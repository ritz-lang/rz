# ritz1/src/mono_clone.ritz - monomorphization's cloning: a generic fn,
# struct or impl method copied with its type parameters substituted
#
# Split from monomorph by AGAST #1818 (no hand-written file over 3,000
# SLOC): nothing left in monomorph calls these, so this module sits above it.

import ast
import ast_helpers
import ritzlib.strview
import types         # view_struct_new / view_*_name: the one view (#4545)
import struct_index   # AGAST #1635
import ast_query   # name_eq & co., off emitter_core (AGAST #3513)
import diag           # diag_error_at (AGAST #3445)
import interp         # print placeholders' method calls (AGAST #3617)
import ritzlib.sys
import ritzlib.io
import ritzlib.str
import ritzlib.cstr
import ritzlib.memory
import monomorph

# Resolve the type of the field named by an ExprKind.Member chain rooted at a
# tracked local: `r.raw` → "Vec$u8", `o.q.a` → "A".  Emits nothing.  Returns
# the *StructField, or null when any link is unknown.  (AGAST #1512)
fn resolve_member_field(mono: *MonoCtx, m: *Module, e: *Expr) -> *StructField
    if e == null or e.kind != ExprKind.Member or e.left == null
        return null
    var sname: *u8 = null
    var sname_len: i32 = 0
    # `(*p).f` is `p.f` (R9 rule 2, AGAST #4836): the field of what `p`
    # points at, one level.  Unstripped, `(*d).data[0..2]` had no field, so
    # it was never a slice of a Vec and the emitter refused it.
    var left: *Expr = e.left
    if left.kind == ExprKind.Unary and left.op == OpKind.Deref and left.operand != null
        left = left.operand
    match left.kind
        ExprKind.Ident =>
            let idx: i32 = find_local_var_idx(mono, left.ident)
            if idx >= 0
                sname = *(mono.lv_type_names + idx)
                sname_len = *(mono.lv_type_name_lens + idx)
            else
                # AGAST #4778: a global, `g_conns.ids` with `var g_conns:
                # *Conns`.  Untyped, `g_conns.ids.get(0)` wanted `get` at
                # every Vec instance, move-only ones too.
                let g: *GlobalVarDef = si_global(m, left.ident)
                if g != null and g.type_name != null
                    sname = g.type_name
                    sname_len = g.type_name_len
                else if g != null and g.pointee_type_name != null
                    sname = g.pointee_type_name
                    sname_len = g.pointee_type_name_len
        # AGAST #4778: a field of a call's or a method's result,
        # `h.item(0).next` with `item` returning `@T` at Holder$Node.
        ExprKind.Call | ExprKind.Method =>
            let rsv: StrView = receiver_instance(mono, m, left)
            if rsv.ptr != null and rsv.len > 0
                sname = rsv.ptr
                sname_len = rsv.len as i32
        # AGAST #4838: a field of a Vec's or Span's element, `edits[0].bytes`
        # with `edits: Vec<Edit>`.  Untyped, `edits[0].bytes.push_span(s)`
        # wanted `push_span` at every Vec instance, Vec$Edit's included, whose
        # body moves an Edit out of a reference.
        ExprKind.Index =>
            let esv: StrView = indexed_element_name(mono, m, e.left)
            if esv.ptr != null and esv.len > 0
                sname = esv.ptr
                sname_len = esv.len as i32
        ExprKind.Member =>
            let parent: *StructField = resolve_member_field(mono, m, left)
            if parent != null
                # Through a held `@T` / `@&T` as through a `*T` (AGAST #2383).
                if parent.field_type == TypeKind.Struct or parent.field_type == TypeKind.Ptr or field_is_ref(parent) == 1
                    sname = parent.field_type_name
                    sname_len = parent.field_type_name_len
        _ => pass
    if sname == null or sname_len <= 0
        return null
    let st: *StructDef = find_concrete_struct(m, StrView { ptr: (sname), len: (sname_len) as i64 })
    if st == null
        return template_member_field(mono, m, StrView { ptr: (sname), len: (sname_len) as i64 }, e)
    var f: *StructField = st.fields
    while f != null
        if f.name_len == e.ident.len as i32
            if memcmp(f.name, e.ident.ptr, e.ident.len) == 0
                return f
        f = f.next
    return null

# AGAST #2411: field `e` of `B$i32` before it's specialised (instantiations are
# collected first): the one-parameter template's field, with a `Vec$T` type
# rewritten to `Vec$i32`, so `b.v.push(3)` instantiates `vec_push$i32`.  null
# for anything else.
fn template_member_field(mono: *MonoCtx, m: *Module, sname_sv: StrView, e: *Expr) -> *StructField
    var sname: *u8 = sname_sv.ptr
    var sname_len: i32 = sname_sv.len as i32
    let dollar: i32 = find_dollar_sign(sname_sv)
    if dollar <= 0
        return null
    let tmpl: *StructDef = find_generic_struct(m, StrView { ptr: (sname), len: (dollar) as i64 })
    if tmpl == null or count_type_params(tmpl.type_params) != 1
        return null
    var f: *StructField = tmpl.fields
    while f != null
        if f.name_len == (e.ident.len as i32) and memcmp(f.name, e.ident.ptr, e.ident.len) == 0
            break
        f = f.next
    if f == null or f.field_type != TypeKind.Struct or f.field_type_name == null
        return null
    if find_dollar_sign(StrView { ptr: (f.field_type_name), len: (f.field_type_name_len) as i64 }) <= 0
        return null
    let out: *StructField = malloc(sizeof(StructField)) as *StructField
    memcpy(out as *u8, f as *u8, sizeof(StructField))
    var sub_len: i32 = 0
    substitute_type_param_in_name(mono, StrView { ptr: (f.field_type_name), len: (f.field_type_name_len) as i64 }, StrView { ptr: (tmpl.type_params.name), len: (tmpl.type_params.name_len) as i64 }, StrView { ptr: (sname + dollar), len: (sname_len - dollar) as i64 }, @out.field_type_name, @sub_len)
    out.field_type_name_len = sub_len
    out.next = null
    out

# AGAST #3110: the leaf of a `[N][M]..P<i64>` declaration.  A multi-
# dimensional array keeps its leaf struct only in the shape (the 1-D
# array_elem_type_name / var_type_name are unset), so a walk of those never
# instantiated P$i64 and `gb[1][2].v` fell to "unhandled EXPR_MEMBER".
fn add_struct_from_array_shape(mono: *MonoCtx, m: *Module, sh: *ArrayShape)
    if sh != null and sh.leaf_name != null
        add_struct_from_mangled_name(mono, m, StrView { ptr: (sh.leaf_name), len: (sh.leaf_name_len) as i64 })

# AGAST #3021: `Option$Slot$i32` / `Result$Two$u8$i64$Slot$i32` are laid out
# by the emitter, but the instances their arguments name are this module's to
# record: with only `Option<Slot<i32>>` naming `Slot<i32>`, a `Some(s)` arm
# bound `s` as an i64, so `match s` was "a variant pattern needs an enum
# scrutinee".  The name itself is still add_enum_instance's: ritzlib.option
# and ritzlib.result declare `enum Option<T>` / `enum Result<T, E>`.
fn add_builtin_enum_args(mono: *MonoCtx, m: *Module, name_sv: StrView, dollar_pos: i32)
    var name: *u8 = name_sv.ptr
    var len: i32 = name_sv.len as i32
    if dollar_pos != 6 or len <= 7
        return
    let is_option: i32 = (name_sv.starts_with("Option")) as i32
    if is_option == 0 and not name_sv.starts_with("Result")
        return
    let suffix: *u8 = name + dollar_pos
    let suffix_len: i32 = len - dollar_pos
    if is_option == 1
        # One parameter: the whole suffix is its argument.
        add_struct_from_mangled_name(mono, m, StrView { ptr: (suffix + 1), len: (suffix_len - 1) as i64 })
        return
    let cap: i64 = 4 * mangled_arg_capacity(StrView { ptr: (suffix), len: (suffix_len) as i64 }) as i64
    let starts: *i32 = malloc(cap) as *i32
    let lens: *i32 = malloc(cap) as *i32
    let n: i32 = split_mangled_args(mono.pctx, m, StrView { ptr: (suffix), len: (suffix_len) as i64 }, starts, lens)
    for i in 0..n
        add_struct_from_mangled_name(mono, m, StrView { ptr: (suffix + *(starts + i) + 1), len: (*(lens + i) - 1) as i64 })
    free(starts as *u8)
    free(lens as *u8)

# Add struct instantiation from a mangled name like "Pair$i32"
# Splits on '$' to get base name and suffix
fn add_struct_from_mangled_name(mono: *MonoCtx, m: *Module, name_sv: StrView)
    var name: *u8 = name_sv.ptr
    var len: i32 = name_sv.len as i32
    let dollar_pos: i32 = find_dollar_sign(name_sv)
    if dollar_pos <= 0
        return  # Not a mangled name

    let base_name: *u8 = name
    let base_len: i32 = dollar_pos

    # Only add if this is actually a generic struct template
    let template: *StructDef = find_generic_struct(m, StrView { ptr: (base_name), len: (base_len) as i64 })
    if template == null
        add_builtin_enum_args(mono, m, name_sv, dollar_pos)   # AGAST #3021
        add_enum_instance(mono, m, name_sv, dollar_pos)   # AGAST #2422
        add_enum_impl_instance(mono, m, name_sv, dollar_pos)   # AGAST #3309
        return  # Not a generic struct we know about

    # Create suffix including the '$'
    let suffix: *u8 = name + dollar_pos
    let suffix_len: i32 = len - dollar_pos

    # AGAST #1574: a multi-parameter template needs exactly one argument per
    # parameter.  (Unlike `Vec$T` below, no placeholder check: nothing
    # registers a `Pair$T$i64` today — see AGAST #1582.)
    if count_type_params(template.type_params) >= 2
        let cap: i64 = 4 * mangled_arg_capacity(StrView { ptr: (suffix), len: (suffix_len) as i64 }) as i64
        let starts: *i32 = malloc(cap) as *i32
        let lens: *i32 = malloc(cap) as *i32
        if split_mangled_args(mono.pctx, m, StrView { ptr: (suffix), len: (suffix_len) as i64 }, starts, lens) == count_type_params(template.type_params)
            add_struct_instantiation(mono, StrView { ptr: (base_name), len: (base_len) as i64 }, StrView { ptr: (suffix), len: (suffix_len) as i64 })
        return

    # `Vec$T`: the unsubstituted placeholder of a generic signature, not an
    # instantiation.  A lone ASCII capital after `$` is a type parameter —
    # unless the module defines a concrete struct by that name: `Vec<P>` for
    # a user `struct P` mangles to `Vec$P`, the same shape (AGAST #1487).
    # Or a user `enum C`: `Vec<C>` is `Vec$C` too, and taking it for the
    # placeholder left `Vec$C` with no struct, so `vec_get<C>` and every
    # `v.len` on it was `unhandled ExprKind.Member` (AGAST #2411).
    if suffix_len == 2
        let ch: i32 = *(suffix + 1) as i32
        if ch >= 'A' and ch <= 'Z'
            if find_concrete_struct(m, StrView { ptr: (suffix + 1), len: (1) as i64 }) == null and names_concrete_enum(mono.pctx, StrView { ptr: (suffix + 1), len: (1) as i64 }) == 0
                return

    add_struct_instantiation(mono, StrView { ptr: (base_name), len: (base_len) as i64 }, StrView { ptr: (suffix), len: (suffix_len) as i64 })

# ----------------------------------------------------------------------------
# Multi-parameter generic structs (AGAST #1574)
# ----------------------------------------------------------------------------
# The parser mangles EVERY type argument, `$`-separated: `Pair<i64, i32>` is
# `Pair$i64$i32` and `Pair<i64, Box<i64>>` is `Pair$i64$Box$i64`.  Nested
# generics share the separator, so splitting a suffix into its arguments
# needs each component's arity: `Box` (one parameter) owns the `$i64` after
# it.  Single-parameter templates never split — their whole suffix is the
# one argument, exactly as before #1574.
#
# That `$`-before-every-component form is ritz1's internal spelling only.  The
# IR spells every name as LANGUAGE_SPEC §11.4 and ritz0 do, `_` after the first
# `$` (`Pair$i64_Box_i64`): emit_name flattens it on the way out (AGAST #3446).

# Record `name` (`Slot$i32`, its `$` at dollar_pos) as an instance of the
# generic enum its base names, once, and instantiate what its payloads name
# (`Full(Box<T>)` at i32 needs `Box$i32`).  Anything else is left alone.
pub fn add_enum_instance(mono: *MonoCtx, m: *Module, name_sv: StrView, dollar_pos: i32)
    var name: *u8 = name_sv.ptr
    var len: i32 = name_sv.len as i32
    let base: i32 = enum_find(mono.pctx, StrView { ptr: (name), len: (dollar_pos) as i64 })
    if base < 0 or enum_is_generic(mono.pctx, base) != 1 or enum_find(mono.pctx, name_sv) >= 0
        return
    let tp: *TypeParam = generic_enum_params(mono.pctx, base)
    let suffix: *u8 = name + dollar_pos
    let suffix_len: i32 = len - dollar_pos
    let n: i32 = count_type_params(tp)
    if n == 0
        return
    let cap: i64 = 4 * mangled_arg_capacity(StrView { ptr: (suffix), len: (suffix_len) as i64 }) as i64
    let starts: *i32 = malloc(cap) as *i32
    let lens: *i32 = malloc(cap) as *i32
    if n == 1
        # One parameter: the whole suffix is its argument (`Slot$Slot$i32`).
        *starts = 0
        *lens = suffix_len
    else if split_mangled_args(mono.pctx, m, StrView { ptr: (suffix), len: (suffix_len) as i64 }, starts, lens) != n
        return
    let count: i32 = enum_variant_count(mono.pctx, base)
    let fields: **StructField = malloc((count as i64 + 1) * 8) as **StructField
    for vi in 0..count
        *(fields + vi) = clone_struct_fields_multi(mono, enum_variant_fields(mono.pctx, base, vi), tp, suffix, starts, lens)
    enum_record_instance(mono.pctx, base, name_sv, fields)
    for vj in 0..count
        var f: *StructField = *(fields + vj)
        while f != null
            if f.field_type_name != null
                add_struct_from_mangled_name(mono, m, StrView { ptr: (f.field_type_name), len: (f.field_type_name_len) as i64 })
            f = f.next

# Rewrite a mangled name, replacing every `$`-component that is a type
# parameter with its argument: `Box$B` at <A=i64, B=i32> is `Box$i32`.
# Returns `name` itself when no component is a parameter.
pub fn substitute_params_in_mangled(mono: *MonoCtx, tp: *TypeParam, suffix: *u8, starts: *i32, lens: *i32, name0_sv: StrView) -> StrView
    var name0: *u8 = name0_sv.ptr
    var len0: i32 = name0_sv.len as i32
    # AGAST #2975: a tuple component over any of the parameters
    # (`Vec$tuple_K_V`) is its instantiation, one parameter at a time.
    var name: *u8 = name0
    var len: i32 = len0
    var ti: i32 = 0
    var tcur: *TypeParam = tp
    while tcur != null
        let subst_sv: StrView = subst_components(mono, StrView { ptr: (name), len: (len) as i64 }, StrView { ptr: (tcur.name), len: (tcur.name_len) as i64 }, StrView { ptr: (suffix + *(starts + ti)), len: (*(lens + ti)) as i64 }, 0)
        name = subst_sv.ptr
        len = subst_sv.len as i32
        tcur = tcur.next
        ti = ti + 1
    # Pass 1: the rewritten length (0 extra when nothing matches).
    var total: i32 = 0
    var hit: i32 = 0
    var pos: i32 = 0
    while pos <= len
        var end: i32 = pos
        while end < len and *(name + end) != '$'
            end = end + 1
        let idx: i32 = type_param_index(tp, StrView { ptr: (name + pos), len: (end - pos) as i64 })
        var head: i32 = 0
        let pidx: i32 = piece_param_index(tp, StrView { ptr: (name + pos), len: (end - pos) as i64 }, @head)
        if idx >= 0
            hit = 1
            total = total + *(lens + idx) - 1
        else if pidx >= 0
            hit = 1
            total = total + head + *(lens + pidx) - 1
        else
            total = total + end - pos
        if end < len
            total = total + 1
        pos = end + 1
    if hit == 0
        return strview_from_ptr(name, len as i64)
    # Pass 2: build it.
    let out: *u8 = malloc(total as i64 + 1) as *u8
    var o: i32 = 0
    pos = 0
    while pos <= len
        var end: i32 = pos
        while end < len and *(name + end) != '$'
            end = end + 1
        let idx: i32 = type_param_index(tp, StrView { ptr: (name + pos), len: (end - pos) as i64 })
        var head: i32 = 0
        let pidx: i32 = piece_param_index(tp, StrView { ptr: (name + pos), len: (end - pos) as i64 }, @head)
        if idx >= 0
            let a: *u8 = suffix + *(starts + idx) + 1
            let a_len: i32 = *(lens + idx) - 1
            for j in 0..a_len
                *(out + o) = *(a + j)
                o = o + 1
        else if pidx >= 0
            # AGAST #3748: `ptr_A` at A = u8 is `ptr_u8`.
            for j in pos..(pos + head)
                *(out + o) = *(name + j)
                o = o + 1
            let pa: *u8 = suffix + *(starts + pidx) + 1
            let pa_len: i32 = *(lens + pidx) - 1
            for j in 0..pa_len
                *(out + o) = *(pa + j)
                o = o + 1
        else
            for j in pos..end
                *(out + o) = *(name + j)
                o = o + 1
        if end < len
            *(out + o) = 36
            o = o + 1
        pos = end + 1
    *(out + o) = 0
    strview_from_ptr(out, o as i64)

# Register the generic-struct instantiations named by a fn's signature.
# Every type kind counts, not just by-value TypeKind.Struct: `v: @&Vec<T>`
# specialised at u8 is a TypeKind.Ref named `Vec$u8`, and the body's `v.len`
# needs `struct Vec$u8` to exist.  ritz1 used to paper over this with a
# hard-coded Vec$u8/i32/... layout table (AGAST #1440); without it, the
# layout must come from instantiating `struct Vec<T>`.
# AGAST #3979: and those of a fn type among them, `look: fn(u16) -> Slot<P>`,
# whose signature is a FnDef of its own (null for any other type).
fn collect_struct_types_from_signature(mono: *MonoCtx, m: *Module, f: *FnDef)
    if f == null
        return
    if f.return_type_name != null
        add_struct_from_mangled_name(mono, m, StrView { ptr: (f.return_type_name), len: (f.return_type_name_len) as i64 })
    collect_struct_types_from_signature(mono, m, f.ret_fn_sig)
    var p: *Param = f.params
    while p != null
        if p.param_type_name != null
            add_struct_from_mangled_name(mono, m, StrView { ptr: (p.param_type_name), len: (p.param_type_name_len) as i64 })
        collect_struct_types_from_signature(mono, m, p.fn_sig)
        p = p.next

# Same, for a specialised fn: its signature and every var-decl type in its
# body.  Only struct instantiations are gathered here — fn instantiations in
# a specialised body are registered by clone_body as it substitutes them.
fn collect_struct_types_from_fn(mono: *MonoCtx, m: *Module, f: *FnDef)
    collect_struct_types_from_signature(mono, m, f)
    collect_struct_types_from_stmts(mono, m, f.body)

# AGAST #2411: a specialised struct's by-value fields, `B$usize.v: Vec$usize`:
# the field's layout must exist even when no fn names it.
fn collect_struct_types_from_fields(mono: *MonoCtx, m: *Module, f: *StructField)
    var cur: *StructField = f
    while cur != null
        if cur.field_type == TypeKind.Struct and cur.field_type_name != null
            add_struct_from_mangled_name(mono, m, StrView { ptr: (cur.field_type_name), len: (cur.field_type_name_len) as i64 })
        # AGAST #3099: and a pointee's, `W$u16.b: *Box$u16`: `w.b.v` reads
        # Box$u16's layout though no fn names it.
        if (cur.field_type == TypeKind.Ptr or cur.field_type == TypeKind.Ref or cur.field_type == TypeKind.MutRef) and cur.field_type_name != null
            add_struct_from_mangled_name(mono, m, StrView { ptr: (cur.field_type_name), len: (cur.field_type_name_len) as i64 })
        # AGAST #2390: and its array elements', `W$i32.a: [2]Box$i32`, or
        # (#3099) `[2]*Box$i32`.
        if cur.field_type == TypeKind.Array and array_elem_names_struct(cur) == 1
            add_struct_from_mangled_name(mono, m, StrView { ptr: (cur.array_elem_type_name), len: (cur.array_elem_type_name_len) as i64 })
        add_struct_from_array_shape(mono, m, cur.array_shape)   # AGAST #3119: `[2][3]Box$i32`
        cur = cur.next

fn collect_struct_types_from_stmts(mono: *MonoCtx, m: *Module, body: *Stmt)
    var s: *Stmt = body
    while s != null
        let k: StmtKind = s.kind
        match k
            StmtKind.VarDecl =>
                if s.var_type_name != null
                    add_struct_from_mangled_name(mono, m, StrView { ptr: (s.var_type_name), len: (s.var_type_name_len) as i64 })
            StmtKind.If =>
                collect_struct_types_from_stmts(mono, m, s.if_then)
                collect_struct_types_from_stmts(mono, m, s.if_else)
            StmtKind.While | StmtKind.Loop | StmtKind.Defer | StmtKind.Unsafe =>
                collect_struct_types_from_stmts(mono, m, s.while_body)
            StmtKind.For =>
                collect_struct_types_from_stmts(mono, m, s.for_body)
            StmtKind.Asm =>
                pass   # StmtKind.Asm holds no statement, expression or type (AGAST #3394).
            _ => pass
        s = s.next

fn collect_instantiations_from_module(mono: *MonoCtx, m: *Module)
    # Walk all non-generic functions to find instantiations
    var f: *FnDef = m.functions
    while f != null
        if f.type_params == null
            collect_struct_types_from_signature(mono, m, f)
            # Reset local-var tracker per fn body, then seed from fn params so
            # `fn foo(v: Vec<T>)` lets `v.push(...)` resolve UFCS-style.
            reset_local_var_tracker(mono)
            var pp: *Param = f.params
            while pp != null
                track_typed_local_through(mono, StrView { ptr: (pp.name), len: (pp.name_len) as i64 }, pp.param_type, pp.param_pointee_type, StrView { ptr: (pp.param_type_name), len: (pp.param_type_name_len) as i64 })
                pp = pp.next
            # Walk function body
            set_mono_fn_context(mono, f)
            mono.req_fn = f   # AGAST #4844: what it names is named from f
            collect_from_fn_body(mono, m, f.body)
            mono.req_fn = null
            set_mono_fn_context(mono, null)
        f = f.next

    # Walk impl block methods.  Skip generic impl blocks (those with
    # type_params != null) — their methods are templates whose bodies
    # reference the type parameter directly (e.g. `span_len<T>(self)` in
    # `impl<T> Span<T>`).  Walking them would register bogus
    # ("span_len", "$T") instantiations that get specialised into
    # broken `span_len$T` functions with unsubstituted T references.
    # Methods on generic impls get specialised via specialize_impl_methods
    # once the parent struct is instantiated for a concrete type.
    var ib: *ImplBlock = m.impls
    while ib != null
        if ib.type_params == null
            var method: *FnDef = ib.methods
            while method != null
                # AGAST #2305: a method's own `s: Span<i32>` instantiates
                # Span$i32 as a free fn's does; left opaque, `s.len` was
                # "unhandled EXPR_MEMBER".
                collect_struct_types_from_signature(mono, m, method)
                reset_local_var_tracker(mono)
                var ipp: *Param = method.params
                while ipp != null
                    if ipp.is_self_borrow == 1 and ipp.param_type_name_len == 0
                        # AGAST #2562: a bare `self:&` names no type (the
                        # emitter takes it from the ImplBlock), so seed it as
                        # the `@&T` it is, or `self.v.push(s)` never
                        # registers `vec_push$S`.
                        track_typed_local_through(mono, StrView { ptr: (ipp.name), len: (ipp.name_len) as i64 }, TypeKind.MutRef, TypeKind.Struct, StrView { ptr: (ib.type_name), len: (ib.type_name_len) as i64 })
                    else
                        track_typed_local_through(mono, StrView { ptr: (ipp.name), len: (ipp.name_len) as i64 }, ipp.param_type, ipp.param_pointee_type, StrView { ptr: (ipp.param_type_name), len: (ipp.param_type_name_len) as i64 })
                    ipp = ipp.next
                set_mono_fn_context(mono, method)
                mono.req_fn = method   # AGAST #4844
                collect_from_fn_body(mono, m, method.body)
                mono.req_fn = null
                set_mono_fn_context(mono, null)
                method = method.next
        ib = ib.next

    # Walk global variable types — `var g: Vec<String>` at module scope
    # needs Vec$String instantiated just like a let-binding does.  Without
    # this, idiomatic main.ritz's `var g_processed: Vec<String>` left
    # Vec$String un-instantiated and the self-hosted bootstrap died with
    # "ERROR: unhandled EXPR_MEMBER" inside vec_len$String.
    var g: *GlobalVarDef = m.globals
    while g != null
        if g.type_name != null
            add_struct_from_mangled_name(mono, m, StrView { ptr: (g.type_name), len: (g.type_name_len) as i64 })
        # AGAST #3025: and the element of `var ga: [N]P<i64>`, as a field's
        # is below.  Missed, P$i64 was never instantiated when no fn named
        # it, and `ga[i].v` fell to "unhandled EXPR_MEMBER".
        if g.array_elem_type_name != null
            add_struct_from_mangled_name(mono, m, StrView { ptr: (g.array_elem_type_name), len: (g.array_elem_type_name_len) as i64 })
        add_struct_from_array_shape(mono, m, g.array_shape)   # AGAST #3110: `[N][M]P<i64>`
        g = g.next

    # Walk concrete struct field types — `struct ParsedArgs` with a
    # `Vec<ArgSlot>` field needs Vec$ArgSlot for its own `%ParsedArgs` type
    # decl, which every importer emits.  This used to be found only by
    # walking the bodies that USE the struct; since G9b (AGAST #1899) an
    # import's bodies are stripped, and field types are its interface.
    var st: *StructDef = m.structs
    while st != null
        if st.type_params == null
            var fld: *StructField = st.fields
            while fld != null
                if fld.field_type_name != null
                    add_struct_from_mangled_name(mono, m, StrView { ptr: (fld.field_type_name), len: (fld.field_type_name_len) as i64 })
                if fld.array_elem_type_name != null
                    add_struct_from_mangled_name(mono, m, StrView { ptr: (fld.array_elem_type_name), len: (fld.array_elem_type_name_len) as i64 })
                # AGAST #3119: `a: [2][3]P<i64>` keeps P$i64 only in its shape.
                add_struct_from_array_shape(mono, m, fld.array_shape)
                collect_struct_types_from_signature(mono, m, fld.fn_sig)        # AGAST #3979
                collect_struct_types_from_signature(mono, m, fld.elem_fn_sig)
                fld = fld.next
        st = st.next

fn collect_from_fn_body(mono: *MonoCtx, m: *Module, body: *Stmt)
    var s: *Stmt = body
    while s != null
        collect_from_stmt(mono, m, s)
        s = s.next

fn collect_from_stmt(mono: *MonoCtx, m: *Module, s: *Stmt)
    rewrite_struct_index_stmt(mono, m, s)   # AGAST #1635
    note_compound_calls(s)            # AGAST #2529, after the rewrite above
    let k: StmtKind = s.kind
    match k
        StmtKind.Expr =>
            if s == mono.mono_tail
                slice_into_expected(mono, m, s.expr, StrView { ptr: (mono.mono_ret_name), len: (mono.mono_ret_len) as i64 })   # AGAST #2877
            collect_from_expr(mono, m, s.expr)
        StmtKind.VarDecl =>
            # Before tracking: `let t = v[1..3]` is `let t = v.slice(1, 3)`, so `t`
            # is tracked as that call's result (AGAST #2451).
            if s.var_init != null
                if slice_into_span_annotation(mono, m, s) == 1
                    mono.slice_kept = s.var_init
                rewrite_value_slice(mono, m, s.var_init)
            # Check if variable type is a generic struct — by value or behind a
            # pointer/reference (`var v: *Vec<u8>` needs Vec$u8 just the same).
            if s.var_type_name != null
                add_struct_from_mangled_name(mono, m, StrView { ptr: (s.var_type_name), len: (s.var_type_name_len) as i64 })
            collect_struct_types_from_signature(mono, m, s.var_fn_sig)   # AGAST #3979: `let f: fn() -> Slot<P>`
            add_struct_from_array_shape(mono, m, s.var_array_shape)   # AGAST #3110
            # Record local-var → Vec/Span suffix mapping for UFCS-driven generic
            # instantiation.  Two paths:
            #   1. Explicit annotation: `var v: Vec<u16>` — var_type_name="Vec$u16"
            #   2. Inferred from ExprKind.Call initializer: `var v = vec_new<u16>()`
            #      — look up the called fn's return type (which for a generic
            #      template is "Vec$T"; substitute T with the call's type suffix).
            var lv_kind: i32 = 0
            var lv_suf: *u8 = null
            var lv_suf_len: i32 = 0
            if s.var_type == TypeKind.Struct and s.var_type_name != null
                lv_kind = classify_collection_type(StrView { ptr: (s.var_type_name), len: (s.var_type_name_len) as i64 }, @lv_suf, @lv_suf_len)
            if lv_kind == 0 and s.var_init != null
                if s.var_init.kind == ExprKind.Call
                    if s.var_init.call_type_suffix.len > 0
                        let init_fn: *FnDef = find_fn_in_module(m, s.var_init.func_name)
                        if init_fn != null
                            if init_fn.return_type == TypeKind.Struct and init_fn.return_type_name != null
                                # Template return type names look like "Vec$T".
                                # The classifier wants the concrete suffix though,
                                # so for generic templates we use the call's own
                                # type suffix instead of the template's "$T".
                                var rt_suf: *u8 = null
                                var rt_suf_len: i32 = 0
                                let rt_kind: i32 = classify_collection_type(StrView { ptr: (init_fn.return_type_name), len: (init_fn.return_type_name_len) as i64 }, @rt_suf, @rt_suf_len)
                                if rt_kind > 0
                                    lv_kind = rt_kind
                                    lv_suf = s.var_init.call_type_suffix.ptr
                                    lv_suf_len = s.var_init.call_type_suffix.len as i32
            if lv_kind > 0 and lv_suf != null and lv_suf_len > 0
                add_local_var(mono, StrView { ptr: (s.var_name), len: (s.var_name_len) as i64 }, lv_kind, StrView { ptr: (lv_suf), len: (lv_suf_len) as i64 })
                mark_last_local_by_value(mono)
            else if s.var_type == TypeKind.Array and s.var_type_name != null and s.var_type_name_len > 0
                # `[N]S`: an element receiver `a[i].m()` is an S (AGAST #4231).
                track_array_local(mono, StrView { ptr: (s.var_name), len: (s.var_name_len) as i64 }, StrView { ptr: (s.var_type_name), len: (s.var_type_name_len) as i64 })
            else if s.var_type_name != null and s.var_type_name_len > 0
                # Plain struct (or pointer/ref to one): root of a field receiver.
                track_typed_local_through(mono, StrView { ptr: (s.var_name), len: (s.var_name_len) as i64 }, s.var_type, s.var_pointee_type, StrView { ptr: (s.var_type_name), len: (s.var_type_name_len) as i64 })
            else if s.var_init != null and s.var_init.kind == ExprKind.Unary and (s.var_init.op == OpKind.Addr or s.var_init.op == OpKind.AddrMut)
                track_address_of_local(mono, StrView { ptr: (s.var_name), len: (s.var_name_len) as i64 }, s.var_init.operand)
                # AGAST #4838: `let e = @&edits[0]` points at an element: `e.bytes`
                # is that element's field, as with `let e: @&Edit = ..`.
                let of: *Expr = s.var_init.operand
                if of != null and of.kind == ExprKind.Index
                    let ename: StrView = indexed_element_name(mono, m, of)
                    if ename.ptr != null and ename.len > 0
                        add_local_struct_var(mono, StrView { ptr: (s.var_name), len: (s.var_name_len) as i64 }, ename)
            else if s.var_init != null and s.var_init.kind == ExprKind.StructLit
                # Un-annotated `var r = R { ... }`: the literal names the type.
                add_local_struct_var(mono, StrView { ptr: (s.var_name), len: (s.var_name_len) as i64 }, s.var_init.ident)
            else if s.var_init != null and s.var_init.kind == ExprKind.Index
                # Un-annotated `let w = p[1]` of a Vec<Vec<T>>: `w` is the element,
                # a Vec<T>, so `w.get(1)` registers vec_get$T (AGAST #2519).
                var esuf: *u8 = null
                var esuf_len: i32 = 0
                let ekind: i32 = indexed_element_collection(mono, m, s.var_init, @esuf, @esuf_len)
                if ekind > 0
                    add_local_var(mono, StrView { ptr: (s.var_name), len: (s.var_name_len) as i64 }, ekind, StrView { ptr: (esuf), len: (esuf_len) as i64 })
                    mark_last_local_by_value(mono)
            else if s.var_init != null and s.var_init.kind == ExprKind.Method
                track_method_init_local(mono, m, StrView { ptr: (s.var_name), len: (s.var_name_len) as i64 }, s.var_init)
            else if s.var_init != null and s.var_init.kind == ExprKind.Call and s.var_init.call_type_suffix.len == 0
                # `var w = ms()`: a plain fn's return type, as an annotation of it.
                var call_fn: *FnDef = find_fn_in_module(m, s.var_init.func_name)
                # AGAST #3495: or an impl method by its symbol (`String_from(x)`).
                if call_fn == null
                    call_fn = find_impl_method_by_symbol(m, s.var_init.func_name)
                if call_fn != null and call_fn.type_params == null
                    track_typed_local(mono, StrView { ptr: (s.var_name), len: (s.var_name_len) as i64 }, call_fn.return_type, StrView { ptr: (call_fn.return_type_name), len: (call_fn.return_type_name_len) as i64 })
            if s.var_init != null
                collect_from_expr(mono, m, s.var_init)
        StmtKind.Assign =>
            # AGAST #4778: an expression target names what it reaches too:
            # `h.at(0).b = 9` wants `at`, which nothing else here asks for
            # unless the program also reads `h.at(..)`.  A compound target is
            # the value's left, walked with it.
            if s.assign_target_len == 0 and s.if_cond != null
                let tv: *Expr = s.assign_value
                if tv == null or tv.kind != ExprKind.Binary or tv.left != s.if_cond
                    collect_from_expr(mono, m, s.if_cond)
            collect_from_expr(mono, m, s.assign_value)
        StmtKind.MemberAssign =>
            # ptr.field = value - walk the value expression
            collect_from_expr(mono, m, s.assign_value)
        StmtKind.MemberIndexAssign =>
            # ptr.field[index] = value - walk the index (in while_cond) and value
            collect_from_expr(mono, m, s.while_cond)  # index stored in while_cond
            collect_from_expr(mono, m, s.assign_value)
        StmtKind.IndexAssign =>
            # name[index] = value - walk the index (in while_cond) and value
            collect_from_expr(mono, m, s.while_cond)  # index stored in while_cond
            collect_from_expr(mono, m, s.assign_value)
        StmtKind.LocalFieldAssign =>
            # local_var.field = value - walk the value expression
            collect_from_expr(mono, m, s.assign_value)
        StmtKind.LocalFieldIndexAssign =>
            # local_var.field[index] = value - walk the index (in while_cond) and value
            collect_from_expr(mono, m, s.while_cond)  # index stored in while_cond
            collect_from_expr(mono, m, s.assign_value)
        StmtKind.If =>
            collect_from_expr(mono, m, s.if_cond)
            collect_from_fn_body(mono, m, s.if_then)
            if s.if_else != null
                collect_from_fn_body(mono, m, s.if_else)
        StmtKind.While =>
            collect_from_expr(mono, m, s.while_cond)
            collect_from_fn_body(mono, m, s.while_body)
        StmtKind.For =>
            collect_from_expr(mono, m, s.for_start)
            collect_from_expr(mono, m, s.for_end)
            collect_from_fn_body(mono, m, s.for_body)
        StmtKind.Loop | StmtKind.Defer | StmtKind.Unsafe =>
            # Infinite loop stores its body in while_body (same slot as StmtKind.While);
            # so does `defer` (AGAST #1625).  Without this case, generic calls inside `loop { ... }` are never
            # registered for monomorphization (e.g. vec_push_bytes<u8> inside
            # vec_read_all_fd), leaving the linker with unresolved references.
            collect_from_fn_body(mono, m, s.while_body)
        StmtKind.Asm =>
            pass   # StmtKind.Asm holds no statement, expression or type (AGAST #3394).
        StmtKind.Return =>
            if s.return_value != null
                slice_into_expected(mono, m, s.return_value, StrView { ptr: (mono.mono_ret_name), len: (mono.mono_ret_len) as i64 })   # AGAST #2877
                collect_from_expr(mono, m, s.return_value)
        StmtKind.Assert =>
            # `assert <cond>` — cond stored in if_cond (slot reuse).  Generic
            # calls in the condition need to register for monomorphization.
            if s.if_cond != null
                collect_from_expr(mono, m, s.if_cond)
        StmtKind.TupleDecl =>
            # `let (a, b) = expr` — initializer in var_init.
            if s.var_init != null
                collect_from_expr(mono, m, s.var_init)
        StmtKind.Match =>
            # `match scrutinee \n arm => body \n …` — scrutinee in if_cond,
            # arms list in if_then (recast as *Stmt by the parser; see
            # stmt_match in ast_helpers.ritz).  Walk the arm bodies as
            # *Expr — they're real expressions, not Stmts.
            if s.if_cond != null
                collect_from_expr(mono, m, s.if_cond)
            collect_from_arms(mono, m, s.if_cond, s.if_then as *MatchArm)
        _ => pass

# Walk a match's (or an if's) arms.  Each arm is a scope (AGAST #2573): its
# payload binding (`Some(x)`, `Ok(x)`, `Hit(x)`) is recorded at the payload's
# type for that arm only, and the arm's own lets go with it, so a second arm
# binding `x` at another type finds its own.  (No outer local can share the
# name: #2395 refuses that.)  `scrut` is null for an if.
fn collect_from_arms(mono: *MonoCtx, m: *Module, scrut: *Expr, arms: *MatchArm)
    let tn_sv: StrView = scrutinee_type_name(mono, m, scrut)
    var arm: *MatchArm = arms
    while arm != null
        let saved_count: i32 = mono.lv_count
        # AGAST #1295: each binding of `V(a, b, ..)`, at its field's type.
        let nb: i32 = arm_bind_count(arm)
        for k in 0..nb
            arm_select_bind(arm, k)
            bind_arm_payload(mono, m, arm, tn_sv)
        arm_select_bind(arm, 0)
        collect_from_fn_body(mono, m, arm.body_stmts)   # block arm (AGAST #1454)
        if arm.body != null
            collect_from_expr(mono, m, arm.body)
        mono.lv_count = saved_count
        arm = arm.next

# The struct type `e` is, or points at one level, with `*out_how` saying which
# (SI_*), and `*out_recv` the receiver its method call takes; null when this
# pass can't tell.  `e` is a tracked local (by value, or one `@` / `@&` / `*`
# level), a global, a field of a tracked local, an element of
# a Vec or Span local, a call to a plain fn, or `*p` of any of those that
# points at a struct (AGAST #2847: ritz0 types any base).
fn si_expr_struct(mono: *MonoCtx, m: *Module, e: *Expr, out_how: *i32, out_recv: **Expr) -> StrView
    *out_how = SI_BY_VALUE
    *out_recv = e
    if e == null
        return strview_empty()
    match e.kind
        ExprKind.Ident =>
            let idx: i32 = find_local_var_idx(mono, e.ident)
            if idx < 0
                let g: *GlobalVarDef = si_global(m, e.ident)
                if g == null or g.type_name == null
                    return strview_empty()
                if g.var_type == TypeKind.Ptr and g.pointee_type == TypeKind.Struct
                    *out_how = SI_THROUGH
                else if g.var_type != TypeKind.Struct
                    return strview_empty()
                return strview_from_ptr(g.type_name, g.type_name_len as i64)
            if *(mono.lv_prefix_kind + idx) != 0
                return strview_empty()
            let bv: i32 = *(mono.lv_by_value + idx)
            if bv != 1 and bv != 2
                return strview_empty()
            if bv == 2
                *out_how = SI_THROUGH
            return strview_from_ptr(*(mono.lv_type_names + idx), (*(mono.lv_type_name_lens + idx)) as i64)
        ExprKind.Member =>
            let f: *StructField = resolve_member_field(mono, m, e)
            if f == null or f.field_type != TypeKind.Struct
                return strview_empty()
            return strview_from_ptr(f.field_type_name, f.field_type_name_len as i64)
        ExprKind.Index =>
            # AGAST #2884: `lv[0][k]`, an element of a Vec or Span local (or of
            # one behind a pointer) that's a struct by value: its type is the
            # local's whole `$T` suffix.  `pv[0][k]` on a `Vec<*S>` names no
            # struct here, and stays a raw buffer (#2887).
            if e.left == null or e.left.kind != ExprKind.Ident or e.right == null or e.right.kind == ExprKind.Range
                return strview_empty()
            let eidx: i32 = find_local_var_idx(mono, e.left.ident)
            if eidx < 0 or *(mono.lv_prefix_kind + eidx) == 0 or *(mono.lv_by_value + eidx) == 0
                return strview_empty()
            let suf: *u8 = *(mono.lv_suffixes + eidx)
            let suf_len: i32 = *(mono.lv_suffix_lens + eidx)
            if suf == null or suf_len < 2 or *suf != '$'   # '$'
                return strview_empty()
            # A generic element (`Pair$i32`) or a nested collection isn't one name.
            var d: i32 = 1
            while d < suf_len
                if *(suf + d) == '$'
                    return strview_empty()
                d = d + 1
            return strview_from_ptr(suf + 1, (suf_len - 1) as i64)
        ExprKind.Call =>
            if e.call_type_suffix.len != 0
                return strview_empty()
            let f: *FnDef = find_fn_in_module(m, e.func_name)
            if f == null or f.type_params != null or f.return_type_name == null
                return strview_empty()
            match f.return_type
                TypeKind.Struct =>
                    *out_how = SI_TEMPORARY
                TypeKind.Ptr | TypeKind.Ref | TypeKind.MutRef =>
                    *out_how = SI_THROUGH
                _ =>
                    return strview_empty()
            return strview_from_ptr(f.return_type_name, f.return_type_name_len as i64)
        _ => pass
    if e.kind == ExprKind.Unary and e.op == OpKind.Deref
        # `(*p)[k]` is `p[k]`'s struct, as a value: the receiver is `p`.
        var how: i32 = 0
        var recv: *Expr = null
        let name_sv: StrView = si_expr_struct(mono, m, e.operand, @how, @recv)
        if name_sv.ptr == null or how != SI_THROUGH
            return strview_empty()
        *out_recv = recv
        return name_sv
    strview_empty()

# The struct `base[k]` indexes, when si_expr_struct knows `base`'s type and
# that struct isn't built in; else null.  `*out_mask` gets the traits it
# implements, `*out_how` how the base holds it and `*out_recv` the receiver.
# A pointer to a struct with none of them is a raw buffer, and a reference
# to one is refused as one value (index_through.ritz): both are left alone.
fn si_base_struct(mono: *MonoCtx, m: *Module, base: *Expr, out_mask: *i32, out_how: *i32, out_recv: **Expr) -> StrView
    *out_mask = 0
    let name_sv: StrView = si_expr_struct(mono, m, base, out_how, out_recv)
    if name_sv.ptr == null or name_sv.len <= 0 or si_built_in(name_sv) == 1 or si_is_struct(m, name_sv) == 0
        return strview_empty()
    let mask: i32 = si_traits(m, name_sv)
    if *out_how == SI_THROUGH and mask == 0
        return strview_empty()
    *out_mask = mask
    name_sv

# A write to `p[k]` with `p` an `@M` (§3.2): located at `p`, as ref_check
# refuses any other write through one.  1 when refused.
fn si_refuse_shared_write(mono: *MonoCtx, m: *Module, base: *Expr) -> i32
    # `p.m[k]`, `p.a.m[k]`: the root, reached through fields held by value.  A
    # pointer field on the way is its own place, not in what `p` refers to.
    var root: *Expr = base
    while root != null and root.kind == ExprKind.Member
        if root != base
            let f: *StructField = resolve_member_field(mono, m, root)
            if f == null or f.field_type != TypeKind.Struct
                return 0
        root = root.left
    if root == null or root.kind != ExprKind.Ident
        return 0
    let idx: i32 = find_local_var_idx(mono, root.ident)
    if idx < 0 or *(mono.lv_shared + idx) != 1
        return 0
    si_refuse_write_through(root.span.line, root.span.col)
    1

# A read of `m[k]` (`*m.index(k)`), `@m[k]` (`m.index(k)`) or `@&m[k]`
# (`m.index_mut(k)`).  Called on each expression before its children.
fn rewrite_struct_index(mono: *MonoCtx, m: *Module, e: *Expr)
    if e == null
        return
    var x: *Expr = e
    var use: i32 = SI_USE_READ
    if e.kind == ExprKind.Unary and (e.op == OpKind.Addr or e.op == OpKind.AddrMut)
        x = e.operand
        if e.op == OpKind.AddrMut
            use = SI_USE_ADDR_MUT
    if x == null or x.kind != ExprKind.Index or x.right == null or x.right.kind == ExprKind.Range
        return
    var mask: i32 = 0
    var how: i32 = 0
    var recv: *Expr = null
    let name_sv: StrView = si_base_struct(mono, m, x.left, @mask, @how, @recv)
    if name_sv.ptr == null
        return
    if si_check_shown(m, si_index_line(x), si_index_col(x), name_sv, mask, use) == 0
        return
    if use == SI_USE_ADDR_MUT and si_refuse_shared_write(mono, m, recv) == 1
        return
    if si_refuse_lent_temporary(how, x.left, (use == SI_USE_ADDR_MUT) as i32) == 1
        return
    let key: *Expr = x.right
    if x == e
        let rd: *Expr = si_method(recv, "index", key, e.span.line, e.span.col)
        si_mark(rd, null, SI_USE_READ, 0, 0, 0)
        si_into_deref(e, rd)
        return
    si_mark(e, x, use, 1, 0, 0)   # x stays `m[k]`: R11a's place
    # `@m[k]` / `@&m[k]` is the reference the method returns.
    e.kind = ExprKind.Method
    e.left = recv
    if use == SI_USE_ADDR_MUT
        e.ident = "index_mut"
    else
        e.ident = "index"
    e.args = key
    e.operand = null
    e.call_type_suffix = strview_empty()

# ----------------------------------------------------------------------------
# AGAST #2529: `x op= v` arrives as `x = x op v` (ast_helpers.ritz
# stmt_compound_assign_*), the read and the store sharing the nodes of x's
# operands.  A call among them is noted as evaluated once (si_once), so the
# emitter runs it at the first of the two and hands its register to the second:
# `h(@a)[1] += 7` and `a[f()] += 1` call once.  Only a node both sides reach is
# noted; a user's `a[f()] = a[f()] + 1` has two calls and keeps them.
# ----------------------------------------------------------------------------

# Where each store form keeps the place's shared operands (ast_helpers.ritz).
fn note_compound_calls(s: *Stmt)
    let k: StmtKind = s.kind
    if is_store_stmt(k) == 0
        return
    let v: *Expr = s.assign_value
    if v == null or v.kind != ExprKind.Binary or v.left == null
        return
    var a: *Expr = null
    var b: *Expr = null
    match k
        StmtKind.IndexAssign | StmtKind.LocalFieldIndexAssign =>
            a = s.while_cond
        StmtKind.MemberIndexAssign =>
            a = s.if_cond
            b = s.while_cond
        StmtKind.MemberAssign =>
            a = s.if_cond
        _ =>
            if k == StmtKind.Assign and s.assign_target_len == 0
                a = s.if_cond
            else
                return
    note_shared_calls(v.left, a, b)

# `s`, a store to `base[key]` of `value`, as `index_set` or a store through
# `index_mut`; `m[k] op= x` (compound) through one `index_mut` call.
fn si_rewrite_assign(mono: *MonoCtx, m: *Module, s: *Stmt, base: *Expr, key: *Expr, value: *Expr, compound: i32, line: i32, col: i32) -> i32
    # The place, for ref_loan (R11a): `base[key]`, put back together.
    let place: *Expr = si_new_expr(ExprKind.Index, s.span.line, s.span.col)
    place.left = base
    place.right = key
    var mask: i32 = 0
    var how: i32 = 0
    var recv: *Expr = null
    let name_sv: StrView = si_base_struct(mono, m, base, @mask, @how, @recv)
    if name_sv.ptr == null
        return 0
    var use: i32 = SI_USE_ASSIGN
    if compound == 1
        use = SI_USE_COMPOUND
    if si_check_shown(m, line, col, name_sv, mask, use) == 0
        return 0
    if si_refuse_shared_write(mono, m, recv) == 1
        return 0
    key.next = null
    if compound == 0 and (mask & SI_INDEX_SET) != 0
        # `index_set` returns nothing: a temporary it writes lends nothing out.
        key.next = value
        s.kind = StmtKind.Expr
        s.expr = si_method(recv, "index_set", key, line, col)
        si_mark(s.expr, place, use, 0, s.span.line, s.span.col)
        return 1
    if si_refuse_lent_temporary(how, base, 1) == 1
        return 0
    let call: *Expr = si_method(recv, "index_mut", key, line, col)
    si_mark(call, place, use, 0, s.span.line, s.span.col)
    if compound == 1
        # The read `m[k]` of `m[k] = m[k] op x` shares the call.
        si_once_add(call)
        value.left = si_deref(call, line, col)
    s.kind = StmtKind.Assign
    s.if_cond = si_deref(call, line, col)
    s.assign_target = null
    s.assign_target_len = 0
    s.assign_value = value
    return 1

# Statement forms of `m[k]` on a struct: `m[k] = v`, `m[k] op= x` and a store
# to a field of one (`m[k].f = x`, `m[k].f op= x`).  Before the statement's
# expressions are walked.
fn rewrite_struct_index_stmt(mono: *MonoCtx, m: *Module, s: *Stmt)
    match s.kind
        StmtKind.IndexAssign =>
            # `name[k] = v` keeps the name, not an expression.
            let base: *Expr = si_new_expr(ExprKind.Ident, s.span.line, s.span.col)
            base.ident = StrView { ptr: s.assign_target, len: s.assign_target_len as i64 }
            let key: *Expr = s.while_cond
            let v: *Expr = s.assign_value
            var compound: i32 = 0
            if v != null and v.kind == ExprKind.Binary and v.left != null and v.left.kind == ExprKind.Index and v.left.right == key
                compound = 1   # stmt_compound_assign_index shares the key
            if si_rewrite_assign(mono, m, s, base, key, v, compound, s.bracket.line, s.bracket.col) == 1
                collect_from_expr(mono, m, key)
            return
        StmtKind.LocalFieldIndexAssign | StmtKind.MemberIndexAssign =>
            # `h.t[k] = v` (a local's field) / `p.t[k] = v` (through a pointer
            # expression): the base is the field `t`.
            var owner: *Expr = null
            if s.kind == StmtKind.LocalFieldIndexAssign
                owner = si_new_expr(ExprKind.Ident, s.span.line, s.span.col)
                owner.ident = StrView { ptr: s.var_name, len: s.var_name_len as i64 }
            else
                owner = s.if_cond
            if owner == null
                return
            let fbase: *Expr = si_new_expr(ExprKind.Member, owner.span.line, owner.span.col)
            fbase.left = owner
            fbase.ident = StrView { ptr: s.assign_target, len: s.assign_target_len as i64 }
            let fkey: *Expr = s.while_cond
            let fv: *Expr = s.assign_value
            var fcompound: i32 = 0
            if fv != null and fv.kind == ExprKind.Binary and fv.left != null and fv.left.kind == ExprKind.Index and fv.left.right == fkey
                fcompound = 1   # stmt_compound_assign_*_field_index shares the key
            if si_rewrite_assign(mono, m, s, fbase, fkey, fv, fcompound, s.index_at.line, s.index_at.col) == 1
                collect_from_expr(mono, m, fkey)
            return
        _ => pass
    if s.kind != StmtKind.Assign or s.assign_target_len != 0 or s.if_cond == null
        return
    let t: *Expr = s.if_cond
    let v: *Expr = s.assign_value
    var compound: i32 = 0
    if v != null and v.kind == ExprKind.Binary and v.left == t
        compound = 1   # stmt_compound_assign_expr shares the target
    if t.kind == ExprKind.Index
        if t.right == null or t.right.kind == ExprKind.Range
            return
        let key: *Expr = t.right
        if si_rewrite_assign(mono, m, s, t.left, key, v, compound, si_index_line(t), si_index_col(t)) == 1
            collect_from_expr(mono, m, key)
        return
    if t.kind != ExprKind.Member
        return
    var root: *Expr = t
    while root.left != null and root.kind == ExprKind.Member
        root = root.left
    if root.kind != ExprKind.Index or root.right == null or root.right.kind == ExprKind.Range
        return
    var mask: i32 = 0
    var how: i32 = 0
    var recv: *Expr = null
    let name_sv: StrView = si_base_struct(mono, m, root.left, @mask, @how, @recv)
    if name_sv.ptr == null
        return
    if si_check_shown(m, si_index_line(root), si_index_col(root), name_sv, mask, SI_USE_FIELD_STORE) == 0
        return
    if si_refuse_shared_write(mono, m, recv) == 1
        return
    if si_refuse_lent_temporary(how, root.left, 1) == 1
        return
    let key: *Expr = root.right
    key.next = null
    let place: *Expr = si_field_place(t, root)   # before si_into_deref rewrites root
    let call: *Expr = si_method(recv, "index_mut", key, root.span.line, root.span.col)
    si_mark(call, place, SI_USE_FIELD_STORE, 0, s.span.line, s.span.col)
    if compound == 1
        si_once_add(call)
    si_into_deref(root, call)
    collect_from_expr(mono, m, key)

# AGAST #2451: `v[lo..hi]` on a Vec, Span or String local (the value, not a
# pointer to one), or on a field holding one by value (`h.v[lo..hi]`, AGAST
# #3803), is rewritten in place into `v.slice(lo, hi)`, ritz0's lowering
# (_emit_slice): vec_slice<T> and string_slice copy, span_slice is a view.  It
# was a bare address in an i64, so `t[1]` indexed bytes and `t.len` had no
# struct.  As a method call, monomorph instantiates vec_slice$T / span_slice$T
# below and the emitter types `t` as the result.  `lo..=hi` arrives as
# `lo..hi + 1` (index_close_inclusive).  A field may hold the
# collection through a pointer or reference (AGAST #3823).  A slice through a
# pointer is left to index_through, which refuses it (#2448); anything this
# misses is refused by emit_expr_index rather than read as an address.
fn rewrite_value_slice(mono: *MonoCtx, m: *Module, e: *Expr)
    if e == null or e == mono.slice_kept or e.kind != ExprKind.Index or e.right == null or e.right.kind != ExprKind.Range
        return
    # Through a pointer or reference, `p[lo..hi]` and `(*p)[lo..hi]` are both
    # `(*p)[lo..hi]` (R9 rule 2, AGAST #2448): `p.slice(lo, hi)`, which UFCS
    # dispatch passes `p` itself to.
    var base: *Expr = e.left
    if base != null and base.kind == ExprKind.Unary and base.op == OpKind.Deref
        base = base.operand
    if base == null
        return
    # The receiver's collection kind (0 = String, 1 = Vec, 2 = Span) and its
    # `$T` suffix, from a tracked local or from the field a member chain names.
    var kind: i32 = 0
    var suf: *u8 = null
    var suf_len: i32 = 0
    if base.kind == ExprKind.Ident
        let idx: i32 = find_local_var_idx(mono, base.ident)
        if idx < 0
            return
        let by_value: i32 = *(mono.lv_by_value + idx)
        if by_value == 0 or (base != e.left and by_value != 2)
            return
        kind = *(mono.lv_prefix_kind + idx)
        suf = *(mono.lv_suffixes + idx)
        suf_len = *(mono.lv_suffix_lens + idx)
        if kind == 0
            if name_eq(StrView { ptr: (*(mono.lv_type_names + idx)), len: (*(mono.lv_type_name_lens + idx)) as i64 }, "String") == 0
                return
    else if base.kind == ExprKind.Member and base == e.left
        # AGAST #3803: `h.v[lo..hi]` on a field holding a Vec, Span or String
        # by value is `h.v.slice(lo, hi)`, as `h.v[:]` already was.  A field
        # holding a `*T`, `@T` or `@&T` to one slices through it, as a pointer
        # local does (R9 rule 2, AGAST #3823): UFCS passes the pointer the
        # field holds.  A `**T` field (TypeKind.PtrPtr) is left to the emitter.
        let fld: *StructField = resolve_member_field(mono, m, base)
        if fld == null or (fld.field_type != TypeKind.Struct and fld.field_type != TypeKind.Ptr and field_is_ref(fld) == 0)
            return
        kind = classify_collection_type(StrView { ptr: (fld.field_type_name), len: (fld.field_type_name_len) as i64 }, @suf, @suf_len)
        if kind == 0
            if name_eq(StrView { ptr: (fld.field_type_name), len: (fld.field_type_name_len) as i64 }, "String") == 0
                return
    else
        return
    let rng: *Expr = e.right
    let lo: *Expr = rng.left
    if kind == 2 and find_generic_function(m, "span_slice") == null
        # No ritzlib.span (a Span<u8> needs none): the view itself.  `lo` is
        # read for both fields, so as slice_into_span_slot has it: a call is
        # evaluated once (AGAST #3126: `s[idx()..0].len()` was left an index
        # nothing could type), and any other bound must be safe to reread.
        if lo.kind == ExprKind.Call or lo.kind == ExprKind.Method
            si_once_add(lo)
        else if slice_bound_rereadable(lo) == 0
            return
        span_view_in_place(e, view_ptr_name(), StrView { ptr: (suf), len: (suf_len) as i64 })
        return
    e.left = base
    lo.next = rng.right
    rng.right.next = null
    e.kind = ExprKind.Method
    e.ident = "slice"
    e.args = lo
    e.right = null
    e.call_type_suffix = strview_empty()

# AGAST #2501: `let s: Span<T> = v[lo..hi]` on a Vec is a view, as ritz0 makes
# it (_emit_vec_span_slice, LANGUAGE_SPEC §3.4), not vec_slice's copy:
# `Span$T { ptr: v.data + lo, len: hi - lo }`.  `v` is a Vec local, a `*T`,
# `@T` or `@&T` of one (`p[lo..hi]` and `(*p)[lo..hi]` are `(*p)[lo..hi]`, R9
# rule 2, AGAST #2448: `p.data` reads through it), or a by-value Vec field
# (`b.data[lo..hi]`).  `lo` appears in both fields: a call is evaluated once
# (si_once, the emitter shares its register), and any other bound must be free
# of calls, so reading it twice reads the same value.  Returns 1 if `s` is such
# a let; it's rewritten when its bound allows, and is otherwise left as an
# index for the emitter to refuse, located.
fn slice_into_span_annotation(mono: *MonoCtx, m: *Module, s: *Stmt) -> i32
    return slice_into_span_slot(mono, m, s.var_init, StrView { ptr: (s.var_type_name), len: (s.var_type_name_len) as i64 })

# The same view of `e` into any slot of type `tn` (AGAST #2877).
fn slice_into_span_slot(mono: *MonoCtx, m: *Module, e: *Expr, tn_sv: StrView) -> i32
    var tn: *u8 = tn_sv.ptr
    var tn_len: i32 = tn_sv.len as i32
    if e == null or tn == null or tn_len < 5
        return 0
    if not tn_sv.starts_with("Span$")
        return 0
    if e.kind != ExprKind.Index or e.right == null or e.right.kind != ExprKind.Range
        return 0
    var base: *Expr = e.left
    if base != null and base.kind == ExprKind.Unary and base.op == OpKind.Deref
        base = base.operand
    if base == null
        return 0
    var suf: *u8 = null
    var suf_len: i32 = 0
    # A String's slice is a view of its bytes, its `data` Vec (AGAST #4837).
    var string: bool = false
    if base.kind == ExprKind.Ident
        let idx: i32 = find_local_var_idx(mono, base.ident)
        if idx < 0
            return 0
        let kind: i32 = *(mono.lv_prefix_kind + idx)
        string = kind == 0 and name_eq(StrView { ptr: (*(mono.lv_type_names + idx)), len: (*(mono.lv_type_name_lens + idx)) as i64 }, "String") == 1
        if kind != 1 and not string
            return 0
        # The Vec itself, or one level from it (`(*p)` needs the level).
        let by_value: i32 = *(mono.lv_by_value + idx)
        if by_value == 0 or (base != e.left and by_value != 2)
            return 1
        suf = *(mono.lv_suffixes + idx)
        suf_len = *(mono.lv_suffix_lens + idx)
    else if base == e.left and base.kind == ExprKind.Member
        # A by-value Vec or String field, `b.data[0..2]`: the same view of it.
        let rf: *StructField = resolve_member_field(mono, m, e.left)
        if rf == null or rf.field_type != TypeKind.Struct
            return 0
        let ftn: StrView = StrView { ptr: (rf.field_type_name), len: (rf.field_type_name_len) as i64 }
        string = name_eq(ftn, "String") == 1
        if not string and classify_collection_type(ftn, @suf, @suf_len) != 1
            return 0
    else
        return 0
    let lo: *Expr = e.right.left
    if lo.kind == ExprKind.Call or lo.kind == ExprKind.Method
        si_once_add(lo)
    else if slice_bound_rereadable(lo) == 0
        return 1
    e.left = base
    if string
        let bytes: StrView = "$u8"
        suf = bytes.ptr
        suf_len = bytes.len as i32
        e.left = slice_node(ExprKind.Member, e, base, null)
        e.left.ident = "data"
    span_view_in_place(e, "data", StrView { ptr: (suf), len: (suf_len) as i64 })
    return 1

# AGAST #2877: `e` lands in a slot of mangled type `tn`: a return (`-> Span<T>`,
# `-> [T]`, the tail), an argument, or a Span let.  A Vec slice there is the
# view slice_into_span_slot builds, as ritz0 makes it (_expects_span), and a
# variant constructor passes its payload's type on: `Some(b.data[0..1])` into
# `-> Option<[u8]>` is a view of `b.data`, `Ok(v[1..3])` into `Result<Span<T>,
# E>` too.  A slice it can't rewrite is kept (mono.slice_kept) for the emitter to
# refuse, located: as vec_slice's copy it was a Vec in a Span slot.
fn slice_into_expected(mono: *MonoCtx, m: *Module, e: *Expr, tn_sv: StrView)
    var tn: *u8 = tn_sv.ptr
    var tn_len: i32 = tn_sv.len as i32
    if e == null or tn == null or tn_len <= 0
        return
    if e.kind == ExprKind.Index
        if slice_into_span_slot(mono, m, e, tn_sv) == 1 and e.kind == ExprKind.Index
            mono.slice_kept = e
        return
    if e.kind != ExprKind.Call or e.call_type_suffix.len != 0 or e.args == null or e.args.next != null
        return
    let pay_sv: StrView = variant_payload_type(mono.pctx, m, tn_sv, e.func_name)
    if pay_sv.ptr != null and pay_sv.len > 0
        slice_into_expected(mono, m, e.args, pay_sv)

# The return type of the fn whose body collect_from_fn_body walks, and its
# tail statement (a `-> T` fn's value), for slice_into_expected.  null in a
# generic's specialisation, which is left as it was.
# (MonoCtx.mono_ret_name, .mono_ret_len, .mono_tail)

# If `e` is `b[i]` (or `(*b)[i]`) on a Vec or Span, the collection's "$T"
# suffix; empty otherwise.  `b` is a tracked local (the collection itself, or
# a `*`/`@`/`@&` of it, one level: LARB R9) or a field of one.  A range index
# is a slice, not an element.
fn indexed_collection_suffix(mono: *MonoCtx, m: *Module, e: *Expr) -> StrView
    if e.left == null or e.right == null or e.right.kind == ExprKind.Range
        return strview_empty()
    var b: *Expr = e.left
    if b.kind == ExprKind.Unary and b.op == OpKind.Deref
        b = b.operand
    if b == null
        return strview_empty()
    var csuf: *u8 = null
    var csuf_len: i32 = 0
    match b.kind
        ExprKind.Ident =>
            let idx: i32 = find_local_var_idx(mono, b.ident)
            # by_value 0 with a collection kind is a `**Vec<T>`: `b[i]` is a raw
            # buffer of pointers there, not an element of the Vec.
            if idx < 0 or *(mono.lv_prefix_kind + idx) == 0 or *(mono.lv_by_value + idx) == 0
                return strview_empty()
            csuf = *(mono.lv_suffixes + idx)
            csuf_len = *(mono.lv_suffix_lens + idx)
        ExprKind.Member =>
            let rf: *StructField = resolve_member_field(mono, m, b)
            if rf == null or (rf.field_type != TypeKind.Struct and rf.field_type != TypeKind.Ptr)
                return strview_empty()
            if classify_collection_type(StrView { ptr: (rf.field_type_name), len: (rf.field_type_name_len) as i64 }, @csuf, @csuf_len) == 0
                return strview_empty()
        _ =>
            return strview_empty()
    if csuf == null or csuf_len < 2
        return strview_empty()
    StrView { ptr: (csuf), len: (csuf_len) as i64 }

# AGAST #2519: if `e` is `b[i]` on a Vec or Span (indexed_collection_suffix)
# whose element is itself a Vec or Span, return that element's kind and write
# its "$T" suffix to out; 0 otherwise.
fn indexed_element_collection(mono: *MonoCtx, m: *Module, e: *Expr, out_suffix: **u8, out_suffix_len: *i32) -> i32
    let csuf: StrView = indexed_collection_suffix(mono, m, e)
    if csuf.ptr == null
        return 0
    # The collection's suffix is "$<element>": classify the element.
    return classify_collection_type(StrView { ptr: (csuf.ptr + 1), len: csuf.len - 1 }, out_suffix, out_suffix_len)

# AGAST #4838: the type name of the element `e` (`b[i]` on a Vec or Span,
# indexed_collection_suffix) is: `edits[0]` of a `Vec<Edit>` is "Edit", so
# `edits[0].bytes` is Edit's field.  Empty when `e` is no such element.
fn indexed_element_name(mono: *MonoCtx, m: *Module, e: *Expr) -> StrView
    let csuf: StrView = indexed_collection_suffix(mono, m, e)
    if csuf.ptr == null
        return strview_empty()
    StrView { ptr: (csuf.ptr + 1), len: csuf.len - 1 }

fn collect_from_expr(mono: *MonoCtx, m: *Module, e: *Expr)
    if e == null
        return

    rewrite_enum_from_call(mono, m, e)
    # AGAST #3145: `@v[lo..hi]` stays an index, so the emitter refuses it at
    # the index ("can't take the address of a slice").  As `@v.slice(lo, hi)`
    # it was an unlocated "cannot take address".
    if e.kind == ExprKind.Unary and (e.op == OpKind.Addr or e.op == OpKind.AddrMut) and e.operand != null
        if e.operand.kind == ExprKind.Index and e.operand.right != null and e.operand.right.kind == ExprKind.Range
            mono.slice_kept = e.operand
    rewrite_value_slice(mono, m, e)
    rewrite_struct_index(mono, m, e)       # AGAST #1635
    let k: ExprKind = e.kind

    match k
        ExprKind.Call =>
            # Check if this is a generic call (has type suffix)
            inst_site_at(mono, e)   # AGAST #4844: what this call names, it names here
            if e.call_type_suffix.len > 0
                add_instantiation(mono, e.func_name, e.call_type_suffix)
            # AGAST #1824: format_into(sink, "...") appends through
            # `sink.push_bytes(..)`, so a generic sink (`*Vec<u8>`) wants that
            # impl method (Vec$u8.push_bytes, and through it vec_push_bytes$u8)
            # even when nothing else calls it (#4303).
            if e.args != null and name_eq(e.func_name, "format_into") == 1
                want_receiver_method(mono, m, e.args, "push_bytes")
            want_interp_methods(mono, m, e)   # AGAST #3617
            # Recurse into arguments, each into its parameter's slot (AGAST #2877).
            let callee: *FnDef = slice_callee(m, e)
            var par: *Param = null
            if callee != null
                par = callee.params
            var arg: *Expr = e.args
            while arg != null
                if par != null
                    if par.param_type == TypeKind.Struct
                        slice_into_expected(mono, m, arg, StrView { ptr: (par.param_type_name), len: (par.param_type_name_len) as i64 })
                    par = par.next
                collect_from_expr(mono, m, arg)
                arg = arg.next
        ExprKind.StructLit =>
            # Check if struct literal is for a generic struct (has $ in name)
            if e.ident.ptr != null and e.ident.len > 0
                add_struct_from_mangled_name(mono, m, e.ident)
            # Recurse into field initializers.  The parser stores a *FieldInit
            # list in e.args (recast to *Expr — see ident_or_struct /
            # generic_struct_lit in ast_helpers.ritz).  Walking it as *Expr is
            # an alias-bug: FieldInit is 32 bytes so reading Expr.next at
            # offset 120 returns heap garbage and segfaults on most non-null
            # values (e.g. 0x8 from cryptosec/aes_gcm.ritz, which is what
            # blocks valet).  Walk the FieldInit chain directly and recurse
            # into each field's value expression.
            # AGAST #3706: each value lands in its field's slot, so a Vec slice
            # in a `Span<T>` field (`H { s: v[1..3] }`) is a view, as ritz0 makes
            # it.  As vec_slice's copy it stored a Vec$T as the Span$T field.
            var st: *StructDef = null
            if e.ident.ptr != null and e.ident.len > 0
                st = find_concrete_struct(m, e.ident)
            var fi: *FieldInit = e.args as *FieldInit
            while fi != null
                if fi.value != null
                    if st != null
                        var sf: *StructField = st.fields
                        while sf != null
                            if name_eq(StrView { ptr: (sf.name), len: (sf.name_len) as i64 }, StrView { ptr: (fi.name), len: (fi.name_len) as i64 }) == 1
                                if sf.field_type == TypeKind.Struct
                                    slice_into_expected(mono, m, fi.value, StrView { ptr: (sf.field_type_name), len: (sf.field_type_name_len) as i64 })
                                sf = null
                            else
                                sf = sf.next
                    collect_from_expr(mono, m, fi.value)
                fi = fi.next
        ExprKind.Binary =>
            collect_from_expr(mono, m, e.left)
            collect_from_expr(mono, m, e.right)
        ExprKind.Unary =>
            collect_from_expr(mono, m, e.operand)
        ExprKind.Index =>
            collect_from_expr(mono, m, e.left)   # base
            collect_from_expr(mono, m, e.right)  # index
        ExprKind.Member =>
            collect_from_expr(mono, m, e.left)  # base
        ExprKind.Method =>
            # `v.push(..)` names the impl method Vec<T>.push; specialising it
            # instantiates the vec_push<T> its body calls (AGAST #3617, #4303).
            inst_site_at(mono, e)   # AGAST #4844
            want_receiver_method(mono, m, e.left, e.ident)   # AGAST #3617
            collect_from_expr(mono, m, e.left)  # receiver
            # Each argument into its parameter's slot, as a call's are (AGAST
            # #4837): `h.rec(v[0..n])` into `a: [u8]` is a view, not a copy.
            var par: *Param = method_slot_params(mono, m, e)
            var arg: *Expr = e.args
            while arg != null
                if par != null
                    if par.param_type == TypeKind.Struct
                        slice_into_expected(mono, m, arg, StrView { ptr: (par.param_type_name), len: (par.param_type_name_len) as i64 })
                    par = par.next
                collect_from_expr(mono, m, arg)
                arg = arg.next
        ExprKind.Cast =>
            # AGAST #3124: the struct a cast names, `x as *Box<i64>` / `x as
            # Box<i64>` (apply_cast_tail records it in ident), is instantiated
            # as a declared type's is: a `let p = x as *Box<i64>` may be its only
            # mention, and `p.v` then had no Box$i64 to resolve.
            if e.ident.ptr != null and e.ident.len > 0
                add_struct_from_mangled_name(mono, m, e.ident)
            # Parser stores operand in e.left, not e.operand
            collect_from_expr(mono, m, e.left)
        ExprKind.TypeOperand =>
            # `sizeof(Box<i64>)` (AGAST #3268) may be Box<i64>'s only mention,
            # and an uninstantiated Box$i64 can't be sized.
            if e.type_kind == TypeKind.Struct and e.ident.ptr != null and e.ident.len > 0
                add_struct_from_mangled_name(mono, m, e.ident)
        ExprKind.Range =>
            # Range: start..end (left=start, right=end).  Generic calls inside
            # ranges (e.g. `for i in 0..vec_len<u8>(v)`) must propagate.
            collect_from_expr(mono, m, e.left)
            collect_from_expr(mono, m, e.right)
        ExprKind.Try =>
            # `expr?` — recurse into the wrapped expression.
            collect_from_expr(mono, m, e.left)
        ExprKind.ArrayLit =>
            # [a, b, c]: the elements are the args list.  Without this a generic
            # call that is an element was never instantiated (AGAST #2831).
            var el: *Expr = e.args
            while el != null
                collect_from_expr(mono, m, el)
                el = el.next
        ExprKind.ArrayFill =>
            # [value; N] keeps value in left (AGAST #2831)
            collect_from_expr(mono, m, e.left)
        ExprKind.Match | ExprKind.If =>
            # ExprKind.If (#1613) has the same shape: condition in left, arms in args.
            # match scrutinee \n pattern => body
            # Scrutinee is e.left; arms are e.args recast as *MatchArm.
            # Each arm has body: *Expr (or null for `pass` arms).  Walking
            # arms as *Expr would crash for the same reason struct lits did.
            collect_from_expr(mono, m, e.left)
            var scrut: *Expr = null
            if k == ExprKind.Match
                scrut = e.left
            collect_from_arms(mono, m, scrut, e.args as *MatchArm)
        _ => pass

# ============================================================================
# Generic Function Lookup
# ============================================================================
# Find the generic template for a given function name

fn clone_and_specialize_function(mono: *MonoCtx, m: *Module, template: *FnDef, suffix_sv: StrView) -> *FnDef
    var suffix: *u8 = suffix_sv.ptr
    let n: i32 = count_type_params(template.type_params)
    if n < 2
        var tp_name: *u8 = null
        var tp_len: i32 = 0
        if template.type_params != null
            tp_name = template.type_params.name
            tp_len = template.type_params.name_len
        let one: *FnDef = specialize_fn_one_param(mono, m, template, StrView { ptr: (tp_name), len: (tp_len) as i64 }, suffix_sv)
        collect_receiver_methods(mono, m, one)
        return one

    let cap: i64 = 4 * mangled_arg_capacity(suffix_sv) as i64
    let starts: *i32 = malloc(cap) as *i32
    let lens: *i32 = malloc(cap) as *i32
    if split_mangled_args(mono.pctx, m, suffix_sv, starts, lens) != n
        # Wrong arity for this template (e.g. `pair<i64>`): nothing sound to
        # emit.  The call stays unresolved and fails at link, loudly.
        return null
    mono.mono_component_mode = 1
    var cur: *FnDef = template
    var tp: *TypeParam = template.type_params
    var i: i32 = 0
    while tp != null
        cur = specialize_fn_one_param(mono, m, cur, StrView { ptr: (tp.name), len: (tp.name_len) as i64 }, StrView { ptr: (suffix + *(starts + i)), len: (*(lens + i)) as i64 })
        tp = tp.next
        i = i + 1
    mono.mono_component_mode = 0
    # Walked as a one-parameter specialisation is: its params seeded, so a
    # receiver's type is the param's, not a stale local's (AGAST #3617).
    collect_receiver_methods(mono, m, cur)
    cur

# AGAST #2412: walk a one-parameter specialisation's finished body, as the
# multi-parameter path does, so a method on a local the substitution made
# concrete registers its UFCS helper: `v.push(a)` in `mk<T>` with
# `v: Vec<T>` needs `vec_push$i32` in `mk$i32`.  clone_expr registers only
# explicit generic calls (`vec_push<T>(@&v, a)`); a method's helper is named
# by its receiver's type, which only the local-var tracker knows.  Templates
# are never walked, so the receiver's `Vec$T` never registered `vec_push$T`.
fn collect_receiver_methods(mono: *MonoCtx, m: *Module, f: *FnDef)
    if f == null
        return
    let saved_ret: *u8 = mono.mono_ret_name
    let saved_ret_len: i32 = mono.mono_ret_len
    let saved_tail: *Stmt = mono.mono_tail
    reset_local_var_tracker(mono)
    var pp: *Param = f.params
    while pp != null
        if mono.impl_self_len > 0 and param_is_self(pp) == 1 and pp.param_type_name_len == 0
            # AGAST #3617: a bare `self` / `self:&` of the impl method being
            # specialised is its instance, which name_untyped_self names only
            # afterwards: `self.m()` wants `m` there alone.
            track_typed_local_through(mono, StrView { ptr: (pp.name), len: (pp.name_len) as i64 }, TypeKind.MutRef, TypeKind.Struct, StrView { ptr: (mono.impl_self_name), len: (mono.impl_self_len) as i64 })
        else
            track_typed_local_through(mono, StrView { ptr: (pp.name), len: (pp.name_len) as i64 }, pp.param_type, pp.param_pointee_type, StrView { ptr: (pp.param_type_name), len: (pp.param_type_name_len) as i64 })
        pp = pp.next
    set_mono_fn_context(mono, null)   # A specialisation has no slot context (#2877).
    collect_from_fn_body(mono, m, f.body)
    mono.mono_ret_name = saved_ret
    mono.mono_ret_len = saved_ret_len
    mono.mono_tail = saved_tail

# Rewrite every `$`-separated component of `name` that equals type_param to
# the argument of the one-argument suffix "$arg" (new_suffix):
# `Result$T$E` at T="$i32" is `Result$i32$E`; `T` alone is `i32`.  A
# component that is a tuple over type_param is that tuple's instantiation
# (AGAST #2975): `Vec$tuple_K_V` at K="$i32" is `Vec$tuple_i32_V`.  Returns
# `name` itself (and *out_len = name_len) when no component matches.
fn replace_param_component(mono: *MonoCtx, name_sv: StrView, type_param_sv: StrView, new_suffix_sv: StrView) -> StrView
    return subst_components(mono, name_sv, type_param_sv, new_suffix_sv, 1)

# replace_param_component, or with plain == 0 only its tuple components.
fn subst_components(mono: *MonoCtx, name_sv: StrView, type_param_sv: StrView, new_suffix_sv: StrView, plain: i32) -> StrView
    var name: *u8 = name_sv.ptr
    var name_len: i32 = name_sv.len as i32
    var type_param: *u8 = type_param_sv.ptr
    var type_param_len: i32 = type_param_sv.len as i32
    var new_suffix: *u8 = new_suffix_sv.ptr
    var new_suffix_len: i32 = new_suffix_sv.len as i32
    if name == null or type_param == null or new_suffix_len < 1
        return strview_from_ptr(name, name_len as i64)
    let arg: *u8 = new_suffix + 1
    let arg_len: i32 = new_suffix_len - 1
    # Pass 1: each component's replacement, to size the output.  A tuple's
    # is registered once (tuple_subst is idempotent), so pass 2 asks again.
    var hits: i32 = 0
    var total: i32 = 0
    var pos: i32 = 0
    while pos <= name_len
        var end: i32 = pos
        while end < name_len and *(name + end) != '$'   # '$'
            end = end + 1
        if plain == 1 and end - pos == type_param_len and memcmp(name + pos, type_param, type_param_len as i64) == 0
            hits = hits + 1
            total = total + arg_len
        else if tuple_subst(mono, StrView { ptr: (name + pos), len: (end - pos) as i64 }, type_param_sv, new_suffix_sv).ptr != null
            hits = hits + 1
            total = total + tuple_subst(mono, StrView { ptr: (name + pos), len: (end - pos) as i64 }, type_param_sv, new_suffix_sv).len as i32
        else if plain == 1 and piece_param_head(StrView { ptr: (name + pos), len: (end - pos) as i64 }, type_param_sv) > 0
            hits = hits + 1
            total = total + piece_param_head(StrView { ptr: (name + pos), len: (end - pos) as i64 }, type_param_sv) + arg_len
        else
            total = total + end - pos
        if end < name_len
            total = total + 1
        pos = end + 1
    if hits == 0
        return strview_from_ptr(name, name_len as i64)
    # Pass 2: build it.
    let out: *u8 = malloc(total as i64 + 1) as *u8
    var o: i32 = 0
    pos = 0
    while pos <= name_len
        var end: i32 = pos
        while end < name_len and *(name + end) != '$'
            end = end + 1
        var tn_sv: StrView = strview_empty()
        if plain == 1 and end - pos == type_param_len and memcmp(name + pos, type_param, type_param_len as i64) == 0
            for j in 0..arg_len
                *(out + o) = *(arg + j)
                o = o + 1
        else
            tn_sv = tuple_subst(mono, StrView { ptr: (name + pos), len: (end - pos) as i64 }, type_param_sv, new_suffix_sv)
            let head: i32 = piece_param_head(StrView { ptr: (name + pos), len: (end - pos) as i64 }, type_param_sv)
            if tn_sv.ptr != null
                for j in 0..(tn_sv.len as i32)
                    *(out + o) = *((tn_sv.ptr) + j)
                    o = o + 1
            else if plain == 1 and head > 0
                # AGAST #3748: `ptr_A` at A = `Box2_u8` is `ptr_Box2_u8`.
                for j in pos..(pos + head)
                    *(out + o) = *(name + j)
                    o = o + 1
                for j in 0..arg_len
                    *(out + o) = *(arg + j)
                    o = o + 1
            else
                for j in pos..end
                    *(out + o) = *(name + j)
                    o = o + 1
        if end < name_len
            *(out + o) = 36
            o = o + 1
        pos = end + 1
    *(out + o) = 0
    strview_from_ptr(out, o as i64)

# The module being monomorphized (AGAST #2975).  Not mono.mono_module, which
# is set only once a fn is specialised: a struct's `f: (T, i32)` is
# substituted before any may be, and names_generic_struct reads that one.
# (MonoCtx.tuple_module)

# AGAST #2975: the tuple `name` (a template over type_param, see
# ast_helpers' tuple_mark_generic) with type_param bound to the one-argument
# suffix "$arg": `tuple_T_T` at T="$i32" is `tuple_i32_i32`, laid out
# `{i32, i32}`, registered the first time and put in the module being
# specialised once no parameter is left in it.  null when `name` is no
# tuple over type_param.
fn tuple_subst(mono: *MonoCtx, name_sv: StrView, type_param_sv: StrView, suffix_sv: StrView) -> StrView
    var type_param: *u8 = type_param_sv.ptr
    var type_param_len: i32 = type_param_sv.len as i32
    var suffix: *u8 = suffix_sv.ptr
    var suffix_len: i32 = suffix_sv.len as i32
    let r: *TupleReg = tuple_reg_lookup(mono.pctx, name_sv)
    if r == null or type_param_index(r.def.type_params, type_param_sv) < 0
        return strview_empty()
    var elems: *TupleElem = null
    var last_e: *TupleElem = null
    var fields: *StructField = null
    var last_f: *StructField = null
    var total: i32 = 5   # "tuple"
    var e: *TupleElem = r.elems
    var f: *StructField = r.def.fields
    while e != null and f != null
        var sp: *u8 = null
        var sl: i32 = generic_arg_spelling(e.ga, @sp)
        let nf: *StructField = malloc(sizeof(StructField)) as *StructField
        *nf = *f
        nf.next = null
        if f.field_type == TypeKind.Struct and f.field_type_name != null
            if name_is_type_param(StrView { ptr: (f.field_type_name), len: (f.field_type_name_len) as i64 }, type_param_sv) == 1
                var sn: *u8 = null
                var snl: i32 = 0
                get_type_name_from_suffix(suffix_sv, @sn, @snl)
                subst_value_field(nf, parse_type_from_suffix(suffix_sv), StrView { ptr: (sn), len: (snl) as i64 })
                sp = suffix + 1
                sl = suffix_len - 1
            else
                let nn_sv: StrView = replace_param_component(mono, StrView { ptr: (f.field_type_name), len: (f.field_type_name_len) as i64 }, type_param_sv, suffix_sv)
                nf.field_type_name = nn_sv.ptr
                nf.field_type_name_len = nn_sv.len as i32
                sp = nn_sv.ptr
                sl = nn_sv.len as i32
        else if tuple_elem_points_at(f, type_param_sv) == 1
            # AGAST #3173: `*T` / `@T` / `@&T` at T = the argument, spelt as
            # ritz0 mangles it: the template's `ptr_T` / `ref_T` / `refmut_T`
            # with its trailing T replaced, so `(*T, i32)` at T = i32 is
            # `tuple_ptr_i32_i32` (and at T = *u8, `tuple_ptr_ptr_u8_i32`).
            var sn: *u8 = null
            var snl: i32 = 0
            get_type_name_from_suffix(suffix_sv, @sn, @snl)
            let st: TypeKind = parse_type_from_suffix(suffix_sv)
            if f.field_type == TypeKind.PtrPtr
                # AGAST #3184: `**T` (`tuple_ptr_ptr_i32_i32`).
                subst_ptr_ptr_field(nf, st, StrView { ptr: (sn), len: (snl) as i64 })
            else
                subst_pointee_field(nf, st, StrView { ptr: (sn), len: (snl) as i64 })
            # The pointee as field_new records a written `*i32` / `**u8`:
            # tuple_split_decl types the bound local from it.
            if f.field_type == TypeKind.Ptr
                if nf.field_type == TypeKind.PtrPtr
                    nf.ptr_pointee = TypeKind.Void
                    nf.inner_pointee_type = (primitive_type_from_name(StrView { ptr: (sn), len: (snl) as i64 }) as i32)
                    if nf.inner_pointee_type == 0
                        nf.inner_pointee_type = (TypeKind.Struct as i32)
                else
                    nf.ptr_pointee = st
            let keep: i32 = sl - type_param_len
            let ps: *u8 = malloc((keep + suffix_len) as i64) as *u8
            memcpy(ps, sp, keep as i64)
            memcpy(ps + keep, suffix + 1, (suffix_len - 1) as i64)
            sp = ps
            sl = keep + suffix_len - 1
        let ga: *GenericArg = calloc(1, sizeof(GenericArg)) as *GenericArg
        ga.ty = TypeKind.Struct   # only its spelling is read again
        ga.name = sp
        ga.name_len = sl
        let ne: *TupleElem = calloc(1, sizeof(TupleElem)) as *TupleElem
        ne.ga = ga
        ne.field = nf
        if last_e == null
            elems = ne
            fields = nf
        else
            last_e.next = ne
            last_f.next = nf
        last_e = ne
        last_f = nf
        total = total + 1 + sl
        e = e.next
        f = f.next
    let nm: *u8 = malloc(total as i64 + 1) as *u8
    let tuple_lit: StrView = "tuple"
    memcpy(nm, tuple_lit.ptr, tuple_lit.len)
    var pos: i32 = 5
    e = elems
    while e != null
        *(nm + pos) = 95   # '_'
        pos = pos + 1
        memcpy(nm + pos, e.ga.name, e.ga.name_len as i64)
        pos = pos + e.ga.name_len
        e = e.next
    *(nm + pos) = 0
    var got: *TupleReg = tuple_reg_lookup(mono.pctx, StrView { ptr: (nm), len: (pos) as i64 })
    if got == null
        # The parameters left: the template's, less type_param.
        var rest: *TypeParam = null
        var tp: *TypeParam = r.def.type_params
        while tp != null
            if name_is_type_param(StrView { ptr: (tp.name), len: (tp.name_len) as i64 }, type_param_sv) == 0
                let c: *TypeParam = calloc(1, sizeof(TypeParam)) as *TypeParam
                c.name = tp.name
                c.name_len = tp.name_len
                c.next = rest
                rest = c
            tp = tp.next
        let def: *StructDef = calloc(1, sizeof(StructDef)) as *StructDef
        def.name = nm
        def.name_len = pos
        def.fields = fields
        def.type_params = rest
        got = tuple_reg_add(mono.pctx, def, elems)
    tuple_reg_place(got, mono.tuple_module)
    strview_from_ptr(got.def.name, got.def.name_len as i64)

# 1 when tuple element f is `*T` / `@T` / `@&T` (AGAST #3173) or `**T`
# (AGAST #3184), T = type_param.
fn tuple_elem_points_at(f: *StructField, type_param_sv: StrView) -> i32
    if f.field_type != TypeKind.Ptr and f.field_type != TypeKind.PtrPtr and f.field_type != TypeKind.Ref and f.field_type != TypeKind.MutRef
        return 0
    name_is_type_param(StrView { ptr: (f.field_type_name), len: (f.field_type_name_len) as i64 }, type_param_sv)

# Specialise `template` at ONE type parameter (type_param_name) bound to the
# one-argument suffix "$arg".  The result's name is template.name + suffix.
fn specialize_fn_one_param(mono: *MonoCtx, m: *Module, template: *FnDef, type_param_name_sv: StrView, suffix_sv: StrView) -> *FnDef
    var type_param_name: *u8 = type_param_name_sv.ptr
    var type_param_len: i32 = type_param_name_sv.len as i32
    var suffix: *u8 = suffix_sv.ptr
    var suffix_len: i32 = suffix_sv.len as i32
    mono.mono_module = m  # AGAST #1926: see names_generic_struct
    # Create a new FnDef with mangled name
    let mangled_name_len: i32 = template.name_len + suffix_len
    let mangled_name: *u8 = malloc(mangled_name_len as i64 + 1) as *u8

    # Copy base name
    for i in 0..template.name_len
        *(mangled_name + i) = *(template.name + i)

    # Copy suffix (including the $)
    for j in 0..suffix_len
        *(mangled_name + template.name_len + j) = *(suffix + j)
    *(mangled_name + mangled_name_len) = 0

    # Get the substitution type from suffix
    var subst_type_name: *u8 = null
    var subst_type_len: i32 = 0
    get_type_name_from_suffix(suffix_sv, @subst_type_name, @subst_type_len)
    let subst_type: TypeKind = parse_type_from_suffix(suffix_sv)

    # Clone the function with specialized name
    # Sized with sizeof(FnDef) (AGAST #1663) — type_params lives at the
    # tail.  Earlier code used malloc(88), undersizing the struct by one
    # pointer slot.  In selfhost ritz1 that meant `specialized.type_params =
    # null` wrote into adjacent heap, leaving type_params junked → emit_module's
    # `if f.type_params != null` skipped the specialized fn → only `declare`
    # emitted at the call site, with i64 fallback types.  Cluster of 4+
    # selfhost asm-fails fixed by widening this allocation.
    let specialized: *FnDef = malloc(sizeof(FnDef)) as *FnDef
    specialized.name = mangled_name
    specialized.name_len = mangled_name_len
    specialized.params = clone_params_with_suffix(mono, template.params, type_param_name_sv, subst_type, StrView { ptr: (subst_type_name), len: (subst_type_len) as i64 }, suffix_sv)
    specialized.return_type = substitute_type(template.return_type, type_param_name_sv, subst_type, StrView { ptr: (subst_type_name), len: (subst_type_len) as i64 })
    specialized.body = clone_body(mono, template.body, type_param_name_sv, subst_type, StrView { ptr: (subst_type_name), len: (subst_type_len) as i64 }, suffix_sv)
    specialized.type_params = null  # Not generic anymore
    specialized.next = null
    specialized.line = template.line
    specialized.return_type_name = template.return_type_name
    specialized.return_type_name_len = template.return_type_name_len
    # AGAST #194: monomorphizations are emitted in every module that uses
    # them, each module's copy `internal` (AGAST #4609: it was `linkonce_odr`,
    # but two types of one name in one program each have an instance).
    # Mark is_local=1 so the emit_fn loop emits the body (rather than a
    # `declare`).
    specialized.is_local = 1
    specialized.ret_fn_sig = template.ret_fn_sig   # AGAST #2120
    specialized.ret_ref = clone_params_with_suffix(mono, template.ret_ref, type_param_name_sv, subst_type, StrView { ptr: (subst_type_name), len: (subst_type_len) as i64 }, suffix_sv)   # AGAST #2308
    specialized.ret_array = null   # AGAST #2343: `[N]T` keeps T's own name; left unjudged
    specialized.ret_array_param = clone_params_with_suffix(mono, template.ret_array_param, type_param_name_sv, subst_type, StrView { ptr: (subst_type_name), len: (subst_type_len) as i64 }, suffix_sv)   # AGAST #2302
    specialized.ret_ptr_array = ptr_array_unless_generic(template.ret_ptr_array)   # AGAST #2329
    specialized.def_file = template.def_file   # AGAST #2236: names the diagnostic's file
    specialized.is_pub = 1   # AGAST #3419: an instance has no declaration to mark `pub`
    specialized.col = template.col
    specialized.extern_decl = 0
    specialized.inst_site = null   # AGAST #4844: its caller sets it
    fn_copy_instance_attrs(mono.pctx, specialized, template)   # [[callconv]] / [[test_helper]] / inline family (#1879, #1869, #1961)

    # Handle return type struct name substitution
    match specialized.return_type
        TypeKind.Struct =>
            if specialized.return_type_name != null
                # Check if it matches the type param exactly (e.g., "T" -> "u8")
                if specialized.return_type_name_len == type_param_len
                    if memcmp(specialized.return_type_name, type_param_name, type_param_len as i64) == 0
                        # Substitute with concrete type
                        specialized.return_type = subst_type
                        specialized.return_type_name = subst_type_name
                        specialized.return_type_name_len = subst_type_len
                        # AGAST #2305: `-> T` at T = `[N]E` returns the `[N x E]`.
                        if subst_type == TypeKind.Array and specialized.ret_array_param == null
                            let rap: *Param = calloc(1, sizeof(Param)) as *Param
                            if param_take_array_arg(rap, StrView { ptr: (subst_type_name), len: (subst_type_len) as i64 }) == 1
                                specialized.ret_array_param = rap
                                specialized.return_type_name = rap.param_type_name
                                specialized.return_type_name_len = rap.param_type_name_len
                # Otherwise it might be a generic struct like "Vec$T" -> "Vec$u8"
                else
                    var new_name: *u8 = null
                    var new_len: i32 = 0
                    substitute_type_param_in_name(mono, StrView { ptr: (specialized.return_type_name), len: (specialized.return_type_name_len) as i64 }, type_param_name_sv, suffix_sv, @new_name, @new_len)
                    specialized.return_type_name = new_name
                    specialized.return_type_name_len = new_len
        # AGAST #1980: `-> *T` names its pointee "T" too.  Left unsubstituted,
        # `let p = vec_as_ptr<i32>(@v)` registered p as a pointer to struct %T
        # (`load %T`, byte stride).  Name the concrete pointee instead: a
        # primitive ("i32", which the let path maps to a pointee kind) or a
        # struct.
        #
        # AGAST #2791: T = *U ($ptr_ suffix) makes the return `**U`, recorded as
        # a written `-> **U` is (TypeKind.PtrPtr, named U).  It stayed a `*T` named
        # "T", which no stride lookup resolves, so `vec_as_ptr<*u8>(@v) + i`
        # added i BYTES and execve got byte-shifted argv pointers (#2790).
        TypeKind.Ptr =>
            if specialized.return_type_name != null and specialized.return_type_name_len == type_param_len
                if memcmp(specialized.return_type_name, type_param_name, type_param_len as i64) == 0
                    if subst_type == TypeKind.Ptr
                        specialized.return_type = TypeKind.PtrPtr
                    specialized.return_type_name = subst_type_name
                    specialized.return_type_name_len = subst_type_len
            # AGAST #3179: `-> *W<T>` points at "W$T", as `-> W<T>` names it: the
            # instance is "W$i32".  Left unsubstituted, find_struct missed it and
            # `g(@w).v` / `w.g().v` were "unhandled EXPR_MEMBER".
            else if specialized.return_type_name != null
                var p_name: *u8 = null
                var p_len: i32 = 0
                substitute_type_param_in_name(mono, StrView { ptr: (specialized.return_type_name), len: (specialized.return_type_name_len) as i64 }, type_param_name_sv, suffix_sv, @p_name, @p_len)
                specialized.return_type_name = p_name
                specialized.return_type_name_len = p_len
        # AGAST #3015: and `-> @T` / `-> @&T` (Deref's `deref`, R17): the referent
        # is T's concrete name, so `(*b.deref()).f` finds T's field.
        TypeKind.Ref | TypeKind.MutRef =>
            if specialized.return_type_name != null and specialized.return_type_name_len == type_param_len
                if memcmp(specialized.return_type_name, type_param_name, type_param_len as i64) == 0
                    specialized.return_type_name = subst_type_name
                    specialized.return_type_name_len = subst_type_len
        _ => pass

    # AGAST #3101: a bare `-> T` at T = `*[N]E` / `@&[N]E` returns that array
    # pointer, recorded as a written `-> *[N]E` is, so `let p = id<*[2]i32>(@a)`
    # knows N and E.  It was a `*arr2_i32` struct pointer: `p[1]` read 0, SILENT.
    if specialized.ret_ptr_array == null and template.return_type == TypeKind.Struct and subst_type == TypeKind.Ptr
        if name_is_type_param(StrView { ptr: (template.return_type_name), len: (template.return_type_name_len) as i64 }, type_param_name_sv) == 1
            specialized.ret_ptr_array = ptr_array_arg_param(StrView { ptr: (subst_type_name), len: (subst_type_len) as i64 })
    # AGAST #3986: and `-> *T` at T = `[N]E` points at that array, as a written
    # `-> *[N]E` does.  ritzlib's `__heap_new<[2]P>` (`heap [a, b]`) returned a
    # `*arr2_P` struct pointer, so `p[0]` and `p[0].c` on its result failed.
    if specialized.ret_ptr_array == null and template.return_type == TypeKind.Ptr and subst_type == TypeKind.Array
        if name_is_type_param(StrView { ptr: (template.return_type_name), len: (template.return_type_name_len) as i64 }, type_param_name_sv) == 1
            specialized.ret_ptr_array = ptr_array_arg_param(StrView { ptr: (subst_type_name), len: (subst_type_len) as i64 })

    return specialized

# AGAST #3101: `param` points at the array a type argument spelled `arrN_E`
# names (N, E, E's pointee and name), as a written `*[N]E` would; unchanged
# when `name` spells no array.
fn param_take_ptr_array_arg(param: *Param, name_sv: StrView)
    var name: *u8 = name_sv.ptr
    let pa: *Param = ptr_array_arg_param(name_sv)
    if pa == null
        return
    param.param_pointee_array_size = pa.param_pointee_array_size
    param.param_pointee_array_elem_type = pa.param_pointee_array_elem_type
    param.param_pointee_array_elem_pointee = pa.param_pointee_array_elem_pointee
    param.param_pointee_array_shape = null
    param.param_type_name = pa.param_type_name
    param.param_type_name_len = pa.param_type_name_len

# AGAST #2305: a by-value `a: T` (or `-> T`) at T = `[N]E` is the `a: [N]E` it
# says: N, E, E's pointee and struct name from the `arrN_E` type argument, as
# a written `[N]E` param records them.  It stayed TypeKind.Array with no N, so the
# call refused `g<[4]i32>(a)` as the wrong length.  0 when `name` spells no array.
fn param_take_array_arg(param: *Param, name_sv: StrView) -> i32
    var arr: ArrayArg
    if array_arg_decode(name_sv, @arr) == 0
        return 0
    param.param_type = TypeKind.Array
    param.param_array_size = arr.size
    param.param_array_elem_type = arr.elem
    param.param_array_elem_pointee = arr.pointee
    param.param_array_shape = arr.shape   # AGAST #3634
    param.param_type_name = arr.name
    param.param_type_name_len = arr.name_len
    1

fn name_is_type_param(name_sv: StrView, tp_sv: StrView) -> i32
    var name: *u8 = name_sv.ptr
    var len: i32 = name_sv.len as i32
    var tp: *u8 = tp_sv.ptr
    var tp_len: i32 = tp_sv.len as i32
    (name != null and len == tp_len and memcmp(name, tp, tp_len as i64) == 0) as i32

# AGAST #3101: the `*[N]E` a type argument spelled `arrN_E` points at, as a
# Param ptr_array_of_last would record (N, E, E's pointee and name); null when
# `name` spells no array.
fn ptr_array_arg_param(name_sv: StrView) -> *Param
    var arr: ArrayArg
    if array_arg_decode(name_sv, @arr) == 0
        return null
    let pa: *Param = calloc(1, sizeof(Param)) as *Param
    pa.param_type = TypeKind.Ptr
    pa.param_pointee_type = TypeKind.Array
    pa.param_pointee_array_size = arr.size
    pa.param_pointee_array_elem_type = arr.elem
    pa.param_pointee_array_elem_pointee = arr.pointee
    pa.param_type_name = arr.name
    pa.param_type_name_len = arr.name_len
    pa

# `sh` with a leaf `T` substituted (AGAST #2290).  Shapes are shared, so a change
# is a copy.
fn array_shape_subst(sh: *ArrayShape, type_param_sv: StrView, subst_type: TypeKind, subst_name_sv: StrView) -> *ArrayShape
    var type_param: *u8 = type_param_sv.ptr
    var type_param_len: i32 = type_param_sv.len as i32
    var subst_name: *u8 = subst_name_sv.ptr
    var subst_len: i32 = subst_name_sv.len as i32
    if sh == null or sh.leaf_name_len != type_param_len or memcmp(sh.leaf_name, type_param, type_param_len as i64) != 0
        return sh
    let out: *ArrayShape = malloc(sizeof(ArrayShape)) as *ArrayShape
    *out = *sh
    out.leaf_type = subst_type
    out.leaf_name = subst_name
    out.leaf_name_len = subst_len
    return out

# AGAST #3119: `sh` with a generic leaf's `$T` rewritten, `[2][3]P<T>` (leaf
# `P$T`) at T = i64 is leaf `P$i64`.  Shared as it stood, `W$i64.a` named the
# `%P$T` no struct is, and `w.a[1][2].v` fell to "unhandled EXPR_MEMBER".
fn array_shape_mangled_subst(mono: *MonoCtx, sh: *ArrayShape, type_param_sv: StrView, suffix_sv: StrView) -> *ArrayShape
    if sh == null or sh.leaf_name == null or find_dollar_sign(StrView { ptr: (sh.leaf_name), len: (sh.leaf_name_len) as i64 }) <= 0
        return sh
    let out: *ArrayShape = malloc(sizeof(ArrayShape)) as *ArrayShape
    *out = *sh
    var n: i32 = 0
    substitute_type_param_in_name(mono, StrView { ptr: (sh.leaf_name), len: (sh.leaf_name_len) as i64 }, type_param_sv, suffix_sv, @out.leaf_name, @n)
    out.leaf_name_len = n
    return out

# A reference param that holds a pointer records what that pointer points at,
# and a `:&` one reads as the pointer, so it needs it twice.
fn set_ref_ptr_pointee(param: *Param, pointee: TypeKind)
    param.param_ref_ptr_pointee = pointee
    if param.is_borrow == 1
        param.param_inner_pointee_type = (pointee as i32)

# What a `*U` type argument points at, from get_type_name_from_suffix's name for
# it: U's spelling, which is `ptr_C` when U is itself the pointer `*C`.
fn ptr_arg_pointee(name_sv: StrView) -> TypeKind
    var name: *u8 = name_sv.ptr
    var len: i32 = name_sv.len as i32
    if len > 4 and name_sv.starts_with("ptr_")
        return TypeKind.Ptr
    # AGAST #3101: `*[N]E` points at an array, not a struct named `arrN_E`.
    var arr: ArrayArg
    if array_arg_decode(name_sv, @arr) == 1
        return TypeKind.Array
    let prim: TypeKind = primitive_type_from_name(name_sv)
    if prim != TypeKind.Void
        return prim
    TypeKind.Struct

# AGAST #2086: `r:& T` at T = `**S` (any depth) borrows a `**S`, recorded as a
# written `r:& **S` is (pointee TypeKind.PtrPtr, S's depth-packed slot, S's
# name), so it binds as one (param_borrows_struct_ptr_ptr).  It was left
# `r:& *<ptr_S>`, which binds as nothing: `r` read as the borrow slot and
# `r = v` wrote that, not the caller's `**S`.  `name` is T less its first
# `ptr_` (get_type_name_from_suffix).
fn borrow_take_ptr_ptr_arg(param: *Param, subst_type: TypeKind, name_sv: StrView)
    var name: *u8 = name_sv.ptr
    var len: i32 = name_sv.len as i32
    if param.is_borrow != 1 or param.param_type != TypeKind.MutRef or subst_type != TypeKind.Ptr
        return
    var rest: *u8 = name
    var rest_len: i32 = len
    var extra: i32 = 0
    while rest_len > 4 and (StrView { ptr: (rest), len: (rest_len) as i64 }).starts_with("ptr_")
        rest = rest + 4
        rest_len = rest_len - 4
        extra = extra + 1
    if extra == 0 or ptr_arg_pointee(StrView { ptr: (rest), len: (rest_len) as i64 }) != TypeKind.Struct
        return
    param.param_pointee_type = TypeKind.PtrPtr
    param.param_inner_pointee_type = ptr_slot_deepen((TypeKind.Struct as i32), extra - 1)
    param.param_ref_ptr_pointee = TypeKind.Void
    param.param_type_name = rest
    param.param_type_name_len = rest_len

fn clone_params_with_suffix(mono: *MonoCtx, params: *Param, type_param_sv: StrView, subst_type: TypeKind, subst_name_sv: StrView, suffix_sv: StrView) -> *Param
    var type_param: *u8 = type_param_sv.ptr
    var type_param_len: i32 = type_param_sv.len as i32
    var subst_name: *u8 = subst_name_sv.ptr
    var subst_len: i32 = subst_name_sv.len as i32
    if params == null
        return null

    let cloned: *Param = malloc(sizeof(Param)) as *Param
    cloned.name = params.name
    cloned.name_len = params.name_len
    cloned.param_ty = params.param_ty   # AGAST #4528: the parsed chain (none mutates it)
    cloned.param_type = substitute_type(params.param_type, type_param_sv, subst_type, subst_name_sv)
    cloned.param_type_name = params.param_type_name
    cloned.param_type_name_len = params.param_type_name_len
    cloned.param_pointee_type = params.param_pointee_type
    cloned.param_inner_pointee_type = params.param_inner_pointee_type  # AGAST #1815
    cloned.param_inner_ref = params.param_inner_ref  # AGAST #2399
    # AGAST #1953, #2321.  A generic `*[N]T` keeps its TypeKind.Array pointee below.
    cloned.param_pointee_array_size = params.param_pointee_array_size
    cloned.param_pointee_array_elem_type = params.param_pointee_array_elem_type
    cloned.param_pointee_array_elem_pointee = params.param_pointee_array_elem_pointee
    cloned.param_pointee_array_shape = array_shape_subst(params.param_pointee_array_shape, type_param_sv, subst_type, subst_name_sv)  # AGAST #2290
    cloned.param_array_size = params.param_array_size
    cloned.param_array_elem_type = params.param_array_elem_type
    cloned.param_array_elem_pointee = params.param_array_elem_pointee   # AGAST #2332
    # AGAST #3634: a by-value `[N][M]T`'s shape, its leaf substituted as above.
    let byval_sh: *ArrayShape = array_shape_subst(params.param_array_shape, type_param_sv, subst_type, subst_name_sv)
    cloned.param_array_shape = array_shape_mangled_subst(mono, byval_sh, type_param_sv, suffix_sv)
    cloned.is_borrow = params.is_borrow
    cloned.is_self_borrow = params.is_self_borrow
    cloned.param_ref_ptr_pointee = params.param_ref_ptr_pointee   # AGAST #2308
    cloned.name_span.line = params.name_span.line   # AGAST #2407
    cloned.name_span.col = params.name_span.col
    cloned.fn_sig = clone_fn_sig(mono, params.fn_sig, type_param_sv, subst_type, subst_name_sv, suffix_sv)  # AGAST #1671

    # AGAST #2287: `a: [N]T` takes T's element type and name; `[N]Vec<T>` its name.
    if cloned.param_type == TypeKind.Array and cloned.param_type_name != null and params.param_type == TypeKind.Array
        if cloned.param_type_name_len == type_param_len and memcmp(cloned.param_type_name, type_param, type_param_len as i64) == 0
            if cloned.param_array_elem_type == TypeKind.Struct
                cloned.param_array_elem_type = subst_type
            if cloned.param_array_elem_pointee == TypeKind.Struct
                cloned.param_array_elem_pointee = subst_type   # AGAST #2332: `[N]*T`
            cloned.param_type_name = subst_name
            cloned.param_type_name_len = subst_len
        else
            var arr_name: *u8 = null
            var arr_len: i32 = 0
            substitute_type_param_in_name(mono, StrView { ptr: (cloned.param_type_name), len: (cloned.param_type_name_len) as i64 }, type_param_sv, suffix_sv, @arr_name, @arr_len)
            cloned.param_type_name = arr_name
            cloned.param_type_name_len = arr_len

    # Handle struct type name substitution for TypeKind.Struct
    if cloned.param_type == TypeKind.Struct and cloned.param_type_name != null
        if cloned.param_type_name_len == type_param_len and memcmp(cloned.param_type_name, type_param, type_param_len as i64) == 0
            cloned.param_type = subst_type
            cloned.param_type_name = subst_name
            cloned.param_type_name_len = subst_len
            if subst_type == TypeKind.Array
                param_take_array_arg(cloned, subst_name_sv)   # AGAST #2305
            # AGAST #2354: `v: T` at T = `@&U` is the `v: @&U` it says, not a
            # `*U`, so `@x` into it is refused as shared (#2339), as on ritz0.
            let pointee: TypeKind = ptr_arg_pointee(subst_name_sv)
            if subst_type == TypeKind.Ptr and suffix_is_mut_ref(suffix_sv) == 1 and pointee != TypeKind.Ptr
                cloned.param_type = TypeKind.MutRef
                cloned.param_pointee_type = pointee
                param_take_ptr_array_arg(cloned, subst_name_sv)   # AGAST #3101: `@&[N]E`
        else
            # AGAST #2418: a by-value `o: Option<T>` / `r: Result<T, E>` /
            # `p: Pair<T>` is named "Option$T" etc.  It kept that name, so
            # `f<i32>` was defined with a `%Option$T` argument.
            var by_name: *u8 = null
            var by_len: i32 = 0
            substitute_type_param_in_name(mono, StrView { ptr: (cloned.param_type_name), len: (cloned.param_type_name_len) as i64 }, type_param_sv, suffix_sv, @by_name, @by_len)
            cloned.param_type_name = by_name
            cloned.param_type_name_len = by_len

    # Handle pointer/reference-to-struct type name substitution (e.g., *Vec<T> -> *Vec$u8, @&Vec<T> -> @&Vec$u8)
    if (cloned.param_type == TypeKind.Ptr or cloned.param_type == TypeKind.Ref or cloned.param_type == TypeKind.MutRef) and cloned.param_type_name != null
        # Special case: bare *T / @T / @&T — param_type_name is exactly "T".
        # Here param_pointee_type was parsed as TypeKind.Struct (since T looks like
        # a struct name). Concretize pointee to subst_type (e.g. TypeKind.U8) so
        # get_ptr_elem_size yields 1 instead of defaulting struct-unknown=8,
        # and deref loads produce the right bit-width (load i8, not i64).
        if cloned.param_type_name_len == type_param_len
            if memcmp(cloned.param_type_name, type_param, type_param_len as i64) == 0
                # AGAST #2279: `c:& [2]T` names T too, but holds an array, and a
                # by-value `T` slot must not read its first element.  So do
                # `@[2]T` and `@&[2]T` (#2287), and `*[2]T`: `p[i]` means one
                # thing for all three (#2321).
                # AGAST #2378: `a:& [2]*T` names T as what its element points
                # at.  The element stays a pointer: making it a T read `[2]*i16`
                # as `[2]i16`, and refused the param's own array at the call.
                if cloned.param_pointee_type == TypeKind.Array and params.param_pointee_array_elem_type == TypeKind.Ptr
                    cloned.param_pointee_array_elem_pointee = subst_type
                else if cloned.param_pointee_type == TypeKind.Array
                    cloned.param_pointee_array_elem_type = subst_type
                else if cloned.param_type != TypeKind.Ptr and cloned.param_pointee_type == TypeKind.Ptr
                    # AGAST #2308: `@&*T` is still a reference to a pointer.
                    set_ref_ptr_pointee(cloned, subst_type)
                else
                    cloned.param_pointee_type = subst_type
                    # AGAST #2345: so is `@&T` at T = `*U`.  subst_type only says
                    # TypeKind.Ptr, so `r:& T` was left as `r:& *<nothing>`: it never
                    # bound as its referent, and `r = v` overwrote its own slot.
                    if subst_type == TypeKind.Ptr
                        set_ref_ptr_pointee(cloned, ptr_arg_pointee(subst_name_sv))
                        # AGAST #3101: and `r:& T` at T = `*[N]E` borrows a
                        # `*[N]E`, bound as #3103 binds a written `r:& *[N]E`.
                        param_take_ptr_array_arg(cloned, subst_name_sv)
                cloned.param_type_name = subst_name
                cloned.param_type_name_len = subst_len
                # AGAST #2832: a bare `c:& T` / `*T` at T = `[2]f64` points at
                # that array, recorded as a written `c:& [2]f64` is (N, E, E's
                # name).  Not `c:& [2]T`, which held TypeKind.Array already.
                var arr: ArrayArg
                if params.param_pointee_type != TypeKind.Array and cloned.param_pointee_type == TypeKind.Array and array_arg_decode(subst_name_sv, @arr) == 1
                    cloned.param_pointee_array_size = arr.size
                    cloned.param_pointee_array_elem_type = arr.elem
                    cloned.param_pointee_array_elem_pointee = arr.pointee
                    cloned.param_pointee_array_shape = null
                    cloned.param_type_name = arr.name
                    cloned.param_type_name_len = arr.name_len
                borrow_take_ptr_ptr_arg(cloned, subst_type, subst_name_sv)
        else
            var new_name: *u8 = null
            var new_len: i32 = 0
            substitute_type_param_in_name(mono, StrView { ptr: (cloned.param_type_name), len: (cloned.param_type_name_len) as i64 }, type_param_sv, suffix_sv, @new_name, @new_len)
            cloned.param_type_name = new_name
            cloned.param_type_name_len = new_len

    # AGAST #1924: a `**T` param (any depth) records its innermost pointee as
    # TypeKind.Struct named "T"; concretize it as the `*T` case above does, so
    # `*(*(pp + i) + k)` in pp_get<i32> loads an i32 and strides by 4.
    if cloned.param_type == TypeKind.PtrPtr and ptr_ptr_slot_inner(cloned.param_inner_pointee_type) == TypeKind.Struct
        if cloned.param_type_name != null and cloned.param_type_name_len == type_param_len and memcmp(cloned.param_type_name, type_param, type_param_len as i64) == 0
            cloned.param_inner_pointee_type = ptr_ptr_slot_subst(cloned.param_inner_pointee_type, subst_type)
            cloned.param_type_name = subst_name
            cloned.param_type_name_len = subst_len

    cloned.next = clone_params_with_suffix(mono, params.next, type_param_sv, subst_type, subst_name_sv, suffix_sv)
    return cloned

# AGAST #1671: a `fn(T) -> T` type inside a generic body is specialized
# like the enclosing fn's own params and return type, so a call through it
# uses the instantiation's signature (`fn(u8) -> u8`), not `%T`.
fn clone_fn_sig(mono: *MonoCtx, sig: *FnDef, type_param_sv: StrView, subst_type: TypeKind, subst_name_sv: StrView, suffix_sv: StrView) -> *FnDef
    var type_param: *u8 = type_param_sv.ptr
    var type_param_len: i32 = type_param_sv.len as i32
    var subst_name: *u8 = subst_name_sv.ptr
    var subst_len: i32 = subst_name_sv.len as i32
    if sig == null
        return null
    let c: *FnDef = malloc(sizeof(FnDef)) as *FnDef
    c.name = sig.name
    c.name_len = sig.name_len
    c.params = clone_params_with_suffix(mono, sig.params, type_param_sv, subst_type, subst_name_sv, suffix_sv)
    c.return_type = sig.return_type
    c.return_type_name = sig.return_type_name
    c.return_type_name_len = sig.return_type_name_len
    if sig.return_type == TypeKind.Struct and sig.return_type_name != null
        if sig.return_type_name_len == type_param_len and memcmp(sig.return_type_name, type_param, type_param_len as i64) == 0
            c.return_type = subst_type
            c.return_type_name = subst_name
            c.return_type_name_len = subst_len
        else
            var rn: *u8 = null
            var rl: i32 = 0
            substitute_type_param_in_name(mono, StrView { ptr: (sig.return_type_name), len: (sig.return_type_name_len) as i64 }, type_param_sv, suffix_sv, @rn, @rl)
            c.return_type_name = rn
            c.return_type_name_len = rl
    c.body = null
    c.line = sig.line
    c.next = null
    c.type_params = null
    c.is_local = 0
    c.is_pub = 1   # AGAST #3419: a fn type, not a declaration
    c.col = 0
    c.extern_decl = 0
    c.ret_fn_sig = null   # AGAST #2120: a fn type's own return is not tracked
    c.ret_ref = null
    c.ret_array = null
    c.ret_ptr_array = null
    c.ret_array_param = clone_params_with_suffix(mono, sig.ret_array_param, type_param_sv, subst_type, subst_name_sv, suffix_sv)   # AGAST #2302
    return c

fn clone_params(mono: *MonoCtx, params: *Param, type_param_sv: StrView, subst_type: TypeKind, subst_name_sv: StrView) -> *Param
    # Legacy wrapper - doesn't handle pointer-to-struct substitution
    return clone_params_with_suffix(mono, params, type_param_sv, subst_type, subst_name_sv, StrView { ptr: (null), len: (0) as i64 })

fn substitute_type(ty: TypeKind, type_param_sv: StrView, subst_type: TypeKind, subst_name_sv: StrView) -> TypeKind
    # For simple types, no substitution needed
    if ty != TypeKind.Struct
        return ty
    # For struct types, we need to check if it's the type param
    # The caller should handle struct name substitution
    return ty

fn mangle_struct_name(name_sv: StrView, suffix_sv: StrView) -> StrView
    var name: *u8 = name_sv.ptr
    var name_len: i32 = name_sv.len as i32
    var suffix: *u8 = suffix_sv.ptr
    var suffix_len: i32 = suffix_sv.len as i32
    # Create mangled name like Vec$u8
    let mangled_len: i32 = name_len + suffix_len
    let mangled: *u8 = malloc(mangled_len as i64 + 1) as *u8
    for i in 0..name_len
        *(mangled + i) = *(name + i)
    for j in 0..suffix_len
        *(mangled + name_len + j) = *(suffix + j)
    *(mangled + mangled_len) = 0
    return strview_from_ptr(mangled, mangled_len as i64)

# The module being specialised, so substitute_type_param_in_name can ask
# whether a bare name is a generic struct template (AGAST #1926).  Set by
# specialize_fn_one_param, through which every clone_* path runs.
# (MonoCtx.mono_module)

fn names_generic_struct(mono: *MonoCtx, name_sv: StrView) -> i32
    var name: *u8 = name_sv.ptr
    if mono.mono_module == null
        return 0
    if find_generic_struct(mono.mono_module, name_sv) == null
        return 0
    1

# Substitute type parameter in a mangled name like "Vec$T" -> "Vec$u8"
# Input: name = "Vec$T", type_param = "T", new_suffix = "$u8"
# Output: "Vec$u8"
pub fn substitute_type_param_in_name(mono: *MonoCtx, name_sv: StrView, type_param_sv: StrView, new_suffix_sv: StrView, out_name: **u8, out_len: *i32)
    var name: *u8 = name_sv.ptr
    var name_len: i32 = name_sv.len as i32
    var type_param: *u8 = type_param_sv.ptr
    var type_param_len: i32 = type_param_sv.len as i32
    var new_suffix: *u8 = new_suffix_sv.ptr
    var new_suffix_len: i32 = new_suffix_sv.len as i32
    # AGAST #2975: `tuple_T_T` at T = i32 is `tuple_i32_i32`.
    let tn_sv: StrView = tuple_subst(mono, name_sv, type_param_sv, new_suffix_sv)
    if tn_sv.ptr != null
        *out_name = tn_sv.ptr
        *out_len = tn_sv.len as i32
        return
    # AGAST #1612: multi-parameter passes rewrite whole components, anywhere
    # in the name, and never append (see mono.mono_component_mode).
    if mono.mono_component_mode != 0
        let rp_sv: StrView = replace_param_component(mono, name_sv, type_param_sv, new_suffix_sv)
        *out_name = rp_sv.ptr
        *out_len = rp_sv.len as i32
        return
    # Check if name ends with "$T" where T is the type param
    # Expected pattern: "Base$T" where Base is some prefix
    # AGAST #1582: only a one-argument name ("Vec$T") takes this shortcut.
    # `Pair$T$T` has T in more than one component; rewriting the tail alone
    # gave `Pair$T$i64`, so a multi-argument name goes to the #2418 rewrite
    # below, which substitutes every component.
    let expected_suffix_len: i32 = type_param_len + 1  # "$" + type_param
    if name_len > expected_suffix_len and find_dollar_sign(StrView { ptr: (name), len: (name_len - expected_suffix_len) as i64 }) < 0
        let suffix_start: i32 = name_len - expected_suffix_len
        # Check for '$' separator
        if *(name + suffix_start) == '$'  # '$'
            # Check if rest matches type param
            var matches: i32 = 1
            for i in 0..type_param_len
                if *(name + suffix_start + 1 + i) != *(type_param + i)
                    matches = 0
                    break
            if matches != 0
                # Replace "$T" with new_suffix
                let base_len: i32 = suffix_start  # "Vec" part
                let new_len: i32 = base_len + new_suffix_len
                let result: *u8 = malloc(new_len as i64 + 1) as *u8
                # Copy base part
                for j in 0..base_len
                    *(result + j) = *(name + j)
                # Copy new suffix
                for k in 0..new_suffix_len
                    *(result + base_len + k) = *(new_suffix + k)
                *(result + new_len) = 0
                *out_name = result
                *out_len = new_len
                return

    # AGAST #2418: T as an inner component, `Result$T$i32` at T = i32 is
    # `Result$i32$i32` (one-parameter fn over `Result<T, i32>`).
    if new_suffix_len > 0 and find_dollar_sign(name_sv) >= 0
        let hit_sv: StrView = replace_param_component(mono, name_sv, type_param_sv, new_suffix_sv)
        if hit_sv.ptr != name
            *out_name = hit_sv.ptr
            *out_len = hit_sv.len as i32
            return

    # If the name doesn't have $T pattern, it might be a bare struct name like "Vec"
    # that needs the suffix appended (for @&Vec<T> parameters).  Only a generic
    # struct TEMPLATE gets it: a plain struct (`p: *Cell`, `var c: Cell`,
    # `Cell { .. }`) keeps its name, else `Cell` -> `Cell$i64`, which does not
    # exist (AGAST #1926).
    if new_suffix_len > 0 and names_generic_struct(mono, name_sv) != 0
        # Append the new suffix (e.g., "Vec" + "$u8" = "Vec$u8")
        let new_len: i32 = name_len + new_suffix_len
        let result: *u8 = malloc(new_len as i64 + 1) as *u8
        for i in 0..name_len
            *(result + i) = *(name + i)
        for k in 0..new_suffix_len
            *(result + name_len + k) = *(new_suffix + k)
        *(result + new_len) = 0
        *out_name = result
        *out_len = new_len
    else
        # No substitution needed - just copy the name
        let copy: *u8 = malloc(name_len as i64 + 1) as *u8
        for i in 0..name_len
            *(copy + i) = *(name + i)
        *(copy + name_len) = 0
        *out_name = copy
        *out_len = name_len

fn clone_body(mono: *MonoCtx, body: *Stmt, type_param_sv: StrView, subst_type: TypeKind, subst_name_sv: StrView, suffix_sv: StrView) -> *Stmt
    if body == null
        return null

    let cloned: *Stmt = clone_stmt(mono, body, type_param_sv, subst_type, subst_name_sv, suffix_sv)

    # Clone the rest of the statement list
    if body.next != null
        cloned.next = clone_body(mono, body.next, type_param_sv, subst_type, subst_name_sv, suffix_sv)

    return cloned

# AGAST #1925: a clone starts as a byte copy of its template, and each case
# below then replaces the child Expr / Stmt pointers with deep clones.  Before
# this, a clone copied only the fields its case listed, and malloc does not
# zero memory.  A kind with no case (StmtKind.IndexAssign, ExprKind.ArrayLit, ...)
# kept its kind but had uninitialised fields, so `a[0] = v` and
# `let a: [2]i64 = [7, 9]` emitted nothing in a generic fn's instantiation.
# Scalars (names, kinds, a cast's pointee) are now always carried over.  A
# kind that has no case still fails loudly (clone_unknown_kind), so a new kind
# can't share the template's child pointers without anyone noticing.
fn clone_unknown_kind(what: StrView, kind: i32)
    eprints("error: ritz1 monomorph: ")
    eprints(what)
    eprint(" has no case for kind {kind as i64}\n")
    sys_exit(1)

# AGAST #3662: `let p: *T` at T = `*U` (any depth) is the `**U` local it says,
# recorded as a written one is: TypeKind.PtrPtr, pointee TypeKind.Ptr, U's
# depth-packed inner slot and U's name (none for a primitive).  It was a `*`
# with a TypeKind.Ptr pointee, so ref_check refused `return *p` ("a value doesn't
# fit a reference slot") and `*p = v` stored a U-wide part of the pointer.
# `name` is T less its first `ptr_`, as borrow_take_ptr_ptr_arg reads it.
# 1 when it retyped the local.  `@T` / `@&T` locals bind through var_ref
# (#2308) and stay as they are.
fn ptr_local_take_ptr_arg(s: *Stmt, cloned: *Stmt, subst_type: TypeKind, name_sv: StrView) -> i32
    var name: *u8 = name_sv.ptr
    var len: i32 = name_sv.len as i32
    if s.var_type != TypeKind.Ptr or subst_type != TypeKind.Ptr
        return 0
    var rest: *u8 = name
    var rest_len: i32 = len
    var extra: i32 = 0
    while rest_len > 4 and (StrView { ptr: (rest), len: (rest_len) as i64 }).starts_with("ptr_")
        rest = rest + 4
        rest_len = rest_len - 4
        extra = extra + 1
    let inner: TypeKind = ptr_arg_pointee(StrView { ptr: (rest), len: (rest_len) as i64 })
    if inner == TypeKind.Array
        return 0
    cloned.var_type = TypeKind.PtrPtr
    cloned.var_declared_type = TypeKind.PtrPtr
    cloned.var_pointee_type = TypeKind.Ptr
    cloned.var_inner_pointee_type = ptr_slot_deepen((inner as i32), extra)
    cloned.var_type_name = rest
    cloned.var_type_name_len = rest_len
    if inner != TypeKind.Struct
        cloned.var_type_name = null
        cloned.var_type_name_len = 0
    return 1

# AGAST #1551: a pointer/reference local's pointee at T = the argument.  A
# bare `*T` (pointee parsed as struct "T") points at the argument type
# itself; `*Vec<T>` keeps its pointee and has T substituted in its name.
fn clone_ptr_local_type(mono: *MonoCtx, s: *Stmt, cloned: *Stmt, type_param_sv: StrView, subst_type: TypeKind, subst_name_sv: StrView, suffix_sv: StrView)
    var type_param: *u8 = type_param_sv.ptr
    var type_param_len: i32 = type_param_sv.len as i32
    var subst_name: *u8 = subst_name_sv.ptr
    var subst_len: i32 = subst_name_sv.len as i32
    if s.var_type_name_len == type_param_len and memcmp(s.var_type_name, type_param, type_param_len as i64) == 0
        # `*[N]T` and other non-struct pointees naming T are not this path
        # (AGAST #3663).
        if s.var_pointee_type != TypeKind.Struct
            cloned.var_type_name = s.var_type_name
            cloned.var_type_name_len = s.var_type_name_len
            return
        if ptr_local_take_ptr_arg(s, cloned, subst_type, subst_name_sv) == 1
            return
        cloned.var_pointee_type = subst_type
        cloned.var_type_name = subst_name
        cloned.var_type_name_len = subst_len
        # A written `*u8` carries no name: a named pointer local is taken to
        # point at a struct, and `*p` was typed i64 while it loaded an i8.
        if type_is_below_struct_nonptr(subst_type)
            cloned.var_type_name = null
            cloned.var_type_name_len = 0
        # `*T` at T = `[N]E` points at that array, as a param does (#2832).
        var arr: ArrayArg
        if subst_type == TypeKind.Array and array_arg_decode(subst_name_sv, @arr) == 1
            cloned.var_pointee_array_size = arr.size
            cloned.var_pointee_array_elem_type = arr.elem
            cloned.var_pointee_array_elem_pointee = arr.pointee
            cloned.var_type_name = arr.name
            cloned.var_type_name_len = arr.name_len
        return
    var new_name: *u8 = null
    var new_len: i32 = 0
    substitute_type_param_in_name(mono, StrView { ptr: (s.var_type_name), len: (s.var_type_name_len) as i64 }, type_param_sv, suffix_sv, @new_name, @new_len)
    cloned.var_type_name = new_name
    cloned.var_type_name_len = new_len

# AGAST #3663: a `*[N]T` local's element is the argument type, as a `*[N]T`
# param's is (#2321), and `*[N]*T`'s element points at it (#2378).  The local
# named no T (its type name is null), so the element stayed a struct "T" and
# `p[1]` was refused as "a whole struct element".
fn clone_ptr_array_local_elem(s: *Stmt, cloned: *Stmt, type_param_sv: StrView, subst_type: TypeKind, subst_name_sv: StrView)
    var type_param: *u8 = type_param_sv.ptr
    var type_param_len: i32 = type_param_sv.len as i32
    var subst_name: *u8 = subst_name_sv.ptr
    var subst_len: i32 = subst_name_sv.len as i32
    if s.var_type != TypeKind.Ptr or s.var_pointee_type != TypeKind.Array
        return
    if s.var_pointee_array_elem_name_len != type_param_len or memcmp(s.var_pointee_array_elem_name, type_param, type_param_len as i64) != 0
        return
    if s.var_pointee_array_elem_type == TypeKind.Ptr
        cloned.var_pointee_array_elem_pointee = subst_type
    else
        cloned.var_pointee_array_elem_type = subst_type
    cloned.var_pointee_array_elem_name = subst_name
    cloned.var_pointee_array_elem_name_len = subst_len

fn clone_stmt(mono: *MonoCtx, s: *Stmt, type_param_sv: StrView, subst_type: TypeKind, subst_name_sv: StrView, suffix_sv: StrView) -> *Stmt
    var type_param: *u8 = type_param_sv.ptr
    var type_param_len: i32 = type_param_sv.len as i32
    var subst_name: *u8 = subst_name_sv.ptr
    var subst_len: i32 = subst_name_sv.len as i32
    var suffix: *u8 = suffix_sv.ptr
    let cloned: *Stmt = malloc(sizeof(Stmt)) as *Stmt
    memcpy(cloned as *u8, s as *u8, sizeof(Stmt))  # AGAST #1925
    cloned.next = null

    let k: StmtKind = s.kind
    # A store keeps the template's sharing (AGAST #2529, clone_memo_find).
    let memo_was: i32 = mono.clone_memo_on
    let memo_base: i32 = mono.clone_memo_count
    if is_store_stmt(k) == 1
        mono.clone_memo_on = 1
    match k
        StmtKind.Expr =>
            cloned.expr = clone_expr(mono, s.expr, type_param_sv, subst_type, subst_name_sv, suffix_sv)
        StmtKind.Return =>
            if s.return_value != null
                cloned.return_value = clone_expr(mono, s.return_value, type_param_sv, subst_type, subst_name_sv, suffix_sv)
            else
                cloned.return_value = null
        StmtKind.VarDecl =>
            cloned.var_name = s.var_name
            cloned.var_name_len = s.var_name_len
            cloned.var_type = s.var_type
            cloned.var_declared_type = s.var_declared_type  # AGAST #1364
            cloned.var_src_file = s.var_src_file
            cloned.var_array_size = s.var_array_size
            cloned.var_array_elem_type = s.var_array_elem_type
            cloned.var_pointee_type = s.var_pointee_type
            cloned.var_inner_pointee_type = s.var_inner_pointee_type  # AGAST #1815
            # AGAST #1924: `let pp: **T` concretizes T like a `**T` param.
            var pp_local_subst: i32 = 0
            if s.var_type == TypeKind.PtrPtr and ptr_ptr_slot_inner(s.var_inner_pointee_type) == TypeKind.Struct
                if s.var_type_name != null and s.var_type_name_len == type_param_len and memcmp(s.var_type_name, type_param, type_param_len as i64) == 0
                    cloned.var_inner_pointee_type = ptr_ptr_slot_subst(s.var_inner_pointee_type, subst_type)
                    pp_local_subst = 1
            cloned.var_fn_sig = clone_fn_sig(mono, s.var_fn_sig, type_param_sv, subst_type, subst_name_sv, suffix_sv)  # AGAST #1671
            # Substitute type param in variable type name (e.g., Vec<T> -> Vec$u8)
            if s.var_type == TypeKind.Struct and s.var_type_name != null and s.var_type_name_len == type_param_len and memcmp(s.var_type_name, type_param, type_param_len as i64) == 0
                # A bare `T` local (`let item: T`, vec_slice<T>) becomes the
                # argument type itself, as clone_params_with_suffix does for a
                # bare `T` param.  The name path below would append the suffix
                # and declare the struct `%T$i32` (AGAST #1794).
                cloned.var_type = subst_type
                cloned.var_declared_type = subst_type
                cloned.var_type_name = subst_name
                cloned.var_type_name_len = subst_len
                # AGAST #2305: `var x: T` at T = `[N]E` is the `[N]E` local.
                var vaa: ArrayArg
                if subst_type == TypeKind.Array and array_arg_decode(subst_name_sv, @vaa) == 1
                    cloned.var_array_size = vaa.size
                    cloned.var_array_elem_type = vaa.elem
                    cloned.var_array_elem_pointee = vaa.pointee
                    cloned.var_array_shape = vaa.shape   # AGAST #3634
                    cloned.var_type_name = vaa.name
                    cloned.var_type_name_len = vaa.name_len
            else if s.var_type == TypeKind.Struct and s.var_type_name != null
                var new_name_ptr: *u8 = null
                var new_name_len: i32 = 0
                substitute_type_param_in_name(mono, StrView { ptr: (s.var_type_name), len: (s.var_type_name_len) as i64 }, type_param_sv, suffix_sv, @new_name_ptr, @new_name_len)
                cloned.var_type_name = new_name_ptr
                cloned.var_type_name_len = new_name_len
            else if pp_local_subst == 1
                cloned.var_type_name = subst_name
                cloned.var_type_name_len = subst_len
            else if (s.var_type == TypeKind.Ptr or s.var_type == TypeKind.Ref or s.var_type == TypeKind.MutRef) and s.var_type_name != null
                # AGAST #1551: `let p: *T` / `*Vec<T>` concretizes T as the same
                # param does (clone_params_with_suffix).  It kept the name "T" and
                # a TypeKind.Struct pointee, a struct that does not exist, so `p + 1`
                # had no element size and was refused.
                clone_ptr_local_type(mono, s, cloned, type_param_sv, subst_type, subst_name_sv, suffix_sv)
            else
                cloned.var_type_name = s.var_type_name
                cloned.var_type_name_len = s.var_type_name_len
            clone_ptr_array_local_elem(s, cloned, type_param_sv, subst_type, subst_name_sv)
            # AGAST #2996: `var a: [N]T` at T = the argument, as a `[N]T` param is.
            # It kept `[N x %T]`, a placeholder struct, so `a[i]` loaded a `%T`.
            if s.var_type == TypeKind.Array and s.var_array_elem_type == TypeKind.Struct and s.var_type_name != null and s.var_type_name_len == type_param_len and memcmp(s.var_type_name, type_param, type_param_len as i64) == 0
                cloned.var_array_elem_type = subst_type
                cloned.var_type_name = subst_name
                cloned.var_type_name_len = subst_len
            # AGAST #2332: `var a: [N]*T` at T = the argument.
            if s.var_array_elem_pointee == TypeKind.Struct and s.var_type_name != null and s.var_type_name_len == type_param_len and memcmp(s.var_type_name, type_param, type_param_len as i64) == 0
                cloned.var_array_elem_pointee = subst_type
                cloned.var_type_name = subst_name
                cloned.var_type_name_len = subst_len
            # AGAST #3120: `var a: [2][3]T` / `[2][3]P<T>` at T = the argument.  The
            # leaf lives only in the shape; kept as `T` / `P$T`, P$i64 was never
            # instantiated and `a[1][2].v` was "unhandled EXPR_MEMBER".
            # AGAST #3634: a bare `var x: T` at T = `[N][M]E` took its shape above.
            if s.var_array_shape != null
                let bare_sh: *ArrayShape = array_shape_subst(s.var_array_shape, type_param_sv, subst_type, subst_name_sv)
                cloned.var_array_shape = array_shape_mangled_subst(mono, bare_sh, type_param_sv, suffix_sv)
            # AGAST #2308: `let p: @&T` concretizes T as a `@&T` param does.
            cloned.var_ref = clone_params_with_suffix(mono, s.var_ref, type_param_sv, subst_type, subst_name_sv, suffix_sv)
            if cloned.var_ref != null
                stmt_take_var_ref(cloned)
            if s.var_init != null
                cloned.var_init = clone_expr(mono, s.var_init, type_param_sv, subst_type, subst_name_sv, suffix_sv)
            else
                cloned.var_init = null
        StmtKind.Assign =>
            cloned.assign_target = s.assign_target
            cloned.assign_target_len = s.assign_target_len
            cloned.assign_value = clone_expr(mono, s.assign_value, type_param_sv, subst_type, subst_name_sv, suffix_sv)
            # When assign_target_len == 0, target expression is stored in if_cond
            if s.assign_target_len == 0
                cloned.if_cond = clone_expr(mono, s.if_cond as *Expr, type_param_sv, subst_type, subst_name_sv, suffix_sv)
        StmtKind.If =>
            cloned.if_cond = clone_expr(mono, s.if_cond, type_param_sv, subst_type, subst_name_sv, suffix_sv)
            cloned.if_then = clone_body(mono, s.if_then, type_param_sv, subst_type, subst_name_sv, suffix_sv)
            if s.if_else != null
                cloned.if_else = clone_body(mono, s.if_else, type_param_sv, subst_type, subst_name_sv, suffix_sv)
            else
                cloned.if_else = null
        StmtKind.While =>
            cloned.while_cond = clone_expr(mono, s.while_cond, type_param_sv, subst_type, subst_name_sv, suffix_sv)
            cloned.while_body = clone_body(mono, s.while_body, type_param_sv, subst_type, subst_name_sv, suffix_sv)
        StmtKind.For =>
            cloned.for_var = s.for_var
            cloned.for_var_len = s.for_var_len
            cloned.for_inclusive = s.for_inclusive
            cloned.for_start = clone_expr(mono, s.for_start, type_param_sv, subst_type, subst_name_sv, suffix_sv)
            cloned.for_end = clone_expr(mono, s.for_end, type_param_sv, subst_type, subst_name_sv, suffix_sv)
            cloned.for_body = clone_body(mono, s.for_body, type_param_sv, subst_type, subst_name_sv, suffix_sv)
        StmtKind.Loop | StmtKind.Defer | StmtKind.Unsafe =>
            # Infinite loop — body stored in while_body (same slot as StmtKind.While);
            # a `defer`'s too (AGAST #1625; the byte copy carries defer_is_block).
            cloned.while_body = clone_body(mono, s.while_body, type_param_sv, subst_type, subst_name_sv, suffix_sv)
        StmtKind.Break | StmtKind.Continue | StmtKind.Stripped | StmtKind.Asm =>
            # No child nodes to clone.  An asm block is never changed once built
            # (AGAST #3394): the byte copy shares it.
            pass
        StmtKind.IndexAssign =>
            # name[idx] = value; the index is stored in while_cond (AGAST #1925)
            cloned.while_cond = clone_expr(mono, s.while_cond, type_param_sv, subst_type, subst_name_sv, suffix_sv)
            cloned.assign_value = clone_expr(mono, s.assign_value, type_param_sv, subst_type, subst_name_sv, suffix_sv)
        StmtKind.MemberAssign =>
            # ptr.field = value; the pointer expression is in if_cond (AGAST #1925)
            cloned.if_cond = clone_expr(mono, s.if_cond, type_param_sv, subst_type, subst_name_sv, suffix_sv)
            cloned.assign_value = clone_expr(mono, s.assign_value, type_param_sv, subst_type, subst_name_sv, suffix_sv)
        StmtKind.MemberIndexAssign =>
            # ptr.field[idx] = value: pointer in if_cond, index in while_cond (AGAST #1925)
            cloned.if_cond = clone_expr(mono, s.if_cond, type_param_sv, subst_type, subst_name_sv, suffix_sv)
            cloned.while_cond = clone_expr(mono, s.while_cond, type_param_sv, subst_type, subst_name_sv, suffix_sv)
            cloned.assign_value = clone_expr(mono, s.assign_value, type_param_sv, subst_type, subst_name_sv, suffix_sv)
        StmtKind.Assert =>
            # The condition is in if_cond (AGAST #1925)
            cloned.if_cond = clone_expr(mono, s.if_cond, type_param_sv, subst_type, subst_name_sv, suffix_sv)
        StmtKind.TupleDecl =>
            # let (a, b) = init; both names are carried over by the byte copy (AGAST #1925)
            cloned.var_init = clone_expr(mono, s.var_init, type_param_sv, subst_type, subst_name_sv, suffix_sv)
        StmtKind.LocalFieldAssign =>
            # v.field = value
            cloned.var_name = s.var_name
            cloned.var_name_len = s.var_name_len
            cloned.assign_target = s.assign_target
            cloned.assign_target_len = s.assign_target_len
            cloned.assign_value = clone_expr(mono, s.assign_value, type_param_sv, subst_type, subst_name_sv, suffix_sv)
        StmtKind.LocalFieldIndexAssign =>
            # v.field[idx] = value
            cloned.var_name = s.var_name
            cloned.var_name_len = s.var_name_len
            cloned.assign_target = s.assign_target
            cloned.assign_target_len = s.assign_target_len
            # Index expression is stored in while_cond (reused field)
            cloned.while_cond = clone_expr(mono, s.while_cond, type_param_sv, subst_type, subst_name_sv, suffix_sv)
            cloned.assign_value = clone_expr(mono, s.assign_value, type_param_sv, subst_type, subst_name_sv, suffix_sv)
        StmtKind.Match =>
            # AGAST #186: match-stmt cloning was missing — uninitialised cloned
            # struct caused emit_match to dereference a null scrutinee.  StmtKind.Match
            # stores scrutinee in if_cond, arms in if_then (recast as *MatchArm).
            cloned.if_cond = clone_expr(mono, s.if_cond, type_param_sv, subst_type, subst_name_sv, suffix_sv)
            cloned.if_then = clone_match_arms(mono, s.if_then as *MatchArm, type_param_sv, subst_type, subst_name_sv, suffix_sv) as *Stmt
            cloned.if_else = null
        _ =>
            clone_unknown_kind("clone_stmt", (k as i32))

    mono.clone_memo_on = memo_was
    mono.clone_memo_count = memo_base
    # A specialised body isn't walked by collect_from_stmt: note its calls here.
    if is_store_stmt(k) == 1
        note_compound_calls(cloned)
    return cloned

# `sizeof(T)` with T := subst (AGAST #2124): one value of the concrete kind,
# keeping `at`'s span and element count (1 for a bare `T`).
fn sizeof_subst_operand(at: *Expr, subst_type: TypeKind, subst_name_sv: StrView) -> *Expr
    var subst_name: *u8 = subst_name_sv.ptr
    var subst_len: i32 = subst_name_sv.len as i32
    let op: *Expr = malloc(sizeof(Expr)) as *Expr
    memcpy(op as *u8, at as *u8, sizeof(Expr))
    if at.kind != ExprKind.TypeOperand
        op.int_val = 1
    op.kind = ExprKind.TypeOperand
    op.type_kind = subst_type
    op.ident = strview_empty()
    # An unparsed suffix (TypeKind.Void) keeps its spelling: the emitter sizes a
    # TypeKind.Struct leaf named `i32` as the primitive, and rejects a non-type.
    if subst_type == TypeKind.Void
        op.type_kind = TypeKind.Struct
    # AGAST #2832: T = `[N]E` is N values of E, as sizeof_array_type_call
    # records a written `sizeof([N]E)`.
    var leaf_name: *u8 = subst_name
    var leaf_len: i32 = subst_len
    var a: ArrayArg
    if subst_type == TypeKind.Array and array_arg_decode(subst_name_sv, @a) == 1
        op.type_kind = a.elem
        leaf_name = a.name
        leaf_len = a.name_len
        var count: i32 = a.size
        if a.shape != null
            # AGAST #3634: `[N][M]E` is N*M values of its leaf E.
            count = shape_leaf_count(a.shape)
            op.type_kind = a.shape.leaf_type
            leaf_name = a.shape.leaf_name
            leaf_len = a.shape.leaf_name_len
        op.int_val = op.int_val * count as i64
    if op.type_kind == TypeKind.Struct
        op.ident = StrView { ptr: leaf_name, len: leaf_len as i64 }
    op.next = null
    return op

# AGAST #2529: a node one statement of the template shares stays shared in its
# clone.  `x op= v`'s read and store share x's operands (ast_helpers.ritz
# stmt_compound_assign_*), and note_compound_calls finds a call to evaluate
# once by that sharing: clone each such node once per statement.
# (MonoCtx.clone_memo_from, .clone_memo_to, .clone_memo_count, .clone_memo_cap, .clone_memo_on)

fn clone_memo_find(mono: *MonoCtx, e: *Expr) -> *Expr
    var i: i32 = 0
    while i < mono.clone_memo_count
        if *(mono.clone_memo_from + i) == e
            return *(mono.clone_memo_to + i)
        i += 1
    return null

fn clone_memo_add(mono: *MonoCtx, e: *Expr, c: *Expr)
    if mono.clone_memo_count == mono.clone_memo_cap
        var cap: i32 = 64
        if mono.clone_memo_cap > 0
            cap = mono.clone_memo_cap * 2
        let from: **Expr = malloc((cap as i64) * 8) as **Expr
        let to: **Expr = malloc((cap as i64) * 8) as **Expr
        var i: i32 = 0
        while i < mono.clone_memo_count
            *(from + i) = *(mono.clone_memo_from + i)
            *(to + i) = *(mono.clone_memo_to + i)
            i += 1
        mono.clone_memo_from = from
        mono.clone_memo_to = to
        mono.clone_memo_cap = cap
    *(mono.clone_memo_from + mono.clone_memo_count) = e
    *(mono.clone_memo_to + mono.clone_memo_count) = c
    mono.clone_memo_count += 1

# The store forms `x op= v` desugars into (note_compound_calls).
fn is_store_stmt(k: StmtKind) -> i32
    match k
        StmtKind.Assign | StmtKind.IndexAssign | StmtKind.MemberAssign =>
            return 1
        StmtKind.MemberIndexAssign | StmtKind.LocalFieldIndexAssign =>
            return 1
        _ => pass
    return 0

fn clone_expr(mono: *MonoCtx, e: *Expr, type_param_sv: StrView, subst_type: TypeKind, subst_name_sv: StrView, suffix_sv: StrView) -> *Expr
    var type_param: *u8 = type_param_sv.ptr
    var type_param_len: i32 = type_param_sv.len as i32
    var subst_name: *u8 = subst_name_sv.ptr
    var suffix: *u8 = suffix_sv.ptr
    if e == null
        return null
    if mono.clone_memo_on == 1
        let seen: *Expr = clone_memo_find(mono, e)
        if seen != null
            return seen

    let cloned: *Expr = malloc(sizeof(Expr)) as *Expr
    memcpy(cloned as *u8, e as *u8, sizeof(Expr))  # AGAST #1925; see clone_stmt
    cloned.next = null
    if mono.clone_memo_on == 1
        clone_memo_add(mono, e, cloned)

    let k: ExprKind = e.kind

    match k
        ExprKind.IntLit =>
            cloned.int_val = e.int_val
        ExprKind.CharLit =>
            cloned.int_val = e.int_val  # Char uses int_val field
        ExprKind.StringLit | ExprKind.CstringLit =>
            cloned.string_val = e.string_val
            # The raw token text print interpolation reads (AGAST #1521).
            cloned.ident = e.ident
        ExprKind.Ident =>
            cloned.ident = e.ident
        ExprKind.TypeOperand =>
            # `sizeof([4]T)` (AGAST #2124): the leaf may be the type parameter.
            if e.type_kind == TypeKind.Struct and (e.ident.len as i32) == type_param_len and memcmp(e.ident.ptr, type_param, type_param_len as i64) == 0
                let leaf: *Expr = sizeof_subst_operand(e, subst_type, subst_name_sv)
                cloned.type_kind = leaf.type_kind
                cloned.ident = leaf.ident
            else if e.type_kind == TypeKind.Struct and e.ident.ptr != null
                # `sizeof(Box<T>)` (AGAST #3268): "Box$T" becomes "Box$i32", as a
                # struct literal's mangled name does.
                var new_name_ptr: *u8 = null
                var new_name_len: i32 = 0
                substitute_type_param_in_name(mono, e.ident, type_param_sv, suffix_sv, @new_name_ptr, @new_name_len)
                cloned.ident = StrView { ptr: new_name_ptr, len: new_name_len as i64 }
        ExprKind.Binary =>
            cloned.op = e.op
            cloned.left = clone_expr(mono, e.left, type_param_sv, subst_type, subst_name_sv, suffix_sv)
            cloned.right = clone_expr(mono, e.right, type_param_sv, subst_type, subst_name_sv, suffix_sv)
        ExprKind.Unary =>
            cloned.op = e.op
            cloned.operand = clone_expr(mono, e.operand, type_param_sv, subst_type, subst_name_sv, suffix_sv)
        ExprKind.Call =>
            cloned.func_name = e.func_name
            # A nameless call's callee expression (AGAST #1747).  Only then: a
            # named call's `left` is not guaranteed initialised.
            cloned.left = null
            if e.func_name.len == 0
                cloned.left = clone_expr(mono, e.left, type_param_sv, subst_type, subst_name_sv, suffix_sv)
            cloned.call_type_suffix = e.call_type_suffix

            # If this call has a type suffix with our type param, substitute
            if cloned.call_type_suffix.len > 1
                # Check if suffix contains type param (e.g., $T -> $u8)
                let subst_suffix_sv: StrView = check_and_substitute_suffix(mono, cloned.call_type_suffix, type_param_sv, suffix_sv)
                if subst_suffix_sv.ptr != null
                    cloned.call_type_suffix = subst_suffix_sv
                    # Register this new instantiation for later generation —
                    # unless a multi-parameter pass is mid-way, when the suffix
                    # may still name a later parameter (AGAST #1612; the finished
                    # body is collected instead).
                    if mono.mono_component_mode == 0
                        inst_site_at(mono, e)   # AGAST #4844: in the instance being made
                        add_instantiation(mono, cloned.func_name, subst_suffix_sv)

            # Special case: sizeof(T) where T is a type parameter
            # The argument to sizeof is a type name (identifier), so we need to substitute
            let is_sizeof: bool = (cloned.func_name).eq("sizeof")
            if is_sizeof and e.args != null and e.args.kind == ExprKind.Ident
                # Check if the argument matches our type parameter
                if (e.args.ident.len as i32) == type_param_len
                    if memcmp(e.args.ident.ptr, type_param, type_param_len as i64) == 0
                        # Substitute the concrete type itself (AGAST #2124): a
                        # TYPE_OPERAND, not an IDENT of subst_name, which for
                        # a pointer or primitive T is no name the emitter knows
                        # (and an unknown sizeof name is now an error).
                        cloned.args = sizeof_subst_operand(e.args, subst_type, subst_name_sv)
                    else
                        cloned.args = clone_expr_list(mono, e.args, type_param_sv, subst_type, subst_name_sv, suffix_sv)
                else
                    cloned.args = clone_expr_list(mono, e.args, type_param_sv, subst_type, subst_name_sv, suffix_sv)
            else
                cloned.args = clone_expr_list(mono, e.args, type_param_sv, subst_type, subst_name_sv, suffix_sv)
        ExprKind.Index =>
            cloned.left = clone_expr(mono, e.left, type_param_sv, subst_type, subst_name_sv, suffix_sv)
            cloned.right = clone_expr(mono, e.right, type_param_sv, subst_type, subst_name_sv, suffix_sv)
        ExprKind.Member =>
            cloned.left = clone_expr(mono, e.left, type_param_sv, subst_type, subst_name_sv, suffix_sv)
            cloned.ident.ptr = e.ident.ptr  # Member name
            cloned.ident.len = e.ident.len
        ExprKind.Method =>
            cloned.left = clone_expr(mono, e.left, type_param_sv, subst_type, subst_name_sv, suffix_sv)
            cloned.ident.ptr = e.ident.ptr  # Method name
            cloned.ident.len = e.ident.len
            cloned.args = clone_expr_list(mono, e.args, type_param_sv, subst_type, subst_name_sv, suffix_sv)
            # A generic body is never walked by collect_from_expr, so its
            # specialisation is where `E.from(...)` becomes `E__from(...)`, and
            # `String.from(..)` `string_from(..)`.
            if mono.mono_module != null
                rewrite_enum_from_call(mono, mono.mono_module, cloned)
        ExprKind.Cast =>
            cloned.cast_array = null   # AGAST #2343: `[N]T` keeps T's own name; left unjudged
            # Parser stores operand in e.left, not e.operand
            cloned.left = clone_expr(mono, e.left, type_param_sv, subst_type, subst_name_sv, suffix_sv)
            cloned.type_kind = e.type_kind
        ExprKind.StructLit =>
            # Struct literal: TypeName { field: value, ... }
            # e.ident = struct type name
            # For generic struct literals, name is already mangled like "Vec$T"
            # We need to replace the "$T" with the new suffix "$u8"
            if e.ident.ptr != null
                var new_name_ptr: *u8 = null
                var new_name_len: i32 = 0
                substitute_type_param_in_name(mono, e.ident, type_param_sv, suffix_sv, @new_name_ptr, @new_name_len)
                cloned.ident = StrView { ptr: new_name_ptr, len: new_name_len as i64 }
            else
                cloned.ident = e.ident
            # Clone field initializers (stored in args)
            cloned.args = clone_field_inits(mono, e.args as *FieldInit, type_param_sv, subst_type, subst_name_sv, suffix_sv) as *Expr
        ExprKind.Range =>
            # Range expression: start..end
            cloned.left = clone_expr(mono, e.left, type_param_sv, subst_type, subst_name_sv, suffix_sv)
            cloned.right = clone_expr(mono, e.right, type_param_sv, subst_type, subst_name_sv, suffix_sv)
        ExprKind.NilLit =>
            # Nil literal: no fields to clone
            pass  # Placeholder statement to satisfy parser
        ExprKind.Match | ExprKind.If =>
            # ExprKind.If (#1613): same shape (condition in left, then/else arms).
            # AGAST #186: match-expr cloning was missing — caused segfaults when
            # generic fns had `match *opt` bodies (option_is_none<T>, etc).
            # ExprKind.Match stores scrutinee in left, arms in args (recast as *MatchArm).
            cloned.left = clone_expr(mono, e.left, type_param_sv, subst_type, subst_name_sv, suffix_sv)
            cloned.args = clone_match_arms(mono, e.args as *MatchArm, type_param_sv, subst_type, subst_name_sv, suffix_sv) as *Expr
        ExprKind.ArrayLit =>
            # [a, b, c]: the elements are the args list (AGAST #1925)
            cloned.args = clone_expr_list(mono, e.args, type_param_sv, subst_type, subst_name_sv, suffix_sv)
        ExprKind.ArrayFill | ExprKind.Try =>
            # [value; N] keeps value in left and N in int_val; `expr?` keeps expr
            # in left (AGAST #1925)
            cloned.left = clone_expr(mono, e.left, type_param_sv, subst_type, subst_name_sv, suffix_sv)
        ExprKind.FloatLit =>
            # The raw digits (string_val) come over with the byte copy
            pass
        _ =>
            clone_unknown_kind("clone_expr", (k as i32))

    return cloned

# AGAST #186: clone a chain of MatchArm nodes when the enclosing fn is being
# specialised.  Pattern fields (kind/int/name) carry no T references so they
# pass through verbatim; only `body` (the arm's RHS expression) needs the
# usual type-param substitution.  Cloning is required because emit_match
# reads each arm's `body.kind` etc.; without this the arms would still point
# at the template's expressions, but more importantly the surrounding STMT_
# /ExprKind.Match cloning did nothing without a copy strategy for arms either.
fn clone_match_arms(mono: *MonoCtx, arms: *MatchArm, type_param_sv: StrView, subst_type: TypeKind, subst_name_sv: StrView, suffix_sv: StrView) -> *MatchArm
    if arms == null
        return null
    let cloned: *MatchArm = malloc(sizeof(MatchArm)) as *MatchArm
    cloned.pattern_kind = arms.pattern_kind
    cloned.pattern_int = arms.pattern_int
    cloned.pattern_name = arms.pattern_name
    cloned.pattern_name_len = arms.pattern_name_len
    cloned.pattern_inner_kind = arms.pattern_inner_kind
    cloned.pattern_inner_name = arms.pattern_inner_name
    cloned.pattern_inner_name_len = arms.pattern_inner_name_len
    cloned.pattern_inner_span.line = arms.pattern_inner_span.line   # AGAST #2405
    cloned.pattern_inner_span.col = arms.pattern_inner_span.col
    cloned.pattern_binds = arms.pattern_binds   # AGAST #1295 (shared: never mutated)
    cloned.pattern_bind_count = arms.pattern_bind_count
    cloned.pattern_field_sel = arms.pattern_field_sel
    cloned.pattern_span.line = arms.pattern_span.line   # AGAST #2407
    cloned.pattern_span.col = arms.pattern_span.col
    cloned.head_span.line = arms.head_span.line   # AGAST #2431
    cloned.head_span.col = arms.head_span.col
    cloned.is_pass = arms.is_pass
    cloned.is_block = arms.is_block   # AGAST #3028
    cloned.or_next = arms.or_next   # AGAST #4450 (shared: patterns only, never mutated)
    cloned.pass_span.line = arms.pass_span.line   # AGAST #2236
    cloned.pass_span.col = arms.pass_span.col
    # Block arm statements (AGAST #1454); clone_body copies the chain.
    cloned.body_stmts = clone_body(mono, arms.body_stmts, type_param_sv, subst_type, subst_name_sv, suffix_sv)
    if arms.body != null
        cloned.body = clone_expr(mono, arms.body, type_param_sv, subst_type, subst_name_sv, suffix_sv)
    else
        cloned.body = null
    cloned.next = clone_match_arms(mono, arms.next, type_param_sv, subst_type, subst_name_sv, suffix_sv)
    return cloned

fn clone_expr_list(mono: *MonoCtx, list: *Expr, type_param_sv: StrView, subst_type: TypeKind, subst_name_sv: StrView, suffix_sv: StrView) -> *Expr
    if list == null
        return null

    let cloned: *Expr = clone_expr(mono, list, type_param_sv, subst_type, subst_name_sv, suffix_sv)
    cloned.next = clone_expr_list(mono, list.next, type_param_sv, subst_type, subst_name_sv, suffix_sv)
    return cloned

fn clone_field_inits(mono: *MonoCtx, fi: *FieldInit, type_param_sv: StrView, subst_type: TypeKind, subst_name_sv: StrView, suffix_sv: StrView) -> *FieldInit
    if fi == null
        return null

    let cloned: *FieldInit = malloc(sizeof(FieldInit)) as *FieldInit
    cloned.name = fi.name
    cloned.name_len = fi.name_len
    # Clone the value expression (handles nested generic calls/literals)
    cloned.value = clone_expr(mono, fi.value, type_param_sv, subst_type, subst_name_sv, suffix_sv)
    cloned.next = clone_field_inits(mono, fi.next, type_param_sv, subst_type, subst_name_sv, suffix_sv)
    return cloned

fn check_and_substitute_suffix(mono: *MonoCtx, old_suffix_sv: StrView, type_param_sv: StrView, new_suffix_sv: StrView) -> StrView
    var old_suffix: *u8 = old_suffix_sv.ptr
    var old_suffix_len: i32 = old_suffix_sv.len as i32
    var type_param: *u8 = type_param_sv.ptr
    var type_param_len: i32 = type_param_sv.len as i32
    var new_suffix: *u8 = new_suffix_sv.ptr
    var new_suffix_len: i32 = new_suffix_sv.len as i32
    # AGAST #1612: in a multi-parameter pass a call suffix may name several
    # parameters (`helper<T, U>` is "$T$U"); rewrite the matching component.
    if mono.mono_component_mode != 0
        let rewritten_sv: StrView = replace_param_component(mono, old_suffix_sv, type_param_sv, new_suffix_sv)
        if rewritten_sv.ptr == old_suffix
            return strview_empty()
        return rewritten_sv
    # AGAST #2975: `vec_push<(T, i32)>` is "$tuple_T_i32".
    let tup_sv: StrView = subst_components(mono, old_suffix_sv, type_param_sv, new_suffix_sv, 0)
    if tup_sv.ptr != old_suffix
        return tup_sv
    # Check if old_suffix is "$T" where T matches type_param
    if old_suffix_len != type_param_len + 1
        # AGAST #3343: T inside a nested argument, `deep<Cell<T>>` ("$Cell$T")
        # at T = i32 is "$Cell$i32".  Left alone, every instance called the
        # unspecialised `deep$Cell$T` (invalid IR), so polymorphic recursion
        # never got deeper than one level and #3330's cap never fired.
        let inner_sv: StrView = replace_param_component(mono, old_suffix_sv, type_param_sv, new_suffix_sv)
        if inner_sv.ptr == old_suffix
            return strview_empty()
        return inner_sv
    if *old_suffix != '$'  # $
        return strview_empty()
    if memcmp(old_suffix + 1, type_param, type_param_len as i64) != 0
        return strview_empty()

    # Substitute with new suffix
    return strview_from_ptr(new_suffix, new_suffix_len as i64)

# ============================================================================
# Struct Cloning and Specialization
# ============================================================================
# Clone a generic struct and substitute the type parameter

fn clone_and_specialize_struct(mono: *MonoCtx, m: *Module, template: *StructDef, suffix_sv: StrView) -> *StructDef
    var suffix: *u8 = suffix_sv.ptr
    var suffix_len: i32 = suffix_sv.len as i32
    # Create a new StructDef with mangled name
    let mangled_name_len: i32 = template.name_len + suffix_len
    let mangled_name: *u8 = malloc(mangled_name_len as i64 + 1) as *u8

    # Copy base name
    for i in 0..template.name_len
        *(mangled_name + i) = *(template.name + i)

    # Copy suffix (including the $)
    for j in 0..suffix_len
        *(mangled_name + template.name_len + j) = *(suffix + j)
    *(mangled_name + mangled_name_len) = 0

    # AGAST #1574: substitute EVERY parameter of a multi-parameter template.
    if count_type_params(template.type_params) >= 2
        let cap: i64 = 4 * mangled_arg_capacity(suffix_sv) as i64
        let starts: *i32 = malloc(cap) as *i32
        let lens: *i32 = malloc(cap) as *i32
        if split_mangled_args(mono.pctx, m, suffix_sv, starts, lens) != count_type_params(template.type_params)
            return null
        let multi: *StructDef = malloc(sizeof(StructDef)) as *StructDef
        multi.name = mangled_name
        multi.name_len = mangled_name_len
        multi.fields = clone_struct_fields_multi(mono, template.fields, template.type_params, suffix, starts, lens)
        multi.type_params = null
        multi.next = null
        if struct_is_packed(mono.pctx, template) == 1
            struct_mark_packed(mono.pctx, multi)   # `[[packed]]` holds for every instance (#1847)
        return multi

    # Get the type parameter name from template
    var type_param_name: *u8 = null
    var type_param_len: i32 = 0
    if template.type_params != null
        type_param_name = template.type_params.name
        type_param_len = template.type_params.name_len

    # Get the substitution type from suffix
    var subst_type_name: *u8 = null
    var subst_type_len: i32 = 0
    get_type_name_from_suffix(suffix_sv, @subst_type_name, @subst_type_len)
    let subst_type: TypeKind = parse_type_from_suffix(suffix_sv)

    # Clone the struct with specialized name
    let specialized: *StructDef = malloc(sizeof(StructDef)) as *StructDef
    specialized.name = mangled_name
    specialized.name_len = mangled_name_len
    specialized.fields = clone_struct_fields(mono, template.fields, StrView { ptr: (type_param_name), len: (type_param_len) as i64 }, subst_type, StrView { ptr: (subst_type_name), len: (subst_type_len) as i64 }, suffix_sv)
    specialized.type_params = null  # Not generic anymore
    specialized.next = null
    if struct_is_packed(mono.pctx, template) == 1
        struct_mark_packed(mono.pctx, specialized)   # `[[packed]]` holds for every instance (#1847)

    return specialized

# primitive_type_from_name lives in ast_helpers (AGAST #1980: the emitter's
# let path needs it too).
fn clone_struct_fields(mono: *MonoCtx, fields: *StructField, type_param_sv: StrView, subst_type: TypeKind, subst_name_sv: StrView, suffix_sv: StrView) -> *StructField
    var type_param: *u8 = type_param_sv.ptr
    var type_param_len: i32 = type_param_sv.len as i32
    var suffix: *u8 = suffix_sv.ptr
    if fields == null
        return null

    # AGAST #4680: the whole field, then what substitution rewrites.  Copied
    # member by member, a member the copy missed (ptr_pointee, so `w.ptr` of
    # `W$Point` was an untyped pointer any slot took) was malloc's garbage.
    let cloned: *StructField = malloc(sizeof(StructField)) as *StructField
    *cloned = *fields
    cloned.array_shape = array_shape_mangled_subst(mono, fields.array_shape, type_param_sv, suffix_sv)  # AGAST #2097, #3119
    # AGAST #3141: a bare `[2][3]T` leaf is the struct named `T` until
    # substituted; kept, `w.a[1][2] = x` read as assigning a whole element.
    cloned.array_shape = array_shape_subst(cloned.array_shape, type_param_sv, subst_type, subst_name_sv)
    cloned.ptr_array = ptr_array_unless_generic(fields.ptr_array)  # AGAST #2329
    # AGAST #3151: a struct U may be the parameter; a scalar U is itself.
    cloned.field_ref_ptr_pointee = TypeKind.Void
    if ref_field_scalar_pointee(fields) == 1
        cloned.field_ref_ptr_pointee = fields.field_ref_ptr_pointee
    # AGAST #4778: `make: fn() -> T` of `Maker<i64>` is `fn() -> i64`.
    # Shared as it stood, `Maker<i64> { make: seven }` was refused.
    cloned.fn_sig = clone_fn_sig(mono, fields.fn_sig, type_param_sv, subst_type, subst_name_sv, suffix_sv)
    cloned.elem_fn_sig = clone_fn_sig(mono, fields.elem_fn_sig, type_param_sv, subst_type, subst_name_sv, suffix_sv)

    # Check if field type is the type parameter
    if fields.field_type == TypeKind.Struct
        if fields.field_type_name != null and find_dollar_sign(StrView { ptr: (fields.field_type_name), len: (fields.field_type_name_len) as i64 }) > 0
            # AGAST #2411: a generic over the parameter, `v: Vec<T>` is
            # `Vec$T`: rewrite its `$T`, to `Vec$i32`.  It was copied as it
            # stood, so `B$i32` held a `%Vec$T`, which names no struct, and
            # `b.v.len` was `unhandled ExprKind.Member`.
            cloned.field_type = fields.field_type
            var sub_len: i32 = 0
            substitute_type_param_in_name(mono, StrView { ptr: (fields.field_type_name), len: (fields.field_type_name_len) as i64 }, type_param_sv, suffix_sv, @cloned.field_type_name, @sub_len)
            cloned.field_type_name_len = sub_len
        else if fields.field_type_name != null and fields.field_type_name_len == type_param_len
            if memcmp(fields.field_type_name, type_param, type_param_len as i64) == 0
                # Substitute with concrete type
                subst_value_field(cloned, subst_type, subst_name_sv)
            else
                # Not the type param, but might be a generic struct - mangle it
                cloned.field_type = fields.field_type
                let mangled_sv: StrView = mangle_struct_name(StrView { ptr: (fields.field_type_name), len: (fields.field_type_name_len) as i64 }, suffix_sv)
                cloned.field_type_name = mangled_sv.ptr
                cloned.field_type_name_len = mangled_sv.len as i32
        else if fields.field_type_name != null and tuple_reg_lookup(mono.pctx, StrView { ptr: (fields.field_type_name), len: (fields.field_type_name_len) as i64 }) != null
            # AGAST #2975: `f: (T, i32)` is `tuple_T_i32`, at T = i64
            # `tuple_i64_i32`.
            cloned.field_type = fields.field_type
            var tu_len: i32 = 0
            substitute_type_param_in_name(mono, StrView { ptr: (fields.field_type_name), len: (fields.field_type_name_len) as i64 }, type_param_sv, suffix_sv, @cloned.field_type_name, @tu_len)
            cloned.field_type_name_len = tu_len
        else
            cloned.field_type = fields.field_type
            cloned.field_type_name = fields.field_type_name
            cloned.field_type_name_len = fields.field_type_name_len
    else
        cloned.field_type = fields.field_type
        cloned.field_type_name = fields.field_type_name
        cloned.field_type_name_len = fields.field_type_name_len

    # `data: *T` — substitute the pointee.  The parser records a struct
    # pointee in field_type_name and a primitive one in array_elem_type; `T`
    # parses as a struct named "T".  Dropping it (as this used to) left
    # `Vec$Token.data + i` striding by 1 byte instead of sizeof(Token); the
    # hard-coded Vec$ layouts in the emitter hid that until #1440 removed them.
    if fields.field_type == TypeKind.Ptr or fields.field_type == TypeKind.Ref or fields.field_type == TypeKind.MutRef
        if fields.field_type_name != null and fields.field_type_name_len == type_param_len
            if memcmp(fields.field_type_name, type_param, type_param_len as i64) == 0
                subst_pointee_field(cloned, subst_type, subst_name_sv)
        if fields.field_type_name != null and find_dollar_sign(StrView { ptr: (fields.field_type_name), len: (fields.field_type_name_len) as i64 }) > 0
            # AGAST #3099: a generic pointee, `b: *Box<T>` is `*Box$T`:
            # rewrite its `$T`, as the by-value `b: Box<T>` above.  Copied as
            # it stood, `w.b.v` named the `%Box$T` no struct is, and fell to
            # "unhandled EXPR_MEMBER".
            var pt_len: i32 = 0
            substitute_type_param_in_name(mono, StrView { ptr: (fields.field_type_name), len: (fields.field_type_name_len) as i64 }, type_param_sv, suffix_sv, @cloned.field_type_name, @pt_len)
            cloned.field_type_name_len = pt_len
    subst_array_ptr_field(cloned, type_param_sv, subst_type, subst_name_sv)
    subst_array_elem_field(cloned, type_param_sv, subst_type, subst_name_sv)
    if cloned.field_type == TypeKind.Array and array_elem_names_struct(cloned) == 1
        if find_dollar_sign(StrView { ptr: (cloned.array_elem_type_name), len: (cloned.array_elem_type_name_len) as i64 }) > 0
            # AGAST #2390: `a: [2]Box<T>` is `[2]Box$T`: rewrite its `$T`;
            # and #3099, `a: [2]*Box<T>`'s pointee `Box$T`.
            var ae_len: i32 = 0
            substitute_type_param_in_name(mono, StrView { ptr: (fields.array_elem_type_name), len: (fields.array_elem_type_name_len) as i64 }, type_param_sv, suffix_sv, @cloned.array_elem_type_name, @ae_len)
            cloned.array_elem_type_name_len = ae_len

    # Clone rest of the list
    cloned.next = clone_struct_fields(mono, fields.next, type_param_sv, subst_type, subst_name_sv, suffix_sv)

    return cloned

# AGAST #1574: clone a multi-parameter template's fields, substituting every
# parameter.  A field typed by a parameter takes that parameter's argument; a
# field typed by a generic over the parameters (`Box$B`) has them rewritten
# in its mangled name; any other type is copied as-is.  (The single-parameter
# path appends the suffix to every non-parameter struct name instead, which
# here would name `%B$i64`-style types.)
fn clone_struct_fields_multi(mono: *MonoCtx, fields: *StructField, tp: *TypeParam, suffix: *u8, starts: *i32, lens: *i32) -> *StructField
    if fields == null
        return null

    let cloned: *StructField = malloc(sizeof(StructField)) as *StructField
    *cloned = *fields   # AGAST #4680, as clone_struct_fields
    # AGAST #3141: a bare `[2][3]T` leaf, T one of the parameters.
    let sh: *ArrayShape = fields.array_shape
    if sh != null and sh.leaf_name != null
        let si: i32 = type_param_index(tp, StrView { ptr: (sh.leaf_name), len: (sh.leaf_name_len) as i64 })
        if si >= 0
            var sh_name: *u8 = null
            var sh_len: i32 = 0
            let arg_s: *u8 = suffix + *(starts + si)
            get_type_name_from_suffix(StrView { ptr: (arg_s), len: (*(lens + si)) as i64 }, @sh_name, @sh_len)
            cloned.array_shape = array_shape_subst(sh, StrView { ptr: (sh.leaf_name), len: (sh.leaf_name_len) as i64 }, parse_type_from_suffix(StrView { ptr: (arg_s), len: (*(lens + si)) as i64 }), StrView { ptr: (sh_name), len: (sh_len) as i64 })
        else if find_dollar_sign(StrView { ptr: (sh.leaf_name), len: (sh.leaf_name_len) as i64 }) > 0
            # AGAST #3140: a generic leaf, `[2][3]P<T>` (leaf `P$T`) of a
            # `W<T, U>`, its parameters rewritten as array_elem_type_name's are.
            # Shared as it stood, `W$i64$i32.a` named a `%P$T` no struct is.
            let msh: *ArrayShape = malloc(sizeof(ArrayShape)) as *ArrayShape
            *msh = *sh
            let msh_sv: StrView = substitute_params_in_mangled(mono, tp, suffix, starts, lens, StrView { ptr: (sh.leaf_name), len: (sh.leaf_name_len) as i64 })
            msh.leaf_name = msh_sv.ptr
            msh.leaf_name_len = msh_sv.len as i32
            cloned.array_shape = msh
    cloned.ptr_array = ptr_array_unless_generic(fields.ptr_array)  # AGAST #2329
    # AGAST #3151: a struct U may be the parameter; a scalar U is itself.
    cloned.field_ref_ptr_pointee = TypeKind.Void
    if ref_field_scalar_pointee(fields) == 1
        cloned.field_ref_ptr_pointee = fields.field_ref_ptr_pointee
    # AGAST #4778: `conv: fn(A) -> B`, each parameter in turn.
    var p: *TypeParam = tp
    var pi: i32 = 0
    while p != null
        let p_arg: StrView = StrView { ptr: (suffix + *(starts + pi)), len: (*(lens + pi)) as i64 }
        var p_name: *u8 = null
        var p_len: i32 = 0
        get_type_name_from_suffix(p_arg, @p_name, @p_len)
        let p_sv: StrView = StrView { ptr: (p.name), len: (p.name_len) as i64 }
        let p_ty: TypeKind = parse_type_from_suffix(p_arg)
        let p_sub: StrView = StrView { ptr: (p_name), len: (p_len) as i64 }
        cloned.fn_sig = clone_fn_sig(mono, cloned.fn_sig, p_sv, p_ty, p_sub, p_arg)
        cloned.elem_fn_sig = clone_fn_sig(mono, cloned.elem_fn_sig, p_sv, p_ty, p_sub, p_arg)
        p = p.next
        pi = pi + 1

    let ft: TypeKind = fields.field_type
    var by_value: i32 = 0
    if ft == TypeKind.Struct
        by_value = 1
    var by_ptr: i32 = 0
    if ft == TypeKind.Ptr or ft == TypeKind.Ref or ft == TypeKind.MutRef
        by_ptr = 1
    if (by_value == 1 or by_ptr == 1) and fields.field_type_name != null
        let idx: i32 = type_param_index(tp, StrView { ptr: (fields.field_type_name), len: (fields.field_type_name_len) as i64 })
        if idx >= 0
            let arg: *u8 = suffix + *(starts + idx)
            let arg_len: i32 = *(lens + idx)
            var subst_name: *u8 = null
            var subst_len: i32 = 0
            get_type_name_from_suffix(StrView { ptr: (arg), len: (arg_len) as i64 }, @subst_name, @subst_len)
            let subst_type: TypeKind = parse_type_from_suffix(StrView { ptr: (arg), len: (arg_len) as i64 })
            if by_value == 1
                subst_value_field(cloned, subst_type, StrView { ptr: (subst_name), len: (subst_len) as i64 })
            else
                subst_pointee_field(cloned, subst_type, StrView { ptr: (subst_name), len: (subst_len) as i64 })
        else
            let new_sv: StrView = substitute_params_in_mangled(mono, tp, suffix, starts, lens, StrView { ptr: (fields.field_type_name), len: (fields.field_type_name_len) as i64 })
            cloned.field_type_name = new_sv.ptr
            cloned.field_type_name_len = new_sv.len as i32

    if fields.array_elem_pointee == TypeKind.Struct and fields.array_elem_type_name != null
        let ai: i32 = type_param_index(tp, StrView { ptr: (fields.array_elem_type_name), len: (fields.array_elem_type_name_len) as i64 })
        if ai >= 0
            var ae_name: *u8 = null
            var ae_len: i32 = 0
            let arg_e: *u8 = suffix + *(starts + ai)
            get_type_name_from_suffix(StrView { ptr: (arg_e), len: (*(lens + ai)) as i64 }, @ae_name, @ae_len)
            subst_array_ptr_field(cloned, StrView { ptr: (fields.array_elem_type_name), len: (fields.array_elem_type_name_len) as i64 }, parse_type_from_suffix(StrView { ptr: (arg_e), len: (*(lens + ai)) as i64 }), StrView { ptr: (ae_name), len: (ae_len) as i64 })
        else if ft == TypeKind.Array and find_dollar_sign(StrView { ptr: (fields.array_elem_type_name), len: (fields.array_elem_type_name_len) as i64 }) > 0
            # AGAST #3099: `a: [N]*Box<V>`, its pointee's parameters rewritten.
            let ap_sv: StrView = substitute_params_in_mangled(mono, tp, suffix, starts, lens, StrView { ptr: (fields.array_elem_type_name), len: (fields.array_elem_type_name_len) as i64 })
            cloned.array_elem_type_name = ap_sv.ptr
            cloned.array_elem_type_name_len = ap_sv.len as i32

    # AGAST #2390: `a: [N]T` / `a: [N]Box<T>` with T one of several parameters.
    if ft == TypeKind.Array and fields.array_elem_type == TypeKind.Struct and fields.array_elem_type_name != null
        let ei: i32 = type_param_index(tp, StrView { ptr: (fields.array_elem_type_name), len: (fields.array_elem_type_name_len) as i64 })
        if ei >= 0
            var ev_name: *u8 = null
            var ev_len: i32 = 0
            let arg_v: *u8 = suffix + *(starts + ei)
            get_type_name_from_suffix(StrView { ptr: (arg_v), len: (*(lens + ei)) as i64 }, @ev_name, @ev_len)
            subst_array_elem_field(cloned, StrView { ptr: (fields.array_elem_type_name), len: (fields.array_elem_type_name_len) as i64 }, parse_type_from_suffix(StrView { ptr: (arg_v), len: (*(lens + ei)) as i64 }), StrView { ptr: (ev_name), len: (ev_len) as i64 })
        else if find_dollar_sign(StrView { ptr: (fields.array_elem_type_name), len: (fields.array_elem_type_name_len) as i64 }) > 0
            let em_sv: StrView = substitute_params_in_mangled(mono, tp, suffix, starts, lens, StrView { ptr: (fields.array_elem_type_name), len: (fields.array_elem_type_name_len) as i64 })
            cloned.array_elem_type_name = em_sv.ptr
            cloned.array_elem_type_name_len = em_sv.len as i32

    cloned.next = clone_struct_fields_multi(mono, fields.next, tp, suffix, starts, lens)
    return cloned

# ============================================================================
# Impl Block Method Specialization
# ============================================================================
# Find impl block for a generic type and specialize its methods

fn specialize_impl_methods(mono: *MonoCtx, m: *Module, type_name_sv: StrView, suffix_sv: StrView)
    var ib: *ImplBlock = find_generic_impl(m.impls, type_name_sv)
    while ib != null
        specialize_one_impl(mono, m, ib, type_name_sv, suffix_sv)
        ib = find_generic_impl(ib.next, type_name_sv)

# A trait impl is specialised whole: the compiler calls its methods itself
# (drop, index, ...).  An inherent impl's methods wait for a call that names
# them (AGAST #3617): specialize_wanted_methods.
fn specialize_one_impl(mono: *MonoCtx, m: *Module, ib: *ImplBlock, type_name_sv: StrView, suffix_sv: StrView)
    if ib.trait_name == null or ib.trait_name_len == 0
        return
    var method: *FnDef = ib.methods
    while method != null
        add_specialized_method(mono, m, specialize_impl_method(mono, m, ib, method, type_name_sv, suffix_sv))
        method = method.next

fn add_specialized_method(mono: *MonoCtx, m: *Module, specialized: *FnDef)
    if specialized == null
        return
    collect_struct_types_from_fn(mono, m, specialized)
    # Add to module's function list
    if m.functions == null
        m.functions = specialized
    else
        var f: *FnDef = m.functions
        while f.next != null
            f = f.next
        f.next = specialized

# ============================================================================
# Inherent impl methods, specialised on use (AGAST #3617, #3341)
# ============================================================================
# Every method of a generic impl used to be specialised for every instance of
# its type, so a method nothing calls was emitted, typed and move-checked at
# every instance: an importer of ritzlib.gvec linked malloc through
# `vec_grow$u8`, and `impl<T> Cell<T>`'s `fn wrap(self) -> Cell<Cell<T>>`
# named a deeper instance at every level.  Now a call names the methods it
# reaches, as a generic fn's call does: `x.m()` wants `m` at x's instance,
# when the local-var tracker knows x's type, and at every instance when it
# doesn't (nothing reachable is missed).  ritz0: monomorph.py, _want_method.

# The instance a method call's receiver is a value of ("W$i32"), or null when
# the tracker can't tell.  `&x`, `@x`, `*p` are x's / p's; `x`, `a.b`, `p[i]`
# of a Vec<Vec<T>> or a `[N]S` local, and a call's result are typed
# (AGAST #4231: ritzlib's `impl<T> Vec<T>` made every untyped `.push(..)`
# specialise `push` on every Vec instance, linking malloc into -nostdlib
# importers and move-checking `Vec<MoveOnly>`'s `get`).
fn receiver_instance(mono: *MonoCtx, m: *Module, recv: *Expr) -> StrView
    var r: *Expr = recv
    while r != null and r.kind == ExprKind.Unary and (r.op == OpKind.Addr or r.op == OpKind.AddrMut or r.op == OpKind.Deref)
        r = r.operand
    if r == null
        return strview_empty()
    match r.kind
        ExprKind.Ident =>
            let idx: i32 = find_local_var_idx(mono, r.ident)
            if idx < 0
                return strview_empty()
            if *(mono.lv_prefix_kind + idx) == 0
                return strview_from_ptr(*(mono.lv_type_names + idx), (*(mono.lv_type_name_lens + idx)) as i64)
            return collection_instance_name(*(mono.lv_prefix_kind + idx), StrView { ptr: (*(mono.lv_suffixes + idx)), len: (*(mono.lv_suffix_lens + idx)) as i64 })
        ExprKind.Member =>
            let rf: *StructField = resolve_member_field(mono, m, r)
            if rf == null or rf.field_type_name == null or rf.field_type_name_len <= 0
                return strview_empty()
            return strview_from_ptr(rf.field_type_name, rf.field_type_name_len as i64)
        ExprKind.Index =>
            var esuf: *u8 = null
            var esuf_len: i32 = 0
            let ekind: i32 = indexed_element_collection(mono, m, r, @esuf, @esuf_len)
            if ekind > 0
                return collection_instance_name(ekind, StrView { ptr: (esuf), len: (esuf_len) as i64 })
            if r.left != null and r.left.kind == ExprKind.Ident and r.right != null and r.right.kind != ExprKind.Range
                return array_local_elem(mono, r.left.ident)
            return strview_empty()
        ExprKind.Call =>
            return call_result_type_name(m, r)
        ExprKind.Method =>
            # `a.slice(0, 1).get(0)`: what the inner method returns at a's type.
            var inner_sv: StrView = receiver_instance(mono, m, r.left)
            if inner_sv.ptr == null and r.left != null and r.left.kind == ExprKind.Ident and find_local_var_idx(mono, r.left.ident) < 0
                # `M.new().get(0)`: what M's static `new` returns (AGAST #4588).
                inner_sv = strview_from_ptr(r.left.ident.ptr, r.left.ident.len)
            if inner_sv.ptr == null or inner_sv.len <= 0
                return strview_empty()
            return method_result_type_name(m, inner_sv, r.ident)
        _ => pass
    strview_empty()

# The params the arguments of method call `e` land in: its impl method's,
# after `self`.  `Type.f(..)` (no local named `Type`) is a static call, and
# all of `f`'s params take arguments.  null when the method isn't found.
fn method_slot_params(mono: *MonoCtx, m: *Module, e: *Expr) -> *Param
    let meth: StrView = e.ident
    var tn: StrView = receiver_instance(mono, m, e.left)
    if tn.len <= 0 and e.left != null and e.left.kind == ExprKind.Ident and find_local_var_idx(mono, e.left.ident) < 0
        tn = e.left.ident
    if tn.ptr == null or tn.len <= 0
        return null
    let ib: *ImplBlock = impl_with_method(m, tn, meth, true)
    if ib == null
        return null
    let f: *FnDef = impl_method_named(ib, meth)
    if param_is_self(f.params) == 1
        return f.params.next
    f.params

# `recv.meth(..)`: the instance the tracker types `recv` as, or every one.
fn want_receiver_method(mono: *MonoCtx, m: *Module, recv: *Expr, meth_sv: StrView)
    if inherent_generic_method(m, StrView { ptr: (null), len: (0) as i64 }, meth_sv) == 0
        return
    let tn_sv: StrView = receiver_instance(mono, m, recv)
    if tn_sv.ptr == null or tn_sv.len <= 0
        want_method(mono, m, StrView { ptr: (null), len: (0) as i64 }, meth_sv)
    else
        want_method(mono, m, tn_sv, meth_sv)

# The method calls in an expression: `a.m(b.n())` wants `m` and `n`.
fn want_methods_in(mono: *MonoCtx, m: *Module, e: *Expr)
    if e == null
        return
    let k: ExprKind = e.kind
    if k == ExprKind.Method
        want_receiver_method(mono, m, e.left, e.ident)
    if k == ExprKind.StructLit or k == ExprKind.Match or k == ExprKind.If
        return   # their args are no *Expr list; a placeholder holds none
    want_methods_in(mono, m, e.left)
    want_methods_in(mono, m, e.right)
    want_methods_in(mono, m, e.operand)
    if k == ExprKind.Call or k == ExprKind.Method or k == ExprKind.ArrayLit
        var a: *Expr = e.args
        while a != null
            want_methods_in(mono, m, a)
            a = a.next

# print / eprint / format_into's "..." literal is split into its `{expr}`
# placeholders only when it is emitted (emitter_print.ritz), after this pass:
# `print("{b.get()}")` names `get` where no walk here sees it.  Parse each
# placeholder as the emitter will (interp.ritz) and want its method calls.
fn want_interp_methods(mono: *MonoCtx, m: *Module, e: *Expr)
    if e.args == null
        return
    var lit: *Expr = null
    if name_eq(e.func_name, "print") == 1 or name_eq(e.func_name, "eprint") == 1
        lit = e.args
    else if name_eq(e.func_name, "format_into") == 1
        lit = e.args.next
    if lit == null or lit.kind != ExprKind.StringLit or lit.ident.ptr == null or lit.ident.len < 2
        return
    let body: *u8 = lit.ident.ptr + 1
    let n: i32 = (lit.ident.len as i32) - 2
    var i: i32 = 0
    while i < n
        let c: i32 = *(body + i) as i32
        if c == '\\'   # `\x`: an escaped byte, never a brace
            i = i + 2
        else if (c == '{' or c == '}') and i + 1 < n and *(body + i + 1) as i32 == c
            i = i + 2   # `{{` / `}}`
        else if c == '{' and interp_match_brace(StrView { ptr: (body), len: (n) as i64 }, i) >= 0
            let close: i32 = interp_match_brace(StrView { ptr: (body), len: (n) as i64 }, i)
            var plen: i32 = close - i - 1
            let colon: i32 = interp_spec_colon(StrView { ptr: (body + i + 1), len: (plen) as i64 })   # `{expr:spec}` (AGAST #201)
            if colon >= 0
                plen = colon
            want_methods_in(mono, m, interp_parse_expr(mono.pctx, StrView { ptr: (body + i + 1), len: (plen) as i64 }, lit.span.line, lit.span.col))
            i = close + 1
        else
            i = i + 1

# Specialise each wanted inherent method of each instance so far, once.
# Returns how many it specialised: the fixpoint goes on while any are.
fn specialize_wanted_methods(mono: *MonoCtx, m: *Module) -> i32
    if mono.wanted_methods == null
        return 0
    var made: i32 = 0
    var si: i32 = 0
    # Instances this pass adds wait for the next round, after
    # specialize_pending_structs has checked their depth (MAX_INSTANCE_DEPTH).
    let end: i32 = mono.struct_count
    while si < end and mono.mono_errors == 0
        let name_sv: StrView = get_struct_instantiation_name(mono, si)
        let suffix_sv: StrView = get_struct_instantiation_suffix(mono, si)
        var ib: *ImplBlock = find_generic_impl(m.impls, name_sv)
        while ib != null
            if ib.trait_name == null or ib.trait_name_len == 0
                var method: *FnDef = ib.methods
                while method != null
                    if wanted_in(mono.wanted_methods, name_sv, suffix_sv, StrView { ptr: (method.name), len: (method.name_len) as i64 }) == 1 and wanted_in(mono.done_methods, name_sv, suffix_sv, StrView { ptr: (method.name), len: (method.name_len) as i64 }) == 0
                        mono.done_methods = push_wanted(mono.done_methods, name_sv, suffix_sv, StrView { ptr: (method.name), len: (method.name_len) as i64 })
                        mono.cur_gen = *(mono.struct_gens + si)
                        # AGAST #4844: the method's instance, from where it was wanted.
                        let method_sv: StrView = StrView { ptr: (method.name), len: (method.name_len) as i64 }
                        let site: *InstSite = inst_site_made(wanted_site(mono.wanted_methods, name_sv, suffix_sv, method_sv), name_sv, suffix_sv, method_sv)
                        let saved: *InstSite = inst_site_enter(mono, site)
                        let made_fn: *FnDef = specialize_impl_method(mono, m, ib, method, name_sv, suffix_sv)
                        inst_site_leave(mono, site, made_fn, saved)
                        add_specialized_method(mono, m, made_fn)
                        made = made + 1
                    method = method.next
            ib = find_generic_impl(ib.next, name_sv)
        si = si + 1
    mono.cur_gen = -1
    made

# Specialise one method of generic impl `ib` at `suffix`.  The method is
# specialised exactly as a generic fn whose type params are the impl's
# (clone_and_specialize_function: a `T` return becomes the argument, `*W<T>`
# becomes `*W$i32`, and multi-parameter impls are handled), then renamed to
# the method mangling `Type$suffix_method` (e.g. `Box$i64_set`).
fn specialize_impl_method(mono: *MonoCtx, m: *Module, ib: *ImplBlock, method: *FnDef, type_name_sv: StrView, suffix_sv: StrView) -> *FnDef
    var type_name: *u8 = type_name_sv.ptr
    var type_name_len: i32 = type_name_sv.len as i32
    var suffix: *u8 = suffix_sv.ptr
    var suffix_len: i32 = suffix_sv.len as i32
    let template: *FnDef = malloc(sizeof(FnDef)) as *FnDef
    memcpy(template as *u8, method as *u8, sizeof(FnDef))
    template.type_params = ib.type_params
    let self_name: *u8 = malloc((type_name_len + suffix_len) as i64 + 1)
    memcpy(self_name, type_name, type_name_len as i64)
    memcpy(self_name + type_name_len, suffix, suffix_len as i64)
    *(self_name + type_name_len + suffix_len) = 0
    mono.impl_self_name = self_name
    mono.impl_self_len = type_name_len + suffix_len
    let specialized: *FnDef = clone_and_specialize_function(mono, m, template, suffix_sv)
    mono.impl_self_name = null
    mono.impl_self_len = 0
    free(template as *u8)
    if specialized == null
        return null

    let mangled_name_len: i32 = type_name_len + suffix_len + 1 + method.name_len
    let mangled_name: *u8 = malloc(mangled_name_len as i64 + 1) as *u8
    var pos: i32 = 0
    for i in 0..type_name_len
        *(mangled_name + pos) = *(type_name + i)
        pos = pos + 1
    for j in 0..suffix_len
        *(mangled_name + pos) = *(suffix + j)
        pos = pos + 1
    *(mangled_name + pos) = 95  # '_'
    pos = pos + 1
    for k in 0..method.name_len
        *(mangled_name + pos) = *(method.name + k)
        pos = pos + 1
    *(mangled_name + pos) = 0
    specialized.name = mangled_name
    specialized.name_len = mangled_name_len
    # AGAST #2318: a bare `self` / `self:&` names no type, and impl_block_new
    # names it only in a non-generic impl.  Here it is this instance: the
    # mangled name up to its `_method` tail, e.g. `W$i32`.
    name_untyped_self(specialized.params, StrView { ptr: (mangled_name), len: (type_name_len + suffix_len) as i64 })
    specialized

pub fn monomorphize_module(mono: *MonoCtx, m: *Module)
    mono.tuple_module = m   # AGAST #2975: where tuple_subst puts a tuple it makes
    init_instantiation_tracker(mono)
    init_local_var_tracker(mono)

    # Collect all generic function and struct instantiations
    collect_instantiations_from_module(mono, m)

    # Structs and fns are specialised to a fixpoint: specialising `vec_push<T>`
    # at u8 yields a fn whose signature names `Vec$u8`, which is a struct
    # instantiation that no call site spelled out; and specialising a struct
    # specialises its impl methods, which may name further instantiations.
    var s_done: i32 = 0
    var i: i32 = 0
    var made: i32 = 0
    while mono.mono_errors == 0 and (s_done < mono.struct_count or i < mono.inst_count or made > 0)
        s_done = specialize_pending_structs(mono, m, s_done)
        i = specialize_pending_fns(mono, m, i)
        made = specialize_wanted_methods(mono, m)   # AGAST #3617
    mono.cur_gen = -1

# Specialise struct instantiations [start, mono.struct_count); returns the new
# high-water mark.
fn specialize_pending_structs(mono: *MonoCtx, m: *Module, start: i32) -> i32
    var si: i32 = start
    while si < mono.struct_count
        let name_sv: StrView = get_struct_instantiation_name(mono, si)
        let suffix_sv: StrView = get_struct_instantiation_suffix(mono, si)
        mono.cur_gen = *(mono.struct_gens + si)
        si = si + 1
        if mono.cur_gen >= MAX_INSTANCE_DEPTH
            refuse_recursive_instance(mono, m, name_sv)
            return mono.struct_count

        # Find the generic template
        let template: *StructDef = find_generic_struct(m, name_sv)
        if template != null
            # Generate specialized version
            let specialized: *StructDef = clone_and_specialize_struct(mono, m, template, suffix_sv)

            # Add to module's struct list (prepend)
            if specialized != null
                specialized.next = m.structs
                m.structs = specialized
                collect_struct_types_from_fields(mono, m, specialized.fields)

        # Specialise the type's generic impls: a struct's, or a generic enum
        # instance's, which add_enum_impl_instance queued with no struct
        # template (AGAST #3309).
        specialize_impl_methods(mono, m, name_sv, suffix_sv)

    si

# Specialise fn instantiations [start, mono.inst_count); returns the new
# high-water mark.  Index-based because cloning adds instantiations as it goes
# (e.g., vec_push<T> calls vec_ensure_cap<T> which calls vec_grow<T>).
fn specialize_pending_fns(mono: *MonoCtx, m: *Module, start: i32) -> i32
    if mono.mono_errors > 0   # a struct was refused this round: report it alone
        return mono.inst_count
    var i: i32 = start
    while i < mono.inst_count
        let name_sv: StrView = get_instantiation_name(mono, i)
        let suffix_sv: StrView = get_instantiation_suffix(mono, i)
        mono.cur_gen = *(mono.inst_gens + i)
        if mono.cur_gen >= MAX_INSTANCE_DEPTH
            refuse_recursive_instance(mono, m, name_sv)
            return mono.inst_count

        # Find the generic template
        let template: *FnDef = find_generic_function(m, name_sv)
        if template != null
            # Generate specialized version, which names what it names from
            # where it was instantiated (AGAST #4844).
            let site: *InstSite = inst_site_made(*(mono.inst_sites + i), name_sv, suffix_sv, strview_empty())
            let saved: *InstSite = inst_site_enter(mono, site)
            let specialized: *FnDef = clone_and_specialize_function(mono, m, template, suffix_sv)
            inst_site_leave(mono, site, specialized, saved)

            # Add to module's function list
            if specialized != null
                # Find end of function list
                if m.functions == null
                    m.functions = specialized
                else
                    var f: *FnDef = m.functions
                    while f.next != null
                        f = f.next
                    f.next = specialized
                collect_struct_types_from_fn(mono, m, specialized)
        i = i + 1

    i
