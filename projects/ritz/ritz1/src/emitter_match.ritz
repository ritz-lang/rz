# ritz1/src/emitter_match.ritz - Match expression/statement lowering
#
# Added in ritz-task-87. Lowers `match scrutinee \n PATTERN => BODY ...`
# to a linear if-else-if chain in LLVM IR.
#
# Design notes:
# - Scrutinee is evaluated once into a register (i64).
# - Each arm emits:
#     match_test:  icmp eq i64 %scrut, <literal>   (or tag comparison for variants)
#                  br i1 %cond, label %match_body_N, label %match_next_N
#     match_body_N:
#                  ... arm body emitted ...
#                  br label %match_end
#     match_next_N: (next arm's test, or fallthrough to end)
# - Wildcard/ident arms unconditionally branch to their body (effectively
#   the catch-all / default). Once we emit an unconditional arm, later
#   arms become dead code (emitted but unreachable).
# - `pass` arms emit a zero value for their body result.
# - Match result is collected via phi over (arm_body_result, arm_exit_label)
#   pairs so `let x = match ...` works.  The phi is i64 unless an arm yields
#   a known struct (`Some(v) => v` over Option<StrView>), in which case it is
#   that struct type (AGAST #1645).  Arms yielding the layout-equivalent
#   Span$u8/StrView pair are rebuilt to the phi's type in their own block, and
#   a `"..."` arm counts as StrView (AGAST #1662).
#
# Variant patterns (Some(v) / None / Ok(v) / Err(_)) use a tag convention:
#   Some(x) / Ok(x) -> high 16 bits = 1, low 48 bits = x
#   None / Err(x)   -> high 16 bits = 0
# Encoded via simple bitwise ops so we don't need an enum-type system yet.
# See emit_variant_constructor_call in emitter_expr_call.ritz for the
# producer side of this convention.

import ritzlib.sys
import ritzlib.io
import ritzlib.str
import ritzlib.gvec
import ritzlib.memory

import ast
import ast_helpers
import tokens_gen
import emitter_core
import emitter_expr
import emitter_expr_call     # is_variant_carrier, is_variant_null, resolve_enum_ctx
import emitter_expr_access   # is_ident_none
import emitter_stmt          # emit_stmt, for block-bodied arms (AGAST #1454)

# Phi result tracking during emit_match.
# We need to collect (value_reg, exit_label) pairs across all non-pass arms
# so we can emit a terminating phi at the match.end label.
# Sized to the arm count by match_result_init (AGAST #1813): fixed [64]
# arrays silently dropped the phi incoming edges of arms past the 64th.
struct MatchResult
    values: *i32   # register numbers holding each arm's result
    labels: *i32   # exit label numbers for each arm's result
    count: i32
    # AGAST #1645: LLVM struct type the arms yield (`%StrView`, `%Point`),
    # or null when they yield the usual i64 scalar.  The merge phi and the
    # non-exhaustive fallthrough value are emitted at this type.
    agg_name: *u8
    agg_name_len: i32

# Check if a variant name denotes the "Some/Ok" (tagged) side of its enum.
# Returns 1 if tag should be 1, 0 otherwise.
# Heuristic: names "Some", "Ok" are the carrier variants; "None", "Err"
# are the null variants. Any other variant currently defaults to tag 0
# (which makes arbitrary enum matching equivalent to "match anything").
fn variant_is_tag_one(name: *u8, len: i32) -> i32
    if len == 4
        # "Some"
        if *name == 83 and *(name + 1) == 111 and *(name + 2) == 109 and *(name + 3) == 101
            return 1
    if len == 2
        # "Ok"
        if *name == 79 and *(name + 1) == 107
            return 1
    return 0

# Emit a check for the scrutinee being of a given variant against the
# struct layout `{ i8 tag, [N x i8] payload }` (ritz-task-133 parity with
# ritz0).  `slot_reg` is a pointer to the scrutinee struct (the match
# prelude spills the scrutinee value into an alloca once).  `enum_name`
# is the `%Result$.../Option$...` type name used to GEP.  `tag_one == 1`
# checks for the carrier variant (Ok / Some); 0 checks for the null
# variant (Err / None).  ritz0 tag convention: Ok=0 Err=1 Some=0 None=1,
# so carrier <=> tag==0.
# User-enum variant check: load the tag byte and compare against an
# arbitrary i8 tag value (instead of the tagged-enum 0/1 binary check).
# Used when the scrutinee's enum is a parser-tracked user enum (Shade,
# etc.) and the match arm names a specific variant by index.
fn emit_variant_tag_check_eq(s: *EmitterState, slot_reg: i32, enum_name: *u8, enum_name_len: i32, tag_value: i32) -> i32
    let tag_ptr: i32 = next_reg(s)
    emit_str(s, c"  ")
    emit_reg(s, tag_ptr)
    emit_str(s, c" = getelementptr %")
    emit_name(s, enum_name, enum_name_len)
    emit_str(s, c", ptr ")
    emit_reg(s, slot_reg)
    emit_str(s, c", i32 0, i32 0\n")
    let tag_reg: i32 = next_reg(s)
    emit_str(s, c"  ")
    emit_reg(s, tag_reg)
    emit_str(s, c" = load i8, ptr ")
    emit_reg(s, tag_ptr)
    emit_str(s, c"\n")
    let cmp_reg: i32 = next_reg(s)
    emit_str(s, c"  ")
    emit_reg(s, cmp_reg)
    emit_str(s, c" = icmp eq i8 ")
    emit_reg(s, tag_reg)
    emit_str(s, c", ")
    emit_int(s, tag_value as i64)
    emit_str(s, c"\n")
    return cmp_reg

fn emit_variant_tag_check(s: *EmitterState, slot_reg: i32, enum_name: *u8, enum_name_len: i32, tag_one: i32) -> i32
    let tag_ptr: i32 = next_reg(s)
    emit_str(s, c"  ")
    emit_reg(s, tag_ptr)
    emit_str(s, c" = getelementptr %")
    emit_name(s, enum_name, enum_name_len)
    emit_str(s, c", ptr ")
    emit_reg(s, slot_reg)
    emit_str(s, c", i32 0, i32 0\n")
    let tag_reg: i32 = next_reg(s)
    emit_str(s, c"  ")
    emit_reg(s, tag_reg)
    emit_str(s, c" = load i8, ptr ")
    emit_reg(s, tag_ptr)
    emit_str(s, c"\n")
    let cmp_reg: i32 = next_reg(s)
    emit_str(s, c"  ")
    emit_reg(s, cmp_reg)
    if tag_one == 1
        # carrier (Ok/Some) → tag == 0
        emit_str(s, c" = icmp eq i8 ")
    else
        # null (Err/None) → tag != 0
        emit_str(s, c" = icmp ne i8 ")
    emit_reg(s, tag_reg)
    emit_str(s, c", 0\n")
    return cmp_reg

# Extract the variant payload as an i64 (the common scalar case).  Payload
# sits at field 2 (the `[N x i8]` buffer after the alignment pad, AGAST
# #1898), stored at its own width; it is widened to i64 because ritz1's
# downstream arithmetic / call paths operate on i64 registers.  `variant` is
# 0 for Ok / Some, 1 for Err.
fn emit_variant_payload(s: *EmitterState, slot_reg: i32, enum_name: *u8, enum_name_len: i32, variant: i32) -> i32
    let pay_ptr: i32 = next_reg(s)
    emit_str(s, c"  ")
    emit_reg(s, pay_ptr)
    emit_str(s, c" = getelementptr %")
    emit_name(s, enum_name, enum_name_len)
    emit_str(s, c", ptr ")
    emit_reg(s, slot_reg)
    emit_str(s, c", i32 0, i32 2\n")
    return emit_tagged_payload_load(s, pay_ptr, enum_name, enum_name_len, variant)

# Scalar-scrutinee fallback (non-enum `match x on int`).
fn emit_variant_tag_check_i64(s: *EmitterState, scrut_reg: i32, tag_one: i32) -> i32
    # Legacy packed-i64 path retained only for non-enum match.  In practice
    # ritz1 code only uses `match` on Result/Option + integers; this branch
    # covers the latter.  Returns a conservative always-false for "variant"
    # patterns against a scalar scrutinee.
    let r: i32 = next_reg(s)
    emit_str(s, c"  ")
    emit_reg(s, r)
    emit_str(s, c" = icmp eq i64 ")
    emit_reg(s, scrut_reg)
    emit_str(s, c", 0\n")
    if tag_one == 1
        return r
    let inv: i32 = next_reg(s)
    emit_str(s, c"  ")
    emit_reg(s, inv)
    emit_str(s, c" = xor i1 ")
    emit_reg(s, r)
    emit_str(s, c", true\n")
    return inv

# AGAST #1515: the struct type carried by a tagged enum's carrier variant
# (Ok/Some): see tagged_enum_payload_struct.  AGAST #1667 adds Result's Err
# side (tagged_enum_err_payload_struct).  When it names a known struct,
# fills (out_name, out_len); otherwise leaves them null/0 and the caller
# keeps the scalar i64 binding (primitives, pointers, None).
fn carrier_payload_struct(s: *EmitterState, arm: *MatchArm, enum_name: *u8, enum_name_len: i32, out_name: **u8, out_len: *i32)
    *out_name = null
    *out_len = 0
    if enum_name == null or enum_name_len <= 0
        return
    if is_tagged_enum_type(enum_name, enum_name_len) == 0
        return
    if variant_is_tag_one(arm.pattern_name, arm.pattern_name_len) == 0
        # AGAST #1667: `Err(e)` over Result<T, E> with a struct E binds at %E.
        if arm.pattern_name_len == 3 and *arm.pattern_name == 69 and *(arm.pattern_name + 1) == 114 and *(arm.pattern_name + 2) == 114   # "Err"
            *out_name = tagged_enum_err_payload_struct(s, enum_name, enum_name_len, out_len)
        return
    *out_name = tagged_enum_payload_struct(s, enum_name, enum_name_len, out_len)

# AGAST #1515: bind `Some(p)` / `Ok(s)` to a copy of a struct payload.  The
# payload sits at field 2 of the spilled scrutinee (#1898); copy it into its own
# `alloca %Name` and register a struct local, so `p.x` and by-value passing
# see `%Name` rather than an i64.
fn emit_struct_payload_bind(s: *EmitterState, arm: *MatchArm, slot_reg: i32, enum_name: *u8, enum_name_len: i32, st_name: *u8, st_name_len: i32)
    let pay_ptr: i32 = next_reg(s)
    emit_str(s, c"  ")
    emit_reg(s, pay_ptr)
    emit_str(s, c" = getelementptr %")
    emit_name(s, enum_name, enum_name_len)
    emit_str(s, c", ptr ")
    emit_reg(s, slot_reg)
    emit_str(s, c", i32 0, i32 2\n")
    let val: i32 = next_reg(s)
    emit_str(s, c"  ")
    emit_reg(s, val)
    emit_str(s, c" = load %")
    emit_name(s, st_name, st_name_len)
    emit_str(s, c", ptr ")
    emit_reg(s, pay_ptr)
    emit_str(s, c"\n")
    let alloca_reg: i32 = next_reg(s)
    emit_str(s, c"  ")
    emit_reg(s, alloca_reg)
    emit_str(s, c" = alloca %")
    emit_name(s, st_name, st_name_len)
    emit_str(s, c"  ; match struct payload bind\n")
    emit_str(s, c"  store %")
    emit_name(s, st_name, st_name_len)
    emit_str(s, c" ")
    emit_reg(s, val)
    emit_str(s, c", ptr ")
    emit_reg(s, alloca_reg)
    emit_str(s, c"\n")
    add_local_struct(s, arm.pattern_inner_name, arm.pattern_inner_name_len, alloca_reg, TYPE_STRUCT, st_name, st_name_len)

# AGAST #1667: an arm yielding a bare `Ok(..)` / `Err(..)` / `Some(..)` /
# `None` builds whichever enum its context dictates (resolve_enum_ctx, the
# same lookup emit_variant_struct made while emitting the arm), so the merge
# phi must have that type rather than i64.  `arg_parse_i64`'s
# `Some(n) => Ok(n)` / `None => Err(..)` emitted `phi i64 [%Result$..]`.
fn variant_ctor_arm_type(s: *EmitterState, e: *Expr, out_name: **u8, out_len: *i32)
    *out_name = null
    *out_len = 0
    if e == null
        return
    var is_ctor: i32 = 0
    if e.kind == EXPR_CALL
        if is_variant_carrier(e.func_name, e.func_name_len) == 1 or is_variant_null(e.func_name, e.func_name_len) == 1
            is_ctor = 1
    else if e.kind == EXPR_IDENT
        # Unshadowed `None`, mirroring emit_expr_ident.
        if is_ident_none(e.ident_ptr, e.ident_len) == 1
            if is_const(s, e.ident_ptr, e.ident_len) == 0 and find_local(s, e.ident_ptr, e.ident_len) < 0
                if find_global(s, e.ident_ptr, e.ident_len) == null
                    is_ctor = 1
    if is_ctor == 1
        resolve_enum_ctx(s, out_name, out_len)

# Emit a block arm's statements (AGAST #1454).  `return` leaves the block
# terminated by `ret`, but the arm still records a phi incoming and emits its
# `br` to the match end.  Without a fresh block the phi would name the block
# holding the `ret` as a predecessor, and clang rejects the module ("PHI node
# entries do not match predecessors").  Opening an (unreachable) block after
# each `ret` makes current_label the block that really branches to the end,
# exactly as STMT_BREAK / STMT_CONTINUE already do (ritz-task-195).
fn emit_match_arm_stmts(s: *EmitterState, stmts: *Stmt)
    var st: *Stmt = stmts
    while st != null
        emit_stmt(s, st, s.fn_ret_type)
        if st.kind == STMT_RETURN
            begin_block(s, next_label(s))
            clear_last_expr(s)
        st = st.next

fn match_result_init(r: *MatchResult, n_arms: i32)
    var n: i64 = n_arms as i64
    if n < 1
        n = 1
    r.values = malloc(n * 4) as *i32
    r.labels = malloc(n * 4) as *i32
    r.count = 0
    r.agg_name = null
    r.agg_name_len = 0

# Emit match body, returning (result_reg, exit_label) via MatchResult slot.
# For PAT_VARIANT arms with PAT_IDENT inner (e.g. `Ok(v) => v`), the inner
# name is bound to the extracted payload for the duration of the arm body,
# then popped via local_count rollback. (task-99 #105)
fn emit_match_arm_body(s: *EmitterState, arm: *MatchArm, scrut_reg: i32, scrut_slot: i32, enum_name: *u8, enum_name_len: i32, result: *MatchResult, arm_index: i32, end_label: i32)
    # Save local_count so arm-scoped bindings get popped after the body.
    let saved_local_count: i32 = s.local_count

    # Bind variant payload to inner pattern name on `Constructor(binding)`.
    if arm.pattern_kind == PAT_VARIANT
        if arm.pattern_inner_kind == PAT_IDENT
            if arm.pattern_inner_name_len > 0
                var is_wildcard: i32 = 0
                if arm.pattern_inner_name_len == 1
                    if *arm.pattern_inner_name == 95   # '_'
                        is_wildcard = 1
                var pay_struct: *u8 = null
                var pay_struct_len: i32 = 0
                if is_wildcard == 0 and scrut_slot != 0
                    carrier_payload_struct(s, arm, enum_name, enum_name_len, @pay_struct, @pay_struct_len)
                if is_wildcard == 0 and pay_struct != null
                    emit_struct_payload_bind(s, arm, scrut_slot, enum_name, enum_name_len, pay_struct, pay_struct_len)
                else if is_wildcard == 0
                    var payload_reg: i32 = 0
                    if scrut_slot != 0 and enum_name != null and enum_name_len > 0
                        payload_reg = emit_variant_payload(s, scrut_slot, enum_name, enum_name_len, 1 - variant_is_tag_one(arm.pattern_name, arm.pattern_name_len))
                    else
                        # Non-enum scrutinee (shouldn't reach here in practice).
                        payload_reg = scrut_reg
                    let alloca_reg: i32 = next_reg(s)
                    emit_str(s, c"  ")
                    emit_reg(s, alloca_reg)
                    emit_str(s, c" = alloca i64  ; match payload bind\n")
                    emit_str(s, c"  store i64 ")
                    emit_reg(s, payload_reg)
                    emit_str(s, c", ptr ")
                    emit_reg(s, alloca_reg)
                    emit_str(s, c"\n")
                    add_local(s, arm.pattern_inner_name, arm.pattern_inner_name_len, alloca_reg, TYPE_I64)

    # Block-bodied / statement arm (AGAST #1454, #1617): run the leading
    # statements in the arm's own scope (they are popped with the payload
    # binding below), then fall into the value path, which reads the
    # trailing expression match_arm_set_block left in arm.body.
    emit_match_arm_stmts(s, arm.body_stmts)

    var body_reg: i32 = 0
    if arm.is_pass == 1
        body_reg = next_reg(s)
        emit_str(s, c"  ")
        emit_reg(s, body_reg)
        emit_str(s, c" = add i64 0, 0  ; match arm: pass\n")
    else if arm.body != null
        body_reg = emit_expr(s, arm.body)
        # AGAST #1645: resolve the arm's struct type while its pattern
        # binding (`Some(v) => v`) is still in scope; it is popped below.
        var arm_ty: *u8 = null
        var arm_ty_len: i32 = 0
        resolve_expr_struct_name(s, arm.body, @arm_ty, @arm_ty_len)
        if arm_ty == null
            variant_ctor_arm_type(s, arm.body, @arm_ty, @arm_ty_len)
        # The first struct-valued arm fixes the phi type.  A `"..."` arm is a
        # StrView in the language; its `%Span$u8` lowering (#98) is an
        # artefact, so a leading literal arm types the phi as StrView, the
        # same type a later `Some(s) => s` over Option<StrView> yields.
        if result.agg_name == null and arm_ty != null and arm_ty_len > 0
            if arm.body.kind == EXPR_STRING_LIT
                result.agg_name = c"StrView"
                result.agg_name_len = 7
            else
                result.agg_name = arm_ty
                result.agg_name_len = arm_ty_len
        # AGAST #1662: rebuild a layout-equivalent arm value (Span$u8 <->
        # StrView, #168) as the phi's type here, in the arm's own block before
        # its `br`, so every phi incoming value has the phi's type.
        if is_layout_equiv_pair(arm_ty, arm_ty_len, result.agg_name, result.agg_name_len) == 1
            body_reg = rebuild_layout_equiv(s, body_reg, arm_ty, arm_ty_len, result.agg_name, result.agg_name_len)
    else
        body_reg = next_reg(s)
        emit_str(s, c"  ")
        emit_reg(s, body_reg)
        emit_str(s, c" = add i64 0, 0  ; match arm: null body\n")

    s.local_count = saved_local_count
    # ritz-task-193 — drop the inner-arm binding from local_map so the next
    # find_local on the shadowed name returns the outer binding via the map
    # fast-path (the find fallback would otherwise carry the cost).
    rebuild_local_map(s)

    let exit_label: i32 = s.current_label
    result.values[arm_index] = body_reg
    result.labels[arm_index] = exit_label
    if arm_index + 1 > result.count
        result.count = arm_index + 1

    emit_str(s, c"  br label %")
    emit_label(s, end_label)
    emit_str(s, c"\n")

# Emit one arm's condition + body.  `scrut_slot` is an alloca holding the
# scrutinee struct (when enum_name is non-null), or 0 for scalar scrutinees.
fn emit_match_arm(s: *EmitterState, arm: *MatchArm, scrut_reg: i32, scrut_slot: i32, enum_name: *u8, enum_name_len: i32, result: *MatchResult, arm_index: i32, end_label: i32)
    let body_label: i32 = next_label(s)
    let next_label_id: i32 = next_label(s)

    var cond_reg: i32 = 0
    var always_true: i32 = 0
    let is_enum_match: i32 = (enum_name != null) and (enum_name_len > 0)

    if arm.pattern_kind == PAT_INT_LIT
        cond_reg = next_reg(s)
        emit_str(s, c"  ")
        emit_reg(s, cond_reg)
        emit_str(s, c" = icmp eq i64 ")
        emit_reg(s, scrut_reg)
        emit_str(s, c", ")
        emit_int(s, arm.pattern_int)
        emit_str(s, c"\n")
    else if arm.pattern_kind == PAT_WILDCARD
        always_true = 1
    else if arm.pattern_kind == PAT_IDENT
        # Ident pattern — unit variant (None/Err/Light/Dark) or a binding.
        # First try the user-enum tracker so user-declared variants resolve
        # to their proper tag index; fall back to None/Err special-casing
        # for tagged enums; otherwise treat as a binding (always_true).
        if is_enum_match == 1 and is_enum_type(enum_name, enum_name_len) == 1
            let user_idx: i32 = enum_variant_index(enum_name, enum_name_len, arm.pattern_name, arm.pattern_name_len)
            if user_idx >= 0
                cond_reg = emit_variant_tag_check_eq(s, scrut_slot, enum_name, enum_name_len, user_idx)
        if cond_reg == 0 and arm.pattern_name_len == 4
            if *arm.pattern_name == 78 and *(arm.pattern_name + 1) == 111
                if *(arm.pattern_name + 2) == 110 and *(arm.pattern_name + 3) == 101
                    # "None": null variant → tag != 0
                    if is_enum_match == 1
                        cond_reg = emit_variant_tag_check(s, scrut_slot, enum_name, enum_name_len, 0)
                    else
                        cond_reg = emit_variant_tag_check_i64(s, scrut_reg, 0)
        if cond_reg == 0
            always_true = 1
    else if arm.pattern_kind == PAT_VARIANT
        # User-declared enum: look up the variant's tag index from the
        # parser's enum tracker (Shade.Light=0, Shade.Dark=1).  Falls back
        # to the binary Some/Ok-vs-None/Err mapping for tagged enums.
        if is_enum_match == 1 and is_enum_type(enum_name, enum_name_len) == 1
            let user_idx: i32 = enum_variant_index(enum_name, enum_name_len, arm.pattern_name, arm.pattern_name_len)
            if user_idx >= 0
                cond_reg = emit_variant_tag_check_eq(s, scrut_slot, enum_name, enum_name_len, user_idx)
            else
                always_true = 1
        else
            let tag_one: i32 = variant_is_tag_one(arm.pattern_name, arm.pattern_name_len)
            if is_enum_match == 1
                cond_reg = emit_variant_tag_check(s, scrut_slot, enum_name, enum_name_len, tag_one)
            else
                cond_reg = emit_variant_tag_check_i64(s, scrut_reg, tag_one)
    else
        always_true = 1

    if always_true == 1
        emit_str(s, c"  br label %")
        emit_label(s, body_label)
        emit_str(s, c"\n")
    else
        emit_str(s, c"  br i1 ")
        emit_reg(s, cond_reg)
        emit_str(s, c", label %")
        emit_label(s, body_label)
        emit_str(s, c", label %")
        emit_label(s, next_label_id)
        emit_str(s, c"\n")

    begin_block(s, body_label)
    emit_match_arm_body(s, arm, scrut_reg, scrut_slot, enum_name, enum_name_len, result, arm_index, end_label)

    begin_block(s, next_label_id)

# Resolve the scrutinee's enum struct type name by peeking at the AST:
#   * EXPR_IDENT   -> local's recorded struct type
#   * EXPR_CALL    -> callee's return struct type (by name)
#   * EXPR_UNARY*  -> unwrap deref (match *res) and recurse
# Returns 1 with (out_name, out_len) filled, 0 otherwise.
fn resolve_scrutinee_enum(s: *EmitterState, scr: *Expr, out_name: **u8, out_len: *i32) -> i32
    if scr.kind == EXPR_IDENT
        let loc: *LocalVar = find_local_struct_name(s, scr.ident_ptr, scr.ident_len)
        if loc != null
            if loc.type_name_len > 0
                if is_tagged_enum_type(loc.type_name, loc.type_name_len) == 1
                    *out_name = loc.type_name
                    *out_len = loc.type_name_len
                    return 1
                # Also recognize user-declared enums (Shade, etc.) via the
                # parser's per-enum tracker.  Their layout is `{ i8 tag }`
                # (no payload) so match logic uses the same tag-byte GEP.
                if is_enum_type(loc.type_name, loc.type_name_len) == 1
                    *out_name = loc.type_name
                    *out_len = loc.type_name_len
                    return 1
    else if scr.kind == EXPR_CALL
        let fd: *FnDef = find_call_fn(s, scr)
        if fd != null
            if fd.return_type == TYPE_STRUCT
                if fd.return_type_name_len > 0
                    if is_tagged_enum_type(fd.return_type_name, fd.return_type_name_len) == 1
                        *out_name = fd.return_type_name
                        *out_len = fd.return_type_name_len
                        return 1
                    if is_enum_type(fd.return_type_name, fd.return_type_name_len) == 1
                        *out_name = fd.return_type_name
                        *out_len = fd.return_type_name_len
                        return 1
    else if scr.kind == EXPR_UNARY
        if scr.op == OP_DEREF
            return resolve_scrutinee_enum(s, scr.operand, out_name, out_len)
    *out_name = null
    *out_len = 0
    return 0

# Main entry: emit a match construct. Returns the phi register holding
# the match's result value (or 0 if no arms contribute).
fn emit_match(s: *EmitterState, scrutinee: *Expr, arms: *MatchArm) -> i32
    # Detect whether the scrutinee is a tagged-enum struct; if so, spill
    # it into an alloca once so every arm can GEP the same pointer.
    var enum_name: *u8 = null
    var enum_name_len: i32 = 0
    let is_enum: i32 = resolve_scrutinee_enum(s, scrutinee, @enum_name, @enum_name_len)

    # Evaluate scrutinee
    let scrut_reg: i32 = emit_expr(s, scrutinee)
    var scrut_slot: i32 = 0
    if is_enum == 1
        scrut_slot = next_reg(s)
        emit_str(s, c"  ")
        emit_reg(s, scrut_slot)
        emit_str(s, c" = alloca %")
        emit_name(s, enum_name, enum_name_len)
        emit_str(s, c"  ; match scrut spill\n")
        emit_str(s, c"  store %")
        emit_name(s, enum_name, enum_name_len)
        emit_str(s, c" ")
        emit_reg(s, scrut_reg)
        emit_str(s, c", ptr ")
        emit_reg(s, scrut_slot)
        emit_str(s, c"\n")

    let end_label: i32 = next_label(s)
    var n_arms: i32 = 0
    var counted: *MatchArm = arms
    while counted != null
        n_arms = n_arms + 1
        counted = counted.next
    var result: MatchResult
    match_result_init(@result, n_arms)

    var arm: *MatchArm = arms
    var idx: i32 = 0
    while arm != null
        emit_match_arm(s, arm, scrut_reg, scrut_slot, enum_name, enum_name_len, @result, idx, end_label)
        arm = arm.next
        idx = idx + 1

    # Current block is the last "next" block — it has no matching arm, so
    # fall through to match end with a default value. This is the
    # non-exhaustive safety net.  For struct-valued arms (AGAST #1645) the
    # default is the aggregate `zeroinitializer` constant, written straight
    # into the phi below, so no instruction is emitted for it here.
    let is_agg: i32 = result.agg_name != null and result.agg_name_len > 0
    # AGAST #1666: publish the phi type for an untyped `let v = match ...`.
    # Set after every arm (nested matches inside arms included) so the
    # outermost match's type is what the enclosing let sees.
    if is_agg == 1
        s.last_match_agg_name = result.agg_name
        s.last_match_agg_name_len = result.agg_name_len
    else
        s.last_match_agg_name = null
        s.last_match_agg_name_len = 0
    var fallthrough_reg: i32 = 0
    if is_agg == 0
        fallthrough_reg = next_reg(s)
        emit_str(s, c"  ")
        emit_reg(s, fallthrough_reg)
        emit_str(s, c" = add i64 0, 0  ; match: non-exhaustive fallthrough\n")
    let fallthrough_label: i32 = s.current_label
    emit_str(s, c"  br label %")
    emit_label(s, end_label)
    emit_str(s, c"\n")

    # End block with phi over all arm results + fallthrough
    begin_block(s, end_label)

    # Emit phi: ( arm_result, arm_exit_label ) for each recorded arm,
    # plus ( fallthrough_reg, fallthrough_label ) at the end.
    if result.count == 0
        # No arms — return fallthrough value
        return fallthrough_reg

    let phi_reg: i32 = next_reg(s)
    emit_str(s, c"  ")
    emit_reg(s, phi_reg)
    emit_str(s, c" = phi ")
    if is_agg == 1
        emit_llvm_type_struct(s, TYPE_STRUCT, result.agg_name, result.agg_name_len)
    else
        emit_str(s, c"i64")
    emit_str(s, c" ")
    var i: i32 = 0
    while i < result.count
        if i > 0
            emit_str(s, c", ")
        emit_str(s, c"[ ")
        emit_reg(s, result.values[i])
        emit_str(s, c", %")
        emit_label(s, result.labels[i])
        emit_str(s, c" ]")
        i = i + 1
    # Add fallthrough entry
    emit_str(s, c", [ ")
    if is_agg == 1
        emit_str(s, c"zeroinitializer")
    else
        emit_reg(s, fallthrough_reg)
    emit_str(s, c", %")
    emit_label(s, fallthrough_label)
    emit_str(s, c" ]\n")
    return phi_reg

# AGAST #1613: does an if-expression arm end by leaving the block (`return`,
# `break`, `continue`)?  Such an arm reaches the merge only through the
# unreachable block emit_match_arm_stmts opens after it, so its lack of a
# value is harmless; any other valueless arm is an error.
fn if_arm_diverges(arm: *MatchArm) -> i32
    var last: *Stmt = arm.body_stmts
    if last == null
        return 0
    while last.next != null
        last = last.next
    if last.kind == STMT_RETURN or last.kind == STMT_BREAK or last.kind == STMT_CONTINUE
        return 1
    0

# Reject a valueless arm before anything is emitted for it.  A trailing
# else-less `if` gets ritz0's wording (LANGUAGE_SPEC §6.1, AGAST #1406);
# expr_if already turned every trailing if/else into the arm's value.
fn if_arm_check_value(s: *EmitterState, arm: *MatchArm)
    if arm.is_pass == 0 or if_arm_diverges(arm) == 1
        return
    var last: *Stmt = arm.body_stmts
    while last != null and last.next != null
        last = last.next
    if last != null and last.kind == STMT_IF
        emit_ir_error(s, c"an `if` with no `else` has no value when its condition is false, so it cannot be used as a value here; add an `else` arm")
    else
        emit_ir_error(s, c"an `if` expression arm does not end in a value")

# Emit an if/else expression (AGAST #1613): `left` is the condition, `args`
# the then-arm and its `next` the else-arm (see expr_if).  Lowered like a
# two-arm match with no fallthrough: each arm goes through
# emit_match_arm_body, which emits its block statements, its value and the
# `br` to the merge, and types a struct-valued arm (#1645) so the phi is
# `%StrView` / `%Point` rather than i64.  Returns the phi register.
fn emit_if_expr(s: *EmitterState, e: *Expr) -> i32
    let then_arm: *MatchArm = e.args as *MatchArm
    let else_arm: *MatchArm = then_arm.next
    if_arm_check_value(s, then_arm)
    if_arm_check_value(s, else_arm)

    # Same i1 / i64 decision as STMT_IF (bool_reg_is_i1, AGAST #1367, #1646).
    let cond: i32 = emit_expr(s, e.left)
    var cond_i1: i32 = cond
    if bool_reg_is_i1(s, e.left) == 0
        cond_i1 = next_reg(s)
        emit_str(s, c"  ")
        emit_reg(s, cond_i1)
        emit_str(s, c" = icmp ne i64 ")
        emit_reg(s, cond)
        emit_str(s, c", 0\n")

    let then_label: i32 = next_label(s)
    let else_label: i32 = next_label(s)
    let end_label: i32 = next_label(s)
    emit_str(s, c"  br i1 ")
    emit_reg(s, cond_i1)
    emit_str(s, c", label %")
    emit_label(s, then_label)
    emit_str(s, c", label %")
    emit_label(s, else_label)
    emit_str(s, c"\n")

    var result: MatchResult
    match_result_init(@result, 2)
    begin_block(s, then_label)
    emit_match_arm_body(s, then_arm, 0, 0, null, 0, @result, 0, end_label)
    begin_block(s, else_label)
    emit_match_arm_body(s, else_arm, 0, 0, null, 0, @result, 1, end_label)
    begin_block(s, end_label)

    # Publish the phi type for an untyped `let v = if ...` (#1666's path);
    # set after both arms so a nested if/match inside an arm can't clobber it.
    let is_agg: i32 = result.agg_name != null and result.agg_name_len > 0
    if is_agg == 1
        s.last_match_agg_name = result.agg_name
        s.last_match_agg_name_len = result.agg_name_len
    else
        s.last_match_agg_name = null
        s.last_match_agg_name_len = 0

    let phi_reg: i32 = next_reg(s)
    emit_str(s, c"  ")
    emit_reg(s, phi_reg)
    emit_str(s, c" = phi ")
    if is_agg == 1
        emit_llvm_type_struct(s, TYPE_STRUCT, result.agg_name, result.agg_name_len)
    else
        emit_str(s, c"i64")
    var i: i32 = 0
    while i < 2
        if i > 0
            emit_str(s, c",")
        emit_str(s, c" [ ")
        emit_reg(s, result.values[i])
        emit_str(s, c", %")
        emit_label(s, result.labels[i])
        emit_str(s, c" ]")
        i = i + 1
    emit_str(s, c"\n")
    return phi_reg
