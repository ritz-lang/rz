# ritz1/src/emitter_match.ritz - Match expression/statement lowering
#
# Added in ritz-task-87. Lowers `match scrutinee \n PATTERN => BODY ...`
# to a linear if-else-if chain in LLVM IR.
#
# Design notes:
# - Scrutinee is evaluated once into a register (i64).
# - Each arm emits:
#     match_test:  icmp eq i64 %scrut, <literal>   (or tag comparison for variants)
#                  br i1 %cond, label %match_body_N, label %match_next_N
#     match_body_N:
#                  ... arm body emitted ...
#                  br label %match_end
#     match_next_N: (next arm's test, or `unreachable` after the last)
# - Wildcard/ident arms unconditionally branch to their body (effectively
#   the catch-all / default). Once we emit an unconditional arm, later
#   arms become dead code (emitted but unreachable).
# - match_check_coverage refuses a match that misses (LARB R6, AGAST #2344), so
#   the block after the last arm is `unreachable`.
# - `pass` arms emit a zero value for their body result.
# - Match result is collected via phi over (arm_body_result, arm_exit_label)
#   pairs so `let x = match ...` works.  The phi is i64 unless an arm yields
#   a known struct (`Some(v) => v` over Option<StrView>), in which case it is
#   that struct type (AGAST #1645).  Arms yielding the layout-equivalent
#   Span$u8/StrView pair are rebuilt to the phi's type in their own block, and
#   a `"..."` arm counts as StrView (AGAST #1662).
# - A match with an arm that calls a void fn (`Some(e) => say(e)`) has no
#   value: no phi, and emit_match returns 0 like a void call (AGAST #1654).
#   `return` / `break` / `continue` arms leave through their own terminator
#   and feed the phi a zero from the unreachable block opened after it.
#
# Variant patterns (Some(v) / None / Ok(v) / Err(_)) use a tag convention:
#   Some(x) / Ok(x) -> high 16 bits = 1, low 48 bits = x
#   None / Err(x)   -> high 16 bits = 0
# Encoded via simple bitwise ops so we don't need an enum-type system yet.
# See emit_variant_constructor_call in emitter_expr_call.ritz for the
# producer side of this convention.

import ritzlib.sys
import ritzlib.io
import ritzlib.str
import ritzlib.gvec
import ritzlib.memory

import ast
import types
import ast_helpers
import tokens_gen
import emitter_core
import emitter_ir
import diag                 # diag_error_at (AGAST #3621)
import emitter_expr
import emitter_expr_call     # is_variant_carrier, is_variant_null, resolve_enum_ctx
import emitter_expr_access   # is_ident_none
import emitter_print         # interp_is_bool (AGAST #2344)
import emitter_stmt          # emit_stmt, for block-bodied arms (AGAST #1454)
import ownership            # arm scopes for drops (AGAST #2158)
import bool_check   # AGAST #2342
import bool_kind
import float_slot   # float_slot_unsigned (AGAST #3313, #4376)
import monomorph     # ArrayArg (AGAST #3029)
import narrowing    # narrow_note_binding (AGAST #3345)
import binder_check
import emitter_expr_arith

# Phi result tracking during emit_match.
# We need to collect (value_reg, exit_label) pairs across all non-pass arms
# so we can emit a terminating phi at the match.end label.
# Sized to the arm count by match_result_init (AGAST #1813): fixed [64]
# arrays silently dropped the phi incoming edges of arms past the 64th.
struct MatchResult
    values: *i32   # register numbers holding each arm's result
    labels: *i32   # exit label numbers for each arm's result
    count: i32
    # AGAST #1645: LLVM struct type the arms yield (`%StrView`, `%Point`),
    # or null when they yield the usual i64 scalar.  The merge phi is emitted
    # at this type.
    agg_name: *u8
    agg_name_len: i32
    # AGAST #1946: TypeKind.F32 / TypeKind.F64 when the arms yield a float, else 0.
    # Fixed by the enclosing let / return's hint (match_float_hint) or by
    # the first float-valued arm; later arms are coerced to it.
    float_ty: TypeKind
    # AGAST #2092: the enclosing let / return's float hint itself (0 if
    # none), handed on to a match / if that is an arm's value tail so the
    # annotation reaches every nested tail, as in ritz0.  Unlike float_ty it
    # is never set by an arm: an unannotated match passes nothing down.
    hint_ty: TypeKind
    # Arms recorded as i64 values before float_ty was fixed: they cannot be
    # coerced after the fact (their `br` is already emitted).
    int_arms: i32
    # AGAST #1654: arms whose body expression produced no value (a call to a
    # void fn: emit_expr returns register 0, which is never defined).  Any
    # such arm makes the match valueless: emit_match emits no phi.
    void_arms: i32
    # AGAST #2046: where the first valueless arm is (its innermost void
    # call), for the error when the match's value is wanted.
    void_line: i32
    void_col: i32
    # AGAST #2950: 1 when every value arm yields a `ptr` (`@&x`), so the phi
    # is a `ptr` (arms_ptr_valued, asked before the arms are emitted).
    ptr_ty: i32
    # AGAST #3276: the whole `[N]T` each arm stores its value into, or null
    # (the arms meet in a phi).  See emit_match_into.
    into: *ArrayInto
    # AGAST #3696: the `alloca %T` register every arm of a large struct %T
    # (at the sret threshold) stores its value into, or 0.  The merge loads
    # it instead of a `phi %T`.  slot_misses counts value arms recorded
    # before the slot existed; any forces the phi back (match_merge_slot).
    slot: i32
    slot_misses: i32
    # AGAST #3028: 1 when nothing reads the match's value (a match statement
    # before the block's last, or an expression arm of such a match).  An
    # expression arm's `t` with `t:& T` then reads nothing, as in ritz0.
    discarded: i32

# AGAST #3276: where a `match` of whole arrays stores each arm's array: the
# `[N x T]` at `ptr`, held to N (`size`) and T (`et`; a struct's `name`).
struct ArrayInto
    ptr: i32
    size: i32
    et: TypeKind
    name: *u8
    name_len: i32

# AGAST #1946: a `values[]` entry for an arm with no value (`pass`, or a body
# with no trailing expression): the phi gets the zero constant of its type
# instead of an `add i64 0, 0` register, which mismatched a float or struct
# phi.
const MATCH_ZERO_VALUE: i32 = -1

# Check if a variant name denotes the "Some/Ok" (tagged) side of its enum.
# Returns 1 if tag should be 1, 0 otherwise.
# Heuristic: names "Some", "Ok" are the carrier variants; "None", "Err"
# are the null variants. Any other variant currently defaults to tag 0
# (which makes arbitrary enum matching equivalent to "match anything").
fn variant_is_tag_one(name_sv: StrView) -> i32
    var name: *u8 = name_sv.ptr
    var len: i32 = name_sv.len as i32
    if len == 4
        # "Some"
        if *name == 'S' and *(name + 1) == 'o' and *(name + 2) == 'm' and *(name + 3) == 'e'
            return 1
    if len == 2
        # "Ok"
        if *name == 'O' and *(name + 1) == 'k'
            return 1
    return 0

# Emit a check for the scrutinee being of a given variant against the
# struct layout `{ i8 tag, [N x i8] payload }` (ritz-task-133 parity with
# ritz0).  `slot_reg` is a pointer to the scrutinee struct (the match
# prelude spills the scrutinee value into an alloca once).  `enum_name`
# is the `%Result$.../Option$...` type name used to GEP.  `tag_one == 1`
# checks for the carrier variant (Ok / Some); 0 checks for the null
# variant (Err / None).  ritz0 tag convention: Ok=0 Err=1 Some=0 None=1,
# so carrier <=> tag==0.
# User-enum variant check: load the tag byte and compare against an
# arbitrary i8 tag value (instead of the tagged-enum 0/1 binary check).
# Used when the scrutinee's enum is a parser-tracked user enum (Shade,
# etc.) and the match arm names a specific variant by index.
fn emit_variant_tag_check_eq(s: *EmitterState, slot_reg: i32, enum_name_sv: StrView, tag_value: i32) -> i32
    var enum_name: *u8 = enum_name_sv.ptr
    var enum_name_len: i32 = enum_name_sv.len as i32
    let tag_ptr: i32 = next_reg(s)
    emit_str(s, IR_INDENT)
    emit_reg(s, tag_ptr)
    emit_str(s, IR_GEP_NAMED)
    emit_name(s, StrView { ptr: (enum_name), len: (enum_name_len) as i64 })
    emit_str(s, IR_PTR_SEP)
    emit_reg(s, slot_reg)
    emit_str(s, c", i32 0, i32 0\n")
    # AGAST #4574: a repr enum holds its discriminant in the repr type.
    let tag_ty: *u8 = enum_tag_ty_named(enum_name_sv)
    let tag_reg: i32 = next_reg(s)
    emit_load_into(s, tag_ty, tag_reg, tag_ptr)
    let cmp_reg: i32 = next_reg(s)
    emit_str(s, IR_INDENT)
    emit_reg(s, cmp_reg)
    emit_str(s, c" = icmp eq ")
    emit_str(s, tag_ty)
    emit_str(s, IR_SP)
    emit_reg(s, tag_reg)
    emit_str(s, IR_COMMA)
    emit_int(s, enum_tag_value_named(enum_name_sv, tag_value))
    emit_str(s, IR_NL)
    return cmp_reg

fn emit_variant_tag_check(s: *EmitterState, slot_reg: i32, enum_name_sv: StrView, tag_one: i32) -> i32
    var enum_name: *u8 = enum_name_sv.ptr
    var enum_name_len: i32 = enum_name_sv.len as i32
    let tag_ptr: i32 = next_reg(s)
    emit_str(s, IR_INDENT)
    emit_reg(s, tag_ptr)
    emit_str(s, IR_GEP_NAMED)
    emit_name(s, StrView { ptr: (enum_name), len: (enum_name_len) as i64 })
    emit_str(s, IR_PTR_SEP)
    emit_reg(s, slot_reg)
    emit_str(s, c", i32 0, i32 0\n")
    let tag_reg: i32 = next_reg(s)
    emit_load_into(s, IR_TY_I8, tag_reg, tag_ptr)
    let cmp_reg: i32 = next_reg(s)
    emit_str(s, IR_INDENT)
    emit_reg(s, cmp_reg)
    if tag_one == 1
        # carrier (Ok/Some) → tag == 0
        emit_str(s, c" = icmp eq i8 ")
    else
        # null (Err/None) → tag != 0
        emit_str(s, c" = icmp ne i8 ")
    emit_reg(s, tag_reg)
    emit_str(s, IR_COMMA_0)
    return cmp_reg

# Extract the variant payload as an i64 (the common scalar case).  Payload
# sits at field 2 (the `[N x i8]` buffer after the alignment pad, AGAST
# #1898), stored at its own width; it is widened to i64 because ritz1's
# downstream arithmetic / call paths operate on i64 registers.  `variant` is
# 0 for Ok / Some, 1 for Err.
fn emit_variant_payload(s: *EmitterState, slot_reg: i32, enum_name_sv: StrView, variant: i32) -> i32
    var enum_name: *u8 = enum_name_sv.ptr
    var enum_name_len: i32 = enum_name_sv.len as i32
    # `variant` is a selector (variant_sel): field k sits at its offset.
    let pay_ptr: i32 = emit_payload_ptr(s, slot_reg, StrView { ptr: (enum_name), len: (enum_name_len) as i64 }, variant)
    return emit_tagged_payload_load(s, pay_ptr, StrView { ptr: (enum_name), len: (enum_name_len) as i64 }, variant)

# The LLVM integer type of narrow integer type code `t` (AGAST #3116).
fn narrow_int_llvm(t: TypeKind) -> *u8
    if ty_int_bits(t) == 8
        return c"i8"
    if ty_int_bits(t) == 16
        return c"i16"
    c"i32"

# Scalar-scrutinee fallback (non-enum `match x on int`).
fn emit_variant_tag_check_i64(s: *EmitterState, scrut_reg: i32, tag_one: i32) -> i32
    # Legacy packed-i64 path retained only for non-enum match.  In practice
    # ritz1 code only uses `match` on Result/Option + integers; this branch
    # covers the latter.  Returns a conservative always-false for "variant"
    # patterns against a scalar scrutinee.
    let r: i32 = next_reg(s)
    emit_str(s, IR_INDENT)
    emit_reg(s, r)
    emit_str(s, c" = icmp eq i64 ")
    emit_reg(s, scrut_reg)
    emit_str(s, IR_COMMA_0)
    if tag_one == 1
        return r
    let inv: i32 = next_reg(s)
    emit_str(s, IR_INDENT)
    emit_reg(s, inv)
    emit_str(s, c" = xor i1 ")
    emit_reg(s, r)
    emit_str(s, c", true\n")
    return inv

# AGAST #1797: the tag of the variant `arm` names in user enum `enum_name`,
# or -1 (not a user enum, or no such variant).
# AGAST #1295: as the payload selector (variant_sel) of the binding the arm
# has selected (arm_select_bind): field pattern_field_sel of that variant.
fn user_arm_variant(enum_name_sv: StrView, arm: *MatchArm) -> i32
    var enum_name: *u8 = enum_name_sv.ptr
    var enum_name_len: i32 = enum_name_sv.len as i32
    if user_enum_index(StrView { ptr: (enum_name), len: (enum_name_len) as i64 }) < 0
        return 0 - 1
    let vi: i32 = enum_variant_index(StrView { ptr: (enum_name), len: (enum_name_len) as i64 }, StrView { ptr: (arm.pattern_name), len: (arm.pattern_name_len) as i64 })
    if vi < 0
        return vi
    return variant_sel(vi, arm.pattern_field_sel)

# AGAST #1515: the struct type carried by a tagged enum's carrier variant
# (Ok/Some): see tagged_enum_payload_struct.  AGAST #1667 adds Result's Err
# side (tagged_enum_err_payload_struct), and #2100 a non-generic user enum
# payload.  When it names a known struct or enum, fills (out_name, out_len);
# otherwise leaves them null/0 and the caller keeps the scalar i64 binding
# (primitives, pointers, None).
fn carrier_payload_struct(s: *EmitterState, arm: *MatchArm, enum_name_sv: StrView, out_name: **u8, out_len: *i32)
    var enum_name: *u8 = enum_name_sv.ptr
    var enum_name_len: i32 = enum_name_sv.len as i32
    *out_name = null
    *out_len = 0
    if enum_name == null or enum_name_len <= 0
        return
    if is_tagged_enum_type(StrView { ptr: (enum_name), len: (enum_name_len) as i64 }) == 0
        # AGAST #1797: a user enum's tuple variant declares its payload.
        let uf: *StructField = user_enum_tuple_field(StrView { ptr: (enum_name), len: (enum_name_len) as i64 }, user_arm_variant(StrView { ptr: (enum_name), len: (enum_name_len) as i64 }, arm))
        if uf != null
            if uf.field_type == TypeKind.Struct and uf.field_type_name_len > 0
                *out_name = uf.field_type_name
                *out_len = uf.field_type_name_len
        return
    # AGAST #2987: a payload declared as a tagged enum (`Some(x)` over
    # `Option<Option<i32>>`, `Ok(x)` / `Err(x)` over a Result carrying one)
    # binds at that aggregate, as emit_variant_build stores it.  It was
    # loaded as an i64.
    var decl_len: i32 = 0
    let decl: *u8 = tagged_enum_arg(s, StrView { ptr: (enum_name), len: (enum_name_len) as i64 }, 1 - variant_is_tag_one(StrView { ptr: (arm.pattern_name), len: (arm.pattern_name_len) as i64 }), @decl_len)
    if decl != null and decl_len > 0 and is_tagged_enum_type(StrView { ptr: (decl), len: (decl_len) as i64 }) == 1
        *out_name = decl
        *out_len = decl_len
        return
    if variant_is_tag_one(StrView { ptr: (arm.pattern_name), len: (arm.pattern_name_len) as i64 }) == 0
        # AGAST #1667: `Err(e)` over Result<T, E> with a struct E binds at %E.
        if arm.pattern_name_len == 3 and *arm.pattern_name == 'E' and *(arm.pattern_name + 1) == 'r' and *(arm.pattern_name + 2) == 'r'   # "Err"
            *out_name = tagged_enum_err_payload_named(s, StrView { ptr: (enum_name), len: (enum_name_len) as i64 }, out_len, 1)
        return
    # AGAST #2100: a user-enum payload (`Some(x)` over Option<Opt>) binds at
    # %Opt too; it was loaded as an i64.
    *out_name = tagged_enum_payload_named(s, StrView { ptr: (enum_name), len: (enum_name_len) as i64 }, out_len, 1)

# AGAST #2436: when `arm`'s payload is a pointer to a struct (`Some(v)` over
# `Option<*Pair>` / `Result<*Pair, E>`, `E.P(v)` over a `P(*Pair)`, `P(@Pair)`
# or `P(@&Pair)` variant), fills (out_name, out_len) with the struct and
# returns the binding's var_type (TypeKind.Ptr, or TypeKind.Ref / TypeKind.MutRef for a
# user enum's `@T` / `@&T`).  Otherwise returns 0 and the caller keeps the
# i64 binding: a pointer to a primitive is #4448's
# carrier_payload_ptr_primitive below.  That i64 had no pointee, so `v.a` and
# `(*v).a` were "unhandled EXPR_MEMBER".  AGAST #3047: a `**T` payload
# (`Option<**Pair>`, a user enum's `P(**Pair)`) returns TypeKind.PtrPtr, still
# naming the struct.
fn carrier_payload_ptr_struct(s: *EmitterState, arm: *MatchArm, enum_name_sv: StrView, out_name: **u8, out_len: *i32) -> TypeKind
    var enum_name: *u8 = enum_name_sv.ptr
    var enum_name_len: i32 = enum_name_sv.len as i32
    *out_name = null
    *out_len = 0
    if enum_name == null or enum_name_len <= 0
        return TypeKind.Void
    if is_tagged_enum_type(StrView { ptr: (enum_name), len: (enum_name_len) as i64 }) == 0
        let uf: *StructField = user_enum_tuple_field(StrView { ptr: (enum_name), len: (enum_name_len) as i64 }, user_arm_variant(StrView { ptr: (enum_name), len: (enum_name_len) as i64 }, arm))
        if uf == null or uf.array_size != 0 or uf.field_type_name_len <= 0
            return TypeKind.Void
        if uf.field_type != TypeKind.Ptr and uf.field_type != TypeKind.PtrPtr and uf.field_type != TypeKind.Ref and uf.field_type != TypeKind.MutRef
            return TypeKind.Void
        if is_concrete_payload_type(s, StrView { ptr: (uf.field_type_name), len: (uf.field_type_name_len) as i64 }, 0) == 0
            return TypeKind.Void
        *out_name = uf.field_type_name
        *out_len = uf.field_type_name_len
        return uf.field_type
    # Option / Result: the mangled argument spells `*Pair` as "ptr_Pair",
    # `@Pair` "ref_Pair" and `@&Pair` "refmut_Pair" (AGAST #2384).
    var decl_len: i32 = 0
    let decl: *u8 = tagged_enum_arg(s, StrView { ptr: (enum_name), len: (enum_name_len) as i64 }, 1 - variant_is_tag_one(StrView { ptr: (arm.pattern_name), len: (arm.pattern_name_len) as i64 }), @decl_len)
    if decl == null
        return TypeKind.Void
    let k: i32 = mangled_ref_prefix(StrView { ptr: (decl), len: (decl_len) as i64 })
    if k == 0
        return TypeKind.Void
    # AGAST #3047: `**Pair` spells "ptr_ptr_Pair" (`@*Pair`, "ref_ptr_Pair",
    # stays unbound).
    if decl_len > 8 and memcmp(decl, c"ptr_ptr_", 8) == 0
        if is_concrete_payload_type(s, StrView { ptr: (decl + 8), len: (decl_len - 8) as i64 }, 0) == 0
            return TypeKind.Void
        *out_name = decl + 8
        *out_len = decl_len - 8
        return TypeKind.PtrPtr
    if is_concrete_payload_type(s, StrView { ptr: (decl + k), len: (decl_len - k) as i64 }, 0) == 0
        return TypeKind.Void
    *out_name = decl + k
    *out_len = decl_len - k
    if k == 7
        return TypeKind.MutRef
    if *(decl + 1) == 'e'   # 'e': "ref_"
        return TypeKind.Ref
    TypeKind.Ptr

# AGAST #2436: bind a pointer-to-struct payload as a pointer local, as `let
# v: *Pair = ...` registers one, so the member chain finds the struct.  The
# payload loads as an i64 (emit_variant_payload); the local holds a `ptr`.
fn emit_ptr_payload_bind(s: *EmitterState, arm: *MatchArm, slot_reg: i32, enum_name_sv: StrView, variant: i32, var_type: TypeKind, st_name_sv: StrView)
    var enum_name: *u8 = enum_name_sv.ptr
    var enum_name_len: i32 = enum_name_sv.len as i32
    var st_name: *u8 = st_name_sv.ptr
    var st_name_len: i32 = st_name_sv.len as i32
    let raw: i32 = emit_variant_payload(s, slot_reg, StrView { ptr: (enum_name), len: (enum_name_len) as i64 }, variant)
    let ptr: i32 = ir_inttoptr_ptr(s.out, @s.reg_counter, raw)
    let alloca_reg: i32 = next_reg(s)
    entry_alloca_reg(s, alloca_reg, c"ptr", c"match pointer payload bind")
    emit_store_typed(s, IR_TY_PTR, ptr, alloca_reg)
    if var_type == TypeKind.PtrPtr
        # AGAST #3047: as `let pp: **Pair` registers (emitter_stmt.ritz,
        # #1933): pointee `*`, then the struct one level further in.
        add_local_full(s, StrView { ptr: (arm.pattern_inner_name), len: (arm.pattern_inner_name_len) as i64 }, alloca_reg, var_type, StrView { ptr: (st_name), len: (st_name_len) as i64 }, TypeKind.Ptr, 0, TypeKind.Void)
        set_local_inner_pointee(s, StrView { ptr: (arm.pattern_inner_name), len: (arm.pattern_inner_name_len) as i64 }, (TypeKind.Struct as i32))
        return
    add_local_full(s, StrView { ptr: (arm.pattern_inner_name), len: (arm.pattern_inner_name_len) as i64 }, alloca_reg, var_type, StrView { ptr: (st_name), len: (st_name_len) as i64 }, TypeKind.Struct, 0, TypeKind.Void)

# AGAST #4448: the primitive `T` a one-level pointer payload points at
# (`Some(n)` over `Option<*u8>`, `Ok(p)` over `Result<*u8, E>`, `P(p)` over a
# user enum's `P(*u8)`), or TypeKind.Void for every other payload.  A pointer to a
# struct is carrier_payload_ptr_struct's, and a `**T` / `@T` stays as it was.
# `n` used to be bound as an i64, so print's Display dispatch printed the
# address and `*n` had no pointee.
fn carrier_payload_ptr_primitive(s: *EmitterState, arm: *MatchArm, enum_name: *u8, enum_name_len: i32) -> TypeKind
    if enum_name == null or enum_name_len <= 0
        return TypeKind.Void
    if is_tagged_enum_type(StrView { ptr: (enum_name), len: (enum_name_len) as i64 }) == 0
        let uf: *StructField = user_enum_tuple_field(StrView { ptr: (enum_name), len: (enum_name_len) as i64 }, user_arm_variant(StrView { ptr: (enum_name), len: (enum_name_len) as i64 }, arm))
        if uf == null or uf.field_type != TypeKind.Ptr
            return TypeKind.Void
        let p: TypeKind = uf.ptr_pointee
        # A struct pointee (or a deeper pointer, or an array) is not primitive.
        if not type_is_scalar_leaf(p)
            return TypeKind.Void
        return p
    var decl_len: i32 = 0
    let decl: *u8 = tagged_enum_arg(s, StrView { ptr: (enum_name), len: (enum_name_len) as i64 }, 1 - variant_is_tag_one(StrView { ptr: (arm.pattern_name), len: (arm.pattern_name_len) as i64 }), @decl_len)
    if decl == null or decl_len <= 4 or memcmp(decl, c"ptr_", 4) != 0
        return TypeKind.Void
    primitive_type_from_name(StrView { ptr: (decl + 4), len: (decl_len - 4) as i64 })

# AGAST #4448: bind a pointer-to-primitive payload as the pointer local a
# `let n: *T` registers (emitter_stmt.ritz), so Display and the arithmetic /
# deref paths see the pointer, not an i64.
fn emit_primitive_ptr_payload_bind(s: *EmitterState, arm: *MatchArm, slot_reg: i32, enum_name: *u8, enum_name_len: i32, pointee: TypeKind)
    var sel: i32 = 1 - variant_is_tag_one(StrView { ptr: (arm.pattern_name), len: (arm.pattern_name_len) as i64 })
    let uvi: i32 = user_arm_variant(StrView { ptr: (enum_name), len: (enum_name_len) as i64 }, arm)
    if uvi >= 0
        sel = uvi
    let raw: i32 = emit_variant_payload(s, slot_reg, StrView { ptr: (enum_name), len: (enum_name_len) as i64 }, sel)
    let ptr: i32 = ir_inttoptr_ptr(s.out, @s.reg_counter, raw)
    let alloca_reg: i32 = next_reg(s)
    entry_alloca_reg(s, alloca_reg, c"ptr", c"match pointer payload bind")
    emit_store_typed(s, IR_TY_PTR, ptr, alloca_reg)
    add_local_ptr(s, StrView { ptr: (arm.pattern_inner_name), len: (arm.pattern_inner_name_len) as i64 }, alloca_reg, TypeKind.Ptr, pointee)

# AGAST #1515: bind `Some(p)` / `Ok(s)` to a copy of a struct payload.  The
# payload sits at field 2 of the spilled scrutinee (#1898); copy it into its own
# `alloca %Name` and register a struct local, so `p.x` and by-value passing
# see `%Name` rather than an i64.
fn emit_struct_payload_bind(s: *EmitterState, arm: *MatchArm, slot_reg: i32, enum_name_sv: StrView, st_name_sv: StrView)
    var enum_name: *u8 = enum_name_sv.ptr
    var enum_name_len: i32 = enum_name_sv.len as i32
    var st_name: *u8 = st_name_sv.ptr
    var st_name_len: i32 = st_name_sv.len as i32
    var sel: i32 = user_arm_variant(StrView { ptr: (enum_name), len: (enum_name_len) as i64 }, arm)
    if sel < 0
        sel = 0   # Result / Option: the payload is at offset 0
    let pay_ptr: i32 = emit_payload_ptr(s, slot_reg, StrView { ptr: (enum_name), len: (enum_name_len) as i64 }, sel)
    let val: i32 = next_reg(s)
    emit_struct_load_or_defer(s, TypeKind.Struct, val, StrView { ptr: (st_name), len: (st_name_len) as i64 }, pay_ptr, null, 0)
    let alloca_reg: i32 = next_reg(s)
    entry_alloca_reg_begin_named(s, alloca_reg)
    emit_name(s, StrView { ptr: (st_name), len: (st_name_len) as i64 })
    emit_str(s, c"  ; match struct payload bind\n")
    entry_alloca_reg_end(s)
    emit_struct_store_or_copy(s, TypeKind.Struct, StrView { ptr: (st_name), len: (st_name_len) as i64 }, val, alloca_reg)
    add_local_struct(s, StrView { ptr: (arm.pattern_inner_name), len: (arm.pattern_inner_name_len) as i64 }, alloca_reg, TypeKind.Struct, StrView { ptr: (st_name), len: (st_name_len) as i64 })

# AGAST #3029: bind `V(a)` / `Some(a)` to a copy of an array payload, at the
# `[N]T` the variant declares (variant_array_type), as a `let a: [N]T` is
# registered.  It was loaded as an i64 and indexed as a pointer: `a[1]` read
# through the array's bytes.  0, emitting nothing, for any other payload.
fn emit_array_payload_bind(s: *EmitterState, arm: *MatchArm, slot_reg: i32, enum_name_sv: StrView) -> i32
    var enum_name: *u8 = enum_name_sv.ptr
    var enum_name_len: i32 = enum_name_sv.len as i32
    var tag: i32 = 1 - variant_is_tag_one(StrView { ptr: (arm.pattern_name), len: (arm.pattern_name_len) as i64 })
    let uvi: i32 = user_arm_variant(StrView { ptr: (enum_name), len: (enum_name_len) as i64 }, arm)
    if uvi >= 0
        tag = uvi
    var arr: ArrayArg
    if variant_array_type(s, StrView { ptr: (enum_name), len: (enum_name_len) as i64 }, tag, @arr) == 0
        return 0
    let pay_ptr: i32 = emit_payload_ptr(s, slot_reg, StrView { ptr: (enum_name), len: (enum_name_len) as i64 }, tag)
    let val: i32 = next_reg(s)
    emit_str(s, IR_INDENT)
    emit_reg(s, val)
    emit_str(s, IR_LOAD)
    emit_local_array_llvm_type(s, arr.size, arr.elem, StrView { ptr: (arr.name), len: (arr.name_len) as i64 })
    emit_str(s, IR_PTR_SEP)
    emit_reg(s, pay_ptr)
    emit_str(s, IR_NL)
    let alloca_reg: i32 = next_reg(s)
    entry_alloca_reg_begin(s, alloca_reg)
    emit_local_array_llvm_type(s, arr.size, arr.elem, StrView { ptr: (arr.name), len: (arr.name_len) as i64 })
    emit_str(s, c"  ; match array payload bind\n")
    entry_alloca_reg_end(s)
    emit_str(s, IR_STORE_IND)
    emit_local_array_llvm_type(s, arr.size, arr.elem, StrView { ptr: (arr.name), len: (arr.name_len) as i64 })
    emit_str(s, IR_SP)
    emit_reg(s, val)
    emit_str(s, IR_PTR_SEP)
    emit_reg(s, alloca_reg)
    emit_str(s, IR_NL)
    if arr.name_len > 0 and (arr.elem == TypeKind.Struct or arr.elem == TypeKind.Ptr)
        add_local_full(s, StrView { ptr: (arm.pattern_inner_name), len: (arm.pattern_inner_name_len) as i64 }, alloca_reg, TypeKind.Array, StrView { ptr: (arr.name), len: (arr.name_len) as i64 }, TypeKind.I64, arr.size, arr.elem)
    else
        add_local_array(s, StrView { ptr: (arm.pattern_inner_name), len: (arm.pattern_inner_name_len) as i64 }, alloca_reg, arr.size, arr.elem)
    let loc: *LocalVar = local_at(s, s.local_count - 1)
    lv_set_array_elem_pointee(loc, arr.pointee)
    1

# AGAST #1667: an arm yielding a bare `Ok(..)` / `Err(..)` / `Some(..)` /
# `None` builds whichever enum its context dictates (resolve_enum_ctx, the
# same lookup emit_variant_struct made while emitting the arm), so the merge
# phi must have that type rather than i64.  `arg_parse_i64`'s
# `Some(n) => Ok(n)` / `None => Err(..)` emitted `phi i64 [%Result$..]`.
fn variant_ctor_arm_type(s: *EmitterState, e: *Expr, out_name: **u8, out_len: *i32)
    *out_name = null
    *out_len = 0
    if e == null
        return
    var is_ctor: i32 = 0
    match e.kind
        ExprKind.Call =>
            if is_variant_carrier(StrView { ptr: (e.func_name), len: (e.func_name_len) as i64 }) == 1 or is_variant_null(StrView { ptr: (e.func_name), len: (e.func_name_len) as i64 }) == 1
                is_ctor = 1
        ExprKind.Ident =>
            # Unshadowed `None`, mirroring emit_expr_ident: not a user's (#2434),
            # which is typed as any of its enum's unit variants.
            if is_ident_none(StrView { ptr: (e.ident_ptr), len: (e.ident_len) as i64 }) == 1 and users_none_wins(s, e) == 0
                if is_const(s, StrView { ptr: (e.ident_ptr), len: (e.ident_len) as i64 }) == 0 and find_local(s, StrView { ptr: (e.ident_ptr), len: (e.ident_len) as i64 }) < 0
                    if find_global(s, StrView { ptr: (e.ident_ptr), len: (e.ident_len) as i64 }) == null
                        is_ctor = 1
        _ => pass
    if is_ctor == 1
        resolve_enum_ctx(s, out_name, out_len)

# AGAST #3117: an arm yielding a bare `Full(..)` / `Empty` of a generic enum
# builds the instance its slot names (slot_instance_variant, which
# try_emit_user_variant_ctor and emit_expr_ident asked while emitting the
# arm), so the merge phi has that type, not i64.  A unit variant counts only
# where emit_expr_ident reaches it: no const, local, global or fn of its name.
fn instance_ctor_arm_type(s: *EmitterState, e: *Expr, out_name: **u8, out_len: *i32)
    var vi: i32 = 0
    var ei: i32 = 0 - 1
    match e.kind
        ExprKind.Call =>
            ei = slot_instance_variant(s, StrView { ptr: (e.func_name), len: (e.func_name_len) as i64 }, @vi)
            if ei >= 0
                let kind: i32 = enum_variant_kind(ei, vi)
                if not ((kind == ENUM_VARIANT_UNIT and e.args == null) or (kind == ENUM_VARIANT_TUPLE and e.args != null and e.args.next == null))
                    return
        ExprKind.Ident =>
            if is_const(s, StrView { ptr: (e.ident_ptr), len: (e.ident_len) as i64 }) == 1 or find_local(s, StrView { ptr: (e.ident_ptr), len: (e.ident_len) as i64 }) >= 0
                return
            if find_global(s, StrView { ptr: (e.ident_ptr), len: (e.ident_len) as i64 }) != null or find_fn(s, StrView { ptr: (e.ident_ptr), len: (e.ident_len) as i64 }) != null
                return
            ei = slot_instance_variant(s, StrView { ptr: (e.ident_ptr), len: (e.ident_len) as i64 }, @vi)
            if ei >= 0 and enum_variant_kind(ei, vi) != ENUM_VARIANT_UNIT
                return
        _ => pass
    if ei >= 0
        *out_name = enum_name_at(ei, out_len)

# AGAST #3205: an arm yielding a qualified unit variant (`0 => A.V`) is the
# `%A` emit_expr_member builds, under the same test, so the merge phi has
# that type.  The phi was i64 over `%A`s, which clang rejected.
fn qualified_unit_variant_arm_type(e: *Expr, out_name: **u8, out_len: *i32)
    if e.kind != ExprKind.Member or e.left == null or e.left.kind != ExprKind.Ident
        return
    if is_enum_type(StrView { ptr: (e.left.ident_ptr), len: (e.left.ident_len) as i64 }) == 0
        return
    if enum_variant_index(StrView { ptr: (e.left.ident_ptr), len: (e.left.ident_len) as i64 }, StrView { ptr: (e.ident_ptr), len: (e.ident_len) as i64 }) < 0
        return
    if enum_is_generic(enum_find(StrView { ptr: (e.left.ident_ptr), len: (e.left.ident_len) as i64 })) == 1
        return   # emit_expr_member refuses it (#1466)
    *out_name = e.left.ident_ptr
    *out_len = e.left.ident_len

# Emit a block arm's statements (AGAST #1454).  `return` leaves the block
# terminated by `ret`, but the arm still records a phi incoming and emits its
# `br` to the match end.  Without a fresh block the phi would name the block
# holding the `ret` as a predecessor, and clang rejects the module ("PHI node
# entries do not match predecessors").  Opening an (unreachable) block after
# each `ret` makes current_label the block that really branches to the end,
# exactly as StmtKind.Break / StmtKind.Continue already do (ritz-task-195).
pub fn emit_match_arm_stmts(s: *EmitterState, stmts: *Stmt)
    var st: *Stmt = stmts
    while st != null
        emit_stmt(s, st, s.fn_ret_type)
        if st.kind == StmtKind.Return
            begin_block(s, next_label(s))
            clear_last_expr(s)
        st = st.next

pub fn match_result_init(r: *MatchResult, n_arms: i32)
    var n: i64 = n_arms as i64
    if n < 1
        n = 1
    r.values = malloc(n * 4) as *i32
    r.labels = malloc(n * 4) as *i32
    r.count = 0
    r.agg_name = null
    r.agg_name_len = 0
    r.float_ty = TypeKind.Void
    r.hint_ty = TypeKind.Void
    r.int_arms = 0
    r.void_arms = 0
    r.void_line = 0
    r.void_col = 0
    r.ptr_ty = 0
    r.into = null
    r.slot = 0
    r.slot_misses = 0
    r.discarded = 0

# AGAST #2046: take the caller's "value discarded" flag (match_no_value) and
# clear it so no nested match / if sees it.  Returns 1 if the value is wanted.
fn take_match_wants_value(s: *EmitterState) -> i32
    let discard: i32 = s.match_no_value
    s.match_no_value = 0
    1 - discard

# AGAST #3028: set by a match statement that isn't its block's last (or
# by such a match for its expression arm's nested match) just before the
# match is emitted, and taken by emit_match_arms before anything else is.
var MATCH_DISCARDED: i32 = 0

pub fn match_discard_next()
    MATCH_DISCARDED = 1

fn take_match_discarded() -> i32
    let d: i32 = MATCH_DISCARDED
    MATCH_DISCARDED = 0
    d

# AGAST #2046: the arms of a match / if were emitted and at least one had no
# value.  If the value is wanted that is a located error at the innermost
# void call; either way publish that location for an enclosing match, whose
# arm this match / if may be.
fn match_void_arms_settle(s: *EmitterState, result: *MatchResult, wants_value: i32)
    s.void_arm_line = result.void_line
    s.void_arm_col = result.void_col
    if wants_value == 0
        return
    let file: *u8 = emitter_source_file()
    if file != null
        eprints_cstr(file)
    else
        eprints_cstr(c"<input>")
    eprint_char(':')
    eprint_i64(result.void_line as i64)
    eprint_char(':')
    eprint_i64(result.void_col as i64)
    eprints_cstr(c": error: this arm calls a fn that returns nothing, so it has no value; the `match`/`if` it belongs to is used as a value here\n")
    emit_str(s, c"  ; ERROR: valueless match / if arm used as a value\n")
    s.error_count = s.error_count + 1

# AGAST #1946: the float type (TypeKind.F32 / TypeKind.F64) arm value `e` was just
# emitted at, or 0.  A nested match / if publishes its phi type as it
# completes, which is immediately before this is asked.
pub fn match_arm_float_ty(s: *EmitterState, e: *Expr) -> TypeKind
    if e.kind == ExprKind.Match or e.kind == ExprKind.If
        return s.last_match_float_ty
    binop_operand_float_ty(s, e)

# AGAST #1946: take the float type an enclosing let / return expects of this
# match (0 if none) and clear it so no nested match sees it.
pub fn take_match_float_hint(s: *EmitterState) -> TypeKind
    let h: TypeKind = s.match_float_hint
    s.match_float_hint = TypeKind.Void
    h

# AGAST #1946: settle a scalar arm's value against the phi's float type.  A
# float slot (result.hint_ty) fixes it up front; otherwise the first float arm
# does, and an integer arm on either side of it is an error (LARB R43).  Once
# fixed, a float of the other width, or in a slot an integer, is converted in
# the arm's own block before its `br`.  Called while
# the arm's pattern binding is in scope.  Returns the register to record.
pub fn match_arm_float_settle(s: *EmitterState, arm_body: *Expr, body_reg: i32, result: *MatchResult) -> i32
    float_arm_settle(s, match_arm_float_ty(s, arm_body), arm_body, arm_body.span, body_reg, result)

# AGAST #3421: match_arm_float_settle for an arm whose value is of float type
# `aft` (0 if none).  A statement `if`'s arms come here too, and one whose
# value is a nested statement `if` / `match` has no expression (`arm_body`
# null): its phi's type is `aft`, and if that is an integer in a float merge,
# it is the R43 mix (the nested one had the slot too, so it would be float).
# `at` is the arm's value, where an R43 mix is reported (AGAST #3621).
pub fn float_arm_settle(s: *EmitterState, aft: TypeKind, arm_body: *Expr, at: SrcSpan, body_reg: i32, result: *MatchResult) -> i32
    if result.float_ty == TypeKind.Void
        if aft == TypeKind.Void
            result.int_arms = result.int_arms + 1
            return body_reg
        if result.int_arms > 0
            emit_ir_error(s, at, c"match arms yield both an integer and a float value; write the integer arm as a float (`0.0`) or annotate the binding")
        result.float_ty = aft
        return body_reg
    if aft == result.float_ty
        return body_reg
    if aft != TypeKind.Void
        return emit_float_coerce(s, body_reg, aft, result.float_ty)
    if arm_body == null
        emit_ir_error(s, at, c"match arms yield both an integer and a float value; write the integer arm as a float (`0.0`) or annotate the binding")
        return body_reg
    let is_int: bool = is_int_const_type(expr_slot_ty(arm_body)) == 1
    # LARB R43 (#3385): with no float slot (hint_ty 0) the float type came
    # from an earlier arm, and an integer arm next to it is refused, as one
    # BEFORE the first float arm is above: the rule doesn't depend on order.
    # The slot is known before any arm is emitted, so no pre-pass is needed.
    if is_int and result.hint_ty == TypeKind.Void
        emit_ir_error(s, at, c"match arms yield both an integer and a float value; write the integer arm as a float (`0.0`) or annotate the binding")
        return body_reg
    # AGAST #3313, LARB R43a: an integer arm lands in the float slot as
    # `let a: f64 = x` does (§7.5): a literal or an exact type (i32 into
    # f64) converts, a lossy one (i64) is refused (ritz0 does the same).
    if is_int
        return emit_int_into_float_slot(s, body_reg, float_slot_unsigned(arm_body), result.float_ty)
    # A pointer arm was refused on Sema, in ritz0's words (AGAST #3626, #3892).
    emit_ir_error(s, arm_body.span, c"match arm yields a non-numeric value where the other arms yield a float")
    body_reg

# AGAST #3696: an arm of a large struct %T writes its value into the
# match's slot, in its own block, while its value is fresh: before its
# bindings drop (a drop is a call, which would keep the value's load from
# becoming a pointer copy) and before its `br`.
#
# A `phi %T` over the arms, stored to the destination, is a first-class %T
# the #1732 rewrite can't see (it is not a load), and it is what sends clang
# -O2's InstCombine superlinear (#3692).  Through the slot, each arm's
# `store %T (load %T, src), slot` and the merge's consumer `store %T (load
# %T, slot), dst` are pointer copies the store site emits as @__ritz_sret_copy
# (#4461).  The slot's alloca is emitted here, in the first such
# arm, into the entry-block buffer (AGAST #4460), so it
# dominates the merge.  An arm that leaves (`return`) stores nothing: it
# never reaches the merge.  A `pass` arm, whose phi incoming was the zero of
# %T, stores that zero once the slot exists; before it, it is a miss.
fn match_arm_into_slot(s: *EmitterState, arm: *MatchArm, result: *MatchResult, body_reg: i32)
    if result.into != null
        return
    if body_reg == MATCH_ZERO_VALUE and if_arm_diverges(arm) == 1
        return
    if result.agg_name == null or struct_ret_uses_sret(s, TypeKind.Struct, StrView { ptr: (result.agg_name), len: (result.agg_name_len) as i64 }) == 0
        result.slot_misses = result.slot_misses + 1
        return
    if body_reg == MATCH_ZERO_VALUE and result.slot == 0
        result.slot_misses = result.slot_misses + 1
        return
    if result.slot == 0
        result.slot = next_reg(s)
        entry_alloca_reg_begin(s, result.slot)
        emit_match_phi_type(s, result)
        emit_str(s, IR_NL)
        entry_alloca_reg_end(s)
    if result.agg_name != null and result.agg_name_len > 0 and body_reg != MATCH_ZERO_VALUE
        emit_struct_store_or_copy(s, TypeKind.Struct, StrView { ptr: (result.agg_name), len: (result.agg_name_len) as i64 }, body_reg, result.slot)
    else
        emit_str(s, IR_STORE_IND)
        emit_match_phi_type(s, result)
        emit_str(s, IR_SP)
        emit_match_phi_value(s, result, body_reg)
        emit_str(s, IR_PTR_SEP)
        emit_reg(s, result.slot)
        emit_str(s, IR_NL)

# AGAST #3696: at the merge, the arms' value read back from their slot (see
# match_arm_into_slot), or 0 when they meet in a phi instead.
fn match_merge_slot(s: *EmitterState, result: *MatchResult) -> i32
    if result.slot == 0 or result.slot_misses > 0
        return 0
    let reg: i32 = next_reg(s)
    if result.agg_name != null and result.agg_name_len > 0
        emit_struct_load_or_defer(s, TypeKind.Struct, reg, StrView { ptr: (result.agg_name), len: (result.agg_name_len) as i64 }, result.slot, null, 0)
    else
        emit_str(s, IR_INDENT)
        emit_reg(s, reg)
        emit_str(s, IR_LOAD)
        emit_match_phi_type(s, result)
        emit_str(s, IR_PTR_SEP)
        emit_reg(s, result.slot)
        emit_str(s, IR_NL)
    reg

# AGAST #1946: the merge phi's type: the arms' struct, their float, or i64.
fn emit_match_phi_type(s: *EmitterState, result: *MatchResult)
    if result.agg_name != null and result.agg_name_len > 0
        emit_llvm_type_struct(s, TypeKind.Struct, StrView { ptr: (result.agg_name), len: (result.agg_name_len) as i64 })
    else if result.ptr_ty == 1
        emit_str(s, c"ptr")
    else if result.float_ty != TypeKind.Void
        emit_str(s, float_llvm_name(result.float_ty))
    else
        emit_str(s, c"i64")

# AGAST #1946: one phi incoming value: the arm's register, or for
# MATCH_ZERO_VALUE the zero constant of the phi's type.
fn emit_match_phi_value(s: *EmitterState, result: *MatchResult, reg: i32)
    if reg != MATCH_ZERO_VALUE
        emit_reg(s, reg)
    else if result.agg_name != null and result.agg_name_len > 0
        emit_str(s, c"zeroinitializer")
    else if result.ptr_ty == 1
        emit_str(s, c"null")
    else if result.float_ty != TypeKind.Void
        emit_str(s, c"0.0")
    else
        emit_str(s, c"0")

# AGAST #1946: publish the phi's type for an untyped `let v = match` / `if`
# (#1666).  Called after every arm, so the outermost construct's type wins.
fn publish_match_type(s: *EmitterState, result: *MatchResult)
    if result.agg_name != null and result.agg_name_len > 0
        s.last_match_agg_name = result.agg_name
        s.last_match_agg_name_len = result.agg_name_len
        s.last_match_float_ty = TypeKind.Void
    else
        s.last_match_agg_name = null
        s.last_match_agg_name_len = 0
        s.last_match_float_ty = result.float_ty

# AGAST #2342: what `Constructor(v)` binds, as bool_kind would say.
fn payload_bool_kind(s: *EmitterState, arm: *MatchArm, enum_name_sv: StrView) -> i32
    var enum_name: *u8 = enum_name_sv.ptr
    var enum_name_len: i32 = enum_name_sv.len as i32
    if enum_name == null or enum_name_len <= 0
        return BK_UNSURE
    if is_tagged_enum_type(StrView { ptr: (enum_name), len: (enum_name_len) as i64 }) == 1
        return bk_tagged_binding(StrView { ptr: (enum_name), len: (enum_name_len) as i64 }, 1 - variant_is_tag_one(StrView { ptr: (arm.pattern_name), len: (arm.pattern_name_len) as i64 }))   # AGAST #4280: `ptr_T` too
    let uf: *StructField = user_enum_tuple_field(StrView { ptr: (enum_name), len: (enum_name_len) as i64 }, user_arm_variant(StrView { ptr: (enum_name), len: (enum_name_len) as i64 }, arm))
    if uf == null
        return BK_UNSURE
    bk_of_type(uf.field_type, StrView { ptr: (uf.field_type_name), len: (uf.field_type_name_len) as i64 })

# AGAST #1295: 1 when `arm`'s positional bindings fit its variant: a user
# enum's variant with fields takes exactly one binding per field.  Otherwise
# the located error, and 0: nothing is bound.  Result / Option, unknown
# variants and unit variants are left to the checks that already cover them.
fn user_arm_arity_ok(s: *EmitterState, arm: *MatchArm, enum_name_sv: StrView) -> i32
    var enum_name: *u8 = enum_name_sv.ptr
    var enum_name_len: i32 = enum_name_sv.len as i32
    let ei: i32 = user_enum_index(StrView { ptr: (enum_name), len: (enum_name_len) as i64 })
    if ei < 0
        return 1
    let vi: i32 = enum_variant_index(StrView { ptr: (enum_name), len: (enum_name_len) as i64 }, StrView { ptr: (arm.pattern_name), len: (arm.pattern_name_len) as i64 })
    if vi < 0
        return 1
    let nf: i32 = enum_variant_field_count(ei, vi)
    let nb: i32 = arm_bind_count(arm)
    if nf == 0 or nf == nb
        return 1
    var line: i32 = arm.head_span.line
    var col: i32 = arm.head_span.col
    if line <= 0
        line = arm.pattern_inner_span.line
        col = arm.pattern_inner_span.col
    emit_nd_error_begin(s, line, col)
    eprints_cstr(c"pattern `")
    eprint_bytes(StrView { ptr: (arm.pattern_name), len: (arm.pattern_name_len) as i64 })
    eprints_cstr(c"` binds ")
    eprint_int(nb as i64)
    eprints_cstr(c" field(s), but the variant has ")
    eprint_int(nf as i64)
    eprints_cstr(c"\n")
    0

# Bind the payload binding `arm` has selected (arm_select_bind), as a local
# of the field's type for the rest of the arm.
fn emit_arm_payload_bind(s: *EmitterState, arm: *MatchArm, scrut_reg: i32, scrut_slot: i32, enum_name_sv: StrView)
    var enum_name: *u8 = enum_name_sv.ptr
    var enum_name_len: i32 = enum_name_sv.len as i32
    if arm.pattern_inner_kind == PAT_IDENT
        if arm.pattern_inner_name_len > 0
            var is_wildcard: i32 = 0
            if arm.pattern_inner_name_len == 1
                if *arm.pattern_inner_name == '_'   # '_'
                    is_wildcard = 1
            var pay_struct: *u8 = null
            var pay_struct_len: i32 = 0
            var ptr_struct: *u8 = null
            var ptr_struct_len: i32 = 0
            var ptr_kind: TypeKind = TypeKind.Void
            var ptr_prim: TypeKind = TypeKind.Void
            if is_wildcard == 0 and scrut_slot != 0
                carrier_payload_struct(s, arm, StrView { ptr: (enum_name), len: (enum_name_len) as i64 }, @pay_struct, @pay_struct_len)
                ptr_kind = carrier_payload_ptr_struct(s, arm, StrView { ptr: (enum_name), len: (enum_name_len) as i64 }, @ptr_struct, @ptr_struct_len)
                if ptr_kind == TypeKind.Void and pay_struct == null
                    ptr_prim = carrier_payload_ptr_primitive(s, arm, enum_name, enum_name_len)   # AGAST #4448
            if is_wildcard == 0 and pay_struct == null and ptr_kind == TypeKind.Void and scrut_slot != 0 and emit_array_payload_bind(s, arm, scrut_slot, StrView { ptr: (enum_name), len: (enum_name_len) as i64 }) == 1
                is_wildcard = 1   # AGAST #3029: bound, as the `[N]T` it is
            if is_wildcard == 0 and ptr_kind != TypeKind.Void
                # AGAST #2436: `Some(v)` over `Option<*Pair>`: v is a `*Pair`.
                var ptr_variant: i32 = 1 - variant_is_tag_one(StrView { ptr: (arm.pattern_name), len: (arm.pattern_name_len) as i64 })
                let puvi: i32 = user_arm_variant(StrView { ptr: (enum_name), len: (enum_name_len) as i64 }, arm)
                if puvi >= 0
                    ptr_variant = puvi
                emit_ptr_payload_bind(s, arm, scrut_slot, StrView { ptr: (enum_name), len: (enum_name_len) as i64 }, ptr_variant, ptr_kind, StrView { ptr: (ptr_struct), len: (ptr_struct_len) as i64 })
                bool_note_binding(s, payload_bool_kind(s, arm, StrView { ptr: (enum_name), len: (enum_name_len) as i64 }))   # AGAST #2342
            else if is_wildcard == 0 and ptr_prim != TypeKind.Void
                # AGAST #4448: `Some(n)` over `Option<*u8>`: n is a `*u8`.
                emit_primitive_ptr_payload_bind(s, arm, scrut_slot, enum_name, enum_name_len, ptr_prim)
                bool_note_binding(s, payload_bool_kind(s, arm, StrView { ptr: (enum_name), len: (enum_name_len) as i64 }))
            else if is_wildcard == 0 and pay_struct != null
                emit_struct_payload_bind(s, arm, scrut_slot, StrView { ptr: (enum_name), len: (enum_name_len) as i64 }, StrView { ptr: (pay_struct), len: (pay_struct_len) as i64 })
                # AGAST #2174: it owns the payload of a scrutinee the
                # match owns.
                own_match_payload(s, StrView { ptr: (arm.pattern_inner_name), len: (arm.pattern_inner_name_len) as i64 })
            else if is_wildcard == 0
                var payload_reg: i32 = 0
                # AGAST #1945: a float payload binds as an f32 / f64 local.
                var bind_ft: TypeKind = TypeKind.Void
                # AGAST #3116: a narrow integer payload binds as its own
                # type (an `i<bits>` local), as a typed `let` does.
                var bind_nt: TypeKind = TypeKind.Void
                # AGAST #3345: its integer type, i64 / u64 too, for
                # the lossy-conversion check (narrow_note_binding).
                var bind_it: TypeKind = TypeKind.Void
                if scrut_slot != 0 and enum_name != null and enum_name_len > 0
                    # Result/Option: 0 Ok-Some, 1 Err; a user enum: the
                    # variant's own tag (AGAST #1797), for its width.
                    var pay_variant: i32 = 1 - variant_is_tag_one(StrView { ptr: (arm.pattern_name), len: (arm.pattern_name_len) as i64 })
                    let uvi: i32 = user_arm_variant(StrView { ptr: (enum_name), len: (enum_name_len) as i64 }, arm)
                    if uvi >= 0
                        pay_variant = uvi
                    payload_reg = emit_variant_payload(s, scrut_slot, StrView { ptr: (enum_name), len: (enum_name_len) as i64 }, pay_variant)
                    bind_ft = tagged_enum_float_type(s, StrView { ptr: (enum_name), len: (enum_name_len) as i64 }, pay_variant)
                    bind_nt = tagged_enum_narrow_int_type(s, StrView { ptr: (enum_name), len: (enum_name_len) as i64 }, pay_variant)
                    bind_it = tagged_enum_int_type(s, StrView { ptr: (enum_name), len: (enum_name_len) as i64 }, pay_variant)
                else
                    # Non-enum scrutinee (shouldn't reach here in practice).
                    payload_reg = scrut_reg
                var bind_llvm: *u8 = c"i64"
                var bind_type: TypeKind = TypeKind.I64
                if bind_ft != TypeKind.Void
                    bind_llvm = float_llvm_name(bind_ft)
                    bind_type = bind_ft
                else if bind_nt != TypeKind.Void
                    bind_type = bind_nt
                    bind_llvm = narrow_int_llvm(bind_nt)
                    # The payload was widened to an i64 register; the
                    # local holds it at its width, truncated back.
                    let narrow_reg: i32 = next_reg(s)
                    emit_str(s, IR_INDENT)
                    emit_reg(s, narrow_reg)
                    emit_str(s, IR_TRUNC)
                    emit_reg(s, payload_reg)
                    emit_str(s, IR_TO_SP)
                    emit_str(s, bind_llvm)
                    emit_str(s, IR_NL)
                    payload_reg = narrow_reg
                let alloca_reg: i32 = next_reg(s)
                entry_alloca_reg_begin(s, alloca_reg)
                emit_str(s, bind_llvm)
                emit_str(s, c"  ; match payload bind\n")
                entry_alloca_reg_end(s)
                emit_str(s, IR_STORE_IND)
                emit_str(s, bind_llvm)
                emit_str(s, IR_SP)
                emit_reg(s, payload_reg)
                emit_str(s, IR_PTR_SEP)
                emit_reg(s, alloca_reg)
                emit_str(s, IR_NL)
                add_local(s, StrView { ptr: (arm.pattern_inner_name), len: (arm.pattern_inner_name_len) as i64 }, alloca_reg, bind_type)
                narrow_note_binding(s, StrView { ptr: (arm.pattern_inner_name), len: (arm.pattern_inner_name_len) as i64 }, bind_it)   # AGAST #3345
                if bind_ft == TypeKind.Void
                    bool_note_binding(s, payload_bool_kind(s, arm, StrView { ptr: (enum_name), len: (enum_name_len) as i64 }))   # AGAST #2342

# Emit match body, returning (result_reg, exit_label) via MatchResult slot.
# For PAT_VARIANT arms with PAT_IDENT inner (e.g. `Ok(v) => v`), the inner
# name is bound to the extracted payload for the duration of the arm body,
# then popped via local_count rollback. (task-99 #105)
fn emit_match_arm_body(s: *EmitterState, arm: *MatchArm, scrut_reg: i32, scrut_slot: i32, enum_name_sv: StrView, result: *MatchResult, arm_index: i32, end_label: i32)
    var enum_name: *u8 = enum_name_sv.ptr
    var enum_name_len: i32 = enum_name_sv.len as i32
    # Save local_count so arm-scoped bindings get popped after the body.
    let saved_local_count: i32 = s.local_count
    # AGAST #3345: the arm's bindings (and lets) leave the narrowing table too.
    let saved_narrow_count: i32 = s.narrow_decl_count
    own_push_scope(s)   # AGAST #2158: the arm is a block for drops

    # Bind variant payload to inner pattern name on `Constructor(binding)`;
    # AGAST #1295: every binding of `V(a, b, ..)`, each field at its offset.
    if arm.pattern_kind == PAT_VARIANT
        if user_arm_arity_ok(s, arm, StrView { ptr: (enum_name), len: (enum_name_len) as i64 }) == 1
            let nb: i32 = arm_bind_count(arm)
            for k in 0..nb
                arm_select_bind(arm, k)
                emit_arm_payload_bind(s, arm, scrut_reg, scrut_slot, StrView { ptr: (enum_name), len: (enum_name_len) as i64 })
            arm_select_bind(arm, 0)

    # A catch-all name over a scalar (`other => other + 1`) binds the
    # scrutinee, as in ritz0 (LANGUAGE_SPEC §8.2).  Not a const (that arm
    # compares) and not `None` (the tagged-enum null test above).
    if arm.pattern_kind == PAT_IDENT and (enum_name == null or enum_name_len == 0)
        if s.match_scrut_str == 1
            # AGAST #1876: a name over a StrView binds the StrView.
            let str_reg: i32 = next_reg(s)
            entry_alloca_reg(s, str_reg, c"%StrView", c"match binding")
            emit_str(s, c"  store %StrView ")
            emit_reg(s, scrut_reg)
            emit_str(s, IR_PTR_SEP)
            emit_reg(s, str_reg)
            emit_str(s, IR_NL)
            add_local_struct(s, StrView { ptr: (arm.pattern_name), len: (arm.pattern_name_len) as i64 }, str_reg, TypeKind.Struct, StrView { ptr: (c"StrView"), len: (7) as i64 })
        else if find_const_entry(s, StrView { ptr: (arm.pattern_name), len: (arm.pattern_name_len) as i64 }) == null and is_ident_none_name(StrView { ptr: (arm.pattern_name), len: (arm.pattern_name_len) as i64 }) == 0
            let bind_reg: i32 = next_reg(s)
            entry_alloca_reg(s, bind_reg, c"i64", c"match binding")
            emit_store_typed(s, IR_TY_I64, scrut_reg, bind_reg)
            add_local(s, StrView { ptr: (arm.pattern_name), len: (arm.pattern_name_len) as i64 }, bind_reg, TypeKind.I64)
            bool_note_binding(s, s.match_scrut_kind)   # AGAST #2342
            narrow_note_binding(s, StrView { ptr: (arm.pattern_name), len: (arm.pattern_name_len) as i64 }, s.match_scrut_int)   # AGAST #3358

    # AGAST #4596: over an enum, a name that isn't one of its variants binds
    # the scrutinee too (§8.2): a copy of the `%E` value, so a repr enum's
    # `other as i32` sees a discriminant naming no variant.  ritz0's twin is
    # `binds_scrutinee` in _emit_enum_match.
    if arm.pattern_kind == PAT_IDENT and enum_name != null and enum_name_len > 0
        if arm_binds_enum_value(arm, StrView { ptr: (enum_name), len: (enum_name_len) as i64 }) == 1
            let enum_bind: i32 = next_reg(s)
            entry_alloca_reg_begin_named(s, enum_bind)
            emit_name(s, StrView { ptr: (enum_name), len: (enum_name_len) as i64 })
            emit_str(s, c"  ; match binding\n")
            entry_alloca_reg_end(s)
            emit_struct_store_or_copy(s, TypeKind.Struct, StrView { ptr: (enum_name), len: (enum_name_len) as i64 }, scrut_reg, enum_bind)
            add_local_struct(s, StrView { ptr: (arm.pattern_name), len: (arm.pattern_name_len) as i64 }, enum_bind, TypeKind.Struct, StrView { ptr: (enum_name), len: (enum_name_len) as i64 })
            # AGAST #4602: of a move-only scrutinee the match owns, the
            # binding takes it (the scrutinee's flag clears): it drops once.
            own_match_payload(s, StrView { ptr: (arm.pattern_name), len: (arm.pattern_name_len) as i64 })

    # Block-bodied / statement arm (AGAST #1454, #1617): run the leading
    # statements in the arm's own scope (they are popped with the payload
    # binding below), then fall into the value path, which reads the
    # trailing expression match_arm_set_block left in arm.body.
    emit_match_arm_stmts(s, arm.body_stmts)

    # A valueless arm (`pass`, or no trailing expression) feeds the phi the
    # zero of its type (AGAST #1946).
    var body_reg: i32 = MATCH_ZERO_VALUE
    var lent_arm: *LocalVar = null
    # AGAST #4168: the aggregate type a nested match / if arm published.
    var nested_ty: *u8 = null
    var nested_ty_len: i32 = 0
    # AGAST #4408: the tuple name tuple_lit_name decided for the arm, which
    # used to be written onto the literal for the phi-typing step to read.
    var arm_lit_name: *u8 = null
    var arm_lit_name_len: i32 = 0
    if result.into != null
        match_arm_array_into(s, arm, result.into)   # AGAST #3276
    else if arm.is_pass == 1
        body_reg = MATCH_ZERO_VALUE
    else if arm.body != null
        # AGAST #2046: a match / if nested as the arm never reports its own
        # valueless arm; it returns no value and this match decides.
        let nested: bool = arm.body.kind == ExprKind.Match or arm.body.kind == ExprKind.If
        if nested
            s.match_no_value = 1
        # AGAST #3028: an expression arm's value is the match's own, so it
        # is discarded when the match's is; a block arm's is its block's tail.
        let discarded: bool = result.discarded == 1 and arm.is_block == 0
        if discarded and arm.body.kind == ExprKind.Match
            match_discard_next()
        own_arm_moves(s, arm.body)   # AGAST #2158: the arm's value moves out
        # AGAST #2288: a `c:& C` arm's value is the referent, as in ritz0.
        # It read as the pointer, so the phi was an i64 over `ptr`s.
        lent_arm = lent_referent_local(s, arm.body)
        # AGAST #3005: a nameless tuple arm takes the type an earlier arm
        # fixed, or its own elements', with this arm's bindings in scope.
        tuple_lit_name(s, arm.body, StrView { ptr: (result.agg_name), len: (result.agg_name_len) as i64 }, @arm_lit_name, @arm_lit_name_len)
        if lent_arm != null and discarded
            body_reg = MATCH_ZERO_VALUE   # AGAST #3028: nothing reads it
        else if lent_arm != null
            body_reg = emit_lent_referent(s, arm.body, StrView { ptr: (lv_type_name(lent_arm)), len: (lv_type_name_len(lent_arm)) as i64 })
        else
            # AGAST #2092: a nested match / if (an `else if`, a match in an
            # arm, a block's tail) merges at the enclosing annotation too.
            # Set last, so nothing emitted before the tail can take it.
            if nested
                s.match_float_hint = result.hint_ty
            body_reg = emit_expr(s, arm.body)
            if nested   # it published (or cleared) its own phi type
                nested_ty = s.last_match_agg_name
                nested_ty_len = s.last_match_agg_name_len
    if result.into != null
        body_reg = MATCH_ZERO_VALUE   # stored; no phi reads it
    else if arm.is_pass == 0 and arm.body != null and body_reg == 0
        # AGAST #1654: a void call (`Some(e) => say(e)`), or a nested
        # valueless match.  Register 0 is never defined; record a zero so
        # nothing ever names %.0, and mark the whole match valueless.
        result.void_arms = result.void_arms + 1
        body_reg = MATCH_ZERO_VALUE
        if result.void_line == 0
            # AGAST #2046: locate the void call; a nested valueless match /
            # if published its own innermost one.
            if arm.body.kind == ExprKind.Match or arm.body.kind == ExprKind.If
                result.void_line = s.void_arm_line
                result.void_col = s.void_arm_col
            else
                result.void_line = arm.body.span.line
                result.void_col = arm.body.span.col
    else if arm.is_pass == 0 and arm.body != null
        # AGAST #1645: resolve the arm's struct type while its pattern
        # binding (`Some(v) => v`) is still in scope; it is popped below.
        var arm_ty: *u8 = null
        var arm_ty_len: i32 = 0
        if lent_arm != null
            arm_ty = lv_type_name(lent_arm)
            arm_ty_len = lv_type_name_len(lent_arm)
        # AGAST #4168: a nested match / if arm is of the type its own phi
        # published; the outer phi stayed i64 over its %S value.
        if arm_ty == null and nested_ty != null and nested_ty_len > 0
            arm_ty = nested_ty
            arm_ty_len = nested_ty_len
        # AGAST #2512: a `Some(v)` the slot built as the builtin (#2453) is
        # the slot's enum, not the user enum that also declares `Some`: that
        # typed the phi %E over the arm's %Option$i32.  A `None` the slot
        # built as the builtin is the same (#2434): variant_ctor_arm_type
        # leaves a user's to resolve_expr_struct_name.
        let call_arm: i32 = (arm.body.kind == ExprKind.Call and users_variant_wins(s, arm.body) == 0) as i32
        if arm_ty == null and (call_arm == 1 or arm.body.kind == ExprKind.Ident)
            variant_ctor_arm_type(s, arm.body, @arm_ty, @arm_ty_len)
        if arm_ty == null
            instance_ctor_arm_type(s, arm.body, @arm_ty, @arm_ty_len)   # AGAST #3117
        if arm_ty == null
            span_assoc_arm_type(s, arm.body, @arm_ty, @arm_ty_len)   # AGAST #4194
        if arm_ty == null
            qualified_unit_variant_arm_type(arm.body, @arm_ty, @arm_ty_len)   # AGAST #3205
        if arm_ty == null
            resolve_expr_struct_name(s, arm.body, @arm_ty, @arm_ty_len)
        # #4408: resolve reads a struct literal's own `ident_ptr`; a tuple
        # literal no longer carries the name, so use the one it returned.
        # Only a literal has a type name here: for any other arm tuple_lit_name
        # returns the expression's own ident_ptr, which is not a type.
        if arm_ty == null and arm.body.kind == ExprKind.StructLit and arm_lit_name != null and arm_lit_name_len > 0
            arm_ty = arm_lit_name
            arm_ty_len = arm_lit_name_len
        if arm_ty == null
            variant_ctor_arm_type(s, arm.body, @arm_ty, @arm_ty_len)
        # AGAST #2559: a static or global-receiver method call (`B.new(..)`)
        # returning a struct, which resolve_expr_struct_name leaves untyped.
        if arm_ty == null
            call_result_struct_name(s, arm.body, @arm_ty, @arm_ty_len)
        # AGAST #2950: `*r` with `r: @C` / `@&C` / `*C` loads the %C
        # deref_pointee_struct_name names; the phi was i64 over it.
        if arm_ty == null and arm.body.kind == ExprKind.Unary and arm.body.op == OpKind.Deref
            deref_pointee_struct_name(s, arm.body.operand, @arm_ty, @arm_ty_len)
        # The first struct-valued arm fixes the phi type.  A `"..."` arm is a
        # StrView in the language; its `%Span$u8` lowering (#98) is an
        # artefact, so a leading literal arm types the phi as StrView, the
        # same type a later `Some(s) => s` over Option<StrView> yields.
        if result.agg_name == null and arm_ty != null and arm_ty_len > 0
            if arm.body.kind == ExprKind.StringLit
                result.agg_name = c"StrView"
                result.agg_name_len = 7
            else
                result.agg_name = arm_ty
                result.agg_name_len = arm_ty_len
        # AGAST #1662: rebuild a layout-equivalent arm value (Span$u8 <->
        # StrView, #168) as the phi's type here, in the arm's own block before
        # its `br`, so every phi incoming value has the phi's type.
        if is_layout_equiv_pair(StrView { ptr: (arm_ty), len: (arm_ty_len) as i64 }, StrView { ptr: (result.agg_name), len: (result.agg_name_len) as i64 }) == 1
            body_reg = rebuild_layout_equiv(s, body_reg, StrView { ptr: (arm_ty), len: (arm_ty_len) as i64 }, StrView { ptr: (result.agg_name), len: (result.agg_name_len) as i64 })
        # AGAST #2950: an `@&x` arm is a `ptr`, any other scalar an i64.  In
        # an i64 phi (another arm is a `*C`, or the pre-scan couldn't see the
        # arm's own `let`) it is converted.  The reverse can't happen: no arm
        # name shadows the one the pre-scan read.
        if result.agg_name == null and arm_ty == null and result.ptr_ty == 0
            if arm_value_is_ptr(s, arm.body) == 1
                body_reg = ptr_value_to_i64(s, arm.body, body_reg)
        # AGAST #1946: a float-valued scalar arm types the phi as float.
        if result.agg_name == null and result.ptr_ty == 0
            body_reg = match_arm_float_settle(s, arm.body, body_reg, result)
    match_arm_into_slot(s, arm, result, body_reg)   # AGAST #3696

    # AGAST #2158: drop the arm's bindings once its value is computed.
    own_pop_scope(s)
    s.local_count = saved_local_count
    if s.narrow_decl_count > saved_narrow_count
        s.narrow_decl_count = saved_narrow_count
    # ritz-task-193 — drop the inner-arm binding from local_map so the next
    # find_local on the shadowed name returns the outer binding via the map
    # fast-path (the find fallback would otherwise carry the cost).
    rebuild_local_map(s)

    let exit_label: i32 = s.current_label
    result.values[arm_index] = body_reg
    result.labels[arm_index] = exit_label
    if arm_index + 1 > result.count
        result.count = arm_index + 1

    emit_str(s, IR_BR)
    emit_label(s, end_label)
    emit_str(s, IR_NL)

# AGAST #3276: an arm of a `match` of whole arrays stores its value at `into`,
# with its pattern binding in scope, as emit_array_arm_into does an `if` arm's
# (#2305).  The arm's array is held to N and T as any whole-array source is.
# An arm that leaves (`return`) has no value and stores nothing; a `pass` arm
# would leave the array unwritten, and is refused.
fn match_arm_array_into(s: *EmitterState, arm: *MatchArm, into: *ArrayInto)
    if arm.is_pass == 1
        emit_ir_error(s, arm.pass_span, c"a `match` arm stored into a whole array has no value (`pass`); give it an `[N]T`")
        return
    if arm.body == null
        return
    own_arm_moves(s, arm.body)
    emit_array_local_whole_assign(s, into.ptr, into.size, into.et, StrView { ptr: (into.name), len: (into.name_len) as i64 }, arm.body)

# Emit one arm's condition + body.  `scrut_slot` is an alloca holding the
# scrutinee struct (when enum_name is non-null), or 0 for scalar scrutinees.
# AGAST #1876: does the StrView in `scrut_reg` equal a PAT_STR arm's bytes?
# The length first: unequal, it branches to `miss` (the next arm); equal, a
# block compares every byte, none past the end, and its i1 is returned for
# emit_match_arm's branch.  ritz0's twin is _emit_strview_match.
fn emit_str_pattern_test(s: *EmitterState, arm: *MatchArm, scrut_reg: i32, miss: i32) -> i32
    let len_reg: i32 = next_reg(s)
    emit_str(s, IR_INDENT)
    emit_reg(s, len_reg)
    emit_str(s, c" = extractvalue %StrView ")
    emit_reg(s, scrut_reg)
    emit_str(s, IR_COMMA_1)
    let same_len: i32 = next_reg(s)
    emit_str(s, IR_INDENT)
    emit_reg(s, same_len)
    emit_str(s, c" = icmp eq i64 ")
    emit_reg(s, len_reg)
    emit_str(s, IR_COMMA)
    emit_int(s, arm.pattern_name_len as i64)
    emit_str(s, IR_NL)
    if arm.pattern_name_len == 0
        return same_len
    let bytes_label: i32 = next_label(s)
    emit_str(s, c"  br i1 ")
    emit_reg(s, same_len)
    emit_str(s, IR_LABEL_SEP)
    emit_label(s, bytes_label)
    emit_str(s, IR_LABEL_SEP)
    emit_label(s, miss)
    emit_str(s, IR_NL)
    begin_block(s, bytes_label)
    let ptr_reg: i32 = next_reg(s)
    emit_str(s, IR_INDENT)
    emit_reg(s, ptr_reg)
    emit_str(s, c" = extractvalue %StrView ")
    emit_reg(s, scrut_reg)
    emit_str(s, IR_COMMA_0)
    var acc: i32 = 0
    for k in 0..arm.pattern_name_len
        let at_reg: i32 = next_reg(s)
        emit_str(s, IR_INDENT)
        emit_reg(s, at_reg)
        emit_str(s, c" = getelementptr i8, ptr ")
        emit_reg(s, ptr_reg)
        emit_str(s, IR_I64_SEP)
        emit_int(s, k as i64)
        emit_str(s, IR_NL)
        let byte_reg: i32 = next_reg(s)
        emit_load_into(s, IR_TY_I8, byte_reg, at_reg)
        let hit: i32 = next_reg(s)
        emit_str(s, IR_INDENT)
        emit_reg(s, hit)
        emit_str(s, c" = icmp eq i8 ")
        emit_reg(s, byte_reg)
        emit_str(s, IR_COMMA)
        emit_int(s, *(arm.pattern_name + k) as i64)
        emit_str(s, IR_NL)
        if acc == 0
            acc = hit
        else
            let both: i32 = next_reg(s)
            emit_str(s, IR_INDENT)
            emit_reg(s, both)
            emit_str(s, c" = and i1 ")
            emit_reg(s, acc)
            emit_str(s, IR_COMMA)
            emit_reg(s, hit)
            emit_str(s, IR_NL)
            acc = both
    acc

# One pattern's test (`pat` is an arm, or an alternative of its or-pattern):
# the i1 register that says it matches, or 0 with *always set when it takes
# every value.  A string test branches to `miss` on a length mismatch.
fn emit_pattern_test(s: *EmitterState, pat: *MatchArm, scrut_reg: i32, scrut_slot: i32, enum_name_sv: StrView, miss: i32, always: *i32) -> i32
    var enum_name: *u8 = enum_name_sv.ptr
    var enum_name_len: i32 = enum_name_sv.len as i32
    var cond_reg: i32 = 0
    let is_enum_match: i32 = (enum_name != null and enum_name_len > 0) as i32

    if pat.pattern_kind == PAT_INT_LIT or pat.pattern_kind == PAT_CHAR or pat.pattern_kind == PAT_BOOL
        cond_reg = next_reg(s)
        emit_str(s, IR_INDENT)
        emit_reg(s, cond_reg)
        emit_str(s, c" = icmp eq i64 ")
        emit_reg(s, scrut_reg)
        emit_str(s, IR_COMMA)
        emit_int(s, pat.pattern_int)
        emit_str(s, IR_NL)
    else if pat.pattern_kind == PAT_STR
        cond_reg = emit_str_pattern_test(s, pat, scrut_reg, miss)
    else if pat.pattern_kind == PAT_WILDCARD
        *always = 1
    else if pat.pattern_kind == PAT_IDENT
        # Ident pattern — unit variant (None/Err/Light/Dark) or a binding.
        # First try the user-enum tracker so user-declared variants resolve
        # to their proper tag index; fall back to None/Err special-casing
        # for tagged enums; otherwise treat as a binding (*always).
        if is_enum_match == 1 and is_enum_type(StrView { ptr: (enum_name), len: (enum_name_len) as i64 }) == 1
            let user_idx: i32 = enum_variant_index(StrView { ptr: (enum_name), len: (enum_name_len) as i64 }, StrView { ptr: (pat.pattern_name), len: (pat.pattern_name_len) as i64 })
            if user_idx >= 0
                cond_reg = emit_variant_tag_check_eq(s, scrut_slot, StrView { ptr: (enum_name), len: (enum_name_len) as i64 }, user_idx)
        if cond_reg == 0 and pat.pattern_name_len == 4
            if *pat.pattern_name == 'N' and *(pat.pattern_name + 1) == 'o'
                if *(pat.pattern_name + 2) == 'n' and *(pat.pattern_name + 3) == 'e'
                    # "None": null variant → tag != 0
                    if is_enum_match == 1
                        cond_reg = emit_variant_tag_check(s, scrut_slot, StrView { ptr: (enum_name), len: (enum_name_len) as i64 }, 0)
                    else
                        cond_reg = emit_variant_tag_check_i64(s, scrut_reg, 0)
        # A constant pattern (LANGUAGE_SPEC §8.2, AGAST #1880): a name that
        # is an integer const compares, as ritz0 does; any other binds.
        if cond_reg == 0 and is_enum_match == 0
            let ce: *ConstEntry = find_const_entry(s, StrView { ptr: (pat.pattern_name), len: (pat.pattern_name_len) as i64 })
            if ce != null and is_int_const_type(ce.const_type) == 1
                cond_reg = next_reg(s)
                emit_str(s, IR_INDENT)
                emit_reg(s, cond_reg)
                emit_str(s, c" = icmp eq i64 ")
                emit_reg(s, scrut_reg)
                emit_str(s, IR_COMMA)
                emit_int(s, ce.value)
                emit_str(s, IR_NL)
        if cond_reg == 0
            *always = 1
    else if pat.pattern_kind == PAT_VARIANT
        # User-declared enum: look up the variant's tag index from the
        # parser's enum tracker (Shade.Light=0, Shade.Dark=1).  Falls back
        # to the binary Some/Ok-vs-None/Err mapping for tagged enums.
        if is_enum_match == 1 and is_enum_type(StrView { ptr: (enum_name), len: (enum_name_len) as i64 }) == 1
            let user_idx: i32 = enum_variant_index(StrView { ptr: (enum_name), len: (enum_name_len) as i64 }, StrView { ptr: (pat.pattern_name), len: (pat.pattern_name_len) as i64 })
            if user_idx >= 0
                cond_reg = emit_variant_tag_check_eq(s, scrut_slot, StrView { ptr: (enum_name), len: (enum_name_len) as i64 }, user_idx)
            else
                *always = 1
        else
            let tag_one: i32 = variant_is_tag_one(StrView { ptr: (pat.pattern_name), len: (pat.pattern_name_len) as i64 })
            if is_enum_match == 1
                cond_reg = emit_variant_tag_check(s, scrut_slot, StrView { ptr: (enum_name), len: (enum_name_len) as i64 }, tag_one)
            else
                cond_reg = emit_variant_tag_check_i64(s, scrut_reg, tag_one)
    else
        *always = 1

    cond_reg

fn emit_match_arm(s: *EmitterState, arm: *MatchArm, scrut_reg: i32, scrut_slot: i32, enum_name_sv: StrView, result: *MatchResult, arm_index: i32, end_label: i32)
    var enum_name: *u8 = enum_name_sv.ptr
    var enum_name_len: i32 = enum_name_sv.len as i32
    let body_label: i32 = next_label(s)
    let next_label_id: i32 = next_label(s)

    # AGAST #4450: an or-pattern tests its alternatives in turn, each missing
    # to the next one's test and the last to the next arm; any that matches
    # enters the one body.
    var pat: *MatchArm = arm
    while pat != null
        var miss: i32 = next_label_id
        if pat.or_next != null
            miss = next_label(s)
        var always_true: i32 = 0
        let cond_reg: i32 = emit_pattern_test(s, pat, scrut_reg, scrut_slot, StrView { ptr: (enum_name), len: (enum_name_len) as i64 }, miss, @always_true)
        if always_true == 1
            emit_str(s, IR_BR)
            emit_label(s, body_label)
            emit_str(s, IR_NL)
        else
            emit_str(s, c"  br i1 ")
            emit_reg(s, cond_reg)
            emit_str(s, IR_LABEL_SEP)
            emit_label(s, body_label)
            emit_str(s, IR_LABEL_SEP)
            emit_label(s, miss)
            emit_str(s, IR_NL)
        if pat.or_next != null
            begin_block(s, miss)
        pat = pat.or_next

    begin_block(s, body_label)
    emit_match_arm_body(s, arm, scrut_reg, scrut_slot, StrView { ptr: (enum_name), len: (enum_name_len) as i64 }, result, arm_index, end_label)

    begin_block(s, next_label_id)

fn is_ident_none_name(name_sv: StrView) -> i32
    var name: *u8 = name_sv.ptr
    var len: i32 = name_sv.len as i32
    if len == 4 and memcmp(name, c"None", 4) == 0
        return 1
    return 0

# AGAST #3041: 1 when `cast` is `x as E` with `x` already a (non-generic)
# user enum `E`: the cast is `x` itself, as in ritz0, for a fieldless enum and
# one that carries data alike.  emit_enum_to_int read it as `x as <integer>`
# and refused the data-carrying one.
pub fn enum_identity_cast(s: *EmitterState, cast: *Expr) -> i32
    if cast.type_kind != TypeKind.Struct or cast.ident_len <= 0
        return 0
    var en: *u8 = null
    var en_len: i32 = 0
    if user_enum_value_of(s, cast.left, @en, @en_len) < 0
        return 0
    name_eq(StrView { ptr: (en), len: (en_len) as i64 }, StrView { ptr: (cast.ident_ptr), len: (cast.ident_len) as i64 })

# `x as U` for a fieldless user enum value `x` (LANGUAGE_SPEC §10.4): the
# discriminant of `x`'s variant, as an i64 register held per the enum's
# representation type (*out_src_ty; TypeKind.I64 without one), for the int → int
# cast that follows to wrap it to U.  The tag (field 0) is the declaration
# index; it maps to the discriminant through a select chain, or is the
# discriminant itself when no `= N` moved one.  An enum with a payload
# variant is the located error ritz0 gives.  -1 when `x` is no user enum.
pub fn emit_enum_to_int(s: *EmitterState, cast: *Expr, raw_reg: i32, out_src_ty: *TypeKind) -> i32
    var en: *u8 = null
    var en_len: i32 = 0
    let ei: i32 = user_enum_value_of(s, cast.left, @en, @en_len)
    if ei < 0
        return 0 - 1
    let n: i32 = enum_variant_count(ei)
    for vi in 0..n
        if enum_variant_kind(ei, vi) != ENUM_VARIANT_UNIT
            var vf: *StructField = enum_variant_fields(ei, vi)
            diag_error_at(emitter_source_file(), cast.span)
            eprints_cstr(c"cannot convert enum '")
            eprint_bytes(StrView { ptr: (en), len: (en_len) as i64 })
            eprints_cstr(c"' to an integer: variant '")
            eprint_bytes(StrView { ptr: (vf.name), len: (vf.name_len) as i64 })
            eprints_cstr(c"' carries data\n")
            s.error_count = s.error_count + 1
            *out_src_ty = TypeKind.I64
            let z: i32 = next_reg(s)
            emit_str(s, IR_INDENT)
            emit_reg(s, z)
            emit_str(s, IR_ADD_ZERO)
            return z
    *out_src_ty = enum_repr(ei)
    if *out_src_ty == TypeKind.Void
        *out_src_ty = TypeKind.I64
    let tag_ty: *u8 = enum_tag_llvm(ei)
    let tag: i32 = next_reg(s)
    emit_str(s, IR_INDENT)
    emit_reg(s, tag)
    emit_str(s, c" = extractvalue %")
    emit_name(s, StrView { ptr: (en), len: (en_len) as i64 })
    emit_str(s, IR_SP)
    emit_reg(s, raw_reg)
    emit_str(s, IR_COMMA_0)
    # AGAST #4574: a repr enum's tag IS its discriminant; widen it as its
    # repr type would be (an i64 / u64 repr is already i64).
    if ty_int_bits(enum_repr(ei)) == 64
        return tag
    var r: i32 = next_reg(s)
    emit_str(s, IR_INDENT)
    emit_reg(s, r)
    if enum_tag_signed(ei) == 1
        emit_str(s, c" = sext ")
    else
        emit_str(s, c" = zext ")
    emit_str(s, tag_ty)
    emit_str(s, IR_SP)
    emit_reg(s, tag)
    emit_str(s, IR_TO_I64)
    if enum_discr_is_index(ei) == 1 or ty_int_bits(enum_repr(ei)) > 0
        return r
    let first: i32 = next_reg(s)
    emit_str(s, IR_INDENT)
    emit_reg(s, first)
    emit_str(s, c" = add i64 0, ")
    emit_int(s, enum_variant_discr(ei, 0))
    emit_str(s, IR_NL)
    r = first
    for vi in 1..n
        let is_vi: i32 = next_reg(s)
        emit_str(s, IR_INDENT)
        emit_reg(s, is_vi)
        emit_str(s, c" = icmp eq i8 ")
        emit_reg(s, tag)
        emit_str(s, IR_COMMA)
        emit_int(s, vi as i64)
        emit_str(s, IR_NL)
        let sel: i32 = next_reg(s)
        emit_str(s, IR_INDENT)
        emit_reg(s, sel)
        emit_str(s, c" = select i1 ")
        emit_reg(s, is_vi)
        emit_str(s, IR_I64_SEP)
        emit_int(s, enum_variant_discr(ei, vi as i32))
        emit_str(s, IR_I64_SEP)
        emit_reg(s, r)
        emit_str(s, IR_NL)
        r = sel
    return r

# The non-generic user enum value `e` evaluates to: its index, with its name
# in out_name/out_len; -1 if `e` is none.  resolve_scrutinee_enum knows enum
# locals and `Lv.Lo`; a bare unit variant `Lo` is bare_unit_variant_enum's
# (#3340, #3351: `Lo as u64` passed the `%Lv` aggregate as the int).  A
# name two enums declare is -1 here: the bare-variant emitter reports it.
pub fn user_enum_value_of(s: *EmitterState, e: *Expr, out_name: **u8, out_len: *i32) -> i32
    if e == null
        return 0 - 1
    var ei: i32 = 0 - 1
    if resolve_scrutinee_enum(s, e, out_name, out_len) == 1
        ei = enum_find(StrView { ptr: (*out_name), len: (*out_len) as i64 })
    else
        var vi: i32 = 0
        var other: i32 = 0
        ei = bare_unit_variant_enum(s, e, @vi, @other)
        if ei >= 0
            *out_name = enum_name_at(ei, out_len)
    if ei < 0 or enum_is_generic(ei) == 1
        return 0 - 1
    ei

# Resolve the scrutinee's enum struct type name by peeking at the AST:
#   * ExprKind.Ident   -> local's recorded struct type
#   * ExprKind.Call    -> callee's return struct type (by name)
#   * ExprKind.Unary*  -> unwrap deref (match *res) and recurse
# Returns 1 with (out_name, out_len) filled, 0 otherwise.
# AGAST #2135: 1 when the local holds a pointer (`*T`, `**T`), not a value.
fn resolve_local_is_ptr(loc: *LocalVar) -> i32
    if lv_var_type(loc) == TypeKind.Ptr or lv_var_type(loc) == TypeKind.PtrPtr
        return 1
    0

pub fn resolve_scrutinee_enum(s: *EmitterState, scr: *Expr, out_name: **u8, out_len: *i32) -> i32
    match scr.kind
        ExprKind.Ident =>
            let loc: *LocalVar = find_local_struct_name(s, StrView { ptr: (scr.ident_ptr), len: (scr.ident_len) as i64 })
            # AGAST #2135: a pointer local is no enum value, whatever its
            # type_name says.  A `*u8` param's type_name is the parser's
            # last-seen type name (an enum field's type, say), so trusting it
            # lowered `d as *H` as enum -> int.  `*p` of a `*E` is the deref arm.
            if loc != null and resolve_local_is_ptr(loc) == 0
                if lv_type_name_len(loc) > 0
                    if is_tagged_enum_type(StrView { ptr: (lv_type_name(loc)), len: (lv_type_name_len(loc)) as i64 }) == 1
                        *out_name = lv_type_name(loc)
                        *out_len = lv_type_name_len(loc)
                        return 1
                    # Also recognize user-declared enums (Shade, etc.) via the
                    # parser's per-enum tracker.  The tag is field 0 and the
                    # payload field 2, as for Result/Option (AGAST #1797).
                    if is_enum_type(StrView { ptr: (lv_type_name(loc)), len: (lv_type_name_len(loc)) as i64 }) == 1
                        *out_name = lv_type_name(loc)
                        *out_len = lv_type_name_len(loc)
                        return 1
        ExprKind.Method =>
            # AGAST #1466: `match Opt.Holds(40)`, a qualified variant ctor.
            qualified_variant_enum(s, scr, out_name, out_len)
            if *out_name != null
                return 1
        ExprKind.Call =>
            # AGAST #1466: `match Holds(40)`, an unqualified user-enum ctor.
            user_variant_ctor_enum(scr, out_name, out_len)
            if *out_name != null
                return 1
            let fd: *FnDef = find_call_fn(s, scr)
            if fd != null
                if fd.return_type == TypeKind.Struct
                    if fd.return_type_name_len > 0
                        if is_tagged_enum_type(StrView { ptr: (fd.return_type_name), len: (fd.return_type_name_len) as i64 }) == 1
                            *out_name = fd.return_type_name
                            *out_len = fd.return_type_name_len
                            return 1
                        if is_enum_type(StrView { ptr: (fd.return_type_name), len: (fd.return_type_name_len) as i64 }) == 1
                            *out_name = fd.return_type_name
                            *out_len = fd.return_type_name_len
                            return 1
        ExprKind.Unary =>
            if scr.op == OpKind.Deref
                let opnd: *Expr = scr.operand
                if opnd != null and opnd.kind == ExprKind.Ident
                    # `*p` of a `p: *E` local: E, from the pointee's name.  Only
                    # a `*T` names its pointee: a `**T`'s deref is a pointer.
                    let ploc: *LocalVar = find_local_struct_name(s, StrView { ptr: (opnd.ident_ptr), len: (opnd.ident_len) as i64 })
                    if ploc != null and lv_var_type(ploc) == TypeKind.Ptr and lv_pointee_type(ploc) == TypeKind.Struct
                        if lv_type_name_len(ploc) > 0
                            if is_tagged_enum_type(StrView { ptr: (lv_type_name(ploc)), len: (lv_type_name_len(ploc)) as i64 }) == 1 or is_enum_type(StrView { ptr: (lv_type_name(ploc)), len: (lv_type_name_len(ploc)) as i64 }) == 1
                                *out_name = lv_type_name(ploc)
                                *out_len = lv_type_name_len(ploc)
                                return 1
                        *out_name = null
                        *out_len = 0
                        return 0
                if resolve_scrutinee_enum(s, scr.operand, out_name, out_len) == 1
                    return 1
        ExprKind.Member =>
            # AGAST #1466: `match Opt.Vacant`, a qualified unit variant.
            qualified_variant_enum(s, scr, out_name, out_len)
            if *out_name != null
                return 1
            # AGAST #1797: an enum-typed struct field, `match h.d`.  It loads
            # the `%Enum` aggregate; matched as a scalar, every arm compared
            # the aggregate register as an i64 and fell through.
            let fld: *StructField = resolve_member_chain_field(s, scr)
            if fld != null and fld.field_type == TypeKind.Struct and fld.field_type_name_len > 0
                if is_tagged_enum_type(StrView { ptr: (fld.field_type_name), len: (fld.field_type_name_len) as i64 }) == 1 or is_enum_type(StrView { ptr: (fld.field_type_name), len: (fld.field_type_name_len) as i64 }) == 1
                    *out_name = fld.field_type_name
                    *out_len = fld.field_type_name_len
                    return 1
        _ => pass
    # AGAST #4450: any other read of a unit enum from memory -- a global, an
    # `[N]E` element, `p[i]` / `*(p + i)` through a `*E` -- loads the `%E`
    # exactly as a local does, so `g as i32` and `match a[i]` read its tag.
    unit_enum_expr_name(s, scr, out_name, out_len)
    if *out_len > 0
        return 1
    *out_name = null
    *out_len = 0
    return 0

# AGAST #2344: the struct `scr` yields, for the shapes resolve_scrutinee_enum
# leaves out.  It stays strict for its other callers, but a match cannot: `R` in
# `match a[1]` is a variant or a binding by this type alone, and read as a
# binding it took the first arm and looked covered.
pub fn match_scrutinee_type(s: *EmitterState, scr: *Expr, out_name: **u8, out_len: *i32)
    *out_name = null
    *out_len = 0
    match scr.kind
        ExprKind.Ident =>
            let loc: *LocalVar = find_local_struct_name(s, StrView { ptr: (scr.ident_ptr), len: (scr.ident_len) as i64 })
            if loc != null
                if lv_var_type(loc) == TypeKind.Struct
                    *out_name = lv_type_name(loc)
                    *out_len = lv_type_name_len(loc)
                return
            let g: *GlobalVarDef = find_global(s, StrView { ptr: (scr.ident_ptr), len: (scr.ident_len) as i64 })
            if g != null and g.var_type == TypeKind.Struct
                *out_name = g.type_name
                *out_len = g.type_name_len
            # LARB R60 (#3480): a const is a whole value, so `match MODE` reads
            # the type its declaration wrote, as `match g` does.  Untyped, the
            # arms were judged against a scalar and every variant arm refused.
            if g == null
                let ce: *ConstEntry = find_const_entry(s, StrView { ptr: (scr.ident_ptr), len: (scr.ident_len) as i64 })
                if ce != null and ce.const_type == TypeKind.Struct and ce.type_name_len > 0
                    *out_name = ce.type_name
                    *out_len = ce.type_name_len
        ExprKind.Method | ExprKind.Call =>
            call_result_struct_name(s, scr, out_name, out_len)
        ExprKind.Index =>
            index_elem_struct_name(s, scr, out_name, out_len)
        ExprKind.Member =>
            let fld: *StructField = resolve_member_chain_field(s, scr)
            if fld != null and fld.field_type == TypeKind.Struct
                *out_name = fld.field_type_name
                *out_len = fld.field_type_name_len
        _ =>
            if scr.kind == ExprKind.Cast and scr.type_kind == TypeKind.Struct and scr.ident_len > 0
                # AGAST #2503: `x as B` is a B.  Untyped, the arms guessed the enum,
                # and an `A` declaring the first arm's `V` too judged B's arms as A's.
                *out_name = scr.ident_ptr
                *out_len = scr.ident_len
            else if (scr.kind == ExprKind.If or scr.kind == ExprKind.Match) and scr.value_ty_name != null
                # AGAST #3042: `match (if c then b else d)` is what its branches are,
                # as Sema typed them (sema_note_arm_value).  Untyped, the arms guessed
                # the enum: refused when two enums declare the arm's name (#2503),
                # and a generic `G<i32>` was matched as an i64, IR clang rejects.
                *out_name = scr.value_ty_name
                *out_len = scr.value_ty_name_len

# 1 when `scr` is certainly no enum, so a bare name in an arm is a binding or a
# const.  Anything this cannot prove stays open: see match_arms_enum.
fn match_scrutinee_is_scalar(s: *EmitterState, scr: *Expr) -> i32
    let k: ExprKind = scr.kind
    match k
        ExprKind.IntLit | ExprKind.CharLit | ExprKind.Binary =>
            return 1
        ExprKind.Unary =>
            return (scr.op != OpKind.Deref) as i32
        ExprKind.Cast =>
            return (scr.type_kind != TypeKind.Struct) as i32
        ExprKind.Ident =>
            let loc: *LocalVar = find_local_struct_name(s, StrView { ptr: (scr.ident_ptr), len: (scr.ident_len) as i64 })
            if loc != null
                return (lv_var_type(loc) != TypeKind.Struct) as i32
            let g: *GlobalVarDef = find_global(s, StrView { ptr: (scr.ident_ptr), len: (scr.ident_len) as i64 })
            if g != null
                return (g.var_type != TypeKind.Struct) as i32
            # A struct- or enum-typed const is no scalar either: `match MODE` on
            # `const MODE: Mode` is the enum (§4.3, #3480).  An integer const is.
            let ce: *ConstEntry = find_const_entry(s, StrView { ptr: (scr.ident_ptr), len: (scr.ident_len) as i64 })
            if ce != null
                return (ce.const_type != TypeKind.Struct) as i32
            return 0
        ExprKind.Call =>
            let fd: *FnDef = find_call_fn(s, scr)
            return (fd != null and fd.return_type != TypeKind.Struct) as i32
        ExprKind.Member =>
            let fld: *StructField = resolve_member_chain_field(s, scr)
            return (fld != null and fld.field_type != TypeKind.Struct) as i32
        _ => pass
    0

# AGAST #1876: 1 when `scr` is a StrView, the one scrutinee a string arm
# compares.  A `*u8` or a String is converted by the caller (§8.2).
fn match_scrutinee_is_strview(s: *EmitterState, scr: *Expr) -> i32
    if scr.kind == ExprKind.StringLit
        return 1
    var name: *u8 = null
    var len: i32 = 0
    match_scrutinee_type(s, scr, @name, @len)
    (name != null and name_eq(StrView { ptr: (name), len: (len) as i64 }, StrView { ptr: (c"StrView"), len: (7) as i64 }) == 1) as i32

fn enum_declares_variant(ei: i32, name_sv: StrView) -> i32
    var name: *u8 = name_sv.ptr
    var len: i32 = name_sv.len as i32
    for vi in 0..enum_variant_count(ei)
        var vlen: i32 = 0
        let vname: *u8 = enum_variant_name(ei, vi, @vlen)
        if name_eq(StrView { ptr: (vname), len: (vlen) as i64 }, StrView { ptr: (name), len: (len) as i64 }) == 1
            return 1
    0

# The first arm that names a user enum's variant, for a scrutinee no rule above
# could type, or null.  A scalar scrutinee keeps its bindings.
fn match_arms_enum_arm(s: *EmitterState, scr: *Expr, arms: *MatchArm) -> *MatchArm
    if match_scrutinee_is_scalar(s, scr) == 1
        return null
    var arm: *MatchArm = arms
    while arm != null
        if arm.pattern_kind == PAT_VARIANT or arm.pattern_kind == PAT_IDENT
            if user_enum_declares(StrView { ptr: (arm.pattern_name), len: (arm.pattern_name_len) as i64 }) == 1
                return arm
        arm = arm.next
    null

# 1 when enum `ei` is one the source declares (no `G$i32` instance, whose
# template is recorded too) and it declares `name`.
fn declared_enum_has_variant(ei: i32, name_sv: StrView) -> i32
    var name: *u8 = name_sv.ptr
    var len: i32 = name_sv.len as i32
    var nlen: i32 = 0
    let ename: *u8 = enum_name_at(ei, @nlen)
    for i in 0..nlen
        if *(ename + i) == '$'
            return 0
    enum_declares_variant(ei, StrView { ptr: (name), len: (len) as i64 })

# How many enums the source declares `name` in.
fn user_enums_declaring(name_sv: StrView) -> i32
    var name: *u8 = name_sv.ptr
    var len: i32 = name_sv.len as i32
    var n: i32 = 0
    for ei in 0..enum_count()
        n = n + declared_enum_has_variant(ei, StrView { ptr: (name), len: (len) as i64 })
    n

# The enum an arm names, for a scrutinee no rule above could type, or -1.  ritz0
# reads the type off the emitted value and ritz1 cannot, so this is what keeps
# `R` in `match x as C` from binding: that took the first arm, and looked like a
# catch-all to coverage.  AGAST #2503: only when one enum declares that name.
# Of two, the first was taken, and judged the other's arms as its own
# (match_refuse_ambiguous_arms refuses that match instead).
fn match_arms_enum(s: *EmitterState, scr: *Expr, arms: *MatchArm) -> i32
    let arm: *MatchArm = match_arms_enum_arm(s, scr, arms)
    if arm == null or user_enums_declaring(StrView { ptr: (arm.pattern_name), len: (arm.pattern_name_len) as i64 }) != 1
        return 0 - 1
    for ei in 0..enum_count()
        if enum_declares_variant(ei, StrView { ptr: (arm.pattern_name), len: (arm.pattern_name_len) as i64 }) == 1
            return ei
    0 - 1

# AGAST #2503: 1, and a located error, when the arms are all that could name
# the scrutinee's enum and two or more enums declare the name they give.
fn match_refuse_ambiguous_arms(s: *EmitterState, scr: *Expr, arms: *MatchArm) -> i32
    let arm: *MatchArm = match_arms_enum_arm(s, scr, arms)
    if arm == null or user_enums_declaring(StrView { ptr: (arm.pattern_name), len: (arm.pattern_name_len) as i64 }) < 2
        return 0
    eprints_cstr(fn_source_file(emitter_current_fn()))
    eprint_char(':')
    eprint_i64(arm.head_span.line as i64)
    eprint_char(':')
    eprint_i64(arm.head_span.col as i64)
    eprints_cstr(c": error: cannot tell which enum ")
    eprint_bytes(StrView { ptr: (arm.pattern_name), len: (arm.pattern_name_len) as i64 })
    eprints_cstr(c" is of: ")
    var seen: i32 = 0
    for ei in 0..enum_count()
        if declared_enum_has_variant(ei, StrView { ptr: (arm.pattern_name), len: (arm.pattern_name_len) as i64 }) == 1
            if seen > 0
                eprints_cstr(c", ")
            var nlen: i32 = 0
            let ename: *u8 = enum_name_at(ei, @nlen)
            eprint_bytes(StrView { ptr: (ename), len: (nlen) as i64 })
            seen = seen + 1
    eprints_cstr(c" declare it, and ritz1 can't type the scrutinee; bind it to a typed local first\n")
    emit_str(s, c"  ; ERROR: a match's enum is ambiguous\n")
    s.error_count = s.error_count + 1
    1

# --- A bare constructor as the scrutinee (AGAST #2419) -----------------------
#
# `match Some(5)` names no enum, so the constructor had none to build: it lowered
# to `add i64 0, 0` and the match ran on that zero.  The payload names it, the
# same whatever else the module says: `Some(5)` is an Option<i64>, as a literal is
# an i64.  A type argument nothing gives (None's, Ok's E, Err's T) takes that
# default too; no arm can read it.

# 1 when a user enum declares `name`, whichever one or how many.
fn user_enum_declares(name_sv: StrView) -> i32
    var name: *u8 = name_sv.ptr
    var len: i32 = name_sv.len as i32
    for ei in 0..enum_count()
        if enum_declares_variant(ei, StrView { ptr: (name), len: (len) as i64 }) == 1
            return 1
    0

# 1 when emit_expr lowers `e` as Some/Ok/Err(x), or `e` is the Option's None: one
# no name shadows and no user enum declares.  A user's None is its enum's bare unit
# variant (match_scrutinee_is_ctor, #2434), never an Option's tag.
pub fn is_tagged_ctor(s: *EmitterState, e: *Expr) -> i32
    if e.kind == ExprKind.Call
        return (is_variant_carrier(StrView { ptr: (e.func_name), len: (e.func_name_len) as i64 }) == 1 or is_variant_null(StrView { ptr: (e.func_name), len: (e.func_name_len) as i64 }) == 1) as i32
    if e.kind != ExprKind.Ident or is_ident_none(StrView { ptr: (e.ident_ptr), len: (e.ident_len) as i64 }) == 0
        return 0
    if is_const(s, StrView { ptr: (e.ident_ptr), len: (e.ident_len) as i64 }) == 1 or find_global(s, StrView { ptr: (e.ident_ptr), len: (e.ident_len) as i64 }) != null
        return 0
    if user_enum_declares(StrView { ptr: (e.ident_ptr), len: (e.ident_len) as i64 }) == 1
        return 0
    (find_local(s, StrView { ptr: (e.ident_ptr), len: (e.ident_len) as i64 }) < 0) as i32

# 1 when `e` is a constructor that takes its enum from its context: a tagged one,
# or a user's bare unit variant, which is no place to take the address of.
fn match_scrutinee_is_ctor(s: *EmitterState, e: *Expr) -> i32
    if is_tagged_ctor(s, e) == 1
        return 1
    var vi: i32 = 0
    var other: i32 = 0
    if generic_ctor_enum(s, e, @vi) >= 0   # AGAST #2437
        return 1
    (bare_unit_variant_enum(s, e, @vi, @other) >= 0) as i32

# 1 when `e` builds its enum where it stands, payload and all: nothing but the
# match can own that value (own_scrutinee_moved).
pub fn match_scrutinee_builds(s: *EmitterState, e: *Expr) -> i32
    if is_tagged_ctor(s, e) == 1
        return 1
    var gvi: i32 = 0
    if e.kind == ExprKind.Call and generic_ctor_enum(s, e, @gvi) >= 0   # AGAST #2437
        return 1
    var name: *u8 = null
    var len: i32 = 0
    match e.kind
        ExprKind.Call =>
            user_variant_ctor_enum(e, @name, @len)
        ExprKind.Method =>
            qualified_variant_enum(s, e, @name, @len)
        _ => pass
    (name != null) as i32

# `a`, `b` and `c` as one NUL-terminated name, its length in *out_len.
pub fn ctor_join(a_sv: StrView, b_sv: StrView, c_sv: StrView, out_len: *i32) -> *u8
    var a: *u8 = a_sv.ptr
    var a_len: i32 = a_sv.len as i32
    var b: *u8 = b_sv.ptr
    var b_len: i32 = b_sv.len as i32
    var c: *u8 = c_sv.ptr
    var c_len: i32 = c_sv.len as i32
    let n: i32 = a_len + b_len + c_len
    let name: *u8 = malloc((n + 1) as i64)
    memcpy(name, a, a_len as i64)
    memcpy(name + a_len, b, b_len as i64)
    memcpy(name + a_len + b_len, c, c_len as i64)
    *(name + n) = 0
    *out_len = n
    name

# A pointer's spelling, `ptr_T`, for the shapes that record T; else 0.
fn ctor_pointer_spelling(s: *EmitterState, e: *Expr, out: **u8) -> i32
    if e.kind == ExprKind.CstringLit
        *out = c"ptr_u8"
        return 6
    if e.kind != ExprKind.Ident
        return 0
    let loc: *LocalVar = find_local_struct_name(s, StrView { ptr: (e.ident_ptr), len: (e.ident_len) as i64 })
    if loc == null
        return 0
    var base: *u8 = lv_type_name(loc)
    var base_len: i32 = lv_type_name_len(loc)
    if lv_pointee_type(loc) != TypeKind.Struct
        base_len = primitive_arg_spelling(lv_pointee_type(loc), @base)
    if base_len <= 0
        return 0
    var n: i32 = 0
    *out = ctor_join(StrView { ptr: (c"ptr_"), len: (4) as i64 }, StrView { ptr: (base), len: (base_len) as i64 }, StrView { ptr: (c""), len: (0) as i64 }, @n)
    n

# The type argument payload `e` gives its enum, spelled as a mangled name; its
# length, or 0 when ritz1 can't name it.  A nested constructor is its own enum's,
# named by its payload the same way (AGAST #2435): `Some(5)` in `Some(Some(5))`
# is `Option$i64`.
pub fn ctor_payload_spelling(s: *EmitterState, e: *Expr, out: **u8) -> i32
    if is_tagged_ctor(s, e) == 1
        var len: i32 = 0
        let name: *u8 = tagged_ctor_enum_name(s, e, @len)
        if name == null
            return 0
        *out = name
        return len
    if e.kind == ExprKind.StringLit
        *out = c"StrView"   # layout-equal to the %Span$u8 it lowers to
        return 7
    if bool_kind(s, e) == BK_BOOL   # `true` is an ExprKind.IntLit to get_expr_type
        *out = c"bool"
        return 4
    var name: *u8 = null
    var len: i32 = 0
    variant_payload_aggregate(s, e, @name, @len)
    if name != null
        *out = name
        return len
    # A struct emit_variant_build would store as a scalar, which get_expr_type
    # can call an i64: `Some(t.m())`, `Some(a[1])`.
    match_scrutinee_type(s, e, @name, @len)
    if name != null
        return 0
    let ty: TypeKind = expr_slot_ty(e)
    if ty == TypeKind.Ptr
        return ctor_pointer_spelling(s, e, out)
    primitive_arg_spelling(ty, out)

# The enum tagged constructor `scr` builds, named by its payload alone: i64 for a
# type argument nothing gives.  null when its payload can't be named.
fn tagged_ctor_enum_name(s: *EmitterState, scr: *Expr, out_len: *i32) -> *u8
    *out_len = 0
    var arg: *u8 = c"i64"
    var arg_len: i32 = 3
    let is_none: i32 = (scr.kind == ExprKind.Ident or is_ident_none(StrView { ptr: (scr.func_name), len: (scr.func_name_len) as i64 }) == 1) as i32
    if is_none == 0 and scr.args != null
        arg_len = ctor_payload_spelling(s, scr.args, @arg)
        if arg_len <= 0
            return null
    if is_none == 1 or name_eq(StrView { ptr: (scr.func_name), len: (scr.func_name_len) as i64 }, StrView { ptr: (c"Some"), len: (4) as i64 }) == 1
        return ctor_join(StrView { ptr: (c"Option$"), len: (7) as i64 }, StrView { ptr: (arg), len: (arg_len) as i64 }, StrView { ptr: (c""), len: (0) as i64 }, out_len)
    if name_eq(StrView { ptr: (scr.func_name), len: (scr.func_name_len) as i64 }, StrView { ptr: (c"Ok"), len: (2) as i64 }) == 1
        return ctor_join(StrView { ptr: (c"Result$"), len: (7) as i64 }, StrView { ptr: (arg), len: (arg_len) as i64 }, StrView { ptr: (c"$i64"), len: (4) as i64 }, out_len)
    ctor_join(StrView { ptr: (c"Result$i64$"), len: (11) as i64 }, StrView { ptr: (arg), len: (arg_len) as i64 }, StrView { ptr: (c""), len: (0) as i64 }, out_len)

# The enum a constructor scrutinee builds, queued for its type decl.  null/0 when
# `scr` is none, or its payload can't be named.
pub fn ctor_scrutinee_enum(s: *EmitterState, scr: *Expr, out_name: **u8, out_len: *i32)
    *out_name = null
    *out_len = 0
    if is_tagged_ctor(s, scr) == 0
        return
    var len: i32 = 0
    let name: *u8 = tagged_ctor_enum_name(s, scr, @len)
    if name == null
        return
    if namelist_find(@s.late_enums, StrView { ptr: (name), len: (len) as i64 }) < 0
        namelist_push(@s.late_enums, StrView { ptr: (name), len: (len) as i64 })
    *out_name = name
    *out_len = len

# --- A generic user enum's bare constructor as the scrutinee (AGAST #2437) ----
#
# `match Hold(5)` for `enum W<T>`: the template has no struct, so the constructor
# lowered to a call to an undefined `@Hold`, and `match Gone` was an unknown
# identifier.  A scrutinee has no slot (§11.3; nor is it the fn's value, #2419),
# so the payload binds T as it does for an untyped let: `Hold(5)` is a `W$i64`.
# A T the payload leaves unbound, every one of a unit variant's, is the located
# error ritz0's Monomorphizer._infer_variant_scrutinee gives.  Here, not in
# generic_infer: a generic fn's `match Hold(x)` is emitted specialised, x typed.

# The generic enum the bare constructor `e` builds (*out_vi its variant), or -1:
# not a constructor, a name a local / const / global / fn takes, or a variant
# another enum declares too.  Option and Result are the tagged constructors'.
fn generic_ctor_enum(s: *EmitterState, e: *Expr, out_vi: *i32) -> i32
    *out_vi = 0 - 1
    var name: *u8 = null
    var len: i32 = 0
    if e.kind == ExprKind.Call and e.call_type_suffix_len == 0
        name = e.func_name
        len = e.func_name_len
    else if e.kind == ExprKind.Ident
        name = e.ident_ptr
        len = e.ident_len
        if find_local(s, StrView { ptr: (name), len: (len) as i64 }) >= 0 or is_const(s, StrView { ptr: (name), len: (len) as i64 }) == 1 or find_global(s, StrView { ptr: (name), len: (len) as i64 }) != null
            return 0 - 1
    if name == null or find_fn(s, StrView { ptr: (name), len: (len) as i64 }) != null
        return 0 - 1
    let ei: i32 = generic_enum_of_variant(StrView { ptr: (name), len: (len) as i64 }, out_vi)
    if ei < 0
        return 0 - 1
    var en_len: i32 = 0
    let en: *u8 = enum_name_at(ei, @en_len)
    if en_len == 6 and (memcmp(en, c"Option", 6) == 0 or memcmp(en, c"Result", 6) == 0)
        return 0 - 1
    ei

var g_gctor_refused: *Expr = null   # the scrutinee generic_ctor_scrutinee_enum refused

# "can't infer `T` for `Gone`: give the binding a type", at the constructor.
fn generic_ctor_error(s: *EmitterState, e: *Expr, tp: *TypeParam, name_sv: StrView)
    var name: *u8 = name_sv.ptr
    var len: i32 = name_sv.len as i32
    var n: i32 = 0
    let head: *u8 = ctor_join(StrView { ptr: (c"can't infer `"), len: (13) as i64 }, StrView { ptr: (tp.name), len: (tp.name_len) as i64 }, StrView { ptr: (c"` for `"), len: (7) as i64 }, @n)
    var m: i32 = 0
    let msg: *u8 = ctor_join(StrView { ptr: (head), len: (n) as i64 }, StrView { ptr: (name), len: (len) as i64 }, StrView { ptr: (c"`: give the binding a type"), len: (26) as i64 }, @m)
    emit_nd_error(s, e.span.line, e.span.col, msg)
    g_gctor_refused = e

# The instance `scr` builds, recorded and queued for its type decl, in *out_name;
# null when `scr` is no such constructor, or it was refused (g_gctor_refused).
fn generic_ctor_scrutinee_enum(s: *EmitterState, scr: *Expr, out_name: **u8, out_len: *i32)
    *out_name = null
    *out_len = 0
    var vi: i32 = 0
    let ei: i32 = generic_ctor_enum(s, scr, @vi)
    if ei < 0
        return
    var name: *u8 = scr.ident_ptr
    var len: i32 = scr.ident_len
    var args: *Expr = null
    if scr.kind == ExprKind.Call
        name = scr.func_name
        len = scr.func_name_len
        args = scr.args
    let tps: *TypeParam = generic_enum_params(ei)
    let n: i32 = count_type_params(tps)
    if n == 0
        return
    let names: **u8 = malloc((n as i64) * 8) as **u8
    let lens: *i32 = malloc((n as i64) * 4) as *i32
    for i in 0..n
        *(names + i) = null
        *(lens + i) = 0
    # A payload field typed exactly `T` binds T to its argument's type, spelled
    # as a mangled name (ctor_payload_spelling: a literal is i64).  A second
    # binding that disagrees leaves it unbound, as ritz0's conflict does.
    var f: *StructField = enum_variant_fields(ei, vi)
    var arg: *Expr = args
    while f != null and arg != null
        if f.field_type == TypeKind.Struct and f.field_type_name != null
            let ti: i32 = type_param_index(tps, StrView { ptr: (f.field_type_name), len: (f.field_type_name_len) as i64 })
            if ti >= 0 and *(lens + ti) >= 0
                var sp: *u8 = null
                let sp_len: i32 = ctor_payload_spelling(s, arg, @sp)
                if sp_len > 0 and *(names + ti) == null
                    *(names + ti) = sp
                    *(lens + ti) = sp_len
                else if sp_len > 0 and name_eq(StrView { ptr: (*(names + ti)), len: (*(lens + ti)) as i64 }, StrView { ptr: (sp), len: (sp_len) as i64 }) == 0
                    *(lens + ti) = 0 - 1
        f = f.next
        arg = arg.next
    var en_len: i32 = 0
    let en: *u8 = enum_name_at(ei, @en_len)
    var full: *u8 = ctor_join(StrView { ptr: (en), len: (en_len) as i64 }, StrView { ptr: (c""), len: (0) as i64 }, StrView { ptr: (c""), len: (0) as i64 }, out_len)
    var tp: *TypeParam = tps
    var i: i32 = 0
    while tp != null
        if *(lens + i) <= 0
            generic_ctor_error(s, scr, tp, StrView { ptr: (name), len: (len) as i64 })
            *out_name = null
            *out_len = 0
            return
        full = ctor_join(StrView { ptr: (full), len: (*out_len) as i64 }, StrView { ptr: (c"$"), len: (1) as i64 }, StrView { ptr: (*(names + i)), len: (*(lens + i)) as i64 }, out_len)
        tp = tp.next
        i = i + 1
    add_enum_instance(s.mono, s.module, StrView { ptr: (full), len: (*out_len) as i64 }, en_len)
    if user_enum_index(StrView { ptr: (full), len: (*out_len) as i64 }) < 0
        *out_len = 0
        return   # not an instance monomorph could record: no enum to build
    if namelist_find(@s.late_enums, StrView { ptr: (full), len: (*out_len) as i64 }) < 0
        namelist_push(@s.late_enums, StrView { ptr: (full), len: (*out_len) as i64 })
    *out_name = full

# `scr` under the enum the match named.  What the slot around the match wants (a
# typed let, the fn's return type) is that match's value, not its scrutinee's.
pub fn emit_ctor_scrutinee(s: *EmitterState, scr: *Expr, name_sv: StrView) -> i32
    var name: *u8 = name_sv.ptr
    var len: i32 = name_sv.len as i32
    let saved_name: *u8 = s.ctx_enum_name
    let saved_len: i32 = s.ctx_enum_name_len
    s.ctx_enum_name = name
    s.ctx_enum_name_len = len
    let reg: i32 = emit_expr(s, scr)
    s.ctx_enum_name = saved_name
    s.ctx_enum_name_len = saved_len
    reg

# As resolve_scrutinee_enum, for a match.  A generic enum named only by an arm is
# left out: the template has no enum struct to spill to, so only coverage reads
# it.  An instance the scrutinee's type names (`Slot$i32`) is a recorded enum
# with ritz0's layout (AGAST #2422), but no arm names one: an arm's `Full` is the
# template's.
fn resolve_match_enum(s: *EmitterState, scr: *Expr, arms: *MatchArm, out_name: **u8, out_len: *i32) -> i32
    if resolve_scrutinee_enum(s, scr, out_name, out_len) == 1
        return 1
    ctor_scrutinee_enum(s, scr, out_name, out_len)   # AGAST #2419
    if *out_name != null
        return 1
    generic_ctor_scrutinee_enum(s, scr, out_name, out_len)   # AGAST #2437
    if *out_name != null
        return 1
    var name: *u8 = null
    var len: i32 = 0
    match_scrutinee_type(s, scr, @name, @len)
    if name != null and (is_tagged_enum_type(StrView { ptr: (name), len: (len) as i64 }) == 1 or is_enum_type(StrView { ptr: (name), len: (len) as i64 }) == 1)
        *out_name = name
        *out_len = len
        return 1
    *out_name = null
    *out_len = 0
    if name == null
        let ei: i32 = match_arms_enum(s, scr, arms)
        if ei >= 0 and enum_is_generic(ei) == 0
            *out_name = enum_name_at(ei, out_len)
            return MATCH_ENUM_FROM_ARMS
    0

# resolve_match_enum's answer when only an arm named the enum: a guess, which
# can't judge the arms it came from (match_refuse_foreign_arms).
const MATCH_ENUM_FROM_ARMS: i32 = 2

# --- Coverage (LARB R6, AGAST #2344; LANGUAGE_SPEC §8.1) ---------------------
#
# ritz0's twin is ritz0/match_coverage.py, and test_match_exhaustive.py holds the
# two to one table.  The parser refuses guards, so no arm here has one.

# The first name opens the error; `count` says how many went before.
fn match_gap_name(line: i32, col: i32, count: *i32, name_sv: StrView)
    var name: *u8 = name_sv.ptr
    var len: i32 = name_sv.len as i32
    if *count == 0
        eprints_cstr(fn_source_file(emitter_current_fn()))
        eprint_char(':')
        eprint_i64(line as i64)
        eprint_char(':')
        eprint_i64(col as i64)
        eprints_cstr(c": error: non-exhaustive match: missing ")
    else
        eprints_cstr(c", ")
    eprint_bytes(StrView { ptr: (name), len: (len) as i64 })
    *count = *count + 1

fn match_gap_end(s: *EmitterState, count: i32)
    if count > 0
        eprints_cstr(c"\n")
        emit_str(s, c"  ; ERROR: non-exhaustive match\n")
        s.error_count = s.error_count + 1

# A name that is an integer const compares (§8.2, as emit_match_arm reads it).
fn match_arm_is_catch_all(s: *EmitterState, arm: *MatchArm) -> i32
    if arm.pattern_kind == PAT_WILDCARD
        return 1
    if arm.pattern_kind != PAT_IDENT
        return 0
    if s.match_scrut_str == 1   # an integer const tests only an integer (#1876)
        return 1
    let ce: *ConstEntry = find_const_entry(s, StrView { ptr: (arm.pattern_name), len: (arm.pattern_name_len) as i64 })
    if ce != null and is_int_const_type(ce.const_type) == 1
        return 0
    1

# Every alternative of an or-pattern counts (AGAST #4450).
fn match_arms_name(arms: *MatchArm, name_sv: StrView) -> i32
    var name: *u8 = name_sv.ptr
    var len: i32 = name_sv.len as i32
    var arm: *MatchArm = arms
    var pat: *MatchArm = arms
    while pat != null
        if pat.pattern_kind == PAT_IDENT or pat.pattern_kind == PAT_VARIANT
            if name_eq(StrView { ptr: (pat.pattern_name), len: (pat.pattern_name_len) as i64 }, StrView { ptr: (name), len: (len) as i64 }) == 1
                return 1
        pat = arm_pattern_next(@arm, pat)
    0

# Every variant of enum `ei`, in declaration order.  A name that is no variant
# here is a binding, and so a catch-all.
fn match_check_enum(s: *EmitterState, arms: *MatchArm, ei: i32, line: i32, col: i32)
    var arm: *MatchArm = arms
    while arm != null
        if arm.pattern_kind == PAT_WILDCARD
            return
        if arm.pattern_kind == PAT_IDENT and enum_declares_variant(ei, StrView { ptr: (arm.pattern_name), len: (arm.pattern_name_len) as i64 }) == 0
            return
        arm = arm.next
    var count: i32 = 0
    for vi in 0..enum_variant_count(ei)
        var vlen: i32 = 0
        let vname: *u8 = enum_variant_name(ei, vi, @vlen)
        if match_arms_name(arms, StrView { ptr: (vname), len: (vlen) as i64 }) == 0
            match_gap_name(line, col, @count, StrView { ptr: (vname), len: (vlen) as i64 })
    match_gap_end(s, count)

fn match_check_bool(s: *EmitterState, arms: *MatchArm, line: i32, col: i32)
    var has_true: bool = false
    var has_false: bool = false
    var arm: *MatchArm = arms
    var pat: *MatchArm = arms   # every alternative counts (AGAST #4450)
    while pat != null
        if match_arm_is_catch_all(s, pat) == 1
            return
        if pat.pattern_kind == PAT_BOOL
            if pat.pattern_int == 1
                has_true = true
            else
                has_false = true
        pat = arm_pattern_next(@arm, pat)
    var count: i32 = 0
    if not has_true
        match_gap_name(line, col, @count, StrView { ptr: (c"true"), len: (4) as i64 })
    if not has_false
        match_gap_name(line, col, @count, StrView { ptr: (c"false"), len: (5) as i64 })
    match_gap_end(s, count)

fn match_check_scalar(s: *EmitterState, arms: *MatchArm, line: i32, col: i32)
    var arm: *MatchArm = arms
    while arm != null
        if match_arm_is_catch_all(s, arm) == 1
            return
        arm = arm.next
    var count: i32 = 0
    match_gap_name(line, col, @count, StrView { ptr: (c"a catch-all"), len: (11) as i64 })
    match_gap_end(s, count)

# Option and Result need no import, so the enum tracker may never have seen them.
const MATCH_OPTION: i32 = 1
const MATCH_RESULT: i32 = 2

# Which of them an arm names, or 0.
fn match_arms_builtin(arms: *MatchArm) -> i32
    var arm: *MatchArm = arms
    while arm != null
        if arm.pattern_kind == PAT_VARIANT or arm.pattern_kind == PAT_IDENT
            if name_eq(StrView { ptr: (arm.pattern_name), len: (arm.pattern_name_len) as i64 }, StrView { ptr: (c"Some"), len: (4) as i64 }) == 1 or name_eq(StrView { ptr: (arm.pattern_name), len: (arm.pattern_name_len) as i64 }, StrView { ptr: (c"None"), len: (4) as i64 }) == 1
                return MATCH_OPTION
            if name_eq(StrView { ptr: (arm.pattern_name), len: (arm.pattern_name_len) as i64 }, StrView { ptr: (c"Ok"), len: (2) as i64 }) == 1 or name_eq(StrView { ptr: (arm.pattern_name), len: (arm.pattern_name_len) as i64 }, StrView { ptr: (c"Err"), len: (3) as i64 }) == 1
                return MATCH_RESULT
        arm = arm.next
    0

# Both variants of `a`/`b`, for Option or Result with no tracked declaration.
fn match_check_pair(s: *EmitterState, arms: *MatchArm, a_sv: StrView, b_sv: StrView, line: i32, col: i32)
    var a: *u8 = a_sv.ptr
    var a_len: i32 = a_sv.len as i32
    var b: *u8 = b_sv.ptr
    var b_len: i32 = b_sv.len as i32
    var arm: *MatchArm = arms
    while arm != null
        if arm.pattern_kind == PAT_WILDCARD
            return
        if arm.pattern_kind == PAT_IDENT
            if name_eq(StrView { ptr: (arm.pattern_name), len: (arm.pattern_name_len) as i64 }, StrView { ptr: (a), len: (a_len) as i64 }) == 0 and name_eq(StrView { ptr: (arm.pattern_name), len: (arm.pattern_name_len) as i64 }, StrView { ptr: (b), len: (b_len) as i64 }) == 0
                return
        arm = arm.next
    var count: i32 = 0
    if match_arms_name(arms, StrView { ptr: (a), len: (a_len) as i64 }) == 0
        match_gap_name(line, col, @count, StrView { ptr: (a), len: (a_len) as i64 })
    if match_arms_name(arms, StrView { ptr: (b), len: (b_len) as i64 }) == 0
        match_gap_name(line, col, @count, StrView { ptr: (b), len: (b_len) as i64 })
    match_gap_end(s, count)

# The enum a `Name$args` instantiation, or a plain name, was declared as.
fn match_enum_index(name_sv: StrView) -> i32
    var name: *u8 = name_sv.ptr
    var len: i32 = name_sv.len as i32
    var base: i32 = 0
    while base < len and *(name + base) != '$'
        base = base + 1
    enum_find(StrView { ptr: (name), len: (base) as i64 })

# --- A bare arm name that binds (AGAST #2407; LANGUAGE_SPEC §4.3, §8.2) -------
#
# A top-level name tests where the scrutinee gives it a meaning: a variant the
# enum declares, or, against a scalar, an integer const (match_arm_is_catch_all
# lowers any other name as a binding).  Anywhere else it binds, and a binding
# can't take a const's, global's or variant's name: binder_check.ritz judges
# every other binder, and ritz0's twin is _refuse_arm_names.
fn match_arm_name_tests(s: *EmitterState, arm: *MatchArm, ei: i32, builtin: i32) -> i32
    if ei >= 0
        return enum_declares_variant(ei, StrView { ptr: (arm.pattern_name), len: (arm.pattern_name_len) as i64 })
    if builtin == MATCH_OPTION
        return (name_eq(StrView { ptr: (arm.pattern_name), len: (arm.pattern_name_len) as i64 }, StrView { ptr: (c"Some"), len: (4) as i64 }) == 1 or name_eq(StrView { ptr: (arm.pattern_name), len: (arm.pattern_name_len) as i64 }, StrView { ptr: (c"None"), len: (4) as i64 }) == 1) as i32
    if builtin == MATCH_RESULT
        return (name_eq(StrView { ptr: (arm.pattern_name), len: (arm.pattern_name_len) as i64 }, StrView { ptr: (c"Ok"), len: (2) as i64 }) == 1 or name_eq(StrView { ptr: (arm.pattern_name), len: (arm.pattern_name_len) as i64 }, StrView { ptr: (c"Err"), len: (3) as i64 }) == 1) as i32
    # On a StrView no name tests (AGAST #1876): an integer const compares only
    # an integer, so there it binds, and binder_report refuses it.
    if s.match_scrut_str == 1
        return 0
    # An integer const, which is_int_const_type takes a bool for: ritz0 compares
    # neither a bool const nor a float one.
    let ce: *ConstEntry = find_const_entry(s, StrView { ptr: (arm.pattern_name), len: (arm.pattern_name_len) as i64 })
    (ce != null and ce.const_type != TypeKind.Bool and is_int_const_type(ce.const_type) == 1) as i32

# How many arms were refused, each said at its name.
fn match_refuse_arm_names(s: *EmitterState, arms: *MatchArm, ei: i32, builtin: i32) -> i32
    var refused: i32 = 0
    var arm: *MatchArm = arms
    while arm != null
        # A qualified `E.V` has no span: it is always a variant.
        if arm.pattern_kind == PAT_IDENT and arm.pattern_span.line > 0 and match_arm_name_tests(s, arm, ei, builtin) == 0
            let kind: i32 = binder_module_value_kind(StrView { ptr: (arm.pattern_name), len: (arm.pattern_name_len) as i64 })
            if kind != BINDER_NONE
                binder_report(fn_source_file(emitter_current_fn()), arm.pattern_span.line, arm.pattern_span.col, StrView { ptr: (arm.pattern_name), len: (arm.pattern_name_len) as i64 }, kind)
                emit_str(s, c"  ; ERROR: a match arm binds a module value's name\n")
                s.error_count = s.error_count + 1
                refused = refused + 1
        arm = arm.next
    refused

# --- An arm naming another enum's variant (AGAST #2431) ----------------------
#
# `Ok(v)` on an Option read `Ok`'s tag off it, silently: tag 0 is Some's.  A
# variant arm, or a qualified `E.V`, must be one the scrutinee's enum declares.
# A bare name that isn't is a binding, and R12 judges it (match_refuse_arm_names).
# ritz0's twin is _require_enum_variant; both name the enum as it was declared,
# since the two mangle `Result<i32, i32>` apart.

# 1 when `arm` names a variant: a payload pattern, or a qualified unit one.
fn match_arm_names_a_variant(arm: *MatchArm) -> i32
    if arm.pattern_kind == PAT_VARIANT
        return 1
    (arm.pattern_kind == PAT_IDENT and arm.pattern_span.line == 0 and arm.head_span.line > 0) as i32

# How many arms named a variant enum `name` doesn't declare, each said at its
# pattern.  `name` is the scrutinee's own, maybe an instantiation (`Option$i64`).
fn match_refuse_foreign_arms(s: *EmitterState, arms: *MatchArm, name_sv: StrView) -> i32
    var name: *u8 = name_sv.ptr
    var len: i32 = name_sv.len as i32
    var base: i32 = 0
    while base < len and *(name + base) != '$'
        base = base + 1
    let ei: i32 = match_enum_index(StrView { ptr: (name), len: (len) as i64 })
    var builtin: i32 = 0
    if ei < 0 and is_tagged_enum_type(StrView { ptr: (name), len: (len) as i64 }) == 1
        builtin = MATCH_RESULT
        if *name == 'O'
            builtin = MATCH_OPTION
    if ei < 0 and builtin == 0
        return 0
    var refused: i32 = 0
    var arm: *MatchArm = arms
    var pat: *MatchArm = arms   # each alternative of an or-pattern too (AGAST #4450)
    while pat != null
        if match_arm_names_a_variant(pat) == 1 and match_arm_name_tests(s, pat, ei, builtin) == 0
            eprints_cstr(fn_source_file(emitter_current_fn()))
            eprint_char(':')
            eprint_i64(pat.head_span.line as i64)
            eprint_char(':')
            eprint_i64(pat.head_span.col as i64)
            eprints_cstr(c": error: Unknown variant ")
            eprint_bytes(StrView { ptr: (pat.pattern_name), len: (pat.pattern_name_len) as i64 })
            eprints_cstr(c" in enum ")
            eprint_bytes(StrView { ptr: (name), len: (base) as i64 })
            eprints_cstr(c"\n")
            emit_str(s, c"  ; ERROR: a match arm names another enum's variant\n")
            s.error_count = s.error_count + 1
            refused = refused + 1
        pat = arm_pattern_next(@arm, pat)
    refused

# --- Or-pattern alternatives (AGAST #4450; LANGUAGE_SPEC §8.2) ----------------
#
# An alternative binds nothing.  `_` takes every value, so it is an arm of its
# own; a payload list (`Some(v)`, even `Some(_)`) is refused whatever it binds;
# a bare name is a test only where match_arm_name_tests says so (a variant of
# this enum, an integer const against an integer), and anywhere else it would
# bind.  Each is said at the alternative, ahead of every other check of the
# arms.  ritz0's twin is _refuse_or_alternatives.

# How many alternatives were refused.
fn match_refuse_or_alternatives(s: *EmitterState, arms: *MatchArm, ei: i32, builtin: i32) -> i32
    var refused: i32 = 0
    var arm: *MatchArm = arms
    while arm != null
        var alt: *MatchArm = arm
        if arm.or_next == null
            alt = null
        while alt != null
            if alt.pattern_kind == PAT_WILDCARD
                match_report_at(s, alt.head_span, c"`_` can't be an alternative of an or-pattern: it matches everything; give it an arm of its own\n", c"  ; ERROR: `_` in an or-pattern\n")
                refused = refused + 1
            else if alt.pattern_kind == PAT_VARIANT
                match_report_at(s, alt.head_span, c"an or-pattern alternative can't have a payload list: give that variant an arm of its own\n", c"  ; ERROR: a payload list in an or-pattern\n")
                refused = refused + 1
            else if alt.pattern_kind == PAT_IDENT and alt.pattern_span.line > 0 and match_arm_name_tests(s, alt, ei, builtin) == 0
                match_report_at(s, alt.head_span, c"an or-pattern can't bind a name: each alternative is a literal, a const or a variant\n", c"  ; ERROR: a binding in an or-pattern\n")
                refused = refused + 1
            alt = alt.or_next
        arm = arm.next
    refused

# --- Field count (AGAST #2408; LANGUAGE_SPEC §8.2) ----------------------------
#
# A variant pattern lists one field per field of its variant: a name on a bare
# variant (`Z(a)`, `None(k)`) would bind nothing, and since AGAST #1295 a list
# (`Rect(w, h)`) must name every field of a tuple or struct variant.  ritz0's
# twin is _require_field_count.

# How many fields variant `name` of the scrutinee has, or -1 if it has none so
# called: that is match_refuse_foreign_arms' error, after coverage.
fn match_variant_field_count(ei: i32, builtin: i32, name_sv: StrView) -> i32
    var name: *u8 = name_sv.ptr
    var len: i32 = name_sv.len as i32
    if ei < 0
        if builtin == MATCH_OPTION and name_eq(StrView { ptr: (name), len: (len) as i64 }, StrView { ptr: (c"None"), len: (4) as i64 }) == 1
            return 0
        return 1
    for vi in 0..enum_variant_count(ei)
        var vlen: i32 = 0
        let vname: *u8 = enum_variant_name(ei, vi, @vlen)
        if name_eq(StrView { ptr: (vname), len: (vlen) as i64 }, StrView { ptr: (name), len: (len) as i64 }) == 1
            let kind: i32 = enum_variant_kind(ei, vi)
            if kind == ENUM_VARIANT_UNIT
                return 0
            # AGAST #1295: a tuple variant has as many as it declares too.
            var n: i32 = 0
            var f: *StructField = enum_variant_fields(ei, vi)
            while f != null
                n = n + 1
                f = f.next
            return n
    0 - 1

# How many arms list a field count their variant doesn't have, each said at its
# pattern, naming both counts.
fn match_refuse_field_counts(s: *EmitterState, arms: *MatchArm, ei: i32, builtin: i32) -> i32
    if ei < 0 and builtin == 0
        return 0
    var refused: i32 = 0
    var arm: *MatchArm = arms
    while arm != null
        if arm.pattern_kind == PAT_VARIANT
            let has: i32 = match_variant_field_count(ei, builtin, StrView { ptr: (arm.pattern_name), len: (arm.pattern_name_len) as i64 })
            let lists: i32 = arm_bind_count(arm)   # AGAST #1295
            if has >= 0 and has != lists
                eprints_cstr(fn_source_file(emitter_current_fn()))
                eprint_char(':')
                eprint_i64(arm.head_span.line as i64)
                eprint_char(':')
                eprint_i64(arm.head_span.col as i64)
                eprints_cstr(c": error: variant '")
                eprint_bytes(StrView { ptr: (arm.pattern_name), len: (arm.pattern_name_len) as i64 })
                eprints_cstr(c"' has ")
                eprint_i64(has as i64)
                if has == 1
                    eprints_cstr(c" field, but this pattern lists ")
                else
                    eprints_cstr(c" fields, but this pattern lists ")
                eprint_i64(lists as i64)
                eprints_cstr(c"\n")
                emit_str(s, c"  ; ERROR: a variant pattern lists a field count its variant doesn't have\n")
                s.error_count = s.error_count + 1
                refused = refused + 1
        arm = arm.next
    refused

# --- Reachability (LARB R13, AGAST #2349; LANGUAGE_SPEC §8.1) ----------------
#
# Arms are tried top to bottom and the first that matches wins, so an arm no
# value can reach is an error at its pattern, naming the arm that covers it: an
# earlier arm testing the same literal, const value or variant, or, once the
# arms so far leave no gap under R6, the arm that closed it.  ritz0's twin is
# unreachable_arm in ritz0/match_coverage.py.  No arm has a guard (#1939).

# 1 when `a` and `b` test the same thing.  `ei`/`builtin` say the scrutinee is
# an enum; otherwise a literal and an integer const compare by value (§8.2).
fn match_arms_test_same(s: *EmitterState, a: *MatchArm, b: *MatchArm, ei: i32, builtin: i32) -> i32
    if ei >= 0 or builtin != 0
        if match_arm_is_variant(s, a, ei, builtin) == 0 or match_arm_is_variant(s, b, ei, builtin) == 0
            return 0
        return name_eq(StrView { ptr: (a.pattern_name), len: (a.pattern_name_len) as i64 }, StrView { ptr: (b.pattern_name), len: (b.pattern_name_len) as i64 })
    if a.pattern_kind == PAT_BOOL or b.pattern_kind == PAT_BOOL
        return (a.pattern_kind == b.pattern_kind and a.pattern_int == b.pattern_int) as i32
    if a.pattern_kind == PAT_STR or b.pattern_kind == PAT_STR   # AGAST #1876
        return (a.pattern_kind == b.pattern_kind and name_eq(StrView { ptr: (a.pattern_name), len: (a.pattern_name_len) as i64 }, StrView { ptr: (b.pattern_name), len: (b.pattern_name_len) as i64 }) == 1) as i32
    var va: i64 = 0
    var vb: i64 = 0
    if match_arm_int_value(s, a, @va) == 0 or match_arm_int_value(s, b, @vb) == 0
        return 0
    (va == vb) as i32

# 1 when `arm` names a variant of the scrutinee's enum, whatever it binds.
fn match_arm_is_variant(s: *EmitterState, arm: *MatchArm, ei: i32, builtin: i32) -> i32
    if arm.pattern_kind != PAT_IDENT and arm.pattern_kind != PAT_VARIANT
        return 0
    match_arm_name_tests(s, arm, ei, builtin)

# The integer a literal or an integer-const arm tests, into `out`; 0 for any other.
fn match_arm_int_value(s: *EmitterState, arm: *MatchArm, out: *i64) -> i32
    # A char pattern is an integer literal pattern (LARB R72, #4196): `'('`
    # and `40` are the same test, so one after the other is unreachable.
    if arm.pattern_kind == PAT_INT_LIT or arm.pattern_kind == PAT_CHAR
        *out = arm.pattern_int
        return 1
    if arm.pattern_kind == PAT_IDENT and match_arm_is_catch_all(s, arm) == 0
        let ce: *ConstEntry = find_const_entry(s, StrView { ptr: (arm.pattern_name), len: (arm.pattern_name_len) as i64 })
        *out = ce.value
        return 1
    0

# `file:line:col: error: <what>` at `at`, one error counted (AGAST #1876).
fn match_report_at(s: *EmitterState, at: SrcSpan, what: *u8, ir_note: *u8)
    eprints_cstr(fn_source_file(emitter_current_fn()))
    eprint_char(':')
    eprint_i64(at.line as i64)
    eprint_char(':')
    eprint_i64(at.col as i64)
    eprints_cstr(c": error: ")
    eprints_cstr(what)
    emit_str(s, ir_note)
    s.error_count = s.error_count + 1

fn match_report_unreachable(s: *EmitterState, arm: *MatchArm, cover: *MatchArm)
    eprints_cstr(fn_source_file(emitter_current_fn()))
    eprint_char(':')
    eprint_i64(arm.head_span.line as i64)
    eprint_char(':')
    eprint_i64(arm.head_span.col as i64)
    eprints_cstr(c": error: unreachable match arm: the arm at line ")
    eprint_i64(cover.head_span.line as i64)
    eprints_cstr(c" covers it\n")
    emit_str(s, c"  ; ERROR: unreachable match arm\n")
    s.error_count = s.error_count + 1

# 1 when an arm was refused.  Asked once the arms cover the scrutinee (R6).
fn match_check_reachable(s: *EmitterState, arms: *MatchArm, ei: i32, builtin: i32, is_bool: i32) -> i32
    # How many distinct values or variants close the match without a catch-all:
    # an integer never closes.
    var total: i32 = 0
    if ei >= 0
        total = enum_variant_count(ei)
    else if builtin != 0
        total = 2
    else if is_bool == 1
        total = 2
    let is_enum: i32 = (ei >= 0 or builtin != 0) as i32
    var seen: i32 = 0
    var closer: *MatchArm = null
    var arm: *MatchArm = arms
    while arm != null
        # A repeat names the arm it repeats, even once all is covered.  Each
        # alternative of an or-pattern is one, whether the arm with it
        # already is an earlier one or this one, said at the alternative
        # (AGAST #4450).
        var alt: *MatchArm = arm
        while alt != null
            var prev_arm: *MatchArm = arms
            var prev: *MatchArm = arms
            while prev != alt
                if match_arms_test_same(s, prev, alt, ei, builtin) == 1
                    match_report_unreachable(s, alt, prev_arm)
                    return 1
                prev = arm_pattern_next(@prev_arm, prev)
            alt = alt.or_next
        if closer != null
            match_report_unreachable(s, arm, closer)
            return 1
        var catch_all: i32 = 0
        var counts: i32 = 0
        if is_enum == 1
            catch_all = (arm.pattern_kind == PAT_WILDCARD or (arm.pattern_kind == PAT_IDENT and match_arm_is_variant(s, arm, ei, builtin) == 0)) as i32
        else
            catch_all = match_arm_is_catch_all(s, arm)
        # Every alternative counts once: a repeat was refused above.
        alt = arm
        while alt != null
            if is_enum == 1
                counts = counts + match_arm_is_variant(s, alt, ei, builtin)
            else
                counts = counts + (is_bool == 1 and alt.pattern_kind == PAT_BOOL) as i32
            alt = alt.or_next
        seen = seen + counts
        if catch_all == 1 or (total > 0 and seen == total)
            closer = arm
        arm = arm.next
    0

fn match_check_coverage(s: *EmitterState, scrutinee: *Expr, arms: *MatchArm, enum_name_sv: StrView, from_arms: i32, line: i32, col: i32)
    var enum_name: *u8 = enum_name_sv.ptr
    var enum_name_len: i32 = enum_name_sv.len as i32
    var name: *u8 = enum_name
    var len: i32 = enum_name_len
    if name == null
        match_scrutinee_type(s, scrutinee, @name, @len)
    var ei: i32 = 0 - 1
    if name != null
        ei = match_enum_index(StrView { ptr: (name), len: (len) as i64 })
    # AGAST #2512: an Option / Result scrutinee is judged as one.  Asked which
    # enum its arms name, `Ok(v)` beside a user `enum E { Ok(i32), Bad }` said
    # E, and the match was "non-exhaustive: missing Bad".
    let named_builtin: bool = name != null and is_tagged_enum_type(StrView { ptr: (name), len: (len) as i64 }) == 1
    # AGAST #1876: a StrView is no enum, whatever its arms name.
    let is_str: bool = s.match_scrut_str == 1
    if ei < 0 and not named_builtin and not is_str
        ei = match_arms_enum(s, scrutinee, arms)
    var builtin: i32 = 0
    if ei < 0 and not is_str
        if name != null and is_tagged_enum_type(StrView { ptr: (name), len: (len) as i64 }) == 1
            builtin = MATCH_RESULT
            if *name == 'O'
                builtin = MATCH_OPTION
        else if match_scrutinee_is_scalar(s, scrutinee) == 0
            builtin = match_arms_builtin(arms)
    var is_bool: i32 = 0
    if ei < 0 and builtin == 0
        is_bool = interp_is_bool(s, scrutinee)
    # AGAST #4450: an or-pattern's alternatives bind nothing, ahead of every
    # other check of the arms, as on ritz0.
    if match_refuse_or_alternatives(s, arms, ei, builtin) > 0
        return
    # AGAST #2407: a name that binds can't take a module value's name, and
    # that error comes before the coverage one, as on ritz0.
    if match_refuse_arm_names(s, arms, ei, builtin) > 0
        return
    # AGAST #2408: a pattern's fields are its variant's, ahead of coverage.
    if match_refuse_field_counts(s, arms, ei, builtin) > 0
        return
    # AGAST #2409: on a scalar no enum is in play, so a variant pattern (`Some(v)`,
    # `R(v)`, a qualified `C.G`, which is the one PAT_IDENT with no
    # pattern_span) tests nothing: `R(v)` took every value, as ritz0 dropped it.
    let scalar: bool = ei < 0 and builtin == 0 and (is_str or match_scrutinee_is_scalar(s, scrutinee) == 1)
    # Each alternative of an or-pattern is judged as an arm's pattern is (AGAST #4450).
    var arm: *MatchArm = arms
    var pat: *MatchArm = arms
    while pat != null
        let qualified: bool = pat.pattern_kind == PAT_IDENT and pat.pattern_span.line == 0
        # `mod.CONST =>` (angelo's `instructions.POP`, #2409) is module access,
        # refused at the arm (§15.3, AGAST #2215); the bare `CONST =>` compares.
        if qualified and pat.qualifier != null
            if is_module_item(s, pat.qualifier, pat.qualifier_len, pat.pattern_name, pat.pattern_name_len) == 1
                emit_module_item_error(s, pat.qualifier, pat.qualifier_len, pat.pattern_name, pat.pattern_name_len, pat.head_span.line, pat.head_span.col)
                return
        if scalar and (pat.pattern_kind == PAT_VARIANT or qualified)
            eprints_cstr(fn_source_file(emitter_current_fn()))
            eprint_char(':')
            eprint_i64(pat.head_span.line as i64)
            eprint_char(':')
            eprint_i64(pat.head_span.col as i64)
            eprints_cstr(c": error: a variant pattern needs an enum scrutinee\n")
            emit_str(s, c"  ; ERROR: variant pattern on a non-enum scrutinee\n")
            s.error_count = s.error_count + 1
            return
        # LARB R72 (#4196): a char literal is u8 (§2.6), so only a u8
        # scrutinee takes its pattern.  A wider integer, bool, StrView or
        # enum is an error at the pattern.  `s.match_scrut_int` is the
        # scrutinee's integer kind, or not TypeKind.U8 for every other type.
        if pat.pattern_kind == PAT_CHAR and s.match_scrut_int != TypeKind.U8
            match_report_at(s, pat.head_span, c"a character pattern needs a u8 scrutinee\n", c"  ; ERROR: character pattern on a non-u8 scrutinee\n")
            return
        # AGAST #3002: a literal compares an integer, so on an enum (`5 =>` on a
        # `C` or an Option) it compared the `%C` aggregate to an i64.
        # AGAST #1876: a string arm compares a StrView, and a StrView only that.
        if pat.pattern_kind == PAT_STR and not is_str
            match_report_at(s, pat.head_span, c"a string pattern needs a StrView scrutinee\n", c"  ; ERROR: string pattern on a non-StrView scrutinee\n")
            return
        if pat.pattern_kind == PAT_INT_LIT and is_str
            match_report_at(s, pat.head_span, c"a literal pattern needs an integer scrutinee\n", c"  ; ERROR: literal pattern on a StrView scrutinee\n")
            return
        if pat.pattern_kind == PAT_INT_LIT and ei >= 0
            eprints_cstr(fn_source_file(emitter_current_fn()))
            eprint_char(':')
            eprint_i64(pat.head_span.line as i64)
            eprint_char(':')
            eprint_i64(pat.head_span.col as i64)
            eprints_cstr(c": error: a literal pattern needs an integer scrutinee\n")
            emit_str(s, c"  ; ERROR: literal pattern on an enum scrutinee\n")
            s.error_count = s.error_count + 1
            return
        if pat.pattern_kind == PAT_BOOL and is_bool == 0
            eprints_cstr(fn_source_file(emitter_current_fn()))
            eprint_char(':')
            eprint_i64(pat.bool_span.line as i64)
            eprint_char(':')
            eprint_i64(pat.bool_span.col as i64)
            eprints_cstr(c": error: a `true` or `false` pattern needs a bool scrutinee\n")
            emit_str(s, c"  ; ERROR: bool pattern on a non-bool scrutinee\n")
            s.error_count = s.error_count + 1
            return
        pat = arm_pattern_next(@arm, pat)
    let errors_before: i32 = s.error_count
    if ei >= 0
        match_check_enum(s, arms, ei, line, col)
    else if builtin == MATCH_OPTION
        match_check_pair(s, arms, StrView { ptr: (c"Some"), len: (4) as i64 }, StrView { ptr: (c"None"), len: (4) as i64 }, line, col)
    else if builtin == MATCH_RESULT
        match_check_pair(s, arms, StrView { ptr: (c"Ok"), len: (2) as i64 }, StrView { ptr: (c"Err"), len: (3) as i64 }, line, col)
    else if is_bool == 1
        match_check_bool(s, arms, line, col)
    else
        match_check_scalar(s, arms, line, col)
    # AGAST #2431: after coverage, as on ritz0, and only against the enum the
    # scrutinee has: one an arm named is no judge of the arms.
    if from_arms == 0 and name != null
        match_refuse_foreign_arms(s, arms, StrView { ptr: (name), len: (len) as i64 })
    # AGAST #2349: then every arm must be reachable, as on ritz0.  A foreign
    # arm is that error, not an unreachable one, so this comes after it.
    if s.error_count == errors_before
        match_check_reachable(s, arms, ei, builtin, is_bool)

# AGAST #2140: 1 when the scrutinee is a borrow, `@place` / `@&place`.
fn match_scrutinee_is_addr(scr: *Expr) -> i32
    if scr.kind == ExprKind.Unary and (scr.op == OpKind.Addr or scr.op == OpKind.AddrMut) and scr.operand != null
        return 1
    0

# The `%E` value in a place-scrutinee's slot, for arms that use the register.
fn emit_match_place_load(s: *EmitterState, slot: i32, enum_name_sv: StrView) -> i32
    var enum_name: *u8 = enum_name_sv.ptr
    var enum_name_len: i32 = enum_name_sv.len as i32
    let reg: i32 = next_reg(s)
    emit_str(s, IR_INDENT)
    emit_reg(s, reg)
    emit_str(s, IR_LOAD_NAMED)
    emit_name(s, StrView { ptr: (enum_name), len: (enum_name_len) as i64 })
    emit_str(s, IR_PTR_SEP)
    emit_reg(s, slot)
    emit_str(s, c"  ; match @place\n")
    reg

# AGAST #4586: end the block no arm took.  A match on a repr enum
# (`enum E: <int>`, LANGUAGE_SPEC §10.1) with no `_` / binding arm reaches it
# when the stored value names no variant: that traps.  Anything else is
# `unreachable`: coverage rules a miss out, and an untyped enum's index tag
# names no variant only through memory corruption.
fn emit_match_no_arm(s: *EmitterState, arms: *MatchArm, enum_name_sv: StrView, is_enum: i32, scrut_slot: i32, span: SrcSpan)
    if is_enum == 1 and scrut_slot != 0 and match_traps_no_variant(s, arms, enum_name_sv) == 1
        emit_match_no_variant_trap(s, enum_name_sv, scrut_slot, span.line, span.col)
    emit_str(s, c"  unreachable\n")

fn match_traps_no_variant(s: *EmitterState, arms: *MatchArm, enum_name_sv: StrView) -> i32
    if enum_name_sv.ptr == null
        return 0
    let ei: i32 = user_enum_index(enum_name_sv)
    if ei < 0 or ty_int_bits(enum_repr(ei)) == 0
        return 0
    var arm: *MatchArm = arms
    while arm != null
        if arm.pattern_kind == PAT_WILDCARD
            return 0
        if arm.pattern_kind == PAT_IDENT and match_arm_is_variant(s, arm, ei, 0) == 0
            return 0
        arm = arm.next
    1

# Main entry: emit a match construct. Returns the phi register holding
# the match's result value (or 0 if no arms contribute).
pub fn emit_match(s: *EmitterState, scrutinee: *Expr, arms: *MatchArm, span: SrcSpan) -> i32
    emit_match_into(s, scrutinee, arms, span, null)

# AGAST #3276: a `match` whose value is a whole `[N]T` (a `-> [N]T` tail,
# `let r = match ...`, `*p = match ...`): with `into` set, each arm stores its
# own array there and the arms join with no phi (0 is returned), as #2305 does
# for `if`.  The dispatch is the usual one: the same scrutinee spill, pattern
# tests, payload bindings, coverage and move checks.  Before this the arms'
# i64s met in a phi: a refusal, or 8 bytes of the array.
pub fn emit_match_into(s: *EmitterState, scrutinee: *Expr, arms: *MatchArm, span: SrcSpan, into: *ArrayInto) -> i32
    # AGAST #2342: a catch-all name binds the scrutinee, so it is the same kind.
    let outer_kind: i32 = s.match_scrut_kind
    s.match_scrut_kind = bool_kind(s, scrutinee)
    # AGAST #3358: ... and the same integer type.
    let outer_int: TypeKind = s.match_scrut_int
    s.match_scrut_int = narrow_known(narrow_src_type(s, scrutinee))
    # AGAST #1876: ... and whether string arms compare it.
    let outer_str: i32 = s.match_scrut_str
    s.match_scrut_str = match_scrutinee_is_strview(s, scrutinee)
    let result: i32 = emit_match_arms(s, scrutinee, arms, span, into)
    s.match_scrut_kind = outer_kind
    s.match_scrut_int = outer_int
    s.match_scrut_str = outer_str
    result

fn emit_match_arms(s: *EmitterState, scrutinee: *Expr, arms: *MatchArm, span: SrcSpan, into: *ArrayInto) -> i32
    let wants_value: i32 = take_match_wants_value(s)   # AGAST #2046
    let discarded: i32 = take_match_discarded()   # AGAST #3028
    # AGAST #1946 / #2092: taken before the scrutinee, so a match there
    # can't see it.
    let float_hint: TypeKind = take_match_float_hint(s)
    # AGAST #3205: taken before the scrutinee, so a match there can't see it.
    let agg_hint: *u8 = s.match_agg_hint
    let agg_hint_len: i32 = s.match_agg_hint_len
    s.match_agg_hint = null
    s.match_agg_hint_len = 0
    # Detect whether the scrutinee is a tagged-enum struct; if so, spill
    # it into an alloca once so every arm can GEP the same pointer.
    var enum_name: *u8 = null
    var enum_name_len: i32 = 0
    # AGAST #2140: `match @place` (angelo's `match @self.cmap`) matches the
    # enum the pointer addresses.  resolve_scrutinee_enum stays strict about
    # `@` (emit_enum_to_int shares it, and `(@e) as T` is a pointer cast), so
    # the borrow is unwrapped here: the pointer is the spill slot, and the
    # value is loaded from it for arms that use the scrutinee register.
    # Without this `@o` was a scalar: `Some(x)` compared the ADDRESS to 0.
    let is_addr: i32 = match_scrutinee_is_addr(scrutinee)
    var is_enum: i32 = 0
    var typed: *Expr = scrutinee
    if is_addr == 1
        typed = scrutinee.operand
    let resolved: i32 = resolve_match_enum(s, typed, arms, @enum_name, @enum_name_len)
    is_enum = (resolved != 0) as i32
    # AGAST #2419: never the zero a constructor with no enum lowers to.
    if is_enum == 0 and is_tagged_ctor(s, typed) == 1
        emit_ctor_type_error(s, typed)
        return 0
    if is_enum == 0 and typed == g_gctor_refused   # AGAST #2437, reported
        return 0
    # AGAST #2503: no guess between two enums that declare an arm's name.
    if is_enum == 0 and match_refuse_ambiguous_arms(s, typed, arms) == 1
        return 0
    match_check_coverage(s, typed, arms, StrView { ptr: (enum_name), len: (enum_name_len) as i64 }, (resolved == MATCH_ENUM_FROM_ARMS) as i32, span.line, span.col)
    # AGAST #2344: an enum element or global is a place too.  emit_expr reads
    # `a[1]` and `g` as scalars, whatever their type.
    var from_place: i32 = is_addr
    var is_ctor: i32 = 0
    if is_enum == 1
        is_ctor = match_scrutinee_is_ctor(s, typed)   # AGAST #2419
        if is_ctor == 1
            from_place = 0
        else if typed.kind == ExprKind.Index or (typed.kind == ExprKind.Ident and find_local_struct_name(s, StrView { ptr: (typed.ident_ptr), len: (typed.ident_len) as i64 }) == null)
            from_place = 1
    # AGAST #2289: an `e:& E` param reads as the borrow's pointer, so it is a
    # place as `@place` is: that pointer is the slot.  Spilled as a `%E` it
    # was a `ptr` clang refused.
    var lent: bool = false
    if is_enum == 1 and is_ctor == 0 and lent_referent_local(s, typed) != null
        lent = true

    # Evaluate scrutinee.  For `@place` the place's own address (a `ptr`;
    # `@expr` as a value is a ptrtoint'd i64) is the slot.
    var scrut_reg: i32 = 0
    var scrut_slot: i32 = 0
    if lent
        from_place = 1
        scrut_slot = emit_expr(s, typed)
        scrut_reg = emit_match_place_load(s, scrut_slot, StrView { ptr: (enum_name), len: (enum_name_len) as i64 })
    else if is_enum == 1 and from_place == 1
        scrut_slot = emit_lvalue_ptr(s, typed)
        if scrut_slot < 0
            emit_ir_error(s, scrutinee.span, c"cannot take address of match scrutinee")
            return 0
        scrut_reg = emit_match_place_load(s, scrut_slot, StrView { ptr: (enum_name), len: (enum_name_len) as i64 })
    else if is_ctor == 1
        scrut_reg = emit_ctor_scrutinee(s, typed, StrView { ptr: (enum_name), len: (enum_name_len) as i64 })
    else
        scrut_reg = emit_expr(s, scrutinee)
    if is_enum == 1 and from_place == 0
        scrut_slot = next_reg(s)
        entry_alloca_reg_begin_named(s, scrut_slot)
        emit_name(s, StrView { ptr: (enum_name), len: (enum_name_len) as i64 })
        emit_str(s, c"  ; match scrut spill\n")
        entry_alloca_reg_end(s)
        emit_struct_store_or_copy(s, TypeKind.Struct, StrView { ptr: (enum_name), len: (enum_name_len) as i64 }, scrut_reg, scrut_slot)

    # AGAST #2174: the match owns a scrutinee it moved (ownership.ritz);
    # `match @place` moves nothing.
    var owned: *Expr = scrutinee
    if is_ctor == 1
        owned = typed   # `@Some(x)` borrows a value only this match holds
    let own_old: i32 = own_match_begin(s, owned, scrut_slot, StrView { ptr: (enum_name), len: (enum_name_len) as i64 })

    let end_label: i32 = next_label(s)
    var n_arms: i32 = 0
    var counted: *MatchArm = arms
    while counted != null
        n_arms = n_arms + 1
        counted = counted.next
    var result: MatchResult
    match_result_init(@result, n_arms)
    result.float_ty = float_hint   # AGAST #1946
    result.hint_ty = float_hint   # AGAST #2092
    result.ptr_ty = arms_ptr_valued(s, arms)   # AGAST #2950
    result.into = into   # AGAST #3276
    result.discarded = discarded   # AGAST #3028

    var arm: *MatchArm = arms
    var idx: i32 = 0
    while arm != null
        emit_match_arm(s, arm, scrut_reg, scrut_slot, StrView { ptr: (enum_name), len: (enum_name_len) as i64 }, @result, idx, end_label)
        arm = arm.next
        idx = idx + 1

    if into != null
        # AGAST #3276: every arm stored its array; nothing to merge.  No arm
        # type leaks to an enclosing untyped `let` (it is the `[N]T` local).
        s.last_match_agg_name = null
        s.last_match_agg_name_len = 0
        s.last_match_float_ty = TypeKind.Void
        emit_match_no_arm(s, arms, StrView { ptr: (enum_name), len: (enum_name_len) as i64 }, is_enum, scrut_slot, span)
        begin_block(s, end_label)
        own_match_end(s, own_old)
        return 0

    # Current block is the last "next" block: no arm matched.  Coverage has
    # ruled out a variant with no arm (AGAST #2344), so it ends in
    # `unreachable`, or in a trap when a repr enum's value names no variant
    # (emit_match_no_arm, AGAST #4586).
    # AGAST #1666: publish the phi type for an untyped `let v = match ...`.
    # Set after every arm (nested matches inside arms included) so the
    # outermost match's type is what the enclosing let sees.
    # AGAST #3205: no arm yielded a value (each `return`s), so nothing typed
    # the phi; as a `-> S` fn's tail it is an S of zeros, which no path
    # reaches, not the i64 the implicit `ret %S` would name.
    if result.agg_name == null and result.ptr_ty == 0 and result.float_ty == TypeKind.Void and result.int_arms == 0 and agg_hint_len > 0
        result.agg_name = agg_hint
        result.agg_name_len = agg_hint_len
    publish_match_type(s, @result)
    if result.void_arms > 0
        # AGAST #1654: an arm yields no value (a void call), so the match is
        # a statement: join at match.end with no phi and no value (register
        # 0, as for a void call).  A struct/float type an earlier arm fixed
        # must not leak to an untyped `let` either.
        s.last_match_agg_name = null
        s.last_match_agg_name_len = 0
        s.last_match_float_ty = TypeKind.Void
        match_void_arms_settle(s, @result, wants_value)   # AGAST #2046
        emit_match_no_arm(s, arms, StrView { ptr: (enum_name), len: (enum_name_len) as i64 }, is_enum, scrut_slot, span)
        begin_block(s, end_label)
        own_match_end(s, own_old)
        return 0
    emit_match_no_arm(s, arms, StrView { ptr: (enum_name), len: (enum_name_len) as i64 }, is_enum, scrut_slot, span)

    # End block with phi over all arm results: ( arm_result, arm_exit_label ).
    begin_block(s, end_label)

    if result.count == 0
        # No arm phi: the match's value is this register itself.
        let no_arm_reg: i32 = next_reg(s)
        emit_str(s, IR_INDENT)
        emit_reg(s, no_arm_reg)
        emit_str(s, c" = add i64 0, 0  ; match: no arm yields a value\n")
        own_match_end(s, own_old)
        return no_arm_reg

    let slot_reg: i32 = match_merge_slot(s, @result)   # AGAST #3696
    if slot_reg != 0
        own_match_end(s, own_old)
        return slot_reg
    let phi_reg: i32 = next_reg(s)
    emit_str(s, IR_INDENT)
    emit_reg(s, phi_reg)
    emit_str(s, c" = phi ")
    emit_match_phi_type(s, @result)
    emit_str(s, IR_SP)
    var i: i32 = 0
    while i < result.count
        if i > 0
            emit_str(s, IR_COMMA)
        emit_str(s, c"[ ")
        emit_match_phi_value(s, @result, result.values[i])
        emit_str(s, c", %")
        emit_label(s, result.labels[i])
        emit_str(s, c" ]")
        i = i + 1
    emit_str(s, IR_NL)
    own_match_end(s, own_old)
    return phi_reg

# AGAST #1613: does an if-expression arm end by leaving the block (`return`,
# `break`, `continue`)?  Such an arm reaches the merge only through the
# unreachable block emit_match_arm_stmts opens after it, so its lack of a
# value is harmless; Sema refuses any other valueless arm (if_arm_value.ritz).
fn if_arm_diverges(arm: *MatchArm) -> i32
    var last: *Stmt = arm.body_stmts
    if last == null
        return 0
    while last.next != null
        last = last.next
    if last.kind == StmtKind.Return or last.kind == StmtKind.Break or last.kind == StmtKind.Continue
        return 1
    0

# Emit an if/else expression (AGAST #1613): `left` is the condition, `args`
# the then-arm and its `next` the else-arm (see expr_if).  Lowered like a
# two-arm match with no fallthrough: each arm goes through
# emit_match_arm_body, which emits its block statements, its value and the
# `br` to the merge, and types a struct-valued arm (#1645) so the phi is
# `%StrView` / `%Point` rather than i64.  Returns the phi register.
pub fn emit_if_expr(s: *EmitterState, e: *Expr) -> i32
    let wants_value: i32 = take_match_wants_value(s)   # AGAST #2046
    # AGAST #1946 / #2092: taken before the condition, so a match there
    # can't see it.
    let float_hint: TypeKind = take_match_float_hint(s)
    let then_arm: *MatchArm = e.args as *MatchArm
    let else_arm: *MatchArm = then_arm.next
    # Sema refused a valueless arm (if_arm_value.ritz, AGAST #3512).

    # Narrowed to i1 for the `br`, as StmtKind.If does (AGAST #1367, #1646).
    let cond: i32 = emit_expr(s, e.left)
    let cond_i1: i32 = next_reg(s)
    emit_str(s, IR_INDENT)
    emit_reg(s, cond_i1)
    emit_str(s, c" = icmp ne i64 ")
    emit_reg(s, cond)
    emit_str(s, IR_COMMA_0)

    let then_label: i32 = next_label(s)
    let else_label: i32 = next_label(s)
    let end_label: i32 = next_label(s)
    emit_str(s, c"  br i1 ")
    emit_reg(s, cond_i1)
    emit_str(s, IR_LABEL_SEP)
    emit_label(s, then_label)
    emit_str(s, IR_LABEL_SEP)
    emit_label(s, else_label)
    emit_str(s, IR_NL)

    var result: MatchResult
    match_result_init(@result, 2)
    result.float_ty = float_hint   # AGAST #1946
    result.hint_ty = float_hint   # AGAST #2092
    result.ptr_ty = arms_ptr_valued(s, then_arm)   # AGAST #2950
    begin_block(s, then_label)
    emit_match_arm_body(s, then_arm, 0, 0, StrView { ptr: (null), len: (0) as i64 }, @result, 0, end_label)
    begin_block(s, else_label)
    emit_match_arm_body(s, else_arm, 0, 0, StrView { ptr: (null), len: (0) as i64 }, @result, 1, end_label)
    begin_block(s, end_label)

    if result.void_arms > 0
        # AGAST #2046: an arm is a void call, so the if has no value: no phi
        # (as emit_match, #1654), and an error if the value is wanted.
        s.last_match_agg_name = null
        s.last_match_agg_name_len = 0
        s.last_match_float_ty = TypeKind.Void
        match_void_arms_settle(s, @result, wants_value)
        return 0

    # Publish the phi type for an untyped `let v = if ...` (#1666's path);
    # set after both arms so a nested if/match inside an arm can't clobber it.
    publish_match_type(s, @result)

    let slot_reg: i32 = match_merge_slot(s, @result)   # AGAST #3696
    if slot_reg != 0
        return slot_reg

    let phi_reg: i32 = next_reg(s)
    emit_str(s, IR_INDENT)
    emit_reg(s, phi_reg)
    emit_str(s, c" = phi ")
    emit_match_phi_type(s, @result)
    var i: i32 = 0
    while i < 2
        if i > 0
            emit_str(s, c",")
        emit_str(s, c" [ ")
        emit_match_phi_value(s, @result, result.values[i])
        emit_str(s, c", %")
        emit_label(s, result.labels[i])
        emit_str(s, c" ]")
        i = i + 1
    emit_str(s, IR_NL)
    return phi_reg
