# ritz1/src/emitter_match.ritz - Match expression/statement lowering
#
# Added in ritz-task-87. Lowers `match scrutinee \n PATTERN => BODY ...`
# to a linear if-else-if chain in LLVM IR.
#
# Design notes:
# - Scrutinee is evaluated once into a register (i64).
# - Each arm emits:
#     match_test:  icmp eq i64 %scrut, <literal>   (or tag comparison for variants)
#                  br i1 %cond, label %match_body_N, label %match_next_N
#     match_body_N:
#                  ... arm body emitted ...
#                  br label %match_end
#     match_next_N: (next arm's test, or `unreachable` after the last)
# - Wildcard/ident arms unconditionally branch to their body (effectively
#   the catch-all / default). Once we emit an unconditional arm, later
#   arms become dead code (emitted but unreachable).
# - match_check_coverage refuses a match that misses (LARB R6, AGAST #2344), so
#   the block after the last arm is `unreachable`.
# - `pass` arms emit a zero value for their body result.
# - Match result is collected via phi over (arm_body_result, arm_exit_label)
#   pairs so `let x = match ...` works.  The phi is i64 unless an arm yields
#   a known struct (`Some(v) => v` over Option<StrView>), in which case it is
#   that struct type (AGAST #1645).  Arms yielding the layout-equivalent
#   Span$u8/StrView pair are rebuilt to the phi's type in their own block, and
#   a `"..."` arm counts as StrView (AGAST #1662).
# - A match with an arm that calls a void fn (`Some(e) => say(e)`) has no
#   value: no phi, and emit_match returns 0 like a void call (AGAST #1654).
#   `return` / `break` / `continue` arms leave through their own terminator
#   and feed the phi a zero from the unreachable block opened after it.
#
# Variant patterns (Some(v) / None / Ok(v) / Err(_)) use a tag convention:
#   Some(x) / Ok(x) -> high 16 bits = 1, low 48 bits = x
#   None / Err(x)   -> high 16 bits = 0
# Encoded via simple bitwise ops so we don't need an enum-type system yet.
# See emit_variant_constructor_call in emitter_expr_call.ritz for the
# producer side of this convention.

import ritzlib.sys
import ritzlib.io
import ritzlib.str
import ritzlib.gvec
import ritzlib.memory

import ast
import ast_helpers
import tokens_gen
import emitter_core
import let_check           # let_check_expr (AGAST #2028)
import emitter_expr
import emitter_expr_call     # is_variant_carrier, is_variant_null, resolve_enum_ctx
import emitter_expr_access   # is_ident_none
import emitter_print         # interp_is_bool (AGAST #2344)
import emitter_stmt          # emit_stmt, for block-bodied arms (AGAST #1454)
import enum_as_int          # enum_as_int_expr (AGAST #2136)
import ownership            # arm scopes for drops (AGAST #2158)
import bool_check   # AGAST #2342

# Phi result tracking during emit_match.
# We need to collect (value_reg, exit_label) pairs across all non-pass arms
# so we can emit a terminating phi at the match.end label.
# Sized to the arm count by match_result_init (AGAST #1813): fixed [64]
# arrays silently dropped the phi incoming edges of arms past the 64th.
struct MatchResult
    values: *i32   # register numbers holding each arm's result
    labels: *i32   # exit label numbers for each arm's result
    count: i32
    # AGAST #1645: LLVM struct type the arms yield (`%StrView`, `%Point`),
    # or null when they yield the usual i64 scalar.  The merge phi is emitted
    # at this type.
    agg_name: *u8
    agg_name_len: i32
    # AGAST #1946: TYPE_F32 / TYPE_F64 when the arms yield a float, else 0.
    # Fixed by the enclosing let / return's hint (match_float_hint) or by
    # the first float-valued arm; later arms are coerced to it.
    float_ty: i32
    # Arms recorded as i64 values before float_ty was fixed: they cannot be
    # coerced after the fact (their `br` is already emitted).
    int_arms: i32
    # AGAST #1654: arms whose body expression produced no value (a call to a
    # void fn: emit_expr returns register 0, which is never defined).  Any
    # such arm makes the match valueless: emit_match emits no phi.
    void_arms: i32
    # AGAST #2046: where the first valueless arm is (its innermost void
    # call), for the error when the match's value is wanted.
    void_line: i32
    void_col: i32

# AGAST #1946: a `values[]` entry for an arm with no value (`pass`, or a body
# with no trailing expression): the phi gets the zero constant of its type
# instead of an `add i64 0, 0` register, which mismatched a float or struct
# phi.
const MATCH_ZERO_VALUE: i32 = -1

# Check if a variant name denotes the "Some/Ok" (tagged) side of its enum.
# Returns 1 if tag should be 1, 0 otherwise.
# Heuristic: names "Some", "Ok" are the carrier variants; "None", "Err"
# are the null variants. Any other variant currently defaults to tag 0
# (which makes arbitrary enum matching equivalent to "match anything").
fn variant_is_tag_one(name: *u8, len: i32) -> i32
    if len == 4
        # "Some"
        if *name == 83 and *(name + 1) == 111 and *(name + 2) == 109 and *(name + 3) == 101
            return 1
    if len == 2
        # "Ok"
        if *name == 79 and *(name + 1) == 107
            return 1
    return 0

# Emit a check for the scrutinee being of a given variant against the
# struct layout `{ i8 tag, [N x i8] payload }` (ritz-task-133 parity with
# ritz0).  `slot_reg` is a pointer to the scrutinee struct (the match
# prelude spills the scrutinee value into an alloca once).  `enum_name`
# is the `%Result$.../Option$...` type name used to GEP.  `tag_one == 1`
# checks for the carrier variant (Ok / Some); 0 checks for the null
# variant (Err / None).  ritz0 tag convention: Ok=0 Err=1 Some=0 None=1,
# so carrier <=> tag==0.
# User-enum variant check: load the tag byte and compare against an
# arbitrary i8 tag value (instead of the tagged-enum 0/1 binary check).
# Used when the scrutinee's enum is a parser-tracked user enum (Shade,
# etc.) and the match arm names a specific variant by index.
fn emit_variant_tag_check_eq(s: *EmitterState, slot_reg: i32, enum_name: *u8, enum_name_len: i32, tag_value: i32) -> i32
    let tag_ptr: i32 = next_reg(s)
    emit_str(s, c"  ")
    emit_reg(s, tag_ptr)
    emit_str(s, c" = getelementptr %")
    emit_name(s, enum_name, enum_name_len)
    emit_str(s, c", ptr ")
    emit_reg(s, slot_reg)
    emit_str(s, c", i32 0, i32 0\n")
    let tag_reg: i32 = next_reg(s)
    emit_str(s, c"  ")
    emit_reg(s, tag_reg)
    emit_str(s, c" = load i8, ptr ")
    emit_reg(s, tag_ptr)
    emit_str(s, c"\n")
    let cmp_reg: i32 = next_reg(s)
    emit_str(s, c"  ")
    emit_reg(s, cmp_reg)
    emit_str(s, c" = icmp eq i8 ")
    emit_reg(s, tag_reg)
    emit_str(s, c", ")
    emit_int(s, tag_value as i64)
    emit_str(s, c"\n")
    return cmp_reg

fn emit_variant_tag_check(s: *EmitterState, slot_reg: i32, enum_name: *u8, enum_name_len: i32, tag_one: i32) -> i32
    let tag_ptr: i32 = next_reg(s)
    emit_str(s, c"  ")
    emit_reg(s, tag_ptr)
    emit_str(s, c" = getelementptr %")
    emit_name(s, enum_name, enum_name_len)
    emit_str(s, c", ptr ")
    emit_reg(s, slot_reg)
    emit_str(s, c", i32 0, i32 0\n")
    let tag_reg: i32 = next_reg(s)
    emit_str(s, c"  ")
    emit_reg(s, tag_reg)
    emit_str(s, c" = load i8, ptr ")
    emit_reg(s, tag_ptr)
    emit_str(s, c"\n")
    let cmp_reg: i32 = next_reg(s)
    emit_str(s, c"  ")
    emit_reg(s, cmp_reg)
    if tag_one == 1
        # carrier (Ok/Some) → tag == 0
        emit_str(s, c" = icmp eq i8 ")
    else
        # null (Err/None) → tag != 0
        emit_str(s, c" = icmp ne i8 ")
    emit_reg(s, tag_reg)
    emit_str(s, c", 0\n")
    return cmp_reg

# Extract the variant payload as an i64 (the common scalar case).  Payload
# sits at field 2 (the `[N x i8]` buffer after the alignment pad, AGAST
# #1898), stored at its own width; it is widened to i64 because ritz1's
# downstream arithmetic / call paths operate on i64 registers.  `variant` is
# 0 for Ok / Some, 1 for Err.
fn emit_variant_payload(s: *EmitterState, slot_reg: i32, enum_name: *u8, enum_name_len: i32, variant: i32) -> i32
    let pay_ptr: i32 = next_reg(s)
    emit_str(s, c"  ")
    emit_reg(s, pay_ptr)
    emit_str(s, c" = getelementptr %")
    emit_name(s, enum_name, enum_name_len)
    emit_str(s, c", ptr ")
    emit_reg(s, slot_reg)
    emit_str(s, c", i32 0, i32 2\n")
    return emit_tagged_payload_load(s, pay_ptr, enum_name, enum_name_len, variant)

# Scalar-scrutinee fallback (non-enum `match x on int`).
fn emit_variant_tag_check_i64(s: *EmitterState, scrut_reg: i32, tag_one: i32) -> i32
    # Legacy packed-i64 path retained only for non-enum match.  In practice
    # ritz1 code only uses `match` on Result/Option + integers; this branch
    # covers the latter.  Returns a conservative always-false for "variant"
    # patterns against a scalar scrutinee.
    let r: i32 = next_reg(s)
    emit_str(s, c"  ")
    emit_reg(s, r)
    emit_str(s, c" = icmp eq i64 ")
    emit_reg(s, scrut_reg)
    emit_str(s, c", 0\n")
    if tag_one == 1
        return r
    let inv: i32 = next_reg(s)
    emit_str(s, c"  ")
    emit_reg(s, inv)
    emit_str(s, c" = xor i1 ")
    emit_reg(s, r)
    emit_str(s, c", true\n")
    return inv

# AGAST #1797: the tag of the variant `arm` names in user enum `enum_name`,
# or -1 (not a user enum, or no such variant).
fn user_arm_variant(enum_name: *u8, enum_name_len: i32, arm: *MatchArm) -> i32
    if user_enum_index(enum_name, enum_name_len) < 0
        return 0 - 1
    return enum_variant_index(enum_name, enum_name_len, arm.pattern_name, arm.pattern_name_len)

# AGAST #1515: the struct type carried by a tagged enum's carrier variant
# (Ok/Some): see tagged_enum_payload_struct.  AGAST #1667 adds Result's Err
# side (tagged_enum_err_payload_struct), and #2100 a non-generic user enum
# payload.  When it names a known struct or enum, fills (out_name, out_len);
# otherwise leaves them null/0 and the caller keeps the scalar i64 binding
# (primitives, pointers, None).
fn carrier_payload_struct(s: *EmitterState, arm: *MatchArm, enum_name: *u8, enum_name_len: i32, out_name: **u8, out_len: *i32)
    *out_name = null
    *out_len = 0
    if enum_name == null or enum_name_len <= 0
        return
    if is_tagged_enum_type(enum_name, enum_name_len) == 0
        # AGAST #1797: a user enum's tuple variant declares its payload.
        let uf: *StructField = user_enum_tuple_field(enum_name, enum_name_len, user_arm_variant(enum_name, enum_name_len, arm))
        if uf != null
            if uf.field_type == TYPE_STRUCT and uf.field_type_name_len > 0
                *out_name = uf.field_type_name
                *out_len = uf.field_type_name_len
        return
    if variant_is_tag_one(arm.pattern_name, arm.pattern_name_len) == 0
        # AGAST #1667: `Err(e)` over Result<T, E> with a struct E binds at %E.
        if arm.pattern_name_len == 3 and *arm.pattern_name == 69 and *(arm.pattern_name + 1) == 114 and *(arm.pattern_name + 2) == 114   # "Err"
            *out_name = tagged_enum_err_payload_named(s, enum_name, enum_name_len, out_len, 1)
        return
    # AGAST #2100: a user-enum payload (`Some(x)` over Option<Opt>) binds at
    # %Opt too; it was loaded as an i64.
    *out_name = tagged_enum_payload_named(s, enum_name, enum_name_len, out_len, 1)

# AGAST #1515: bind `Some(p)` / `Ok(s)` to a copy of a struct payload.  The
# payload sits at field 2 of the spilled scrutinee (#1898); copy it into its own
# `alloca %Name` and register a struct local, so `p.x` and by-value passing
# see `%Name` rather than an i64.
fn emit_struct_payload_bind(s: *EmitterState, arm: *MatchArm, slot_reg: i32, enum_name: *u8, enum_name_len: i32, st_name: *u8, st_name_len: i32)
    let pay_ptr: i32 = next_reg(s)
    emit_str(s, c"  ")
    emit_reg(s, pay_ptr)
    emit_str(s, c" = getelementptr %")
    emit_name(s, enum_name, enum_name_len)
    emit_str(s, c", ptr ")
    emit_reg(s, slot_reg)
    emit_str(s, c", i32 0, i32 2\n")
    let val: i32 = next_reg(s)
    emit_str(s, c"  ")
    emit_reg(s, val)
    emit_str(s, c" = load %")
    emit_name(s, st_name, st_name_len)
    emit_str(s, c", ptr ")
    emit_reg(s, pay_ptr)
    emit_str(s, c"\n")
    let alloca_reg: i32 = next_reg(s)
    emit_str(s, c"  ")
    emit_reg(s, alloca_reg)
    emit_str(s, c" = alloca %")
    emit_name(s, st_name, st_name_len)
    emit_str(s, c"  ; match struct payload bind\n")
    emit_str(s, c"  store %")
    emit_name(s, st_name, st_name_len)
    emit_str(s, c" ")
    emit_reg(s, val)
    emit_str(s, c", ptr ")
    emit_reg(s, alloca_reg)
    emit_str(s, c"\n")
    add_local_struct(s, arm.pattern_inner_name, arm.pattern_inner_name_len, alloca_reg, TYPE_STRUCT, st_name, st_name_len)

# AGAST #1667: an arm yielding a bare `Ok(..)` / `Err(..)` / `Some(..)` /
# `None` builds whichever enum its context dictates (resolve_enum_ctx, the
# same lookup emit_variant_struct made while emitting the arm), so the merge
# phi must have that type rather than i64.  `arg_parse_i64`'s
# `Some(n) => Ok(n)` / `None => Err(..)` emitted `phi i64 [%Result$..]`.
fn variant_ctor_arm_type(s: *EmitterState, e: *Expr, out_name: **u8, out_len: *i32)
    *out_name = null
    *out_len = 0
    if e == null
        return
    var is_ctor: i32 = 0
    if e.kind == EXPR_CALL
        if is_variant_carrier(e.func_name, e.func_name_len) == 1 or is_variant_null(e.func_name, e.func_name_len) == 1
            is_ctor = 1
    else if e.kind == EXPR_IDENT
        # Unshadowed `None`, mirroring emit_expr_ident.
        if is_ident_none(e.ident_ptr, e.ident_len) == 1
            if is_const(s, e.ident_ptr, e.ident_len) == 0 and find_local(s, e.ident_ptr, e.ident_len) < 0
                if find_global(s, e.ident_ptr, e.ident_len) == null
                    is_ctor = 1
    if is_ctor == 1
        resolve_enum_ctx(s, out_name, out_len)

# Emit a block arm's statements (AGAST #1454).  `return` leaves the block
# terminated by `ret`, but the arm still records a phi incoming and emits its
# `br` to the match end.  Without a fresh block the phi would name the block
# holding the `ret` as a predecessor, and clang rejects the module ("PHI node
# entries do not match predecessors").  Opening an (unreachable) block after
# each `ret` makes current_label the block that really branches to the end,
# exactly as STMT_BREAK / STMT_CONTINUE already do (ritz-task-195).
fn emit_match_arm_stmts(s: *EmitterState, stmts: *Stmt)
    var st: *Stmt = stmts
    while st != null
        emit_stmt(s, st, s.fn_ret_type)
        if st.kind == STMT_RETURN
            begin_block(s, next_label(s))
            clear_last_expr(s)
        st = st.next

fn match_result_init(r: *MatchResult, n_arms: i32)
    var n: i64 = n_arms as i64
    if n < 1
        n = 1
    r.values = malloc(n * 4) as *i32
    r.labels = malloc(n * 4) as *i32
    r.count = 0
    r.agg_name = null
    r.agg_name_len = 0
    r.float_ty = 0
    r.int_arms = 0
    r.void_arms = 0
    r.void_line = 0
    r.void_col = 0

# AGAST #2046: take the caller's "value discarded" flag (match_no_value) and
# clear it so no nested match / if sees it.  Returns 1 if the value is wanted.
fn take_match_wants_value(s: *EmitterState) -> i32
    let discard: i32 = s.match_no_value
    s.match_no_value = 0
    1 - discard

# AGAST #2046: the arms of a match / if were emitted and at least one had no
# value.  If the value is wanted that is a located error at the innermost
# void call; either way publish that location for an enclosing match, whose
# arm this match / if may be.
fn match_void_arms_settle(s: *EmitterState, result: *MatchResult, wants_value: i32)
    s.void_arm_line = result.void_line
    s.void_arm_col = result.void_col
    if wants_value == 0
        return
    let file: *u8 = emitter_source_file()
    if file != null
        eprints_cstr(file)
    else
        eprints_cstr(c"<input>")
    eprint_char(':')
    eprint_i64(result.void_line as i64)
    eprint_char(':')
    eprint_i64(result.void_col as i64)
    eprints_cstr(c": error: this arm calls a fn that returns nothing, so it has no value; the `match`/`if` it belongs to is used as a value here\n")
    emit_str(s, c"  ; ERROR: valueless match / if arm used as a value\n")
    s.error_count = s.error_count + 1

# AGAST #1946: the float type (TYPE_F32 / TYPE_F64) arm value `e` was just
# emitted at, or 0.  A nested match / if publishes its phi type as it
# completes, which is immediately before this is asked.
fn match_arm_float_ty(s: *EmitterState, e: *Expr) -> i32
    if e.kind == EXPR_MATCH or e.kind == EXPR_IF
        return s.last_match_float_ty
    binop_operand_float_ty(s, e)

# AGAST #1946: take the float type an enclosing let / return expects of this
# match (0 if none) and clear it so no nested match sees it.
fn take_match_float_hint(s: *EmitterState) -> i32
    let h: i32 = s.match_float_hint
    s.match_float_hint = 0
    h

# AGAST #1946: settle a scalar arm's value against the phi's float type.  The
# first float arm fixes it (an earlier i64 arm cannot be converted any more:
# an error, not a mistyped phi); once fixed, a float of the other width or an
# integer is converted in the arm's own block before its `br`.  Called while
# the arm's pattern binding is in scope.  Returns the register to record.
fn match_arm_float_settle(s: *EmitterState, arm_body: *Expr, body_reg: i32, result: *MatchResult) -> i32
    let aft: i32 = match_arm_float_ty(s, arm_body)
    if result.float_ty == 0
        if aft == 0
            result.int_arms = result.int_arms + 1
            return body_reg
        if result.int_arms > 0
            emit_ir_error(s, c"match arms yield both an integer and a float value; write the integer arm as a float (`0.0`) or annotate the binding")
        result.float_ty = aft
        return body_reg
    if aft == result.float_ty
        return body_reg
    if aft != 0
        return emit_float_coerce(s, body_reg, aft, result.float_ty)
    if is_int_const_type(get_expr_type(s, arm_body)) == 1
        return emit_float_coerce(s, body_reg, TYPE_I64, result.float_ty)
    emit_ir_error(s, c"match arm yields a non-numeric value where the other arms yield a float")
    body_reg

# AGAST #1946: the merge phi's type: the arms' struct, their float, or i64.
fn emit_match_phi_type(s: *EmitterState, result: *MatchResult)
    if result.agg_name != null and result.agg_name_len > 0
        emit_llvm_type_struct(s, TYPE_STRUCT, result.agg_name, result.agg_name_len)
    else if result.float_ty != 0
        emit_str(s, float_llvm_name(result.float_ty))
    else
        emit_str(s, c"i64")

# AGAST #1946: one phi incoming value: the arm's register, or for
# MATCH_ZERO_VALUE the zero constant of the phi's type.
fn emit_match_phi_value(s: *EmitterState, result: *MatchResult, reg: i32)
    if reg != MATCH_ZERO_VALUE
        emit_reg(s, reg)
    else if result.agg_name != null and result.agg_name_len > 0
        emit_str(s, c"zeroinitializer")
    else if result.float_ty != 0
        emit_str(s, c"0.0")
    else
        emit_str(s, c"0")

# AGAST #1946: publish the phi's type for an untyped `let v = match` / `if`
# (#1666).  Called after every arm, so the outermost construct's type wins.
fn publish_match_type(s: *EmitterState, result: *MatchResult)
    if result.agg_name != null and result.agg_name_len > 0
        s.last_match_agg_name = result.agg_name
        s.last_match_agg_name_len = result.agg_name_len
        s.last_match_float_ty = 0
    else
        s.last_match_agg_name = null
        s.last_match_agg_name_len = 0
        s.last_match_float_ty = result.float_ty

# AGAST #2342: what `Constructor(v)` binds, as bool_kind would say.
fn payload_bool_kind(s: *EmitterState, arm: *MatchArm, enum_name: *u8, enum_name_len: i32) -> i32
    if enum_name == null or enum_name_len <= 0
        return BK_UNSURE
    if is_tagged_enum_type(enum_name, enum_name_len) == 1
        return bk_tagged_payload(enum_name, enum_name_len, 1 - variant_is_tag_one(arm.pattern_name, arm.pattern_name_len))
    let uf: *StructField = user_enum_tuple_field(enum_name, enum_name_len, user_arm_variant(enum_name, enum_name_len, arm))
    if uf == null
        return BK_UNSURE
    bk_of_type(uf.field_type, uf.field_type_name, uf.field_type_name_len)

# Emit match body, returning (result_reg, exit_label) via MatchResult slot.
# For PAT_VARIANT arms with PAT_IDENT inner (e.g. `Ok(v) => v`), the inner
# name is bound to the extracted payload for the duration of the arm body,
# then popped via local_count rollback. (task-99 #105)
fn emit_match_arm_body(s: *EmitterState, arm: *MatchArm, scrut_reg: i32, scrut_slot: i32, enum_name: *u8, enum_name_len: i32, result: *MatchResult, arm_index: i32, end_label: i32)
    # Save local_count so arm-scoped bindings get popped after the body.
    let saved_local_count: i32 = s.local_count
    own_push_scope(s)   # AGAST #2158: the arm is a block for drops

    # Bind variant payload to inner pattern name on `Constructor(binding)`.
    if arm.pattern_kind == PAT_VARIANT
        if arm.pattern_inner_kind == PAT_IDENT
            if arm.pattern_inner_name_len > 0
                var is_wildcard: i32 = 0
                if arm.pattern_inner_name_len == 1
                    if *arm.pattern_inner_name == 95   # '_'
                        is_wildcard = 1
                var pay_struct: *u8 = null
                var pay_struct_len: i32 = 0
                if is_wildcard == 0 and scrut_slot != 0
                    carrier_payload_struct(s, arm, enum_name, enum_name_len, @pay_struct, @pay_struct_len)
                if is_wildcard == 0 and pay_struct != null
                    emit_struct_payload_bind(s, arm, scrut_slot, enum_name, enum_name_len, pay_struct, pay_struct_len)
                    # AGAST #2174: it owns the payload of a scrutinee the
                    # match owns.
                    own_match_payload(s, arm.pattern_inner_name, arm.pattern_inner_name_len)
                else if is_wildcard == 0
                    var payload_reg: i32 = 0
                    # AGAST #1945: a float payload binds as an f32 / f64 local.
                    var bind_ft: i32 = 0
                    if scrut_slot != 0 and enum_name != null and enum_name_len > 0
                        # Result/Option: 0 Ok-Some, 1 Err; a user enum: the
                        # variant's own tag (AGAST #1797), for its width.
                        var pay_variant: i32 = 1 - variant_is_tag_one(arm.pattern_name, arm.pattern_name_len)
                        let uvi: i32 = user_arm_variant(enum_name, enum_name_len, arm)
                        if uvi >= 0
                            pay_variant = uvi
                        payload_reg = emit_variant_payload(s, scrut_slot, enum_name, enum_name_len, pay_variant)
                        bind_ft = tagged_enum_float_type(s, enum_name, enum_name_len, pay_variant)
                    else
                        # Non-enum scrutinee (shouldn't reach here in practice).
                        payload_reg = scrut_reg
                    var bind_llvm: *u8 = c"i64"
                    var bind_type: i32 = TYPE_I64
                    if bind_ft != 0
                        bind_llvm = float_llvm_name(bind_ft)
                        bind_type = bind_ft
                    let alloca_reg: i32 = next_reg(s)
                    emit_str(s, c"  ")
                    emit_reg(s, alloca_reg)
                    emit_str(s, c" = alloca ")
                    emit_str(s, bind_llvm)
                    emit_str(s, c"  ; match payload bind\n")
                    emit_str(s, c"  store ")
                    emit_str(s, bind_llvm)
                    emit_str(s, c" ")
                    emit_reg(s, payload_reg)
                    emit_str(s, c", ptr ")
                    emit_reg(s, alloca_reg)
                    emit_str(s, c"\n")
                    add_local(s, arm.pattern_inner_name, arm.pattern_inner_name_len, alloca_reg, bind_type)
                    if bind_ft == 0
                        bool_note_binding(s, payload_bool_kind(s, arm, enum_name, enum_name_len))   # AGAST #2342

    # A catch-all name over a scalar (`other => other + 1`) binds the
    # scrutinee, as in ritz0 (LANGUAGE_SPEC §8.2).  Not a const (that arm
    # compares) and not `None` (the tagged-enum null test above).
    if arm.pattern_kind == PAT_IDENT and (enum_name == null or enum_name_len == 0)
        if find_const_entry(s, arm.pattern_name, arm.pattern_name_len) == null and is_ident_none_name(arm.pattern_name, arm.pattern_name_len) == 0
            let bind_reg: i32 = next_reg(s)
            emit_str(s, c"  ")
            emit_reg(s, bind_reg)
            emit_str(s, c" = alloca i64  ; match binding\n")
            emit_str(s, c"  store i64 ")
            emit_reg(s, scrut_reg)
            emit_str(s, c", ptr ")
            emit_reg(s, bind_reg)
            emit_str(s, c"\n")
            add_local(s, arm.pattern_name, arm.pattern_name_len, bind_reg, TYPE_I64)
            bool_note_binding(s, s.match_scrut_kind)   # AGAST #2342

    # Block-bodied / statement arm (AGAST #1454, #1617): run the leading
    # statements in the arm's own scope (they are popped with the payload
    # binding below), then fall into the value path, which reads the
    # trailing expression match_arm_set_block left in arm.body.
    emit_match_arm_stmts(s, arm.body_stmts)

    # A valueless arm (`pass`, or no trailing expression) feeds the phi the
    # zero of its type (AGAST #1946).
    var body_reg: i32 = MATCH_ZERO_VALUE
    if arm.is_pass == 1
        body_reg = MATCH_ZERO_VALUE
    else if arm.body != null
        # AGAST #2028: `@&` of a `let` in an expression arm, with the arm's
        # pattern binding in scope.
        let_check_expr(s, arm.body)
        enum_as_int_expr(s, arm.body)   # AGAST #2136: call arguments
        # AGAST #2046: a match / if nested as the arm never reports its own
        # valueless arm; it returns no value and this match decides.
        let nested: bool = arm.body.kind == EXPR_MATCH or arm.body.kind == EXPR_IF
        if nested
            s.match_no_value = 1
        own_check_arm(s, arm.body)   # AGAST #2158: the arm's value moves out
        body_reg = emit_expr(s, arm.body)
    if arm.is_pass == 0 and arm.body != null and body_reg == 0
        # AGAST #1654: a void call (`Some(e) => say(e)`), or a nested
        # valueless match.  Register 0 is never defined; record a zero so
        # nothing ever names %.0, and mark the whole match valueless.
        result.void_arms = result.void_arms + 1
        body_reg = MATCH_ZERO_VALUE
        if result.void_line == 0
            # AGAST #2046: locate the void call; a nested valueless match /
            # if published its own innermost one.
            if arm.body.kind == EXPR_MATCH or arm.body.kind == EXPR_IF
                result.void_line = s.void_arm_line
                result.void_col = s.void_arm_col
            else
                result.void_line = arm.body.span.line
                result.void_col = arm.body.span.col
    else if arm.is_pass == 0 and arm.body != null
        # AGAST #1645: resolve the arm's struct type while its pattern
        # binding (`Some(v) => v`) is still in scope; it is popped below.
        var arm_ty: *u8 = null
        var arm_ty_len: i32 = 0
        resolve_expr_struct_name(s, arm.body, @arm_ty, @arm_ty_len)
        if arm_ty == null
            variant_ctor_arm_type(s, arm.body, @arm_ty, @arm_ty_len)
        # The first struct-valued arm fixes the phi type.  A `"..."` arm is a
        # StrView in the language; its `%Span$u8` lowering (#98) is an
        # artefact, so a leading literal arm types the phi as StrView, the
        # same type a later `Some(s) => s` over Option<StrView> yields.
        if result.agg_name == null and arm_ty != null and arm_ty_len > 0
            if arm.body.kind == EXPR_STRING_LIT
                result.agg_name = c"StrView"
                result.agg_name_len = 7
            else
                result.agg_name = arm_ty
                result.agg_name_len = arm_ty_len
        # AGAST #1662: rebuild a layout-equivalent arm value (Span$u8 <->
        # StrView, #168) as the phi's type here, in the arm's own block before
        # its `br`, so every phi incoming value has the phi's type.
        if is_layout_equiv_pair(arm_ty, arm_ty_len, result.agg_name, result.agg_name_len) == 1
            body_reg = rebuild_layout_equiv(s, body_reg, arm_ty, arm_ty_len, result.agg_name, result.agg_name_len)
        # AGAST #1946: a float-valued scalar arm types the phi as float.
        if result.agg_name == null
            body_reg = match_arm_float_settle(s, arm.body, body_reg, result)

    # AGAST #2158: drop the arm's bindings once its value is computed.
    own_pop_scope(s)
    s.local_count = saved_local_count
    # ritz-task-193 — drop the inner-arm binding from local_map so the next
    # find_local on the shadowed name returns the outer binding via the map
    # fast-path (the find fallback would otherwise carry the cost).
    rebuild_local_map(s)

    let exit_label: i32 = s.current_label
    result.values[arm_index] = body_reg
    result.labels[arm_index] = exit_label
    if arm_index + 1 > result.count
        result.count = arm_index + 1

    emit_str(s, c"  br label %")
    emit_label(s, end_label)
    emit_str(s, c"\n")

# Emit one arm's condition + body.  `scrut_slot` is an alloca holding the
# scrutinee struct (when enum_name is non-null), or 0 for scalar scrutinees.
fn emit_match_arm(s: *EmitterState, arm: *MatchArm, scrut_reg: i32, scrut_slot: i32, enum_name: *u8, enum_name_len: i32, result: *MatchResult, arm_index: i32, end_label: i32)
    let body_label: i32 = next_label(s)
    let next_label_id: i32 = next_label(s)

    var cond_reg: i32 = 0
    var always_true: i32 = 0
    let is_enum_match: i32 = (enum_name != null and enum_name_len > 0) as i32

    if arm.pattern_kind == PAT_INT_LIT or arm.pattern_kind == PAT_BOOL
        cond_reg = next_reg(s)
        emit_str(s, c"  ")
        emit_reg(s, cond_reg)
        emit_str(s, c" = icmp eq i64 ")
        emit_reg(s, scrut_reg)
        emit_str(s, c", ")
        emit_int(s, arm.pattern_int)
        emit_str(s, c"\n")
    else if arm.pattern_kind == PAT_WILDCARD
        always_true = 1
    else if arm.pattern_kind == PAT_IDENT
        # Ident pattern — unit variant (None/Err/Light/Dark) or a binding.
        # First try the user-enum tracker so user-declared variants resolve
        # to their proper tag index; fall back to None/Err special-casing
        # for tagged enums; otherwise treat as a binding (always_true).
        if is_enum_match == 1 and is_enum_type(enum_name, enum_name_len) == 1
            let user_idx: i32 = enum_variant_index(enum_name, enum_name_len, arm.pattern_name, arm.pattern_name_len)
            if user_idx >= 0
                cond_reg = emit_variant_tag_check_eq(s, scrut_slot, enum_name, enum_name_len, user_idx)
        if cond_reg == 0 and arm.pattern_name_len == 4
            if *arm.pattern_name == 78 and *(arm.pattern_name + 1) == 111
                if *(arm.pattern_name + 2) == 110 and *(arm.pattern_name + 3) == 101
                    # "None": null variant → tag != 0
                    if is_enum_match == 1
                        cond_reg = emit_variant_tag_check(s, scrut_slot, enum_name, enum_name_len, 0)
                    else
                        cond_reg = emit_variant_tag_check_i64(s, scrut_reg, 0)
        # A constant pattern (LANGUAGE_SPEC §8.2, AGAST #1880): a name that
        # is an integer const compares, as ritz0 does; any other binds.
        if cond_reg == 0 and is_enum_match == 0
            let ce: *ConstEntry = find_const_entry(s, arm.pattern_name, arm.pattern_name_len)
            if ce != null and is_int_const_type(ce.const_type) == 1
                cond_reg = next_reg(s)
                emit_str(s, c"  ")
                emit_reg(s, cond_reg)
                emit_str(s, c" = icmp eq i64 ")
                emit_reg(s, scrut_reg)
                emit_str(s, c", ")
                emit_int(s, ce.value)
                emit_str(s, c"\n")
        if cond_reg == 0
            always_true = 1
    else if arm.pattern_kind == PAT_VARIANT
        # User-declared enum: look up the variant's tag index from the
        # parser's enum tracker (Shade.Light=0, Shade.Dark=1).  Falls back
        # to the binary Some/Ok-vs-None/Err mapping for tagged enums.
        if is_enum_match == 1 and is_enum_type(enum_name, enum_name_len) == 1
            let user_idx: i32 = enum_variant_index(enum_name, enum_name_len, arm.pattern_name, arm.pattern_name_len)
            if user_idx >= 0
                cond_reg = emit_variant_tag_check_eq(s, scrut_slot, enum_name, enum_name_len, user_idx)
            else
                always_true = 1
        else
            let tag_one: i32 = variant_is_tag_one(arm.pattern_name, arm.pattern_name_len)
            if is_enum_match == 1
                cond_reg = emit_variant_tag_check(s, scrut_slot, enum_name, enum_name_len, tag_one)
            else
                cond_reg = emit_variant_tag_check_i64(s, scrut_reg, tag_one)
    else
        always_true = 1

    if always_true == 1
        emit_str(s, c"  br label %")
        emit_label(s, body_label)
        emit_str(s, c"\n")
    else
        emit_str(s, c"  br i1 ")
        emit_reg(s, cond_reg)
        emit_str(s, c", label %")
        emit_label(s, body_label)
        emit_str(s, c", label %")
        emit_label(s, next_label_id)
        emit_str(s, c"\n")

    begin_block(s, body_label)
    emit_match_arm_body(s, arm, scrut_reg, scrut_slot, enum_name, enum_name_len, result, arm_index, end_label)

    begin_block(s, next_label_id)

fn is_ident_none_name(name: *u8, len: i32) -> i32
    if len == 4 and memcmp(name, c"None", 4) == 0
        return 1
    return 0

# `x as U` for a fieldless user enum value `x` (LANGUAGE_SPEC §10.4): the
# discriminant of `x`'s variant, as an i64 register held per the enum's
# representation type (*out_src_ty; TYPE_I64 without one), for the int → int
# cast that follows to wrap it to U.  The tag (field 0) is the declaration
# index; it maps to the discriminant through a select chain, or is the
# discriminant itself when no `= N` moved one.  An enum with a payload
# variant is the located error ritz0 gives.  -1 when `x` is no user enum.
pub fn emit_enum_to_int(s: *EmitterState, cast: *Expr, raw_reg: i32, out_src_ty: *i32) -> i32
    var en: *u8 = null
    var en_len: i32 = 0
    if resolve_scrutinee_enum(s, cast.left, @en, @en_len) == 0
        return 0 - 1
    let ei: i32 = enum_find(en, en_len)
    if ei < 0 or enum_is_generic(ei) == 1
        return 0 - 1
    let n: i32 = enum_variant_count(ei)
    for vi in 0..n
        if enum_variant_kind(ei, vi) != ENUM_VARIANT_UNIT
            var vf: *StructField = enum_variant_fields(ei, vi)
            eprints_cstr(c"error: ")
            let file: *u8 = emitter_source_file()
            if file != null
                eprints_cstr(file)
            else
                eprints_cstr(c"<input>")
            eprints_cstr(c":")
            eprint_int(cast.span.line as i64)
            eprints_cstr(c":")
            eprint_int(cast.span.col as i64)
            eprints_cstr(c": cannot convert enum '")
            eprint_bytes(en, en_len)
            eprints_cstr(c"' to an integer: variant '")
            eprint_bytes(vf.name, vf.name_len)
            eprints_cstr(c"' carries data\n")
            s.error_count = s.error_count + 1
            *out_src_ty = TYPE_I64
            let z: i32 = next_reg(s)
            emit_str(s, c"  ")
            emit_reg(s, z)
            emit_str(s, c" = add i64 0, 0\n")
            return z
    *out_src_ty = enum_repr(ei)
    if *out_src_ty == 0
        *out_src_ty = TYPE_I64
    let tag: i32 = next_reg(s)
    emit_str(s, c"  ")
    emit_reg(s, tag)
    emit_str(s, c" = extractvalue %")
    emit_name(s, en, en_len)
    emit_str(s, c" ")
    emit_reg(s, raw_reg)
    emit_str(s, c", 0\n")
    var r: i32 = next_reg(s)
    emit_str(s, c"  ")
    emit_reg(s, r)
    emit_str(s, c" = zext i8 ")
    emit_reg(s, tag)
    emit_str(s, c" to i64\n")
    if enum_discr_is_index(ei) == 1
        return r
    let first: i32 = next_reg(s)
    emit_str(s, c"  ")
    emit_reg(s, first)
    emit_str(s, c" = add i64 0, ")
    emit_int(s, enum_variant_discr(ei, 0))
    emit_str(s, c"\n")
    r = first
    for vi in 1..n
        let is_vi: i32 = next_reg(s)
        emit_str(s, c"  ")
        emit_reg(s, is_vi)
        emit_str(s, c" = icmp eq i8 ")
        emit_reg(s, tag)
        emit_str(s, c", ")
        emit_int(s, vi as i64)
        emit_str(s, c"\n")
        let sel: i32 = next_reg(s)
        emit_str(s, c"  ")
        emit_reg(s, sel)
        emit_str(s, c" = select i1 ")
        emit_reg(s, is_vi)
        emit_str(s, c", i64 ")
        emit_int(s, enum_variant_discr(ei, vi))
        emit_str(s, c", i64 ")
        emit_reg(s, r)
        emit_str(s, c"\n")
        r = sel
    return r

# Resolve the scrutinee's enum struct type name by peeking at the AST:
#   * EXPR_IDENT   -> local's recorded struct type
#   * EXPR_CALL    -> callee's return struct type (by name)
#   * EXPR_UNARY*  -> unwrap deref (match *res) and recurse
# Returns 1 with (out_name, out_len) filled, 0 otherwise.
# AGAST #2135: 1 when the local holds a pointer (`*T`, `**T`), not a value.
fn resolve_local_is_ptr(loc: *LocalVar) -> i32
    if loc.var_type == TYPE_PTR or loc.var_type == TYPE_PTR_PTR
        return 1
    0

fn resolve_scrutinee_enum(s: *EmitterState, scr: *Expr, out_name: **u8, out_len: *i32) -> i32
    if scr.kind == EXPR_IDENT
        let loc: *LocalVar = find_local_struct_name(s, scr.ident_ptr, scr.ident_len)
        # AGAST #2135: a pointer local is no enum value, whatever its
        # type_name says.  A `*u8` param's type_name is the parser's
        # last-seen type name (an enum field's type, say), so trusting it
        # lowered `d as *H` as enum -> int.  `*p` of a `*E` is the deref arm.
        if loc != null and resolve_local_is_ptr(loc) == 0
            if loc.type_name_len > 0
                if is_tagged_enum_type(loc.type_name, loc.type_name_len) == 1
                    *out_name = loc.type_name
                    *out_len = loc.type_name_len
                    return 1
                # Also recognize user-declared enums (Shade, etc.) via the
                # parser's per-enum tracker.  The tag is field 0 and the
                # payload field 2, as for Result/Option (AGAST #1797).
                if is_enum_type(loc.type_name, loc.type_name_len) == 1
                    *out_name = loc.type_name
                    *out_len = loc.type_name_len
                    return 1
    else if scr.kind == EXPR_METHOD
        # AGAST #1466: `match Opt.Holds(40)`, a qualified variant ctor.
        qualified_variant_enum(s, scr, out_name, out_len)
        if *out_name != null
            return 1
    else if scr.kind == EXPR_CALL
        # AGAST #1466: `match Holds(40)`, an unqualified user-enum ctor.
        user_variant_ctor_enum(scr, out_name, out_len)
        if *out_name != null
            return 1
        let fd: *FnDef = find_call_fn(s, scr)
        if fd != null
            if fd.return_type == TYPE_STRUCT
                if fd.return_type_name_len > 0
                    if is_tagged_enum_type(fd.return_type_name, fd.return_type_name_len) == 1
                        *out_name = fd.return_type_name
                        *out_len = fd.return_type_name_len
                        return 1
                    if is_enum_type(fd.return_type_name, fd.return_type_name_len) == 1
                        *out_name = fd.return_type_name
                        *out_len = fd.return_type_name_len
                        return 1
    else if scr.kind == EXPR_UNARY
        if scr.op == OP_DEREF
            let opnd: *Expr = scr.operand
            if opnd != null and opnd.kind == EXPR_IDENT
                # `*p` of a `p: *E` local: E, from the pointee's name.  Only
                # a `*T` names its pointee: a `**T`'s deref is a pointer.
                let ploc: *LocalVar = find_local_struct_name(s, opnd.ident_ptr, opnd.ident_len)
                if ploc != null and ploc.var_type == TYPE_PTR and ploc.pointee_type == TYPE_STRUCT
                    if ploc.type_name_len > 0
                        if is_tagged_enum_type(ploc.type_name, ploc.type_name_len) == 1 or is_enum_type(ploc.type_name, ploc.type_name_len) == 1
                            *out_name = ploc.type_name
                            *out_len = ploc.type_name_len
                            return 1
                    *out_name = null
                    *out_len = 0
                    return 0
            return resolve_scrutinee_enum(s, scr.operand, out_name, out_len)
    else if scr.kind == EXPR_MEMBER
        # AGAST #1466: `match Opt.Vacant`, a qualified unit variant.
        qualified_variant_enum(s, scr, out_name, out_len)
        if *out_name != null
            return 1
        # AGAST #1797: an enum-typed struct field, `match h.d`.  It loads
        # the `%Enum` aggregate; matched as a scalar, every arm compared
        # the aggregate register as an i64 and fell through.
        let fld: *StructField = resolve_member_chain_field(s, scr)
        if fld != null and fld.field_type == TYPE_STRUCT and fld.field_type_name_len > 0
            if is_tagged_enum_type(fld.field_type_name, fld.field_type_name_len) == 1 or is_enum_type(fld.field_type_name, fld.field_type_name_len) == 1
                *out_name = fld.field_type_name
                *out_len = fld.field_type_name_len
                return 1
    *out_name = null
    *out_len = 0
    return 0

# AGAST #2344: the struct `scr` yields, for the shapes resolve_scrutinee_enum
# leaves out.  It stays strict for its other callers, but a match cannot: `R` in
# `match a[1]` is a variant or a binding by this type alone, and read as a
# binding it took the first arm and looked covered.
fn match_scrutinee_type(s: *EmitterState, scr: *Expr, out_name: **u8, out_len: *i32)
    *out_name = null
    *out_len = 0
    if scr.kind == EXPR_IDENT
        let loc: *LocalVar = find_local_struct_name(s, scr.ident_ptr, scr.ident_len)
        if loc != null
            if loc.var_type == TYPE_STRUCT
                *out_name = loc.type_name
                *out_len = loc.type_name_len
            return
        let g: *GlobalVarDef = find_global(s, scr.ident_ptr, scr.ident_len)
        if g != null and g.var_type == TYPE_STRUCT
            *out_name = g.type_name
            *out_len = g.type_name_len
    else if scr.kind == EXPR_METHOD or scr.kind == EXPR_CALL
        call_result_struct_name(s, scr, out_name, out_len)
    else if scr.kind == EXPR_INDEX
        index_elem_struct_name(s, scr, out_name, out_len)
    else if scr.kind == EXPR_MEMBER
        let fld: *StructField = resolve_member_chain_field(s, scr)
        if fld != null and fld.field_type == TYPE_STRUCT
            *out_name = fld.field_type_name
            *out_len = fld.field_type_name_len

# 1 when `scr` is certainly no enum, so a bare name in an arm is a binding or a
# const.  Anything this cannot prove stays open: see match_arms_enum.
fn match_scrutinee_is_scalar(s: *EmitterState, scr: *Expr) -> i32
    let k: i32 = scr.kind
    if k == EXPR_INT_LIT or k == EXPR_CHAR_LIT or k == EXPR_BINARY
        return 1
    if k == EXPR_UNARY
        return (scr.op != OP_DEREF) as i32
    if k == EXPR_CAST
        return (scr.op != TYPE_STRUCT) as i32
    if k == EXPR_IDENT
        let loc: *LocalVar = find_local_struct_name(s, scr.ident_ptr, scr.ident_len)
        if loc != null
            return (loc.var_type != TYPE_STRUCT) as i32
        let g: *GlobalVarDef = find_global(s, scr.ident_ptr, scr.ident_len)
        if g != null
            return (g.var_type != TYPE_STRUCT) as i32
        return (find_const_entry(s, scr.ident_ptr, scr.ident_len) != null) as i32
    if k == EXPR_CALL
        let fd: *FnDef = find_call_fn(s, scr)
        return (fd != null and fd.return_type != TYPE_STRUCT) as i32
    if k == EXPR_MEMBER
        let fld: *StructField = resolve_member_chain_field(s, scr)
        return (fld != null and fld.field_type != TYPE_STRUCT) as i32
    0

fn enum_declares_variant(ei: i32, name: *u8, len: i32) -> i32
    for vi in 0..enum_variant_count(ei)
        var vlen: i32 = 0
        let vname: *u8 = enum_variant_name(ei, vi, @vlen)
        if name_eq(vname, vlen, name, len) == 1
            return 1
    0

# The enum an arm names, for a scrutinee no rule above could type, or -1.  ritz0
# reads the type off the emitted value and ritz1 cannot, so this is what keeps
# `R` in `match x as C` from binding: that took the first arm, and looked like a
# catch-all to coverage.  A scalar scrutinee keeps its bindings.
fn match_arms_enum(s: *EmitterState, scr: *Expr, arms: *MatchArm) -> i32
    if match_scrutinee_is_scalar(s, scr) == 1
        return 0 - 1
    var arm: *MatchArm = arms
    while arm != null
        if arm.pattern_kind == PAT_VARIANT or arm.pattern_kind == PAT_IDENT
            for ei in 0..enum_count()
                if enum_declares_variant(ei, arm.pattern_name, arm.pattern_name_len) == 1
                    return ei
        arm = arm.next
    0 - 1

# --- A bare constructor as the scrutinee (AGAST #2419) -----------------------
#
# `match Some(5)` names no enum, so the constructor had none to build: it lowered
# to `add i64 0, 0` and the match ran on that zero.  The payload names it, the
# same whatever else the module says: `Some(5)` is an Option<i64>, as a literal is
# an i64.  A type argument nothing gives (None's, Ok's E, Err's T) takes that
# default too; no arm can read it.

# 1 when a user enum declares `name`, whichever one or how many.
fn user_enum_declares(name: *u8, len: i32) -> i32
    for ei in 0..enum_count()
        if enum_declares_variant(ei, name, len) == 1
            return 1
    0

# 1 when emit_expr lowers `e` as Some/Ok/Err(x), or `e` is the Option's None: one
# no name shadows and no user enum declares.  emit_expr_ident can't build a user's
# None, so that stays the "cannot take address" refusal, not an Option's tag.
fn is_tagged_ctor(s: *EmitterState, e: *Expr) -> i32
    if e.kind == EXPR_CALL
        return (is_variant_carrier(e.func_name, e.func_name_len) == 1 or is_variant_null(e.func_name, e.func_name_len) == 1) as i32
    if e.kind != EXPR_IDENT or is_ident_none(e.ident_ptr, e.ident_len) == 0
        return 0
    if is_const(s, e.ident_ptr, e.ident_len) == 1 or find_global(s, e.ident_ptr, e.ident_len) != null
        return 0
    if user_enum_declares(e.ident_ptr, e.ident_len) == 1
        return 0
    (find_local(s, e.ident_ptr, e.ident_len) < 0) as i32

# 1 when `e` is a constructor that takes its enum from its context: a tagged one,
# or a user's bare unit variant, which is no place to take the address of.
fn match_scrutinee_is_ctor(s: *EmitterState, e: *Expr) -> i32
    if is_tagged_ctor(s, e) == 1
        return 1
    if e.kind == EXPR_IDENT and is_ident_none(e.ident_ptr, e.ident_len) == 1
        return 0
    var vi: i32 = 0
    var other: i32 = 0
    (bare_unit_variant_enum(s, e, @vi, @other) >= 0) as i32

# 1 when `e` builds its enum where it stands, payload and all: nothing but the
# match can own that value (own_scrutinee_moved).
fn match_scrutinee_builds(s: *EmitterState, e: *Expr) -> i32
    if is_tagged_ctor(s, e) == 1
        return 1
    var name: *u8 = null
    var len: i32 = 0
    if e.kind == EXPR_CALL
        user_variant_ctor_enum(e, @name, @len)
    else if e.kind == EXPR_METHOD
        qualified_variant_enum(s, e, @name, @len)
    (name != null) as i32

# `a`, `b` and `c` as one NUL-terminated name, its length in *out_len.
fn ctor_join(a: *u8, a_len: i32, b: *u8, b_len: i32, c: *u8, c_len: i32, out_len: *i32) -> *u8
    let n: i32 = a_len + b_len + c_len
    let name: *u8 = malloc((n + 1) as i64)
    memcpy(name, a, a_len as i64)
    memcpy(name + a_len, b, b_len as i64)
    memcpy(name + a_len + b_len, c, c_len as i64)
    *(name + n) = 0
    *out_len = n
    name

# A pointer's spelling, `ptr_T`, for the shapes that record T; else 0.
fn ctor_pointer_spelling(s: *EmitterState, e: *Expr, out: **u8) -> i32
    if e.kind == EXPR_CSTRING_LIT
        *out = c"ptr_u8"
        return 6
    if e.kind != EXPR_IDENT
        return 0
    let loc: *LocalVar = find_local_struct_name(s, e.ident_ptr, e.ident_len)
    if loc == null
        return 0
    var base: *u8 = loc.type_name
    var base_len: i32 = loc.type_name_len
    if loc.pointee_type != TYPE_STRUCT
        base_len = primitive_arg_spelling(loc.pointee_type, @base)
    if base_len <= 0
        return 0
    var n: i32 = 0
    *out = ctor_join(c"ptr_", 4, base, base_len, c"", 0, @n)
    n

# The type argument payload `e` gives its enum, spelled as a mangled name; its
# length, or 0 when ritz1 can't name it.  A nested constructor is one of those:
# emit_variant_build gives the inner one the outer enum, typed or not.
fn ctor_payload_spelling(s: *EmitterState, e: *Expr, out: **u8) -> i32
    if is_tagged_ctor(s, e) == 1
        return 0
    if e.kind == EXPR_STRING_LIT
        *out = c"StrView"   # layout-equal to the %Span$u8 it lowers to
        return 7
    if bool_kind(s, e) == BK_BOOL   # `true` is an EXPR_INT_LIT to get_expr_type
        *out = c"bool"
        return 4
    var name: *u8 = null
    var len: i32 = 0
    variant_payload_aggregate(s, e, @name, @len)
    if name != null
        *out = name
        return len
    # A struct emit_variant_build would store as a scalar, which get_expr_type
    # can call an i64: `Some(t.m())`, `Some(a[1])`.
    match_scrutinee_type(s, e, @name, @len)
    if name != null
        return 0
    let ty: i32 = get_expr_type(s, e)
    if ty == TYPE_PTR
        return ctor_pointer_spelling(s, e, out)
    primitive_arg_spelling(ty, out)

# The enum a constructor scrutinee builds, queued for its type decl.  null/0 when
# `scr` is none, or its payload can't be named.
fn ctor_scrutinee_enum(s: *EmitterState, scr: *Expr, out_name: **u8, out_len: *i32)
    *out_name = null
    *out_len = 0
    if is_tagged_ctor(s, scr) == 0
        return
    var arg: *u8 = c"i64"
    var arg_len: i32 = 3
    let is_none: i32 = (scr.kind == EXPR_IDENT or is_ident_none(scr.func_name, scr.func_name_len) == 1) as i32
    if is_none == 0 and scr.args != null
        arg_len = ctor_payload_spelling(s, scr.args, @arg)
        if arg_len <= 0
            return
    var len: i32 = 0
    var name: *u8 = null
    if is_none == 1 or name_eq(scr.func_name, scr.func_name_len, c"Some", 4) == 1
        name = ctor_join(c"Option$", 7, arg, arg_len, c"", 0, @len)
    else if name_eq(scr.func_name, scr.func_name_len, c"Ok", 2) == 1
        name = ctor_join(c"Result$", 7, arg, arg_len, c"$i64", 4, @len)
    else
        name = ctor_join(c"Result$i64$", 11, arg, arg_len, c"", 0, @len)
    if namelist_find(@s.late_enums, name, len) < 0
        namelist_push(@s.late_enums, name, len)
    *out_name = name
    *out_len = len

# `scr` under the enum the match named.  What the slot around the match wants (a
# typed let, the fn's return type) is that match's value, not its scrutinee's.
fn emit_ctor_scrutinee(s: *EmitterState, scr: *Expr, name: *u8, len: i32) -> i32
    let saved_name: *u8 = s.ctx_enum_name
    let saved_len: i32 = s.ctx_enum_name_len
    s.ctx_enum_name = name
    s.ctx_enum_name_len = len
    let reg: i32 = emit_expr(s, scr)
    s.ctx_enum_name = saved_name
    s.ctx_enum_name_len = saved_len
    reg

# As resolve_scrutinee_enum, for a match.  Generic enums named only by an arm or
# by a user `W$i32` are left out: they have no enum struct to spill to, so only
# coverage reads them.
fn resolve_match_enum(s: *EmitterState, scr: *Expr, arms: *MatchArm, out_name: **u8, out_len: *i32) -> i32
    if resolve_scrutinee_enum(s, scr, out_name, out_len) == 1
        return 1
    ctor_scrutinee_enum(s, scr, out_name, out_len)   # AGAST #2419
    if *out_name != null
        return 1
    var name: *u8 = null
    var len: i32 = 0
    match_scrutinee_type(s, scr, @name, @len)
    if name != null and (is_tagged_enum_type(name, len) == 1 or is_enum_type(name, len) == 1)
        *out_name = name
        *out_len = len
        return 1
    *out_name = null
    *out_len = 0
    if name == null
        let ei: i32 = match_arms_enum(s, scr, arms)
        if ei >= 0 and enum_is_generic(ei) == 0
            *out_name = enum_name_at(ei, out_len)
            return MATCH_ENUM_FROM_ARMS
    0

# resolve_match_enum's answer when only an arm named the enum: a guess, which
# can't judge the arms it came from (match_refuse_foreign_arms).
const MATCH_ENUM_FROM_ARMS: i32 = 2

# --- Coverage (LARB R6, AGAST #2344; LANGUAGE_SPEC §8.1) ---------------------
#
# ritz0's twin is ritz0/match_coverage.py, and test_match_exhaustive.py holds the
# two to one table.  The parser refuses guards, so no arm here has one.

# The first name opens the error; `count` says how many went before.
fn match_gap_name(line: i32, col: i32, count: *i32, name: *u8, len: i32)
    if *count == 0
        eprints_cstr(fn_source_file(emitter_current_fn()))
        eprint_char(':')
        eprint_i64(line as i64)
        eprint_char(':')
        eprint_i64(col as i64)
        eprints_cstr(c": error: non-exhaustive match: missing ")
    else
        eprints_cstr(c", ")
    eprint_bytes(name, len)
    *count = *count + 1

fn match_gap_end(s: *EmitterState, count: i32)
    if count > 0
        eprints_cstr(c"\n")
        emit_str(s, c"  ; ERROR: non-exhaustive match\n")
        s.error_count = s.error_count + 1

# A name that is an integer const compares (§8.2, as emit_match_arm reads it).
fn match_arm_is_catch_all(s: *EmitterState, arm: *MatchArm) -> i32
    if arm.pattern_kind == PAT_WILDCARD
        return 1
    if arm.pattern_kind != PAT_IDENT
        return 0
    let ce: *ConstEntry = find_const_entry(s, arm.pattern_name, arm.pattern_name_len)
    if ce != null and is_int_const_type(ce.const_type) == 1
        return 0
    1

fn match_arms_name(arms: *MatchArm, name: *u8, len: i32) -> i32
    var arm: *MatchArm = arms
    while arm != null
        if arm.pattern_kind == PAT_IDENT or arm.pattern_kind == PAT_VARIANT
            if name_eq(arm.pattern_name, arm.pattern_name_len, name, len) == 1
                return 1
        arm = arm.next
    0

# Every variant of enum `ei`, in declaration order.  A name that is no variant
# here is a binding, and so a catch-all.
fn match_check_enum(s: *EmitterState, arms: *MatchArm, ei: i32, line: i32, col: i32)
    var arm: *MatchArm = arms
    while arm != null
        if arm.pattern_kind == PAT_WILDCARD
            return
        if arm.pattern_kind == PAT_IDENT and enum_declares_variant(ei, arm.pattern_name, arm.pattern_name_len) == 0
            return
        arm = arm.next
    var count: i32 = 0
    for vi in 0..enum_variant_count(ei)
        var vlen: i32 = 0
        let vname: *u8 = enum_variant_name(ei, vi, @vlen)
        if match_arms_name(arms, vname, vlen) == 0
            match_gap_name(line, col, @count, vname, vlen)
    match_gap_end(s, count)

fn match_check_bool(s: *EmitterState, arms: *MatchArm, line: i32, col: i32)
    var has_true: i32 = 0
    var has_false: i32 = 0
    var arm: *MatchArm = arms
    while arm != null
        if match_arm_is_catch_all(s, arm) == 1
            return
        if arm.pattern_kind == PAT_BOOL
            if arm.pattern_int == 1
                has_true = 1
            else
                has_false = 1
        arm = arm.next
    var count: i32 = 0
    if has_true == 0
        match_gap_name(line, col, @count, c"true", 4)
    if has_false == 0
        match_gap_name(line, col, @count, c"false", 5)
    match_gap_end(s, count)

fn match_check_scalar(s: *EmitterState, arms: *MatchArm, line: i32, col: i32)
    var arm: *MatchArm = arms
    while arm != null
        if match_arm_is_catch_all(s, arm) == 1
            return
        arm = arm.next
    var count: i32 = 0
    match_gap_name(line, col, @count, c"a catch-all", 11)
    match_gap_end(s, count)

# Option and Result need no import, so the enum tracker may never have seen them.
const MATCH_OPTION: i32 = 1
const MATCH_RESULT: i32 = 2

# Which of them an arm names, or 0.
fn match_arms_builtin(arms: *MatchArm) -> i32
    var arm: *MatchArm = arms
    while arm != null
        if arm.pattern_kind == PAT_VARIANT or arm.pattern_kind == PAT_IDENT
            if name_eq(arm.pattern_name, arm.pattern_name_len, c"Some", 4) == 1 or name_eq(arm.pattern_name, arm.pattern_name_len, c"None", 4) == 1
                return MATCH_OPTION
            if name_eq(arm.pattern_name, arm.pattern_name_len, c"Ok", 2) == 1 or name_eq(arm.pattern_name, arm.pattern_name_len, c"Err", 3) == 1
                return MATCH_RESULT
        arm = arm.next
    0

# Both variants of `a`/`b`, for Option or Result with no tracked declaration.
fn match_check_pair(s: *EmitterState, arms: *MatchArm, a: *u8, a_len: i32, b: *u8, b_len: i32, line: i32, col: i32)
    var arm: *MatchArm = arms
    while arm != null
        if arm.pattern_kind == PAT_WILDCARD
            return
        if arm.pattern_kind == PAT_IDENT
            if name_eq(arm.pattern_name, arm.pattern_name_len, a, a_len) == 0 and name_eq(arm.pattern_name, arm.pattern_name_len, b, b_len) == 0
                return
        arm = arm.next
    var count: i32 = 0
    if match_arms_name(arms, a, a_len) == 0
        match_gap_name(line, col, @count, a, a_len)
    if match_arms_name(arms, b, b_len) == 0
        match_gap_name(line, col, @count, b, b_len)
    match_gap_end(s, count)

# The enum a `Name$args` instantiation, or a plain name, was declared as.
fn match_enum_index(name: *u8, len: i32) -> i32
    var base: i32 = 0
    while base < len and *(name + base) != '$'
        base = base + 1
    enum_find(name, base)

# --- A bare arm name that binds (AGAST #2407; LANGUAGE_SPEC §4.3, §8.2) -------
#
# A top-level name tests where the scrutinee gives it a meaning: a variant the
# enum declares, or, against a scalar, an integer const (match_arm_is_catch_all
# lowers any other name as a binding).  Anywhere else it binds, and a binding
# can't take a const's, global's or variant's name: binder_check.ritz judges
# every other binder, and ritz0's twin is _refuse_arm_names.
fn match_arm_name_tests(s: *EmitterState, arm: *MatchArm, ei: i32, builtin: i32) -> i32
    if ei >= 0
        return enum_declares_variant(ei, arm.pattern_name, arm.pattern_name_len)
    if builtin == MATCH_OPTION
        return (name_eq(arm.pattern_name, arm.pattern_name_len, c"Some", 4) == 1 or name_eq(arm.pattern_name, arm.pattern_name_len, c"None", 4) == 1) as i32
    if builtin == MATCH_RESULT
        return (name_eq(arm.pattern_name, arm.pattern_name_len, c"Ok", 2) == 1 or name_eq(arm.pattern_name, arm.pattern_name_len, c"Err", 3) == 1) as i32
    # An integer const, which is_int_const_type takes a bool for: ritz0 compares
    # neither a bool const nor a float one.
    let ce: *ConstEntry = find_const_entry(s, arm.pattern_name, arm.pattern_name_len)
    (ce != null and ce.const_type != TYPE_BOOL and is_int_const_type(ce.const_type) == 1) as i32

# How many arms were refused, each said at its name.
fn match_refuse_arm_names(s: *EmitterState, arms: *MatchArm, ei: i32, builtin: i32) -> i32
    var refused: i32 = 0
    var arm: *MatchArm = arms
    while arm != null
        # A qualified `E.V` has no span: it is always a variant.
        if arm.pattern_kind == PAT_IDENT and arm.pattern_span.line > 0 and match_arm_name_tests(s, arm, ei, builtin) == 0
            let kind: i32 = binder_module_value_kind(arm.pattern_name, arm.pattern_name_len)
            if kind != BINDER_NONE
                binder_report(fn_source_file(emitter_current_fn()), arm.pattern_span.line, arm.pattern_span.col, arm.pattern_name, arm.pattern_name_len, kind)
                emit_str(s, c"  ; ERROR: a match arm binds a module value's name\n")
                s.error_count = s.error_count + 1
                refused = refused + 1
        arm = arm.next
    refused

# --- An arm naming another enum's variant (AGAST #2431) ----------------------
#
# `Ok(v)` on an Option read `Ok`'s tag off it, silently: tag 0 is Some's.  A
# variant arm, or a qualified `E.V`, must be one the scrutinee's enum declares.
# A bare name that isn't is a binding, and R12 judges it (match_refuse_arm_names).
# ritz0's twin is _require_enum_variant; both name the enum as it was declared,
# since the two mangle `Result<i32, i32>` apart.

# 1 when `arm` names a variant: a payload pattern, or a qualified unit one.
fn match_arm_names_a_variant(arm: *MatchArm) -> i32
    if arm.pattern_kind == PAT_VARIANT
        return 1
    (arm.pattern_kind == PAT_IDENT and arm.pattern_span.line == 0 and arm.head_span.line > 0) as i32

# How many arms named a variant enum `name` doesn't declare, each said at its
# pattern.  `name` is the scrutinee's own, maybe an instantiation (`Option$i64`).
fn match_refuse_foreign_arms(s: *EmitterState, arms: *MatchArm, name: *u8, len: i32) -> i32
    var base: i32 = 0
    while base < len and *(name + base) != '$'
        base = base + 1
    let ei: i32 = match_enum_index(name, len)
    var builtin: i32 = 0
    if ei < 0 and is_tagged_enum_type(name, len) == 1
        builtin = MATCH_RESULT
        if *name == 'O'
            builtin = MATCH_OPTION
    if ei < 0 and builtin == 0
        return 0
    var refused: i32 = 0
    var arm: *MatchArm = arms
    while arm != null
        if match_arm_names_a_variant(arm) == 1 and match_arm_name_tests(s, arm, ei, builtin) == 0
            eprints_cstr(fn_source_file(emitter_current_fn()))
            eprint_char(':')
            eprint_i64(arm.head_span.line as i64)
            eprint_char(':')
            eprint_i64(arm.head_span.col as i64)
            eprints_cstr(c": error: Unknown variant ")
            eprint_bytes(arm.pattern_name, arm.pattern_name_len)
            eprints_cstr(c" in enum ")
            eprint_bytes(name, base)
            eprints_cstr(c"\n")
            emit_str(s, c"  ; ERROR: a match arm names another enum's variant\n")
            s.error_count = s.error_count + 1
            refused = refused + 1
        arm = arm.next
    refused

# --- Reachability (LARB R13, AGAST #2349; LANGUAGE_SPEC §8.1) ----------------
#
# Arms are tried top to bottom and the first that matches wins, so an arm no
# value can reach is an error at its pattern, naming the arm that covers it: an
# earlier arm testing the same literal, const value or variant, or, once the
# arms so far leave no gap under R6, the arm that closed it.  ritz0's twin is
# unreachable_arm in ritz0/match_coverage.py.  No arm has a guard (#1939).

# 1 when `a` and `b` test the same thing.  `ei`/`builtin` say the scrutinee is
# an enum; otherwise a literal and an integer const compare by value (§8.2).
fn match_arms_test_same(s: *EmitterState, a: *MatchArm, b: *MatchArm, ei: i32, builtin: i32) -> i32
    if ei >= 0 or builtin != 0
        if match_arm_is_variant(s, a, ei, builtin) == 0 or match_arm_is_variant(s, b, ei, builtin) == 0
            return 0
        return name_eq(a.pattern_name, a.pattern_name_len, b.pattern_name, b.pattern_name_len)
    if a.pattern_kind == PAT_BOOL or b.pattern_kind == PAT_BOOL
        return (a.pattern_kind == b.pattern_kind and a.pattern_int == b.pattern_int) as i32
    var va: i64 = 0
    var vb: i64 = 0
    if match_arm_int_value(s, a, @va) == 0 or match_arm_int_value(s, b, @vb) == 0
        return 0
    (va == vb) as i32

# 1 when `arm` names a variant of the scrutinee's enum, whatever it binds.
fn match_arm_is_variant(s: *EmitterState, arm: *MatchArm, ei: i32, builtin: i32) -> i32
    if arm.pattern_kind != PAT_IDENT and arm.pattern_kind != PAT_VARIANT
        return 0
    match_arm_name_tests(s, arm, ei, builtin)

# The integer a literal or an integer-const arm tests, into `out`; 0 for any other.
fn match_arm_int_value(s: *EmitterState, arm: *MatchArm, out: *i64) -> i32
    if arm.pattern_kind == PAT_INT_LIT
        *out = arm.pattern_int
        return 1
    if arm.pattern_kind == PAT_IDENT and match_arm_is_catch_all(s, arm) == 0
        let ce: *ConstEntry = find_const_entry(s, arm.pattern_name, arm.pattern_name_len)
        *out = ce.value
        return 1
    0

fn match_report_unreachable(s: *EmitterState, arm: *MatchArm, cover: *MatchArm)
    eprints_cstr(fn_source_file(emitter_current_fn()))
    eprint_char(':')
    eprint_i64(arm.head_span.line as i64)
    eprint_char(':')
    eprint_i64(arm.head_span.col as i64)
    eprints_cstr(c": error: unreachable match arm: the arm at line ")
    eprint_i64(cover.head_span.line as i64)
    eprints_cstr(c" covers it\n")
    emit_str(s, c"  ; ERROR: unreachable match arm\n")
    s.error_count = s.error_count + 1

# 1 when an arm was refused.  Asked once the arms cover the scrutinee (R6).
fn match_check_reachable(s: *EmitterState, arms: *MatchArm, ei: i32, builtin: i32, is_bool: i32) -> i32
    # How many distinct values or variants close the match without a catch-all:
    # an integer never closes.
    var total: i32 = 0
    if ei >= 0
        total = enum_variant_count(ei)
    else if builtin != 0
        total = 2
    else if is_bool == 1
        total = 2
    let is_enum: i32 = (ei >= 0 or builtin != 0) as i32
    var seen: i32 = 0
    var closer: *MatchArm = null
    var arm: *MatchArm = arms
    while arm != null
        # A repeat names the arm it repeats, even once all is covered.
        var prev: *MatchArm = arms
        while prev != arm
            if match_arms_test_same(s, prev, arm, ei, builtin) == 1
                match_report_unreachable(s, arm, prev)
                return 1
            prev = prev.next
        if closer != null
            match_report_unreachable(s, arm, closer)
            return 1
        var catch_all: i32 = 0
        var counts: i32 = 0
        if is_enum == 1
            catch_all = (arm.pattern_kind == PAT_WILDCARD or (arm.pattern_kind == PAT_IDENT and match_arm_is_variant(s, arm, ei, builtin) == 0)) as i32
            counts = match_arm_is_variant(s, arm, ei, builtin)
        else
            catch_all = match_arm_is_catch_all(s, arm)
            counts = (is_bool == 1 and arm.pattern_kind == PAT_BOOL) as i32
        if counts == 1
            seen = seen + 1
        if catch_all == 1 or (total > 0 and seen == total)
            closer = arm
        arm = arm.next
    0

fn match_check_coverage(s: *EmitterState, scrutinee: *Expr, arms: *MatchArm, enum_name: *u8, enum_name_len: i32, from_arms: i32, line: i32, col: i32)
    var name: *u8 = enum_name
    var len: i32 = enum_name_len
    if name == null
        match_scrutinee_type(s, scrutinee, @name, @len)
    var ei: i32 = 0 - 1
    if name != null
        ei = match_enum_index(name, len)
    if ei < 0
        ei = match_arms_enum(s, scrutinee, arms)
    var builtin: i32 = 0
    if ei < 0
        if name != null and is_tagged_enum_type(name, len) == 1
            builtin = MATCH_RESULT
            if *name == 'O'
                builtin = MATCH_OPTION
        else if match_scrutinee_is_scalar(s, scrutinee) == 0
            builtin = match_arms_builtin(arms)
    var is_bool: i32 = 0
    if ei < 0 and builtin == 0
        is_bool = interp_is_bool(s, scrutinee)
    # AGAST #2407: a name that binds can't take a module value's name, and
    # that error comes before the coverage one, as on ritz0.
    if match_refuse_arm_names(s, arms, ei, builtin) > 0
        return
    var arm: *MatchArm = arms
    while arm != null
        if arm.pattern_kind == PAT_BOOL and is_bool == 0
            eprints_cstr(fn_source_file(emitter_current_fn()))
            eprint_char(':')
            eprint_i64(arm.bool_span.line as i64)
            eprint_char(':')
            eprint_i64(arm.bool_span.col as i64)
            eprints_cstr(c": error: a `true` or `false` pattern needs a bool scrutinee\n")
            emit_str(s, c"  ; ERROR: bool pattern on a non-bool scrutinee\n")
            s.error_count = s.error_count + 1
            return
        arm = arm.next
    let errors_before: i32 = s.error_count
    if ei >= 0
        match_check_enum(s, arms, ei, line, col)
    else if builtin == MATCH_OPTION
        match_check_pair(s, arms, c"Some", 4, c"None", 4, line, col)
    else if builtin == MATCH_RESULT
        match_check_pair(s, arms, c"Ok", 2, c"Err", 3, line, col)
    else if is_bool == 1
        match_check_bool(s, arms, line, col)
    else
        match_check_scalar(s, arms, line, col)
    # AGAST #2431: after coverage, as on ritz0, and only against the enum the
    # scrutinee has: one an arm named is no judge of the arms.
    if from_arms == 0 and name != null
        match_refuse_foreign_arms(s, arms, name, len)
    # AGAST #2349: then every arm must be reachable, as on ritz0.  A foreign
    # arm is that error, not an unreachable one, so this comes after it.
    if s.error_count == errors_before
        match_check_reachable(s, arms, ei, builtin, is_bool)

# AGAST #2140: 1 when the scrutinee is a borrow, `@place` / `@&place`.
fn match_scrutinee_is_addr(scr: *Expr) -> i32
    if scr.kind == EXPR_UNARY and (scr.op == OP_ADDR or scr.op == OP_ADDR_MUT) and scr.operand != null
        return 1
    0

# Main entry: emit a match construct. Returns the phi register holding
# the match's result value (or 0 if no arms contribute).
fn emit_match(s: *EmitterState, scrutinee: *Expr, arms: *MatchArm, span: SrcSpan) -> i32
    # AGAST #2342: a catch-all name binds the scrutinee, so it is the same kind.
    let outer_kind: i32 = s.match_scrut_kind
    s.match_scrut_kind = bool_kind(s, scrutinee)
    let result: i32 = emit_match_arms(s, scrutinee, arms, span)
    s.match_scrut_kind = outer_kind
    result

fn emit_match_arms(s: *EmitterState, scrutinee: *Expr, arms: *MatchArm, span: SrcSpan) -> i32
    let wants_value: i32 = take_match_wants_value(s)   # AGAST #2046
    if wants_value == 1
        bool_check_arms(s, arms)   # AGAST #2342
    # Detect whether the scrutinee is a tagged-enum struct; if so, spill
    # it into an alloca once so every arm can GEP the same pointer.
    var enum_name: *u8 = null
    var enum_name_len: i32 = 0
    # AGAST #2140: `match @place` (angelo's `match @self.cmap`) matches the
    # enum the pointer addresses.  resolve_scrutinee_enum stays strict about
    # `@` (emit_enum_to_int shares it, and `(@e) as T` is a pointer cast), so
    # the borrow is unwrapped here: the pointer is the spill slot, and the
    # value is loaded from it for arms that use the scrutinee register.
    # Without this `@o` was a scalar: `Some(x)` compared the ADDRESS to 0.
    let is_addr: i32 = match_scrutinee_is_addr(scrutinee)
    var is_enum: i32 = 0
    var typed: *Expr = scrutinee
    if is_addr == 1
        typed = scrutinee.operand
    let resolved: i32 = resolve_match_enum(s, typed, arms, @enum_name, @enum_name_len)
    is_enum = (resolved != 0) as i32
    # AGAST #2419: never the zero a constructor with no enum lowers to.
    if is_enum == 0 and is_tagged_ctor(s, typed) == 1
        emit_ctor_type_error(s, typed)
        return 0
    match_check_coverage(s, typed, arms, enum_name, enum_name_len, (resolved == MATCH_ENUM_FROM_ARMS) as i32, span.line, span.col)
    # AGAST #2344: an enum element or global is a place too.  emit_expr reads
    # `a[1]` and `g` as scalars, whatever their type.
    var from_place: i32 = is_addr
    var is_ctor: i32 = 0
    if is_enum == 1
        is_ctor = match_scrutinee_is_ctor(s, typed)   # AGAST #2419
        if is_ctor == 1
            from_place = 0
        else if typed.kind == EXPR_INDEX or (typed.kind == EXPR_IDENT and find_local_struct_name(s, typed.ident_ptr, typed.ident_len) == null)
            from_place = 1

    # Evaluate scrutinee.  For `@place` the place's own address (a `ptr`;
    # `@expr` as a value is a ptrtoint'd i64) is the slot.
    var scrut_reg: i32 = 0
    var scrut_slot: i32 = 0
    if is_enum == 1 and from_place == 1
        scrut_slot = emit_lvalue_ptr(s, typed)
        if scrut_slot < 0
            emit_ir_error(s, c"cannot take address of match scrutinee")
            return 0
        scrut_reg = next_reg(s)
        emit_str(s, c"  ")
        emit_reg(s, scrut_reg)
        emit_str(s, c" = load %")
        emit_name(s, enum_name, enum_name_len)
        emit_str(s, c", ptr ")
        emit_reg(s, scrut_slot)
        emit_str(s, c"  ; match @place\n")
    else if is_ctor == 1
        scrut_reg = emit_ctor_scrutinee(s, typed, enum_name, enum_name_len)
    else
        scrut_reg = emit_expr(s, scrutinee)
    if is_enum == 1 and from_place == 0
        scrut_slot = next_reg(s)
        emit_str(s, c"  ")
        emit_reg(s, scrut_slot)
        emit_str(s, c" = alloca %")
        emit_name(s, enum_name, enum_name_len)
        emit_str(s, c"  ; match scrut spill\n")
        emit_str(s, c"  store %")
        emit_name(s, enum_name, enum_name_len)
        emit_str(s, c" ")
        emit_reg(s, scrut_reg)
        emit_str(s, c", ptr ")
        emit_reg(s, scrut_slot)
        emit_str(s, c"\n")

    # AGAST #2174: the match owns a scrutinee it moved (ownership.ritz);
    # `match @place` moves nothing.
    var owned: *Expr = scrutinee
    if is_ctor == 1
        owned = typed   # `@Some(x)` borrows a value only this match holds
    let own_old: i32 = own_match_begin(s, owned, scrut_slot, enum_name, enum_name_len)

    let end_label: i32 = next_label(s)
    var n_arms: i32 = 0
    var counted: *MatchArm = arms
    while counted != null
        n_arms = n_arms + 1
        counted = counted.next
    var result: MatchResult
    match_result_init(@result, n_arms)
    result.float_ty = take_match_float_hint(s)   # AGAST #1946

    # AGAST #2168: each arm's move check starts from the state before the
    # match; after it, the arms that fall through are merged (own_arms_*).
    let own_before: *i32 = own_arms_begin(s)
    var own_acc: *i32 = null
    var arm: *MatchArm = arms
    var idx: i32 = 0
    while arm != null
        own_arm_begin(s, own_before)
        emit_match_arm(s, arm, scrut_reg, scrut_slot, enum_name, enum_name_len, @result, idx, end_label)
        own_arm_end(s, @own_acc)
        arm = arm.next
        idx = idx + 1
    own_arms_end(s, own_before, own_acc)

    # Current block is the last "next" block: no arm matched, and coverage has
    # ruled that out (AGAST #2344), so it ends in `unreachable`.
    # AGAST #1666: publish the phi type for an untyped `let v = match ...`.
    # Set after every arm (nested matches inside arms included) so the
    # outermost match's type is what the enclosing let sees.
    publish_match_type(s, @result)
    if result.void_arms > 0
        # AGAST #1654: an arm yields no value (a void call), so the match is
        # a statement: join at match.end with no phi and no value (register
        # 0, as for a void call).  A struct/float type an earlier arm fixed
        # must not leak to an untyped `let` either.
        s.last_match_agg_name = null
        s.last_match_agg_name_len = 0
        s.last_match_float_ty = 0
        match_void_arms_settle(s, @result, wants_value)   # AGAST #2046
        emit_str(s, c"  unreachable\n")
        begin_block(s, end_label)
        own_match_end(s, own_old)
        return 0
    emit_str(s, c"  unreachable\n")

    # End block with phi over all arm results: ( arm_result, arm_exit_label ).
    begin_block(s, end_label)

    if result.count == 0
        # No arm phi: the match's value is this register itself.
        let no_arm_reg: i32 = next_reg(s)
        emit_str(s, c"  ")
        emit_reg(s, no_arm_reg)
        emit_str(s, c" = add i64 0, 0  ; match: no arm yields a value\n")
        own_match_end(s, own_old)
        return no_arm_reg

    let phi_reg: i32 = next_reg(s)
    emit_str(s, c"  ")
    emit_reg(s, phi_reg)
    emit_str(s, c" = phi ")
    emit_match_phi_type(s, @result)
    emit_str(s, c" ")
    var i: i32 = 0
    while i < result.count
        if i > 0
            emit_str(s, c", ")
        emit_str(s, c"[ ")
        emit_match_phi_value(s, @result, result.values[i])
        emit_str(s, c", %")
        emit_label(s, result.labels[i])
        emit_str(s, c" ]")
        i = i + 1
    emit_str(s, c"\n")
    own_match_end(s, own_old)
    return phi_reg

# AGAST #1613: does an if-expression arm end by leaving the block (`return`,
# `break`, `continue`)?  Such an arm reaches the merge only through the
# unreachable block emit_match_arm_stmts opens after it, so its lack of a
# value is harmless; any other valueless arm is an error.
fn if_arm_diverges(arm: *MatchArm) -> i32
    var last: *Stmt = arm.body_stmts
    if last == null
        return 0
    while last.next != null
        last = last.next
    if last.kind == STMT_RETURN or last.kind == STMT_BREAK or last.kind == STMT_CONTINUE
        return 1
    0

# Reject a valueless arm before anything is emitted for it.  A trailing
# else-less `if` gets ritz0's wording (LANGUAGE_SPEC §6.1, AGAST #1406);
# expr_if already turned every trailing if/else into the arm's value.
fn if_arm_check_value(s: *EmitterState, arm: *MatchArm)
    if arm.is_pass == 0 or if_arm_diverges(arm) == 1
        return
    var last: *Stmt = arm.body_stmts
    while last != null and last.next != null
        last = last.next
    if last != null and last.kind == STMT_IF
        emit_ir_error(s, c"an `if` with no `else` has no value when its condition is false, so it cannot be used as a value here; add an `else` arm")
    else
        emit_ir_error(s, c"an `if` expression arm does not end in a value")

# Emit an if/else expression (AGAST #1613): `left` is the condition, `args`
# the then-arm and its `next` the else-arm (see expr_if).  Lowered like a
# two-arm match with no fallthrough: each arm goes through
# emit_match_arm_body, which emits its block statements, its value and the
# `br` to the merge, and types a struct-valued arm (#1645) so the phi is
# `%StrView` / `%Point` rather than i64.  Returns the phi register.
fn emit_if_expr(s: *EmitterState, e: *Expr) -> i32
    let wants_value: i32 = take_match_wants_value(s)   # AGAST #2046
    let then_arm: *MatchArm = e.args as *MatchArm
    let else_arm: *MatchArm = then_arm.next
    if_arm_check_value(s, then_arm)
    if_arm_check_value(s, else_arm)

    bool_check_cond(s, e.left, c"if condition")
    if wants_value == 1
        bool_check_arms(s, then_arm)
    # Same i1 / i64 decision as STMT_IF (bool_reg_is_i1, AGAST #1367, #1646).
    let cond: i32 = emit_expr(s, e.left)
    var cond_i1: i32 = cond
    if bool_reg_is_i1(s, e.left) == 0
        cond_i1 = next_reg(s)
        emit_str(s, c"  ")
        emit_reg(s, cond_i1)
        emit_str(s, c" = icmp ne i64 ")
        emit_reg(s, cond)
        emit_str(s, c", 0\n")

    let then_label: i32 = next_label(s)
    let else_label: i32 = next_label(s)
    let end_label: i32 = next_label(s)
    emit_str(s, c"  br i1 ")
    emit_reg(s, cond_i1)
    emit_str(s, c", label %")
    emit_label(s, then_label)
    emit_str(s, c", label %")
    emit_label(s, else_label)
    emit_str(s, c"\n")

    var result: MatchResult
    match_result_init(@result, 2)
    result.float_ty = take_match_float_hint(s)   # AGAST #1946
    # AGAST #2168: the arms' move checks merge as a match's do.
    let own_before: *i32 = own_arms_begin(s)
    var own_acc: *i32 = null
    begin_block(s, then_label)
    emit_match_arm_body(s, then_arm, 0, 0, null, 0, @result, 0, end_label)
    own_arm_end(s, @own_acc)
    own_arm_begin(s, own_before)
    begin_block(s, else_label)
    emit_match_arm_body(s, else_arm, 0, 0, null, 0, @result, 1, end_label)
    own_arm_end(s, @own_acc)
    own_arms_end(s, own_before, own_acc)
    begin_block(s, end_label)

    if result.void_arms > 0
        # AGAST #2046: an arm is a void call, so the if has no value: no phi
        # (as emit_match, #1654), and an error if the value is wanted.
        s.last_match_agg_name = null
        s.last_match_agg_name_len = 0
        s.last_match_float_ty = 0
        match_void_arms_settle(s, @result, wants_value)
        return 0

    # Publish the phi type for an untyped `let v = if ...` (#1666's path);
    # set after both arms so a nested if/match inside an arm can't clobber it.
    publish_match_type(s, @result)

    let phi_reg: i32 = next_reg(s)
    emit_str(s, c"  ")
    emit_reg(s, phi_reg)
    emit_str(s, c" = phi ")
    emit_match_phi_type(s, @result)
    var i: i32 = 0
    while i < 2
        if i > 0
            emit_str(s, c",")
        emit_str(s, c" [ ")
        emit_match_phi_value(s, @result, result.values[i])
        emit_str(s, c", %")
        emit_label(s, result.labels[i])
        emit_str(s, c" ]")
        i = i + 1
    emit_str(s, c"\n")
    return phi_reg
