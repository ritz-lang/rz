# let_check.ritz - `let` immutability (AGAST #2028, ritz0 #2026)
#
# A write (`=`, `op=`) or a mutable borrow (`@&`) whose place is a `let`'s
# own storage is a compile error: the binding itself, a by-value field of
# it, or an element of a by-value array in it, to any depth.  A path that
# leaves the binding through a pointer (`let p: *T` then `p.x`, a `*T`
# field, a slice) writes the pointee, not the binding, and stays legal.
#
# Mirrors ritz0's `_let_place` / `_check_let_write` / `_check_let_mut_borrow`
# in emitter_llvmlite.py, with ritz0's exact messages; the shared case table
# is ritz0/test_let_immutability.py (ritz0/test_ritz1_let_immutability.py
# runs it through ritz1).
#
# A binding is a `let` when its LocalVar has is_let = 1 (emit_stmt copies it
# from Stmt.var_is_let).  The lookup is by the CURRENT binding of the name,
# so a `var`, param, range variable or match binding that shadows a `let` is
# mutable, as in ritz0.  A `for x in <iterable>` element binding is a `let`
# (emit_for_iterable, AGAST #2389).
#
# Implicit mutable autoborrows (AGAST #2032, ritz0 #2029) count too: a
# `self:&` / `self: @&T` receiver or a `name:& T` / `name: @&T` argument
# that is a `let`'s own storage (let_check_implicit).

import ritzlib.sys
import ritzlib.io

import ast
import ast_helpers
import emitter_core
import emitter_expr_call   # method_callee_def (AGAST #2032)
import bool_kind           # bk_method_def (AGAST #3294)

# The type of the place reached so far along a `let`'s own storage.
struct LetPlace
    name: *u8            # the `let` binding's name
    name_len: i32
    kind: i32            # TYPE_* of the place
    type_name: *u8       # struct name when kind == TYPE_STRUCT
    type_name_len: i32
    elem: i32            # element TYPE_* when kind == TYPE_ARRAY
    elem_name: *u8       # element struct name when elem == TYPE_STRUCT
    elem_name_len: i32
    is_const: i32        # AGAST #3325: the root is a module `const` array

# AGAST #3325: a module `const A: [N]T = [...]` is read-only data
# (`internal constant`), so a write into it (`A[i] = v`, `A[i].f = v`) or a
# mutable borrow of it faulted at run time.  It is a place like a `let`'s,
# under its own message.  A local or global of the name is what it names.
fn let_place_const(s: *EmitterState, name: *u8, len: i32, out: *LetPlace) -> i32
    if find_global(s, name, len) != null
        return 0
    let ce: *ConstEntry = find_const_entry(s, name, len)
    if ce == null or ce.const_type != TYPE_ARRAY
        return 0
    out.name = ce.name
    out.name_len = ce.name_len
    out.kind = TYPE_ARRAY
    out.type_name = null
    out.type_name_len = 0
    out.elem = ce.array_elem_type
    out.elem_name = ce.array_elem_type_name
    out.elem_name_len = ce.array_elem_type_name_len
    out.is_const = 1
    return 1

# 1 and fill `out` when `name` is currently bound by a `let`.
fn let_place_root(s: *EmitterState, name: *u8, len: i32, out: *LetPlace) -> i32
    out.is_const = 0
    let idx: i32 = find_local_idx(s, name, len)
    if idx < 0
        return let_place_const(s, name, len, out)
    let loc: *LocalVar = local_at(s, idx)
    if loc.is_let != 1
        return 0
    out.name = loc.name
    out.name_len = loc.name_len
    out.kind = loc.var_type
    out.type_name = loc.type_name
    out.type_name_len = loc.type_name_len
    out.elem = loc.array_elem_type
    # LocalVar does not record an array's element struct name.  Without it a
    # `.f` past `a[i]` stays permissive (let_place_member answers 0).
    out.elem_name = null
    out.elem_name_len = 0
    return 1

# Step `out` into field `field` of a by-value struct.  0 when the place is
# not a struct value (a pointer, say), so the field lives outside the `let`.
fn let_place_member(s: *EmitterState, out: *LetPlace, field: *u8, field_len: i32) -> i32
    if out.kind != TYPE_STRUCT or out.type_name_len <= 0
        return 0
    let st: *StructDef = find_struct(s, out.type_name, out.type_name_len)
    if st == null
        return 0
    let fidx: i32 = find_field_index(st, field, field_len)
    if fidx < 0
        return 0
    let fld: *StructField = get_field_type(st, fidx)
    if fld == null
        return 0
    out.kind = fld.field_type
    out.type_name = fld.field_type_name
    out.type_name_len = fld.field_type_name_len
    out.elem = fld.array_elem_type
    out.elem_name = fld.array_elem_type_name
    out.elem_name_len = fld.array_elem_type_name_len
    return 1

# Step `out` into an element of a by-value array.  0 for a pointer or slice:
# its elements are the pointee's.
fn let_place_index(out: *LetPlace) -> i32
    if out.kind != TYPE_ARRAY
        return 0
    out.kind = out.elem
    out.type_name = out.elem_name
    out.type_name_len = out.elem_name_len
    out.elem = TYPE_VOID
    out.elem_name = null
    out.elem_name_len = 0
    return 1

# 1 when `e` (an ident / `.f` / `[i]` chain) is a `let`'s own storage.
fn let_place(s: *EmitterState, e: *Expr, out: *LetPlace) -> i32
    if e == null
        return 0
    if e.kind == EXPR_IDENT
        return let_place_root(s, e.ident_ptr, e.ident_len, out)
    if e.kind == EXPR_MEMBER
        if let_place(s, e.left, out) == 0
            return 0
        return let_place_member(s, out, e.ident_ptr, e.ident_len)
    if e.kind == EXPR_INDEX
        if let_place(s, e.left, out) == 0
            return 0
        return let_place_index(out)
    return 0

fn let_eprint_name(name: *u8, len: i32)
    var i: i32 = 0
    while i < len
        eprint_char(*(name + i))
        i += 1

# `<file>:<line>:<col>: error: <head>`<name>`<tail>`, counted.
fn let_error(s: *EmitterState, line: i32, col: i32, head: *u8, name: *u8, len: i32, tail: *u8)
    let file: *u8 = emitter_source_file()
    if file != null
        eprints_cstr(file)
    else
        eprints_cstr(c"<input>")
    eprint_char(':')
    eprint_i64(line as i64)
    eprint_char(':')
    eprint_i64(col as i64)
    eprints_cstr(c": error: ")
    eprints_cstr(head)
    let_eprint_name(name, len)
    eprints_cstr(tail)
    s.error_count = s.error_count + 1

fn let_error_assign_through(s: *EmitterState, line: i32, col: i32, pl: *LetPlace)
    if pl.is_const == 1
        let_error(s, line, col, c"cannot assign through const `", pl.name, pl.name_len, c"`; it is read-only data\n")
        return
    let_error(s, line, col, c"cannot assign through `let` binding `", pl.name, pl.name_len, c"`; declare it `var`\n")

fn let_error_assign_whole(s: *EmitterState, line: i32, col: i32, pl: *LetPlace)
    if pl.is_const == 1
        let_error(s, line, col, c"cannot assign to const `", pl.name, pl.name_len, c"`; it is read-only data\n")
        return
    let_error(s, line, col, c"cannot assign to `let` binding `", pl.name, pl.name_len, c"`; declare it `var`\n")

fn let_error_borrow(s: *EmitterState, line: i32, col: i32, pl: *LetPlace)
    if pl.is_const == 1
        let_error(s, line, col, c"cannot borrow const `", pl.name, pl.name_len, c"` as mutable; it is read-only data\n")
        return
    let_error(s, line, col, c"cannot borrow `let` binding `", pl.name, pl.name_len, c"` as mutable; declare it `var`\n")

# AGAST #2032 (ritz0 #2029): an implicit mutable borrow.  `p` is the callee
# param that `arg` (or a method receiver) binds to.  A `name:& T`,
# `name: @&T` or `self:&` param (all TYPE_MUT_REF) autoborrows its argument,
# which is #2026's explicit `@&` in disguise.  A `let` that *holds* a
# pointer is passed as that pointer, borrowing the pointee, so stays legal;
# `@&x` itself is the explicit form, reported by let_check_expr.
fn let_check_implicit(s: *EmitterState, arg: *Expr, p: *Param)
    # AGAST #2389: a bare `self:&` is a TYPE_STRUCT param marked is_self_borrow
    # (param_self_lent), the same borrow as `self:& T`.
    if p.param_type != TYPE_MUT_REF and (p.param_type != TYPE_STRUCT or p.is_self_borrow != 1)
        return
    var pl: LetPlace
    if let_place(s, arg, @pl) == 0
        return
    # A `let` that holds a pointer passes that pointer, unless `:& *U` borrows
    # its own storage (AGAST #2335).
    if pl.kind == TYPE_PTR or pl.kind == TYPE_PTR_PTR or pl.kind == TYPE_REF or pl.kind == TYPE_MUT_REF
        if borrow_arg_kind(s, arg, p) != BORROW_PLACE
            return
    let_error_borrow(s, arg.span.line, arg.span.col, @pl)

# AGAST #2403: a receiver lent to a `self: **S` is `@&recv`.
pub fn let_check_receiver(s: *EmitterState, recv: *Expr)
    var pl: LetPlace
    if let_place(s, recv, @pl) == 1
        let_error_borrow(s, recv.span.line, recv.span.col, @pl)

# AGAST #2338: `e` is `@x` of a `let`'s own storage.  It's the shared form of what
# let_check_expr refuses, and refused only where it lands in a mutable slot, which
# ref_check.ritz sees.
pub fn let_addr_of_own(s: *EmitterState, e: *Expr) -> i32
    if e.kind != EXPR_UNARY or e.op != OP_ADDR
        return 0
    var pl: LetPlace
    let_place(s, e.operand, @pl)

pub fn let_error_addr(s: *EmitterState, e: *Expr)
    var pl: LetPlace
    if let_place(s, e.operand, @pl) == 1
        let_error_borrow(s, e.span.line, e.span.col, @pl)

# Reject every `@&<let place>` in `e`.  Walks only the expression kinds
# whose children are plain sub-expressions; a match / if / struct-literal
# expression reuses those slots for other nodes, and their statements and
# arm bodies are checked when they are emitted (emit_stmt, emit_match_arm_body).
pub fn let_check_expr(s: *EmitterState, e: *Expr)
    if e == null
        return
    let k: i32 = e.kind
    if k == EXPR_UNARY
        if e.op == OP_ADDR_MUT
            var pl: LetPlace
            if let_place(s, e.operand, @pl) == 1
                let_error_borrow(s, e.span.line, e.span.col, @pl)
        let_check_expr(s, e.operand)
    else if k == EXPR_BINARY or k == EXPR_INDEX or k == EXPR_RANGE
        let_check_expr(s, e.left)
        let_check_expr(s, e.right)
    else if k == EXPR_MEMBER or k == EXPR_CAST or k == EXPR_TRY
        let_check_expr(s, e.left)
    else if k == EXPR_CALL or k == EXPR_METHOD
        # AGAST #2032: the callee's signature, for implicit `@&` autoborrows.
        var p: *Param = null
        if k == EXPR_METHOD
            let_check_expr(s, e.left)
            let m: *FnDef = method_call_def(s, e)
            if m != null
                p = m.params
                # `S.make(..)` has no receiver: its params start at the first.
                if p != null and method_recv_is_type(s, e.left) == 0
                    let_check_implicit(s, e.left, p)
                    p = p.next
        else
            let f: *FnDef = find_call_fn(s, e)
            if f != null
                p = f.params
        var a: *Expr = e.args
        while a != null
            let_check_expr(s, a)
            if p != null
                let_check_implicit(s, a, p)
                p = p.next
            a = a.next

# The write target of an assignment-kind statement, if it is a `let` place.
fn let_check_write(s: *EmitterState, stmt: *Stmt)
    let line: i32 = stmt.span.line
    let col: i32 = stmt.span.col
    var pl: LetPlace
    let k: i32 = stmt.kind
    if k == STMT_ASSIGN
        if stmt.assign_target_len > 0
            # `x = v` / `x op= v`: the whole binding.
            if let_place_root(s, stmt.assign_target, stmt.assign_target_len, @pl) == 1
                let_error_assign_whole(s, line, col, @pl)
            return
        # `expr = v`; the target expr is in if_cond.  `*p = v` (EXPR_UNARY)
        # writes the pointee and never matches.
        let target: *Expr = stmt.if_cond as *Expr
        if target == null
            return
        if target.kind == EXPR_IDENT
            if let_place_root(s, target.ident_ptr, target.ident_len, @pl) == 1
                let_error_assign_whole(s, line, col, @pl)
            return
        if target.kind == EXPR_MEMBER or target.kind == EXPR_INDEX
            if let_place(s, target, @pl) == 1
                let_error_assign_through(s, line, col, @pl)
        return
    if k == STMT_INDEX_ASSIGN
        # `name[i] = v`
        if let_place_root(s, stmt.assign_target, stmt.assign_target_len, @pl) == 1
            if let_place_index(@pl) == 1
                let_error_assign_through(s, line, col, @pl)
        return
    if k == STMT_LOCAL_FIELD_ASSIGN
        # `name.f = v`
        if let_place_root(s, stmt.var_name, stmt.var_name_len, @pl) == 1
            if let_place_member(s, @pl, stmt.assign_target, stmt.assign_target_len) == 1
                let_error_assign_through(s, line, col, @pl)
        return
    if k == STMT_LOCAL_FIELD_INDEX_ASSIGN
        # `name.f[i] = v`
        if let_place_root(s, stmt.var_name, stmt.var_name_len, @pl) == 1
            if let_place_member(s, @pl, stmt.assign_target, stmt.assign_target_len) == 1
                if let_place_index(@pl) == 1
                    let_error_assign_through(s, line, col, @pl)
        return
    # STMT_MEMBER_ASSIGN / STMT_MEMBER_INDEX_ASSIGN are `(*p).f = v`: through
    # a pointer, always legal.

# AGAST #2293: `let d: D = c` / `var d: D = c` with `c` a struct of another
# type.  It used to reach clang as `store %C ..., %D` (or the `ptr` a `c:& C`
# reads as).  ritz0's _reject_another_struct gives the same message at the
# same place (ritz0/let_rules.py).  Only two known structs that differ by name
# are refused: a cast names its operand's type here, a Span$u8 converts to a
# StrView (#168) but not back (#3441), and an enum or a name find_struct doesn't know (an
# alias) is left to the store.
fn let_check_another_struct(s: *EmitterState, stmt: *Stmt)
    if stmt.var_declared_type != TYPE_STRUCT
        return
    var src: *u8 = null
    var src_len: i32 = 0
    if another_struct_source(s, stmt.var_init, stmt.var_type_name, stmt.var_type_name_len, @src, @src_len) == 0
        return
    let_error(s, stmt.span.line, stmt.span.col, c"`", stmt.var_name, stmt.var_name_len, c"` is declared `")
    let_eprint_name(stmt.var_type_name, stmt.var_type_name_len)
    eprints_cstr(c"` but its initialiser is a `")
    let_eprint_name(src, src_len)
    eprints_cstr(c"`\n")

# 1 when `init` is a known struct of another type than the known struct `want`,
# with its name in `*out` / `*out_len` (AGAST #2293, #3293).
fn another_struct_source(s: *EmitterState, init: *Expr, want: *u8, want_len: i32, out: **u8, out_len: *i32) -> i32
    if init == null or init.kind == EXPR_CAST
        return 0
    if want == null or want_len <= 0
        return 0
    var src: *u8 = null
    var src_len: i32 = 0
    resolve_expr_struct_name(s, init, @src, @src_len)
    # A `c:& C` param is a TYPE_MUT_REF local naming its referent (#2250).
    let lent: *LocalVar = lent_local(s, init)
    if src == null and lent != null and lent.var_type == TYPE_MUT_REF
        src = lent.type_name
        src_len = lent.type_name_len
    if src == null or src_len <= 0
        return 0
    # AGAST #3579: a local bound to an unannotated `"..."` lowers to the
    # literal's `%Span$u8` but is a StrView value, as in ritz0.
    if init.kind == EXPR_IDENT and lent == null
        let sv: *LocalVar = find_local_struct_name(s, init.ident_ptr, init.ident_len)
        if sv != null and sv.str_view == 1
            src = c"StrView"
            src_len = 7
    if name_eq(src, src_len, want, want_len) == 1
        return 0
    # AGAST #3441 (R49): of that pair only a `"..."` fits a `Span<u8>` slot, and
    # it reads as a `Span$u8` here; a StrView value never converts.  The other
    # way stays a conversion: a local bound to a `"..."` is a `Span$u8` here but
    # a StrView in ritz0.
    if is_layout_equiv_pair(src, src_len, want, want_len) == 1 and name_eq(src, src_len, c"StrView", 7) == 0
        return 0
    if find_struct(s, src, src_len) == null or find_struct(s, want, want_len) == null
        return 0
    *out = src
    *out_len = src_len
    return 1

# `let s: String = "abc"`: 1 when it reported one.  With no `String` in scope
# (no `import ritzlib.string`, AGAST #3347) the literal has nothing to become:
# ritz1 stored its `{ ptr, len }` into an undeclared `%String`.  With one, LARB
# R49 (AGAST #3361, #3393) refuses it anyway: a literal is a `StrView`, or a
# `*u8` in a `*u8` slot, and nothing else converts (LANGUAGE_SPEC 3.5).  ritz1
# used to say "`s` is declared `String` but its initialiser is a `Span$u8`", at
# the `let`.  ritz0's _refuse_string_literal gives the same words, at the literal.
fn let_check_string_lit(s: *EmitterState, stmt: *Stmt) -> i32
    let init: *Expr = stmt.var_init
    if init == null or init.kind != EXPR_STRING_LIT
        return 0
    if name_eq(stmt.var_type_name, stmt.var_type_name_len, c"String", 6) == 0
        return 0
    if find_struct(s, c"String", 6) != null
        let_error(s, init.span.line, init.span.col, c"", null, 0, c"a string literal is not a `String`: write `string_from(")
        let_eprint_source_quote(init.string_ptr, init.string_len)
        eprints_cstr(c")`\n")
        return 1
    let_error(s, init.span.line, init.span.col, c"", null, 0, c"`String` is not built in: `import ritzlib.string` to make one from a string literal\n")
    # AGAST #3362: that names the mistake; a later `s.len` doesn't say it again.
    s.unknown_struct_name = c"String"
    s.unknown_struct_name_len = 6
    return 1

# A literal's bytes as the "..." that writes them: `"`, `\\`, newline, tab, CR
# and NUL escaped, every other byte (UTF-8 included) as itself.  ritz0's
# _source_quote matches.
fn let_eprint_source_quote(p: *u8, n: i32)
    eprint_char('"')
    var i: i32 = 0
    while i < n
        let c: u8 = p[i]
        if c == '"'
            eprints_cstr(c"\\\"")
        else if c == '\\'
            eprints_cstr(c"\\\\")
        else if c == '\n'
            eprints_cstr(c"\\n")
        else if c == '\t'
            eprints_cstr(c"\\t")
        else if c == '\r'
            eprints_cstr(c"\\r")
        else if c == 0
            eprints_cstr(c"\\0")
        else
            eprint_char(c)
        i = i + 1
    eprint_char('"')

# AGAST #3293: `return c` or a tail `c`, with `c` a struct of another type than
# the fn's `-> D`.  ritz1 loaded the `C` local's slot as a `%D` and returned it:
# the bytes of a `C`, read as a `D`, with no error.  ritz0's
# _reject_another_struct_return gives the same message (ritz0/let_rules.py).
# (line, col) is the `return`, or the tail value.  1 when refused.
pub fn return_check_another_struct(s: *EmitterState, e: *Expr, ret_type: i32, line: i32, col: i32) -> i32
    if ret_type != TYPE_STRUCT
        return 0
    var src: *u8 = null
    var src_len: i32 = 0
    if another_struct_source(s, e, s.ret_type_name, s.ret_type_name_len, @src, @src_len) == 0
        return 0
    let_error(s, line, col, c"the fn is declared `-> ", s.ret_type_name, s.ret_type_name_len, c"` but its return value is a `")
    let_eprint_name(src, src_len)
    eprints_cstr(c"`\n")
    return 1

# AGAST #3294: the same rule at a store, `d = c` / `v.d = c`, with `c` a struct
# of another type than the local or field.  It reached clang as `store %C ...`
# into the `%D`.  ritz0 reads it back from llvmlite's store complaint
# (_store_mismatch_message) and gives the same message.
fn let_check_another_struct_store(s: *EmitterState, stmt: *Stmt)
    var want: *u8 = null
    var want_len: i32 = 0
    if stmt.kind == STMT_ASSIGN
        if stmt.assign_target_len <= 0
            return
        let loc: *LocalVar = find_local_struct_name(s, stmt.assign_target, stmt.assign_target_len)
        if loc == null or loc.var_type != TYPE_STRUCT
            return
        want = loc.type_name
        want_len = loc.type_name_len
    else if stmt.kind == STMT_LOCAL_FIELD_ASSIGN
        let base: *LocalVar = find_local_struct_name(s, stmt.var_name, stmt.var_name_len)
        if base == null
            return
        let st: *StructDef = find_struct(s, base.type_name, base.type_name_len)
        if st == null
            return
        let idx: i32 = find_field_index(st, stmt.assign_target, stmt.assign_target_len)
        if idx < 0
            return
        let f: *StructField = get_field_type(st, idx)
        if f.field_type != TYPE_STRUCT
            return
        want = f.field_type_name
        want_len = f.field_type_name_len
    else
        return
    var src: *u8 = null
    var src_len: i32 = 0
    if another_struct_source(s, stmt.assign_value, want, want_len, @src, @src_len) == 0
        return
    if stmt.kind == STMT_ASSIGN
        let_error(s, stmt.span.line, stmt.span.col, c"`", stmt.assign_target, stmt.assign_target_len, c"` is declared `")
    else
        let_error(s, stmt.span.line, stmt.span.col, c"field `", stmt.assign_target, stmt.assign_target_len, c"` is declared `")
    let_eprint_name(want, want_len)
    eprints_cstr(c"` but the value assigned is a `")
    let_eprint_name(src, src_len)
    eprints_cstr(c"`\n")

# AGAST #3294: argument `a` for by-value param `p`, a struct of another type.
# It reached clang as a `%C` passed to the `%D`.  let_another_struct_call /
# _method pair them, for a call, a fn-pointer call and a method; ritz0's
# _another_struct_arg_message gives the same message, at the argument.
pub fn let_check_another_struct_arg(s: *EmitterState, p: *Param, a: *Expr)
    if p.param_type != TYPE_STRUCT or p.is_borrow == 1
        return
    var src: *u8 = null
    var src_len: i32 = 0
    if another_struct_source(s, a, p.param_type_name, p.param_type_name_len, @src, @src_len) == 0
        return
    let_error(s, a.span.line, a.span.col, c"parameter `", p.name, p.name_len, c"` is declared `")
    let_eprint_name(p.param_type_name, p.param_type_name_len)
    eprints_cstr(c"` but its argument is a `")
    let_eprint_name(src, src_len)
    eprints_cstr(c"`\n")

fn let_another_struct_args(s: *EmitterState, params: *Param, args: *Expr)
    var p: *Param = params
    var a: *Expr = args
    while p != null and a != null
        let_check_another_struct_arg(s, p, a)
        p = p.next
        a = a.next

# A named call's arguments against its callee's params: a fn-pointer local's
# signature, else the fn.  (bool_check paired them until it moved onto Sema,
# AGAST #3502; this rule moves with let_check, #3504.)
pub fn let_another_struct_call(s: *EmitterState, e: *Expr)
    if e.func_name_len == 0
        return
    let idx: i32 = find_local_idx(s, e.func_name, e.func_name_len)
    if idx >= 0
        let sig: *FnDef = local_at(s, idx).fn_sig
        if sig != null
            let_another_struct_args(s, sig.params, e.args)
        return
    let fd: *FnDef = find_call_fn(s, e)
    if fd != null
        let_another_struct_args(s, fd.params, e.args)

# A method call's arguments against its callee's params after the receiver
# (`self`, or a UFCS helper's first param).
pub fn let_another_struct_method(s: *EmitterState, e: *Expr)
    let fd: *FnDef = bk_method_def(s, e)
    if fd == null or fd.params == null
        return
    if name_eq(fd.params.name, fd.params.name_len, c"self", 4) == 1 or bk_method_is_ufcs(s, e, fd) == 1
        let_another_struct_args(s, fd.params.next, e.args)
    else
        let_another_struct_args(s, fd.params, e.args)

# Check one statement before it is emitted: its own write target, and every
# `@&` in the expressions it evaluates.  Nested statement lists (if / while /
# for bodies, match arms) are checked as emit_stmt reaches them, when the
# bindings in scope are the ones that statement sees.
pub fn let_check_stmt(s: *EmitterState, stmt: *Stmt)
    let k: i32 = stmt.kind
    if k == STMT_VAR_DECL or k == STMT_TUPLE_DECL
        let_check_expr(s, stmt.var_init)
        if k == STMT_VAR_DECL
            if let_check_string_lit(s, stmt) == 0   # AGAST #3347, LARB R49
                let_check_another_struct(s, stmt)
        return
    if k == STMT_ASSIGN or k == STMT_INDEX_ASSIGN or k == STMT_LOCAL_FIELD_ASSIGN or k == STMT_LOCAL_FIELD_INDEX_ASSIGN or k == STMT_MEMBER_ASSIGN or k == STMT_MEMBER_INDEX_ASSIGN
        let_check_write(s, stmt)
        let_check_expr(s, stmt.assign_value)
        let_check_another_struct_store(s, stmt)   # AGAST #3294
        if k == STMT_INDEX_ASSIGN or k == STMT_LOCAL_FIELD_INDEX_ASSIGN or k == STMT_MEMBER_INDEX_ASSIGN
            let_check_expr(s, stmt.while_cond)
        return
    if k == STMT_RETURN
        let_check_expr(s, stmt.return_value)
    else if k == STMT_EXPR
        let_check_expr(s, stmt.expr)
    else if k == STMT_IF or k == STMT_ASSERT
        let_check_expr(s, stmt.if_cond)
    else if k == STMT_WHILE
        let_check_expr(s, stmt.while_cond)
    else if k == STMT_FOR
        let_check_expr(s, stmt.for_start)
        let_check_expr(s, stmt.for_end)

# After emit_var_decl: mark the binding it registered as a `let`, and (#3579)
# one bound to an unannotated `"..."` as a StrView value.  `before` is
# s.local_count before the decl, so a decl that registered nothing never marks
# an outer binding of the same name.
pub fn let_mark_decl(s: *EmitterState, stmt: *Stmt, before: i32)
    let idx: i32 = find_local_idx(s, stmt.var_name, stmt.var_name_len)
    if idx < before
        return
    let loc: *LocalVar = local_at(s, idx)
    if stmt.var_declared_type == TYPE_VOID and stmt.var_init != null and stmt.var_init.kind == EXPR_STRING_LIT
        loc.str_view = 1
    if stmt.var_is_let == 1
        loc.is_let = 1
