# let_check.ritz - `let` immutability (AGAST #2028, ritz0 #2026), on Sema
#
# A write (`=`, `op=`) or a mutable borrow (`@&`) whose place is a `let`'s
# own storage is a compile error: the binding itself, a by-value field of
# it, or an element of a by-value array in it, to any depth.  A path that
# leaves the binding through a pointer (`let p: *T` then `p.x`, a `*T`
# field, a slice) writes the pointee, not the binding, and stays legal.
#
# Mirrors ritz0's `_let_place` / `_check_let_write` / `_check_let_mut_borrow`
# in emitter_llvmlite.py, with ritz0's exact messages; the shared case table
# is ritz0/test_let_immutability.py (ritz0/test_ritz1_let_immutability.py
# runs it through ritz1).
#
# AGAST #3504 (#1816): the checks run on Sema, from sema_walk.ritz, before
# emit_module: a refused program never reaches the emitter.  They read
# Sema's lexical scope, where SemaVar.is_let marks a `let` (and a
# `for x in <iterable>` element, AGAST #2389), and SemaVar.let_* records the
# local as the emitter's LocalVar does (let_note_decl / _param / _for).  The
# lookup is by the CURRENT binding of the name, so a `var`, param, range
# variable or match binding that shadows a `let` is mutable, as in ritz0.
# Where Sema can't type a local (let_kind TypeKind.Unknown) a check that needs
# its type stays quiet: a missed refusal is a parity gap, a false one would
# refuse a valid program.
#
# The place rule itself (let_place) is one copy over a LetEnv, which reads
# either Sema's scope or the emitter's locals: ref_check.ritz, still on the
# emitter, asks let_addr_of_own / let_error_addr about an `@x` (AGAST #2338).
#
# Implicit mutable autoborrows (AGAST #2032, ritz0 #2029) count too: a
# `self:&` / `self: @&T` receiver or a `name:& T` / `name: @&T` argument
# that is a `let`'s own storage (let_check_implicit).

import ritzlib.cstr
import ritzlib.strview
import ritzlib.sys
import ritzlib.io
import ritzlib.str      # memcmp, for the payload's mangled prefix (AGAST #4458)

import ast
import diag   # diag_error_at, diag_loc (AGAST #3621)
import ast_helpers
import types             # ty_from_name, TYPE_* (AGAST #4458)
import emitter_core      # pure helpers: name_eq, find_field_index, ...
import sema
import sema_type
import bool_check        # Sema's resolvers: sbk_method_def, sbk_receiver, ...
import emitter_types   # index_through, merged into it (AGAST #1818)
import ast_query         # is_tagged_enum_type, tagged_enum_arg_in, user_enum_index

# Where a place lookup reads: the emitter's locals (s), or Sema's scope (sm).
struct LetEnv
    s: *EmitterState
    sm: *Sema

# The type of the place reached so far along a `let`'s own storage.
struct LetPlace
    name: *u8            # the `let` binding's name
    name_len: i32
    kind: TypeKind            # TYPE_* of the place; TypeKind.Unknown when Sema can't say
    type_name: *u8       # struct name when kind == TypeKind.Struct (or a pointer's pointee)
    type_name_len: i32
    elem: TypeKind            # element TYPE_* when kind == TypeKind.Array
    elem_name: *u8       # element struct name when elem == TypeKind.Struct
    elem_name_len: i32
    is_const: i32        # AGAST #3325: the root is a module `const` array
    pointee: TypeKind         # the pointee's TYPE_* when kind is a pointer
    inner: i32           # a `**T` place's inner-pointee slot
    tuple: i32           # 1 for a nameless tuple's root: its fields are unnamed
    # AGAST #4071: an N-D `[N][M]..T` array place's shape, and how many of its
    # dimensions the path has indexed; null / 0 for a 1-D array or a non-array.
    shape: *ArrayShape
    depth: i32

fn let_find_struct(env: *LetEnv, name_sv: StrView) -> *StructDef
    var name: *u8 = name_sv.ptr
    if env.s != null
        return find_struct(env.s, name_sv)
    sema_find_struct(env.sm, name_sv)

# AGAST #3325: a module `const A: [N]T = [...]` is read-only data
# (`internal constant`), so a write into it (`A[i] = v`, `A[i].f = v`) or a
# mutable borrow of it faulted at run time.  It is a place like a `let`'s,
# under its own message.  A local or global of the name is what it names.
fn let_place_const(env: *LetEnv, name_sv: StrView, out: *LetPlace) -> i32
    var ce: *ConstEntry = null
    if env.s != null
        if find_global(env.s, name_sv) != null
            return 0
        ce = find_const_entry(env.s, name_sv)
    else
        if sbk_global(env.sm, name_sv) != null
            return 0
        ce = sbk_const(env.sm, name_sv)
    if ce == null or (ce.const_type != TypeKind.Array and ce.const_type != TypeKind.Struct)
        return 0
    out.name = ce.name
    out.name_len = ce.name_len
    out.kind = ce.const_type
    out.type_name = null
    out.type_name_len = 0
    out.elem = TypeKind.Void
    out.elem_name = null
    out.elem_name_len = 0
    if ce.const_type == TypeKind.Array
        out.elem = ce.array_elem_type
        out.elem_name = ce.array_elem_type_name
        out.elem_name_len = ce.array_elem_type_name_len
    else
        # LARB R60 / R48: a struct or enum const is read-only data too, so a
        # write into it (`C.k = 2`) or a mutable borrow is refused as a const
        # array's is.
        out.type_name = ce.type_name
        out.type_name_len = ce.type_name_len
    out.is_const = 1
    return 1

# `sh` when it is an N-D shape (rank >= 2), else null.
fn let_nd_shape(sh: *ArrayShape) -> *ArrayShape
    if sh == null or sh.rank < 2
        return null
    sh

# 1 and fill `out` when `name` is currently bound by a `let`.
fn let_place_root(env: *LetEnv, name_sv: StrView, out: *LetPlace) -> i32
    var name: *u8 = name_sv.ptr
    out.is_const = 0
    out.pointee = TypeKind.Void
    out.inner = (TypeKind.Void as i32)
    out.tuple = 0
    out.shape = null
    out.depth = 0
    # LocalVar does not record an array's element struct name; SemaVar's
    # let_name does.  Without it a `.f` past `a[i]` stays permissive
    # (let_place_member answers 0).
    out.elem_name = null
    out.elem_name_len = 0
    if env.s == null
        let v: *SemaVar = sema_find_local(env.sm, name_sv)
        if v == null
            return let_place_const(env, name_sv, out)
        if v.is_let != 1
            return 0
        out.name = v.name
        out.name_len = v.name_len
        out.kind = v.let_kind
        out.type_name = v.let_name
        out.type_name_len = v.let_name_len
        out.elem = v.let_elem
        out.pointee = v.let_pointee
        out.inner = v.inner
        out.tuple = v.tuple
        # AGAST #3399: a 1-D array's let_name is its element struct.
        if v.let_kind == TypeKind.Array and v.let_elem == TypeKind.Struct
            out.elem_name = v.let_name
            out.elem_name_len = v.let_name_len
        # AGAST #4071: an N-D array's element struct is its shape's leaf.
        if v.let_kind == TypeKind.Array
            out.shape = let_nd_shape(v.shape)
        return 1
    let idx: i32 = find_local_idx(env.s, name_sv)
    if idx < 0
        return let_place_const(env, name_sv, out)
    let loc: *LocalVar = local_at(env.s, idx)
    if loc.is_let != 1
        return 0
    out.name = loc.name
    out.name_len = loc.name_len
    out.kind = lv_var_type(loc)
    out.type_name = lv_type_name(loc)
    out.type_name_len = lv_type_name_len(loc)
    out.elem = lv_array_elem_type(loc)
    out.pointee = lv_pointee_type(loc)
    out.inner = lv_inner_pointee_type(loc)
    return 1

# Step `out` into field `field` of a by-value struct.  0 when the place is
# not a struct value (a pointer, say), so the field lives outside the `let`.
fn let_place_member(env: *LetEnv, out: *LetPlace, field_sv: StrView) -> i32
    var field: *u8 = field_sv.ptr
    if out.kind == TypeKind.Struct and out.tuple == 1
        # `p.0` of `let p = (1, 2)`: the emitter names the tuple's struct
        # only as it lowers it, and Sema's own (`(tuple)N`, AGAST #4251) is
        # none let_find_struct finds.  The field is the `let`'s own storage.
        out.kind = TypeKind.Unknown
        out.tuple = 0
        out.type_name = null
        out.type_name_len = 0
        return 1
    if out.kind != TypeKind.Struct or out.type_name_len <= 0
        return 0
    let st: *StructDef = let_find_struct(env, StrView { ptr: (out.type_name), len: (out.type_name_len) as i64 })
    if st == null
        return 0
    let fidx: i32 = find_field_index(st, field_sv)
    if fidx < 0
        return 0
    let fld: *StructField = get_field_type(st, fidx)
    if fld == null
        return 0
    out.kind = fld.field_type
    out.type_name = fld.field_type_name
    out.type_name_len = fld.field_type_name_len
    out.elem = fld.array_elem_type
    out.elem_name = fld.array_elem_type_name
    out.elem_name_len = fld.array_elem_type_name_len
    out.pointee = fld.ptr_pointee
    out.inner = fld.inner_pointee_type
    out.shape = null
    out.depth = 0
    if fld.field_type == TypeKind.Array
        out.shape = let_nd_shape(fld.array_shape)
    return 1

# Step `out` into an element of a by-value array.  0 for a pointer or slice:
# its elements are the pointee's.
fn let_place_index(out: *LetPlace) -> i32
    if out.kind != TypeKind.Array
        return 0
    # AGAST #4071: an N-D array stays an array until the path indexes every
    # dimension, then is its leaf `T`: `g[1][0]` of `[2][2]Pt` is a Pt.
    if out.shape != null
        out.depth = out.depth + 1
        if out.depth < out.shape.rank
            return 1
        out.kind = out.shape.leaf_type
        out.type_name = out.shape.leaf_name.ptr
        out.type_name_len = out.shape.leaf_name.len as i32
        out.pointee = out.shape.leaf_pointee
        out.shape = null
        out.depth = 0
        out.elem = TypeKind.Void
        out.elem_name = null
        out.elem_name_len = 0
        out.inner = (TypeKind.Void as i32)
        return 1
    out.kind = out.elem
    out.type_name = out.elem_name
    out.type_name_len = out.elem_name_len
    out.elem = TypeKind.Void
    out.elem_name = null
    out.elem_name_len = 0
    out.pointee = TypeKind.Void
    out.inner = (TypeKind.Void as i32)
    return 1

# 1 when `e` (an ident / `.f` / `[i]` chain) is a `let`'s own storage.
fn let_place(env: *LetEnv, e: *Expr, out: *LetPlace) -> i32
    if e == null
        return 0
    match e.kind
        ExprKind.Ident =>
            return let_place_root(env, e.ident, out)
        ExprKind.Member =>
            if let_place(env, e.left, out) == 0
                return 0
            return let_place_member(env, out, e.ident)
        ExprKind.Index =>
            if let_place(env, e.left, out) == 0
                return 0
            return let_place_index(out)
        _ => pass
    return 0

fn let_eprint_name(name_sv: StrView)
    var name: *u8 = name_sv.ptr
    var len: i32 = name_sv.len as i32
    var i: i32 = 0
    while i < len
        eprint_char(*(name + i))
        i += 1

# `<file>:<line>:<col>: error: <head>`<name>`<tail>`, counted on the env's
# pass.  Sema names the input file, as the emitter did.
fn let_error(env: *LetEnv, line: i32, col: i32, head: StrView, name: StrView, tail: StrView)
    if env.s != null
        diag_error_at(emitter_source_file(), diag_span(line, col))   # AGAST #3621
        env.s.diag.error_count = env.s.diag.error_count + 1
    else
        sema_error_at(env.sm, line, col)
    eprints(head)
    let_eprint_name(name)
    eprints(tail)

fn let_error_assign_through(env: *LetEnv, line: i32, col: i32, pl: *LetPlace)
    if pl.is_const == 1
        let_error(env, line, col, "cannot assign through const `", StrView { ptr: (pl.name), len: (pl.name_len) as i64 }, "`; it is read-only data\n")
        return
    let_error(env, line, col, "cannot assign through `let` binding `", StrView { ptr: (pl.name), len: (pl.name_len) as i64 }, "`; declare it `var`\n")

fn let_error_assign_whole(env: *LetEnv, line: i32, col: i32, pl: *LetPlace)
    if pl.is_const == 1
        let_error(env, line, col, "cannot assign to const `", StrView { ptr: (pl.name), len: (pl.name_len) as i64 }, "`; it is read-only data\n")
        return
    let_error(env, line, col, "cannot assign to `let` binding `", StrView { ptr: (pl.name), len: (pl.name_len) as i64 }, "`; declare it `var`\n")

fn let_error_borrow(env: *LetEnv, line: i32, col: i32, pl: *LetPlace)
    if pl.is_const == 1
        let_error(env, line, col, "cannot borrow const `", StrView { ptr: (pl.name), len: (pl.name_len) as i64 }, "` as mutable; it is read-only data\n")
        return
    let_error(env, line, col, "cannot borrow `let` binding `", StrView { ptr: (pl.name), len: (pl.name_len) as i64 }, "` as mutable; declare it `var`\n")

fn let_sema_env(sm: *Sema, env: *LetEnv)
    env.s = null
    env.sm = sm

# =============================================================================
# For ref_value.ritz's `@&T` slot check, on Sema (AGAST #2338, #4011)
# =============================================================================

# `e` is `@x` of a `let`'s own storage.  It's the shared form of what
# let_check_expr refuses, and refused only where it lands in a mutable slot,
# which ref_value.ritz sees.
pub fn let_addr_of_own(sm: *Sema, e: *Expr) -> i32
    if e.kind != ExprKind.Unary or e.op != OpKind.Addr
        return 0
    var env: LetEnv
    let_sema_env(sm, @env)
    var pl: LetPlace
    let_place(@env, e.operand, @pl)

pub fn let_error_addr(sm: *Sema, e: *Expr)
    var env: LetEnv
    let_sema_env(sm, @env)
    var pl: LetPlace
    if let_place(@env, e.operand, @pl) == 1
        let_error_borrow(@env, e.span.line, e.span.col, @pl)

# =============================================================================
# Sema's local table: what each binding is (let_note_*)
# =============================================================================

fn let_last(sm: *Sema) -> *SemaVar
    if sm.scope_top <= 0
        return null
    @sm.scope[sm.scope_top - 1]

# 1 when `e` is a tuple literal nothing has named: `(1, 2)`.
fn let_tuple_lit(e: *Expr) -> i32
    if e == null or e.kind != ExprKind.StructLit or e.ident.len != 0
        return 0
    let fi: *FieldInit = e.args as *FieldInit
    if fi == null or fi.name_len != 1 or *fi.name != '0'  # '0'
        return 0
    1

fn let_set_value(kind: TypeKind, name_sv: StrView, out_kind: *TypeKind, out_name: **u8, out_len: *i32) -> i32
    var name: *u8 = name_sv.ptr
    var name_len: i32 = name_sv.len as i32
    if kind == TypeKind.Struct and name_len <= 0
        return 0
    if kind == TypeKind.Struct or kind == TypeKind.Bool or kind == TypeKind.F32 or kind == TypeKind.F64 or sema_is_int_kind(kind) == 1
        *out_kind = kind
        *out_name = name
        *out_len = name_len
        if kind != TypeKind.Struct
            *out_name = null
            *out_len = 0
        return 1
    0

# What an untyped `let x = e` holds where sema_expr_ty can't say but the
# emitter types it anyway: a method's result, an element of an array, a
# field reached through what Sema's resolvers name, an `if` / `match` arm's
# value.  1 and the kind (and a struct's name) for a struct or scalar value;
# 0 otherwise, a pointer included (its pointee isn't recorded here).
fn let_value_ty(sm: *Sema, e: *Expr, out_kind: *TypeKind, out_name: **u8, out_len: *i32, depth: i32) -> i32
    if e == null or depth > 8
        return 0
    var t: SemaTy
    let k: TypeKind = sema_expr_ty(sm, e, @t)
    if k != TypeKind.Unknown
        return let_set_value(k, StrView { ptr: (t.name), len: (t.name_len) as i64 }, out_kind, out_name, out_len)
    match e.kind
        ExprKind.Method =>
            # StrView.as_bytes() is a `Span$u8` (resolve_expr_struct_name).
            if name_eq(e.ident, "as_bytes") == 1
                return let_set_value(TypeKind.Struct, "Span$u8", out_kind, out_name, out_len)
            if e.args == null and name_eq(e.ident, "unwrap") == 1
                # `r.unwrap()` of an Option$S / Result$S$E is an S.
                var un: *u8 = null
                var ul: i32 = 0
                sbk_receiver(sm, e, @un, @ul)
                return let_set_value(TypeKind.Struct, StrView { ptr: (un), len: (ul) as i64 }, out_kind, out_name, out_len)
            let fd: *FnDef = sbk_method_def(sm, e)
            if fd == null
                return 0
            return let_set_value(fd.return_type, StrView { ptr: (fd.return_type_name), len: (fd.return_type_name_len) as i64 }, out_kind, out_name, out_len)
        ExprKind.Index =>
            if e.right != null and e.right.kind == ExprKind.Range
                return 0
            let b: *Expr = e.left
            if b == null
                return 0
            if b.kind == ExprKind.Ident
                let lv: *SemaVar = sema_find_local(sm, b.ident)
                if lv != null
                    if lv.let_kind != TypeKind.Array or lv.let_elem == TypeKind.Array
                        return 0
                    return let_set_value(lv.let_elem, StrView { ptr: (lv.let_name), len: (lv.let_name_len) as i64 }, out_kind, out_name, out_len)
                let g: *GlobalVarDef = sbk_global(sm, b.ident)
                if g != null and g.var_type == TypeKind.Array and g.array_elem_type != TypeKind.Array
                    return let_set_value(g.array_elem_type, StrView { ptr: (g.array_elem_type_name), len: (g.array_elem_type_name_len) as i64 }, out_kind, out_name, out_len)
                return 0
            if b.kind == ExprKind.Member
                let f: *StructField = sbk_member_field(sm, b)
                if f != null and f.field_type == TypeKind.Array and f.array_elem_type != TypeKind.Array
                    return let_set_value(f.array_elem_type, StrView { ptr: (f.array_elem_type_name), len: (f.array_elem_type_name_len) as i64 }, out_kind, out_name, out_len)
            return 0
        ExprKind.Member =>
            let f: *StructField = sbk_member_field(sm, e)
            if f == null
                return 0
            return let_set_value(f.field_type, StrView { ptr: (f.field_type_name), len: (f.field_type_name_len) as i64 }, out_kind, out_name, out_len)
        _ => pass
    if e.kind == ExprKind.If or e.kind == ExprKind.Match
        # The first arm with a value says what the merged value is.
        var arm: *MatchArm = e.args as *MatchArm
        while arm != null
            if arm.is_pass == 0 and arm.body != null
                return let_value_ty(sm, arm.body, out_kind, out_name, out_len, depth + 1)
            arm = arm.next
    0

# AGAST #4458: `let x = r.unwrap()` whose Option / Result payload is a
# reference or pointer (`Option<@&Font>`, `Option<*T>`): the kind, the pointee
# and its name, as the emitter's unwrap_payload_pointer_type types the slot.
# let_value_ty's unwrap arm names only a struct payload, so such a local stayed
# an untyped i64 for Sema's checks and call_check refused passing it.
# `r`'s mangled carrier name comes from sbk_receiver, the payload from
# tagged_enum_arg_in (the same `ref_` / `refmut_` / `ptr_` spelling the emitter
# reads).  Returns 1 when it typed the payload, 0 otherwise.
pub fn let_unwrap_payload_pointer(sm: *Sema, e: *Expr, out_kind: *TypeKind, out_name: **u8, out_len: *i32, out_pointee: *TypeKind) -> i32
    *out_kind = TypeKind.Void
    *out_name = null
    *out_len = 0
    *out_pointee = TypeKind.Void
    if e == null or e.kind != ExprKind.Method or e.left == null
        return 0
    let is_unwrap: bool = e.args == null and name_eq(e.ident, "unwrap") == 1
    let is_unwrap_or: bool = e.args != null and e.args.next == null and name_eq(e.ident, "unwrap_or") == 1
    if not is_unwrap and not is_unwrap_or
        return 0
    var en: *u8 = null
    var en_len: i32 = 0
    sbk_receiver(sm, e.left, @en, @en_len)
    if en == null or en_len <= 0 or is_tagged_enum_type(StrView { ptr: (en), len: (en_len) as i64 }) == 0
        return 0
    var pay_len: i32 = 0
    let pay: *u8 = tagged_enum_arg_in(sm.pctx, @sm.struct_map, sm.module, StrView { ptr: (en), len: (en_len) as i64 }, 0, @pay_len)
    if pay == null or pay_len <= 0
        return 0
    var kind: TypeKind = TypeKind.Void
    var skip: i32 = 0
    if pay_len > 7 and (StrView { ptr: (pay), len: (pay_len) as i64 }).starts_with("refmut_")
        kind = TypeKind.MutRef
        skip = 7
    else if pay_len > 4 and (StrView { ptr: (pay), len: (pay_len) as i64 }).starts_with("ref_")
        kind = TypeKind.Ref
        skip = 4
    else if pay_len > 4 and (StrView { ptr: (pay), len: (pay_len) as i64 }).starts_with("ptr_")
        kind = TypeKind.Ptr
        skip = 4
    else
        return 0
    let base: *u8 = pay + skip
    let base_len: i32 = pay_len - skip
    if base_len <= 0
        return 0
    if base_len > 4 and (StrView { ptr: (base), len: (base_len) as i64 }).starts_with("ptr_")
        let inner: *u8 = base + 4
        let inner_len: i32 = base_len - 4
        if inner_len <= 0
            return 0
        if kind == TypeKind.Ptr
            *out_kind = TypeKind.PtrPtr
            if sema_find_struct(sm, StrView { ptr: (inner), len: (inner_len) as i64 }) != null
                *out_name = inner
                *out_len = inner_len
            else if ty_from_name(StrView { ptr: (inner), len: (inner_len) as i64 }) == TypeKind.Void and is_tagged_enum_type(StrView { ptr: (inner), len: (inner_len) as i64 }) == 0 and user_enum_index(sm.pctx, StrView { ptr: (inner), len: (inner_len) as i64 }) < 0
                return 0
        else
            *out_kind = kind
        *out_pointee = TypeKind.Ptr
        return 1
    if sema_find_struct(sm, StrView { ptr: (base), len: (base_len) as i64 }) != null or is_tagged_enum_type(StrView { ptr: (base), len: (base_len) as i64 }) == 1 or user_enum_index(sm.pctx, StrView { ptr: (base), len: (base_len) as i64 }) >= 0
        *out_kind = kind
        *out_name = base
        *out_len = base_len
        *out_pointee = TypeKind.Struct
        return 1
    let prim: TypeKind = ty_from_name(StrView { ptr: (base), len: (base_len) as i64 })
    if prim == TypeKind.Void
        return 0
    *out_kind = kind
    *out_pointee = prim
    1

# let_unwrap_payload_pointer onto the binding, keeping the fields untouched
# when it can't type it.
fn let_note_unwrap_pointer(sm: *Sema, init: *Expr, v: *SemaVar) -> i32
    var k: TypeKind = TypeKind.Void
    var n: *u8 = null
    var nl: i32 = 0
    var p: TypeKind = TypeKind.Void
    if let_unwrap_payload_pointer(sm, init, @k, @n, @nl, @p) == 0
        return 0
    v.let_kind = k
    v.let_name = n
    v.let_name_len = nl
    v.let_pointee = p
    1

# The `let` / `var` `st` just bound by sema_bind_decl: an array's element,
# and what an untyped one holds where Sema's typer leaves it unknown and
# the emitter types it anyway (an array literal, a tuple).
pub fn let_note_decl(sm: *Sema, st: *Stmt)
    let v: *SemaVar = let_last(sm)
    if v == null or name_eq(StrView { ptr: (v.name), len: (v.name_len) as i64 }, st.var_name) == 0
        return
    if st.var_declared_type != TypeKind.Void
        if st.var_type == TypeKind.Array
            v.let_elem = st.var_array_elem_type
        return
    let init: *Expr = st.var_init
    if init == null
        return
    if let_tuple_lit(init) == 1
        v.tuple = 1
    else if v.let_kind == TypeKind.Unknown and let_value_ty(sm, init, @v.let_kind, @v.let_name, @v.let_name_len, 0) == 1
        v.let_pointee = TypeKind.Void
    else if v.let_kind == TypeKind.Unknown and let_note_unwrap_pointer(sm, init, v) == 1
        pass   # AGAST #4458: a `@T` / `@&T` / `*T` unwrap payload
    else if v.let_kind == TypeKind.Unknown and (init.kind == ExprKind.ArrayLit or init.kind == ExprKind.ArrayFill)
        # AGAST #2266 / #3014: `[a, b]` / `[x; N]` is an `[N]T` local.
        var first: *Expr = init.args
        if init.kind == ExprKind.ArrayFill
            first = init.left
        var t: SemaTy
        let ek: TypeKind = sema_expr_ty(sm, first, @t)
        v.let_kind = TypeKind.Array
        v.let_elem = ek
        v.let_name = null
        v.let_name_len = 0
        if ek == TypeKind.Struct
            v.let_name = t.name
            v.let_name_len = t.name_len

# A param just bound by sema_bind_param: a `c:& C` holds the pointer to its
# referent (LocalVar.is_lent, AGAST #2250).
pub fn let_note_param(sm: *Sema, p: *Param)
    let v: *SemaVar = let_last(sm)
    if v == null or p.is_borrow != 1 or p.param_type != TypeKind.MutRef
        return
    v.let_kind = TypeKind.MutRef
    v.let_name = p.param_type_name
    v.let_name_len = p.param_type_name_len
    v.let_pointee = p.param_pointee_type
    let pt: TypeKind = p.param_pointee_type
    if pt == TypeKind.Struct or pt == TypeKind.Array or is_borrow_scalar_kind(pt) == 1
        v.let_lent = 1

# The element of a Vec, Span or String value (or a pointer to one) of type
# `name`, through its buffer field as the emitter indexes it: 1 and the
# element's kind (and struct name) in *out_*, else 0.
# Sema's one element typer answers it (sema_buffer_ty, AGAST #4259).
pub fn let_through_elem(sm: *Sema, kind: TypeKind, pointee: TypeKind, name_sv: StrView, out_kind: *TypeKind, out_name: **u8, out_len: *i32) -> i32
    var name: *u8 = name_sv.ptr
    var len: i32 = name_sv.len as i32
    if name == null or len <= 0
        return 0
    var bt: SemaTy
    bt.kind = kind
    bt.pointee = pointee
    bt.name = name
    bt.name_len = len
    bt.fn_sig = null
    bt.shape = null
    var t: SemaTy
    if sema_buffer_ty(sm, @bt, @t) == TypeKind.Unknown
        return 0
    *out_kind = t.kind
    if t.name != null
        *out_name = t.name
        *out_len = t.name_len
    1

# A `for` variable just bound: an element of `for x in <iterable>` is a
# `let` (AGAST #2389); a range variable is a `var`.
pub fn let_note_for(sm: *Sema, st: *Stmt)
    let v: *SemaVar = let_last(sm)
    if v == null or st.for_end != null
        return
    v.is_let = 1
    v.let_kind = TypeKind.Unknown
    v.let_name = null
    v.let_name_len = 0
    # The iterable is read in the scope outside the loop variable.
    sm.scope_top = sm.scope_top - 1
    var e: *Expr = st.for_start
    if e != null and e.kind == ExprKind.Unary and (e.op == OpKind.Addr or e.op == OpKind.AddrMut)
        e = e.operand
    var kind: TypeKind = TypeKind.Unknown
    var name: *u8 = null
    var name_len: i32 = 0
    var sh: *ArrayShape = null
    if e != null and e.kind == ExprKind.Ident
        let lv: *SemaVar = sema_find_local(sm, e.ident)
        if lv != null
            sh = lv.shape
            if lv.let_kind == TypeKind.Array and lv.let_elem != TypeKind.Array
                kind = lv.let_elem
                name = lv.let_name
                name_len = lv.let_name_len
            else
                # A Vec<S> / Span<S> local (#2389's iterables): its element.
                let_through_elem(sm, lv.let_kind, lv.let_pointee, StrView { ptr: (lv.let_name), len: (lv.let_name_len) as i64 }, @kind, @name, @name_len)
        else
            let g: *GlobalVarDef = sbk_global(sm, e.ident)
            if g != null and g.var_type == TypeKind.Array
                sh = g.array_shape
                if g.array_elem_type != TypeKind.Array
                    kind = g.array_elem_type
                    name = g.array_elem_type_name
                    name_len = g.array_elem_type_name_len
    else if e != null and e.kind == ExprKind.Member
        let f: *StructField = sbk_member_field(sm, e)
        if f != null and f.field_type == TypeKind.Array
            sh = f.array_shape
            if f.array_elem_type != TypeKind.Array
                kind = f.array_elem_type
                name = f.array_elem_type_name
                name_len = f.array_elem_type_name_len
        else if f != null
            let_through_elem(sm, f.field_type, f.ptr_pointee, StrView { ptr: (f.field_type_name), len: (f.field_type_name_len) as i64 }, @kind, @name, @name_len)
    sm.scope_top = sm.scope_top + 1
    # AGAST #2410 / #3379: over an N-D `[N][M]..T` each turn binds a row, an
    # `[M]T` local, or a plane, whose elements are arrays.
    if sh != null and sh.rank >= 2
        v.let_kind = TypeKind.Array
        v.let_elem = TypeKind.Array
        if sh.rank == 2
            v.let_elem = sh.leaf_type
            v.let_name = sh.leaf_name.ptr
            v.let_name_len = sh.leaf_name.len as i32
        return
    # Only a scalar or a named struct element is typed: a pointer element's
    # pointee is not recorded here.
    if kind == TypeKind.Struct and name_len <= 0
        return
    if kind == TypeKind.Ptr or kind == TypeKind.PtrPtr or kind == TypeKind.Ref or kind == TypeKind.MutRef
        return
    v.let_kind = kind
    v.let_name = name
    v.let_name_len = name_len

# =============================================================================
# Resolving calls and methods as the emitter does
# =============================================================================

# The fn a call `e` calls, as find_call_fn: a nameless call's value, a typed
# fn-pointer local of the name, else the fn.
fn let_call_fn(sm: *Sema, e: *Expr) -> *FnDef
    if e.func_name.len == 0
        return sbk_value_fn_sig(sm, e.left)
    if e.call_type_suffix.len <= 0
        let v: *SemaVar = sema_find_local(sm, e.func_name)
        if v != null and v.fn_sig != null and v.let_kind != TypeKind.Array
            return v.fn_sig
    sema_call_fn(sm, e)

# 1 when `recv` names no value, so it's the type of a static call.
fn let_recv_is_type(sm: *Sema, recv: *Expr) -> i32
    if recv == null or recv.kind != ExprKind.Ident
        return 0
    if sema_find_local(sm, recv.ident) != null
        return 0
    (sbk_global(sm, recv.ident) == null) as i32

# The type a method receiver names, as the emitter's method_recv_type: a
# local's or global's type name, a static call's type, a field's type, an
# element of a const struct array.
fn let_method_recv_type(sm: *Sema, recv: *Expr) -> StrView
    if recv == null
        return strview_empty()
    match recv.kind
        ExprKind.Ident =>
            let v: *SemaVar = sema_find_local(sm, recv.ident)
            if v != null
                return StrView { ptr: (v.let_name), len: (v.let_name_len) as i64 }
            let g: *GlobalVarDef = sbk_global(sm, recv.ident)
            if g != null
                return StrView { ptr: (g.type_name), len: (g.type_name_len) as i64 }
            return recv.ident
        ExprKind.Member =>
            var f: *StructField = sbk_member_field(sm, recv)
            # AGAST #3399: `xs[i].f.m()`, a field of an array's struct element.
            if f == null and recv.left != null and recv.left.kind == ExprKind.Index
                let es: StrView = let_index_struct(sm, recv.left)
                if es.ptr != null
                    f = sbk_struct_field(sm, es, recv.ident)
            if f == null
                return strview_empty()
            return StrView { ptr: (f.field_type_name), len: (f.field_type_name_len) as i64 }
        _ => pass
    # AGAST #3360: `PS[i].m()` of a const struct array.
    if recv.kind == ExprKind.Index and recv.left != null and recv.left.kind == ExprKind.Ident
        if sema_find_local(sm, recv.left.ident) == null and sbk_global(sm, recv.left.ident) == null
            let ce: *ConstEntry = sbk_const(sm, recv.left.ident)
            if ce != null and ce.const_type == TypeKind.Array and ce.array_elem_type == TypeKind.Struct
                return StrView { ptr: (ce.array_elem_type_name), len: (ce.array_elem_type_name_len) as i64 }
    # AGAST #3399: `xs[i].m()` of a local, global or field array's struct
    # element, and `g[i][j].m()` of an N-D one's.
    if recv.kind == ExprKind.Index
        return let_index_struct(sm, recv)
    strview_empty()

# The struct an element `e` (an ExprKind.Index) of an array is, or an empty
# view: a 1-D array's as let_value_ty types it, an N-D `[N][M]..S` array's
# when `e` indexes every dimension.
fn let_index_struct(sm: *Sema, e: *Expr) -> StrView
    var kind: TypeKind = TypeKind.Unknown
    var name: *u8 = null
    var name_len: i32 = 0
    if let_value_ty(sm, e, @kind, @name, @name_len, 0) == 1
        if kind != TypeKind.Struct or name_len <= 0
            return strview_empty()
        return StrView { ptr: (name), len: (name_len) as i64 }
    # Down the index chain to the N-D array it starts at.
    var depth: i32 = 0
    var at: *Expr = e
    while at != null and at.kind == ExprKind.Index
        if at.right == null or at.right.kind == ExprKind.Range
            return strview_empty()
        depth = depth + 1
        at = at.left
    if at == null
        return strview_empty()
    var sh: *ArrayShape = null
    match at.kind
        ExprKind.Ident =>
            let lv: *SemaVar = sema_find_local(sm, at.ident)
            if lv != null
                sh = lv.shape
            else
                let g: *GlobalVarDef = sbk_global(sm, at.ident)
                if g != null and g.var_type == TypeKind.Array
                    sh = g.array_shape
        ExprKind.Member =>
            let f: *StructField = sbk_member_field(sm, at)
            if f != null and f.field_type == TypeKind.Array
                sh = f.array_shape
        _ => pass
    if sh == null or sh.rank != depth or sh.leaf_type != TypeKind.Struct or sh.leaf_name.len <= 0
        return strview_empty()
    sh.leaf_name

# The fn method call `e` dispatches to, as the emitter's method_call_def.
fn let_method_call_def(sm: *Sema, e: *Expr) -> *FnDef
    let tname: StrView = let_method_recv_type(sm, e.left)
    if tname.ptr == null or tname.len <= 0
        return null
    sema_method_fn(sm, tname, e.ident)

# =============================================================================
# `let` immutability
# =============================================================================

# Pointers between the place and its struct, as local_struct_levels counts
# a local's; -1 when Sema can't say.
fn let_place_levels(pl: *LetPlace) -> i32
    let k: TypeKind = pl.kind
    match k
        TypeKind.Struct =>
            return 0
        TypeKind.Ptr =>
            return 1
        TypeKind.PtrPtr =>
            return ptr_ptr_ident_levels(pl.inner)
        TypeKind.Ref | TypeKind.MutRef =>
            match pl.pointee
                TypeKind.Ptr =>
                    return 2
                TypeKind.PtrPtr =>
                    return 1 + ptr_ptr_ident_levels(pl.inner)
                _ => pass
            return 1
        _ => pass
    0 - 1

# 1 when `p`, a `:&` param, borrows the pointer-holding `let` place `pl`
# itself rather than taking the pointer it holds: borrow_arg_kind's
# BORROW_PLACE (AGAST #2335), for a place rooted at a by-value `let`.
fn let_ptr_place_lent(pl: *LetPlace, p: *Param) -> i32
    if p.is_borrow != 1 or p.param_type != TypeKind.MutRef
        return 0
    # Through an `@T` it is read-only: no borrow (BORROW_SHARED).
    if pl.kind == TypeKind.Ref
        return 0
    if param_borrows_struct_ptr_ptr(p) == 1
        if let_place_levels(pl) == ptr_ptr_ident_levels(p.param_inner_pointee_type)
            return 1
    if p.param_pointee_type != TypeKind.Ptr
        return 0
    if pl.kind == TypeKind.PtrPtr or pl.pointee == TypeKind.Ptr
        return 0
    if pl.kind != TypeKind.Ptr and pl.kind != TypeKind.MutRef
        return 0
    # pointer_place_fits.  A `:& *U` param always records its U, and Sema
    # never records an unknown pointee, so both sides are known here.
    let want: TypeKind = p.param_ref_ptr_pointee
    if want == TypeKind.Array and p.param_pointee_array_size > 0
        return (pl.pointee == TypeKind.Array) as i32
    if want == TypeKind.Struct or pl.pointee == TypeKind.Struct
        return (want == pl.pointee and name_eq(StrView { ptr: (p.param_type_name), len: (p.param_type_name_len) as i64 }, StrView { ptr: (pl.type_name), len: (pl.type_name_len) as i64 }) == 1) as i32
    (want == pl.pointee) as i32

# 1 when an `[a..b]` slice is on `e`'s path: no place (arg_is_place).
fn let_path_slices(e: *Expr) -> i32
    var at: *Expr = e
    while at != null and (at.kind == ExprKind.Member or at.kind == ExprKind.Index)
        if at.kind == ExprKind.Index and at.right != null and at.right.kind == ExprKind.Range
            return 1
        at = at.left
    0

# AGAST #2032 (ritz0 #2029): an implicit mutable borrow.  `p` is the callee
# param that `arg` (or a method receiver) binds to.  A `name:& T`,
# `name: @&T` or `self:&` param (all TypeKind.MutRef) autoborrows its argument,
# which is #2026's explicit `@&` in disguise.  A `let` that *holds* a
# pointer is passed as that pointer, borrowing the pointee, so stays legal;
# `@&x` itself is the explicit form, reported by let_check_expr.
fn let_check_implicit(sm: *Sema, arg: *Expr, p: *Param)
    # AGAST #2389: a bare `self:&` is a TypeKind.Struct param marked is_self_borrow
    # (param_self_lent), the same borrow as `self:& T`.
    if p.param_type != TypeKind.MutRef and (p.param_type != TypeKind.Struct or p.is_self_borrow != 1)
        return
    var env: LetEnv
    let_sema_env(sm, @env)
    var pl: LetPlace
    if let_place(@env, arg, @pl) == 0
        return
    # Sema can't say whether it holds a pointer: no refusal on a guess.
    if pl.kind == TypeKind.Unknown
        return
    # A `let` that holds a pointer passes that pointer, unless `:& *U` borrows
    # its own storage (AGAST #2335).
    if pl.kind == TypeKind.Ptr or pl.kind == TypeKind.PtrPtr or pl.kind == TypeKind.Ref or pl.kind == TypeKind.MutRef
        if let_path_slices(arg) == 1 or let_ptr_place_lent(@pl, p) == 0
            return
    let_error_borrow(@env, arg.span.line, arg.span.col, @pl)

# AGAST #2403: a receiver one pointer short of a `self: **S` (or deeper) is
# lent as `@&recv`: refused when that place is a `let`'s own storage.  A
# shared `self: @*S` borrows it read-only.  `e` is the method call.
pub fn let_check_receiver(sm: *Sema, e: *Expr)
    let recv: *Expr = e.left
    if recv == null or let_path_slices(recv) == 1
        return
    let mfn: *FnDef = sbk_method_def(sm, e)
    if mfn == null or param_is_self(mfn.params) == 0
        return
    let want: i32 = self_struct_levels(mfn.params)
    if want < 2 or mfn.params.param_type == TypeKind.Ref
        return
    var env: LetEnv
    let_sema_env(sm, @env)
    var pl: LetPlace
    if let_place(@env, recv, @pl) == 0
        return
    let levels: i32 = let_place_levels(@pl)
    if levels < 0 or levels + 1 != want
        return
    let_error_borrow(@env, recv.span.line, recv.span.col, @pl)

# Reject every `@&<let place>` in `e`.  Walks only the expression kinds
# whose children are plain sub-expressions, as the emitter did: a match /
# if expression's arms are checked by sema_walk_arms (where emit_match_arm_body
# checked them), with the arm's bindings in scope; a struct literal's fields
# are not checked.
pub fn let_check_expr(sm: *Sema, e: *Expr)
    if e == null
        return
    let k: ExprKind = e.kind
    match k
        ExprKind.Unary =>
            if e.op == OpKind.AddrMut
                var env: LetEnv
                let_sema_env(sm, @env)
                var pl: LetPlace
                if let_place(@env, e.operand, @pl) == 1
                    let_error_borrow(@env, e.span.line, e.span.col, @pl)
            let_check_expr(sm, e.operand)
        ExprKind.Binary | ExprKind.Index | ExprKind.Range =>
            let_check_expr(sm, e.left)
            let_check_expr(sm, e.right)
        ExprKind.Member | ExprKind.Cast | ExprKind.Try =>
            let_check_expr(sm, e.left)
        ExprKind.Call | ExprKind.Method =>
            # AGAST #2032: the callee's signature, for implicit `@&` autoborrows.
            var p: *Param = null
            if k == ExprKind.Method
                let_check_expr(sm, e.left)
                let m: *FnDef = let_method_call_def(sm, e)
                if m != null
                    p = m.params
                    # `S.make(..)` has no receiver: its params start at the first.
                    if p != null and let_recv_is_type(sm, e.left) == 0
                        let_check_implicit(sm, e.left, p)
                        p = p.next
            else
                let f: *FnDef = let_call_fn(sm, e)
                if f != null
                    p = f.params
            var a: *Expr = e.args
            while a != null
                let_check_expr(sm, a)
                if p != null
                    let_check_implicit(sm, a, p)
                    p = p.next
                a = a.next
        _ => pass

# The write target of an assignment-kind statement, if it is a `let` place.
fn let_check_write(sm: *Sema, stmt: *Stmt)
    let line: i32 = stmt.span.line
    let col: i32 = stmt.span.col
    var env: LetEnv
    let_sema_env(sm, @env)
    var pl: LetPlace
    let k: StmtKind = stmt.kind
    match k
        StmtKind.Assign =>
            if stmt.assign_target.len > 0
                # `x = v` / `x op= v`: the whole binding.
                if let_place_root(@env, stmt.assign_target, @pl) == 1
                    let_error_assign_whole(@env, line, col, @pl)
                return
            # `expr = v`; the target expr is in if_cond.  `*p = v` (ExprKind.Unary)
            # writes the pointee and never matches.
            let target: *Expr = stmt.if_cond as *Expr
            if target == null
                return
            if target.kind == ExprKind.Ident
                if let_place_root(@env, target.ident, @pl) == 1
                    let_error_assign_whole(@env, line, col, @pl)
                return
            if target.kind == ExprKind.Member or target.kind == ExprKind.Index
                if let_place(@env, target, @pl) == 1
                    let_error_assign_through(@env, line, col, @pl)
            return
        StmtKind.IndexAssign =>
            # `name[i] = v`
            if let_place_root(@env, stmt.assign_target, @pl) == 1
                if let_place_index(@pl) == 1
                    let_error_assign_through(@env, line, col, @pl)
            return
        StmtKind.LocalFieldAssign =>
            # `name.f = v`
            if let_place_root(@env, stmt.var_name, @pl) == 1
                if let_place_member(@env, @pl, stmt.assign_target) == 1
                    let_error_assign_through(@env, line, col, @pl)
            return
        StmtKind.LocalFieldIndexAssign =>
            # `name.f[i] = v`
            if let_place_root(@env, stmt.var_name, @pl) == 1
                if let_place_member(@env, @pl, stmt.assign_target) == 1
                    if let_place_index(@pl) == 1
                        let_error_assign_through(@env, line, col, @pl)
            return
        _ => pass
    # StmtKind.MemberAssign / StmtKind.MemberIndexAssign are `(*p).f = v`: through
    # a pointer, always legal.

# =============================================================================
# A struct of another type (AGAST #2293, #3293, #3294)
# =============================================================================

# The struct `e` evaluates to, by name, as the emitter's
# resolve_expr_struct_name names it: a `"..."` is a `Span$u8` there, a
# struct local, a struct const, an enum variant, a call's or an impl
# method's struct return, a struct literal.  `strview_empty()` when unknown.
#
# AGAST #4780: `out` is `*StrView`, not `**u8`/`*i32` — a spelling out-param
# always holds Ritz text.  The `*u8`/`_len` field pairs this reads (AST/type
# name fields, #4773's territory) are wrapped into a StrView right here, at
# the boundary, rather than converting those fields themselves.
fn let_struct_name(sm: *Sema, e: *Expr, out: *StrView)
    *out = strview_empty()
    if e == null
        return
    if e.kind == ExprKind.StringLit
        *out = "Span$u8"
        return
    if e.kind == ExprKind.Cast and e.type_kind == TypeKind.Struct
        # AGAST #3004: `r as C` through a reference reads the `C` itself.
        var t: SemaTy
        let k: TypeKind = sema_expr_ty(sm, e.left, @t)
        if (k == TypeKind.Ptr or k == TypeKind.Ref or k == TypeKind.MutRef) and t.pointee == TypeKind.Struct and name_eq(StrView { ptr: (t.name), len: (t.name_len) as i64 }, e.ident) == 1
            *out = e.ident
            return
        let_struct_name(sm, e.left, out)
        return
    match e.kind
        ExprKind.Method =>
            if name_eq(e.ident, "as_bytes") == 1
                *out = "Span$u8"
                return
            # AGAST #1466: a qualified variant ctor `Opt.Holds(x)` is the enum.
            let q: *Expr = e.left
            if q != null and q.kind == ExprKind.Ident and sema_find_local(sm, q.ident) == null and sbk_global(sm, q.ident) == null
                let ei: i32 = enum_find(sm.pctx, q.ident)
                if ei >= 0 and enum_variant_index(sm.pctx, q.ident, e.ident) >= 0 and enum_is_generic(sm.pctx, ei) != 1
                    var en_len: i32 = 0
                    let en: *u8 = enum_name_at(sm.pctx, ei, @en_len)
                    *out = StrView { ptr: (en), len: (en_len) as i64 }
                    return
            # An impl method on a local receiver: its struct return.
            if q != null and q.kind == ExprKind.Ident
                let v: *SemaVar = sema_find_local(sm, q.ident)
                if v != null and v.let_name_len > 0
                    var ib: *ImplBlock = sm.module.impls
                    while ib != null
                        if name_eq(StrView { ptr: (ib.type_name), len: (ib.type_name_len) as i64 }, StrView { ptr: (v.let_name), len: (v.let_name_len) as i64 }) == 1
                            var m: *FnDef = ib.methods
                            while m != null
                                if name_eq(StrView { ptr: (m.name), len: (m.name_len) as i64 }, e.ident) == 1
                                    if m.return_type == TypeKind.Struct and m.return_type_name_len > 0
                                        *out = StrView { ptr: (m.return_type_name), len: (m.return_type_name_len) as i64 }
                                    return
                                m = m.next
                            return
                        ib = ib.next
            return
        ExprKind.Ident =>
            let v: *SemaVar = sema_find_local(sm, e.ident)
            if v != null and v.let_name_len > 0 and v.let_kind == TypeKind.Struct
                *out = StrView { ptr: (v.let_name), len: (v.let_name_len) as i64 }
                return
            # AGAST #189: a struct const (`const FOO: StrView = "..."`).
            let ce: *ConstEntry = sbk_const(sm, e.ident)
            if ce != null and ce.const_type == TypeKind.Struct and ce.type_name_len > 0
                *out = StrView { ptr: (ce.type_name), len: (ce.type_name_len) as i64 }
                return
            # AGAST #1600: a bare unit variant `B` is a value of its enum.
            if ce != null or is_builtin_const(e.ident) == 1 or v != null
                return
            if sbk_global(sm, e.ident) != null or sema_find_fn(sm, e.ident) != null
                return
            var vi: i32 = 0
            var other: i32 = 0
            let ei: i32 = enum_of_variant_unique(sm.pctx, e.ident, @vi, @other)
            if ei >= 0 and enum_variant_kind(sm.pctx, ei, vi) == ENUM_VARIANT_UNIT
                var en_len: i32 = 0
                let en: *u8 = enum_name_at(sm.pctx, ei, @en_len)
                *out = StrView { ptr: (en), len: (en_len) as i64 }
            return
        ExprKind.Call =>
            # AGAST #1797: a user-enum payload ctor `Holds(x)` is the enum.
            var ctor_name: *u8 = null
            var ctor_len: i32 = 0
            user_variant_ctor_enum(sm.pctx, e, @ctor_name, @ctor_len)
            if ctor_name != null
                *out = StrView { ptr: (ctor_name), len: (ctor_len) as i64 }
                return
            let fdr: *FnDef = let_call_fn(sm, e)
            if fdr != null and fdr.return_type == TypeKind.Struct and fdr.return_type_name_len > 0
                *out = StrView { ptr: (fdr.return_type_name), len: (fdr.return_type_name_len) as i64 }
            return
        _ => pass
    if e.kind == ExprKind.StructLit
        if e.ident.ptr != null and (e.ident.len as i32) > 0
            *out = e.ident

# 1 when `init` is a known struct of another type than the known struct `want`,
# with its name in `*out` / `*out_len` (AGAST #2293, #3293).
fn another_struct_source(sm: *Sema, init: *Expr, want_sv: StrView, out: **u8, out_len: *i32) -> i32
    var want: *u8 = want_sv.ptr
    var want_len: i32 = want_sv.len as i32
    if init == null or init.kind == ExprKind.Cast
        return 0
    if want == null or want_len <= 0
        return 0
    var src_sv: StrView = strview_empty()
    let_struct_name(sm, init, @src_sv)
    var src: *u8 = src_sv.ptr
    var src_len: i32 = src_sv.len as i32
    # A `c:& C` param holds its referent (#2250).
    var lent: *SemaVar = null
    if init.kind == ExprKind.Ident
        let lv: *SemaVar = sema_find_local(sm, init.ident)
        if lv != null and lv.let_lent == 1
            lent = lv
    if src == null and lent != null and lent.let_kind == TypeKind.MutRef
        src = lent.let_name
        src_len = lent.let_name_len
    if src == null or src_len <= 0
        return 0
    # AGAST #3579 / #3564: a local bound to an unannotated `"..."`, to a
    # `... as StrView` or to another such local is a StrView value, as in
    # ritz0: Sema binds it so (sema_expr_ty), where the emitter's local is the
    # literal's `Span$u8` it marks str_view.
    if name_eq(StrView { ptr: (src), len: (src_len) as i64 }, want_sv) == 1
        return 0
    # AGAST #3441 (R49): of the StrView / Span$u8 pair only a `"..."` converts,
    # either way, and it reads as a `Span$u8` here.  A StrView value never fits
    # a `Span<u8>` slot, nor a `Span<u8>` value a StrView one (#3564).
    if init.kind == ExprKind.StringLit and is_layout_equiv_pair(StrView { ptr: (src), len: (src_len) as i64 }, want_sv) == 1
        return 0
    if sema_find_struct(sm, StrView { ptr: (src), len: (src_len) as i64 }) == null or sema_find_struct(sm, want_sv) == null
        return 0
    *out = src
    *out_len = src_len
    return 1

# `<head>`<name>` is declared `<want>` but <what> is a `<src>``, at (line, col).
fn let_error_another(sm: *Sema, line: i32, col: i32, head: StrView, name: StrView, want: StrView, what: StrView, src: StrView)
    var env: LetEnv
    let_sema_env(sm, @env)
    let_error(@env, line, col, head, name, "` is declared `")
    let_eprint_name(want)
    eprints(what)
    let_eprint_name(src)
    eprints("`\n")

# AGAST #2293: `let d: D = c` / `var d: D = c` with `c` a struct of another
# type.  It used to reach clang as `store %C ..., %D` (or the `ptr` a `c:& C`
# reads as).  ritz0's _reject_another_struct gives the same message at the
# same place (ritz0/let_rules.py).  Only two known structs that differ by name
# are refused: a cast names its operand's type here, a Span$u8 converts to a
# StrView (#168) but not back (#3441), and an enum or a name Sema doesn't
# know (an alias) is left to the store.
fn let_check_another_struct(sm: *Sema, stmt: *Stmt)
    if stmt.var_declared_type != TypeKind.Struct
        return
    var src: *u8 = null
    var src_len: i32 = 0
    if another_struct_source(sm, stmt.var_init, stmt.var_type_name, @src, @src_len) == 0
        return
    let_error_another(sm, stmt.span.line, stmt.span.col, "`", stmt.var_name, stmt.var_type_name, "` but its initialiser is a `", StrView { ptr: (src), len: (src_len) as i64 })

# `let s: String = "abc"`: 1 when it reported one.  With no `String` in scope
# (no `import ritzlib.string`, AGAST #3347) the literal has nothing to become:
# ritz1 stored its `{ ptr, len }` into an undeclared `%String`.  With one, LARB
# R49 (AGAST #3361, #3393) refuses it anyway: a literal is a `StrView`, or a
# `*u8` in a `*u8` slot, and nothing else converts (LANGUAGE_SPEC 3.5).  ritz1
# used to say "`s` is declared `String` but its initialiser is a `Span$u8`", at
# the `let`.  ritz0's _refuse_string_literal gives the same words, at the literal.
# The compile stops at Sema, so a later `s.len` never reports it again (#3362).
fn let_check_string_lit(sm: *Sema, stmt: *Stmt) -> i32
    let init: *Expr = stmt.var_init
    if init == null or init.kind != ExprKind.StringLit
        return 0
    if name_eq(stmt.var_type_name, "String") == 0
        return 0
    var env: LetEnv
    let_sema_env(sm, @env)
    if sema_find_struct(sm, "String") != null
        let_error(@env, init.span.line, init.span.col, "", StrView { ptr: (null), len: (0) as i64 }, "a string literal is not a `String`: write `string_from(")
        let_eprint_source_quote(init.string_val)
        eprints(")`\n")
        return 1
    let_error(@env, init.span.line, init.span.col, "", StrView { ptr: (null), len: (0) as i64 }, "`String` is not built in: `import ritzlib.string` to make one from a string literal\n")
    return 1

# A literal's bytes as the "..." that writes them: `"`, `\\`, newline, tab, CR
# and NUL escaped, every other byte (UTF-8 included) as itself.  ritz0's
# _source_quote matches.
fn let_eprint_source_quote(lit: StrView)
    eprint_char('"')
    var i: i64 = 0
    while i < lit.len
        let c: u8 = lit.get(i)
        if c == '"'
            eprints("\\\"")
        else if c == '\\'
            eprints("\\\\")
        else if c == '\n'
            eprints("\\n")
        else if c == '\t'
            eprints("\\t")
        else if c == '\r'
            eprints("\\r")
        else if c == 0
            eprints("\\0")
        else
            eprint_char(c)
        i = i + 1
    eprint_char('"')

# AGAST #3293: `return c` or a tail `c`, with `c` a struct of another type than
# the fn's `-> D`.  ritz1 loaded the `C` local's slot as a `%D` and returned it:
# the bytes of a `C`, read as a `D`, with no error.  ritz0's
# _reject_another_struct_return gives the same message (ritz0/let_rules.py).
# (line, col) is the `return`, or the tail value.  1 when refused.
pub fn return_check_another_struct(sm: *Sema, e: *Expr, line: i32, col: i32) -> i32
    let f: *FnDef = sm.cur_fn
    if f == null or f.return_type != TypeKind.Struct
        return 0
    var src: *u8 = null
    var src_len: i32 = 0
    if another_struct_source(sm, e, StrView { ptr: (f.return_type_name), len: (f.return_type_name_len) as i64 }, @src, @src_len) == 0
        return 0
    var env: LetEnv
    let_sema_env(sm, @env)
    let_error(@env, line, col, "the fn is declared `-> ", StrView { ptr: (f.return_type_name), len: (f.return_type_name_len) as i64 }, "` but its return value is a `")
    let_eprint_name(StrView { ptr: (src), len: (src_len) as i64 })
    eprints("`\n")
    return 1

# AGAST #3294: the same rule at a store, `d = c` / `v.d = c`, with `c` a struct
# of another type than the local or field.  It reached clang as `store %C ...`
# into the `%D`.  ritz0 reads it back from llvmlite's store complaint
# (_store_mismatch_message) and gives the same message.
fn let_check_another_struct_store(sm: *Sema, stmt: *Stmt)
    var want: *u8 = null
    var want_len: i32 = 0
    match stmt.kind
        StmtKind.Assign =>
            if stmt.assign_target.len <= 0
                return
            let loc: *SemaVar = sema_find_local(sm, stmt.assign_target)
            if loc == null or loc.let_kind != TypeKind.Struct
                return
            want = loc.let_name
            want_len = loc.let_name_len
        StmtKind.LocalFieldAssign =>
            let base: *SemaVar = sema_find_local(sm, stmt.var_name)
            if base == null
                return
            let st: *StructDef = sema_find_struct(sm, StrView { ptr: (base.let_name), len: (base.let_name_len) as i64 })
            if st == null
                return
            let idx: i32 = find_field_index(st, stmt.assign_target)
            if idx < 0
                return
            let f: *StructField = get_field_type(st, idx)
            if f.field_type != TypeKind.Struct
                return
            want = f.field_type_name
            want_len = f.field_type_name_len
        _ =>
            return
    var src: *u8 = null
    var src_len: i32 = 0
    if another_struct_source(sm, stmt.assign_value, StrView { ptr: (want), len: (want_len) as i64 }, @src, @src_len) == 0
        return
    var head: StrView = "`"
    if stmt.kind != StmtKind.Assign
        head = "field `"
    let_error_another(sm, stmt.span.line, stmt.span.col, head, stmt.assign_target, StrView { ptr: (want), len: (want_len) as i64 }, "` but the value assigned is a `", StrView { ptr: (src), len: (src_len) as i64 })

# AGAST #3294: argument `a` for by-value param `p`, a struct of another type.
# It reached clang as a `%C` passed to the `%D`.  let_another_struct_call /
# _method pair them, for a call, a fn-pointer call and a method; ritz0's
# _another_struct_arg_message gives the same message, at the argument.
pub fn let_check_another_struct_arg(sm: *Sema, p: *Param, a: *Expr)
    if p.param_type != TypeKind.Struct or p.is_borrow == 1
        return
    var src: *u8 = null
    var src_len: i32 = 0
    if another_struct_source(sm, a, StrView { ptr: (p.param_type_name), len: (p.param_type_name_len) as i64 }, @src, @src_len) == 0
        return
    let_error_another(sm, a.span.line, a.span.col, "parameter `", StrView { ptr: (p.name), len: (p.name_len) as i64 }, StrView { ptr: (p.param_type_name), len: (p.param_type_name_len) as i64 }, "` but its argument is a `", StrView { ptr: (src), len: (src_len) as i64 })

fn let_another_struct_args(sm: *Sema, params: *Param, args: *Expr)
    var p: *Param = params
    var a: *Expr = args
    while p != null and a != null
        let_check_another_struct_arg(sm, p, a)
        p = p.next
        a = a.next

# A named call's arguments against its callee's params: a local's fn-pointer
# signature (a local without one is not checked), else the fn.
# >0 inside a `sizeof(x)` operand, which emit_expr_call never lowered, so the
# emitter never paired the arguments of a call there with its params.
var g_let_sizeof: i32 = 0

# 1 when `e` is `sizeof(x)`: let_check_sizeof brackets its operand.
pub fn let_check_sizeof_of(e: *Expr) -> i32
    if e.kind != ExprKind.Call or e.func_name.len == 0
        return 0
    name_eq(e.func_name, "sizeof")

pub fn let_check_sizeof(delta: i32)
    g_let_sizeof = g_let_sizeof + delta

pub fn let_another_struct_call(sm: *Sema, e: *Expr)
    if e.func_name.len == 0 or g_let_sizeof > 0
        return
    let v: *SemaVar = sema_find_local(sm, e.func_name)
    if v != null
        if v.fn_sig != null
            let_another_struct_args(sm, v.fn_sig.params, e.args)
        return
    let fd: *FnDef = let_call_fn(sm, e)
    if fd != null
        let_another_struct_args(sm, fd.params, e.args)

# A method call's arguments against its callee's params after the receiver
# (`self`).
pub fn let_another_struct_method(sm: *Sema, e: *Expr)
    if g_let_sizeof > 0
        return
    let fd: *FnDef = sbk_method_def(sm, e)
    if fd == null or fd.params == null
        return
    if name_eq(StrView { ptr: (fd.params.name), len: (fd.params.name_len) as i64 }, "self") == 1
        let_another_struct_args(sm, fd.params.next, e.args)
    else
        let_another_struct_args(sm, fd.params, e.args)

# Check one statement, from sema_walk before its expressions are walked and
# before a `let` / `var` binds its name: its own write target, and every
# `@&` in the expressions it evaluates.  Nested statement lists are checked
# as the walk reaches them, with the bindings that statement sees.  A fn's
# tail expression is not one: the emitter lowered it as the return value.
pub fn let_check_stmt(sm: *Sema, stmt: *Stmt)
    let k: StmtKind = stmt.kind
    match k
        StmtKind.VarDecl | StmtKind.TupleDecl =>
            let_check_expr(sm, stmt.var_init)
            if k == StmtKind.VarDecl
                if let_check_string_lit(sm, stmt) == 0   # AGAST #3347, LARB R49
                    let_check_another_struct(sm, stmt)
            return
        StmtKind.Assign | StmtKind.IndexAssign | StmtKind.LocalFieldAssign | StmtKind.LocalFieldIndexAssign | StmtKind.MemberAssign | StmtKind.MemberIndexAssign =>
            let_check_write(sm, stmt)
            let_check_expr(sm, stmt.assign_value)
            let_check_another_struct_store(sm, stmt)   # AGAST #3294
            if k == StmtKind.IndexAssign or k == StmtKind.LocalFieldIndexAssign or k == StmtKind.MemberIndexAssign
                let_check_expr(sm, stmt.while_cond)
            return
        _ => pass
    match k
        StmtKind.Return =>
            let_check_expr(sm, stmt.return_value)
        StmtKind.Expr =>
            let_check_expr(sm, stmt.expr)
        StmtKind.If | StmtKind.Assert =>
            let_check_expr(sm, stmt.if_cond)
        StmtKind.While =>
            let_check_expr(sm, stmt.while_cond)
        StmtKind.For =>
            let_check_expr(sm, stmt.for_start)
            let_check_expr(sm, stmt.for_end)
        _ => pass
