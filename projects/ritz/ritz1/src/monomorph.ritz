# ritz1/src/monomorph.ritz - Monomorphization pass for ritz1
#
# This pass transforms generic code into specialized (monomorphized) code.
# Each instantiation of a generic function with concrete type arguments
# results in a specialized version being generated.
#
# Example:
#     fn vec_new<T>() -> Vec<T>
#         ...
#     vec_new<u8>()  # Creates call to vec_new$u8
#
# After monomorphization, vec_new$u8 is generated from the template.
#
# The pass lowers a construct by rewriting the Expr it is handed, in place, on
# nodes it owns: "Lowering in place" below (AGAST #4411) says why that is safe
# and which helpers do it.

import ast
import ast_helpers
import struct_index   # AGAST #1635
import ast_query   # name_eq & co., off emitter_core (AGAST #3513)
import diag           # diag_error_at (AGAST #3445)
import interp         # print placeholders' method calls (AGAST #3617)
import ritzlib.sys
import ritzlib.io
import ritzlib.str
import ritzlib.memory

# ============================================================================
# Instantiation Tracking
# ============================================================================
# Track generic function AND struct instantiations as (name, type_suffix) pairs

# Initial capacity; the fn and struct tables each grow by doubling (AGAST
# #1813).  add_instantiation used to return -1 when full and every caller
# ignored it, so instantiations past 256 were silently never specialised
# (#1325's root cause).
const INST_INIT_CAP: i32 = 256

# Function instantiation tracking (stored as parallel arrays for simplicity)
var g_inst_names: **u8 = null        # Function names
var g_inst_name_lens: *i32 = null
var g_inst_suffixes: **u8 = null     # Type suffixes ($u8, $i32, etc.)
var g_inst_suffix_lens: *i32 = null
var g_inst_count: i32 = 0
var g_inst_cap: i32 = 0

# Struct instantiation tracking (parallel arrays)
var g_struct_names: **u8 = null      # Struct names (e.g., "Pair", "Vec")
var g_struct_name_lens: *i32 = null
var g_struct_suffixes: **u8 = null   # Type suffixes ($i32, $u8, etc.)
var g_struct_suffix_lens: *i32 = null
var g_struct_count: i32 = 0
var g_struct_cap: i32 = 0

# AGAST #3330: each instance's generation.  One named in the program is 0; one
# first named while specialising a generation-g instance (its fields, its impl
# methods, its body) is g + 1.  `impl<T> Cell<T>  fn wrap(..) -> Cell<Cell<T>>`
# names a deeper instance at every generation, so instantiation never ended
# (ritz1 hung).  Past MAX_INSTANCE_DEPTH generations it stops with a located
# error instead; ritz0 uses the same cap (monomorph.py, MAX_INSTANCE_DEPTH).
# Real code peaks at 4.
const MAX_INSTANCE_DEPTH: i32 = 64
var g_inst_gens: *i32 = null
var g_struct_gens: *i32 = null
var g_cur_gen: i32 = -1          # generation being specialised; -1 outside
var g_mono_errors: i32 = 0

fn init_instantiation_tracker()
    # Initialize function tracking
    g_inst_cap = INST_INIT_CAP
    g_inst_names = malloc((g_inst_cap as i64) * 8) as **u8
    g_inst_name_lens = malloc((g_inst_cap as i64) * 4) as *i32
    g_inst_suffixes = malloc((g_inst_cap as i64) * 8) as **u8
    g_inst_suffix_lens = malloc((g_inst_cap as i64) * 4) as *i32
    g_inst_gens = malloc((g_inst_cap as i64) * 4) as *i32
    g_inst_count = 0
    # Initialize struct tracking
    g_struct_cap = INST_INIT_CAP
    g_struct_names = malloc((g_struct_cap as i64) * 8) as **u8
    g_struct_name_lens = malloc((g_struct_cap as i64) * 4) as *i32
    g_struct_suffixes = malloc((g_struct_cap as i64) * 8) as **u8
    g_struct_suffix_lens = malloc((g_struct_cap as i64) * 4) as *i32
    g_struct_gens = malloc((g_struct_cap as i64) * 4) as *i32
    g_struct_count = 0
    g_cur_gen = -1
    g_mono_errors = 0

fn add_instantiation(name_sv: StrView, suffix_sv: StrView) -> i32
    var name: *u8 = name_sv.ptr
    var name_len: i32 = name_sv.len as i32
    var suffix: *u8 = suffix_sv.ptr
    var suffix_len: i32 = suffix_sv.len as i32
    # Check if already tracked
    for i in 0..g_inst_count
        if *(g_inst_name_lens + i) == name_len and *(g_inst_suffix_lens + i) == suffix_len
            if memcmp(*(g_inst_names + i), name, name_len as i64) == 0
                if memcmp(*(g_inst_suffixes + i), suffix, suffix_len as i64) == 0
                    return 0  # Already tracked

    # Add new entry
    if g_inst_count >= g_inst_cap
        let cap: i64 = (g_inst_cap as i64) * 2
        g_inst_names = realloc(g_inst_names as *u8, cap * 8) as **u8
        g_inst_name_lens = realloc(g_inst_name_lens as *u8, cap * 4) as *i32
        g_inst_suffixes = realloc(g_inst_suffixes as *u8, cap * 8) as **u8
        g_inst_suffix_lens = realloc(g_inst_suffix_lens as *u8, cap * 4) as *i32
        g_inst_gens = realloc(g_inst_gens as *u8, cap * 4) as *i32
        g_inst_cap = cap as i32

    *(g_inst_names + g_inst_count) = name
    *(g_inst_name_lens + g_inst_count) = name_len
    *(g_inst_suffixes + g_inst_count) = suffix
    *(g_inst_suffix_lens + g_inst_count) = suffix_len
    *(g_inst_gens + g_inst_count) = g_cur_gen + 1
    g_inst_count = g_inst_count + 1
    return 1  # Added new

pub fn get_instantiation_count() -> i32
    g_inst_count

pub fn get_instantiation_name(idx: i32) -> *u8
    if idx >= g_inst_count
        return null
    *(g_inst_names + idx)

pub fn get_instantiation_name_len(idx: i32) -> i32
    if idx >= g_inst_count
        return 0
    *(g_inst_name_lens + idx)

pub fn get_instantiation_suffix(idx: i32) -> *u8
    if idx >= g_inst_count
        return null
    *(g_inst_suffixes + idx)

pub fn get_instantiation_suffix_len(idx: i32) -> i32
    if idx >= g_inst_count
        return 0
    *(g_inst_suffix_lens + idx)

# ============================================================================
# Struct Instantiation Tracking
# ============================================================================

fn add_struct_instantiation(name_sv: StrView, suffix_sv: StrView) -> i32
    var name: *u8 = name_sv.ptr
    var name_len: i32 = name_sv.len as i32
    var suffix: *u8 = suffix_sv.ptr
    var suffix_len: i32 = suffix_sv.len as i32
    # Check if already tracked
    for i in 0..g_struct_count
        if *(g_struct_name_lens + i) == name_len and *(g_struct_suffix_lens + i) == suffix_len
            if memcmp(*(g_struct_names + i), name, name_len as i64) == 0
                if memcmp(*(g_struct_suffixes + i), suffix, suffix_len as i64) == 0
                    return 0  # Already tracked

    # Add new entry
    if g_struct_count >= g_struct_cap
        let cap: i64 = (g_struct_cap as i64) * 2
        g_struct_names = realloc(g_struct_names as *u8, cap * 8) as **u8
        g_struct_name_lens = realloc(g_struct_name_lens as *u8, cap * 4) as *i32
        g_struct_suffixes = realloc(g_struct_suffixes as *u8, cap * 8) as **u8
        g_struct_suffix_lens = realloc(g_struct_suffix_lens as *u8, cap * 4) as *i32
        g_struct_gens = realloc(g_struct_gens as *u8, cap * 4) as *i32
        g_struct_cap = cap as i32

    *(g_struct_names + g_struct_count) = name
    *(g_struct_name_lens + g_struct_count) = name_len
    *(g_struct_suffixes + g_struct_count) = suffix
    *(g_struct_suffix_lens + g_struct_count) = suffix_len
    *(g_struct_gens + g_struct_count) = g_cur_gen + 1
    g_struct_count = g_struct_count + 1
    return 1  # Added new

pub fn get_struct_instantiation_count() -> i32
    g_struct_count

pub fn get_struct_instantiation_name(idx: i32) -> *u8
    if idx >= g_struct_count
        return null
    *(g_struct_names + idx)

pub fn get_struct_instantiation_name_len(idx: i32) -> i32
    if idx >= g_struct_count
        return 0
    *(g_struct_name_lens + idx)

pub fn get_struct_instantiation_suffix(idx: i32) -> *u8
    if idx >= g_struct_count
        return null
    *(g_struct_suffixes + idx)

pub fn get_struct_instantiation_suffix_len(idx: i32) -> i32
    if idx >= g_struct_count
        return 0
    *(g_struct_suffix_lens + idx)

# Find generic struct by name
pub fn find_generic_struct(m: *Module, name_sv: StrView) -> *StructDef
    var name: *u8 = name_sv.ptr
    var name_len: i32 = name_sv.len as i32
    var st: *StructDef = m.structs
    while st != null
        if st.type_params != null
            if st.name_len == name_len
                if memcmp(st.name, name, name_len as i64) == 0
                    return st
        st = st.next
    return null

# AGAST #3162: an `impl` on a built-in type is refused, at the `impl`.
# `Span<T>`, `StrView`, `Option<T>` and `Result<T, E>` exist with no
# declaration, and their methods are lowered by the compiler, so an impl's
# methods were lost (`Span_is_empty` defined, `Span$u8_is_empty` called; an
# `Option<i32>` method undefined at link).  Aaron (2026-11-15, rz-larb): the
# built-ins are closed, as R15 made built-in indexing.  A struct or enum of
# that name the program declares or imports (ritzlib.span, .strview,
# .option, .result) is ordinary, and its impls stand.  Run after imports are
# merged and before ensure_builtin_span_template adds its `Span`.  ritz0
# says the same (ritz0/builtin_types.py).

# The ritzlib module declaring `name` if it is a built-in type, else null.
# The base name of a concrete generic instance: `Span$u8` names `Span`.
# AGAST #4294: an impl target on a built-in may be a concrete instantiation
# (`impl Display for Span<u8>`), and the parser spells it mangled.
fn type_base_len(name_sv: StrView) -> i32
    var name: *u8 = name_sv.ptr
    var len: i32 = name_sv.len as i32
    var i: i32 = 0
    while i < len and *(name + i) != '$'   # '$'
        i = i + 1
    i

fn builtin_type_module(name_sv: StrView, out_len: *i32) -> *u8
    var name: *u8 = name_sv.ptr
    var len: i32 = name_sv.len as i32
    let base: i32 = type_base_len(StrView { ptr: (name), len: (len) as i64 })
    if base == 4 and memcmp(name, c"Span", 4) == 0
        *out_len = 12
        return c"ritzlib.span"
    if base == 7 and memcmp(name, c"StrView", 7) == 0
        *out_len = 15
        return c"ritzlib.strview"
    if base == 6 and memcmp(name, c"Option", 6) == 0
        *out_len = 14
        return c"ritzlib.option"
    if base == 6 and memcmp(name, c"Result", 6) == 0
        *out_len = 14
        return c"ritzlib.result"
    null

pub fn module_declares_type(m: *Module, name_sv: StrView) -> i32
    var name: *u8 = name_sv.ptr
    var len: i32 = name_sv.len as i32
    # AGAST #3494 (R65): a trait impl's target may be a concrete instance
    # (`Result$i32$i32`, `Span$u8`); the declaration is under its base name.
    let base: i32 = type_base_len(StrView { ptr: (name), len: (len) as i64 })
    var st: *StructDef = m.structs
    while st != null
        if st.name_len == base and memcmp(st.name, name, base as i64) == 0
            return 1
        st = st.next
    if enum_find(StrView { ptr: (name), len: (base) as i64 }) >= 0
        return 1
    0

# AGAST #4294 (R36's revisit): a trait impl on a primitive/built-in is legal
# in the file that declares the trait.  `ib.def_file` is the file the impl was
# parsed from; the trait log records each trait's file.
fn impl_in_trait_file(ib: *ImplBlock) -> i32
    if ib.trait_name == null
        return 0
    trait_declared_in_file(StrView { ptr: (ib.trait_name), len: (ib.trait_name_len) as i64 }, ib.def_file)

# R36's revisit admits `Span<T>` and `StrView`, not Option/Result.  A concrete
# instance (`Span$u8`) is judged by its base.
fn builtin_impl_target_allowed(name_sv: StrView) -> i32
    var name: *u8 = name_sv.ptr
    var len: i32 = name_sv.len as i32
    let base: i32 = type_base_len(StrView { ptr: (name), len: (len) as i64 })
    if base == 4 and memcmp(name, c"Span", 4) == 0
        return 1
    if base == 7 and memcmp(name, c"StrView", 7) == 0
        return 1
    0

# The target's source spelling: `Span$u8` names `Span`, `ptr_u8` is `*u8`,
# anything else is as written.
fn eprint_impl_target(ib: *ImplBlock)
    if ib.ptr_target == 1
        eprint_char('*')
        if ib.type_name_len > 4
            sys_write(2, ib.type_name + 4, (ib.type_name_len - 4) as i64)
        return
    let base: i32 = type_base_len(StrView { ptr: (ib.type_name), len: (ib.type_name_len) as i64 })
    sys_write(2, ib.type_name, base as i64)

# Errors reported; `path` is the main file, for blocks it parsed.
pub fn refuse_impls_on_builtin_types(m: *Module, path: *u8) -> i32
    var errors: i32 = 0
    var ib: *ImplBlock = m.impls
    while ib != null
        var mod_len: i32 = 0
        let module: *u8 = builtin_type_module(StrView { ptr: (ib.type_name), len: (ib.type_name_len) as i64 }, @mod_len)
        # A trait impl on Span/StrView is R36's revisit (#4294); it is this
        # check's to refuse only when inherent, and the placement is
        # impl_target_class's.
        let allowed_trait: i32 = (builtin_impl_target_allowed(StrView { ptr: (ib.type_name), len: (ib.type_name_len) as i64 }) == 1 and ib.trait_name != null) as i32
        if module != null and module_declares_type(m, StrView { ptr: (ib.type_name), len: (ib.type_name_len) as i64 }) == 0 and allowed_trait == 0
            if ib.def_file != null
                eprints_cstr(ib.def_file)
            else
                eprints_cstr(path)
            eprint_char(':')
            eprint_i64(ib.impl_span.line as i64)
            eprint_char(':')
            eprint_i64(ib.impl_span.col as i64)
            eprints_cstr(c": error: `")
            eprint_impl_target(ib)
            eprints_cstr(c"` is a built-in type and can't be extended here: import ")
            sys_write(2, module, mod_len as i64)
            eprints_cstr(c" or declare your own type\n")
            errors += 1
        ib = ib.next
    errors

# AGAST #3264: an `impl` on a type nothing declares or imports is "unknown
# type `Foo`", at the impl's type name.  `impl Foo` with no `struct Foo` /
# `enum Foo` compiled and its methods were unreachable; so did `impl Vec<u8>`
# without ritzlib.vec.  Known: a struct or enum of the merged module, a SIMD
# vector, or one of the impl's own type parameters.  `impl Self` is unknown:
# Self names no type outside an impl.  Two targets never get here: an
# undeclared built-in (refuse_impls_on_builtin_types runs first, and main
# stops on its errors) and a primitive (below).
#
# AGAST #3369 (LARB R35): a `type` alias is known but no impl target: a
# type's methods live under the name it was declared with.  `type Id = Foo`
# then `impl Id` is "`Id` is a type alias for `Foo`: write `impl Foo`", at
# `Id`, before the impl body is lowered (it failed later, unlocated, with
# "unhandled EXPR_MEMBER").  ritz0 says the same
# (ritz0/builtin_types.py, check_unknown_impl_targets).
#
# AGAST #3371 (LARB R36, #3288): a primitive is known but closed.  `impl u8`
# and `impl Speak for i32` are "`i32` is a built-in type; it can't have an
# `impl`", at the type, as in ritz0.  The grammar takes a type_name as the
# target so a keyword type parses (it was an unlocated "Parse error at pos
# 64"); `f64`, `usize` and the like lex as IDENTs and land here too.  A SIMD
# vector (`v4i32`) stays a known target, as in ritz0.
#
# impl_target_class sorts a target; refuse_impls_on_unknown_types says each
# refused class's message.  A new refusal is a new class and a new arm.
#
# AGAST #4211: the impl's trait is judged too, as ritz0 does (#4197): one no
# parsed file declares (imports count) and no compiler trait names is
# "unknown trait `Nonesuch`", at the trait name.  It compiled silently.

const IMPL_TARGET_OK: i32 = 0
const IMPL_TARGET_UNKNOWN: i32 = 1
const IMPL_TARGET_ALIAS: i32 = 2
const IMPL_TARGET_PRIMITIVE: i32 = 3
# R36's revisit (#4294): a trait impl on a primitive / built-in / `*u8` that
# is not in the file declaring the trait.
const IMPL_TARGET_MISPLACED: i32 = 4

fn impl_has_type_param(ib: *ImplBlock, name_sv: StrView) -> i32
    var name: *u8 = name_sv.ptr
    var len: i32 = name_sv.len as i32
    var tp: *TypeParam = ib.type_params
    while tp != null
        if tp.name_len == len and memcmp(tp.name, name, len as i64) == 0
            return 1
        tp = tp.next
    0

# Same order as ritz0: the impl's own type parameter, then an alias, then a
# primitive.
fn impl_target_class(m: *Module, ib: *ImplBlock) -> i32
    let name: *u8 = ib.type_name
    let len: i32 = ib.type_name_len
    if impl_has_type_param(ib, StrView { ptr: (name), len: (len) as i64 }) == 1
        return IMPL_TARGET_OK
    if type_alias_declared(StrView { ptr: (name), len: (len) as i64 }) == 1
        return IMPL_TARGET_ALIAS
    # R36's revisit (#4294): `impl Trait for *u8` — the parser spells the
    # target `ptr_u8` — is legal only in the trait's file.
    if ib.ptr_target == 1
        if impl_in_trait_file(ib) == 1
            return IMPL_TARGET_OK
        return IMPL_TARGET_MISPLACED
    if is_primitive_type_name(StrView { ptr: (name), len: (len) as i64 }) == 1
        # A trait impl on a primitive is legal in the trait's file; an
        # inherent impl still says "it can't have an `impl`".
        if impl_in_trait_file(ib) == 1
            return IMPL_TARGET_OK
        if ib.trait_name != null
            return IMPL_TARGET_MISPLACED
        return IMPL_TARGET_PRIMITIVE
    # `Span<T>` / `StrView` in the trait's file stand even when nothing
    # declares them (the emitter synthesizes them); outside it, the trait
    # impl is misplaced (#4294).
    var mod_len: i32 = 0
    let module: *u8 = builtin_type_module(StrView { ptr: (name), len: (len) as i64 }, @mod_len)
    if module != null and module_declares_type(m, StrView { ptr: (name), len: (len) as i64 }) == 0
        if builtin_impl_target_allowed(StrView { ptr: (name), len: (len) as i64 }) == 1 and ib.trait_name != null
            if impl_in_trait_file(ib) == 1
                return IMPL_TARGET_OK
            return IMPL_TARGET_MISPLACED
    if module_declares_type(m, StrView { ptr: (name), len: (len) as i64 }) == 1 or is_simd_vector_type_name(StrView { ptr: (name), len: (len) as i64 }) == 1
        return IMPL_TARGET_OK
    IMPL_TARGET_UNKNOWN

# R36's revisit (#4294): "`*u8` is a built-in type: a trait impl for it must
# be in the trait's file (§12.2)", the target spelled as the source wrote it
# (`ptr_u8` is `*u8`).
fn eprint_misplaced_target(ib: *ImplBlock)
    eprint_char('`')
    eprint_impl_target(ib)
    eprints_cstr(c"` is a built-in type: a trait impl for it must be in the trait's file (§12.2)\n")

# "`Id` is a type alias for `Foo`: write `impl Foo`", the target as the
# alias wrote it (#3625).  One with no recorded spelling drops the "for `T`".
fn eprint_impl_on_alias(name_sv: StrView)
    var name: *u8 = name_sv.ptr
    var len: i32 = name_sv.len as i32
    var tlen: i32 = 0
    let target: *u8 = type_alias_target_spelling(StrView { ptr: (name), len: (len) as i64 }, @tlen)
    eprint_char('`')
    sys_write(2, name, len as i64)
    if target == null
        eprints_cstr(c"` is a type alias: write `impl` on the type it names\n")
        return
    eprints_cstr(c"` is a type alias for `")
    sys_write(2, target, tlen as i64)
    eprints_cstr(c"`: write `impl ")
    sys_write(2, target, tlen as i64)
    eprints_cstr(c"`\n")

# The traits the compiler knows without a declaration, as ritz0's
# trait_bounds.COMPILER_TRAITS.
pub fn is_compiler_trait(name_sv: StrView) -> i32
    var name: *u8 = name_sv.ptr
    var len: i32 = name_sv.len as i32
    if name_eq(StrView { ptr: (name), len: (len) as i64 }, StrView { ptr: (c"Drop"), len: (4) as i64 }) == 1 or name_eq(StrView { ptr: (name), len: (len) as i64 }, StrView { ptr: (c"Deref"), len: (5) as i64 }) == 1
        return 1
    if name_eq(StrView { ptr: (name), len: (len) as i64 }, StrView { ptr: (c"DerefMut"), len: (8) as i64 }) == 1 or name_eq(StrView { ptr: (name), len: (len) as i64 }, StrView { ptr: (c"Index"), len: (5) as i64 }) == 1
        return 1
    if name_eq(StrView { ptr: (name), len: (len) as i64 }, StrView { ptr: (c"IndexMut"), len: (8) as i64 }) == 1 or name_eq(StrView { ptr: (name), len: (len) as i64 }, StrView { ptr: (c"IndexSet"), len: (8) as i64 }) == 1
        return 1
    0

fn impl_trait_unknown(ib: *ImplBlock) -> i32
    if ib.trait_name == null
        return 0
    if trait_declared(StrView { ptr: (ib.trait_name), len: (ib.trait_name_len) as i64 }) == 1 or is_compiler_trait(StrView { ptr: (ib.trait_name), len: (ib.trait_name_len) as i64 }) == 1
        return 0
    1

# AGAST #4002 (LARB R81): a generic impl declares its own parameters,
# `impl<T> Box<T>`.  In `impl Box<T>` without `<T>`, `T` is an ordinary type
# name; when nothing declares `T` it names nothing, at the `T`:
#
#     unknown type `T`: a generic impl declares it, `impl<T> Box<T>`
#
# The suggestion is the target's declared parameter list, as ritz0's
# impl_placement._free_param prints it (`impl<> Foo<>` for a target with
# none).  Judged only when the target itself is declared, so `impl Nope<T>`
# stays "unknown type `Nope`" at the target.  Only a bare name is judged: a
# nested instance is a mangled `Vec$u8` and a pointer starts `ptr_`, which
# ritz0 skips too (its arg is then not a plain NamedType).  A declared
# parameter, and any known type, is not free.
fn impl_arg_is_bare(ga: *GenericArg) -> i32
    if ga.ty != TYPE_STRUCT or ga.name == null or ga.name_len <= 0
        return 0
    var i: i32 = 0
    while i < ga.name_len and *(ga.name + i) != '$'   # '$': a nested instance
        i = i + 1
    (i == ga.name_len) as i32

fn impl_arg_known(m: *Module, name_sv: StrView) -> i32
    var name: *u8 = name_sv.ptr
    var len: i32 = name_sv.len as i32
    if module_declares_type(m, StrView { ptr: (name), len: (len) as i64 }) == 1 or type_alias_declared(StrView { ptr: (name), len: (len) as i64 }) == 1
        return 1
    if trait_declared(StrView { ptr: (name), len: (len) as i64 }) == 1
        return 1
    if is_primitive_type_name(StrView { ptr: (name), len: (len) as i64 }) == 1 or is_simd_vector_type_name(StrView { ptr: (name), len: (len) as i64 }) == 1
        return 1
    # The built-ins no module declares (ritz0's NameResolver.BUILTIN_TYPES).
    if name_eq(StrView { ptr: (name), len: (len) as i64 }, StrView { ptr: (c"StrView"), len: (7) as i64 }) == 1 or name_eq(StrView { ptr: (name), len: (len) as i64 }, StrView { ptr: (c"Self"), len: (4) as i64 }) == 1
        return 1
    if name_eq(StrView { ptr: (name), len: (len) as i64 }, StrView { ptr: (c"Option"), len: (6) as i64 }) == 1 or name_eq(StrView { ptr: (name), len: (len) as i64 }, StrView { ptr: (c"Result"), len: (6) as i64 }) == 1
        return 1
    if name_eq(StrView { ptr: (name), len: (len) as i64 }, StrView { ptr: (c"Span"), len: (4) as i64 }) == 1 or name_eq(StrView { ptr: (name), len: (len) as i64 }, StrView { ptr: (c"void"), len: (4) as i64 }) == 1
        return 1
    name_eq(StrView { ptr: (name), len: (len) as i64 }, StrView { ptr: (c"Future"), len: (6) as i64 })

# The target's declared parameters, when a struct or enum declares it.
# `*found` says whether one did (an alias, a trait or an unknown name does
# not, and then ritz0's check skips the impl too).
fn impl_decl_params(m: *Module, name_sv: StrView, found: *i32) -> *TypeParam
    var name: *u8 = name_sv.ptr
    var len: i32 = name_sv.len as i32
    var st: *StructDef = m.structs
    while st != null
        if st.name_len == len and memcmp(st.name, name, len as i64) == 0
            *found = 1
            return st.type_params
        st = st.next
    let ei: i32 = enum_find(StrView { ptr: (name), len: (len) as i64 })
    if ei >= 0
        *found = 1
        return generic_enum_params(ei)
    *found = 0
    null

# The first argument that is neither the impl's own parameter nor a known
# type, or null.
fn impl_free_arg(m: *Module, ib: *ImplBlock) -> *GenericArg
    var ga: *GenericArg = ib.impl_args
    while ga != null
        if impl_arg_is_bare(ga) == 1
            if impl_has_type_param(ib, StrView { ptr: (ga.name), len: (ga.name_len) as i64 }) == 0 and impl_arg_known(m, StrView { ptr: (ga.name), len: (ga.name_len) as i64 }) == 0
                return ga
        ga = ga.next
    null

fn eprint_type_param_list(tp: *TypeParam)
    var cur: *TypeParam = tp
    var first: i32 = 1
    while cur != null
        if first == 0
            eprints_cstr(c", ")
        first = 0
        sys_write(2, cur.name, cur.name_len as i64)
        cur = cur.next

# Errors reported; `path` is the main file, for blocks it parsed.
pub fn refuse_impls_on_unknown_types(m: *Module, path: *u8) -> i32
    var errors: i32 = 0
    var ib: *ImplBlock = m.impls
    while ib != null
        if impl_trait_unknown(ib) == 1
            var tfile: *u8 = path
            if ib.def_file != null
                tfile = ib.def_file
            diag_error_at(tfile, ib.trait_span)
            eprints_cstr(c"unknown trait `")
            sys_write(2, ib.trait_name, ib.trait_name_len as i64)
            eprints_cstr(c"`\n")
            errors += 1
        # AGAST #4002: R81's free parameter, before the target's class: in
        # `impl Box<T>` the target `Box` is known, and it is `T` that names
        # nothing.  The target's base names the declaration (`Box$T` too).
        let base: i32 = type_base_len(StrView { ptr: (ib.type_name), len: (ib.type_name_len) as i64 })
        var declared: i32 = 0
        let params: *TypeParam = impl_decl_params(m, StrView { ptr: (ib.type_name), len: (base) as i64 }, @declared)
        if declared == 1
            let free: *GenericArg = impl_free_arg(m, ib)
            if free != null
                var ffile: *u8 = path
                if ib.def_file != null
                    ffile = ib.def_file
                diag_error_at(ffile, free.at)
                eprints_cstr(c"unknown type `")
                sys_write(2, free.name, free.name_len as i64)
                eprints_cstr(c"`: a generic impl declares it, `impl<")
                eprint_type_param_list(params)
                eprints_cstr(c"> ")
                sys_write(2, ib.type_name, base as i64)
                eprints_cstr(c"<")
                eprint_type_param_list(params)
                eprints_cstr(c">`\n")
                errors += 1
                ib = ib.next
                continue
        let cls: i32 = impl_target_class(m, ib)
        if cls != IMPL_TARGET_OK
            var file: *u8 = path
            if ib.def_file != null
                file = ib.def_file
            diag_error_at(file, ib.type_span)
            if cls == IMPL_TARGET_ALIAS
                eprint_impl_on_alias(StrView { ptr: (ib.type_name), len: (ib.type_name_len) as i64 })
            else if cls == IMPL_TARGET_PRIMITIVE
                eprint_char('`')
                sys_write(2, ib.type_name, ib.type_name_len as i64)
                eprints_cstr(c"` is a built-in type; it can't have an `impl`\n")
            else if cls == IMPL_TARGET_MISPLACED
                eprint_misplaced_target(ib)
            else
                eprints_cstr(c"unknown type `")
                sys_write(2, ib.type_name, ib.type_name_len as i64)
                eprints_cstr(c"`\n")
            errors += 1
        ib = ib.next
    errors

# AGAST #3127: `Span<T>` is a built-in shape, as in ritz0. Without
# `import ritzlib.span` no template existed, so `Span<i32>` named a
# `%Span$i32` no struct declared (clang: "invalid type for function
# argument"), and `s.ptr` on it, or on any generic fn's `Span<X>` instance,
# was "unhandled EXPR_MEMBER". Unless the program has a `Span` of its own
# (ritzlib.span's, imported), add the template ritzlib.span spells:
#
#     struct Span<T>
#         ptr: *T
#         len: i64
#
# with the fields the parser builds for it (field_new): `*T` is a pointer
# whose pointee is the struct named "T", which clone_struct_fields
# substitutes. Unused, a template emits nothing.
pub fn ensure_builtin_span_template(m: *Module)
    var st: *StructDef = m.structs
    while st != null
        if st.name_len == 4 and memcmp(st.name, c"Span", 4) == 0
            return
        st = st.next
    let len_f: *StructField = calloc(1, sizeof(StructField)) as *StructField
    len_f.name = c"len"
    len_f.name_len = 3
    len_f.field_type = TYPE_I64
    len_f.ptr_pointee = TYPE_VOID
    len_f.array_elem_pointee = TYPE_VOID
    len_f.inner_pointee_type = TYPE_VOID
    let ptr_f: *StructField = calloc(1, sizeof(StructField)) as *StructField
    ptr_f.name = c"ptr"
    ptr_f.name_len = 3
    ptr_f.field_type = TYPE_PTR
    ptr_f.ptr_pointee = TYPE_STRUCT
    ptr_f.field_type_name = c"T"
    ptr_f.field_type_name_len = 1
    ptr_f.array_elem_pointee = TYPE_VOID
    ptr_f.inner_pointee_type = TYPE_VOID
    ptr_f.next = len_f
    let tp: *TypeParam = calloc(1, sizeof(TypeParam)) as *TypeParam
    tp.name = c"T"
    tp.name_len = 1
    let span: *StructDef = calloc(1, sizeof(StructDef)) as *StructDef
    span.name = c"Span"
    span.name_len = 4
    span.fields = ptr_f
    span.type_params = tp
    span.next = m.structs
    m.structs = span

# ============================================================================
# Local-var Type Tracking (per fn body, for UFCS-driven instantiation)
# ============================================================================
# When we see `var v = vec_new<u16>()` at the AST level, monomorph normally
# only records `vec_new$u16` (the explicit generic call).  But the later
# `v.push(...)` call is an EXPR_METHOD whose mangled fn name (`vec_push$u16`)
# is computed at emit time — without a hook here, we never collect that
# instantiation, the linker can't find `vec_push$u16`, and the UFCS dispatch
# in emitter_expr_call.ritz falls back to the broken `Vec$u16_push` mangling.
#
# Solution: walk fn bodies tracking which local vars hold Vec<T> / Span<T>
# (inferred from the initializer), then on every EXPR_METHOD with an IDENT
# receiver, register the corresponding `vec_<method>$<T>` / `span_<method>$<T>`
# instantiation when a matching generic template exists.

# Holds the Vec/Span locals AND the plain-struct locals (kind 0) that field
# receivers resolve through (AGAST #1512).  Grows by doubling: entries past
# the old fixed cap of 256 used to be dropped silently (AGAST #1813).
const LOCAL_VARS_INIT_CAP: i32 = 256

var g_lv_names: **u8 = null
var g_lv_name_lens: *i32 = null
var g_lv_prefix_kind: *i32 = null      # 0 = plain struct, 1 = Vec, 2 = Span
var g_lv_suffixes: **u8 = null         # The "$T" portion (with leading $)
var g_lv_suffix_lens: *i32 = null
var g_lv_type_names: **u8 = null       # Kind 0: the struct's name (e.g. "R")
var g_lv_type_name_lens: *i32 = null
var g_lv_by_value: *i32 = null         # 1: the local IS the struct, not *T / @T (AGAST #2451)
                                       # 2: a *T, @T or @&T of it, one level (AGAST #2448)
var g_lv_shared: *i32 = null           # 1: an `@T` param or local, which refuses writes (§3.2)
var g_lv_count: i32 = 0
var g_lv_cap: i32 = 0
var g_lv_initialized: i32 = 0

fn init_local_var_tracker()
    if g_lv_initialized == 1
        return
    g_lv_cap = LOCAL_VARS_INIT_CAP
    g_lv_names = malloc((g_lv_cap as i64) * 8) as **u8
    g_lv_name_lens = malloc((g_lv_cap as i64) * 4) as *i32
    g_lv_prefix_kind = malloc((g_lv_cap as i64) * 4) as *i32
    g_lv_suffixes = malloc((g_lv_cap as i64) * 8) as **u8
    g_lv_suffix_lens = malloc((g_lv_cap as i64) * 4) as *i32
    g_lv_type_names = malloc((g_lv_cap as i64) * 8) as **u8
    g_lv_type_name_lens = malloc((g_lv_cap as i64) * 4) as *i32
    g_lv_by_value = malloc((g_lv_cap as i64) * 4) as *i32
    g_lv_shared = malloc((g_lv_cap as i64) * 4) as *i32
    g_lv_initialized = 1
    g_lv_count = 0

fn reset_local_var_tracker()
    g_lv_count = 0
    g_al_count = 0

# `[N]S` locals (and `[N]*S`, `[N]@S`), name -> S, so `a[i].m()` is typed
# (AGAST #4231, receiver_instance).  Reset with the tracker above.
var g_al_names: **u8 = null
var g_al_name_lens: *i32 = null
var g_al_elems: **u8 = null
var g_al_elem_lens: *i32 = null
var g_al_count: i32 = 0
var g_al_cap: i32 = 0

fn track_array_local(name_sv: StrView, elem_sv: StrView)
    var name: *u8 = name_sv.ptr
    var name_len: i32 = name_sv.len as i32
    var elem: *u8 = elem_sv.ptr
    var elem_len: i32 = elem_sv.len as i32
    if elem == null or elem_len <= 0
        return
    if g_al_count >= g_al_cap
        var cap: i32 = g_al_cap * 2
        if cap == 0
            cap = 16
        g_al_names = realloc(g_al_names as *u8, (cap as i64) * 8) as **u8
        g_al_name_lens = realloc(g_al_name_lens as *u8, (cap as i64) * 4) as *i32
        g_al_elems = realloc(g_al_elems as *u8, (cap as i64) * 8) as **u8
        g_al_elem_lens = realloc(g_al_elem_lens as *u8, (cap as i64) * 4) as *i32
        g_al_cap = cap
    *(g_al_names + g_al_count) = name
    *(g_al_name_lens + g_al_count) = name_len
    *(g_al_elems + g_al_count) = elem
    *(g_al_elem_lens + g_al_count) = elem_len
    g_al_count = g_al_count + 1

# The element type name of `[N]S` local `name`, or null.  The latest
# declaration of the name wins.
fn array_local_elem(name_sv: StrView, out_len: *i32) -> *u8
    var name: *u8 = name_sv.ptr
    var name_len: i32 = name_sv.len as i32
    var i: i32 = g_al_count - 1
    while i >= 0
        if name_eq(StrView { ptr: (*(g_al_names + i)), len: (*(g_al_name_lens + i)) as i64 }, StrView { ptr: (name), len: (name_len) as i64 }) == 1
            *out_len = *(g_al_elem_lens + i)
            return *(g_al_elems + i)
        i = i - 1
    null

fn add_local_var(name_sv: StrView, prefix_kind: i32, suffix_sv: StrView)
    var name: *u8 = name_sv.ptr
    var name_len: i32 = name_sv.len as i32
    var suffix: *u8 = suffix_sv.ptr
    var suffix_len: i32 = suffix_sv.len as i32
    if g_lv_count >= g_lv_cap
        let cap: i64 = (g_lv_cap as i64) * 2
        g_lv_names = realloc(g_lv_names as *u8, cap * 8) as **u8
        g_lv_name_lens = realloc(g_lv_name_lens as *u8, cap * 4) as *i32
        g_lv_prefix_kind = realloc(g_lv_prefix_kind as *u8, cap * 4) as *i32
        g_lv_suffixes = realloc(g_lv_suffixes as *u8, cap * 8) as **u8
        g_lv_suffix_lens = realloc(g_lv_suffix_lens as *u8, cap * 4) as *i32
        g_lv_type_names = realloc(g_lv_type_names as *u8, cap * 8) as **u8
        g_lv_type_name_lens = realloc(g_lv_type_name_lens as *u8, cap * 4) as *i32
        g_lv_by_value = realloc(g_lv_by_value as *u8, cap * 4) as *i32
        g_lv_shared = realloc(g_lv_shared as *u8, cap * 4) as *i32
        g_lv_cap = cap as i32
    *(g_lv_names + g_lv_count) = name
    *(g_lv_name_lens + g_lv_count) = name_len
    *(g_lv_prefix_kind + g_lv_count) = prefix_kind
    *(g_lv_suffixes + g_lv_count) = suffix
    *(g_lv_suffix_lens + g_lv_count) = suffix_len
    *(g_lv_type_names + g_lv_count) = null
    *(g_lv_type_name_lens + g_lv_count) = 0
    *(g_lv_by_value + g_lv_count) = 0
    *(g_lv_shared + g_lv_count) = 0
    g_lv_count = g_lv_count + 1

# The local just added holds the struct itself, not a pointer to one.
fn mark_last_local_by_value()
    if g_lv_count > 0
        *(g_lv_by_value + g_lv_count - 1) = 1

# Record a local/param whose type is a (non-collection) struct or a pointer
# or reference to one, so a field receiver rooted at it — `r.raw.push(9)` —
# can resolve the field's type (AGAST #1512).  Kind 0 never matches a UFCS
# prefix, so the ident-receiver path ignores these entries.
fn add_local_struct_var(name_sv: StrView, type_name_sv: StrView)
    var name: *u8 = name_sv.ptr
    var name_len: i32 = name_sv.len as i32
    var type_name: *u8 = type_name_sv.ptr
    var type_name_len: i32 = type_name_sv.len as i32
    if type_name == null or type_name_len <= 0
        return
    add_local_var(StrView { ptr: (name), len: (name_len) as i64 }, 0, StrView { ptr: (null), len: (0) as i64 })
    *(g_lv_type_names + g_lv_count - 1) = type_name
    *(g_lv_type_name_lens + g_lv_count - 1) = type_name_len

# Record a binding of type `type_kind`/`type_name`: Vec/Span by-value go to
# the UFCS kinds; any other named struct (by value, *T, @T, @&T) is kind 0.
fn track_typed_local(name_sv: StrView, type_kind: i32, type_name_sv: StrView)
    var name: *u8 = name_sv.ptr
    var name_len: i32 = name_sv.len as i32
    var type_name: *u8 = type_name_sv.ptr
    var type_name_len: i32 = type_name_sv.len as i32
    if type_name == null or type_name_len <= 0
        return
    if type_kind != TYPE_STRUCT and type_kind != TYPE_PTR and type_kind != TYPE_REF and type_kind != TYPE_MUT_REF
        return
    var suf: *u8 = null
    var suf_len: i32 = 0
    let kind: i32 = classify_collection_type(StrView { ptr: (type_name), len: (type_name_len) as i64 }, @suf, @suf_len)
    if kind > 0
        # By value or through *T / @T / @&T alike: the emitter's UFCS
        # dispatch loads a pointer receiver itself, so `points:& Vec<P>`
        # needs `vec_slice$P` registered just as a local Vec would
        # (angelo's `points[:]`, AGAST #1794).
        add_local_var(StrView { ptr: (name), len: (name_len) as i64 }, kind, StrView { ptr: (suf), len: (suf_len) as i64 })
    else
        add_local_struct_var(StrView { ptr: (name), len: (name_len) as i64 }, StrView { ptr: (type_name), len: (type_name_len) as i64 })
    if type_kind == TYPE_STRUCT
        mark_last_local_by_value()

# track_typed_local, and a `*T`, `@T` or `@&T` whose pointee is the struct
# itself (not `**T`) is marked as one, so `p[lo..hi]` can slice what it points
# at (AGAST #2448).  `pointee` is the param's or let's pointee type.
fn track_typed_local_through(name_sv: StrView, type_kind: i32, pointee: i32, type_name_sv: StrView)
    var name: *u8 = name_sv.ptr
    var name_len: i32 = name_sv.len as i32
    var type_name: *u8 = type_name_sv.ptr
    var type_name_len: i32 = type_name_sv.len as i32
    let before: i32 = g_lv_count
    track_typed_local(StrView { ptr: (name), len: (name_len) as i64 }, type_kind, StrView { ptr: (type_name), len: (type_name_len) as i64 })
    if g_lv_count == before or pointee != TYPE_STRUCT
        return
    if type_kind == TYPE_PTR or type_kind == TYPE_REF or type_kind == TYPE_MUT_REF
        *(g_lv_by_value + g_lv_count - 1) = 2
    if type_kind == TYPE_REF
        *(g_lv_shared + g_lv_count - 1) = 1

# Un-annotated `let p = @v` / `@&v` of a by-value Vec, Span or String local:
# `p` points at it, one level, as `let p: @Vec<T> = @v` would (AGAST #2448).
fn track_address_of_local(name_sv: StrView, of: *Expr)
    var name: *u8 = name_sv.ptr
    var name_len: i32 = name_sv.len as i32
    if of == null or of.kind != EXPR_IDENT
        return
    let idx: i32 = find_local_var_idx(StrView { ptr: (of.ident_ptr), len: (of.ident_len) as i64 })
    if idx < 0 or *(g_lv_by_value + idx) != 1
        return
    add_local_var(StrView { ptr: (name), len: (name_len) as i64 }, *(g_lv_prefix_kind + idx), StrView { ptr: (*(g_lv_suffixes + idx)), len: (*(g_lv_suffix_lens + idx)) as i64 })
    *(g_lv_type_names + g_lv_count - 1) = *(g_lv_type_names + idx)
    *(g_lv_type_name_lens + g_lv_count - 1) = *(g_lv_type_name_lens + idx)
    *(g_lv_by_value + g_lv_count - 1) = 2

# A field holding an `@T` or `@&T`: one level, like a `*T` (AGAST #2383).
fn field_is_ref(f: *StructField) -> i32
    (f.field_type == TYPE_REF or f.field_type == TYPE_MUT_REF) as i32

# Resolve the type of the field named by an EXPR_MEMBER chain rooted at a
# tracked local: `r.raw` → "Vec$u8", `o.q.a` → "A".  Emits nothing.  Returns
# the *StructField, or null when any link is unknown.  (AGAST #1512)
fn resolve_member_field(m: *Module, e: *Expr) -> *StructField
    if e == null or e.kind != EXPR_MEMBER or e.left == null
        return null
    var sname: *u8 = null
    var sname_len: i32 = 0
    if e.left.kind == EXPR_IDENT
        let idx: i32 = find_local_var_idx(StrView { ptr: (e.left.ident_ptr), len: (e.left.ident_len) as i64 })
        if idx >= 0
            sname = *(g_lv_type_names + idx)
            sname_len = *(g_lv_type_name_lens + idx)
    else if e.left.kind == EXPR_MEMBER
        let parent: *StructField = resolve_member_field(m, e.left)
        if parent != null
            # Through a held `@T` / `@&T` as through a `*T` (AGAST #2383).
            if parent.field_type == TYPE_STRUCT or parent.field_type == TYPE_PTR or field_is_ref(parent) == 1
                sname = parent.field_type_name
                sname_len = parent.field_type_name_len
    if sname == null or sname_len <= 0
        return null
    let st: *StructDef = find_concrete_struct(m, StrView { ptr: (sname), len: (sname_len) as i64 })
    if st == null
        return template_member_field(m, StrView { ptr: (sname), len: (sname_len) as i64 }, e)
    var f: *StructField = st.fields
    while f != null
        if f.name_len == e.ident_len
            if memcmp(f.name, e.ident_ptr, e.ident_len as i64) == 0
                return f
        f = f.next
    return null

# AGAST #2411: field `e` of `B$i32` before it's specialised (instantiations are
# collected first): the one-parameter template's field, with a `Vec$T` type
# rewritten to `Vec$i32`, so `b.v.push(3)` instantiates `vec_push$i32`.  null
# for anything else.
fn template_member_field(m: *Module, sname_sv: StrView, e: *Expr) -> *StructField
    var sname: *u8 = sname_sv.ptr
    var sname_len: i32 = sname_sv.len as i32
    let dollar: i32 = find_dollar_sign(StrView { ptr: (sname), len: (sname_len) as i64 })
    if dollar <= 0
        return null
    let tmpl: *StructDef = find_generic_struct(m, StrView { ptr: (sname), len: (dollar) as i64 })
    if tmpl == null or count_type_params(tmpl.type_params) != 1
        return null
    var f: *StructField = tmpl.fields
    while f != null
        if f.name_len == e.ident_len and memcmp(f.name, e.ident_ptr, e.ident_len as i64) == 0
            break
        f = f.next
    if f == null or f.field_type != TYPE_STRUCT or f.field_type_name == null
        return null
    if find_dollar_sign(StrView { ptr: (f.field_type_name), len: (f.field_type_name_len) as i64 }) <= 0
        return null
    let out: *StructField = malloc(sizeof(StructField)) as *StructField
    memcpy(out as *u8, f as *u8, sizeof(StructField))
    var sub_len: i32 = 0
    substitute_type_param_in_name(StrView { ptr: (f.field_type_name), len: (f.field_type_name_len) as i64 }, StrView { ptr: (tmpl.type_params.name), len: (tmpl.type_params.name_len) as i64 }, StrView { ptr: (sname + dollar), len: (sname_len - dollar) as i64 }, @out.field_type_name, @sub_len)
    out.field_type_name_len = sub_len
    out.next = null
    out

# The method `meth` of the inherent generic impl of Vec (kind 1) or Span
# (kind 2), and through out_ib that impl, or null.  Method syntax reaches only
# impl methods (LARB R66); the vec_/span_ prefix table this replaced went with
# AGAST #4303.
fn collection_impl_method(m: *Module, kind: i32, meth_sv: StrView, out_ib: **ImplBlock) -> *FnDef
    var meth: *u8 = meth_sv.ptr
    var meth_len: i32 = meth_sv.len as i32
    var base: *u8 = c"Vec"
    var bl: i32 = 3
    if kind == 2
        base = c"Span"
        bl = 4
    else if kind != 1
        return null
    var ib: *ImplBlock = m.impls
    while ib != null
        if ib.type_params != null and (ib.trait_name == null or ib.trait_name_len == 0) and name_eq(StrView { ptr: (ib.type_name), len: (ib.type_name_len) as i64 }, StrView { ptr: (base), len: (bl) as i64 }) == 1
            var f: *FnDef = ib.methods
            while f != null
                if name_eq(StrView { ptr: (f.name), len: (f.name_len) as i64 }, StrView { ptr: (meth), len: (meth_len) as i64 }) == 1
                    *out_ib = ib
                    return f
                f = f.next
        ib = ib.next
    null

# AGAST #1798: record an un-annotated local initialised by a method call on a
# tracked ident receiver -- `var s = a.slice(0, n)`, `var s = a[:]` (which
# lowers to that call), `var v = b.items()` -- so a later `s.push(..)`
# wants `Vec$T.push` even when no other receiver calls push.
fn track_method_init_local(m: *Module, name_sv: StrView, init: *Expr)
    var name: *u8 = name_sv.ptr
    var name_len: i32 = name_sv.len as i32
    if init.left == null or init.left.kind != EXPR_IDENT
        return
    let idx: i32 = find_local_var_idx(StrView { ptr: (init.left.ident_ptr), len: (init.left.ident_len) as i64 })
    if idx < 0
        return
    let kind: i32 = *(g_lv_prefix_kind + idx)
    if kind > 0
        # Vec/Span receiver: an impl method returning its own collection
        # over the impl's type parameter (`fn slice(..) -> Vec<T>`, "Vec$T")
        # gives that collection at the receiver's suffix.
        var cib: *ImplBlock = null
        let tmpl: *FnDef = collection_impl_method(m, kind, StrView { ptr: (init.ident_ptr), len: (init.ident_len) as i64 }, @cib)
        if tmpl == null or tmpl.return_type != TYPE_STRUCT
            return
        var rsuf: *u8 = null
        var rsuf_len: i32 = 0
        let rkind: i32 = classify_collection_type(StrView { ptr: (tmpl.return_type_name), len: (tmpl.return_type_name_len) as i64 }, @rsuf, @rsuf_len)
        let tp: *TypeParam = cib.type_params
        if rkind > 0 and rsuf_len == tp.name_len + 1
            if memcmp(rsuf + 1, tp.name, tp.name_len as i64) == 0
                add_local_var(StrView { ptr: (name), len: (name_len) as i64 }, rkind, StrView { ptr: (*(g_lv_suffixes + idx)), len: (*(g_lv_suffix_lens + idx)) as i64 })
                mark_last_local_by_value()
        return
    # Struct receiver (by value or pointer): its non-generic impl method's
    # return type, recorded like an annotation of that type.
    let tn: *u8 = *(g_lv_type_names + idx)
    let tn_len: i32 = *(g_lv_type_name_lens + idx)
    # `s.slice(lo, hi)` on a String is string_slice, a String (no impl method
    # says so), and what `let t = s[lo..hi]` became (AGAST #2451).
    if name_eq(StrView { ptr: (tn), len: (tn_len) as i64 }, StrView { ptr: (c"String"), len: (6) as i64 }) == 1 and name_eq(StrView { ptr: (init.ident_ptr), len: (init.ident_len) as i64 }, StrView { ptr: (c"slice"), len: (5) as i64 }) == 1
        track_typed_local(StrView { ptr: (name), len: (name_len) as i64 }, TYPE_STRUCT, StrView { ptr: (c"String"), len: (6) as i64 })
        return
    var ib: *ImplBlock = m.impls
    while ib != null
        if ib.type_params == null and ib.type_name_len == tn_len
            if memcmp(ib.type_name, tn, tn_len as i64) == 0
                var meth: *FnDef = ib.methods
                while meth != null
                    if meth.name_len == init.ident_len
                        if memcmp(meth.name, init.ident_ptr, init.ident_len as i64) == 0
                            track_typed_local(StrView { ptr: (name), len: (name_len) as i64 }, meth.return_type, StrView { ptr: (meth.return_type_name), len: (meth.return_type_name_len) as i64 })
                            return
                    meth = meth.next
        ib = ib.next

fn find_local_var_idx(name_sv: StrView) -> i32
    var name: *u8 = name_sv.ptr
    var name_len: i32 = name_sv.len as i32
    for i in 0..g_lv_count
        if *(g_lv_name_lens + i) == name_len
            if memcmp(*(g_lv_names + i), name, name_len as i64) == 0
                return i
    return -1

# If `type_name` is a Vec$T or Span$T mangled name, return the prefix kind
# (1 = Vec, 2 = Span) and write the inner suffix (with leading $) to out.
# Returns 0 if no match.
pub fn classify_collection_type(type_name_sv: StrView, out_suffix: **u8, out_suffix_len: *i32) -> i32
    var type_name: *u8 = type_name_sv.ptr
    var type_name_len: i32 = type_name_sv.len as i32
    if type_name == null or type_name_len < 5
        return 0
    # "Vec$..." → kind 1, suffix starts at index 3
    if *(type_name + 0) == 'V' and *(type_name + 1) == 'e' and *(type_name + 2) == 'c' and *(type_name + 3) == '$'
        *out_suffix = type_name + 3
        *out_suffix_len = type_name_len - 3
        return 1
    # "Span$..." → kind 2, suffix starts at index 4 (need 6+ bytes)
    if type_name_len >= 6
        if *(type_name + 0) == 'S' and *(type_name + 1) == 'p' and *(type_name + 2) == 'a' and *(type_name + 3) == 'n' and *(type_name + 4) == '$'
            *out_suffix = type_name + 4
            *out_suffix_len = type_name_len - 4
            return 2
    return 0

# Walk module functions looking for any (generic or specialized) fn matching
# the given name.  Used during collection to resolve a var-decl initializer
# call's return type so we can infer the local var's struct type.
pub fn find_fn_in_module(m: *Module, name_sv: StrView) -> *FnDef
    var name: *u8 = name_sv.ptr
    var name_len: i32 = name_sv.len as i32
    var f: *FnDef = m.functions
    while f != null
        if f.name_len == name_len
            if memcmp(f.name, name, name_len as i64) == 0
                return f
        f = f.next
    return null

# ============================================================================
# Instantiation Collection
# ============================================================================
# Walk the AST to find all generic function and struct instantiations

# Check if a name contains '$' (indicating a mangled generic)
# Returns the position of '$' or -1 if not found
fn find_dollar_sign(name_sv: StrView) -> i32
    var name: *u8 = name_sv.ptr
    var len: i32 = name_sv.len as i32
    for i in 0..len
        if *(name + i) == '$'  # '$'
            return i
    return -1

# AGAST #3110: the leaf of a `[N][M]..P<i64>` declaration.  A multi-
# dimensional array keeps its leaf struct only in the shape (the 1-D
# array_elem_type_name / var_type_name are unset), so a walk of those never
# instantiated P$i64 and `gb[1][2].v` fell to "unhandled EXPR_MEMBER".
fn add_struct_from_array_shape(m: *Module, sh: *ArrayShape)
    if sh != null and sh.leaf_name != null
        add_struct_from_mangled_name(m, StrView { ptr: (sh.leaf_name), len: (sh.leaf_name_len) as i64 })

# AGAST #3021: `Option$Slot$i32` / `Result$Two$u8$i64$Slot$i32` are laid out
# by the emitter, but the instances their arguments name are this module's to
# record: with only `Option<Slot<i32>>` naming `Slot<i32>`, a `Some(s)` arm
# bound `s` as an i64, so `match s` was "a variant pattern needs an enum
# scrutinee".  The name itself is still add_enum_instance's: ritzlib.option
# and ritzlib.result declare `enum Option<T>` / `enum Result<T, E>`.
fn add_builtin_enum_args(m: *Module, name_sv: StrView, dollar_pos: i32)
    var name: *u8 = name_sv.ptr
    var len: i32 = name_sv.len as i32
    if dollar_pos != 6 or len <= 7
        return
    let is_option: i32 = (memcmp(name, c"Option", 6) == 0) as i32
    if is_option == 0 and memcmp(name, c"Result", 6) != 0
        return
    let suffix: *u8 = name + dollar_pos
    let suffix_len: i32 = len - dollar_pos
    if is_option == 1
        # One parameter: the whole suffix is its argument.
        add_struct_from_mangled_name(m, StrView { ptr: (suffix + 1), len: (suffix_len - 1) as i64 })
        return
    let cap: i64 = 4 * mangled_arg_capacity(StrView { ptr: (suffix), len: (suffix_len) as i64 }) as i64
    let starts: *i32 = malloc(cap) as *i32
    let lens: *i32 = malloc(cap) as *i32
    let n: i32 = split_mangled_args(m, StrView { ptr: (suffix), len: (suffix_len) as i64 }, starts, lens)
    for i in 0..n
        add_struct_from_mangled_name(m, StrView { ptr: (suffix + *(starts + i) + 1), len: (*(lens + i) - 1) as i64 })
    free(starts as *u8)
    free(lens as *u8)

# Add struct instantiation from a mangled name like "Pair$i32"
# Splits on '$' to get base name and suffix
fn add_struct_from_mangled_name(m: *Module, name_sv: StrView)
    var name: *u8 = name_sv.ptr
    var len: i32 = name_sv.len as i32
    let dollar_pos: i32 = find_dollar_sign(StrView { ptr: (name), len: (len) as i64 })
    if dollar_pos <= 0
        return  # Not a mangled name

    let base_name: *u8 = name
    let base_len: i32 = dollar_pos

    # Only add if this is actually a generic struct template
    let template: *StructDef = find_generic_struct(m, StrView { ptr: (base_name), len: (base_len) as i64 })
    if template == null
        add_builtin_enum_args(m, StrView { ptr: (name), len: (len) as i64 }, dollar_pos)   # AGAST #3021
        add_enum_instance(m, StrView { ptr: (name), len: (len) as i64 }, dollar_pos)   # AGAST #2422
        add_enum_impl_instance(m, StrView { ptr: (name), len: (len) as i64 }, dollar_pos)   # AGAST #3309
        return  # Not a generic struct we know about

    # Create suffix including the '$'
    let suffix: *u8 = name + dollar_pos
    let suffix_len: i32 = len - dollar_pos

    # AGAST #1574: a multi-parameter template needs exactly one argument per
    # parameter.  (Unlike `Vec$T` below, no placeholder check: nothing
    # registers a `Pair$T$i64` today — see AGAST #1582.)
    if count_type_params(template.type_params) >= 2
        let cap: i64 = 4 * mangled_arg_capacity(StrView { ptr: (suffix), len: (suffix_len) as i64 }) as i64
        let starts: *i32 = malloc(cap) as *i32
        let lens: *i32 = malloc(cap) as *i32
        if split_mangled_args(m, StrView { ptr: (suffix), len: (suffix_len) as i64 }, starts, lens) == count_type_params(template.type_params)
            add_struct_instantiation(StrView { ptr: (base_name), len: (base_len) as i64 }, StrView { ptr: (suffix), len: (suffix_len) as i64 })
        return

    # `Vec$T`: the unsubstituted placeholder of a generic signature, not an
    # instantiation.  A lone ASCII capital after `$` is a type parameter —
    # unless the module defines a concrete struct by that name: `Vec<P>` for
    # a user `struct P` mangles to `Vec$P`, the same shape (AGAST #1487).
    # Or a user `enum C`: `Vec<C>` is `Vec$C` too, and taking it for the
    # placeholder left `Vec$C` with no struct, so `vec_get<C>` and every
    # `v.len` on it was `unhandled EXPR_MEMBER` (AGAST #2411).
    if suffix_len == 2
        let ch: i32 = *(suffix + 1) as i32
        if ch >= 'A' and ch <= 'Z'
            if find_concrete_struct(m, StrView { ptr: (suffix + 1), len: (1) as i64 }) == null and names_concrete_enum(StrView { ptr: (suffix + 1), len: (1) as i64 }) == 0
                return

    add_struct_instantiation(StrView { ptr: (base_name), len: (base_len) as i64 }, StrView { ptr: (suffix), len: (suffix_len) as i64 })

# ----------------------------------------------------------------------------
# Multi-parameter generic structs (AGAST #1574)
# ----------------------------------------------------------------------------
# The parser mangles EVERY type argument, `$`-separated: `Pair<i64, i32>` is
# `Pair$i64$i32` and `Pair<i64, Box<i64>>` is `Pair$i64$Box$i64`.  Nested
# generics share the separator, so splitting a suffix into its arguments
# needs each component's arity: `Box` (one parameter) owns the `$i64` after
# it.  Single-parameter templates never split — their whole suffix is the
# one argument, exactly as before #1574.
#
# That `$`-before-every-component form is ritz1's internal spelling only.  The
# IR spells every name as LANGUAGE_SPEC §11.4 and ritz0 do, `_` after the first
# `$` (`Pair$i64_Box_i64`): emit_name flattens it on the way out (AGAST #3446).

# AGAST #1906: no fixed cap on type arguments (it was 8, and a 9th dropped the
# instantiation, so the program failed at link).  Every argument starts with
# its own `$`, so the suffix's `$` count bounds the argument count; callers
# size split_mangled_args' starts/lens buffers with it.
pub fn mangled_arg_capacity(suffix_sv: StrView) -> i32
    var suffix: *u8 = suffix_sv.ptr
    var suffix_len: i32 = suffix_sv.len as i32
    var n: i32 = 0
    for i in 0..suffix_len
        if *(suffix + i) == '$'   # '$'
            n = n + 1
    if n == 0
        return 1
    n

pub fn count_type_params(tp: *TypeParam) -> i32
    var n: i32 = 0
    var cur: *TypeParam = tp
    while cur != null
        n = n + 1
        cur = cur.next
    n

# Arity of the generic type named by one `$`-component of a mangled name: a
# generic struct template's parameter count, or Result/Option's (ritz1 keeps
# no enum definitions, but their mangled names nest like structs).  0 for a
# primitive or a concrete struct: a leaf.
pub fn mangled_component_arity(m: *Module, name_sv: StrView) -> i32
    var name: *u8 = name_sv.ptr
    var len: i32 = name_sv.len as i32
    let t: *StructDef = find_generic_struct(m, StrView { ptr: (name), len: (len) as i64 })
    if t != null
        return count_type_params(t.type_params)
    if len == 6 and memcmp(name, c"Result", 6) == 0
        return 2
    if len == 6 and memcmp(name, c"Option", 6) == 0
        return 1
    let gei: i32 = enum_find(StrView { ptr: (name), len: (len) as i64 })
    if gei >= 0 and enum_is_generic(gei) == 1
        return count_type_params(generic_enum_params(gei))   # AGAST #2422
    0

# ----------------------------------------------------------------------------
# Generic user enums (AGAST #2422)
# ----------------------------------------------------------------------------
# `enum Slot<T>` records its variants with `T` unsubstituted, so `Slot<i32>`
# (mangled `Slot$i32`) had no layout: ritz1 named `%Slot$i32` in signatures and
# allocas and never declared it, and clang refused the IR.  Each instance a
# program names is recorded here as a concrete enum of that name, its payload
# fields cloned with every parameter substituted, exactly as a generic struct's
# are.  From there it is any user enum: ritz0's layout, constructors, match.

# generic_enum_params moved to ast_helpers (AGAST #3021): emitter_core's
# te_component_arity needs a generic enum's parameter count too.

# Record `name` (`Slot$i32`, its `$` at dollar_pos) as an instance of the
# generic enum its base names, once, and instantiate what its payloads name
# (`Full(Box<T>)` at i32 needs `Box$i32`).  Anything else is left alone.
pub fn add_enum_instance(m: *Module, name_sv: StrView, dollar_pos: i32)
    var name: *u8 = name_sv.ptr
    var len: i32 = name_sv.len as i32
    let base: i32 = enum_find(StrView { ptr: (name), len: (dollar_pos) as i64 })
    if base < 0 or enum_is_generic(base) != 1 or enum_find(StrView { ptr: (name), len: (len) as i64 }) >= 0
        return
    let tp: *TypeParam = generic_enum_params(base)
    let suffix: *u8 = name + dollar_pos
    let suffix_len: i32 = len - dollar_pos
    let n: i32 = count_type_params(tp)
    if n == 0
        return
    let cap: i64 = 4 * mangled_arg_capacity(StrView { ptr: (suffix), len: (suffix_len) as i64 }) as i64
    let starts: *i32 = malloc(cap) as *i32
    let lens: *i32 = malloc(cap) as *i32
    if n == 1
        # One parameter: the whole suffix is its argument (`Slot$Slot$i32`).
        *starts = 0
        *lens = suffix_len
    else if split_mangled_args(m, StrView { ptr: (suffix), len: (suffix_len) as i64 }, starts, lens) != n
        return
    let count: i32 = enum_variant_count(base)
    let fields: **StructField = malloc((count as i64 + 1) * 8) as **StructField
    for vi in 0..count
        *(fields + vi) = clone_struct_fields_multi(enum_variant_fields(base, vi), tp, suffix, starts, lens)
    enum_record_instance(base, StrView { ptr: (name), len: (len) as i64 }, fields)
    for vj in 0..count
        var f: *StructField = *(fields + vj)
        while f != null
            if f.field_type_name != null
                add_struct_from_mangled_name(m, StrView { ptr: (f.field_type_name), len: (f.field_type_name_len) as i64 })
            f = f.next

# AGAST #3309: an instance of a generic enum with a generic impl (`Slot$i32`
# for `impl<T> Slot<T>`) has that impl's methods specialised, as a generic
# struct's instance has: `Slot.mk(5)` into a `Slot<i32>` calls `Slot$i32_mk`.
# Queued as a struct instantiation, so specialize_pending_structs does it in
# the fixpoint, under the same generation cap (find_generic_struct misses an
# enum, so only the impl part runs).  `Slot$T`, the template's own spelling
# of its type, is no instance.
fn add_enum_impl_instance(m: *Module, name_sv: StrView, dollar_pos: i32)
    var name: *u8 = name_sv.ptr
    var len: i32 = name_sv.len as i32
    if enum_find(StrView { ptr: (name), len: (len) as i64 }) < 0 or find_generic_impl(m.impls, StrView { ptr: (name), len: (dollar_pos) as i64 }) == null
        return
    let suffix: *u8 = name + dollar_pos
    let suffix_len: i32 = len - dollar_pos
    if suffix_len == 2
        let ch: i32 = *(suffix + 1) as i32
        if ch >= 'A' and ch <= 'Z'
            if find_concrete_struct(m, StrView { ptr: (suffix + 1), len: (1) as i64 }) == null and names_concrete_enum(StrView { ptr: (suffix + 1), len: (1) as i64 }) == 0
                return
    add_struct_instantiation(StrView { ptr: (name), len: (dollar_pos) as i64 }, StrView { ptr: (suffix), len: (suffix_len) as i64 })

# End (exclusive) of the mangled type argument that starts at s[pos]: its
# first component plus, if that names a generic, one nested argument per
# parameter.  Stops early at the end of a truncated name.
pub fn mangled_arg_end(m: *Module, s_sv: StrView, pos: i32) -> i32
    var s: *u8 = s_sv.ptr
    var len: i32 = s_sv.len as i32
    var end: i32 = pos
    while end < len and *(s + end) != '$'   # '$'
        end = end + 1
    let arity: i32 = mangled_component_arity(m, StrView { ptr: (s + pos), len: (end - pos) as i64 })
    for k in 0..arity
        if end >= len
            return end
        end = mangled_arg_end(m, StrView { ptr: (s), len: (len) as i64 }, end + 1)
    end

# Split a suffix "$a1$a2..." into its top-level arguments.  Each
# (suffix + starts[i], lens[i]) is itself a one-argument suffix "$ai", the
# form parse_type_from_suffix / get_type_name_from_suffix take.  Returns the
# argument count, or -1 for a malformed suffix.  starts/lens must hold
# mangled_arg_capacity(suffix, suffix_len) entries.
pub fn split_mangled_args(m: *Module, suffix_sv: StrView, starts: *i32, lens: *i32) -> i32
    var suffix: *u8 = suffix_sv.ptr
    var suffix_len: i32 = suffix_sv.len as i32
    var n: i32 = 0
    var pos: i32 = 0
    while pos < suffix_len
        if *(suffix + pos) != '$'   # '$'
            return -1
        let end: i32 = mangled_arg_end(m, StrView { ptr: (suffix), len: (suffix_len) as i64 }, pos + 1)
        *(starts + n) = pos
        *(lens + n) = end - pos
        n = n + 1
        pos = end
    n

# Index of the type parameter named (name, len), or -1.
pub fn type_param_index(tp: *TypeParam, name_sv: StrView) -> i32
    var name: *u8 = name_sv.ptr
    var len: i32 = name_sv.len as i32
    var i: i32 = 0
    var cur: *TypeParam = tp
    while cur != null
        if cur.name_len == len and memcmp(cur.name, name, len as i64) == 0
            return i
        i = i + 1
        cur = cur.next
    -1

# AGAST #3748: the parameter a `$`-component ends in after its `_`-pieces
# (`ptr_A`, `ptr_ptr_A`, `arr2_A`), its index, with the length of the pieces
# before it in `out_head` (`ptr_` is 4).  -1 when the last piece is no
# parameter, or the component has no `_`: a whole-component parameter is
# substitute_params_in_mangled's own case.  Only the last piece takes an
# argument, as gi_match_pieces binds it (#3516).
fn piece_param_index(tp: *TypeParam, c_sv: StrView, out_head: *i32) -> i32
    var c: *u8 = c_sv.ptr
    var clen: i32 = c_sv.len as i32
    let k: i32 = last_piece_start(StrView { ptr: (c), len: (clen) as i64 })
    if k == 0
        return -1
    *out_head = k
    type_param_index(tp, StrView { ptr: (c + k), len: (clen - k) as i64 })

# Where a `$`-component's last `_`-piece starts: 4 in `ptr_A`, 0 with no `_`
# or when a piece before it is no type constructor the mangler writes (`ptr`,
# `ref`, `refmut`, `arr<N>`): `My_A` is a struct's name, not `My` over A.
fn last_piece_start(c_sv: StrView) -> i32
    var c: *u8 = c_sv.ptr
    var clen: i32 = c_sv.len as i32
    var k: i32 = clen
    while k > 0 and *(c + k - 1) != '_'   # '_'
        k = k - 1
    var p: i32 = 0
    while p < k
        var e: i32 = p
        while *(c + e) != '_'
            e = e + 1
        if is_type_ctor_piece(c + p, e - p) == 0
            return 0
        p = e + 1
    k

# 1 for a mangled type-constructor piece: `ptr`, `ref`, `refmut`, `arr<N>`.
fn is_type_ctor_piece(c: *u8, n: i32) -> i32
    if n == 3 and (memcmp(c, c"ptr", 3) == 0 or memcmp(c, c"ref", 3) == 0)
        return 1
    if n == 6 and memcmp(c, c"refmut", 6) == 0
        return 1
    if n < 4 or memcmp(c, c"arr", 3) != 0
        return 0
    for i in 3..n
        if *(c + i) < '0' or *(c + i) > '9'   # not '0'..'9'
            return 0
    1

# piece_param_index for the one parameter (type_param, type_param_len): the
# length of the pieces before it, `ptr_` (4) in `ptr_A`, or 0 for no match.
fn piece_param_head(c_sv: StrView, type_param_sv: StrView) -> i32
    var c: *u8 = c_sv.ptr
    var clen: i32 = c_sv.len as i32
    var type_param: *u8 = type_param_sv.ptr
    var type_param_len: i32 = type_param_sv.len as i32
    let k: i32 = last_piece_start(StrView { ptr: (c), len: (clen) as i64 })
    if k == 0 or clen - k != type_param_len or memcmp(c + k, type_param, type_param_len as i64) != 0
        return 0
    k

# Rewrite a mangled name, replacing every `$`-component that is a type
# parameter with its argument: `Box$B` at <A=i64, B=i32> is `Box$i32`.
# Returns `name` itself when no component is a parameter.
pub fn substitute_params_in_mangled(tp: *TypeParam, suffix: *u8, starts: *i32, lens: *i32, name0_sv: StrView, out_len: *i32) -> *u8
    var name0: *u8 = name0_sv.ptr
    var len0: i32 = name0_sv.len as i32
    # AGAST #2975: a tuple component over any of the parameters
    # (`Vec$tuple_K_V`) is its instantiation, one parameter at a time.
    var name: *u8 = name0
    var len: i32 = len0
    var ti: i32 = 0
    var tcur: *TypeParam = tp
    while tcur != null
        var nl: i32 = len
        name = subst_components(StrView { ptr: (name), len: (len) as i64 }, StrView { ptr: (tcur.name), len: (tcur.name_len) as i64 }, StrView { ptr: (suffix + *(starts + ti)), len: (*(lens + ti)) as i64 }, 0, @nl)
        len = nl
        tcur = tcur.next
        ti = ti + 1
    # Pass 1: the rewritten length (0 extra when nothing matches).
    var total: i32 = 0
    var hit: i32 = 0
    var pos: i32 = 0
    while pos <= len
        var end: i32 = pos
        while end < len and *(name + end) != '$'
            end = end + 1
        let idx: i32 = type_param_index(tp, StrView { ptr: (name + pos), len: (end - pos) as i64 })
        var head: i32 = 0
        let pidx: i32 = piece_param_index(tp, StrView { ptr: (name + pos), len: (end - pos) as i64 }, @head)
        if idx >= 0
            hit = 1
            total = total + *(lens + idx) - 1
        else if pidx >= 0
            hit = 1
            total = total + head + *(lens + pidx) - 1
        else
            total = total + end - pos
        if end < len
            total = total + 1
        pos = end + 1
    if hit == 0
        *out_len = len
        return name
    # Pass 2: build it.
    let out: *u8 = malloc(total as i64 + 1) as *u8
    var o: i32 = 0
    pos = 0
    while pos <= len
        var end: i32 = pos
        while end < len and *(name + end) != '$'
            end = end + 1
        let idx: i32 = type_param_index(tp, StrView { ptr: (name + pos), len: (end - pos) as i64 })
        var head: i32 = 0
        let pidx: i32 = piece_param_index(tp, StrView { ptr: (name + pos), len: (end - pos) as i64 }, @head)
        if idx >= 0
            let a: *u8 = suffix + *(starts + idx) + 1
            let a_len: i32 = *(lens + idx) - 1
            for j in 0..a_len
                *(out + o) = *(a + j)
                o = o + 1
        else if pidx >= 0
            # AGAST #3748: `ptr_A` at A = u8 is `ptr_u8`.
            for j in pos..(pos + head)
                *(out + o) = *(name + j)
                o = o + 1
            let pa: *u8 = suffix + *(starts + pidx) + 1
            let pa_len: i32 = *(lens + pidx) - 1
            for j in 0..pa_len
                *(out + o) = *(pa + j)
                o = o + 1
        else
            for j in pos..end
                *(out + o) = *(name + j)
                o = o + 1
        if end < len
            *(out + o) = 36
            o = o + 1
        pos = end + 1
    *(out + o) = 0
    *out_len = o
    out

# 1 if (name, len) is a non-generic enum the module declares (AGAST #2411).
fn names_concrete_enum(name_sv: StrView) -> i32
    var name: *u8 = name_sv.ptr
    var len: i32 = name_sv.len as i32
    let ei: i32 = enum_find(StrView { ptr: (name), len: (len) as i64 })
    if ei < 0 or enum_is_generic(ei) == 1
        return 0
    1

# Find a non-generic struct by name.
pub fn find_concrete_struct(m: *Module, name_sv: StrView) -> *StructDef
    var name: *u8 = name_sv.ptr
    var name_len: i32 = name_sv.len as i32
    var st: *StructDef = m.structs
    while st != null
        if st.type_params == null
            if st.name_len == name_len
                if memcmp(st.name, name, name_len as i64) == 0
                    return st
        st = st.next
    return null

# Register the generic-struct instantiations named by a fn's signature.
# Every type kind counts, not just by-value TYPE_STRUCT: `v: @&Vec<T>`
# specialised at u8 is a TYPE_REF named `Vec$u8`, and the body's `v.len`
# needs `struct Vec$u8` to exist.  ritz1 used to paper over this with a
# hard-coded Vec$u8/i32/... layout table (AGAST #1440); without it, the
# layout must come from instantiating `struct Vec<T>`.
# AGAST #3979: and those of a fn type among them, `look: fn(u16) -> Slot<P>`,
# whose signature is a FnDef of its own (null for any other type).
fn collect_struct_types_from_signature(m: *Module, f: *FnDef)
    if f == null
        return
    if f.return_type_name != null
        add_struct_from_mangled_name(m, StrView { ptr: (f.return_type_name), len: (f.return_type_name_len) as i64 })
    collect_struct_types_from_signature(m, f.ret_fn_sig)
    var p: *Param = f.params
    while p != null
        if p.param_type_name != null
            add_struct_from_mangled_name(m, StrView { ptr: (p.param_type_name), len: (p.param_type_name_len) as i64 })
        collect_struct_types_from_signature(m, p.fn_sig)
        p = p.next

# Same, for a specialised fn: its signature and every var-decl type in its
# body.  Only struct instantiations are gathered here — fn instantiations in
# a specialised body are registered by clone_body as it substitutes them.
fn collect_struct_types_from_fn(m: *Module, f: *FnDef)
    collect_struct_types_from_signature(m, f)
    collect_struct_types_from_stmts(m, f.body)

# AGAST #2411: a specialised struct's by-value fields, `B$usize.v: Vec$usize`:
# the field's layout must exist even when no fn names it.
fn collect_struct_types_from_fields(m: *Module, f: *StructField)
    var cur: *StructField = f
    while cur != null
        if cur.field_type == TYPE_STRUCT and cur.field_type_name != null
            add_struct_from_mangled_name(m, StrView { ptr: (cur.field_type_name), len: (cur.field_type_name_len) as i64 })
        # AGAST #3099: and a pointee's, `W$u16.b: *Box$u16`: `w.b.v` reads
        # Box$u16's layout though no fn names it.
        if (cur.field_type == TYPE_PTR or cur.field_type == TYPE_REF or cur.field_type == TYPE_MUT_REF) and cur.field_type_name != null
            add_struct_from_mangled_name(m, StrView { ptr: (cur.field_type_name), len: (cur.field_type_name_len) as i64 })
        # AGAST #2390: and its array elements', `W$i32.a: [2]Box$i32`, or
        # (#3099) `[2]*Box$i32`.
        if cur.field_type == TYPE_ARRAY and array_elem_names_struct(cur) == 1
            add_struct_from_mangled_name(m, StrView { ptr: (cur.array_elem_type_name), len: (cur.array_elem_type_name_len) as i64 })
        add_struct_from_array_shape(m, cur.array_shape)   # AGAST #3119: `[2][3]Box$i32`
        cur = cur.next

fn collect_struct_types_from_stmts(m: *Module, body: *Stmt)
    var s: *Stmt = body
    while s != null
        let k: i32 = s.kind
        if k == STMT_VAR_DECL
            if s.var_type_name != null
                add_struct_from_mangled_name(m, StrView { ptr: (s.var_type_name), len: (s.var_type_name_len) as i64 })
        else if k == STMT_IF
            collect_struct_types_from_stmts(m, s.if_then)
            collect_struct_types_from_stmts(m, s.if_else)
        else if k == STMT_WHILE or k == STMT_LOOP or k == STMT_DEFER or k == STMT_UNSAFE
            collect_struct_types_from_stmts(m, s.while_body)
        else if k == STMT_FOR
            collect_struct_types_from_stmts(m, s.for_body)
        else if k == STMT_ASM
            pass   # STMT_ASM holds no statement, expression or type (AGAST #3394).
        s = s.next

fn collect_instantiations_from_module(m: *Module)
    # Walk all non-generic functions to find instantiations
    var f: *FnDef = m.functions
    while f != null
        if f.type_params == null
            collect_struct_types_from_signature(m, f)
            # Reset local-var tracker per fn body, then seed from fn params so
            # `fn foo(v: Vec<T>)` lets `v.push(...)` resolve UFCS-style.
            reset_local_var_tracker()
            var pp: *Param = f.params
            while pp != null
                track_typed_local_through(StrView { ptr: (pp.name), len: (pp.name_len) as i64 }, pp.param_type, pp.param_pointee_type, StrView { ptr: (pp.param_type_name), len: (pp.param_type_name_len) as i64 })
                pp = pp.next
            # Walk function body
            set_mono_fn_context(f)
            collect_from_fn_body(m, f.body)
            set_mono_fn_context(null)
        f = f.next

    # Walk impl block methods.  Skip generic impl blocks (those with
    # type_params != null) — their methods are templates whose bodies
    # reference the type parameter directly (e.g. `span_len<T>(self)` in
    # `impl<T> Span<T>`).  Walking them would register bogus
    # ("span_len", "$T") instantiations that get specialised into
    # broken `span_len$T` functions with unsubstituted T references.
    # Methods on generic impls get specialised via specialize_impl_methods
    # once the parent struct is instantiated for a concrete type.
    var ib: *ImplBlock = m.impls
    while ib != null
        if ib.type_params == null
            var method: *FnDef = ib.methods
            while method != null
                # AGAST #2305: a method's own `s: Span<i32>` instantiates
                # Span$i32 as a free fn's does; left opaque, `s.len` was
                # "unhandled EXPR_MEMBER".
                collect_struct_types_from_signature(m, method)
                reset_local_var_tracker()
                var ipp: *Param = method.params
                while ipp != null
                    if ipp.is_self_borrow == 1 and ipp.param_type_name_len == 0
                        # AGAST #2562: a bare `self:&` names no type (the
                        # emitter takes it from the ImplBlock), so seed it as
                        # the `@&T` it is, or `self.v.push(s)` never
                        # registers `vec_push$S`.
                        track_typed_local_through(StrView { ptr: (ipp.name), len: (ipp.name_len) as i64 }, TYPE_MUT_REF, TYPE_STRUCT, StrView { ptr: (ib.type_name), len: (ib.type_name_len) as i64 })
                    else
                        track_typed_local_through(StrView { ptr: (ipp.name), len: (ipp.name_len) as i64 }, ipp.param_type, ipp.param_pointee_type, StrView { ptr: (ipp.param_type_name), len: (ipp.param_type_name_len) as i64 })
                    ipp = ipp.next
                set_mono_fn_context(method)
                collect_from_fn_body(m, method.body)
                set_mono_fn_context(null)
                method = method.next
        ib = ib.next

    # Walk global variable types — `var g: Vec<String>` at module scope
    # needs Vec$String instantiated just like a let-binding does.  Without
    # this, idiomatic main.ritz's `var g_processed: Vec<String>` left
    # Vec$String un-instantiated and the self-hosted bootstrap died with
    # "ERROR: unhandled EXPR_MEMBER" inside vec_len$String.
    var g: *GlobalVarDef = m.globals
    while g != null
        if g.type_name != null
            add_struct_from_mangled_name(m, StrView { ptr: (g.type_name), len: (g.type_name_len) as i64 })
        # AGAST #3025: and the element of `var ga: [N]P<i64>`, as a field's
        # is below.  Missed, P$i64 was never instantiated when no fn named
        # it, and `ga[i].v` fell to "unhandled EXPR_MEMBER".
        if g.array_elem_type_name != null
            add_struct_from_mangled_name(m, StrView { ptr: (g.array_elem_type_name), len: (g.array_elem_type_name_len) as i64 })
        add_struct_from_array_shape(m, g.array_shape)   # AGAST #3110: `[N][M]P<i64>`
        g = g.next

    # Walk concrete struct field types — `struct ParsedArgs` with a
    # `Vec<ArgSlot>` field needs Vec$ArgSlot for its own `%ParsedArgs` type
    # decl, which every importer emits.  This used to be found only by
    # walking the bodies that USE the struct; since G9b (AGAST #1899) an
    # import's bodies are stripped, and field types are its interface.
    var st: *StructDef = m.structs
    while st != null
        if st.type_params == null
            var fld: *StructField = st.fields
            while fld != null
                if fld.field_type_name != null
                    add_struct_from_mangled_name(m, StrView { ptr: (fld.field_type_name), len: (fld.field_type_name_len) as i64 })
                if fld.array_elem_type_name != null
                    add_struct_from_mangled_name(m, StrView { ptr: (fld.array_elem_type_name), len: (fld.array_elem_type_name_len) as i64 })
                # AGAST #3119: `a: [2][3]P<i64>` keeps P$i64 only in its shape.
                add_struct_from_array_shape(m, fld.array_shape)
                collect_struct_types_from_signature(m, fld.fn_sig)        # AGAST #3979
                collect_struct_types_from_signature(m, fld.elem_fn_sig)
                fld = fld.next
        st = st.next

fn collect_from_fn_body(m: *Module, body: *Stmt)
    var s: *Stmt = body
    while s != null
        collect_from_stmt(m, s)
        s = s.next

fn collect_from_stmt(m: *Module, s: *Stmt)
    rewrite_struct_index_stmt(m, s)   # AGAST #1635
    note_compound_calls(s)            # AGAST #2529, after the rewrite above
    let k: i32 = s.kind
    if k == STMT_EXPR
        if s == g_mono_tail
            slice_into_expected(m, s.expr, StrView { ptr: (g_mono_ret_name), len: (g_mono_ret_len) as i64 })   # AGAST #2877
        collect_from_expr(m, s.expr)
    else if k == STMT_VAR_DECL
        # Before tracking: `let t = v[1..3]` is `let t = v.slice(1, 3)`, so `t`
        # is tracked as that call's result (AGAST #2451).
        if s.var_init != null
            if slice_into_span_annotation(m, s) == 1
                g_slice_kept = s.var_init
            rewrite_value_slice(m, s.var_init)
        # Check if variable type is a generic struct — by value or behind a
        # pointer/reference (`var v: *Vec<u8>` needs Vec$u8 just the same).
        if s.var_type_name != null
            add_struct_from_mangled_name(m, StrView { ptr: (s.var_type_name), len: (s.var_type_name_len) as i64 })
        collect_struct_types_from_signature(m, s.var_fn_sig)   # AGAST #3979: `let f: fn() -> Slot<P>`
        add_struct_from_array_shape(m, s.var_array_shape)   # AGAST #3110
        # Record local-var → Vec/Span suffix mapping for UFCS-driven generic
        # instantiation.  Two paths:
        #   1. Explicit annotation: `var v: Vec<u16>` — var_type_name="Vec$u16"
        #   2. Inferred from EXPR_CALL initializer: `var v = vec_new<u16>()`
        #      — look up the called fn's return type (which for a generic
        #      template is "Vec$T"; substitute T with the call's type suffix).
        var lv_kind: i32 = 0
        var lv_suf: *u8 = null
        var lv_suf_len: i32 = 0
        if s.var_type == TYPE_STRUCT and s.var_type_name != null
            lv_kind = classify_collection_type(StrView { ptr: (s.var_type_name), len: (s.var_type_name_len) as i64 }, @lv_suf, @lv_suf_len)
        if lv_kind == 0 and s.var_init != null
            if s.var_init.kind == EXPR_CALL
                if s.var_init.call_type_suffix_len > 0
                    let init_fn: *FnDef = find_fn_in_module(m, StrView { ptr: (s.var_init.func_name), len: (s.var_init.func_name_len) as i64 })
                    if init_fn != null
                        if init_fn.return_type == TYPE_STRUCT and init_fn.return_type_name != null
                            # Template return type names look like "Vec$T".
                            # The classifier wants the concrete suffix though,
                            # so for generic templates we use the call's own
                            # type suffix instead of the template's "$T".
                            var rt_suf: *u8 = null
                            var rt_suf_len: i32 = 0
                            let rt_kind: i32 = classify_collection_type(StrView { ptr: (init_fn.return_type_name), len: (init_fn.return_type_name_len) as i64 }, @rt_suf, @rt_suf_len)
                            if rt_kind > 0
                                lv_kind = rt_kind
                                lv_suf = s.var_init.call_type_suffix
                                lv_suf_len = s.var_init.call_type_suffix_len
        if lv_kind > 0 and lv_suf != null and lv_suf_len > 0
            add_local_var(StrView { ptr: (s.var_name), len: (s.var_name_len) as i64 }, lv_kind, StrView { ptr: (lv_suf), len: (lv_suf_len) as i64 })
            mark_last_local_by_value()
        else if s.var_type == TYPE_ARRAY and s.var_type_name != null and s.var_type_name_len > 0
            # `[N]S`: an element receiver `a[i].m()` is an S (AGAST #4231).
            track_array_local(StrView { ptr: (s.var_name), len: (s.var_name_len) as i64 }, StrView { ptr: (s.var_type_name), len: (s.var_type_name_len) as i64 })
        else if s.var_type_name != null and s.var_type_name_len > 0
            # Plain struct (or pointer/ref to one): root of a field receiver.
            track_typed_local_through(StrView { ptr: (s.var_name), len: (s.var_name_len) as i64 }, s.var_type, s.var_pointee_type, StrView { ptr: (s.var_type_name), len: (s.var_type_name_len) as i64 })
        else if s.var_init != null and s.var_init.kind == EXPR_UNARY and (s.var_init.op == OP_ADDR or s.var_init.op == OP_ADDR_MUT)
            track_address_of_local(StrView { ptr: (s.var_name), len: (s.var_name_len) as i64 }, s.var_init.operand)
        else if s.var_init != null and s.var_init.kind == EXPR_STRUCT_LIT
            # Un-annotated `var r = R { ... }`: the literal names the type.
            add_local_struct_var(StrView { ptr: (s.var_name), len: (s.var_name_len) as i64 }, StrView { ptr: (s.var_init.ident_ptr), len: (s.var_init.ident_len) as i64 })
        else if s.var_init != null and s.var_init.kind == EXPR_INDEX
            # Un-annotated `let w = p[1]` of a Vec<Vec<T>>: `w` is the element,
            # a Vec<T>, so `w.get(1)` registers vec_get$T (AGAST #2519).
            var esuf: *u8 = null
            var esuf_len: i32 = 0
            let ekind: i32 = indexed_element_collection(m, s.var_init, @esuf, @esuf_len)
            if ekind > 0
                add_local_var(StrView { ptr: (s.var_name), len: (s.var_name_len) as i64 }, ekind, StrView { ptr: (esuf), len: (esuf_len) as i64 })
                mark_last_local_by_value()
        else if s.var_init != null and s.var_init.kind == EXPR_METHOD
            track_method_init_local(m, StrView { ptr: (s.var_name), len: (s.var_name_len) as i64 }, s.var_init)
        else if s.var_init != null and s.var_init.kind == EXPR_CALL and s.var_init.call_type_suffix_len == 0
            # `var w = ms()`: a plain fn's return type, as an annotation of it.
            var call_fn: *FnDef = find_fn_in_module(m, StrView { ptr: (s.var_init.func_name), len: (s.var_init.func_name_len) as i64 })
            # AGAST #3495: or an impl method by its symbol (`String_from(x)`).
            if call_fn == null
                call_fn = find_impl_method_by_symbol(m, StrView { ptr: (s.var_init.func_name), len: (s.var_init.func_name_len) as i64 })
            if call_fn != null and call_fn.type_params == null
                track_typed_local(StrView { ptr: (s.var_name), len: (s.var_name_len) as i64 }, call_fn.return_type, StrView { ptr: (call_fn.return_type_name), len: (call_fn.return_type_name_len) as i64 })
        if s.var_init != null
            collect_from_expr(m, s.var_init)
    else if k == STMT_ASSIGN
        collect_from_expr(m, s.assign_value)
    else if k == STMT_MEMBER_ASSIGN
        # ptr.field = value - walk the value expression
        collect_from_expr(m, s.assign_value)
    else if k == STMT_MEMBER_INDEX_ASSIGN
        # ptr.field[index] = value - walk the index (in while_cond) and value
        collect_from_expr(m, s.while_cond)  # index stored in while_cond
        collect_from_expr(m, s.assign_value)
    else if k == STMT_INDEX_ASSIGN
        # name[index] = value - walk the index (in while_cond) and value
        collect_from_expr(m, s.while_cond)  # index stored in while_cond
        collect_from_expr(m, s.assign_value)
    else if k == STMT_LOCAL_FIELD_ASSIGN
        # local_var.field = value - walk the value expression
        collect_from_expr(m, s.assign_value)
    else if k == STMT_LOCAL_FIELD_INDEX_ASSIGN
        # local_var.field[index] = value - walk the index (in while_cond) and value
        collect_from_expr(m, s.while_cond)  # index stored in while_cond
        collect_from_expr(m, s.assign_value)
    else if k == STMT_IF
        collect_from_expr(m, s.if_cond)
        collect_from_fn_body(m, s.if_then)
        if s.if_else != null
            collect_from_fn_body(m, s.if_else)
    else if k == STMT_WHILE
        collect_from_expr(m, s.while_cond)
        collect_from_fn_body(m, s.while_body)
    else if k == STMT_FOR
        collect_from_expr(m, s.for_start)
        collect_from_expr(m, s.for_end)
        collect_from_fn_body(m, s.for_body)
    else if k == STMT_LOOP or k == STMT_DEFER or k == STMT_UNSAFE
        # Infinite loop stores its body in while_body (same slot as STMT_WHILE);
        # so does `defer` (AGAST #1625).  Without this case, generic calls inside `loop { ... }` are never
        # registered for monomorphization (e.g. vec_push_bytes<u8> inside
        # vec_read_all_fd), leaving the linker with unresolved references.
        collect_from_fn_body(m, s.while_body)
    else if k == STMT_ASM
        pass   # STMT_ASM holds no statement, expression or type (AGAST #3394).
    else if k == STMT_RETURN
        if s.return_value != null
            slice_into_expected(m, s.return_value, StrView { ptr: (g_mono_ret_name), len: (g_mono_ret_len) as i64 })   # AGAST #2877
            collect_from_expr(m, s.return_value)
    else if k == STMT_ASSERT
        # `assert <cond>` — cond stored in if_cond (slot reuse).  Generic
        # calls in the condition need to register for monomorphization.
        if s.if_cond != null
            collect_from_expr(m, s.if_cond)
    else if k == STMT_TUPLE_DECL
        # `let (a, b) = expr` — initializer in var_init.
        if s.var_init != null
            collect_from_expr(m, s.var_init)
    else if k == STMT_MATCH
        # `match scrutinee \n arm => body \n …` — scrutinee in if_cond,
        # arms list in if_then (recast as *Stmt by the parser; see
        # stmt_match in ast_helpers.ritz).  Walk the arm bodies as
        # *Expr — they're real expressions, not Stmts.
        if s.if_cond != null
            collect_from_expr(m, s.if_cond)
        collect_from_arms(m, s.if_cond, s.if_then as *MatchArm)

# Walk a match's (or an if's) arms.  Each arm is a scope (AGAST #2573): its
# payload binding (`Some(x)`, `Ok(x)`, `Hit(x)`) is recorded at the payload's
# type for that arm only, and the arm's own lets go with it, so a second arm
# binding `x` at another type finds its own.  (No outer local can share the
# name: #2395 refuses that.)  `scrut` is null for an if.
fn collect_from_arms(m: *Module, scrut: *Expr, arms: *MatchArm)
    var tn_len: i32 = 0
    let tn: *u8 = scrutinee_type_name(m, scrut, @tn_len)
    var arm: *MatchArm = arms
    while arm != null
        let saved_count: i32 = g_lv_count
        # AGAST #1295: each binding of `V(a, b, ..)`, at its field's type.
        let nb: i32 = arm_bind_count(arm)
        for k in 0..nb
            arm_select_bind(arm, k)
            bind_arm_payload(m, arm, StrView { ptr: (tn), len: (tn_len) as i64 })
        arm_select_bind(arm, 0)
        collect_from_fn_body(m, arm.body_stmts)   # block arm (AGAST #1454)
        if arm.body != null
            collect_from_expr(m, arm.body)
        g_lv_count = saved_count
        arm = arm.next

# AGAST #2573: the mangled type of a match scrutinee, as far as this walk
# knows it: a tracked local's (`let o = wrap(v)`, a param), or a plain fn
# call's return type (`match wrap(v)`).  null for anything else.
fn scrutinee_type_name(m: *Module, e: *Expr, out_len: *i32) -> *u8
    *out_len = 0
    if e == null
        return null
    if e.kind == EXPR_IDENT
        let idx: i32 = find_local_var_idx(StrView { ptr: (e.ident_ptr), len: (e.ident_len) as i64 })
        if idx < 0 or *(g_lv_by_value + idx) != 1 or *(g_lv_prefix_kind + idx) != 0
            return null
        *out_len = *(g_lv_type_name_lens + idx)
        return *(g_lv_type_names + idx)
    if e.kind == EXPR_CALL and e.call_type_suffix_len == 0
        let f: *FnDef = find_fn_in_module(m, StrView { ptr: (e.func_name), len: (e.func_name_len) as i64 })
        if f == null or f.type_params != null or f.return_type != TYPE_STRUCT or f.return_type_name == null
            return null
        *out_len = f.return_type_name_len
        return f.return_type_name
    return null

# Record `Ctor(x)`'s `x` at its payload's type, so `x[lo..hi]` is a slice of
# a Vec, Span or String (rewrite_value_slice) and `x.push(..)` instantiates.
fn bind_arm_payload(m: *Module, arm: *MatchArm, tn_sv: StrView)
    var tn: *u8 = tn_sv.ptr
    var tn_len: i32 = tn_sv.len as i32
    if arm.pattern_kind != PAT_VARIANT or arm.pattern_inner_kind != PAT_IDENT
        return
    let name: *u8 = arm.pattern_inner_name
    let name_len: i32 = arm.pattern_inner_name_len
    if name_len <= 0 or (name_len == 1 and *name == '_')   # `_`
        return
    var pay_len: i32 = 0
    var k: i32 = arm.pattern_field_sel
    if arm.pattern_binds == null
        k = 0 - 1
    let pay: *u8 = variant_field_payload_type(m, StrView { ptr: (tn), len: (tn_len) as i64 }, StrView { ptr: (arm.pattern_name), len: (arm.pattern_name_len) as i64 }, k, @pay_len)
    if pay != null and pay_len > 0
        track_typed_local(StrView { ptr: (name), len: (name_len) as i64 }, TYPE_STRUCT, StrView { ptr: (pay), len: (pay_len) as i64 })

# The mangled type variant `ctor` of `tn` carries, or null: Option's Some the
# whole suffix, Result's Ok its T and Err its E, a non-generic user enum's
# single-field tuple variant that field's struct type.
fn variant_payload_type(m: *Module, tn_sv: StrView, ctor_sv: StrView, out_len: *i32) -> *u8
    var tn: *u8 = tn_sv.ptr
    var tn_len: i32 = tn_sv.len as i32
    var ctor: *u8 = ctor_sv.ptr
    var ctor_len: i32 = ctor_sv.len as i32
    return variant_field_payload_type(m, StrView { ptr: (tn), len: (tn_len) as i64 }, StrView { ptr: (ctor), len: (ctor_len) as i64 }, 0 - 1, out_len)

# AGAST #1295: as variant_payload_type, for field `k` of a multi-field user
# enum variant (`h` of `Rect(w, h)` is field 1).  k = -1 asks for the sole
# field of a single-field variant (none for a multi-field one); Result /
# Option have only that one.
fn variant_field_payload_type(m: *Module, tn_sv: StrView, ctor_sv: StrView, k: i32, out_len: *i32) -> *u8
    var tn: *u8 = tn_sv.ptr
    var tn_len: i32 = tn_sv.len as i32
    var ctor: *u8 = ctor_sv.ptr
    var ctor_len: i32 = ctor_sv.len as i32
    *out_len = 0
    if k > 0 and enum_find(StrView { ptr: (tn), len: (tn_len) as i64 }) < 0
        return null
    let sole: i32 = (k < 0) as i32
    var want: i32 = k
    if want < 0
        want = 0
    if tn == null or tn_len <= 0
        return null
    if tn_len > 7 and memcmp(tn, c"Option$", 7) == 0
        if name_eq(StrView { ptr: (ctor), len: (ctor_len) as i64 }, StrView { ptr: (c"Some"), len: (4) as i64 }) == 0
            return null
        *out_len = tn_len - 7
        return tn + 7
    if tn_len > 7 and memcmp(tn, c"Result$", 7) == 0
        let sfx: *u8 = tn + 7
        let sfx_len: i32 = tn_len - 7
        let t_len: i32 = mangled_type_extent(m, StrView { ptr: (sfx), len: (sfx_len) as i64 })
        if name_eq(StrView { ptr: (ctor), len: (ctor_len) as i64 }, StrView { ptr: (c"Ok"), len: (2) as i64 }) == 1
            *out_len = t_len
            return sfx
        if name_eq(StrView { ptr: (ctor), len: (ctor_len) as i64 }, StrView { ptr: (c"Err"), len: (3) as i64 }) == 1 and t_len + 1 < sfx_len
            *out_len = sfx_len - t_len - 1
            return sfx + t_len + 1
        return null
    let ei: i32 = enum_find(StrView { ptr: (tn), len: (tn_len) as i64 })
    if ei < 0 or enum_is_generic(ei) == 1
        return null
    let vi: i32 = enum_variant_index(StrView { ptr: (tn), len: (tn_len) as i64 }, StrView { ptr: (ctor), len: (ctor_len) as i64 })
    if vi < 0 or enum_variant_kind(ei, vi) != ENUM_VARIANT_TUPLE
        return null
    var f: *StructField = enum_variant_fields(ei, vi)
    if sole == 1 and f != null and f.next != null
        return null   # `V(x)` over a multi-field variant: the arity error's
    var i: i32 = 0
    while f != null and i < want
        f = f.next
        i += 1
    if f == null or f.field_type != TYPE_STRUCT or f.field_type_name == null
        return null
    *out_len = f.field_type_name_len
    return f.field_type_name

# Byte length of the first whole type in the `$`-joined mangled list `p`
# (AGAST #1574): `Vec$i32$i32` -> `Vec$i32`, `Result$Vec$u8$i32$i64` ->
# `Result$Vec$u8$i32`.  A component takes as many types after it as it has
# type parameters; one it doesn't know as generic takes none.
fn mangled_type_extent(m: *Module, p_sv: StrView) -> i32
    var p: *u8 = p_sv.ptr
    var len: i32 = p_sv.len as i32
    var end: i32 = 0
    while end < len and *(p + end) != '$'   # '$'
        end = end + 1
    var pos: i32 = end
    let arity: i32 = mangled_generic_arity(m, StrView { ptr: (p), len: (end) as i64 })
    for a in 0..arity
        if pos >= len
            return pos
        pos = pos + 1 + mangled_type_extent(m, StrView { ptr: (p + pos + 1), len: (len - pos - 1) as i64 })
    return pos

# How many type arguments the mangled name component `p` takes: a generic
# struct's own count, and the three that may have no template here: Span
# (`[u8]` needs no ritzlib.span), Option and Result.
fn mangled_generic_arity(m: *Module, p_sv: StrView) -> i32
    var p: *u8 = p_sv.ptr
    var len: i32 = p_sv.len as i32
    if name_eq(StrView { ptr: (p), len: (len) as i64 }, StrView { ptr: (c"Span"), len: (4) as i64 }) == 1 or name_eq(StrView { ptr: (p), len: (len) as i64 }, StrView { ptr: (c"Option"), len: (6) as i64 }) == 1
        return 1
    if name_eq(StrView { ptr: (p), len: (len) as i64 }, StrView { ptr: (c"Result"), len: (6) as i64 }) == 1
        return 2
    let st: *StructDef = find_generic_struct(m, StrView { ptr: (p), len: (len) as i64 })
    if st != null
        return count_type_params(st.type_params)
    return 0

# ----------------------------------------------------------------------------
# Lowering in place (AGAST #4411, part of #1816's AST-write-back audit)
#
# This pass owns the Exprs it lowers.  A module's bodies are parsed fresh for
# this compile and collect_instantiations_from_module walks each body; a
# generic body is cloned per instantiation (clone_expr) and only the clone is
# rewritten.  Neither tree is shared with another module or another instance,
# and the emitter receives the lowered tree afterwards.  So the six helpers
# that turn one construct into another -- rewrite_enum_from_call,
# si_into_deref, rewrite_struct_index, rewrite_value_slice,
# span_view_in_place and slice_into_span_slot -- rewrite the node they are
# given rather than build a replacement.  That is correct here, and unlike the
# emitter's write-back #4408 removed it has no second owner to surprise.
#
# A helper must still refuse a node that is not the construct it names, which
# is how "not owned" shows up in practice: rewrite_enum_from_call returns for
# a local or param that shadows the enum's name, since then `E.from` is that
# binding's method call; the rest only fire on a tracked local or field of
# this module.  test_ritz1_monomorph_owns_nodes.py pins that boundary.
# ----------------------------------------------------------------------------

# Rewrite `E.from(args)` in place into the plain call `E__from(args)` of the
# generated fn (main.ritz, add_enum_from_fns), as ritz0's enum_from.py does,
# so type inference and emission see an ordinary call.  Done here because
# this walk visits every body before emission.  Left alone when no such fn
# exists: emit_expr_method then reports the located error.
fn rewrite_enum_from_call(m: *Module, e: *Expr)
    if is_enum_from_call(e) == 0
        return
    if find_local_var_idx(StrView { ptr: (e.left.ident_ptr), len: (e.left.ident_len) as i64 }) >= 0
        return
    var len: i32 = 0
    let name: *u8 = enum_from_fn_name(StrView { ptr: (e.left.ident_ptr), len: (e.left.ident_len) as i64 }, @len)
    if find_fn_in_module(m, StrView { ptr: (name), len: (len) as i64 }) == null
        return
    e.kind = EXPR_CALL
    e.func_name = name
    e.func_name_len = len
    e.call_type_suffix = null
    e.call_type_suffix_len = 0
    e.left = null

# ----------------------------------------------------------------------------
# Indexing a struct (LANGUAGE_SPEC §7.8, LARB R15, AGAST #1635): `m[k]` on a
# struct with `impl Index` / `IndexMut` / `IndexSet` becomes the method call it
# means, in place.  struct_index.ritz says which, and holds the refusals.
# ----------------------------------------------------------------------------

# How `[]` reaches the struct a base expression is (AGAST #2847).
const SI_BY_VALUE: i32 = 0    # the struct, a place: the receiver is the base
const SI_THROUGH: i32 = 1     # a `*M`, `@M` or `@&M`: the receiver is that pointer
const SI_TEMPORARY: i32 = 2   # a by-value call's result: `@` of it lends a temporary

# The global `name`.  No param or local shadows one: binder_check refuses
# that before monomorph runs (AGAST #2407).
fn si_global(m: *Module, name_sv: StrView) -> *GlobalVarDef
    var name: *u8 = name_sv.ptr
    var len: i32 = name_sv.len as i32
    var g: *GlobalVarDef = m.globals
    while g != null
        if name_eq(StrView { ptr: (g.name), len: (g.name_len) as i64 }, StrView { ptr: (name), len: (len) as i64 }) == 1
            return g
        g = g.next
    null

# The struct type `e` is, or points at one level, with `*out_how` saying which
# (SI_*), and `*out_recv` the receiver its method call takes; null when this
# pass can't tell.  `e` is a tracked local (by value, or one `@` / `@&` / `*`
# level), a global, a field of a tracked local, an element of
# a Vec or Span local, a call to a plain fn, or `*p` of any of those that
# points at a struct (AGAST #2847: ritz0 types any base).
fn si_expr_struct(m: *Module, e: *Expr, out_len: *i32, out_how: *i32, out_recv: **Expr) -> *u8
    *out_len = 0
    *out_how = SI_BY_VALUE
    *out_recv = e
    if e == null
        return null
    if e.kind == EXPR_IDENT
        let idx: i32 = find_local_var_idx(StrView { ptr: (e.ident_ptr), len: (e.ident_len) as i64 })
        if idx < 0
            let g: *GlobalVarDef = si_global(m, StrView { ptr: (e.ident_ptr), len: (e.ident_len) as i64 })
            if g == null or g.type_name == null
                return null
            if g.var_type == TYPE_PTR and g.pointee_type == TYPE_STRUCT
                *out_how = SI_THROUGH
            else if g.var_type != TYPE_STRUCT
                return null
            *out_len = g.type_name_len
            return g.type_name
        if *(g_lv_prefix_kind + idx) != 0
            return null
        let bv: i32 = *(g_lv_by_value + idx)
        if bv != 1 and bv != 2
            return null
        if bv == 2
            *out_how = SI_THROUGH
        *out_len = *(g_lv_type_name_lens + idx)
        return *(g_lv_type_names + idx)
    if e.kind == EXPR_MEMBER
        let f: *StructField = resolve_member_field(m, e)
        if f == null or f.field_type != TYPE_STRUCT
            return null
        *out_len = f.field_type_name_len
        return f.field_type_name
    if e.kind == EXPR_INDEX
        # AGAST #2884: `lv[0][k]`, an element of a Vec or Span local (or of
        # one behind a pointer) that's a struct by value: its type is the
        # local's whole `$T` suffix.  `pv[0][k]` on a `Vec<*S>` names no
        # struct here, and stays a raw buffer (#2887).
        if e.left == null or e.left.kind != EXPR_IDENT or e.right == null or e.right.kind == EXPR_RANGE
            return null
        let eidx: i32 = find_local_var_idx(StrView { ptr: (e.left.ident_ptr), len: (e.left.ident_len) as i64 })
        if eidx < 0 or *(g_lv_prefix_kind + eidx) == 0 or *(g_lv_by_value + eidx) == 0
            return null
        let suf: *u8 = *(g_lv_suffixes + eidx)
        let suf_len: i32 = *(g_lv_suffix_lens + eidx)
        if suf == null or suf_len < 2 or *suf != '$'   # '$'
            return null
        # A generic element (`Pair$i32`) or a nested collection isn't one name.
        var d: i32 = 1
        while d < suf_len
            if *(suf + d) == '$'
                return null
            d = d + 1
        *out_len = suf_len - 1
        return suf + 1
    if e.kind == EXPR_CALL
        if e.call_type_suffix_len != 0
            return null
        let f: *FnDef = find_fn_in_module(m, StrView { ptr: (e.func_name), len: (e.func_name_len) as i64 })
        if f == null or f.type_params != null or f.return_type_name == null
            return null
        if f.return_type == TYPE_STRUCT
            *out_how = SI_TEMPORARY
        else if f.return_type == TYPE_PTR or f.return_type == TYPE_REF or f.return_type == TYPE_MUT_REF
            *out_how = SI_THROUGH
        else
            return null
        *out_len = f.return_type_name_len
        return f.return_type_name
    if e.kind == EXPR_UNARY and e.op == OP_DEREF
        # `(*p)[k]` is `p[k]`'s struct, as a value: the receiver is `p`.
        var how: i32 = 0
        var recv: *Expr = null
        let name: *u8 = si_expr_struct(m, e.operand, out_len, @how, @recv)
        if name == null or how != SI_THROUGH
            *out_len = 0
            return null
        *out_recv = recv
        return name
    null

# The struct `base[k]` indexes, when si_expr_struct knows `base`'s type and
# that struct isn't built in; else null.  `*out_mask` gets the traits it
# implements, `*out_how` how the base holds it and `*out_recv` the receiver.
# A pointer to a struct with none of them is a raw buffer, and a reference
# to one is refused as one value (index_through.ritz): both are left alone.
fn si_base_struct(m: *Module, base: *Expr, out_len: *i32, out_mask: *i32, out_how: *i32, out_recv: **Expr) -> *u8
    *out_mask = 0
    var len: i32 = 0
    let name: *u8 = si_expr_struct(m, base, @len, out_how, out_recv)
    *out_len = 0
    if name == null or len <= 0 or si_built_in(StrView { ptr: (name), len: (len) as i64 }) == 1 or si_is_struct(m, StrView { ptr: (name), len: (len) as i64 }) == 0
        return null
    let mask: i32 = si_traits(m, StrView { ptr: (name), len: (len) as i64 })
    if *out_how == SI_THROUGH and mask == 0
        return null
    *out_len = len
    *out_mask = mask
    name

# si_check, naming the type as the source spells it (`Pair<i64>`, #2847).
fn si_check_shown(m: *Module, line: i32, col: i32, name_sv: StrView, mask: i32, use: i32) -> i32
    var name: *u8 = name_sv.ptr
    var len: i32 = name_sv.len as i32
    var shown_len: i32 = 0
    let shown: *u8 = si_shown(m, StrView { ptr: (name), len: (len) as i64 }, @shown_len)
    si_check(line, col, StrView { ptr: (shown), len: (shown_len) as i64 }, mask, use)

# `@<call>` (or `@&<call>`) of a by-value call's result, which `index` /
# `index_mut` would lend and return a reference into: refused as ritz0's
# _refuse_lent_into_reference refuses it (Aaron's ruling on AGAST #3215).
# 1 when refused.
fn si_refuse_lent_temporary(how: i32, base: *Expr, mutable: i32) -> i32
    if how != SI_TEMPORARY
        return 0
    si_refuse_lent(base, mutable)
    1

# A write to `p[k]` with `p` an `@M` (§3.2): located at `p`, as ref_check
# refuses any other write through one.  1 when refused.
fn si_refuse_shared_write(m: *Module, base: *Expr) -> i32
    # `p.m[k]`, `p.a.m[k]`: the root, reached through fields held by value.  A
    # pointer field on the way is its own place, not in what `p` refers to.
    var root: *Expr = base
    while root != null and root.kind == EXPR_MEMBER
        if root != base
            let f: *StructField = resolve_member_field(m, root)
            if f == null or f.field_type != TYPE_STRUCT
                return 0
        root = root.left
    if root == null or root.kind != EXPR_IDENT
        return 0
    let idx: i32 = find_local_var_idx(StrView { ptr: (root.ident_ptr), len: (root.ident_len) as i64 })
    if idx < 0 or *(g_lv_shared + idx) != 1
        return 0
    si_refuse_write_through(root.span.line, root.span.col)
    1

# Where `x`'s `[` is, `x` an index on a struct: the parser's record of it
# (AGAST #2847: counting from the base's name was off past a space).
fn si_index_line(x: *Expr) -> i32
    if x.bracket.line > 0
        return x.bracket.line
    x.span.line

fn si_index_col(x: *Expr) -> i32
    if x.bracket.line > 0
        return x.bracket.col
    x.span.col

# `e`, an index on a struct, as `*<call>` in place.
fn si_into_deref(e: *Expr, call: *Expr)
    e.kind = EXPR_UNARY
    e.op = OP_DEREF
    e.operand = call
    e.left = null
    e.right = null

# A read of `m[k]` (`*m.index(k)`), `@m[k]` (`m.index(k)`) or `@&m[k]`
# (`m.index_mut(k)`).  Called on each expression before its children.
fn rewrite_struct_index(m: *Module, e: *Expr)
    if e == null
        return
    var x: *Expr = e
    var use: i32 = SI_USE_READ
    if e.kind == EXPR_UNARY and (e.op == OP_ADDR or e.op == OP_ADDR_MUT)
        x = e.operand
        if e.op == OP_ADDR_MUT
            use = SI_USE_ADDR_MUT
    if x == null or x.kind != EXPR_INDEX or x.right == null or x.right.kind == EXPR_RANGE
        return
    var len: i32 = 0
    var mask: i32 = 0
    var how: i32 = 0
    var recv: *Expr = null
    let name: *u8 = si_base_struct(m, x.left, @len, @mask, @how, @recv)
    if name == null
        return
    if si_check_shown(m, si_index_line(x), si_index_col(x), StrView { ptr: (name), len: (len) as i64 }, mask, use) == 0
        return
    if use == SI_USE_ADDR_MUT and si_refuse_shared_write(m, recv) == 1
        return
    if si_refuse_lent_temporary(how, x.left, (use == SI_USE_ADDR_MUT) as i32) == 1
        return
    let key: *Expr = x.right
    if x == e
        let rd: *Expr = si_method(recv, StrView { ptr: (c"index"), len: (5) as i64 }, key, e.span.line, e.span.col)
        si_mark(rd, null, SI_USE_READ, 0, 0, 0)
        si_into_deref(e, rd)
        return
    si_mark(e, x, use, 1, 0, 0)   # x stays `m[k]`: R11a's place
    # `@m[k]` / `@&m[k]` is the reference the method returns.
    e.kind = EXPR_METHOD
    e.left = recv
    if use == SI_USE_ADDR_MUT
        e.ident_ptr = c"index_mut"
        e.ident_len = 9
    else
        e.ident_ptr = c"index"
        e.ident_len = 5
    e.args = key
    e.operand = null
    e.call_type_suffix = null
    e.call_type_suffix_len = 0

# ----------------------------------------------------------------------------
# AGAST #2529: `x op= v` arrives as `x = x op v` (ast_helpers.ritz
# stmt_compound_assign_*), the read and the store sharing the nodes of x's
# operands.  A call among them is noted as evaluated once (si_once), so the
# emitter runs it at the first of the two and hands its register to the second:
# `h(@a)[1] += 7` and `a[f()] += 1` call once.  Only a node both sides reach is
# noted; a user's `a[f()] = a[f()] + 1` has two calls and keeps them.
# ----------------------------------------------------------------------------

# Whether `e` is reached from `root` through a place's operands: an index's
# base and key, a member's or cast's left, a deref, a binary's sides.  A call
# is a leaf: its arguments are evaluated with it.
fn place_reaches(root: *Expr, e: *Expr) -> i32
    if root == null
        return 0
    if root == e
        return 1
    let k: i32 = root.kind
    if k == EXPR_INDEX or k == EXPR_BINARY
        if place_reaches(root.left, e) == 1
            return 1
        return place_reaches(root.right, e)
    if k == EXPR_MEMBER or k == EXPR_CAST
        return place_reaches(root.left, e)
    if k == EXPR_UNARY
        return place_reaches(root.operand, e)
    0

# Note each call in the read `e` that the store reaches from `a` or `b`.
fn note_shared_calls(e: *Expr, a: *Expr, b: *Expr)
    if e == null
        return
    let k: i32 = e.kind
    if k == EXPR_CALL or k == EXPR_METHOD
        if si_once_find(e) < 0 and (place_reaches(a, e) == 1 or place_reaches(b, e) == 1)
            si_once_add(e)
        return
    if k == EXPR_INDEX or k == EXPR_BINARY
        note_shared_calls(e.left, a, b)
        note_shared_calls(e.right, a, b)
    else if k == EXPR_MEMBER or k == EXPR_CAST
        note_shared_calls(e.left, a, b)
    else if k == EXPR_UNARY
        note_shared_calls(e.operand, a, b)

# Where each store form keeps the place's shared operands (ast_helpers.ritz).
fn note_compound_calls(s: *Stmt)
    let k: i32 = s.kind
    if is_store_stmt(k) == 0
        return
    let v: *Expr = s.assign_value
    if v == null or v.kind != EXPR_BINARY or v.left == null
        return
    var a: *Expr = null
    var b: *Expr = null
    if k == STMT_INDEX_ASSIGN or k == STMT_LOCAL_FIELD_INDEX_ASSIGN
        a = s.while_cond
    else if k == STMT_MEMBER_INDEX_ASSIGN
        a = s.if_cond
        b = s.while_cond
    else if k == STMT_MEMBER_ASSIGN
        a = s.if_cond
    else if k == STMT_ASSIGN and s.assign_target_len == 0
        a = s.if_cond
    else
        return
    note_shared_calls(v.left, a, b)

# `s`, a store to `base[key]` of `value`, as `index_set` or a store through
# `index_mut`; `m[k] op= x` (compound) through one `index_mut` call.
fn si_rewrite_assign(m: *Module, s: *Stmt, base: *Expr, key: *Expr, value: *Expr, compound: i32, line: i32, col: i32) -> i32
    # The place, for ref_loan (R11a): `base[key]`, put back together.
    let place: *Expr = si_new_expr(EXPR_INDEX, s.span.line, s.span.col)
    place.left = base
    place.right = key
    var len: i32 = 0
    var mask: i32 = 0
    var how: i32 = 0
    var recv: *Expr = null
    let name: *u8 = si_base_struct(m, base, @len, @mask, @how, @recv)
    if name == null
        return 0
    var use: i32 = SI_USE_ASSIGN
    if compound == 1
        use = SI_USE_COMPOUND
    if si_check_shown(m, line, col, StrView { ptr: (name), len: (len) as i64 }, mask, use) == 0
        return 0
    if si_refuse_shared_write(m, recv) == 1
        return 0
    key.next = null
    if compound == 0 and (mask & SI_INDEX_SET) != 0
        # `index_set` returns nothing: a temporary it writes lends nothing out.
        key.next = value
        s.kind = STMT_EXPR
        s.expr = si_method(recv, StrView { ptr: (c"index_set"), len: (9) as i64 }, key, line, col)
        si_mark(s.expr, place, use, 0, s.span.line, s.span.col)
        return 1
    if si_refuse_lent_temporary(how, base, 1) == 1
        return 0
    let call: *Expr = si_method(recv, StrView { ptr: (c"index_mut"), len: (9) as i64 }, key, line, col)
    si_mark(call, place, use, 0, s.span.line, s.span.col)
    if compound == 1
        # The read `m[k]` of `m[k] = m[k] op x` shares the call.
        si_once_add(call)
        value.left = si_deref(call, line, col)
    s.kind = STMT_ASSIGN
    s.if_cond = si_deref(call, line, col)
    s.assign_target = null
    s.assign_target_len = 0
    s.assign_value = value
    return 1

# Statement forms of `m[k]` on a struct: `m[k] = v`, `m[k] op= x` and a store
# to a field of one (`m[k].f = x`, `m[k].f op= x`).  Before the statement's
# expressions are walked.
fn rewrite_struct_index_stmt(m: *Module, s: *Stmt)
    if s.kind == STMT_INDEX_ASSIGN
        # `name[k] = v` keeps the name, not an expression.
        let base: *Expr = si_new_expr(EXPR_IDENT, s.span.line, s.span.col)
        base.ident_ptr = s.assign_target
        base.ident_len = s.assign_target_len
        let key: *Expr = s.while_cond
        let v: *Expr = s.assign_value
        var compound: i32 = 0
        if v != null and v.kind == EXPR_BINARY and v.left != null and v.left.kind == EXPR_INDEX and v.left.right == key
            compound = 1   # stmt_compound_assign_index shares the key
        if si_rewrite_assign(m, s, base, key, v, compound, s.bracket.line, s.bracket.col) == 1
            collect_from_expr(m, key)
        return
    if s.kind == STMT_LOCAL_FIELD_INDEX_ASSIGN or s.kind == STMT_MEMBER_INDEX_ASSIGN
        # `h.t[k] = v` (a local's field) / `p.t[k] = v` (through a pointer
        # expression): the base is the field `t`.
        var owner: *Expr = null
        if s.kind == STMT_LOCAL_FIELD_INDEX_ASSIGN
            owner = si_new_expr(EXPR_IDENT, s.span.line, s.span.col)
            owner.ident_ptr = s.var_name
            owner.ident_len = s.var_name_len
        else
            owner = s.if_cond
        if owner == null
            return
        let fbase: *Expr = si_new_expr(EXPR_MEMBER, owner.span.line, owner.span.col)
        fbase.left = owner
        fbase.ident_ptr = s.assign_target
        fbase.ident_len = s.assign_target_len
        let fkey: *Expr = s.while_cond
        let fv: *Expr = s.assign_value
        var fcompound: i32 = 0
        if fv != null and fv.kind == EXPR_BINARY and fv.left != null and fv.left.kind == EXPR_INDEX and fv.left.right == fkey
            fcompound = 1   # stmt_compound_assign_*_field_index shares the key
        if si_rewrite_assign(m, s, fbase, fkey, fv, fcompound, s.index_at.line, s.index_at.col) == 1
            collect_from_expr(m, fkey)
        return
    if s.kind != STMT_ASSIGN or s.assign_target_len != 0 or s.if_cond == null
        return
    let t: *Expr = s.if_cond
    let v: *Expr = s.assign_value
    var compound: i32 = 0
    if v != null and v.kind == EXPR_BINARY and v.left == t
        compound = 1   # stmt_compound_assign_expr shares the target
    if t.kind == EXPR_INDEX
        if t.right == null or t.right.kind == EXPR_RANGE
            return
        let key: *Expr = t.right
        if si_rewrite_assign(m, s, t.left, key, v, compound, si_index_line(t), si_index_col(t)) == 1
            collect_from_expr(m, key)
        return
    if t.kind != EXPR_MEMBER
        return
    var root: *Expr = t
    while root.left != null and root.kind == EXPR_MEMBER
        root = root.left
    if root.kind != EXPR_INDEX or root.right == null or root.right.kind == EXPR_RANGE
        return
    var len: i32 = 0
    var mask: i32 = 0
    var how: i32 = 0
    var recv: *Expr = null
    let name: *u8 = si_base_struct(m, root.left, @len, @mask, @how, @recv)
    if name == null
        return
    if si_check_shown(m, si_index_line(root), si_index_col(root), StrView { ptr: (name), len: (len) as i64 }, mask, SI_USE_FIELD_STORE) == 0
        return
    if si_refuse_shared_write(m, recv) == 1
        return
    if si_refuse_lent_temporary(how, root.left, 1) == 1
        return
    let key: *Expr = root.right
    key.next = null
    let place: *Expr = si_field_place(t, root)   # before si_into_deref rewrites root
    let call: *Expr = si_method(recv, StrView { ptr: (c"index_mut"), len: (9) as i64 }, key, root.span.line, root.span.col)
    si_mark(call, place, SI_USE_FIELD_STORE, 0, s.span.line, s.span.col)
    if compound == 1
        si_once_add(call)
    si_into_deref(root, call)
    collect_from_expr(m, key)

# AGAST #2451: `v[lo..hi]` on a Vec, Span or String local (the value, not a
# pointer to one), or on a field holding one by value (`h.v[lo..hi]`, AGAST
# #3803), is rewritten in place into `v.slice(lo, hi)`, ritz0's lowering
# (_emit_slice): vec_slice<T> and string_slice copy, span_slice is a view.  It
# was a bare address in an i64, so `t[1]` indexed bytes and `t.len` had no
# struct.  As a method call, monomorph instantiates vec_slice$T / span_slice$T
# below and the emitter types `t` as the result.  `lo..=hi` arrives as
# `lo..hi + 1` (postfix_range_index_inclusive).  A field may hold the
# collection through a pointer or reference (AGAST #3823).  A slice through a
# pointer is left to index_through, which refuses it (#2448); anything this
# misses is refused by emit_expr_index rather than read as an address.
fn rewrite_value_slice(m: *Module, e: *Expr)
    if e == null or e == g_slice_kept or e.kind != EXPR_INDEX or e.right == null or e.right.kind != EXPR_RANGE
        return
    # Through a pointer or reference, `p[lo..hi]` and `(*p)[lo..hi]` are both
    # `(*p)[lo..hi]` (R9 rule 2, AGAST #2448): `p.slice(lo, hi)`, which UFCS
    # dispatch passes `p` itself to.
    var base: *Expr = e.left
    if base != null and base.kind == EXPR_UNARY and base.op == OP_DEREF
        base = base.operand
    if base == null
        return
    # The receiver's collection kind (0 = String, 1 = Vec, 2 = Span) and its
    # `$T` suffix, from a tracked local or from the field a member chain names.
    var kind: i32 = 0
    var suf: *u8 = null
    var suf_len: i32 = 0
    if base.kind == EXPR_IDENT
        let idx: i32 = find_local_var_idx(StrView { ptr: (base.ident_ptr), len: (base.ident_len) as i64 })
        if idx < 0
            return
        let by_value: i32 = *(g_lv_by_value + idx)
        if by_value == 0 or (base != e.left and by_value != 2)
            return
        kind = *(g_lv_prefix_kind + idx)
        suf = *(g_lv_suffixes + idx)
        suf_len = *(g_lv_suffix_lens + idx)
        if kind == 0
            if name_eq(StrView { ptr: (*(g_lv_type_names + idx)), len: (*(g_lv_type_name_lens + idx)) as i64 }, StrView { ptr: (c"String"), len: (6) as i64 }) == 0
                return
    else if base.kind == EXPR_MEMBER and base == e.left
        # AGAST #3803: `h.v[lo..hi]` on a field holding a Vec, Span or String
        # by value is `h.v.slice(lo, hi)`, as `h.v[:]` already was.  A field
        # holding a `*T`, `@T` or `@&T` to one slices through it, as a pointer
        # local does (R9 rule 2, AGAST #3823): UFCS passes the pointer the
        # field holds.  A `**T` field (TYPE_PTR_PTR) is left to the emitter.
        let fld: *StructField = resolve_member_field(m, base)
        if fld == null or (fld.field_type != TYPE_STRUCT and fld.field_type != TYPE_PTR and field_is_ref(fld) == 0)
            return
        kind = classify_collection_type(StrView { ptr: (fld.field_type_name), len: (fld.field_type_name_len) as i64 }, @suf, @suf_len)
        if kind == 0
            if name_eq(StrView { ptr: (fld.field_type_name), len: (fld.field_type_name_len) as i64 }, StrView { ptr: (c"String"), len: (6) as i64 }) == 0
                return
    else
        return
    let rng: *Expr = e.right
    let lo: *Expr = rng.left
    if kind == 2 and find_generic_function(m, StrView { ptr: (c"span_slice"), len: (10) as i64 }) == null
        # No ritzlib.span (a Span<u8> needs none): the view itself.  `lo` is
        # read for both fields, so as slice_into_span_slot has it: a call is
        # evaluated once (AGAST #3126: `s[idx()..0].len()` was left an index
        # nothing could type), and any other bound must be safe to reread.
        if lo.kind == EXPR_CALL or lo.kind == EXPR_METHOD
            si_once_add(lo)
        else if slice_bound_rereadable(lo) == 0
            return
        span_view_in_place(e, StrView { ptr: (c"ptr"), len: (3) as i64 }, StrView { ptr: (suf), len: (suf_len) as i64 })
        return
    e.left = base
    lo.next = rng.right
    rng.right.next = null
    e.kind = EXPR_METHOD
    e.ident_ptr = c"slice"
    e.ident_len = 5
    e.args = lo
    e.right = null
    e.call_type_suffix = null
    e.call_type_suffix_len = 0

# `v[lo..hi]` as `Span$T { ptr: v.<field> + lo, len: hi - lo }`: ritz0's
# _emit_span_slice on a Span (`field` is `ptr`) and _emit_vec_span_slice on a
# Vec (`data`, AGAST #2501).  `lo` is read twice: the caller takes only a
# bound that's safe to, or registers it to be evaluated once.  Through a
# pointer, `p.ptr` and `(*p).ptr` both read through it (AGAST #2448).
fn span_view_in_place(e: *Expr, field_sv: StrView, suf_sv: StrView)
    var field: *u8 = field_sv.ptr
    var field_len: i32 = field_sv.len as i32
    var suf: *u8 = suf_sv.ptr
    var suf_len: i32 = suf_sv.len as i32
    let lo: *Expr = e.right.left
    let hi: *Expr = e.right.right
    let base: *Expr = slice_node(EXPR_MEMBER, e, e.left, null)
    base.ident_ptr = field
    base.ident_len = field_len
    let at: *Expr = slice_node(EXPR_BINARY, e, base, lo)
    at.op = OP_ADD
    let len: *Expr = slice_node(EXPR_BINARY, e, hi, lo)
    len.op = OP_SUB
    let name: *u8 = malloc((suf_len + 5) as i64) as *u8
    memcpy(name, c"Span", 4)
    memcpy(name + 4, suf, suf_len as i64)
    *(name + 4 + suf_len) = 0
    let ptr_field: *FieldInit = calloc(1, sizeof(FieldInit)) as *FieldInit
    ptr_field.name = c"ptr"
    ptr_field.name_len = 3
    ptr_field.value = at
    let len_field: *FieldInit = calloc(1, sizeof(FieldInit)) as *FieldInit
    len_field.name = c"len"
    len_field.name_len = 3
    len_field.value = len
    ptr_field.next = len_field
    e.kind = EXPR_STRUCT_LIT
    e.ident_ptr = name
    e.ident_len = suf_len + 4
    e.args = ptr_field as *Expr
    e.left = null
    e.right = null

# A zeroed node of `kind` at `at`'s place.
fn slice_node(kind: i32, at: *Expr, left: *Expr, right: *Expr) -> *Expr
    let n: *Expr = calloc(1, sizeof(Expr)) as *Expr
    n.kind = kind
    n.span = at.span
    n.left = left
    n.right = right
    return n

var g_slice_kept: *Expr = null

# AGAST #2501: `let s: Span<T> = v[lo..hi]` on a Vec is a view, as ritz0 makes
# it (_emit_vec_span_slice, LANGUAGE_SPEC §3.4), not vec_slice's copy:
# `Span$T { ptr: v.data + lo, len: hi - lo }`.  `v` is a Vec local, a `*T`,
# `@T` or `@&T` of one (`p[lo..hi]` and `(*p)[lo..hi]` are `(*p)[lo..hi]`, R9
# rule 2, AGAST #2448: `p.data` reads through it), or a by-value Vec field
# (`b.data[lo..hi]`).  `lo` appears in both fields: a call is evaluated once
# (si_once, the emitter shares its register), and any other bound must be free
# of calls, so reading it twice reads the same value.  Returns 1 if `s` is such
# a let; it's rewritten when its bound allows, and is otherwise left as an
# index for the emitter to refuse, located.
fn slice_into_span_annotation(m: *Module, s: *Stmt) -> i32
    return slice_into_span_slot(m, s.var_init, StrView { ptr: (s.var_type_name), len: (s.var_type_name_len) as i64 })

# The same view of `e` into any slot of type `tn` (AGAST #2877).
fn slice_into_span_slot(m: *Module, e: *Expr, tn_sv: StrView) -> i32
    var tn: *u8 = tn_sv.ptr
    var tn_len: i32 = tn_sv.len as i32
    if e == null or tn == null or tn_len < 5
        return 0
    if memcmp(tn, c"Span$", 5) != 0
        return 0
    if e.kind != EXPR_INDEX or e.right == null or e.right.kind != EXPR_RANGE
        return 0
    var base: *Expr = e.left
    if base != null and base.kind == EXPR_UNARY and base.op == OP_DEREF
        base = base.operand
    if base == null
        return 0
    var suf: *u8 = null
    var suf_len: i32 = 0
    if base.kind == EXPR_IDENT
        let idx: i32 = find_local_var_idx(StrView { ptr: (base.ident_ptr), len: (base.ident_len) as i64 })
        if idx < 0 or *(g_lv_prefix_kind + idx) != 1
            return 0
        # The Vec itself, or one level from it (`(*p)` needs the level).
        let by_value: i32 = *(g_lv_by_value + idx)
        if by_value == 0 or (base != e.left and by_value != 2)
            return 1
        suf = *(g_lv_suffixes + idx)
        suf_len = *(g_lv_suffix_lens + idx)
    else if base == e.left and base.kind == EXPR_MEMBER
        # A by-value Vec field, `b.data[0..2]`: the same view of it.
        let rf: *StructField = resolve_member_field(m, e.left)
        if rf == null or rf.field_type != TYPE_STRUCT
            return 0
        if classify_collection_type(StrView { ptr: (rf.field_type_name), len: (rf.field_type_name_len) as i64 }, @suf, @suf_len) != 1
            return 0
    else
        return 0
    let lo: *Expr = e.right.left
    if lo.kind == EXPR_CALL or lo.kind == EXPR_METHOD
        si_once_add(lo)
    else if slice_bound_rereadable(lo) == 0
        return 1
    e.left = base
    span_view_in_place(e, StrView { ptr: (c"data"), len: (4) as i64 }, StrView { ptr: (suf), len: (suf_len) as i64 })
    return 1

# AGAST #2877: `e` lands in a slot of mangled type `tn`: a return (`-> Span<T>`,
# `-> [T]`, the tail), an argument, or a Span let.  A Vec slice there is the
# view slice_into_span_slot builds, as ritz0 makes it (_expects_span), and a
# variant constructor passes its payload's type on: `Some(b.data[0..1])` into
# `-> Option<[u8]>` is a view of `b.data`, `Ok(v[1..3])` into `Result<Span<T>,
# E>` too.  A slice it can't rewrite is kept (g_slice_kept) for the emitter to
# refuse, located: as vec_slice's copy it was a Vec in a Span slot.
fn slice_into_expected(m: *Module, e: *Expr, tn_sv: StrView)
    var tn: *u8 = tn_sv.ptr
    var tn_len: i32 = tn_sv.len as i32
    if e == null or tn == null or tn_len <= 0
        return
    if e.kind == EXPR_INDEX
        if slice_into_span_slot(m, e, StrView { ptr: (tn), len: (tn_len) as i64 }) == 1 and e.kind == EXPR_INDEX
            g_slice_kept = e
        return
    if e.kind != EXPR_CALL or e.call_type_suffix_len != 0 or e.args == null or e.args.next != null
        return
    var pay_len: i32 = 0
    let pay: *u8 = variant_payload_type(m, StrView { ptr: (tn), len: (tn_len) as i64 }, StrView { ptr: (e.func_name), len: (e.func_name_len) as i64 }, @pay_len)
    if pay != null and pay_len > 0
        slice_into_expected(m, e.args, StrView { ptr: (pay), len: (pay_len) as i64 })

# The return type of the fn whose body collect_from_fn_body walks, and its
# tail statement (a `-> T` fn's value), for slice_into_expected.  null in a
# generic's specialisation, which is left as it was.
var g_mono_ret_name: *u8 = null
var g_mono_ret_len: i32 = 0
var g_mono_tail: *Stmt = null

fn set_mono_fn_context(f: *FnDef)
    g_mono_ret_name = null
    g_mono_ret_len = 0
    g_mono_tail = null
    if f == null or f.return_type_name == null or f.return_type_name_len <= 0
        return
    g_mono_ret_name = f.return_type_name
    g_mono_ret_len = f.return_type_name_len
    var st: *Stmt = f.body
    while st != null and st.next != null
        st = st.next
    if st != null and st.kind == STMT_EXPR
        g_mono_tail = st

# A plain (non-generic) fn call's callee, whose params type its arguments.
fn slice_callee(m: *Module, e: *Expr) -> *FnDef
    if e.call_type_suffix_len != 0
        return null
    let f: *FnDef = find_fn_in_module(m, StrView { ptr: (e.func_name), len: (e.func_name_len) as i64 })
    if f == null or f.type_params != null
        return null
    return f

# 1 if reading `e` twice gives the same value with no effect: literals, names,
# fields, and arithmetic, casts and derefs of those.  A call isn't.
fn slice_bound_rereadable(e: *Expr) -> i32
    if e == null
        return 0
    let k: i32 = e.kind
    if k == EXPR_INT_LIT or k == EXPR_IDENT
        return 1
    if k == EXPR_MEMBER or k == EXPR_CAST
        return slice_bound_rereadable(e.left)
    if k == EXPR_UNARY
        return slice_bound_rereadable(e.operand)
    if k == EXPR_BINARY
        if slice_bound_rereadable(e.left) == 1
            return slice_bound_rereadable(e.right)
    return 0

# AGAST #2519: if `e` is `b[i]` (or `(*b)[i]`) on a Vec or Span whose element
# is itself a Vec or Span, return that element's kind and write its "$T"
# suffix to out; 0 otherwise.  `b` is a tracked local (the collection itself,
# or a `*`/`@`/`@&` of it, one level: LARB R9) or a field of one.  A range
# index is a slice, not an element.
fn indexed_element_collection(m: *Module, e: *Expr, out_suffix: **u8, out_suffix_len: *i32) -> i32
    if e.left == null or e.right == null or e.right.kind == EXPR_RANGE
        return 0
    var b: *Expr = e.left
    if b.kind == EXPR_UNARY and b.op == OP_DEREF
        b = b.operand
    if b == null
        return 0
    var csuf: *u8 = null
    var csuf_len: i32 = 0
    if b.kind == EXPR_IDENT
        let idx: i32 = find_local_var_idx(StrView { ptr: (b.ident_ptr), len: (b.ident_len) as i64 })
        # by_value 0 with a collection kind is a `**Vec<T>`: `b[i]` is a raw
        # buffer of pointers there, not an element of the Vec.
        if idx < 0 or *(g_lv_prefix_kind + idx) == 0 or *(g_lv_by_value + idx) == 0
            return 0
        csuf = *(g_lv_suffixes + idx)
        csuf_len = *(g_lv_suffix_lens + idx)
    else if b.kind == EXPR_MEMBER
        let rf: *StructField = resolve_member_field(m, b)
        if rf == null or (rf.field_type != TYPE_STRUCT and rf.field_type != TYPE_PTR)
            return 0
        if classify_collection_type(StrView { ptr: (rf.field_type_name), len: (rf.field_type_name_len) as i64 }, @csuf, @csuf_len) == 0
            return 0
    else
        return 0
    # The collection's suffix is "$<element>": classify the element.
    if csuf == null or csuf_len < 2
        return 0
    return classify_collection_type(StrView { ptr: (csuf + 1), len: (csuf_len - 1) as i64 }, out_suffix, out_suffix_len)

fn collect_from_expr(m: *Module, e: *Expr)
    if e == null
        return

    rewrite_enum_from_call(m, e)
    # AGAST #3145: `@v[lo..hi]` stays an index, so the emitter refuses it at
    # the index ("can't take the address of a slice").  As `@v.slice(lo, hi)`
    # it was an unlocated "cannot take address".
    if e.kind == EXPR_UNARY and (e.op == OP_ADDR or e.op == OP_ADDR_MUT) and e.operand != null
        if e.operand.kind == EXPR_INDEX and e.operand.right != null and e.operand.right.kind == EXPR_RANGE
            g_slice_kept = e.operand
    rewrite_value_slice(m, e)
    rewrite_struct_index(m, e)       # AGAST #1635
    let k: i32 = e.kind

    if k == EXPR_CALL
        # Check if this is a generic call (has type suffix)
        if e.call_type_suffix_len > 0
            add_instantiation(StrView { ptr: (e.func_name), len: (e.func_name_len) as i64 }, StrView { ptr: (e.call_type_suffix), len: (e.call_type_suffix_len) as i64 })
        # AGAST #1824: format_into(sink, "...") appends through
        # `sink.push_bytes(..)`, so a generic sink (`*Vec<u8>`) wants that
        # impl method (Vec$u8.push_bytes, and through it vec_push_bytes$u8)
        # even when nothing else calls it (#4303).
        if e.args != null and name_eq(StrView { ptr: (e.func_name), len: (e.func_name_len) as i64 }, StrView { ptr: (c"format_into"), len: (11) as i64 }) == 1
            want_receiver_method(m, e.args, StrView { ptr: (c"push_bytes"), len: (10) as i64 })
        want_interp_methods(m, e)   # AGAST #3617
        # Recurse into arguments, each into its parameter's slot (AGAST #2877).
        let callee: *FnDef = slice_callee(m, e)
        var par: *Param = null
        if callee != null
            par = callee.params
        var arg: *Expr = e.args
        while arg != null
            if par != null
                if par.param_type == TYPE_STRUCT
                    slice_into_expected(m, arg, StrView { ptr: (par.param_type_name), len: (par.param_type_name_len) as i64 })
                par = par.next
            collect_from_expr(m, arg)
            arg = arg.next
    else if k == EXPR_STRUCT_LIT
        # Check if struct literal is for a generic struct (has $ in name)
        if e.ident_ptr != null and e.ident_len > 0
            add_struct_from_mangled_name(m, StrView { ptr: (e.ident_ptr), len: (e.ident_len) as i64 })
        # Recurse into field initializers.  The parser stores a *FieldInit
        # list in e.args (recast to *Expr — see ident_or_struct /
        # generic_struct_lit in ast_helpers.ritz).  Walking it as *Expr is
        # an alias-bug: FieldInit is 32 bytes so reading Expr.next at
        # offset 120 returns heap garbage and segfaults on most non-null
        # values (e.g. 0x8 from cryptosec/aes_gcm.ritz, which is what
        # blocks valet).  Walk the FieldInit chain directly and recurse
        # into each field's value expression.
        # AGAST #3706: each value lands in its field's slot, so a Vec slice
        # in a `Span<T>` field (`H { s: v[1..3] }`) is a view, as ritz0 makes
        # it.  As vec_slice's copy it stored a Vec$T as the Span$T field.
        var st: *StructDef = null
        if e.ident_ptr != null and e.ident_len > 0
            st = find_concrete_struct(m, StrView { ptr: (e.ident_ptr), len: (e.ident_len) as i64 })
        var fi: *FieldInit = e.args as *FieldInit
        while fi != null
            if fi.value != null
                if st != null
                    var sf: *StructField = st.fields
                    while sf != null
                        if name_eq(StrView { ptr: (sf.name), len: (sf.name_len) as i64 }, StrView { ptr: (fi.name), len: (fi.name_len) as i64 }) == 1
                            if sf.field_type == TYPE_STRUCT
                                slice_into_expected(m, fi.value, StrView { ptr: (sf.field_type_name), len: (sf.field_type_name_len) as i64 })
                            sf = null
                        else
                            sf = sf.next
                collect_from_expr(m, fi.value)
            fi = fi.next
    else if k == EXPR_BINARY
        collect_from_expr(m, e.left)
        collect_from_expr(m, e.right)
    else if k == EXPR_UNARY
        collect_from_expr(m, e.operand)
    else if k == EXPR_INDEX
        collect_from_expr(m, e.left)   # base
        collect_from_expr(m, e.right)  # index
    else if k == EXPR_MEMBER
        collect_from_expr(m, e.left)  # base
    else if k == EXPR_METHOD
        # `v.push(..)` names the impl method Vec<T>.push; specialising it
        # instantiates the vec_push<T> its body calls (AGAST #3617, #4303).
        want_receiver_method(m, e.left, StrView { ptr: (e.ident_ptr), len: (e.ident_len) as i64 })   # AGAST #3617
        collect_from_expr(m, e.left)  # receiver
        var arg: *Expr = e.args
        while arg != null
            collect_from_expr(m, arg)
            arg = arg.next
    else if k == EXPR_CAST
        # AGAST #3124: the struct a cast names, `x as *Box<i64>` / `x as
        # Box<i64>` (apply_cast_tail records it in ident_ptr), is instantiated
        # as a declared type's is: a `let p = x as *Box<i64>` may be its only
        # mention, and `p.v` then had no Box$i64 to resolve.
        if e.ident_ptr != null and e.ident_len > 0
            add_struct_from_mangled_name(m, StrView { ptr: (e.ident_ptr), len: (e.ident_len) as i64 })
        # Parser stores operand in e.left, not e.operand
        collect_from_expr(m, e.left)
    else if k == EXPR_TYPE_OPERAND
        # `sizeof(Box<i64>)` (AGAST #3268) may be Box<i64>'s only mention,
        # and an uninstantiated Box$i64 can't be sized.
        if e.op == TYPE_STRUCT and e.ident_ptr != null and e.ident_len > 0
            add_struct_from_mangled_name(m, StrView { ptr: (e.ident_ptr), len: (e.ident_len) as i64 })
    else if k == EXPR_RANGE
        # Range: start..end (left=start, right=end).  Generic calls inside
        # ranges (e.g. `for i in 0..vec_len<u8>(v)`) must propagate.
        collect_from_expr(m, e.left)
        collect_from_expr(m, e.right)
    else if k == EXPR_TRY
        # `expr?` — recurse into the wrapped expression.
        collect_from_expr(m, e.left)
    else if k == EXPR_ARRAY_LIT
        # [a, b, c]: the elements are the args list.  Without this a generic
        # call that is an element was never instantiated (AGAST #2831).
        var el: *Expr = e.args
        while el != null
            collect_from_expr(m, el)
            el = el.next
    else if k == EXPR_ARRAY_FILL
        # [value; N] keeps value in left (AGAST #2831)
        collect_from_expr(m, e.left)
    else if k == EXPR_MATCH or k == EXPR_IF
        # EXPR_IF (#1613) has the same shape: condition in left, arms in args.
        # match scrutinee \n pattern => body
        # Scrutinee is e.left; arms are e.args recast as *MatchArm.
        # Each arm has body: *Expr (or null for `pass` arms).  Walking
        # arms as *Expr would crash for the same reason struct lits did.
        collect_from_expr(m, e.left)
        var scrut: *Expr = null
        if k == EXPR_MATCH
            scrut = e.left
        collect_from_arms(m, scrut, e.args as *MatchArm)

# ============================================================================
# Generic Function Lookup
# ============================================================================
# Find the generic template for a given function name

pub fn find_generic_function(m: *Module, name_sv: StrView) -> *FnDef
    var name: *u8 = name_sv.ptr
    var name_len: i32 = name_sv.len as i32
    var f: *FnDef = m.functions
    while f != null
        if f.type_params != null
            if f.name_len == name_len
                if memcmp(f.name, name, name_len as i64) == 0
                    return f
        f = f.next
    return null

# ============================================================================
# Type Substitution
# ============================================================================
# Given a type suffix like "$u8", parse out the type name

# AGAST #186: detect ritz0-compatible pointer suffix `$ptr_<TypeName>` so the
# monomorphizer can substitute T with `*Concrete` instead of treating
# "ptr_Foo" as the literal struct name.  Returns 1 iff suffix starts with
# `$ptr_` (5-char prefix after the `$`) and has at least one char of payload.
# AGAST #1794: `$ref_` (`id<@E>`, same length) counts too — a reference is a
# pointer at the IR level, so T substitutes as `*E` either way.
# AGAST #2384: `$refmut_` (`w<@&E>`) too, its prefix 3 bytes longer.
fn suffix_is_ptr(suffix_sv: StrView) -> i32
    var suffix: *u8 = suffix_sv.ptr
    var suffix_len: i32 = suffix_sv.len as i32
    (suffix_ptr_prefix(StrView { ptr: (suffix), len: (suffix_len) as i64 }) > 0) as i32

# Length of the `$ptr_` / `$ref_` (5) or `$refmut_` (8) a pointer-typed
# suffix starts with, payload after it; 0 for any other suffix.
fn suffix_ptr_prefix(suffix_sv: StrView) -> i32
    var suffix: *u8 = suffix_sv.ptr
    var suffix_len: i32 = suffix_sv.len as i32
    if suffix_len < 2 or *suffix != '$'   # '$'
        return 0
    let k: i32 = mangled_ref_prefix(StrView { ptr: (suffix + 1), len: (suffix_len - 1) as i64 })
    if k == 0
        return 0
    k + 1

# AGAST #2354: 1 for a `$refmut_` suffix (`w<@&E>`), which substitutes as
# TYPE_PTR like the others but makes a by-value `T` param an `@&E` one.
fn suffix_is_mut_ref(suffix_sv: StrView) -> i32
    var suffix: *u8 = suffix_sv.ptr
    var suffix_len: i32 = suffix_sv.len as i32
    (suffix_ptr_prefix(StrView { ptr: (suffix), len: (suffix_len) as i64 }) == 8) as i32

pub fn parse_type_from_suffix(suffix_sv: StrView) -> i32
    var suffix: *u8 = suffix_sv.ptr
    var suffix_len: i32 = suffix_sv.len as i32
    # Suffix format: "$typename" where typename is u8, i32, etc.
    # Skip the leading $
    if suffix_len < 2
        return 0  # TYPE_VOID as unknown

    # Pointer-typed generic instantiation (AGAST #186): suffix starts with
    # `$ptr_` — substitute T → *<Pointee>.  TYPE_PTR represents the bare
    # `*T` form; the pointee struct name is carried separately.
    if suffix_is_ptr(StrView { ptr: (suffix), len: (suffix_len) as i64 }) == 1
        return TYPE_PTR

    let type_name: *u8 = suffix + 1
    let type_len: i32 = suffix_len - 1

    # Every primitive ritz0 spells (AGAST #1922: only five were matched, so
    # `ident<u32>` substituted T as a struct named "u32").
    let prim: i32 = primitive_type_from_name(StrView { ptr: (type_name), len: (type_len) as i64 })
    if prim != 0
        return prim

    # AGAST #2832: `$arr2_i8` is the array `[2]i8`.
    var a: ArrayArg
    if array_arg_decode(StrView { ptr: (type_name), len: (type_len) as i64 }, @a) == 1
        return TYPE_ARRAY

    # Could be a struct type
    return TYPE_STRUCT

# AGAST #2832: an array type argument as ast_helpers' spell_last_array spells
# it, "arr" N "_" E: E a primitive's name, a struct's, or "ptr_" + either.
struct ArrayArg
    size: i32
    elem: i32          # TYPE_* of the element
    pointee: i32       # for a TYPE_PTR element, its pointee's TYPE_*
    name: *u8          # the struct named by the element or its pointee
    name_len: i32
    # AGAST #3634: every dimension of an `arrN_arrM_..E` (elem is then
    # TYPE_ARRAY and name null, as on an N-D local); null for a 1-D one.
    shape: *ArrayShape

# 1 and *out filled when name[0..len] spells an array, else 0.
pub fn array_arg_decode(name_sv: StrView, out: *ArrayArg) -> i32
    var name: *u8 = name_sv.ptr
    var len: i32 = name_sv.len as i32
    out.shape = null
    if array_arg_decode_1d(StrView { ptr: (name), len: (len) as i64 }, out) == 0
        return 0
    # AGAST #3634: an element that itself spells an array nests it.
    if out.elem != TYPE_STRUCT or out.name_len < 6
        return 1
    var inner: ArrayArg
    if array_arg_decode(StrView { ptr: (out.name), len: (out.name_len) as i64 }, @inner) == 0
        return 1
    var inner_rank: i32 = 1
    if inner.shape != null
        inner_rank = inner.shape.rank
    if inner_rank >= MAX_ARRAY_RANK
        return 1
    let sh: *ArrayShape = malloc(sizeof(ArrayShape)) as *ArrayShape
    sh.rank = inner_rank + 1
    sh.dims[0] = out.size
    if inner.shape == null
        sh.dims[1] = inner.size
        sh.leaf_type = inner.elem
        sh.leaf_pointee = inner.pointee
        sh.leaf_name = inner.name
        sh.leaf_name_len = inner.name_len
    else
        for d in 0..inner_rank
            sh.dims[d + 1] = inner.shape.dims[d]
        sh.leaf_type = inner.shape.leaf_type
        sh.leaf_pointee = inner.shape.leaf_pointee
        sh.leaf_name = inner.shape.leaf_name
        sh.leaf_name_len = inner.shape.leaf_name_len
    out.elem = TYPE_ARRAY
    out.pointee = TYPE_VOID
    out.name = null
    out.name_len = 0
    out.shape = sh
    1

# One `arrN_` level of array_arg_decode, its element read as written.
fn array_arg_decode_1d(name_sv: StrView, out: *ArrayArg) -> i32
    var name: *u8 = name_sv.ptr
    var len: i32 = name_sv.len as i32
    if name == null or len < 6 or memcmp(name, c"arr", 3) != 0
        return 0
    var pos: i32 = 3
    var size: i32 = 0
    while pos < len and *(name + pos) >= '0' and *(name + pos) <= '9'
        size = size * 10 + (*(name + pos) - 48) as i32
        pos = pos + 1
    if pos == 3 or pos + 1 >= len or *(name + pos) != '_'   # digits, '_', element
        return 0
    pos = pos + 1
    var elem: *u8 = name + pos
    var elem_len: i32 = len - pos
    out.size = size
    out.elem = TYPE_STRUCT
    out.pointee = TYPE_VOID
    if elem_len > 4 and memcmp(elem, c"ptr_", 4) == 0
        out.elem = TYPE_PTR
        elem = elem + 4
        elem_len = elem_len - 4
    let prim: i32 = primitive_type_from_name(StrView { ptr: (elem), len: (elem_len) as i64 })
    if prim != 0
        out.name = null
        out.name_len = 0
        if out.elem == TYPE_PTR
            out.pointee = prim
        else
            out.elem = prim
        return 1
    out.name = elem
    out.name_len = elem_len
    if out.elem == TYPE_PTR
        out.pointee = TYPE_STRUCT
    1

pub fn get_type_name_from_suffix(suffix_sv: StrView, out_name: **u8, out_len: *i32)
    var suffix: *u8 = suffix_sv.ptr
    var suffix_len: i32 = suffix_sv.len as i32
    # Suffix format: "$typename" or (AGAST #186) "$ptr_<typename>".
    # For the pointer form we return the underlying struct name (no `ptr_`
    # prefix) so substitute_type_param_in_name can mangle dependent generics
    # like `Option<T> -> Option$ptr_Page` correctly via the original
    # `$ptr_Page` suffix passed alongside.
    if suffix_len < 2
        *out_name = null
        *out_len = 0
        return
    let k: i32 = suffix_ptr_prefix(StrView { ptr: (suffix), len: (suffix_len) as i64 })
    if k > 0
        *out_name = suffix + k  # skip "$ptr_" / "$ref_" / "$refmut_"
        *out_len = suffix_len - k
        return
    *out_name = suffix + 1
    *out_len = suffix_len - 1

# ============================================================================
# Function Cloning and Substitution
# ============================================================================
# Clone a generic function and substitute the type parameter

# ----------------------------------------------------------------------------
# Multi-parameter generic fns (AGAST #1612)
# ----------------------------------------------------------------------------
# `second<T, U>` called as `second<i64, i32>` carries the suffix "$i64$i32".
# The cloning machinery below substitutes ONE parameter at a time, so a
# multi-parameter template is specialised in one pass per parameter: T at
# "$i64" gives `second$i64` (U still free), then U at "$i32" gives
# `second$i64$i32`.  Each pass appends its argument to the name, so the last
# pass's name is the template's plus the whole suffix — the call site's
# spelling.
#
# While those passes run, g_mono_component_mode switches name rewriting to
# whole `$`-components: `Result$T$E` must become `Result$i32$E` and then
# `Result$i32$i64`, where single-parameter mode only rewrites a trailing
# `$T` and otherwise APPENDS the suffix (its `@&Vec<T>` -> "Vec" + "$u8"
# convention).  Nested generic calls are not registered mid-way — a pass-1
# `helper<T, U>` would register the half-substituted `helper$i64$U` — but
# once, from the finished body (collect_from_fn_body).
var g_mono_component_mode: i32 = 0

fn clone_and_specialize_function(m: *Module, template: *FnDef, suffix_sv: StrView) -> *FnDef
    var suffix: *u8 = suffix_sv.ptr
    var suffix_len: i32 = suffix_sv.len as i32
    let n: i32 = count_type_params(template.type_params)
    if n < 2
        var tp_name: *u8 = null
        var tp_len: i32 = 0
        if template.type_params != null
            tp_name = template.type_params.name
            tp_len = template.type_params.name_len
        let one: *FnDef = specialize_fn_one_param(m, template, StrView { ptr: (tp_name), len: (tp_len) as i64 }, StrView { ptr: (suffix), len: (suffix_len) as i64 })
        collect_receiver_methods(m, one)
        return one

    let cap: i64 = 4 * mangled_arg_capacity(StrView { ptr: (suffix), len: (suffix_len) as i64 }) as i64
    let starts: *i32 = malloc(cap) as *i32
    let lens: *i32 = malloc(cap) as *i32
    if split_mangled_args(m, StrView { ptr: (suffix), len: (suffix_len) as i64 }, starts, lens) != n
        # Wrong arity for this template (e.g. `pair<i64>`): nothing sound to
        # emit.  The call stays unresolved and fails at link, loudly.
        return null
    g_mono_component_mode = 1
    var cur: *FnDef = template
    var tp: *TypeParam = template.type_params
    var i: i32 = 0
    while tp != null
        cur = specialize_fn_one_param(m, cur, StrView { ptr: (tp.name), len: (tp.name_len) as i64 }, StrView { ptr: (suffix + *(starts + i)), len: (*(lens + i)) as i64 })
        tp = tp.next
        i = i + 1
    g_mono_component_mode = 0
    # Walked as a one-parameter specialisation is: its params seeded, so a
    # receiver's type is the param's, not a stale local's (AGAST #3617).
    collect_receiver_methods(m, cur)
    cur

# AGAST #2412: walk a one-parameter specialisation's finished body, as the
# multi-parameter path does, so a method on a local the substitution made
# concrete registers its UFCS helper: `v.push(a)` in `mk<T>` with
# `v: Vec<T>` needs `vec_push$i32` in `mk$i32`.  clone_expr registers only
# explicit generic calls (`vec_push<T>(@&v, a)`); a method's helper is named
# by its receiver's type, which only the local-var tracker knows.  Templates
# are never walked, so the receiver's `Vec$T` never registered `vec_push$T`.
fn collect_receiver_methods(m: *Module, f: *FnDef)
    if f == null
        return
    let saved_ret: *u8 = g_mono_ret_name
    let saved_ret_len: i32 = g_mono_ret_len
    let saved_tail: *Stmt = g_mono_tail
    reset_local_var_tracker()
    var pp: *Param = f.params
    while pp != null
        if g_impl_self_len > 0 and param_is_self(pp) == 1 and pp.param_type_name_len == 0
            # AGAST #3617: a bare `self` / `self:&` of the impl method being
            # specialised is its instance, which name_untyped_self names only
            # afterwards: `self.m()` wants `m` there alone.
            track_typed_local_through(StrView { ptr: (pp.name), len: (pp.name_len) as i64 }, TYPE_MUT_REF, TYPE_STRUCT, StrView { ptr: (g_impl_self_name), len: (g_impl_self_len) as i64 })
        else
            track_typed_local_through(StrView { ptr: (pp.name), len: (pp.name_len) as i64 }, pp.param_type, pp.param_pointee_type, StrView { ptr: (pp.param_type_name), len: (pp.param_type_name_len) as i64 })
        pp = pp.next
    set_mono_fn_context(null)   # A specialisation has no slot context (#2877).
    collect_from_fn_body(m, f.body)
    g_mono_ret_name = saved_ret
    g_mono_ret_len = saved_ret_len
    g_mono_tail = saved_tail

# Rewrite every `$`-separated component of `name` that equals type_param to
# the argument of the one-argument suffix "$arg" (new_suffix):
# `Result$T$E` at T="$i32" is `Result$i32$E`; `T` alone is `i32`.  A
# component that is a tuple over type_param is that tuple's instantiation
# (AGAST #2975): `Vec$tuple_K_V` at K="$i32" is `Vec$tuple_i32_V`.  Returns
# `name` itself (and *out_len = name_len) when no component matches.
fn replace_param_component(name_sv: StrView, type_param_sv: StrView, new_suffix_sv: StrView, out_len: *i32) -> *u8
    var name: *u8 = name_sv.ptr
    var name_len: i32 = name_sv.len as i32
    var type_param: *u8 = type_param_sv.ptr
    var type_param_len: i32 = type_param_sv.len as i32
    var new_suffix: *u8 = new_suffix_sv.ptr
    var new_suffix_len: i32 = new_suffix_sv.len as i32
    return subst_components(StrView { ptr: (name), len: (name_len) as i64 }, StrView { ptr: (type_param), len: (type_param_len) as i64 }, StrView { ptr: (new_suffix), len: (new_suffix_len) as i64 }, 1, out_len)

# replace_param_component, or with plain == 0 only its tuple components.
fn subst_components(name_sv: StrView, type_param_sv: StrView, new_suffix_sv: StrView, plain: i32, out_len: *i32) -> *u8
    var name: *u8 = name_sv.ptr
    var name_len: i32 = name_sv.len as i32
    var type_param: *u8 = type_param_sv.ptr
    var type_param_len: i32 = type_param_sv.len as i32
    var new_suffix: *u8 = new_suffix_sv.ptr
    var new_suffix_len: i32 = new_suffix_sv.len as i32
    *out_len = name_len
    if name == null or type_param == null or new_suffix_len < 1
        return name
    let arg: *u8 = new_suffix + 1
    let arg_len: i32 = new_suffix_len - 1
    # Pass 1: each component's replacement, to size the output.  A tuple's
    # is registered once (tuple_subst is idempotent), so pass 2 asks again.
    var hits: i32 = 0
    var total: i32 = 0
    var pos: i32 = 0
    while pos <= name_len
        var end: i32 = pos
        while end < name_len and *(name + end) != '$'   # '$'
            end = end + 1
        var tl: i32 = 0
        if plain == 1 and end - pos == type_param_len and memcmp(name + pos, type_param, type_param_len as i64) == 0
            hits = hits + 1
            total = total + arg_len
        else if tuple_subst(StrView { ptr: (name + pos), len: (end - pos) as i64 }, StrView { ptr: (type_param), len: (type_param_len) as i64 }, StrView { ptr: (new_suffix), len: (new_suffix_len) as i64 }, @tl) != null
            hits = hits + 1
            total = total + tl
        else if plain == 1 and piece_param_head(StrView { ptr: (name + pos), len: (end - pos) as i64 }, StrView { ptr: (type_param), len: (type_param_len) as i64 }) > 0
            hits = hits + 1
            total = total + piece_param_head(StrView { ptr: (name + pos), len: (end - pos) as i64 }, StrView { ptr: (type_param), len: (type_param_len) as i64 }) + arg_len
        else
            total = total + end - pos
        if end < name_len
            total = total + 1
        pos = end + 1
    if hits == 0
        return name
    # Pass 2: build it.
    let out: *u8 = malloc(total as i64 + 1) as *u8
    var o: i32 = 0
    pos = 0
    while pos <= name_len
        var end: i32 = pos
        while end < name_len and *(name + end) != '$'
            end = end + 1
        var tl: i32 = 0
        var tn: *u8 = null
        if plain == 1 and end - pos == type_param_len and memcmp(name + pos, type_param, type_param_len as i64) == 0
            for j in 0..arg_len
                *(out + o) = *(arg + j)
                o = o + 1
        else
            tn = tuple_subst(StrView { ptr: (name + pos), len: (end - pos) as i64 }, StrView { ptr: (type_param), len: (type_param_len) as i64 }, StrView { ptr: (new_suffix), len: (new_suffix_len) as i64 }, @tl)
            let head: i32 = piece_param_head(StrView { ptr: (name + pos), len: (end - pos) as i64 }, StrView { ptr: (type_param), len: (type_param_len) as i64 })
            if tn != null
                for j in 0..tl
                    *(out + o) = *(tn + j)
                    o = o + 1
            else if plain == 1 and head > 0
                # AGAST #3748: `ptr_A` at A = `Box2_u8` is `ptr_Box2_u8`.
                for j in pos..(pos + head)
                    *(out + o) = *(name + j)
                    o = o + 1
                for j in 0..arg_len
                    *(out + o) = *(arg + j)
                    o = o + 1
            else
                for j in pos..end
                    *(out + o) = *(name + j)
                    o = o + 1
        if end < name_len
            *(out + o) = 36
            o = o + 1
        pos = end + 1
    *(out + o) = 0
    *out_len = o
    out

# The module being monomorphized (AGAST #2975).  Not g_mono_module, which
# is set only once a fn is specialised: a struct's `f: (T, i32)` is
# substituted before any may be, and names_generic_struct reads that one.
var g_tuple_module: *Module = null

# AGAST #2975: the tuple `name` (a template over type_param, see
# ast_helpers' tuple_mark_generic) with type_param bound to the one-argument
# suffix "$arg": `tuple_T_T` at T="$i32" is `tuple_i32_i32`, laid out
# `{i32, i32}`, registered the first time and put in the module being
# specialised once no parameter is left in it.  null when `name` is no
# tuple over type_param.
fn tuple_subst(name_sv: StrView, type_param_sv: StrView, suffix_sv: StrView, out_len: *i32) -> *u8
    var name: *u8 = name_sv.ptr
    var name_len: i32 = name_sv.len as i32
    var type_param: *u8 = type_param_sv.ptr
    var type_param_len: i32 = type_param_sv.len as i32
    var suffix: *u8 = suffix_sv.ptr
    var suffix_len: i32 = suffix_sv.len as i32
    let r: *TupleReg = tuple_reg_lookup(StrView { ptr: (name), len: (name_len) as i64 })
    if r == null or type_param_index(r.def.type_params, StrView { ptr: (type_param), len: (type_param_len) as i64 }) < 0
        return null
    var elems: *TupleElem = null
    var last_e: *TupleElem = null
    var fields: *StructField = null
    var last_f: *StructField = null
    var total: i32 = 5   # "tuple"
    var e: *TupleElem = r.elems
    var f: *StructField = r.def.fields
    while e != null and f != null
        var sp: *u8 = null
        var sl: i32 = generic_arg_spelling(e.ga, @sp)
        let nf: *StructField = malloc(sizeof(StructField)) as *StructField
        *nf = *f
        nf.next = null
        if f.field_type == TYPE_STRUCT and f.field_type_name != null
            if name_is_type_param(StrView { ptr: (f.field_type_name), len: (f.field_type_name_len) as i64 }, StrView { ptr: (type_param), len: (type_param_len) as i64 }) == 1
                var sn: *u8 = null
                var snl: i32 = 0
                get_type_name_from_suffix(StrView { ptr: (suffix), len: (suffix_len) as i64 }, @sn, @snl)
                subst_value_field(nf, parse_type_from_suffix(StrView { ptr: (suffix), len: (suffix_len) as i64 }), StrView { ptr: (sn), len: (snl) as i64 })
                sp = suffix + 1
                sl = suffix_len - 1
            else
                var nl: i32 = 0
                let nn: *u8 = replace_param_component(StrView { ptr: (f.field_type_name), len: (f.field_type_name_len) as i64 }, StrView { ptr: (type_param), len: (type_param_len) as i64 }, StrView { ptr: (suffix), len: (suffix_len) as i64 }, @nl)
                nf.field_type_name = nn
                nf.field_type_name_len = nl
                sp = nn
                sl = nl
        else if tuple_elem_points_at(f, StrView { ptr: (type_param), len: (type_param_len) as i64 }) == 1
            # AGAST #3173: `*T` / `@T` / `@&T` at T = the argument, spelt as
            # ritz0 mangles it: the template's `ptr_T` / `ref_T` / `refmut_T`
            # with its trailing T replaced, so `(*T, i32)` at T = i32 is
            # `tuple_ptr_i32_i32` (and at T = *u8, `tuple_ptr_ptr_u8_i32`).
            var sn: *u8 = null
            var snl: i32 = 0
            get_type_name_from_suffix(StrView { ptr: (suffix), len: (suffix_len) as i64 }, @sn, @snl)
            let st: i32 = parse_type_from_suffix(StrView { ptr: (suffix), len: (suffix_len) as i64 })
            if f.field_type == TYPE_PTR_PTR
                # AGAST #3184: `**T` (`tuple_ptr_ptr_i32_i32`).
                subst_ptr_ptr_field(nf, st, StrView { ptr: (sn), len: (snl) as i64 })
            else
                subst_pointee_field(nf, st, StrView { ptr: (sn), len: (snl) as i64 })
            # The pointee as field_new records a written `*i32` / `**u8`:
            # tuple_split_decl types the bound local from it.
            if f.field_type == TYPE_PTR
                if nf.field_type == TYPE_PTR_PTR
                    nf.ptr_pointee = TYPE_VOID
                    nf.inner_pointee_type = primitive_type_from_name(StrView { ptr: (sn), len: (snl) as i64 })
                    if nf.inner_pointee_type == 0
                        nf.inner_pointee_type = TYPE_STRUCT
                else
                    nf.ptr_pointee = st
            let keep: i32 = sl - type_param_len
            let ps: *u8 = malloc((keep + suffix_len) as i64) as *u8
            memcpy(ps, sp, keep as i64)
            memcpy(ps + keep, suffix + 1, (suffix_len - 1) as i64)
            sp = ps
            sl = keep + suffix_len - 1
        let ga: *GenericArg = calloc(1, sizeof(GenericArg)) as *GenericArg
        ga.ty = TYPE_STRUCT   # only its spelling is read again
        ga.name = sp
        ga.name_len = sl
        let ne: *TupleElem = calloc(1, sizeof(TupleElem)) as *TupleElem
        ne.ga = ga
        ne.field = nf
        if last_e == null
            elems = ne
            fields = nf
        else
            last_e.next = ne
            last_f.next = nf
        last_e = ne
        last_f = nf
        total = total + 1 + sl
        e = e.next
        f = f.next
    let nm: *u8 = malloc(total as i64 + 1) as *u8
    memcpy(nm, c"tuple", 5)
    var pos: i32 = 5
    e = elems
    while e != null
        *(nm + pos) = 95   # '_'
        pos = pos + 1
        memcpy(nm + pos, e.ga.name, e.ga.name_len as i64)
        pos = pos + e.ga.name_len
        e = e.next
    *(nm + pos) = 0
    var got: *TupleReg = tuple_reg_lookup(StrView { ptr: (nm), len: (pos) as i64 })
    if got == null
        # The parameters left: the template's, less type_param.
        var rest: *TypeParam = null
        var tp: *TypeParam = r.def.type_params
        while tp != null
            if name_is_type_param(StrView { ptr: (tp.name), len: (tp.name_len) as i64 }, StrView { ptr: (type_param), len: (type_param_len) as i64 }) == 0
                let c: *TypeParam = calloc(1, sizeof(TypeParam)) as *TypeParam
                c.name = tp.name
                c.name_len = tp.name_len
                c.next = rest
                rest = c
            tp = tp.next
        let def: *StructDef = calloc(1, sizeof(StructDef)) as *StructDef
        def.name = nm
        def.name_len = pos
        def.fields = fields
        def.type_params = rest
        got = tuple_reg_add(def, elems)
    tuple_reg_place(got, g_tuple_module)
    *out_len = got.def.name_len
    got.def.name

# 1 when tuple element f is `*T` / `@T` / `@&T` (AGAST #3173) or `**T`
# (AGAST #3184), T = type_param.
fn tuple_elem_points_at(f: *StructField, type_param_sv: StrView) -> i32
    var type_param: *u8 = type_param_sv.ptr
    var type_param_len: i32 = type_param_sv.len as i32
    if f.field_type != TYPE_PTR and f.field_type != TYPE_PTR_PTR and f.field_type != TYPE_REF and f.field_type != TYPE_MUT_REF
        return 0
    name_is_type_param(StrView { ptr: (f.field_type_name), len: (f.field_type_name_len) as i64 }, StrView { ptr: (type_param), len: (type_param_len) as i64 })

# Specialise `template` at ONE type parameter (type_param_name) bound to the
# one-argument suffix "$arg".  The result's name is template.name + suffix.
fn specialize_fn_one_param(m: *Module, template: *FnDef, type_param_name_sv: StrView, suffix_sv: StrView) -> *FnDef
    var type_param_name: *u8 = type_param_name_sv.ptr
    var type_param_len: i32 = type_param_name_sv.len as i32
    var suffix: *u8 = suffix_sv.ptr
    var suffix_len: i32 = suffix_sv.len as i32
    g_mono_module = m  # AGAST #1926: see names_generic_struct
    # Create a new FnDef with mangled name
    let mangled_name_len: i32 = template.name_len + suffix_len
    let mangled_name: *u8 = malloc(mangled_name_len as i64 + 1) as *u8

    # Copy base name
    for i in 0..template.name_len
        *(mangled_name + i) = *(template.name + i)

    # Copy suffix (including the $)
    for j in 0..suffix_len
        *(mangled_name + template.name_len + j) = *(suffix + j)
    *(mangled_name + mangled_name_len) = 0

    # Get the substitution type from suffix
    var subst_type_name: *u8 = null
    var subst_type_len: i32 = 0
    get_type_name_from_suffix(StrView { ptr: (suffix), len: (suffix_len) as i64 }, @subst_type_name, @subst_type_len)
    let subst_type: i32 = parse_type_from_suffix(StrView { ptr: (suffix), len: (suffix_len) as i64 })

    # Clone the function with specialized name
    # Sized with sizeof(FnDef) (AGAST #1663) — type_params lives at the
    # tail.  Earlier code used malloc(88), undersizing the struct by one
    # pointer slot.  In selfhost ritz1 that meant `specialized.type_params =
    # null` wrote into adjacent heap, leaving type_params junked → emit_module's
    # `if f.type_params != null` skipped the specialized fn → only `declare`
    # emitted at the call site, with i64 fallback types.  Cluster of 4+
    # selfhost asm-fails fixed by widening this allocation.
    let specialized: *FnDef = malloc(sizeof(FnDef)) as *FnDef
    specialized.name = mangled_name
    specialized.name_len = mangled_name_len
    specialized.params = clone_params_with_suffix(template.params, StrView { ptr: (type_param_name), len: (type_param_len) as i64 }, subst_type, StrView { ptr: (subst_type_name), len: (subst_type_len) as i64 }, StrView { ptr: (suffix), len: (suffix_len) as i64 })
    specialized.return_type = substitute_type(template.return_type, StrView { ptr: (type_param_name), len: (type_param_len) as i64 }, subst_type, StrView { ptr: (subst_type_name), len: (subst_type_len) as i64 })
    specialized.body = clone_body(template.body, StrView { ptr: (type_param_name), len: (type_param_len) as i64 }, subst_type, StrView { ptr: (subst_type_name), len: (subst_type_len) as i64 }, StrView { ptr: (suffix), len: (suffix_len) as i64 })
    specialized.type_params = null  # Not generic anymore
    specialized.next = null
    specialized.line = template.line
    specialized.return_type_name = template.return_type_name
    specialized.return_type_name_len = template.return_type_name_len
    # AGAST #194: monomorphizations are emitted in every module that uses
    # them, with `linkonce_odr` linkage so the linker dedupes copies.
    # Mark is_local=1 so the emit_fn loop emits the body (rather than a
    # `declare`).
    specialized.is_local = 1
    specialized.ret_fn_sig = template.ret_fn_sig   # AGAST #2120
    specialized.ret_ref = clone_params_with_suffix(template.ret_ref, StrView { ptr: (type_param_name), len: (type_param_len) as i64 }, subst_type, StrView { ptr: (subst_type_name), len: (subst_type_len) as i64 }, StrView { ptr: (suffix), len: (suffix_len) as i64 })   # AGAST #2308
    specialized.ret_array = null   # AGAST #2343: `[N]T` keeps T's own name; left unjudged
    specialized.ret_array_param = clone_params_with_suffix(template.ret_array_param, StrView { ptr: (type_param_name), len: (type_param_len) as i64 }, subst_type, StrView { ptr: (subst_type_name), len: (subst_type_len) as i64 }, StrView { ptr: (suffix), len: (suffix_len) as i64 })   # AGAST #2302
    specialized.ret_ptr_array = ptr_array_unless_generic(template.ret_ptr_array)   # AGAST #2329
    specialized.def_file = template.def_file   # AGAST #2236: names the diagnostic's file
    specialized.is_pub = 1   # AGAST #3419: an instance has no declaration to mark `pub`
    specialized.col = template.col
    specialized.extern_decl = 0
    fn_copy_instance_attrs(specialized, template)   # [[callconv]] / [[test_helper]] / inline family (#1879, #1869, #1961)

    # Handle return type struct name substitution
    if specialized.return_type == TYPE_STRUCT
        if specialized.return_type_name != null
            # Check if it matches the type param exactly (e.g., "T" -> "u8")
            if specialized.return_type_name_len == type_param_len
                if memcmp(specialized.return_type_name, type_param_name, type_param_len as i64) == 0
                    # Substitute with concrete type
                    specialized.return_type = subst_type
                    specialized.return_type_name = subst_type_name
                    specialized.return_type_name_len = subst_type_len
                    # AGAST #2305: `-> T` at T = `[N]E` returns the `[N x E]`.
                    if subst_type == TYPE_ARRAY and specialized.ret_array_param == null
                        let rap: *Param = calloc(1, sizeof(Param)) as *Param
                        if param_take_array_arg(rap, StrView { ptr: (subst_type_name), len: (subst_type_len) as i64 }) == 1
                            specialized.ret_array_param = rap
                            specialized.return_type_name = rap.param_type_name
                            specialized.return_type_name_len = rap.param_type_name_len
            # Otherwise it might be a generic struct like "Vec$T" -> "Vec$u8"
            else
                var new_name: *u8 = null
                var new_len: i32 = 0
                substitute_type_param_in_name(StrView { ptr: (specialized.return_type_name), len: (specialized.return_type_name_len) as i64 }, StrView { ptr: (type_param_name), len: (type_param_len) as i64 }, StrView { ptr: (suffix), len: (suffix_len) as i64 }, @new_name, @new_len)
                specialized.return_type_name = new_name
                specialized.return_type_name_len = new_len
    # AGAST #1980: `-> *T` names its pointee "T" too.  Left unsubstituted,
    # `let p = vec_as_ptr<i32>(@v)` registered p as a pointer to struct %T
    # (`load %T`, byte stride).  Name the concrete pointee instead: a
    # primitive ("i32", which the let path maps to a pointee kind) or a
    # struct.
    #
    # AGAST #2791: T = *U ($ptr_ suffix) makes the return `**U`, recorded as
    # a written `-> **U` is (TYPE_PTR_PTR, named U).  It stayed a `*T` named
    # "T", which no stride lookup resolves, so `vec_as_ptr<*u8>(@v) + i`
    # added i BYTES and execve got byte-shifted argv pointers (#2790).
    else if specialized.return_type == TYPE_PTR
        if specialized.return_type_name != null and specialized.return_type_name_len == type_param_len
            if memcmp(specialized.return_type_name, type_param_name, type_param_len as i64) == 0
                if subst_type == TYPE_PTR
                    specialized.return_type = TYPE_PTR_PTR
                specialized.return_type_name = subst_type_name
                specialized.return_type_name_len = subst_type_len
        # AGAST #3179: `-> *W<T>` points at "W$T", as `-> W<T>` names it: the
        # instance is "W$i32".  Left unsubstituted, find_struct missed it and
        # `g(@w).v` / `w.g().v` were "unhandled EXPR_MEMBER".
        else if specialized.return_type_name != null
            var p_name: *u8 = null
            var p_len: i32 = 0
            substitute_type_param_in_name(StrView { ptr: (specialized.return_type_name), len: (specialized.return_type_name_len) as i64 }, StrView { ptr: (type_param_name), len: (type_param_len) as i64 }, StrView { ptr: (suffix), len: (suffix_len) as i64 }, @p_name, @p_len)
            specialized.return_type_name = p_name
            specialized.return_type_name_len = p_len
    # AGAST #3015: and `-> @T` / `-> @&T` (Deref's `deref`, R17): the referent
    # is T's concrete name, so `(*b.deref()).f` finds T's field.
    else if specialized.return_type == TYPE_REF or specialized.return_type == TYPE_MUT_REF
        if specialized.return_type_name != null and specialized.return_type_name_len == type_param_len
            if memcmp(specialized.return_type_name, type_param_name, type_param_len as i64) == 0
                specialized.return_type_name = subst_type_name
                specialized.return_type_name_len = subst_type_len

    # AGAST #3101: a bare `-> T` at T = `*[N]E` / `@&[N]E` returns that array
    # pointer, recorded as a written `-> *[N]E` is, so `let p = id<*[2]i32>(@a)`
    # knows N and E.  It was a `*arr2_i32` struct pointer: `p[1]` read 0, SILENT.
    if specialized.ret_ptr_array == null and template.return_type == TYPE_STRUCT and subst_type == TYPE_PTR
        if name_is_type_param(StrView { ptr: (template.return_type_name), len: (template.return_type_name_len) as i64 }, StrView { ptr: (type_param_name), len: (type_param_len) as i64 }) == 1
            specialized.ret_ptr_array = ptr_array_arg_param(StrView { ptr: (subst_type_name), len: (subst_type_len) as i64 })
    # AGAST #3986: and `-> *T` at T = `[N]E` points at that array, as a written
    # `-> *[N]E` does.  ritzlib's `__heap_new<[2]P>` (`heap [a, b]`) returned a
    # `*arr2_P` struct pointer, so `p[0]` and `p[0].c` on its result failed.
    if specialized.ret_ptr_array == null and template.return_type == TYPE_PTR and subst_type == TYPE_ARRAY
        if name_is_type_param(StrView { ptr: (template.return_type_name), len: (template.return_type_name_len) as i64 }, StrView { ptr: (type_param_name), len: (type_param_len) as i64 }) == 1
            specialized.ret_ptr_array = ptr_array_arg_param(StrView { ptr: (subst_type_name), len: (subst_type_len) as i64 })

    return specialized

# AGAST #3101: `param` points at the array a type argument spelled `arrN_E`
# names (N, E, E's pointee and name), as a written `*[N]E` would; unchanged
# when `name` spells no array.
fn param_take_ptr_array_arg(param: *Param, name_sv: StrView)
    var name: *u8 = name_sv.ptr
    var len: i32 = name_sv.len as i32
    let pa: *Param = ptr_array_arg_param(StrView { ptr: (name), len: (len) as i64 })
    if pa == null
        return
    param.param_pointee_array_size = pa.param_pointee_array_size
    param.param_pointee_array_elem_type = pa.param_pointee_array_elem_type
    param.param_pointee_array_elem_pointee = pa.param_pointee_array_elem_pointee
    param.param_pointee_array_shape = null
    param.param_type_name = pa.param_type_name
    param.param_type_name_len = pa.param_type_name_len

# AGAST #2305: a by-value `a: T` (or `-> T`) at T = `[N]E` is the `a: [N]E` it
# says: N, E, E's pointee and struct name from the `arrN_E` type argument, as
# a written `[N]E` param records them.  It stayed TYPE_ARRAY with no N, so the
# call refused `g<[4]i32>(a)` as the wrong length.  0 when `name` spells no array.
fn param_take_array_arg(param: *Param, name_sv: StrView) -> i32
    var name: *u8 = name_sv.ptr
    var len: i32 = name_sv.len as i32
    var arr: ArrayArg
    if array_arg_decode(StrView { ptr: (name), len: (len) as i64 }, @arr) == 0
        return 0
    param.param_type = TYPE_ARRAY
    param.param_array_size = arr.size
    param.param_array_elem_type = arr.elem
    param.param_array_elem_pointee = arr.pointee
    param.param_array_shape = arr.shape   # AGAST #3634
    param.param_type_name = arr.name
    param.param_type_name_len = arr.name_len
    1

fn name_is_type_param(name_sv: StrView, tp_sv: StrView) -> i32
    var name: *u8 = name_sv.ptr
    var len: i32 = name_sv.len as i32
    var tp: *u8 = tp_sv.ptr
    var tp_len: i32 = tp_sv.len as i32
    (name != null and len == tp_len and memcmp(name, tp, tp_len as i64) == 0) as i32

# AGAST #3101: the `*[N]E` a type argument spelled `arrN_E` points at, as a
# Param ptr_array_of_last would record (N, E, E's pointee and name); null when
# `name` spells no array.
fn ptr_array_arg_param(name_sv: StrView) -> *Param
    var name: *u8 = name_sv.ptr
    var len: i32 = name_sv.len as i32
    var arr: ArrayArg
    if array_arg_decode(StrView { ptr: (name), len: (len) as i64 }, @arr) == 0
        return null
    let pa: *Param = calloc(1, sizeof(Param)) as *Param
    pa.param_type = TYPE_PTR
    pa.param_pointee_type = TYPE_ARRAY
    pa.param_pointee_array_size = arr.size
    pa.param_pointee_array_elem_type = arr.elem
    pa.param_pointee_array_elem_pointee = arr.pointee
    pa.param_type_name = arr.name
    pa.param_type_name_len = arr.name_len
    pa

# `sh` with a leaf `T` substituted (AGAST #2290).  Shapes are shared, so a change
# is a copy.
fn array_shape_subst(sh: *ArrayShape, type_param_sv: StrView, subst_type: i32, subst_name_sv: StrView) -> *ArrayShape
    var type_param: *u8 = type_param_sv.ptr
    var type_param_len: i32 = type_param_sv.len as i32
    var subst_name: *u8 = subst_name_sv.ptr
    var subst_len: i32 = subst_name_sv.len as i32
    if sh == null or sh.leaf_name_len != type_param_len or memcmp(sh.leaf_name, type_param, type_param_len as i64) != 0
        return sh
    let out: *ArrayShape = malloc(sizeof(ArrayShape)) as *ArrayShape
    *out = *sh
    out.leaf_type = subst_type
    out.leaf_name = subst_name
    out.leaf_name_len = subst_len
    return out

# AGAST #3119: `sh` with a generic leaf's `$T` rewritten, `[2][3]P<T>` (leaf
# `P$T`) at T = i64 is leaf `P$i64`.  Shared as it stood, `W$i64.a` named the
# `%P$T` no struct is, and `w.a[1][2].v` fell to "unhandled EXPR_MEMBER".
fn array_shape_mangled_subst(sh: *ArrayShape, type_param_sv: StrView, suffix_sv: StrView) -> *ArrayShape
    var type_param: *u8 = type_param_sv.ptr
    var type_param_len: i32 = type_param_sv.len as i32
    var suffix: *u8 = suffix_sv.ptr
    var suffix_len: i32 = suffix_sv.len as i32
    if sh == null or sh.leaf_name == null or find_dollar_sign(StrView { ptr: (sh.leaf_name), len: (sh.leaf_name_len) as i64 }) <= 0
        return sh
    let out: *ArrayShape = malloc(sizeof(ArrayShape)) as *ArrayShape
    *out = *sh
    var n: i32 = 0
    substitute_type_param_in_name(StrView { ptr: (sh.leaf_name), len: (sh.leaf_name_len) as i64 }, StrView { ptr: (type_param), len: (type_param_len) as i64 }, StrView { ptr: (suffix), len: (suffix_len) as i64 }, @out.leaf_name, @n)
    out.leaf_name_len = n
    return out

# A reference param that holds a pointer records what that pointer points at,
# and a `:&` one reads as the pointer, so it needs it twice.
fn set_ref_ptr_pointee(param: *Param, pointee: i32)
    param.param_ref_ptr_pointee = pointee
    if param.is_borrow == 1
        param.param_inner_pointee_type = pointee

# What a `*U` type argument points at, from get_type_name_from_suffix's name for
# it: U's spelling, which is `ptr_C` when U is itself the pointer `*C`.
fn ptr_arg_pointee(name_sv: StrView) -> i32
    var name: *u8 = name_sv.ptr
    var len: i32 = name_sv.len as i32
    if len > 4 and memcmp(name, c"ptr_", 4) == 0
        return TYPE_PTR
    # AGAST #3101: `*[N]E` points at an array, not a struct named `arrN_E`.
    var arr: ArrayArg
    if array_arg_decode(StrView { ptr: (name), len: (len) as i64 }, @arr) == 1
        return TYPE_ARRAY
    let prim: i32 = primitive_type_from_name(StrView { ptr: (name), len: (len) as i64 })
    if prim != 0
        return prim
    TYPE_STRUCT

# AGAST #2086: `r:& T` at T = `**S` (any depth) borrows a `**S`, recorded as a
# written `r:& **S` is (pointee TYPE_PTR_PTR, S's depth-packed slot, S's
# name), so it binds as one (param_borrows_struct_ptr_ptr).  It was left
# `r:& *<ptr_S>`, which binds as nothing: `r` read as the borrow slot and
# `r = v` wrote that, not the caller's `**S`.  `name` is T less its first
# `ptr_` (get_type_name_from_suffix).
fn borrow_take_ptr_ptr_arg(param: *Param, subst_type: i32, name_sv: StrView)
    var name: *u8 = name_sv.ptr
    var len: i32 = name_sv.len as i32
    if param.is_borrow != 1 or param.param_type != TYPE_MUT_REF or subst_type != TYPE_PTR
        return
    var rest: *u8 = name
    var rest_len: i32 = len
    var extra: i32 = 0
    while rest_len > 4 and memcmp(rest, c"ptr_", 4) == 0
        rest = rest + 4
        rest_len = rest_len - 4
        extra = extra + 1
    if extra == 0 or ptr_arg_pointee(StrView { ptr: (rest), len: (rest_len) as i64 }) != TYPE_STRUCT
        return
    param.param_pointee_type = TYPE_PTR_PTR
    param.param_inner_pointee_type = TYPE_STRUCT + (extra - 1) * PTR_DEPTH_UNIT
    param.param_ref_ptr_pointee = TYPE_VOID
    param.param_type_name = rest
    param.param_type_name_len = rest_len

fn clone_params_with_suffix(params: *Param, type_param_sv: StrView, subst_type: i32, subst_name_sv: StrView, suffix_sv: StrView) -> *Param
    var type_param: *u8 = type_param_sv.ptr
    var type_param_len: i32 = type_param_sv.len as i32
    var subst_name: *u8 = subst_name_sv.ptr
    var subst_len: i32 = subst_name_sv.len as i32
    var suffix: *u8 = suffix_sv.ptr
    var suffix_len: i32 = suffix_sv.len as i32
    if params == null
        return null

    let cloned: *Param = malloc(sizeof(Param)) as *Param
    cloned.name = params.name
    cloned.name_len = params.name_len
    cloned.param_ty = params.param_ty   # AGAST #4528: the parsed chain (none mutates it)
    cloned.param_type = substitute_type(params.param_type, StrView { ptr: (type_param), len: (type_param_len) as i64 }, subst_type, StrView { ptr: (subst_name), len: (subst_len) as i64 })
    cloned.param_type_name = params.param_type_name
    cloned.param_type_name_len = params.param_type_name_len
    cloned.param_pointee_type = params.param_pointee_type
    cloned.param_inner_pointee_type = params.param_inner_pointee_type  # AGAST #1815
    cloned.param_inner_ref = params.param_inner_ref  # AGAST #2399
    # AGAST #1953, #2321.  A generic `*[N]T` keeps its TYPE_ARRAY pointee below.
    cloned.param_pointee_array_size = params.param_pointee_array_size
    cloned.param_pointee_array_elem_type = params.param_pointee_array_elem_type
    cloned.param_pointee_array_elem_pointee = params.param_pointee_array_elem_pointee
    cloned.param_pointee_array_shape = array_shape_subst(params.param_pointee_array_shape, StrView { ptr: (type_param), len: (type_param_len) as i64 }, subst_type, StrView { ptr: (subst_name), len: (subst_len) as i64 })  # AGAST #2290
    cloned.param_array_size = params.param_array_size
    cloned.param_array_elem_type = params.param_array_elem_type
    cloned.param_array_elem_pointee = params.param_array_elem_pointee   # AGAST #2332
    # AGAST #3634: a by-value `[N][M]T`'s shape, its leaf substituted as above.
    let byval_sh: *ArrayShape = array_shape_subst(params.param_array_shape, StrView { ptr: (type_param), len: (type_param_len) as i64 }, subst_type, StrView { ptr: (subst_name), len: (subst_len) as i64 })
    cloned.param_array_shape = array_shape_mangled_subst(byval_sh, StrView { ptr: (type_param), len: (type_param_len) as i64 }, StrView { ptr: (suffix), len: (suffix_len) as i64 })
    cloned.is_borrow = params.is_borrow
    cloned.is_self_borrow = params.is_self_borrow
    cloned.param_ref_ptr_pointee = params.param_ref_ptr_pointee   # AGAST #2308
    cloned.name_span.line = params.name_span.line   # AGAST #2407
    cloned.name_span.col = params.name_span.col
    cloned.fn_sig = clone_fn_sig(params.fn_sig, StrView { ptr: (type_param), len: (type_param_len) as i64 }, subst_type, StrView { ptr: (subst_name), len: (subst_len) as i64 }, StrView { ptr: (suffix), len: (suffix_len) as i64 })  # AGAST #1671

    # AGAST #2287: `a: [N]T` takes T's element type and name; `[N]Vec<T>` its name.
    if cloned.param_type == TYPE_ARRAY and cloned.param_type_name != null and params.param_type == TYPE_ARRAY
        if cloned.param_type_name_len == type_param_len and memcmp(cloned.param_type_name, type_param, type_param_len as i64) == 0
            if cloned.param_array_elem_type == TYPE_STRUCT
                cloned.param_array_elem_type = subst_type
            if cloned.param_array_elem_pointee == TYPE_STRUCT
                cloned.param_array_elem_pointee = subst_type   # AGAST #2332: `[N]*T`
            cloned.param_type_name = subst_name
            cloned.param_type_name_len = subst_len
        else
            var arr_name: *u8 = null
            var arr_len: i32 = 0
            substitute_type_param_in_name(StrView { ptr: (cloned.param_type_name), len: (cloned.param_type_name_len) as i64 }, StrView { ptr: (type_param), len: (type_param_len) as i64 }, StrView { ptr: (suffix), len: (suffix_len) as i64 }, @arr_name, @arr_len)
            cloned.param_type_name = arr_name
            cloned.param_type_name_len = arr_len

    # Handle struct type name substitution for TYPE_STRUCT
    if cloned.param_type == TYPE_STRUCT and cloned.param_type_name != null
        if cloned.param_type_name_len == type_param_len and memcmp(cloned.param_type_name, type_param, type_param_len as i64) == 0
            cloned.param_type = subst_type
            cloned.param_type_name = subst_name
            cloned.param_type_name_len = subst_len
            if subst_type == TYPE_ARRAY
                param_take_array_arg(cloned, StrView { ptr: (subst_name), len: (subst_len) as i64 })   # AGAST #2305
            # AGAST #2354: `v: T` at T = `@&U` is the `v: @&U` it says, not a
            # `*U`, so `@x` into it is refused as shared (#2339), as on ritz0.
            let pointee: i32 = ptr_arg_pointee(StrView { ptr: (subst_name), len: (subst_len) as i64 })
            if subst_type == TYPE_PTR and suffix_is_mut_ref(StrView { ptr: (suffix), len: (suffix_len) as i64 }) == 1 and pointee != TYPE_PTR
                cloned.param_type = TYPE_MUT_REF
                cloned.param_pointee_type = pointee
                param_take_ptr_array_arg(cloned, StrView { ptr: (subst_name), len: (subst_len) as i64 })   # AGAST #3101: `@&[N]E`
        else
            # AGAST #2418: a by-value `o: Option<T>` / `r: Result<T, E>` /
            # `p: Pair<T>` is named "Option$T" etc.  It kept that name, so
            # `f<i32>` was defined with a `%Option$T` argument.
            var by_name: *u8 = null
            var by_len: i32 = 0
            substitute_type_param_in_name(StrView { ptr: (cloned.param_type_name), len: (cloned.param_type_name_len) as i64 }, StrView { ptr: (type_param), len: (type_param_len) as i64 }, StrView { ptr: (suffix), len: (suffix_len) as i64 }, @by_name, @by_len)
            cloned.param_type_name = by_name
            cloned.param_type_name_len = by_len

    # Handle pointer/reference-to-struct type name substitution (e.g., *Vec<T> -> *Vec$u8, @&Vec<T> -> @&Vec$u8)
    if (cloned.param_type == TYPE_PTR or cloned.param_type == TYPE_REF or cloned.param_type == TYPE_MUT_REF) and cloned.param_type_name != null
        # Special case: bare *T / @T / @&T — param_type_name is exactly "T".
        # Here param_pointee_type was parsed as TYPE_STRUCT (since T looks like
        # a struct name). Concretize pointee to subst_type (e.g. TYPE_U8) so
        # get_ptr_elem_size yields 1 instead of defaulting struct-unknown=8,
        # and deref loads produce the right bit-width (load i8, not i64).
        if cloned.param_type_name_len == type_param_len
            if memcmp(cloned.param_type_name, type_param, type_param_len as i64) == 0
                # AGAST #2279: `c:& [2]T` names T too, but holds an array, and a
                # by-value `T` slot must not read its first element.  So do
                # `@[2]T` and `@&[2]T` (#2287), and `*[2]T`: `p[i]` means one
                # thing for all three (#2321).
                # AGAST #2378: `a:& [2]*T` names T as what its element points
                # at.  The element stays a pointer: making it a T read `[2]*i16`
                # as `[2]i16`, and refused the param's own array at the call.
                if cloned.param_pointee_type == TYPE_ARRAY and params.param_pointee_array_elem_type == TYPE_PTR
                    cloned.param_pointee_array_elem_pointee = subst_type
                else if cloned.param_pointee_type == TYPE_ARRAY
                    cloned.param_pointee_array_elem_type = subst_type
                else if cloned.param_type != TYPE_PTR and cloned.param_pointee_type == TYPE_PTR
                    # AGAST #2308: `@&*T` is still a reference to a pointer.
                    set_ref_ptr_pointee(cloned, subst_type)
                else
                    cloned.param_pointee_type = subst_type
                    # AGAST #2345: so is `@&T` at T = `*U`.  subst_type only says
                    # TYPE_PTR, so `r:& T` was left as `r:& *<nothing>`: it never
                    # bound as its referent, and `r = v` overwrote its own slot.
                    if subst_type == TYPE_PTR
                        set_ref_ptr_pointee(cloned, ptr_arg_pointee(StrView { ptr: (subst_name), len: (subst_len) as i64 }))
                        # AGAST #3101: and `r:& T` at T = `*[N]E` borrows a
                        # `*[N]E`, bound as #3103 binds a written `r:& *[N]E`.
                        param_take_ptr_array_arg(cloned, StrView { ptr: (subst_name), len: (subst_len) as i64 })
                cloned.param_type_name = subst_name
                cloned.param_type_name_len = subst_len
                # AGAST #2832: a bare `c:& T` / `*T` at T = `[2]f64` points at
                # that array, recorded as a written `c:& [2]f64` is (N, E, E's
                # name).  Not `c:& [2]T`, which held TYPE_ARRAY already.
                var arr: ArrayArg
                if params.param_pointee_type != TYPE_ARRAY and cloned.param_pointee_type == TYPE_ARRAY and array_arg_decode(StrView { ptr: (subst_name), len: (subst_len) as i64 }, @arr) == 1
                    cloned.param_pointee_array_size = arr.size
                    cloned.param_pointee_array_elem_type = arr.elem
                    cloned.param_pointee_array_elem_pointee = arr.pointee
                    cloned.param_pointee_array_shape = null
                    cloned.param_type_name = arr.name
                    cloned.param_type_name_len = arr.name_len
                borrow_take_ptr_ptr_arg(cloned, subst_type, StrView { ptr: (subst_name), len: (subst_len) as i64 })
        else
            var new_name: *u8 = null
            var new_len: i32 = 0
            substitute_type_param_in_name(StrView { ptr: (cloned.param_type_name), len: (cloned.param_type_name_len) as i64 }, StrView { ptr: (type_param), len: (type_param_len) as i64 }, StrView { ptr: (suffix), len: (suffix_len) as i64 }, @new_name, @new_len)
            cloned.param_type_name = new_name
            cloned.param_type_name_len = new_len

    # AGAST #1924: a `**T` param (any depth) records its innermost pointee as
    # TYPE_STRUCT named "T"; concretize it as the `*T` case above does, so
    # `*(*(pp + i) + k)` in pp_get<i32> loads an i32 and strides by 4.
    if cloned.param_type == TYPE_PTR_PTR and ptr_ptr_slot_inner(cloned.param_inner_pointee_type) == TYPE_STRUCT
        if cloned.param_type_name != null and cloned.param_type_name_len == type_param_len and memcmp(cloned.param_type_name, type_param, type_param_len as i64) == 0
            cloned.param_inner_pointee_type = ptr_ptr_slot_subst(cloned.param_inner_pointee_type, subst_type)
            cloned.param_type_name = subst_name
            cloned.param_type_name_len = subst_len

    cloned.next = clone_params_with_suffix(params.next, StrView { ptr: (type_param), len: (type_param_len) as i64 }, subst_type, StrView { ptr: (subst_name), len: (subst_len) as i64 }, StrView { ptr: (suffix), len: (suffix_len) as i64 })
    return cloned

# AGAST #1671: a `fn(T) -> T` type inside a generic body is specialized
# like the enclosing fn's own params and return type, so a call through it
# uses the instantiation's signature (`fn(u8) -> u8`), not `%T`.
fn clone_fn_sig(sig: *FnDef, type_param_sv: StrView, subst_type: i32, subst_name_sv: StrView, suffix_sv: StrView) -> *FnDef
    var type_param: *u8 = type_param_sv.ptr
    var type_param_len: i32 = type_param_sv.len as i32
    var subst_name: *u8 = subst_name_sv.ptr
    var subst_len: i32 = subst_name_sv.len as i32
    var suffix: *u8 = suffix_sv.ptr
    var suffix_len: i32 = suffix_sv.len as i32
    if sig == null
        return null
    let c: *FnDef = malloc(sizeof(FnDef)) as *FnDef
    c.name = sig.name
    c.name_len = sig.name_len
    c.params = clone_params_with_suffix(sig.params, StrView { ptr: (type_param), len: (type_param_len) as i64 }, subst_type, StrView { ptr: (subst_name), len: (subst_len) as i64 }, StrView { ptr: (suffix), len: (suffix_len) as i64 })
    c.return_type = sig.return_type
    c.return_type_name = sig.return_type_name
    c.return_type_name_len = sig.return_type_name_len
    if sig.return_type == TYPE_STRUCT and sig.return_type_name != null
        if sig.return_type_name_len == type_param_len and memcmp(sig.return_type_name, type_param, type_param_len as i64) == 0
            c.return_type = subst_type
            c.return_type_name = subst_name
            c.return_type_name_len = subst_len
        else
            var rn: *u8 = null
            var rl: i32 = 0
            substitute_type_param_in_name(StrView { ptr: (sig.return_type_name), len: (sig.return_type_name_len) as i64 }, StrView { ptr: (type_param), len: (type_param_len) as i64 }, StrView { ptr: (suffix), len: (suffix_len) as i64 }, @rn, @rl)
            c.return_type_name = rn
            c.return_type_name_len = rl
    c.body = null
    c.line = sig.line
    c.next = null
    c.type_params = null
    c.is_local = 0
    c.is_pub = 1   # AGAST #3419: a fn type, not a declaration
    c.col = 0
    c.extern_decl = 0
    c.ret_fn_sig = null   # AGAST #2120: a fn type's own return is not tracked
    c.ret_ref = null
    c.ret_array = null
    c.ret_ptr_array = null
    c.ret_array_param = clone_params_with_suffix(sig.ret_array_param, StrView { ptr: (type_param), len: (type_param_len) as i64 }, subst_type, StrView { ptr: (subst_name), len: (subst_len) as i64 }, StrView { ptr: (suffix), len: (suffix_len) as i64 })   # AGAST #2302
    return c

fn clone_params(params: *Param, type_param_sv: StrView, subst_type: i32, subst_name_sv: StrView) -> *Param
    var type_param: *u8 = type_param_sv.ptr
    var type_param_len: i32 = type_param_sv.len as i32
    var subst_name: *u8 = subst_name_sv.ptr
    var subst_len: i32 = subst_name_sv.len as i32
    # Legacy wrapper - doesn't handle pointer-to-struct substitution
    return clone_params_with_suffix(params, StrView { ptr: (type_param), len: (type_param_len) as i64 }, subst_type, StrView { ptr: (subst_name), len: (subst_len) as i64 }, StrView { ptr: (null), len: (0) as i64 })

fn substitute_type(ty: i32, type_param_sv: StrView, subst_type: i32, subst_name_sv: StrView) -> i32
    var type_param: *u8 = type_param_sv.ptr
    var type_param_len: i32 = type_param_sv.len as i32
    var subst_name: *u8 = subst_name_sv.ptr
    var subst_len: i32 = subst_name_sv.len as i32
    # For simple types, no substitution needed
    if ty != TYPE_STRUCT
        return ty
    # For struct types, we need to check if it's the type param
    # The caller should handle struct name substitution
    return ty

fn mangle_struct_name(name_sv: StrView, suffix_sv: StrView) -> *u8
    var name: *u8 = name_sv.ptr
    var name_len: i32 = name_sv.len as i32
    var suffix: *u8 = suffix_sv.ptr
    var suffix_len: i32 = suffix_sv.len as i32
    # Create mangled name like Vec$u8
    let mangled_len: i32 = name_len + suffix_len
    let mangled: *u8 = malloc(mangled_len as i64 + 1) as *u8
    for i in 0..name_len
        *(mangled + i) = *(name + i)
    for j in 0..suffix_len
        *(mangled + name_len + j) = *(suffix + j)
    *(mangled + mangled_len) = 0
    return mangled

# The module being specialised, so substitute_type_param_in_name can ask
# whether a bare name is a generic struct template (AGAST #1926).  Set by
# specialize_fn_one_param, through which every clone_* path runs.
var g_mono_module: *Module = null

fn names_generic_struct(name_sv: StrView) -> i32
    var name: *u8 = name_sv.ptr
    var name_len: i32 = name_sv.len as i32
    if g_mono_module == null
        return 0
    if find_generic_struct(g_mono_module, StrView { ptr: (name), len: (name_len) as i64 }) == null
        return 0
    1

# Substitute type parameter in a mangled name like "Vec$T" -> "Vec$u8"
# Input: name = "Vec$T", type_param = "T", new_suffix = "$u8"
# Output: "Vec$u8"
pub fn substitute_type_param_in_name(name_sv: StrView, type_param_sv: StrView, new_suffix_sv: StrView, out_name: **u8, out_len: *i32)
    var name: *u8 = name_sv.ptr
    var name_len: i32 = name_sv.len as i32
    var type_param: *u8 = type_param_sv.ptr
    var type_param_len: i32 = type_param_sv.len as i32
    var new_suffix: *u8 = new_suffix_sv.ptr
    var new_suffix_len: i32 = new_suffix_sv.len as i32
    # AGAST #2975: `tuple_T_T` at T = i32 is `tuple_i32_i32`.
    var tl: i32 = 0
    let tn: *u8 = tuple_subst(StrView { ptr: (name), len: (name_len) as i64 }, StrView { ptr: (type_param), len: (type_param_len) as i64 }, StrView { ptr: (new_suffix), len: (new_suffix_len) as i64 }, @tl)
    if tn != null
        *out_name = tn
        *out_len = tl
        return
    # AGAST #1612: multi-parameter passes rewrite whole components, anywhere
    # in the name, and never append (see g_mono_component_mode).
    if g_mono_component_mode != 0
        *out_name = replace_param_component(StrView { ptr: (name), len: (name_len) as i64 }, StrView { ptr: (type_param), len: (type_param_len) as i64 }, StrView { ptr: (new_suffix), len: (new_suffix_len) as i64 }, out_len)
        return
    # Check if name ends with "$T" where T is the type param
    # Expected pattern: "Base$T" where Base is some prefix
    # AGAST #1582: only a one-argument name ("Vec$T") takes this shortcut.
    # `Pair$T$T` has T in more than one component; rewriting the tail alone
    # gave `Pair$T$i64`, so a multi-argument name goes to the #2418 rewrite
    # below, which substitutes every component.
    let expected_suffix_len: i32 = type_param_len + 1  # "$" + type_param
    if name_len > expected_suffix_len and find_dollar_sign(StrView { ptr: (name), len: (name_len - expected_suffix_len) as i64 }) < 0
        let suffix_start: i32 = name_len - expected_suffix_len
        # Check for '$' separator
        if *(name + suffix_start) == '$'  # '$'
            # Check if rest matches type param
            var matches: i32 = 1
            for i in 0..type_param_len
                if *(name + suffix_start + 1 + i) != *(type_param + i)
                    matches = 0
                    break
            if matches != 0
                # Replace "$T" with new_suffix
                let base_len: i32 = suffix_start  # "Vec" part
                let new_len: i32 = base_len + new_suffix_len
                let result: *u8 = malloc(new_len as i64 + 1) as *u8
                # Copy base part
                for j in 0..base_len
                    *(result + j) = *(name + j)
                # Copy new suffix
                for k in 0..new_suffix_len
                    *(result + base_len + k) = *(new_suffix + k)
                *(result + new_len) = 0
                *out_name = result
                *out_len = new_len
                return

    # AGAST #2418: T as an inner component, `Result$T$i32` at T = i32 is
    # `Result$i32$i32` (one-parameter fn over `Result<T, i32>`).
    if new_suffix_len > 0 and find_dollar_sign(StrView { ptr: (name), len: (name_len) as i64 }) >= 0
        var hit_len: i32 = name_len
        let hit: *u8 = replace_param_component(StrView { ptr: (name), len: (name_len) as i64 }, StrView { ptr: (type_param), len: (type_param_len) as i64 }, StrView { ptr: (new_suffix), len: (new_suffix_len) as i64 }, @hit_len)
        if hit != name
            *out_name = hit
            *out_len = hit_len
            return

    # If the name doesn't have $T pattern, it might be a bare struct name like "Vec"
    # that needs the suffix appended (for @&Vec<T> parameters).  Only a generic
    # struct TEMPLATE gets it: a plain struct (`p: *Cell`, `var c: Cell`,
    # `Cell { .. }`) keeps its name, else `Cell` -> `Cell$i64`, which does not
    # exist (AGAST #1926).
    if new_suffix_len > 0 and names_generic_struct(StrView { ptr: (name), len: (name_len) as i64 }) != 0
        # Append the new suffix (e.g., "Vec" + "$u8" = "Vec$u8")
        let new_len: i32 = name_len + new_suffix_len
        let result: *u8 = malloc(new_len as i64 + 1) as *u8
        for i in 0..name_len
            *(result + i) = *(name + i)
        for k in 0..new_suffix_len
            *(result + name_len + k) = *(new_suffix + k)
        *(result + new_len) = 0
        *out_name = result
        *out_len = new_len
    else
        # No substitution needed - just copy the name
        let copy: *u8 = malloc(name_len as i64 + 1) as *u8
        for i in 0..name_len
            *(copy + i) = *(name + i)
        *(copy + name_len) = 0
        *out_name = copy
        *out_len = name_len

fn clone_body(body: *Stmt, type_param_sv: StrView, subst_type: i32, subst_name_sv: StrView, suffix_sv: StrView) -> *Stmt
    var type_param: *u8 = type_param_sv.ptr
    var type_param_len: i32 = type_param_sv.len as i32
    var subst_name: *u8 = subst_name_sv.ptr
    var subst_len: i32 = subst_name_sv.len as i32
    var suffix: *u8 = suffix_sv.ptr
    var suffix_len: i32 = suffix_sv.len as i32
    if body == null
        return null

    let cloned: *Stmt = clone_stmt(body, StrView { ptr: (type_param), len: (type_param_len) as i64 }, subst_type, StrView { ptr: (subst_name), len: (subst_len) as i64 }, StrView { ptr: (suffix), len: (suffix_len) as i64 })

    # Clone the rest of the statement list
    if body.next != null
        cloned.next = clone_body(body.next, StrView { ptr: (type_param), len: (type_param_len) as i64 }, subst_type, StrView { ptr: (subst_name), len: (subst_len) as i64 }, StrView { ptr: (suffix), len: (suffix_len) as i64 })

    return cloned

# AGAST #1925: a clone starts as a byte copy of its template, and each case
# below then replaces the child Expr / Stmt pointers with deep clones.  Before
# this, a clone copied only the fields its case listed, and malloc does not
# zero memory.  A kind with no case (STMT_INDEX_ASSIGN, EXPR_ARRAY_LIT, ...)
# kept its kind but had uninitialised fields, so `a[0] = v` and
# `let a: [2]i64 = [7, 9]` emitted nothing in a generic fn's instantiation.
# Scalars (names, kinds, a cast's pointee) are now always carried over.  A
# kind that has no case still fails loudly (clone_unknown_kind), so a new kind
# can't share the template's child pointers without anyone noticing.
fn clone_unknown_kind(what: *u8, kind: i32)
    eprints_cstr(c"error: ritz1 monomorph: ")
    eprints_cstr(what)
    eprints_cstr(c" has no case for kind ")
    eprint_int(kind as i64)
    eprints_cstr(c"\n")
    sys_exit(1)

# AGAST #3662: `let p: *T` at T = `*U` (any depth) is the `**U` local it says,
# recorded as a written one is: TYPE_PTR_PTR, pointee TYPE_PTR, U's
# depth-packed inner slot and U's name (none for a primitive).  It was a `*`
# with a TYPE_PTR pointee, so ref_check refused `return *p` ("a value doesn't
# fit a reference slot") and `*p = v` stored a U-wide part of the pointer.
# `name` is T less its first `ptr_`, as borrow_take_ptr_ptr_arg reads it.
# 1 when it retyped the local.  `@T` / `@&T` locals bind through var_ref
# (#2308) and stay as they are.
fn ptr_local_take_ptr_arg(s: *Stmt, cloned: *Stmt, subst_type: i32, name_sv: StrView) -> i32
    var name: *u8 = name_sv.ptr
    var len: i32 = name_sv.len as i32
    if s.var_type != TYPE_PTR or subst_type != TYPE_PTR
        return 0
    var rest: *u8 = name
    var rest_len: i32 = len
    var extra: i32 = 0
    while rest_len > 4 and memcmp(rest, c"ptr_", 4) == 0
        rest = rest + 4
        rest_len = rest_len - 4
        extra = extra + 1
    let inner: i32 = ptr_arg_pointee(StrView { ptr: (rest), len: (rest_len) as i64 })
    if inner == TYPE_ARRAY
        return 0
    cloned.var_type = TYPE_PTR_PTR
    cloned.var_declared_type = TYPE_PTR_PTR
    cloned.var_pointee_type = TYPE_PTR
    cloned.var_inner_pointee_type = inner + extra * PTR_DEPTH_UNIT
    cloned.var_type_name = rest
    cloned.var_type_name_len = rest_len
    if inner != TYPE_STRUCT
        cloned.var_type_name = null
        cloned.var_type_name_len = 0
    return 1

# AGAST #1551: a pointer/reference local's pointee at T = the argument.  A
# bare `*T` (pointee parsed as struct "T") points at the argument type
# itself; `*Vec<T>` keeps its pointee and has T substituted in its name.
fn clone_ptr_local_type(s: *Stmt, cloned: *Stmt, type_param_sv: StrView, subst_type: i32, subst_name_sv: StrView, suffix_sv: StrView)
    var type_param: *u8 = type_param_sv.ptr
    var type_param_len: i32 = type_param_sv.len as i32
    var subst_name: *u8 = subst_name_sv.ptr
    var subst_len: i32 = subst_name_sv.len as i32
    var suffix: *u8 = suffix_sv.ptr
    var suffix_len: i32 = suffix_sv.len as i32
    if s.var_type_name_len == type_param_len and memcmp(s.var_type_name, type_param, type_param_len as i64) == 0
        # `*[N]T` and other non-struct pointees naming T are not this path
        # (AGAST #3663).
        if s.var_pointee_type != TYPE_STRUCT
            cloned.var_type_name = s.var_type_name
            cloned.var_type_name_len = s.var_type_name_len
            return
        if ptr_local_take_ptr_arg(s, cloned, subst_type, StrView { ptr: (subst_name), len: (subst_len) as i64 }) == 1
            return
        cloned.var_pointee_type = subst_type
        cloned.var_type_name = subst_name
        cloned.var_type_name_len = subst_len
        # A written `*u8` carries no name: a named pointer local is taken to
        # point at a struct, and `*p` was typed i64 while it loaded an i8.
        if subst_type < TYPE_STRUCT and subst_type != TYPE_PTR and subst_type != TYPE_PTR_PTR
            cloned.var_type_name = null
            cloned.var_type_name_len = 0
        # `*T` at T = `[N]E` points at that array, as a param does (#2832).
        var arr: ArrayArg
        if subst_type == TYPE_ARRAY and array_arg_decode(StrView { ptr: (subst_name), len: (subst_len) as i64 }, @arr) == 1
            cloned.var_pointee_array_size = arr.size
            cloned.var_pointee_array_elem_type = arr.elem
            cloned.var_pointee_array_elem_pointee = arr.pointee
            cloned.var_type_name = arr.name
            cloned.var_type_name_len = arr.name_len
        return
    var new_name: *u8 = null
    var new_len: i32 = 0
    substitute_type_param_in_name(StrView { ptr: (s.var_type_name), len: (s.var_type_name_len) as i64 }, StrView { ptr: (type_param), len: (type_param_len) as i64 }, StrView { ptr: (suffix), len: (suffix_len) as i64 }, @new_name, @new_len)
    cloned.var_type_name = new_name
    cloned.var_type_name_len = new_len

# AGAST #3663: a `*[N]T` local's element is the argument type, as a `*[N]T`
# param's is (#2321), and `*[N]*T`'s element points at it (#2378).  The local
# named no T (its type name is null), so the element stayed a struct "T" and
# `p[1]` was refused as "a whole struct element".
fn clone_ptr_array_local_elem(s: *Stmt, cloned: *Stmt, type_param_sv: StrView, subst_type: i32, subst_name_sv: StrView)
    var type_param: *u8 = type_param_sv.ptr
    var type_param_len: i32 = type_param_sv.len as i32
    var subst_name: *u8 = subst_name_sv.ptr
    var subst_len: i32 = subst_name_sv.len as i32
    if s.var_type != TYPE_PTR or s.var_pointee_type != TYPE_ARRAY
        return
    if s.var_pointee_array_elem_name_len != type_param_len or memcmp(s.var_pointee_array_elem_name, type_param, type_param_len as i64) != 0
        return
    if s.var_pointee_array_elem_type == TYPE_PTR
        cloned.var_pointee_array_elem_pointee = subst_type
    else
        cloned.var_pointee_array_elem_type = subst_type
    cloned.var_pointee_array_elem_name = subst_name
    cloned.var_pointee_array_elem_name_len = subst_len

fn clone_stmt(s: *Stmt, type_param_sv: StrView, subst_type: i32, subst_name_sv: StrView, suffix_sv: StrView) -> *Stmt
    var type_param: *u8 = type_param_sv.ptr
    var type_param_len: i32 = type_param_sv.len as i32
    var subst_name: *u8 = subst_name_sv.ptr
    var subst_len: i32 = subst_name_sv.len as i32
    var suffix: *u8 = suffix_sv.ptr
    var suffix_len: i32 = suffix_sv.len as i32
    let cloned: *Stmt = malloc(sizeof(Stmt)) as *Stmt
    memcpy(cloned as *u8, s as *u8, sizeof(Stmt))  # AGAST #1925
    cloned.next = null

    let k: i32 = s.kind
    # A store keeps the template's sharing (AGAST #2529, clone_memo_find).
    let memo_was: i32 = g_clone_memo_on
    let memo_base: i32 = g_clone_memo_count
    if is_store_stmt(k) == 1
        g_clone_memo_on = 1
    if k == STMT_EXPR
        cloned.expr = clone_expr(s.expr, StrView { ptr: (type_param), len: (type_param_len) as i64 }, subst_type, StrView { ptr: (subst_name), len: (subst_len) as i64 }, StrView { ptr: (suffix), len: (suffix_len) as i64 })
    else if k == STMT_RETURN
        if s.return_value != null
            cloned.return_value = clone_expr(s.return_value, StrView { ptr: (type_param), len: (type_param_len) as i64 }, subst_type, StrView { ptr: (subst_name), len: (subst_len) as i64 }, StrView { ptr: (suffix), len: (suffix_len) as i64 })
        else
            cloned.return_value = null
    else if k == STMT_VAR_DECL
        cloned.var_name = s.var_name
        cloned.var_name_len = s.var_name_len
        cloned.var_type = s.var_type
        cloned.var_declared_type = s.var_declared_type  # AGAST #1364
        cloned.var_src_file = s.var_src_file
        cloned.var_array_size = s.var_array_size
        cloned.var_array_elem_type = s.var_array_elem_type
        cloned.var_pointee_type = s.var_pointee_type
        cloned.var_inner_pointee_type = s.var_inner_pointee_type  # AGAST #1815
        # AGAST #1924: `let pp: **T` concretizes T like a `**T` param.
        var pp_local_subst: i32 = 0
        if s.var_type == TYPE_PTR_PTR and ptr_ptr_slot_inner(s.var_inner_pointee_type) == TYPE_STRUCT
            if s.var_type_name != null and s.var_type_name_len == type_param_len and memcmp(s.var_type_name, type_param, type_param_len as i64) == 0
                cloned.var_inner_pointee_type = ptr_ptr_slot_subst(s.var_inner_pointee_type, subst_type)
                pp_local_subst = 1
        cloned.var_fn_sig = clone_fn_sig(s.var_fn_sig, StrView { ptr: (type_param), len: (type_param_len) as i64 }, subst_type, StrView { ptr: (subst_name), len: (subst_len) as i64 }, StrView { ptr: (suffix), len: (suffix_len) as i64 })  # AGAST #1671
        # Substitute type param in variable type name (e.g., Vec<T> -> Vec$u8)
        if s.var_type == TYPE_STRUCT and s.var_type_name != null and s.var_type_name_len == type_param_len and memcmp(s.var_type_name, type_param, type_param_len as i64) == 0
            # A bare `T` local (`let item: T`, vec_slice<T>) becomes the
            # argument type itself, as clone_params_with_suffix does for a
            # bare `T` param.  The name path below would append the suffix
            # and declare the struct `%T$i32` (AGAST #1794).
            cloned.var_type = subst_type
            cloned.var_declared_type = subst_type
            cloned.var_type_name = subst_name
            cloned.var_type_name_len = subst_len
            # AGAST #2305: `var x: T` at T = `[N]E` is the `[N]E` local.
            var vaa: ArrayArg
            if subst_type == TYPE_ARRAY and array_arg_decode(StrView { ptr: (subst_name), len: (subst_len) as i64 }, @vaa) == 1
                cloned.var_array_size = vaa.size
                cloned.var_array_elem_type = vaa.elem
                cloned.var_array_elem_pointee = vaa.pointee
                cloned.var_array_shape = vaa.shape   # AGAST #3634
                cloned.var_type_name = vaa.name
                cloned.var_type_name_len = vaa.name_len
        else if s.var_type == TYPE_STRUCT and s.var_type_name != null
            var new_name_ptr: *u8 = null
            var new_name_len: i32 = 0
            substitute_type_param_in_name(StrView { ptr: (s.var_type_name), len: (s.var_type_name_len) as i64 }, StrView { ptr: (type_param), len: (type_param_len) as i64 }, StrView { ptr: (suffix), len: (suffix_len) as i64 }, @new_name_ptr, @new_name_len)
            cloned.var_type_name = new_name_ptr
            cloned.var_type_name_len = new_name_len
        else if pp_local_subst == 1
            cloned.var_type_name = subst_name
            cloned.var_type_name_len = subst_len
        else if (s.var_type == TYPE_PTR or s.var_type == TYPE_REF or s.var_type == TYPE_MUT_REF) and s.var_type_name != null
            # AGAST #1551: `let p: *T` / `*Vec<T>` concretizes T as the same
            # param does (clone_params_with_suffix).  It kept the name "T" and
            # a TYPE_STRUCT pointee, a struct that does not exist, so `p + 1`
            # had no element size and was refused.
            clone_ptr_local_type(s, cloned, StrView { ptr: (type_param), len: (type_param_len) as i64 }, subst_type, StrView { ptr: (subst_name), len: (subst_len) as i64 }, StrView { ptr: (suffix), len: (suffix_len) as i64 })
        else
            cloned.var_type_name = s.var_type_name
            cloned.var_type_name_len = s.var_type_name_len
        clone_ptr_array_local_elem(s, cloned, StrView { ptr: (type_param), len: (type_param_len) as i64 }, subst_type, StrView { ptr: (subst_name), len: (subst_len) as i64 })
        # AGAST #2996: `var a: [N]T` at T = the argument, as a `[N]T` param is.
        # It kept `[N x %T]`, a placeholder struct, so `a[i]` loaded a `%T`.
        if s.var_type == TYPE_ARRAY and s.var_array_elem_type == TYPE_STRUCT and s.var_type_name != null and s.var_type_name_len == type_param_len and memcmp(s.var_type_name, type_param, type_param_len as i64) == 0
            cloned.var_array_elem_type = subst_type
            cloned.var_type_name = subst_name
            cloned.var_type_name_len = subst_len
        # AGAST #2332: `var a: [N]*T` at T = the argument.
        if s.var_array_elem_pointee == TYPE_STRUCT and s.var_type_name != null and s.var_type_name_len == type_param_len and memcmp(s.var_type_name, type_param, type_param_len as i64) == 0
            cloned.var_array_elem_pointee = subst_type
            cloned.var_type_name = subst_name
            cloned.var_type_name_len = subst_len
        # AGAST #3120: `var a: [2][3]T` / `[2][3]P<T>` at T = the argument.  The
        # leaf lives only in the shape; kept as `T` / `P$T`, P$i64 was never
        # instantiated and `a[1][2].v` was "unhandled EXPR_MEMBER".
        # AGAST #3634: a bare `var x: T` at T = `[N][M]E` took its shape above.
        if s.var_array_shape != null
            let bare_sh: *ArrayShape = array_shape_subst(s.var_array_shape, StrView { ptr: (type_param), len: (type_param_len) as i64 }, subst_type, StrView { ptr: (subst_name), len: (subst_len) as i64 })
            cloned.var_array_shape = array_shape_mangled_subst(bare_sh, StrView { ptr: (type_param), len: (type_param_len) as i64 }, StrView { ptr: (suffix), len: (suffix_len) as i64 })
        # AGAST #2308: `let p: @&T` concretizes T as a `@&T` param does.
        cloned.var_ref = clone_params_with_suffix(s.var_ref, StrView { ptr: (type_param), len: (type_param_len) as i64 }, subst_type, StrView { ptr: (subst_name), len: (subst_len) as i64 }, StrView { ptr: (suffix), len: (suffix_len) as i64 })
        if cloned.var_ref != null
            stmt_take_var_ref(cloned)
        if s.var_init != null
            cloned.var_init = clone_expr(s.var_init, StrView { ptr: (type_param), len: (type_param_len) as i64 }, subst_type, StrView { ptr: (subst_name), len: (subst_len) as i64 }, StrView { ptr: (suffix), len: (suffix_len) as i64 })
        else
            cloned.var_init = null
    else if k == STMT_ASSIGN
        cloned.assign_target = s.assign_target
        cloned.assign_target_len = s.assign_target_len
        cloned.assign_value = clone_expr(s.assign_value, StrView { ptr: (type_param), len: (type_param_len) as i64 }, subst_type, StrView { ptr: (subst_name), len: (subst_len) as i64 }, StrView { ptr: (suffix), len: (suffix_len) as i64 })
        # When assign_target_len == 0, target expression is stored in if_cond
        if s.assign_target_len == 0
            cloned.if_cond = clone_expr(s.if_cond as *Expr, StrView { ptr: (type_param), len: (type_param_len) as i64 }, subst_type, StrView { ptr: (subst_name), len: (subst_len) as i64 }, StrView { ptr: (suffix), len: (suffix_len) as i64 })
    else if k == STMT_IF
        cloned.if_cond = clone_expr(s.if_cond, StrView { ptr: (type_param), len: (type_param_len) as i64 }, subst_type, StrView { ptr: (subst_name), len: (subst_len) as i64 }, StrView { ptr: (suffix), len: (suffix_len) as i64 })
        cloned.if_then = clone_body(s.if_then, StrView { ptr: (type_param), len: (type_param_len) as i64 }, subst_type, StrView { ptr: (subst_name), len: (subst_len) as i64 }, StrView { ptr: (suffix), len: (suffix_len) as i64 })
        if s.if_else != null
            cloned.if_else = clone_body(s.if_else, StrView { ptr: (type_param), len: (type_param_len) as i64 }, subst_type, StrView { ptr: (subst_name), len: (subst_len) as i64 }, StrView { ptr: (suffix), len: (suffix_len) as i64 })
        else
            cloned.if_else = null
    else if k == STMT_WHILE
        cloned.while_cond = clone_expr(s.while_cond, StrView { ptr: (type_param), len: (type_param_len) as i64 }, subst_type, StrView { ptr: (subst_name), len: (subst_len) as i64 }, StrView { ptr: (suffix), len: (suffix_len) as i64 })
        cloned.while_body = clone_body(s.while_body, StrView { ptr: (type_param), len: (type_param_len) as i64 }, subst_type, StrView { ptr: (subst_name), len: (subst_len) as i64 }, StrView { ptr: (suffix), len: (suffix_len) as i64 })
    else if k == STMT_FOR
        cloned.for_var = s.for_var
        cloned.for_var_len = s.for_var_len
        cloned.for_inclusive = s.for_inclusive
        cloned.for_start = clone_expr(s.for_start, StrView { ptr: (type_param), len: (type_param_len) as i64 }, subst_type, StrView { ptr: (subst_name), len: (subst_len) as i64 }, StrView { ptr: (suffix), len: (suffix_len) as i64 })
        cloned.for_end = clone_expr(s.for_end, StrView { ptr: (type_param), len: (type_param_len) as i64 }, subst_type, StrView { ptr: (subst_name), len: (subst_len) as i64 }, StrView { ptr: (suffix), len: (suffix_len) as i64 })
        cloned.for_body = clone_body(s.for_body, StrView { ptr: (type_param), len: (type_param_len) as i64 }, subst_type, StrView { ptr: (subst_name), len: (subst_len) as i64 }, StrView { ptr: (suffix), len: (suffix_len) as i64 })
    else if k == STMT_LOOP or k == STMT_DEFER or k == STMT_UNSAFE
        # Infinite loop — body stored in while_body (same slot as STMT_WHILE);
        # a `defer`'s too (AGAST #1625; the byte copy carries defer_is_block).
        cloned.while_body = clone_body(s.while_body, StrView { ptr: (type_param), len: (type_param_len) as i64 }, subst_type, StrView { ptr: (subst_name), len: (subst_len) as i64 }, StrView { ptr: (suffix), len: (suffix_len) as i64 })
    else if k == STMT_BREAK or k == STMT_CONTINUE or k == STMT_STRIPPED or k == STMT_ASM
        # No child nodes to clone.  An asm block is never changed once built
        # (AGAST #3394): the byte copy shares it.
        pass
    else if k == STMT_INDEX_ASSIGN
        # name[idx] = value; the index is stored in while_cond (AGAST #1925)
        cloned.while_cond = clone_expr(s.while_cond, StrView { ptr: (type_param), len: (type_param_len) as i64 }, subst_type, StrView { ptr: (subst_name), len: (subst_len) as i64 }, StrView { ptr: (suffix), len: (suffix_len) as i64 })
        cloned.assign_value = clone_expr(s.assign_value, StrView { ptr: (type_param), len: (type_param_len) as i64 }, subst_type, StrView { ptr: (subst_name), len: (subst_len) as i64 }, StrView { ptr: (suffix), len: (suffix_len) as i64 })
    else if k == STMT_MEMBER_ASSIGN
        # ptr.field = value; the pointer expression is in if_cond (AGAST #1925)
        cloned.if_cond = clone_expr(s.if_cond, StrView { ptr: (type_param), len: (type_param_len) as i64 }, subst_type, StrView { ptr: (subst_name), len: (subst_len) as i64 }, StrView { ptr: (suffix), len: (suffix_len) as i64 })
        cloned.assign_value = clone_expr(s.assign_value, StrView { ptr: (type_param), len: (type_param_len) as i64 }, subst_type, StrView { ptr: (subst_name), len: (subst_len) as i64 }, StrView { ptr: (suffix), len: (suffix_len) as i64 })
    else if k == STMT_MEMBER_INDEX_ASSIGN
        # ptr.field[idx] = value: pointer in if_cond, index in while_cond (AGAST #1925)
        cloned.if_cond = clone_expr(s.if_cond, StrView { ptr: (type_param), len: (type_param_len) as i64 }, subst_type, StrView { ptr: (subst_name), len: (subst_len) as i64 }, StrView { ptr: (suffix), len: (suffix_len) as i64 })
        cloned.while_cond = clone_expr(s.while_cond, StrView { ptr: (type_param), len: (type_param_len) as i64 }, subst_type, StrView { ptr: (subst_name), len: (subst_len) as i64 }, StrView { ptr: (suffix), len: (suffix_len) as i64 })
        cloned.assign_value = clone_expr(s.assign_value, StrView { ptr: (type_param), len: (type_param_len) as i64 }, subst_type, StrView { ptr: (subst_name), len: (subst_len) as i64 }, StrView { ptr: (suffix), len: (suffix_len) as i64 })
    else if k == STMT_ASSERT
        # The condition is in if_cond (AGAST #1925)
        cloned.if_cond = clone_expr(s.if_cond, StrView { ptr: (type_param), len: (type_param_len) as i64 }, subst_type, StrView { ptr: (subst_name), len: (subst_len) as i64 }, StrView { ptr: (suffix), len: (suffix_len) as i64 })
    else if k == STMT_TUPLE_DECL
        # let (a, b) = init; both names are carried over by the byte copy (AGAST #1925)
        cloned.var_init = clone_expr(s.var_init, StrView { ptr: (type_param), len: (type_param_len) as i64 }, subst_type, StrView { ptr: (subst_name), len: (subst_len) as i64 }, StrView { ptr: (suffix), len: (suffix_len) as i64 })
    else if k == STMT_LOCAL_FIELD_ASSIGN
        # v.field = value
        cloned.var_name = s.var_name
        cloned.var_name_len = s.var_name_len
        cloned.assign_target = s.assign_target
        cloned.assign_target_len = s.assign_target_len
        cloned.assign_value = clone_expr(s.assign_value, StrView { ptr: (type_param), len: (type_param_len) as i64 }, subst_type, StrView { ptr: (subst_name), len: (subst_len) as i64 }, StrView { ptr: (suffix), len: (suffix_len) as i64 })
    else if k == STMT_LOCAL_FIELD_INDEX_ASSIGN
        # v.field[idx] = value
        cloned.var_name = s.var_name
        cloned.var_name_len = s.var_name_len
        cloned.assign_target = s.assign_target
        cloned.assign_target_len = s.assign_target_len
        # Index expression is stored in while_cond (reused field)
        cloned.while_cond = clone_expr(s.while_cond, StrView { ptr: (type_param), len: (type_param_len) as i64 }, subst_type, StrView { ptr: (subst_name), len: (subst_len) as i64 }, StrView { ptr: (suffix), len: (suffix_len) as i64 })
        cloned.assign_value = clone_expr(s.assign_value, StrView { ptr: (type_param), len: (type_param_len) as i64 }, subst_type, StrView { ptr: (subst_name), len: (subst_len) as i64 }, StrView { ptr: (suffix), len: (suffix_len) as i64 })
    else if k == STMT_MATCH
        # AGAST #186: match-stmt cloning was missing — uninitialised cloned
        # struct caused emit_match to dereference a null scrutinee.  STMT_MATCH
        # stores scrutinee in if_cond, arms in if_then (recast as *MatchArm).
        cloned.if_cond = clone_expr(s.if_cond, StrView { ptr: (type_param), len: (type_param_len) as i64 }, subst_type, StrView { ptr: (subst_name), len: (subst_len) as i64 }, StrView { ptr: (suffix), len: (suffix_len) as i64 })
        cloned.if_then = clone_match_arms(s.if_then as *MatchArm, StrView { ptr: (type_param), len: (type_param_len) as i64 }, subst_type, StrView { ptr: (subst_name), len: (subst_len) as i64 }, StrView { ptr: (suffix), len: (suffix_len) as i64 }) as *Stmt
        cloned.if_else = null
    else
        clone_unknown_kind(c"clone_stmt", k)

    g_clone_memo_on = memo_was
    g_clone_memo_count = memo_base
    # A specialised body isn't walked by collect_from_stmt: note its calls here.
    if is_store_stmt(k) == 1
        note_compound_calls(cloned)
    return cloned

# `sizeof(T)` with T := subst (AGAST #2124): one value of the concrete kind,
# keeping `at`'s span and element count (1 for a bare `T`).
fn sizeof_subst_operand(at: *Expr, subst_type: i32, subst_name_sv: StrView) -> *Expr
    var subst_name: *u8 = subst_name_sv.ptr
    var subst_len: i32 = subst_name_sv.len as i32
    let op: *Expr = malloc(sizeof(Expr)) as *Expr
    memcpy(op as *u8, at as *u8, sizeof(Expr))
    if at.kind != EXPR_TYPE_OPERAND
        op.int_val = 1
    op.kind = EXPR_TYPE_OPERAND
    op.op = subst_type
    op.ident_ptr = null
    op.ident_len = 0
    # An unparsed suffix (TYPE_VOID) keeps its spelling: the emitter sizes a
    # TYPE_STRUCT leaf named `i32` as the primitive, and rejects a non-type.
    if subst_type == TYPE_VOID
        op.op = TYPE_STRUCT
    # AGAST #2832: T = `[N]E` is N values of E, as sizeof_array_type_call
    # records a written `sizeof([N]E)`.
    var leaf_name: *u8 = subst_name
    var leaf_len: i32 = subst_len
    var a: ArrayArg
    if subst_type == TYPE_ARRAY and array_arg_decode(StrView { ptr: (subst_name), len: (subst_len) as i64 }, @a) == 1
        op.op = a.elem
        leaf_name = a.name
        leaf_len = a.name_len
        var count: i32 = a.size
        if a.shape != null
            # AGAST #3634: `[N][M]E` is N*M values of its leaf E.
            count = shape_leaf_count(a.shape)
            op.op = a.shape.leaf_type
            leaf_name = a.shape.leaf_name
            leaf_len = a.shape.leaf_name_len
        op.int_val = op.int_val * count as i64
    if op.op == TYPE_STRUCT
        op.ident_ptr = leaf_name
        op.ident_len = leaf_len
    op.next = null
    return op

# AGAST #2529: a node one statement of the template shares stays shared in its
# clone.  `x op= v`'s read and store share x's operands (ast_helpers.ritz
# stmt_compound_assign_*), and note_compound_calls finds a call to evaluate
# once by that sharing: clone each such node once per statement.
var g_clone_memo_from: **Expr = null
var g_clone_memo_to: **Expr = null
var g_clone_memo_count: i32 = 0
var g_clone_memo_cap: i32 = 0
var g_clone_memo_on: i32 = 0

fn clone_memo_find(e: *Expr) -> *Expr
    var i: i32 = 0
    while i < g_clone_memo_count
        if *(g_clone_memo_from + i) == e
            return *(g_clone_memo_to + i)
        i += 1
    return null

fn clone_memo_add(e: *Expr, c: *Expr)
    if g_clone_memo_count == g_clone_memo_cap
        var cap: i32 = 64
        if g_clone_memo_cap > 0
            cap = g_clone_memo_cap * 2
        let from: **Expr = malloc((cap as i64) * 8) as **Expr
        let to: **Expr = malloc((cap as i64) * 8) as **Expr
        var i: i32 = 0
        while i < g_clone_memo_count
            *(from + i) = *(g_clone_memo_from + i)
            *(to + i) = *(g_clone_memo_to + i)
            i += 1
        g_clone_memo_from = from
        g_clone_memo_to = to
        g_clone_memo_cap = cap
    *(g_clone_memo_from + g_clone_memo_count) = e
    *(g_clone_memo_to + g_clone_memo_count) = c
    g_clone_memo_count += 1

# The store forms `x op= v` desugars into (note_compound_calls).
fn is_store_stmt(k: i32) -> i32
    if k == STMT_ASSIGN or k == STMT_INDEX_ASSIGN or k == STMT_MEMBER_ASSIGN
        return 1
    if k == STMT_MEMBER_INDEX_ASSIGN or k == STMT_LOCAL_FIELD_INDEX_ASSIGN
        return 1
    return 0

fn clone_expr(e: *Expr, type_param_sv: StrView, subst_type: i32, subst_name_sv: StrView, suffix_sv: StrView) -> *Expr
    var type_param: *u8 = type_param_sv.ptr
    var type_param_len: i32 = type_param_sv.len as i32
    var subst_name: *u8 = subst_name_sv.ptr
    var subst_len: i32 = subst_name_sv.len as i32
    var suffix: *u8 = suffix_sv.ptr
    var suffix_len: i32 = suffix_sv.len as i32
    if e == null
        return null
    if g_clone_memo_on == 1
        let seen: *Expr = clone_memo_find(e)
        if seen != null
            return seen

    let cloned: *Expr = malloc(sizeof(Expr)) as *Expr
    memcpy(cloned as *u8, e as *u8, sizeof(Expr))  # AGAST #1925; see clone_stmt
    cloned.next = null
    if g_clone_memo_on == 1
        clone_memo_add(e, cloned)

    let k: i32 = e.kind

    if k == EXPR_INT_LIT
        cloned.int_val = e.int_val
    else if k == EXPR_CHAR_LIT
        cloned.int_val = e.int_val  # Char uses int_val field
    else if k == EXPR_STRING_LIT or k == EXPR_CSTRING_LIT
        cloned.string_ptr = e.string_ptr
        cloned.string_len = e.string_len
        # The raw token text print interpolation reads (AGAST #1521).
        cloned.ident_ptr = e.ident_ptr
        cloned.ident_len = e.ident_len
    else if k == EXPR_IDENT
        cloned.ident_ptr = e.ident_ptr
        cloned.ident_len = e.ident_len
    else if k == EXPR_TYPE_OPERAND
        # `sizeof([4]T)` (AGAST #2124): the leaf may be the type parameter.
        if e.op == TYPE_STRUCT and e.ident_len == type_param_len and memcmp(e.ident_ptr, type_param, type_param_len as i64) == 0
            let leaf: *Expr = sizeof_subst_operand(e, subst_type, StrView { ptr: (subst_name), len: (subst_len) as i64 })
            cloned.op = leaf.op
            cloned.ident_ptr = leaf.ident_ptr
            cloned.ident_len = leaf.ident_len
        else if e.op == TYPE_STRUCT and e.ident_ptr != null
            # `sizeof(Box<T>)` (AGAST #3268): "Box$T" becomes "Box$i32", as a
            # struct literal's mangled name does.
            var new_name_ptr: *u8 = null
            var new_name_len: i32 = 0
            substitute_type_param_in_name(StrView { ptr: (e.ident_ptr), len: (e.ident_len) as i64 }, StrView { ptr: (type_param), len: (type_param_len) as i64 }, StrView { ptr: (suffix), len: (suffix_len) as i64 }, @new_name_ptr, @new_name_len)
            cloned.ident_ptr = new_name_ptr
            cloned.ident_len = new_name_len
    else if k == EXPR_BINARY
        cloned.op = e.op
        cloned.left = clone_expr(e.left, StrView { ptr: (type_param), len: (type_param_len) as i64 }, subst_type, StrView { ptr: (subst_name), len: (subst_len) as i64 }, StrView { ptr: (suffix), len: (suffix_len) as i64 })
        cloned.right = clone_expr(e.right, StrView { ptr: (type_param), len: (type_param_len) as i64 }, subst_type, StrView { ptr: (subst_name), len: (subst_len) as i64 }, StrView { ptr: (suffix), len: (suffix_len) as i64 })
    else if k == EXPR_UNARY
        cloned.op = e.op
        cloned.operand = clone_expr(e.operand, StrView { ptr: (type_param), len: (type_param_len) as i64 }, subst_type, StrView { ptr: (subst_name), len: (subst_len) as i64 }, StrView { ptr: (suffix), len: (suffix_len) as i64 })
    else if k == EXPR_CALL
        cloned.func_name = e.func_name
        cloned.func_name_len = e.func_name_len
        # A nameless call's callee expression (AGAST #1747).  Only then: a
        # named call's `left` is not guaranteed initialised.
        cloned.left = null
        if e.func_name_len == 0
            cloned.left = clone_expr(e.left, StrView { ptr: (type_param), len: (type_param_len) as i64 }, subst_type, StrView { ptr: (subst_name), len: (subst_len) as i64 }, StrView { ptr: (suffix), len: (suffix_len) as i64 })
        cloned.call_type_suffix = e.call_type_suffix
        cloned.call_type_suffix_len = e.call_type_suffix_len

        # If this call has a type suffix with our type param, substitute
        if cloned.call_type_suffix_len > 1
            # Check if suffix contains type param (e.g., $T -> $u8)
            var subst_suffix: *u8 = null
            var subst_suffix_len: i32 = 0
            subst_suffix = check_and_substitute_suffix(StrView { ptr: (cloned.call_type_suffix), len: (cloned.call_type_suffix_len) as i64 }, StrView { ptr: (type_param), len: (type_param_len) as i64 }, StrView { ptr: (suffix), len: (suffix_len) as i64 }, @subst_suffix_len)
            if subst_suffix != null
                cloned.call_type_suffix = subst_suffix
                cloned.call_type_suffix_len = subst_suffix_len
                # Register this new instantiation for later generation —
                # unless a multi-parameter pass is mid-way, when the suffix
                # may still name a later parameter (AGAST #1612; the finished
                # body is collected instead).
                if g_mono_component_mode == 0
                    add_instantiation(StrView { ptr: (cloned.func_name), len: (cloned.func_name_len) as i64 }, StrView { ptr: (subst_suffix), len: (subst_suffix_len) as i64 })

        # Special case: sizeof(T) where T is a type parameter
        # The argument to sizeof is a type name (identifier), so we need to substitute
        var is_sizeof: bool = false
        if cloned.func_name_len == 6
            if memcmp(cloned.func_name, c"sizeof", 6) == 0
                is_sizeof = true
        if is_sizeof and e.args != null and e.args.kind == EXPR_IDENT
            # Check if the argument matches our type parameter
            if e.args.ident_len == type_param_len
                if memcmp(e.args.ident_ptr, type_param, type_param_len as i64) == 0
                    # Substitute the concrete type itself (AGAST #2124): a
                    # TYPE_OPERAND, not an IDENT of subst_name, which for
                    # a pointer or primitive T is no name the emitter knows
                    # (and an unknown sizeof name is now an error).
                    cloned.args = sizeof_subst_operand(e.args, subst_type, StrView { ptr: (subst_name), len: (subst_len) as i64 })
                else
                    cloned.args = clone_expr_list(e.args, StrView { ptr: (type_param), len: (type_param_len) as i64 }, subst_type, StrView { ptr: (subst_name), len: (subst_len) as i64 }, StrView { ptr: (suffix), len: (suffix_len) as i64 })
            else
                cloned.args = clone_expr_list(e.args, StrView { ptr: (type_param), len: (type_param_len) as i64 }, subst_type, StrView { ptr: (subst_name), len: (subst_len) as i64 }, StrView { ptr: (suffix), len: (suffix_len) as i64 })
        else
            cloned.args = clone_expr_list(e.args, StrView { ptr: (type_param), len: (type_param_len) as i64 }, subst_type, StrView { ptr: (subst_name), len: (subst_len) as i64 }, StrView { ptr: (suffix), len: (suffix_len) as i64 })
    else if k == EXPR_INDEX
        cloned.left = clone_expr(e.left, StrView { ptr: (type_param), len: (type_param_len) as i64 }, subst_type, StrView { ptr: (subst_name), len: (subst_len) as i64 }, StrView { ptr: (suffix), len: (suffix_len) as i64 })
        cloned.right = clone_expr(e.right, StrView { ptr: (type_param), len: (type_param_len) as i64 }, subst_type, StrView { ptr: (subst_name), len: (subst_len) as i64 }, StrView { ptr: (suffix), len: (suffix_len) as i64 })
    else if k == EXPR_MEMBER
        cloned.left = clone_expr(e.left, StrView { ptr: (type_param), len: (type_param_len) as i64 }, subst_type, StrView { ptr: (subst_name), len: (subst_len) as i64 }, StrView { ptr: (suffix), len: (suffix_len) as i64 })
        cloned.ident_ptr = e.ident_ptr  # Member name
        cloned.ident_len = e.ident_len
    else if k == EXPR_METHOD
        cloned.left = clone_expr(e.left, StrView { ptr: (type_param), len: (type_param_len) as i64 }, subst_type, StrView { ptr: (subst_name), len: (subst_len) as i64 }, StrView { ptr: (suffix), len: (suffix_len) as i64 })
        cloned.ident_ptr = e.ident_ptr  # Method name
        cloned.ident_len = e.ident_len
        cloned.args = clone_expr_list(e.args, StrView { ptr: (type_param), len: (type_param_len) as i64 }, subst_type, StrView { ptr: (subst_name), len: (subst_len) as i64 }, StrView { ptr: (suffix), len: (suffix_len) as i64 })
        # A generic body is never walked by collect_from_expr, so its
        # specialisation is where `E.from(...)` becomes `E__from(...)`, and
        # `String.from(..)` `string_from(..)`.
        if g_mono_module != null
            rewrite_enum_from_call(g_mono_module, cloned)
    else if k == EXPR_CAST
        cloned.cast_array = null   # AGAST #2343: `[N]T` keeps T's own name; left unjudged
        # Parser stores operand in e.left, not e.operand
        cloned.left = clone_expr(e.left, StrView { ptr: (type_param), len: (type_param_len) as i64 }, subst_type, StrView { ptr: (subst_name), len: (subst_len) as i64 }, StrView { ptr: (suffix), len: (suffix_len) as i64 })
        cloned.op = e.op  # cast_type stored in op
    else if k == EXPR_STRUCT_LIT
        # Struct literal: TypeName { field: value, ... }
        # e.ident_ptr/ident_len = struct type name
        # For generic struct literals, name is already mangled like "Vec$T"
        # We need to replace the "$T" with the new suffix "$u8"
        if e.ident_ptr != null
            var new_name_ptr: *u8 = null
            var new_name_len: i32 = 0
            substitute_type_param_in_name(StrView { ptr: (e.ident_ptr), len: (e.ident_len) as i64 }, StrView { ptr: (type_param), len: (type_param_len) as i64 }, StrView { ptr: (suffix), len: (suffix_len) as i64 }, @new_name_ptr, @new_name_len)
            cloned.ident_ptr = new_name_ptr
            cloned.ident_len = new_name_len
        else
            cloned.ident_ptr = e.ident_ptr
            cloned.ident_len = e.ident_len
        # Clone field initializers (stored in args)
        cloned.args = clone_field_inits(e.args as *FieldInit, StrView { ptr: (type_param), len: (type_param_len) as i64 }, subst_type, StrView { ptr: (subst_name), len: (subst_len) as i64 }, StrView { ptr: (suffix), len: (suffix_len) as i64 }) as *Expr
    else if k == EXPR_RANGE
        # Range expression: start..end
        cloned.left = clone_expr(e.left, StrView { ptr: (type_param), len: (type_param_len) as i64 }, subst_type, StrView { ptr: (subst_name), len: (subst_len) as i64 }, StrView { ptr: (suffix), len: (suffix_len) as i64 })
        cloned.right = clone_expr(e.right, StrView { ptr: (type_param), len: (type_param_len) as i64 }, subst_type, StrView { ptr: (subst_name), len: (subst_len) as i64 }, StrView { ptr: (suffix), len: (suffix_len) as i64 })
    else if k == EXPR_NIL_LIT
        # Nil literal: no fields to clone
        pass  # Placeholder statement to satisfy parser
    else if k == EXPR_MATCH or k == EXPR_IF
        # EXPR_IF (#1613): same shape (condition in left, then/else arms).
        # AGAST #186: match-expr cloning was missing — caused segfaults when
        # generic fns had `match *opt` bodies (option_is_none<T>, etc).
        # EXPR_MATCH stores scrutinee in left, arms in args (recast as *MatchArm).
        cloned.left = clone_expr(e.left, StrView { ptr: (type_param), len: (type_param_len) as i64 }, subst_type, StrView { ptr: (subst_name), len: (subst_len) as i64 }, StrView { ptr: (suffix), len: (suffix_len) as i64 })
        cloned.args = clone_match_arms(e.args as *MatchArm, StrView { ptr: (type_param), len: (type_param_len) as i64 }, subst_type, StrView { ptr: (subst_name), len: (subst_len) as i64 }, StrView { ptr: (suffix), len: (suffix_len) as i64 }) as *Expr
    else if k == EXPR_ARRAY_LIT
        # [a, b, c]: the elements are the args list (AGAST #1925)
        cloned.args = clone_expr_list(e.args, StrView { ptr: (type_param), len: (type_param_len) as i64 }, subst_type, StrView { ptr: (subst_name), len: (subst_len) as i64 }, StrView { ptr: (suffix), len: (suffix_len) as i64 })
    else if k == EXPR_ARRAY_FILL or k == EXPR_TRY
        # [value; N] keeps value in left and N in int_val; `expr?` keeps expr
        # in left (AGAST #1925)
        cloned.left = clone_expr(e.left, StrView { ptr: (type_param), len: (type_param_len) as i64 }, subst_type, StrView { ptr: (subst_name), len: (subst_len) as i64 }, StrView { ptr: (suffix), len: (suffix_len) as i64 })
    else if k == EXPR_FLOAT_LIT
        # The raw digits (string_ptr / string_len) come over with the byte copy
        pass
    else
        clone_unknown_kind(c"clone_expr", k)

    return cloned

# AGAST #186: clone a chain of MatchArm nodes when the enclosing fn is being
# specialised.  Pattern fields (kind/int/name) carry no T references so they
# pass through verbatim; only `body` (the arm's RHS expression) needs the
# usual type-param substitution.  Cloning is required because emit_match
# reads each arm's `body.kind` etc.; without this the arms would still point
# at the template's expressions, but more importantly the surrounding STMT_
# /EXPR_MATCH cloning did nothing without a copy strategy for arms either.
fn clone_match_arms(arms: *MatchArm, type_param_sv: StrView, subst_type: i32, subst_name_sv: StrView, suffix_sv: StrView) -> *MatchArm
    var type_param: *u8 = type_param_sv.ptr
    var type_param_len: i32 = type_param_sv.len as i32
    var subst_name: *u8 = subst_name_sv.ptr
    var subst_len: i32 = subst_name_sv.len as i32
    var suffix: *u8 = suffix_sv.ptr
    var suffix_len: i32 = suffix_sv.len as i32
    if arms == null
        return null
    let cloned: *MatchArm = malloc(sizeof(MatchArm)) as *MatchArm
    cloned.pattern_kind = arms.pattern_kind
    cloned.pattern_int = arms.pattern_int
    cloned.pattern_name = arms.pattern_name
    cloned.pattern_name_len = arms.pattern_name_len
    cloned.pattern_inner_kind = arms.pattern_inner_kind
    cloned.pattern_inner_name = arms.pattern_inner_name
    cloned.pattern_inner_name_len = arms.pattern_inner_name_len
    cloned.pattern_inner_span.line = arms.pattern_inner_span.line   # AGAST #2405
    cloned.pattern_inner_span.col = arms.pattern_inner_span.col
    cloned.pattern_binds = arms.pattern_binds   # AGAST #1295 (shared: never mutated)
    cloned.pattern_bind_count = arms.pattern_bind_count
    cloned.pattern_field_sel = arms.pattern_field_sel
    cloned.pattern_span.line = arms.pattern_span.line   # AGAST #2407
    cloned.pattern_span.col = arms.pattern_span.col
    cloned.head_span.line = arms.head_span.line   # AGAST #2431
    cloned.head_span.col = arms.head_span.col
    cloned.is_pass = arms.is_pass
    cloned.is_block = arms.is_block   # AGAST #3028
    cloned.pass_span.line = arms.pass_span.line   # AGAST #2236
    cloned.pass_span.col = arms.pass_span.col
    # Block arm statements (AGAST #1454); clone_body copies the chain.
    cloned.body_stmts = clone_body(arms.body_stmts, StrView { ptr: (type_param), len: (type_param_len) as i64 }, subst_type, StrView { ptr: (subst_name), len: (subst_len) as i64 }, StrView { ptr: (suffix), len: (suffix_len) as i64 })
    if arms.body != null
        cloned.body = clone_expr(arms.body, StrView { ptr: (type_param), len: (type_param_len) as i64 }, subst_type, StrView { ptr: (subst_name), len: (subst_len) as i64 }, StrView { ptr: (suffix), len: (suffix_len) as i64 })
    else
        cloned.body = null
    cloned.next = clone_match_arms(arms.next, StrView { ptr: (type_param), len: (type_param_len) as i64 }, subst_type, StrView { ptr: (subst_name), len: (subst_len) as i64 }, StrView { ptr: (suffix), len: (suffix_len) as i64 })
    return cloned

fn clone_expr_list(list: *Expr, type_param_sv: StrView, subst_type: i32, subst_name_sv: StrView, suffix_sv: StrView) -> *Expr
    var type_param: *u8 = type_param_sv.ptr
    var type_param_len: i32 = type_param_sv.len as i32
    var subst_name: *u8 = subst_name_sv.ptr
    var subst_len: i32 = subst_name_sv.len as i32
    var suffix: *u8 = suffix_sv.ptr
    var suffix_len: i32 = suffix_sv.len as i32
    if list == null
        return null

    let cloned: *Expr = clone_expr(list, StrView { ptr: (type_param), len: (type_param_len) as i64 }, subst_type, StrView { ptr: (subst_name), len: (subst_len) as i64 }, StrView { ptr: (suffix), len: (suffix_len) as i64 })
    cloned.next = clone_expr_list(list.next, StrView { ptr: (type_param), len: (type_param_len) as i64 }, subst_type, StrView { ptr: (subst_name), len: (subst_len) as i64 }, StrView { ptr: (suffix), len: (suffix_len) as i64 })
    return cloned

fn clone_field_inits(fi: *FieldInit, type_param_sv: StrView, subst_type: i32, subst_name_sv: StrView, suffix_sv: StrView) -> *FieldInit
    var type_param: *u8 = type_param_sv.ptr
    var type_param_len: i32 = type_param_sv.len as i32
    var subst_name: *u8 = subst_name_sv.ptr
    var subst_len: i32 = subst_name_sv.len as i32
    var suffix: *u8 = suffix_sv.ptr
    var suffix_len: i32 = suffix_sv.len as i32
    if fi == null
        return null

    let cloned: *FieldInit = malloc(sizeof(FieldInit)) as *FieldInit
    cloned.name = fi.name
    cloned.name_len = fi.name_len
    # Clone the value expression (handles nested generic calls/literals)
    cloned.value = clone_expr(fi.value, StrView { ptr: (type_param), len: (type_param_len) as i64 }, subst_type, StrView { ptr: (subst_name), len: (subst_len) as i64 }, StrView { ptr: (suffix), len: (suffix_len) as i64 })
    cloned.next = clone_field_inits(fi.next, StrView { ptr: (type_param), len: (type_param_len) as i64 }, subst_type, StrView { ptr: (subst_name), len: (subst_len) as i64 }, StrView { ptr: (suffix), len: (suffix_len) as i64 })
    return cloned

fn check_and_substitute_suffix(old_suffix_sv: StrView, type_param_sv: StrView, new_suffix_sv: StrView, out_len: *i32) -> *u8
    var old_suffix: *u8 = old_suffix_sv.ptr
    var old_suffix_len: i32 = old_suffix_sv.len as i32
    var type_param: *u8 = type_param_sv.ptr
    var type_param_len: i32 = type_param_sv.len as i32
    var new_suffix: *u8 = new_suffix_sv.ptr
    var new_suffix_len: i32 = new_suffix_sv.len as i32
    # AGAST #1612: in a multi-parameter pass a call suffix may name several
    # parameters (`helper<T, U>` is "$T$U"); rewrite the matching component.
    if g_mono_component_mode != 0
        let rewritten: *u8 = replace_param_component(StrView { ptr: (old_suffix), len: (old_suffix_len) as i64 }, StrView { ptr: (type_param), len: (type_param_len) as i64 }, StrView { ptr: (new_suffix), len: (new_suffix_len) as i64 }, out_len)
        if rewritten == old_suffix
            return null
        return rewritten
    # AGAST #2975: `vec_push<(T, i32)>` is "$tuple_T_i32".
    let tup: *u8 = subst_components(StrView { ptr: (old_suffix), len: (old_suffix_len) as i64 }, StrView { ptr: (type_param), len: (type_param_len) as i64 }, StrView { ptr: (new_suffix), len: (new_suffix_len) as i64 }, 0, out_len)
    if tup != old_suffix
        return tup
    # Check if old_suffix is "$T" where T matches type_param
    if old_suffix_len != type_param_len + 1
        # AGAST #3343: T inside a nested argument, `deep<Cell<T>>` ("$Cell$T")
        # at T = i32 is "$Cell$i32".  Left alone, every instance called the
        # unspecialised `deep$Cell$T` (invalid IR), so polymorphic recursion
        # never got deeper than one level and #3330's cap never fired.
        let inner: *u8 = replace_param_component(StrView { ptr: (old_suffix), len: (old_suffix_len) as i64 }, StrView { ptr: (type_param), len: (type_param_len) as i64 }, StrView { ptr: (new_suffix), len: (new_suffix_len) as i64 }, out_len)
        if inner == old_suffix
            return null
        return inner
    if *old_suffix != '$'  # $
        return null
    if memcmp(old_suffix + 1, type_param, type_param_len as i64) != 0
        return null

    # Substitute with new suffix
    *out_len = new_suffix_len
    return new_suffix

# ============================================================================
# Struct Cloning and Specialization
# ============================================================================
# Clone a generic struct and substitute the type parameter

fn clone_and_specialize_struct(m: *Module, template: *StructDef, suffix_sv: StrView) -> *StructDef
    var suffix: *u8 = suffix_sv.ptr
    var suffix_len: i32 = suffix_sv.len as i32
    # Create a new StructDef with mangled name
    let mangled_name_len: i32 = template.name_len + suffix_len
    let mangled_name: *u8 = malloc(mangled_name_len as i64 + 1) as *u8

    # Copy base name
    for i in 0..template.name_len
        *(mangled_name + i) = *(template.name + i)

    # Copy suffix (including the $)
    for j in 0..suffix_len
        *(mangled_name + template.name_len + j) = *(suffix + j)
    *(mangled_name + mangled_name_len) = 0

    # AGAST #1574: substitute EVERY parameter of a multi-parameter template.
    if count_type_params(template.type_params) >= 2
        let cap: i64 = 4 * mangled_arg_capacity(StrView { ptr: (suffix), len: (suffix_len) as i64 }) as i64
        let starts: *i32 = malloc(cap) as *i32
        let lens: *i32 = malloc(cap) as *i32
        if split_mangled_args(m, StrView { ptr: (suffix), len: (suffix_len) as i64 }, starts, lens) != count_type_params(template.type_params)
            return null
        let multi: *StructDef = malloc(sizeof(StructDef)) as *StructDef
        multi.name = mangled_name
        multi.name_len = mangled_name_len
        multi.fields = clone_struct_fields_multi(template.fields, template.type_params, suffix, starts, lens)
        multi.type_params = null
        multi.next = null
        if struct_is_packed(template) == 1
            struct_mark_packed(multi)   # `[[packed]]` holds for every instance (#1847)
        return multi

    # Get the type parameter name from template
    var type_param_name: *u8 = null
    var type_param_len: i32 = 0
    if template.type_params != null
        type_param_name = template.type_params.name
        type_param_len = template.type_params.name_len

    # Get the substitution type from suffix
    var subst_type_name: *u8 = null
    var subst_type_len: i32 = 0
    get_type_name_from_suffix(StrView { ptr: (suffix), len: (suffix_len) as i64 }, @subst_type_name, @subst_type_len)
    let subst_type: i32 = parse_type_from_suffix(StrView { ptr: (suffix), len: (suffix_len) as i64 })

    # Clone the struct with specialized name
    let specialized: *StructDef = malloc(sizeof(StructDef)) as *StructDef
    specialized.name = mangled_name
    specialized.name_len = mangled_name_len
    specialized.fields = clone_struct_fields(template.fields, StrView { ptr: (type_param_name), len: (type_param_len) as i64 }, subst_type, StrView { ptr: (subst_type_name), len: (subst_type_len) as i64 }, StrView { ptr: (suffix), len: (suffix_len) as i64 })
    specialized.type_params = null  # Not generic anymore
    specialized.next = null
    if struct_is_packed(template) == 1
        struct_mark_packed(specialized)   # `[[packed]]` holds for every instance (#1847)

    return specialized

# AGAST #2329: a `*[N]T` field or return keeps N and T through a clone when T is
# a scalar.  A named T may be the type parameter, so it's dropped, and `x[i]` on
# one is left as it was before #2329.
fn ptr_array_unless_generic(pa: *Param) -> *Param
    if pa == null or pa.param_type_name_len > 0
        return null
    pa

# primitive_type_from_name lives in ast_helpers (AGAST #1980: the emitter's
# let path needs it too).
fn clone_struct_fields(fields: *StructField, type_param_sv: StrView, subst_type: i32, subst_name_sv: StrView, suffix_sv: StrView) -> *StructField
    var type_param: *u8 = type_param_sv.ptr
    var type_param_len: i32 = type_param_sv.len as i32
    var subst_name: *u8 = subst_name_sv.ptr
    var subst_len: i32 = subst_name_sv.len as i32
    var suffix: *u8 = suffix_sv.ptr
    var suffix_len: i32 = suffix_sv.len as i32
    if fields == null
        return null

    let cloned: *StructField = malloc(sizeof(StructField)) as *StructField
    cloned.name = fields.name
    cloned.name_len = fields.name_len
    cloned.inner_pointee_type = fields.inner_pointee_type  # AGAST #1924
    cloned.fn_sig = fields.fn_sig  # AGAST #2120
    cloned.elem_fn_sig = fields.elem_fn_sig  # AGAST #3666
    cloned.array_shape = array_shape_mangled_subst(fields.array_shape, StrView { ptr: (type_param), len: (type_param_len) as i64 }, StrView { ptr: (suffix), len: (suffix_len) as i64 })  # AGAST #2097, #3119
    # AGAST #3141: a bare `[2][3]T` leaf is the struct named `T` until
    # substituted; kept, `w.a[1][2] = x` read as assigning a whole element.
    cloned.array_shape = array_shape_subst(cloned.array_shape, StrView { ptr: (type_param), len: (type_param_len) as i64 }, subst_type, StrView { ptr: (subst_name), len: (subst_len) as i64 })
    cloned.ptr_array = ptr_array_unless_generic(fields.ptr_array)  # AGAST #2329

    # Copy array info first: substituting `v: T` at an array T writes it
    # (AGAST #2832).
    cloned.array_size = fields.array_size
    cloned.array_elem_type = fields.array_elem_type
    cloned.array_elem_pointee = fields.array_elem_pointee   # AGAST #2332
    cloned.field_mut_ref = fields.field_mut_ref
    cloned.field_shared_ref = fields.field_shared_ref
    cloned.field_inner_ref = fields.field_inner_ref  # AGAST #2399
    # AGAST #3151: a struct U may be the parameter; a scalar U is itself.
    cloned.field_ref_ptr_pointee = TYPE_VOID
    if ref_field_scalar_pointee(fields) == 1
        cloned.field_ref_ptr_pointee = fields.field_ref_ptr_pointee
    cloned.array_elem_type_name = fields.array_elem_type_name
    cloned.array_elem_type_name_len = fields.array_elem_type_name_len

    # Check if field type is the type parameter
    if fields.field_type == TYPE_STRUCT
        if fields.field_type_name != null and find_dollar_sign(StrView { ptr: (fields.field_type_name), len: (fields.field_type_name_len) as i64 }) > 0
            # AGAST #2411: a generic over the parameter, `v: Vec<T>` is
            # `Vec$T`: rewrite its `$T`, to `Vec$i32`.  It was copied as it
            # stood, so `B$i32` held a `%Vec$T`, which names no struct, and
            # `b.v.len` was `unhandled EXPR_MEMBER`.
            cloned.field_type = fields.field_type
            var sub_len: i32 = 0
            substitute_type_param_in_name(StrView { ptr: (fields.field_type_name), len: (fields.field_type_name_len) as i64 }, StrView { ptr: (type_param), len: (type_param_len) as i64 }, StrView { ptr: (suffix), len: (suffix_len) as i64 }, @cloned.field_type_name, @sub_len)
            cloned.field_type_name_len = sub_len
        else if fields.field_type_name != null and fields.field_type_name_len == type_param_len
            if memcmp(fields.field_type_name, type_param, type_param_len as i64) == 0
                # Substitute with concrete type
                subst_value_field(cloned, subst_type, StrView { ptr: (subst_name), len: (subst_len) as i64 })
            else
                # Not the type param, but might be a generic struct - mangle it
                cloned.field_type = fields.field_type
                cloned.field_type_name = mangle_struct_name(StrView { ptr: (fields.field_type_name), len: (fields.field_type_name_len) as i64 }, StrView { ptr: (suffix), len: (suffix_len) as i64 })
                cloned.field_type_name_len = fields.field_type_name_len + suffix_len
        else if fields.field_type_name != null and tuple_reg_lookup(StrView { ptr: (fields.field_type_name), len: (fields.field_type_name_len) as i64 }) != null
            # AGAST #2975: `f: (T, i32)` is `tuple_T_i32`, at T = i64
            # `tuple_i64_i32`.
            cloned.field_type = fields.field_type
            var tu_len: i32 = 0
            substitute_type_param_in_name(StrView { ptr: (fields.field_type_name), len: (fields.field_type_name_len) as i64 }, StrView { ptr: (type_param), len: (type_param_len) as i64 }, StrView { ptr: (suffix), len: (suffix_len) as i64 }, @cloned.field_type_name, @tu_len)
            cloned.field_type_name_len = tu_len
        else
            cloned.field_type = fields.field_type
            cloned.field_type_name = fields.field_type_name
            cloned.field_type_name_len = fields.field_type_name_len
    else
        cloned.field_type = fields.field_type
        cloned.field_type_name = fields.field_type_name
        cloned.field_type_name_len = fields.field_type_name_len

    # `data: *T` — substitute the pointee.  The parser records a struct
    # pointee in field_type_name and a primitive one in array_elem_type; `T`
    # parses as a struct named "T".  Dropping it (as this used to) left
    # `Vec$Token.data + i` striding by 1 byte instead of sizeof(Token); the
    # hard-coded Vec$ layouts in the emitter hid that until #1440 removed them.
    if fields.field_type == TYPE_PTR or fields.field_type == TYPE_REF or fields.field_type == TYPE_MUT_REF
        if fields.field_type_name != null and fields.field_type_name_len == type_param_len
            if memcmp(fields.field_type_name, type_param, type_param_len as i64) == 0
                subst_pointee_field(cloned, subst_type, StrView { ptr: (subst_name), len: (subst_len) as i64 })
        if fields.field_type_name != null and find_dollar_sign(StrView { ptr: (fields.field_type_name), len: (fields.field_type_name_len) as i64 }) > 0
            # AGAST #3099: a generic pointee, `b: *Box<T>` is `*Box$T`:
            # rewrite its `$T`, as the by-value `b: Box<T>` above.  Copied as
            # it stood, `w.b.v` named the `%Box$T` no struct is, and fell to
            # "unhandled EXPR_MEMBER".
            var pt_len: i32 = 0
            substitute_type_param_in_name(StrView { ptr: (fields.field_type_name), len: (fields.field_type_name_len) as i64 }, StrView { ptr: (type_param), len: (type_param_len) as i64 }, StrView { ptr: (suffix), len: (suffix_len) as i64 }, @cloned.field_type_name, @pt_len)
            cloned.field_type_name_len = pt_len
    subst_array_ptr_field(cloned, StrView { ptr: (type_param), len: (type_param_len) as i64 }, subst_type, StrView { ptr: (subst_name), len: (subst_len) as i64 })
    subst_array_elem_field(cloned, StrView { ptr: (type_param), len: (type_param_len) as i64 }, subst_type, StrView { ptr: (subst_name), len: (subst_len) as i64 })
    if cloned.field_type == TYPE_ARRAY and array_elem_names_struct(cloned) == 1
        if find_dollar_sign(StrView { ptr: (cloned.array_elem_type_name), len: (cloned.array_elem_type_name_len) as i64 }) > 0
            # AGAST #2390: `a: [2]Box<T>` is `[2]Box$T`: rewrite its `$T`;
            # and #3099, `a: [2]*Box<T>`'s pointee `Box$T`.
            var ae_len: i32 = 0
            substitute_type_param_in_name(StrView { ptr: (fields.array_elem_type_name), len: (fields.array_elem_type_name_len) as i64 }, StrView { ptr: (type_param), len: (type_param_len) as i64 }, StrView { ptr: (suffix), len: (suffix_len) as i64 }, @cloned.array_elem_type_name, @ae_len)
            cloned.array_elem_type_name_len = ae_len

    # Clone rest of the list
    cloned.next = clone_struct_fields(fields.next, StrView { ptr: (type_param), len: (type_param_len) as i64 }, subst_type, StrView { ptr: (subst_name), len: (subst_len) as i64 }, StrView { ptr: (suffix), len: (suffix_len) as i64 })

    return cloned

# An array field's element names a struct: `[N]S` or (AGAST #3099) `[N]*S`.
fn array_elem_names_struct(f: *StructField) -> i32
    if f.array_elem_type_name == null
        return 0
    if f.array_elem_type == TYPE_STRUCT
        return 1
    if f.array_elem_type == TYPE_PTR and f.array_elem_pointee == TYPE_STRUCT
        return 1
    0

# AGAST #2332: a field `a: [N]*T`, at T = the argument (subst_type, subst_name).
fn subst_array_ptr_field(cloned: *StructField, type_param_sv: StrView, subst_type: i32, subst_name_sv: StrView)
    var type_param: *u8 = type_param_sv.ptr
    var type_param_len: i32 = type_param_sv.len as i32
    var subst_name: *u8 = subst_name_sv.ptr
    var subst_len: i32 = subst_name_sv.len as i32
    if cloned.array_elem_pointee != TYPE_STRUCT or cloned.array_elem_type_name == null or cloned.array_elem_type_name_len != type_param_len
        return
    if memcmp(cloned.array_elem_type_name, type_param, type_param_len as i64) != 0
        return
    cloned.array_elem_pointee = subst_type
    cloned.array_elem_type_name = subst_name
    cloned.array_elem_type_name_len = subst_len

# AGAST #2390: a field `a: [N]T`, at T = the argument (subst_type, subst_name).
# The parser records the element as a struct named "T"; it was copied as it
# stood, so `W$i32` was `{[2 x %T]}` and clang refused the unsized alloca.
# The element is encoded as field_new encodes a written one (and as
# array_arg_decode does): a primitive by its type and no name, a struct by
# its name, `*X` as TYPE_PTR with X the pointee.  An array argument (a nested
# `[N][M]X`) isn't rewritten here.
fn subst_array_elem_field(cloned: *StructField, type_param_sv: StrView, subst_type: i32, subst_name_sv: StrView)
    var type_param: *u8 = type_param_sv.ptr
    var type_param_len: i32 = type_param_sv.len as i32
    var subst_name: *u8 = subst_name_sv.ptr
    var subst_len: i32 = subst_name_sv.len as i32
    if cloned.field_type != TYPE_ARRAY or cloned.array_elem_type != TYPE_STRUCT
        return
    if cloned.array_elem_type_name == null or cloned.array_elem_type_name_len != type_param_len
        return
    if memcmp(cloned.array_elem_type_name, type_param, type_param_len as i64) != 0
        return
    if subst_type == TYPE_ARRAY or subst_type == 0
        return
    if subst_type == TYPE_STRUCT
        cloned.array_elem_type_name = subst_name
        cloned.array_elem_type_name_len = subst_len
        return
    if subst_type == TYPE_PTR
        cloned.array_elem_type = TYPE_PTR
        let prim: i32 = primitive_type_from_name(StrView { ptr: (subst_name), len: (subst_len) as i64 })
        if prim != 0
            cloned.array_elem_pointee = prim
            cloned.array_elem_type_name = null
            cloned.array_elem_type_name_len = 0
        else
            cloned.array_elem_pointee = TYPE_STRUCT
            cloned.array_elem_type_name = subst_name
            cloned.array_elem_type_name_len = subst_len
        return
    cloned.array_elem_type = subst_type
    cloned.array_elem_type_name = null
    cloned.array_elem_type_name_len = 0

# A by-value field `x: T`, at T = the argument (subst_type, subst_name).
fn subst_value_field(cloned: *StructField, subst_type: i32, subst_name_sv: StrView)
    var subst_name: *u8 = subst_name_sv.ptr
    var subst_len: i32 = subst_name_sv.len as i32
    cloned.field_type = subst_type
    cloned.field_type_name = subst_name
    cloned.field_type_name_len = subst_len
    # AGAST #2832: `v: T` at T = `[4]i64` is the array field `v: [4]i64`,
    # recorded as field_new records a written one.
    var a: ArrayArg
    if subst_type == TYPE_ARRAY and array_arg_decode(StrView { ptr: (subst_name), len: (subst_len) as i64 }, @a) == 1
        cloned.field_type_name = null
        cloned.field_type_name_len = 0
        cloned.array_size = a.size
        cloned.array_elem_type = a.elem
        cloned.array_elem_pointee = a.pointee
        cloned.array_elem_type_name = a.name
        cloned.array_elem_type_name_len = a.name_len
        cloned.array_shape = a.shape   # AGAST #3634: `[N][M]E`

# A `*T` / `@T` / `@&T` field at T = the argument.  The parser records a
# struct pointee in field_type_name and a primitive one in array_elem_type.
fn subst_pointee_field(cloned: *StructField, subst_type: i32, subst_name_sv: StrView)
    var subst_name: *u8 = subst_name_sv.ptr
    var subst_len: i32 = subst_name_sv.len as i32
    let prim: i32 = primitive_type_from_name(StrView { ptr: (subst_name), len: (subst_len) as i64 })
    if subst_type == TYPE_PTR
        # `*T` at T = *X is `**X`: the element is a pointer.  Checked before
        # the primitive case: a `$ptr_u8` argument arrives as the name "u8"
        # (get_type_name_from_suffix strips `ptr_`), and taking it as T = u8
        # made Vec$ptr_u8.data a `*u8` — 1-byte stride, `load i8` (#1796).
        # Encoded like a declared `**X` field (field_new): the innermost
        # struct's name, or no name for a primitive.
        cloned.field_type = TYPE_PTR_PTR
        if prim != 0
            cloned.field_type_name = null
            cloned.field_type_name_len = 0
        else
            cloned.field_type_name = subst_name
            cloned.field_type_name_len = subst_len
    else if prim != 0
        cloned.field_type_name = null
        cloned.field_type_name_len = 0
        cloned.array_elem_type = prim
    else
        cloned.field_type_name = subst_name
        cloned.field_type_name_len = subst_len

# AGAST #3184: a `**T` field (any depth) at T = the argument, encoded as
# field_new records a written `**X`: the innermost pointee in the
# inner-pointee slot (depth kept), named when it is a struct, unnamed when
# a primitive.  T = *X is one level deeper: `**T` at T = *u8 is `***u8`.
fn subst_ptr_ptr_field(cloned: *StructField, subst_type: i32, subst_name_sv: StrView)
    var subst_name: *u8 = subst_name_sv.ptr
    var subst_len: i32 = subst_name_sv.len as i32
    let prim: i32 = primitive_type_from_name(StrView { ptr: (subst_name), len: (subst_len) as i64 })
    var inner: i32 = TYPE_STRUCT
    if prim != 0
        inner = prim
    var slot: i32 = ptr_ptr_slot_subst(cloned.inner_pointee_type, inner)
    if subst_type == TYPE_PTR
        slot = slot + PTR_DEPTH_UNIT
    cloned.inner_pointee_type = slot
    if prim != 0
        cloned.field_type_name = null
        cloned.field_type_name_len = 0
    else
        cloned.field_type_name = subst_name
        cloned.field_type_name_len = subst_len

# AGAST #1574: clone a multi-parameter template's fields, substituting every
# parameter.  A field typed by a parameter takes that parameter's argument; a
# field typed by a generic over the parameters (`Box$B`) has them rewritten
# in its mangled name; any other type is copied as-is.  (The single-parameter
# path appends the suffix to every non-parameter struct name instead, which
# here would name `%B$i64`-style types.)
fn clone_struct_fields_multi(fields: *StructField, tp: *TypeParam, suffix: *u8, starts: *i32, lens: *i32) -> *StructField
    if fields == null
        return null

    let cloned: *StructField = malloc(sizeof(StructField)) as *StructField
    cloned.name = fields.name
    cloned.name_len = fields.name_len
    cloned.inner_pointee_type = fields.inner_pointee_type  # AGAST #1924
    cloned.fn_sig = fields.fn_sig  # AGAST #2120
    cloned.elem_fn_sig = fields.elem_fn_sig  # AGAST #3666
    cloned.array_shape = fields.array_shape  # AGAST #2097
    # AGAST #3141: a bare `[2][3]T` leaf, T one of the parameters.
    let sh: *ArrayShape = fields.array_shape
    if sh != null and sh.leaf_name != null
        let si: i32 = type_param_index(tp, StrView { ptr: (sh.leaf_name), len: (sh.leaf_name_len) as i64 })
        if si >= 0
            var sh_name: *u8 = null
            var sh_len: i32 = 0
            let arg_s: *u8 = suffix + *(starts + si)
            get_type_name_from_suffix(StrView { ptr: (arg_s), len: (*(lens + si)) as i64 }, @sh_name, @sh_len)
            cloned.array_shape = array_shape_subst(sh, StrView { ptr: (sh.leaf_name), len: (sh.leaf_name_len) as i64 }, parse_type_from_suffix(StrView { ptr: (arg_s), len: (*(lens + si)) as i64 }), StrView { ptr: (sh_name), len: (sh_len) as i64 })
        else if find_dollar_sign(StrView { ptr: (sh.leaf_name), len: (sh.leaf_name_len) as i64 }) > 0
            # AGAST #3140: a generic leaf, `[2][3]P<T>` (leaf `P$T`) of a
            # `W<T, U>`, its parameters rewritten as array_elem_type_name's are.
            # Shared as it stood, `W$i64$i32.a` named a `%P$T` no struct is.
            let msh: *ArrayShape = malloc(sizeof(ArrayShape)) as *ArrayShape
            *msh = *sh
            var msh_len: i32 = 0
            msh.leaf_name = substitute_params_in_mangled(tp, suffix, starts, lens, StrView { ptr: (sh.leaf_name), len: (sh.leaf_name_len) as i64 }, @msh_len)
            msh.leaf_name_len = msh_len
            cloned.array_shape = msh
    cloned.ptr_array = ptr_array_unless_generic(fields.ptr_array)  # AGAST #2329
    cloned.field_type = fields.field_type
    cloned.field_type_name = fields.field_type_name
    cloned.field_type_name_len = fields.field_type_name_len
    cloned.array_size = fields.array_size
    cloned.array_elem_type = fields.array_elem_type
    cloned.array_elem_pointee = fields.array_elem_pointee   # AGAST #2332
    cloned.field_mut_ref = fields.field_mut_ref
    cloned.field_shared_ref = fields.field_shared_ref
    cloned.field_inner_ref = fields.field_inner_ref  # AGAST #2399
    # AGAST #3151: a struct U may be the parameter; a scalar U is itself.
    cloned.field_ref_ptr_pointee = TYPE_VOID
    if ref_field_scalar_pointee(fields) == 1
        cloned.field_ref_ptr_pointee = fields.field_ref_ptr_pointee
    cloned.array_elem_type_name = fields.array_elem_type_name
    cloned.array_elem_type_name_len = fields.array_elem_type_name_len

    let ft: i32 = fields.field_type
    var by_value: i32 = 0
    if ft == TYPE_STRUCT
        by_value = 1
    var by_ptr: i32 = 0
    if ft == TYPE_PTR or ft == TYPE_REF or ft == TYPE_MUT_REF
        by_ptr = 1
    if (by_value == 1 or by_ptr == 1) and fields.field_type_name != null
        let idx: i32 = type_param_index(tp, StrView { ptr: (fields.field_type_name), len: (fields.field_type_name_len) as i64 })
        if idx >= 0
            let arg: *u8 = suffix + *(starts + idx)
            let arg_len: i32 = *(lens + idx)
            var subst_name: *u8 = null
            var subst_len: i32 = 0
            get_type_name_from_suffix(StrView { ptr: (arg), len: (arg_len) as i64 }, @subst_name, @subst_len)
            let subst_type: i32 = parse_type_from_suffix(StrView { ptr: (arg), len: (arg_len) as i64 })
            if by_value == 1
                subst_value_field(cloned, subst_type, StrView { ptr: (subst_name), len: (subst_len) as i64 })
            else
                subst_pointee_field(cloned, subst_type, StrView { ptr: (subst_name), len: (subst_len) as i64 })
        else
            var new_len: i32 = 0
            cloned.field_type_name = substitute_params_in_mangled(tp, suffix, starts, lens, StrView { ptr: (fields.field_type_name), len: (fields.field_type_name_len) as i64 }, @new_len)
            cloned.field_type_name_len = new_len

    if fields.array_elem_pointee == TYPE_STRUCT and fields.array_elem_type_name != null
        let ai: i32 = type_param_index(tp, StrView { ptr: (fields.array_elem_type_name), len: (fields.array_elem_type_name_len) as i64 })
        if ai >= 0
            var ae_name: *u8 = null
            var ae_len: i32 = 0
            let arg_e: *u8 = suffix + *(starts + ai)
            get_type_name_from_suffix(StrView { ptr: (arg_e), len: (*(lens + ai)) as i64 }, @ae_name, @ae_len)
            subst_array_ptr_field(cloned, StrView { ptr: (fields.array_elem_type_name), len: (fields.array_elem_type_name_len) as i64 }, parse_type_from_suffix(StrView { ptr: (arg_e), len: (*(lens + ai)) as i64 }), StrView { ptr: (ae_name), len: (ae_len) as i64 })
        else if ft == TYPE_ARRAY and find_dollar_sign(StrView { ptr: (fields.array_elem_type_name), len: (fields.array_elem_type_name_len) as i64 }) > 0
            # AGAST #3099: `a: [N]*Box<V>`, its pointee's parameters rewritten.
            var ap_len: i32 = 0
            cloned.array_elem_type_name = substitute_params_in_mangled(tp, suffix, starts, lens, StrView { ptr: (fields.array_elem_type_name), len: (fields.array_elem_type_name_len) as i64 }, @ap_len)
            cloned.array_elem_type_name_len = ap_len

    # AGAST #2390: `a: [N]T` / `a: [N]Box<T>` with T one of several parameters.
    if ft == TYPE_ARRAY and fields.array_elem_type == TYPE_STRUCT and fields.array_elem_type_name != null
        let ei: i32 = type_param_index(tp, StrView { ptr: (fields.array_elem_type_name), len: (fields.array_elem_type_name_len) as i64 })
        if ei >= 0
            var ev_name: *u8 = null
            var ev_len: i32 = 0
            let arg_v: *u8 = suffix + *(starts + ei)
            get_type_name_from_suffix(StrView { ptr: (arg_v), len: (*(lens + ei)) as i64 }, @ev_name, @ev_len)
            subst_array_elem_field(cloned, StrView { ptr: (fields.array_elem_type_name), len: (fields.array_elem_type_name_len) as i64 }, parse_type_from_suffix(StrView { ptr: (arg_v), len: (*(lens + ei)) as i64 }), StrView { ptr: (ev_name), len: (ev_len) as i64 })
        else if find_dollar_sign(StrView { ptr: (fields.array_elem_type_name), len: (fields.array_elem_type_name_len) as i64 }) > 0
            var em_len: i32 = 0
            cloned.array_elem_type_name = substitute_params_in_mangled(tp, suffix, starts, lens, StrView { ptr: (fields.array_elem_type_name), len: (fields.array_elem_type_name_len) as i64 }, @em_len)
            cloned.array_elem_type_name_len = em_len

    cloned.next = clone_struct_fields_multi(fields.next, tp, suffix, starts, lens)
    return cloned

# ============================================================================
# Impl Block Method Specialization
# ============================================================================
# Find impl block for a generic type and specialize its methods

# AGAST #1520: the parser records an impl's type as its bare name (`Box`
# for `impl<T> Box<T>` and `impl<T> Drop for Box<T>`; see impl_block in
# grammars/ritz1.grammar), so a generic impl is one with type params whose
# type name equals the instantiated struct's base name.  This used to look for
# a `$` in the impl's type name, which the parser never produces, so no
# generic impl method was ever specialized.  `start` resumes the search after
# a previous match: a type can have several generic impls.
fn find_generic_impl(start: *ImplBlock, type_name_sv: StrView) -> *ImplBlock
    var type_name: *u8 = type_name_sv.ptr
    var type_name_len: i32 = type_name_sv.len as i32
    var ib: *ImplBlock = start
    while ib != null
        if ib.type_params != null and ib.type_name_len == type_name_len
            if memcmp(ib.type_name, type_name, type_name_len as i64) == 0
                return ib
        ib = ib.next
    return null

fn specialize_impl_methods(m: *Module, type_name_sv: StrView, suffix_sv: StrView)
    var type_name: *u8 = type_name_sv.ptr
    var type_name_len: i32 = type_name_sv.len as i32
    var suffix: *u8 = suffix_sv.ptr
    var suffix_len: i32 = suffix_sv.len as i32
    var ib: *ImplBlock = find_generic_impl(m.impls, StrView { ptr: (type_name), len: (type_name_len) as i64 })
    while ib != null
        specialize_one_impl(m, ib, StrView { ptr: (type_name), len: (type_name_len) as i64 }, StrView { ptr: (suffix), len: (suffix_len) as i64 })
        ib = find_generic_impl(ib.next, StrView { ptr: (type_name), len: (type_name_len) as i64 })

# A trait impl is specialised whole: the compiler calls its methods itself
# (drop, index, ...).  An inherent impl's methods wait for a call that names
# them (AGAST #3617): specialize_wanted_methods.
fn specialize_one_impl(m: *Module, ib: *ImplBlock, type_name_sv: StrView, suffix_sv: StrView)
    var type_name: *u8 = type_name_sv.ptr
    var type_name_len: i32 = type_name_sv.len as i32
    var suffix: *u8 = suffix_sv.ptr
    var suffix_len: i32 = suffix_sv.len as i32
    if ib.trait_name == null or ib.trait_name_len == 0
        return
    var method: *FnDef = ib.methods
    while method != null
        add_specialized_method(m, specialize_impl_method(m, ib, method, StrView { ptr: (type_name), len: (type_name_len) as i64 }, StrView { ptr: (suffix), len: (suffix_len) as i64 }))
        method = method.next

fn add_specialized_method(m: *Module, specialized: *FnDef)
    if specialized == null
        return
    collect_struct_types_from_fn(m, specialized)
    # Add to module's function list
    if m.functions == null
        m.functions = specialized
    else
        var f: *FnDef = m.functions
        while f.next != null
            f = f.next
        f.next = specialized

# ============================================================================
# Inherent impl methods, specialised on use (AGAST #3617, #3341)
# ============================================================================
# Every method of a generic impl used to be specialised for every instance of
# its type, so a method nothing calls was emitted, typed and move-checked at
# every instance: an importer of ritzlib.gvec linked malloc through
# `vec_grow$u8`, and `impl<T> Cell<T>`'s `fn wrap(self) -> Cell<Cell<T>>`
# named a deeper instance at every level.  Now a call names the methods it
# reaches, as a generic fn's call does: `x.m()` wants `m` at x's instance,
# when the local-var tracker knows x's type, and at every instance when it
# doesn't (nothing reachable is missed).  ritz0: monomorph.py, _want_method.

struct WantedMethod
    base: *u8
    base_len: i32
    suffix: *u8          # "$i32"; null: every instance
    suffix_len: i32
    method: *u8
    method_len: i32
    next: *WantedMethod

var g_wanted_methods: *WantedMethod = null
var g_done_methods: *WantedMethod = null
# The instance whose impl method is being specialised ("W$i32"), for its
# bare `self` (collect_receiver_methods); 0 outside.
var g_impl_self_name: *u8 = null
var g_impl_self_len: i32 = 0

# 1 if an inherent generic impl of `base` (null: of any type) defines `meth`.
fn inherent_generic_method(m: *Module, base_sv: StrView, meth_sv: StrView) -> i32
    var base: *u8 = base_sv.ptr
    var base_len: i32 = base_sv.len as i32
    var meth: *u8 = meth_sv.ptr
    var meth_len: i32 = meth_sv.len as i32
    var ib: *ImplBlock = m.impls
    while ib != null
        if ib.type_params != null and (ib.trait_name == null or ib.trait_name_len == 0)
            if base == null or name_eq(StrView { ptr: (ib.type_name), len: (ib.type_name_len) as i64 }, StrView { ptr: (base), len: (base_len) as i64 }) == 1
                var f: *FnDef = ib.methods
                while f != null
                    if name_eq(StrView { ptr: (f.name), len: (f.name_len) as i64 }, StrView { ptr: (meth), len: (meth_len) as i64 }) == 1
                        return 1
                    f = f.next
        ib = ib.next
    0

fn wanted_in(list: *WantedMethod, base_sv: StrView, suffix_sv: StrView, meth_sv: StrView) -> i32
    var base: *u8 = base_sv.ptr
    var base_len: i32 = base_sv.len as i32
    var suffix: *u8 = suffix_sv.ptr
    var suffix_len: i32 = suffix_sv.len as i32
    var meth: *u8 = meth_sv.ptr
    var meth_len: i32 = meth_sv.len as i32
    var w: *WantedMethod = list
    while w != null
        if name_eq(StrView { ptr: (w.method), len: (w.method_len) as i64 }, StrView { ptr: (meth), len: (meth_len) as i64 }) == 1
            if w.suffix == null
                return 1
            if name_eq(StrView { ptr: (w.base), len: (w.base_len) as i64 }, StrView { ptr: (base), len: (base_len) as i64 }) == 1 and name_eq(StrView { ptr: (w.suffix), len: (w.suffix_len) as i64 }, StrView { ptr: (suffix), len: (suffix_len) as i64 }) == 1
                return 1
        w = w.next
    0

fn push_wanted(list: *WantedMethod, base_sv: StrView, suffix_sv: StrView, meth_sv: StrView) -> *WantedMethod
    var base: *u8 = base_sv.ptr
    var base_len: i32 = base_sv.len as i32
    var suffix: *u8 = suffix_sv.ptr
    var suffix_len: i32 = suffix_sv.len as i32
    var meth: *u8 = meth_sv.ptr
    var meth_len: i32 = meth_sv.len as i32
    let w: *WantedMethod = malloc(sizeof(WantedMethod)) as *WantedMethod
    w.base = base
    w.base_len = base_len
    w.suffix = suffix
    w.suffix_len = suffix_len
    w.method = meth
    w.method_len = meth_len
    w.next = list
    w

# A call names `meth` on an instance of type `tn` ("W$i32"; null: unknown).
fn want_method(m: *Module, tn_sv: StrView, meth_sv: StrView)
    var tn: *u8 = tn_sv.ptr
    var tn_len: i32 = tn_sv.len as i32
    var meth: *u8 = meth_sv.ptr
    var meth_len: i32 = meth_sv.len as i32
    if tn == null or tn_len <= 0
        if inherent_generic_method(m, StrView { ptr: (null), len: (0) as i64 }, StrView { ptr: (meth), len: (meth_len) as i64 }) == 1 and wanted_in(g_wanted_methods, StrView { ptr: (null), len: (0) as i64 }, StrView { ptr: (null), len: (0) as i64 }, StrView { ptr: (meth), len: (meth_len) as i64 }) == 0
            g_wanted_methods = push_wanted(g_wanted_methods, StrView { ptr: (null), len: (0) as i64 }, StrView { ptr: (null), len: (0) as i64 }, StrView { ptr: (meth), len: (meth_len) as i64 })
        return
    let d: i32 = find_dollar_sign(StrView { ptr: (tn), len: (tn_len) as i64 })
    if d <= 0 or inherent_generic_method(m, StrView { ptr: (tn), len: (d) as i64 }, StrView { ptr: (meth), len: (meth_len) as i64 }) == 0
        return
    if wanted_in(g_wanted_methods, StrView { ptr: (tn), len: (d) as i64 }, StrView { ptr: (tn + d), len: (tn_len - d) as i64 }, StrView { ptr: (meth), len: (meth_len) as i64 }) == 0
        g_wanted_methods = push_wanted(g_wanted_methods, StrView { ptr: (tn), len: (d) as i64 }, StrView { ptr: (tn + d), len: (tn_len - d) as i64 }, StrView { ptr: (meth), len: (meth_len) as i64 })

# "Vec$i32" / "Span$u8" for a Vec / Span of the tracker's kind and suffix.
fn collection_instance_name(kind: i32, suf_sv: StrView, out_len: *i32) -> *u8
    var suf: *u8 = suf_sv.ptr
    var suf_len: i32 = suf_sv.len as i32
    var base: *u8 = c"Vec"
    var bl: i32 = 3
    if kind == 2
        base = c"Span"
        bl = 4
    let tn: *u8 = malloc((bl + suf_len) as i64 + 1)
    memcpy(tn, base, bl as i64)
    memcpy(tn + bl, suf, suf_len as i64)
    *(tn + bl + suf_len) = 0
    *out_len = bl + suf_len
    tn

# The type a call `f(..)` returns, by name: a plain fn's (or an impl method's
# by its symbol, `String_from`), or a one-param generic fn's `Base$T` at the
# call's own suffix (`vec_new<i32>()` -> "Vec$i32").  null when unknown.
fn call_result_type_name(m: *Module, call: *Expr, out_len: *i32) -> *u8
    var f: *FnDef = find_fn_in_module(m, StrView { ptr: (call.func_name), len: (call.func_name_len) as i64 })
    if f == null
        f = find_impl_method_by_symbol(m, StrView { ptr: (call.func_name), len: (call.func_name_len) as i64 })
    if f == null or f.return_type_name == null or f.return_type_name_len <= 0
        return null
    if f.type_params == null
        *out_len = f.return_type_name_len
        return f.return_type_name
    let tp: *TypeParam = f.type_params
    if tp.next != null or call.call_type_suffix == null or call.call_type_suffix_len <= 0
        return null
    let d: i32 = find_dollar_sign(StrView { ptr: (f.return_type_name), len: (f.return_type_name_len) as i64 })
    if d <= 0 or name_eq(StrView { ptr: (f.return_type_name + d + 1), len: (f.return_type_name_len - d - 1) as i64 }, StrView { ptr: (tp.name), len: (tp.name_len) as i64 }) == 0
        return null
    let n: i32 = d + call.call_type_suffix_len
    let tn: *u8 = malloc(n as i64 + 1)
    memcpy(tn, f.return_type_name, d as i64)
    memcpy(tn + d, call.call_type_suffix, call.call_type_suffix_len as i64)
    *(tn + n) = 0
    *out_len = n
    tn

# The instance a method call's receiver is a value of ("W$i32"), or null when
# the tracker can't tell.  `&x`, `@x`, `*p` are x's / p's; `x`, `a.b`, `p[i]`
# of a Vec<Vec<T>> or a `[N]S` local, and a call's result are typed
# (AGAST #4231: ritzlib's `impl<T> Vec<T>` made every untyped `.push(..)`
# specialise `push` on every Vec instance, linking malloc into -nostdlib
# importers and move-checking `Vec<MoveOnly>`'s `get`).
fn receiver_instance(m: *Module, recv: *Expr, out_len: *i32) -> *u8
    var r: *Expr = recv
    while r != null and r.kind == EXPR_UNARY and (r.op == OP_ADDR or r.op == OP_ADDR_MUT or r.op == OP_DEREF)
        r = r.operand
    if r == null
        return null
    if r.kind == EXPR_IDENT
        let idx: i32 = find_local_var_idx(StrView { ptr: (r.ident_ptr), len: (r.ident_len) as i64 })
        if idx < 0
            return null
        if *(g_lv_prefix_kind + idx) == 0
            *out_len = *(g_lv_type_name_lens + idx)
            return *(g_lv_type_names + idx)
        return collection_instance_name(*(g_lv_prefix_kind + idx), StrView { ptr: (*(g_lv_suffixes + idx)), len: (*(g_lv_suffix_lens + idx)) as i64 }, out_len)
    if r.kind == EXPR_MEMBER
        let rf: *StructField = resolve_member_field(m, r)
        if rf == null or rf.field_type_name == null or rf.field_type_name_len <= 0
            return null
        *out_len = rf.field_type_name_len
        return rf.field_type_name
    if r.kind == EXPR_INDEX
        var esuf: *u8 = null
        var esuf_len: i32 = 0
        let ekind: i32 = indexed_element_collection(m, r, @esuf, @esuf_len)
        if ekind > 0
            return collection_instance_name(ekind, StrView { ptr: (esuf), len: (esuf_len) as i64 }, out_len)
        if r.left != null and r.left.kind == EXPR_IDENT and r.right != null and r.right.kind != EXPR_RANGE
            return array_local_elem(StrView { ptr: (r.left.ident_ptr), len: (r.left.ident_len) as i64 }, out_len)
        return null
    if r.kind == EXPR_CALL
        return call_result_type_name(m, r, out_len)
    if r.kind == EXPR_METHOD
        # `a.slice(0, 1).get(0)`: what the inner method returns at a's type.
        var il: i32 = 0
        let inner: *u8 = receiver_instance(m, r.left, @il)
        if inner == null or il <= 0
            return null
        return method_result_type_name(m, StrView { ptr: (inner), len: (il) as i64 }, StrView { ptr: (r.ident_ptr), len: (r.ident_len) as i64 }, out_len)
    null

# The type impl method `meth` of instance `tn` ("Vec$i32", or a plain "S")
# returns, by name: a one-param generic impl's `T` / `Base$T` at tn's suffix,
# or a concrete name as written.  null when unknown, or when the name still
# holds a type param this can't substitute.
fn method_result_type_name(m: *Module, tn_sv: StrView, meth_sv: StrView, out_len: *i32) -> *u8
    var tn: *u8 = tn_sv.ptr
    var tn_len: i32 = tn_sv.len as i32
    var meth: *u8 = meth_sv.ptr
    var meth_len: i32 = meth_sv.len as i32
    let d: i32 = find_dollar_sign(StrView { ptr: (tn), len: (tn_len) as i64 })
    var ib: *ImplBlock = m.impls
    while ib != null
        if ib.trait_name == null or ib.trait_name_len == 0
            let generic: i32 = (ib.type_params != null) as i32
            var hit: i32 = 0
            if generic == 1 and d > 0
                hit = name_eq(StrView { ptr: (ib.type_name), len: (ib.type_name_len) as i64 }, StrView { ptr: (tn), len: (d) as i64 })
            else if generic == 0
                hit = name_eq(StrView { ptr: (ib.type_name), len: (ib.type_name_len) as i64 }, StrView { ptr: (tn), len: (tn_len) as i64 })
            if hit == 1
                var f: *FnDef = ib.methods
                while f != null
                    if name_eq(StrView { ptr: (f.name), len: (f.name_len) as i64 }, StrView { ptr: (meth), len: (meth_len) as i64 }) == 1
                        return method_ret_at(ib, f, StrView { ptr: (tn), len: (tn_len) as i64 }, d, out_len)
                    f = f.next
        ib = ib.next
    null

fn method_ret_at(ib: *ImplBlock, f: *FnDef, tn_sv: StrView, d: i32, out_len: *i32) -> *u8
    var tn: *u8 = tn_sv.ptr
    var tn_len: i32 = tn_sv.len as i32
    let rn: *u8 = f.return_type_name
    let rl: i32 = f.return_type_name_len
    if rn == null or rl <= 0
        return null
    if ib.type_params == null
        *out_len = rl
        return rn
    let tp: *TypeParam = ib.type_params
    if tp.next != null
        return null
    if name_eq(StrView { ptr: (rn), len: (rl) as i64 }, StrView { ptr: (tp.name), len: (tp.name_len) as i64 }) == 1
        # `-> T`: the instance's own argument.
        *out_len = tn_len - d - 1
        return tn + d + 1
    let rd: i32 = find_dollar_sign(StrView { ptr: (rn), len: (rl) as i64 })
    if rd < 0
        *out_len = rl
        return rn   # a concrete type
    if name_eq(StrView { ptr: (rn + rd + 1), len: (rl - rd - 1) as i64 }, StrView { ptr: (tp.name), len: (tp.name_len) as i64 }) == 0
        return null
    let n: i32 = rd + tn_len - d
    let out: *u8 = malloc(n as i64 + 1)
    memcpy(out, rn, rd as i64)
    memcpy(out + rd, tn + d, (tn_len - d) as i64)
    *(out + n) = 0
    *out_len = n
    out

# `recv.meth(..)`: the instance the tracker types `recv` as, or every one.
fn want_receiver_method(m: *Module, recv: *Expr, meth_sv: StrView)
    var meth: *u8 = meth_sv.ptr
    var meth_len: i32 = meth_sv.len as i32
    if inherent_generic_method(m, StrView { ptr: (null), len: (0) as i64 }, StrView { ptr: (meth), len: (meth_len) as i64 }) == 0
        return
    var tn_len: i32 = 0
    let tn: *u8 = receiver_instance(m, recv, @tn_len)
    if tn == null or tn_len <= 0
        want_method(m, StrView { ptr: (null), len: (0) as i64 }, StrView { ptr: (meth), len: (meth_len) as i64 })
    else
        want_method(m, StrView { ptr: (tn), len: (tn_len) as i64 }, StrView { ptr: (meth), len: (meth_len) as i64 })

# The method calls in an expression: `a.m(b.n())` wants `m` and `n`.
fn want_methods_in(m: *Module, e: *Expr)
    if e == null
        return
    let k: i32 = e.kind
    if k == EXPR_METHOD
        want_receiver_method(m, e.left, StrView { ptr: (e.ident_ptr), len: (e.ident_len) as i64 })
    if k == EXPR_STRUCT_LIT or k == EXPR_MATCH or k == EXPR_IF
        return   # their args are no *Expr list; a placeholder holds none
    want_methods_in(m, e.left)
    want_methods_in(m, e.right)
    want_methods_in(m, e.operand)
    if k == EXPR_CALL or k == EXPR_METHOD or k == EXPR_ARRAY_LIT
        var a: *Expr = e.args
        while a != null
            want_methods_in(m, a)
            a = a.next

# print / eprint / format_into's "..." literal is split into its `{expr}`
# placeholders only when it is emitted (emitter_print.ritz), after this pass:
# `print("{b.get()}")` names `get` where no walk here sees it.  Parse each
# placeholder as the emitter will (interp.ritz) and want its method calls.
fn want_interp_methods(m: *Module, e: *Expr)
    if e.args == null
        return
    var lit: *Expr = null
    if name_eq(StrView { ptr: (e.func_name), len: (e.func_name_len) as i64 }, StrView { ptr: (c"print"), len: (5) as i64 }) == 1 or name_eq(StrView { ptr: (e.func_name), len: (e.func_name_len) as i64 }, StrView { ptr: (c"eprint"), len: (6) as i64 }) == 1
        lit = e.args
    else if name_eq(StrView { ptr: (e.func_name), len: (e.func_name_len) as i64 }, StrView { ptr: (c"format_into"), len: (11) as i64 }) == 1
        lit = e.args.next
    if lit == null or lit.kind != EXPR_STRING_LIT or lit.ident_ptr == null or lit.ident_len < 2
        return
    let body: *u8 = lit.ident_ptr + 1
    let n: i32 = lit.ident_len - 2
    var i: i32 = 0
    while i < n
        let c: i32 = *(body + i) as i32
        if c == '\\'   # `\x`: an escaped byte, never a brace
            i = i + 2
        else if (c == '{' or c == '}') and i + 1 < n and *(body + i + 1) as i32 == c
            i = i + 2   # `{{` / `}}`
        else if c == '{' and interp_match_brace(StrView { ptr: (body), len: (n) as i64 }, i) >= 0
            let close: i32 = interp_match_brace(StrView { ptr: (body), len: (n) as i64 }, i)
            var plen: i32 = close - i - 1
            let colon: i32 = interp_spec_colon(StrView { ptr: (body + i + 1), len: (plen) as i64 })   # `{expr:spec}` (AGAST #201)
            if colon >= 0
                plen = colon
            want_methods_in(m, interp_parse_expr(StrView { ptr: (body + i + 1), len: (plen) as i64 }, lit.span.line, lit.span.col))
            i = close + 1
        else
            i = i + 1

# Specialise each wanted inherent method of each instance so far, once.
# Returns how many it specialised: the fixpoint goes on while any are.
fn specialize_wanted_methods(m: *Module) -> i32
    if g_wanted_methods == null
        return 0
    var made: i32 = 0
    var si: i32 = 0
    # Instances this pass adds wait for the next round, after
    # specialize_pending_structs has checked their depth (MAX_INSTANCE_DEPTH).
    let end: i32 = g_struct_count
    while si < end and g_mono_errors == 0
        let name: *u8 = get_struct_instantiation_name(si)
        let name_len: i32 = get_struct_instantiation_name_len(si)
        let suffix: *u8 = get_struct_instantiation_suffix(si)
        let suffix_len: i32 = get_struct_instantiation_suffix_len(si)
        var ib: *ImplBlock = find_generic_impl(m.impls, StrView { ptr: (name), len: (name_len) as i64 })
        while ib != null
            if ib.trait_name == null or ib.trait_name_len == 0
                var method: *FnDef = ib.methods
                while method != null
                    if wanted_in(g_wanted_methods, StrView { ptr: (name), len: (name_len) as i64 }, StrView { ptr: (suffix), len: (suffix_len) as i64 }, StrView { ptr: (method.name), len: (method.name_len) as i64 }) == 1 and wanted_in(g_done_methods, StrView { ptr: (name), len: (name_len) as i64 }, StrView { ptr: (suffix), len: (suffix_len) as i64 }, StrView { ptr: (method.name), len: (method.name_len) as i64 }) == 0
                        g_done_methods = push_wanted(g_done_methods, StrView { ptr: (name), len: (name_len) as i64 }, StrView { ptr: (suffix), len: (suffix_len) as i64 }, StrView { ptr: (method.name), len: (method.name_len) as i64 })
                        g_cur_gen = *(g_struct_gens + si)
                        add_specialized_method(m, specialize_impl_method(m, ib, method, StrView { ptr: (name), len: (name_len) as i64 }, StrView { ptr: (suffix), len: (suffix_len) as i64 }))
                        made = made + 1
                    method = method.next
            ib = find_generic_impl(ib.next, StrView { ptr: (name), len: (name_len) as i64 })
        si = si + 1
    g_cur_gen = -1
    made

# Specialise one method of generic impl `ib` at `suffix`.  The method is
# specialised exactly as a generic fn whose type params are the impl's
# (clone_and_specialize_function: a `T` return becomes the argument, `*W<T>`
# becomes `*W$i32`, and multi-parameter impls are handled), then renamed to
# the method mangling `Type$suffix_method` (e.g. `Box$i64_set`).
fn specialize_impl_method(m: *Module, ib: *ImplBlock, method: *FnDef, type_name_sv: StrView, suffix_sv: StrView) -> *FnDef
    var type_name: *u8 = type_name_sv.ptr
    var type_name_len: i32 = type_name_sv.len as i32
    var suffix: *u8 = suffix_sv.ptr
    var suffix_len: i32 = suffix_sv.len as i32
    let template: *FnDef = malloc(sizeof(FnDef)) as *FnDef
    memcpy(template as *u8, method as *u8, sizeof(FnDef))
    template.type_params = ib.type_params
    let self_name: *u8 = malloc((type_name_len + suffix_len) as i64 + 1)
    memcpy(self_name, type_name, type_name_len as i64)
    memcpy(self_name + type_name_len, suffix, suffix_len as i64)
    *(self_name + type_name_len + suffix_len) = 0
    g_impl_self_name = self_name
    g_impl_self_len = type_name_len + suffix_len
    let specialized: *FnDef = clone_and_specialize_function(m, template, StrView { ptr: (suffix), len: (suffix_len) as i64 })
    g_impl_self_name = null
    g_impl_self_len = 0
    free(template as *u8)
    if specialized == null
        return null

    let mangled_name_len: i32 = type_name_len + suffix_len + 1 + method.name_len
    let mangled_name: *u8 = malloc(mangled_name_len as i64 + 1) as *u8
    var pos: i32 = 0
    for i in 0..type_name_len
        *(mangled_name + pos) = *(type_name + i)
        pos = pos + 1
    for j in 0..suffix_len
        *(mangled_name + pos) = *(suffix + j)
        pos = pos + 1
    *(mangled_name + pos) = 95  # '_'
    pos = pos + 1
    for k in 0..method.name_len
        *(mangled_name + pos) = *(method.name + k)
        pos = pos + 1
    *(mangled_name + pos) = 0
    specialized.name = mangled_name
    specialized.name_len = mangled_name_len
    # AGAST #2318: a bare `self` / `self:&` names no type, and impl_block_new
    # names it only in a non-generic impl.  Here it is this instance: the
    # mangled name up to its `_method` tail, e.g. `W$i32`.
    name_untyped_self(specialized.params, StrView { ptr: (mangled_name), len: (type_name_len + suffix_len) as i64 })
    specialized

# AGAST #2318: an untyped receiver becomes the typed one it means: bare `self`
# (param_self) is `self: T`, and bare `self:&` (param_self_lent) is `self:& T`,
# as param_self_borrow records it.
fn name_untyped_self(p: *Param, type_name_sv: StrView)
    var type_name: *u8 = type_name_sv.ptr
    var type_len: i32 = type_name_sv.len as i32
    if param_is_self(p) == 0 or p.param_type != TYPE_STRUCT or p.param_type_name_len > 0
        return
    p.param_type_name = type_name
    p.param_type_name_len = type_len
    if p.is_self_borrow == 1
        p.param_type = TYPE_MUT_REF
        p.param_pointee_type = TYPE_STRUCT

# ============================================================================
# Main Monomorphization Entry Point
# ============================================================================

pub fn monomorphize_module(m: *Module)
    g_tuple_module = m   # AGAST #2975: where tuple_subst puts a tuple it makes
    init_instantiation_tracker()
    init_local_var_tracker()

    # Collect all generic function and struct instantiations
    collect_instantiations_from_module(m)

    # Structs and fns are specialised to a fixpoint: specialising `vec_push<T>`
    # at u8 yields a fn whose signature names `Vec$u8`, which is a struct
    # instantiation that no call site spelled out; and specialising a struct
    # specialises its impl methods, which may name further instantiations.
    var s_done: i32 = 0
    var i: i32 = 0
    var made: i32 = 0
    while g_mono_errors == 0 and (s_done < g_struct_count or i < g_inst_count or made > 0)
        s_done = specialize_pending_structs(m, s_done)
        i = specialize_pending_fns(m, i)
        made = specialize_wanted_methods(m)   # AGAST #3617
    g_cur_gen = -1

# Errors monomorphize_module reported (AGAST #3330); main stops on any.
pub fn monomorph_errors() -> i32
    g_mono_errors

# AGAST #3330: `name` is still being instantiated MAX_INSTANCE_DEPTH
# generations deep.  Located at its first generic impl, whose methods are what
# name the deeper instance.  Without one, a generic fn `f<T>` calling
# `f<Cell<T>>` (AGAST #3343) is located at the fn's definition, as ritz0 does
# (monomorph.py, _recursion_error): a top-level fn starts at column 1.
fn refuse_recursive_instance(m: *Module, name_sv: StrView)
    var name: *u8 = name_sv.ptr
    var name_len: i32 = name_sv.len as i32
    let ib: *ImplBlock = find_generic_impl(m.impls, StrView { ptr: (name), len: (name_len) as i64 })
    var fd: *FnDef = null
    if ib == null
        fd = find_generic_function(m, StrView { ptr: (name), len: (name_len) as i64 })
    if ib != null and ib.def_file != null
        eprints_cstr(ib.def_file)
    else if fd != null and fd.def_file != null
        eprints_cstr(fd.def_file)
    else if struct_index_file() != null
        eprints_cstr(struct_index_file())
    else
        eprints_cstr(c"<input>")
    if ib != null
        eprint_char(':')
        eprint_i64(ib.impl_span.line as i64)
        eprint_char(':')
        eprint_i64(ib.impl_span.col as i64)
    else if fd != null and fd.line > 0
        eprint_char(':')
        eprint_i64(fd.line as i64)
        eprints_cstr(c":1")
    eprints_cstr(c": error: instantiating `")
    sys_write(2, name, name_len as i64)
    eprints_cstr(c"` recurses: ")
    if ib != null
        sys_write(2, name, name_len as i64)
        eprint_char('<')
        sys_write(2, name, name_len as i64)
        eprints_cstr(c"<...>> names a deeper instance at every level (stopped after ")
    else
        eprints_cstr(c"each instance names a deeper one (stopped after ")
    eprint_i64(MAX_INSTANCE_DEPTH as i64)
    eprints_cstr(c")\n")
    g_mono_errors += 1

# Specialise struct instantiations [start, g_struct_count); returns the new
# high-water mark.
fn specialize_pending_structs(m: *Module, start: i32) -> i32
    var si: i32 = start
    while si < g_struct_count
        let name: *u8 = get_struct_instantiation_name(si)
        let name_len: i32 = get_struct_instantiation_name_len(si)
        let suffix: *u8 = get_struct_instantiation_suffix(si)
        let suffix_len: i32 = get_struct_instantiation_suffix_len(si)
        g_cur_gen = *(g_struct_gens + si)
        si = si + 1
        if g_cur_gen >= MAX_INSTANCE_DEPTH
            refuse_recursive_instance(m, StrView { ptr: (name), len: (name_len) as i64 })
            return g_struct_count

        # Find the generic template
        let template: *StructDef = find_generic_struct(m, StrView { ptr: (name), len: (name_len) as i64 })
        if template != null
            # Generate specialized version
            let specialized: *StructDef = clone_and_specialize_struct(m, template, StrView { ptr: (suffix), len: (suffix_len) as i64 })

            # Add to module's struct list (prepend)
            if specialized != null
                specialized.next = m.structs
                m.structs = specialized
                collect_struct_types_from_fields(m, specialized.fields)

        # Specialise the type's generic impls: a struct's, or a generic enum
        # instance's, which add_enum_impl_instance queued with no struct
        # template (AGAST #3309).
        specialize_impl_methods(m, StrView { ptr: (name), len: (name_len) as i64 }, StrView { ptr: (suffix), len: (suffix_len) as i64 })

    si

# Specialise fn instantiations [start, g_inst_count); returns the new
# high-water mark.  Index-based because cloning adds instantiations as it goes
# (e.g., vec_push<T> calls vec_ensure_cap<T> which calls vec_grow<T>).
fn specialize_pending_fns(m: *Module, start: i32) -> i32
    if g_mono_errors > 0   # a struct was refused this round: report it alone
        return g_inst_count
    var i: i32 = start
    while i < g_inst_count
        let name: *u8 = get_instantiation_name(i)
        let name_len: i32 = get_instantiation_name_len(i)
        let suffix: *u8 = get_instantiation_suffix(i)
        let suffix_len: i32 = get_instantiation_suffix_len(i)
        g_cur_gen = *(g_inst_gens + i)
        if g_cur_gen >= MAX_INSTANCE_DEPTH
            refuse_recursive_instance(m, StrView { ptr: (name), len: (name_len) as i64 })
            return g_inst_count

        # Find the generic template
        let template: *FnDef = find_generic_function(m, StrView { ptr: (name), len: (name_len) as i64 })
        if template != null
            # Generate specialized version
            let specialized: *FnDef = clone_and_specialize_function(m, template, StrView { ptr: (suffix), len: (suffix_len) as i64 })

            # Add to module's function list
            if specialized != null
                # Find end of function list
                if m.functions == null
                    m.functions = specialized
                else
                    var f: *FnDef = m.functions
                    while f.next != null
                        f = f.next
                    f.next = specialized
                collect_struct_types_from_fn(m, specialized)
        i = i + 1

    i
