# ritz1/src/monomorph.ritz - Monomorphization pass for ritz1
#
# This pass transforms generic code into specialized (monomorphized) code.
# Each instantiation of a generic function with concrete type arguments
# results in a specialized version being generated.
#
# Example:
#     fn vec_new<T>() -> Vec<T>
#         ...
#     vec_new<u8>()  # Creates call to vec_new$u8
#
# After monomorphization, vec_new$u8 is generated from the template.

import ast
import ast_helpers
import struct_index   # AGAST #1635
import ritzlib.sys
import ritzlib.io
import ritzlib.str
import ritzlib.memory

# ============================================================================
# Instantiation Tracking
# ============================================================================
# Track generic function AND struct instantiations as (name, type_suffix) pairs

# Initial capacity; the fn and struct tables each grow by doubling (AGAST
# #1813).  add_instantiation used to return -1 when full and every caller
# ignored it, so instantiations past 256 were silently never specialised
# (#1325's root cause).
const INST_INIT_CAP: i32 = 256

# Function instantiation tracking (stored as parallel arrays for simplicity)
var g_inst_names: **u8 = null        # Function names
var g_inst_name_lens: *i32 = null
var g_inst_suffixes: **u8 = null     # Type suffixes ($u8, $i32, etc.)
var g_inst_suffix_lens: *i32 = null
var g_inst_count: i32 = 0
var g_inst_cap: i32 = 0

# Struct instantiation tracking (parallel arrays)
var g_struct_names: **u8 = null      # Struct names (e.g., "Pair", "Vec")
var g_struct_name_lens: *i32 = null
var g_struct_suffixes: **u8 = null   # Type suffixes ($i32, $u8, etc.)
var g_struct_suffix_lens: *i32 = null
var g_struct_count: i32 = 0
var g_struct_cap: i32 = 0

fn init_instantiation_tracker()
    # Initialize function tracking
    g_inst_cap = INST_INIT_CAP
    g_inst_names = malloc((g_inst_cap as i64) * 8) as **u8
    g_inst_name_lens = malloc((g_inst_cap as i64) * 4) as *i32
    g_inst_suffixes = malloc((g_inst_cap as i64) * 8) as **u8
    g_inst_suffix_lens = malloc((g_inst_cap as i64) * 4) as *i32
    g_inst_count = 0
    # Initialize struct tracking
    g_struct_cap = INST_INIT_CAP
    g_struct_names = malloc((g_struct_cap as i64) * 8) as **u8
    g_struct_name_lens = malloc((g_struct_cap as i64) * 4) as *i32
    g_struct_suffixes = malloc((g_struct_cap as i64) * 8) as **u8
    g_struct_suffix_lens = malloc((g_struct_cap as i64) * 4) as *i32
    g_struct_count = 0

fn add_instantiation(name: *u8, name_len: i32, suffix: *u8, suffix_len: i32) -> i32
    # Check if already tracked
    for i in 0..g_inst_count
        if *(g_inst_name_lens + i) == name_len and *(g_inst_suffix_lens + i) == suffix_len
            if memcmp(*(g_inst_names + i), name, name_len as i64) == 0
                if memcmp(*(g_inst_suffixes + i), suffix, suffix_len as i64) == 0
                    return 0  # Already tracked

    # Add new entry
    if g_inst_count >= g_inst_cap
        let cap: i64 = (g_inst_cap as i64) * 2
        g_inst_names = realloc(g_inst_names as *u8, cap * 8) as **u8
        g_inst_name_lens = realloc(g_inst_name_lens as *u8, cap * 4) as *i32
        g_inst_suffixes = realloc(g_inst_suffixes as *u8, cap * 8) as **u8
        g_inst_suffix_lens = realloc(g_inst_suffix_lens as *u8, cap * 4) as *i32
        g_inst_cap = cap as i32

    *(g_inst_names + g_inst_count) = name
    *(g_inst_name_lens + g_inst_count) = name_len
    *(g_inst_suffixes + g_inst_count) = suffix
    *(g_inst_suffix_lens + g_inst_count) = suffix_len
    g_inst_count = g_inst_count + 1
    return 1  # Added new

fn get_instantiation_count() -> i32
    g_inst_count

fn get_instantiation_name(idx: i32) -> *u8
    if idx >= g_inst_count
        return null
    *(g_inst_names + idx)

fn get_instantiation_name_len(idx: i32) -> i32
    if idx >= g_inst_count
        return 0
    *(g_inst_name_lens + idx)

fn get_instantiation_suffix(idx: i32) -> *u8
    if idx >= g_inst_count
        return null
    *(g_inst_suffixes + idx)

fn get_instantiation_suffix_len(idx: i32) -> i32
    if idx >= g_inst_count
        return 0
    *(g_inst_suffix_lens + idx)

# ============================================================================
# Struct Instantiation Tracking
# ============================================================================

fn add_struct_instantiation(name: *u8, name_len: i32, suffix: *u8, suffix_len: i32) -> i32
    # Check if already tracked
    for i in 0..g_struct_count
        if *(g_struct_name_lens + i) == name_len and *(g_struct_suffix_lens + i) == suffix_len
            if memcmp(*(g_struct_names + i), name, name_len as i64) == 0
                if memcmp(*(g_struct_suffixes + i), suffix, suffix_len as i64) == 0
                    return 0  # Already tracked

    # Add new entry
    if g_struct_count >= g_struct_cap
        let cap: i64 = (g_struct_cap as i64) * 2
        g_struct_names = realloc(g_struct_names as *u8, cap * 8) as **u8
        g_struct_name_lens = realloc(g_struct_name_lens as *u8, cap * 4) as *i32
        g_struct_suffixes = realloc(g_struct_suffixes as *u8, cap * 8) as **u8
        g_struct_suffix_lens = realloc(g_struct_suffix_lens as *u8, cap * 4) as *i32
        g_struct_cap = cap as i32

    *(g_struct_names + g_struct_count) = name
    *(g_struct_name_lens + g_struct_count) = name_len
    *(g_struct_suffixes + g_struct_count) = suffix
    *(g_struct_suffix_lens + g_struct_count) = suffix_len
    g_struct_count = g_struct_count + 1
    return 1  # Added new

fn get_struct_instantiation_count() -> i32
    g_struct_count

fn get_struct_instantiation_name(idx: i32) -> *u8
    if idx >= g_struct_count
        return null
    *(g_struct_names + idx)

fn get_struct_instantiation_name_len(idx: i32) -> i32
    if idx >= g_struct_count
        return 0
    *(g_struct_name_lens + idx)

fn get_struct_instantiation_suffix(idx: i32) -> *u8
    if idx >= g_struct_count
        return null
    *(g_struct_suffixes + idx)

fn get_struct_instantiation_suffix_len(idx: i32) -> i32
    if idx >= g_struct_count
        return 0
    *(g_struct_suffix_lens + idx)

# Find generic struct by name
fn find_generic_struct(m: *Module, name: *u8, name_len: i32) -> *StructDef
    var st: *StructDef = m.structs
    while st != null
        if st.type_params != null
            if st.name_len == name_len
                if memcmp(st.name, name, name_len as i64) == 0
                    return st
        st = st.next
    return null

# ============================================================================
# Local-var Type Tracking (per fn body, for UFCS-driven instantiation)
# ============================================================================
# When we see `var v = vec_new<u16>()` at the AST level, monomorph normally
# only records `vec_new$u16` (the explicit generic call).  But the later
# `v.push(...)` call is an EXPR_METHOD whose mangled fn name (`vec_push$u16`)
# is computed at emit time — without a hook here, we never collect that
# instantiation, the linker can't find `vec_push$u16`, and the UFCS dispatch
# in emitter_expr_call.ritz falls back to the broken `Vec$u16_push` mangling.
#
# Solution: walk fn bodies tracking which local vars hold Vec<T> / Span<T>
# (inferred from the initializer), then on every EXPR_METHOD with an IDENT
# receiver, register the corresponding `vec_<method>$<T>` / `span_<method>$<T>`
# instantiation when a matching generic template exists.

# Holds the Vec/Span locals AND the plain-struct locals (kind 0) that field
# receivers resolve through (AGAST #1512).  Grows by doubling: entries past
# the old fixed cap of 256 used to be dropped silently (AGAST #1813).
const LOCAL_VARS_INIT_CAP: i32 = 256

var g_lv_names: **u8 = null
var g_lv_name_lens: *i32 = null
var g_lv_prefix_kind: *i32 = null      # 0 = plain struct, 1 = Vec, 2 = Span
var g_lv_suffixes: **u8 = null         # The "$T" portion (with leading $)
var g_lv_suffix_lens: *i32 = null
var g_lv_type_names: **u8 = null       # Kind 0: the struct's name (e.g. "R")
var g_lv_type_name_lens: *i32 = null
var g_lv_by_value: *i32 = null         # 1: the local IS the struct, not *T / @T (AGAST #2451)
                                       # 2: a *T, @T or @&T of it, one level (AGAST #2448)
var g_lv_shared: *i32 = null           # 1: an `@T` param or local, which refuses writes (§3.2)
var g_lv_count: i32 = 0
var g_lv_cap: i32 = 0
var g_lv_initialized: i32 = 0

fn init_local_var_tracker()
    if g_lv_initialized == 1
        return
    g_lv_cap = LOCAL_VARS_INIT_CAP
    g_lv_names = malloc((g_lv_cap as i64) * 8) as **u8
    g_lv_name_lens = malloc((g_lv_cap as i64) * 4) as *i32
    g_lv_prefix_kind = malloc((g_lv_cap as i64) * 4) as *i32
    g_lv_suffixes = malloc((g_lv_cap as i64) * 8) as **u8
    g_lv_suffix_lens = malloc((g_lv_cap as i64) * 4) as *i32
    g_lv_type_names = malloc((g_lv_cap as i64) * 8) as **u8
    g_lv_type_name_lens = malloc((g_lv_cap as i64) * 4) as *i32
    g_lv_by_value = malloc((g_lv_cap as i64) * 4) as *i32
    g_lv_shared = malloc((g_lv_cap as i64) * 4) as *i32
    g_lv_initialized = 1
    g_lv_count = 0

# AGAST #2575: 1 once a param or local of the fn being walked is named like a
# non-generic UFCS type (`let String = 5`): its `String.new()` is a method on
# that value, which ritz0 refuses, so rewrite_static_ufcs_call leaves it be.
var g_ufcs_shadowed: i32 = 0

fn reset_local_var_tracker()
    g_lv_count = 0
    g_ufcs_shadowed = 0

fn note_ufcs_shadow(name: *u8, name_len: i32)
    var pl: i32 = 0
    if ufcs_non_generic_prefix(name, name_len, @pl) != null
        g_ufcs_shadowed = 1

fn add_local_var(name: *u8, name_len: i32, prefix_kind: i32, suffix: *u8, suffix_len: i32)
    if g_lv_count >= g_lv_cap
        let cap: i64 = (g_lv_cap as i64) * 2
        g_lv_names = realloc(g_lv_names as *u8, cap * 8) as **u8
        g_lv_name_lens = realloc(g_lv_name_lens as *u8, cap * 4) as *i32
        g_lv_prefix_kind = realloc(g_lv_prefix_kind as *u8, cap * 4) as *i32
        g_lv_suffixes = realloc(g_lv_suffixes as *u8, cap * 8) as **u8
        g_lv_suffix_lens = realloc(g_lv_suffix_lens as *u8, cap * 4) as *i32
        g_lv_type_names = realloc(g_lv_type_names as *u8, cap * 8) as **u8
        g_lv_type_name_lens = realloc(g_lv_type_name_lens as *u8, cap * 4) as *i32
        g_lv_by_value = realloc(g_lv_by_value as *u8, cap * 4) as *i32
        g_lv_shared = realloc(g_lv_shared as *u8, cap * 4) as *i32
        g_lv_cap = cap as i32
    *(g_lv_names + g_lv_count) = name
    *(g_lv_name_lens + g_lv_count) = name_len
    *(g_lv_prefix_kind + g_lv_count) = prefix_kind
    *(g_lv_suffixes + g_lv_count) = suffix
    *(g_lv_suffix_lens + g_lv_count) = suffix_len
    *(g_lv_type_names + g_lv_count) = null
    *(g_lv_type_name_lens + g_lv_count) = 0
    *(g_lv_by_value + g_lv_count) = 0
    *(g_lv_shared + g_lv_count) = 0
    g_lv_count = g_lv_count + 1

# The local just added holds the struct itself, not a pointer to one.
fn mark_last_local_by_value()
    if g_lv_count > 0
        *(g_lv_by_value + g_lv_count - 1) = 1

# Record a local/param whose type is a (non-collection) struct or a pointer
# or reference to one, so a field receiver rooted at it — `r.raw.push(9)` —
# can resolve the field's type (AGAST #1512).  Kind 0 never matches a UFCS
# prefix, so the ident-receiver path ignores these entries.
fn add_local_struct_var(name: *u8, name_len: i32, type_name: *u8, type_name_len: i32)
    if type_name == null or type_name_len <= 0
        return
    add_local_var(name, name_len, 0, null, 0)
    *(g_lv_type_names + g_lv_count - 1) = type_name
    *(g_lv_type_name_lens + g_lv_count - 1) = type_name_len

# Record a binding of type `type_kind`/`type_name`: Vec/Span by-value go to
# the UFCS kinds; any other named struct (by value, *T, @T, @&T) is kind 0.
fn track_typed_local(name: *u8, name_len: i32, type_kind: i32, type_name: *u8, type_name_len: i32)
    if type_name == null or type_name_len <= 0
        return
    if type_kind != TYPE_STRUCT and type_kind != TYPE_PTR and type_kind != TYPE_REF and type_kind != TYPE_MUT_REF
        return
    var suf: *u8 = null
    var suf_len: i32 = 0
    let kind: i32 = classify_collection_type(type_name, type_name_len, @suf, @suf_len)
    if kind > 0
        # By value or through *T / @T / @&T alike: the emitter's UFCS
        # dispatch loads a pointer receiver itself, so `points:& Vec<P>`
        # needs `vec_slice$P` registered just as a local Vec would
        # (angelo's `points[:]`, AGAST #1794).
        add_local_var(name, name_len, kind, suf, suf_len)
    else
        add_local_struct_var(name, name_len, type_name, type_name_len)
    if type_kind == TYPE_STRUCT
        mark_last_local_by_value()

# track_typed_local, and a `*T`, `@T` or `@&T` whose pointee is the struct
# itself (not `**T`) is marked as one, so `p[lo..hi]` can slice what it points
# at (AGAST #2448).  `pointee` is the param's or let's pointee type.
fn track_typed_local_through(name: *u8, name_len: i32, type_kind: i32, pointee: i32, type_name: *u8, type_name_len: i32)
    note_ufcs_shadow(name, name_len)   # every param comes through here (AGAST #2575)
    let before: i32 = g_lv_count
    track_typed_local(name, name_len, type_kind, type_name, type_name_len)
    if g_lv_count == before or pointee != TYPE_STRUCT
        return
    if type_kind == TYPE_PTR or type_kind == TYPE_REF or type_kind == TYPE_MUT_REF
        *(g_lv_by_value + g_lv_count - 1) = 2
    if type_kind == TYPE_REF
        *(g_lv_shared + g_lv_count - 1) = 1

# Un-annotated `let p = @v` / `@&v` of a by-value Vec, Span or String local:
# `p` points at it, one level, as `let p: @Vec<T> = @v` would (AGAST #2448).
fn track_address_of_local(name: *u8, name_len: i32, of: *Expr)
    if of == null or of.kind != EXPR_IDENT
        return
    let idx: i32 = find_local_var_idx(of.ident_ptr, of.ident_len)
    if idx < 0 or *(g_lv_by_value + idx) != 1
        return
    add_local_var(name, name_len, *(g_lv_prefix_kind + idx), *(g_lv_suffixes + idx), *(g_lv_suffix_lens + idx))
    *(g_lv_type_names + g_lv_count - 1) = *(g_lv_type_names + idx)
    *(g_lv_type_name_lens + g_lv_count - 1) = *(g_lv_type_name_lens + idx)
    *(g_lv_by_value + g_lv_count - 1) = 2

# Resolve the type of the field named by an EXPR_MEMBER chain rooted at a
# tracked local: `r.raw` → "Vec$u8", `o.q.a` → "A".  Emits nothing.  Returns
# the *StructField, or null when any link is unknown.  (AGAST #1512)
fn resolve_member_field(m: *Module, e: *Expr) -> *StructField
    if e == null or e.kind != EXPR_MEMBER or e.left == null
        return null
    var sname: *u8 = null
    var sname_len: i32 = 0
    if e.left.kind == EXPR_IDENT
        let idx: i32 = find_local_var_idx(e.left.ident_ptr, e.left.ident_len)
        if idx >= 0
            sname = *(g_lv_type_names + idx)
            sname_len = *(g_lv_type_name_lens + idx)
    else if e.left.kind == EXPR_MEMBER
        let parent: *StructField = resolve_member_field(m, e.left)
        if parent != null
            if parent.field_type == TYPE_STRUCT or parent.field_type == TYPE_PTR
                sname = parent.field_type_name
                sname_len = parent.field_type_name_len
    if sname == null or sname_len <= 0
        return null
    let st: *StructDef = find_concrete_struct(m, sname, sname_len)
    if st == null
        return template_member_field(m, sname, sname_len, e)
    var f: *StructField = st.fields
    while f != null
        if f.name_len == e.ident_len
            if memcmp(f.name, e.ident_ptr, e.ident_len as i64) == 0
                return f
        f = f.next
    return null

# AGAST #2411: field `e` of `B$i32` before it's specialised (instantiations are
# collected first): the one-parameter template's field, with a `Vec$T` type
# rewritten to `Vec$i32`, so `b.v.push(3)` instantiates `vec_push$i32`.  null
# for anything else.
fn template_member_field(m: *Module, sname: *u8, sname_len: i32, e: *Expr) -> *StructField
    let dollar: i32 = find_dollar_sign(sname, sname_len)
    if dollar <= 0
        return null
    let tmpl: *StructDef = find_generic_struct(m, sname, dollar)
    if tmpl == null or count_type_params(tmpl.type_params) != 1
        return null
    var f: *StructField = tmpl.fields
    while f != null
        if f.name_len == e.ident_len and memcmp(f.name, e.ident_ptr, e.ident_len as i64) == 0
            break
        f = f.next
    if f == null or f.field_type != TYPE_STRUCT or f.field_type_name == null
        return null
    if find_dollar_sign(f.field_type_name, f.field_type_name_len) <= 0
        return null
    let out: *StructField = malloc(sizeof(StructField)) as *StructField
    memcpy(out as *u8, f as *u8, sizeof(StructField))
    var sub_len: i32 = 0
    substitute_type_param_in_name(f.field_type_name, f.field_type_name_len, tmpl.type_params.name, tmpl.type_params.name_len, sname + dollar, sname_len - dollar, @out.field_type_name, @sub_len)
    out.field_type_name_len = sub_len
    out.next = null
    out

# The generic UFCS template `<prefix><method>` (vec_/span_) a method call on
# a Vec/Span receiver of the given kind dispatches to, or null.
fn find_ufcs_template(m: *Module, kind: i32, method: *u8, method_len: i32) -> *FnDef
    var prefix: *u8 = null
    var prefix_len: i32 = 0
    if kind == 1
        prefix = c"vec_"
        prefix_len = 4
    else if kind == 2
        prefix = c"span_"
        prefix_len = 5
    if prefix_len == 0
        return null
    let mangled_len: i32 = prefix_len + method_len
    let mangled: *u8 = malloc(mangled_len as i64 + 1) as *u8
    for i in 0..prefix_len
        *(mangled + i) = *(prefix + i)
    for i in 0..method_len
        *(mangled + prefix_len + i) = *(method + i)
    *(mangled + mangled_len) = 0
    let tmpl: *FnDef = find_generic_function(m, mangled, mangled_len)
    free(mangled)
    return tmpl

# Register `<prefix><method>$T` (vec_/span_) for a UFCS call on a Vec/Span
# receiver of the given kind and "$T" suffix, if that generic template exists.
fn register_ufcs_instantiation(m: *Module, kind: i32, suf: *u8, suf_len: i32, method: *u8, method_len: i32)
    if suf == null or suf_len <= 0
        return
    let tmpl: *FnDef = find_ufcs_template(m, kind, method, method_len)
    if tmpl != null
        add_instantiation(tmpl.name, tmpl.name_len, suf, suf_len)

# AGAST #1798: record an un-annotated local initialised by a method call on a
# tracked ident receiver -- `var s = a.slice(0, n)`, `var s = a[:]` (which
# lowers to that call), `var v = b.items()` -- so a later `s.push(..)`
# instantiates `vec_push$T` even when no other receiver calls push.
fn track_method_init_local(m: *Module, name: *u8, name_len: i32, init: *Expr)
    if init.left == null or init.left.kind != EXPR_IDENT
        return
    let idx: i32 = find_local_var_idx(init.left.ident_ptr, init.left.ident_len)
    if idx < 0
        return
    let kind: i32 = *(g_lv_prefix_kind + idx)
    if kind > 0
        # Vec/Span receiver: a UFCS template returning its own collection
        # over its type parameter (`vec_slice<T> -> Vec<T>`, "Vec$T") gives
        # that collection at the receiver's suffix.
        let tmpl: *FnDef = find_ufcs_template(m, kind, init.ident_ptr, init.ident_len)
        if tmpl == null or tmpl.return_type != TYPE_STRUCT or tmpl.type_params == null
            return
        var rsuf: *u8 = null
        var rsuf_len: i32 = 0
        let rkind: i32 = classify_collection_type(tmpl.return_type_name, tmpl.return_type_name_len, @rsuf, @rsuf_len)
        let tp: *TypeParam = tmpl.type_params
        if rkind > 0 and rsuf_len == tp.name_len + 1
            if memcmp(rsuf + 1, tp.name, tp.name_len as i64) == 0
                add_local_var(name, name_len, rkind, *(g_lv_suffixes + idx), *(g_lv_suffix_lens + idx))
                mark_last_local_by_value()
        return
    # Struct receiver (by value or pointer): its non-generic impl method's
    # return type, recorded like an annotation of that type.
    let tn: *u8 = *(g_lv_type_names + idx)
    let tn_len: i32 = *(g_lv_type_name_lens + idx)
    # `s.slice(lo, hi)` on a String is string_slice, a String (no impl method
    # says so), and what `let t = s[lo..hi]` became (AGAST #2451).
    if buf_eq(tn, tn_len, c"String", 6) == 1 and buf_eq(init.ident_ptr, init.ident_len, c"slice", 5) == 1
        track_typed_local(name, name_len, TYPE_STRUCT, c"String", 6)
        return
    var ib: *ImplBlock = m.impls
    while ib != null
        if ib.type_params == null and ib.type_name_len == tn_len
            if memcmp(ib.type_name, tn, tn_len as i64) == 0
                var meth: *FnDef = ib.methods
                while meth != null
                    if meth.name_len == init.ident_len
                        if memcmp(meth.name, init.ident_ptr, init.ident_len as i64) == 0
                            track_typed_local(name, name_len, meth.return_type, meth.return_type_name, meth.return_type_name_len)
                            return
                    meth = meth.next
        ib = ib.next

fn find_local_var_idx(name: *u8, name_len: i32) -> i32
    for i in 0..g_lv_count
        if *(g_lv_name_lens + i) == name_len
            if memcmp(*(g_lv_names + i), name, name_len as i64) == 0
                return i
    return -1

# If `type_name` is a Vec$T or Span$T mangled name, return the prefix kind
# (1 = Vec, 2 = Span) and write the inner suffix (with leading $) to out.
# Returns 0 if no match.
fn classify_collection_type(type_name: *u8, type_name_len: i32, out_suffix: **u8, out_suffix_len: *i32) -> i32
    if type_name == null or type_name_len < 5
        return 0
    # "Vec$..." → kind 1, suffix starts at index 3
    if *(type_name + 0) == 86 and *(type_name + 1) == 101 and *(type_name + 2) == 99 and *(type_name + 3) == 36
        *out_suffix = type_name + 3
        *out_suffix_len = type_name_len - 3
        return 1
    # "Span$..." → kind 2, suffix starts at index 4 (need 6+ bytes)
    if type_name_len >= 6
        if *(type_name + 0) == 83 and *(type_name + 1) == 112 and *(type_name + 2) == 97 and *(type_name + 3) == 110 and *(type_name + 4) == 36
            *out_suffix = type_name + 4
            *out_suffix_len = type_name_len - 4
            return 2
    return 0

# Walk module functions looking for any (generic or specialized) fn matching
# the given name.  Used during collection to resolve a var-decl initializer
# call's return type so we can infer the local var's struct type.
fn find_fn_in_module(m: *Module, name: *u8, name_len: i32) -> *FnDef
    var f: *FnDef = m.functions
    while f != null
        if f.name_len == name_len
            if memcmp(f.name, name, name_len as i64) == 0
                return f
        f = f.next
    return null

# ============================================================================
# Instantiation Collection
# ============================================================================
# Walk the AST to find all generic function and struct instantiations

# Check if a name contains '$' (indicating a mangled generic)
# Returns the position of '$' or -1 if not found
fn find_dollar_sign(name: *u8, len: i32) -> i32
    for i in 0..len
        if *(name + i) == 36  # '$'
            return i
    return -1

# Add struct instantiation from a mangled name like "Pair$i32"
# Splits on '$' to get base name and suffix
fn add_struct_from_mangled_name(m: *Module, name: *u8, len: i32)
    let dollar_pos: i32 = find_dollar_sign(name, len)
    if dollar_pos <= 0
        return  # Not a mangled name

    let base_name: *u8 = name
    let base_len: i32 = dollar_pos

    # Only add if this is actually a generic struct template
    let template: *StructDef = find_generic_struct(m, base_name, base_len)
    if template == null
        return  # Not a generic struct we know about

    # Create suffix including the '$'
    let suffix: *u8 = name + dollar_pos
    let suffix_len: i32 = len - dollar_pos

    # AGAST #1574: a multi-parameter template needs exactly one argument per
    # parameter.  (Unlike `Vec$T` below, no placeholder check: nothing
    # registers a `Pair$T$i64` today — see AGAST #1582.)
    if count_type_params(template.type_params) >= 2
        let cap: i64 = 4 * mangled_arg_capacity(suffix, suffix_len) as i64
        let starts: *i32 = malloc(cap) as *i32
        let lens: *i32 = malloc(cap) as *i32
        if split_mangled_args(m, suffix, suffix_len, starts, lens) == count_type_params(template.type_params)
            add_struct_instantiation(base_name, base_len, suffix, suffix_len)
        return

    # `Vec$T`: the unsubstituted placeholder of a generic signature, not an
    # instantiation.  A lone ASCII capital after `$` is a type parameter —
    # unless the module defines a concrete struct by that name: `Vec<P>` for
    # a user `struct P` mangles to `Vec$P`, the same shape (AGAST #1487).
    # Or a user `enum C`: `Vec<C>` is `Vec$C` too, and taking it for the
    # placeholder left `Vec$C` with no struct, so `vec_get<C>` and every
    # `v.len` on it was `unhandled EXPR_MEMBER` (AGAST #2411).
    if suffix_len == 2
        let ch: i32 = *(suffix + 1) as i32
        if ch >= 65 and ch <= 90
            if find_concrete_struct(m, suffix + 1, 1) == null and names_concrete_enum(suffix + 1, 1) == 0
                return

    add_struct_instantiation(base_name, base_len, suffix, suffix_len)

# ----------------------------------------------------------------------------
# Multi-parameter generic structs (AGAST #1574)
# ----------------------------------------------------------------------------
# The parser mangles EVERY type argument, `$`-separated: `Pair<i64, i32>` is
# `Pair$i64$i32` and `Pair<i64, Box<i64>>` is `Pair$i64$Box$i64`.  Nested
# generics share the separator, so splitting a suffix into its arguments
# needs each component's arity: `Box` (one parameter) owns the `$i64` after
# it.  Single-parameter templates never split — their whole suffix is the
# one argument, exactly as before #1574.

# AGAST #1906: no fixed cap on type arguments (it was 8, and a 9th dropped the
# instantiation, so the program failed at link).  Every argument starts with
# its own `$`, so the suffix's `$` count bounds the argument count; callers
# size split_mangled_args' starts/lens buffers with it.
fn mangled_arg_capacity(suffix: *u8, suffix_len: i32) -> i32
    var n: i32 = 0
    for i in 0..suffix_len
        if *(suffix + i) == 36   # '$'
            n = n + 1
    if n == 0
        return 1
    n

fn count_type_params(tp: *TypeParam) -> i32
    var n: i32 = 0
    var cur: *TypeParam = tp
    while cur != null
        n = n + 1
        cur = cur.next
    n

# Arity of the generic type named by one `$`-component of a mangled name: a
# generic struct template's parameter count, or Result/Option's (ritz1 keeps
# no enum definitions, but their mangled names nest like structs).  0 for a
# primitive or a concrete struct: a leaf.
fn mangled_component_arity(m: *Module, name: *u8, len: i32) -> i32
    let t: *StructDef = find_generic_struct(m, name, len)
    if t != null
        return count_type_params(t.type_params)
    if len == 6 and memcmp(name, c"Result", 6) == 0
        return 2
    if len == 6 and memcmp(name, c"Option", 6) == 0
        return 1
    0

# End (exclusive) of the mangled type argument that starts at s[pos]: its
# first component plus, if that names a generic, one nested argument per
# parameter.  Stops early at the end of a truncated name.
fn mangled_arg_end(m: *Module, s: *u8, len: i32, pos: i32) -> i32
    var end: i32 = pos
    while end < len and *(s + end) != 36   # '$'
        end = end + 1
    let arity: i32 = mangled_component_arity(m, s + pos, end - pos)
    for k in 0..arity
        if end >= len
            return end
        end = mangled_arg_end(m, s, len, end + 1)
    end

# Split a suffix "$a1$a2..." into its top-level arguments.  Each
# (suffix + starts[i], lens[i]) is itself a one-argument suffix "$ai", the
# form parse_type_from_suffix / get_type_name_from_suffix take.  Returns the
# argument count, or -1 for a malformed suffix.  starts/lens must hold
# mangled_arg_capacity(suffix, suffix_len) entries.
fn split_mangled_args(m: *Module, suffix: *u8, suffix_len: i32, starts: *i32, lens: *i32) -> i32
    var n: i32 = 0
    var pos: i32 = 0
    while pos < suffix_len
        if *(suffix + pos) != 36   # '$'
            return -1
        let end: i32 = mangled_arg_end(m, suffix, suffix_len, pos + 1)
        *(starts + n) = pos
        *(lens + n) = end - pos
        n = n + 1
        pos = end
    n

# Index of the type parameter named (name, len), or -1.
fn type_param_index(tp: *TypeParam, name: *u8, len: i32) -> i32
    var i: i32 = 0
    var cur: *TypeParam = tp
    while cur != null
        if cur.name_len == len and memcmp(cur.name, name, len as i64) == 0
            return i
        i = i + 1
        cur = cur.next
    -1

# Rewrite a mangled name, replacing every `$`-component that is a type
# parameter with its argument: `Box$B` at <A=i64, B=i32> is `Box$i32`.
# Returns `name` itself when no component is a parameter.
fn substitute_params_in_mangled(tp: *TypeParam, suffix: *u8, starts: *i32, lens: *i32, name: *u8, len: i32, out_len: *i32) -> *u8
    # Pass 1: the rewritten length (0 extra when nothing matches).
    var total: i32 = 0
    var hit: i32 = 0
    var pos: i32 = 0
    while pos <= len
        var end: i32 = pos
        while end < len and *(name + end) != 36
            end = end + 1
        let idx: i32 = type_param_index(tp, name + pos, end - pos)
        if idx >= 0
            hit = 1
            total = total + *(lens + idx) - 1
        else
            total = total + end - pos
        if end < len
            total = total + 1
        pos = end + 1
    if hit == 0
        *out_len = len
        return name
    # Pass 2: build it.
    let out: *u8 = malloc(total as i64 + 1) as *u8
    var o: i32 = 0
    pos = 0
    while pos <= len
        var end: i32 = pos
        while end < len and *(name + end) != 36
            end = end + 1
        let idx: i32 = type_param_index(tp, name + pos, end - pos)
        if idx >= 0
            let a: *u8 = suffix + *(starts + idx) + 1
            let a_len: i32 = *(lens + idx) - 1
            for j in 0..a_len
                *(out + o) = *(a + j)
                o = o + 1
        else
            for j in pos..end
                *(out + o) = *(name + j)
                o = o + 1
        if end < len
            *(out + o) = 36
            o = o + 1
        pos = end + 1
    *(out + o) = 0
    *out_len = o
    out

# 1 if (name, len) is a non-generic enum the module declares (AGAST #2411).
fn names_concrete_enum(name: *u8, len: i32) -> i32
    let ei: i32 = enum_find(name, len)
    if ei < 0 or enum_is_generic(ei) == 1
        return 0
    1

# Find a non-generic struct by name.
fn find_concrete_struct(m: *Module, name: *u8, name_len: i32) -> *StructDef
    var st: *StructDef = m.structs
    while st != null
        if st.type_params == null
            if st.name_len == name_len
                if memcmp(st.name, name, name_len as i64) == 0
                    return st
        st = st.next
    return null

# Register the generic-struct instantiations named by a fn's signature.
# Every type kind counts, not just by-value TYPE_STRUCT: `v: @&Vec<T>`
# specialised at u8 is a TYPE_REF named `Vec$u8`, and the body's `v.len`
# needs `struct Vec$u8` to exist.  ritz1 used to paper over this with a
# hard-coded Vec$u8/i32/... layout table (AGAST #1440); without it, the
# layout must come from instantiating `struct Vec<T>`.
fn collect_struct_types_from_signature(m: *Module, f: *FnDef)
    if f.return_type_name != null
        add_struct_from_mangled_name(m, f.return_type_name, f.return_type_name_len)
    var p: *Param = f.params
    while p != null
        if p.param_type_name != null
            add_struct_from_mangled_name(m, p.param_type_name, p.param_type_name_len)
        p = p.next

# Same, for a specialised fn: its signature and every var-decl type in its
# body.  Only struct instantiations are gathered here — fn instantiations in
# a specialised body are registered by clone_body as it substitutes them.
fn collect_struct_types_from_fn(m: *Module, f: *FnDef)
    collect_struct_types_from_signature(m, f)
    collect_struct_types_from_stmts(m, f.body)

# AGAST #2411: a specialised struct's by-value fields, `B$usize.v: Vec$usize`:
# the field's layout must exist even when no fn names it.
fn collect_struct_types_from_fields(m: *Module, f: *StructField)
    var cur: *StructField = f
    while cur != null
        if cur.field_type == TYPE_STRUCT and cur.field_type_name != null
            add_struct_from_mangled_name(m, cur.field_type_name, cur.field_type_name_len)
        cur = cur.next

fn collect_struct_types_from_stmts(m: *Module, body: *Stmt)
    var s: *Stmt = body
    while s != null
        let k: i32 = s.kind
        if k == STMT_VAR_DECL
            if s.var_type_name != null
                add_struct_from_mangled_name(m, s.var_type_name, s.var_type_name_len)
        else if k == STMT_IF
            collect_struct_types_from_stmts(m, s.if_then)
            collect_struct_types_from_stmts(m, s.if_else)
        else if k == STMT_WHILE or k == STMT_LOOP or k == STMT_DEFER
            collect_struct_types_from_stmts(m, s.while_body)
        else if k == STMT_FOR
            collect_struct_types_from_stmts(m, s.for_body)
        s = s.next

fn collect_instantiations_from_module(m: *Module)
    # Walk all non-generic functions to find instantiations
    var f: *FnDef = m.functions
    while f != null
        if f.type_params == null
            collect_struct_types_from_signature(m, f)
            # Reset local-var tracker per fn body, then seed from fn params so
            # `fn foo(v: Vec<T>)` lets `v.push(...)` resolve UFCS-style.
            reset_local_var_tracker()
            var pp: *Param = f.params
            while pp != null
                track_typed_local_through(pp.name, pp.name_len, pp.param_type, pp.param_pointee_type, pp.param_type_name, pp.param_type_name_len)
                pp = pp.next
            # Walk function body
            collect_from_fn_body(m, f.body)
        f = f.next

    # Walk impl block methods.  Skip generic impl blocks (those with
    # type_params != null) — their methods are templates whose bodies
    # reference the type parameter directly (e.g. `span_len<T>(self)` in
    # `impl<T> Span<T>`).  Walking them would register bogus
    # ("span_len", "$T") instantiations that get specialised into
    # broken `span_len$T` functions with unsubstituted T references.
    # Methods on generic impls get specialised via specialize_impl_methods
    # once the parent struct is instantiated for a concrete type.
    var ib: *ImplBlock = m.impls
    while ib != null
        if ib.type_params == null
            var method: *FnDef = ib.methods
            while method != null
                reset_local_var_tracker()
                var ipp: *Param = method.params
                while ipp != null
                    if ipp.is_self_borrow == 1 and ipp.param_type_name_len == 0
                        # AGAST #2562: a bare `self:&` names no type (the
                        # emitter takes it from the ImplBlock), so seed it as
                        # the `@&T` it is, or `self.v.push(s)` never
                        # registers `vec_push$S`.
                        track_typed_local_through(ipp.name, ipp.name_len, TYPE_MUT_REF, TYPE_STRUCT, ib.type_name, ib.type_name_len)
                    else
                        track_typed_local_through(ipp.name, ipp.name_len, ipp.param_type, ipp.param_pointee_type, ipp.param_type_name, ipp.param_type_name_len)
                    ipp = ipp.next
                collect_from_fn_body(m, method.body)
                method = method.next
        ib = ib.next

    # Walk global variable types — `var g: Vec<String>` at module scope
    # needs Vec$String instantiated just like a let-binding does.  Without
    # this, idiomatic main.ritz's `var g_processed: Vec<String>` left
    # Vec$String un-instantiated and the self-hosted bootstrap died with
    # "ERROR: unhandled EXPR_MEMBER" inside vec_len$String.
    var g: *GlobalVarDef = m.globals
    while g != null
        if g.type_name != null
            add_struct_from_mangled_name(m, g.type_name, g.type_name_len)
        g = g.next

    # Walk concrete struct field types — `struct ParsedArgs` with a
    # `Vec<ArgSlot>` field needs Vec$ArgSlot for its own `%ParsedArgs` type
    # decl, which every importer emits.  This used to be found only by
    # walking the bodies that USE the struct; since G9b (AGAST #1899) an
    # import's bodies are stripped, and field types are its interface.
    var st: *StructDef = m.structs
    while st != null
        if st.type_params == null
            var fld: *StructField = st.fields
            while fld != null
                if fld.field_type_name != null
                    add_struct_from_mangled_name(m, fld.field_type_name, fld.field_type_name_len)
                if fld.array_elem_type_name != null
                    add_struct_from_mangled_name(m, fld.array_elem_type_name, fld.array_elem_type_name_len)
                fld = fld.next
        st = st.next

fn collect_from_fn_body(m: *Module, body: *Stmt)
    var s: *Stmt = body
    while s != null
        collect_from_stmt(m, s)
        s = s.next

fn collect_from_stmt(m: *Module, s: *Stmt)
    rewrite_struct_index_stmt(m, s)   # AGAST #1635
    note_compound_calls(s)            # AGAST #2529, after the rewrite above
    let k: i32 = s.kind
    if k == STMT_EXPR
        collect_from_expr(m, s.expr)
    else if k == STMT_VAR_DECL
        # Before tracking: `let t = v[1..3]` is `let t = v.slice(1, 3)`, so `t`
        # is tracked as that call's result (AGAST #2451).
        if s.var_init != null
            if slice_into_span_annotation(m, s) == 1
                g_slice_kept = s.var_init
            rewrite_value_slice(m, s.var_init)
            rewrite_static_ufcs_call(m, s.var_init)   # AGAST #2575
        note_ufcs_shadow(s.var_name, s.var_name_len)
        # Check if variable type is a generic struct — by value or behind a
        # pointer/reference (`var v: *Vec<u8>` needs Vec$u8 just the same).
        if s.var_type_name != null
            add_struct_from_mangled_name(m, s.var_type_name, s.var_type_name_len)
        # Record local-var → Vec/Span suffix mapping for UFCS-driven generic
        # instantiation.  Two paths:
        #   1. Explicit annotation: `var v: Vec<u16>` — var_type_name="Vec$u16"
        #   2. Inferred from EXPR_CALL initializer: `var v = vec_new<u16>()`
        #      — look up the called fn's return type (which for a generic
        #      template is "Vec$T"; substitute T with the call's type suffix).
        var lv_kind: i32 = 0
        var lv_suf: *u8 = null
        var lv_suf_len: i32 = 0
        if s.var_type == TYPE_STRUCT and s.var_type_name != null
            lv_kind = classify_collection_type(s.var_type_name, s.var_type_name_len, @lv_suf, @lv_suf_len)
        if lv_kind == 0 and s.var_init != null
            if s.var_init.kind == EXPR_CALL
                if s.var_init.call_type_suffix_len > 0
                    let init_fn: *FnDef = find_fn_in_module(m, s.var_init.func_name, s.var_init.func_name_len)
                    if init_fn != null
                        if init_fn.return_type == TYPE_STRUCT and init_fn.return_type_name != null
                            # Template return type names look like "Vec$T".
                            # The classifier wants the concrete suffix though,
                            # so for generic templates we use the call's own
                            # type suffix instead of the template's "$T".
                            var rt_suf: *u8 = null
                            var rt_suf_len: i32 = 0
                            let rt_kind: i32 = classify_collection_type(init_fn.return_type_name, init_fn.return_type_name_len, @rt_suf, @rt_suf_len)
                            if rt_kind > 0
                                lv_kind = rt_kind
                                lv_suf = s.var_init.call_type_suffix
                                lv_suf_len = s.var_init.call_type_suffix_len
        if lv_kind > 0 and lv_suf != null and lv_suf_len > 0
            add_local_var(s.var_name, s.var_name_len, lv_kind, lv_suf, lv_suf_len)
            mark_last_local_by_value()
        else if s.var_type_name != null and s.var_type_name_len > 0
            # Plain struct (or pointer/ref to one): root of a field receiver.
            track_typed_local_through(s.var_name, s.var_name_len, s.var_type, s.var_pointee_type, s.var_type_name, s.var_type_name_len)
        else if s.var_init != null and s.var_init.kind == EXPR_UNARY and (s.var_init.op == OP_ADDR or s.var_init.op == OP_ADDR_MUT)
            track_address_of_local(s.var_name, s.var_name_len, s.var_init.operand)
        else if s.var_init != null and s.var_init.kind == EXPR_STRUCT_LIT
            # Un-annotated `var r = R { ... }`: the literal names the type.
            add_local_struct_var(s.var_name, s.var_name_len, s.var_init.ident_ptr, s.var_init.ident_len)
        else if s.var_init != null and s.var_init.kind == EXPR_INDEX
            # Un-annotated `let w = p[1]` of a Vec<Vec<T>>: `w` is the element,
            # a Vec<T>, so `w.get(1)` registers vec_get$T (AGAST #2519).
            var esuf: *u8 = null
            var esuf_len: i32 = 0
            let ekind: i32 = indexed_element_collection(m, s.var_init, @esuf, @esuf_len)
            if ekind > 0
                add_local_var(s.var_name, s.var_name_len, ekind, esuf, esuf_len)
                mark_last_local_by_value()
        else if s.var_init != null and s.var_init.kind == EXPR_METHOD
            track_method_init_local(m, s.var_name, s.var_name_len, s.var_init)
        else if s.var_init != null and s.var_init.kind == EXPR_CALL and s.var_init.call_type_suffix_len == 0
            # `var w = ms()`: a plain fn's return type, as an annotation of it.
            let call_fn: *FnDef = find_fn_in_module(m, s.var_init.func_name, s.var_init.func_name_len)
            if call_fn != null and call_fn.type_params == null
                track_typed_local(s.var_name, s.var_name_len, call_fn.return_type, call_fn.return_type_name, call_fn.return_type_name_len)
        if s.var_init != null
            collect_from_expr(m, s.var_init)
    else if k == STMT_ASSIGN
        collect_from_expr(m, s.assign_value)
    else if k == STMT_MEMBER_ASSIGN
        # ptr.field = value - walk the value expression
        collect_from_expr(m, s.assign_value)
    else if k == STMT_MEMBER_INDEX_ASSIGN
        # ptr.field[index] = value - walk the index (in while_cond) and value
        collect_from_expr(m, s.while_cond)  # index stored in while_cond
        collect_from_expr(m, s.assign_value)
    else if k == STMT_INDEX_ASSIGN
        # name[index] = value - walk the index (in while_cond) and value
        collect_from_expr(m, s.while_cond)  # index stored in while_cond
        collect_from_expr(m, s.assign_value)
    else if k == STMT_LOCAL_FIELD_ASSIGN
        # local_var.field = value - walk the value expression
        collect_from_expr(m, s.assign_value)
    else if k == STMT_LOCAL_FIELD_INDEX_ASSIGN
        # local_var.field[index] = value - walk the index (in while_cond) and value
        collect_from_expr(m, s.while_cond)  # index stored in while_cond
        collect_from_expr(m, s.assign_value)
    else if k == STMT_IF
        collect_from_expr(m, s.if_cond)
        collect_from_fn_body(m, s.if_then)
        if s.if_else != null
            collect_from_fn_body(m, s.if_else)
    else if k == STMT_WHILE
        collect_from_expr(m, s.while_cond)
        collect_from_fn_body(m, s.while_body)
    else if k == STMT_FOR
        collect_from_expr(m, s.for_start)
        collect_from_expr(m, s.for_end)
        collect_from_fn_body(m, s.for_body)
    else if k == STMT_LOOP or k == STMT_DEFER
        # Infinite loop stores its body in while_body (same slot as STMT_WHILE);
        # so does `defer` (AGAST #1625).  Without this case, generic calls inside `loop { ... }` are never
        # registered for monomorphization (e.g. vec_push_bytes<u8> inside
        # vec_read_all_fd), leaving the linker with unresolved references.
        collect_from_fn_body(m, s.while_body)
    else if k == STMT_RETURN
        if s.return_value != null
            collect_from_expr(m, s.return_value)
    else if k == STMT_ASSERT
        # `assert <cond>` — cond stored in if_cond (slot reuse).  Generic
        # calls in the condition need to register for monomorphization.
        if s.if_cond != null
            collect_from_expr(m, s.if_cond)
    else if k == STMT_TUPLE_DECL
        # `let (a, b) = expr` — initializer in var_init.
        if s.var_init != null
            collect_from_expr(m, s.var_init)
    else if k == STMT_MATCH
        # `match scrutinee \n arm => body \n …` — scrutinee in if_cond,
        # arms list in if_then (recast as *Stmt by the parser; see
        # stmt_match in ast_helpers.ritz).  Walk the arm bodies as
        # *Expr — they're real expressions, not Stmts.
        if s.if_cond != null
            collect_from_expr(m, s.if_cond)
        collect_from_arms(m, s.if_cond, s.if_then as *MatchArm)

# Walk a match's (or an if's) arms.  Each arm is a scope (AGAST #2573): its
# payload binding (`Some(x)`, `Ok(x)`, `Hit(x)`) is recorded at the payload's
# type for that arm only, and the arm's own lets go with it, so a second arm
# binding `x` at another type finds its own.  (No outer local can share the
# name: #2395 refuses that.)  `scrut` is null for an if.
fn collect_from_arms(m: *Module, scrut: *Expr, arms: *MatchArm)
    var tn_len: i32 = 0
    let tn: *u8 = scrutinee_type_name(m, scrut, @tn_len)
    var arm: *MatchArm = arms
    while arm != null
        let saved_count: i32 = g_lv_count
        bind_arm_payload(m, arm, tn, tn_len)
        collect_from_fn_body(m, arm.body_stmts)   # block arm (AGAST #1454)
        if arm.body != null
            collect_from_expr(m, arm.body)
        g_lv_count = saved_count
        arm = arm.next

# AGAST #2573: the mangled type of a match scrutinee, as far as this walk
# knows it: a tracked local's (`let o = wrap(v)`, a param), or a plain fn
# call's return type (`match wrap(v)`).  null for anything else.
fn scrutinee_type_name(m: *Module, e: *Expr, out_len: *i32) -> *u8
    *out_len = 0
    if e == null
        return null
    if e.kind == EXPR_IDENT
        let idx: i32 = find_local_var_idx(e.ident_ptr, e.ident_len)
        if idx < 0 or *(g_lv_by_value + idx) != 1 or *(g_lv_prefix_kind + idx) != 0
            return null
        *out_len = *(g_lv_type_name_lens + idx)
        return *(g_lv_type_names + idx)
    if e.kind == EXPR_CALL and e.call_type_suffix_len == 0
        let f: *FnDef = find_fn_in_module(m, e.func_name, e.func_name_len)
        if f == null or f.type_params != null or f.return_type != TYPE_STRUCT or f.return_type_name == null
            return null
        *out_len = f.return_type_name_len
        return f.return_type_name
    return null

# Record `Ctor(x)`'s `x` at its payload's type, so `x[lo..hi]` is a slice of
# a Vec, Span or String (rewrite_value_slice) and `x.push(..)` instantiates.
fn bind_arm_payload(m: *Module, arm: *MatchArm, tn: *u8, tn_len: i32)
    if arm.pattern_kind != PAT_VARIANT or arm.pattern_inner_kind != PAT_IDENT
        return
    let name: *u8 = arm.pattern_inner_name
    let name_len: i32 = arm.pattern_inner_name_len
    if name_len <= 0 or (name_len == 1 and *name == 95)   # `_`
        return
    var pay_len: i32 = 0
    let pay: *u8 = variant_payload_type(m, tn, tn_len, arm.pattern_name, arm.pattern_name_len, @pay_len)
    if pay != null and pay_len > 0
        track_typed_local(name, name_len, TYPE_STRUCT, pay, pay_len)

# The mangled type variant `ctor` of `tn` carries, or null: Option's Some the
# whole suffix, Result's Ok its T and Err its E, a non-generic user enum's
# single-field tuple variant that field's struct type.
fn variant_payload_type(m: *Module, tn: *u8, tn_len: i32, ctor: *u8, ctor_len: i32, out_len: *i32) -> *u8
    *out_len = 0
    if tn == null or tn_len <= 0
        return null
    if tn_len > 7 and memcmp(tn, c"Option$", 7) == 0
        if buf_eq(ctor, ctor_len, c"Some", 4) == 0
            return null
        *out_len = tn_len - 7
        return tn + 7
    if tn_len > 7 and memcmp(tn, c"Result$", 7) == 0
        let sfx: *u8 = tn + 7
        let sfx_len: i32 = tn_len - 7
        let t_len: i32 = mangled_type_extent(m, sfx, sfx_len)
        if buf_eq(ctor, ctor_len, c"Ok", 2) == 1
            *out_len = t_len
            return sfx
        if buf_eq(ctor, ctor_len, c"Err", 3) == 1 and t_len + 1 < sfx_len
            *out_len = sfx_len - t_len - 1
            return sfx + t_len + 1
        return null
    let ei: i32 = enum_find(tn, tn_len)
    if ei < 0 or enum_is_generic(ei) == 1
        return null
    let vi: i32 = enum_variant_index(tn, tn_len, ctor, ctor_len)
    if vi < 0 or enum_variant_kind(ei, vi) != ENUM_VARIANT_TUPLE
        return null
    let f: *StructField = enum_variant_fields(ei, vi)
    if f == null or f.next != null or f.field_type != TYPE_STRUCT or f.field_type_name == null
        return null
    *out_len = f.field_type_name_len
    return f.field_type_name

# Byte length of the first whole type in the `$`-joined mangled list `p`
# (AGAST #1574): `Vec$i32$i32` -> `Vec$i32`, `Result$Vec$u8$i32$i64` ->
# `Result$Vec$u8$i32`.  A component takes as many types after it as it has
# type parameters; one it doesn't know as generic takes none.
fn mangled_type_extent(m: *Module, p: *u8, len: i32) -> i32
    var end: i32 = 0
    while end < len and *(p + end) != 36   # '$'
        end = end + 1
    var pos: i32 = end
    let arity: i32 = mangled_generic_arity(m, p, end)
    for a in 0..arity
        if pos >= len
            return pos
        pos = pos + 1 + mangled_type_extent(m, p + pos + 1, len - pos - 1)
    return pos

# How many type arguments the mangled name component `p` takes: a generic
# struct's own count, and the three that may have no template here: Span
# (`[u8]` needs no ritzlib.span), Option and Result.
fn mangled_generic_arity(m: *Module, p: *u8, len: i32) -> i32
    if buf_eq(p, len, c"Span", 4) == 1 or buf_eq(p, len, c"Option", 6) == 1
        return 1
    if buf_eq(p, len, c"Result", 6) == 1
        return 2
    let st: *StructDef = find_generic_struct(m, p, len)
    if st != null
        return count_type_params(st.type_params)
    return 0

# Rewrite `E.from(args)` in place into the plain call `E__from(args)` of the
# generated fn (main.ritz, add_enum_from_fns), as ritz0's enum_from.py does,
# so type inference and emission see an ordinary call.  Done here because
# this walk visits every body before emission.  Left alone when no such fn
# exists: emit_expr_method then reports the located error.
fn rewrite_enum_from_call(m: *Module, e: *Expr)
    if is_enum_from_call(e) == 0
        return
    if find_local_var_idx(e.left.ident_ptr, e.left.ident_len) >= 0
        return
    var len: i32 = 0
    let name: *u8 = enum_from_fn_name(e.left.ident_ptr, e.left.ident_len, @len)
    if find_fn_in_module(m, name, len) == null
        return
    e.kind = EXPR_CALL
    e.func_name = name
    e.func_name_len = len
    e.call_type_suffix = null
    e.call_type_suffix_len = 0
    e.left = null

# AGAST #2575: rewrite the static-style call `String.from(x)` in place into
# the UFCS free fn `string_from(x)`, arguments unchanged, as ritz0 lowers it
# (#1321).  Only for a non-generic ritzlib type (ufcs_non_generic_prefix),
# only when that fn exists, and never over an impl method of the same name or
# a param or local named like the type (g_ufcs_shadowed).  A global of that
# name doesn't shadow it, in ritz0 either.  As a plain call, `let s =
# String.new()` is typed by its callee's return like `let s = string_new()`.
# Anything else is left to emit_expr_method, which refuses it.
fn rewrite_static_ufcs_call(m: *Module, e: *Expr)
    if e.kind != EXPR_METHOD or e.left == null or e.left.kind != EXPR_IDENT
        return
    let tn: *u8 = e.left.ident_ptr
    let tn_len: i32 = e.left.ident_len
    var pfx_len: i32 = 0
    let pfx: *u8 = ufcs_non_generic_prefix(tn, tn_len, @pfx_len)
    if pfx == null
        return
    if g_ufcs_shadowed == 1
        return
    if impl_has_method(m, tn, tn_len, e.ident_ptr, e.ident_len) == 1
        return
    let len: i32 = pfx_len + e.ident_len
    let name: *u8 = malloc(len as i64 + 1)
    memcpy(name, pfx, pfx_len as i64)
    memcpy(name + pfx_len, e.ident_ptr, e.ident_len as i64)
    *(name + len) = 0
    if find_fn_in_module(m, name, len) == null
        free(name)
        return
    e.kind = EXPR_CALL
    e.func_name = name
    e.func_name_len = len
    e.call_type_suffix = null
    e.call_type_suffix_len = 0
    e.left = null

# 1 when an impl of `tn` (any, generic or not) has a method `meth`.
fn impl_has_method(m: *Module, tn: *u8, tn_len: i32, meth: *u8, meth_len: i32) -> i32
    var ib: *ImplBlock = m.impls
    while ib != null
        if buf_eq(ib.type_name, ib.type_name_len, tn, tn_len) == 1
            var f: *FnDef = ib.methods
            while f != null
                if buf_eq(f.name, f.name_len, meth, meth_len) == 1
                    return 1
                f = f.next
        ib = ib.next
    return 0

# ----------------------------------------------------------------------------
# Indexing a struct (LANGUAGE_SPEC §7.8, LARB R15, AGAST #1635): `m[k]` on a
# struct with `impl Index` / `IndexMut` / `IndexSet` becomes the method call it
# means, in place.  struct_index.ritz says which, and holds the refusals.
# ----------------------------------------------------------------------------

# The struct `base[k]` indexes, when `base` is a tracked local (by value, or one
# `@` / `@&` / `*` level) or a field of one, and that struct isn't built in;
# else null.  `*out_mask` gets the traits it implements.  A pointer to a struct
# with none of them is a raw buffer, and a reference to one is refused as one
# value (index_through.ritz): both are left alone.
fn si_base_struct(m: *Module, base: *Expr, out_len: *i32, out_mask: *i32) -> *u8
    *out_len = 0
    *out_mask = 0
    if base == null
        return null
    var name: *u8 = null
    var len: i32 = 0
    var through: i32 = 0
    if base.kind == EXPR_IDENT
        let idx: i32 = find_local_var_idx(base.ident_ptr, base.ident_len)
        if idx < 0 or *(g_lv_prefix_kind + idx) != 0
            return null
        let bv: i32 = *(g_lv_by_value + idx)
        if bv != 1 and bv != 2
            return null
        if bv == 2
            through = 1
        name = *(g_lv_type_names + idx)
        len = *(g_lv_type_name_lens + idx)
    else if base.kind == EXPR_MEMBER
        let f: *StructField = resolve_member_field(m, base)
        if f == null or f.field_type != TYPE_STRUCT
            return null
        name = f.field_type_name
        len = f.field_type_name_len
    else
        return null
    if name == null or len <= 0 or si_built_in(name, len) == 1 or si_is_struct(m, name, len) == 0
        return null
    let mask: i32 = si_traits(m, name, len)
    if through == 1 and mask == 0
        return null
    *out_len = len
    *out_mask = mask
    name

# A write to `p[k]` with `p` an `@M` (§3.2): located at `p`, as ref_check
# refuses any other write through one.  1 when refused.
fn si_refuse_shared_write(m: *Module, base: *Expr) -> i32
    # `p.m[k]`, `p.a.m[k]`: the root, reached through fields held by value.  A
    # pointer field on the way is its own place, not in what `p` refers to.
    var root: *Expr = base
    while root != null and root.kind == EXPR_MEMBER
        if root != base
            let f: *StructField = resolve_member_field(m, root)
            if f == null or f.field_type != TYPE_STRUCT
                return 0
        root = root.left
    if root == null or root.kind != EXPR_IDENT
        return 0
    let idx: i32 = find_local_var_idx(root.ident_ptr, root.ident_len)
    if idx < 0 or *(g_lv_shared + idx) != 1
        return 0
    si_refuse_write_through(root.span.line, root.span.col)
    1

# The column of the `[` after `base` (`m[`, `h.t[`): the errors are located
# there, as ritz0's are.
fn si_bracket_col(base: *Expr) -> i32
    if base.kind == EXPR_IDENT
        return base.span.col + base.ident_len
    if base.kind == EXPR_MEMBER and base.left != null
        if base.left.kind == EXPR_IDENT or base.left.kind == EXPR_MEMBER
            return si_bracket_col(base.left) + 1 + base.ident_len
    base.span.col

# `e`, an index on a struct, as `*<call>` in place.
fn si_into_deref(e: *Expr, call: *Expr)
    e.kind = EXPR_UNARY
    e.op = OP_DEREF
    e.operand = call
    e.left = null
    e.right = null

# A read of `m[k]` (`*m.index(k)`), `@m[k]` (`m.index(k)`) or `@&m[k]`
# (`m.index_mut(k)`).  Called on each expression before its children.
fn rewrite_struct_index(m: *Module, e: *Expr)
    if e == null
        return
    var x: *Expr = e
    var use: i32 = SI_USE_READ
    if e.kind == EXPR_UNARY and (e.op == OP_ADDR or e.op == OP_ADDR_MUT)
        x = e.operand
        if e.op == OP_ADDR_MUT
            use = SI_USE_ADDR_MUT
    if x == null or x.kind != EXPR_INDEX or x.right == null or x.right.kind == EXPR_RANGE
        return
    var len: i32 = 0
    var mask: i32 = 0
    let name: *u8 = si_base_struct(m, x.left, @len, @mask)
    if name == null
        return
    if si_check(x.left.span.line, si_bracket_col(x.left), name, len, mask, use) == 0
        return
    if use == SI_USE_ADDR_MUT and si_refuse_shared_write(m, x.left) == 1
        return
    let key: *Expr = x.right
    if x == e
        si_into_deref(e, si_method(x.left, c"index", 5, key, e.span.line, e.span.col))
        return
    # `@m[k]` / `@&m[k]` is the reference the method returns.
    e.kind = EXPR_METHOD
    e.left = x.left
    if use == SI_USE_ADDR_MUT
        e.ident_ptr = c"index_mut"
        e.ident_len = 9
    else
        e.ident_ptr = c"index"
        e.ident_len = 5
    e.args = key
    e.operand = null
    e.call_type_suffix = null
    e.call_type_suffix_len = 0

# ----------------------------------------------------------------------------
# AGAST #2529: `x op= v` arrives as `x = x op v` (ast_helpers.ritz
# stmt_compound_assign_*), the read and the store sharing the nodes of x's
# operands.  A call among them is noted as evaluated once (si_once), so the
# emitter runs it at the first of the two and hands its register to the second:
# `h(@a)[1] += 7` and `a[f()] += 1` call once.  Only a node both sides reach is
# noted; a user's `a[f()] = a[f()] + 1` has two calls and keeps them.
# ----------------------------------------------------------------------------

# Whether `e` is reached from `root` through a place's operands: an index's
# base and key, a member's or cast's left, a deref, a binary's sides.  A call
# is a leaf: its arguments are evaluated with it.
fn place_reaches(root: *Expr, e: *Expr) -> i32
    if root == null
        return 0
    if root == e
        return 1
    let k: i32 = root.kind
    if k == EXPR_INDEX or k == EXPR_BINARY
        if place_reaches(root.left, e) == 1
            return 1
        return place_reaches(root.right, e)
    if k == EXPR_MEMBER or k == EXPR_CAST
        return place_reaches(root.left, e)
    if k == EXPR_UNARY
        return place_reaches(root.operand, e)
    0

# Note each call in the read `e` that the store reaches from `a` or `b`.
fn note_shared_calls(e: *Expr, a: *Expr, b: *Expr)
    if e == null
        return
    let k: i32 = e.kind
    if k == EXPR_CALL or k == EXPR_METHOD
        if si_once_find(e) < 0 and (place_reaches(a, e) == 1 or place_reaches(b, e) == 1)
            si_once_add(e)
        return
    if k == EXPR_INDEX or k == EXPR_BINARY
        note_shared_calls(e.left, a, b)
        note_shared_calls(e.right, a, b)
    else if k == EXPR_MEMBER or k == EXPR_CAST
        note_shared_calls(e.left, a, b)
    else if k == EXPR_UNARY
        note_shared_calls(e.operand, a, b)

# Where each store form keeps the place's shared operands (ast_helpers.ritz).
fn note_compound_calls(s: *Stmt)
    let k: i32 = s.kind
    if is_store_stmt(k) == 0
        return
    let v: *Expr = s.assign_value
    if v == null or v.kind != EXPR_BINARY or v.left == null
        return
    var a: *Expr = null
    var b: *Expr = null
    if k == STMT_INDEX_ASSIGN or k == STMT_LOCAL_FIELD_INDEX_ASSIGN
        a = s.while_cond
    else if k == STMT_MEMBER_INDEX_ASSIGN
        a = s.if_cond
        b = s.while_cond
    else if k == STMT_MEMBER_ASSIGN
        a = s.if_cond
    else if k == STMT_ASSIGN and s.assign_target_len == 0
        a = s.if_cond
    else
        return
    note_shared_calls(v.left, a, b)

# `s`, a store to `base[key]` of `value`, as `index_set` or a store through
# `index_mut`; `m[k] op= x` (compound) through one `index_mut` call.
fn si_rewrite_assign(m: *Module, s: *Stmt, base: *Expr, key: *Expr, value: *Expr, compound: i32, line: i32, col: i32) -> i32
    var len: i32 = 0
    var mask: i32 = 0
    let name: *u8 = si_base_struct(m, base, @len, @mask)
    if name == null
        return 0
    var use: i32 = SI_USE_ASSIGN
    if compound == 1
        use = SI_USE_COMPOUND
    if si_check(line, col, name, len, mask, use) == 0
        return 0
    if si_refuse_shared_write(m, base) == 1
        return 0
    key.next = null
    if compound == 0 and (mask & SI_INDEX_SET) != 0
        key.next = value
        s.kind = STMT_EXPR
        s.expr = si_method(base, c"index_set", 9, key, line, col)
        return 1
    let call: *Expr = si_method(base, c"index_mut", 9, key, line, col)
    if compound == 1
        # The read `m[k]` of `m[k] = m[k] op x` shares the call.
        si_once_add(call)
        value.left = si_deref(call, line, col)
    s.kind = STMT_ASSIGN
    s.if_cond = si_deref(call, line, col)
    s.assign_target = null
    s.assign_target_len = 0
    s.assign_value = value
    return 1

# Statement forms of `m[k]` on a struct: `m[k] = v`, `m[k] op= x` and a store
# to a field of one (`m[k].f = x`, `m[k].f op= x`).  Before the statement's
# expressions are walked.
fn rewrite_struct_index_stmt(m: *Module, s: *Stmt)
    if s.kind == STMT_INDEX_ASSIGN
        # `name[k] = v` keeps the name, not an expression.
        let base: *Expr = si_new_expr(EXPR_IDENT, s.span.line, s.span.col)
        base.ident_ptr = s.assign_target
        base.ident_len = s.assign_target_len
        let key: *Expr = s.while_cond
        let v: *Expr = s.assign_value
        var compound: i32 = 0
        if v != null and v.kind == EXPR_BINARY and v.left != null and v.left.kind == EXPR_INDEX and v.left.right == key
            compound = 1   # stmt_compound_assign_index shares the key
        if si_rewrite_assign(m, s, base, key, v, compound, s.span.line, s.span.col + s.assign_target_len) == 1
            collect_from_expr(m, key)
        return
    if s.kind == STMT_LOCAL_FIELD_INDEX_ASSIGN or s.kind == STMT_MEMBER_INDEX_ASSIGN
        # `h.t[k] = v` (a local's field) / `p.t[k] = v` (through a pointer
        # expression): the base is the field `t`.
        var owner: *Expr = null
        if s.kind == STMT_LOCAL_FIELD_INDEX_ASSIGN
            owner = si_new_expr(EXPR_IDENT, s.span.line, s.span.col)
            owner.ident_ptr = s.var_name
            owner.ident_len = s.var_name_len
        else
            owner = s.if_cond
        if owner == null
            return
        let fbase: *Expr = si_new_expr(EXPR_MEMBER, owner.span.line, owner.span.col)
        fbase.left = owner
        fbase.ident_ptr = s.assign_target
        fbase.ident_len = s.assign_target_len
        let fkey: *Expr = s.while_cond
        let fv: *Expr = s.assign_value
        var fcompound: i32 = 0
        if fv != null and fv.kind == EXPR_BINARY and fv.left != null and fv.left.kind == EXPR_INDEX and fv.left.right == fkey
            fcompound = 1   # stmt_compound_assign_*_field_index shares the key
        if si_rewrite_assign(m, s, fbase, fkey, fv, fcompound, fbase.span.line, si_bracket_col(fbase)) == 1
            collect_from_expr(m, fkey)
        return
    if s.kind != STMT_ASSIGN or s.assign_target_len != 0 or s.if_cond == null
        return
    let t: *Expr = s.if_cond
    let v: *Expr = s.assign_value
    var compound: i32 = 0
    if v != null and v.kind == EXPR_BINARY and v.left == t
        compound = 1   # stmt_compound_assign_expr shares the target
    if t.kind == EXPR_INDEX
        if t.right == null or t.right.kind == EXPR_RANGE
            return
        let key: *Expr = t.right
        if si_rewrite_assign(m, s, t.left, key, v, compound, t.left.span.line, si_bracket_col(t.left)) == 1
            collect_from_expr(m, key)
        return
    if t.kind != EXPR_MEMBER
        return
    var root: *Expr = t
    while root.left != null and root.kind == EXPR_MEMBER
        root = root.left
    if root.kind != EXPR_INDEX or root.right == null or root.right.kind == EXPR_RANGE
        return
    var len: i32 = 0
    var mask: i32 = 0
    let name: *u8 = si_base_struct(m, root.left, @len, @mask)
    if name == null
        return
    if si_check(root.left.span.line, si_bracket_col(root.left), name, len, mask, SI_USE_FIELD_STORE) == 0
        return
    if si_refuse_shared_write(m, root.left) == 1
        return
    let key: *Expr = root.right
    key.next = null
    let call: *Expr = si_method(root.left, c"index_mut", 9, key, root.span.line, root.span.col)
    if compound == 1
        si_once_add(call)
    si_into_deref(root, call)
    collect_from_expr(m, key)

# AGAST #2451: `v[lo..hi]` on a Vec, Span or String local (the value, not a
# pointer to one) is rewritten in place into `v.slice(lo, hi)`, ritz0's lowering
# (_emit_slice): vec_slice<T> and string_slice copy, span_slice is a view.  It
# was a bare address in an i64, so `t[1]` indexed bytes and `t.len` had no
# struct.  As a method call, monomorph instantiates vec_slice$T / span_slice$T
# below and the emitter types `t` as the result.  `lo..=hi` arrives as
# `lo..hi + 1` (postfix_range_index_inclusive).  A slice through a pointer is
# left to index_through, which refuses it (#2448); anything this misses is
# refused by emit_expr_index rather than read as an address.
fn rewrite_value_slice(m: *Module, e: *Expr)
    if e == null or e == g_slice_kept or e.kind != EXPR_INDEX or e.right == null or e.right.kind != EXPR_RANGE
        return
    # Through a pointer or reference, `p[lo..hi]` and `(*p)[lo..hi]` are both
    # `(*p)[lo..hi]` (R9 rule 2, AGAST #2448): `p.slice(lo, hi)`, which UFCS
    # dispatch passes `p` itself to.
    var base: *Expr = e.left
    if base != null and base.kind == EXPR_UNARY and base.op == OP_DEREF
        base = base.operand
    if base == null or base.kind != EXPR_IDENT
        return
    let idx: i32 = find_local_var_idx(base.ident_ptr, base.ident_len)
    if idx < 0
        return
    let by_value: i32 = *(g_lv_by_value + idx)
    if by_value == 0 or (base != e.left and by_value != 2)
        return
    if *(g_lv_prefix_kind + idx) == 0
        if buf_eq(*(g_lv_type_names + idx), *(g_lv_type_name_lens + idx), c"String", 6) == 0
            return
    let rng: *Expr = e.right
    let lo: *Expr = rng.left
    if *(g_lv_prefix_kind + idx) == 2 and find_generic_function(m, c"span_slice", 10) == null
        # No ritzlib.span (a Span<u8> needs none): the view itself.
        let lo_kind: i32 = rng.left.kind
        if lo_kind == EXPR_INT_LIT or lo_kind == EXPR_IDENT
            span_view_in_place(e, c"ptr", 3, *(g_lv_suffixes + idx), *(g_lv_suffix_lens + idx))
        return
    e.left = base
    lo.next = rng.right
    rng.right.next = null
    e.kind = EXPR_METHOD
    e.ident_ptr = c"slice"
    e.ident_len = 5
    e.args = lo
    e.right = null
    e.call_type_suffix = null
    e.call_type_suffix_len = 0

# `v[lo..hi]` as `Span$T { ptr: v.<field> + lo, len: hi - lo }`: ritz0's
# _emit_span_slice on a Span (`field` is `ptr`) and _emit_vec_span_slice on a
# Vec (`data`, AGAST #2501).  `lo` is read twice: the caller takes only a
# bound that's safe to, or registers it to be evaluated once.  Through a
# pointer, `p.ptr` and `(*p).ptr` both read through it (AGAST #2448).
fn span_view_in_place(e: *Expr, field: *u8, field_len: i32, suf: *u8, suf_len: i32)
    let lo: *Expr = e.right.left
    let hi: *Expr = e.right.right
    let base: *Expr = slice_node(EXPR_MEMBER, e, e.left, null)
    base.ident_ptr = field
    base.ident_len = field_len
    let at: *Expr = slice_node(EXPR_BINARY, e, base, lo)
    at.op = OP_ADD
    let len: *Expr = slice_node(EXPR_BINARY, e, hi, lo)
    len.op = OP_SUB
    let name: *u8 = malloc((suf_len + 5) as i64) as *u8
    memcpy(name, c"Span", 4)
    memcpy(name + 4, suf, suf_len as i64)
    *(name + 4 + suf_len) = 0
    let ptr_field: *FieldInit = calloc(1, sizeof(FieldInit)) as *FieldInit
    ptr_field.name = c"ptr"
    ptr_field.name_len = 3
    ptr_field.value = at
    let len_field: *FieldInit = calloc(1, sizeof(FieldInit)) as *FieldInit
    len_field.name = c"len"
    len_field.name_len = 3
    len_field.value = len
    ptr_field.next = len_field
    e.kind = EXPR_STRUCT_LIT
    e.ident_ptr = name
    e.ident_len = suf_len + 4
    e.args = ptr_field as *Expr
    e.left = null
    e.right = null

# A zeroed node of `kind` at `at`'s place.
fn slice_node(kind: i32, at: *Expr, left: *Expr, right: *Expr) -> *Expr
    let n: *Expr = calloc(1, sizeof(Expr)) as *Expr
    n.kind = kind
    n.span = at.span
    n.left = left
    n.right = right
    return n

var g_slice_kept: *Expr = null

# AGAST #2501: `let s: Span<T> = v[lo..hi]` on a Vec is a view, as ritz0 makes
# it (_emit_vec_span_slice, LANGUAGE_SPEC §3.4), not vec_slice's copy:
# `Span$T { ptr: v.data + lo, len: hi - lo }`.  `v` is a Vec local, a `*T`,
# `@T` or `@&T` of one (`p[lo..hi]` and `(*p)[lo..hi]` are `(*p)[lo..hi]`, R9
# rule 2, AGAST #2448: `p.data` reads through it), or a by-value Vec field
# (`b.data[lo..hi]`).  `lo` appears in both fields: a call is evaluated once
# (si_once, the emitter shares its register), and any other bound must be free
# of calls, so reading it twice reads the same value.  Returns 1 if `s` is such
# a let; it's rewritten when its bound allows, and is otherwise left as an
# index for the emitter to refuse, located.
fn slice_into_span_annotation(m: *Module, s: *Stmt) -> i32
    if s.var_type_name == null or s.var_type_name_len < 5
        return 0
    if memcmp(s.var_type_name, c"Span$", 5) != 0
        return 0
    let e: *Expr = s.var_init
    if e.kind != EXPR_INDEX or e.right == null or e.right.kind != EXPR_RANGE
        return 0
    var base: *Expr = e.left
    if base != null and base.kind == EXPR_UNARY and base.op == OP_DEREF
        base = base.operand
    if base == null
        return 0
    var suf: *u8 = null
    var suf_len: i32 = 0
    if base.kind == EXPR_IDENT
        let idx: i32 = find_local_var_idx(base.ident_ptr, base.ident_len)
        if idx < 0 or *(g_lv_prefix_kind + idx) != 1
            return 0
        # The Vec itself, or one level from it (`(*p)` needs the level).
        let by_value: i32 = *(g_lv_by_value + idx)
        if by_value == 0 or (base != e.left and by_value != 2)
            return 1
        suf = *(g_lv_suffixes + idx)
        suf_len = *(g_lv_suffix_lens + idx)
    else if base == e.left and base.kind == EXPR_MEMBER
        # A by-value Vec field, `b.data[0..2]`: the same view of it.
        let rf: *StructField = resolve_member_field(m, e.left)
        if rf == null or rf.field_type != TYPE_STRUCT
            return 0
        if classify_collection_type(rf.field_type_name, rf.field_type_name_len, @suf, @suf_len) != 1
            return 0
    else
        return 0
    let lo: *Expr = e.right.left
    if lo.kind == EXPR_CALL or lo.kind == EXPR_METHOD
        si_once_add(lo)
    else if slice_bound_rereadable(lo) == 0
        return 1
    e.left = base
    span_view_in_place(e, c"data", 4, suf, suf_len)
    return 1

# 1 if reading `e` twice gives the same value with no effect: literals, names,
# fields, and arithmetic, casts and derefs of those.  A call isn't.
fn slice_bound_rereadable(e: *Expr) -> i32
    if e == null
        return 0
    let k: i32 = e.kind
    if k == EXPR_INT_LIT or k == EXPR_IDENT
        return 1
    if k == EXPR_MEMBER or k == EXPR_CAST
        return slice_bound_rereadable(e.left)
    if k == EXPR_UNARY
        return slice_bound_rereadable(e.operand)
    if k == EXPR_BINARY
        if slice_bound_rereadable(e.left) == 1
            return slice_bound_rereadable(e.right)
    return 0

# Register the UFCS instantiation a call of `method` on receiver `recv`
# dispatches to: `vec_<method>$T` / `span_<method>$T` when `recv` is a
# tracked Vec / Span local, a field of one (`r.raw.push(9)`, AGAST #1512), or
# `@` / `@&` of either (format_into's sink, AGAST #1824).
fn register_receiver_method(m: *Module, recv: *Expr, method: *u8, method_len: i32)
    var r: *Expr = recv
    if r != null and r.kind == EXPR_UNARY and (r.op == OP_ADDR or r.op == OP_ADDR_MUT)
        r = r.operand
    if r == null
        return
    if r.kind == EXPR_IDENT
        let lv_idx: i32 = find_local_var_idx(r.ident_ptr, r.ident_len)
        if lv_idx >= 0
            register_ufcs_instantiation(m, *(g_lv_prefix_kind + lv_idx), *(g_lv_suffixes + lv_idx), *(g_lv_suffix_lens + lv_idx), method, method_len)
    else if r.kind == EXPR_MEMBER
        # A `*Vec<T>` field dispatches to the same `vec_<method>$T` as a
        # by-value one (the emitter passes the pointer it holds).
        let rf: *StructField = resolve_member_field(m, r)
        if rf != null and (rf.field_type == TYPE_STRUCT or rf.field_type == TYPE_PTR)
            var fsuf: *u8 = null
            var fsuf_len: i32 = 0
            let fkind: i32 = classify_collection_type(rf.field_type_name, rf.field_type_name_len, @fsuf, @fsuf_len)
            register_ufcs_instantiation(m, fkind, fsuf, fsuf_len, method, method_len)
    else if r.kind == EXPR_INDEX
        # AGAST #2519: `v[1].get(1)` on a Vec<Vec<i32>>: the element is the
        # receiver, one level into the collection's suffix ("$Vec$i32" ->
        # "Vec$i32" -> vec_get$i32).
        var esuf: *u8 = null
        var esuf_len: i32 = 0
        let ekind: i32 = indexed_element_collection(m, r, @esuf, @esuf_len)
        register_ufcs_instantiation(m, ekind, esuf, esuf_len, method, method_len)

# AGAST #2519: if `e` is `b[i]` (or `(*b)[i]`) on a Vec or Span whose element
# is itself a Vec or Span, return that element's kind and write its "$T"
# suffix to out; 0 otherwise.  `b` is a tracked local (the collection itself,
# or a `*`/`@`/`@&` of it, one level: LARB R9) or a field of one.  A range
# index is a slice, not an element.
fn indexed_element_collection(m: *Module, e: *Expr, out_suffix: **u8, out_suffix_len: *i32) -> i32
    if e.left == null or e.right == null or e.right.kind == EXPR_RANGE
        return 0
    var b: *Expr = e.left
    if b.kind == EXPR_UNARY and b.op == OP_DEREF
        b = b.operand
    if b == null
        return 0
    var csuf: *u8 = null
    var csuf_len: i32 = 0
    if b.kind == EXPR_IDENT
        let idx: i32 = find_local_var_idx(b.ident_ptr, b.ident_len)
        # by_value 0 with a collection kind is a `**Vec<T>`: `b[i]` is a raw
        # buffer of pointers there, not an element of the Vec.
        if idx < 0 or *(g_lv_prefix_kind + idx) == 0 or *(g_lv_by_value + idx) == 0
            return 0
        csuf = *(g_lv_suffixes + idx)
        csuf_len = *(g_lv_suffix_lens + idx)
    else if b.kind == EXPR_MEMBER
        let rf: *StructField = resolve_member_field(m, b)
        if rf == null or (rf.field_type != TYPE_STRUCT and rf.field_type != TYPE_PTR)
            return 0
        if classify_collection_type(rf.field_type_name, rf.field_type_name_len, @csuf, @csuf_len) == 0
            return 0
    else
        return 0
    # The collection's suffix is "$<element>": classify the element.
    if csuf == null or csuf_len < 2
        return 0
    return classify_collection_type(csuf + 1, csuf_len - 1, out_suffix, out_suffix_len)

fn collect_from_expr(m: *Module, e: *Expr)
    if e == null
        return

    rewrite_enum_from_call(m, e)
    rewrite_static_ufcs_call(m, e)   # AGAST #2575
    rewrite_value_slice(m, e)
    rewrite_struct_index(m, e)       # AGAST #1635
    let k: i32 = e.kind

    if k == EXPR_CALL
        # Check if this is a generic call (has type suffix)
        if e.call_type_suffix_len > 0
            add_instantiation(e.func_name, e.func_name_len, e.call_type_suffix, e.call_type_suffix_len)
        # AGAST #1824: format_into(sink, "...") appends through
        # `sink.push_bytes(..)`, so a generic sink (`*Vec<u8>` ->
        # vec_push_bytes$u8) needs that method even when nothing else calls it.
        if e.args != null and buf_eq(e.func_name, e.func_name_len, c"format_into", 11) == 1
            register_receiver_method(m, e.args, c"push_bytes", 10)
        # Recurse into arguments
        var arg: *Expr = e.args
        while arg != null
            collect_from_expr(m, arg)
            arg = arg.next
    else if k == EXPR_STRUCT_LIT
        # Check if struct literal is for a generic struct (has $ in name)
        if e.ident_ptr != null and e.ident_len > 0
            add_struct_from_mangled_name(m, e.ident_ptr, e.ident_len)
        # Recurse into field initializers.  The parser stores a *FieldInit
        # list in e.args (recast to *Expr — see ident_or_struct /
        # generic_struct_lit in ast_helpers.ritz).  Walking it as *Expr is
        # an alias-bug: FieldInit is 32 bytes so reading Expr.next at
        # offset 120 returns heap garbage and segfaults on most non-null
        # values (e.g. 0x8 from cryptosec/aes_gcm.ritz, which is what
        # blocks valet).  Walk the FieldInit chain directly and recurse
        # into each field's value expression.
        var fi: *FieldInit = e.args as *FieldInit
        while fi != null
            if fi.value != null
                collect_from_expr(m, fi.value)
            fi = fi.next
    else if k == EXPR_BINARY
        collect_from_expr(m, e.left)
        collect_from_expr(m, e.right)
    else if k == EXPR_UNARY
        collect_from_expr(m, e.operand)
    else if k == EXPR_INDEX
        collect_from_expr(m, e.left)   # base
        collect_from_expr(m, e.right)  # index
    else if k == EXPR_MEMBER
        collect_from_expr(m, e.left)  # base
    else if k == EXPR_METHOD
        # UFCS instantiation: `v.push(...)` where v: Vec<T> implies
        # `vec_push<T>` needs to be specialized.  Look up the receiver
        # ident in the local-var tracker; when it's a Vec or Span,
        # mangle to `vec_<method>$T` / `span_<method>$T` and register
        # the instantiation so the specialization loop emits a real
        # function body.  Without this, the linker fails on the missing
        # `vec_<method>$T` symbol (the emitter's UFCS dispatch falls
        # back to the broken `Vec$T_<method>` mangling).
        register_receiver_method(m, e.left, e.ident_ptr, e.ident_len)
        collect_from_expr(m, e.left)  # receiver
        var arg: *Expr = e.args
        while arg != null
            collect_from_expr(m, arg)
            arg = arg.next
    else if k == EXPR_CAST
        # Parser stores operand in e.left, not e.operand
        collect_from_expr(m, e.left)
    else if k == EXPR_RANGE
        # Range: start..end (left=start, right=end).  Generic calls inside
        # ranges (e.g. `for i in 0..vec_len<u8>(v)`) must propagate.
        collect_from_expr(m, e.left)
        collect_from_expr(m, e.right)
    else if k == EXPR_TRY
        # `expr?` — recurse into the wrapped expression.
        collect_from_expr(m, e.left)
    else if k == EXPR_ARRAY_LIT
        # [a, b, c]: the elements are the args list.  Without this a generic
        # call that is an element was never instantiated (AGAST #2831).
        var el: *Expr = e.args
        while el != null
            collect_from_expr(m, el)
            el = el.next
    else if k == EXPR_ARRAY_FILL
        # [value; N] keeps value in left (AGAST #2831)
        collect_from_expr(m, e.left)
    else if k == EXPR_MATCH or k == EXPR_IF
        # EXPR_IF (#1613) has the same shape: condition in left, arms in args.
        # match scrutinee \n pattern => body
        # Scrutinee is e.left; arms are e.args recast as *MatchArm.
        # Each arm has body: *Expr (or null for `pass` arms).  Walking
        # arms as *Expr would crash for the same reason struct lits did.
        collect_from_expr(m, e.left)
        var scrut: *Expr = null
        if k == EXPR_MATCH
            scrut = e.left
        collect_from_arms(m, scrut, e.args as *MatchArm)

# ============================================================================
# Generic Function Lookup
# ============================================================================
# Find the generic template for a given function name

fn find_generic_function(m: *Module, name: *u8, name_len: i32) -> *FnDef
    var f: *FnDef = m.functions
    while f != null
        if f.type_params != null
            if f.name_len == name_len
                if memcmp(f.name, name, name_len as i64) == 0
                    return f
        f = f.next
    return null

# ============================================================================
# Type Substitution
# ============================================================================
# Given a type suffix like "$u8", parse out the type name

# AGAST #186: detect ritz0-compatible pointer suffix `$ptr_<TypeName>` so the
# monomorphizer can substitute T with `*Concrete` instead of treating
# "ptr_Foo" as the literal struct name.  Returns 1 iff suffix starts with
# `$ptr_` (5-char prefix after the `$`) and has at least one char of payload.
# AGAST #1794: `$ref_` (`id<@E>`, same length) counts too — a reference is a
# pointer at the IR level, so T substitutes as `*E` either way.
fn suffix_is_ptr(suffix: *u8, suffix_len: i32) -> i32
    if suffix_len < 6
        return 0
    if *(suffix + 0) != 36   # '$'
        return 0
    if *(suffix + 4) != 95   # '_'
        return 0
    if *(suffix + 1) == 112 and *(suffix + 2) == 116 and *(suffix + 3) == 114  # "ptr"
        return 1
    if *(suffix + 1) == 114 and *(suffix + 2) == 101 and *(suffix + 3) == 102  # "ref"
        return 1
    0

fn parse_type_from_suffix(suffix: *u8, suffix_len: i32) -> i32
    # Suffix format: "$typename" where typename is u8, i32, etc.
    # Skip the leading $
    if suffix_len < 2
        return 0  # TYPE_VOID as unknown

    # Pointer-typed generic instantiation (AGAST #186): suffix starts with
    # `$ptr_` — substitute T → *<Pointee>.  TYPE_PTR represents the bare
    # `*T` form; the pointee struct name is carried separately.
    if suffix_is_ptr(suffix, suffix_len) == 1
        return TYPE_PTR

    let type_name: *u8 = suffix + 1
    let type_len: i32 = suffix_len - 1

    # Every primitive ritz0 spells (AGAST #1922: only five were matched, so
    # `ident<u32>` substituted T as a struct named "u32").
    let prim: i32 = primitive_type_from_name(type_name, type_len)
    if prim != 0
        return prim

    # AGAST #2832: `$arr2_i8` is the array `[2]i8`.
    var a: ArrayArg
    if array_arg_decode(type_name, type_len, @a) == 1
        return TYPE_ARRAY

    # Could be a struct type
    return TYPE_STRUCT

# AGAST #2832: an array type argument as ast_helpers' spell_last_array spells
# it, "arr" N "_" E: E a primitive's name, a struct's, or "ptr_" + either.
struct ArrayArg
    size: i32
    elem: i32          # TYPE_* of the element
    pointee: i32       # for a TYPE_PTR element, its pointee's TYPE_*
    name: *u8          # the struct named by the element or its pointee
    name_len: i32

# 1 and *out filled when name[0..len] spells an array, else 0.
fn array_arg_decode(name: *u8, len: i32, out: *ArrayArg) -> i32
    if name == null or len < 6 or memcmp(name, c"arr", 3) != 0
        return 0
    var pos: i32 = 3
    var size: i32 = 0
    while pos < len and *(name + pos) >= 48 and *(name + pos) <= 57
        size = size * 10 + (*(name + pos) - 48) as i32
        pos = pos + 1
    if pos == 3 or pos + 1 >= len or *(name + pos) != 95   # digits, '_', element
        return 0
    pos = pos + 1
    var elem: *u8 = name + pos
    var elem_len: i32 = len - pos
    out.size = size
    out.elem = TYPE_STRUCT
    out.pointee = TYPE_VOID
    if elem_len > 4 and memcmp(elem, c"ptr_", 4) == 0
        out.elem = TYPE_PTR
        elem = elem + 4
        elem_len = elem_len - 4
    let prim: i32 = primitive_type_from_name(elem, elem_len)
    if prim != 0
        out.name = null
        out.name_len = 0
        if out.elem == TYPE_PTR
            out.pointee = prim
        else
            out.elem = prim
        return 1
    out.name = elem
    out.name_len = elem_len
    if out.elem == TYPE_PTR
        out.pointee = TYPE_STRUCT
    1

fn get_type_name_from_suffix(suffix: *u8, suffix_len: i32, out_name: **u8, out_len: *i32)
    # Suffix format: "$typename" or (AGAST #186) "$ptr_<typename>".
    # For the pointer form we return the underlying struct name (no `ptr_`
    # prefix) so substitute_type_param_in_name can mangle dependent generics
    # like `Option<T> -> Option$ptr_Page` correctly via the original
    # `$ptr_Page` suffix passed alongside.
    if suffix_len < 2
        *out_name = null
        *out_len = 0
        return
    if suffix_is_ptr(suffix, suffix_len) == 1
        *out_name = suffix + 5  # skip "$ptr_"
        *out_len = suffix_len - 5
        return
    *out_name = suffix + 1
    *out_len = suffix_len - 1

# ============================================================================
# Function Cloning and Substitution
# ============================================================================
# Clone a generic function and substitute the type parameter

# ----------------------------------------------------------------------------
# Multi-parameter generic fns (AGAST #1612)
# ----------------------------------------------------------------------------
# `second<T, U>` called as `second<i64, i32>` carries the suffix "$i64$i32".
# The cloning machinery below substitutes ONE parameter at a time, so a
# multi-parameter template is specialised in one pass per parameter: T at
# "$i64" gives `second$i64` (U still free), then U at "$i32" gives
# `second$i64$i32`.  Each pass appends its argument to the name, so the last
# pass's name is the template's plus the whole suffix — the call site's
# spelling.
#
# While those passes run, g_mono_component_mode switches name rewriting to
# whole `$`-components: `Result$T$E` must become `Result$i32$E` and then
# `Result$i32$i64`, where single-parameter mode only rewrites a trailing
# `$T` and otherwise APPENDS the suffix (its `@&Vec<T>` -> "Vec" + "$u8"
# convention).  Nested generic calls are not registered mid-way — a pass-1
# `helper<T, U>` would register the half-substituted `helper$i64$U` — but
# once, from the finished body (collect_from_fn_body).
var g_mono_component_mode: i32 = 0

fn clone_and_specialize_function(m: *Module, template: *FnDef, suffix: *u8, suffix_len: i32) -> *FnDef
    let n: i32 = count_type_params(template.type_params)
    if n < 2
        var tp_name: *u8 = null
        var tp_len: i32 = 0
        if template.type_params != null
            tp_name = template.type_params.name
            tp_len = template.type_params.name_len
        return specialize_fn_one_param(m, template, tp_name, tp_len, suffix, suffix_len)

    let cap: i64 = 4 * mangled_arg_capacity(suffix, suffix_len) as i64
    let starts: *i32 = malloc(cap) as *i32
    let lens: *i32 = malloc(cap) as *i32
    if split_mangled_args(m, suffix, suffix_len, starts, lens) != n
        # Wrong arity for this template (e.g. `pair<i64>`): nothing sound to
        # emit.  The call stays unresolved and fails at link, loudly.
        return null
    g_mono_component_mode = 1
    var cur: *FnDef = template
    var tp: *TypeParam = template.type_params
    var i: i32 = 0
    while tp != null
        cur = specialize_fn_one_param(m, cur, tp.name, tp.name_len, suffix + *(starts + i), *(lens + i))
        tp = tp.next
        i = i + 1
    g_mono_component_mode = 0
    collect_from_fn_body(m, cur.body)
    cur

# Rewrite every `$`-separated component of `name` that equals type_param to
# the argument of the one-argument suffix "$arg" (new_suffix):
# `Result$T$E` at T="$i32" is `Result$i32$E`; `T` alone is `i32`.  Returns
# `name` itself (and *out_len = name_len) when no component matches.
fn replace_param_component(name: *u8, name_len: i32, type_param: *u8, type_param_len: i32, new_suffix: *u8, new_suffix_len: i32, out_len: *i32) -> *u8
    *out_len = name_len
    if name == null or type_param == null or new_suffix_len < 1
        return name
    let arg: *u8 = new_suffix + 1
    let arg_len: i32 = new_suffix_len - 1
    # Pass 1: count matches to size the output.
    var hits: i32 = 0
    var pos: i32 = 0
    while pos <= name_len
        var end: i32 = pos
        while end < name_len and *(name + end) != 36   # '$'
            end = end + 1
        if end - pos == type_param_len and memcmp(name + pos, type_param, type_param_len as i64) == 0
            hits = hits + 1
        pos = end + 1
    if hits == 0
        return name
    # Pass 2: build it.
    let total: i32 = name_len + hits * (arg_len - type_param_len)
    let out: *u8 = malloc(total as i64 + 1) as *u8
    var o: i32 = 0
    pos = 0
    while pos <= name_len
        var end: i32 = pos
        while end < name_len and *(name + end) != 36
            end = end + 1
        if end - pos == type_param_len and memcmp(name + pos, type_param, type_param_len as i64) == 0
            for j in 0..arg_len
                *(out + o) = *(arg + j)
                o = o + 1
        else
            for j in pos..end
                *(out + o) = *(name + j)
                o = o + 1
        if end < name_len
            *(out + o) = 36
            o = o + 1
        pos = end + 1
    *(out + o) = 0
    *out_len = o
    out

# Specialise `template` at ONE type parameter (type_param_name) bound to the
# one-argument suffix "$arg".  The result's name is template.name + suffix.
fn specialize_fn_one_param(m: *Module, template: *FnDef, type_param_name: *u8, type_param_len: i32, suffix: *u8, suffix_len: i32) -> *FnDef
    g_mono_module = m  # AGAST #1926: see names_generic_struct
    # Create a new FnDef with mangled name
    let mangled_name_len: i32 = template.name_len + suffix_len
    let mangled_name: *u8 = malloc(mangled_name_len as i64 + 1) as *u8

    # Copy base name
    for i in 0..template.name_len
        *(mangled_name + i) = *(template.name + i)

    # Copy suffix (including the $)
    for j in 0..suffix_len
        *(mangled_name + template.name_len + j) = *(suffix + j)
    *(mangled_name + mangled_name_len) = 0

    # Get the substitution type from suffix
    var subst_type_name: *u8 = null
    var subst_type_len: i32 = 0
    get_type_name_from_suffix(suffix, suffix_len, @subst_type_name, @subst_type_len)
    let subst_type: i32 = parse_type_from_suffix(suffix, suffix_len)

    # Clone the function with specialized name
    # Sized with sizeof(FnDef) (AGAST #1663) — type_params lives at the
    # tail.  Earlier code used malloc(88), undersizing the struct by one
    # pointer slot.  In selfhost ritz1 that meant `specialized.type_params =
    # null` wrote into adjacent heap, leaving type_params junked → emit_module's
    # `if f.type_params != null` skipped the specialized fn → only `declare`
    # emitted at the call site, with i64 fallback types.  Cluster of 4+
    # selfhost asm-fails fixed by widening this allocation.
    let specialized: *FnDef = malloc(sizeof(FnDef)) as *FnDef
    specialized.name = mangled_name
    specialized.name_len = mangled_name_len
    specialized.params = clone_params_with_suffix(template.params, type_param_name, type_param_len, subst_type, subst_type_name, subst_type_len, suffix, suffix_len)
    specialized.return_type = substitute_type(template.return_type, type_param_name, type_param_len, subst_type, subst_type_name, subst_type_len)
    specialized.body = clone_body(template.body, type_param_name, type_param_len, subst_type, subst_type_name, subst_type_len, suffix, suffix_len)
    specialized.type_params = null  # Not generic anymore
    specialized.next = null
    specialized.line = template.line
    specialized.return_type_name = template.return_type_name
    specialized.return_type_name_len = template.return_type_name_len
    # AGAST #194: monomorphizations are emitted in every module that uses
    # them, with `linkonce_odr` linkage so the linker dedupes copies.
    # Mark is_local=1 so the emit_fn loop emits the body (rather than a
    # `declare`).
    specialized.is_local = 1
    specialized.ret_fn_sig = template.ret_fn_sig   # AGAST #2120
    specialized.ret_ref = clone_params_with_suffix(template.ret_ref, type_param_name, type_param_len, subst_type, subst_type_name, subst_type_len, suffix, suffix_len)   # AGAST #2308
    specialized.ret_written_void = template.ret_written_void   # AGAST #2236
    specialized.ret_array = null   # AGAST #2343: `[N]T` keeps T's own name; left unjudged
    specialized.ret_ptr_array = ptr_array_unless_generic(template.ret_ptr_array)   # AGAST #2329
    specialized.def_file = template.def_file   # AGAST #2236: names the diagnostic's file
    fn_copy_instance_attrs(specialized, template)   # [[callconv]] / [[test_helper]] (#1879, #1869)

    # Handle return type struct name substitution
    if specialized.return_type == TYPE_STRUCT
        if specialized.return_type_name != null
            # Check if it matches the type param exactly (e.g., "T" -> "u8")
            if specialized.return_type_name_len == type_param_len
                if memcmp(specialized.return_type_name, type_param_name, type_param_len as i64) == 0
                    # Substitute with concrete type
                    specialized.return_type = subst_type
                    specialized.return_type_name = subst_type_name
                    specialized.return_type_name_len = subst_type_len
            # Otherwise it might be a generic struct like "Vec$T" -> "Vec$u8"
            else
                var new_name: *u8 = null
                var new_len: i32 = 0
                substitute_type_param_in_name(specialized.return_type_name, specialized.return_type_name_len, type_param_name, type_param_len, suffix, suffix_len, @new_name, @new_len)
                specialized.return_type_name = new_name
                specialized.return_type_name_len = new_len
    # AGAST #1980: `-> *T` names its pointee "T" too.  Left unsubstituted,
    # `let p = vec_as_ptr<i32>(@v)` registered p as a pointer to struct %T
    # (`load %T`, byte stride).  Name the concrete pointee instead: a
    # primitive ("i32", which the let path maps to a pointee kind) or a
    # struct.
    #
    # AGAST #2791: T = *U ($ptr_ suffix) makes the return `**U`, recorded as
    # a written `-> **U` is (TYPE_PTR_PTR, named U).  It stayed a `*T` named
    # "T", which no stride lookup resolves, so `vec_as_ptr<*u8>(@v) + i`
    # added i BYTES and execve got byte-shifted argv pointers (#2790).
    else if specialized.return_type == TYPE_PTR
        if specialized.return_type_name != null and specialized.return_type_name_len == type_param_len
            if memcmp(specialized.return_type_name, type_param_name, type_param_len as i64) == 0
                if subst_type == TYPE_PTR
                    specialized.return_type = TYPE_PTR_PTR
                specialized.return_type_name = subst_type_name
                specialized.return_type_name_len = subst_type_len

    return specialized

# `sh` with a leaf `T` substituted (AGAST #2290).  Shapes are shared, so a change
# is a copy.
fn array_shape_subst(sh: *ArrayShape, type_param: *u8, type_param_len: i32, subst_type: i32, subst_name: *u8, subst_len: i32) -> *ArrayShape
    if sh == null or sh.leaf_name_len != type_param_len or memcmp(sh.leaf_name, type_param, type_param_len as i64) != 0
        return sh
    let out: *ArrayShape = malloc(sizeof(ArrayShape)) as *ArrayShape
    *out = *sh
    out.leaf_type = subst_type
    out.leaf_name = subst_name
    out.leaf_name_len = subst_len
    return out

# A reference param that holds a pointer records what that pointer points at,
# and a `:&` one reads as the pointer, so it needs it twice.
fn set_ref_ptr_pointee(param: *Param, pointee: i32)
    param.param_ref_ptr_pointee = pointee
    if param.is_borrow == 1
        param.param_inner_pointee_type = pointee

# What a `*U` type argument points at, from get_type_name_from_suffix's name for
# it: U's spelling, which is `ptr_C` when U is itself the pointer `*C`.
fn ptr_arg_pointee(name: *u8, len: i32) -> i32
    if len > 4 and memcmp(name, c"ptr_", 4) == 0
        return TYPE_PTR
    let prim: i32 = primitive_type_from_name(name, len)
    if prim != 0
        return prim
    TYPE_STRUCT

fn clone_params_with_suffix(params: *Param, type_param: *u8, type_param_len: i32, subst_type: i32, subst_name: *u8, subst_len: i32, suffix: *u8, suffix_len: i32) -> *Param
    if params == null
        return null

    let cloned: *Param = malloc(sizeof(Param)) as *Param
    cloned.name = params.name
    cloned.name_len = params.name_len
    cloned.param_type = substitute_type(params.param_type, type_param, type_param_len, subst_type, subst_name, subst_len)
    cloned.param_type_name = params.param_type_name
    cloned.param_type_name_len = params.param_type_name_len
    cloned.param_pointee_type = params.param_pointee_type
    cloned.param_inner_pointee_type = params.param_inner_pointee_type  # AGAST #1815
    # AGAST #1953, #2321.  A generic `*[N]T` keeps its TYPE_ARRAY pointee below.
    cloned.param_pointee_array_size = params.param_pointee_array_size
    cloned.param_pointee_array_elem_type = params.param_pointee_array_elem_type
    cloned.param_pointee_array_elem_pointee = params.param_pointee_array_elem_pointee
    cloned.param_pointee_array_shape = array_shape_subst(params.param_pointee_array_shape, type_param, type_param_len, subst_type, subst_name, subst_len)  # AGAST #2290
    cloned.param_array_size = params.param_array_size
    cloned.param_array_elem_type = params.param_array_elem_type
    cloned.param_array_elem_pointee = params.param_array_elem_pointee   # AGAST #2332
    cloned.is_borrow = params.is_borrow
    cloned.is_self_borrow = params.is_self_borrow
    cloned.param_ref_ptr_pointee = params.param_ref_ptr_pointee   # AGAST #2308
    cloned.name_span.line = params.name_span.line   # AGAST #2407
    cloned.name_span.col = params.name_span.col
    cloned.fn_sig = clone_fn_sig(params.fn_sig, type_param, type_param_len, subst_type, subst_name, subst_len, suffix, suffix_len)  # AGAST #1671

    # AGAST #2287: `a: [N]T` takes T's element type and name; `[N]Vec<T>` its name.
    if cloned.param_type == TYPE_ARRAY and cloned.param_type_name != null and params.param_type == TYPE_ARRAY
        if cloned.param_type_name_len == type_param_len and memcmp(cloned.param_type_name, type_param, type_param_len as i64) == 0
            if cloned.param_array_elem_type == TYPE_STRUCT
                cloned.param_array_elem_type = subst_type
            if cloned.param_array_elem_pointee == TYPE_STRUCT
                cloned.param_array_elem_pointee = subst_type   # AGAST #2332: `[N]*T`
            cloned.param_type_name = subst_name
            cloned.param_type_name_len = subst_len
        else
            var arr_name: *u8 = null
            var arr_len: i32 = 0
            substitute_type_param_in_name(cloned.param_type_name, cloned.param_type_name_len, type_param, type_param_len, suffix, suffix_len, @arr_name, @arr_len)
            cloned.param_type_name = arr_name
            cloned.param_type_name_len = arr_len

    # Handle struct type name substitution for TYPE_STRUCT
    if cloned.param_type == TYPE_STRUCT and cloned.param_type_name != null
        if cloned.param_type_name_len == type_param_len and memcmp(cloned.param_type_name, type_param, type_param_len as i64) == 0
            cloned.param_type = subst_type
            cloned.param_type_name = subst_name
            cloned.param_type_name_len = subst_len
        else
            # AGAST #2418: a by-value `o: Option<T>` / `r: Result<T, E>` /
            # `p: Pair<T>` is named "Option$T" etc.  It kept that name, so
            # `f<i32>` was defined with a `%Option$T` argument.
            var by_name: *u8 = null
            var by_len: i32 = 0
            substitute_type_param_in_name(cloned.param_type_name, cloned.param_type_name_len, type_param, type_param_len, suffix, suffix_len, @by_name, @by_len)
            cloned.param_type_name = by_name
            cloned.param_type_name_len = by_len

    # Handle pointer/reference-to-struct type name substitution (e.g., *Vec<T> -> *Vec$u8, @&Vec<T> -> @&Vec$u8)
    if (cloned.param_type == TYPE_PTR or cloned.param_type == TYPE_REF or cloned.param_type == TYPE_MUT_REF) and cloned.param_type_name != null
        # Special case: bare *T / @T / @&T — param_type_name is exactly "T".
        # Here param_pointee_type was parsed as TYPE_STRUCT (since T looks like
        # a struct name). Concretize pointee to subst_type (e.g. TYPE_U8) so
        # get_ptr_elem_size yields 1 instead of defaulting struct-unknown=8,
        # and deref loads produce the right bit-width (load i8, not i64).
        if cloned.param_type_name_len == type_param_len
            if memcmp(cloned.param_type_name, type_param, type_param_len as i64) == 0
                # AGAST #2279: `c:& [2]T` names T too, but holds an array, and a
                # by-value `T` slot must not read its first element.  So do
                # `@[2]T` and `@&[2]T` (#2287), and `*[2]T`: `p[i]` means one
                # thing for all three (#2321).
                if cloned.param_pointee_type == TYPE_ARRAY
                    cloned.param_pointee_array_elem_type = subst_type
                else if cloned.param_type != TYPE_PTR and cloned.param_pointee_type == TYPE_PTR
                    # AGAST #2308: `@&*T` is still a reference to a pointer.
                    set_ref_ptr_pointee(cloned, subst_type)
                else
                    cloned.param_pointee_type = subst_type
                    # AGAST #2345: so is `@&T` at T = `*U`.  subst_type only says
                    # TYPE_PTR, so `r:& T` was left as `r:& *<nothing>`: it never
                    # bound as its referent, and `r = v` overwrote its own slot.
                    if subst_type == TYPE_PTR
                        set_ref_ptr_pointee(cloned, ptr_arg_pointee(subst_name, subst_len))
                cloned.param_type_name = subst_name
                cloned.param_type_name_len = subst_len
                # AGAST #2832: a bare `c:& T` / `*T` at T = `[2]f64` points at
                # that array, recorded as a written `c:& [2]f64` is (N, E, E's
                # name).  Not `c:& [2]T`, which held TYPE_ARRAY already.
                var arr: ArrayArg
                if params.param_pointee_type != TYPE_ARRAY and cloned.param_pointee_type == TYPE_ARRAY and array_arg_decode(subst_name, subst_len, @arr) == 1
                    cloned.param_pointee_array_size = arr.size
                    cloned.param_pointee_array_elem_type = arr.elem
                    cloned.param_pointee_array_elem_pointee = arr.pointee
                    cloned.param_pointee_array_shape = null
                    cloned.param_type_name = arr.name
                    cloned.param_type_name_len = arr.name_len
        else
            var new_name: *u8 = null
            var new_len: i32 = 0
            substitute_type_param_in_name(cloned.param_type_name, cloned.param_type_name_len, type_param, type_param_len, suffix, suffix_len, @new_name, @new_len)
            cloned.param_type_name = new_name
            cloned.param_type_name_len = new_len

    # AGAST #1924: a `**T` param (any depth) records its innermost pointee as
    # TYPE_STRUCT named "T"; concretize it as the `*T` case above does, so
    # `*(*(pp + i) + k)` in pp_get<i32> loads an i32 and strides by 4.
    if cloned.param_type == TYPE_PTR_PTR and ptr_ptr_slot_inner(cloned.param_inner_pointee_type) == TYPE_STRUCT
        if cloned.param_type_name != null and cloned.param_type_name_len == type_param_len and memcmp(cloned.param_type_name, type_param, type_param_len as i64) == 0
            cloned.param_inner_pointee_type = ptr_ptr_slot_subst(cloned.param_inner_pointee_type, subst_type)
            cloned.param_type_name = subst_name
            cloned.param_type_name_len = subst_len

    cloned.next = clone_params_with_suffix(params.next, type_param, type_param_len, subst_type, subst_name, subst_len, suffix, suffix_len)
    return cloned

# AGAST #1671: a `fn(T) -> T` type inside a generic body is specialized
# like the enclosing fn's own params and return type, so a call through it
# uses the instantiation's signature (`fn(u8) -> u8`), not `%T`.
fn clone_fn_sig(sig: *FnDef, type_param: *u8, type_param_len: i32, subst_type: i32, subst_name: *u8, subst_len: i32, suffix: *u8, suffix_len: i32) -> *FnDef
    if sig == null
        return null
    let c: *FnDef = malloc(sizeof(FnDef)) as *FnDef
    c.name = sig.name
    c.name_len = sig.name_len
    c.params = clone_params_with_suffix(sig.params, type_param, type_param_len, subst_type, subst_name, subst_len, suffix, suffix_len)
    c.return_type = sig.return_type
    c.return_type_name = sig.return_type_name
    c.return_type_name_len = sig.return_type_name_len
    if sig.return_type == TYPE_STRUCT and sig.return_type_name != null
        if sig.return_type_name_len == type_param_len and memcmp(sig.return_type_name, type_param, type_param_len as i64) == 0
            c.return_type = subst_type
            c.return_type_name = subst_name
            c.return_type_name_len = subst_len
        else
            var rn: *u8 = null
            var rl: i32 = 0
            substitute_type_param_in_name(sig.return_type_name, sig.return_type_name_len, type_param, type_param_len, suffix, suffix_len, @rn, @rl)
            c.return_type_name = rn
            c.return_type_name_len = rl
    c.ret_written_void = sig.ret_written_void   # AGAST #2236
    c.body = null
    c.line = sig.line
    c.next = null
    c.type_params = null
    c.is_local = 0
    c.ret_fn_sig = null   # AGAST #2120: a fn type's own return is not tracked
    c.ret_ref = null
    c.ret_array = null
    c.ret_ptr_array = null
    return c

fn clone_params(params: *Param, type_param: *u8, type_param_len: i32, subst_type: i32, subst_name: *u8, subst_len: i32) -> *Param
    # Legacy wrapper - doesn't handle pointer-to-struct substitution
    return clone_params_with_suffix(params, type_param, type_param_len, subst_type, subst_name, subst_len, null, 0)

fn substitute_type(ty: i32, type_param: *u8, type_param_len: i32, subst_type: i32, subst_name: *u8, subst_len: i32) -> i32
    # For simple types, no substitution needed
    if ty != TYPE_STRUCT
        return ty
    # For struct types, we need to check if it's the type param
    # The caller should handle struct name substitution
    return ty

fn mangle_struct_name(name: *u8, name_len: i32, suffix: *u8, suffix_len: i32) -> *u8
    # Create mangled name like Vec$u8
    let mangled_len: i32 = name_len + suffix_len
    let mangled: *u8 = malloc(mangled_len as i64 + 1) as *u8
    for i in 0..name_len
        *(mangled + i) = *(name + i)
    for j in 0..suffix_len
        *(mangled + name_len + j) = *(suffix + j)
    *(mangled + mangled_len) = 0
    return mangled

# The module being specialised, so substitute_type_param_in_name can ask
# whether a bare name is a generic struct template (AGAST #1926).  Set by
# specialize_fn_one_param, through which every clone_* path runs.
var g_mono_module: *Module = null

fn names_generic_struct(name: *u8, name_len: i32) -> i32
    if g_mono_module == null
        return 0
    if find_generic_struct(g_mono_module, name, name_len) == null
        return 0
    1

# Substitute type parameter in a mangled name like "Vec$T" -> "Vec$u8"
# Input: name = "Vec$T", type_param = "T", new_suffix = "$u8"
# Output: "Vec$u8"
fn substitute_type_param_in_name(name: *u8, name_len: i32, type_param: *u8, type_param_len: i32, new_suffix: *u8, new_suffix_len: i32, out_name: **u8, out_len: *i32)
    # AGAST #1612: multi-parameter passes rewrite whole components, anywhere
    # in the name, and never append (see g_mono_component_mode).
    if g_mono_component_mode != 0
        *out_name = replace_param_component(name, name_len, type_param, type_param_len, new_suffix, new_suffix_len, out_len)
        return
    # Check if name ends with "$T" where T is the type param
    # Expected pattern: "Base$T" where Base is some prefix
    let expected_suffix_len: i32 = type_param_len + 1  # "$" + type_param
    if name_len > expected_suffix_len
        let suffix_start: i32 = name_len - expected_suffix_len
        # Check for '$' separator
        if *(name + suffix_start) == 36  # '$'
            # Check if rest matches type param
            var matches: i32 = 1
            for i in 0..type_param_len
                if *(name + suffix_start + 1 + i) != *(type_param + i)
                    matches = 0
                    break
            if matches != 0
                # Replace "$T" with new_suffix
                let base_len: i32 = suffix_start  # "Vec" part
                let new_len: i32 = base_len + new_suffix_len
                let result: *u8 = malloc(new_len as i64 + 1) as *u8
                # Copy base part
                for j in 0..base_len
                    *(result + j) = *(name + j)
                # Copy new suffix
                for k in 0..new_suffix_len
                    *(result + base_len + k) = *(new_suffix + k)
                *(result + new_len) = 0
                *out_name = result
                *out_len = new_len
                return

    # AGAST #2418: T as an inner component, `Result$T$i32` at T = i32 is
    # `Result$i32$i32` (one-parameter fn over `Result<T, i32>`).
    if new_suffix_len > 0 and find_dollar_sign(name, name_len) >= 0
        var hit_len: i32 = name_len
        let hit: *u8 = replace_param_component(name, name_len, type_param, type_param_len, new_suffix, new_suffix_len, @hit_len)
        if hit != name
            *out_name = hit
            *out_len = hit_len
            return

    # If the name doesn't have $T pattern, it might be a bare struct name like "Vec"
    # that needs the suffix appended (for @&Vec<T> parameters).  Only a generic
    # struct TEMPLATE gets it: a plain struct (`p: *Cell`, `var c: Cell`,
    # `Cell { .. }`) keeps its name, else `Cell` -> `Cell$i64`, which does not
    # exist (AGAST #1926).
    if new_suffix_len > 0 and names_generic_struct(name, name_len) != 0
        # Append the new suffix (e.g., "Vec" + "$u8" = "Vec$u8")
        let new_len: i32 = name_len + new_suffix_len
        let result: *u8 = malloc(new_len as i64 + 1) as *u8
        for i in 0..name_len
            *(result + i) = *(name + i)
        for k in 0..new_suffix_len
            *(result + name_len + k) = *(new_suffix + k)
        *(result + new_len) = 0
        *out_name = result
        *out_len = new_len
    else
        # No substitution needed - just copy the name
        let copy: *u8 = malloc(name_len as i64 + 1) as *u8
        for i in 0..name_len
            *(copy + i) = *(name + i)
        *(copy + name_len) = 0
        *out_name = copy
        *out_len = name_len

fn clone_body(body: *Stmt, type_param: *u8, type_param_len: i32, subst_type: i32, subst_name: *u8, subst_len: i32, suffix: *u8, suffix_len: i32) -> *Stmt
    if body == null
        return null

    let cloned: *Stmt = clone_stmt(body, type_param, type_param_len, subst_type, subst_name, subst_len, suffix, suffix_len)

    # Clone the rest of the statement list
    if body.next != null
        cloned.next = clone_body(body.next, type_param, type_param_len, subst_type, subst_name, subst_len, suffix, suffix_len)

    return cloned

# AGAST #1925: a clone starts as a byte copy of its template, and each case
# below then replaces the child Expr / Stmt pointers with deep clones.  Before
# this, a clone copied only the fields its case listed, and malloc does not
# zero memory.  A kind with no case (STMT_INDEX_ASSIGN, EXPR_ARRAY_LIT, ...)
# kept its kind but had uninitialised fields, so `a[0] = v` and
# `let a: [2]i64 = [7, 9]` emitted nothing in a generic fn's instantiation.
# Scalars (names, kinds, a cast's pointee) are now always carried over.  A
# kind that has no case still fails loudly (clone_unknown_kind), so a new kind
# can't share the template's child pointers without anyone noticing.
fn clone_unknown_kind(what: *u8, kind: i32)
    eprints_cstr(c"error: ritz1 monomorph: ")
    eprints_cstr(what)
    eprints_cstr(c" has no case for kind ")
    eprint_int(kind as i64)
    eprints_cstr(c"\n")
    sys_exit(1)

fn clone_stmt(s: *Stmt, type_param: *u8, type_param_len: i32, subst_type: i32, subst_name: *u8, subst_len: i32, suffix: *u8, suffix_len: i32) -> *Stmt
    let cloned: *Stmt = malloc(sizeof(Stmt)) as *Stmt
    memcpy(cloned as *u8, s as *u8, sizeof(Stmt))  # AGAST #1925
    cloned.next = null

    let k: i32 = s.kind
    # A store keeps the template's sharing (AGAST #2529, clone_memo_find).
    let memo_was: i32 = g_clone_memo_on
    let memo_base: i32 = g_clone_memo_count
    if is_store_stmt(k) == 1
        g_clone_memo_on = 1
    if k == STMT_EXPR
        cloned.expr = clone_expr(s.expr, type_param, type_param_len, subst_type, subst_name, subst_len, suffix, suffix_len)
    else if k == STMT_RETURN
        if s.return_value != null
            cloned.return_value = clone_expr(s.return_value, type_param, type_param_len, subst_type, subst_name, subst_len, suffix, suffix_len)
        else
            cloned.return_value = null
    else if k == STMT_VAR_DECL
        cloned.var_name = s.var_name
        cloned.var_name_len = s.var_name_len
        cloned.var_type = s.var_type
        cloned.var_declared_type = s.var_declared_type  # AGAST #1364
        cloned.var_src_file = s.var_src_file
        cloned.var_array_size = s.var_array_size
        cloned.var_array_elem_type = s.var_array_elem_type
        cloned.var_pointee_type = s.var_pointee_type
        cloned.var_inner_pointee_type = s.var_inner_pointee_type  # AGAST #1815
        # AGAST #1924: `let pp: **T` concretizes T like a `**T` param.
        var pp_local_subst: i32 = 0
        if s.var_type == TYPE_PTR_PTR and ptr_ptr_slot_inner(s.var_inner_pointee_type) == TYPE_STRUCT
            if s.var_type_name != null and s.var_type_name_len == type_param_len and memcmp(s.var_type_name, type_param, type_param_len as i64) == 0
                cloned.var_inner_pointee_type = ptr_ptr_slot_subst(s.var_inner_pointee_type, subst_type)
                pp_local_subst = 1
        cloned.var_fn_sig = clone_fn_sig(s.var_fn_sig, type_param, type_param_len, subst_type, subst_name, subst_len, suffix, suffix_len)  # AGAST #1671
        # Substitute type param in variable type name (e.g., Vec<T> -> Vec$u8)
        if s.var_type == TYPE_STRUCT and s.var_type_name != null and s.var_type_name_len == type_param_len and memcmp(s.var_type_name, type_param, type_param_len as i64) == 0
            # A bare `T` local (`let item: T`, vec_slice<T>) becomes the
            # argument type itself, as clone_params_with_suffix does for a
            # bare `T` param.  The name path below would append the suffix
            # and declare the struct `%T$i32` (AGAST #1794).
            cloned.var_type = subst_type
            cloned.var_declared_type = subst_type
            cloned.var_type_name = subst_name
            cloned.var_type_name_len = subst_len
        else if s.var_type == TYPE_STRUCT and s.var_type_name != null
            var new_name_ptr: *u8 = null
            var new_name_len: i32 = 0
            substitute_type_param_in_name(s.var_type_name, s.var_type_name_len, type_param, type_param_len, suffix, suffix_len, @new_name_ptr, @new_name_len)
            cloned.var_type_name = new_name_ptr
            cloned.var_type_name_len = new_name_len
        else if pp_local_subst == 1
            cloned.var_type_name = subst_name
            cloned.var_type_name_len = subst_len
        else
            cloned.var_type_name = s.var_type_name
            cloned.var_type_name_len = s.var_type_name_len
        # AGAST #2332: `var a: [N]*T` at T = the argument.
        if s.var_array_elem_pointee == TYPE_STRUCT and s.var_type_name != null and s.var_type_name_len == type_param_len and memcmp(s.var_type_name, type_param, type_param_len as i64) == 0
            cloned.var_array_elem_pointee = subst_type
            cloned.var_type_name = subst_name
            cloned.var_type_name_len = subst_len
        # AGAST #2308: `let p: @&T` concretizes T as a `@&T` param does.
        cloned.var_ref = clone_params_with_suffix(s.var_ref, type_param, type_param_len, subst_type, subst_name, subst_len, suffix, suffix_len)
        if cloned.var_ref != null
            stmt_take_var_ref(cloned)
        if s.var_init != null
            cloned.var_init = clone_expr(s.var_init, type_param, type_param_len, subst_type, subst_name, subst_len, suffix, suffix_len)
        else
            cloned.var_init = null
    else if k == STMT_ASSIGN
        cloned.assign_target = s.assign_target
        cloned.assign_target_len = s.assign_target_len
        cloned.assign_value = clone_expr(s.assign_value, type_param, type_param_len, subst_type, subst_name, subst_len, suffix, suffix_len)
        # When assign_target_len == 0, target expression is stored in if_cond
        if s.assign_target_len == 0
            cloned.if_cond = clone_expr(s.if_cond as *Expr, type_param, type_param_len, subst_type, subst_name, subst_len, suffix, suffix_len)
    else if k == STMT_IF
        cloned.if_cond = clone_expr(s.if_cond, type_param, type_param_len, subst_type, subst_name, subst_len, suffix, suffix_len)
        cloned.if_then = clone_body(s.if_then, type_param, type_param_len, subst_type, subst_name, subst_len, suffix, suffix_len)
        if s.if_else != null
            cloned.if_else = clone_body(s.if_else, type_param, type_param_len, subst_type, subst_name, subst_len, suffix, suffix_len)
        else
            cloned.if_else = null
    else if k == STMT_WHILE
        cloned.while_cond = clone_expr(s.while_cond, type_param, type_param_len, subst_type, subst_name, subst_len, suffix, suffix_len)
        cloned.while_body = clone_body(s.while_body, type_param, type_param_len, subst_type, subst_name, subst_len, suffix, suffix_len)
    else if k == STMT_FOR
        cloned.for_var = s.for_var
        cloned.for_var_len = s.for_var_len
        cloned.for_inclusive = s.for_inclusive
        cloned.for_start = clone_expr(s.for_start, type_param, type_param_len, subst_type, subst_name, subst_len, suffix, suffix_len)
        cloned.for_end = clone_expr(s.for_end, type_param, type_param_len, subst_type, subst_name, subst_len, suffix, suffix_len)
        cloned.for_body = clone_body(s.for_body, type_param, type_param_len, subst_type, subst_name, subst_len, suffix, suffix_len)
    else if k == STMT_LOOP or k == STMT_DEFER
        # Infinite loop — body stored in while_body (same slot as STMT_WHILE);
        # a `defer`'s too (AGAST #1625; the byte copy carries defer_is_block).
        cloned.while_body = clone_body(s.while_body, type_param, type_param_len, subst_type, subst_name, subst_len, suffix, suffix_len)
    else if k == STMT_BREAK or k == STMT_CONTINUE or k == STMT_STRIPPED
        # No child nodes to clone
        0
    else if k == STMT_INDEX_ASSIGN
        # name[idx] = value; the index is stored in while_cond (AGAST #1925)
        cloned.while_cond = clone_expr(s.while_cond, type_param, type_param_len, subst_type, subst_name, subst_len, suffix, suffix_len)
        cloned.assign_value = clone_expr(s.assign_value, type_param, type_param_len, subst_type, subst_name, subst_len, suffix, suffix_len)
    else if k == STMT_MEMBER_ASSIGN
        # ptr.field = value; the pointer expression is in if_cond (AGAST #1925)
        cloned.if_cond = clone_expr(s.if_cond, type_param, type_param_len, subst_type, subst_name, subst_len, suffix, suffix_len)
        cloned.assign_value = clone_expr(s.assign_value, type_param, type_param_len, subst_type, subst_name, subst_len, suffix, suffix_len)
    else if k == STMT_MEMBER_INDEX_ASSIGN
        # ptr.field[idx] = value: pointer in if_cond, index in while_cond (AGAST #1925)
        cloned.if_cond = clone_expr(s.if_cond, type_param, type_param_len, subst_type, subst_name, subst_len, suffix, suffix_len)
        cloned.while_cond = clone_expr(s.while_cond, type_param, type_param_len, subst_type, subst_name, subst_len, suffix, suffix_len)
        cloned.assign_value = clone_expr(s.assign_value, type_param, type_param_len, subst_type, subst_name, subst_len, suffix, suffix_len)
    else if k == STMT_ASSERT
        # The condition is in if_cond (AGAST #1925)
        cloned.if_cond = clone_expr(s.if_cond, type_param, type_param_len, subst_type, subst_name, subst_len, suffix, suffix_len)
    else if k == STMT_TUPLE_DECL
        # let (a, b) = init; both names are carried over by the byte copy (AGAST #1925)
        cloned.var_init = clone_expr(s.var_init, type_param, type_param_len, subst_type, subst_name, subst_len, suffix, suffix_len)
    else if k == STMT_LOCAL_FIELD_ASSIGN
        # v.field = value
        cloned.var_name = s.var_name
        cloned.var_name_len = s.var_name_len
        cloned.assign_target = s.assign_target
        cloned.assign_target_len = s.assign_target_len
        cloned.assign_value = clone_expr(s.assign_value, type_param, type_param_len, subst_type, subst_name, subst_len, suffix, suffix_len)
    else if k == STMT_LOCAL_FIELD_INDEX_ASSIGN
        # v.field[idx] = value
        cloned.var_name = s.var_name
        cloned.var_name_len = s.var_name_len
        cloned.assign_target = s.assign_target
        cloned.assign_target_len = s.assign_target_len
        # Index expression is stored in while_cond (reused field)
        cloned.while_cond = clone_expr(s.while_cond, type_param, type_param_len, subst_type, subst_name, subst_len, suffix, suffix_len)
        cloned.assign_value = clone_expr(s.assign_value, type_param, type_param_len, subst_type, subst_name, subst_len, suffix, suffix_len)
    else if k == STMT_MATCH
        # AGAST #186: match-stmt cloning was missing — uninitialised cloned
        # struct caused emit_match to dereference a null scrutinee.  STMT_MATCH
        # stores scrutinee in if_cond, arms in if_then (recast as *MatchArm).
        cloned.if_cond = clone_expr(s.if_cond, type_param, type_param_len, subst_type, subst_name, subst_len, suffix, suffix_len)
        cloned.if_then = clone_match_arms(s.if_then as *MatchArm, type_param, type_param_len, subst_type, subst_name, subst_len, suffix, suffix_len) as *Stmt
        cloned.if_else = null
    else
        clone_unknown_kind(c"clone_stmt", k)

    g_clone_memo_on = memo_was
    g_clone_memo_count = memo_base
    # A specialised body isn't walked by collect_from_stmt: note its calls here.
    if is_store_stmt(k) == 1
        note_compound_calls(cloned)
    return cloned

# `sizeof(T)` with T := subst (AGAST #2124): one value of the concrete kind,
# keeping `at`'s span and element count (1 for a bare `T`).
fn sizeof_subst_operand(at: *Expr, subst_type: i32, subst_name: *u8, subst_len: i32) -> *Expr
    let op: *Expr = malloc(sizeof(Expr)) as *Expr
    memcpy(op as *u8, at as *u8, sizeof(Expr))
    if at.kind != EXPR_TYPE_OPERAND
        op.int_val = 1
    op.kind = EXPR_TYPE_OPERAND
    op.op = subst_type
    op.ident_ptr = null
    op.ident_len = 0
    # An unparsed suffix (TYPE_VOID) keeps its spelling: the emitter sizes a
    # TYPE_STRUCT leaf named `i32` as the primitive, and rejects a non-type.
    if subst_type == TYPE_VOID
        op.op = TYPE_STRUCT
    # AGAST #2832: T = `[N]E` is N values of E, as sizeof_array_type_call
    # records a written `sizeof([N]E)`.
    var leaf_name: *u8 = subst_name
    var leaf_len: i32 = subst_len
    var a: ArrayArg
    if subst_type == TYPE_ARRAY and array_arg_decode(subst_name, subst_len, @a) == 1
        op.int_val = op.int_val * a.size as i64
        op.op = a.elem
        leaf_name = a.name
        leaf_len = a.name_len
    if op.op == TYPE_STRUCT
        op.ident_ptr = leaf_name
        op.ident_len = leaf_len
    op.next = null
    return op

# AGAST #2529: a node one statement of the template shares stays shared in its
# clone.  `x op= v`'s read and store share x's operands (ast_helpers.ritz
# stmt_compound_assign_*), and note_compound_calls finds a call to evaluate
# once by that sharing: clone each such node once per statement.
var g_clone_memo_from: **Expr = null
var g_clone_memo_to: **Expr = null
var g_clone_memo_count: i32 = 0
var g_clone_memo_cap: i32 = 0
var g_clone_memo_on: i32 = 0

fn clone_memo_find(e: *Expr) -> *Expr
    var i: i32 = 0
    while i < g_clone_memo_count
        if *(g_clone_memo_from + i) == e
            return *(g_clone_memo_to + i)
        i += 1
    return null

fn clone_memo_add(e: *Expr, c: *Expr)
    if g_clone_memo_count == g_clone_memo_cap
        var cap: i32 = 64
        if g_clone_memo_cap > 0
            cap = g_clone_memo_cap * 2
        let from: **Expr = malloc((cap as i64) * 8) as **Expr
        let to: **Expr = malloc((cap as i64) * 8) as **Expr
        var i: i32 = 0
        while i < g_clone_memo_count
            *(from + i) = *(g_clone_memo_from + i)
            *(to + i) = *(g_clone_memo_to + i)
            i += 1
        g_clone_memo_from = from
        g_clone_memo_to = to
        g_clone_memo_cap = cap
    *(g_clone_memo_from + g_clone_memo_count) = e
    *(g_clone_memo_to + g_clone_memo_count) = c
    g_clone_memo_count += 1

# The store forms `x op= v` desugars into (note_compound_calls).
fn is_store_stmt(k: i32) -> i32
    if k == STMT_ASSIGN or k == STMT_INDEX_ASSIGN or k == STMT_MEMBER_ASSIGN
        return 1
    if k == STMT_MEMBER_INDEX_ASSIGN or k == STMT_LOCAL_FIELD_INDEX_ASSIGN
        return 1
    return 0

fn clone_expr(e: *Expr, type_param: *u8, type_param_len: i32, subst_type: i32, subst_name: *u8, subst_len: i32, suffix: *u8, suffix_len: i32) -> *Expr
    if e == null
        return null
    if g_clone_memo_on == 1
        let seen: *Expr = clone_memo_find(e)
        if seen != null
            return seen

    let cloned: *Expr = malloc(sizeof(Expr)) as *Expr
    memcpy(cloned as *u8, e as *u8, sizeof(Expr))  # AGAST #1925; see clone_stmt
    cloned.next = null
    if g_clone_memo_on == 1
        clone_memo_add(e, cloned)

    let k: i32 = e.kind

    if k == EXPR_INT_LIT
        cloned.int_val = e.int_val
    else if k == EXPR_CHAR_LIT
        cloned.int_val = e.int_val  # Char uses int_val field
    else if k == EXPR_STRING_LIT or k == EXPR_CSTRING_LIT
        cloned.string_ptr = e.string_ptr
        cloned.string_len = e.string_len
        # The raw token text print interpolation reads (AGAST #1521).
        cloned.ident_ptr = e.ident_ptr
        cloned.ident_len = e.ident_len
    else if k == EXPR_IDENT
        cloned.ident_ptr = e.ident_ptr
        cloned.ident_len = e.ident_len
    else if k == EXPR_TYPE_OPERAND
        # `sizeof([4]T)` (AGAST #2124): the leaf may be the type parameter.
        if e.op == TYPE_STRUCT and e.ident_len == type_param_len and memcmp(e.ident_ptr, type_param, type_param_len as i64) == 0
            let leaf: *Expr = sizeof_subst_operand(e, subst_type, subst_name, subst_len)
            cloned.op = leaf.op
            cloned.ident_ptr = leaf.ident_ptr
            cloned.ident_len = leaf.ident_len
    else if k == EXPR_BINARY
        cloned.op = e.op
        cloned.left = clone_expr(e.left, type_param, type_param_len, subst_type, subst_name, subst_len, suffix, suffix_len)
        cloned.right = clone_expr(e.right, type_param, type_param_len, subst_type, subst_name, subst_len, suffix, suffix_len)
    else if k == EXPR_UNARY
        cloned.op = e.op
        cloned.operand = clone_expr(e.operand, type_param, type_param_len, subst_type, subst_name, subst_len, suffix, suffix_len)
    else if k == EXPR_CALL
        cloned.func_name = e.func_name
        cloned.func_name_len = e.func_name_len
        # A nameless call's callee expression (AGAST #1747).  Only then: a
        # named call's `left` is not guaranteed initialised.
        cloned.left = null
        if e.func_name_len == 0
            cloned.left = clone_expr(e.left, type_param, type_param_len, subst_type, subst_name, subst_len, suffix, suffix_len)
        cloned.call_type_suffix = e.call_type_suffix
        cloned.call_type_suffix_len = e.call_type_suffix_len

        # If this call has a type suffix with our type param, substitute
        if cloned.call_type_suffix_len > 1
            # Check if suffix contains type param (e.g., $T -> $u8)
            var subst_suffix: *u8 = null
            var subst_suffix_len: i32 = 0
            subst_suffix = check_and_substitute_suffix(cloned.call_type_suffix, cloned.call_type_suffix_len, type_param, type_param_len, suffix, suffix_len, @subst_suffix_len)
            if subst_suffix != null
                cloned.call_type_suffix = subst_suffix
                cloned.call_type_suffix_len = subst_suffix_len
                # Register this new instantiation for later generation —
                # unless a multi-parameter pass is mid-way, when the suffix
                # may still name a later parameter (AGAST #1612; the finished
                # body is collected instead).
                if g_mono_component_mode == 0
                    add_instantiation(cloned.func_name, cloned.func_name_len, subst_suffix, subst_suffix_len)

        # Special case: sizeof(T) where T is a type parameter
        # The argument to sizeof is a type name (identifier), so we need to substitute
        var is_sizeof: i32 = 0
        if cloned.func_name_len == 6
            if memcmp(cloned.func_name, c"sizeof", 6) == 0
                is_sizeof = 1
        if is_sizeof == 1 and e.args != null and e.args.kind == EXPR_IDENT
            # Check if the argument matches our type parameter
            if e.args.ident_len == type_param_len
                if memcmp(e.args.ident_ptr, type_param, type_param_len as i64) == 0
                    # Substitute the concrete type itself (AGAST #2124): a
                    # TYPE_OPERAND, not an IDENT of subst_name, which for
                    # a pointer or primitive T is no name the emitter knows
                    # (and an unknown sizeof name is now an error).
                    cloned.args = sizeof_subst_operand(e.args, subst_type, subst_name, subst_len)
                else
                    cloned.args = clone_expr_list(e.args, type_param, type_param_len, subst_type, subst_name, subst_len, suffix, suffix_len)
            else
                cloned.args = clone_expr_list(e.args, type_param, type_param_len, subst_type, subst_name, subst_len, suffix, suffix_len)
        else
            cloned.args = clone_expr_list(e.args, type_param, type_param_len, subst_type, subst_name, subst_len, suffix, suffix_len)
    else if k == EXPR_INDEX
        cloned.left = clone_expr(e.left, type_param, type_param_len, subst_type, subst_name, subst_len, suffix, suffix_len)
        cloned.right = clone_expr(e.right, type_param, type_param_len, subst_type, subst_name, subst_len, suffix, suffix_len)
    else if k == EXPR_MEMBER
        cloned.left = clone_expr(e.left, type_param, type_param_len, subst_type, subst_name, subst_len, suffix, suffix_len)
        cloned.ident_ptr = e.ident_ptr  # Member name
        cloned.ident_len = e.ident_len
    else if k == EXPR_METHOD
        cloned.left = clone_expr(e.left, type_param, type_param_len, subst_type, subst_name, subst_len, suffix, suffix_len)
        cloned.ident_ptr = e.ident_ptr  # Method name
        cloned.ident_len = e.ident_len
        cloned.args = clone_expr_list(e.args, type_param, type_param_len, subst_type, subst_name, subst_len, suffix, suffix_len)
        # A generic body is never walked by collect_from_expr, so its
        # specialisation is where `E.from(...)` becomes `E__from(...)`, and
        # `String.from(..)` `string_from(..)`.
        if g_mono_module != null
            rewrite_enum_from_call(g_mono_module, cloned)
            rewrite_static_ufcs_call(g_mono_module, cloned)   # AGAST #2575
    else if k == EXPR_CAST
        cloned.cast_array = null   # AGAST #2343: `[N]T` keeps T's own name; left unjudged
        # Parser stores operand in e.left, not e.operand
        cloned.left = clone_expr(e.left, type_param, type_param_len, subst_type, subst_name, subst_len, suffix, suffix_len)
        cloned.op = e.op  # cast_type stored in op
    else if k == EXPR_STRUCT_LIT
        # Struct literal: TypeName { field: value, ... }
        # e.ident_ptr/ident_len = struct type name
        # For generic struct literals, name is already mangled like "Vec$T"
        # We need to replace the "$T" with the new suffix "$u8"
        if e.ident_ptr != null
            var new_name_ptr: *u8 = null
            var new_name_len: i32 = 0
            substitute_type_param_in_name(e.ident_ptr, e.ident_len, type_param, type_param_len, suffix, suffix_len, @new_name_ptr, @new_name_len)
            cloned.ident_ptr = new_name_ptr
            cloned.ident_len = new_name_len
        else
            cloned.ident_ptr = e.ident_ptr
            cloned.ident_len = e.ident_len
        # Clone field initializers (stored in args)
        cloned.args = clone_field_inits(e.args as *FieldInit, type_param, type_param_len, subst_type, subst_name, subst_len, suffix, suffix_len) as *Expr
    else if k == EXPR_RANGE
        # Range expression: start..end
        cloned.left = clone_expr(e.left, type_param, type_param_len, subst_type, subst_name, subst_len, suffix, suffix_len)
        cloned.right = clone_expr(e.right, type_param, type_param_len, subst_type, subst_name, subst_len, suffix, suffix_len)
    else if k == EXPR_NIL_LIT
        # Nil literal: no fields to clone
        0  # Placeholder statement to satisfy parser
    else if k == EXPR_MATCH or k == EXPR_IF
        # EXPR_IF (#1613): same shape (condition in left, then/else arms).
        # AGAST #186: match-expr cloning was missing — caused segfaults when
        # generic fns had `match *opt` bodies (option_is_none<T>, etc).
        # EXPR_MATCH stores scrutinee in left, arms in args (recast as *MatchArm).
        cloned.left = clone_expr(e.left, type_param, type_param_len, subst_type, subst_name, subst_len, suffix, suffix_len)
        cloned.args = clone_match_arms(e.args as *MatchArm, type_param, type_param_len, subst_type, subst_name, subst_len, suffix, suffix_len) as *Expr
    else if k == EXPR_ARRAY_LIT
        # [a, b, c]: the elements are the args list (AGAST #1925)
        cloned.args = clone_expr_list(e.args, type_param, type_param_len, subst_type, subst_name, subst_len, suffix, suffix_len)
    else if k == EXPR_ARRAY_FILL or k == EXPR_TRY
        # [value; N] keeps value in left and N in int_val; `expr?` keeps expr
        # in left (AGAST #1925)
        cloned.left = clone_expr(e.left, type_param, type_param_len, subst_type, subst_name, subst_len, suffix, suffix_len)
    else if k == EXPR_FLOAT_LIT
        # The raw digits (string_ptr / string_len) come over with the byte copy
        0
    else
        clone_unknown_kind(c"clone_expr", k)

    return cloned

# AGAST #186: clone a chain of MatchArm nodes when the enclosing fn is being
# specialised.  Pattern fields (kind/int/name) carry no T references so they
# pass through verbatim; only `body` (the arm's RHS expression) needs the
# usual type-param substitution.  Cloning is required because emit_match
# reads each arm's `body.kind` etc.; without this the arms would still point
# at the template's expressions, but more importantly the surrounding STMT_
# /EXPR_MATCH cloning did nothing without a copy strategy for arms either.
fn clone_match_arms(arms: *MatchArm, type_param: *u8, type_param_len: i32, subst_type: i32, subst_name: *u8, subst_len: i32, suffix: *u8, suffix_len: i32) -> *MatchArm
    if arms == null
        return null
    let cloned: *MatchArm = malloc(sizeof(MatchArm)) as *MatchArm
    cloned.pattern_kind = arms.pattern_kind
    cloned.pattern_int = arms.pattern_int
    cloned.pattern_name = arms.pattern_name
    cloned.pattern_name_len = arms.pattern_name_len
    cloned.pattern_inner_kind = arms.pattern_inner_kind
    cloned.pattern_inner_name = arms.pattern_inner_name
    cloned.pattern_inner_name_len = arms.pattern_inner_name_len
    cloned.pattern_inner_span.line = arms.pattern_inner_span.line   # AGAST #2405
    cloned.pattern_inner_span.col = arms.pattern_inner_span.col
    cloned.pattern_span.line = arms.pattern_span.line   # AGAST #2407
    cloned.pattern_span.col = arms.pattern_span.col
    cloned.head_span.line = arms.head_span.line   # AGAST #2431
    cloned.head_span.col = arms.head_span.col
    cloned.is_pass = arms.is_pass
    cloned.pass_span.line = arms.pass_span.line   # AGAST #2236
    cloned.pass_span.col = arms.pass_span.col
    # Block arm statements (AGAST #1454); clone_body copies the chain.
    cloned.body_stmts = clone_body(arms.body_stmts, type_param, type_param_len, subst_type, subst_name, subst_len, suffix, suffix_len)
    if arms.body != null
        cloned.body = clone_expr(arms.body, type_param, type_param_len, subst_type, subst_name, subst_len, suffix, suffix_len)
    else
        cloned.body = null
    cloned.next = clone_match_arms(arms.next, type_param, type_param_len, subst_type, subst_name, subst_len, suffix, suffix_len)
    return cloned

fn clone_expr_list(list: *Expr, type_param: *u8, type_param_len: i32, subst_type: i32, subst_name: *u8, subst_len: i32, suffix: *u8, suffix_len: i32) -> *Expr
    if list == null
        return null

    let cloned: *Expr = clone_expr(list, type_param, type_param_len, subst_type, subst_name, subst_len, suffix, suffix_len)
    cloned.next = clone_expr_list(list.next, type_param, type_param_len, subst_type, subst_name, subst_len, suffix, suffix_len)
    return cloned

fn clone_field_inits(fi: *FieldInit, type_param: *u8, type_param_len: i32, subst_type: i32, subst_name: *u8, subst_len: i32, suffix: *u8, suffix_len: i32) -> *FieldInit
    if fi == null
        return null

    let cloned: *FieldInit = malloc(sizeof(FieldInit)) as *FieldInit
    cloned.name = fi.name
    cloned.name_len = fi.name_len
    # Clone the value expression (handles nested generic calls/literals)
    cloned.value = clone_expr(fi.value, type_param, type_param_len, subst_type, subst_name, subst_len, suffix, suffix_len)
    cloned.next = clone_field_inits(fi.next, type_param, type_param_len, subst_type, subst_name, subst_len, suffix, suffix_len)
    return cloned

fn check_and_substitute_suffix(old_suffix: *u8, old_suffix_len: i32, type_param: *u8, type_param_len: i32, new_suffix: *u8, new_suffix_len: i32, out_len: *i32) -> *u8
    # AGAST #1612: in a multi-parameter pass a call suffix may name several
    # parameters (`helper<T, U>` is "$T$U"); rewrite the matching component.
    if g_mono_component_mode != 0
        let rewritten: *u8 = replace_param_component(old_suffix, old_suffix_len, type_param, type_param_len, new_suffix, new_suffix_len, out_len)
        if rewritten == old_suffix
            return null
        return rewritten
    # Check if old_suffix is "$T" where T matches type_param
    if old_suffix_len != type_param_len + 1
        return null
    if *old_suffix != 36  # $
        return null
    if memcmp(old_suffix + 1, type_param, type_param_len as i64) != 0
        return null

    # Substitute with new suffix
    *out_len = new_suffix_len
    return new_suffix

# ============================================================================
# Struct Cloning and Specialization
# ============================================================================
# Clone a generic struct and substitute the type parameter

fn clone_and_specialize_struct(m: *Module, template: *StructDef, suffix: *u8, suffix_len: i32) -> *StructDef
    # Create a new StructDef with mangled name
    let mangled_name_len: i32 = template.name_len + suffix_len
    let mangled_name: *u8 = malloc(mangled_name_len as i64 + 1) as *u8

    # Copy base name
    for i in 0..template.name_len
        *(mangled_name + i) = *(template.name + i)

    # Copy suffix (including the $)
    for j in 0..suffix_len
        *(mangled_name + template.name_len + j) = *(suffix + j)
    *(mangled_name + mangled_name_len) = 0

    # AGAST #1574: substitute EVERY parameter of a multi-parameter template.
    if count_type_params(template.type_params) >= 2
        let cap: i64 = 4 * mangled_arg_capacity(suffix, suffix_len) as i64
        let starts: *i32 = malloc(cap) as *i32
        let lens: *i32 = malloc(cap) as *i32
        if split_mangled_args(m, suffix, suffix_len, starts, lens) != count_type_params(template.type_params)
            return null
        let multi: *StructDef = malloc(sizeof(StructDef)) as *StructDef
        multi.name = mangled_name
        multi.name_len = mangled_name_len
        multi.fields = clone_struct_fields_multi(template.fields, template.type_params, suffix, starts, lens)
        multi.type_params = null
        multi.next = null
        if struct_is_packed(template) == 1
            struct_mark_packed(multi)   # `[[packed]]` holds for every instance (#1847)
        return multi

    # Get the type parameter name from template
    var type_param_name: *u8 = null
    var type_param_len: i32 = 0
    if template.type_params != null
        type_param_name = template.type_params.name
        type_param_len = template.type_params.name_len

    # Get the substitution type from suffix
    var subst_type_name: *u8 = null
    var subst_type_len: i32 = 0
    get_type_name_from_suffix(suffix, suffix_len, @subst_type_name, @subst_type_len)
    let subst_type: i32 = parse_type_from_suffix(suffix, suffix_len)

    # Clone the struct with specialized name
    let specialized: *StructDef = malloc(sizeof(StructDef)) as *StructDef
    specialized.name = mangled_name
    specialized.name_len = mangled_name_len
    specialized.fields = clone_struct_fields(template.fields, type_param_name, type_param_len, subst_type, subst_type_name, subst_type_len, suffix, suffix_len)
    specialized.type_params = null  # Not generic anymore
    specialized.next = null
    if struct_is_packed(template) == 1
        struct_mark_packed(specialized)   # `[[packed]]` holds for every instance (#1847)

    return specialized

# AGAST #2329: a `*[N]T` field or return keeps N and T through a clone when T is
# a scalar.  A named T may be the type parameter, so it's dropped, and `x[i]` on
# one is left as it was before #2329.
fn ptr_array_unless_generic(pa: *Param) -> *Param
    if pa == null or pa.param_type_name_len > 0
        return null
    pa

# primitive_type_from_name lives in ast_helpers (AGAST #1980: the emitter's
# let path needs it too).
fn clone_struct_fields(fields: *StructField, type_param: *u8, type_param_len: i32, subst_type: i32, subst_name: *u8, subst_len: i32, suffix: *u8, suffix_len: i32) -> *StructField
    if fields == null
        return null

    let cloned: *StructField = malloc(sizeof(StructField)) as *StructField
    cloned.name = fields.name
    cloned.name_len = fields.name_len
    cloned.inner_pointee_type = fields.inner_pointee_type  # AGAST #1924
    cloned.fn_sig = fields.fn_sig  # AGAST #2120
    cloned.array_shape = fields.array_shape  # AGAST #2097
    cloned.ptr_array = ptr_array_unless_generic(fields.ptr_array)  # AGAST #2329

    # Copy array info first: substituting `v: T` at an array T writes it
    # (AGAST #2832).
    cloned.array_size = fields.array_size
    cloned.array_elem_type = fields.array_elem_type
    cloned.array_elem_pointee = fields.array_elem_pointee   # AGAST #2332
    cloned.field_mut_ref = fields.field_mut_ref
    cloned.field_shared_ref = fields.field_shared_ref
    cloned.array_elem_type_name = fields.array_elem_type_name
    cloned.array_elem_type_name_len = fields.array_elem_type_name_len

    # Check if field type is the type parameter
    if fields.field_type == TYPE_STRUCT
        if fields.field_type_name != null and find_dollar_sign(fields.field_type_name, fields.field_type_name_len) > 0
            # AGAST #2411: a generic over the parameter, `v: Vec<T>` is
            # `Vec$T`: rewrite its `$T`, to `Vec$i32`.  It was copied as it
            # stood, so `B$i32` held a `%Vec$T`, which names no struct, and
            # `b.v.len` was `unhandled EXPR_MEMBER`.
            cloned.field_type = fields.field_type
            var sub_len: i32 = 0
            substitute_type_param_in_name(fields.field_type_name, fields.field_type_name_len, type_param, type_param_len, suffix, suffix_len, @cloned.field_type_name, @sub_len)
            cloned.field_type_name_len = sub_len
        else if fields.field_type_name != null and fields.field_type_name_len == type_param_len
            if memcmp(fields.field_type_name, type_param, type_param_len as i64) == 0
                # Substitute with concrete type
                subst_value_field(cloned, subst_type, subst_name, subst_len)
            else
                # Not the type param, but might be a generic struct - mangle it
                cloned.field_type = fields.field_type
                cloned.field_type_name = mangle_struct_name(fields.field_type_name, fields.field_type_name_len, suffix, suffix_len)
                cloned.field_type_name_len = fields.field_type_name_len + suffix_len
        else
            cloned.field_type = fields.field_type
            cloned.field_type_name = fields.field_type_name
            cloned.field_type_name_len = fields.field_type_name_len
    else
        cloned.field_type = fields.field_type
        cloned.field_type_name = fields.field_type_name
        cloned.field_type_name_len = fields.field_type_name_len

    # `data: *T` — substitute the pointee.  The parser records a struct
    # pointee in field_type_name and a primitive one in array_elem_type; `T`
    # parses as a struct named "T".  Dropping it (as this used to) left
    # `Vec$Token.data + i` striding by 1 byte instead of sizeof(Token); the
    # hard-coded Vec$ layouts in the emitter hid that until #1440 removed them.
    if fields.field_type == TYPE_PTR or fields.field_type == TYPE_REF or fields.field_type == TYPE_MUT_REF
        if fields.field_type_name != null and fields.field_type_name_len == type_param_len
            if memcmp(fields.field_type_name, type_param, type_param_len as i64) == 0
                subst_pointee_field(cloned, subst_type, subst_name, subst_len)
    subst_array_ptr_field(cloned, type_param, type_param_len, subst_type, subst_name, subst_len)

    # Clone rest of the list
    cloned.next = clone_struct_fields(fields.next, type_param, type_param_len, subst_type, subst_name, subst_len, suffix, suffix_len)

    return cloned

# AGAST #2332: a field `a: [N]*T`, at T = the argument (subst_type, subst_name).
fn subst_array_ptr_field(cloned: *StructField, type_param: *u8, type_param_len: i32, subst_type: i32, subst_name: *u8, subst_len: i32)
    if cloned.array_elem_pointee != TYPE_STRUCT or cloned.array_elem_type_name == null or cloned.array_elem_type_name_len != type_param_len
        return
    if memcmp(cloned.array_elem_type_name, type_param, type_param_len as i64) != 0
        return
    cloned.array_elem_pointee = subst_type
    cloned.array_elem_type_name = subst_name
    cloned.array_elem_type_name_len = subst_len

# A by-value field `x: T`, at T = the argument (subst_type, subst_name).
fn subst_value_field(cloned: *StructField, subst_type: i32, subst_name: *u8, subst_len: i32)
    cloned.field_type = subst_type
    cloned.field_type_name = subst_name
    cloned.field_type_name_len = subst_len
    # AGAST #2832: `v: T` at T = `[4]i64` is the array field `v: [4]i64`,
    # recorded as field_new records a written one.
    var a: ArrayArg
    if subst_type == TYPE_ARRAY and array_arg_decode(subst_name, subst_len, @a) == 1
        cloned.field_type_name = null
        cloned.field_type_name_len = 0
        cloned.array_size = a.size
        cloned.array_elem_type = a.elem
        cloned.array_elem_pointee = a.pointee
        cloned.array_elem_type_name = a.name
        cloned.array_elem_type_name_len = a.name_len
        cloned.array_shape = null

# A `*T` / `@T` / `@&T` field at T = the argument.  The parser records a
# struct pointee in field_type_name and a primitive one in array_elem_type.
fn subst_pointee_field(cloned: *StructField, subst_type: i32, subst_name: *u8, subst_len: i32)
    let prim: i32 = primitive_type_from_name(subst_name, subst_len)
    if subst_type == TYPE_PTR
        # `*T` at T = *X is `**X`: the element is a pointer.  Checked before
        # the primitive case: a `$ptr_u8` argument arrives as the name "u8"
        # (get_type_name_from_suffix strips `ptr_`), and taking it as T = u8
        # made Vec$ptr_u8.data a `*u8` — 1-byte stride, `load i8` (#1796).
        # Encoded like a declared `**X` field (field_new): the innermost
        # struct's name, or no name for a primitive.
        cloned.field_type = TYPE_PTR_PTR
        if prim != 0
            cloned.field_type_name = null
            cloned.field_type_name_len = 0
        else
            cloned.field_type_name = subst_name
            cloned.field_type_name_len = subst_len
    else if prim != 0
        cloned.field_type_name = null
        cloned.field_type_name_len = 0
        cloned.array_elem_type = prim
    else
        cloned.field_type_name = subst_name
        cloned.field_type_name_len = subst_len

# AGAST #1574: clone a multi-parameter template's fields, substituting every
# parameter.  A field typed by a parameter takes that parameter's argument; a
# field typed by a generic over the parameters (`Box$B`) has them rewritten
# in its mangled name; any other type is copied as-is.  (The single-parameter
# path appends the suffix to every non-parameter struct name instead, which
# here would name `%B$i64`-style types.)
fn clone_struct_fields_multi(fields: *StructField, tp: *TypeParam, suffix: *u8, starts: *i32, lens: *i32) -> *StructField
    if fields == null
        return null

    let cloned: *StructField = malloc(sizeof(StructField)) as *StructField
    cloned.name = fields.name
    cloned.name_len = fields.name_len
    cloned.inner_pointee_type = fields.inner_pointee_type  # AGAST #1924
    cloned.fn_sig = fields.fn_sig  # AGAST #2120
    cloned.array_shape = fields.array_shape  # AGAST #2097
    cloned.ptr_array = ptr_array_unless_generic(fields.ptr_array)  # AGAST #2329
    cloned.field_type = fields.field_type
    cloned.field_type_name = fields.field_type_name
    cloned.field_type_name_len = fields.field_type_name_len
    cloned.array_size = fields.array_size
    cloned.array_elem_type = fields.array_elem_type
    cloned.array_elem_pointee = fields.array_elem_pointee   # AGAST #2332
    cloned.field_mut_ref = fields.field_mut_ref
    cloned.field_shared_ref = fields.field_shared_ref
    cloned.array_elem_type_name = fields.array_elem_type_name
    cloned.array_elem_type_name_len = fields.array_elem_type_name_len

    let ft: i32 = fields.field_type
    var by_value: i32 = 0
    if ft == TYPE_STRUCT
        by_value = 1
    var by_ptr: i32 = 0
    if ft == TYPE_PTR or ft == TYPE_REF or ft == TYPE_MUT_REF
        by_ptr = 1
    if (by_value == 1 or by_ptr == 1) and fields.field_type_name != null
        let idx: i32 = type_param_index(tp, fields.field_type_name, fields.field_type_name_len)
        if idx >= 0
            let arg: *u8 = suffix + *(starts + idx)
            let arg_len: i32 = *(lens + idx)
            var subst_name: *u8 = null
            var subst_len: i32 = 0
            get_type_name_from_suffix(arg, arg_len, @subst_name, @subst_len)
            let subst_type: i32 = parse_type_from_suffix(arg, arg_len)
            if by_value == 1
                subst_value_field(cloned, subst_type, subst_name, subst_len)
            else
                subst_pointee_field(cloned, subst_type, subst_name, subst_len)
        else
            var new_len: i32 = 0
            cloned.field_type_name = substitute_params_in_mangled(tp, suffix, starts, lens, fields.field_type_name, fields.field_type_name_len, @new_len)
            cloned.field_type_name_len = new_len

    if fields.array_elem_pointee == TYPE_STRUCT and fields.array_elem_type_name != null
        let ai: i32 = type_param_index(tp, fields.array_elem_type_name, fields.array_elem_type_name_len)
        if ai >= 0
            var ae_name: *u8 = null
            var ae_len: i32 = 0
            let arg_e: *u8 = suffix + *(starts + ai)
            get_type_name_from_suffix(arg_e, *(lens + ai), @ae_name, @ae_len)
            subst_array_ptr_field(cloned, fields.array_elem_type_name, fields.array_elem_type_name_len, parse_type_from_suffix(arg_e, *(lens + ai)), ae_name, ae_len)

    cloned.next = clone_struct_fields_multi(fields.next, tp, suffix, starts, lens)
    return cloned

# ============================================================================
# Impl Block Method Specialization
# ============================================================================
# Find impl block for a generic type and specialize its methods

# AGAST #1520: the parser records an impl's type as its bare name (`Box`
# for `impl<T> Box<T>` and `impl<T> Drop for Box<T>`; see impl_block in
# grammars/ritz1.grammar), so a generic impl is one with type params whose
# type name equals the instantiated struct's base name.  This used to look for
# a `$` in the impl's type name, which the parser never produces, so no
# generic impl method was ever specialized.  `start` resumes the search after
# a previous match: a type can have several generic impls.
fn find_generic_impl(start: *ImplBlock, type_name: *u8, type_name_len: i32) -> *ImplBlock
    var ib: *ImplBlock = start
    while ib != null
        if ib.type_params != null and ib.type_name_len == type_name_len
            if memcmp(ib.type_name, type_name, type_name_len as i64) == 0
                return ib
        ib = ib.next
    return null

fn specialize_impl_methods(m: *Module, type_name: *u8, type_name_len: i32, suffix: *u8, suffix_len: i32)
    var ib: *ImplBlock = find_generic_impl(m.impls, type_name, type_name_len)
    while ib != null
        specialize_one_impl(m, ib, type_name, type_name_len, suffix, suffix_len)
        ib = find_generic_impl(ib.next, type_name, type_name_len)

fn specialize_one_impl(m: *Module, ib: *ImplBlock, type_name: *u8, type_name_len: i32, suffix: *u8, suffix_len: i32)
    var method: *FnDef = ib.methods
    while method != null
        let specialized: *FnDef = specialize_impl_method(m, ib, method, type_name, type_name_len, suffix, suffix_len)
        if specialized != null
            collect_struct_types_from_fn(m, specialized)
            # Add to module's function list
            if m.functions == null
                m.functions = specialized
            else
                var f: *FnDef = m.functions
                while f.next != null
                    f = f.next
                f.next = specialized
        method = method.next

# Specialise one method of generic impl `ib` at `suffix`.  The method is
# specialised exactly as a generic fn whose type params are the impl's
# (clone_and_specialize_function: a `T` return becomes the argument, `*W<T>`
# becomes `*W$i32`, and multi-parameter impls are handled), then renamed to
# the method mangling `Type$suffix_method` (e.g. `Box$i64_set`).
fn specialize_impl_method(m: *Module, ib: *ImplBlock, method: *FnDef, type_name: *u8, type_name_len: i32, suffix: *u8, suffix_len: i32) -> *FnDef
    let template: *FnDef = malloc(sizeof(FnDef)) as *FnDef
    memcpy(template as *u8, method as *u8, sizeof(FnDef))
    template.type_params = ib.type_params
    let specialized: *FnDef = clone_and_specialize_function(m, template, suffix, suffix_len)
    free(template as *u8)
    if specialized == null
        return null

    let mangled_name_len: i32 = type_name_len + suffix_len + 1 + method.name_len
    let mangled_name: *u8 = malloc(mangled_name_len as i64 + 1) as *u8
    var pos: i32 = 0
    for i in 0..type_name_len
        *(mangled_name + pos) = *(type_name + i)
        pos = pos + 1
    for j in 0..suffix_len
        *(mangled_name + pos) = *(suffix + j)
        pos = pos + 1
    *(mangled_name + pos) = 95  # '_'
    pos = pos + 1
    for k in 0..method.name_len
        *(mangled_name + pos) = *(method.name + k)
        pos = pos + 1
    *(mangled_name + pos) = 0
    specialized.name = mangled_name
    specialized.name_len = mangled_name_len
    specialized

# ============================================================================
# Main Monomorphization Entry Point
# ============================================================================

fn monomorphize_module(m: *Module)
    init_instantiation_tracker()
    init_local_var_tracker()

    # Collect all generic function and struct instantiations
    collect_instantiations_from_module(m)

    # Structs and fns are specialised to a fixpoint: specialising `vec_push<T>`
    # at u8 yields a fn whose signature names `Vec$u8`, which is a struct
    # instantiation that no call site spelled out; and specialising a struct
    # specialises its impl methods, which may name further instantiations.
    var s_done: i32 = 0
    var i: i32 = 0
    while s_done < g_struct_count or i < g_inst_count
        s_done = specialize_pending_structs(m, s_done)
        i = specialize_pending_fns(m, i)

# Specialise struct instantiations [start, g_struct_count); returns the new
# high-water mark.
fn specialize_pending_structs(m: *Module, start: i32) -> i32
    var si: i32 = start
    while si < g_struct_count
        let name: *u8 = get_struct_instantiation_name(si)
        let name_len: i32 = get_struct_instantiation_name_len(si)
        let suffix: *u8 = get_struct_instantiation_suffix(si)
        let suffix_len: i32 = get_struct_instantiation_suffix_len(si)
        si = si + 1

        # Find the generic template
        let template: *StructDef = find_generic_struct(m, name, name_len)
        if template != null
            # Generate specialized version
            let specialized: *StructDef = clone_and_specialize_struct(m, template, suffix, suffix_len)

            # Add to module's struct list (prepend)
            if specialized != null
                specialized.next = m.structs
                m.structs = specialized
                collect_struct_types_from_fields(m, specialized.fields)

            # Also specialize impl block methods for this struct
            specialize_impl_methods(m, name, name_len, suffix, suffix_len)

    si

# Specialise fn instantiations [start, g_inst_count); returns the new
# high-water mark.  Index-based because cloning adds instantiations as it goes
# (e.g., vec_push<T> calls vec_ensure_cap<T> which calls vec_grow<T>).
fn specialize_pending_fns(m: *Module, start: i32) -> i32
    var i: i32 = start
    while i < g_inst_count
        let name: *u8 = get_instantiation_name(i)
        let name_len: i32 = get_instantiation_name_len(i)
        let suffix: *u8 = get_instantiation_suffix(i)
        let suffix_len: i32 = get_instantiation_suffix_len(i)

        # Find the generic template
        let template: *FnDef = find_generic_function(m, name, name_len)
        if template != null
            # Generate specialized version
            let specialized: *FnDef = clone_and_specialize_function(m, template, suffix, suffix_len)

            # Add to module's function list
            if specialized != null
                # Find end of function list
                if m.functions == null
                    m.functions = specialized
                else
                    var f: *FnDef = m.functions
                    while f.next != null
                        f = f.next
                    f.next = specialized
                collect_struct_types_from_fn(m, specialized)
        i = i + 1

    i
