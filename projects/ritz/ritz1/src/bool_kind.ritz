# bool_kind.ritz - the emitter's bool kind of an expression (LARB R4, AGAST #2342)
#
# What an expression is, as far as `bool` cares (BK_*, bool_check.ritz), read
# off the emitter's own state mid-lowering: its LocalVar scope, get_expr_type
# and the receiver resolution the lowering uses.  Codegen reads it (a bool
# local's i1 store, print's `true` / `false`, a match scrutinee's binding).
# ritz1 can't read a bool off the LLVM type as ritz0 does: a bool value lives
# in an i64 register (#1646).
#
# bool_check's own rules run on Sema (AGAST #3502, #1816) and judge with
# sema_bool_kind, its port of this onto Sema's scope.  sema_probe.ritz pins the
# two together on every expression the emitter lowers (RITZ1_SEMA_PROBE=1).
# This copy goes when the emitter reads types off Sema (#3514).

import ritzlib.sys
import ritzlib.io

import ast
import ast_helpers
import emitter_core
import emitter_expr_call   # method_callee_def
import index_through       # through_named_elem (AGAST #2440)
import bool_check          # BK_*, bk_of_type, bk_tagged_payload

fn bk_name(s: *EmitterState, name_sv: StrView) -> i32
    var name: *u8 = name_sv.ptr
    var len: i32 = name_sv.len as i32
    let ce: *ConstEntry = find_const_entry(s, StrView { ptr: (name), len: (len) as i64 })
    if ce != null
        return bk_of_type(ce.const_type, StrView { ptr: (ce.type_name), len: (ce.type_name_len) as i64 })
    let idx: i32 = find_local_idx(s, StrView { ptr: (name), len: (len) as i64 })
    if idx >= 0
        let loc: *LocalVar = local_at(s, idx)
        if loc.is_bool == 1
            return BK_BOOL
        if lv_bk_ptr(loc) == 1
            return BK_PTR
        if lv_bk_unsure(loc) == 1
            return BK_UNSURE
        return bk_of_type(lv_var_type(loc), StrView { ptr: (lv_type_name(loc)), len: (lv_type_name_len(loc)) as i64 })
    let g: *GlobalVarDef = find_global(s, StrView { ptr: (name), len: (len) as i64 })
    if g != null
        return bk_of_type(g.var_type, StrView { ptr: (g.type_name), len: (g.type_name_len) as i64 })
    if find_fn(s, StrView { ptr: (name), len: (len) as i64 }) != null
        return BK_PTR
    BK_UNSURE

# What `name[i]` is, for a local or global `name`.
pub fn bk_element(s: *EmitterState, name_sv: StrView) -> i32
    var name: *u8 = name_sv.ptr
    var len: i32 = name_sv.len as i32
    # AGAST #2440: through a pointer or reference, the buffer's element.
    let through: i32 = through_named_elem(s, StrView { ptr: (name), len: (len) as i64 })
    if through != TYPE_VOID
        return bk_of_type(through, StrView { ptr: (null), len: (0) as i64 })
    let idx: i32 = find_local_idx(s, StrView { ptr: (name), len: (len) as i64 })
    if idx >= 0
        let loc: *LocalVar = local_at(s, idx)
        if lv_var_type(loc) == TYPE_ARRAY
            return bk_of_type(lv_array_elem_type(loc), StrView { ptr: (lv_type_name(loc)), len: (lv_type_name_len(loc)) as i64 })
        if lv_var_type(loc) == TYPE_PTR or lv_var_type(loc) == TYPE_REF or lv_var_type(loc) == TYPE_MUT_REF
            # `p: *[N]T` indexes T (#2321), not the array.
            if lv_pointee_type(loc) == TYPE_ARRAY
                return bk_of_type(lv_pointee_array_elem_type(loc), StrView { ptr: (lv_type_name(loc)), len: (lv_type_name_len(loc)) as i64 })
            return bk_of_type(lv_pointee_type(loc), StrView { ptr: (lv_type_name(loc)), len: (lv_type_name_len(loc)) as i64 })
        return BK_UNSURE
    let g: *GlobalVarDef = find_global(s, StrView { ptr: (name), len: (len) as i64 })
    if g == null
        # AGAST #4403: `KS[i]` of `const KS: [N]T` takes its element T from
        # the ConstEntry, as Sema's sbk_element does.  get_expr_type guessed
        # an i64 for a struct element, so a `const [N]StrView` was BK_INT.
        let ce: *ConstEntry = find_const_entry(s, StrView { ptr: (name), len: (len) as i64 })
        if ce != null and ce.const_type == TYPE_ARRAY
            return bk_of_type(ce.array_elem_type, StrView { ptr: (ce.array_elem_type_name), len: (ce.array_elem_type_name_len) as i64 })
        return BK_UNSURE
    if g.var_type == TYPE_ARRAY
        return bk_of_type(g.array_elem_type, StrView { ptr: (g.type_name), len: (g.type_name_len) as i64 })
    if g.var_type == TYPE_PTR
        return bk_of_type(g.pointee_type, StrView { ptr: (g.type_name), len: (g.type_name_len) as i64 })
    BK_UNSURE

fn bk_index(s: *EmitterState, e: *Expr) -> i32
    if e.right != null and e.right.kind == EXPR_RANGE
        return BK_PTR
    # AGAST #2768: a full-rank `x[i][j]` over an N-D `[N][M]T` (local, global
    # or field) is its leaf T.  Its base is an index, not a name, so it fell to
    # get_expr_type's i64 and `x[1][1] = true` was "cannot use bool as an
    # integer".
    var nd_depth: i32 = 0
    let nd_sh: *ArrayShape = nd_index_shape(s, e, @nd_depth)
    if nd_sh != null and nd_depth == nd_sh.rank
        return bk_of_type(nd_sh.leaf_type, StrView { ptr: (nd_sh.leaf_name), len: (nd_sh.leaf_name_len) as i64 })
    let base: *Expr = e.left
    if base.kind == EXPR_IDENT
        let k: i32 = bk_element(s, StrView { ptr: (base.ident_ptr), len: (base.ident_len) as i64 })
        if k != BK_UNSURE
            return k
    else if base.kind == EXPR_MEMBER
        let f: *StructField = member_field_def(s, base)
        if f != null
            if f.field_type == TYPE_ARRAY
                return bk_of_type(f.array_elem_type, StrView { ptr: (f.array_elem_type_name), len: (f.array_elem_type_name_len) as i64 })
            if f.field_type == TYPE_PTR and get_member_pointee_type_exact(s, base) == TYPE_BOOL
                return BK_BOOL
    bk_of_type(expr_slot_ty(e), StrView { ptr: (null), len: (0) as i64 })

# The first arm with a value: a `return` arm has none, and ritz0's phi skips it.
fn bk_arms(s: *EmitterState, arms: *MatchArm) -> i32
    var arm: *MatchArm = arms
    while arm != null
        if arm.is_pass == 0 and arm.body != null
            let k: i32 = bool_kind(s, arm.body)
            if k != BK_UNSURE
                return k
        arm = arm.next
    BK_UNSURE

# What `e?` or `e.unwrap()` gives, for `e` an Option or Result.
fn bk_payload_of(s: *EmitterState, e: *Expr) -> i32
    var name: *u8 = null
    var len: i32 = 0
    bk_receiver(s, e, @name, @len)
    if name == null or len <= 0 or is_tagged_enum_type(StrView { ptr: (name), len: (len) as i64 }) == 0
        return BK_UNSURE
    bk_tagged_payload(StrView { ptr: (name), len: (len) as i64 }, 0)

# The fn a method call dispatches to, or null.
pub fn bk_method_def(s: *EmitterState, e: *Expr) -> *FnDef
    var tn_len: i32 = 0
    let tn: *u8 = bk_method_recv(s, e, @tn_len)
    if tn == null
        return null
    method_callee_def(s, StrView { ptr: (tn), len: (tn_len) as i64 }, StrView { ptr: (e.ident_ptr), len: (e.ident_len) as i64 })

# The type name method call `e` dispatches on, or null.
fn bk_method_recv(s: *EmitterState, e: *Expr, out_len: *i32) -> *u8
    var tn_len: i32 = 0
    var tn: *u8 = method_recv_type_name(s, e, @tn_len)
    if tn == null or tn_len == 0
        bk_receiver(s, e.left, @tn, @tn_len)
    if tn == null or tn_len == 0
        return null
    *out_len = tn_len
    tn

fn bk_method(s: *EmitterState, e: *Expr) -> i32
    if name_eq(StrView { ptr: (e.ident_ptr), len: (e.ident_len) as i64 }, StrView { ptr: (c"is_some"), len: (7) as i64 }) == 1 or name_eq(StrView { ptr: (e.ident_ptr), len: (e.ident_len) as i64 }, StrView { ptr: (c"is_none"), len: (7) as i64 }) == 1
        return BK_BOOL
    if name_eq(StrView { ptr: (e.ident_ptr), len: (e.ident_len) as i64 }, StrView { ptr: (c"is_ok"), len: (5) as i64 }) == 1 or name_eq(StrView { ptr: (e.ident_ptr), len: (e.ident_len) as i64 }, StrView { ptr: (c"is_err"), len: (6) as i64 }) == 1
        return BK_BOOL
    # The carrier's own methods hand back its payload.
    if name_eq(StrView { ptr: (e.ident_ptr), len: (e.ident_len) as i64 }, StrView { ptr: (c"unwrap"), len: (6) as i64 }) == 1 or name_eq(StrView { ptr: (e.ident_ptr), len: (e.ident_len) as i64 }, StrView { ptr: (c"unwrap_or"), len: (9) as i64 }) == 1
        let pk: i32 = bk_payload_of(s, e.left)
        if pk != BK_UNSURE
            return pk
    var tn_len: i32 = 0
    let tn: *u8 = bk_method_recv(s, e, @tn_len)
    if bk_is_strview_as_bytes(StrView { ptr: (tn), len: (tn_len) as i64 }, e) == 1
        return BK_OTHER
    let fd: *FnDef = bk_method_def(s, e)
    if fd == null
        return BK_UNSURE
    bk_of_fn(fd)

fn bk_call(s: *EmitterState, e: *Expr) -> i32
    # A call through a local: its signature, not a fn of that name.
    if e.func_name_len > 0
        let idx: i32 = find_local_idx(s, StrView { ptr: (e.func_name), len: (e.func_name_len) as i64 })
        if idx >= 0
            let loc: *LocalVar = local_at(s, idx)
            if lv_fn_sig(loc) != null
                return bk_of_fn(lv_fn_sig(loc))
            return BK_UNSURE
    if mem_builtin_id(StrView { ptr: (e.func_name), len: (e.func_name_len) as i64 }) != 0
        return bk_of_type(expr_slot_ty(e), StrView { ptr: (null), len: (0) as i64 })
    let fd: *FnDef = find_call_fn(s, e)
    if fd == null
        return BK_UNSURE
    bk_of_fn(fd)

# The struct `e` is, or points at, for the receiver forms member_field_def
# leaves out: `(*p).f`, `a[i].f`, `(x as *S).f`.
fn bk_receiver(s: *EmitterState, e: *Expr, out_name: **u8, out_len: *i32)
    *out_name = null
    *out_len = 0
    if e.kind == EXPR_UNARY and e.op == OP_DEREF
        bk_receiver(s, e.operand, out_name, out_len)
    else if e.kind == EXPR_UNARY and (e.op == OP_ADDR or e.op == OP_ADDR_MUT)
        # AGAST #3948: `(*(@x)).f` — the address carries x's own struct type,
        # as deref_pointee_struct_name reads it for the emitter's lowering.
        bk_receiver(s, e.operand, out_name, out_len)
    else if e.kind == EXPR_BINARY and (e.op == OP_ADD or e.op == OP_SUB)
        bk_receiver(s, e.left, out_name, out_len)
    else if e.kind == EXPR_INDEX
        # AGAST #3948: the element's own struct, as member_field_def reads an
        # `a[i].f` base — a Vec's or Span's element, not the container's name.
        index_elem_struct_name(s, e, out_name, out_len)
        if *out_name == null
            bk_receiver(s, e.left, out_name, out_len)
    else if e.kind == EXPR_CAST and e.ident_len > 0
        *out_name = e.ident_ptr
        *out_len = e.ident_len
    else if e.kind == EXPR_IDENT
        let idx: i32 = find_local_idx(s, StrView { ptr: (e.ident_ptr), len: (e.ident_len) as i64 })
        if idx >= 0
            let loc: *LocalVar = local_at(s, idx)
            *out_name = lv_type_name(loc)
            *out_len = lv_type_name_len(loc)
        else
            let g: *GlobalVarDef = find_global(s, StrView { ptr: (e.ident_ptr), len: (e.ident_len) as i64 })
            if g != null
                *out_name = g.type_name
                *out_len = g.type_name_len
    else if e.kind == EXPR_MEMBER
        let f: *StructField = member_field_def(s, e)
        if f != null
            if f.field_type == TYPE_ARRAY
                *out_name = f.array_elem_type_name
                *out_len = f.array_elem_type_name_len
            else
                *out_name = f.field_type_name
                *out_len = f.field_type_name_len
    else
        resolve_expr_struct_name(s, e, out_name, out_len)

fn bk_member(s: *EmitterState, e: *Expr) -> i32
    var f: *StructField = member_field_def(s, e)
    # `colors.ON`: a const reached through its module.
    if f == null and e.left.kind == EXPR_IDENT and find_local_idx(s, StrView { ptr: (e.left.ident_ptr), len: (e.left.ident_len) as i64 }) < 0
        let ce: *ConstEntry = find_const_entry(s, StrView { ptr: (e.ident_ptr), len: (e.ident_len) as i64 })
        if ce != null
            return bk_of_type(ce.const_type, StrView { ptr: (ce.type_name), len: (ce.type_name_len) as i64 })
    if f == null
        var name: *u8 = null
        var len: i32 = 0
        bk_receiver(s, e.left, @name, @len)
        if name == null or len <= 0
            return BK_UNSURE
        let st: *StructDef = find_struct(s, StrView { ptr: (name), len: (len) as i64 })
        if st == null
            return BK_UNSURE
        let idx: i32 = find_field_index(st, StrView { ptr: (e.ident_ptr), len: (e.ident_len) as i64 })
        if idx < 0
            return BK_UNSURE
        f = get_field_type(st, idx)
    bk_of_type(f.field_type, StrView { ptr: (f.field_type_name), len: (f.field_type_name_len) as i64 })

# What `e` is, or BK_UNSURE.  See the header.
pub fn bool_kind(s: *EmitterState, e: *Expr) -> i32
    if e == null
        return BK_UNSURE
    let k: i32 = e.kind
    if k == EXPR_INT_LIT
        if e.lit_kind == LIT_TRUE or e.lit_kind == LIT_FALSE
            return BK_BOOL
        if e.lit_kind == LIT_PASS
            return BK_UNSURE
        return BK_INT
    if k == EXPR_CHAR_LIT
        return BK_INT
    if k == EXPR_FLOAT_LIT
        return BK_FLOAT
    if k == EXPR_CSTRING_LIT or k == EXPR_NIL_LIT
        return BK_PTR
    if k == EXPR_STRING_LIT or k == EXPR_STRUCT_LIT or k == EXPR_ARRAY_LIT or k == EXPR_ARRAY_FILL
        return BK_OTHER
    if k == EXPR_IDENT
        return bk_name(s, StrView { ptr: (e.ident_ptr), len: (e.ident_len) as i64 })
    if k == EXPR_BINARY
        if e.op >= OP_EQ and e.op <= OP_OR
            return BK_BOOL
        let l: i32 = bool_kind(s, e.left)
        let r: i32 = bool_kind(s, e.right)
        if l == BK_BOOL or r == BK_BOOL
            return BK_BAD
        if e.op >= OP_BIT_AND and e.op <= OP_SHR
            return BK_INT
        return bk_arithmetic(l, r)
    if k == EXPR_UNARY
        if e.op == OP_NOT
            return BK_BOOL
        if e.op == OP_ADDR or e.op == OP_ADDR_MUT
            return BK_PTR
        if e.op == OP_NEG or e.op == OP_BIT_NOT
            let o: i32 = bool_kind(s, e.operand)
            if o == BK_BOOL
                return BK_BAD
            return o
        # AGAST #2972: `*h` of an integer or `bool` borrow `h:& T` is `h`.
        if e.op == OP_DEREF and lent_scalar_ident(s, e.operand) != null
            return bool_kind(s, e.operand)
        return bk_of_type(expr_slot_ty(e), StrView { ptr: (null), len: (0) as i64 })
    if k == EXPR_CAST
        return bk_of_type(e.op, StrView { ptr: (e.ident_ptr), len: (e.ident_len) as i64 })
    if k == EXPR_MEMBER
        return bk_member(s, e)
    if k == EXPR_INDEX
        return bk_index(s, e)
    if k == EXPR_CALL
        return bk_call(s, e)
    if k == EXPR_METHOD
        return bk_method(s, e)
    if k == EXPR_IF or k == EXPR_MATCH
        return bk_arms(s, e.args as *MatchArm)
    if k == EXPR_TRY
        return bk_payload_of(s, e.left)
    BK_UNSURE

# The local just added is a pattern's binding, of kind `k`.  Its slot is an i64
# whatever the value is, so TYPE_I64 says nothing.
pub fn bool_note_binding(s: *EmitterState, k: i32)
    let loc: *LocalVar = local_at(s, s.local_count - 1)
    loc.is_bool = (k == BK_BOOL) as i32
    lv_set_bk_unsure(loc, (k != BK_BOOL and k != BK_INT) as i32)
    lv_set_bk_ptr(loc, (k == BK_PTR) as i32)   # AGAST #4280
