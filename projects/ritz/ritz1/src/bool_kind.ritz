# bool_kind.ritz - the emitter's bool kind of an expression (LARB R4, AGAST #2342)
#
# What an expression is, as far as `bool` cares (BK_*, bool_check.ritz), read
# off the emitter's own state mid-lowering: its LocalVar scope, get_expr_type
# and the receiver resolution the lowering uses.  Codegen reads it (a bool
# local's i1 store, print's `true` / `false`, a match scrutinee's binding).
# ritz1 can't read a bool off the LLVM type as ritz0 does: a bool value lives
# in an i64 register (#1646).
#
# bool_check's own rules run on Sema (AGAST #3502, #1816) and judge with
# sema_bool_kind, its port of this onto Sema's scope.  sema_probe.ritz pins the
# two together on every expression the emitter lowers (RITZ1_SEMA_PROBE=1).
# This copy goes when the emitter reads types off Sema (#3514).

import ritzlib.sys
import ritzlib.io
import ritzlib.strview  # strview_empty (AGAST #4772)

import ast
import ast_helpers
import emitter_core
import emitter_types   # AGAST #1818: type inference moved out of emitter_core
import bool_check          # BK_*, bk_of_type, bk_tagged_payload

fn bk_name(s: *EmitterState, name_sv: StrView) -> i32
    var len: i32 = name_sv.len as i32
    let ce: *ConstEntry = find_const_entry(s, name_sv)
    if ce != null
        return bk_of_type(ce.const_type, ce.type_name)
    let idx: i32 = find_local_idx(s, name_sv)
    if idx >= 0
        let loc: *LocalVar = local_at(s, idx)
        if loc.is_bool == 1
            return BK_BOOL
        if lv_bk_ptr(loc) == 1
            return BK_PTR
        if lv_bk_unsure(loc) == 1
            return BK_UNSURE
        return bk_of_type(lv_var_type(loc), StrView { ptr: (lv_type_name(loc)), len: (lv_type_name_len(loc)) as i64 })
    let g: *GlobalVarDef = find_global(s, name_sv)
    if g != null
        return bk_of_type(g.var_type, g.type_name)
    if find_fn(s, name_sv) != null
        return BK_PTR
    BK_UNSURE

# What `name[i]` is, for a local or global `name`.
pub fn bk_element(s: *EmitterState, name_sv: StrView) -> i32
    var len: i32 = name_sv.len as i32
    # AGAST #2440: through a pointer or reference, the buffer's element.
    let through: TypeKind = through_named_elem(s, name_sv)
    if through != TypeKind.Void
        return bk_of_type(through, strview_empty())
    let idx: i32 = find_local_idx(s, name_sv)
    if idx >= 0
        let loc: *LocalVar = local_at(s, idx)
        match lv_var_type(loc)
            TypeKind.Array =>
                return bk_of_type(lv_array_elem_type(loc), StrView { ptr: (lv_type_name(loc)), len: (lv_type_name_len(loc)) as i64 })
            TypeKind.Ptr | TypeKind.Ref | TypeKind.MutRef =>
                # `p: *[N]T` indexes T (#2321), not the array.
                if lv_pointee_type(loc) == TypeKind.Array
                    return bk_of_type(lv_pointee_array_elem_type(loc), StrView { ptr: (lv_type_name(loc)), len: (lv_type_name_len(loc)) as i64 })
                return bk_of_type(lv_pointee_type(loc), StrView { ptr: (lv_type_name(loc)), len: (lv_type_name_len(loc)) as i64 })
            _ => pass
        return BK_UNSURE
    let g: *GlobalVarDef = find_global(s, name_sv)
    if g == null
        # AGAST #4403: `KS[i]` of `const KS: [N]T` takes its element T from
        # the ConstEntry, as Sema's sbk_element does.  get_expr_type guessed
        # an i64 for a struct element, so a `const [N]StrView` was BK_INT.
        let ce: *ConstEntry = find_const_entry(s, name_sv)
        if ce != null and ce.const_type == TypeKind.Array
            return bk_of_type(ce.array_elem_type, ce.array_elem_type_name)
        return BK_UNSURE
    match g.var_type
        TypeKind.Array =>
            return bk_of_type(g.array_elem_type, g.type_name)
        TypeKind.Ptr =>
            return bk_of_type(g.pointee_type, g.type_name)
        _ => pass
    BK_UNSURE

fn bk_index(s: *EmitterState, e: *Expr) -> i32
    if e.right != null and e.right.kind == ExprKind.Range
        return BK_PTR
    # AGAST #2768: a full-rank `x[i][j]` over an N-D `[N][M]T` (local, global
    # or field) is its leaf T.  Its base is an index, not a name, so it fell to
    # get_expr_type's i64 and `x[1][1] = true` was "cannot use bool as an
    # integer".
    var nd_depth: i32 = 0
    let nd_sh: *ArrayShape = nd_index_shape(s, e, @nd_depth)
    if nd_sh != null and nd_depth == nd_sh.rank
        return bk_of_type(nd_sh.leaf_type, nd_sh.leaf_name)
    # AGAST #4450: `p[i]` through a `*E`, E a user enum, is the `%E` the
    # emitter loads (ptr_index_user_enum), not an integer.
    var pe_name: *u8 = null
    var pe_len: i32 = 0
    let pe_name_sv: StrView = ptr_index_user_enum(s, e)
    pe_name = pe_name_sv.ptr
    pe_len = pe_name_sv.len as i32
    if pe_len > 0
        return bk_of_type(TypeKind.Struct, StrView { ptr: (pe_name), len: (pe_len) as i64 })
    let base: *Expr = e.left
    match base.kind
        ExprKind.Ident =>
            let k: i32 = bk_element(s, base.ident)
            if k != BK_UNSURE
                return k
        ExprKind.Member =>
            let f: *StructField = member_field_def(s, base)
            if f != null
                if f.field_type == TypeKind.Array
                    return bk_of_type(f.array_elem_type, f.array_elem_type_name)
                if f.field_type == TypeKind.Ptr and get_member_pointee_type_exact(s, base) == TypeKind.Bool
                    return BK_BOOL
        _ => pass
    bk_of_type(expr_slot_ty(e), strview_empty())

# The first arm with a value: a `return` arm has none, and ritz0's phi skips it.
fn bk_arms(s: *EmitterState, arms: *MatchArm) -> i32
    var arm: *MatchArm = arms
    while arm != null
        if arm.is_pass == 0 and arm.body != null
            let k: i32 = bool_kind(s, arm.body)
            if k != BK_UNSURE
                return k
        arm = arm.next
    BK_UNSURE

# What `e?` or `e.unwrap()` gives, for `e` an Option or Result.
fn bk_payload_of(s: *EmitterState, e: *Expr) -> i32
    var name: StrView = strview_empty()
    bk_receiver(s, e, @name)
    if name.ptr == null or name.len <= 0 or is_tagged_enum_type(name) == 0
        return BK_UNSURE
    bk_tagged_payload(name, 0)

# The fn a method call dispatches to, or null.
pub fn bk_method_def(s: *EmitterState, e: *Expr) -> *FnDef
    let tn: StrView = bk_method_recv(s, e)
    if tn.ptr == null
        return null
    method_callee_def(s, tn, e.ident)

# The type name method call `e` dispatches on, or `strview_empty()`.
fn bk_method_recv(s: *EmitterState, e: *Expr) -> StrView
    var tn: StrView = method_recv_type_name(s, e)
    if tn.ptr == null or tn.len == 0
        bk_receiver(s, e.left, @tn)
    if tn.ptr == null or tn.len == 0
        return strview_empty()
    tn

fn bk_method(s: *EmitterState, e: *Expr) -> i32
    if name_eq(e.ident, "is_some") == 1 or name_eq(e.ident, "is_none") == 1
        return BK_BOOL
    if name_eq(e.ident, "is_ok") == 1 or name_eq(e.ident, "is_err") == 1
        return BK_BOOL
    # The carrier's own methods hand back its payload.
    if name_eq(e.ident, "unwrap") == 1 or name_eq(e.ident, "unwrap_or") == 1
        let pk: i32 = bk_payload_of(s, e.left)
        if pk != BK_UNSURE
            return pk
    let tn: StrView = bk_method_recv(s, e)
    if bk_is_strview_as_bytes(tn, e) == 1
        return BK_OTHER
    let fd: *FnDef = bk_method_def(s, e)
    if fd == null
        return BK_UNSURE
    bk_of_fn(fd)

fn bk_call(s: *EmitterState, e: *Expr) -> i32
    # A call through a local: its signature, not a fn of that name.
    if e.func_name.len > 0
        let idx: i32 = find_local_idx(s, e.func_name)
        if idx >= 0
            let loc: *LocalVar = local_at(s, idx)
            if lv_fn_sig(loc) != null
                return bk_of_fn(lv_fn_sig(loc))
            return BK_UNSURE
    if mem_builtin_id(e.func_name) != 0
        return bk_of_type(expr_slot_ty(e), strview_empty())
    let fd: *FnDef = find_call_fn(s, e)
    if fd == null
        return BK_UNSURE
    bk_of_fn(fd)

# The struct `e` is, or points at, for the receiver forms member_field_def
# leaves out: `(*p).f`, `a[i].f`, `(x as *S).f`.
fn bk_receiver(s: *EmitterState, e: *Expr, out: *StrView)
    *out = strview_empty()
    if e.kind == ExprKind.Unary and e.op == OpKind.Deref
        bk_receiver(s, e.operand, out)
    else if e.kind == ExprKind.Unary and (e.op == OpKind.Addr or e.op == OpKind.AddrMut)
        # AGAST #3948: `(*(@x)).f` — the address carries x's own struct type,
        # as deref_pointee_struct_name reads it for the emitter's lowering.
        bk_receiver(s, e.operand, out)
    else if e.kind == ExprKind.Binary and (e.op == OpKind.Add or e.op == OpKind.Sub)
        bk_receiver(s, e.left, out)
    else if e.kind == ExprKind.Index
        # AGAST #3948: the element's own struct, as member_field_def reads an
        # `a[i].f` base — a Vec's or Span's element, not the container's name.
        let elem_sv: StrView = index_elem_struct_name(s, e)
        *out = elem_sv
        if out.ptr == null
            bk_receiver(s, e.left, out)
    else if e.kind == ExprKind.Cast and (e.ident.len as i32) > 0
        *out = e.ident
    else
        match e.kind
            ExprKind.Ident =>
                let idx: i32 = find_local_idx(s, e.ident)
                if idx >= 0
                    let loc: *LocalVar = local_at(s, idx)
                    *out = StrView { ptr: lv_type_name(loc), len: (lv_type_name_len(loc)) as i64 }
                else
                    let g: *GlobalVarDef = find_global(s, e.ident)
                    if g != null
                        *out = g.type_name
            ExprKind.Member =>
                let f: *StructField = member_field_def(s, e)
                if f != null
                    if f.field_type == TypeKind.Array
                        *out = f.array_elem_type_name
                    else
                        *out = f.field_type_name
            _ =>
                let resolved: StrView = resolve_expr_struct_name(s, e)
                *out = resolved

fn bk_member(s: *EmitterState, e: *Expr) -> i32
    var f: *StructField = member_field_def(s, e)
    # `colors.ON`: a const reached through its module.
    if f == null and e.left.kind == ExprKind.Ident and find_local_idx(s, e.left.ident) < 0
        let ce: *ConstEntry = find_const_entry(s, e.ident)
        if ce != null
            return bk_of_type(ce.const_type, ce.type_name)
    if f == null
        var name: StrView = strview_empty()
        bk_receiver(s, e.left, @name)
        if name.ptr == null or name.len <= 0
            return BK_UNSURE
        let st: *StructDef = find_struct(s, name)
        if st == null
            return BK_UNSURE
        let idx: i32 = find_field_index(st, e.ident)
        if idx < 0
            return BK_UNSURE
        f = get_field_type(st, idx)
    bk_of_type(f.field_type, f.field_type_name)

# What `e` is, or BK_UNSURE.  See the header.
pub fn bool_kind(s: *EmitterState, e: *Expr) -> i32
    if e == null
        return BK_UNSURE
    let k: ExprKind = e.kind
    match k
        ExprKind.IntLit =>
            if e.lit_kind == LIT_TRUE or e.lit_kind == LIT_FALSE
                return BK_BOOL
            if e.lit_kind == LIT_PASS
                return BK_UNSURE
            return BK_INT
        ExprKind.CharLit =>
            return BK_INT
        ExprKind.FloatLit =>
            return BK_FLOAT
        ExprKind.CstringLit | ExprKind.NilLit =>
            return BK_PTR
        ExprKind.StringLit | ExprKind.StructLit | ExprKind.ArrayLit | ExprKind.ArrayFill =>
            return BK_OTHER
        ExprKind.Ident =>
            return bk_name(s, e.ident)
        ExprKind.Binary =>
            if op_is_cmp_or_logic(e.op)
                return BK_BOOL
            let l: i32 = bool_kind(s, e.left)
            let r: i32 = bool_kind(s, e.right)
            if l == BK_BOOL or r == BK_BOOL
                return BK_BAD
            if op_is_bitwise(e.op)
                return BK_INT
            return bk_arithmetic(l, r)
        ExprKind.Unary =>
            match e.op
                OpKind.Not =>
                    return BK_BOOL
                OpKind.Addr | OpKind.AddrMut =>
                    return BK_PTR
                OpKind.Neg | OpKind.BitNot =>
                    let o: i32 = bool_kind(s, e.operand)
                    if o == BK_BOOL
                        return BK_BAD
                    return o
                _ => pass
            # AGAST #2972: `*h` of an integer or `bool` borrow `h:& T` is `h`.
            if e.op == OpKind.Deref and lent_scalar_ident(s, e.operand) != null
                return bool_kind(s, e.operand)
            return bk_of_type(expr_slot_ty(e), strview_empty())
        ExprKind.Cast =>
            return bk_of_type(e.type_kind, e.ident)
        ExprKind.Member =>
            return bk_member(s, e)
        ExprKind.Index =>
            return bk_index(s, e)
        ExprKind.Call =>
            return bk_call(s, e)
        ExprKind.Method =>
            return bk_method(s, e)
        ExprKind.If | ExprKind.Match =>
            return bk_arms(s, e.args as *MatchArm)
        ExprKind.Try =>
            return bk_payload_of(s, e.left)
        _ => pass
    BK_UNSURE

# The local just added is a pattern's binding, of kind `k`.  Its slot is an i64
# whatever the value is, so TypeKind.I64 says nothing.
pub fn bool_note_binding(s: *EmitterState, k: i32)
    let loc: *LocalVar = local_at(s, s.fcx.local_count - 1)
    loc.is_bool = (k == BK_BOOL) as i32
    lv_set_bk_unsure(loc, (k != BK_BOOL and k != BK_INT) as i32)
    lv_set_bk_ptr(loc, (k == BK_PTR) as i32)   # AGAST #4280
