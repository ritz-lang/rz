# ritz1/src/float_compare.ritz - an f32 compared with an f64 asks for `as`
#
# AGAST #3607, LANGUAGE_SPEC §7.2 (Aaron, 2026-11-17).
#
#     let y: f32 = 3.0
#     let x: f64 = 2.0
#     let z = y * x          # fine: f64, y widens (§7.1; emitted by #1965's fpext)
#     if x > y               # error: cannot compare `f64` with `f32`: ...
#     if x > (y as f64)      # fine
#
# `a: f32 = 0.1` against `b: f64 = 0.1` is `a == b` false and `a > b` true:
# both widen correctly, and the answer is still rarely what was meant, so the
# writer picks the precision.  A float literal takes the other side's type
# (`y == 0.1` is an f32 compare) and is never refused.
#
# It runs on Sema, from sema_walk_expr, so the emitter never sees the program.
# The types are sema_type's; an operand Sema can't type is let through, as
# the emitter's fpext lets it through, so a gap is a missed refusal, never a
# refused program ritz0 accepts.  The words are ritz0/float_rules.py's
# mixed_float_compare, and ritz0/test_float_width_compare.py feeds the same
# programs to all three compilers.

import ritzlib.cstr
import ritzlib.sys
import ritzlib.io

import ast
import ast_query   # name_eq & co., off emitter_core (AGAST #3513)
import diag
import sema
import sema_type

fn fc_name(t: TypeKind) -> StrView
    if t == TypeKind.F32
        return "`f32`"
    "`f64`"

fn fc_is_float(t: TypeKind) -> i32
    (t == TypeKind.F32 or t == TypeKind.F64) as i32

# Every binary expression, before its operands.
pub fn float_check_compare(sm: *Sema, e: *Expr)
    if e.kind != ExprKind.Binary or not op_is_comparison(e.op)
        return
    if is_float_lit_operand(e.left) == 1 or is_float_lit_operand(e.right) == 1
        return
    let l: TypeKind = sema_expr_type(sm, e.left)
    let r: TypeKind = sema_expr_type(sm, e.right)
    if fc_is_float(l) == 0 or fc_is_float(r) == 0 or l == r
        return
    sm.error_count = sm.error_count + 1
    diag_error_at(sema_file(sm).ptr, diag_span(e.span.line, e.span.col))
    eprints("cannot compare ")
    eprints(fc_name(l))
    eprints(" with ")
    eprints(fc_name(r))
    eprints(": write `as` to choose the precision\n")
