# ritz1/src/emitter_abi.ritz - how a struct or array crosses a call
#
# sret returns and byval params for large structs and arrays (AGAST #1730,
# #1739, #2306, #3181), their LLVM attribute spellings, and the deferred
# large-struct loads and copies that keep a big aggregate out of a
# first-class value.  Split from emitter_core by AGAST #1818 (no hand-written
# file over 3,000 SLOC): nothing left in emitter_core calls these, so this
# sits above it and below the emitter modules.
#
# The IR is written in ritz1/ARCHITECTURE.md's "Emitter style": a whole
# instruction per `format_into(s, "...")`, text as StrViews.

import ritzlib.sys
import ritzlib.io
import ritzlib.str
import ritzlib.strview
import ritzlib.string    # refuse_huge_fn_type_byval's message
import ritzlib.gvec
import ritzlib.memory
import ritzlib.hash
import ritzlib.hashmap
import ast
import diag            # diag_error_at, fn_display_name (AGAST #3445, #3621, #4018)
import types           # the one primitive type table (AGAST #1889)
import sha256          # sha256_hex, for a private fn's symbol (AGAST #4356)
import ast_helpers   # is_enum_type / enum_variant_index (AGAST #1660)
import tokens_gen
import emitter_ir      # ir_alloca (AGAST #4460)
import monomorph       # MonoCtx, EmitterState.mono (AGAST #4454)
import emitter_core
import text_bridge     # no_name, llvm_text, primitive_spelling (AGAST #4696)

# The type name a param was declared with (its elements' struct, for an array).
fn abi_param_type_name(p: *Param) -> StrView
    StrView { ptr: p.param_type_name, len: p.param_type_name_len as i64 }

# The struct type the fn being emitted returns.
fn abi_ret_type_name(s: *EmitterState) -> StrView
    StrView { ptr: s.ret_type_name, len: s.ret_type_name_len as i64 }

# A `ptr` operand: the register `reg`, or the global `@<name>` when reg < 0.
fn emit_ptr_operand(s: *EmitterState, reg: i32, name: StrView)
    if reg >= 0
        format_into(s, "%.{reg}")
        return
    let g: String = ir_name(name)
    format_into(s, "@{g.as_view()}")

# Hold the load `  %.reg = load %T, ptr <src>` when `ty` is an sret-sized
# struct; false when the caller must emit it as usual.  `src_name` names the
# source when src_reg < 0.
fn defer_load(s: *EmitterState, t: TypeKind, reg: i32, ty: StrView, src_reg: i32, src_name: StrView) -> bool
    if struct_ret_uses_sret(s, t, ty) == 0
        return false
    dload_add(s, reg, ty, src_reg, src_name.ptr, src_name.len as i32)
    true

# 1 (and the load line is held) when `t`/`ty_sv` is an sret-sized struct;
# 0 when the caller must emit the load as usual.  `src_reg` is the pointer
# register the line would say `, ptr %.N` for.
pub fn defer_large_struct_load(s: *EmitterState, t: TypeKind, reg: i32, ty_sv: StrView, src_reg: i32) -> i32
    if defer_load(s, t, reg, ty_sv, src_reg, no_name()) then 1 else 0

# As defer_large_struct_load, for `, ptr @<name>` (a global or const struct).
pub fn defer_large_struct_load_named(s: *EmitterState, t: TypeKind, reg: i32, ty_sv: StrView, name: StrView) -> i32
    if defer_load(s, t, reg, ty_sv, 0 - 1, name) then 1 else 0

# 1 when the store `store %T %.val, ptr %.dst` is the copy of a deferred load
# and was emitted as the helper call.  0 means "emit the store as usual".
pub fn defer_try_struct_copy_store(s: *EmitterState, t: TypeKind, ty_sv: StrView, val: i32, dst: i32) -> i32
    if defer_copy_store(s, t, ty_sv, val, dst, no_name()) then 1 else 0

# As defer_try_struct_copy_store, for `, ptr @<name>` (a global destination).
pub fn defer_try_struct_copy_store_named(s: *EmitterState, t: TypeKind, ty_sv: StrView, val: i32, name: StrView) -> i32
    if defer_copy_store(s, t, ty_sv, val, 0 - 1, name) then 1 else 0

# The held load of %.val as type `ty`, when the region since it cannot have
# written its source; null when there is none.
fn pending_load_of(s: *EmitterState, ty: StrView, val: i32) -> *DeferredLoad
    for i in 0..s.dload_count
        let r: *DeferredLoad = s.dloads + (i as i64)
        if r.state == DLOAD_PENDING and r.reg == val and dload_region_cannot_write(s, r.off) == 1
            let held: StrView = StrView { ptr: r.ty, len: r.ty_len as i64 }
            if held.eq(ty)
                return r
    null

# The store of %.val to <dst> (the register `dst`, or `@dst_name` when dst < 0)
# as the `@__ritz_sret_copy` call, when %.val is a held load; false otherwise.
fn defer_copy_store(s: *EmitterState, t: TypeKind, ty: StrView, val: i32, dst: i32, dst_name: StrView) -> bool
    if s.dload_count <= 0 or struct_ret_uses_sret(s, t, ty) == 0
        return false
    let r: *DeferredLoad = pending_load_of(s, ty, val)
    if r == null
        return false
    format_into(s, "  call void @__ritz_sret_copy(ptr ")
    emit_ptr_operand(s, dst, dst_name)
    format_into(s, ", ptr ")
    emit_ptr_operand(s, r.src_reg, StrView { ptr: r.src_name, len: r.src_name_len as i64 })
    format_into(s, ", ")
    emit_sret_size(s, ty)
    format_into(s, ")\n")
    s.sret_helpers_used = 1
    if r.used == 0
        r.state = DLOAD_DROPPED
    else
        # Also read elsewhere: keep the load, copy anyway, as the
        # #1732 pass did when its dead-load count saw a reader.
        r.state = DLOAD_KEEP
    true

# `  %.reg = <tytext>, ptr <src>` where <tytext> is what the load sites
# spell for the type kind `t`.  Emits the load line, or holds it when `ty_sv`
# is an sret-sized struct (AGAST #4461).  `src_reg` < 0 means the source is
# the named global `src_name`.  Returns 1 when the line was held.
pub fn emit_struct_load_or_defer(s: *EmitterState, t: TypeKind, reg: i32, ty_sv: StrView, src_reg: i32, src_name: StrView) -> i32
    let held_name: StrView = if src_reg < 0 then src_name else no_name()
    if defer_load(s, t, reg, ty_sv, src_reg, held_name)
        return 1
    format_into(s, "  %.{reg} = load ")
    emit_llvm_type_struct(s, t, ty_sv)
    format_into(s, ", ptr ")
    emit_ptr_operand(s, src_reg, src_name)
    format_into(s, "\n")
    0

# `  store %<ty> %.val, ptr <dst>` (`@dst_name` when dst < 0), or the
# `@__ritz_sret_copy` call when it copies a held sret-sized struct load
# (AGAST #4461).  True when the copy call was emitted.
fn struct_store_or_copy(s: *EmitterState, t: TypeKind, ty: StrView, val: i32, dst: i32, dst_name: StrView) -> bool
    if defer_copy_store(s, t, ty, val, dst, dst_name)
        return true
    format_into(s, "  store ")
    emit_llvm_type_struct(s, t, ty)
    format_into(s, " %.{val}, ptr ")
    emit_ptr_operand(s, dst, dst_name)
    format_into(s, "\n")
    false

# `  store %<ty> %.val, ptr %.dst`.  When it copies a held sret-sized struct
# load, this is the `@__ritz_sret_copy` call instead (AGAST #4461).
# Returns 1 when the copy call was emitted.
pub fn emit_struct_store_or_copy(s: *EmitterState, t: TypeKind, ty_sv: StrView, val: i32, dst: i32) -> i32
    if struct_store_or_copy(s, t, ty_sv, val, dst, no_name()) then 1 else 0

# As emit_struct_store_or_copy, for a `, ptr @<name>` global destination.
pub fn emit_struct_store_or_copy_named(s: *EmitterState, t: TypeKind, ty_sv: StrView, val: i32, name: StrView) -> i32
    if struct_store_or_copy(s, t, ty_sv, val, 0 - 1, name) then 1 else 0

pub fn struct_ret_uses_sret(s: *EmitterState, t: TypeKind, name_sv: StrView) -> i32
    if t != TypeKind.Struct or name_sv.ptr == null or name_sv.len <= 0
        return 0
    # Tagged enums (Result$/Option$) are not StructDefs and keep their ABI.
    if is_primitive_type_name(name_sv) == 1 or is_tagged_enum_type(name_sv) == 1
        return 0
    if find_struct(s, name_sv) == null
        return 0
    # get_struct_size_by_name is the padded LLVM alloc size.  It must be
    # exact, and ritz0's _sret_struct_type must measure the same way: for a
    # PARAM this predicate is the ABI (byval vs first-class), so a struct
    # that only padding lifts to 256 B is byval in both (AGAST #1744,
    # test_byval_exact_size.py).
    if get_struct_size_by_name(s, name_sv) < SRET_MIN_BYTES
        return 0
    1

# The exact LLVM alloc size of %T as a constant expression, prefixed `i64 `.
pub fn emit_sret_size(s: *EmitterState, name_sv: StrView)
    let n: String = ir_name(name_sv)
    format_into(s, "i64 ptrtoint (ptr getelementptr (%{n.as_view()}, ptr null, i32 1) to i64)")

# `ptr sret(%T) ` — the attribute both the definition and every call carry.
pub fn emit_sret_attr(s: *EmitterState, name_sv: StrView)
    let n: String = ir_name(name_sv)
    format_into(s, "ptr sret(%{n.as_view()}) ")

# AGAST #1739 — large by-value struct PARAMS are `ptr byval(%T) align 8`.
#
# A param of a struct at the sret threshold used to be a first-class %T
# argument (`define @f(%Big %b.arg)` + `store %Big %b.arg, ptr %slot`, and
# every caller loaded the argument first-class), which hangs clang -O2 for
# the same reason #1730 fixed for returns.  It was also not the C ABI: LLVM
# splits a first-class aggregate argument into one scalar per leaf, while C
# passes a large struct in memory.  `ptr byval(%T) align 8` is exactly what
# clang emits for a C `struct T` param on x86-64 SysV (a struct aligned past
# 8, one of `v4i64`, takes its own alignment: AGAST #3656).  The callee
# binds the param to the byval pointer, which it owns; the caller spills the argument into a fresh slot right after
# evaluating it (emit_call_arg), and the store site emits that spill as a
# pointer-to-pointer copy (#4461).  Uses the sret threshold,
# so small structs, tagged enums and primitives keep their ABI.
pub fn param_uses_byval(s: *EmitterState, p: *Param) -> i32
    if p == null
        return 0
    struct_ret_uses_sret(s, p.param_type, abi_param_type_name(p))

# `ptr byval(%T) align A` — what the definition, declare and every call
# carry.  A is 8, or %T's own alignment when that is more: a struct of
# `v4i64` is 32-aligned, and clang gives an over-aligned C struct its type's
# alignment (AGAST #3656).  ritz0's _byval_align writes the same A.
fn emit_byval_attr(s: *EmitterState, name: StrView)
    var a: i64 = get_struct_align_by_name(s, name)
    if a < 8
        a = 8
    let n: String = ir_name(name)
    format_into(s, "ptr byval(%{n.as_view()}) align {a}")

# Emit the LLVM type `[N x T]` of a 1-D local array (element struct `name`).
# The spelling matches emit_var_decl's alloca, so a copy loads and stores
# exactly the local's bytes.
pub fn emit_local_array_llvm_type(s: *EmitterState, size: i32, et: TypeKind, name_sv: StrView)
    if et == TypeKind.Struct and name_sv.len > 0
        let n: String = ir_name(name_sv)
        format_into(s, "[{size} x %{n.as_view()}]")
        return
    let elem: StrView = elem_mem_llvm(et)
    format_into(s, "[{size} x {elem}]")

# AGAST #2306 / #3181 — large by-value ARRAYS are `ptr byval` / `ptr sret`.
#
# #2287 / #2302 made a by-value `[N]T` param and a `-> [N]T` return a
# first-class `[N x T]`, which LLVM splits into one scalar per element: at
# N = 16384 u8 clang -O2 hangs, and at 65536 -O0 crashes.  As #1739 / #1730
# did for large structs, an array of at least SRET_MIN_BYTES is passed
# `ptr byval([N x T]) align A` and returned through `ptr sret([N x T])`, the
# same ABI ritz0 emits (both compilers changed together).  A is the
# ELEMENT's natural alignment, not 8: a byval `align` also promises that the
# pointer the caller passes is that aligned, and a `[N]u8` local is only
# 1-aligned.  x86-64 SysV rounds a byval stack slot up to 8 anyway.
#
# The `[N]T` is described by a Param: the param itself, or ret_array_of(f)
# for a return.  Below the threshold nothing changes.

# The byte size of an `[N]T` and the alignment of its element.
struct ArrayBytes
    size: i64
    align: i64

# The `[N]T` that `p` holds; size 0 (align 8) when `p` is not an array.
fn array_param_bytes(s: *EmitterState, p: *Param) -> ArrayBytes
    var align: i64 = 8
    if p == null or p.param_type != TypeKind.Array
        return ArrayBytes { size: 0, align: align }
    let sh: *ArrayShape = p.param_array_shape
    if sh != null
        # AGAST #3634: `[N][M]..T` is every leaf, at the leaf's alignment.
        let leaf: i64 = elem_size_align(s, sh.leaf_type, StrView { ptr: sh.leaf_name, len: sh.leaf_name_len as i64 }, @align)
        return ArrayBytes { size: leaf * (shape_leaf_count(sh) as i64), align: align }
    let es: i64 = elem_size_align(s, p.param_array_elem_type, abi_param_type_name(p), @align)
    ArrayBytes { size: es * (p.param_array_size as i64), align: align }

# 1 when the `[N]T` `p` holds is passed byval / returned sret (AGAST #2306).
pub fn array_param_uses_byval(s: *EmitterState, p: *Param) -> i32
    if array_param_bytes(s, p).size < SRET_MIN_BYTES
        return 0
    1

# AGAST #3668: the padded LLVM alloc size of a param passed `ptr byval`, a
# struct (param_uses_byval) or an `[N]T` (array_param_uses_byval); 0 for any
# other param.  i64 throughout: a byval past 4 GiB is what this measures.
pub fn param_byval_bytes(s: *EmitterState, p: *Param) -> i64
    if param_uses_byval(s, p) == 1
        return get_struct_size_by_name(s, abi_param_type_name(p))
    let bytes: i64 = array_param_bytes(s, p).size
    if bytes < SRET_MIN_BYTES
        return 0
    bytes

# A Ritz leaf type `T` of kind `t`, a struct named `name`.  "?" when unknown.
fn put_leaf_type(out: *String, t: TypeKind, name: StrView)
    let prim: StrView = primitive_spelling(t)
    if not unnamed(prim)
        format_into(out, "{prim}")
    else if name.ptr != null and name.len > 0
        format_into(out, "{name}")
    else
        format_into(out, "?")

# The param's type as written: `H`, or `[1073741825]i32` for an array.
pub fn put_param_type(out: *String, p: *Param)
    let name: StrView = abi_param_type_name(p)
    if p.param_type != TypeKind.Array
        format_into(out, "{name}")
        return
    format_into(out, "[{p.param_array_size}]")
    if p.param_array_elem_type == TypeKind.Ptr
        format_into(out, "*")
        put_leaf_type(out, p.param_array_elem_pointee, name)
        return
    put_leaf_type(out, p.param_array_elem_type, name)

# AGAST #3690: a call through a fn type whose by-value param `p` (the
# `n`th, 1-based) is past LLVM's byval limit is refused at the type's `fn`
# token (sig.line / sig.col; an alias's own, for a call through it), in
# ritz0's words.  An uncalled fn type is a plain `ptr`: nothing to refuse.
# Returns 1 when it refused.
pub fn refuse_huge_fn_type_byval(s: *EmitterState, sig: *FnDef) -> i32
    var refused: bool = false
    var n: i32 = 1
    var p: *Param = sig.params
    while p != null
        let bytes: i64 = param_byval_bytes(s, p)
        if bytes >= BYVAL_MAX_BYTES and not refused
            var ty: String = string_new()
            put_param_type(@&ty, p)
            var msg: String = string_new()
            format_into(@&msg, "parameter #{n} of this fn type is {bytes} bytes, too large to pass by value (LLVM's byval limit is 4 GiB); take it by reference: `@{ty.as_view()}` or `@&{ty.as_view()}`")
            emit_nd_error_sv(s, sig.line, sig.col, msg.as_view())
            refused = true
        n += 1
        p = p.next
    if refused then 1 else 0

# The `[N x T]` value type of the array `p` holds (its allocas and loads).
# AGAST #3634: a `[N][M]..T` is the nested `[N x [M x T]]`, as ritz0 spells it.
pub fn emit_array_value_llvm_type(s: *EmitterState, p: *Param)
    if p.param_array_shape != null
        emit_array_shape_llvm(s, p.param_array_shape, 0)
        return
    emit_local_array_llvm_type(s, p.param_array_size, p.param_array_elem_type, abi_param_type_name(p))

# `i64 sizeof([N x T])` as a constant expression, as emit_sret_size spells it.
pub fn emit_array_sret_size(s: *EmitterState, p: *Param)
    format_into(s, "i64 ptrtoint (ptr getelementptr (")
    emit_array_value_llvm_type(s, p)
    format_into(s, ", ptr null, i32 1) to i64)")

# `ptr sret([N x T]) ` (AGAST #3181).
pub fn emit_sret_array_attr(s: *EmitterState, ra: *Param)
    format_into(s, "ptr sret(")
    emit_array_value_llvm_type(s, ra)
    format_into(s, ") ")

# The `-> [N]T` of `f` when it is returned through sret, or null (AGAST #3181).
pub fn fn_sret_array(s: *EmitterState, f: *FnDef) -> *Param
    let ra: *Param = ret_array_of(f)
    if ra == null or array_param_uses_byval(s, ra) == 0
        return null
    ra

# A call's sret slot, when callee `f` returns `[N]T` through one (AGAST #3181):
# the fresh `[N x T]` slot it writes, which is also the call's value (a `ptr`;
# emit_call_array_store copies it).  `slot` (a struct's, or 0) otherwise.
# Each call site keeps its struct path.
pub fn emit_call_sret_array_slot(s: *EmitterState, f: *FnDef, slot: i32) -> i32
    let ra: *Param = fn_sret_array(s, f)
    if ra == null
        return slot
    let array_slot: i32 = next_reg(s)
    entry_alloca_reg_begin(s, array_slot)
    emit_array_value_llvm_type(s, ra)
    format_into(s, "  ; #3181 sret array\n")
    entry_alloca_reg_end(s)
    array_slot

# The `ptr sret(...)` an sret call passes: `[N x T]` or the struct `name`.
pub fn emit_call_sret_attr(s: *EmitterState, f: *FnDef, name_sv: StrView)
    let ra: *Param = fn_sret_array(s, f)
    if ra != null
        emit_sret_array_attr(s, ra)
        return
    emit_sret_attr(s, name_sv)

# After an sret call: a struct is loaded into `result` as the first-class
# value every consumer expects, and the slot remembered (emit_sret_ret_value
# copies it for `return f()`); an array's value is its slot, which
# emit_call_array_store copies from.
pub fn emit_call_sret_result(s: *EmitterState, f: *FnDef, result: i32, slot: i32, name_sv: StrView) -> i32
    if fn_sret_array(s, f) != null
        return slot
    emit_struct_load_or_defer(s, TypeKind.Struct, result, name_sv, slot, no_name())
    s.sret_last_val = result
    s.sret_last_slot = slot
    result

# The LLVM type of param `p` in a signature or call argument list.  AGAST #2287:
# a by-value `[N]T` is a first-class `[N x T]`, as ritz0 emits it; a large one
# is `ptr byval` (AGAST #2306), aligned as its element.
pub fn emit_param_llvm_type(s: *EmitterState, p: *Param)
    if param_uses_byval(s, p) == 1
        emit_byval_attr(s, abi_param_type_name(p))
        return
    if p.param_type != TypeKind.Array
        emit_llvm_type_struct(s, p.param_type, abi_param_type_name(p))
        return
    let ab: ArrayBytes = array_param_bytes(s, p)
    if ab.size < SRET_MIN_BYTES
        emit_array_value_llvm_type(s, p)
        return
    format_into(s, "ptr byval(")
    emit_array_value_llvm_type(s, p)
    format_into(s, ") align {ab.align}")

# AGAST #2302: the `-> [N]T` of `f` as a by-value param would hold it, or null.
pub fn ret_array_of(f: *FnDef) -> *Param
    if f == null or f.return_type != TypeKind.Array
        return null
    return f.ret_array_param

# The non-sret return type of `f` in a definition, declare or call: a `-> [N]T`
# is a first-class `[N x T]`, as ritz0 emits it (AGAST #2302), and `void` when
# large: it then comes back through `ptr sret([N x T])` (AGAST #3181).
pub fn emit_fn_ret_llvm_type(s: *EmitterState, f: *FnDef)
    let ra: *Param = ret_array_of(f)
    if ra == null
        emit_llvm_type_struct(s, f.return_type, StrView { ptr: f.return_type_name, len: f.return_type_name_len as i64 })
        return
    if array_param_uses_byval(s, ra) == 1
        format_into(s, "void")
        return
    emit_array_value_llvm_type(s, ra)   # AGAST #3634: `[N][M]T` too

# Return from an sret fn by copying the %T at register `src_ptr` (a `ptr`).
# The `ret` is its own piece: the sink drops the live owned bindings before it.
pub fn emit_sret_ret_from_ptr(s: *EmitterState, src_ptr: i32)
    format_into(s, "  call void @__ritz_sret_copy(ptr %ret.sret, ptr %.{src_ptr}, ")
    emit_sret_size(s, abi_ret_type_name(s))
    format_into(s, ")\n")
    format_into(s, "  ret void\n")
    s.sret_helpers_used = 1

# Module-internal byte copy / zero used by every sret return.  Defined once
# per module, only when used.  "no-builtins" keeps clang from rewriting the
# loops into libc memcpy/memset calls (see build.py FREESTANDING_FLAGS).
# These are module-level text, emitted after every fn: each `  ret void\n` is
# its own piece, so the sink runs its before-`ret` drops, but no owned binding
# is live here and they emit nothing.
pub fn emit_sret_helpers(s: *EmitterState)
    if s.sret_helpers_used == 0
        return
    format_into(s, "define internal void @__ritz_sret_copy(ptr %d, ptr %s, i64 %n) \"no-builtins\"")
    emit_no_red_zone_attr(s)
    format_into(s, " {{\n")
    format_into(s, "entry:\n")
    format_into(s, "  %z = icmp eq i64 %n, 0\n")
    format_into(s, "  br i1 %z, label %done, label %loop\n")
    format_into(s, "loop:\n")
    format_into(s, "  %i = phi i64 [ 0, %entry ], [ %i1, %loop ]\n")
    format_into(s, "  %sp = getelementptr i8, ptr %s, i64 %i\n")
    format_into(s, "  %c = load i8, ptr %sp\n")
    format_into(s, "  %dp = getelementptr i8, ptr %d, i64 %i\n")
    format_into(s, "  store i8 %c, ptr %dp\n")
    format_into(s, "  %i1 = add i64 %i, 1\n")
    format_into(s, "  %more = icmp ult i64 %i1, %n\n")
    format_into(s, "  br i1 %more, label %loop, label %done\n")
    format_into(s, "done:\n")
    format_into(s, "  ret void\n")
    format_into(s, "}}\n\n")
    format_into(s, "define internal void @__ritz_sret_zero(ptr %d, i64 %n) \"no-builtins\"")
    emit_no_red_zone_attr(s)
    format_into(s, " {{\n")
    format_into(s, "entry:\n")
    format_into(s, "  %z = icmp eq i64 %n, 0\n")
    format_into(s, "  br i1 %z, label %done, label %loop\n")
    format_into(s, "loop:\n")
    format_into(s, "  %i = phi i64 [ 0, %entry ], [ %i1, %loop ]\n")
    format_into(s, "  %dp = getelementptr i8, ptr %d, i64 %i\n")
    format_into(s, "  store i8 0, ptr %dp\n")
    format_into(s, "  %i1 = add i64 %i, 1\n")
    format_into(s, "  %more = icmp ult i64 %i1, %n\n")
    format_into(s, "  br i1 %more, label %loop, label %done\n")
    format_into(s, "done:\n")
    format_into(s, "  ret void\n")
    format_into(s, "}}\n\n")

# The float widths float `%` has a helper for (EmitterState.fmod_helpers_used).
enum FmodWidth
    F64
    F32

# The fmod_helpers_used bit that says the helper at width `w` is called.
fn fmod_used_bit(w: FmodWidth) -> i32
    match w
        FmodWidth.F64 => 1
        FmodWidth.F32 => 2

fn fmod_symbol(w: FmodWidth) -> StrView
    match w
        FmodWidth.F64 => "__ritz_fmod"
        FmodWidth.F32 => "__ritz_fmodf"

fn fmod_llvm_type(w: FmodWidth) -> StrView
    match w
        FmodWidth.F64 => "double"
        FmodWidth.F32 => "float"

# @__ritz_fmod / @__ritz_fmodf: C's fmod, exactly, at float width `w`.  Float
# `%` can't be `frem`: x86-64 lowers it to a libm fmod call and Ritz links no
# libc (AGAST #3817).  Binary long division: double |y| up to just past |x|,
# then halve back down to |y|, subtracting where it fits (|x| < |y| subtracts
# nothing).  Each subtraction is
# exact (Sterbenz: d <= r < 2d) and so is each halving (it retraces a
# doubling).  Mirrors ritz0's _fmod_helper.  Module-level text, as
# emit_sret_helpers; here each `ret` shares a piece with the text before it,
# so no piece starts a `ret`.
fn emit_fmod_fn(s: *EmitterState, w: FmodWidth)
    let name: StrView = fmod_symbol(w)
    let ty: StrView = fmod_llvm_type(w)
    format_into(s, "define internal {ty} @{name}({ty} %x, {ty} %y) {{\n")
    format_into(s, "entry:\n")
    format_into(s, "  %xn = fcmp olt {ty} %x, 0.0\n")
    format_into(s, "  %xf = fneg {ty} %x\n")
    format_into(s, "  %ax = select i1 %xn, {ty} %xf, {ty} %x\n")
    format_into(s, "  %yn = fcmp olt {ty} %y, 0.0\n")
    format_into(s, "  %yf = fneg {ty} %y\n")
    format_into(s, "  %ay = select i1 %yn, {ty} %yf, {ty} %y\n")
    # y == 0, x infinite, or either NaN: NaN (unordered compares are true).
    format_into(s, "  %yz = fcmp ueq {ty} %ay, 0.0\n")
    format_into(s, "  %xi = fcmp ueq {ty} %ax, 0x7FF0000000000000\n")
    format_into(s, "  %bad = or i1 %yz, %xi\n")
    format_into(s, "  br i1 %bad, label %nan, label %up\n")
    format_into(s, "nan:\n  ret {ty} 0x7FF8000000000000\n")
    format_into(s, "up:\n")
    format_into(s, "  %t = phi {ty} [ %ay, %entry ], [ %t2, %up ]\n")
    format_into(s, "  %t2 = fmul {ty} %t, 2.0\n")
    format_into(s, "  %more = fcmp ole {ty} %t2, %ax\n")
    format_into(s, "  br i1 %more, label %up, label %down\n")
    format_into(s, "down:\n")
    format_into(s, "  %r = phi {ty} [ %ax, %up ], [ %r2, %down ]\n")
    format_into(s, "  %d = phi {ty} [ %t, %up ], [ %d2, %down ]\n")
    format_into(s, "  %ge = fcmp oge {ty} %r, %d\n")
    format_into(s, "  %rs = fsub {ty} %r, %d\n")
    format_into(s, "  %r2 = select i1 %ge, {ty} %rs, {ty} %r\n")
    format_into(s, "  %d2 = fmul {ty} %d, 0.5\n")
    format_into(s, "  %again = fcmp ogt {ty} %d, %ay\n")
    format_into(s, "  br i1 %again, label %down, label %done\n")
    format_into(s, "done:\n")
    format_into(s, "  %rn = fneg {ty} %r2\n")
    format_into(s, "  %res = select i1 %xn, {ty} %rn, {ty} %r2\n  ret {ty} %res\n")
    format_into(s, "}}\n\n")

# The fmod helper at width `w`, when float `%` called it in this module.
fn emit_fmod_if_used(s: *EmitterState, w: FmodWidth)
    if (s.fmod_helpers_used & fmod_used_bit(w)) != 0
        emit_fmod_fn(s, w)

# The fmod helpers float `%` called in this module, defined once each.
pub fn emit_fmod_helpers(s: *EmitterState)
    emit_fmod_if_used(s, FmodWidth.F64)
    emit_fmod_if_used(s, FmodWidth.F32)

# Return from an sret fn given a first-class %T value register.  When `val`
# is the load of an sret call's slot (`return f()`), copy the slot itself;
# otherwise spill the value and copy that.
pub fn emit_sret_ret_value(s: *EmitterState, val: i32)
    if val == s.sret_last_val and s.sret_last_slot > 0
        emit_sret_ret_from_ptr(s, s.sret_last_slot)
        return
    let ty: StrView = abi_ret_type_name(s)
    let tmp: i32 = emit_sret_call_slot(s, ty)
    emit_struct_store_or_copy(s, TypeKind.Struct, ty, val, tmp)
    emit_sret_ret_from_ptr(s, tmp)

# Caller side: allocate the result slot for a call to an sret fn.  Emit it
# BEFORE the `call` line; pass it with emit_sret_attr and `%.{slot}`.
pub fn emit_sret_call_slot(s: *EmitterState, name_sv: StrView) -> i32
    let slot: i32 = next_reg(s)
    entry_alloca_reg_begin_named(s, slot)
    let n: String = ir_name(name_sv)
    format_into(s, "{n.as_view()}\n")
    entry_alloca_reg_end(s)
    slot

# AGAST #1600: the user enum a bare identifier `B` denotes as a VALUE — a
# unit variant of exactly one non-generic enum, the name not shadowed by a
# const, local, global or fn (those resolve first in emit_expr_ident).
# Returns the enum index with *out_vi = the tag; -1 if `e` is not one; -2 if
# two enums declare the name (*out_vi / *out_other = the two enum indices,
# for the caller's error).  A payload variant used bare is -1: it is not a
# value without its payload.
pub fn bare_unit_variant_enum(s: *EmitterState, e: *Expr, out_vi: *i32, out_other: *i32) -> i32
    *out_vi = 0 - 1
    *out_other = 0 - 1
    if e == null or e.kind != ExprKind.Ident
        return 0 - 1
    let name: StrView = e.ident
    if is_const(s, name) == 1 or find_local(s, name) >= 0 or find_global(s, name) != null or find_fn(s, name) != null
        return 0 - 1
    let ei: i32 = enum_of_variant_unique(s.mono.pctx, name, out_vi, out_other)
    if ei < 0
        return ei
    if enum_variant_kind(s.mono.pctx, ei, *out_vi) != ENUM_VARIANT_UNIT
        *out_vi = 0 - 1
        return 0 - 1
    ei
