# ritz1/src/emitter.ritz - LLVM IR Emitter (orchestrator)
#
# emit_fn, emit_impl_method, and the top-level emit_module entrypoint.
# State / helpers / expressions / statements live in sibling modules:
#   emitter_core   — types, lookups, member-access GEP
#   emitter_expr   — emit_expr + emit_struct_lit_to_alloca
#   emitter_stmt   — emit_var_decl / emit_assign / emit_return / emit_stmt

import ritzlib.sys
import ritzlib.io
import ritzlib.str
import ritzlib.gvec
import ritzlib.memory

import ast
import tokens_gen
import emitter_core
import emitter_expr
import emitter_stmt

fn emit_fn(s: *EmitterState, f: *FnDef)
    # AGAST #194 modular emit: skip imports entirely. The owning .ll
    # emits the body; this .ll just needs a `declare`, which the
    # extern path produces only for fns actually called by local code
    # (driven by add_extern at every emit_expr_call site). That avoids
    # paying ~80 bytes per declare for fns this module doesn't reach.
    if f.is_local == 0 and f.body != null
        # Side-channel: register so emit_extern_declarations doesn't
        # accidentally emit a `(...)` fallback declare for fns we'd
        # otherwise resolve concretely.  Actually we don't add_extern
        # here — we want the declare to be opt-in via call sites only.
        return
    # Check if this is an extern function (no body) — defer the declare
    # to emit_extern_declarations so we don't duplicate it when a call
    # site also adds the name to s.externs (matches AGAST #194's
    # single-source-of-truth rule for declare emission).
    if f.body == null
        add_extern(s, f.name, f.name_len)
        return

    s.reg_counter = 1
    s.label_counter = 0
    s.local_count = 0
    s.break_label = -1
    s.continue_label = -1
    # ritz-task-193 — clear per-fn locals map (entries from previous fn
    # would otherwise pollute the probe chain and falsely match new locals
    # via stale-but-still-OCCUPIED slots).
    hashmap_i64_clear(@s.local_map)
    # Store return type name for struct returns
    s.ret_type_name = f.return_type_name
    s.ret_type_name_len = f.return_type_name_len

    # Linkage selection — AGAST #194 modular emit:
    #   - `main`: external (runtime _start needs it).
    #   - generic monomorphizations (name contains '$'): linkonce_odr —
    #     each user module emits its own copy; linker dedupes. Matches
    #     ritz0's `is_monomorphized` linkage path.
    #   - regular local fns: weak_odr — preserves cross-module dedup
    #     for legacy paths and avoids breaking impl-method emit, which
    #     emits the same Type_method from multiple .ll files when
    #     impls live alongside their type.
    var is_main: i32 = 0
    if f.name_len == 4
        if *(f.name + 0) == 109 and *(f.name + 1) == 97 and *(f.name + 2) == 105 and *(f.name + 3) == 110
            is_main = 1
    var is_monomorph: i32 = 0
    var name_i: i32 = 0
    while name_i < f.name_len
        if *(f.name + name_i) == 36   # '$' marks a monomorph instantiation suffix
            is_monomorph = 1
            name_i = f.name_len
        else
            name_i = name_i + 1
    if is_main == 1
        emit_str(s, c"define ")
    else if is_monomorph == 1
        emit_str(s, c"define linkonce_odr ")
    else
        emit_str(s, c"define weak_odr ")
    emit_llvm_type_struct(s, f.return_type, f.return_type_name, f.return_type_name_len)
    emit_str(s, c" @")
    emit_name(s, f.name, f.name_len)
    emit_str(s, c"(")

    var param2: *Param = f.params
    var first2: i32 = 1
    while param2 != null
        if first2 == 0
            emit_str(s, c", ")
        first2 = 0
        emit_llvm_type_struct(s, param2.param_type, param2.param_type_name, param2.param_type_name_len)
        emit_str(s, c" %")
        emit_name(s, param2.name, param2.name_len)
        emit_str(s, c".arg")
        param2 = param2.next

    # alignstack(16) ensures proper 16-byte stack alignment for SIMD instructions
    # that clang's optimizer may introduce even when we don't use SIMD explicitly
    #
    # "no-builtins" (AGAST #1313): Ritz links -nostdlib. LLVM's loop-idiom
    # recognizer does not know that, and at -O2 rewrites a plain byte loop into
    # a call to strlen/memcpy/memset/bcmp -- an undefined reference at link
    # time, or infinite self-recursion when it rewrites ritzlib's own memcpy.
    # build.py's -ffreestanding/-fno-builtin cannot prevent this: they are
    # frontend flags and we hand clang already-emitted .ll, so the frontend
    # never runs. The property has to travel with the IR.
    emit_str(s, c") alignstack(16) \"no-builtins\" {\n")
    emit_str(s, c"entry:\n")

    var param3: *Param = f.params
    while param3 != null
        let alloca_reg: i32 = next_reg(s)
        emit_str(s, c"  ")
        emit_reg(s, alloca_reg)
        emit_str(s, c" = alloca ")
        emit_llvm_type_struct(s, param3.param_type, param3.param_type_name, param3.param_type_name_len)
        emit_str(s, c"\n")
        emit_str(s, c"  store ")
        emit_llvm_type_struct(s, param3.param_type, param3.param_type_name, param3.param_type_name_len)
        emit_str(s, c" %")
        emit_name(s, param3.name, param3.name_len)
        emit_str(s, c".arg, ptr ")
        emit_reg(s, alloca_reg)
        emit_str(s, c"\n")
        # Track parameter type including struct name for method calls
        # For pointer-to-struct params like *Vec<u8>, we need both:
        # - param_pointee_type (TYPE_STRUCT) to know it's a pointer to struct
        # - param_type_name ("Vec$u8") to mangle method calls correctly
        if param3.param_type == TYPE_PTR or param3.param_type == TYPE_PTR_PTR or param3.param_type == TYPE_REF or param3.param_type == TYPE_MUT_REF
            add_local_full(s, param3.name, param3.name_len, alloca_reg, param3.param_type, param3.param_type_name, param3.param_type_name_len, param3.param_pointee_type, 0, 0)
        else if param3.param_type == TYPE_STRUCT
            add_local_struct(s, param3.name, param3.name_len, alloca_reg, param3.param_type, param3.param_type_name, param3.param_type_name_len)
        else
            add_local(s, param3.name, param3.name_len, alloca_reg, param3.param_type)
        param3 = param3.next

    clear_last_expr(s)  # Reset before processing function body (ritz-task-1309)
    var has_explicit_return: i32 = 0
    var stmt: *Stmt = f.body
    while stmt != null
        # Check if this is the last statement and it's an expression (implicit return)
        if stmt.next == null and stmt.kind == STMT_EXPR
            has_explicit_return = 1
            # Special handling for struct literal returns
            if stmt.expr.kind == EXPR_STRUCT_LIT and f.return_type == TYPE_STRUCT
                # Allocate space for the struct, initialize fields, load and return
                let alloca_reg: i32 = next_reg(s)
                emit_str(s, c"  ")
                emit_reg(s, alloca_reg)
                emit_str(s, c" = alloca %")
                emit_name(s, stmt.expr.ident_ptr, stmt.expr.ident_len)
                emit_str(s, c"\n")
                emit_struct_lit_to_alloca(s, stmt.expr, alloca_reg)
                # Load the struct value and return it
                let val: i32 = next_reg(s)
                emit_str(s, c"  ")
                emit_reg(s, val)
                emit_str(s, c" = load %")
                emit_name(s, stmt.expr.ident_ptr, stmt.expr.ident_len)
                emit_str(s, c", ptr ")
                emit_reg(s, alloca_reg)
                emit_str(s, c"\n")
                emit_str(s, c"  ret %")
                emit_name(s, stmt.expr.ident_ptr, stmt.expr.ident_len)
                emit_str(s, c" ")
                emit_reg(s, val)
                emit_str(s, c"\n")
            else if f.return_type == TYPE_STRUCT
                # Struct return — handle ident (load from alloca) or call result.
                # Use emit_llvm_type_struct so tagged-enum types (Result$/Option$)
                # auto-route to `i64` instead of `%<name>` (task-99 cluster #3).
                if stmt.expr.kind == EXPR_IDENT
                    let local: *LocalVar = find_local_struct_name(s, stmt.expr.ident_ptr, stmt.expr.ident_len)
                    if local != null
                        let loc: i32 = find_local(s, stmt.expr.ident_ptr, stmt.expr.ident_len)
                        let val: i32 = next_reg(s)
                        emit_str(s, c"  ")
                        emit_reg(s, val)
                        emit_str(s, c" = load ")
                        emit_llvm_type_struct(s, TYPE_STRUCT, local.type_name, local.type_name_len)
                        emit_str(s, c", ptr ")
                        emit_reg(s, loc)
                        emit_str(s, c"\n")
                        emit_str(s, c"  ret ")
                        emit_llvm_type_struct(s, TYPE_STRUCT, local.type_name, local.type_name_len)
                        emit_str(s, c" ")
                        emit_reg(s, val)
                        emit_str(s, c"\n")
                    else
                        let val: i32 = emit_expr(s, stmt.expr)
                        emit_str(s, c"  ret ")
                        emit_llvm_type_struct(s, TYPE_STRUCT, s.ret_type_name, s.ret_type_name_len)
                        emit_str(s, c" ")
                        emit_reg(s, val)
                        emit_str(s, c"\n")
                else
                    # Function call or other expression returning struct
                    let val: i32 = emit_expr(s, stmt.expr)
                    emit_str(s, c"  ret ")
                    emit_llvm_type_struct(s, TYPE_STRUCT, s.ret_type_name, s.ret_type_name_len)
                    emit_str(s, c" ")
                    emit_reg(s, val)
                    emit_str(s, c"\n")
            else
                let val: i32 = emit_expr(s, stmt.expr)
                if f.return_type == TYPE_I32 or f.return_type == TYPE_U32
                    let trunc: i32 = next_reg(s)
                    emit_str(s, c"  ")
                    emit_reg(s, trunc)
                    emit_str(s, c" = trunc i64 ")
                    emit_reg(s, val)
                    emit_str(s, c" to i32\n")
                    emit_str(s, c"  ret i32 ")
                    emit_reg(s, trunc)
                    emit_str(s, c"\n")
                else if f.return_type == TYPE_BOOL
                    # Comparisons zext to i64; trunc back for bool returns.
                    # (task-99 cluster #1)
                    let btrunc: i32 = next_reg(s)
                    emit_str(s, c"  ")
                    emit_reg(s, btrunc)
                    emit_str(s, c" = trunc i64 ")
                    emit_reg(s, val)
                    emit_str(s, c" to i1\n")
                    emit_str(s, c"  ret i1 ")
                    emit_reg(s, btrunc)
                    emit_str(s, c"\n")
                else if f.return_type == TYPE_I8 or f.return_type == TYPE_U8
                    # Narrow byte return (test_issue_namespace_const_field etc.)
                    let btrunc8: i32 = next_reg(s)
                    emit_str(s, c"  ")
                    emit_reg(s, btrunc8)
                    emit_str(s, c" = trunc i64 ")
                    emit_reg(s, val)
                    emit_str(s, c" to i8\n")
                    emit_str(s, c"  ret i8 ")
                    emit_reg(s, btrunc8)
                    emit_str(s, c"\n")
                else if f.return_type == TYPE_I16 or f.return_type == TYPE_U16
                    let btrunc16: i32 = next_reg(s)
                    emit_str(s, c"  ")
                    emit_reg(s, btrunc16)
                    emit_str(s, c" = trunc i64 ")
                    emit_reg(s, val)
                    emit_str(s, c" to i16\n")
                    emit_str(s, c"  ret i16 ")
                    emit_reg(s, btrunc16)
                    emit_str(s, c"\n")
                else if f.return_type == 0
                    emit_str(s, c"  ret void\n")
                else
                    emit_str(s, c"  ret ")
                    emit_llvm_type(s, f.return_type)
                    emit_str(s, c" ")
                    emit_reg(s, val)
                    emit_str(s, c"\n")
        else
            # Track if we hit a return statement
            if stmt.kind == STMT_RETURN
                has_explicit_return = 1
            emit_stmt(s, stmt, f.return_type)
        stmt = stmt.next

    # If no explicit return and function has non-void return, use the last
    # tracked expression value — but ONLY if it was defined in the block the
    # implicit `ret` will be emitted into (AGAST #1329).  Reading
    # `last_expr_reg` raw here bypassed the dominance guard #1309 added: a
    # trailing expression inside a loop body leaked its register into the
    # loop-exit block, where the body does not dominate the ret on the
    # zero-iteration path.  `last_expr_here` returns 0 in that case and we
    # fall through to the `ret <T> 0` default below — exactly what ritz0
    # does, and what an if-without-else already does post-#1309.
    if has_explicit_return == 0 and f.return_type != TYPE_VOID
        let ival: i32 = last_expr_here(s)
        if ival > 0
            if f.return_type == TYPE_I32 or f.return_type == TYPE_U32
                let trunc: i32 = next_reg(s)
                emit_str(s, c"  ")
                emit_reg(s, trunc)
                emit_str(s, c" = trunc i64 ")
                emit_reg(s, ival)
                emit_str(s, c" to i32\n")
                emit_str(s, c"  ret i32 ")
                emit_reg(s, trunc)
                emit_str(s, c"\n")
            else if f.return_type == TYPE_BOOL
                # Match arms / binops carry their result as i64 even when the
                # function signature is bool; trunc back to i1 at the implicit
                # return (mirrors the explicit-return path at line ~195).
                let btrunc: i32 = next_reg(s)
                emit_str(s, c"  ")
                emit_reg(s, btrunc)
                emit_str(s, c" = trunc i64 ")
                emit_reg(s, ival)
                emit_str(s, c" to i1\n")
                emit_str(s, c"  ret i1 ")
                emit_reg(s, btrunc)
                emit_str(s, c"\n")
            else if f.return_type == TYPE_I8 or f.return_type == TYPE_U8
                # Narrow byte return — expressions carry i64; trunc down.
                # (test_issue_namespace_const_field uses `-> u8`.)
                let btrunc8: i32 = next_reg(s)
                emit_str(s, c"  ")
                emit_reg(s, btrunc8)
                emit_str(s, c" = trunc i64 ")
                emit_reg(s, ival)
                emit_str(s, c" to i8\n")
                emit_str(s, c"  ret i8 ")
                emit_reg(s, btrunc8)
                emit_str(s, c"\n")
            else if f.return_type == TYPE_I16 or f.return_type == TYPE_U16
                let btrunc16: i32 = next_reg(s)
                emit_str(s, c"  ")
                emit_reg(s, btrunc16)
                emit_str(s, c" = trunc i64 ")
                emit_reg(s, ival)
                emit_str(s, c" to i16\n")
                emit_str(s, c"  ret i16 ")
                emit_reg(s, btrunc16)
                emit_str(s, c"\n")
            else if f.return_type == TYPE_STRUCT
                # tagged-enum or named-struct return: use the named type
                # (ritz-task-133).  Without this the tail-expression phi
                # carries `%Result$...` but the ret claims `i64`.
                emit_str(s, c"  ret ")
                emit_llvm_type_struct(s, TYPE_STRUCT, f.return_type_name, f.return_type_name_len)
                emit_str(s, c" ")
                emit_reg(s, ival)
                emit_str(s, c"\n")
            else
                emit_str(s, c"  ret ")
                emit_llvm_type(s, f.return_type)
                emit_str(s, c" ")
                emit_reg(s, ival)
                emit_str(s, c"\n")
        else
            # No value available, return 0
            if f.return_type == TYPE_STRUCT
                emit_str(s, c"  ret ")
                emit_llvm_type_struct(s, TYPE_STRUCT, f.return_type_name, f.return_type_name_len)
                emit_str(s, c" zeroinitializer\n")
            else
                emit_str(s, c"  ret ")
                emit_llvm_type(s, f.return_type)
                emit_str(s, c" 0\n")
    else if f.return_type == TYPE_VOID and has_explicit_return == 0
        emit_str(s, c"  ret void\n")
    emit_str(s, c"}\n\n")

# =============================================================================
# Impl Block Method Emission
# =============================================================================

# Emit an impl block method with mangled name: Type_method
# For `impl Point { fn sum(...) }` we emit `Point_sum`
fn emit_impl_method(s: *EmitterState, ib: *ImplBlock, method: *FnDef)
    # AGAST #194: imported impl methods are skipped here — the file that
    # owns the impl will emit the body. Call sites elsewhere reach this
    # method through emit_extern_declarations (declares get auto-emitted
    # for any unresolved Type_method extern).
    if method.is_local == 0
        return

    # Check if already emitted (deduplication for imports)
    # Mangle name: Type_method
    # First build the mangled name: type_name + "_" + method_name
    # We'll emit directly rather than building a separate buffer

    s.reg_counter = 1
    s.label_counter = 0
    s.local_count = 0
    s.break_label = -1
    s.continue_label = -1
    # ritz-task-1309 — drop the previous function's tracked expression value.
    # `label_counter` resets per function, so labels are NOT unique across the
    # module: a leftover `last_expr_label` from the previous function can
    # collide with a live label in this one and read as "defined here".
    # emit_fn clears this after its params; the method path never did.
    clear_last_expr(s)
    # ritz-task-193 — clear per-method locals map (matches emit_fn).
    hashmap_i64_clear(@s.local_map)
    # Propagate this method's return-type name into emitter state so
    # STMT_RETURN handling (in emitter_stmt.ritz) emits the correct
    # `ret %T` rather than leaking the previous fn's `s.ret_type_name`.
    # Without this, `fn slice(self: @StrView, ...) -> StrView` ended up
    # emitting `ret %Token` because the Token-returning emit_fn ran
    # earlier and last set s.ret_type_name.
    s.ret_type_name = method.return_type_name
    s.ret_type_name_len = method.return_type_name_len

    # Linkage selection mirrors emit_fn:
    #   - mangled name contains '$' (e.g. `Vec$u8_push`): linkonce_odr
    #   - else: weak_odr (cross-module dedup safety)
    var im_is_monomorph: i32 = 0
    var im_i: i32 = 0
    while im_i < ib.type_name_len
        if *(ib.type_name + im_i) == 36   # '$'
            im_is_monomorph = 1
            im_i = ib.type_name_len
        else
            im_i = im_i + 1
    if im_is_monomorph == 1
        emit_str(s, c"define linkonce_odr ")
    else
        emit_str(s, c"define weak_odr ")
    # For struct-returning impl methods (where `method.return_type_name`
    # is set), emit `%Type` so call sites that walk the impl table can
    # match the signature.  Other return types route through
    # emit_llvm_type which preserves the legacy i64 default for
    # TYPE_STRUCT-without-name (impl methods whose return slot lost the
    # name during parse — strview_slice etc. land here).
    if method.return_type == TYPE_STRUCT and method.return_type_name != null and method.return_type_name_len > 0
        emit_llvm_type_struct(s, method.return_type, method.return_type_name, method.return_type_name_len)
    else
        emit_llvm_type(s, method.return_type)
    emit_str(s, c" @")
    # Emit mangled name: Type_method
    emit_name(s, ib.type_name, ib.type_name_len)
    emit_str(s, c"_")
    emit_name(s, method.name, method.name_len)
    emit_str(s, c"(")

    var param: *Param = method.params
    var first: i32 = 1
    while param != null
        if first == 0
            emit_str(s, c", ")
        first = 0
        # Bare `self` receiver (task-99 cluster #1): UFCS callers pass
        # the receiver as `ptr <reg>` so the signature must declare it
        # as `ptr`, not as the impl's struct type.
        var is_self: i32 = 0
        if param.name_len == 4
            if *param.name == 115 and *(param.name + 1) == 101 and *(param.name + 2) == 108 and *(param.name + 3) == 102
                is_self = 1
        if is_self == 1
            emit_str(s, c"ptr")
        else
            # emit_llvm_type_struct so struct params declare `%Tag` rather
            # than the i64 fallback — keeps the definition in sync with
            # call sites that walk the same FnDef.params.
            emit_llvm_type_struct(s, param.param_type, param.param_type_name, param.param_type_name_len)
        emit_str(s, c" %")
        emit_name(s, param.name, param.name_len)
        emit_str(s, c".arg")
        param = param.next

    # alignstack(16) ensures proper 16-byte stack alignment for SIMD instructions
    # that clang's optimizer may introduce even when we don't use SIMD explicitly
    #
    # "no-builtins" (AGAST #1313): Ritz links -nostdlib. LLVM's loop-idiom
    # recognizer does not know that, and at -O2 rewrites a plain byte loop into
    # a call to strlen/memcpy/memset/bcmp -- an undefined reference at link
    # time, or infinite self-recursion when it rewrites ritzlib's own memcpy.
    # build.py's -ffreestanding/-fno-builtin cannot prevent this: they are
    # frontend flags and we hand clang already-emitted .ll, so the frontend
    # never runs. The property has to travel with the IR.
    emit_str(s, c") alignstack(16) \"no-builtins\" {\n")
    emit_str(s, c"entry:\n")

    var param2: *Param = method.params
    while param2 != null
        var p2_is_self: i32 = 0
        if param2.name_len == 4
            if *param2.name == 115 and *(param2.name + 1) == 101 and *(param2.name + 2) == 108 and *(param2.name + 3) == 102
                p2_is_self = 1
        let alloca_reg: i32 = next_reg(s)
        emit_str(s, c"  ")
        emit_reg(s, alloca_reg)
        emit_str(s, c" = alloca ")
        if p2_is_self == 1
            emit_str(s, c"ptr")
        else
            emit_llvm_type_struct(s, param2.param_type, param2.param_type_name, param2.param_type_name_len)
        emit_str(s, c"\n")
        emit_str(s, c"  store ")
        if p2_is_self == 1
            emit_str(s, c"ptr")
        else
            emit_llvm_type_struct(s, param2.param_type, param2.param_type_name, param2.param_type_name_len)
        emit_str(s, c" %")
        emit_name(s, param2.name, param2.name_len)
        emit_str(s, c".arg, ptr ")
        emit_reg(s, alloca_reg)
        emit_str(s, c"\n")
        # Track parameter type including struct name for method calls
        if p2_is_self == 1
            # Register `self` as a pointer-to-struct local so `self.field`
            # member access resolves via the impl type. (task-99 cluster #1)
            add_local_full(s, param2.name, param2.name_len, alloca_reg, TYPE_PTR, ib.type_name, ib.type_name_len, TYPE_STRUCT, 0, 0)
        else if param2.param_type == TYPE_PTR or param2.param_type == TYPE_PTR_PTR or param2.param_type == TYPE_REF or param2.param_type == TYPE_MUT_REF
            add_local_full(s, param2.name, param2.name_len, alloca_reg, param2.param_type, param2.param_type_name, param2.param_type_name_len, param2.param_pointee_type, 0, 0)
        else if param2.param_type == TYPE_STRUCT
            add_local_struct(s, param2.name, param2.name_len, alloca_reg, param2.param_type, param2.param_type_name, param2.param_type_name_len)
        else
            add_local(s, param2.name, param2.name_len, alloca_reg, param2.param_type)
        param2 = param2.next

    var stmt: *Stmt = method.body
    while stmt != null
        # Check if this is the last statement and it's an expression (implicit return)
        if stmt.next == null and stmt.kind == STMT_EXPR
            # Special handling for struct literal returns
            if stmt.expr.kind == EXPR_STRUCT_LIT and method.return_type == TYPE_STRUCT
                # Allocate space for the struct, initialize fields, load and return
                let alloca_reg: i32 = next_reg(s)
                emit_str(s, c"  ")
                emit_reg(s, alloca_reg)
                emit_str(s, c" = alloca %")
                emit_name(s, stmt.expr.ident_ptr, stmt.expr.ident_len)
                emit_str(s, c"\n")
                emit_struct_lit_to_alloca(s, stmt.expr, alloca_reg)
                # Load the struct value and return it
                let val: i32 = next_reg(s)
                emit_str(s, c"  ")
                emit_reg(s, val)
                emit_str(s, c" = load %")
                emit_name(s, stmt.expr.ident_ptr, stmt.expr.ident_len)
                emit_str(s, c", ptr ")
                emit_reg(s, alloca_reg)
                emit_str(s, c"\n")
                emit_str(s, c"  ret %")
                emit_name(s, stmt.expr.ident_ptr, stmt.expr.ident_len)
                emit_str(s, c" ")
                emit_reg(s, val)
                emit_str(s, c"\n")
            else
                let val: i32 = emit_expr(s, stmt.expr)
                if method.return_type == TYPE_I32 or method.return_type == TYPE_U32
                    let trunc: i32 = next_reg(s)
                    emit_str(s, c"  ")
                    emit_reg(s, trunc)
                    emit_str(s, c" = trunc i64 ")
                    emit_reg(s, val)
                    emit_str(s, c" to i32\n")
                    emit_str(s, c"  ret i32 ")
                    emit_reg(s, trunc)
                    emit_str(s, c"\n")
                else if method.return_type == TYPE_BOOL
                    # Comparisons zext to i64 in emit_binary; trunc back to
                    # i1 for bool-returning methods. (task-99 cluster #1)
                    let btrunc: i32 = next_reg(s)
                    emit_str(s, c"  ")
                    emit_reg(s, btrunc)
                    emit_str(s, c" = trunc i64 ")
                    emit_reg(s, val)
                    emit_str(s, c" to i1\n")
                    emit_str(s, c"  ret i1 ")
                    emit_reg(s, btrunc)
                    emit_str(s, c"\n")
                else if method.return_type == TYPE_I8 or method.return_type == TYPE_U8
                    let btrunc8: i32 = next_reg(s)
                    emit_str(s, c"  ")
                    emit_reg(s, btrunc8)
                    emit_str(s, c" = trunc i64 ")
                    emit_reg(s, val)
                    emit_str(s, c" to i8\n")
                    emit_str(s, c"  ret i8 ")
                    emit_reg(s, btrunc8)
                    emit_str(s, c"\n")
                else if method.return_type == TYPE_I16 or method.return_type == TYPE_U16
                    let btrunc16: i32 = next_reg(s)
                    emit_str(s, c"  ")
                    emit_reg(s, btrunc16)
                    emit_str(s, c" = trunc i64 ")
                    emit_reg(s, val)
                    emit_str(s, c" to i16\n")
                    emit_str(s, c"  ret i16 ")
                    emit_reg(s, btrunc16)
                    emit_str(s, c"\n")
                else if method.return_type == 0
                    emit_str(s, c"  ret void\n")
                else if method.return_type == TYPE_STRUCT and method.return_type_name != null and method.return_type_name_len > 0
                    # Struct-returning impl method.  Function header
                    # emits `define %T @T_method(...)` so the body must
                    # `ret %T <val>`.  Two shapes:
                    #
                    #  * EXPR_IDENT (`return self`): emit_expr loaded
                    #    the local as i64 (ptr-as-int).  Need
                    #    inttoptr+load to materialise a typed struct.
                    #
                    #  * EXPR_CALL (`return strview_slice(...)`): the
                    #    call already produced a `%T` register, so
                    #    just `ret %T <val>` directly.
                    if stmt.expr.kind == EXPR_IDENT
                        let pp: i32 = next_reg(s)
                        emit_str(s, c"  ")
                        emit_reg(s, pp)
                        emit_str(s, c" = inttoptr i64 ")
                        emit_reg(s, val)
                        emit_str(s, c" to ptr\n")
                        let sv: i32 = next_reg(s)
                        emit_str(s, c"  ")
                        emit_reg(s, sv)
                        emit_str(s, c" = load %")
                        emit_name(s, method.return_type_name, method.return_type_name_len)
                        emit_str(s, c", ptr ")
                        emit_reg(s, pp)
                        emit_str(s, c"\n")
                        emit_str(s, c"  ret %")
                        emit_name(s, method.return_type_name, method.return_type_name_len)
                        emit_str(s, c" ")
                        emit_reg(s, sv)
                        emit_str(s, c"\n")
                    else
                        emit_str(s, c"  ret %")
                        emit_name(s, method.return_type_name, method.return_type_name_len)
                        emit_str(s, c" ")
                        emit_reg(s, val)
                        emit_str(s, c"\n")
                else
                    emit_str(s, c"  ret ")
                    emit_llvm_type(s, method.return_type)
                    emit_str(s, c" ")
                    emit_reg(s, val)
                    emit_str(s, c"\n")
        else
            emit_stmt(s, stmt, method.return_type)
        stmt = stmt.next

    # For void methods without explicit return, emit ret void
    if method.return_type == TYPE_VOID
        emit_str(s, c"  ret void\n")
    emit_str(s, c"}\n\n")

# =============================================================================
# Module Emission
# =============================================================================

fn emit_string_byte(s: *EmitterState, b: u8)
    if b == 10
        emit_str(s, c"\\0A")
    else if b == 13
        emit_str(s, c"\\0D")
    else if b == 9
        emit_str(s, c"\\09")
    else if b == 0
        emit_str(s, c"\\00")
    else if b == 92
        emit_str(s, c"\\5C")
    else if b == 34
        emit_str(s, c"\\22")
    else if b >= 32 and b < 127
        vec_push<u8>(s.out, b)
    else
        emit_str(s, c"\\")
        let hi: u8 = (b / 16) as u8
        let lo: u8 = (b % 16) as u8
        if hi < 10
            vec_push<u8>(s.out, 48 + hi)
        else
            vec_push<u8>(s.out, 55 + hi)
        if lo < 10
            vec_push<u8>(s.out, 48 + lo)
        else
            vec_push<u8>(s.out, 55 + lo)

fn emit_string_constants(s: *EmitterState)
    for i in 0..s.string_count
        let str_lit: *StringLit = @s.strings[i]
        emit_str(s, c"@.str.")
        emit_int(s, i as i64)
        emit_str(s, c" = private constant [")
        emit_int(s, (str_lit.len + 1) as i64)
        emit_str(s, c" x i8] c\"")
        for j in 0..str_lit.len
            emit_string_byte(s, *(str_lit.data + j))
        emit_str(s, c"\\00\"\n")

fn is_local_function(m: *Module, name: *u8, len: i32) -> i32
    var f: *FnDef = m.functions
    while f != null
        # AGAST #194: a fn is "local" only when this .ll actually
        # defines its body (is_local == 1, set by main() for fns
        # parsed from the input file, and by monomorph for cloned
        # instantiations). Imported fns merged from other source
        # files carry is_local == 0 and must NOT short-circuit the
        # extern-declare path here — otherwise call sites in the
        # current .ll would reference unresolved symbols.
        if f.body != null and f.is_local == 1 and f.name_len == len
            var j: i32 = 0
            var matched: i32 = 1
            while j < len
                if *(f.name + j) != *(name + j)
                    matched = 0
                    break
                j += 1
            if matched == 1
                return 1
        f = f.next
    # Also check impl block methods (mangled as Type_method). Without this,
    # emit_extern_declarations emits a conflicting `declare` for any impl
    # method referenced from a call site (e.g. `tag.eq()` -> `Tag_eq`),
    # clashing with the `define` emitted by emit_impl_method and producing
    # LLVM's "invalid redefinition" error.
    var ib: *ImplBlock = m.impls
    while ib != null
        var method: *FnDef = ib.methods
        while method != null
            # AGAST #194: same rationale as the m.functions branch above —
            # only methods this .ll actually defines (is_local==1) count
            # as local for the extern-declare suppression check.
            if method.body != null and method.is_local == 1
                let type_len: i32 = ib.type_name_len
                if type_len + 1 + method.name_len == len
                    var matched: i32 = 1
                    var mj: i32 = 0
                    while mj < type_len
                        if *(ib.type_name + mj) != *(name + mj)
                            matched = 0
                            break
                        mj += 1
                    if matched == 1 and *(name + type_len) != 95  # '_'
                        matched = 0
                    if matched == 1
                        var mk: i32 = 0
                        while mk < method.name_len
                            if *(method.name + mk) != *(name + type_len + 1 + mk)
                                matched = 0
                                break
                            mk += 1
                    if matched == 1
                        return 1
            method = method.next
        ib = ib.next
    0

# Emit inline syscall implementations for commonly used syscall functions
fn emit_syscall_implementations(s: *EmitterState)
    emit_str(s, c"; Inline syscall implementations (weak_odr — linker merges duplicates across modules)\n")

    # syscall0-6: low-level syscall wrappers with weak_odr linkage
    # so multiple modules can emit them and the linker deduplicates.
    emit_str(s, c"define weak_odr i64 @syscall0(i64 %n) {\n")
    emit_str(s, c"  %ret = call i64 asm sideeffect \"syscall\", \"={rax},{rax},~{rcx},~{r11},~{memory}\"(i64 %n)\n")
    emit_str(s, c"  ret i64 %ret\n")
    emit_str(s, c"}\n\n")

    emit_str(s, c"define weak_odr i64 @syscall1(i64 %n, i64 %a1) {\n")
    emit_str(s, c"  %ret = call i64 asm sideeffect \"syscall\", \"={rax},{rax},{rdi},~{rcx},~{r11},~{memory}\"(i64 %n, i64 %a1)\n")
    emit_str(s, c"  ret i64 %ret\n")
    emit_str(s, c"}\n\n")

    emit_str(s, c"define weak_odr i64 @syscall2(i64 %n, i64 %a1, i64 %a2) {\n")
    emit_str(s, c"  %ret = call i64 asm sideeffect \"syscall\", \"={rax},{rax},{rdi},{rsi},~{rcx},~{r11},~{memory}\"(i64 %n, i64 %a1, i64 %a2)\n")
    emit_str(s, c"  ret i64 %ret\n")
    emit_str(s, c"}\n\n")

    emit_str(s, c"define weak_odr i64 @syscall3(i64 %n, i64 %a1, i64 %a2, i64 %a3) {\n")
    emit_str(s, c"  %ret = call i64 asm sideeffect \"syscall\", \"={rax},{rax},{rdi},{rsi},{rdx},~{rcx},~{r11},~{memory}\"(i64 %n, i64 %a1, i64 %a2, i64 %a3)\n")
    emit_str(s, c"  ret i64 %ret\n")
    emit_str(s, c"}\n\n")

    emit_str(s, c"define weak_odr i64 @syscall4(i64 %n, i64 %a1, i64 %a2, i64 %a3, i64 %a4) {\n")
    emit_str(s, c"  %ret = call i64 asm sideeffect \"syscall\", \"={rax},{rax},{rdi},{rsi},{rdx},{r10},~{rcx},~{r11},~{memory}\"(i64 %n, i64 %a1, i64 %a2, i64 %a3, i64 %a4)\n")
    emit_str(s, c"  ret i64 %ret\n")
    emit_str(s, c"}\n\n")

    emit_str(s, c"define weak_odr i64 @syscall5(i64 %n, i64 %a1, i64 %a2, i64 %a3, i64 %a4, i64 %a5) {\n")
    emit_str(s, c"  %ret = call i64 asm sideeffect \"syscall\", \"={rax},{rax},{rdi},{rsi},{rdx},{r10},{r8},~{rcx},~{r11},~{memory}\"(i64 %n, i64 %a1, i64 %a2, i64 %a3, i64 %a4, i64 %a5)\n")
    emit_str(s, c"  ret i64 %ret\n")
    emit_str(s, c"}\n\n")

    emit_str(s, c"define weak_odr i64 @syscall6(i64 %n, i64 %a1, i64 %a2, i64 %a3, i64 %a4, i64 %a5, i64 %a6) {\n")
    emit_str(s, c"  %ret = call i64 asm sideeffect \"syscall\", \"={rax},{rax},{rdi},{rsi},{rdx},{r10},{r8},{r9},~{rcx},~{r11},~{memory}\"(i64 %n, i64 %a1, i64 %a2, i64 %a3, i64 %a4, i64 %a5, i64 %a6)\n")
    emit_str(s, c"  ret i64 %ret\n")
    emit_str(s, c"}\n\n")

    # ritz0 alias `__syscallN` — net.ritz / friends use the underscore
    # variant.  Emit identical bodies under both names so the linker
    # resolves either form.
    emit_str(s, c"define weak_odr i64 @__syscall0(i64 %n) {\n")
    emit_str(s, c"  %ret = call i64 asm sideeffect \"syscall\", \"={rax},{rax},~{rcx},~{r11},~{memory}\"(i64 %n)\n")
    emit_str(s, c"  ret i64 %ret\n")
    emit_str(s, c"}\n\n")

    emit_str(s, c"define weak_odr i64 @__syscall1(i64 %n, i64 %a1) {\n")
    emit_str(s, c"  %ret = call i64 asm sideeffect \"syscall\", \"={rax},{rax},{rdi},~{rcx},~{r11},~{memory}\"(i64 %n, i64 %a1)\n")
    emit_str(s, c"  ret i64 %ret\n")
    emit_str(s, c"}\n\n")

    emit_str(s, c"define weak_odr i64 @__syscall2(i64 %n, i64 %a1, i64 %a2) {\n")
    emit_str(s, c"  %ret = call i64 asm sideeffect \"syscall\", \"={rax},{rax},{rdi},{rsi},~{rcx},~{r11},~{memory}\"(i64 %n, i64 %a1, i64 %a2)\n")
    emit_str(s, c"  ret i64 %ret\n")
    emit_str(s, c"}\n\n")

    emit_str(s, c"define weak_odr i64 @__syscall3(i64 %n, i64 %a1, i64 %a2, i64 %a3) {\n")
    emit_str(s, c"  %ret = call i64 asm sideeffect \"syscall\", \"={rax},{rax},{rdi},{rsi},{rdx},~{rcx},~{r11},~{memory}\"(i64 %n, i64 %a1, i64 %a2, i64 %a3)\n")
    emit_str(s, c"  ret i64 %ret\n")
    emit_str(s, c"}\n\n")

    emit_str(s, c"define weak_odr i64 @__syscall4(i64 %n, i64 %a1, i64 %a2, i64 %a3, i64 %a4) {\n")
    emit_str(s, c"  %ret = call i64 asm sideeffect \"syscall\", \"={rax},{rax},{rdi},{rsi},{rdx},{r10},~{rcx},~{r11},~{memory}\"(i64 %n, i64 %a1, i64 %a2, i64 %a3, i64 %a4)\n")
    emit_str(s, c"  ret i64 %ret\n")
    emit_str(s, c"}\n\n")

    emit_str(s, c"define weak_odr i64 @__syscall5(i64 %n, i64 %a1, i64 %a2, i64 %a3, i64 %a4, i64 %a5) {\n")
    emit_str(s, c"  %ret = call i64 asm sideeffect \"syscall\", \"={rax},{rax},{rdi},{rsi},{rdx},{r10},{r8},~{rcx},~{r11},~{memory}\"(i64 %n, i64 %a1, i64 %a2, i64 %a3, i64 %a4, i64 %a5)\n")
    emit_str(s, c"  ret i64 %ret\n")
    emit_str(s, c"}\n\n")

    emit_str(s, c"define weak_odr i64 @__syscall6(i64 %n, i64 %a1, i64 %a2, i64 %a3, i64 %a4, i64 %a5, i64 %a6) {\n")
    emit_str(s, c"  %ret = call i64 asm sideeffect \"syscall\", \"={rax},{rax},{rdi},{rsi},{rdx},{r10},{r8},{r9},~{rcx},~{r11},~{memory}\"(i64 %n, i64 %a1, i64 %a2, i64 %a3, i64 %a4, i64 %a5, i64 %a6)\n")
    emit_str(s, c"  ret i64 %ret\n")
    emit_str(s, c"}\n\n")

    # Note: Higher-level syscall wrappers (sys_write, sys_read, etc.) are
    # defined in ritzlib/sys.ritz and will be included when that module is imported.

# AGAST #185: cpuid_raw is a magic intrinsic name (no source body); ritz0
# emits inline asm at the call site, but ritz1 leaves the call referring to
# an external `@cpuid_raw` symbol.  Without an emitted body the linker fails
# with `undefined reference to cpuid_raw`.  Detect the name as an extern and
# emit a weak_odr definition wrapping the CPUID instruction in inline asm.
fn is_cpuid_raw_function(name: *u8, len: i32) -> i32
    if name_eq(name, len, c"cpuid_raw", 9) == 1
        return 1
    0

# Emit the cpuid_raw implementation as a weak_odr function so multiple
# modules can each emit it without linker conflicts.  Signature mirrors
# what ritz1 generates at call sites: 6 i64 args (leaf, subleaf, eax_p,
# ebx_p, ecx_p, edx_p) returning i64.  Truncate the leaf/subleaf to i32
# and treat the four pointer args as ptr via inttoptr.
fn emit_cpuid_raw_implementation(s: *EmitterState)
    emit_str(s, c"; AGAST #185: cpuid_raw — weak_odr inline-asm wrapper for CPUID instruction\n")
    emit_str(s, c"define weak_odr i64 @cpuid_raw(i64 %leaf.i64, i64 %sub.i64, i64 %eax.p64, i64 %ebx.p64, i64 %ecx.p64, i64 %edx.p64) {\n")
    emit_str(s, c"  %leaf = trunc i64 %leaf.i64 to i32\n")
    emit_str(s, c"  %sub = trunc i64 %sub.i64 to i32\n")
    emit_str(s, c"  %eax_p = inttoptr i64 %eax.p64 to ptr\n")
    emit_str(s, c"  %ebx_p = inttoptr i64 %ebx.p64 to ptr\n")
    emit_str(s, c"  %ecx_p = inttoptr i64 %ecx.p64 to ptr\n")
    emit_str(s, c"  %edx_p = inttoptr i64 %edx.p64 to ptr\n")
    emit_str(s, c"  %r = call {i32, i32, i32, i32} asm sideeffect \"cpuid\", \"={ax},={bx},={cx},={dx},{ax},{cx},~{dirflag},~{fpsr},~{flags}\"(i32 %leaf, i32 %sub)\n")
    emit_str(s, c"  %eax = extractvalue {i32, i32, i32, i32} %r, 0\n")
    emit_str(s, c"  %ebx = extractvalue {i32, i32, i32, i32} %r, 1\n")
    emit_str(s, c"  %ecx = extractvalue {i32, i32, i32, i32} %r, 2\n")
    emit_str(s, c"  %edx = extractvalue {i32, i32, i32, i32} %r, 3\n")
    emit_str(s, c"  store i32 %eax, ptr %eax_p\n")
    emit_str(s, c"  store i32 %ebx, ptr %ebx_p\n")
    emit_str(s, c"  store i32 %ecx, ptr %ecx_p\n")
    emit_str(s, c"  store i32 %edx, ptr %edx_p\n")
    emit_str(s, c"  ret i64 0\n")
    emit_str(s, c"}\n\n")

# AGAST #167: Recognize LLVM x86 intrinsic names registered as externs by
# emit_x86_simd_intrinsic.  These need typed `declare <vec> @llvm.x86.foo(<vec>...)`
# instead of the generic `declare i64 @name(...)`.
fn is_llvm_x86_intrinsic_name(name: *u8, len: i32) -> i32
    # Cheap prefix match on "llvm.x86.".
    if len < 9
        return 0
    if *(name + 0) != 'l'
        return 0
    if *(name + 1) != 'l'
        return 0
    if *(name + 2) != 'v'
        return 0
    if *(name + 3) != 'm'
        return 0
    if *(name + 4) != '.'
        return 0
    if *(name + 5) != 'x'
        return 0
    if *(name + 6) != '8'
        return 0
    if *(name + 7) != '6'
        return 0
    if *(name + 8) != '.'
        return 0
    1

# Emit a `declare` for one of the supported x86 SIMD LLVM intrinsics.  Keeps
# signature data co-located with name detection so the ritz1 dispatch and
# the module-level extern emission stay in sync.
fn emit_llvm_x86_intrinsic_decl(s: *EmitterState, name: *u8, len: i32)
    if name_eq(name, len, c"llvm.x86.sha256rnds2", 20) == 1
        emit_str(s, c"declare <4 x i32> @llvm.x86.sha256rnds2(<4 x i32>, <4 x i32>, <4 x i32>)\n")
        return
    if name_eq(name, len, c"llvm.x86.sha256msg1", 19) == 1
        emit_str(s, c"declare <4 x i32> @llvm.x86.sha256msg1(<4 x i32>, <4 x i32>)\n")
        return
    if name_eq(name, len, c"llvm.x86.sha256msg2", 19) == 1
        emit_str(s, c"declare <4 x i32> @llvm.x86.sha256msg2(<4 x i32>, <4 x i32>)\n")
        return
    if name_eq(name, len, c"llvm.x86.aesni.aesenc", 21) == 1
        emit_str(s, c"declare <2 x i64> @llvm.x86.aesni.aesenc(<2 x i64>, <2 x i64>)\n")
        return
    if name_eq(name, len, c"llvm.x86.aesni.aesenclast", 25) == 1
        emit_str(s, c"declare <2 x i64> @llvm.x86.aesni.aesenclast(<2 x i64>, <2 x i64>)\n")
        return
    if name_eq(name, len, c"llvm.x86.aesni.aesdec", 21) == 1
        emit_str(s, c"declare <2 x i64> @llvm.x86.aesni.aesdec(<2 x i64>, <2 x i64>)\n")
        return
    if name_eq(name, len, c"llvm.x86.aesni.aesdeclast", 25) == 1
        emit_str(s, c"declare <2 x i64> @llvm.x86.aesni.aesdeclast(<2 x i64>, <2 x i64>)\n")
        return
    if name_eq(name, len, c"llvm.x86.aesni.aesimc", 21) == 1
        emit_str(s, c"declare <2 x i64> @llvm.x86.aesni.aesimc(<2 x i64>)\n")
        return
    if name_eq(name, len, c"llvm.x86.sse2.psad.bw", 21) == 1
        emit_str(s, c"declare <2 x i64> @llvm.x86.sse2.psad.bw(<16 x i8>, <16 x i8>)\n")
        return
    if name_eq(name, len, c"llvm.x86.pclmulqdq", 18) == 1
        emit_str(s, c"declare <2 x i64> @llvm.x86.pclmulqdq(<2 x i64>, <2 x i64>, i8)\n")
        return
    # Unknown llvm.x86.* — fall back to a vague declare so the IR at least
    # parses (caller handles the type-check).
    emit_str(s, c"declare void @")
    emit_name(s, name, len)
    emit_str(s, c"(...)\n")

# Check if an external name is a syscall function we implement inline
# (Only the low-level syscall0-6 functions; higher-level wrappers come from ritzlib/sys.ritz)
fn is_syscall_function(name: *u8, len: i32) -> i32
    if name_eq(name, len, c"syscall0", 8) == 1
        return 1
    if name_eq(name, len, c"syscall1", 8) == 1
        return 1
    if name_eq(name, len, c"syscall2", 8) == 1
        return 1
    if name_eq(name, len, c"syscall3", 8) == 1
        return 1
    if name_eq(name, len, c"syscall4", 8) == 1
        return 1
    if name_eq(name, len, c"syscall5", 8) == 1
        return 1
    if name_eq(name, len, c"syscall6", 8) == 1
        return 1
    # ritz0-style alias `__syscallN`. ritzlib.net uses these — without
    # this branch, ritz1 emits `extern declare i64 @__syscall3` and the
    # linker has no body to resolve.
    if name_eq(name, len, c"__syscall0", 10) == 1
        return 1
    if name_eq(name, len, c"__syscall1", 10) == 1
        return 1
    if name_eq(name, len, c"__syscall2", 10) == 1
        return 1
    if name_eq(name, len, c"__syscall3", 10) == 1
        return 1
    if name_eq(name, len, c"__syscall4", 10) == 1
        return 1
    if name_eq(name, len, c"__syscall5", 10) == 1
        return 1
    if name_eq(name, len, c"__syscall6", 10) == 1
        return 1
    0

fn emit_extern_declarations(s: *EmitterState)
    # Check ALL externs for syscalls — even "local" ones (imported from ritzlib.sys),
    # because ritz1 can't emit their inline asm bodies. We provide our own implementations.
    var need_syscalls: i32 = 0
    for i in 0..s.extern_count
        let ex: *ExternFunc = @s.externs[i]
        if is_syscall_function(ex.name, ex.name_len) == 1
            need_syscalls = 1
    if need_syscalls == 1
        emit_syscall_implementations(s)

    # AGAST #185: emit cpuid_raw weak_odr body if any extern references it.
    # Same rationale as syscalls — ritz1 can't emit inline-asm intrinsic
    # bodies from source, so we provide one here.
    var need_cpuid: i32 = 0
    for i in 0..s.extern_count
        let ex: *ExternFunc = @s.externs[i]
        if is_cpuid_raw_function(ex.name, ex.name_len) == 1
            need_cpuid = 1
    if need_cpuid == 1
        emit_cpuid_raw_implementation(s)

    # Emit remaining external declarations (non-syscall, non-local functions)
    for i in 0..s.extern_count
        let ex: *ExternFunc = @s.externs[i]
        # Skip syscalls (already emitted inline above)
        if is_syscall_function(ex.name, ex.name_len) == 1
            continue
        # Skip cpuid_raw (weak_odr body emitted above)
        if is_cpuid_raw_function(ex.name, ex.name_len) == 1
            continue
        # AGAST #167: x86 LLVM intrinsics (`llvm.x86.sha256rnds2`, etc.) need
        # vector-typed declarations so clang accepts the inline calls emitted
        # by emit_x86_simd_intrinsic.  Detect by `llvm.x86.` prefix and emit
        # the right vector signature; everything else falls through to the
        # generic `declare i64 @name(...)` path below.
        if is_llvm_x86_intrinsic_name(ex.name, ex.name_len) == 1
            emit_llvm_x86_intrinsic_decl(s, ex.name, ex.name_len)
            continue
        # Skip if this function is defined in this module
        if is_local_function(s.module, ex.name, ex.name_len) == 0
                # Look up the function's return type from its definition
                let fn_def: *FnDef = find_fn(s, ex.name, ex.name_len)
                if fn_def != null and fn_def.return_type == TYPE_STRUCT
                    emit_str(s, c"declare %")
                    emit_name(s, fn_def.return_type_name, fn_def.return_type_name_len)
                    emit_str(s, c" @")
                    emit_name(s, ex.name, ex.name_len)
                    emit_str(s, c"(...)\n")
                else if fn_def != null and fn_def.return_type == TYPE_I32
                    emit_str(s, c"declare i32 @")
                    emit_name(s, ex.name, ex.name_len)
                    emit_str(s, c"(...)\n")
                else if fn_def != null and fn_def.return_type == TYPE_VOID
                    emit_str(s, c"declare void @")
                    emit_name(s, ex.name, ex.name_len)
                    emit_str(s, c"(...)\n")
                else
                    emit_str(s, c"declare i64 @")
                    emit_name(s, ex.name, ex.name_len)
                    emit_str(s, c"(...)\n")
    if s.extern_count > 0
        emit_str(s, c"\n")
# Returns 1 if every value-type struct dependency of `st` has already been
# emitted, 0 otherwise.  Pointer fields (TYPE_PTR / TYPE_PTR_PTR) are not
# dependencies — LLVM's opaque `ptr` lets us reference a forward-declared
# struct through a pointer.  Embedded structs (TYPE_STRUCT) and arrays of
# structs (TYPE_ARRAY whose elem is TYPE_STRUCT) require the dependent
# struct's body to be in scope before the use, so they DO count.
# ritz-task-169.
fn struct_deps_satisfied(s: *EmitterState, st: *StructDef) -> i32
    var field: *StructField = st.fields
    while field != null
        if field.field_type == TYPE_STRUCT
            if field.field_type_name != null
                if field.field_type_name_len > 0
                    if was_struct_emitted(s, field.field_type_name, field.field_type_name_len) == 0
                        return 0
        else if field.field_type == TYPE_ARRAY
            if field.array_elem_type == TYPE_STRUCT
                if field.array_elem_type_name != null
                    if field.array_elem_type_name_len > 0
                        if was_struct_emitted(s, field.array_elem_type_name, field.array_elem_type_name_len) == 0
                            return 0
        field = field.next
    1

# Emit a single `%Name = type { ... }` definition and mark it emitted.
fn emit_one_struct_type(s: *EmitterState, st: *StructDef)
    mark_struct_emitted(s, st.name, st.name_len)
    emit_str(s, c"%")
    emit_name(s, st.name, st.name_len)
    emit_str(s, c" = type {")
    var first: i32 = 1
    var field: *StructField = st.fields
    while field != null
        if first == 0
            emit_str(s, c", ")
        first = 0
        emit_field_llvm_type(s, field)
        field = field.next
    emit_str(s, c"}\n")

fn emit_struct_types(s: *EmitterState)
    # Topologically sort struct emission by value-field containment so that
    # `alloca %T` and `getelementptr %T, ...` never see an opaque %T.
    # Source-order emission was breaking when an earlier-listed struct
    # embedded a later-listed one (e.g. `struct PageStore { index:
    # [100]IndexEntry, ... }` parsed before its imported deps Db/Cache, or
    # `struct TomeServer { task_server: TaskServer, ... }` parsed before
    # ritzlib's TaskServer).  ritz-task-169.
    #
    # Pass 1..N: emit any unemitted struct whose value-field deps are all
    # already emitted; loop until a pass makes no progress.
    var made_progress: i32 = 1
    while made_progress == 1
        made_progress = 0
        var st: *StructDef = s.module.structs
        while st != null
            if st.type_params != null
                st = st.next
                continue
            if was_struct_emitted(s, st.name, st.name_len) == 1
                st = st.next
                continue
            if struct_deps_satisfied(s, st) == 0
                st = st.next
                continue
            emit_one_struct_type(s, st)
            made_progress = 1
            st = st.next

    # Final pass: emit anything still pending in source order.  This catches
    # structs whose declared deps aren't in s.module.structs (unresolved
    # imports, name typos, etc.) — we'd already have produced broken IR for
    # those in the legacy path, so falling back here is no regression.
    var st2: *StructDef = s.module.structs
    while st2 != null
        if st2.type_params != null
            st2 = st2.next
            continue
        if was_struct_emitted(s, st2.name, st2.name_len) == 1
            st2 = st2.next
            continue
        emit_one_struct_type(s, st2)
        st2 = st2.next

    emit_str(s, c"\n")

# Emit one `%Result$... = type { i8, [N x i8] }` decl (dedup via
# emitted_structs) for the tagged-enum name at (name, len).  No-op when
# name doesn't look like Result$/Option$, which lets callers funnel every
# type name they see through here unconditionally.  ritz-task-133.
fn emit_tagged_enum_decl_once(s: *EmitterState, name: *u8, len: i32)
    if name == null or len == 0
        return
    if is_tagged_enum_type(name, len) == 0
        return
    # Skip template-shaped names like `Option$T` / `Result$E` — these are
    # the raw generic placeholders that leak in from function signatures
    # declared against an unspecialized type parameter.  Concrete
    # instantiations (Option$i32, Option$Vec_u8) are what we want to emit.
    # Also skip empty suffix (`Option$`) which happens for u-types whose
    # mangling table doesn't know the suffix letter — those still work
    # because they share a single struct layout, but we only want one
    # emission regardless.  A "template" suffix is a single ASCII upper
    # letter A..Z immediately after `$`; any multi-char or lowercase
    # suffix (i32/u8/Vec_u8/...) is concrete.
    let suffix_start: i32 = 7
    if len - suffix_start == 1
        let ch: i32 = *(name + suffix_start) as i32
        if ch >= 65 and ch <= 90
            return
    if was_struct_emitted(s, name, len) == 1
        return
    mark_struct_emitted(s, name, len)
    emit_str(s, c"%")
    emit_name(s, name, len)
    emit_str(s, c" = type { i8, [")
    emit_int(s, TAGGED_ENUM_PAYLOAD_BYTES as i64)
    emit_str(s, c" x i8] }\n")

# Walk every fn / param / var-decl type name in the module and emit a
# tagged-enum struct decl for each unique Result$/Option$ instantiation.
# Must run AFTER emit_struct_types so user-declared types get dibs on the
# emitted-names table; before any IR that references `%Result$...`.
fn emit_tagged_enum_types(s: *EmitterState)
    var f: *FnDef = s.module.functions
    while f != null
        # AGAST #186: scan TYPE_PTR/TYPE_REF/TYPE_MUT_REF too so monomorph-
        # produced fns like `option_is_none$ptr_Page(opt: *Option$ptr_Page)`
        # get their `%Option$ptr_Page` decl emitted.  Original code only
        # looked at TYPE_STRUCT params/returns and missed pointer-to-enum.
        if f.return_type == TYPE_STRUCT or f.return_type == TYPE_PTR or f.return_type == TYPE_REF or f.return_type == TYPE_MUT_REF
            emit_tagged_enum_decl_once(s, f.return_type_name, f.return_type_name_len)
        var p: *Param = f.params
        while p != null
            if p.param_type == TYPE_STRUCT or p.param_type == TYPE_PTR or p.param_type == TYPE_REF or p.param_type == TYPE_MUT_REF
                emit_tagged_enum_decl_once(s, p.param_type_name, p.param_type_name_len)
            p = p.next
        # Walk body for let-bindings with explicit enum types
        emit_tagged_enum_scan_stmts(s, f.body)
        f = f.next

    # Impl-block methods carry the same shape (generic dispatch is lowered
    # to FnDefs elsewhere — this is defensive).
    var ib: *ImplBlock = s.module.impls
    while ib != null
        var meth: *FnDef = ib.methods
        while meth != null
            if meth.return_type == TYPE_STRUCT or meth.return_type == TYPE_PTR or meth.return_type == TYPE_REF or meth.return_type == TYPE_MUT_REF
                emit_tagged_enum_decl_once(s, meth.return_type_name, meth.return_type_name_len)
            var mp: *Param = meth.params
            while mp != null
                if mp.param_type == TYPE_STRUCT or mp.param_type == TYPE_PTR or mp.param_type == TYPE_REF or mp.param_type == TYPE_MUT_REF
                    emit_tagged_enum_decl_once(s, mp.param_type_name, mp.param_type_name_len)
                mp = mp.next
            emit_tagged_enum_scan_stmts(s, meth.body)
            meth = meth.next
        ib = ib.next

    emit_str(s, c"\n")

fn emit_tagged_enum_scan_stmts(s: *EmitterState, body: *Stmt)
    var st: *Stmt = body
    while st != null
        if st.kind == STMT_VAR_DECL
            # AGAST #186: scan pointer-typed locals too — `var p: *Option<*Page>`
            # carries the mangled enum name in var_type_name even though
            # var_type is TYPE_PTR.
            if st.var_type == TYPE_STRUCT or st.var_type == TYPE_PTR or st.var_type == TYPE_REF or st.var_type == TYPE_MUT_REF
                emit_tagged_enum_decl_once(s, st.var_type_name, st.var_type_name_len)
        else if st.kind == STMT_IF
            emit_tagged_enum_scan_stmts(s, st.if_then)
            if st.if_else != null
                emit_tagged_enum_scan_stmts(s, st.if_else)
        else if st.kind == STMT_WHILE
            emit_tagged_enum_scan_stmts(s, st.while_body)
        else if st.kind == STMT_FOR
            emit_tagged_enum_scan_stmts(s, st.for_body)
        else if st.kind == STMT_LOOP
            emit_tagged_enum_scan_stmts(s, st.while_body)
        st = st.next

# Unit-variant enum fallback (ritz0 parity — test_issue_qualified_enum_variant).
#
# ritz1's parser currently swallows `enum Name ... variants` declarations
# without persisting them to the AST (see parser_gen.ritz parse_enum_def).
# But the type name can still be referenced by function signatures
# (`fn f(s: Shade) -> bool`) and emitted as `%Shade` in IR.  Without a
# matching type declaration, LLVM rejects the IR with "Cannot allocate
# unsized type".  We plug the gap by walking every struct-typed reference
# in the module, and emitting `%Name = type { i8 }` for any name that
# nothing else has claimed — matching the single-tag layout ritz0 uses
# for C-style enums.  User structs and Result$/Option$ tagged enums are
# already marked in `emitted_structs` by prior passes, so we skip those.
fn emit_enum_fallback_decl(s: *EmitterState, name: *u8, len: i32)
    if name == null or len == 0
        return
    if is_tagged_enum_type(name, len) == 1
        return
    if is_primitive_type_name(name, len) == 1
        return
    # AGAST #167: SIMD vector type names lower to `<N x iM>` directly — they
    # never need (and must not get) a `%v4i32 = type { i8 }` named-struct
    # decl which would pin the LLVM type to a bogus `{ i8 }` layout.
    if is_simd_vector_type_name(name, len) == 1
        return
    if was_struct_emitted(s, name, len) == 1
        return
    # Skip generic instantiations (`Vec$String`, `Span$u8`, `Pair$i32`, ...).
    # The `$` separator is reserved for monomorph mangling — a name with `$`
    # is *always* a generic instantiation, never a user-declared C-style enum.
    # Without this filter we'd emit `%Vec$String = type { i8 }` and clobber
    # the real Vec$T layout that emit_struct_types instantiates lazily.
    var i: i32 = 0
    while i < len
        if *(name + i) == '$'
            return
        i = i + 1
    mark_struct_emitted(s, name, len)
    emit_str(s, c"%")
    emit_name(s, name, len)
    emit_str(s, c" = type { i8 }\n")

fn emit_enum_fallback_scan_stmts(s: *EmitterState, body: *Stmt)
    var st: *Stmt = body
    while st != null
        if st.kind == STMT_VAR_DECL
            if st.var_type == TYPE_STRUCT
                emit_enum_fallback_decl(s, st.var_type_name, st.var_type_name_len)
        else if st.kind == STMT_IF
            emit_enum_fallback_scan_stmts(s, st.if_then)
            if st.if_else != null
                emit_enum_fallback_scan_stmts(s, st.if_else)
        else if st.kind == STMT_WHILE
            emit_enum_fallback_scan_stmts(s, st.while_body)
        else if st.kind == STMT_FOR
            emit_enum_fallback_scan_stmts(s, st.for_body)
        else if st.kind == STMT_LOOP
            emit_enum_fallback_scan_stmts(s, st.while_body)
        st = st.next

fn emit_enum_fallback_types(s: *EmitterState)
    # Function signatures.
    var f: *FnDef = s.module.functions
    while f != null
        if f.return_type == TYPE_STRUCT
            emit_enum_fallback_decl(s, f.return_type_name, f.return_type_name_len)
        var p: *Param = f.params
        while p != null
            if p.param_type == TYPE_STRUCT
                emit_enum_fallback_decl(s, p.param_type_name, p.param_type_name_len)
            p = p.next
        emit_enum_fallback_scan_stmts(s, f.body)
        f = f.next

    # Impl methods.
    var ib: *ImplBlock = s.module.impls
    while ib != null
        var meth: *FnDef = ib.methods
        while meth != null
            if meth.return_type == TYPE_STRUCT
                emit_enum_fallback_decl(s, meth.return_type_name, meth.return_type_name_len)
            var mp: *Param = meth.params
            while mp != null
                if mp.param_type == TYPE_STRUCT
                    emit_enum_fallback_decl(s, mp.param_type_name, mp.param_type_name_len)
                mp = mp.next
            emit_enum_fallback_scan_stmts(s, meth.body)
            meth = meth.next
        ib = ib.next

    # Global variable types.
    var g: *GlobalVarDef = s.module.globals
    while g != null
        if g.var_type == TYPE_STRUCT
            emit_enum_fallback_decl(s, g.type_name, g.type_name_len)
        g = g.next

    emit_str(s, c"\n")

# =============================================================================
# Global initializers (AGAST #1501)
# =============================================================================
# `var g: i32 = 5` used to be emitted as `i32 zeroinitializer` — init_expr was
# parsed and never read, so every global started at 0 with no diagnostic
# (zeus's `var g_running: i32 = 1` quit its event loop at once).
#
# An initializer is folded to one of the GINIT_* shapes below and written in
# the global's EXISTING storage type (narrow ints, bool and floats keep their
# i64 slot; widening that storage is a separate change).  Anything that does
# not fold gets a located error instead of a silent zero.

const GINIT_BAD: i32 = 0     # not a constant ritz1 can lower
const GINIT_INT: i32 = 1     # integer/bool/char value in int_val
const GINIT_FLOAT: i32 = 2   # float literal text in text/text_len, sign in neg
const GINIT_NULL: i32 = 3    # null / nil

struct GlobalInit
    kind: i32
    int_val: i64
    text: *u8
    text_len: i32
    neg: i32

# Fold a global initializer: literals, unary - ~ ! of a literal, null, and
# `as` casts of any of those.  The cast target is not consulted: the value is
# written in the global's own storage type, as ritz0 does.
fn global_init_fold(e: *Expr, out: *GlobalInit)
    out.kind = GINIT_BAD
    if e == null
        return
    if e.kind == EXPR_INT_LIT or e.kind == EXPR_CHAR_LIT
        out.kind = GINIT_INT
        out.int_val = e.int_val
        return
    if e.kind == EXPR_FLOAT_LIT
        out.kind = GINIT_FLOAT
        out.text = e.string_ptr
        out.text_len = e.string_len
        out.neg = 0
        return
    if e.kind == EXPR_NIL_LIT
        out.kind = GINIT_NULL
        return
    if e.kind == EXPR_CAST
        global_init_fold(e.left, out)
        return
    if e.kind == EXPR_UNARY
        global_init_fold(e.operand, out)
        if e.op == OP_NEG
            if out.kind == GINIT_INT
                out.int_val = 0 - out.int_val
                return
            if out.kind == GINIT_FLOAT
                out.neg = 1 - out.neg
                return
        else if e.op == OP_BIT_NOT and out.kind == GINIT_INT
            out.int_val = 0 - out.int_val - 1
            return
        else if e.op == OP_NOT and out.kind == GINIT_INT
            if out.int_val == 0
                out.int_val = 1
            else
                out.int_val = 0
            return
        out.kind = GINIT_BAD
        return

# 1 if a float literal's text is +0.0 (FLOAT is /[0-9]+\.[0-9]+/: no exponent).
fn global_init_float_is_pos_zero(gi: *GlobalInit) -> i32
    if gi.neg != 0
        return 0
    var i: i32 = 0
    while i < gi.text_len
        let c: u8 = *(gi.text + i)
        if c != 48 and c != 46   # '0' '.'
            return 0
        i += 1
    1

# "<file>:<line>:<col>: error: global '<name>' <why>" on stderr, an IR marker,
# and a counted error so main refuses to write the output.
fn global_init_error(s: *EmitterState, g: *GlobalVarDef, why: *u8)
    if g.src_file != null
        eprints_cstr(g.src_file)
    else
        eprints_cstr(c"<input>")
    eprint_char(':')
    eprint_i64(g.line as i64)
    eprint_char(':')
    eprint_i64(g.col as i64)
    eprints_cstr(c": error: global '")
    var i: i32 = 0
    while i < g.name_len
        eprint_char(*(g.name + i))
        i += 1
    eprints_cstr(c"' ")
    eprints_cstr(why)
    eprints_cstr(c"\n")
    emit_str(s, c"; ERROR: global initializer for @")
    emit_name(s, g.name, g.name_len)
    emit_str(s, c": ")
    emit_str(s, why)
    emit_str(s, c"\n")
    s.error_count = s.error_count + 1

# Write " <initializer>" for g, whose storage type has just been emitted.
fn emit_global_init(s: *EmitterState, g: *GlobalVarDef, gi: *GlobalInit)
    if gi.kind == GINIT_BAD
        emit_str(s, c" zeroinitializer")
        return
    # Storage `ptr`.
    if g.var_type == TYPE_PTR
        if gi.kind == GINIT_NULL or (gi.kind == GINIT_INT and gi.int_val == 0)
            emit_str(s, c" null")
        else
            emit_str(s, c" inttoptr (i64 ")
            emit_int(s, gi.int_val)
            emit_str(s, c" to ptr)")
        return
    # f64 lives in an i64 slot and is loaded as `double`: store its bits.
    if g.var_type == TYPE_F64
        emit_str(s, c" bitcast (double ")
        if gi.kind == GINIT_FLOAT
            if gi.neg != 0
                emit_str(s, c"-")
            emit_name(s, gi.text, gi.text_len)
        else
            emit_int(s, gi.int_val)
            emit_str(s, c".0")
        emit_str(s, c" to i64)")
        return
    # f32: only +0 reaches here (anything else was rejected up front).
    if g.var_type == TYPE_F32
        emit_str(s, c" zeroinitializer")
        return
    # Every other storage type is an LLVM integer.
    emit_str(s, c" ")
    if gi.kind == GINIT_NULL
        emit_int(s, 0)
    else
        emit_int(s, gi.int_val)

# Fold g.init_expr into gi, reporting a located error when it cannot be
# lowered.  An absent initializer leaves gi.kind == GINIT_BAD with no error,
# which emit_global_init writes as zeroinitializer.
fn global_init_check(s: *EmitterState, g: *GlobalVarDef, gi: *GlobalInit)
    gi.kind = GINIT_BAD
    if g.init_expr == null
        return
    if g.var_type == TYPE_STRUCT or g.var_type == TYPE_ARRAY
        global_init_error(s, g, c"has an aggregate initializer; ritz1 only lowers scalar constants")
        return
    global_init_fold(g.init_expr, gi)
    if gi.kind == GINIT_BAD
        global_init_error(s, g, c"has a non-constant initializer; ritz1 lowers only literals, unary -/~/! of one, null and casts of those")
        return
    let is_float: i32 = is_float_type(g.var_type, g.type_name, g.type_name_len)
    if gi.kind == GINIT_FLOAT and is_float == 0
        global_init_error(s, g, c"is not a float type but has a float initializer")
        gi.kind = GINIT_BAD
        return
    if gi.kind == GINIT_NULL and is_float == 1
        global_init_error(s, g, c"is a float type but has a null initializer")
        gi.kind = GINIT_BAD
        return
    if g.var_type == TYPE_F32
        var zero: i32 = 0
        if gi.kind == GINIT_INT and gi.int_val == 0
            zero = 1
        else if gi.kind == GINIT_FLOAT
            zero = global_init_float_is_pos_zero(gi)
        if zero == 0
            global_init_error(s, g, c"is f32 with a non-zero initializer, which ritz1 cannot lower yet")
            gi.kind = GINIT_BAD
        return

# Emit global variable declarations
fn emit_global_vars(s: *EmitterState)
    var g: *GlobalVarDef = s.module.globals
    while g != null
        # Skip already-emitted globals (deduplication for imports)
        if was_global_emitted(s, g.name, g.name_len) == 1
            g = g.next
            continue
        mark_global_emitted(s, g.name, g.name_len)
        # Fold (and diagnose) the initializer before the declaration line so
        # any IR error marker lands on its own line.
        var gi: GlobalInit
        global_init_check(s, g, @gi)
        emit_str(s, c"@")
        emit_name(s, g.name, g.name_len)
        # weak_odr: merge duplicates across modules (same as functions)
        emit_str(s, c" = weak_odr global ")
        # Emit the type
        if g.var_type == TYPE_STRUCT
            emit_str(s, c"%")
            emit_name(s, g.type_name, g.type_name_len)
        else if g.var_type == TYPE_I32 or g.var_type == TYPE_U32
            emit_str(s, c"i32")
        else if g.var_type == TYPE_I64 or g.var_type == TYPE_U64
            emit_str(s, c"i64")
        else if g.var_type == TYPE_PTR
            emit_str(s, c"ptr")
        else if g.var_type == TYPE_ARRAY
            # AGAST #190: `var g: [N]T` — emit `[N x T]` so indexing GEPs
            # use the right stride.  Without this branch the global fell
            # through to `i64 zeroinitializer` and `g_fallback[i].used`
            # in nexus tripped "; ERROR: unhandled EXPR_MEMBER" because
            # the emitter had no array-stride context to GEP through.
            emit_str(s, c"[")
            emit_int(s, g.array_size as i64)
            emit_str(s, c" x ")
            if g.array_elem_type == TYPE_I32 or g.array_elem_type == TYPE_U32
                emit_str(s, c"i32")
            else if g.array_elem_type == TYPE_I64 or g.array_elem_type == TYPE_U64
                emit_str(s, c"i64")
            else if g.array_elem_type == TYPE_U8 or g.array_elem_type == TYPE_I8
                emit_str(s, c"i8")
            else if g.array_elem_type == TYPE_U16 or g.array_elem_type == TYPE_I16
                emit_str(s, c"i16")
            else if g.array_elem_type == TYPE_PTR or g.array_elem_type == TYPE_PTR_PTR
                emit_str(s, c"ptr")
            else if g.array_elem_type == TYPE_STRUCT and g.array_elem_type_name_len > 0
                emit_llvm_type_struct(s, TYPE_STRUCT, g.array_elem_type_name, g.array_elem_type_name_len)
            else
                emit_str(s, c"i64")
            emit_str(s, c"]")
        else
            emit_str(s, c"i64")
        emit_global_init(s, g, @gi)
        emit_str(s, c"\n")
        g = g.next
    emit_str(s, c"\n")

# =============================================================================
# Const Arrays of Struct Literals (ritz0 parity — B1 wave-1)
# =============================================================================
# Lowers declarations like:
#
#   const PAIRS: [2]Pair = [
#       Pair { a: "x", b: "y" },
#       Pair { a: "m", b: "n" }
#   ]
#
# to an immutable LLVM global constant:
#
#   @.const.PAIRS.0.a = private constant [2 x i8] c"x\00"
#   @.const.PAIRS.0.b = private constant [2 x i8] c"y\00"
#   @.const.PAIRS.1.a = private constant [2 x i8] c"m\00"
#   @.const.PAIRS.1.b = private constant [2 x i8] c"n\00"
#   @PAIRS = internal constant [2 x %Pair] [ ... ]
#
# Only handles the shape needed by the current regression test: arrays whose
# element type is a named struct, whose StructLit elements have
# int / bool / char / StringLit-typed fields. Non-StrView struct-typed
# fields inside the struct literal are not supported yet (would require
# nested recursion); integer consts still take the old fast path via
# find_const and do not need an LLVM global.

# Find a FieldInit in a struct literal's FieldInit list by field name.
# Note: parse_struct_lit returns the *FieldInit linked list directly,
# and EXPR_STRUCT_LIT stores the list head in `e.args` (see ident_or_struct).
# We iterate the list directly — there is no boxed StructLit struct.
fn find_field_init(fields: *FieldInit, name: *u8, len: i32) -> *FieldInit
    var fi: *FieldInit = fields
    while fi != null
        if fi.name_len == len
            var j: i32 = 0
            var matched: i32 = 1
            while j < len
                if *(fi.name + j) != *(name + j)
                    matched = 0
                    break
                j += 1
            if matched == 1
                return fi
        fi = fi.next
    return null

# Emit a backing `@.const.NAME.ELEM.FIELD` string global for StrView fields
# inside a const struct-array element.
fn emit_const_array_string(s: *EmitterState, c: *ConstEntry, elem_idx: i32, fi: *FieldInit)
    emit_str(s, c"@.const.")
    emit_name(s, c.name, c.name_len)
    emit_str(s, c".")
    emit_int(s, elem_idx as i64)
    emit_str(s, c".")
    emit_name(s, fi.name, fi.name_len)
    emit_str(s, c" = private constant [")
    let strlen: i32 = fi.value.string_len
    emit_int(s, (strlen + 1) as i64)
    emit_str(s, c" x i8] c\"")
    for j in 0..strlen
        emit_string_byte(s, *(fi.value.string_ptr + j))
    emit_str(s, c"\\00\"\n")

# Emit one struct-literal element inside the top-level array constant.
# Walks the struct definition in field order (canonical) and emits each
# field's value using `emit_const_field_value`.
fn emit_const_struct_literal(s: *EmitterState, c: *ConstEntry, elem_idx: i32, st: *StructDef, elem: *Expr)
    emit_str(s, c"%")
    emit_name(s, c.array_elem_type_name, c.array_elem_type_name_len)
    emit_str(s, c" { ")
    let fields: *FieldInit = elem.args as *FieldInit
    var field: *StructField = st.fields
    var first: i32 = 1
    while field != null
        if first == 0
            emit_str(s, c", ")
        first = 0
        let fi: *FieldInit = find_field_init(fields, field.name, field.name_len)
        emit_const_field_value(s, c, elem_idx, field, fi)
        field = field.next
    emit_str(s, c" }")

# Emit one field's value as an LLVM typed-constant operand.
# StrView-shaped struct field + StringLit value → %StrView { ptr @str, i64 len }.
# Scalar (i8/i16/i32/i64) → `<type> <int>` using FieldInit value's int_val.
# For anything we don't recognise, fall back to zeroinitializer so the
# overall global still assembles — matches ritz0's "best-effort lowering"
# behaviour on mixed-shape const arrays.
fn emit_const_field_value(s: *EmitterState, c: *ConstEntry, elem_idx: i32, field: *StructField, fi: *FieldInit)
    if fi == null
        # Missing field init — shouldn't happen for well-formed source.
        emit_field_llvm_type(s, field)
        emit_str(s, c" zeroinitializer")
        return
    let v: *Expr = fi.value
    if field.field_type == TYPE_STRUCT and v != null and v.kind == EXPR_STRING_LIT
        # Treat target struct as StrView-shaped: { ptr, i64 len }.
        emit_str(s, c"%")
        emit_name(s, field.field_type_name, field.field_type_name_len)
        emit_str(s, c" { ptr @.const.")
        emit_name(s, c.name, c.name_len)
        emit_str(s, c".")
        emit_int(s, elem_idx as i64)
        emit_str(s, c".")
        emit_name(s, fi.name, fi.name_len)
        emit_str(s, c", i64 ")
        emit_int(s, v.string_len as i64)
        emit_str(s, c" }")
        return
    # Scalar / integer path — emit typed integer literal.
    emit_llvm_type(s, field.field_type)
    emit_str(s, c" ")
    if v != null
        emit_int(s, v.int_val)
    else
        emit_int(s, 0)

# Emit a single ConstEntry as an LLVM global constant (if applicable).
fn emit_const_array_entry(s: *EmitterState, c: *ConstEntry)
    if c.const_type != TYPE_ARRAY
        return
    if c.value_expr == null
        return
    if c.value_expr.kind != EXPR_ARRAY_LIT
        return
    # Primitive-element arrays — `const VALUES: [3]i32 = [2, 3, 5]`.
    # Required so `for v in VALUES` (iterable form) can reference the
    # global by name.  Integer consts of non-array shape stay inlined
    # via find_const; this path is purely for the [N]T iterable case.
    if c.array_elem_type != TYPE_STRUCT
        if was_global_emitted(s, c.name, c.name_len) == 1
            return
        mark_global_emitted(s, c.name, c.name_len)
        emit_str(s, c"@")
        emit_name(s, c.name, c.name_len)
        emit_str(s, c" = internal constant [")
        emit_int(s, c.array_size as i64)
        emit_str(s, c" x ")
        emit_llvm_type(s, c.array_elem_type)
        emit_str(s, c"] [")
        var pe: *Expr = c.value_expr.args
        var pi: i32 = 0
        while pe != null
            if pi > 0
                emit_str(s, c", ")
            emit_llvm_type(s, c.array_elem_type)
            emit_str(s, c" ")
            emit_int(s, pe.int_val)
            pi = pi + 1
            pe = pe.next
        emit_str(s, c"]\n")
        return
    if c.value_expr == null
        return
    if c.value_expr.kind != EXPR_ARRAY_LIT
        return
    # Dedup across imports (same const may be reached from multiple paths)
    if was_global_emitted(s, c.name, c.name_len) == 1
        return
    mark_global_emitted(s, c.name, c.name_len)
    # Need the struct def to emit fields in canonical order.
    let st: *StructDef = find_struct(s, c.array_elem_type_name, c.array_elem_type_name_len)
    if st == null
        return

    # Pass 1: emit the backing string globals referenced by StrView fields.
    var elem: *Expr = c.value_expr.args
    var elem_idx: i32 = 0
    while elem != null
        if elem.kind == EXPR_STRUCT_LIT
            var fi: *FieldInit = elem.args as *FieldInit
            while fi != null
                if fi.value != null and fi.value.kind == EXPR_STRING_LIT
                    emit_const_array_string(s, c, elem_idx, fi)
                fi = fi.next
        elem_idx = elem_idx + 1
        elem = elem.next

    # Pass 2: emit the top-level [N x %Struct] constant.
    emit_str(s, c"@")
    emit_name(s, c.name, c.name_len)
    emit_str(s, c" = internal constant [")
    emit_int(s, c.array_size as i64)
    emit_str(s, c" x %")
    emit_name(s, c.array_elem_type_name, c.array_elem_type_name_len)
    emit_str(s, c"] [")

    elem = c.value_expr.args
    elem_idx = 0
    while elem != null
        if elem_idx > 0
            emit_str(s, c", ")
        if elem.kind == EXPR_STRUCT_LIT
            emit_const_struct_literal(s, c, elem_idx, st, elem)
        else
            # Unexpected non-struct element in a struct-array; emit zero.
            emit_str(s, c"%")
            emit_name(s, c.array_elem_type_name, c.array_elem_type_name_len)
            emit_str(s, c" zeroinitializer")
        elem_idx = elem_idx + 1
        elem = elem.next

    emit_str(s, c"]\n")

# =============================================================================
# AGAST #189 — Scalar struct consts (`const FOO: StrView = "..."`)
# =============================================================================
# Lowers a top-level
#
#   const NAME: StrView = "/data.m7m"
#
# to an immutable global aggregate whose layout matches the struct shape:
#
#   @.const.NAME = private constant [10 x i8] c"/data.m7m\00"
#   @NAME = internal constant %StrView { ptr @.const.NAME, i64 9 }
#
# Use sites then load the aggregate via `load %StrView, ptr @NAME`, which
# produces a `%StrView` value that flows naturally into call args typed
# `s: StrView` (the mausoleum/storage `build_path` failure).  Without this,
# the const-ident path emitted `add i64 0, 0` and the verifier rejected the
# i64-vs-%StrView mismatch at the call site.
#
# Currently restricted to the StrView shape `{ ptr, i64 }` driven by an
# EXPR_STRING_LIT initializer — that's the only scalar-struct-const shape
# observed in the codebase (mausoleum/storage.ritz, lexis/dom/attribute.ritz,
# prism/test/test_text_rendering.ritz).  Other struct shapes fall through
# to the legacy `add i64 0, 0` path, matching previous behaviour.
fn emit_const_struct_entry(s: *EmitterState, c: *ConstEntry)
    if c.const_type != TYPE_STRUCT
        return
    if c.type_name == null
        return
    if c.type_name_len <= 0
        return
    if c.value_expr == null
        return
    if c.value_expr.kind != EXPR_STRING_LIT
        return
    # Dedup across imports — same const may be reached via multiple paths.
    if was_global_emitted(s, c.name, c.name_len) == 1
        return
    mark_global_emitted(s, c.name, c.name_len)

    let strlen: i32 = c.value_expr.string_len

    # Backing string global (private — only the @NAME global references it).
    emit_str(s, c"@.const.")
    emit_name(s, c.name, c.name_len)
    emit_str(s, c" = private constant [")
    emit_int(s, (strlen + 1) as i64)
    emit_str(s, c" x i8] c\"")
    for j in 0..strlen
        emit_string_byte(s, *(c.value_expr.string_ptr + j))
    emit_str(s, c"\\00\"\n")

    # Top-level `%StructTy { ptr @.const.NAME, i64 N }` constant.
    # Treats the target struct as `{ ptr, i64 }`-shaped (StrView / Span$u8).
    emit_str(s, c"@")
    emit_name(s, c.name, c.name_len)
    emit_str(s, c" = internal constant %")
    emit_name(s, c.type_name, c.type_name_len)
    emit_str(s, c" { ptr @.const.")
    emit_name(s, c.name, c.name_len)
    emit_str(s, c", i64 ")
    emit_int(s, strlen as i64)
    emit_str(s, c" }\n")

# Walk module constants and emit LLVM globals for const arrays of structs.
fn emit_const_arrays(s: *EmitterState)
    var c: *ConstEntry = s.module.constants
    while c != null
        emit_const_array_entry(s, c)
        # AGAST #189 — also lower scalar struct consts (`const FOO: StrView
        # = "..."`).  Distinct from the array path: const_type is
        # TYPE_STRUCT here, not TYPE_ARRAY.
        emit_const_struct_entry(s, c)
        c = c.next
    emit_str(s, c"\n")

# =============================================================================
# The string-literal type
# =============================================================================
# Struct layouts come from source: the module's own structs, imported ones,
# and monomorphised instantiations of generic ones (`Vec$u8` from
# `struct Vec<T>`).  ritz1 used to carry hard-coded copies of ~20 of them
# (NFA, Transition, ArgParser, String, LineBounds, Vec$*, ...) which were
# installed ahead of the source and shadowed it, so every edit to one of
# those structs needed a matching hand-edit here, and any user program that
# named a struct `Transition` got ritz1's layout instead of its own.  The
# copies are gone (AGAST #1440).
#
# The one exception is `Span$u8`: a bare `"..."` literal lowers to a
# `%Span$u8` aggregate (AGAST #98), so the type is needed even by a program
# that imports nothing.  It is supplied only when the source does not define
# it, and through the same StructDef path as every other struct.  When the
# source DOES define it (an imported `Span<T>` instantiated at u8), the
# source wins — and because the literal lowering hard-codes `{ ptr, i64 }`,
# a source layout that differs is an error, not a silent shadow.

fn string_literal_field(name: *u8, len: i32, ty: i32) -> *StructField
    let f: *StructField = malloc(64) as *StructField   # sizeof(StructField)
    f.name = name
    f.name_len = len
    f.field_type = ty
    f.field_type_name = null
    f.field_type_name_len = 0
    f.array_size = 0
    f.array_elem_type = 0
    f.array_elem_type_name = null
    f.array_elem_type_name_len = 0
    f.next = null
    f

fn find_module_struct(m: *Module, name: *u8, len: i32) -> *StructDef
    var st: *StructDef = m.structs
    while st != null
        if st.type_params == null
            if name_eq(st.name, st.name_len, name, len) == 1
                return st
        st = st.next
    null

# Returns 1 if `st` has exactly the `{ ptr, i64 }` shape string literals are
# lowered to.
fn is_string_literal_layout(st: *StructDef) -> i32
    let f1: *StructField = st.fields
    if f1 == null
        return 0
    if f1.field_type != TYPE_PTR
        return 0
    let f2: *StructField = f1.next
    if f2 == null
        return 0
    if f2.field_type != TYPE_I64
        return 0
    if f2.next != null
        return 0
    1

fn ensure_string_literal_struct(s: *EmitterState, m: *Module)
    let existing: *StructDef = find_module_struct(m, c"Span$u8", 7)
    if existing != null
        if is_string_literal_layout(existing) == 0
            emit_ir_error(s, c"struct Span$u8 must be { ptr: *u8, len: i64 }: string literals are lowered to that layout")
        return
    # Span$u8 = { ptr: *u8, len: i64 } — the monomorph of ritzlib's
    # `struct Span<T> { ptr: *T, len: i64 }` at T = u8.
    let f1: *StructField = string_literal_field(c"ptr", 3, TYPE_PTR)
    f1.array_elem_type = TYPE_U8   # pointee, for `span.ptr + i` stride
    f1.next = string_literal_field(c"len", 3, TYPE_I64)
    let st: *StructDef = malloc(40) as *StructDef   # sizeof(StructDef)
    st.name = c"Span$u8"
    st.name_len = 7
    st.fields = f1
    st.type_params = null
    # Appended, not prepended: nothing it could shadow exists (checked above).
    st.next = null
    if m.structs == null
        m.structs = st
        return
    var last: *StructDef = m.structs
    while last.next != null
        last = last.next
    last.next = st

fn emit_module(m: *Module, out: *Vec<u8>) -> i32
    var s: EmitterState
    s.out = out
    s.reg_counter = 1
    s.label_counter = 0
    s.local_count = 0
    s.break_label = -1
    s.continue_label = -1
    s.module = m
    s.string_count = 0
    s.extern_count = 0
    s.emitted_struct_count = 0
    s.emitted_fn_count = 0
    s.emitted_global_count = 0
    s.ctx_enum_name = null
    s.ctx_enum_name_len = 0
    s.ctx_simd_name = null
    s.ctx_simd_name_len = 0
    s.error_count = 0   # AGAST #1369 — see emit_ir_error / the return below
    # Before build_symbol_maps, so find_struct sees the fallback if added.
    ensure_string_literal_struct(@s, m)
    # ritz-task-193 — allocate the five symbol-table HashMaps before any
    # add_local / find_* call.  build_symbol_maps then snapshots the
    # post-monomorph module-level lists so find_global / find_fn /
    # find_struct / find_const_entry are O(1) for the rest of emit_module.
    init_emitter_maps(@s)
    build_symbol_maps(@s)

    emit_str(@s, c"; ModuleID = 'ritz1_output'\n")
    emit_str(@s, c"target triple = \"x86_64-unknown-linux-gnu\"\n\n")

    # Emit struct type definitions from source
    emit_struct_types(@s)

    # Emit tagged-enum struct type decls for every Result$/Option$
    # instantiation referenced in the module.  ritz-task-133 replaces the
    # old i64-pack fast-path with a real `{ i8, [N x i8] }` struct so the
    # IR matches ritz0.
    emit_tagged_enum_types(@s)

    # Emit fallback `%Name = type { i8 }` decls for any remaining
    # referenced struct-typed name the parser skipped (C-style unit
    # enums — parse_enum_def currently consumes without persisting to
    # the AST).  Must run AFTER emit_struct_types + emit_tagged_enum_types
    # so real structs and Result$/Option$ instantiations keep priority
    # in the emitted_structs dedup table.
    emit_enum_fallback_types(@s)

    # Emit global variable declarations
    emit_global_vars(@s)

    # Emit const arrays of struct literals as LLVM globals (B1 parity).
    # Integer consts remain inlined via find_const; only complex shapes
    # (array-of-struct) need a real global.
    emit_const_arrays(@s)

    # First pass: emit all functions (to collect externs)
    # Deduplicate: same function may appear multiple times from imports
    var f: *FnDef = m.functions
    var total_fns: i32 = 0
    var skipped_generic: i32 = 0
    var skipped_dup: i32 = 0
    var emitted_count: i32 = 0

    while f != null
        total_fns = total_fns + 1
        # Skip generic function templates - they need monomorphization
        # Only concrete instantiations (no type_params) should be emitted
        if f.type_params != null
            skipped_generic = skipped_generic + 1
            f = f.next
            continue
        # AGAST #196: skip imported fns up-front so they don't poison the
        # was_fn_emitted dedup table. emit_fn would early-return on these
        # anyway (is_local==0 path), but the loop's mark_fn_emitted
        # below was firing FIRST — then the matching is_local==1 copy
        # parsed from THIS file (added later by main()) hit the dedup
        # check and was silently skipped, leaving cross-module callers
        # with unresolved symbols at link time. Skipping here means the
        # local copy reaches mark_fn_emitted/emit_fn cleanly.
        # body==null externs are also skipped so they don't pollute
        # dedup either; emit_extern_declarations handles them via the
        # add_extern call sites.
        if f.is_local == 0
            f = f.next
            continue
        # Skip syscall functions — ritz1 can't emit their asm bodies,
        # we emit our own inline implementations at the end.
        # Also skip functions with unsafe/asm blocks that ritz1 can't emit.
        if f.name_len == 8 and f.name != null
            let c0: i32 = *(f.name + 0)
            let c1: i32 = *(f.name + 1)
            if c0 == 115 and c1 == 121  # "sy" prefix
                let c2: i32 = *(f.name + 2)
                let c3: i32 = *(f.name + 3)
                if c2 == 115 and c3 == 99  # "sc" continuation
                    f = f.next
                    continue
        # Skip already-emitted functions (deduplication for imports)
        if was_fn_emitted(@s, f.name, f.name_len) == 1
            skipped_dup = skipped_dup + 1
            f = f.next
            continue
        mark_fn_emitted(@s, f.name, f.name_len)
        emit_fn(@s, f)
        emitted_count = emitted_count + 1
        f = f.next

    # Register syscall functions as externs — ritz1 can't emit their inline asm bodies,
    # so they need to be handled by emit_extern_declarations (which provides our own inline implementations)
    var sys_fn: *FnDef = m.functions
    while sys_fn != null
        if is_syscall_function(sys_fn.name, sys_fn.name_len) == 1
            add_extern(@s, sys_fn.name, sys_fn.name_len)
        sys_fn = sys_fn.next

    # Emit impl block methods with mangled names (Type_method).
    # Skip generic impl blocks: their methods are templates that
    # reference the type parameter T directly (e.g.
    # `fn len(self: *Span<T>) -> i64`).  Emitting them here would
    # produce IR like `define %T @Span_get(...)` where `%T` is not
    # a defined LLVM type.  Concrete specialisations are emitted
    # via specialize_impl_methods in monomorph.ritz.
    var ib: *ImplBlock = m.impls
    while ib != null
        if ib.type_params == null
            var method: *FnDef = ib.methods
            while method != null
                emit_impl_method(@s, ib, method)
                method = method.next
        ib = ib.next

    emit_str(@s, c"\n")
    emit_string_constants(@s)

    # Emit extern declarations after collecting them from function bodies.
    # This will also emit syscall implementations if any syscalls are used.
    emit_extern_declarations(@s)

    # Always declare llvm.memset.p0.i64 — emit_var_decl uses it as the
    # zero-fill fast path for `[0; N]` array-fill literals (AGAST #178).
    # Re-emitting is harmless if the IR already references it via another
    # path; LLVM treats duplicate `declare`s with matching signatures as
    # the same intrinsic.  An always-emit declare also costs nothing in
    # the link step when no fill is used because LLVM elides unreferenced
    # intrinsic decls.
    emit_str(@s, c"declare void @llvm.memset.p0.i64(ptr nocapture writeonly, i8, i64, i1 immarg)\n")

    # Note: _start is provided by runtime/ritz_crt0.o which properly sets up argc/argv

    # AGAST #1369 — number of expressions the emitter could not lower.  This
    # used to be a hardcoded 0, and the call site in main.ritz ignored it, so
    # there was no path by which an emit failure could reach the exit code.
    s.error_count
