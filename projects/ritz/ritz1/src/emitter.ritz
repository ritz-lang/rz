# ritz1/src/emitter.ritz - LLVM IR Emitter (orchestrator)
#
# emit_fn, emit_impl_method, and the top-level emit_module entrypoint.
# State / helpers / expressions / statements live in sibling modules:
#   emitter_core   — types, lookups, member-access GEP
#   emitter_expr   — emit_expr + emit_struct_lit_to_alloca
#   emitter_stmt   — emit_var_decl / emit_assign / emit_return / emit_stmt

import ritzlib.sys
import ritzlib.io
import ritzlib.str
import ritzlib.strview    # StrView (the type; #4462 moved the scanners out)
import ritzlib.option
import ritzlib.gvec
import ritzlib.string
import ritzlib.memory
import diag              # diag_error_at (AGAST #1866)
import text_bridge        # StrView views of the older *u8 text APIs (AGAST #4696)

import ast
import types           # the one primitive type table (AGAST #1889)
import ast_helpers   # is_enum_type (AGAST #1660)
import tokens_gen
import emitter_core
import emitter_abi   # AGAST #1818: sret / byval moved out of emitter_core
import emitter_types   # AGAST #1818: type inference moved out of emitter_core
import emitter_ir
import emitter_expr
import emitter_stmt
import emitter_print
import narrowing         # narrowing_begin_fn (AGAST #1364)
import ownership         # own_begin_fn / own_reset (AGAST #2158, #4529)
import ref_check         # ref_begin_fn (AGAST #2336)
import emitter_asm       # emit_naked_fn_body (AGAST #3395)
import frame_limit       # refuse_huge_frame (AGAST #3739)
import emitter_expr_access
import emitter_expr_arith   # const_struct_fill_refused (AGAST #3946), const_strview_fill (#3978)
import emitter_expr_call
import monomorph         # MonoCtx: emit_module's parameter (AGAST #4454)
import ritzlib.hashmap
pub import emitter_consts   # AGAST #1818: split out of this file
import emitter_call_lower   # AGAST #1818: split out below the emitter cycle
import emitter_stmt_parts   # AGAST #1818: split out below the emitter cycle

# AGAST #2565: an impl method's (non-sret) return type, as its `define` line
# and its implicit-tail `ret` both spell it.  A primitive can still reach here
# as a TypeKind.Struct name (`-> void`; usize/isize did until AGAST #2198 made
# them TypeKind.I64); emit_llvm_type_struct maps those names to their LLVM
# primitive, and a TypeKind.Struct that lost its name keeps emit_llvm_type's i64.
fn emit_method_ret_type(s: *EmitterState, method: *FnDef)
    if ret_array_of(method) != null
        emit_fn_ret_llvm_type(s, method)   # AGAST #2302: `[N x T]`
    else if method.return_type == TypeKind.Struct and method.return_type_name != null and method.return_type_name_len > 0
        emit_llvm_type_struct(s, method.return_type, StrView { ptr: (method.return_type_name), len: (method.return_type_name_len) as i64 })
    else
        format_into(s, "{llvm_text(ty_value_llvm(method.return_type))}")

# 1 if the method returns a real named struct (`define %T`), 0 for a scalar:
# its tail is a scalar register, not a struct to load and `ret %T`.
#
# AGAST #3561: no primitive reaches here as a TypeKind.Struct name any more, so
# #2565's is_primitive_type_name guard was dead and is gone.  type_named
# parses usize/isize/f32/f64 to their kinds (#2198), the other primitives are
# tokens, monomorph substitutes `-> T` through primitive_type_from_name, and
# an `impl` on a primitive (the only way `-> Self` names one) is refused.
fn method_returns_named_struct(method: *FnDef) -> bool
    method.return_type == TypeKind.Struct and method.return_type_name != null and method.return_type_name_len > 0

# AGAST #3147: a tail in a `-> S` method is a copy into the return slot, as
# `return e` is (#2996), so a whole struct element (`p[i]`, `(*r)[i]`) is
# loaded rather than refused.  emit_struct_copy's `ty` for that tail.
fn method_tail_copy_type(method: *FnDef) -> TypeKind
    if method_returns_named_struct(method)
        return TypeKind.Struct
    TypeKind.Void

# The span of a body's last statement: the value an implicit return returns.
fn body_tail_span(body: *Stmt) -> SrcSpan
    var last: *Stmt = body
    while last != null and last.next != null
        last = last.next
    if last == null
        return diag_span(0, 0)   # no body: no implicit return to report on
    last.span

# The implicit-return tail shared by emit_fn and emit_impl_method (AGAST #1573).
#
# Called after the body loop. `has_explicit_return` is 1 when the body's last
# top-level statement already emitted a `ret`: a trailing bare expression, or
# a `return`. Otherwise the final block is still open and needs a terminator.
# Before #1573 only emit_fn called this. emit_impl_method emitted nothing, so a
# non-void method ending in an `if`/loop/`let` closed the function on an
# unterminated block (`L2:` then `}`), which clang rejects.
#
# `tail` is the body's last statement (body_tail_span), where an error about
# the implicit return's value is reported (AGAST #3445).
fn emit_implicit_return_tail(s: *EmitterState, has_explicit_return: bool, ret_type: TypeKind, ret_type_name_sv: StrView, tail: SrcSpan)
    # A TypeKind.Struct return that lost its name is declared through emit_llvm_type
    # (emit_impl_method's header does this), so every `ret` below must be too.
    let named_struct: bool = ret_type == TypeKind.Struct and ret_type_name_sv.ptr != null and ret_type_name_sv.len > 0

    # If no explicit return and function has non-void return, use the last
    # tracked expression value — but ONLY if it was defined in the block the
    # implicit `ret` will be emitted into (AGAST #1329).  Reading
    # `last_expr_reg` raw here bypassed the dominance guard #1309 added: a
    # trailing expression inside a loop body leaked its register into the
    # loop-exit block, where the body does not dominate the ret on the
    # zero-iteration path.  `last_expr_here` returns 0 in that case, and
    # Sema's tail_value_check (AGAST #2236, #3511) has already rejected a fn that ends there.
    if not has_explicit_return and ret_type != TypeKind.Void
        var ival: i32 = last_expr_here(s)
        # AGAST #2950: a tail `if` / `match` whose phi is an i64 in a `-> @&T`
        # fn (an arm `q` with `q: *C`), or a `ptr` in a `-> *T` / `-> @T` one.
        if ival > 0 and ret_type == TypeKind.MutRef and s.last_expr_model == LAST_EXPR_I64
            let p: i32 = next_reg(s)
            format_into(s, "  %.{p} = inttoptr i64 %.{ival} to ptr  ; #2950\n")
            ival = p
        else if ival > 0 and (ret_type == TypeKind.Ptr or ret_type == TypeKind.Ref) and s.last_expr_model == LAST_EXPR_PTR
            let q: i32 = next_reg(s)
            format_into(s, "  %.{q} = ptrtoint ptr %.{ival} to i64  ; #2950\n")
            ival = q
        if ival > 0
            if ret_type == TypeKind.Array
                # AGAST #2302: emit_array_return takes a tail statement; this
                # value (an `if` / `match` arm's, say) is no `[N x T]`.
                emit_ir_error_sv(s, tail, "a `-> [N]T` fn's value here is not lowered by ritz1 (return the array from each arm)")
            else if ty_int_bits(ret_type) == 32
                let trunc: i32 = ir_trunc_i64_i32(s.out, @s.reg_counter, ival)
                format_into(s, "  ret i32 %.{trunc}\n")
            else if ret_type == TypeKind.Bool
                # Match arms / binops carry their result as i64 even when the
                # function signature is bool; trunc back to i1 at the implicit
                # return (mirrors the explicit-return path at line ~195).
                let btrunc: i32 = ir_trunc_i64_i1(s.out, @s.reg_counter, ival)
                format_into(s, "  ret i1 %.{btrunc}\n")
            else if ty_int_bits(ret_type) == 8
                # Narrow byte return — expressions carry i64; trunc down.
                let btrunc8: i32 = ir_trunc_i64_i8(s.out, @s.reg_counter, ival)
                format_into(s, "  ret i8 %.{btrunc8}\n")
            else if ty_int_bits(ret_type) == 16
                let btrunc16: i32 = ir_trunc_i64_i16(s.out, @s.reg_counter, ival)
                format_into(s, "  ret i16 %.{btrunc16}\n")
            else if named_struct and s.ret_sret == 1
                emit_sret_ret_value(s, ival)   # AGAST #1730
            else if named_struct
                # tagged-enum or named-struct return: use the named type
                # (ritz-task-133).  Without this the tail-expression phi
                # carries `%Result$...` but the ret claims `i64`.
                format_into(s, "  ret ")
                emit_llvm_type_struct(s, TypeKind.Struct, ret_type_name_sv)
                format_into(s, " %.{ival}\n")
            else
                format_into(s, "  ret {llvm_text(ty_value_llvm(ret_type))} %.{ival}\n")
        else
            # No value here, and this block is dead.  Sema's tail_value_check (AGAST
            # #2236) rejected every fn the rule says ends without one, and the
            # rule's "every arm diverges" is sound now that a match must cover
            # its scrutinee (#2245, #2344): this is the merge after arms that
            # all left, or the exit of a `while true`.
            format_into(s, "  unreachable\n")
    else if ret_type == TypeKind.Void and not has_explicit_return
        format_into(s, "  ret void\n")

# AGAST #3421: a statement `if` ending a fn body.  In an `-> f64` / `-> f32`
# fn it is a float slot (LARB R43), as the tail `match` is (#3385); in a
# procedure nobody reads its value, so it has no phi (its arms could be an
# i64 and a double, #3749's discarded `if`).
fn tail_if_slot(s: *EmitterState, stmt: *Stmt, ret_type: TypeKind, ret_name_sv: StrView)
    if ret_type == TypeKind.Void
        s.if_stmt_discarded = stmt
        return
    s.match_float_hint = slot_float_type(ret_type, ret_name_sv)

# AGAST #2098: a `p: *[N][M]..T` param is a pointer to the whole array, kept
# as a plane pointer is (#2570): param_of_type recorded the flat count and the
# leaf, and the shape makes `p[i][j]` and `(*p)[i][j]` one GEP over it.
# AGAST #3635: and a `p: **[N][M]..T` param, the shape of the array `*p`
# points at (plane_ptr_shape tells the two apart by var_type).
fn bind_nd_pointee_param(s: *EmitterState, param: *Param)
    if param.param_pointee_array_shape == null
        return
    let loc: *LocalVar = find_local_struct_name(s, StrView { ptr: (param.name), len: (param.name_len) as i64 })
    if loc == null
        return
    if param.param_type == TypeKind.Ptr and lv_pointee_type(loc) == TypeKind.Array
        lv_set_pointee_array_shape(loc, param.param_pointee_array_shape)
    else if param.param_type == TypeKind.PtrPtr and lv_pointee_type(loc) == TypeKind.Ptr
        lv_set_pointee_array_shape(loc, param.param_pointee_array_shape)
    else if (param.param_type == TypeKind.Ref or param.param_type == TypeKind.MutRef) and lv_pointee_type(loc) == TypeKind.Ptr
        lv_set_pointee_array_shape(loc, param.param_pointee_array_shape)   # AGAST #4122: `@*[N][M]T`
    else if (param.param_type == TypeKind.Ref or param.param_type == TypeKind.MutRef) and lv_pointee_type(loc) == TypeKind.Array
        lv_set_pointee_array_shape(loc, param.param_pointee_array_shape)   # AGAST #4313: `@[N][M]T` / `@&[N][M]T`

# AGAST #1644: bind a scalar `name:& T` borrow param whose ptr was just
# spilled to `alloca_reg`.  ritz0 auto-dereferences the borrow: `x` reads the
# pointee, `x = v` / `x += v` write it, and `@&x` is the caller's pointer.
# Load the ptr once at entry and register `x` as a plain T local whose slot IS
# that pointer, so every read, store and address-of lowers exactly as for the
# caller's own variable.  Returns 1 when bound; 0 leaves the param to the
# normal path (struct pointees keep the pointer lowering `c.n` already uses,
# `@&T` params are not borrows).  `bool` (#2994) and f32 / f64 (#1668) bind the
# same way.
# An array pointee binds the same way, as an array local (AGAST #2290).
fn bind_scalar_borrow_param(s: *EmitterState, param: *Param, alloca_reg: i32) -> i32
    if param.is_borrow != 1 or param.param_type != TypeKind.MutRef
        return 0
    let pt: TypeKind = param.param_pointee_type
    # AGAST #2290: `a:& [N]T` binds as an array local whose slot is the array
    # behind the borrow, so `a[i]`, `a[i] = v`, `@a[i]`, `a[i].f` and every
    # other element path index it as `[N x T]`, as for the caller's own array.
    # As a reference local the index paths had no element type and fell back
    # to i64: `a[1] = 3` stored 8 bytes past the end of a `[2]i32`.
    match pt
        TypeKind.Array =>
            let aslot: i32 = emit_borrow_slot_load(s, alloca_reg)
            add_local_full(s, StrView { ptr: (param.name), len: (param.name_len) as i64 }, aslot, TypeKind.Array, StrView { ptr: (param.param_type_name), len: (param.param_type_name_len) as i64 }, TypeKind.Array, param.param_pointee_array_size, param.param_pointee_array_elem_type)
            set_local_pointee_array(s, StrView { ptr: (param.name), len: (param.name_len) as i64 }, param.param_pointee_array_size, param.param_pointee_array_elem_type)
            set_local_pointee_elem(s, StrView { ptr: (param.name), len: (param.name_len) as i64 }, param.param_pointee_array_elem_pointee)
            let lent: *LocalVar = find_local_struct_name(s, StrView { ptr: (param.name), len: (param.name_len) as i64 })
            lv_set_array_elem_pointee(lent, param.param_pointee_array_elem_pointee)   # it reads as the array
            let aloc: *LocalVar = find_local_struct_name(s, StrView { ptr: (param.name), len: (param.name_len) as i64 })
            lv_set_array_shape(aloc, param.param_pointee_array_shape)
            mark_lent_param(s, param)
            return 1
        # AGAST #2075: `p:& *T` (T an integer or a struct) is a borrow of a
        # pointer variable, and like the integer case `p` reads as the
        # referent: the `*T` value.  Bind it as a `*T` local whose slot is the
        # caller's pointer variable, so `p`, `*p`, `p.f`, `@*p` (which is p's
        # value) and `p = q` lower as for the caller's own `var p: *T`.  Before
        # this, `p` was left a TypeKind.MutRef whose value is the borrow itself,
        # so `@*p` returned the `**T` slot.
        TypeKind.Ptr =>
            let ipt: TypeKind = ptr_slot_flat(param.param_inner_pointee_type)
            # AGAST #3103: `p:& *[N]T` the same way, as a `*[N]T` local with the
            # `p#` view a `p: *[N]T` param gets, so `p[i]` is element i (§13.4).
            if ipt == TypeKind.Array and param.param_pointee_array_size > 0
                let aps: i32 = emit_borrow_slot_load(s, alloca_reg)
                add_array_view(s, StrView { ptr: (param.name), len: (param.name_len) as i64 }, aps, TypeKind.Ptr, TypeKind.Array, param.param_pointee_array_size, param.param_pointee_array_elem_type, StrView { ptr: (param.param_type_name), len: (param.param_type_name_len) as i64 })
                add_local_full(s, StrView { ptr: (param.name), len: (param.name_len) as i64 }, aps, TypeKind.Ptr, StrView { ptr: (param.param_type_name), len: (param.param_type_name_len) as i64 }, TypeKind.Array, 0, TypeKind.Void)
                set_local_pointee_array(s, StrView { ptr: (param.name), len: (param.name_len) as i64 }, param.param_pointee_array_size, param.param_pointee_array_elem_type)
                set_local_pointee_elem(s, StrView { ptr: (param.name), len: (param.name_len) as i64 }, param.param_pointee_array_elem_pointee)
                # AGAST #4122: `p:& *[N][M]T` is a plane pointer, as a `p: *[N][M]T` is.
                let bloc: *LocalVar = find_local_struct_name(s, StrView { ptr: (param.name), len: (param.name_len) as i64 })
                lv_set_pointee_array_shape(bloc, param.param_pointee_array_shape)
                name_array_ptr_param(s, param)
                return 1
            # AGAST #2086: and `p:& *bool`, `*f32`, `*f64`: left to the normal
            # path, `*p` read the borrow slot as the pointer's referent, so
            # `*p = 3.0` stored a double where the `*f64` lives (invalid IR) and
            # `*p = true` refused a `bool` as a pointer.
            let float_or_bool: bool = ipt == TypeKind.Bool or ipt == TypeKind.F32 or ipt == TypeKind.F64
            if is_borrow_scalar_kind(ipt) == 0 and ipt != TypeKind.Struct and float_or_bool == false
                return 0
            if ipt == TypeKind.Struct and param.param_type_name_len <= 0
                return 0
            let pslot: i32 = emit_borrow_slot_load(s, alloca_reg)
            add_local_full(s, StrView { ptr: (param.name), len: (param.name_len) as i64 }, pslot, TypeKind.Ptr, StrView { ptr: (param.param_type_name), len: (param.param_type_name_len) as i64 }, ipt, 0, TypeKind.Void)
            set_local_inner_ref(s, StrView { ptr: (param.name), len: (param.name_len) as i64 }, param.param_inner_ref)   # AGAST #2399: `p:& @S`
            return 1
        _ => pass
    # AGAST #2372: `p:& **S` the same way, as a `**S` local.
    if param_borrows_struct_ptr_ptr(param) == 1
        let ppslot: i32 = emit_borrow_slot_load(s, alloca_reg)
        add_local_full(s, StrView { ptr: (param.name), len: (param.name_len) as i64 }, ppslot, TypeKind.PtrPtr, StrView { ptr: (param.param_type_name), len: (param.param_type_name_len) as i64 }, TypeKind.Ptr, 0, TypeKind.Void)
        set_local_inner_pointee(s, StrView { ptr: (param.name), len: (param.name_len) as i64 }, param.param_inner_pointee_type)
        set_local_inner_ref(s, StrView { ptr: (param.name), len: (param.name_len) as i64 }, param.param_inner_ref)
        return 1
    # AGAST #2994: `b:& bool` the same way, as a `bool` local whose slot is
    # the caller's: i1, the one byte every `bool` place holds its value in
    # (a `bool` local keeps it in the low byte of a wider slot).
    # AGAST #1668: and `x:& f32` / `x:& f64`, as a float local: `x` reads the
    # caller's float, `x = x + 1.0` writes it, `@&x` is the caller's pointer.
    let float_pt: bool = pt == TypeKind.F32 or pt == TypeKind.F64
    if is_borrow_scalar_kind(pt) == 0 and pt != TypeKind.Bool and float_pt == false
        return 0
    let slot: i32 = emit_borrow_slot_load(s, alloca_reg)
    add_local(s, StrView { ptr: (param.name), len: (param.name_len) as i64 }, slot, pt)
    if pt == TypeKind.Bool
        local_at(s, s.local_count - 1).is_bool = 1
    mark_lent_param(s, param)
    return 1

# AGAST #3131: the inner pointee a pointer or reference param's local records.
# An `@*T` / `@&*T` param records T as a `**T` does (T is the `*T`'s pointee),
# as an `@*T` / `@&*T` local does (#3079, #3108).  It recorded none, so
# ptr_levels_of saw it as no levels deep and `(*r)[i]` loaded `*r`, read a byte
# there and used that as the element's address.  param_inner_pointee_type holds
# T only for a `p:& *T` borrow (param_borrow); param_ref_ptr_pointee is VOID
# for anything but an `@*T` / `@&*T`.
fn param_local_inner_pointee(param: *Param) -> i32
    if param.param_inner_pointee_type == (TypeKind.Void as i32)
        return (param.param_ref_ptr_pointee as i32)
    param.param_inner_pointee_type

# AGAST #2548: a `*[N]S`, `@[N]S` or `@&[N]S` param records S where
# such a local does (name_array_ptr_local): pointee_array_elem_name, not
# type_name.  In type_name it made the param a `*S`, so `q.b`, `let p = q; p.b`
# and `(*r).b` with `r = @q` read element 0's b; ritz0 refuses them, as ritz1
# does for a local.  `q#`, the `*S` view add_array_view binds first, keeps S.
#
# AGAST #2553: and a `**[N]S` param, which the parser now names S too: in
# type_name it would make `(*r).b` a `**S`'s field.
#
# AGAST #3074: and a `**[N]*S`, `@*[N]*S` or `@&*[N]*S` param, for `(*q)[i].f`.
# A `*[N]*S` keeps S in type_name (#2343).
fn name_array_ptr_param(s: *EmitterState, param: *Param)
    name_array_ptr_param_loc(find_local_struct_name(s, StrView { ptr: (param.name), len: (param.name_len) as i64 }), param)

# AGAST #2250: record that the local just bound for `param` is a `name:& T`
# param with an integer, struct or array T (LocalVar.is_lent).  Checking the
# kind matters: `c:& **C` also names `C`, and that isn't what it holds.  Nor
# does `c:& [2]C`, which is why its readers ask for an array (AGAST #2279).
# Whatever its T, a param bound as a reference holds the pointer in its slot
# (AGAST #2286); bind_scalar_borrow_param's locals don't.
fn mark_lent_param(s: *EmitterState, param: *Param)
    let loc: *LocalVar = find_local_struct_name(s, StrView { ptr: (param.name), len: (param.name_len) as i64 })
    if loc == null
        return
    # AGAST #2407: a param that holds no fn value can't be called.
    loc.not_fn = (param.fn_sig == null and param.param_type != TypeKind.Ptr) as i32
    # `self:& C` on a free fn binds here too; in an impl it's a `*C` local.
    if (param.is_borrow == 1 or param.is_self_borrow == 1) and lv_var_type(loc) == TypeKind.MutRef
        lv_set_holds_lent_ptr(loc, 1)
    # AGAST #2278: `self:& T` reads its referent into a by-value `T` slot.
    if param.is_self_borrow == 1 and lv_pointee_type(loc) == TypeKind.Struct and (lv_var_type(loc) == TypeKind.Ptr or lv_var_type(loc) == TypeKind.MutRef)
        lv_set_is_lent_self(loc, 1)
    if param.is_borrow != 1 or param.param_type != TypeKind.MutRef
        return
    let pt: TypeKind = param.param_pointee_type
    if pt != TypeKind.Struct and pt != TypeKind.Array and is_borrow_scalar_kind(pt) == 0
        return
    lv_set_is_lent(loc, 1)

# Load a borrow param's pointer, spilled to `alloca_reg`, once at entry.
fn emit_borrow_slot_load(s: *EmitterState, alloca_reg: i32) -> i32
    let slot: i32 = next_reg(s)
    format_into(s, "  %.{slot} = load ptr, ptr %.{alloca_reg}  ; #1644 scalar borrow\n")
    slot

# AGAST #1739: bind a large by-value struct param (`ptr byval(%T) %x.arg`,
# see param_uses_byval).  The byval memory is the callee's own copy, so it
# IS the param's slot: no alloca and no first-class `store %T`, which is
# what hung clang -O2.  A no-op GEP names the pointer with a fresh `%.N`
# register (locals are keyed by register number), and the param registers
# exactly like a spilled struct param.  Writes to the param stay local.
# Returns 0 for every other param.
fn bind_byval_param(s: *EmitterState, param: *Param) -> i32
    if param_uses_byval(s, param) == 0
        return 0
    let slot: i32 = next_reg(s)
    let name: StrView = StrView { ptr: (param.name), len: (param.name_len) as i64 }
    let name_ir: String = ir_name(name)
    format_into(s, "  %.{slot} = getelementptr i8, ptr %{name_ir.as_view()}.arg, i64 0  ; #1739 byval param\n")
    add_local_struct(s, name, slot, param.param_type, StrView { ptr: (param.param_type_name), len: (param.param_type_name_len) as i64 })
    set_local_fn_sig(s, name, param.fn_sig)  # AGAST #1671
    return 1

# AGAST #2287: bind a by-value `[N]T` param (`[N x T] %a.arg`, as in ritz0) to
# a slot of its own, registered as an array local: it is the callee's copy, and
# `a[i]`, `a[i].f`, `h.a = a` and `g(a)` read it as they read any local array.
# AGAST #2306: a large one arrives `ptr byval([N x T])`, which already IS the
# callee's copy: a no-op GEP names it as a `%.N` slot, as bind_byval_param does,
# with no first-class `store [N x T]`.
fn bind_array_param(s: *EmitterState, param: *Param) -> i32
    if param.param_type != TypeKind.Array
        return 0
    let slot: i32 = next_reg(s)
    let name: StrView = StrView { ptr: (param.name), len: (param.name_len) as i64 }
    let name_ir: String = ir_name(name)
    if array_param_uses_byval(s, param) == 1
        format_into(s, "  %.{slot} = getelementptr i8, ptr %{name_ir.as_view()}.arg, i64 0  ; #2306 byval array param\n")
    else
        entry_alloca_reg_begin(s, slot)
        emit_array_value_llvm_type(s, param)
        format_into(s, "\n")
        entry_alloca_reg_end(s)
        format_into(s, "  store ")
        emit_array_value_llvm_type(s, param)
        format_into(s, " %{name_ir.as_view()}.arg, ptr %.{slot}\n")
    add_local_full(s, name, slot, TypeKind.Array, StrView { ptr: (param.param_type_name), len: (param.param_type_name_len) as i64 }, TypeKind.I64, param.param_array_size, param.param_array_elem_type)
    let arr: *LocalVar = find_local_struct_name(s, name)
    lv_set_array_elem_pointee(arr, param.param_array_elem_pointee)   # AGAST #2343
    lv_set_array_shape(arr, param.param_array_shape)   # AGAST #3634: an N-D local
    return 1

# Spill a bool parameter into an i64 slot and register it as TypeKind.I64.
#
# AGAST #1497. The ABI passes a bool as i1, but ritz1's value model is i64 for
# every scalar, and bool LOCALS were already promoted to i64 slots for that
# reason (emit_var_decl). A bool param used to keep an `alloca i1` slot, so
# loading it gave an i1 that every i64 consumer then mangled: `store i64` into
# a struct literal or typed let, `trunc i64` in a field assign. Widening at
# the prologue makes a param read exactly like a bool local: condition sites
# `icmp ne i64` it, and bool call args / bool returns `trunc` it back to i1.
fn emit_bool_param_spill(s: *EmitterState, param: *Param)
    let alloca_reg: i32 = entry_alloca(s, IR_TY_I64, null)
    let wide: i32 = next_reg(s)
    let name: StrView = StrView { ptr: (param.name), len: (param.name_len) as i64 }
    let name_ir: String = ir_name(name)
    format_into(s, "  %.{wide} = zext i1 %{name_ir.as_view()}.arg to i64\n")
    emit_store_typed(s, IR_TY_I64, wide, alloca_reg)
    add_local(s, name, alloca_reg, TypeKind.I64)
    # AGAST #1521: the slot is i64, but print interpolation must still see a
    # bool (`print("{b}")` prints true/false), the same as emit_var_decl's
    # bool locals.
    if s.local_count > 0
        let bool_loc: *LocalVar = local_at(s, s.local_count - 1)
        bool_loc.is_bool = 1

# AGAST #1685, #4460 — every fixed-size alloca belongs in the entry block.
#
# The emitter writes a static `%r = alloca T` into EmitterState.entry_allocas
# as it emits it (entry_alloca / entry_alloca_begin in emitter_core) instead
# of into the body, and emit_fn / emit_impl_method call this once the body is
# complete to insert that buffer just after `entry:`.  The buffer is in
# emission order, which is exactly the order the old stable text partition
# produced, so the emitted IR is unchanged.  A DYNAMIC alloca
# (`alloca i8, i64 %.N` from `__builtin_alloca(n)`) is left in place: its size
# register is defined later than `entry:`, and its per-call allocation is the
# point of the builtin.
#
# Why this matters: a non-entry alloca is dynamic to LLVM and is never
# reclaimed until the fn returns, so a 16-byte `let` in a loop body needed
# 160 MB of stack over 10M iterations and segfaulted (#1685).
#
# The frame-limit check (#3739) runs after the splice and locates the largest
# alloca from EmitterState.fm.  Splicing shifts every body line, so the marks
# are rebuilt here: the buffer's allocas carry the (line, col) in force when
# each was emitted (ea_marks), and the original marks past `entry:` move up by
# the buffer's length.  Its diagnostics keep their exact source spans.
fn splice_entry_allocas(s: *EmitterState, body_start: i64)
    let n: i64 = s.entry_allocas.data.len
    if n <= 0
        return
    out_insert(s, body_start, s.entry_allocas.as_view())
    # Rebuild the frame-limit marks.  They are sorted by offset; the buffer's
    # lines now start at body_start (in emission order), and every original
    # mark at or after body_start shifted up by n.
    let cap: i32 = s.fm_count + s.ea_count
    let marks: *FrameMark = malloc((cap as i64) * sizeof(FrameMark)) as *FrameMark
    var w: i32 = 0
    var i: i32 = 0
    while i < s.fm_count
        let m: *FrameMark = s.fm + (i as i64)
        if m.off >= body_start
            break
        let d: *FrameMark = marks + (w as i64)
        d.off = m.off
        d.line = m.line
        d.col = m.col
        w += 1
        i += 1
    var e: i32 = 0
    while e < s.ea_count
        let em: *FrameMark = s.ea_marks + (e as i64)
        let d2: *FrameMark = marks + (w as i64)
        d2.off = body_start + em.off
        d2.line = em.line
        d2.col = em.col
        w += 1
        e += 1
    while i < s.fm_count
        let m2: *FrameMark = s.fm + (i as i64)
        let d3: *FrameMark = marks + (w as i64)
        d3.off = m2.off + n
        d3.line = m2.line
        d3.col = m2.col
        w += 1
        i += 1
    free(s.fm as *u8)
    s.fm = marks
    s.fm_count = w
    s.fm_cap = cap
    # AGAST #4461: deferred load lines move with the body too.
    defer_loads_shift(s, n)
    # The next fn starts empty (grows are kept for reuse).
    s.entry_allocas.data.len = 0
    s.ea_count = 0

# AGAST #4461: the generic line scanners the deferred-load splice uses live in
# emitter_core (scan_find and friends); they were the deleted copy-scan
# module's, and the copy rewrite that drove it is gone.  Packed-struct
# alignment (#1918) is decided at instruction-emission time now (#4462); see
# packed_mark / packed_marked in emitter_core.

# AGAST #1737 — the CPU features an x86 ISA-extension intrinsic needs.
#
# Without them, instruction selection aborts with "Cannot select: intrinsic
# %llvm.x86.sha256rnds2" (clang exit 70), unless clang is run with -msha /
# -maes / -mpclmul / -march=native, and build.py's per-source `clang -c -O2`
# passes none of those (#1731). So, as ritz0 has done since #1736, a function
# whose body calls one gets `"target-features"="+..."` for exactly the
# features it uses: what clang gives a C function marked
# `__attribute__((target("sha")))`. The rest of the module stays baseline
# x86-64, so the runtime check guarding the call (cryptosec's cpu_has_sha_ni
# and friends) still decides whether the instructions ever run.
#
# "target-cpu"="x86-64" is pinned too (#1921): a function's target-features
# REPLACES the command line's feature string, so with `-march=native` on a VM
# that masks AVX, a bare "+sha" function got the host CPU's full nominal ISA
# and SIGILLed. ritz0's _with_target_features emits the identical attributes.
#
# llvm.x86.sse2.* (psad.bw) is baseline x86-64 and needs nothing.

# 1 if `pat` (plen bytes) occurs anywhere in s.out from `from` on.
fn out_contains(s: *EmitterState, from: i64, pat_sv: StrView) -> i32
    var pat: *u8 = pat_sv.ptr
    var plen: i64 = pat_sv.len
    let base: *u8 = s.out.data.data
    var i: i64 = from
    while i + plen <= s.out.data.len
        if memcmp(base + i, pat, plen) == 0
            return 1
        i += 1
    0

# Called once the body is complete (before the closing `}`), with attr_pos
# the offset in s.out just after the define line's other attributes. Splices
# the target attributes in there when the body calls an intrinsic needing
# one; the body text after attr_pos moves along unchanged.
fn tag_intrinsic_target_features(s: *EmitterState, attr_pos: i64)
    let sha: i32 = out_contains(s, attr_pos, "@llvm.x86.sha")
    let aes: i32 = out_contains(s, attr_pos, "@llvm.x86.aesni.")
    let clmul: i32 = out_contains(s, attr_pos, "@llvm.x86.pclmulqdq")
    if sha == 0 and aes == 0 and clmul == 0
        return
    let n: i64 = s.out.data.len - attr_pos
    let tail: *u8 = malloc(n)
    memcpy(tail, s.out.data.data + attr_pos, n)
    s.out.data.len = attr_pos
    format_into(s, " \"target-cpu\"=\"x86-64\" \"target-features\"=\"")
    # Sorted, as ritz0 emits them, so the two compilers' IR agrees.
    var sep: i32 = 0
    if aes == 1
        format_into(s, "+aes")
        sep = 1
    if clmul == 1
        if sep == 1
            format_into(s, ",")
        format_into(s, "+pclmul")
        sep = 1
    if sha == 1
        if sep == 1
            format_into(s, ",")
        format_into(s, "+sha")
    format_into(s, "\"")
    s.out.push_span(Span<u8> { ptr: (tail), len: (n) as i64 })
    free(tail)

# 1 for an async fn's poll fn: its name ends in `$poll` (async_lower).
fn fn_name_ends_poll(f: *FnDef) -> i32
    if StrView { ptr: (f.name), len: (f.name_len) as i64 }.ends_with("$poll")
        return 1
    0

# AGAST #4609: 1 for a generated `E.from` (§10.4): every object that uses it
# defines its own internal copy, as an instance's (two files' enums `E` each
# generate one).  Not async_lower's injected `future_poll` (each unit's own
# copy, merged weak_odr), nor a monomorph instance ('$'), whose
# `from_generated` its clone leaves unset.
fn fn_is_enum_from(f: *FnDef) -> i32
    if f == null or f.from_generated != 1
        return 0
    let name: StrView = StrView { ptr: (f.name), len: (f.name_len) as i64 }
    if name.ends_with("__from") and name.find_byte('$') == name.len
        return 1
    0

# 1 when fn_linkage gives the fn an ODR linkage (linkonce_odr / weak_odr).
fn fn_is_odr(is_main: bool, is_monomorph: bool, is_pub: i32, from_generated: i32) -> bool
    if is_main
        return false
    if is_monomorph
        return false   # internal since AGAST #4609 (fn_linkage)
    if is_pub == 1 and from_generated == 1
        return true
    false

# AGAST #201: an ODR *function* goes in its own same-named comdat, as clang
# does for every C++ inline/template function.  On ELF a linkonce definition
# is a weak symbol and the linker keeps one copy either way; on COFF (a
# `*-uefi` [[bin]] compiles for x86_64-windows-gnu) one without a comdat is a
# plain weak external, and lld-link reports two objects' copies of
# `vec_push$u8` as a duplicate symbol (harland's hwinv).  ritz0 does the same
# (_add_odr_comdats).  This writes the `$name = comdat any` line, just before
# the define (module-level entities may come in any order); the caller writes
# ` comdat` after the define's attributes.
#
# Functions only, never globals: a comdat group is matched by *name* across
# objects, and globals of unrelated modules share names (`g_out`, every test
# file's capture buffer).  The ritzunit runner localizes its own copy with
# `objcopy --keep-global-symbol=main`, so the test's group was discarded in
# its favour and the test's references bound to the discarded section --
# `@g_out[0]` became 0 and every capture test SIGSEGVd.  A global stays
# `weak_odr` alone, as on main; only functions get the group.
fn emit_odr_comdat_start(s: *EmitterState, name_sv: StrView, suffix_sv: StrView)
    let name_ir: String = ir_name(name_sv)
    format_into(s, "${name_ir.as_view()}")
    if suffix_sv.ptr != null
        let suffix_ir: String = ir_name(suffix_sv)
        format_into(s, "_{suffix_ir.as_view()}")
    format_into(s, " = comdat any\n")

# AGAST #3386 (LARB R45): a defined fn's linkage follows its visibility.
#   - `main`: external (the runtime's _start calls it).
#   - a monomorph ('$' in its name): internal.  Every module using it emits
#     its own copy, as ritz0's is_monomorphized (AGAST #4609).  It was
#     linkonce_odr, one copy kept for the program, but its name says only
#     which type *name* it is for: two types `Box` of two files (§15.3) each
#     have a `pick$Box`, and the linker kept one for both.
#   - a generated `pub` `E__from` (§10.4): weak_odr. Two files declaring the
#     same enum each generate one (AGAST #2148), as ritz0 links them (#2160).
#   - a `pub fn`: external.
#   - a private fn: internal, so two modules' private fns of one name stay
#     two fns. `weak_odr` here (#194) let the linker keep either body.
#     emit_fn does not use this for a private *free* fn: since #4356 that is
#     external with its file in the symbol (fn_symbol), like ritz0, so a
#     generic's instance in another object can call it.  A private impl
#     method still lands here: two types of one name may not both define
#     `m` (type_twins.ritz), so `T_m` cannot clash.
fn fn_linkage(is_main: bool, is_monomorph: bool, is_pub: i32, from_generated: i32) -> StrView
    if is_main
        return "define "
    if fn_is_odr(is_main, is_monomorph, is_pub, from_generated)
        return "define weak_odr "
    if is_pub == 1 and is_monomorph == false
        return "define "
    "define internal "

fn emit_fn(s: *EmitterState, f: *FnDef)
    # AGAST #194 modular emit: skip imports entirely. The owning .ll
    # emits the body; this .ll just needs a `declare`, which the
    # extern path produces only for fns actually called by local code
    # (driven by add_extern at every emit_expr_call site). That avoids
    # paying ~80 bytes per declare for fns this module doesn't reach.
    # AGAST #3585: an eligible [[inline]] import is the exception, defined
    # available_externally below (fn_inline_import, ast_helpers.ritz).
    if f.is_local == 0 and f.body != null and fn_inline_import(s.mono.pctx, f) == 0
        # Side-channel: register so emit_extern_declarations doesn't
        # accidentally emit a `(...)` fallback declare for fns we'd
        # otherwise resolve concretely.  Actually we don't add_extern
        # here — we want the declare to be opt-in via call sites only.
        return
    refuse_huge_byval_params(s, f)   # AGAST #3668: definitions and externs
    # Check if this is an extern function (no body) — defer the declare
    # to emit_extern_declarations so we don't duplicate it when a call
    # site also adds the name to s.externs (matches AGAST #194's
    # single-source-of-truth rule for declare emission).
    if f.body == null
        add_extern(s, StrView { ptr: (f.name), len: (f.name_len) as i64 })
        return

    emitter_set_current_fn(f)   # AGAST #1813: locates emit_fatal_limit
    variant_site_set(s.mono.pctx, diag_fn_source_file(f))   # AGAST #4609: its bare variants
    frame_begin_fn(s, f.line, f.col)   # AGAST #3739
    s.fn_assert_kind = assert_fn_kind(s.mono.pctx, f)   # AGAST #1869
    s.reg_counter = 1
    packed_marks_reset(s)   # AGAST #4462: register numbers restart per fn
    s.label_counter = 0
    # AGAST #1335 — the entry block is unlabelled; see ENTRY_BLOCK_LABEL.
    s.current_label = ENTRY_BLOCK_LABEL
    s.local_count = 0
    narrowing_begin_fn(s, f.params)   # AGAST #1364
    s.break_label = -1
    s.continue_label = -1
    # ritz-task-193 — clear per-fn locals map (entries from previous fn
    # would otherwise pollute the probe chain and falsely match new locals
    # via stale-but-still-OCCUPIED slots).
    s.local_map.clear()
    # Store return type name for struct returns
    s.ret_type_name = f.return_type_name
    s.ret_type_name_len = f.return_type_name_len
    # AGAST #1730 — large struct returns go through `ptr sret(%T) %ret.sret`.
    s.ret_sret = struct_ret_uses_sret(s, f.return_type, StrView { ptr: (f.return_type_name), len: (f.return_type_name_len) as i64 })
    s.fn_ret_type = f.return_type   # AGAST #1454
    s.sret_last_val = 0
    s.sret_last_slot = 0

    # Linkage follows visibility (AGAST #3386, LARB R45); see fn_linkage.
    var is_main: bool = false
    if f.name_len == 4
        if *(f.name + 0) == 'm' and *(f.name + 1) == 'a' and *(f.name + 2) == 'i' and *(f.name + 3) == 'n'
            is_main = true
    var is_monomorph: bool = false
    var name_i: i32 = 0
    while name_i < f.name_len
        if *(f.name + name_i) == '$'   # '$' marks a monomorph instantiation suffix
            is_monomorph = true
            name_i = f.name_len
        else
            name_i = name_i + 1
    # AGAST #4609: a generated `E.from` is each object's own copy, as an
    # instance is (fn_linkage): two files' enums `E` each have one.
    let own_copy: bool = is_monomorph or fn_is_enum_from(f) == 1
    # An async fn's poll fn (`go$poll`, async_lower) is no instance: the
    # importer calls the one its definer's object has, `linkonce_odr` as
    # before #4609.  Its name is the async fn's, which is one per program.
    let poll_odr: bool = is_monomorph and fn_name_ends_poll(f) == 1
    if f.is_local == 0
        # AGAST #3585: an imported [[inline]] fn, a body for -O2 to inline;
        # the defining module's object has the symbol.
        format_into(s, "define available_externally ")
    else
        if fn_private_free(f) == 1
            # AGAST #4356: a private free fn is external but mangled (below),
            # so a generic's instance emitted in another object can call it.
            format_into(s, "define ")
        else if poll_odr
            emit_odr_comdat_start(s, StrView { ptr: (f.name), len: (f.name_len) as i64 }, StrView { ptr: (null), len: (0) as i64 })
            format_into(s, "define linkonce_odr ")
        else
            if fn_is_odr(is_main, own_copy, f.is_pub, f.from_generated)
                emit_odr_comdat_start(s, StrView { ptr: (f.name), len: (f.name_len) as i64 }, StrView { ptr: (null), len: (0) as i64 })
            emit_sv(s, fn_linkage(is_main, own_copy, f.is_pub, f.from_generated))
    emit_sv(s, llvm_text(fn_callconv_kw(s.mono.pctx, f)))   # [[callconv = "win64"]] (AGAST #1879)
    if s.ret_sret == 1
        format_into(s, "void")
    else
        emit_fn_ret_llvm_type(s, f)   # AGAST #2302: `-> [N]T` is `[N x T]`
    var sym_len: i32 = 0
    let sym: *u8 = fn_symbol(f, @sym_len)
    let sym_ir: String = ir_name(StrView { ptr: (sym), len: (sym_len) as i64 })
    format_into(s, " @{sym_ir.as_view()}(")

    var param2: *Param = f.params
    var first2: i32 = 1
    if s.ret_sret == 1
        emit_sret_attr(s, StrView { ptr: (f.return_type_name), len: (f.return_type_name_len) as i64 })
        format_into(s, "%ret.sret")
        first2 = 0
    if fn_sret_array(s, f) != null
        emit_sret_array_attr(s, fn_sret_array(s, f))   # AGAST #3181
        format_into(s, "%ret.sret")
        first2 = 0
    while param2 != null
        if first2 == 0
            format_into(s, ", ")
        first2 = 0
        emit_param_llvm_type(s, param2)   # AGAST #1739: large struct -> ptr byval
        let param2_ir: String = ir_name(StrView { ptr: (param2.name), len: (param2.name_len) as i64 })
        format_into(s, " %{param2_ir.as_view()}.arg")
        param2 = param2.next

    # alignstack(16), "no-builtins" and (--stack-protector) sspstrong: see
    # emit_fn_attrs.
    # [[naked]] (§17.5, §18.6, AGAST #3395): no frame, so no parameter slot
    # and no prologue; the asm blocks, then `unreachable`.  noinline as in
    # ritz0 (#1917): inlined, the block's own `ret` would leave the caller.
    # No alignstack(16) "no-builtins" here, deliberately (AGAST #1326): the
    # body is asm only (emit_naked_fn_body drops every other statement), so
    # loop-idiom has no loop to rewrite, and there is no prologue to align.
    # Same for `_start` below and runtime/*.ll.  Revisit if that changes.
    if fn_is_naked(s.mono.pctx, f) == 1
        format_into(s, ") naked noinline {\nentry:\n")
        emit_naked_fn_body(s, f)
        format_into(s, "}\n\n")
        return
    emit_fn_attrs(s)
    emit_sv(s, llvm_text(fn_inline_attr(s.mono.pctx, f)))   # [[inline]] / [[always_inline]] / [[noinline]] (#1847)
    let attr_pos: i64 = s.out.data.len    # AGAST #1737: target attrs go here
    # After attr_pos: an attribute inserted there must precede `comdat`.
    if f.is_local == 1 and (poll_odr or fn_is_odr(is_main, own_copy, f.is_pub, f.from_generated))
        format_into(s, " comdat")   # AGAST #201: see emit_odr_comdat_start
    format_into(s, " {\nentry:\n")
    # AGAST #1685, #4460: static allocas emitted below this point are
    # buffered and spliced back here when the body is complete.
    let body_start: i64 = s.out.data.len

    var param3: *Param = f.params
    while param3 != null
        if param3.param_type == TypeKind.Bool
            emit_bool_param_spill(s, param3)
            param3 = param3.next
            continue
        if bind_byval_param(s, param3) == 1   # AGAST #1739
            param3 = param3.next
            continue
        if bind_array_param(s, param3) == 1   # AGAST #2287
            param3 = param3.next
            continue
        let alloca_reg: i32 = entry_alloca_begin(s)
        emit_llvm_type_struct(s, param3.param_type, StrView { ptr: (param3.param_type_name), len: (param3.param_type_name_len) as i64 })
        format_into(s, "\n")
        entry_alloca_end(s)
        format_into(s, "  store ")
        emit_llvm_type_struct(s, param3.param_type, StrView { ptr: (param3.param_type_name), len: (param3.param_type_name_len) as i64 })
        let param3_ir: String = ir_name(StrView { ptr: (param3.name), len: (param3.name_len) as i64 })
        format_into(s, " %{param3_ir.as_view()}.arg, ptr %.{alloca_reg}\n")
        # Track parameter type including struct name for method calls
        # For pointer-to-struct params like *Vec<u8>, we need both:
        # - param_pointee_type (TypeKind.Struct) to know it's a pointer to struct
        # - param_type_name ("Vec$u8") to mangle method calls correctly
        if bind_scalar_borrow_param(s, param3, alloca_reg) == 1
            param3 = param3.next
            continue
        match param3.param_type
            TypeKind.Ptr | TypeKind.PtrPtr | TypeKind.Ref | TypeKind.MutRef =>
                add_array_view(s, StrView { ptr: (param3.name), len: (param3.name_len) as i64 }, alloca_reg, param3.param_type, param3.param_pointee_type, param3.param_pointee_array_size, param3.param_pointee_array_elem_type, StrView { ptr: (param3.param_type_name), len: (param3.param_type_name_len) as i64 })   # AGAST #2330
                add_local_full(s, StrView { ptr: (param3.name), len: (param3.name_len) as i64 }, alloca_reg, param3.param_type, StrView { ptr: (param3.param_type_name), len: (param3.param_type_name_len) as i64 }, param3.param_pointee_type, 0, TypeKind.Void)
                set_local_inner_pointee(s, StrView { ptr: (param3.name), len: (param3.name_len) as i64 }, param_local_inner_pointee(param3))   # AGAST #3131
                set_local_inner_ref(s, StrView { ptr: (param3.name), len: (param3.name_len) as i64 }, param3.param_inner_ref)   # AGAST #2399
                set_local_pointee_array(s, StrView { ptr: (param3.name), len: (param3.name_len) as i64 }, param3.param_pointee_array_size, param3.param_pointee_array_elem_type)  # AGAST #1953
                bind_nd_pointee_param(s, param3)   # AGAST #2098
                set_local_pointee_elem(s, StrView { ptr: (param3.name), len: (param3.name_len) as i64 }, param3.param_pointee_array_elem_pointee)
                name_array_ptr_param(s, param3)   # AGAST #2548
            TypeKind.Struct =>
                add_local_struct(s, StrView { ptr: (param3.name), len: (param3.name_len) as i64 }, alloca_reg, param3.param_type, StrView { ptr: (param3.param_type_name), len: (param3.param_type_name_len) as i64 })
            _ =>
                add_local(s, StrView { ptr: (param3.name), len: (param3.name_len) as i64 }, alloca_reg, param3.param_type)
        set_local_fn_sig(s, StrView { ptr: (param3.name), len: (param3.name_len) as i64 }, param3.fn_sig)  # AGAST #1671
        mark_lent_param(s, param3)   # AGAST #2250
        param3 = param3.next

    clear_last_expr(s)  # Reset before processing function body (ritz-task-1309)
    own_begin_fn(s, f.params)   # AGAST #2158: by-value move-only params
    ref_begin_fn(s, f)          # AGAST #2336
    var has_explicit_return: bool = false
    var stmt: *Stmt = f.body
    while stmt != null
        # AGAST #2279: a `c:& C` tail in a `-> C` fn returns the referent.
        if stmt.next == null and emit_array_return_if_stmt(s, stmt, ret_array_of(f)) == 1
            has_explicit_return = true   # AGAST #2305: a tail `if` / `else` of arrays
            stmt = stmt.next
            continue
        if stmt.next == null and stmt.kind == StmtKind.Expr and emit_lent_return(s, stmt.expr, f.return_type) == 1
            has_explicit_return = true
            stmt = stmt.next
            continue
        # Check if this is the last statement and it's an expression (implicit return).
        # AGAST #4072: a procedure's tail returns nothing, so it is an
        # expression statement: its value is a temporary, dropped (§13.6)
        # before the defers run, and emit_implicit_return_tail emits `ret void`.
        if stmt.next == null and stmt.kind == StmtKind.Expr and f.return_type != TypeKind.Void
            has_explicit_return = true
            struct_return_as_int_refused(s, stmt.expr, f.return_type)   # AGAST #3008
            own_tail_moves(s, stmt.expr)   # AGAST #2158: the tail is moved out
            if emit_array_return(s, stmt.expr, ret_array_of(f)) == 1
                has_explicit_return = true   # AGAST #2302: a `-> [N]T` tail is returned whole
            # Special handling for struct literal returns
            else if stmt.expr.kind == ExprKind.StructLit and f.return_type == TypeKind.Struct
                # Allocate space for the struct, initialize fields, load and return
                let alloca_reg: i32 = next_reg(s)
                let struct_name_sv: StrView = StrView { ptr: (stmt.expr.ident_ptr), len: (stmt.expr.ident_len) as i64 }
                let struct_name_ir: String = ir_name(struct_name_sv)
                entry_alloca_reg_begin_named(s, alloca_reg)
                format_into(s, "{struct_name_ir.as_view()}\n")
                entry_alloca_reg_end(s)
                emit_struct_lit_to_alloca(s, stmt.expr, alloca_reg)
                if s.ret_sret == 1
                    emit_sret_ret_from_ptr(s, alloca_reg)   # AGAST #1730
                else
                    # Load the struct value and return it
                    let val: i32 = next_reg(s)
                    format_into(s, "  %.{val} = load %{struct_name_ir.as_view()}, ptr %.{alloca_reg}\n")
                    format_into(s, "  ret %{struct_name_ir.as_view()} %.{val}\n")
            else if f.return_type == TypeKind.Struct
                # Struct return — handle ident (load from alloca) or call result.
                # Use emit_llvm_type_struct so tagged-enum types (Result$/Option$)
                # auto-route to `i64` instead of `%<name>` (task-99 cluster #3).
                # AGAST #3147: the tail is a copy into the return slot, as
                # `return e` is, so `p[i]` / `(*r)[i]` of a `C` loads it.
                if stmt.expr.kind == ExprKind.Ident
                    let local: *LocalVar = struct_value_local(s, stmt.expr)
                    if local != null and s.ret_sret == 1
                        emit_sret_ret_from_ptr(s, find_local(s, StrView { ptr: (stmt.expr.ident_ptr), len: (stmt.expr.ident_len) as i64 }))   # AGAST #1730
                    else if local != null
                        let loc: i32 = find_local(s, StrView { ptr: (stmt.expr.ident_ptr), len: (stmt.expr.ident_len) as i64 })
                        let val: i32 = next_reg(s)
                        emit_struct_load_or_defer(s, TypeKind.Struct, val, StrView { ptr: (lv_type_name(local)), len: (lv_type_name_len(local)) as i64 }, loc, no_name())
                        # AGAST #3564: a tail `v` for `let v = "..."` loads a
                        # %Span$u8; a `-> StrView` fn returns it as a %StrView.
                        var ret_name: *u8 = lv_type_name(local)
                        var ret_name_len: i32 = lv_type_name_len(local)
                        var ret_val: i32 = val
                        if is_layout_equiv_pair(StrView { ptr: (lv_type_name(local)), len: (lv_type_name_len(local)) as i64 }, StrView { ptr: (s.ret_type_name), len: (s.ret_type_name_len) as i64 }) == 1
                            ret_val = rebuild_layout_equiv(s, val, StrView { ptr: (lv_type_name(local)), len: (lv_type_name_len(local)) as i64 }, StrView { ptr: (s.ret_type_name), len: (s.ret_type_name_len) as i64 })
                            ret_name = s.ret_type_name
                            ret_name_len = s.ret_type_name_len
                        format_into(s, "  ret ")
                        emit_llvm_type_struct(s, TypeKind.Struct, StrView { ptr: (ret_name), len: (ret_name_len) as i64 })
                        format_into(s, " %.{ret_val}\n")
                    else if s.ret_sret == 1
                        emit_sret_ret_value(s, emit_struct_copy(s, stmt.expr, TypeKind.Struct))   # AGAST #1730
                    else
                        let val: i32 = emit_struct_copy(s, stmt.expr, TypeKind.Struct)
                        format_into(s, "  ret ")
                        emit_llvm_type_struct(s, TypeKind.Struct, StrView { ptr: (s.ret_type_name), len: (s.ret_type_name_len) as i64 })
                        format_into(s, " %.{val}\n")
                else if s.ret_sret == 1
                    emit_sret_ret_value(s, emit_struct_copy(s, stmt.expr, TypeKind.Struct))   # AGAST #1730
                else
                    # Function call or other expression returning struct.
                    # AGAST #1643: a tail `"..."` is a %Span$u8; coerce it to a
                    # %StrView return the way `return "..."` does (#168).
                    let val: i32 = emit_struct_copy(s, stmt.expr, TypeKind.Struct)
                    let ret_reg: i32 = coerce_struct_ret_value(s, stmt.expr, val, StrView { ptr: (s.ret_type_name), len: (s.ret_type_name_len) as i64 })
                    format_into(s, "  ret ")
                    emit_llvm_type_struct(s, TypeKind.Struct, StrView { ptr: (s.ret_type_name), len: (s.ret_type_name_len) as i64 })
                    format_into(s, " %.{ret_reg}\n")
            else
                # AGAST #1652: a tail `s` (`s: @&S`) from a `-> *S` fn is a `ptr`.
                # (`let`, not `var` + reassign: ritz0 mis-scopes a `var` that
                # shares its name with a sibling branch's `let`, #1755.)
                # LARB R43 (#3385): a tail if / match of an `-> f64` fn is a float slot.
                set_match_float_hint(s, stmt.expr, f.return_type, StrView { ptr: (f.return_type_name), len: (f.return_type_name_len) as i64 })
                let tail_raw: i32 = emit_expr(s, stmt.expr)
                let tail_i64: i32 = ptr_slot_value(s, f.return_type, stmt.expr, tail_raw)
                let tail_ptr: i32 = mut_ref_slot_value(s, f.return_type, stmt.expr, tail_i64)   # AGAST #2391
                # AGAST #2074: a `1.0` tail in an `-> f32` fn is fptrunc'd.
                let val: i32 = float_ret_value(s, tail_ptr, f.return_type, stmt.expr)
                if ty_int_bits(f.return_type) == 32
                    let trunc: i32 = ir_trunc_i64_i32(s.out, @s.reg_counter, val)
                    format_into(s, "  ret i32 %.{trunc}\n")
                else if f.return_type == TypeKind.Bool
                    # Comparisons zext to i64; trunc back for bool returns.
                    # (task-99 cluster #1)
                    let btrunc: i32 = ir_trunc_i64_i1(s.out, @s.reg_counter, val)
                    format_into(s, "  ret i1 %.{btrunc}\n")
                else if ty_int_bits(f.return_type) == 8
                    # Narrow byte return
                    let btrunc8: i32 = ir_trunc_i64_i8(s.out, @s.reg_counter, val)
                    format_into(s, "  ret i8 %.{btrunc8}\n")
                else if ty_int_bits(f.return_type) == 16
                    let btrunc16: i32 = ir_trunc_i64_i16(s.out, @s.reg_counter, val)
                    format_into(s, "  ret i16 %.{btrunc16}\n")
                else if f.return_type == TypeKind.Void
                    format_into(s, "  ret void\n")
                else
                    format_into(s, "  ret {llvm_text(ty_value_llvm(f.return_type))} %.{val}\n")
        else
            # AGAST #2823: only the LAST statement decides.  A `return` followed
            # by dead code (an `if` that returns, say) leaves the final block
            # open, and it needs the implicit tail's terminator.
            has_explicit_return = false
            if stmt.kind == StmtKind.Return
                has_explicit_return = true
            if stmt.next == null and stmt.kind == StmtKind.Match
                set_match_agg_hint(s, f.return_type)   # AGAST #3205: the tail match
                # LARB R43 (#3385): and in an `-> f64` fn it is a float slot.
                s.match_float_hint = slot_float_type(f.return_type, StrView { ptr: (f.return_type_name), len: (f.return_type_name_len) as i64 })
            if stmt.next == null and stmt.kind == StmtKind.If
                tail_if_slot(s, stmt, f.return_type, StrView { ptr: (f.return_type_name), len: (f.return_type_name_len) as i64 })
            emit_stmt(s, stmt, f.return_type)
        stmt = stmt.next

    emit_implicit_return_tail(s, has_explicit_return, f.return_type, StrView { ptr: (f.return_type_name), len: (f.return_type_name_len) as i64 }, body_tail_span(f.body))
    splice_entry_allocas(s, body_start)          # AGAST #4460: static allocas into entry:
    refuse_huge_frame(s, f, body_start)          # AGAST #3739: before any rewrite
    splice_deferred_struct_loads(s)              # AGAST #4461
    tag_intrinsic_target_features(s, attr_pos)   # AGAST #1737
    format_into(s, "}\n\n")

# =============================================================================
# Impl Block Method Emission
# =============================================================================

# Emit an impl block method with mangled name: Type_method
# For `impl Point { fn sum(...) }` we emit `Point_sum`
fn emit_impl_method(s: *EmitterState, ib: *ImplBlock, method: *FnDef)
    # AGAST #194: imported impl methods are skipped here — the file that
    # owns the impl will emit the body. Call sites elsewhere reach this
    # method through emit_extern_declarations (declares get auto-emitted
    # for any unresolved Type_method extern).
    if method.is_local == 0
        return

    # Check if already emitted (deduplication for imports)
    # Mangle name: Type_method
    # First build the mangled name: type_name + "_" + method_name
    # We'll emit directly rather than building a separate buffer

    # AGAST #2516: diagnostics name this method's file, not the last fn's.
    emitter_set_current_fn(method)
    variant_site_set(s.mono.pctx, diag_fn_source_file(method))   # AGAST #4609
    refuse_huge_byval_params(s, method)   # AGAST #3668
    frame_begin_fn(s, method.line, method.col)   # AGAST #3739
    s.fn_assert_kind = ASSERT_FN_PLAIN   # AGAST #1869: methods take no attributes
    s.reg_counter = 1
    packed_marks_reset(s)   # AGAST #4462: register numbers restart per fn
    s.label_counter = 0
    # AGAST #1335 — the entry block is unlabelled; see ENTRY_BLOCK_LABEL.
    # Set BEFORE clear_last_expr below, which stamps last_expr_label with it.
    s.current_label = ENTRY_BLOCK_LABEL
    s.local_count = 0
    narrowing_begin_fn(s, method.params)   # AGAST #1364
    s.break_label = -1
    s.continue_label = -1
    # ritz-task-1309 — drop the previous function's tracked expression value.
    # `label_counter` resets per function, so labels are NOT unique across the
    # module: a leftover `last_expr_label` from the previous function can
    # collide with a live label in this one and read as "defined here".
    # emit_fn clears this after its params; the method path never did.
    clear_last_expr(s)
    # ritz-task-193 — clear per-method locals map (matches emit_fn).
    s.local_map.clear()
    # Propagate this method's return-type name into emitter state so
    # StmtKind.Return handling (in emitter_stmt.ritz) emits the correct
    # `ret %T` rather than leaking the previous fn's `s.ret_type_name`.
    # Without this, `fn slice(self: @StrView, ...) -> StrView` ended up
    # emitting `ret %Token` because the Token-returning emit_fn ran
    # earlier and last set s.ret_type_name.
    s.ret_type_name = method.return_type_name
    s.ret_type_name_len = method.return_type_name_len
    # AGAST #1730 — large struct returns go through `ptr sret(%T) %ret.sret`.
    s.ret_sret = struct_ret_uses_sret(s, method.return_type, StrView { ptr: (method.return_type_name), len: (method.return_type_name_len) as i64 })
    s.fn_ret_type = method.return_type   # AGAST #1454
    s.sret_last_val = 0
    s.sret_last_slot = 0

    # Linkage follows visibility, as emit_fn's (fn_linkage); a generic impl's
    # instantiation (`Vec$u8_push`: '$' in the type name) is a monomorph.
    # Only the module declaring the impl defines a method (is_local, above),
    # so a non-generic method needs no cross-module dedup (AGAST #3386).
    # AGAST #4684: a trait impl on one written instantiation (`impl Bytes for
    # Span<u8>`, R36's revisit) has a '$' too, but it is one impl in one file
    # and importers only declare its methods.  As a linkonce_odr its copy is
    # dropped once -O2 inlines every local use, and an importer's call of
    # `Span$u8_as_strview` fails to link: it is external, as in ritz0.
    let im_name: StrView = StrView { ptr: ib.type_name, len: ib.type_name_len as i64 }
    let im_concrete_trait: bool = ib.trait_name != null and ib.type_params == null and ib.impl_args != null
    let im_is_monomorph: bool = not im_concrete_trait and im_name.find_byte('$') < im_name.len
    # A trait impl's method is reached through the trait, wherever the
    # compiler inserts the call (`Drop`'s drop at another module's scope end),
    # so it is external with or without `pub` (AGAST #3386).
    var im_pub: i32 = method.is_pub
    if ib.trait_name != null
        im_pub = 1
    if fn_is_odr(false, im_is_monomorph, im_pub, 0)
        emit_odr_comdat_start(s, StrView { ptr: (ib.type_name), len: (ib.type_name_len) as i64 }, StrView { ptr: (method.name), len: (method.name_len) as i64 })
    emit_sv(s, fn_linkage(false, im_is_monomorph, im_pub, 0))
    # For struct-returning impl methods (where `method.return_type_name`
    # is set), emit `%Type` so call sites that walk the impl table can
    # match the signature.  Other return types route through
    # emit_llvm_type which preserves the legacy i64 default for
    # TypeKind.Struct-without-name (impl methods whose return slot lost the
    # name during parse — strview_slice etc. land here).
    if s.ret_sret == 1
        format_into(s, "void")
    else
        emit_method_ret_type(s, method)
    let type_name_ir: String = ir_name(StrView { ptr: (ib.type_name), len: (ib.type_name_len) as i64 })
    let method_name_ir: String = ir_name(StrView { ptr: (method.name), len: (method.name_len) as i64 })
    format_into(s, " @{type_name_ir.as_view()}_{method_name_ir.as_view()}(")

    var param: *Param = method.params
    var first: bool = true
    if s.ret_sret == 1
        emit_sret_attr(s, StrView { ptr: (method.return_type_name), len: (method.return_type_name_len) as i64 })
        format_into(s, "%ret.sret")
        first = false
    if fn_sret_array(s, method) != null
        emit_sret_array_attr(s, fn_sret_array(s, method))   # AGAST #3181
        format_into(s, "%ret.sret")
        first = false
    while param != null
        if not first
            format_into(s, ", ")
        first = false
        # A lent `self` (task-99 cluster #1): callers pass the receiver as
        # `ptr <reg>`.  A by-value one is a by-value param (AGAST #2393).
        if param_self_is_ptr(param) == 1
            format_into(s, "ptr")
        else
            # emit_llvm_type_struct so struct params declare `%Tag` rather
            # than the i64 fallback — keeps the definition in sync with
            # call sites that walk the same FnDef.params.
            emit_param_llvm_type(s, param)   # AGAST #1739: large struct -> ptr byval
        let param_ir: String = ir_name(StrView { ptr: (param.name), len: (param.name_len) as i64 })
        format_into(s, " %{param_ir.as_view()}.arg")
        param = param.next

    # alignstack(16), "no-builtins" and (--stack-protector) sspstrong: see
    # emit_fn_attrs.
    emit_fn_attrs(s)
    let attr_pos: i64 = s.out.data.len    # AGAST #1737: target attrs go here
    if fn_is_odr(false, im_is_monomorph, im_pub, 0)
        format_into(s, " comdat")   # AGAST #201: see emit_odr_comdat_start
    format_into(s, " {\nentry:\n")
    # AGAST #1685, #4460: static allocas emitted below this point are
    # buffered and spliced back here when the body is complete.
    let body_start: i64 = s.out.data.len

    var param2: *Param = method.params
    while param2 != null
        if param2.param_type == TypeKind.Bool
            emit_bool_param_spill(s, param2)
            param2 = param2.next
            continue
        # A lent `self` is passed as `ptr` (see the header above).  One two
        # levels or more from its struct (`**S`, `@*S`) is bound at the levels it
        # declares, as any such param is: `self` is the pointer to the pointer,
        # so `*self` is the `*S` and `f(self)` passes the `**S` (AGAST #3071).
        let p2_self_ptr: i32 = param_self_is_ptr(param2)   # arrives as a `ptr`
        let p2_is_self: i32 = (p2_self_ptr == 1 and self_struct_levels(param2) < 2) as i32
        if p2_is_self == 0 and bind_byval_param(s, param2) == 1   # AGAST #1739
            param2 = param2.next
            continue
        if p2_is_self == 0 and bind_array_param(s, param2) == 1   # AGAST #2287
            param2 = param2.next
            continue
        let alloca_reg: i32 = entry_alloca_begin(s)
        if p2_self_ptr == 1
            format_into(s, "ptr")
        else
            emit_llvm_type_struct(s, param2.param_type, StrView { ptr: (param2.param_type_name), len: (param2.param_type_name_len) as i64 })
        format_into(s, "\n")
        entry_alloca_end(s)
        format_into(s, "  store ")
        if p2_self_ptr == 1
            format_into(s, "ptr")
        else
            emit_llvm_type_struct(s, param2.param_type, StrView { ptr: (param2.param_type_name), len: (param2.param_type_name_len) as i64 })
        let param2_ir: String = ir_name(StrView { ptr: (param2.name), len: (param2.name_len) as i64 })
        format_into(s, " %{param2_ir.as_view()}.arg, ptr %.{alloca_reg}\n")
        # Track parameter type including struct name for method calls
        if p2_is_self == 0 and bind_scalar_borrow_param(s, param2, alloca_reg) == 1
            param2 = param2.next
            continue
        if p2_is_self == 1
            # Register `self` as a pointer-to-struct local so `self.field`
            # member access resolves via the impl type. (task-99 cluster #1)
            # AGAST #3079: `self: @C` is an `@C`, read-only (was a `*C` plus
            # the holds_shared_ref flag, #2338).
            var self_kind: TypeKind = TypeKind.Ptr
            if param2.param_type == TypeKind.Ref and param2.is_self_borrow == 0
                self_kind = TypeKind.Ref
            # AGAST #4294: a `self` whose pointee is a primitive (`impl
            # Display for bool`, `self: @bool`) is no struct, so its deref
            # must load the scalar's width (an i1 for bool), not `%bool`.
            # Keep the impl target name only for a struct pointee.  Only a
            # reference pointee says: param_of_type leaves TypeKind.I64 in
            # param_pointee_type for a bare `self` / `self:&` (TypeKind.Struct),
            # and that must keep naming the impl's type.
            var self_name: *u8 = ib.type_name
            var self_name_len: i32 = ib.type_name_len
            var self_pointee: TypeKind = TypeKind.Struct
            let self_is_ref: i32 = (param2.param_type == TypeKind.Ref or param2.param_type == TypeKind.MutRef) as i32
            if self_is_ref == 1 and primitive_name_from_type(param2.param_pointee_type) != null
                self_name = null
                self_name_len = 0
                self_pointee = param2.param_pointee_type
            add_local_full(s, StrView { ptr: (param2.name), len: (param2.name_len) as i64 }, alloca_reg, self_kind, StrView { ptr: (self_name), len: (self_name_len) as i64 }, self_pointee, 0, TypeKind.Void)
            # AGAST #2286: `self:&` is passed as a `ptr`, so `@self` is that
            # pointer.  `self: @C` and `self: @&C` are references: `@self` is the
            # reference's address.
            if param2.param_type == TypeKind.Struct or param2.is_self_borrow == 1
                let self_loc: *LocalVar = find_local_struct_name(s, StrView { ptr: (param2.name), len: (param2.name_len) as i64 })
                lv_set_holds_lent_ptr(self_loc, 1)
        else
            match param2.param_type
                TypeKind.Ptr | TypeKind.PtrPtr | TypeKind.Ref | TypeKind.MutRef =>
                    add_array_view(s, StrView { ptr: (param2.name), len: (param2.name_len) as i64 }, alloca_reg, param2.param_type, param2.param_pointee_type, param2.param_pointee_array_size, param2.param_pointee_array_elem_type, StrView { ptr: (param2.param_type_name), len: (param2.param_type_name_len) as i64 })   # AGAST #2330
                    add_local_full(s, StrView { ptr: (param2.name), len: (param2.name_len) as i64 }, alloca_reg, param2.param_type, StrView { ptr: (param2.param_type_name), len: (param2.param_type_name_len) as i64 }, param2.param_pointee_type, 0, TypeKind.Void)
                    set_local_inner_pointee(s, StrView { ptr: (param2.name), len: (param2.name_len) as i64 }, param_local_inner_pointee(param2))   # AGAST #3131
                    set_local_inner_ref(s, StrView { ptr: (param2.name), len: (param2.name_len) as i64 }, param2.param_inner_ref)   # AGAST #2399
                    set_local_pointee_array(s, StrView { ptr: (param2.name), len: (param2.name_len) as i64 }, param2.param_pointee_array_size, param2.param_pointee_array_elem_type)  # AGAST #1953
                    bind_nd_pointee_param(s, param2)   # AGAST #2098
                    set_local_pointee_elem(s, StrView { ptr: (param2.name), len: (param2.name_len) as i64 }, param2.param_pointee_array_elem_pointee)
                    name_array_ptr_param(s, param2)   # AGAST #2548
                TypeKind.Struct =>
                    add_local_struct(s, StrView { ptr: (param2.name), len: (param2.name_len) as i64 }, alloca_reg, param2.param_type, StrView { ptr: (param2.param_type_name), len: (param2.param_type_name_len) as i64 })
                _ =>
                    add_local(s, StrView { ptr: (param2.name), len: (param2.name_len) as i64 }, alloca_reg, param2.param_type)
        set_local_fn_sig(s, StrView { ptr: (param2.name), len: (param2.name_len) as i64 }, param2.fn_sig)  # AGAST #1671
        mark_lent_param(s, param2)   # AGAST #2250
        param2 = param2.next

    own_begin_fn(s, method.params)   # AGAST #2158
    ref_begin_fn(s, method)          # AGAST #2336
    var has_explicit_return: bool = false
    var stmt: *Stmt = method.body
    while stmt != null
        if stmt.next == null and emit_array_return_if_stmt(s, stmt, ret_array_of(method)) == 1
            has_explicit_return = true   # AGAST #2305: a tail `if` / `else` of arrays
            stmt = stmt.next
            continue
        if stmt.next == null and stmt.kind == StmtKind.Expr and emit_lent_return(s, stmt.expr, method.return_type) == 1
            has_explicit_return = true   # AGAST #2279, as in emit_fn
            stmt = stmt.next
            continue
        # Check if this is the last statement and it's an expression (implicit return)
        if stmt.next == null and stmt.kind == StmtKind.Expr and method.return_type != TypeKind.Void
            has_explicit_return = true   # AGAST #4072: a procedure's tail is a statement
            struct_return_as_int_refused(s, stmt.expr, method.return_type)   # AGAST #3008
            own_tail_moves(s, stmt.expr)   # AGAST #2158
            if emit_array_return(s, stmt.expr, ret_array_of(method)) == 1
                has_explicit_return = true   # AGAST #2302: a `-> [N]T` tail is returned whole
            # Special handling for struct literal returns
            else if stmt.expr.kind == ExprKind.StructLit and method.return_type == TypeKind.Struct
                # Allocate space for the struct, initialize fields, load and return
                let alloca_reg: i32 = next_reg(s)
                let struct_name_sv: StrView = StrView { ptr: (stmt.expr.ident_ptr), len: (stmt.expr.ident_len) as i64 }
                let struct_name_ir: String = ir_name(struct_name_sv)
                entry_alloca_reg_begin_named(s, alloca_reg)
                format_into(s, "{struct_name_ir.as_view()}\n")
                entry_alloca_reg_end(s)
                emit_struct_lit_to_alloca(s, stmt.expr, alloca_reg)
                if s.ret_sret == 1
                    emit_sret_ret_from_ptr(s, alloca_reg)   # AGAST #1730
                else
                    # Load the struct value and return it
                    let val: i32 = next_reg(s)
                    format_into(s, "  %.{val} = load %{struct_name_ir.as_view()}, ptr %.{alloca_reg}\n")
                    format_into(s, "  ret %{struct_name_ir.as_view()} %.{val}\n")
            else
                # AGAST #1652: a tail `s` (`s: @&S`) from a `-> *S` fn is a `ptr`.
                # (`let`, not `var` + reassign: ritz0 mis-scopes a `var` that
                # shares its name with a sibling branch's `let`, #1755.)
                # LARB R43 (#3385): a tail if / match of an `-> f64` fn is a float slot.
                set_match_float_hint(s, stmt.expr, method.return_type, StrView { ptr: (method.return_type_name), len: (method.return_type_name_len) as i64 })
                let tail_raw: i32 = emit_struct_copy(s, stmt.expr, method_tail_copy_type(method))
                let tail_i64: i32 = ptr_slot_value(s, method.return_type, stmt.expr, tail_raw)
                let tail_ptr: i32 = mut_ref_slot_value(s, method.return_type, stmt.expr, tail_i64)   # AGAST #2391
                # AGAST #2074: a `1.0` tail in an `-> f32` method is fptrunc'd.
                let val: i32 = float_ret_value(s, tail_ptr, method.return_type, stmt.expr)
                if ty_int_bits(method.return_type) == 32
                    let trunc: i32 = ir_trunc_i64_i32(s.out, @s.reg_counter, val)
                    format_into(s, "  ret i32 %.{trunc}\n")
                else if method.return_type == TypeKind.Bool
                    # Comparisons zext to i64 in emit_binary; trunc back to
                    # i1 for bool-returning methods. (task-99 cluster #1)
                    let btrunc: i32 = ir_trunc_i64_i1(s.out, @s.reg_counter, val)
                    format_into(s, "  ret i1 %.{btrunc}\n")
                else if ty_int_bits(method.return_type) == 8
                    let btrunc8: i32 = ir_trunc_i64_i8(s.out, @s.reg_counter, val)
                    format_into(s, "  ret i8 %.{btrunc8}\n")
                else if ty_int_bits(method.return_type) == 16
                    let btrunc16: i32 = ir_trunc_i64_i16(s.out, @s.reg_counter, val)
                    format_into(s, "  ret i16 %.{btrunc16}\n")
                else if method.return_type == TypeKind.Void
                    format_into(s, "  ret void\n")
                else if method_returns_named_struct(method)
                    # Struct-returning impl method.  Function header
                    # emits `define %T @T_method(...)` so the body must
                    # `ret %T <val>`.  Two shapes:
                    #
                    #  * ExprKind.Ident holding a pointer: emit_expr loaded
                    #    the local as i64 (ptr-as-int).  Need
                    #    inttoptr+load to materialise a typed struct.
                    #
                    #  * ExprKind.Call (`return strview_slice(...)`), or a
                    #    struct local such as a by-value `self`: that's
                    #    already a `%T` register, so just `ret %T <val>`.
                    #
                    # AGAST #2351: only a LOCAL can hold a pointer.  A bare
                    # `None` is an ident but no local: emit_expr built the
                    # aggregate, so it takes the value path, as in emit_fn.
                    let tail_is_local: i32 = (stmt.expr.kind == ExprKind.Ident and find_local(s, StrView { ptr: (stmt.expr.ident_ptr), len: (stmt.expr.ident_len) as i64 }) >= 0) as i32
                    let tail_holds_ptr: i32 = (tail_is_local == 1 and struct_value_local(s, stmt.expr) == null) as i32
                    if tail_holds_ptr == 1 and s.ret_sret == 1
                        let spp: i32 = ir_inttoptr_ptr(s.out, @s.reg_counter, val)
                        emit_sret_ret_from_ptr(s, spp)   # AGAST #1730
                    else if s.ret_sret == 1
                        emit_sret_ret_value(s, val)   # AGAST #1730
                    else if tail_holds_ptr == 1
                        let pp: i32 = ir_inttoptr_ptr(s.out, @s.reg_counter, val)
                        let sv: i32 = next_reg(s)
                        let ret_type_ir: String = ir_name(StrView { ptr: (method.return_type_name), len: (method.return_type_name_len) as i64 })
                        format_into(s, "  %.{sv} = load %{ret_type_ir.as_view()}, ptr %.{pp}\n")
                        format_into(s, "  ret %{ret_type_ir.as_view()} %.{sv}\n")
                    else
                        # AGAST #1643: a tail `"..."` is a %Span$u8; coerce
                        # it to a %StrView return (same as emit_fn).
                        let ret_reg: i32 = coerce_struct_ret_value(s, stmt.expr, val, StrView { ptr: (method.return_type_name), len: (method.return_type_name_len) as i64 })
                        let ret_type_ir2: String = ir_name(StrView { ptr: (method.return_type_name), len: (method.return_type_name_len) as i64 })
                        format_into(s, "  ret %{ret_type_ir2.as_view()} %.{ret_reg}\n")
                else
                    # AGAST #2565: typed as the `define` line types it.
                    format_into(s, "  ret ")
                    emit_method_ret_type(s, method)
                    format_into(s, " %.{val}\n")
        else
            # AGAST #2823: only the LAST statement decides.  A `return` followed
            # by dead code (an `if` that returns, say) leaves the final block
            # open, and it needs the implicit tail's terminator.
            has_explicit_return = false
            if stmt.kind == StmtKind.Return
                has_explicit_return = true
            if stmt.next == null and stmt.kind == StmtKind.Match
                set_match_agg_hint(s, method.return_type)   # AGAST #3205: the tail match
                # LARB R43 (#3385): and in an `-> f64` fn it is a float slot.
                s.match_float_hint = slot_float_type(method.return_type, StrView { ptr: (method.return_type_name), len: (method.return_type_name_len) as i64 })
            if stmt.next == null and stmt.kind == StmtKind.If
                tail_if_slot(s, stmt, method.return_type, StrView { ptr: (method.return_type_name), len: (method.return_type_name_len) as i64 })
            emit_stmt(s, stmt, method.return_type)
        stmt = stmt.next

    # AGAST #1573 — same tail as emit_fn: close the final block if the body
    # did not already end in a `ret`.
    emit_implicit_return_tail(s, has_explicit_return, method.return_type, StrView { ptr: (method.return_type_name), len: (method.return_type_name_len) as i64 }, body_tail_span(method.body))
    splice_entry_allocas(s, body_start)          # AGAST #4460: static allocas into entry:
    refuse_huge_frame(s, method, body_start)     # AGAST #3739: before any rewrite
    splice_deferred_struct_loads(s)              # AGAST #4461
    tag_intrinsic_target_features(s, attr_pos)   # AGAST #1737
    format_into(s, "}\n\n")

# =============================================================================
# Module Emission
# =============================================================================

fn emit_string_constants(s: *EmitterState)
    for i in 0..namelist_count(@s.strings)
        let data: *u8 = namelist_name(@s.strings, i)
        let len: i32 = namelist_len(@s.strings, i)
        format_into(s, "@.str.{i as i64} = private constant [{(len + 1) as i64} x i8] c\"")
        for j in 0..len
            emit_string_byte(s, *(data + j))
        format_into(s, "\\00\"\n")

# AGAST #3585: 1 if this .ll defines imported `f` available_externally: an
# eligible [[inline]] fn (fn_inline_import) whose name this file doesn't
# define itself.  emit_module's fn loop emits exactly these.
fn inline_import_defines(ctx: *ParseCtx, m: *Module, f: *FnDef) -> i32
    if f.is_local != 0 or fn_inline_import(ctx, f) == 0
        return 0
    if is_local_function(m, StrView { ptr: (f.name), len: (f.name_len) as i64 }) == 1
        return 0
    1

# 1 if some fn named `name` is one inline_import_defines picks, so no
# `declare` of it may be emitted beside its definition.
fn inline_import_defined(ctx: *ParseCtx, m: *Module, name_sv: StrView) -> i32
    var name: *u8 = name_sv.ptr
    var len: i32 = name_sv.len as i32
    var f: *FnDef = m.functions
    while f != null
        if f.name_len == len and memcmp(f.name, name, len as i64) == 0 and inline_import_defines(ctx, m, f) == 1
            return 1
        f = f.next
    0

fn is_local_function(m: *Module, name_sv: StrView) -> i32
    var name: *u8 = name_sv.ptr
    var len: i32 = name_sv.len as i32
    var f: *FnDef = m.functions
    while f != null
        # AGAST #194: a fn is "local" only when this .ll actually
        # defines its body (is_local == 1, set by main() for fns
        # parsed from the input file, and by monomorph for cloned
        # instantiations). Imported fns merged from other source
        # files carry is_local == 0 and must NOT short-circuit the
        # extern-declare path here — otherwise call sites in the
        # current .ll would reference unresolved symbols.
        if f.body != null and f.is_local == 1 and name_eq(StrView { ptr: (f.name), len: (f.name_len) as i64 }, name_sv) == 1
            return 1
        f = f.next
    # Also check impl block methods (mangled as Type_method). Without this,
    # emit_extern_declarations emits a conflicting `declare` for any impl
    # method referenced from a call site (e.g. `tag.eq()` -> `Tag_eq`),
    # clashing with the `define` emitted by emit_impl_method and producing
    # LLVM's "invalid redefinition" error.
    # AGAST #194: same rationale as the m.functions branch above — only
    # methods this .ll actually defines (is_local==1) count as local for the
    # extern-declare suppression check.
    let method: *FnDef = find_impl_method_by_symbol(m, StrView { ptr: (name), len: (len) as i64 })
    if method != null and method.is_local == 1
        return 1
    0

# AGAST #167: Recognize LLVM x86 intrinsic names registered as externs by
# emit_x86_simd_intrinsic.  These need typed `declare <vec> @llvm.x86.foo(<vec>...)`
# instead of the generic `declare i64 @name(...)`.
fn is_llvm_x86_intrinsic_name(name_sv: StrView) -> i32
    var name: *u8 = name_sv.ptr
    var len: i32 = name_sv.len as i32
    # Cheap prefix match on "llvm.x86.".
    if len < 9
        return 0
    if *(name + 0) != 'l'
        return 0
    if *(name + 1) != 'l'
        return 0
    if *(name + 2) != 'v'
        return 0
    if *(name + 3) != 'm'
        return 0
    if *(name + 4) != '.'
        return 0
    if *(name + 5) != 'x'
        return 0
    if *(name + 6) != '8'
        return 0
    if *(name + 7) != '6'
        return 0
    if *(name + 8) != '.'
        return 0
    1

# Emit a `declare` for one of the supported x86 SIMD LLVM intrinsics.  Keeps
# signature data co-located with name detection so the ritz1 dispatch and
# the module-level extern emission stay in sync.
fn emit_llvm_x86_intrinsic_decl(s: *EmitterState, name_sv: StrView)
    if name_eq(name_sv, "llvm.x86.sha256rnds2") == 1
        format_into(s, "declare <4 x i32> @llvm.x86.sha256rnds2(<4 x i32>, <4 x i32>, <4 x i32>)\n")
        return
    if name_eq(name_sv, "llvm.x86.sha256msg1") == 1
        format_into(s, "declare <4 x i32> @llvm.x86.sha256msg1(<4 x i32>, <4 x i32>)\n")
        return
    if name_eq(name_sv, "llvm.x86.sha256msg2") == 1
        format_into(s, "declare <4 x i32> @llvm.x86.sha256msg2(<4 x i32>, <4 x i32>)\n")
        return
    if name_eq(name_sv, "llvm.x86.aesni.aesenc") == 1
        format_into(s, "declare <2 x i64> @llvm.x86.aesni.aesenc(<2 x i64>, <2 x i64>)\n")
        return
    if name_eq(name_sv, "llvm.x86.aesni.aesenclast") == 1
        format_into(s, "declare <2 x i64> @llvm.x86.aesni.aesenclast(<2 x i64>, <2 x i64>)\n")
        return
    if name_eq(name_sv, "llvm.x86.aesni.aesdec") == 1
        format_into(s, "declare <2 x i64> @llvm.x86.aesni.aesdec(<2 x i64>, <2 x i64>)\n")
        return
    if name_eq(name_sv, "llvm.x86.aesni.aesdeclast") == 1
        format_into(s, "declare <2 x i64> @llvm.x86.aesni.aesdeclast(<2 x i64>, <2 x i64>)\n")
        return
    if name_eq(name_sv, "llvm.x86.aesni.aesimc") == 1
        format_into(s, "declare <2 x i64> @llvm.x86.aesni.aesimc(<2 x i64>)\n")
        return
    if name_eq(name_sv, "llvm.x86.aesni.aeskeygenassist") == 1
        format_into(s, "declare <2 x i64> @llvm.x86.aesni.aeskeygenassist(<2 x i64>, i8)\n")
        return
    if name_eq(name_sv, "llvm.x86.sse2.psad.bw") == 1
        format_into(s, "declare <2 x i64> @llvm.x86.sse2.psad.bw(<16 x i8>, <16 x i8>)\n")
        return
    if name_eq(name_sv, "llvm.x86.pclmulqdq") == 1
        format_into(s, "declare <2 x i64> @llvm.x86.pclmulqdq(<2 x i64>, <2 x i64>, i8)\n")
        return
    # Unknown llvm.x86.* — fall back to a vague declare so the IR at least
    # parses (caller handles the type-check).
    let name_ir: String = ir_name(name_sv)
    format_into(s, "declare void @{name_ir.as_view()}(...)\n")

# AGAST #1739: 1 when `f` has a large by-value struct param (param_uses_byval).
fn fn_has_byval_param(s: *EmitterState, f: *FnDef) -> i32
    if f == null
        return 0
    var p: *Param = f.params
    while p != null
        if param_uses_byval(s, p) == 1
            return 1
        p = p.next
    0

# Refuse each param of `f` passed `ptr byval` at 4 GiB or more, at its name,
# in ritz0's words (AGAST #3668).  Every fn, method and extern the module
# defines comes through here, called or not.  This is a limit of the byval
# lowering, so it is decided from the emitter's own byval measure.
fn refuse_huge_byval_params(s: *EmitterState, f: *FnDef)
    var p: *Param = f.params
    while p != null
        let bytes: i64 = param_byval_bytes(s, p)
        if bytes >= BYVAL_MAX_BYTES
            let name: StrView = StrView { ptr: p.name, len: p.name_len as i64 }
            var ty: String = string_new()
            put_param_type(@&ty, p)
            var msg: String = string_new()
            format_into(@&msg, "parameter `{name}` is {bytes} bytes, too large to pass by value (LLVM's byval limit is 4 GiB); take it by reference: `{name}: @{ty.as_view()}` or `{name}: @&{ty.as_view()}`")
            emit_nd_error_sv(s, p.name_span.line, p.name_span.col, msg.as_view())
        p = p.next

# AGAST #1985: every non-intrinsic `declare` is "no-builtins", as every
# definition is (#1313, emit_fn). LLVM's InferFunctionAttrs recognises a
# declaration by its name: once a prototype matches libc's, an imported
# ritzlib `realloc` gains allocptr/allockind/noalias and -O2 folds
# `realloc(p, 0) == null` to false (ritz0's #1917). `llvm.*` intrinsic
# declarations never come through here.
fn emit_declare_attrs_nl(s: *EmitterState)
    format_into(s, " \"no-builtins\"\n")

# AGAST #1739: a `(...)` declare cannot carry a `byval` attribute, so a fn
# with a large by-value struct param is declared with its concrete
# signature, written exactly as emit_fn writes the definition (sret first).
# `is_method` = 1 for an impl method: emit_impl_method spells its `self`
# param as plain `ptr` whatever its declared type, so the declare must too.
fn emit_concrete_extern_declare(s: *EmitterState, f: *FnDef, name_sv: StrView, is_method: i32)
    var name: *u8 = name_sv.ptr
    var name_len: i32 = name_sv.len as i32
    let sret: i32 = struct_ret_uses_sret(s, f.return_type, StrView { ptr: (f.return_type_name), len: (f.return_type_name_len) as i64 })
    format_into(s, "declare ")
    emit_sv(s, llvm_text(fn_callconv_kw(s.mono.pctx, f)))
    if sret == 1
        format_into(s, "void")
    else
        emit_fn_ret_llvm_type(s, f)   # AGAST #2302
    let name_ir: String = ir_name(StrView { ptr: (name), len: (name_len) as i64 })
    format_into(s, " @{name_ir.as_view()}(")
    var first: bool = true
    if sret == 1
        let ret_type_ir: String = ir_name(StrView { ptr: (f.return_type_name), len: (f.return_type_name_len) as i64 })
        format_into(s, "ptr sret(%{ret_type_ir.as_view()})")
        first = false
    if fn_sret_array(s, f) != null
        format_into(s, "ptr sret(")   # AGAST #3181
        emit_array_value_llvm_type(s, fn_sret_array(s, f))
        format_into(s, ")")
        first = false
    var p: *Param = f.params
    while p != null
        if not first
            format_into(s, ", ")
        first = false
        if is_method == 1 and param_self_is_ptr(p) == 1
            format_into(s, "ptr")
        else
            emit_param_llvm_type(s, p)
        p = p.next
    format_into(s, ")")
    emit_declare_attrs_nl(s)

# The hooks emit_platform_hooks defines weak in a test binary.
fn is_platform_hook_name(name: StrView) -> i32
    if name_eq(name, "ritz_platform_fatal") == 1
        return 1
    if name_eq(name, "ritz_platform_page_map") == 1
        return 1
    if name_eq(name, "ritz_platform_page_unmap") == 1
        return 1
    0

fn emit_extern_declarations(s: *EmitterState)
    # Emit remaining external declarations (non-local functions)
    for i in 0..namelist_count(@s.externs)
        let ex_name: *u8 = namelist_name(@s.externs, i)
        let ex_len: i32 = namelist_len(@s.externs, i)
        # AGAST #167: x86 LLVM intrinsics (`llvm.x86.sha256rnds2`, etc.) need
        # vector-typed declarations so clang accepts the inline calls emitted
        # by emit_x86_simd_intrinsic.  Detect by `llvm.x86.` prefix and emit
        # the right vector signature; everything else falls through to the
        # generic `declare i64 @name(...)` path below.
        if is_llvm_x86_intrinsic_name(StrView { ptr: (ex_name), len: (ex_len) as i64 }) == 1
            emit_llvm_x86_intrinsic_decl(s, StrView { ptr: (ex_name), len: (ex_len) as i64 })
            continue
        # A test binary defines the platform hooks weak (emit_platform_hooks);
        # a `declare` beside that `define` is an invalid redefinition (#4648:
        # gvec's generic Vec.set calls `extern fn ritz_platform_fatal`).
        if g_emit_test_table == 1 and is_platform_hook_name(StrView { ptr: (ex_name), len: (ex_len) as i64 }) == 1
            continue
        # Skip if this function is defined in this module (an [[inline]]
        # import defined available_externally included, AGAST #3585)
        if is_local_function(s.module, StrView { ptr: (ex_name), len: (ex_len) as i64 }) == 0 and inline_import_defined(s.mono.pctx, s.module, StrView { ptr: (ex_name), len: (ex_len) as i64 }) == 0
                # Look up the function's return type from its definition
                var fn_def: *FnDef = find_fn(s, StrView { ptr: (ex_name), len: (ex_len) as i64 })
                # AGAST #1518: an imported impl method (`Type_method`) is not
                # in fn_map; take its signature from the impl table so the
                # declare matches the call site (sret / byval / i32 / struct).
                var is_method: i32 = 0
                if fn_def == null
                    fn_def = find_impl_method_by_symbol(s.module, StrView { ptr: (ex_name), len: (ex_len) as i64 })
                    if fn_def != null
                        is_method = 1
                # AGAST #4356: a private free fn is declared under the mangled
                # symbol its defining object defines (fn_symbol); a method is
                # not (twins may not share `T_m`, type_twins.ritz).
                var sym_name: *u8 = ex_name
                var sym_len: i32 = ex_len
                if is_method == 0 and fn_private_free(fn_def) == 1
                    sym_name = fn_symbol(fn_def, @sym_len)
                # AGAST #2302: a `-> [N]T` is declared `[N x T]`, its signature whole.
                if fn_has_byval_param(s, fn_def) == 1 or ret_array_of(fn_def) != null
                    emit_concrete_extern_declare(s, fn_def, StrView { ptr: (sym_name), len: (sym_len) as i64 }, is_method)   # AGAST #1739
                else if fn_def != null and struct_ret_uses_sret(s, fn_def.return_type, StrView { ptr: (fn_def.return_type_name), len: (fn_def.return_type_name_len) as i64 }) == 1
                    # AGAST #1730 — the call sites pass `ptr sret(%T)`.
                    let sym_ir: String = ir_name(StrView { ptr: (sym_name), len: (sym_len) as i64 })
                    format_into(s, "declare ")
                    emit_sv(s, llvm_text(fn_callconv_kw(s.mono.pctx, fn_def)))
                    format_into(s, "void @{sym_ir.as_view()}(...)")
                    emit_declare_attrs_nl(s)
                else if fn_def != null and fn_def.return_type == TypeKind.Struct
                    let ret_ty_ir: String = ir_name(StrView { ptr: (fn_def.return_type_name), len: (fn_def.return_type_name_len) as i64 })
                    let sym_ir2: String = ir_name(StrView { ptr: (sym_name), len: (sym_len) as i64 })
                    format_into(s, "declare ")
                    emit_sv(s, llvm_text(fn_callconv_kw(s.mono.pctx, fn_def)))
                    format_into(s, "%{ret_ty_ir.as_view()} @{sym_ir2.as_view()}(...)")
                    emit_declare_attrs_nl(s)
                else if fn_def != null and fn_def.return_type == TypeKind.I32
                    let sym_ir3: String = ir_name(StrView { ptr: (sym_name), len: (sym_len) as i64 })
                    format_into(s, "declare ")
                    emit_sv(s, llvm_text(fn_callconv_kw(s.mono.pctx, fn_def)))
                    format_into(s, "i32 @{sym_ir3.as_view()}(...)")
                    emit_declare_attrs_nl(s)
                else if fn_def != null and fn_def.return_type == TypeKind.Void
                    let sym_ir4: String = ir_name(StrView { ptr: (sym_name), len: (sym_len) as i64 })
                    format_into(s, "declare ")
                    emit_sv(s, llvm_text(fn_callconv_kw(s.mono.pctx, fn_def)))
                    format_into(s, "void @{sym_ir4.as_view()}(...)")
                    emit_declare_attrs_nl(s)
                else
                    let sym_ir5: String = ir_name(StrView { ptr: (sym_name), len: (sym_len) as i64 })
                    format_into(s, "declare ")
                    emit_sv(s, llvm_text(fn_callconv_kw(s.mono.pctx, fn_def)))
                    format_into(s, "i64 @{sym_ir5.as_view()}(...)")
                    emit_declare_attrs_nl(s)
    if namelist_count(@s.externs) > 0
        format_into(s, "\n")
# Returns 1 if every value-type struct dependency of `st` has already been
# emitted, 0 otherwise.  Pointer fields (TypeKind.Ptr / TypeKind.PtrPtr) are not
# dependencies — LLVM's opaque `ptr` lets us reference a forward-declared
# struct through a pointer.  Embedded structs (TypeKind.Struct) and arrays of
# structs (TypeKind.Array whose elem is TypeKind.Struct) require the dependent
# struct's body to be in scope before the use, so they DO count.
# ritz-task-169.
fn struct_deps_satisfied(s: *EmitterState, st: *StructDef) -> i32
    var field: *StructField = st.fields
    while field != null
        match field.field_type
            TypeKind.Struct =>
                if field.field_type_name != null
                    if field.field_type_name_len > 0
                        if was_struct_emitted(s, StrView { ptr: (field.field_type_name), len: (field.field_type_name_len) as i64 }) == 0
                            return 0
            TypeKind.Array =>
                if field.array_elem_type == TypeKind.Struct
                    if field.array_elem_type_name != null
                        if field.array_elem_type_name_len > 0
                            if was_struct_emitted(s, StrView { ptr: (field.array_elem_type_name), len: (field.array_elem_type_name_len) as i64 }) == 0
                                return 0
                # AGAST #2097: `m: [2][2]P` holds P by value too.
                let fsh: *ArrayShape = field.array_shape
                if fsh != null and fsh.leaf_type == TypeKind.Struct and fsh.leaf_name_len > 0
                    if was_struct_emitted(s, StrView { ptr: (fsh.leaf_name), len: (fsh.leaf_name_len) as i64 }) == 0
                        return 0
            _ => pass
        field = field.next
    1

# Emit a single `%Name = type { ... }` definition and mark it emitted.
fn emit_one_struct_type(s: *EmitterState, st: *StructDef)
    mark_struct_emitted(s, StrView { ptr: (st.name), len: (st.name_len) as i64 })
    let name_ir: String = ir_name(StrView { ptr: (st.name), len: (st.name_len) as i64 })
    # `[[packed]]` (AGAST #1847): an LLVM packed struct, no padding.
    let packed: i32 = struct_is_packed(s.mono.pctx, st)
    if packed == 1
        format_into(s, "%{name_ir.as_view()} = type <{")
    else
        format_into(s, "%{name_ir.as_view()} = type {")
    var first: bool = true
    var field: *StructField = st.fields
    while field != null
        if not first
            format_into(s, ", ")
        first = false
        emit_field_llvm_type(s, field)
        field = field.next
    if packed == 1
        format_into(s, "}>\n")
    else
        format_into(s, "}\n")

fn emit_struct_types(s: *EmitterState)
    # Topologically sort struct emission by value-field containment so that
    # `alloca %T` and `getelementptr %T, ...` never see an opaque %T.
    # Source-order emission was breaking when an earlier-listed struct
    # embedded a later-listed one (e.g. `struct PageStore { index:
    # [100]IndexEntry, ... }` parsed before its imported deps Db/Cache, or
    # `struct TomeServer { task_server: TaskServer, ... }` parsed before
    # ritzlib's TaskServer).  ritz-task-169.
    #
    # Pass 1..N: emit any unemitted struct whose value-field deps are all
    # already emitted; loop until a pass makes no progress.
    var made_progress: i32 = 1
    while made_progress == 1
        made_progress = 0
        var st: *StructDef = s.module.structs
        while st != null
            if st.type_params != null
                st = st.next
                continue
            if was_struct_emitted(s, StrView { ptr: (st.name), len: (st.name_len) as i64 }) == 1
                st = st.next
                continue
            if struct_deps_satisfied(s, st) == 0
                st = st.next
                continue
            emit_one_struct_type(s, st)
            made_progress = 1
            st = st.next

    # Final pass: emit anything still pending in source order.  This catches
    # structs whose declared deps aren't in s.module.structs (unresolved
    # imports, name typos, etc.) — we'd already have produced broken IR for
    # those in the legacy path, so falling back here is no regression.
    var st2: *StructDef = s.module.structs
    while st2 != null
        if st2.type_params != null
            st2 = st2.next
            continue
        if was_struct_emitted(s, StrView { ptr: (st2.name), len: (st2.name_len) as i64 }) == 1
            st2 = st2.next
            continue
        emit_one_struct_type(s, st2)
        st2 = st2.next

    format_into(s, "\n")

# Emit one `%Result$... = type { i8, [P x i8], [N x i8] }` decl (dedup via
# emitted_structs) for the tagged-enum name at (name, len).  No-op when
# name doesn't look like Result$/Option$, which lets callers funnel every
# type name they see through here unconditionally.  ritz-task-133.
fn emit_tagged_enum_decl_once(s: *EmitterState, name_sv: StrView)
    var name: *u8 = name_sv.ptr
    var len: i32 = name_sv.len as i32
    if name == null or len == 0
        return
    if is_tagged_enum_type(StrView { ptr: (name), len: (len) as i64 }) == 0
        return
    # Skip template-shaped names like `Option$T` / `Result$E` — these are
    # the raw generic placeholders that leak in from function signatures
    # declared against an unspecialized type parameter.  Concrete
    # instantiations (Option$i32, Option$Vec_u8) are what we want to emit.
    # Also skip empty suffix (`Option$`) which happens for u-types whose
    # mangling table doesn't know the suffix letter — those still work
    # because they share a single struct layout, but we only want one
    # emission regardless.  A "template" suffix is a single ASCII upper
    # letter A..Z immediately after `$` that the module doesn't declare as a
    # struct or enum; any multi-char or lowercase suffix (i32/u8/Vec_u8/...)
    # is concrete.  AGAST #2432/#2420: `struct P` / `enum C` are real types,
    # and `Option$P` skipped with the placeholders left clang an unsized
    # `%Option$P`.  Ask the module, not the name's length.
    let suffix_start: i32 = 7
    if len - suffix_start == 1
        let ch: i32 = *(name + suffix_start) as i32
        if ch >= 'A' and ch <= 'Z'
            if is_concrete_payload_type(s, StrView { ptr: (name + suffix_start), len: (1) as i64 }, 1) == 0
                return
    if was_struct_emitted(s, StrView { ptr: (name), len: (len) as i64 }) == 1
        return
    mark_struct_emitted(s, StrView { ptr: (name), len: (len) as i64 })
    let name_ir: String = ir_name(StrView { ptr: (name), len: (len) as i64 })
    # AGAST #1898: ritz0's layout, the pad field always present (field 2 is
    # the payload); see tagged_enum_layout in emitter_core.
    var pad: i64 = 0
    let n: i64 = tagged_enum_layout(s, StrView { ptr: (name), len: (len) as i64 }, @pad)
    format_into(s, "%{name_ir.as_view()} = type {{ i8, [{pad} x i8], [{n} x i8] }}\n")
    emit_tagged_enum_arg_decls(s, StrView { ptr: (name), len: (len) as i64 })

# AGAST #2435: an Option / Result its arguments name is declared with it.
# `Some(Some(5))` in an `Option<Option<i64>>` builds the inner `%Option$i64`,
# which nothing else in the module may name: undeclared, its alloca was an
# unsized type clang refused.  A named type may be declared after its first use.
fn emit_tagged_enum_arg_decls(s: *EmitterState, name_sv: StrView)
    var name: *u8 = name_sv.ptr
    var len: i32 = name_sv.len as i32
    var t_len: i32 = 0
    let t: *u8 = tagged_enum_arg(s, StrView { ptr: (name), len: (len) as i64 }, 0, @t_len)   # Some's / Ok's
    if t != null
        emit_tagged_enum_decl_once(s, StrView { ptr: (t), len: (t_len) as i64 })
    var e_len: i32 = 0
    let e: *u8 = tagged_enum_arg(s, StrView { ptr: (name), len: (len) as i64 }, 1, @e_len)   # Err's; null for an Option
    if e != null
        emit_tagged_enum_decl_once(s, StrView { ptr: (e), len: (e_len) as i64 })

# The instances a signature names: its return's and each param's, and those
# of any fn type among them (`look: fn(u16) -> Option<O>`, `-> fn() -> ..`).
# AGAST #3979: a fn type's own signature went unscanned, so an instance only
# it named was undeclared and `alloca %Option$O` an unsized type clang refused.
# `sig` is a fn's, or a fn type's (the parser builds both as FnDefs).
fn emit_tagged_enum_sig_decls(s: *EmitterState, sig: *FnDef)
    if sig == null
        return
    if sig.return_type == TypeKind.Struct or sig.return_type == TypeKind.Ptr or sig.return_type == TypeKind.Ref or sig.return_type == TypeKind.MutRef
        emit_tagged_enum_decl_once(s, StrView { ptr: (sig.return_type_name), len: (sig.return_type_name_len) as i64 })
    emit_tagged_enum_sig_decls(s, sig.ret_fn_sig)
    var p: *Param = sig.params
    while p != null
        if p.param_type == TypeKind.Struct or p.param_type == TypeKind.Ptr or p.param_type == TypeKind.Ref or p.param_type == TypeKind.MutRef
            emit_tagged_enum_decl_once(s, StrView { ptr: (p.param_type_name), len: (p.param_type_name_len) as i64 })
        emit_tagged_enum_sig_decls(s, p.fn_sig)
        p = p.next

# Walk every fn / param / var-decl type name in the module and emit a
# tagged-enum struct decl for each unique Result$/Option$ instantiation.
# Must run AFTER emit_struct_types so user-declared types get dibs on the
# emitted-names table; before any IR that references `%Result$...`.
fn emit_tagged_enum_types(s: *EmitterState)
    var f: *FnDef = s.module.functions
    while f != null
        # AGAST #186: scan TypeKind.Ptr/TypeKind.Ref/TypeKind.MutRef too so monomorph-
        # produced fns like `option_is_none$ptr_Page(opt: *Option$ptr_Page)`
        # get their `%Option$ptr_Page` decl emitted.  Original code only
        # looked at TypeKind.Struct params/returns and missed pointer-to-enum.
        emit_tagged_enum_sig_decls(s, f)
        # Walk body for let-bindings with explicit enum types
        emit_tagged_enum_scan_stmts(s, f.body)
        f = f.next

    # Impl-block methods carry the same shape (generic dispatch is lowered
    # to FnDefs elsewhere — this is defensive).
    var ib: *ImplBlock = s.module.impls
    while ib != null
        var meth: *FnDef = ib.methods
        while meth != null
            emit_tagged_enum_sig_decls(s, meth)
            emit_tagged_enum_scan_stmts(s, meth.body)
            meth = meth.next
        ib = ib.next

    # Concrete struct fields (`maybe: Option<i64>`): every struct's type decl
    # is emitted, so its field types must be too.  Only bodies used to reach
    # them; an import's bodies are stripped since G9b (AGAST #1899).
    var fst: *StructDef = s.module.structs
    while fst != null
        if fst.type_params == null
            var fld: *StructField = fst.fields
            while fld != null
                emit_tagged_enum_decl_once(s, StrView { ptr: (fld.field_type_name), len: (fld.field_type_name_len) as i64 })
                emit_tagged_enum_decl_once(s, StrView { ptr: (fld.array_elem_type_name), len: (fld.array_elem_type_name_len) as i64 })
                emit_tagged_enum_sig_decls(s, fld.fn_sig)        # AGAST #3979
                emit_tagged_enum_sig_decls(s, fld.elem_fn_sig)
                fld = fld.next
        fst = fst.next

    # AGAST #2454: a global `var g: [N]Option<T>` or `Option<T>` names one too.
    var g: *GlobalVarDef = s.module.globals
    while g != null
        if g.var_type == TypeKind.Struct
            emit_tagged_enum_decl_once(s, StrView { ptr: (g.type_name), len: (g.type_name_len) as i64 })
        else if g.var_type == TypeKind.Array and g.array_elem_type == TypeKind.Struct
            emit_tagged_enum_decl_once(s, StrView { ptr: (g.array_elem_type_name), len: (g.array_elem_type_name_len) as i64 })
        g = g.next

    # AGAST #2926: a user enum's (or instance's) payload `Has(Option<i32>)`
    # names one too: built by `Has(Some(6))`, undeclared it was an unsized
    # `alloca %Option$i32` clang refused.  A template's `Option$T` isn't.
    for ei in 0..enum_count(s.mono.pctx)
        if enum_is_generic(s.mono.pctx, ei) != 1
            for vi in 0..enum_variant_count(s.mono.pctx, ei)
                var vf: *StructField = enum_variant_fields(s.mono.pctx, ei, vi)
                while vf != null
                    emit_tagged_enum_decl_once(s, StrView { ptr: (vf.field_type_name), len: (vf.field_type_name_len) as i64 })
                    vf = vf.next

    format_into(s, "\n")

# AGAST #2419: the enums the fn bodies named as they went, spliced in at `pos`.
# Ahead of those bodies, not after: an `alloca` needs its type sized where the
# IR parser reads it, and a type only declared later isn't.
fn emit_late_enum_types(s: *EmitterState, pos: i64)
    if namelist_count(@s.late_enums) == 0 and namelist_count(@s.late_tuples) == 0
        return
    let n: i64 = s.out.data.len - pos
    let tail: *u8 = malloc(n)
    memcpy(tail, s.out.data.data + pos, n)
    s.out.data.len = pos
    for i in 0..namelist_count(@s.late_enums)
        let ln: *u8 = namelist_name(@s.late_enums, i)
        let ll: i32 = namelist_len(@s.late_enums, i)
        if is_tagged_enum_type(StrView { ptr: (ln), len: (ll) as i64 }) == 1
            emit_tagged_enum_decl_once(s, StrView { ptr: (ln), len: (ll) as i64 })
        else
            emit_enum_fallback_decl(s, StrView { ptr: (ln), len: (ll) as i64 })   # a generic user enum's instance (AGAST #2437)
    # AGAST #3005: the tuple structs tuple_lit_infer synthesized.
    for i in 0..namelist_count(@s.late_tuples)
        let tst: *StructDef = find_struct(s, StrView { ptr: (namelist_name(@s.late_tuples, i)), len: (namelist_len(@s.late_tuples, i)) as i64 })
        if tst != null and was_struct_emitted(s, StrView { ptr: (tst.name), len: (tst.name_len) as i64 }) == 0
            emit_one_struct_type(s, tst)
    s.out.push_span(Span<u8> { ptr: (tail), len: (n) as i64 })
    free(tail)

fn emit_tagged_enum_scan_stmts(s: *EmitterState, body: *Stmt)
    var st: *Stmt = body
    while st != null
        match st.kind
            StmtKind.VarDecl =>
                # AGAST #186: scan pointer-typed locals too — `var p: *Option<*Page>`
                # carries the mangled enum name in var_type_name even though
                # var_type is TypeKind.Ptr.
                # AGAST #2454: `[N]Option<T>`, whose var_type_name is its element's:
                # undeclared, its alloca was an unsized type clang refused.
                if st.var_type == TypeKind.Struct or st.var_type == TypeKind.Ptr or st.var_type == TypeKind.Ref or st.var_type == TypeKind.MutRef or st.var_type == TypeKind.Array
                    emit_tagged_enum_decl_once(s, StrView { ptr: (st.var_type_name), len: (st.var_type_name_len) as i64 })
                emit_tagged_enum_sig_decls(s, st.var_fn_sig)   # AGAST #3979: `let f: fn() -> Result<P, i32>`
            StmtKind.If =>
                emit_tagged_enum_scan_stmts(s, st.if_then)
                if st.if_else != null
                    emit_tagged_enum_scan_stmts(s, st.if_else)
            StmtKind.While =>
                emit_tagged_enum_scan_stmts(s, st.while_body)
            StmtKind.For =>
                emit_tagged_enum_scan_stmts(s, st.for_body)
            StmtKind.Loop | StmtKind.Defer | StmtKind.Unsafe =>
                emit_tagged_enum_scan_stmts(s, st.while_body)
            StmtKind.Asm =>
                pass   # StmtKind.Asm holds no statement, expression or type (AGAST #3394).
            _ => pass
        st = st.next

# User-enum type decls (ritz0 parity — test_issue_qualified_enum_variant;
# payload layout AGAST #1797).
#
# ritz1's parser currently swallows `enum Name ... variants` declarations
# without persisting them to the AST (see parser_gen.ritz parse_enum_def).
# But the type name can still be referenced by function signatures
# (`fn f(s: Shade) -> bool`) and emitted as `%Shade` in IR.  Without a
# matching type declaration, LLVM rejects the IR with "Cannot allocate
# unsized type".  We plug the gap by walking every struct-typed reference
# in the module, and emitting `%Name = type { i8 }` for any name that
# nothing else has claimed — matching the single-tag layout ritz0 uses
# for C-style enums.  User structs and Result$/Option$ tagged enums are
# already marked in `emitted_structs` by prior passes, so we skip those.
fn emit_enum_fallback_decl(s: *EmitterState, name_sv: StrView)
    var name: *u8 = name_sv.ptr
    var len: i32 = name_sv.len as i32
    if name == null or len == 0
        return
    if is_tagged_enum_type(StrView { ptr: (name), len: (len) as i64 }) == 1
        return
    if is_primitive_type_name(StrView { ptr: (name), len: (len) as i64 }) == 1
        return
    # AGAST #167: SIMD vector type names lower to `<N x iM>` directly — they
    # never need (and must not get) a `%v4i32 = type { i8 }` named-struct
    # decl which would pin the LLVM type to a bogus `{ i8 }` layout.
    if is_simd_vector_type_name(StrView { ptr: (name), len: (len) as i64 }) == 1
        return
    if was_struct_emitted(s, StrView { ptr: (name), len: (len) as i64 }) == 1
        return
    # AGAST #2975: a tuple over a generic parameter (`tuple_T_T`, a template
    # fn's `-> (T, T)`) is a template, never a type.
    let tr: *TupleReg = tuple_reg_lookup(s.mono.pctx, StrView { ptr: (name), len: (len) as i64 })
    if tr != null and tr.def.type_params != null
        return
    # Skip generic instantiations (`Vec$String`, `Span$u8`, `Pair$i32`, ...).
    # The `$` separator is reserved for monomorph mangling — a name with `$`
    # is *always* a generic instantiation, never a user-declared C-style enum.
    # Without this filter we'd emit `%Vec$String = type { i8 }` and clobber
    # the real Vec$T layout that emit_struct_types instantiates lazily.
    # A generic enum's instance (`Slot$i32`, AGAST #2422) is a recorded enum.
    if user_enum_index(s.mono.pctx, StrView { ptr: (name), len: (len) as i64 }) < 0
        var i: i32 = 0
        while i < len
            if *(name + i) == '$'
                return
            i = i + 1
    mark_struct_emitted(s, StrView { ptr: (name), len: (len) as i64 })
    let name_ir: String = ir_name(StrView { ptr: (name), len: (len) as i64 })
    # AGAST #1797: a user enum with payload variants gets ritz0's layout
    # (emitter_core user_enum_layout); tag-only enums stay `{ i8 }`.
    let uei: i32 = user_enum_index(s.mono.pctx, StrView { ptr: (name), len: (len) as i64 })
    if uei >= 0
        var pad: i64 = 0
        let n: i64 = user_enum_layout(s, uei, @pad)
        if n > 0
            format_into(s, "%{name_ir.as_view()} = type {{ i8, [{pad} x i8], [{n} x i8] }}\n")
            return
        # AGAST #4574: `enum E: <int>` is `{ <int> }`, holding the discriminant.
        format_into(s, "%{name_ir.as_view()} = type {{ {llvm_text(enum_tag_llvm(s.mono.pctx, uei))} }}\n")
        return
    format_into(s, "%{name_ir.as_view()} = type {{ i8 }}\n")

fn emit_enum_fallback_scan_stmts(s: *EmitterState, body: *Stmt)
    var st: *Stmt = body
    while st != null
        match st.kind
            StmtKind.VarDecl =>
                if st.var_type == TypeKind.Struct
                    emit_enum_fallback_decl(s, StrView { ptr: (st.var_type_name), len: (st.var_type_name_len) as i64 })
            StmtKind.If =>
                emit_enum_fallback_scan_stmts(s, st.if_then)
                if st.if_else != null
                    emit_enum_fallback_scan_stmts(s, st.if_else)
            StmtKind.While =>
                emit_enum_fallback_scan_stmts(s, st.while_body)
            StmtKind.For =>
                emit_enum_fallback_scan_stmts(s, st.for_body)
            StmtKind.Loop | StmtKind.Defer | StmtKind.Unsafe =>
                emit_enum_fallback_scan_stmts(s, st.while_body)
            StmtKind.Asm =>
                pass   # StmtKind.Asm holds no statement, expression or type (AGAST #3394).
            _ => pass
        st = st.next

fn emit_enum_fallback_types(s: *EmitterState)
    # AGAST #1797: every non-generic enum the parser recorded, referenced by
    # a signature or not — `let b = Holds(20)` allocas %Opt with nothing
    # else naming it.  Real structs were marked emitted first and win.
    let n_enums: i32 = enum_count(s.mono.pctx)
    for ei in 0..n_enums
        if enum_is_generic(s.mono.pctx, ei) != 1   # instances too (AGAST #2422)
            var en_len: i32 = 0
            let en: *u8 = enum_name_at(s.mono.pctx, ei, @en_len)
            emit_enum_fallback_decl(s, StrView { ptr: (en), len: (en_len) as i64 })
    # Function signatures.
    var f: *FnDef = s.module.functions
    while f != null
        if f.return_type == TypeKind.Struct
            emit_enum_fallback_decl(s, StrView { ptr: (f.return_type_name), len: (f.return_type_name_len) as i64 })
        var p: *Param = f.params
        while p != null
            if p.param_type == TypeKind.Struct
                emit_enum_fallback_decl(s, StrView { ptr: (p.param_type_name), len: (p.param_type_name_len) as i64 })
            p = p.next
        emit_enum_fallback_scan_stmts(s, f.body)
        f = f.next

    # Impl methods.
    var ib: *ImplBlock = s.module.impls
    while ib != null
        var meth: *FnDef = ib.methods
        while meth != null
            if meth.return_type == TypeKind.Struct
                emit_enum_fallback_decl(s, StrView { ptr: (meth.return_type_name), len: (meth.return_type_name_len) as i64 })
            var mp: *Param = meth.params
            while mp != null
                if mp.param_type == TypeKind.Struct
                    emit_enum_fallback_decl(s, StrView { ptr: (mp.param_type_name), len: (mp.param_type_name_len) as i64 })
                mp = mp.next
            emit_enum_fallback_scan_stmts(s, meth.body)
            meth = meth.next
        ib = ib.next

    # AGAST #1660: struct fields.  `struct E \n kind: Kind` lays out as
    # `%E = type {%Kind, ..}`; with Kind named nowhere else, %Kind was never
    # declared ("base element of getelementptr must be sized").  Only names
    # the parser registered as enums — a generic template's `a: T` field
    # must not mint a `%T = type { i8 }`.
    var sd: *StructDef = s.module.structs
    while sd != null
        var sf: *StructField = sd.fields
        while sf != null
            if sf.field_type == TypeKind.Struct and is_enum_type(s.mono.pctx, StrView { ptr: (sf.field_type_name), len: (sf.field_type_name_len) as i64 }) == 1
                emit_enum_fallback_decl(s, StrView { ptr: (sf.field_type_name), len: (sf.field_type_name_len) as i64 })
            sf = sf.next
        sd = sd.next

    # Global variable types.
    var g: *GlobalVarDef = s.module.globals
    while g != null
        if g.var_type == TypeKind.Struct
            emit_enum_fallback_decl(s, StrView { ptr: (g.type_name), len: (g.type_name_len) as i64 })
        g = g.next

    format_into(s, "\n")

# =============================================================================
# Global initializers (AGAST #1501)
# =============================================================================
# `var g: i32 = 5` used to be emitted as `i32 zeroinitializer` — init_expr was
# parsed and never read, so every global started at 0 with no diagnostic
# (zeus's `var g_running: i32 = 1` quit its event loop at once).
#
# An initializer is folded to one of the GINIT_* shapes below and written in
# the global's EXISTING storage type (narrow ints, bool and floats keep their
# i64 slot; widening that storage is a separate change).  Anything that does
# not fold gets a located error instead of a silent zero.

var g_emit_test_table: i32 = 0

# `--stack-protector` (AGAST #2590): emit_fn_attrs adds LLVM's sspstrong.
var g_emit_stack_protector: i32 = 0

pub fn emitter_set_stack_protector(on: i32)
    g_emit_stack_protector = on

# `--no-red-zone` (AGAST #4308): emit_fn_attrs adds LLVM's noredzone, as
# every hand-written helper define does (emitter_core's emit_no_red_zone_attr).
pub fn emitter_set_no_red_zone(on: i32)
    set_no_red_zone_attr(on)

# `--target <triple>` (AGAST #4607): 1 when it names no OS (`-none-`, as
# ritz0's is_freestanding).  main passes it to emit_module and the cache key.
pub fn target_is_freestanding(triple: StrView) -> i32
    var i: i64 = 0
    while i + 6 <= triple.len
        if memcmp(triple.ptr + i, "-none-", 6) == 0
            return 1
        i = i + 1
    0

# The attributes every non-naked Ritz fn's `define` carries.
#
# alignstack(16) ensures proper 16-byte stack alignment for SIMD instructions
# that clang's optimizer may introduce even when we don't use SIMD explicitly
#
# "no-builtins" (AGAST #1313): Ritz links -nostdlib. LLVM's loop-idiom
# recognizer does not know that, and at -O2 rewrites a plain byte loop into
# a call to strlen/memcpy/memset/bcmp -- an undefined reference at link
# time, or infinite self-recursion when it rewrites ritzlib's own memcpy.
# build.py's -ffreestanding/-fno-builtin cannot prevent this: they are
# frontend flags and we hand clang already-emitted .ll, so the frontend
# never runs. The property has to travel with the IR.
#
# sspstrong (--stack-protector, AGAST #2590) travels with the IR for the
# same reason: clang's -fstack-protector-strong is a frontend flag.  On a
# `*-none-*` target LLVM reads the canary from the global __stack_chk_guard,
# so the program (harland) defines it and __stack_chk_fail.
#
# noredzone (--no-red-zone, AGAST #4308), likewise for -mno-red-zone: in
# ring 0 an interrupt on the current stack clobbers the 128 bytes below
# %rsp that a leaf fn would otherwise keep its locals in.
fn emit_fn_attrs(s: *EmitterState)
    format_into(s, ") alignstack(16) \"no-builtins\"")
    if g_emit_stack_protector == 1
        format_into(s, " sspstrong")
    emit_no_red_zone_attr(s)

pub fn emitter_set_test_mode(on: i32)
    g_emit_test_table = on

# Bit width of a [[test]] fn's result: 0 for none, 1..64 for an integer,
# -1 for anything else (rejected).
fn test_ret_bits(f: *FnDef) -> i32
    let t: TypeKind = f.return_type
    match t
        TypeKind.Void =>
            return 0
        TypeKind.Bool =>
            return 1
        _ => pass
    if ty_int_bits(t) == 8
        return 8
    if ty_int_bits(t) == 16
        return 16
    if ty_int_bits(t) == 32
        return 32
    if ty_int_bits(t) == 64
        return 64
    if t == TypeKind.Struct
        let n_sv: StrView = StrView { ptr: (f.return_type_name), len: (f.return_type_name_len) as i64 }
        if name_eq(n_sv, "void") == 1
            return 0
        if name_eq(n_sv, "bool") == 1
            return 1
        if name_eq(n_sv, "i8") == 1 or name_eq(n_sv, "u8") == 1
            return 8
        if name_eq(n_sv, "i16") == 1 or name_eq(n_sv, "u16") == 1
            return 16
        if name_eq(n_sv, "i32") == 1 or name_eq(n_sv, "u32") == 1
            return 32
        if name_eq(n_sv, "i64") == 1 or name_eq(n_sv, "u64") == 1
            return 64
        if name_eq(n_sv, "isize") == 1 or name_eq(n_sv, "usize") == 1
            return 64
    0 - 1

# "<file>:<line>:1: error: [[test]] function 'NAME' <what>", counted like
# emit_ir_error.  A FnDef records no column; a [[test]] fn is a top-level
# item, and a top-level `fn` starts in column 1 (Ritz is indentation-based).
fn test_fn_error(s: *EmitterState, f: *FnDef, what: StrView)
    diag_error_at(emitter_source_file(), diag_span(f.line, 1))
    eprints("[[test]] function '")
    for i in 0..f.name_len
        eprint_char(*(f.name + i))
    eprints("' ")
    eprints(what)
    eprints("\n")
    s.error_count = s.error_count + 1

# `{ { ptr, i64 }, ptr }`: one table entry.
fn emit_test_entry_type(s: *EmitterState)
    format_into(s, "{{ {{ ptr, i64 }}, ptr }}")

fn emit_test_bits_type(s: *EmitterState, bits: i32)
    if bits == 0
        format_into(s, "void")
    else
        format_into(s, "i{bits as i64}")

# 1 if this module (imports included) has a global `var` named `name`.
fn module_has_global(s: *EmitterState, name_sv: StrView) -> i32
    var name: *u8 = name_sv.ptr
    var len: i32 = name_sv.len as i32
    var g: *GlobalVarDef = s.module.globals
    while g != null
        if name_eq(StrView { ptr: (g.name), len: (g.name_len) as i64 }, StrView { ptr: (name), len: (len) as i64 }) == 1
            return 1
        g = g.next
    0

# 1 when this file itself has a fn `name` (defined or `extern`): ritz1 writes
# a define or declare for it, so a weak definition beside it would clash.
fn module_has_local_fn(s: *EmitterState, name_sv: StrView) -> i32
    var name: *u8 = name_sv.ptr
    var len: i32 = name_sv.len as i32
    var f: *FnDef = s.module.functions
    while f != null
        if f.is_local == 1 and name_eq(StrView { ptr: (f.name), len: (f.name_len) as i64 }, StrView { ptr: (name), len: (len) as i64 }) == 1
            return 1
        f = f.next
    0

# `declare void @ritz_platform_fatal(ptr, i64, i32)` when a freestanding
# stop called it (AGAST #4607) and nothing else in this .ll defines or
# declares it: not the module (a kernel defines it), not
# emit_extern_declarations (a called `extern fn`), not emit_platform_hooks.
fn emit_platform_fatal_decl(s: *EmitterState)
    if (s.platform_stop & PSTOP_USED) == 0 or (s.platform_stop & PSTOP_DEFINED) != 0
        return
    let name: StrView = "ritz_platform_fatal"
    if is_local_function(s.module, name) == 1 or inline_import_defined(s.mono.pctx, s.module, name) == 1
        return
    if namelist_find(@s.externs, name) >= 0
        return
    format_into(s, "declare void @ritz_platform_fatal(ptr, i64, i32)")
    emit_declare_attrs_nl(s)

# AGAST #4119: ritzlib's core (memory, hashmap) declares these platform hooks
# instead of importing ritzlib.sys, so it builds freestanding.  sys defines
# them; a test binary that links no sys gets these weak Linux copies, as
# runtime/ritz_start.x86_64.ll and ritz0's `_start` provide them.  mmap 9,
# munmap 11 (PROT_READ|PROT_WRITE = 3, MAP_PRIVATE|MAP_ANONYMOUS = 0x22),
# write 1, exit 60.
fn emit_platform_hooks(s: *EmitterState)
    if module_has_local_fn(s, "ritz_platform_page_map") == 0
        format_into(s, "define weak ptr @ritz_platform_page_map(i64 %len)")
        emit_no_red_zone_attr(s)
        format_into(s, " {\nentry:\n")
        format_into(s, "  %r = call i64 asm sideeffect \"syscall\", \"={{rax}},{{rax}},{{rdi}},{{rsi}},{{rdx}},{{r10}},{{r8}},{{r9}},~{{rcx}},~{{r11}},~{{memory}}\"(i64 9, i64 0, i64 %len, i64 3, i64 34, i64 -1, i64 0)\n")
        format_into(s, "  %p = inttoptr i64 %r to ptr\n")
        format_into(s, "  ret ptr %p\n}\n")
    if module_has_local_fn(s, "ritz_platform_page_unmap") == 0
        format_into(s, "define weak i32 @ritz_platform_page_unmap(ptr %p, i64 %len)")
        emit_no_red_zone_attr(s)
        format_into(s, " {\nentry:\n  %a = ptrtoint ptr %p to i64\n")
        format_into(s, "  %r = call i64 asm sideeffect \"syscall\", \"={{rax}},{{rax}},{{rdi}},{{rsi}},~{{rcx}},~{{r11}},~{{memory}}\"(i64 11, i64 %a, i64 %len)\n")
        format_into(s, "  %t = trunc i64 %r to i32\n")
        format_into(s, "  ret i32 %t\n}\n")
    if module_has_local_fn(s, "ritz_platform_fatal") == 0
        s.platform_stop = s.platform_stop | PSTOP_DEFINED
        format_into(s, "define weak void @ritz_platform_fatal(ptr %msg, i64 %len, i32 %status)")
        emit_no_red_zone_attr(s)
        format_into(s, " {\nentry:\n  %nl = alloca i8\n  store i8 10, ptr %nl\n")
        format_into(s, "  %m = ptrtoint ptr %msg to i64\n  %n = ptrtoint ptr %nl to i64\n  %st = sext i32 %status to i64\n")
        format_into(s, "  %w1 = call i64 asm sideeffect \"syscall\", \"={{rax}},{{rax}},{{rdi}},{{rsi}},{{rdx}},~{{rcx}},~{{r11}},~{{memory}}\"(i64 1, i64 2, i64 %m, i64 %len)\n")
        format_into(s, "  %w2 = call i64 asm sideeffect \"syscall\", \"={{rax}},{{rax}},{{rdi}},{{rsi}},{{rdx}},~{{rcx}},~{{r11}},~{{memory}}\"(i64 1, i64 2, i64 %n, i64 1)\n")
        format_into(s, "  %x = call i64 asm sideeffect \"syscall\", \"={{rax}},{{rax}},{{rdi}},~{{rcx}},~{{r11}},~{{memory}}\"(i64 60, i64 %st)\n  unreachable\n}\n")

fn emit_test_table(s: *EmitterState)
    # This file's tests, in source order.  Imported files record their
    # [[test]] fns too; only the input file's (is_local) count.
    var n: i64 = 0
    var k: i64 = 0
    let total: i64 = test_fn_count(s.mono.pctx)
    var idx: *i64 = malloc((total + 1) * 8) as *i64
    while k < total
        let f: *FnDef = test_fn_at(s.mono.pctx, k)
        k = k + 1
        if f.is_local != 1 or f.body == null
            continue
        if f.params != null
            test_fn_error(s, f, "must take no parameters")
            continue
        let bits: i32 = test_ret_bits(f)
        if bits < 0
            test_fn_error(s, f, "must return an integer or nothing")
            continue
        *(idx + n) = f as i64
        n = n + 1

    format_into(s, "\n; [[test]] table (LANGUAGE_SPEC 17.1)\n")
    var i: i64 = 0
    while i < n
        let f: *FnDef = *(idx + i) as *FnDef
        let fname_ir: String = ir_name(StrView { ptr: (f.name), len: (f.name_len) as i64 })
        format_into(s, "@__ritz_test_name.{i} = private constant [{(f.name_len + 1) as i64} x i8] c\"{fname_ir.as_view()}\\00\"\n")
        let bits: i32 = test_ret_bits(f)
        # AGAST #4356: the test fn's symbol may be mangled (it is a private
        # free fn); its display name above stays the Ritz name.
        var t_sym_len: i32 = 0
        let t_sym: *u8 = fn_symbol(f, @t_sym_len)
        let t_sym_ir: String = ir_name(StrView { ptr: (t_sym), len: (t_sym_len) as i64 })
        if bits != 32
            format_into(s, "define internal i32 @__ritz_test_run.{i}()")
            emit_no_red_zone_attr(s)
            format_into(s, " {\nentry:\n")
            if bits == 0
                format_into(s, "  call void @{t_sym_ir.as_view()}()\n")
                emit_sv(s, "  ret i32 0\n}\n")
            else
                format_into(s, "  %r = call ")
                emit_test_bits_type(s, bits)
                format_into(s, " @{t_sym_ir.as_view()}()\n  %failed = icmp ne ")
                emit_test_bits_type(s, bits)
                format_into(s, " %r, 0\n  %code = zext i1 %failed to i32\n")
                format_into(s, "  ret i32 %code\n}\n")
        i = i + 1

    format_into(s, "@__ritz_tests = constant [{n} x ")
    emit_test_entry_type(s)
    format_into(s, "] ")
    if n == 0
        format_into(s, "zeroinitializer\n")
    else
        format_into(s, "[")
        i = 0
        while i < n
            let f: *FnDef = *(idx + i) as *FnDef
            if i > 0
                format_into(s, ", ")
            emit_test_entry_type(s)
            format_into(s, " {{ {{ ptr, i64 }} {{ ptr @__ritz_test_name.{i}, i64 {f.name_len as i64} }}, ptr @")
            if test_ret_bits(f) == 32
                var ptr_sym_len: i32 = 0
                let ptr_sym: *u8 = fn_symbol(f, @ptr_sym_len)
                let ptr_sym_ir: String = ir_name(StrView { ptr: (ptr_sym), len: (ptr_sym_len) as i64 })
                format_into(s, "{ptr_sym_ir.as_view()}")
            else
                format_into(s, "__ritz_test_run.{i}")
            format_into(s, " }")
            i = i + 1
        format_into(s, "]\n")
    format_into(s, "@__ritz_tests_count = constant i64 {n}\n")
    format_into(s, "define ptr @__ritz_test_table(ptr %count) {{\nentry:\n  store i64 {n}, ptr %count\n")
    format_into(s, "  ret ptr @__ritz_tests\n}}\n")
    free(idx as *u8)

    # The runner's `main(argc, argv)` lives in ritzunit's object; this file's
    # own `main` was dropped by the driver.  Same shim as
    # runtime/ritz_start.x86_64.ll.
    format_into(s, "declare i32 @main(i32, ptr)")
    emit_declare_attrs_nl(s)
    # AGAST #3737: it also stores envp in `__ritz_envp` for ritzlib.os.env,
    # defined weak here unless an imported os/env already defines it.
    if module_has_global(s, "__ritz_envp") == 0
        format_into(s, "@__ritz_envp = weak global ptr null\n")
    emit_platform_hooks(s)
    # Bare `naked`, no alignstack/"no-builtins": asm only (AGAST #1326).
    format_into(s, "define void @_start() naked {\nentry:\n")
    format_into(s, "  call void asm sideeffect \"movq (%rsp), %rdi\\0Aleaq 8(%rsp), %rsi\\0Aleaq 8(%rsi,%rdi,8), %rdx\\0Amovq %rdx, __ritz_envp(%rip)\\0Aandq $$-16, %rsp\\0Acall main\\0Amovq %rax, %rdi\\0Amovq $$60, %rax\\0Asyscall\", \"~{{rax}},~{{rdi}},~{{rsi}},~{{rdx}},~{{rsp}},~{{rcx}},~{{r11}},~{{memory}}\"()\n")
    format_into(s, "  unreachable\n}\n")

# AGAST #2041: a struct field of reference type to a struct (`ch: @C`,
# `ch: @&C`, `ch:& C`) is a `*C` field as far as the emitter is concerned.
# ritz0 lays it out as `ptr` and auto-derefs member access through it, which
# is exactly what every TypeKind.Ptr field path (struct literal, member read,
# member assignment, sizeof, field + i, ...) already does.  Rather than teach
# each of those sites the two ref codes, rewrite the field once, after
# monomorphize_module (clone_struct_fields substitutes a `@T` pointee the
# same way as a `*T` one) and before any struct is laid out or looked up.
# AGAST #2050: refs to an integer (`p: @i32`) lower the same way.  A
# TypeKind.Ptr field with a primitive pointee needs array_elem_type, which
# field_new records for integer refs.  A ref with neither a struct name nor
# an integer pointee (`@f64`, `@bool`, `@*u8`) keeps its ref type and stays
# on the existing fail-closed path.
fn lower_ref_fields(m: *Module)
    var st: *StructDef = m.structs
    while st != null
        var f: *StructField = st.fields
        while f != null
            f.field_type = lowered_field_type(f)   # AGAST #2399, #3151
            f = f.next
        st = st.next

pub fn emit_module(m: *Module, out: *String, alloc: *Allocator, mono: *MonoCtx, freestanding: i32) -> i32
    # Built whole (AGAST #3592): EmitterState is move-only (its HashMapI64
    # maps have Drop).  This was R59's migration site; R59 now allows a
    # splittable struct to be written field by field (AGAST #4328).
    var s: EmitterState = EmitterState {
        out: out,
        entry_allocas: arena_string(alloc, ENTRY_ALLOCA_BYTES),   # AGAST #4460
        ea_marks: null,
        ea_count: 0,
        ea_cap: 0,
        entry_out_saved: null,
        dloads: null,   # AGAST #4461 — deferred large-struct loads
        dload_count: 0,
        dload_cap: 0,
        reg_counter: 1,
        label_counter: 0,
        locals: null,
        locals_cap: 0,
        local_count: 0,
        break_label: -1,
        continue_label: -1,
        module: m,
        mono: mono,   # AGAST #4454
        strings: NameList { names: null, lens: null, count: 0, cap: 0 },
        externs: NameList { names: null, lens: null, count: 0, cap: 0 },
        emitted_structs: NameList { names: null, lens: null, count: 0, cap: 0 },
        late_enums: NameList { names: null, lens: null, count: 0, cap: 0 },
        late_tuples: NameList { names: null, lens: null, count: 0, cap: 0 },
        emitted_fns: NameList { names: null, lens: null, count: 0, cap: 0 },
        emitted_globals: NameList { names: null, lens: null, count: 0, cap: 0 },
        last_expr_reg: 0,
        last_expr_label: 0,
        last_expr_model: LAST_EXPR_UNKNOWN,   # AGAST #2950
        current_label: ENTRY_BLOCK_LABEL,   # AGAST #1335
        ret_type_name: null,
        ret_type_name_len: 0,
        ret_sret: 0,   # AGAST #1730 — set per fn by emit_fn / emit_impl_method
        fn_ret_type: TypeKind.Void,   # AGAST #1454 — set per fn like ret_sret
        sret_last_val: 0,
        sret_last_slot: 0,
        sret_helpers_used: 0,
        fmod_helpers_used: 0,   # AGAST #3817 — see emit_fmod_helpers
        ctx_enum_name: null,
        ctx_enum_name_len: 0,
        ctx_enum_arg: 0,
        ctx_slot_name: null,   # AGAST #2296
        ctx_slot_name_len: 0,
        ctx_slot_set: 0,
        struct_copy_expr: null,
        ctx_simd_name: null,
        ctx_simd_name_len: 0,
        last_match_agg_name: null,   # AGAST #1666
        last_match_agg_name_len: 0,
        last_match_float_ty: TypeKind.Void,   # AGAST #1946
        last_if_stmt_agg_name: null,   # AGAST #2559
        last_if_stmt_agg_name_len: 0,
        match_float_hint: TypeKind.Void,
        match_agg_hint: null,   # AGAST #3205
        match_agg_hint_len: 0,
        match_no_value: 0,   # AGAST #2046
        if_arm_value: null,   # AGAST #2288
        if_stmt_discarded: null,   # AGAST #3749
        void_arm_line: 0,
        void_arm_col: 0,
        local_map: HashMapI64 { entries: null, cap: 0, len: 0, tombstones: 0 },
        global_map: HashMapI64 { entries: null, cap: 0, len: 0, tombstones: 0 },
        fn_map: HashMapI64 { entries: null, cap: 0, len: 0, tombstones: 0 },
        struct_map: HashMapI64 { entries: null, cap: 0, len: 0, tombstones: 0 },
        const_map: HashMapI64 { entries: null, cap: 0, len: 0, tombstones: 0 },
        error_count: 0,   # AGAST #1369 — see emit_ir_error / the return below
        unknown_struct_name: null,   # AGAST #3362
        unknown_struct_name_len: 0,
        match_scrut_kind: 0,
        match_scrut_int: TypeKind.Void,
        match_scrut_str: 0,
        wanted: null,   # AGAST #2260
        wanted_count: 0,
        wanted_cap: 0,
        print_helpers_used: 0,   # AGAST #1521 — see emit_print_helpers
        fmt_helpers_used: 0,   # AGAST #1824 — see emit_format_helpers
        packed_marks: null,   # AGAST #4462 — see packed_mark / packed_marked
        packed_marks_cap: 0,
        narrow_params: null,
        narrow_decls: [NarrowDecl { name: null, name_len: 0, decl_type: TypeKind.Void, declared: TypeKind.Void, init: null }; 256],
        narrow_decl_count: 0,
        narrow_decl_overflow: 0,
        fn_assert_kind: ASSERT_FN_PLAIN,   # AGAST #1869 — see emit_assert_stmt
        platform_stop: freestanding * PSTOP_FREESTANDING,   # AGAST #4607
        assert_helpers_used: 0,
        assert_site_used: 0,
        assert_cap_expr: null,
        assert_cap_ok: 0,
        assert_cap_l: 0,
        assert_cap_r: 0,
        assert_file_str: -1,
        own: null,
        own_emit_stmt: emit_stmt,
        own_before_ret_fn: own_before_ret,   # AGAST #3513
        ref_cast_reads_referent_fn: ref_cast_reads_referent,
        fm: null,
        fm_count: 0,
        fm_cap: 0,
        fm_line: 0,
        fm_col: 0,
        fs: null,
        fs_count: 0,
        fs_cap: 0
    }
    locals_init(@s, LOCALS_INIT_CAP)
    own_init(@s)   # AGAST #2158
    namelist_init(@s.strings, STRINGS_INIT_CAP)
    namelist_init(@s.externs, 256)
    namelist_init(@s.emitted_structs, 256)
    namelist_init(@s.late_enums, 16)
    namelist_init(@s.late_tuples, 16)   # AGAST #3005
    namelist_init(@s.emitted_fns, 512)
    namelist_init(@s.emitted_globals, 256)
    # Before build_symbol_maps, so find_struct sees the fallback if added.
    ensure_string_literal_struct(@s, m)
    lower_ref_fields(m)   # AGAST #2041
    # ritz-task-193 — allocate the five symbol-table HashMaps before any
    # add_local / find_* call.  build_symbol_maps then snapshots the
    # post-monomorph module-level lists so find_global / find_fn /
    # find_struct / find_const_entry are O(1) for the rest of emit_module.
    init_emitter_maps(@s)
    build_symbol_maps(@s)
    # AGAST #1502 — fold consts that name a later / imported const.
    resolve_const_values(@s)

    format_into(@s, "; ModuleID = 'ritz1_output'\ntarget triple = \"x86_64-unknown-linux-gnu\"\n\n")

    # Emit struct type definitions from source
    emit_struct_types(@s)

    # Emit tagged-enum struct type decls for every Result$/Option$
    # instantiation referenced in the module.  ritz-task-133 replaces the
    # old i64-pack fast-path with a real `{ i8, [N x i8] }` struct so the
    # IR matches ritz0.
    emit_tagged_enum_types(@s)
    let late_enum_pos: i64 = s.out.data.len

    # Emit fallback `%Name = type { i8 }` decls for any remaining
    # referenced struct-typed name the parser skipped (C-style unit
    # enums — parse_enum_def currently consumes without persisting to
    # the AST).  Must run AFTER emit_struct_types + emit_tagged_enum_types
    # so real structs and Result$/Option$ instantiations keep priority
    # in the emitted_structs dedup table.
    emit_enum_fallback_types(@s)

    # Emit global variable declarations
    emit_global_vars(@s)

    # Emit const arrays of struct literals as LLVM globals (B1 parity).
    # Integer consts remain inlined via find_const; only complex shapes
    # (array-of-struct) need a real global.
    emit_const_arrays(@s)

    # First pass: emit all functions (to collect externs)
    # Deduplicate: same function may appear multiple times from imports
    var f: *FnDef = m.functions
    var total_fns: i32 = 0
    var skipped_generic: i32 = 0
    var skipped_dup: i32 = 0
    var emitted_count: i32 = 0

    while f != null
        total_fns = total_fns + 1
        # Skip generic function templates - they need monomorphization
        # Only concrete instantiations (no type_params) should be emitted
        if f.type_params != null
            skipped_generic = skipped_generic + 1
            f = f.next
            continue
        # AGAST #196: skip imported fns up-front so they don't poison the
        # was_fn_emitted dedup table. emit_fn would early-return on these
        # anyway (is_local==0 path), but the loop's mark_fn_emitted
        # below was firing FIRST — then the matching is_local==1 copy
        # parsed from THIS file (added later by main()) hit the dedup
        # check and was silently skipped, leaving cross-module callers
        # with unresolved symbols at link time. Skipping here means the
        # local copy reaches mark_fn_emitted/emit_fn cleanly.
        # body==null externs are also skipped so they don't pollute
        # dedup either; emit_extern_declarations handles them via the
        # add_extern call sites.
        # AGAST #3585: an eligible [[inline]] import is defined here
        # available_externally, unless this file defines the name itself;
        # marked, so emit_extern_declarations doesn't also declare it.
        if f.is_local == 0
            if inline_import_defines(mono.pctx, m, f) == 1 and was_fn_emitted(@s, StrView { ptr: (f.name), len: (f.name_len) as i64 }) == 0
                mark_fn_emitted(@s, StrView { ptr: (f.name), len: (f.name_len) as i64 })
                emit_fn(@s, f)
            f = f.next
            continue
        # Skip already-emitted functions (deduplication for imports)
        if was_fn_emitted(@s, StrView { ptr: (f.name), len: (f.name_len) as i64 }) == 1
            skipped_dup = skipped_dup + 1
            f = f.next
            continue
        mark_fn_emitted(@s, StrView { ptr: (f.name), len: (f.name_len) as i64 })
        emit_fn(@s, f)
        emitted_count = emitted_count + 1
        f = f.next

    # Emit impl block methods with mangled names (Type_method).
    # Skip generic impl blocks: their methods are templates that
    # reference the type parameter T directly (e.g.
    # `fn len(self: *Span<T>) -> i64`).  Emitting them here would
    # produce IR like `define %T @Span_get(...)` where `%T` is not
    # a defined LLVM type.  Concrete specialisations are emitted
    # via specialize_impl_methods in monomorph.ritz.
    var ib: *ImplBlock = m.impls
    while ib != null
        if ib.type_params == null
            var method: *FnDef = ib.methods
            while method != null
                emit_impl_method(@s, ib, method)
                method = method.next
        ib = ib.next

    # AGAST #4529: the functions are done.  The helpers below write their own
    # `ret` outside any fn body; emit_str runs own_before_ret at each, so the
    # last fn must be forgotten first or its live bindings drop inside a
    # helper, referring to registers that do not exist there.
    own_reset(@s)

    emit_late_enum_types(@s, late_enum_pos)   # AGAST #2419

    format_into(@s, "\n")
    emit_string_constants(@s)

    # assert's value printer and call-site globals (AGAST #1869).  Before
    # emit_print_helpers: the assert lowering writes text through them.
    emit_assert_helpers(@s)
    emit_match_trap_helper(@s)   # AGAST #4586

    # Integer / bool / string printers for print interpolation (AGAST #1521).
    emit_print_helpers(@s)
    emit_format_helpers(@s)

    # Emit extern declarations after collecting them from function bodies.
    emit_extern_declarations(@s)

    # BitOps intrinsics (`x.rotl(3)` etc.) this module called (AGAST #1506).
    emit_bitops_intrinsic_decls(@s)
    # llvm.fabs for `x.abs()` on f32/f64 (AGAST #1370).
    emit_float_intrinsic_decls(@s)

    # No llvm.memset: a `[0; N]` fill calls @__ritz_sret_zero (AGAST #3218),
    # since the intrinsic lowers to libc `memset` and Ritz links -nostdlib.
    emit_sret_helpers(@s)   # AGAST #1730
    emit_fmod_helpers(@s)   # AGAST #3817
    emit_overflow_helpers(@s)   # LARB R63 (AGAST #3489)

    if g_emit_test_table == 1
        emit_test_table(@s)
    # Last: the stops above (asserts, the overflow trap) note their calls.
    emit_platform_fatal_decl(@s)   # AGAST #4607

    # Note: _start is provided by runtime/ritz_crt0.o which properly sets up argc/argv

    # AGAST #1369 — number of expressions the emitter could not lower.  This
    # used to be a hardcoded 0, and the call site in main.ritz ignored it, so
    # there was no path by which an emit failure could reach the exit code.
    # AGAST #1509: a multi-dimensional array reached a 1-D element path
    # (field_array_elem_llvm).  That is an unlowered N-D use: fail.
    let nd_leaks: i32 = nd_elem_leaks()
    if nd_leaks > 0
        eprints("error: ritz1 cannot emit: a multi-dimensional array is used in a way ritz1 does not lower (only element access g[i][j], element stores and @g[i][j] are supported)\n")
        count_unlocated_error(@s, nd_leaks)
    s.error_count
