# ref_check.ritz - a reference doesn't fit a by-value slot, nor a value a
# reference slot (AGAST #2336, #2337), and an array only fits a slot of its own
# element type (AGAST #2343)
#
# LANGUAGE_SPEC §13.2-13.4, LARB ruling R1.  An `@T`, `@&T` or `*T` where a `T`
# goes is a located error at every slot: argument, `let`/`var`, `=`, `return`,
# tail, field, element, variant payload.  There's no implicit deref, and `@x`
# into a by-value slot is the same mistake.  So is a `T` where a reference goes:
# a `name:& T` param has type `T` in its body, and a reference is written.
#
# ritz0's twin is TypeChecker._check_ref_slot; ref_rules.py has the wording, and
# ritz0/test_ref_into_value.py and test_value_into_ref.py hold all three
# compilers to it.  ritz1 emits
# bodies after monomorphize_module, so a generic is judged per instance for free.
#
# This runs from the ownership hooks, as code is emitted, so every local a value
# names is in scope.  That also means an `if` or `match` can't be judged where
# it lands: its arms bind their own names.  So a slot's tails are noted when the
# slot is met (ref_note_*) and judged as each one is emitted (ref_landed).
#
# Types the tables can't name stay unjudged: wrongly refusing a valid program
# is worse than leaving it to clang.
#
# LANGUAGE_SPEC §3.3, LARB ruling R5: a non-literal `[N]T1` fits `[N]T2` only if
# T1 is T2, at the same slots, and under `as`.  ritz0's twin is
# TypeChecker._check_array_slot; array_rules.py has the wording and
# ritz0/test_array_store_rule.py holds all three compilers to it.
#
# ownership.ritz uses ref_ty_of and ref_through for "cannot move out of a
# reference", which only reaches a program with a Drop in it.
#
# `@T` is read-only (AGAST #2338), and doesn't become an `@&T` (AGAST #2374): near
# the end of this file, and ref_addr_into_mut.  A reference to a local doesn't
# leave its fn (AGAST #2340): the end of this file.

import ritzlib.sys
import ritzlib.io

import ast
import ast_helpers
import deref_field   # df_deref_step_recv (AGAST #3015)
import emitter_core
import emitter_expr_call   # method_callee_def
import let_check           # let_addr_of_own (AGAST #2338)
import index_through       # index_through_struct (AGAST #2443)
import ownership            # own_type_is_move_only (AGAST #2963)

# What an expression or a slot holds.
pub struct RefTy
    kind: i32       # TYPE_*
    pointee: i32    # TYPE_* behind a pointer kind, or an array's element
    name: *u8       # the struct: kind's own, or the pointee's
    name_len: i32
    elem_pointee: i32     # U for an array's `*U` element; TYPE_VOID if unknown
    shape: *ArrayShape    # a multi-dimensional array's, else null
    returned: i32         # 1 for a slot that leaves the fn as a pointer or reference
    ref_size: i32         # N for a pointer kind to `[N]T`; 0 if unknown
    ref_elem: i32         # its T's kind (a struct T is `name`); TYPE_VOID if unknown
    name_only: i32        # 1 for a `-> *X` return: only a name, maybe a stale one
    # AGAST #2364: U when the pointee is a `*U` (pointee == TYPE_PTR), as
    # Param.param_ref_ptr_pointee keeps it; TYPE_VOID if unknown.  A scalar U
    # has no name, so without it `@&*i32` and `@&*i64` were one type.
    ptr_pointee: i32

# A tail and the slot it lands in.
struct RefTail
    e: *Expr
    slot: RefTy

var REF_TAILS: *RefTail = null
var REF_TAIL_COUNT: i32 = 0
var REF_TAIL_CAP: i32 = 0
var REF_RET: RefTy
var REF_LAST_LINE: i32 = 0
var REF_LAST_COL: i32 = 0
# The local root a declaration's initialiser refers to, until ref_after_stmt can
# give it to the binding, and the loops around the statement being checked.
var REF_DECL_ROOT: *u8 = null
var REF_DECL_ROOT_LEN: i32 = 0
var REF_DECL_TY: RefTy
var REF_LOOPS: i32 = 0

# A loan of a place, held by a binding declared at ownership scope `depth`
# (AGAST #2438).  `root` is the place's local's index, and `place` the borrowed
# expression (an ident, member or index chain down to it); the loan ends when
# that scope does.
struct RefLoan
    root: i32
    mutable: i32
    depth: i32
    place: *Expr
    # A `for`'s loan on the place its iterable indexes into (AGAST #2439): only a
    # use of that place, or of one holding it, conflicts.  `vs[0].a[2] = 50` is
    # inside `vs`: it can't move the buffer, and stays legal.
    outer: i32

var REF_LOANS: *RefLoan = null
var REF_LOAN_COUNT: i32 = 0
var REF_LOAN_CAP: i32 = 0
# The ownership scope depth of the statement being checked (own_check_stmt).
var REF_DEPTH: i32 = 0
# Call arguments being walked, and the depth of an argument's loan: deeper than
# any scope, so only ref_args ends it.
var REF_IN_ARGS: i32 = 0
const REF_LOAN_ARG: i32 = 1000000000

fn ref_set(out: *RefTy, kind: i32, pointee: i32, name: *u8, len: i32) -> i32
    out.kind = kind
    out.pointee = pointee
    out.name = name
    out.name_len = len
    out.elem_pointee = TYPE_VOID
    out.shape = null
    out.returned = 0
    out.ref_size = 0
    out.ref_elem = TYPE_VOID
    out.name_only = 0
    out.ptr_pointee = TYPE_VOID
    1

fn ref_set_array(out: *RefTy, elem: i32, elem_pointee: i32, name: *u8, len: i32, shape: *ArrayShape) -> i32
    ref_set(out, TYPE_ARRAY, elem, name, len)
    out.elem_pointee = elem_pointee
    out.shape = shape
    1

fn ref_set_elem(out: *RefTy, a: *ArrayElem) -> i32
    ref_set_array(out, a.elem, a.pointee, a.name, a.name_len, a.shape)

# `out` is what `a[i]` holds for `[N][M]T`: 0 past two dimensions, or for a
# one-dimensional `a`.
fn ref_row(a: *RefTy, out: *RefTy) -> i32
    if a.shape == null or a.shape.rank != 2
        return 0
    ref_set_array(out, a.shape.leaf_type, a.shape.leaf_pointee, a.shape.leaf_name, a.shape.leaf_name_len, null)

pub fn ref_is_pointer(kind: i32) -> i32
    if kind == TYPE_PTR or kind == TYPE_REF or kind == TYPE_MUT_REF
        return 1
    0

fn ref_of_local(loc: *LocalVar, out: *RefTy) -> i32
    if loc.bk_unsure == 1
        return 0
    let t: i32 = loc.var_type
    if ref_is_pointer(t) == 1
        # `c:& C` reads as a `C` (§13.4), and so does a by-value `self`.
        if loc.is_lent == 1 or loc.holds_lent_ptr == 1
            return ref_set(out, loc.pointee_type, 0, loc.type_name, loc.type_name_len)
        ref_set(out, t, loc.pointee_type, loc.type_name, loc.type_name_len)
        out.ptr_pointee = loc.ref_ptr_pointee
        return 1
    if t == TYPE_ARRAY
        return ref_set_array(out, loc.array_elem_type, loc.array_elem_pointee, loc.type_name, loc.type_name_len, loc.array_shape)
    if t == TYPE_PTR_PTR
        return 0
    ref_set(out, t, 0, loc.type_name, loc.type_name_len)

fn ref_of_ident(s: *EmitterState, name: *u8, len: i32, out: *RefTy) -> i32
    let idx: i32 = find_local_idx(s, name, len)
    if idx >= 0
        return ref_of_local(local_at(s, idx), out)
    let g: *GlobalVarDef = find_global(s, name, len)
    if g == null
        return 0
    if ref_is_pointer(g.var_type) == 1
        return ref_set(out, g.var_type, g.pointee_type, g.pointee_type_name, g.pointee_type_name_len)
    if g.var_type == TYPE_PTR_PTR
        return 0
    if g.var_type == TYPE_ARRAY
        return ref_set_array(out, g.array_elem_type, g.array_elem_pointee, g.array_elem_type_name, g.array_elem_type_name_len, g.array_shape)
    ref_set(out, g.var_type, 0, g.type_name, g.type_name_len)

fn ref_of_fn(f: *FnDef, out: *RefTy) -> i32
    if f == null or f.return_type == TYPE_VOID
        return 0
    if f.ret_ref != null
        return ref_of_param(f.ret_ref, out)
    if f.ret_array != null
        return ref_set_elem(out, f.ret_array)
    if f.return_type == TYPE_PTR or f.return_type == TYPE_PTR_PTR
        # FnDef keeps no pointee, only a struct's name.
        if f.return_type_name_len > 0 and f.return_type == TYPE_PTR
            ref_set(out, TYPE_PTR, TYPE_STRUCT, f.return_type_name, f.return_type_name_len)
            out.name_only = 1
            return 1
        return 0
    ref_set(out, f.return_type, 0, f.return_type_name, f.return_type_name_len)

fn ref_of_param(p: *Param, out: *RefTy) -> i32
    if p.param_type == TYPE_PTR_PTR
        return 0
    if p.param_type == TYPE_ARRAY
        return ref_set_array(out, p.param_array_elem_type, p.param_array_elem_pointee, p.param_type_name, p.param_type_name_len, null)
    ref_set(out, p.param_type, p.param_pointee_type, p.param_type_name, p.param_type_name_len)
    if p.param_pointee_type == TYPE_ARRAY
        out.ref_size = p.param_pointee_array_size
        out.ref_elem = p.param_pointee_array_elem_type
    if p.param_pointee_type == TYPE_PTR
        out.ptr_pointee = p.param_ref_ptr_pointee
    1

fn ref_of_field(s: *EmitterState, e: *Expr, f: *StructField, out: *RefTy) -> i32
    let t: i32 = f.field_type
    if ref_is_pointer(t) == 1
        var pointee: i32 = get_member_pointee_type_exact(s, e)
        # An instance's `*T` field keeps the name and not the kind.
        if pointee == TYPE_VOID and f.field_type_name_len > 0
            pointee = TYPE_STRUCT
        # A primitive `*T` field says what it points at itself (#1304), which
        # the member chain can lose behind an element, `a.a[1].p` (#2368).
        if t == TYPE_PTR and f.field_type_name_len == 0 and f.array_elem_type != TYPE_VOID
            pointee = f.array_elem_type
        return ref_set(out, t, pointee, f.field_type_name, f.field_type_name_len)
    if t == TYPE_ARRAY
        return ref_of_array_field(f, out)
    if t == TYPE_PTR_PTR
        return 0
    ref_set(out, t, 0, f.field_type_name, f.field_type_name_len)

fn ref_of_array_field(f: *StructField, out: *RefTy) -> i32
    ref_set_array(out, f.array_elem_type, f.array_elem_pointee, f.array_elem_type_name, f.array_elem_type_name_len, f.array_shape)

# The method `e` (EXPR_METHOD) calls, on the receiver's own type.
pub fn ref_method_def(s: *EmitterState, e: *Expr) -> *FnDef
    # An element through, `p[i].m()`, is the element's type: ref_ty_of gives `p[i]`
    # the Vec's own name (AGAST #2443).
    var en: *u8 = null
    var el: i32 = 0
    if index_through_struct(s, e.left, @en, @el) == 1
        if en == null
            return null
        return method_callee_def(s, en, el, e.ident_ptr, e.ident_len)
    var t: RefTy
    if e.left != null and ref_ty_of(s, e.left, @t) == 1 and t.name_len > 0
        return method_callee_def(s, t.name, t.name_len, e.ident_ptr, e.ident_len)
    var len: i32 = 0
    let name: *u8 = method_recv_type_name(s, e, @len)
    if name == null or len == 0
        return null
    method_callee_def(s, name, len, e.ident_ptr, e.ident_len)

# Fill `out` with the type of `e`.  0 if the tables can't say.
pub fn ref_ty_of(s: *EmitterState, e: *Expr, out: *RefTy) -> i32
    if e == null
        return 0
    let k: i32 = e.kind
    if k == EXPR_IDENT
        return ref_of_ident(s, e.ident_ptr, e.ident_len, out)
    if k == EXPR_STRING_LIT
        return ref_set(out, TYPE_STRUCT, 0, c"StrView", 7)
    if k == EXPR_UNARY
        var t: RefTy
        if e.op == OP_ADDR or e.op == OP_ADDR_MUT
            if ref_ty_of(s, e.operand, @t) == 0
                return 0
            if ref_is_pointer(t.kind) == 1
                ref_set(out, TYPE_PTR, TYPE_PTR, t.name, t.name_len)
                out.ptr_pointee = ref_addr_ptr_pointee(@t)
                return 1
            ref_set(out, TYPE_PTR, t.kind, t.name, t.name_len)
            if t.kind == TYPE_ARRAY
                ref_array_referent(s, e.operand, out)
            return 1
        if e.op == OP_DEREF
            if ref_ty_of(s, e.operand, @t) == 0
                return 0
            if ref_is_pointer(t.kind) == 0
                *out = t
                return 1
            if t.pointee == TYPE_ARRAY
                return ref_behind(s, e.operand, out)
            if t.pointee == TYPE_VOID or ref_is_pointer(t.pointee) == 1
                return 0
            return ref_set(out, t.pointee, 0, t.name, t.name_len)
        return 0
    if k == EXPR_MEMBER
        let f: *StructField = resolve_member_chain_field(s, e)
        if f == null
            return 0
        return ref_of_field(s, e, f, out)
    if k == EXPR_INDEX
        # `p[1..3]` is a pointer, not an element.
        if e.right != null and e.right.kind == EXPR_RANGE
            return 0
        var b: RefTy
        if ref_ty_of(s, e.left, @b) == 0
            return 0
        if b.kind != TYPE_ARRAY and ref_is_pointer(b.kind) == 0
            return 0
        if b.kind == TYPE_ARRAY and b.pointee == TYPE_ARRAY
            return ref_row(@b, out)
        # AGAST #2377: `a[i]` with `a: [N]*T` is a `*T`, so `*a[i]` and
        # `a[i][j]` are read through a pointer: a Drop T is not moved out.
        if b.kind == TYPE_ARRAY and ref_is_pointer(b.pointee) == 1
            let ep: i32 = b.elem_pointee
            if ep == TYPE_VOID or ep == TYPE_ARRAY or ep == TYPE_PTR_PTR or ref_is_pointer(ep) == 1
                return 0
            return ref_set(out, b.pointee, ep, b.name, b.name_len)
        if b.pointee == TYPE_VOID or ref_is_pointer(b.pointee) == 1 or b.pointee == TYPE_ARRAY
            return 0
        return ref_set(out, b.pointee, 0, b.name, b.name_len)
    if k == EXPR_CALL
        return ref_of_fn(find_call_fn(s, e), out)
    if k == EXPR_METHOD
        return ref_of_fn(ref_method_def(s, e), out)
    if k == EXPR_BINARY
        var l: RefTy
        if ref_ty_of(s, e.left, @l) == 1 and ref_is_pointer(l.kind) == 1
            return ref_set(out, l.kind, l.pointee, l.name, l.name_len)
        return 0
    if k == EXPR_CAST and e.op == TYPE_PTR
        return ref_set(out, TYPE_PTR, e.int_val as i32, e.ident_ptr, e.ident_len)
    0

# AGAST #2364: U for `@x` of an x of type `t`, when x is a `*U`: a local, a
# field, or a `:& *U` param, which binds as the caller's `*U` (#2075).  A
# reference `q: @&U` or `@U` is a `*U` too (#3160): ref_value_into_ref words
# that misfit as ritz0 does, "a reference to one type".
fn ref_addr_ptr_pointee(t: *RefTy) -> i32
    t.pointee

# `out` is `@a`: its `[N]T`'s N and T, for an `a` that is a local array or a
# `:&` one.  Unknown for anything else.
fn ref_array_referent(s: *EmitterState, e: *Expr, out: *RefTy)
    if e.kind != EXPR_IDENT
        return
    let idx: i32 = find_local_idx(s, e.ident_ptr, e.ident_len)
    if idx < 0
        return
    let loc: *LocalVar = local_at(s, idx)
    if loc.var_type == TYPE_ARRAY
        out.ref_size = loc.array_size
        out.ref_elem = loc.array_elem_type
    else if loc.is_lent == 1 and loc.pointee_type == TYPE_ARRAY
        out.ref_size = loc.pointee_array_size
        out.ref_elem = loc.pointee_array_elem_type

# The `[N]T` behind `e`, a local `*[N]T`, `@[N]T` or `@&[N]T`.  0 for any other
# pointer: only a local keeps the element.
fn ref_behind(s: *EmitterState, e: *Expr, out: *RefTy) -> i32
    if e.kind != EXPR_IDENT
        return 0
    let idx: i32 = find_local_idx(s, e.ident_ptr, e.ident_len)
    if idx < 0
        return 0
    let loc: *LocalVar = local_at(s, idx)
    var en_len: i32 = 0
    let en: *u8 = array_ptr_elem_name(loc, @en_len)   # #2548
    ref_set_array(out, loc.pointee_array_elem_type, loc.pointee_array_elem_pointee, en, en_len, null)

# Does the place `e` lie behind an `@T`, `@&T`, `*T` or `:&`?  ritz0's
# MoveChecker._through_reference.
pub fn ref_through(s: *EmitterState, e0: *Expr) -> i32
    var e: *Expr = e0
    while e != null
        var next: *Expr = null
        if e.kind == EXPR_MEMBER or e.kind == EXPR_INDEX
            next = e.left
        else if e.kind == EXPR_UNARY and e.op == OP_DEREF
            next = e.operand
        else
            if e.kind != EXPR_IDENT
                return 0
            let idx: i32 = find_local_idx(s, e.ident_ptr, e.ident_len)
            if idx < 0
                return 0
            let loc: *LocalVar = local_at(s, idx)
            return loc.is_lent
        e = next
        var t: RefTy
        if ref_ty_of(s, e, @t) == 1 and ref_is_pointer(t.kind) == 1
            return 1
    0

# AGAST #2516: the fn being emitted owns the line, and an instance of an
# imported generic (span.ritz's span_get<T>) carries its module's def_file.
fn ref_eprint_loc(line: i32, col: i32)
    eprints_cstr(fn_source_file(emitter_current_fn()))
    eprint_char(':')
    eprint_i64(line as i64)
    eprint_char(':')
    eprint_i64(col as i64)

# 1 the first time this place is reported: `x.f` is walked as a value and a
# tail, and a loop body's moves are checked twice.
fn ref_first_report(line: i32, col: i32) -> i32
    if line == REF_LAST_LINE and col == REF_LAST_COL
        return 0
    REF_LAST_LINE = line
    REF_LAST_COL = col
    1

pub fn ref_error_move_out(s: *EmitterState, line: i32, col: i32)
    if ref_first_report(line, col) == 0
        return
    ref_eprint_loc(line, col)
    eprints_cstr(c": error: cannot move out of a reference\n")
    s.error_count = s.error_count + 1

fn ref_error_slot(s: *EmitterState, e: *Expr)
    if ref_first_report(e.span.line, e.span.col) == 0
        return
    ref_eprint_loc(e.span.line, e.span.col)
    if e.kind == EXPR_UNARY and (e.op == OP_ADDR or e.op == OP_ADDR_MUT)
        eprints_cstr(c": error: `@x` doesn't fit a by-value slot: drop the `@`\n")
    else
        eprints_cstr(c": error: a reference or pointer doesn't fit a by-value slot: write `*` to read through it\n")
    s.error_count = s.error_count + 1

# `e` is a non-literal array of another element type than its slot's.  The
# emitter's own check comes here too, for what ref_into couldn't name.
pub fn ref_array_error(s: *EmitterState, e: *Expr)
    if ref_first_report(e.span.line, e.span.col) == 0
        return
    ref_eprint_loc(e.span.line, e.span.col)
    eprints_cstr(c": error: an array only fits a slot of the same element type: write a loop to convert it\n")
    s.error_count = s.error_count + 1

fn ref_same_shape(a: *ArrayShape, b: *ArrayShape) -> i32
    if a == null or b == null
        return 1
    if a.rank != b.rank or a.leaf_type != b.leaf_type
        return 0
    for i in 0..a.rank
        if a.dims[i] != b.dims[i]
            return 0
    if a.leaf_type != TYPE_STRUCT or a.leaf_name_len == 0 or b.leaf_name_len == 0
        return 1
    name_eq(a.leaf_name, a.leaf_name_len, b.leaf_name, b.leaf_name_len)

# 0 only when `a`'s element is known not to be `slot`'s: what the tables can't
# name stays unjudged, as above.
fn ref_same_element(a: *RefTy, slot: *RefTy) -> i32
    if a.pointee == TYPE_VOID or slot.pointee == TYPE_VOID
        return 1
    if a.pointee != slot.pointee
        return 0
    if a.pointee == TYPE_ARRAY
        return ref_same_shape(a.shape, slot.shape)
    if a.pointee == TYPE_PTR and a.elem_pointee != TYPE_VOID and slot.elem_pointee != TYPE_VOID
        if a.elem_pointee != slot.elem_pointee
            return 0
    if a.pointee != TYPE_STRUCT and (a.pointee != TYPE_PTR or a.elem_pointee != TYPE_STRUCT)
        return 1
    if a.name_len == 0 or slot.name_len == 0
        return 1
    name_eq(a.name, a.name_len, slot.name, slot.name_len)

fn ref_same_pointee(a: *RefTy, slot: *RefTy) -> i32
    if a.pointee != slot.kind
        return 0
    if slot.kind != TYPE_STRUCT
        return 1
    if a.name_len == 0 or slot.name_len == 0
        return 0
    name_eq(a.name, a.name_len, slot.name, slot.name_len)

fn ref_error_value(s: *EmitterState, e: *Expr, slot: *RefTy)
    if ref_first_report(e.span.line, e.span.col) == 0
        return
    ref_eprint_loc(e.span.line, e.span.col)
    if slot.kind == TYPE_MUT_REF
        eprints_cstr(c": error: a value doesn't fit a reference slot: write `@&x` to borrow it\n")
    else
        eprints_cstr(c": error: a value doesn't fit a reference slot: write `@x` to borrow it\n")
    s.error_count = s.error_count + 1

fn ref_error_other_pointer(s: *EmitterState, e: *Expr)
    if ref_first_report(e.span.line, e.span.col) == 0
        return
    ref_eprint_loc(e.span.line, e.span.col)
    eprints_cstr(c": error: a reference to one pointer type doesn't fit a reference to another\n")
    s.error_count = s.error_count + 1

fn ref_error_other_type(s: *EmitterState, e: *Expr)
    if ref_first_report(e.span.line, e.span.col) == 0
        return
    ref_eprint_loc(e.span.line, e.span.col)
    eprints_cstr(c": error: a reference to one type doesn't fit a reference to another: cast it with `as`\n")
    s.error_count = s.error_count + 1

# 1 for `@x` or `@&x`, written where the slot is.
fn ref_is_written(e: *Expr) -> i32
    if e.kind == EXPR_UNARY and (e.op == OP_ADDR or e.op == OP_ADDR_MUT)
        return 1
    0

# `a` goes to the `name:& T` param `p`: `@x` / `@&x` of another type than T
# would be reinterpreted (#2367, #2368).  A bare place is check_lent_ref_arg's
# "argument N has the wrong type".  ritz0's twin is
# TypeChecker._check_lent_referent.
fn ref_lent_referent(s: *EmitterState, a: *Expr, p: *Param)
    if ref_is_written(a) == 0
        return
    var slot: RefTy
    if ref_of_param(p, @slot) == 0
        return
    var t: RefTy
    if ref_ty_of(s, a, @t) == 0
        return
    if ref_is_pointer(t.kind) == 1 and ref_unsure_referent(s, a) == 0 and ref_other_written(s, a, @t, @slot) == 1
        ref_error_other_type(s, a)

# ref_other_referent for `e`, `@x` of type `a`: a `bool` local is a `bool`,
# though its slot is kept wider.
fn ref_other_written(s: *EmitterState, e: *Expr, a: *RefTy, slot: *RefTy) -> i32
    let kept: i32 = a.pointee
    if ref_bool_local(s, e.operand) == 1
        a.pointee = TYPE_BOOL
    let other: i32 = ref_other_referent(s, a, slot)
    a.pointee = kept
    other

# 1 when `x` names a local declared `bool`.
fn ref_bool_local(s: *EmitterState, x: *Expr) -> i32
    if x == null or x.kind != EXPR_IDENT
        return 0
    let idx: i32 = find_local_idx(s, x.ident_ptr, x.ident_len)
    if idx < 0
        return 0
    let loc: *LocalVar = local_at(s, idx)
    loc.is_bool

# 1 when `e` is `@x` of what the tables can't vouch for: an element through a
# Vec, Span or String, where ref_ty_of names the container (AGAST #2443), not
# the element.  An un-annotated scalar `let` / `var` is typed as its initialiser
# since AGAST #2527 (inferred_int_init), so the local table vouches for it.
fn ref_unsure_referent(s: *EmitterState, e: *Expr) -> i32
    let x: *Expr = e.operand
    if x == null or x.kind != EXPR_INDEX
        return 0
    var en: *u8 = null
    var el: i32 = 0
    index_through_struct(s, x, @en, @el)

# `a` is `@x` of an `x` known not to be what `slot` refers to: exactly, not by
# width (Aaron's ruling on AGAST #2368), so `@&u32` doesn't fit `@&i32`.  ritz0's
# twin is TypeChecker._other_referent.  A `*T` x into an `@*U` is
# ref_value_into_ref's own question, "a reference to one pointer type", and what
# the tables can't name stays unjudged.
fn ref_other_referent(s: *EmitterState, a: *RefTy, slot: *RefTy) -> i32
    var x: i32 = a.pointee
    var want: i32 = slot.pointee
    # A field, an element or a payload keeps a `*S`'s name and not the kind.
    if want == TYPE_VOID and slot.name_len > 0
        want = TYPE_STRUCT
    # The parser names a `-> *X` return after the last type it saw when X isn't
    # a struct (`-> *[2]i32` after a `*C`), so that name only judges a struct.
    if slot.name_only == 1 and x != TYPE_STRUCT
        return 0
    # A scalar pointee with a name contradicts itself: a generic's `v: T` at
    # `T = *i32` or `*C` keeps the name and a defaulted kind (`i64`).
    if want != TYPE_STRUCT and want != TYPE_ARRAY and slot.name_len > 0
        return 0
    # A pointer referent is another type than any the tables name; two of them
    # are ref_value_into_ref's "a reference to one pointer type".
    let xp: i32 = (x == TYPE_PTR or x == TYPE_PTR_PTR) as i32
    let wp: i32 = (want == TYPE_PTR or want == TYPE_PTR_PTR) as i32
    if xp == 1 and wp == 1
        return 0
    if xp == 1
        return ref_judged(s, want, slot)
    if wp == 1
        return ref_judged(s, x, a)
    if ref_judged(s, x, a) == 0 or ref_judged(s, want, slot) == 0
        return 0
    if x != want
        return 1
    if x == TYPE_STRUCT
        return 1 - name_eq(a.name, a.name_len, slot.name, slot.name_len)
    if x == TYPE_ARRAY
        if a.ref_size > 0 and slot.ref_size > 0 and a.ref_size != slot.ref_size
            return 1
        if ref_judged(s, a.ref_elem, a) == 1 and ref_judged(s, slot.ref_elem, slot) == 1
            if a.ref_elem != slot.ref_elem
                return 1
            if a.ref_elem == TYPE_STRUCT
                return 1 - name_eq(a.name, a.name_len, slot.name, slot.name_len)
    0

# 1 when `kind`, with `t`'s name, is a referent the tables name: a scalar, an
# array, or a struct that is one.  A `*i32` return or field, or a generic's
# `*T`, keeps a name and no kind, so a name that isn't a struct is unjudged.
fn ref_judged(s: *EmitterState, kind: i32, t: *RefTy) -> i32
    if kind == TYPE_VOID or kind == TYPE_UNKNOWN or kind == TYPE_PTR or kind == TYPE_PTR_PTR
        return 0
    if ref_is_pointer(kind) == 1
        return 0
    if kind != TYPE_STRUCT
        return 1
    if t.name_len == 0 or find_struct(s, t.name, t.name_len) == null
        return 0
    1

# 1 when `e` names a `name:& T` param.
fn ref_names_lent(s: *EmitterState, e: *Expr) -> i32
    if e.kind != EXPR_IDENT
        return 0
    let idx: i32 = find_local_idx(s, e.ident_ptr, e.ident_len)
    if idx < 0
        return 0
    let loc: *LocalVar = local_at(s, idx)
    return loc.is_lent

# `a`, which `e` has, is what `slot` refers to.
fn ref_is_referent(a: *RefTy, slot: *RefTy) -> i32
    # A field, an element or a payload keeps a `*S`'s name and not the kind.
    if slot.pointee == TYPE_VOID and slot.name_len > 0 and a.kind == TYPE_STRUCT
        return name_eq(a.name, a.name_len, slot.name, slot.name_len)
    if a.kind != slot.pointee
        return 0
    if a.kind != TYPE_STRUCT
        return 1
    name_eq(a.name, a.name_len, slot.name, slot.name_len)

# `e`, of type `a`, lands in reference or pointer `slot`.  Only a pointer fits:
# a `T` never does, and `@T` and `@&T` take nothing else.  `*U` is a `T` too, for
# an `@*U`.  A plain integer into a `*U` of another `U` is a pointer as an
# integer, which is another question; a `:&` param isn't one.
fn ref_value_into_ref(s: *EmitterState, e: *Expr, a: *RefTy, slot: *RefTy)
    if ref_is_pointer(a.kind) == 1
        if ref_is_written(e) == 1 and ref_unsure_referent(s, e) == 0 and ref_other_written(s, e, a, slot) == 1
            ref_error_other_type(s, e)
            return
        if slot.pointee != TYPE_PTR or slot.kind == TYPE_PTR
            return
        if a.kind == TYPE_PTR and a.pointee != TYPE_PTR
            ref_error_value(s, e, slot)
        else if a.pointee == TYPE_PTR and a.name_len > 0 and slot.name_len > 0
            if name_eq(a.name, a.name_len, slot.name, slot.name_len) == 0
                ref_error_other_pointee(s, e)
        else if a.pointee == TYPE_PTR and ref_other_ptr_pointee(a, slot) == 1
            ref_error_other_pointee(s, e)
        return
    if slot.kind != TYPE_PTR or ref_is_referent(a, slot) == 1 or ref_names_lent(s, e) == 1
        ref_error_value(s, e, slot)

# `e`'s `*U` isn't the `*U` its slot refers to.  `@q` of a reference `q` is
# ritz0's "a reference to one type" (TypeChecker._other_referent, AGAST #3160);
# any other `*U` is "one pointer type".
fn ref_error_other_pointee(s: *EmitterState, e: *Expr)
    if ref_addr_of_reference(s, e) == 1
        ref_error_other_type(s, e)
    else
        ref_error_other_pointer(s, e)

# 1 when `e` is `@q` / `@&q` of a `q` that is an `@U` or `@&U`.
fn ref_addr_of_reference(s: *EmitterState, e: *Expr) -> i32
    if ref_is_written(e) == 0
        return 0
    var t: RefTy
    if ref_ty_of(s, e.operand, @t) == 0
        return 0
    (t.kind == TYPE_REF or t.kind == TYPE_MUT_REF) as i32

# AGAST #2364: 1 when `a`'s `*U` pointee is known not to be `slot`'s.  A scalar
# U has no name for the branch above to compare, so the kinds are, exactly, as
# ritz0's TypeChecker does (`*u32` isn't `*i32`); so is a struct U against a
# scalar one.  A U either side didn't record stays unjudged.  A generic's
# instance keeps U's name even when it's a scalar (`g<i64>`), and its kind with it.
fn ref_other_ptr_pointee(a: *RefTy, slot: *RefTy) -> i32
    let x: i32 = a.ptr_pointee
    let want: i32 = slot.ptr_pointee
    if x == TYPE_VOID or x == TYPE_UNKNOWN or want == TYPE_VOID or want == TYPE_UNKNOWN
        return 0
    (x != want) as i32

fn ref_is_span(slot: *RefTy) -> i32
    if slot.kind != TYPE_STRUCT or slot.name_len <= 5
        return 0
    return (memcmp(slot.name, c"Span$", 5) == 0) as i32

fn ref_tail_set(t: *RefTail, e: *Expr, slot: *RefTy)
    t.e = e
    t.slot = *slot

fn ref_note(e: *Expr, slot: *RefTy)
    if REF_TAIL_COUNT == REF_TAIL_CAP
        let cap: i32 = REF_TAIL_CAP * 2 + 16
        let grown: *RefTail = malloc((cap as i64) * sizeof(RefTail)) as *RefTail
        for i in 0..REF_TAIL_COUNT
            let old: *RefTail = REF_TAILS + i
            ref_tail_set(grown + i, old.e, @old.slot)
        if REF_TAILS != null
            free(REF_TAILS as *u8)
        REF_TAILS = grown
        REF_TAIL_CAP = cap
    ref_tail_set(REF_TAILS + REF_TAIL_COUNT, e, slot)
    REF_TAIL_COUNT = REF_TAIL_COUNT + 1

fn ref_note_arms(arms: *MatchArm, slot: *RefTy)
    var arm: *MatchArm = arms
    while arm != null
        if arm.is_pass == 0 and arm.body != null
            ref_note_value(arm.body, slot)
        else
            ref_note_stmts(arm.body_stmts, slot)
        arm = arm.next

fn ref_note_value(e: *Expr, slot: *RefTy)
    if e == null
        return
    if e.kind == EXPR_IF or e.kind == EXPR_MATCH
        ref_note_arms(e.args as *MatchArm, slot)
    else
        ref_note(e, slot)

# The last statement of `list` is its value.
fn ref_note_stmts(list: *Stmt, slot: *RefTy)
    var st: *Stmt = list
    if st == null
        return
    while st.next != null
        st = st.next
    if st.kind == STMT_EXPR
        ref_note_value(st.expr, slot)
    else if st.kind == STMT_IF
        ref_note_stmts(st.if_then, slot)
        ref_note_stmts(st.if_else, slot)
    else if st.kind == STMT_MATCH
        ref_note_arms(st.if_then as *MatchArm, slot)

# `e`'s value lands in `slot`.
fn ref_into(s: *EmitterState, e: *Expr, slot: *RefTy)
    if e == null or slot.kind == TYPE_VOID and slot.returned == 0
        return
    if e.kind == EXPR_IF or e.kind == EXPR_MATCH
        ref_note_value(e, slot)
        return
    if slot.kind == TYPE_MUT_REF
        ref_addr_into_mut(s, e)
        ref_shared_into_mut(s, e)
    if slot.returned == 1
        ref_check_return(s, e)
    if slot.kind == TYPE_VOID
        return
    if e.kind == EXPR_ARRAY_LIT and slot.kind == TYPE_ARRAY
        var part: RefTy
        ref_element(slot, @part)
        var el: *Expr = e.args
        while el != null
            ref_into(s, el, @part)
            el = el.next
        return
    if e.kind == EXPR_ARRAY_FILL and slot.kind == TYPE_ARRAY
        var fill: RefTy
        ref_element(slot, @fill)
        ref_into(s, e.left, @fill)
        return
    var a: RefTy
    if ref_ty_of(s, e, @a) == 1
        if ref_is_pointer(slot.kind) == 1
            ref_value_into_ref(s, e, @a, slot)
        else if a.kind == TYPE_ARRAY and ref_is_span(slot) == 1
            ref_error_value(s, e, slot)
        else if ref_is_pointer(a.kind) == 1 and ref_same_pointee(@a, slot) == 1
            ref_error_slot(s, e)
        else if a.kind == TYPE_ARRAY and slot.kind == TYPE_ARRAY and ref_same_element(@a, slot) == 0
            ref_array_error(s, e)
    ref_into_variant(s, e, slot)

# What an element of the array `slot` lands in.
fn ref_element(slot: *RefTy, out: *RefTy)
    if slot.pointee != TYPE_ARRAY or ref_row(slot, out) == 0
        ref_set(out, slot.pointee, 0, slot.name, slot.name_len)
        out.elem_pointee = TYPE_VOID

# `Some(x)`, `Ok(x)` or `Err(x)` into an instance of Option or Result: its name
# says what the payload is, for a struct.
fn ref_into_variant(s: *EmitterState, e: *Expr, slot: *RefTy)
    if e.kind != EXPR_CALL or e.args == null or slot.kind != TYPE_STRUCT
        return
    var variant: i32 = 0
    if name_eq(e.func_name, e.func_name_len, c"Err", 3) == 1
        variant = 1
    else if name_eq(e.func_name, e.func_name_len, c"Some", 4) == 0 and name_eq(e.func_name, e.func_name_len, c"Ok", 2) == 0
        return
    var len: i32 = 0
    let name: *u8 = tagged_enum_arg(s, slot.name, slot.name_len, variant, @len)
    if name == null
        return
    var part: RefTy
    if ref_of_mangled_ref(s, name, len, @part) == 0
        if find_struct(s, name, len) == null
            return
        ref_set(@part, TYPE_STRUCT, 0, name, len)
    ref_into(s, e.args, @part)

# AGAST #2384: the slot a reference type argument spells, as ref_of_param
# makes one for a parameter of that type: "refmut_C" is `@&C`, "ref_i32"
# `@i32`, "refmut_ptr_C" `@&*C`, "ref_arr2_i8" `@[2]i8`.  0 for anything
# else, or a referent this can't read back (it goes unjudged, as before).
fn ref_of_mangled_ref(s: *EmitterState, name: *u8, len: i32, out: *RefTy) -> i32
    var kind: i32 = TYPE_REF
    var k: i32 = 4
    if len > 7 and memcmp(name, c"refmut_", 7) == 0
        kind = TYPE_MUT_REF
        k = 7
    else if len <= 4 or memcmp(name, c"ref_", 4) != 0
        return 0
    let r: *u8 = name + k
    let n: i32 = len - k
    let prim: i32 = primitive_type_from_name(r, n)
    if prim != 0
        return ref_set(out, kind, prim, null, 0)
    if n > 4 and memcmp(r, c"ptr_", 4) == 0
        # The pointer's own pointee is only a name here, as for a struct one.
        if primitive_type_from_name(r + 4, n - 4) != 0
            return ref_set(out, kind, TYPE_PTR, null, 0)
        return ref_set(out, kind, TYPE_PTR, r + 4, n - 4)
    var size: i32 = 0
    var elem: i32 = 0
    if ref_mangled_array(r, n, @size, @elem) == 1
        ref_set(out, kind, TYPE_ARRAY, null, 0)
        out.ref_size = size
        out.ref_elem = elem
        return 1
    if find_struct(s, r, n) == null
        return 0
    ref_set(out, kind, TYPE_STRUCT, r, n)

# "arr" N "_" E with E a primitive: N to *size, E's TYPE_* to *elem.  1 if so.
fn ref_mangled_array(r: *u8, n: i32, size: *i32, elem: *i32) -> i32
    if n < 6 or memcmp(r, c"arr", 3) != 0
        return 0
    var pos: i32 = 3
    var v: i32 = 0
    while pos < n and *(r + pos) >= 48 and *(r + pos) <= 57
        v = v * 10 + (*(r + pos) - 48) as i32
        pos = pos + 1
    if pos == 3 or pos + 1 >= n or *(r + pos) != 95   # '_'
        return 0
    let t: i32 = primitive_type_from_name(r + pos + 1, n - pos - 1)
    if t == 0
        return 0
    *size = v
    *elem = t
    1

fn ref_payload(s: *EmitterState, a0: *Expr, ei: i32, vi: i32)
    var a: *Expr = a0
    var f: *StructField = enum_variant_fields(ei, vi)
    while a != null and f != null
        var slot: RefTy
        ref_field_slot(f, @slot)
        ref_into(s, a, @slot)
        a = a.next
        f = f.next

fn ref_args(s: *EmitterState, a0: *Expr, p0: *Param)
    # An argument's loan lasts until the call's arguments are done (#2438).
    let loans: i32 = REF_LOAN_COUNT
    REF_IN_ARGS = REF_IN_ARGS + 1
    var a: *Expr = a0
    var p: *Param = p0
    while a != null
        if p != null
            var slot: RefTy
            if p.is_borrow == 1
                ref_addr_into_mut(s, a)
                ref_lent_referent(s, a, p)
                if ref_lends_place(s, a, p) == 1
                    let root: i32 = ref_loan_root(s, a)
                    if ref_loan_use(s, a.span.line, a.span.col, root, a, 1, 0) == 1
                        ref_loan_add(root, a, 1, REF_LOAN_ARG)
                ref_forget(s, a)
            else if ref_of_param(p, @slot) == 1
                ref_into(s, a, @slot)
            p = p.next
        ref_walk(s, a)
        a = a.next
    REF_IN_ARGS = REF_IN_ARGS - 1
    if REF_LOAN_COUNT > loans
        REF_LOAN_COUNT = loans

fn ref_walk_list(s: *EmitterState, a0: *Expr)
    var a: *Expr = a0
    while a != null
        ref_walk(s, a)
        a = a.next

# A `**T` slot, at a field, a `let` or an `=` (AGAST #2370, #2528): a pointer
# whose referent is a pointer, whatever T is.  Nameless, so ref_other_referent
# judges `@n` of any type the tables name as another type, and a `:&` param
# bare is a value; `@q` of a `*U` and a `**U` value stay unjudged, and so does a
# `*U` value, which ritz0 refuses (AGAST #3048).
fn ref_ptr_ptr_slot(out: *RefTy) -> i32
    ref_set(out, TYPE_PTR, TYPE_PTR, null, 0)

# The slot an `=` to the name `name` writes: what it holds, or a `**T` slot.
fn ref_slot_of_name(s: *EmitterState, name: *u8, len: i32, out: *RefTy) -> i32
    if ref_of_ident(s, name, len, out) == 1
        return 1
    let idx: i32 = find_local_idx(s, name, len)
    var t: i32 = TYPE_VOID
    if idx >= 0
        t = local_at(s, idx).var_type
    else
        let g: *GlobalVarDef = find_global(s, name, len)
        if g != null
            t = g.var_type
    if t != TYPE_PTR_PTR
        return 0
    ref_ptr_ptr_slot(out)

# What field `f` takes, as a slot.
fn ref_field_slot(f: *StructField, out: *RefTy)
    if f.field_type == TYPE_ARRAY
        ref_of_array_field(f, out)
    else if f.field_type == TYPE_PTR_PTR
        ref_ptr_ptr_slot(out)
    else if f.field_type == TYPE_PTR and f.field_mut_ref == 1
        ref_set(out, TYPE_MUT_REF, f.array_elem_type, f.field_type_name, f.field_type_name_len)
    else
        ref_set(out, f.field_type, f.array_elem_type, f.field_type_name, f.field_type_name_len)

fn ref_walk_struct(s: *EmitterState, e: *Expr)
    let st: *StructDef = find_struct(s, e.ident_ptr, e.ident_len)
    var fi: *FieldInit = e.args as *FieldInit
    while fi != null
        if st != null
            let idx: i32 = find_field_index(st, fi.name, fi.name_len)
            if idx >= 0
                let f: *StructField = get_field_type(st, idx)
                var slot: RefTy
                ref_field_slot(f, @slot)
                ref_into(s, fi.value, @slot)
        ref_walk(s, fi.value)
        fi = fi.next

# Every slot inside `e`.  An `if` or `match` is its condition here: its arms
# come through own_check_arm.
# `[v; n]` copies its one value into each element: n > 1 of a move-only `v`
# would drop it n times (AGAST #2963). ritz0's words, from array_rules.py.
fn ref_check_fill(s: *EmitterState, e: *Expr)
    if e.int_val <= 1
        return
    var name: *u8 = null
    var len: i32 = 0
    if e.left.kind == EXPR_STRUCT_LIT
        name = e.left.ident_ptr
        len = e.left.ident_len
    else
        var t: RefTy
        if ref_ty_of(s, e.left, @t) == 0 or ref_is_pointer(t.kind) == 1
            return
        name = t.name
        len = t.name_len
    if len == 0 or own_type_is_move_only(s, name, len) == 0
        return
    if ref_first_report(e.span.line, e.span.col) == 0
        return
    ref_eprint_loc(e.span.line, e.span.col)
    eprints_cstr(c": error: `[v; n]` copies `v` into every element: a move-only value fills one, `[v; 1]`\n")
    s.error_count = s.error_count + 1

fn ref_walk(s: *EmitterState, e: *Expr)
    if e == null
        return
    let k: i32 = e.kind
    if k == EXPR_CALL
        if e.func_name_len == 6 and name_eq(e.func_name, e.func_name_len, c"sizeof", 6) == 1
            return
        # AGAST #3015: `S_deref(@b)` made for `b.f` (R17) is a step of the
        # place `b.f`, which the borrow it's in is of; it lends nothing itself.
        if df_is_step(e) == 1
            let sa: *Expr = e.args
            if sa != null and sa.kind == EXPR_UNARY and (sa.op == OP_ADDR or sa.op == OP_ADDR_MUT)
                ref_walk(s, sa.operand)
            else
                ref_walk(s, sa)
            return
        var en: *u8 = null
        var el: i32 = 0
        user_variant_ctor_enum(e, @en, @el)
        if en != null
            var vi: i32 = 0
            var other: i32 = 0
            let ei: i32 = enum_of_variant_unique(e.func_name, e.func_name_len, @vi, @other)
            if ei >= 0
                ref_payload(s, e.args, ei, vi)
            ref_walk_list(s, e.args)
            return
        var p: *Param = null
        # A call through a `fn(...)` local or param.  A local named like a fn
        # is the local, as emit_call calls it (#2407, #2417): `let f = mb`
        # inside `fn f` calls mb, so its slots are mb's.
        var f: *FnDef = null
        var li: i32 = 0 - 1
        if e.func_name_len > 0 and e.call_type_suffix_len == 0
            li = find_local_idx(s, e.func_name, e.func_name_len)
        if li >= 0
            let callee: *LocalVar = local_at(s, li)
            f = callee.fn_sig
        else
            f = find_call_fn(s, e)
        if f != null
            p = f.params
        ref_args(s, e.args, p)
    else if k == EXPR_METHOD
        var qv: i32 = 0
        let qe: i32 = qualified_variant(s, e, @qv)
        if qe >= 0
            ref_payload(s, e.args, qe, qv)
            ref_walk_list(s, e.args)
            return
        ref_walk(s, e.left)
        var mp: *Param = null
        let m: *FnDef = ref_method_def(s, e)
        if m != null
            # A method found by a looser name, `v.push(x)` for `vec_push(v, x)`,
            # takes the receiver as an argument: its params don't line up, so
            # the slots go unjudged, as in ritz0.
            mp = m.params
            ref_check_receiver(s, e, mp)
            ref_loan_receiver(s, e, mp)
            if mp != null and name_eq(mp.name, mp.name_len, c"self", 4) == 1
                mp = mp.next
            else
                mp = null
        ref_args(s, e.args, mp)
    else if k == EXPR_STRUCT_LIT
        ref_walk_struct(s, e)
    else if k == EXPR_ARRAY_LIT
        ref_walk_list(s, e.args)
    else if k == EXPR_ARRAY_FILL
        ref_check_fill(s, e)
        ref_walk(s, e.left)
    else if k == EXPR_UNARY
        if e.op == OP_ADDR_MUT or e.op == OP_ADDR
            var mutable: i32 = 0
            if e.op == OP_ADDR_MUT
                mutable = 1
            let root: i32 = ref_loan_root(s, e.operand)
            if ref_loan_use(s, e.span.line, e.span.col, root, e.operand, mutable, 0) == 1 and REF_IN_ARGS > 0
                ref_loan_add(root, e.operand, mutable, REF_LOAN_ARG)
        if e.op == OP_ADDR_MUT
            ref_check_borrow(s, e)
        if e.op == OP_ADDR_MUT or e.op == OP_ADDR
            ref_forget(s, e.operand)
        ref_walk(s, e.operand)
    else if k == EXPR_BINARY or k == EXPR_INDEX or k == EXPR_RANGE
        ref_walk(s, e.left)
        ref_walk(s, e.right)
    else if k == EXPR_MEMBER or k == EXPR_CAST or k == EXPR_TRY or k == EXPR_MATCH or k == EXPR_IF
        if k == EXPR_CAST and e.cast_array != null
            var target: RefTy
            ref_set_elem(@target, e.cast_array)
            ref_into(s, e.left, @target)
        if k == EXPR_CAST
            ref_cast_move_only(s, e)
            ref_cast_value_to_ref(s, e)
        ref_walk(s, e.left)

# `c as @&C`, `c as @C` or `c as *C` with `c` a struct or array value, a `:&`
# param's included (AGAST #2370): a cast isn't a borrow, so it's the bare form's
# error, as ritz0's TypeChecker._check_cast_to_ref.  An integer source is the
# integer-to-pointer cast and stays; a string literal is a `*u8` already, and a
# StrView or String into a `*T` has LARB R3's own words (AGAST #2341).
fn ref_cast_value_to_ref(s: *EmitterState, e: *Expr)
    if e.op != TYPE_PTR and e.op != TYPE_REF and e.op != TYPE_MUT_REF
        return
    if e.left == null or e.left.kind == EXPR_STRING_LIT
        return
    var a: RefTy
    if ref_ty_of(s, e.left, @a) == 0
        return
    if a.kind != TYPE_STRUCT and a.kind != TYPE_ARRAY
        return
    if e.op == TYPE_PTR and a.kind == TYPE_STRUCT
        if name_eq(a.name, a.name_len, c"StrView", 7) == 1 or name_eq(a.name, a.name_len, c"String", 6) == 1
            return
    var target: RefTy
    ref_set(@target, e.op, 0, null, 0)
    ref_error_value(s, e.left, @target)

# `r as T` with `r: @T`, `@&T` or `*T` and T move-only (AGAST #2985): the
# plain slot's error, at `r`, as ritz0's MoveChecker._check_ref_cast.  Without
# it the cast copies the value out from behind the reference, and both owners
# drop it.  A copy T is left alone, and so is a cast to a pointer type.
fn ref_cast_move_only(s: *EmitterState, e: *Expr)
    if e.op != TYPE_STRUCT or e.ident_len == 0
        return
    if own_type_is_move_only(s, e.ident_ptr, e.ident_len) == 0
        return
    var target: RefTy
    ref_set(@target, TYPE_STRUCT, 0, e.ident_ptr, e.ident_len)
    ref_into(s, e.left, @target)

# `r as C` with `r: @C`, `@&C` or `*C` (AGAST #3004): 1 when the cast reads the
# referent, as ritz0 does, so the emitter loads a `%C` copy through `r` and
# resolve_expr_struct_name types it `%C`.  The move-only C was refused above.
# A target other than the referent is left as it was: neither compiler defines
# a struct-to-struct `as` (AGAST #3012).
pub fn ref_cast_reads_referent(s: *EmitterState, e: *Expr) -> i32
    if e.kind != EXPR_CAST or e.op != TYPE_STRUCT or e.ident_len == 0
        return 0
    var a: RefTy
    if ref_ty_of(s, e.left, @a) == 0 or ref_is_pointer(a.kind) == 0
        return 0
    var target: RefTy
    ref_set(@target, TYPE_STRUCT, 0, e.ident_ptr, e.ident_len)
    ref_same_pointee(@a, @target)

# `e` is about to be emitted as a tail: judge it against the slot it was noted
# for, now its arm's bindings are in scope.
fn ref_landed(s: *EmitterState, e: *Expr)
    let tails: *RefTail = REF_TAILS
    var i: i32 = 0
    while i < REF_TAIL_COUNT
        let t: *RefTail = tails + i
        if t.e == e
            ref_into(s, e, @t.slot)
            return
        i = i + 1

pub fn ref_begin_fn(s: *EmitterState, f: *FnDef)
    REF_TAIL_COUNT = 0
    REF_LAST_LINE = 0
    REF_LAST_COL = 0
    REF_LOOPS = 0
    REF_DECL_ROOT = null
    REF_LOAN_COUNT = 0
    REF_IN_ARGS = 0
    ref_mark_params(s, f.params)
    if ref_of_fn(f, @REF_RET) == 0
        REF_RET.kind = TYPE_VOID
    # `-> *i32` and `-> **T` name nothing ref_of_fn can, and still leave as pointers.
    REF_RET.returned = 0
    if ref_is_pointer(f.return_type) == 1 or f.return_type == TYPE_PTR_PTR
        REF_RET.returned = 1
    if REF_RET.kind != TYPE_VOID or REF_RET.returned == 1
        ref_note_stmts(f.body, @REF_RET)

# A tail or an arm's value.
pub fn ref_check_value(s: *EmitterState, e: *Expr)
    ref_landed(s, e)
    ref_walk(s, e)

fn ref_decl_slot(stmt: *Stmt, out: *RefTy) -> i32
    if stmt.var_declared_type == TYPE_VOID
        return 0
    if stmt.var_type == TYPE_PTR_PTR
        return ref_ptr_ptr_slot(out)
    if stmt.var_type == TYPE_ARRAY
        return ref_set_array(out, stmt.var_array_elem_type, stmt.var_array_elem_pointee, stmt.var_type_name, stmt.var_type_name_len, stmt.var_array_shape)
    ref_set(out, stmt.var_type, stmt.var_pointee_type, stmt.var_type_name, stmt.var_type_name_len)
    if stmt.var_pointee_type == TYPE_ARRAY
        out.ref_size = stmt.var_pointee_array_size
        out.ref_elem = stmt.var_pointee_array_elem_type
    out.ptr_pointee = ref_decl_ptr_pointee(stmt)
    1

# AGAST #2364: U for a local declared `@*U` / `@&*U`; TYPE_VOID otherwise.
fn ref_decl_ptr_pointee(stmt: *Stmt) -> i32
    if stmt.var_ref == null or stmt.var_pointee_type != TYPE_PTR
        return TYPE_VOID
    stmt.var_ref.param_ref_ptr_pointee

# `x.f = v` and `p.f = v`: the field is named by assign_target, on `owner`.
fn ref_into_field(s: *EmitterState, stmt: *Stmt, owner: *RefTy)
    if owner.name_len == 0
        return
    let st: *StructDef = find_struct(s, owner.name, owner.name_len)
    if st == null
        return
    let idx: i32 = find_field_index(st, stmt.assign_target, stmt.assign_target_len)
    if idx < 0
        return
    let f: *StructField = get_field_type(st, idx)
    var slot: RefTy
    ref_field_slot(f, @slot)
    ref_into(s, stmt.assign_value, @slot)

# What a write's place evaluates on the way: its base and its index.
fn ref_walk_target(s: *EmitterState, stmt: *Stmt)
    let k: i32 = stmt.kind
    if k == STMT_MEMBER_ASSIGN or k == STMT_MEMBER_INDEX_ASSIGN or k == STMT_ASSIGN and stmt.assign_target_len == 0
        ref_walk(s, stmt.if_cond as *Expr)
    if k == STMT_INDEX_ASSIGN or k == STMT_LOCAL_FIELD_INDEX_ASSIGN or k == STMT_MEMBER_INDEX_ASSIGN
        ref_walk(s, stmt.while_cond)

pub fn ref_check_stmt(s: *EmitterState, stmt: *Stmt)
    let k: i32 = stmt.kind
    ref_check_write(s, stmt)
    ref_walk_target(s, stmt)
    ref_loan_write(s, stmt)
    if k == STMT_FOR
        ref_for_hold(s, stmt)
    var slot: RefTy
    if k == STMT_VAR_DECL
        if stmt.var_init != null and ref_decl_slot(stmt, @slot) == 1
            ref_into(s, stmt.var_init, @slot)
        ref_walk(s, stmt.var_init)
        REF_DECL_ROOT = ref_referent(s, stmt.var_init, @REF_DECL_ROOT_LEN)
        if REF_DECL_ROOT != null and ref_referent_ty(s, stmt.var_init, @REF_DECL_TY) == 0
            REF_DECL_TY.pointee = TYPE_VOID
    else if k == STMT_TUPLE_DECL
        ref_walk(s, stmt.var_init)
    else if k == STMT_ASSIGN
        var known: i32 = 0
        if stmt.assign_target_len > 0
            known = ref_slot_of_name(s, stmt.assign_target, stmt.assign_target_len, @slot)
        else
            known = ref_ty_of(s, stmt.if_cond as *Expr, @slot)
        if known == 1
            ref_into(s, stmt.assign_value, @slot)
        ref_walk(s, stmt.assign_value)
        if stmt.assign_target_len > 0
            ref_forget_name(s, stmt.assign_target, stmt.assign_target_len)
    else if k == STMT_RETURN
        ref_into(s, stmt.return_value, @REF_RET)
        ref_walk(s, stmt.return_value)
    else if k == STMT_EXPR
        ref_check_value(s, stmt.expr)
    else if k == STMT_MATCH
        ref_walk(s, stmt.if_cond as *Expr)
    else if k == STMT_IF or k == STMT_ASSERT
        ref_walk(s, stmt.if_cond)
    else if k == STMT_WHILE
        ref_walk(s, stmt.while_cond)
        REF_LOOPS = REF_LOOPS + 1
    else if k == STMT_FOR
        ref_walk(s, stmt.for_start)
        ref_walk(s, stmt.for_end)
        REF_LOOPS = REF_LOOPS + 1
    else if k == STMT_LOOP
        REF_LOOPS = REF_LOOPS + 1
    else if k == STMT_LOCAL_FIELD_ASSIGN
        var owner: RefTy
        if ref_of_ident(s, stmt.var_name, stmt.var_name_len, @owner) == 1
            ref_into_field(s, stmt, @owner)
        ref_walk(s, stmt.assign_value)
    else if k == STMT_MEMBER_ASSIGN
        var base: RefTy
        if ref_ty_of(s, stmt.if_cond, @base) == 1
            ref_into_field(s, stmt, @base)
        ref_walk(s, stmt.assign_value)
    else if k == STMT_INDEX_ASSIGN
        var held: RefTy
        if ref_of_ident(s, stmt.assign_target, stmt.assign_target_len, @held) == 1
            if held.kind == TYPE_ARRAY or ref_is_pointer(held.kind) == 1
                var part: RefTy
                ref_element(@held, @part)
                ref_into(s, stmt.assign_value, @part)
        ref_walk(s, stmt.assign_value)
    else if k == STMT_LOCAL_FIELD_INDEX_ASSIGN or k == STMT_MEMBER_INDEX_ASSIGN
        ref_walk(s, stmt.assign_value)

# `@T` is read-only (LANGUAGE_SPEC §3.2, §13.3, LARB ruling R1, AGAST #2338).
# ritz0's twins are TypeChecker._check_write and _check_let_into_mut, and
# ritz0/test_at_is_read_only.py holds all three compilers to them.

# What a write meets when it goes through a value.
pub const REF_VIEW_VALUE: i32 = 0
pub const REF_VIEW_RAW: i32 = 1
pub const REF_VIEW_MUT: i32 = 2
pub const REF_VIEW_SHARED: i32 = 3
pub const REF_VIEW_UNKNOWN: i32 = 4

fn ref_view_of_kind(kind: i32) -> i32
    if kind == TYPE_REF
        return REF_VIEW_SHARED
    if kind == TYPE_MUT_REF
        return REF_VIEW_MUT
    if kind == TYPE_PTR or kind == TYPE_PTR_PTR
        return REF_VIEW_RAW
    REF_VIEW_VALUE

fn ref_view_of_ident(s: *EmitterState, name: *u8, len: i32) -> i32
    let idx: i32 = find_local_idx(s, name, len)
    if idx >= 0
        let loc: *LocalVar = local_at(s, idx)
        # `c:& C` is a `C`, and so is a by-value `self`.
        if loc.is_lent == 1 or loc.holds_lent_ptr == 1
            return REF_VIEW_VALUE
        return ref_view_of_kind(loc.var_type)
    let g: *GlobalVarDef = find_global(s, name, len)
    if g == null
        return REF_VIEW_UNKNOWN
    ref_view_of_kind(g.var_type)

fn ref_view_of_fn(f: *FnDef) -> i32
    var t: RefTy
    if ref_of_fn(f, @t) == 0
        return REF_VIEW_UNKNOWN
    ref_view_of_kind(t.kind)

# What the value of `e` is, as far as a write through it goes.  An `@T` field is a
# `*T` by now (lower_ref_fields), and only its flag says otherwise.
pub fn ref_view(s: *EmitterState, e: *Expr) -> i32
    if e == null
        return REF_VIEW_UNKNOWN
    let k: i32 = e.kind
    if k == EXPR_IDENT
        return ref_view_of_ident(s, e.ident_ptr, e.ident_len)
    if k == EXPR_UNARY and e.op == OP_ADDR
        return REF_VIEW_SHARED
    if k == EXPR_UNARY and e.op == OP_ADDR_MUT
        return REF_VIEW_MUT
    if k == EXPR_MEMBER
        let f: *StructField = resolve_member_chain_field(s, e)
        if f == null
            return REF_VIEW_UNKNOWN
        if f.field_shared_ref == 1
            return REF_VIEW_SHARED
        if f.field_mut_ref == 1
            return REF_VIEW_MUT
        return ref_view_of_kind(f.field_type)
    if k == EXPR_CALL
        return ref_view_of_fn(find_call_fn(s, e))
    if k == EXPR_METHOD
        return ref_view_of_fn(ref_method_def(s, e))
    if k == EXPR_INDEX
        # An element through, `p[i]` or `(*p)[i]`, is its own kind: a `*S` one is the
        # pointer's business, anything else is a place in what `p` reaches (#2443).
        let through: *LocalVar = index_through(s, e)
        if through != null
            return ref_view_of_kind(through_elem_kind(s, through))
    # AGAST #2399: `*r` with `r: @@S` or `*@&S` (held as an `@*S` / `**S`) is the
    # `@S` / `@&S` it was.
    if k == EXPR_UNARY and e.op == OP_DEREF and e.operand != null and e.operand.kind == EXPR_IDENT
        let dl: i32 = find_local_idx(s, e.operand.ident_ptr, e.operand.ident_len)
        if dl >= 0 and local_struct_levels(local_at(s, dl)) == 2
            let nearest: i32 = local_at(s, dl).inner_ref
            if nearest == INNER_REF_SHARED
                return REF_VIEW_SHARED
            if nearest == INNER_REF_MUT
                return REF_VIEW_MUT
    var t: RefTy
    if k == EXPR_INDEX or k == EXPR_UNARY and e.op == OP_DEREF
        # What holds a pointer keeps its kind, where ref_ty_of has no pointee to give.
        var from: *Expr = e.left
        if k == EXPR_UNARY
            from = e.operand
        if ref_ty_of(s, from, @t) == 1 and ref_is_pointer(t.pointee) == 1
            return ref_view_of_kind(t.pointee)
    if ref_ty_of(s, e, @t) == 1
        return ref_view_of_kind(t.kind)
    REF_VIEW_UNKNOWN

# AGAST #2399: the reference `.` on `e` reaches the struct through last
# (INNER_REF_*): `p: @@S` or `*@S` is held as an `@*S` / `**S`, whose kind says
# the nearest level is a `*`.
fn ref_inner_ref(s: *EmitterState, e: *Expr) -> i32
    if e.kind == EXPR_IDENT
        let idx: i32 = find_local_idx(s, e.ident_ptr, e.ident_len)
        if idx >= 0
            return local_at(s, idx).inner_ref
        let g: *GlobalVarDef = find_global(s, e.ident_ptr, e.ident_len)
        if g != null
            return g.inner_ref
        return 0
    if e.kind == EXPR_MEMBER
        let f: *StructField = resolve_member_chain_field(s, e)
        if f != null
            return f.field_inner_ref
    0

# The kind of the field `e` names, or TYPE_VOID.
fn ref_field_kind(s: *EmitterState, e: *Expr) -> i32
    if e.kind != EXPR_MEMBER
        return TYPE_VOID
    let f: *StructField = resolve_member_chain_field(s, e)
    if f == null
        return TYPE_VOID
    f.field_type

# 1 when writing the place `e` goes through an `@T`.  Walk it from the place to
# its root: a `*T` ends the walk, since what it points at is the pointer's
# business, and so does anything the tables can't type.
fn ref_write_is_shared(s: *EmitterState, e0: *Expr) -> i32
    var e: *Expr = e0
    while e != null
        var base: *Expr = null
        if e.kind == EXPR_MEMBER or e.kind == EXPR_INDEX
            base = e.left
        else if e.kind == EXPR_UNARY and e.op == OP_DEREF
            base = e.operand
        else
            return 0
        if e.kind == EXPR_MEMBER and ref_inner_ref(s, base) == INNER_REF_SHARED
            return 1
        let view: i32 = ref_view(s, base)
        var t: RefTy
        let known: i32 = ref_ty_of(s, base, @t)
        if view == REF_VIEW_SHARED
            # `.` reads through every level, so the one nearest the place counts.
            if e.kind == EXPR_MEMBER and known == 1 and (t.pointee == TYPE_PTR or t.pointee == TYPE_PTR_PTR)
                return 0
            # AGAST #2399: an `@*S` field is a `**S` by now (lower_ref_fields).
            if e.kind == EXPR_MEMBER and ref_field_kind(s, base) == TYPE_PTR_PTR
                return 0
            return 1
        if view == REF_VIEW_RAW or view == REF_VIEW_UNKNOWN
            return 0
        e = base
    0

fn ref_expr_ident(e: *Expr, name: *u8, len: i32)
    memset(e as *u8, 0, sizeof(Expr))
    e.kind = EXPR_IDENT
    e.ident_ptr = name
    e.ident_len = len

fn ref_expr_member(e: *Expr, base: *Expr, name: *u8, len: i32)
    memset(e as *u8, 0, sizeof(Expr))
    e.kind = EXPR_MEMBER
    e.left = base
    e.ident_ptr = name
    e.ident_len = len

fn ref_expr_index(e: *Expr, base: *Expr)
    memset(e as *u8, 0, sizeof(Expr))
    e.kind = EXPR_INDEX
    e.left = base

# The statement forms the parser splits a place into, put back together.
fn ref_stmt_writes_shared(s: *EmitterState, stmt: *Stmt) -> i32
    let k: i32 = stmt.kind
    var root: Expr
    var member: Expr
    var element: Expr
    if k == STMT_ASSIGN
        if stmt.assign_target_len > 0
            return 0
        return ref_write_is_shared(s, stmt.if_cond as *Expr)
    if k == STMT_INDEX_ASSIGN
        ref_expr_ident(@root, stmt.assign_target, stmt.assign_target_len)
        ref_expr_index(@element, @root)
        return ref_write_is_shared(s, @element)
    if k == STMT_LOCAL_FIELD_ASSIGN or k == STMT_LOCAL_FIELD_INDEX_ASSIGN
        ref_expr_ident(@root, stmt.var_name, stmt.var_name_len)
        ref_expr_member(@member, @root, stmt.assign_target, stmt.assign_target_len)
    else if k == STMT_MEMBER_ASSIGN or k == STMT_MEMBER_INDEX_ASSIGN
        ref_expr_member(@member, stmt.if_cond as *Expr, stmt.assign_target, stmt.assign_target_len)
    else
        return 0
    if k == STMT_LOCAL_FIELD_ASSIGN or k == STMT_MEMBER_ASSIGN
        return ref_write_is_shared(s, @member)
    ref_expr_index(@element, @member)
    ref_write_is_shared(s, @element)

fn ref_check_write(s: *EmitterState, stmt: *Stmt)
    if ref_stmt_writes_shared(s, stmt) == 0
        return
    # `(*p).f = v` starts at the `(`, and the place at the `*`.
    var col: i32 = stmt.span.col
    if stmt.kind == STMT_MEMBER_ASSIGN or stmt.kind == STMT_MEMBER_INDEX_ASSIGN
        col = col + 1
    if ref_first_report(stmt.span.line, col) == 0
        return
    ref_eprint_loc(stmt.span.line, col)
    eprints_cstr(c": error: cannot write through an `@T`: make it `@&T`\n")
    s.error_count = s.error_count + 1

# `e` lands in an `@&T` or a `:&` param, which `@x` never does (LANGUAGE_SPEC §13.3,
# AGAST #2339).  Of a `let`, or of a place behind an `@T`, `@&x` wouldn't do either,
# so those say what would.  ritz0's twin is TypeChecker._check_addr_into_mut.
fn ref_addr_into_mut(s: *EmitterState, e: *Expr)
    if let_addr_of_own(s, e) == 1
        if ref_first_report(e.span.line, e.span.col) == 1
            let_error_addr(s, e)
    else if e.kind == EXPR_UNARY and e.op == OP_ADDR
        if ref_write_is_shared(s, e.operand) == 1
            ref_check_borrow(s, e)
        else if ref_first_report(e.span.line, e.span.col) == 1
            ref_eprint_loc(e.span.line, e.span.col)
            eprints_cstr(c": error: `@x` is shared and doesn't fit an `@&T` or `:&` slot: write `@&x`\n")
            s.error_count = s.error_count + 1

# An `@T` doesn't become an `@&T` (LANGUAGE_SPEC §3.2, §13.3, AGAST #2374).  ritz0's
# twins are TypeChecker._check_borrow, _check_shared_into_mut and _check_receiver,
# and ritz0/test_at_into_mut.py holds all three compilers to them.

fn ref_error_shared_into_mut(s: *EmitterState, e: *Expr)
    if ref_first_report(e.span.line, e.span.col) == 0
        return
    ref_eprint_loc(e.span.line, e.span.col)
    eprints_cstr(c": error: an `@T` doesn't fit an `@&T` slot: make it `@&T`\n")
    s.error_count = s.error_count + 1

# `e` is a mutable borrow of its operand.
fn ref_check_borrow(s: *EmitterState, e: *Expr)
    if ref_write_is_shared(s, e.operand) == 0
        return
    if ref_first_report(e.span.line, e.span.col) == 0
        return
    ref_eprint_loc(e.span.line, e.span.col)
    eprints_cstr(c": error: cannot borrow through an `@T` as mutable: make it `@&T`\n")
    s.error_count = s.error_count + 1

# `e` lands in an `@&T`.  `@x` is ref_addr_into_mut's.  An `@&T` reached through an
# `@T`, as `h.m` of `h: @H` is, is read-only too (#2381): what `e` points at is walked.
fn ref_shared_into_mut(s: *EmitterState, e: *Expr)
    if e.kind == EXPR_UNARY and e.op == OP_ADDR
        return
    let view: i32 = ref_view(s, e)
    if view == REF_VIEW_SHARED
        ref_error_shared_into_mut(s, e)
        return
    if view != REF_VIEW_MUT
        return
    var pointee: Expr
    memset(@pointee as *u8, 0, sizeof(Expr))
    pointee.kind = EXPR_UNARY
    pointee.op = OP_DEREF
    pointee.operand = e
    if ref_write_is_shared(s, @pointee) == 1
        ref_error_shared_into_mut(s, e)

# A method taking `self: @&T` writes what its receiver reaches, as `recv.f = v`
# would: `.` finds the receiver the same way.  `p` is its first param, whatever
# that's called: a standalone function takes the receiver there too.
fn ref_check_receiver(s: *EmitterState, e: *Expr, p: *Param)
    if p == null or p.param_type != TYPE_MUT_REF
        return
    var member: Expr
    ref_expr_member(@member, e.left, e.ident_ptr, e.ident_len)
    if ref_write_is_shared(s, @member) == 1
        ref_error_shared_into_mut(s, e.left)

# A reference to a local doesn't leave its fn (LANGUAGE_SPEC §13.5, LARB ruling R2,
# AGAST #2340).  A check for the definite case: what can't be told stays unjudged.
# ritz0's twins are TypeChecker._check_return and the fns it calls, ref_rules.py
# has the wording, and ritz0/test_return_local_ref.py holds all three compilers to
# them.  Statements are seen in order, as ritz0 sees them: a `var` that's written
# stops counting there, and a loop can reach that write first (ref_referent).

# What a `:&` param or `self:&` names is the caller's.  A by-value `self` is a
# local root, as any by-value param is (#2393).
fn ref_mark_params(s: *EmitterState, p0: *Param)
    var p: *Param = p0
    while p != null
        let idx: i32 = find_local_idx(s, p.name, p.name_len)
        if idx >= 0
            let loc: *LocalVar = local_at(s, idx)
            if p.is_borrow == 1 or loc.holds_lent_ptr == 1
                loc.is_caller_place = 1
            if p.param_pointee_type == TYPE_PTR
                loc.ref_ptr_pointee = p.param_ref_ptr_pointee   # AGAST #2364
        p = p.next

# The local `name` is bound to.  A name is bound once per scope in its fn
# (#2395), so the latest binding of it is the one in scope.
fn ref_sole_local(s: *EmitterState, name: *u8, len: i32) -> *LocalVar
    let idx: i32 = find_local_idx(s, name, len)
    if idx < 0
        return null
    local_at(s, idx)

# The local root the place `e` is in, reached with no pointer or reference on the
# path; null if it's not in one, or the tables can't say.
fn ref_local_root(s: *EmitterState, e0: *Expr) -> *LocalVar
    var e: *Expr = e0
    while e != null
        if e.kind == EXPR_IDENT
            let loc: *LocalVar = ref_sole_local(s, e.ident_ptr, e.ident_len)
            if loc == null or loc.is_caller_place == 1
                return null
            return loc
        if e.kind != EXPR_MEMBER and e.kind != EXPR_INDEX
            return null
        var base: RefTy
        if ref_ty_of(s, e.left, @base) == 0 or ref_is_pointer(base.kind) == 1
            return null
        if e.kind == EXPR_INDEX and (base.kind != TYPE_ARRAY or e.right == null or e.right.kind == EXPR_RANGE)
            return null
        e = e.left
    null

# The name of the local root `e` definitely refers to, with its length in `len`:
# `@x` of one, or a binding that holds such a reference.  Null if there's none.
fn ref_referent(s: *EmitterState, e: *Expr, len: *i32) -> *u8
    if e == null
        return null
    if e.kind == EXPR_UNARY and (e.op == OP_ADDR or e.op == OP_ADDR_MUT)
        let root: *LocalVar = ref_local_root(s, e.operand)
        if root == null
            return null
        *len = root.name_len
        return root.name
    if e.kind != EXPR_IDENT
        return null
    let loc: *LocalVar = ref_sole_local(s, e.ident_ptr, e.ident_len)
    # A loop can reach a `var`'s later write before this read.
    if loc == null or loc.ref_root == null or loc.is_let == 0 and REF_LOOPS > loc.ref_root_loops
        return null
    *len = loc.ref_root_len
    loc.ref_root

# What `e`, which ref_referent named a root for, has: a binding keeps it.
fn ref_referent_ty(s: *EmitterState, e: *Expr, out: *RefTy) -> i32
    if e.kind == EXPR_IDENT
        let idx: i32 = find_local_idx(s, e.ident_ptr, e.ident_len)
        if idx >= 0
            let loc: *LocalVar = local_at(s, idx)
            return ref_set(out, TYPE_PTR, loc.ref_root_pointee, loc.ref_root_name, loc.ref_root_name_len)
    ref_ty_of(s, e, out)

# `name` is written, or its address may let it be: if it's a `var`, what it holds
# is no longer definite.
fn ref_forget_name(s: *EmitterState, name: *u8, len: i32)
    let idx: i32 = find_local_idx(s, name, len)
    if idx < 0
        return
    let loc: *LocalVar = local_at(s, idx)
    if loc.is_let == 0
        loc.ref_root = null

fn ref_forget(s: *EmitterState, e: *Expr)
    if e != null and e.kind == EXPR_IDENT
        ref_forget_name(s, e.ident_ptr, e.ident_len)

# After a statement is emitted: a declaration's binding exists now, and a loop is
# over.
pub fn ref_after_stmt(s: *EmitterState, stmt: *Stmt)
    let k: i32 = stmt.kind
    if k == STMT_WHILE or k == STMT_FOR or k == STMT_LOOP
        REF_LOOPS = REF_LOOPS - 1
    # `@x` held in a `*T` isn't a borrow (#2371).  AGAST #2950: held once the
    # value is emitted.  Held before, an `if` / `match` value's arms each
    # conflicted with the loans of its own `@&c` arms as they were emitted.
    if k == STMT_VAR_DECL and stmt.var_declared_type != TYPE_PTR
        ref_hold(s, stmt.var_init)
    if k == STMT_VAR_DECL and stmt.var_ref != null
        ref_keep_ptr_pointee(s, stmt)
    if k != STMT_VAR_DECL or REF_DECL_ROOT == null
        return
    let idx: i32 = find_local_idx(s, stmt.var_name, stmt.var_name_len)
    if idx >= 0
        let loc: *LocalVar = local_at(s, idx)
        # An un-annotated `let` stays an i64, holding the `@T`.  `let n: i64 = @c`
        # is a pointer as an integer: no reference, whatever the local says.
        let declared: i32 = stmt.var_declared_type
        if declared == TYPE_VOID or declared == TYPE_PTR_PTR or ref_is_pointer(declared) == 1
            loc.ref_root = REF_DECL_ROOT
            loc.ref_root_len = REF_DECL_ROOT_LEN
            loc.ref_root_loops = REF_LOOPS
            loc.ref_root_pointee = REF_DECL_TY.pointee
            loc.ref_root_name = REF_DECL_TY.name
            loc.ref_root_name_len = REF_DECL_TY.name_len
    REF_DECL_ROOT = null

# AGAST #2364: the local `stmt` declares keeps its `@&*U`'s U.
fn ref_keep_ptr_pointee(s: *EmitterState, stmt: *Stmt)
    let idx: i32 = find_local_idx(s, stmt.var_name, stmt.var_name_len)
    if idx >= 0
        local_at(s, idx).ref_ptr_pointee = ref_decl_ptr_pointee(stmt)

# `a` and `ret` point at the same type.
fn ref_same_referent(a: *RefTy, ret: *RefTy) -> i32
    if a.pointee != ret.pointee or a.pointee == TYPE_VOID
        return 0
    if a.pointee != TYPE_STRUCT and a.pointee != TYPE_PTR
        return 1
    if a.name_len == 0 or ret.name_len == 0
        return 0
    name_eq(a.name, a.name_len, ret.name, ret.name_len)

# The local root `a` refers to, if it has `ret`'s pointee.  A `:&` param or a
# receiver borrows `a` itself when it's that `U`.
fn ref_gives_referent(s: *EmitterState, a: *Expr, lent: i32, ret: *RefTy, len: *i32) -> *u8
    var t: RefTy
    let root: *u8 = ref_referent(s, a, len)
    if root != null
        if ref_referent_ty(s, a, @t) == 1 and ref_same_referent(@t, ret) == 1
            return root
        return null
    if lent == 0
        return null
    let place: *LocalVar = ref_local_root(s, a)
    if place == null or ref_ty_of(s, a, @t) == 0
        return null
    var held: RefTy
    ref_set(@held, TYPE_PTR, t.kind, t.name, t.name_len)
    if ref_same_referent(@held, ret) == 0
        return null
    *len = place.name_len
    place.name

# The local root a call returning `@U` or `@&U` was given a reference to, with
# pointee `U`: the result may be that reference, so a raw `*U` return, which no
# reference has to live through, isn't asked.
fn ref_call_referent(s: *EmitterState, e: *Expr, len: *i32) -> *u8
    var f: *FnDef = null
    if e.kind == EXPR_METHOD
        f = ref_method_def(s, e)
    else
        f = find_call_fn(s, e)
    var ret: RefTy
    if f == null or f.ret_ref == null or ref_of_fn(f, @ret) == 0
        return null
    var p: *Param = f.params
    if p != null and name_eq(p.name, p.name_len, c"self", 4) == 1
        p = p.next
    if e.kind == EXPR_METHOD
        let by_self: *u8 = ref_gives_referent(s, e.left, 1, @ret, len)
        if by_self != null
            return by_self
    var a: *Expr = e.args
    while a != null
        var lent: i32 = 0
        if p != null
            lent = p.is_borrow
            p = p.next
        let root: *u8 = ref_gives_referent(s, a, lent, @ret, len)
        if root != null
            return root
        a = a.next
    null

fn ref_error_returns_local(s: *EmitterState, e: *Expr, name: *u8, len: i32)
    if ref_first_report(e.span.line, e.span.col) == 0
        return
    ref_eprint_loc(e.span.line, e.span.col)
    eprints_cstr(c": error: cannot return a reference to local `")
    for i in 0..len
        eprint_char(*(name + i))
    eprints_cstr(c"`: it ends with the fn\n")
    s.error_count = s.error_count + 1

# `e` is a return value or a tail of one.
fn ref_check_return(s: *EmitterState, e: *Expr)
    var len: i32 = 0
    var root: *u8 = ref_referent(s, e, @len)
    if root == null and (e.kind == EXPR_CALL or e.kind == EXPR_METHOD)
        root = ref_call_referent(s, e, @len)
    if root != null
        ref_error_returns_local(s, e, root, len)

# LANGUAGE_SPEC §13.5's first rule (LARB rulings R11 and R11a, AGAST #2438).  A
# borrow is of a place: a root local and its field and index steps.  Two places
# overlap when one's path is a prefix of the other's (field names must match; any
# two indexes are equal).  While a binding holds an `@T` of a place, or within one
# call's arguments, a mutable borrow of an overlapping place is a located error
# naming both places; while it holds an `@&T`, any borrow is.  The mutable borrows
# are `@&p`, `p` bare into a `:&` param, a receiver taken `self: @&T` or `self:& T`
# (or as a UFCS fn's first `@&T` param), and a write into p's own storage.  A loan lasts to the end
# of its holder's block: own_pop_scope calls ref_loans_end.  Only a declaration's
# value is held, so `p = @x` and a call's `@x` borrow nothing past the statement.
# ritz0's twin is the loan half of move_checker.py, and
# ritz0/test_borrow_conflict_all_compilers.py holds all three compilers to it.

pub fn ref_loans_at(depth: i32)
    REF_DEPTH = depth

pub fn ref_loans_end(depth: i32)
    let loans: *RefLoan = REF_LOANS
    var kept: i32 = 0
    for i in 0..REF_LOAN_COUNT
        let l: *RefLoan = loans + i
        if l.depth <= depth or l.depth == REF_LOAN_ARG
            let to: *RefLoan = loans + kept
            to.root = l.root
            to.mutable = l.mutable
            to.depth = l.depth
            to.place = l.place
            to.outer = l.outer
            kept = kept + 1
    REF_LOAN_COUNT = kept

# The index of the local whose storage the place `e0` is in, reached by fields and
# indexes with no pointer or reference on the way, or -1.  An index into a Vec
# counts as a step of its place (R11a): `@vs[0]` is a loan of `vs[_]`, and a write
# into `vs[0].a` is a write inside it.
fn ref_loan_root(s: *EmitterState, e0: *Expr) -> i32
    var e: *Expr = e0
    while e != null
        if e.kind == EXPR_IDENT
            return find_local_idx(s, e.ident_ptr, e.ident_len)
        # AGAST #3015: a step through `Deref` (R17 rule 6) is a step of its
        # receiver's place.
        let through: *Expr = df_deref_step_recv(e)
        if through != null
            e = through
            continue
        if e.kind != EXPR_MEMBER and e.kind != EXPR_INDEX
            return 0 - 1
        var base: RefTy
        if ref_loan_ty(s, e.left, @base) == 0 or ref_is_pointer(base.kind) == 1
            return 0 - 1
        if e.kind == EXPR_INDEX
            if e.right == null or e.right.kind == EXPR_RANGE
                return 0 - 1
        e = e.left
    0 - 1

# ref_ty_of, also through a Vec's element (`vs[1].a`), for the steps of a place.
# Only the loan check reads it.  As ritz0's MoveChecker._loan_type.
fn ref_loan_ty(s: *EmitterState, e: *Expr, out: *RefTy) -> i32
    if e.kind == EXPR_INDEX or e.kind == EXPR_MEMBER
        var b: RefTy
        if ref_loan_ty(s, e.left, @b) == 1 and b.kind == TYPE_STRUCT
            if e.kind == EXPR_INDEX
                if ref_vec_elem(s, @b, out) == 1
                    return 1
            else
                let st: *StructDef = find_struct(s, b.name, b.name_len)
                if st != null
                    let fi: i32 = find_field_index(st, e.ident_ptr, e.ident_len)
                    if fi >= 0
                        return ref_of_field(s, e, get_field_type(st, fi), out)
    ref_ty_of(s, e, out)

# The element of the instantiated `Vec$T` `v`, from its `data: *T` field (as
# emit_vec_elem_member_ptr finds it): a struct or an integer.  0 otherwise.
fn ref_vec_elem(s: *EmitterState, v: *RefTy, out: *RefTy) -> i32
    if v.name_len <= 4 or *v.name != 'V' or *(v.name + 1) != 'e' or *(v.name + 2) != 'c' or *(v.name + 3) != '$'
        return 0
    let vec_st: *StructDef = find_struct(s, v.name, v.name_len)
    if vec_st == null
        return 0
    let di: i32 = find_field_index(vec_st, c"data", 4)
    if di < 0
        return 0
    let data: *StructField = get_field_type(vec_st, di)
    if data.field_type != TYPE_PTR or data.field_type_name_len <= 0
        return 0
    if find_struct(s, data.field_type_name, data.field_type_name_len) != null
        return ref_set(out, TYPE_STRUCT, 0, data.field_type_name, data.field_type_name_len)
    let k: i32 = vec_name_elem_type(v.name, v.name_len)
    if k == TYPE_UNKNOWN
        return 0
    ref_set(out, k, 0, null, 0)

# The place one step up from `e`: a field's or index's base, or the receiver of
# a step `*` through `Deref` (AGAST #3015); null at the root.
fn ref_place_up(e: *Expr) -> *Expr
    if e.kind == EXPR_MEMBER or e.kind == EXPR_INDEX
        return e.left
    df_deref_step_recv(e)

# How many field, index and `*` steps place `e` takes below its root.
fn ref_place_depth(e0: *Expr) -> i32
    var n: i32 = 0
    var e: *Expr = e0
    while e != null and ref_place_up(e) != null
        n = n + 1
        e = ref_place_up(e)
    n

# Two steps are the same: one field, or any two indexes, or two `*` steps.  A `*`
# step overlaps any own field of its root, which may re-aim it (R17 rule 6).
fn ref_step_eq(a: *Expr, b: *Expr) -> i32
    if df_deref_step_recv(a) != null or df_deref_step_recv(b) != null
        return 1
    if a.kind != b.kind
        return 0
    if a.kind == EXPR_INDEX
        return 1
    name_eq(a.ident_ptr, a.ident_len, b.ident_ptr, b.ident_len)

# Do places `a0` and `b0`, of one root, overlap: is one's path a prefix of the
# other's?  Trim the longer to the shorter's length, then compare step by step.
fn ref_places_overlap(a0: *Expr, b0: *Expr) -> i32
    var a: *Expr = a0
    var b: *Expr = b0
    var da: i32 = ref_place_depth(a)
    var db: i32 = ref_place_depth(b)
    while da > db
        a = ref_place_up(a)
        da = da - 1
    while db > da
        b = ref_place_up(b)
        db = db - 1
    while da > 0
        if ref_step_eq(a, b) == 0
            return 0
        a = ref_place_up(a)
        b = ref_place_up(b)
        da = da - 1
    1

# The loan a new borrow of `place` on local `root` (`mutable` or not) conflicts
# with, or null: an overlapping mutable loan first, else, for a mutable borrow, an
# overlapping shared one.  As ritz0's MoveChecker._conflict.
fn ref_loan_conflict(root: i32, place: *Expr, mutable: i32) -> *RefLoan
    let loans: *RefLoan = REF_LOANS
    var shared: *RefLoan = null
    for i in 0..REF_LOAN_COUNT
        let l: *RefLoan = loans + i
        if l.root == root and ref_places_overlap(l.place, place) == 1 and (l.outer == 0 or ref_place_depth(place) <= ref_place_depth(l.place))
            if l.mutable == 1
                return l
            if shared == null
                shared = l
    if mutable == 1
        return shared
    null

# `c.x`, `vs[_]`: a place as the error names it.
fn ref_eprint_place(e: *Expr)
    if e == null
        return
    # A `*` step through `Deref` isn't spelled: `b.a`, not `(*b).a` (R17).
    let through: *Expr = df_deref_step_recv(e)
    if through != null
        ref_eprint_place(through)
        return
    if e.kind == EXPR_MEMBER
        ref_eprint_place(e.left)
        eprint_char('.')
        for i in 0..e.ident_len
            eprint_char(*(e.ident_ptr + i))
    else if e.kind == EXPR_INDEX
        ref_eprint_place(e.left)
        eprints_cstr(c"[_]")
    else
        for i in 0..e.ident_len
            eprint_char(*(e.ident_ptr + i))

# A borrow of `place`, on local `root`, at line:col (a write when `assign` is 1).
# 1 if there's no conflict, so the borrow can be lent; 0 otherwise.
fn ref_loan_use(s: *EmitterState, line: i32, col: i32, root: i32, place: *Expr, mutable: i32, assign: i32) -> i32
    if root < 0
        return 0
    let l: *RefLoan = ref_loan_conflict(root, place, mutable)
    if l == null
        return 1
    if ref_first_report(line, col) == 0
        return 0
    ref_eprint_loc(line, col)
    if assign == 1
        eprints_cstr(c": error: cannot assign to `")
    else
        eprints_cstr(c": error: cannot borrow `")
    ref_eprint_place(place)
    if assign == 1
        eprints_cstr(c"` - `")
    else if mutable == 1
        eprints_cstr(c"` as mutable - `")
    else
        eprints_cstr(c"` as immutable - `")
    ref_eprint_place(l.place)
    if l.mutable == 1
        eprints_cstr(c"` is already borrowed as mutable\n")
    else
        eprints_cstr(c"` is already borrowed as immutable\n")
    s.error_count = s.error_count + 1
    0

# The method `e` takes its receiver as `p`, its first param.  `self: *T` and
# `self: @T` don't borrow it mutably, and nor does a receiver that's a pointer.
fn ref_loan_receiver(s: *EmitterState, e: *Expr, p: *Param)
    if p == null or p.param_type != TYPE_MUT_REF
        return
    var t: RefTy
    if ref_ty_of(s, e.left, @t) == 0 or ref_is_pointer(t.kind) == 1
        return
    ref_loan_use(s, e.left.span.line, e.left.span.col, ref_loan_root(s, e.left), e.left, 1, 0)

# A write into a local's own storage, in each statement form the parser splits a
# place into.
fn ref_loan_write(s: *EmitterState, stmt: *Stmt)
    let k: i32 = stmt.kind
    var root: Expr
    var member: Expr
    var element: Expr
    var at: i32 = 0 - 1
    var place: *Expr = null
    if k == STMT_ASSIGN
        if stmt.assign_target_len > 0
            ref_expr_ident(@root, stmt.assign_target, stmt.assign_target_len)
            place = @root
            at = find_local_idx(s, stmt.assign_target, stmt.assign_target_len)
        else
            place = stmt.if_cond as *Expr
            at = ref_loan_root(s, place)
    else if k == STMT_INDEX_ASSIGN
        ref_expr_ident(@root, stmt.assign_target, stmt.assign_target_len)
        ref_expr_index(@element, @root)
        element.right = stmt.while_cond
        place = @element
        at = ref_loan_root(s, @element)
    else if k == STMT_LOCAL_FIELD_ASSIGN or k == STMT_LOCAL_FIELD_INDEX_ASSIGN or k == STMT_MEMBER_ASSIGN or k == STMT_MEMBER_INDEX_ASSIGN
        if k == STMT_LOCAL_FIELD_ASSIGN or k == STMT_LOCAL_FIELD_INDEX_ASSIGN
            ref_expr_ident(@root, stmt.var_name, stmt.var_name_len)
            ref_expr_member(@member, @root, stmt.assign_target, stmt.assign_target_len)
        else
            ref_expr_member(@member, stmt.if_cond as *Expr, stmt.assign_target, stmt.assign_target_len)
        if k == STMT_LOCAL_FIELD_ASSIGN or k == STMT_MEMBER_ASSIGN
            place = @member
            at = ref_loan_root(s, @member)
        else
            ref_expr_index(@element, @member)
            element.right = stmt.while_cond
            place = @element
            at = ref_loan_root(s, @element)
    else
        return
    ref_loan_use(s, stmt.span.line, stmt.span.col, at, place, 1, 1)

# A place (a local, a field or an element) passed bare into the `:&` param `p` is
# an `@&` of it (#2335, R11a).  A pointer into a `:& U` isn't a place of `U`: it
# passes what it points at.  As ritz0's MoveChecker._check_place_borrow.
fn ref_lends_place(s: *EmitterState, a: *Expr, p: *Param) -> i32
    if a.kind != EXPR_IDENT and a.kind != EXPR_MEMBER and a.kind != EXPR_INDEX
        return 0
    var t: RefTy
    if ref_ty_of(s, a, @t) == 1 and ref_is_pointer(t.kind) == 1 and p.param_pointee_type != TYPE_PTR
        return 0
    1

fn ref_loan_add(root: i32, place: *Expr, mutable: i32, depth: i32)
    if REF_LOAN_COUNT == REF_LOAN_CAP
        let cap: i32 = REF_LOAN_CAP * 2 + 16
        let grown: *RefLoan = malloc((cap as i64) * sizeof(RefLoan)) as *RefLoan
        let was: *RefLoan = REF_LOANS
        for i in 0..REF_LOAN_COUNT
            let from: *RefLoan = was + i
            let to: *RefLoan = grown + i
            to.root = from.root
            to.mutable = from.mutable
            to.depth = from.depth
            to.place = from.place
            to.outer = from.outer
        if REF_LOANS != null
            free(REF_LOANS as *u8)
        REF_LOANS = grown
        REF_LOAN_CAP = cap
    let l: *RefLoan = REF_LOANS + REF_LOAN_COUNT
    l.root = root
    l.mutable = mutable
    l.depth = depth
    l.place = place
    l.outer = 0
    REF_LOAN_COUNT = REF_LOAN_COUNT + 1

# The loan a `for` over a place holds for its body (LARB R11, AGAST #2439).  A
# `for` walks a place in place (§6.3), so when the place's path crosses an index
# into anything but an array (a Vec, a Span, a pointer), a push may move the
# storage it walks.  The loan is an `@` of the base of the last such index: `vs`
# in `vs[0].a`, `s.vs` in `s.vs[0].a`.  It lasts as the body's scope does.  As
# ritz0's MoveChecker._for_loan.
fn ref_for_hold(s: *EmitterState, stmt: *Stmt)
    if stmt.for_end != null or stmt.for_start == null
        return
    var e: *Expr = stmt.for_start
    while e.kind == EXPR_UNARY and e.op == OP_ADDR
        e = e.operand
    var base: *Expr = null
    while base == null and (e.kind == EXPR_MEMBER or e.kind == EXPR_INDEX)
        if e.kind == EXPR_INDEX
            var t: RefTy
            if ref_loan_ty(s, e.left, @t) == 1 and t.kind != TYPE_ARRAY
                base = e.left
        e = e.left
    if base == null
        return
    let root: i32 = ref_loan_root(s, base)
    if root < 0
        return
    ref_loan_add(root, base, 0, REF_DEPTH + 1)
    let l: *RefLoan = REF_LOANS + (REF_LOAN_COUNT - 1)
    l.outer = 1

# The `@place` and `@&place` a declaration's binding holds: its value, or an arm's
# tail of an `if` or `match` value.
fn ref_hold(s: *EmitterState, e: *Expr)
    if e == null
        return
    if e.kind == EXPR_UNARY and (e.op == OP_ADDR or e.op == OP_ADDR_MUT)
        let root: i32 = ref_loan_root(s, e.operand)
        if root >= 0
            var mutable: i32 = 0
            if e.op == OP_ADDR_MUT
                mutable = 1
            ref_loan_add(root, e.operand, mutable, REF_DEPTH)
    else if e.kind == EXPR_IF or e.kind == EXPR_MATCH
        var arm: *MatchArm = e.args as *MatchArm
        while arm != null
            if arm.is_pass == 0 and arm.body != null
                ref_hold(s, arm.body)
            else if arm.body_stmts != null
                var st: *Stmt = arm.body_stmts
                while st.next != null
                    st = st.next
                if st.kind == STMT_EXPR
                    ref_hold(s, st.expr)
            arm = arm.next
