# ref_check.ritz - the reference queries the emitter and Sema both ask
#
# Its checks have moved to Sema (#1816): §13.5's borrow conflicts (AGAST #2438)
# to ref_loan.ritz (#3506); `@T` read-only, return-of-local (#2338, #2374,
# #2340) and the slot checks (§13.2-13.4, LARB R1 / R5 / R42: a reference into
# a by-value slot and back, `@x` or an `@T` into an `@&T` or `:&` slot, arrays,
# variant payloads, casts, a call's temporary, `[v; n]`) to ref_value.ritz
# (#3926, #4011).  ref_rules.py and array_rules.py have their words.
#
# What stays is what both sides ask, one copy over a RefEnv (as let_check's
# LetEnv): the emitter's locals (s) or Sema's scope (sm).  ref_ty_in types an
# expression as a RefTy; on Sema a binding is read from the image of the
# LocalVar the emitter will make for it (RsNote.loc, made by ref_value.ritz's
# hooks, else from Sema's own type of it), so the typing code is the
# emitter's.  ref_view_in and ref_write_is_shared_in answer what a write
# through a place meets; ref_temp_call_in, whether a place is a call's
# temporary.  Sema's thin place typing (rs_ty) and its per-binding notes
# (RsNote) live here too, for ref_loan.ritz and ref_value.ritz.
#
# The emitter still asks ref_ty_of and ref_through (ownership.ritz's "cannot
# move out of a reference", which only reaches a program with a Drop in it),
# ref_temp_call (lending a temporary to a call), ref_view and ref_vec_elem
# (codegen), ref_cast_reads_referent and ref_array_error (emitter_stmt's
# backstop for an array mismatch Sema couldn't name).  ritz1 emits bodies after
# monomorphize_module, so a generic is judged per instance.

import ritzlib.sys
import ritzlib.io

import ast
import diag   # diag_error_at (AGAST #3621)
import ast_helpers
import types           # ty_int_in
import emitter_core
import emitter_types   # AGAST #1818: type inference moved out of emitter_core
import let_check           # let_through_elem
import ritzlib.memory
import ritzlib.str
import sema
import sema_type
import bool_check          # sbk_global, sbk_method_def
import text_bridge   # no_name / unnamed (AGAST #4696)
import ritzlib.strview

# What an expression or a slot holds.
pub struct RefTy
    kind: TypeKind       # TYPE_*
    pointee: TypeKind    # TYPE_* behind a pointer kind, or an array's element
    name: StrView       # the struct: kind's own, or the pointee's
    elem_pointee: TypeKind     # U for an array's `*U` element; TypeKind.Void if unknown
    shape: *ArrayShape    # a multi-dimensional array's, else null
    returned: i32         # 1 for a slot that leaves the fn as a pointer or reference
    ref_size: i32         # N for a pointer kind to `[N]T`; 0 if unknown
    ref_elem: TypeKind         # its T's kind (a struct T is `name`); TypeKind.Void if unknown
    # AGAST #2098: the `[N][M]..T` a pointer kind points at, else null.  A
    # `*[N][M]T` records the flat count and the leaf in ref_size / ref_elem
    # (#2570), so two N-D referents are judged by shape instead.
    ref_shape: *ArrayShape
    name_only: i32        # 1 for a `-> *X` return: only a name, maybe a stale one
    # AGAST #2364: U when the pointee is a `*U` (pointee == TypeKind.Ptr), as
    # Param.param_ref_ptr_pointee keeps it; TypeKind.Void if unknown.  A scalar U
    # has no name, so without it `@&*i32` and `@&*i64` were one type.
    ptr_pointee: TypeKind
    # AGAST #3048: a `**T` slot's T, as ptr_pointee keeps its kind; only
    # ref_ptr_ptr_slot sets it, and only a struct T has one.
    held_name: StrView
    # AGAST #3383 (LARB R42): N for an array kind, d0 for `[d0][d1]..T`, which
    # a literal landing here must be as long as; 0 if unknown.
    array_len: i32

var REF_LAST_LINE: i32 = 0
var REF_LAST_COL: i32 = 0

pub fn ref_set(out: *RefTy, kind: TypeKind, pointee: TypeKind, name_sv: StrView) -> i32
    out.kind = kind
    out.pointee = pointee
    out.name = name_sv
    out.elem_pointee = TypeKind.Void
    out.shape = null
    out.returned = 0
    out.ref_size = 0
    out.ref_elem = TypeKind.Void
    out.ref_shape = null
    out.name_only = 0
    out.ptr_pointee = TypeKind.Void
    out.held_name = strview_empty()
    out.array_len = 0
    1

# `n` is the array's N (its d0 for a `shape`), 0 if unknown.
pub fn ref_set_array(out: *RefTy, elem: TypeKind, elem_pointee: TypeKind, name_sv: StrView, shape: *ArrayShape, n: i32) -> i32
    ref_set(out, TypeKind.Array, elem, name_sv)
    out.elem_pointee = elem_pointee
    out.shape = shape
    out.array_len = n
    if shape != null
        out.array_len = shape.dims[0]
    1

# An ArrayElem keeps no N: a fn's `-> [N]T` has it on ret_array_param.
pub fn ref_set_elem(out: *RefTy, a: *ArrayElem) -> i32
    ref_set_array(out, a.elem, a.pointee, a.name, a.shape, 0)

# `out` is what `a[i]` holds for an N-D `[N][M]..T`: a row, one dimension
# fewer, as Sema's element step has it (sema_arr_elem, AGAST #4259): `[M]T`
# for two, an `[M][K]T` plane past that.  0 for a one-dimensional `a`.
pub fn ref_row(a: *RefTy, out: *RefTy) -> i32
    let sh: *ArrayShape = a.shape
    if sh == null or sh.rank < 2
        return 0
    var at: SemaTy
    sema_arr_ty(@at, TypeKind.Array, strview_empty(), sh)
    var row: SemaTy
    sema_arr_elem(@at, @row)
    if row.shape != null
        return ref_set_array(out, TypeKind.Array, sh.leaf_pointee, sh.leaf_name, row.shape, 0)
    ref_set_array(out, sh.leaf_type, sh.leaf_pointee, sh.leaf_name, null, sh.dims[sh.rank - 1])

pub fn ref_is_pointer(kind: TypeKind) -> i32
    if kind == TypeKind.Ptr or kind == TypeKind.Ref or kind == TypeKind.MutRef
        return 1
    0

fn ref_of_local(loc: *LocalVar, out: *RefTy) -> i32
    if lv_bk_unsure(loc) == 1
        return 0
    let t: TypeKind = lv_var_type(loc)
    if ref_is_pointer(t) == 1
        # `c:& C` reads as a `C` (§13.4), and so does a by-value `self`.
        if lv_is_lent(loc) == 1 or lv_holds_lent_ptr(loc) == 1
            return ref_set(out, lv_pointee_type(loc), TypeKind.Void, StrView { ptr: (lv_type_name(loc)), len: (lv_type_name_len(loc)) as i64 })
        ref_set(out, t, lv_pointee_type(loc), StrView { ptr: (lv_type_name(loc)), len: (lv_type_name_len(loc)) as i64 })
        # The `[N]T` it points at, as ref_decl_slot and ref_of_param record
        # it, so `r = @g` into a `*[3]i32` local is judged (AGAST #3636).
        if lv_pointee_type(loc) == TypeKind.Array
            out.ref_size = lv_pointee_array_size(loc)
            out.ref_elem = lv_pointee_array_elem_type(loc)
            out.ref_shape = lv_pointee_array_shape(loc)   # AGAST #2098
        return 1
    match t
        TypeKind.Array =>
            return ref_set_array(out, lv_array_elem_type(loc), lv_array_elem_pointee(loc), StrView { ptr: (lv_type_name(loc)), len: (lv_type_name_len(loc)) as i64 }, lv_array_shape(loc), lv_array_size(loc))
        TypeKind.PtrPtr =>
            return 0
        _ => pass
    ref_set(out, t, TypeKind.Void, StrView { ptr: (lv_type_name(loc)), len: (lv_type_name_len(loc)) as i64 })

fn ref_of_ident(s: *EmitterState, name_sv: StrView, out: *RefTy) -> i32
    var env: RefEnv
    ref_of_ident_in(ref_env_of(@env, s, null), name_sv, out)

# The local `name` names, as the emitter keeps it: its LocalVar, or on Sema
# the image RsNote keeps of it (AGAST #4011).  Null when it names none, and
# *is_local says whether it names a local Sema can't type.
pub fn ref_local_in(env: *RefEnv, name_sv: StrView, is_local: *i32) -> *LocalVar
    *is_local = 0
    if env.s != null
        let idx: i32 = find_local_idx(env.s, name_sv)
        if idx < 0
            return null
        *is_local = 1
        return local_at(env.s, idx)
    let v: *SemaVar = sema_find_local(env.sm, name_sv)
    if v == null
        return null
    *is_local = 1
    var n: *RsNote = rs_note(env.sm, v)
    if n != null and n.has_loc == 1
        return @n.loc
    # A binding no hook made an image of: Sema's own type of it.
    if n == null
        n = rs_note_new(env.sm, v)
    n.has_loc = rs_default_loc(env.sm, v, @n.loc)
    if n.has_loc == 0
        return null
    @n.loc

# The LocalVar add_local_full makes, with nothing else known yet.
pub fn rs_loc_new(loc: *LocalVar, name_sv: StrView, var_type: TypeKind, type_name_sv: StrView, pointee: TypeKind, arr_size: i32, arr_elem: TypeKind)
    # AGAST #4528: the same name + `*TypeRef` image add_local_full builds.
    lv_loc_init(loc, name_sv, var_type, type_name_sv, pointee, arr_size, arr_elem)

# What any other binding (a `for` variable, a match payload, a tuple's) reads
# as: Sema's own type of it, held as the emitter holds it.
pub fn rs_default_loc(sm: *Sema, v: *SemaVar, loc: *LocalVar) -> i32
    var t: SemaTy
    if rs_local(sm, v, @t) == 0 or t.kind == TypeKind.Unknown or t.kind == TypeKind.Void
        # A `for` variable let_check leaves unread: Sema's binding type.
        rs_set(@t, v.kind, v.pointee, v.type_name)
    if t.kind == v.kind and t.name.len <= 0 and v.type_name.len > 0
        t.name.ptr = v.type_name.ptr   # a `for` variable over a `[N]S` param: let_check's has no S
        t.name.len = v.type_name.len
    var k: TypeKind = t.kind
    if k == TypeKind.Unknown or k == TypeKind.Void or k == TypeKind.PtrPtr
        return 0
    if k == TypeKind.Bool or v.bk == 1   # BK_BOOL: an i64 slot
        rs_loc_new(loc, v.name, TypeKind.I64, strview_empty(), TypeKind.I64, 0, TypeKind.Void)
        loc.is_bool = 1
        return 1
    if k == TypeKind.Array
        rs_loc_new(loc, v.name, TypeKind.Array, t.name, TypeKind.I64, 0, t.pointee)
        lv_set_array_shape(loc, v.shape)
        return 1
    if ref_is_pointer(k) == 1
        rs_loc_new(loc, v.name, k, t.name, t.pointee, 0, TypeKind.Void)
        return 1
    rs_loc_new(loc, v.name, k, t.name, TypeKind.I64, 0, TypeKind.Void)
    1

pub fn ref_of_ident_in(env: *RefEnv, name_sv: StrView, out: *RefTy) -> i32
    var is_local: i32 = 0
    let loc: *LocalVar = ref_local_in(env, name_sv, @is_local)
    if loc != null
        let ok: i32 = ref_of_local(loc, out)
        # AGAST #2364: the U of an `@*U` / `@&*U` binding is Sema's fact, on
        # its note.  Nothing on the emitter's lowering path read it.
        if ok == 1 and env.sm != null and ref_is_pointer(out.kind) == 1
            let n: *RsNote = rs_note(env.sm, sema_find_local(env.sm, name_sv))
            if n != null
                out.ptr_pointee = n.ptr_pointee
        return ok
    if is_local == 1
        return 0
    var g: *GlobalVarDef = null
    if env.s != null
        g = find_global(env.s, name_sv)
    else
        g = sbk_global(env.sm, name_sv)
    if g == null
        return 0
    if ref_is_pointer(g.var_type) == 1
        return ref_set(out, g.var_type, g.pointee_type, g.pointee_type_name)
    match g.var_type
        TypeKind.PtrPtr =>
            return 0
        TypeKind.Array =>
            return ref_set_array(out, g.array_elem_type, g.array_elem_pointee, g.array_elem_type_name, g.array_shape, g.array_size)
        _ => pass
    ref_set(out, g.var_type, TypeKind.Void, g.type_name)

pub fn ref_of_fn(f: *FnDef, out: *RefTy) -> i32
    if f == null or f.return_type == TypeKind.Void
        return 0
    if f.ret_ref != null
        return ref_of_param(f.ret_ref, out)
    if f.ret_array != null
        ref_set_elem(out, f.ret_array)
        if f.ret_array_param != null
            out.array_len = f.ret_array_param.param_array_size   # AGAST #3383
        return 1
    if f.return_type == TypeKind.Ptr or f.return_type == TypeKind.PtrPtr
        # FnDef keeps no pointee, only a struct's name.
        if f.return_type_name.len > 0 and f.return_type == TypeKind.Ptr
            ref_set(out, TypeKind.Ptr, TypeKind.Struct, f.return_type_name)
            out.name_only = 1
            return 1
        return 0
    ref_set(out, f.return_type, TypeKind.Void, f.return_type_name)

pub fn ref_of_param(p: *Param, out: *RefTy) -> i32
    match p.param_type
        TypeKind.PtrPtr =>
            return 0
        TypeKind.Array =>
            return ref_set_array(out, p.param_array_elem_type, p.param_array_elem_pointee, p.param_type_name, p.param_array_shape, p.param_array_size)   # AGAST #3634: `[N][M]T`
        _ => pass
    ref_set(out, p.param_type, p.param_pointee_type, p.param_type_name)
    if p.param_pointee_type == TypeKind.Array
        out.ref_size = p.param_pointee_array_size
        out.ref_elem = p.param_pointee_array_elem_type
        out.ref_shape = p.param_pointee_array_shape   # AGAST #2098
    if p.param_pointee_type == TypeKind.Ptr
        out.ptr_pointee = p.param_ref_ptr_pointee
    1

fn ref_of_field(env: *RefEnv, e: *Expr, f: *StructField, out: *RefTy) -> i32
    # Sema runs before lower_ref_fields, and asks what it will make the field.
    var t: TypeKind = f.field_type
    if env.s == null
        t = lowered_field_type(f)
    if ref_is_pointer(t) == 1
        var pointee: TypeKind = ref_member_pointee(env, e, f)
        # An instance's `*T` field keeps the name and not the kind.
        if pointee == TypeKind.Void and f.field_type_name.len > 0
            pointee = TypeKind.Struct
        # A primitive `*T` field says what it points at itself (#1304), which
        # the member chain can lose behind an element, `a.a[1].p` (#2368).
        if t == TypeKind.Ptr and f.field_type_name.len == 0 and f.array_elem_type != TypeKind.Void
            pointee = f.array_elem_type
        return ref_set(out, t, pointee, f.field_type_name)
    match t
        TypeKind.Array =>
            return ref_of_array_field(f, out)
        TypeKind.PtrPtr =>
            return 0
        _ => pass
    ref_set(out, t, TypeKind.Void, f.field_type_name)

# get_member_pointee_type_exact, for the field `f` that `e` names: on Sema the
# same reading of the field itself.
fn ref_member_pointee(env: *RefEnv, e: *Expr, f: *StructField) -> TypeKind
    if env.s != null
        return get_member_pointee_type_exact(env.s, e)
    if lowered_field_type(f) != TypeKind.Ptr
        return TypeKind.I64
    let pe: TypeKind = f.array_elem_type
    if ty_int_in(pe, 8, 16) == 1 or ty_int_in(pe, 32, 64) == 1
        return pe
    if pe == TypeKind.F32 or pe == TypeKind.F64 or pe == TypeKind.Bool
        return pe
    TypeKind.Void

pub fn ref_of_array_field(f: *StructField, out: *RefTy) -> i32
    ref_set_array(out, f.array_elem_type, f.array_elem_pointee, f.array_elem_type_name, f.array_shape, f.array_size)

# The method `e` (ExprKind.Method) calls, on the receiver's own type.
pub fn ref_method_def(s: *EmitterState, e: *Expr) -> *FnDef
    # An element through, `p[i].m()`, is the element's type: ref_ty_of gives `p[i]`
    # the Vec's own name (AGAST #2443).
    let through: Option<StrView> = index_through_struct(s, e.left)
    if through.is_some()
        let en: StrView = through.unwrap_or(no_name())
        if unnamed(en)
            return null
        return method_callee_def(s, en, e.ident)
    var t: RefTy
    if e.left != null and ref_ty_of(s, e.left, @t) == 1 and t.name.len > 0
        return method_callee_def(s, t.name, e.ident)
    let name: StrView = method_recv_type_name(s, e)
    if name.ptr == null or name.len == 0
        return null
    method_callee_def(s, name, e.ident)

# Fill `out` with the type of `e`.  0 if the tables can't say.
pub fn ref_ty_of(s: *EmitterState, e: *Expr, out: *RefTy) -> i32
    var env: RefEnv
    ref_ty_in(ref_env_of(@env, s, null), e, out)

# ref_ty_of, from either side (AGAST #3926, #4011): only the leaves differ, a
# name's binding, a member's field, a call's fn.
pub fn ref_ty_in(env: *RefEnv, e: *Expr, out: *RefTy) -> i32
    if e == null
        return 0
    let k: ExprKind = e.kind
    match k
        ExprKind.Ident =>
            return ref_of_ident_in(env, e.ident, out)
        ExprKind.StringLit =>
            return ref_set(out, TypeKind.Struct, TypeKind.Void, "StrView")
        ExprKind.Unary =>
            var t: RefTy
            match e.op
                OpKind.Addr | OpKind.AddrMut =>
                    if ref_ty_in(env, e.operand, @t) == 0
                        return 0
                    if ref_is_pointer(t.kind) == 1
                        ref_set(out, TypeKind.Ptr, TypeKind.Ptr, t.name)
                        out.ptr_pointee = ref_addr_ptr_pointee(@t)
                        return 1
                    ref_set(out, TypeKind.Ptr, t.kind, t.name)
                    if t.kind == TypeKind.Array
                        ref_array_referent(env, e.operand, out)
                        out.ref_shape = t.shape   # AGAST #2098
                    return 1
                OpKind.Deref =>
                    if ref_ty_in(env, e.operand, @t) == 0
                        return 0
                    if ref_is_pointer(t.kind) == 0
                        *out = t
                        return 1
                    if t.pointee == TypeKind.Array
                        return ref_behind(env, e.operand, out)
                    if t.pointee == TypeKind.Void or ref_is_pointer(t.pointee) == 1
                        return 0
                    return ref_set(out, t.pointee, TypeKind.Void, t.name)
                _ => pass
            return 0
        ExprKind.Member =>
            let f: *StructField = ref_field_in(env, e)
            if f == null
                return 0
            return ref_of_field(env, e, f, out)
        ExprKind.Index =>
            # `p[1..3]` is a pointer, not an element.
            if e.right != null and e.right.kind == ExprKind.Range
                return 0
            var b: RefTy
            if ref_ty_in(env, e.left, @b) == 0
                return 0
            if b.kind != TypeKind.Array and ref_is_pointer(b.kind) == 0
                return 0
            if b.kind == TypeKind.Array and b.pointee == TypeKind.Array
                return ref_row(@b, out)
            if ref_is_pointer(b.kind) == 1 and b.pointee == TypeKind.Array and b.ref_shape != null
                # A plane pointer's `q[i]` is a row of its `[M][N]..T` (#2570,
                # AGAST #4259), as the plane's own is.
                var plane: RefTy
                ref_set_array(@plane, TypeKind.Array, TypeKind.Void, b.name, b.ref_shape, 0)
                return ref_row(@plane, out)
            if ref_is_pointer(b.kind) == 1 and b.pointee == TypeKind.Array
                # A `*[N]T` / `@[N]T` / `@&[N]T`'s `q[i]` is an element of the
                # `[N]T` behind it, as the array's own `a[i]` is (AGAST #4290).
                var arr: RefTy
                if ref_behind(env, e.left, @arr) == 0
                    if b.ref_elem == TypeKind.Void
                        return 0
                    ref_set_array(@arr, b.ref_elem, TypeKind.Void, b.name, null, b.ref_size)
                if arr.kind == TypeKind.Array and arr.pointee == TypeKind.Array
                    return ref_row(@arr, out)   # an `@[N][M]T` plane, by Sema's shape
                b = arr
            # AGAST #2377: `a[i]` with `a: [N]*T` is a `*T`, so `*a[i]` and
            # `a[i][j]` are read through a pointer: a Drop T is not moved out.
            if b.kind == TypeKind.Array and ref_is_pointer(b.pointee) == 1
                let ep: TypeKind = b.elem_pointee
                if ep == TypeKind.Void or ep == TypeKind.Array or ep == TypeKind.PtrPtr or ref_is_pointer(ep) == 1
                    return 0
                return ref_set(out, b.pointee, ep, b.name)
            if b.pointee == TypeKind.Void or ref_is_pointer(b.pointee) == 1 or b.pointee == TypeKind.Array
                return 0
            return ref_set(out, b.pointee, TypeKind.Void, b.name)
        ExprKind.Call | ExprKind.Method =>
            return ref_of_fn(ref_call_def_in(env, e), out)
        ExprKind.Binary =>
            var l: RefTy
            if ref_ty_in(env, e.left, @l) == 1 and ref_is_pointer(l.kind) == 1
                return ref_set(out, l.kind, l.pointee, l.name)
            return 0
        _ => pass
    if k == ExprKind.Cast and e.type_kind == TypeKind.Ptr
        return ref_set(out, TypeKind.Ptr, ptr_slot_flat(e.cast_ptr_kind), e.ident)
    # AGAST #4058: and `as @S` / `as @&S`, whose pointee the parser keeps too
    # (#3443, #3757): `p as @S` is an `@S` whatever `p` was, so a write through
    # it, `(p as @S).f = v` or `.arr[i] = v`, is through an `@T`, as ritz0 says.
    if k == ExprKind.Cast and (e.type_kind == TypeKind.Ref or e.type_kind == TypeKind.MutRef) and e.cast_ptr_kind != (TypeKind.Void as i32)
        return ref_set(out, e.type_kind, ptr_slot_flat(e.cast_ptr_kind), e.ident)
    0

# AGAST #2364: U for `@x` of an x of type `t`, when x is a `*U`: a local, a
# field, or a `:& *U` param, which binds as the caller's `*U` (#2075).  A
# reference `q: @&U` or `@U` is a `*U` too (#3160): ref_value_into_ref words
# that misfit as ritz0 does, "a reference to one type".
fn ref_addr_ptr_pointee(t: *RefTy) -> TypeKind
    t.pointee

# `out` is `@a`: its `[N]T`'s N and T, for an `a` that is a local array or a
# `:&` one.  Unknown for anything else.
fn ref_array_referent(env: *RefEnv, e: *Expr, out: *RefTy)
    if e.kind != ExprKind.Ident
        return
    var is_local: i32 = 0
    let loc: *LocalVar = ref_local_in(env, e.ident, @is_local)
    if loc == null
        return
    if lv_var_type(loc) == TypeKind.Array
        out.ref_size = lv_array_size(loc)
        out.ref_elem = lv_array_elem_type(loc)
    else if lv_is_lent(loc) == 1 and lv_pointee_type(loc) == TypeKind.Array
        out.ref_size = lv_pointee_array_size(loc)
        out.ref_elem = lv_pointee_array_elem_type(loc)

# The `[N]T` behind `e`, a local `*[N]T`, `@[N]T` or `@&[N]T`.  0 for any other
# pointer: only a local keeps the element.
fn ref_behind(env: *RefEnv, e: *Expr, out: *RefTy) -> i32
    if e.kind != ExprKind.Ident
        return 0
    var is_local: i32 = 0
    let loc: *LocalVar = ref_local_in(env, e.ident, @is_local)
    if loc == null
        return 0
    var en_len: i32 = 0
    let en: *u8 = array_ptr_elem_name(loc, @en_len)   # #2548
    # AGAST #3642: a plane `@x[i]` (#2570) is its `[M][N]..T`, as an N-D local
    # is, so `*q = [..]` is judged by shape (R42), not by the flat count
    # pointee_array_size keeps.
    var shape: *ArrayShape = lv_pointee_array_shape(loc)
    if shape == null and env.s == null
        # AGAST #4290: on Sema, an `@[N][M]T` / `@&[N][M]T` is a plane too,
        # by SemaVar's shape (sema_elem_ty's), which the emitter's image keeps
        # only for a `*[N][M]T` (bind_nd_pointee_param): `(*p)[i]` is a row.
        let v: *SemaVar = sema_find_local(env.sm, e.ident)
        if v != null and ref_is_pointer(v.kind) == 1 and v.shape != null and v.shape.rank >= 2
            shape = v.shape
    if shape != null
        return ref_set_array(out, TypeKind.Array, lv_pointee_array_elem_pointee(loc), StrView { ptr: (en), len: (en_len) as i64 }, shape, 0)
    ref_set_array(out, lv_pointee_array_elem_type(loc), lv_pointee_array_elem_pointee(loc), StrView { ptr: (en), len: (en_len) as i64 }, null, lv_pointee_array_size(loc))

# Does the place `e` lie behind an `@T`, `@&T`, `*T` or `:&`?  ritz0's
# MoveChecker._through_reference.
pub fn ref_through(s: *EmitterState, e0: *Expr) -> i32
    var e: *Expr = e0
    while e != null
        var next: *Expr = null
        if e.kind == ExprKind.Member or e.kind == ExprKind.Index
            next = e.left
        else if e.kind == ExprKind.Unary and e.op == OpKind.Deref
            next = e.operand
        else
            if e.kind != ExprKind.Ident
                return 0
            let idx: i32 = find_local_idx(s, e.ident)
            if idx < 0
                return 0
            return lv_is_lent(local_at(s, idx))
        e = next
        var t: RefTy
        if ref_ty_of(s, e, @t) == 1 and ref_is_pointer(t.kind) == 1
            return 1
    0

# --- One copy over either side (AGAST #3926, #4011) ------------------------------
#
# The queries take a RefEnv: the emitter's locals (s) or Sema's scope (sm).  Only
# the leaves differ: a name's binding, a member's field, a call's fn.
pub struct RefEnv
    s: *EmitterState
    sm: *Sema

pub fn ref_env_of(env: *RefEnv, s: *EmitterState, sm: *Sema) -> *RefEnv
    env.s = s
    env.sm = sm
    env

# What Sema can't read off a SemaVar, kept per scope slot by ref_value.ritz's
# hooks as the emitter keeps it on LocalVar.  A note counts only for the binding
# it was made for: `name` is that binding's, and a slot reused by another
# binding (a match arm's, a `for`'s) has none.
pub struct RsNote
    name: *u8
    # TypeKind.Ref / TypeKind.MutRef for an un-annotated `let p = @c` / `@&c` (or a
    # copy of one) the emitter types as a reference (type_ref_view_let), or a
    # match payload of an `@T` / `@&T` variant field; TypeKind.Void otherwise.  What
    # it points at stays: an `@*C` of `let p = @q` keeps its `*C`.
    ref_kind: TypeKind
    ref_pointee: TypeKind
    ref_name: StrView
    inner_ref: i32        # Param.param_inner_ref / Stmt.var_inner_ref (AGAST #2399)
    # The `q#` view's T when emit_var_decl's inference makes an un-annotated
    # `let q = h(p)` a `*[N]T` (infer_array_ptr_let), which index_elem, from
    # what's written, can't know; TypeKind.Void otherwise (AGAST #4011).
    infer_view: TypeKind
    caller_place: i32     # AGAST #2340: a `:&` param's `@x` names the caller's
    # AGAST #2364: U for an `@*U` / `@&*U` param or local
    # (Param.param_ref_ptr_pointee, ref_decl_ptr_pointee), TypeKind.Void otherwise.
    # ref_of_ident_in copies it onto the RefTy; the emitter never read it.
    ptr_pointee: TypeKind
    # LocalVar.ref_root* (AGAST #2340): the local root this binding definitely
    # refers to, how many loops it was declared in, and what it points at.
    root: StrView
    root_loops: i32
    root_pointee: TypeKind
    root_name: StrView
    # AGAST #4011: the LocalVar the emitter will make for this binding, as far
    # as ref_check's typing reads it (ref_local_in); has_loc 0 when none is.
    has_loc: i32
    loc: LocalVar
    # The fn type a declared local or a param holds (LocalVar.fn_sig, which
    # emit_call calls through); has_fn 0 when no hook made it.
    fn_sig: *FnDef
    has_fn: i32

var RS_NOTES: *RsNote = null
var RS_NOTE_CAP: i32 = 0

# The note on `v`, a binding in Sema's scope; null if none was made for it.
pub fn rs_note(sm: *Sema, v: *SemaVar) -> *RsNote
    if v == null
        return null
    let i: i32 = ((v as i64 - sm.scope as i64) / sizeof(SemaVar)) as i32
    if i < 0 or i >= RS_NOTE_CAP
        return null
    let n: *RsNote = RS_NOTES + i
    if n.name != v.name.ptr
        return null
    n

# A fresh note on `v`, the binding just made.
pub fn rs_note_new(sm: *Sema, v: *SemaVar) -> *RsNote
    let i: i32 = ((v as i64 - sm.scope as i64) / sizeof(SemaVar)) as i32
    if i >= RS_NOTE_CAP
        let cap: i32 = i * 2 + 16
        let grown: *RsNote = malloc((cap as i64) * sizeof(RsNote)) as *RsNote
        memset(grown as *u8, 0, (cap as i64) * sizeof(RsNote))
        if RS_NOTES != null
            memcpy(grown as *u8, RS_NOTES as *u8, (RS_NOTE_CAP as i64) * sizeof(RsNote))
            free(RS_NOTES as *u8)
        RS_NOTES = grown
        RS_NOTE_CAP = cap
    let n: *RsNote = RS_NOTES + i
    memset(n as *u8, 0, sizeof(RsNote))
    n.name = v.name.ptr
    n.ref_kind = TypeKind.Void
    n.infer_view = TypeKind.Void
    n.root_pointee = TypeKind.Void
    n.ptr_pointee = TypeKind.Void
    n

# A fn begins: no note is for any of its bindings yet.
pub fn rs_notes_clear()
    if RS_NOTES != null
        memset(RS_NOTES as *u8, 0, (RS_NOTE_CAP as i64) * sizeof(RsNote))

# The field `e` (ExprKind.Member) names.
fn ref_field_in(env: *RefEnv, e: *Expr) -> *StructField
    if env.s != null
        return resolve_member_chain_field(env.s, e)
    rs_field(env.sm, e)

# The fn a call or method `e` calls, as ref_view's of_fn asks.
fn ref_call_def_in(env: *RefEnv, e: *Expr) -> *FnDef
    if e.kind == ExprKind.Method
        if env.s != null
            return ref_method_def(env.s, e)
        return rs_method_def(env.sm, e)
    if env.s != null
        return find_call_fn(env.s, e)
    sema_call_fn(env.sm, e)

# A step `p[i]` that reads through a pointer to an array, a Vec, Span or
# String: its element's kind.  TypeKind.Void when `e` isn't one (index_through).
fn ref_through_kind_in(env: *RefEnv, e: *Expr) -> TypeKind
    if env.s != null
        let through: *LocalVar = index_through(env.s, e)
        if through == null
            return TypeKind.Void
        return through_elem_kind(env.s, through)
    rs_through_kind(env.sm, e)

# What a write meets in `*r` with `r: @@S` or `*@&S`, held as an `@*S` / `**S`
# (AGAST #2399): the `@S` / `@&S` the nearest level was, else 0.
fn ref_deref_ref_in(env: *RefEnv, r: *Expr) -> i32
    if r.kind != ExprKind.Ident
        return 0
    if env.s != null
        let dl: i32 = find_local_idx(env.s, r.ident)
        if dl < 0 or local_struct_levels(local_at(env.s, dl)) != 2
            return 0
        return lv_inner_ref(local_at(env.s, dl))
    let v: *SemaVar = sema_find_local(env.sm, r.ident)
    if v == null or v.lent != null or rs_levels(v) != 2
        return 0
    let n: *RsNote = rs_note(env.sm, v)
    if n == null
        return 0
    n.inner_ref

# --- Sema's side: types of a place's steps -----------------------------------------
#
# ref_ty_of's answer from Sema's scope (ref_ty_in's Sema side; ref_loan.ritz's
# loans read it too, AGAST #3506): a step's kind (TYPE_*), the struct it is or
# points at (name), and an array's element kind (pointee).  0 when Sema can't
# say.

pub fn rs_set(out: *SemaTy, kind: TypeKind, pointee: TypeKind, name_sv: StrView) -> i32
    out.kind = kind
    out.pointee = pointee
    out.name = name_sv
    out.fn_sig = null
    out.shape = null
    1

pub fn rs_local(sm: *Sema, v: *SemaVar, out: *SemaTy) -> i32
    let n: *RsNote = rs_note(sm, v)
    if n != null and n.ref_kind != TypeKind.Void
        return rs_set(out, n.ref_kind, n.ref_pointee, n.ref_name)
    let p: *Param = v.lent
    if p != null and p.param_type == TypeKind.MutRef
        # `c:& C` (and a free fn's `self:& C`) reads as a `C` (§13.4).
        return rs_set(out, p.param_pointee_type, TypeKind.Void, p.param_type_name)
    var kind: TypeKind = v.let_kind
    match kind
        TypeKind.Unknown | TypeKind.PtrPtr =>
            return 0
        TypeKind.Array =>
            var elem: TypeKind = v.let_elem
            if elem == TypeKind.Void
                elem = v.index_elem
            sema_arr_ty(out, elem, v.let_name, v.shape)
            return 1
        _ => pass
    if ref_is_pointer(kind) == 1
        return rs_set(out, kind, v.let_pointee, v.let_name)
    rs_set(out, kind, TypeKind.Void, v.let_name)

pub fn rs_ident(sm: *Sema, name_sv: StrView, out: *SemaTy) -> i32
    let v: *SemaVar = sema_find_local(sm, name_sv)
    if v != null
        return rs_local(sm, v, out)
    let g: *GlobalVarDef = sbk_global(sm, name_sv)
    if g == null or g.var_type == TypeKind.PtrPtr
        return 0
    if ref_is_pointer(g.var_type) == 1
        return rs_set(out, g.var_type, g.pointee_type, g.pointee_type_name)
    if g.var_type == TypeKind.Array
        sema_arr_ty(out, g.array_elem_type, g.array_elem_type_name, g.array_shape)
        return 1
    rs_set(out, g.var_type, TypeKind.Void, g.type_name)

# What fn `f` returns, as ref_check's ref_of_fn has it.
pub fn rs_fn(f: *FnDef, out: *SemaTy) -> i32
    if f == null or f.return_type == TypeKind.Void
        return 0
    if f.ret_ref != null
        let r: *Param = f.ret_ref
        if r.param_type == TypeKind.PtrPtr or r.param_type == TypeKind.Array
            return 0
        return rs_set(out, r.param_type, r.param_pointee_type, r.param_type_name)
    if f.ret_array != null
        sema_arr_ty(out, f.ret_array.elem, f.ret_array.name, f.ret_array.shape)
        return 1
    if f.return_type == TypeKind.Ptr or f.return_type == TypeKind.PtrPtr
        if f.return_type_name.len > 0 and f.return_type == TypeKind.Ptr
            return rs_set(out, TypeKind.Ptr, TypeKind.Struct, f.return_type_name)
        return 0
    rs_set(out, f.return_type, TypeKind.Void, f.return_type_name)

pub fn rs_call_fn(sm: *Sema, e: *Expr) -> *FnDef
    if e.func_name.len > 0 and e.call_type_suffix.len == 0
        let v: *SemaVar = sema_find_local(sm, e.func_name)
        if v != null
            return v.fn_sig
    sema_call_fn(sm, e)

# The field `e` (ExprKind.Member) names, on its base's struct or what it points at.
pub fn rs_field(sm: *Sema, e: *Expr) -> *StructField
    var b: SemaTy
    if rs_ty(sm, e.left, @b) == 0
        return null
    if b.kind != TypeKind.Struct and (ref_is_pointer(b.kind) == 0 or b.pointee != TypeKind.Struct)
        return null
    let st: *StructDef = sema_find_struct(sm, b.name)
    if st == null
        return null
    let idx: i32 = find_field_index(st, e.ident)
    if idx < 0
        return null
    get_field_type(st, idx)

pub fn rs_of_field(f: *StructField, out: *SemaTy) -> i32
    let t: TypeKind = lowered_field_type(f)   # Sema runs before lower_ref_fields
    if ref_is_pointer(t) == 1
        var pointee: TypeKind = f.ptr_pointee
        if pointee == TypeKind.Void and f.field_type_name.len > 0
            pointee = TypeKind.Struct
        return rs_set(out, t, pointee, f.field_type_name)
    match t
        TypeKind.Array =>
            sema_arr_ty(out, f.array_elem_type, f.array_elem_type_name, f.array_shape)
            return 1
        TypeKind.PtrPtr =>
            return 0
        _ => pass
    rs_set(out, t, TypeKind.Void, f.field_type_name)

pub fn rs_ty(sm: *Sema, e: *Expr, out: *SemaTy) -> i32
    if e == null
        return 0
    let k: ExprKind = e.kind
    match k
        ExprKind.Ident =>
            return rs_ident(sm, e.ident, out)
        ExprKind.StringLit =>
            return rs_set(out, TypeKind.Struct, TypeKind.Void, "StrView")
        ExprKind.Member =>
            let f: *StructField = rs_field(sm, e)
            if f == null
                return 0
            return rs_of_field(f, out)
        ExprKind.Index =>
            if e.right != null and e.right.kind == ExprKind.Range
                return 0
            var b: SemaTy
            if rs_ty(sm, e.left, @b) == 0
                return 0
            if b.kind == TypeKind.Array
                # Sema's element step: an N-D array's row, else its element.
                return (sema_arr_elem(@b, out) != TypeKind.Unknown) as i32
            if ref_is_pointer(b.kind) == 1
                # A `*[N]T`'s `q[i]` is an element (a plane's, a row) of the
                # `[N]T` behind it, as the array's own is (AGAST #4290).
                var arr: SemaTy
                if b.pointee == TypeKind.Array and rs_behind(sm, e.left, @b, @arr) == 1
                    return (sema_arr_elem(@arr, out) != TypeKind.Unknown) as i32
                if b.pointee == TypeKind.Void or ref_is_pointer(b.pointee) == 1 or b.pointee == TypeKind.Array or b.pointee == TypeKind.PtrPtr
                    return 0
                return rs_set(out, b.pointee, TypeKind.Void, b.name)
            return 0
        _ => pass
    if k == ExprKind.Unary and e.op == OpKind.Deref
        var o: SemaTy
        if rs_ty(sm, e.operand, @o) == 0
            return 0
        if ref_is_pointer(o.kind) == 0
            *out = o
            return 1
        if o.pointee == TypeKind.Array
            return rs_behind(sm, e.operand, @o, out)
        if o.pointee == TypeKind.Void or ref_is_pointer(o.pointee) == 1 or o.pointee == TypeKind.PtrPtr
            return 0
        return rs_set(out, o.pointee, TypeKind.Void, o.name)
    if k == ExprKind.Unary and (e.op == OpKind.Addr or e.op == OpKind.AddrMut)
        var a: SemaTy
        if rs_ty(sm, e.operand, @a) == 0
            return 0
        if ref_is_pointer(a.kind) == 1
            return rs_set(out, TypeKind.Ptr, TypeKind.Ptr, a.name)
        return rs_set(out, TypeKind.Ptr, a.kind, a.name)
    match k
        ExprKind.Call =>
            return rs_fn(rs_call_fn(sm, e), out)
        ExprKind.Method =>
            return rs_fn(rs_method_def(sm, e), out)
        ExprKind.Binary =>
            var l: SemaTy
            if rs_ty(sm, e.left, @l) == 1 and ref_is_pointer(l.kind) == 1
                return rs_set(out, l.kind, l.pointee, l.name)
            return 0
        _ => pass
    if k == ExprKind.Cast and e.type_kind == TypeKind.Ptr
        return rs_set(out, TypeKind.Ptr, ptr_slot_flat(e.cast_ptr_kind), e.ident)
    # AGAST #4058: and `as @S` / `as @&S`, whose pointee the parser keeps too
    # (#3443, #3757): `p as @S` is an `@S` whatever `p` was, so a write through
    # it, `(p as @S).f = v` or `.arr[i] = v`, is through an `@T`, as ritz0 says.
    if k == ExprKind.Cast and (e.type_kind == TypeKind.Ref or e.type_kind == TypeKind.MutRef) and e.cast_ptr_kind != (TypeKind.Void as i32)
        return rs_set(out, e.type_kind, ptr_slot_flat(e.cast_ptr_kind), e.ident)
    0

# The element of the instantiated `Vec$T` `v`, from its `data: *T` field: a
# struct, or an integer its name spells.  0 otherwise.
pub fn rs_vec_elem(sm: *Sema, v: *SemaTy, out: *SemaTy) -> i32
    if v.name.len <= 4 or not v.name.starts_with("Vec$")
        return 0
    let vec_st: *StructDef = sema_find_struct(sm, v.name)
    if vec_st == null
        return 0
    let di: i32 = find_field_index(vec_st, "data")
    if di < 0
        return 0
    let data: *StructField = get_field_type(vec_st, di)
    if data.field_type != TypeKind.Ptr or data.field_type_name.len <= 0
        return 0
    if sema_find_struct(sm, data.field_type_name) != null
        return rs_set(out, TypeKind.Struct, TypeKind.Void, data.field_type_name)
    let k: TypeKind = primitive_type_from_name(v.name.skip(4))
    if sema_is_int_kind(k) == 0
        return 0
    rs_set(out, k, TypeKind.Void, strview_empty())

# rs_ty, also through a Vec's element (`vs[1].a`), for the steps of a place.
# As ritz0's MoveChecker._loan_type.
pub fn rs_loan_ty(sm: *Sema, e: *Expr, out: *SemaTy) -> i32
    if e.kind == ExprKind.Index or e.kind == ExprKind.Member
        var b: SemaTy
        if rs_loan_ty(sm, e.left, @b) == 1 and b.kind == TypeKind.Struct
            if e.kind == ExprKind.Index
                if rs_vec_elem(sm, @b, out) == 1
                    return 1
            else
                let st: *StructDef = sema_find_struct(sm, b.name)
                if st != null
                    let fi: i32 = find_field_index(st, e.ident)
                    if fi >= 0
                        return rs_of_field(get_field_type(st, fi), out)
    rs_ty(sm, e, out)

# The method `e` (ExprKind.Method) calls, on its receiver's own type, as
# ref_check's ref_method_def: an element of a Vec is its element's (AGAST
# #2443).  Else bool_check's resolution, which also knows a static call.
pub fn rs_method_def(sm: *Sema, e: *Expr) -> *FnDef
    # An element through, `p[i].m()`, is the element's type (index_through_struct).
    var en: *u8 = null
    var el: i32 = 0
    if rs_through_struct(sm, e.left, @en, @el) == 1
        if en == null
            return null
        return sema_method_fn(sm, StrView { ptr: (en), len: (el) as i64 }, e.ident)
    var t: SemaTy
    if e.left != null and rs_loan_ty(sm, e.left, @t) == 1 and t.name.len > 0
        return sema_method_fn(sm, t.name, e.ident)
    sbk_method_def(sm, e)

# The `[N]T` behind `e`, a local `*[N]T`, `@[N]T` or `@&[N]T` of type `o`, as
# sema_elem_ty reads it (AGAST #4290): SemaVar.index_elem and, for a plane
# pointer `*[N][M]..T` (#2570), its shape, so `(*p)[i]` is a row.  What the
# emitter's inference made a `*[N]T` (an un-annotated `let q = h(p)`, which
# index_elem, from what's written, can't know) is the LocalVar image's.  0 for
# any other pointer: only a local keeps the element.
fn rs_behind(sm: *Sema, e: *Expr, o: *SemaTy, out: *SemaTy) -> i32
    if e.kind != ExprKind.Ident
        return 0
    let v: *SemaVar = sema_find_local(sm, e.ident)
    if v == null
        return 0
    if ref_is_pointer(v.kind) == 1 and v.index_elem != TypeKind.Void
        sema_arr_ty(out, v.index_elem, o.name, v.shape)
        return 1
    let n: *RsNote = rs_note(sm, v)
    if n == null or n.has_loc == 0
        return 0
    let lo: *LocalVar = @n.loc
    if ref_is_pointer(lv_var_type(lo)) == 0 or lv_pointee_type(lo) != TypeKind.Array or lv_pointee_array_elem_type(lo) == TypeKind.Void
        return 0
    sema_arr_ty(out, lv_pointee_array_elem_type(lo), o.name, lv_pointee_array_shape(lo))
    1

# index_through_struct on Sema: 1 when `e` is `p[i]` through a Vec, Span or
# String (or a pointer to one), with the element's struct name in *name (null
# for a scalar element); 0 when `e` isn't one.
fn rs_through_struct(sm: *Sema, e: *Expr, name: **u8, len: *i32) -> i32
    if e == null or e.kind != ExprKind.Index or e.right == null or e.right.kind == ExprKind.Range or e.left == null
        return 0
    let lk: ExprKind = e.left.kind
    if lk != ExprKind.Ident and lk != ExprKind.Member and (lk != ExprKind.Unary or e.left.op != OpKind.Deref)
        return 0
    var t: SemaTy
    if rs_ty(sm, e.left, @t) == 0
        return 0
    if e.left.kind == ExprKind.Ident and t.kind != TypeKind.Struct and (ref_is_pointer(t.kind) == 0 or t.pointee != TypeKind.Struct)
        return 0
    var k: TypeKind = TypeKind.Void
    var n: *u8 = null
    var l: i32 = 0
    if let_through_elem(sm, t.kind, t.pointee, t.name, @k, @n, @l) == 0
        return 0
    *name = null
    *len = 0
    if k == TypeKind.Struct or k == TypeKind.Ptr
        *name = n
        *len = l
    1

# local_struct_levels for a Sema binding, which ref_deref_ref_in asks about 2.
fn rs_levels(v: *SemaVar) -> i32
    match v.kind
        TypeKind.PtrPtr =>
            return ptr_ptr_ident_levels(v.inner)
        TypeKind.Ref | TypeKind.MutRef =>
            match v.pointee
                TypeKind.Ptr =>
                    return 2
                TypeKind.PtrPtr =>
                    return 1 + ptr_ptr_ident_levels(v.inner)
                _ => pass
            return 1
        TypeKind.Ptr =>
            return 1
        _ => pass
    0

# The element kind of a Vec, Span or String `t` is or points at; else TypeKind.Void.
fn rs_buffer_kind(sm: *Sema, t: *SemaTy) -> TypeKind
    var k: TypeKind = TypeKind.Void
    var n: *u8 = null
    var l: i32 = 0
    if let_through_elem(sm, t.kind, t.pointee, t.name, @k, @n, @l) == 0
        return TypeKind.Void
    k

# index_through's question on Sema: the element kind when `e`, `p[i]` or
# `(*p)[i]`, reads through a Vec, Span or String (or a pointer to one), a field
# that is one, or a `*[N]T` local's `p#` view; else TypeKind.Void.
pub fn rs_through_kind(sm: *Sema, e: *Expr) -> TypeKind
    if e.kind != ExprKind.Index or e.right == null or e.right.kind == ExprKind.Range or e.left == null
        return TypeKind.Void
    if e.left.kind == ExprKind.Index
        return TypeKind.Void
    var root: *Expr = e.left
    if root.kind == ExprKind.Unary and root.op == OpKind.Deref
        root = root.operand
    if root == null
        return TypeKind.Void
    var t: SemaTy
    if root.kind != ExprKind.Ident
        # `x.vf[i]`, a field that is a Vec, Span or String or points at one (#2564).
        if root == e.left and root.kind == ExprKind.Member and rs_ty(sm, root, @t) == 1
            let bk: TypeKind = rs_buffer_kind(sm, @t)
            if bk != TypeKind.Void
                return bk
        return rs_base_array_kind(sm, root)
    let v: *SemaVar = sema_find_local(sm, root.ident)
    if v == null
        return TypeKind.Void
    let n: *RsNote = rs_note(sm, v)
    if n != null and n.infer_view != TypeKind.Void
        return n.infer_view
    if rs_ty(sm, root, @t) == 0
        return TypeKind.Void
    # `v[i]` on the value itself, but not `(*v)[i]`.
    if t.kind == TypeKind.Struct
        if root != e.left
            return TypeKind.Void
        return rs_buffer_kind(sm, @t)
    if ref_is_pointer(t.kind) == 1 and t.pointee == TypeKind.Array
        return sema_view_elem(sm, v)
    if ref_is_pointer(t.kind) == 1 and t.pointee == TypeKind.Struct
        return rs_buffer_kind(sm, @t)
    TypeKind.Void

# base_array_view on Sema (AGAST #4011): the element kind of the `*[N]T` that
# `root`, a field, a global or a call, holds (`h.r[i]`, `g[i]`, `h(p)[i]`, #2329);
# TypeKind.Void when it holds none, or T gets no view.
fn rs_base_array_kind(sm: *Sema, root: *Expr) -> TypeKind
    var pa: *Param = null
    match root.kind
        ExprKind.Member =>
            let f: *StructField = rs_field(sm, root)
            if f != null
                pa = f.ptr_array
        ExprKind.Ident =>
            if sema_find_local(sm, root.ident) != null
                return TypeKind.Void
            let g: *GlobalVarDef = sbk_global(sm, root.ident)
            if g != null
                pa = g.ptr_array
        ExprKind.Call =>
            let fd: *FnDef = rs_call_fn(sm, root)
            if fd != null
                pa = fd.ret_ptr_array
        _ => pass
    if pa == null or pa.param_pointee_array_size <= 0
        return TypeKind.Void
    if sx_view_elem_ok(sm, pa.param_pointee_array_elem_type, pa.param_type_name) == 0
        return TypeKind.Void
    pa.param_pointee_array_elem_type

# `<file>:<line>:<col>: error: `, the prefix of every ref_check error, in
# that file (AGAST #3621: through diag, as every ritz1 error is).  AGAST #2516:
# the fn being emitted owns the line, and an instance of an imported generic
# (span.ritz's span_get<T>) carries its module's def_file.
fn ref_error_at(line: i32, col: i32)
    diag_error_at(fn_source_file(emitter_current_fn()), diag_span(line, col))

# 1 the first time this place is reported (ref_array_error).
pub fn ref_first_report(line: i32, col: i32) -> i32
    if line == REF_LAST_LINE and col == REF_LAST_COL
        return 0
    REF_LAST_LINE = line
    REF_LAST_COL = col
    1

# `e` is a non-literal array of another element type than its slot's, which
# Sema's slot checks (ref_value.ritz) couldn't name.
pub fn ref_array_error(s: *EmitterState, e: *Expr)
    if ref_first_report(e.span.line, e.span.col) == 0
        return
    ref_error_at(e.span.line, e.span.col)
    eprints("an array only fits a slot of the same element type: write a loop to convert it\n")
    s.diag.error_count = s.diag.error_count + 1

# `a`, a pointer kind, points at what `slot` holds.
pub fn ref_same_pointee(a: *RefTy, slot: *RefTy) -> i32
    if a.pointee != slot.kind
        return 0
    if slot.kind != TypeKind.Struct
        return 1
    if a.name.len == 0 or slot.name.len == 0
        return 0
    name_eq(a.name, slot.name)

# A call's by-value result is a temporary, not a place (Aaron's ruling on
# AGAST #2518, LARB review 4): ref_value.ritz's checks, and ownership.ritz's
# lending of one to a call, ask this.
# The call (ExprKind.Call / ExprKind.Method) whose by-value struct or array result
# `e` is, or is a field or element of; null when `e` is a place.  A step
# through a pointer (`mkp().x`, a `*T` field, `v[i]` of a Vec) reaches one.
pub fn ref_temp_call(s: *EmitterState, e: *Expr) -> *Expr
    var env: RefEnv
    ref_temp_call_in(ref_env_of(@env, s, null), e)

pub fn ref_temp_call_in(env: *RefEnv, e: *Expr) -> *Expr
    var r: *Expr = e
    while r != null and (r.kind == ExprKind.Member or r.kind == ExprKind.Index)
        if r.kind == ExprKind.Index
            if r.right != null and r.right.kind == ExprKind.Range
                return null
            if ref_is_through_in(env, r) == 1
                return null
        var t: RefTy
        if ref_ty_in(env, r.left, @t) == 0
            return null
        if t.kind != TypeKind.Struct and t.kind != TypeKind.Array
            return null
        r = r.left
    if r == null or (r.kind != ExprKind.Call and r.kind != ExprKind.Method)
        return null
    var rt: RefTy
    if ref_ty_in(env, r, @rt) == 0
        return null
    if rt.kind != TypeKind.Struct and rt.kind != TypeKind.Array
        return null
    r

# 1 when `e`, `p[i]`, reads through a pointer to an array, a Vec, Span or
# String (index_through), not a place in `p` itself.
pub fn ref_is_through_in(env: *RefEnv, e: *Expr) -> i32
    if env.s != null
        return (index_through(env.s, e) != null) as i32
    (rs_through_kind(env.sm, e) != TypeKind.Void) as i32

# `r as C` with `r: @C`, `@&C` or `*C` (AGAST #3004): 1 when the cast reads the
# referent, as ritz0 does, so the emitter loads a `%C` copy through `r` and
# resolve_expr_struct_name types it `%C`.  The move-only C was refused above.
# A target other than the referent is left as it was: neither compiler defines
# a struct-to-struct `as` (AGAST #3012).
pub fn ref_cast_reads_referent(s: *EmitterState, e: *Expr) -> i32
    if e.kind != ExprKind.Cast or e.type_kind != TypeKind.Struct or e.ident.len == 0
        return 0
    var a: RefTy
    if ref_ty_of(s, e.left, @a) == 0 or ref_is_pointer(a.kind) == 0
        return 0
    var target: RefTy
    ref_set(@target, TypeKind.Struct, TypeKind.Void, e.ident)
    ref_same_pointee(@a, @target)

# A fn's body is about to be emitted, its params bound.
pub fn ref_begin_fn(s: *EmitterState, f: *FnDef)
    REF_LAST_LINE = 0
    REF_LAST_COL = 0

# AGAST #2364: U for a local declared `@*U` / `@&*U`; TypeKind.Void otherwise.
pub fn ref_decl_ptr_pointee(stmt: *Stmt) -> TypeKind
    if stmt.var_ref == null or stmt.var_pointee_type != TypeKind.Ptr
        return TypeKind.Void
    stmt.var_ref.param_ref_ptr_pointee

# `@T` is read-only (LANGUAGE_SPEC §3.2, §13.3, LARB ruling R1, AGAST #2338).
# ritz0's twins are TypeChecker._check_write and _check_let_into_mut, and
# ritz0/test_at_is_read_only.py holds all three compilers to them.

# What a write meets when it goes through a value.
pub const REF_VIEW_VALUE: i32 = 0
pub const REF_VIEW_RAW: i32 = 1
pub const REF_VIEW_MUT: i32 = 2
pub const REF_VIEW_SHARED: i32 = 3
pub const REF_VIEW_UNKNOWN: i32 = 4

fn ref_view_of_kind(kind: TypeKind) -> i32
    match kind
        TypeKind.Ref =>
            return REF_VIEW_SHARED
        TypeKind.MutRef =>
            return REF_VIEW_MUT
        TypeKind.Ptr | TypeKind.PtrPtr =>
            return REF_VIEW_RAW
        _ => pass
    REF_VIEW_VALUE

fn ref_view_of_ident(env: *RefEnv, name_sv: StrView) -> i32
    if env.s != null
        let idx: i32 = find_local_idx(env.s, name_sv)
        if idx >= 0
            let loc: *LocalVar = local_at(env.s, idx)
            # `c:& C` is a `C`, and so is a by-value `self`.
            if lv_is_lent(loc) == 1 or lv_holds_lent_ptr(loc) == 1
                return REF_VIEW_VALUE
            return ref_view_of_kind(lv_var_type(loc))
        let g: *GlobalVarDef = find_global(env.s, name_sv)
        if g == null
            return REF_VIEW_UNKNOWN
        return ref_view_of_kind(g.var_type)
    let v: *SemaVar = sema_find_local(env.sm, name_sv)
    if v != null
        if v.lent != null
            return REF_VIEW_VALUE
        let n: *RsNote = rs_note(env.sm, v)
        if n != null and n.ref_kind != TypeKind.Void
            return ref_view_of_kind(n.ref_kind)
        return ref_view_of_kind(v.kind)
    let sg: *GlobalVarDef = sbk_global(env.sm, name_sv)
    if sg == null
        return REF_VIEW_UNKNOWN
    ref_view_of_kind(sg.var_type)

fn ref_view_of_fn(f: *FnDef) -> i32
    var t: RefTy
    if ref_of_fn(f, @t) == 0
        return REF_VIEW_UNKNOWN
    ref_view_of_kind(t.kind)

# What the value of `e` is, as far as a write through it goes.  An `@T` field is a
# `*T` by now (lower_ref_fields), and only its flag says otherwise.
pub fn ref_view(s: *EmitterState, e: *Expr) -> i32
    var env: RefEnv
    ref_view_in(ref_env_of(@env, s, null), e)

pub fn ref_view_in(env: *RefEnv, e: *Expr) -> i32
    if e == null
        return REF_VIEW_UNKNOWN
    let k: ExprKind = e.kind
    if k == ExprKind.Ident
        return ref_view_of_ident(env, e.ident)
    if k == ExprKind.Unary and e.op == OpKind.Addr
        return REF_VIEW_SHARED
    if k == ExprKind.Unary and e.op == OpKind.AddrMut
        return REF_VIEW_MUT
    # #4162: `p as @C` is an `@C` whatever `p` was.  ref_ty_of only types `as *T`,
    # so on the emitter it read as unknown and fit an `@&T` slot.  An `as @&C` needs
    # no case: unknown and mutable both let it into one.
    if k == ExprKind.Cast and e.type_kind == TypeKind.Ref
        return REF_VIEW_SHARED
    match k
        ExprKind.Member =>
            let f: *StructField = ref_field_in(env, e)
            if f == null
                return REF_VIEW_UNKNOWN
            if f.field_shared_ref == 1
                return REF_VIEW_SHARED
            if f.field_mut_ref == 1
                return REF_VIEW_MUT
            return ref_view_of_kind(lowered_field_type(f))
        ExprKind.Call | ExprKind.Method =>
            return ref_view_of_fn(ref_call_def_in(env, e))
        _ => pass
    if k == ExprKind.Index
        # An element through, `p[i]` or `(*p)[i]`, is its own kind: a `*S` one is the
        # pointer's business, anything else is a place in what `p` reaches (#2443).
        let through: TypeKind = ref_through_kind_in(env, e)
        if through != TypeKind.Void
            return ref_view_of_kind(through)
    # AGAST #2399: `*r` with `r: @@S` or `*@&S` (held as an `@*S` / `**S`) is the
    # `@S` / `@&S` it was.
    if k == ExprKind.Unary and e.op == OpKind.Deref and e.operand != null
        let nearest: i32 = ref_deref_ref_in(env, e.operand)
        if nearest == INNER_REF_SHARED
            return REF_VIEW_SHARED
        if nearest == INNER_REF_MUT
            return REF_VIEW_MUT
    var t: RefTy
    if k == ExprKind.Index or k == ExprKind.Unary and e.op == OpKind.Deref
        # What holds a pointer keeps its kind, where ref_ty_of has no pointee to give.
        var from: *Expr = e.left
        if k == ExprKind.Unary
            from = e.operand
        if ref_ty_in(env, from, @t) == 1 and ref_is_pointer(t.pointee) == 1
            return ref_view_of_kind(t.pointee)
    if ref_ty_in(env, e, @t) == 1
        return ref_view_of_kind(t.kind)
    REF_VIEW_UNKNOWN

# AGAST #2399: the reference `.` on `e` reaches the struct through last
# (INNER_REF_*): `p: @@S` or `*@S` is held as an `@*S` / `**S`, whose kind says
# the nearest level is a `*`.
fn ref_inner_ref(env: *RefEnv, e: *Expr) -> i32
    if e.kind == ExprKind.Ident
        if env.s != null
            let idx: i32 = find_local_idx(env.s, e.ident)
            if idx >= 0
                return lv_inner_ref(local_at(env.s, idx))
            let g: *GlobalVarDef = find_global(env.s, e.ident)
            if g != null
                return g.inner_ref
            return 0
        let v: *SemaVar = sema_find_local(env.sm, e.ident)
        if v != null
            let n: *RsNote = rs_note(env.sm, v)
            if n == null
                return 0
            return n.inner_ref
        let sg: *GlobalVarDef = sbk_global(env.sm, e.ident)
        if sg != null
            return sg.inner_ref
        return 0
    if e.kind == ExprKind.Member
        let f: *StructField = ref_field_in(env, e)
        if f != null
            return f.field_inner_ref
    0

# The kind of the field `e` names, or TypeKind.Void.
fn ref_field_kind(env: *RefEnv, e: *Expr) -> TypeKind
    if e.kind != ExprKind.Member
        return TypeKind.Void
    let f: *StructField = ref_field_in(env, e)
    if f == null
        return TypeKind.Void
    lowered_field_type(f)

# 1 when writing the place `e` goes through an `@T`.  Walk it from the place to
# its root: a `*T` ends the walk, since what it points at is the pointer's
# business, and so does anything the tables can't type.
pub fn ref_write_is_shared(s: *EmitterState, e0: *Expr) -> i32
    var env: RefEnv
    ref_write_is_shared_in(ref_env_of(@env, s, null), e0)

pub fn ref_write_is_shared_in(env: *RefEnv, e0: *Expr) -> i32
    var e: *Expr = e0
    while e != null
        var base: *Expr = null
        if e.kind == ExprKind.Member or e.kind == ExprKind.Index
            base = e.left
        else if e.kind == ExprKind.Unary and e.op == OpKind.Deref
            base = e.operand
        else
            return 0
        if e.kind == ExprKind.Member and ref_inner_ref(env, base) == INNER_REF_SHARED
            return 1
        let view: i32 = ref_view_in(env, base)
        var t: RefTy
        let known: i32 = ref_ty_in(env, base, @t)
        if view == REF_VIEW_SHARED
            # `.` reads through every level, so the one nearest the place counts.
            if e.kind == ExprKind.Member and known == 1 and (t.pointee == TypeKind.Ptr or t.pointee == TypeKind.PtrPtr)
                return 0
            # AGAST #2399: an `@*S` field is a `**S` by now (lower_ref_fields).
            if e.kind == ExprKind.Member and ref_field_kind(env, base) == TypeKind.PtrPtr
                return 0
            return 1
        if view == REF_VIEW_RAW or view == REF_VIEW_UNKNOWN
            return 0
        e = base
    0

# An `@T` doesn't become an `@&T` (LANGUAGE_SPEC §3.2, §13.3, AGAST #2374).  ritz0's
# twins are TypeChecker._check_borrow, _check_shared_into_mut and _check_receiver,
# and ritz0/test_at_into_mut.py holds all three compilers to them.

# `a` and `ret` point at the same type.
pub fn ref_same_referent(a: *RefTy, ret: *RefTy) -> i32
    if a.pointee != ret.pointee or a.pointee == TypeKind.Void
        return 0
    if a.pointee != TypeKind.Struct and a.pointee != TypeKind.Ptr
        return 1
    if a.name.len == 0 or ret.name.len == 0
        return 0
    name_eq(a.name, ret.name)

# The element of the instantiated `Vec$T` `v`, from its `data: *T` field (as
# emit_vec_elem_member_ptr finds it): a struct or an integer.  0 otherwise.
pub fn ref_vec_elem(s: *EmitterState, v: *RefTy, out: *RefTy) -> i32
    if v.name.len <= 4 or *v.name.ptr != 'V' or *(v.name.ptr + 1) != 'e' or *(v.name.ptr + 2) != 'c' or *(v.name.ptr + 3) != '$'
        return 0
    let vec_st: *StructDef = find_struct(s, v.name)
    if vec_st == null
        return 0
    let di: i32 = find_field_index(vec_st, "data")
    if di < 0
        return 0
    let data: *StructField = get_field_type(vec_st, di)
    if data.field_type != TypeKind.Ptr or data.field_type_name.len <= 0
        return 0
    if find_struct(s, data.field_type_name) != null
        return ref_set(out, TypeKind.Struct, TypeKind.Void, data.field_type_name)
    let k: TypeKind = vec_name_elem_type(v.name)
    if k == TypeKind.Unknown
        return 0
    ref_set(out, k, TypeKind.Void, strview_empty())
