# ref_check.ritz - the reference queries the emitter and Sema both ask
#
# Its checks have moved to Sema (#1816): §13.5's borrow conflicts (AGAST #2438)
# to ref_loan.ritz (#3506); `@T` read-only, return-of-local (#2338, #2374,
# #2340) and the slot checks (§13.2-13.4, LARB R1 / R5 / R42: a reference into
# a by-value slot and back, `@x` or an `@T` into an `@&T` or `:&` slot, arrays,
# variant payloads, casts, a call's temporary, `[v; n]`) to ref_value.ritz
# (#3926, #4011).  ref_rules.py and array_rules.py have their words.
#
# What stays is what both sides ask, one copy over a RefEnv (as let_check's
# LetEnv): the emitter's locals (s) or Sema's scope (sm).  ref_ty_in types an
# expression as a RefTy; on Sema a binding is read from the image of the
# LocalVar the emitter will make for it (RsNote.loc, made by ref_value.ritz's
# hooks, else from Sema's own type of it), so the typing code is the
# emitter's.  ref_view_in and ref_write_is_shared_in answer what a write
# through a place meets; ref_temp_call_in, whether a place is a call's
# temporary.  Sema's thin place typing (rs_ty) and its per-binding notes
# (RsNote) live here too, for ref_loan.ritz and ref_value.ritz.
#
# The emitter still asks ref_ty_of and ref_through (ownership.ritz's "cannot
# move out of a reference", which only reaches a program with a Drop in it),
# ref_temp_call (lending a temporary to a call), ref_view and ref_vec_elem
# (codegen), ref_cast_reads_referent and ref_array_error (emitter_stmt's
# backstop for an array mismatch Sema couldn't name).  ritz1 emits bodies after
# monomorphize_module, so a generic is judged per instance.

import ritzlib.sys
import ritzlib.io

import ast
import diag   # diag_error_at (AGAST #3621)
import ast_helpers
import types           # ty_int_in
import emitter_core
import emitter_expr_call   # method_callee_def
import let_check           # let_through_elem
import index_through       # index_through_struct (AGAST #2443)
import emitter_expr
import emitter_expr_arith
import ritzlib.memory
import ritzlib.str
import sema
import sema_type
import bool_check          # sbk_global, sbk_method_def

# What an expression or a slot holds.
pub struct RefTy
    kind: i32       # TYPE_*
    pointee: i32    # TYPE_* behind a pointer kind, or an array's element
    name: *u8       # the struct: kind's own, or the pointee's
    name_len: i32
    elem_pointee: i32     # U for an array's `*U` element; TYPE_VOID if unknown
    shape: *ArrayShape    # a multi-dimensional array's, else null
    returned: i32         # 1 for a slot that leaves the fn as a pointer or reference
    ref_size: i32         # N for a pointer kind to `[N]T`; 0 if unknown
    ref_elem: i32         # its T's kind (a struct T is `name`); TYPE_VOID if unknown
    # AGAST #2098: the `[N][M]..T` a pointer kind points at, else null.  A
    # `*[N][M]T` records the flat count and the leaf in ref_size / ref_elem
    # (#2570), so two N-D referents are judged by shape instead.
    ref_shape: *ArrayShape
    name_only: i32        # 1 for a `-> *X` return: only a name, maybe a stale one
    # AGAST #2364: U when the pointee is a `*U` (pointee == TYPE_PTR), as
    # Param.param_ref_ptr_pointee keeps it; TYPE_VOID if unknown.  A scalar U
    # has no name, so without it `@&*i32` and `@&*i64` were one type.
    ptr_pointee: i32
    # AGAST #3048: a `**T` slot's T, as ptr_pointee keeps its kind; only
    # ref_ptr_ptr_slot sets it, and only a struct T has one.
    held_name: *u8
    held_name_len: i32
    # AGAST #3383 (LARB R42): N for an array kind, d0 for `[d0][d1]..T`, which
    # a literal landing here must be as long as; 0 if unknown.
    array_len: i32

var REF_LAST_LINE: i32 = 0
var REF_LAST_COL: i32 = 0

pub fn ref_set(out: *RefTy, kind: i32, pointee: i32, name: *u8, len: i32) -> i32
    out.kind = kind
    out.pointee = pointee
    out.name = name
    out.name_len = len
    out.elem_pointee = TYPE_VOID
    out.shape = null
    out.returned = 0
    out.ref_size = 0
    out.ref_elem = TYPE_VOID
    out.ref_shape = null
    out.name_only = 0
    out.ptr_pointee = TYPE_VOID
    out.held_name = null
    out.held_name_len = 0
    out.array_len = 0
    1

# `n` is the array's N (its d0 for a `shape`), 0 if unknown.
pub fn ref_set_array(out: *RefTy, elem: i32, elem_pointee: i32, name: *u8, len: i32, shape: *ArrayShape, n: i32) -> i32
    ref_set(out, TYPE_ARRAY, elem, name, len)
    out.elem_pointee = elem_pointee
    out.shape = shape
    out.array_len = n
    if shape != null
        out.array_len = shape.dims[0]
    1

# An ArrayElem keeps no N: a fn's `-> [N]T` has it on ret_array_param.
pub fn ref_set_elem(out: *RefTy, a: *ArrayElem) -> i32
    ref_set_array(out, a.elem, a.pointee, a.name, a.name_len, a.shape, 0)

# `out` is what `a[i]` holds for an N-D `[N][M]..T`: a row, one dimension
# fewer, as Sema's element step has it (sema_arr_elem, AGAST #4259): `[M]T`
# for two, an `[M][K]T` plane past that.  0 for a one-dimensional `a`.
pub fn ref_row(a: *RefTy, out: *RefTy) -> i32
    let sh: *ArrayShape = a.shape
    if sh == null or sh.rank < 2
        return 0
    var at: SemaTy
    sema_arr_ty(@at, TYPE_ARRAY, null, 0, sh)
    var row: SemaTy
    sema_arr_elem(@at, @row)
    if row.shape != null
        return ref_set_array(out, TYPE_ARRAY, sh.leaf_pointee, sh.leaf_name, sh.leaf_name_len, row.shape, 0)
    ref_set_array(out, sh.leaf_type, sh.leaf_pointee, sh.leaf_name, sh.leaf_name_len, null, sh.dims[sh.rank - 1])

pub fn ref_is_pointer(kind: i32) -> i32
    if kind == TYPE_PTR or kind == TYPE_REF or kind == TYPE_MUT_REF
        return 1
    0

fn ref_of_local(loc: *LocalVar, out: *RefTy) -> i32
    if loc.bk_unsure == 1
        return 0
    let t: i32 = loc.var_type
    if ref_is_pointer(t) == 1
        # `c:& C` reads as a `C` (§13.4), and so does a by-value `self`.
        if loc.is_lent == 1 or loc.holds_lent_ptr == 1
            return ref_set(out, loc.pointee_type, 0, loc.type_name, loc.type_name_len)
        ref_set(out, t, loc.pointee_type, loc.type_name, loc.type_name_len)
        out.ptr_pointee = loc.ref_ptr_pointee
        # The `[N]T` it points at, as ref_decl_slot and ref_of_param record
        # it, so `r = @g` into a `*[3]i32` local is judged (AGAST #3636).
        if loc.pointee_type == TYPE_ARRAY
            out.ref_size = loc.pointee_array_size
            out.ref_elem = loc.pointee_array_elem_type
            out.ref_shape = loc.pointee_array_shape   # AGAST #2098
        return 1
    if t == TYPE_ARRAY
        return ref_set_array(out, loc.array_elem_type, loc.array_elem_pointee, loc.type_name, loc.type_name_len, loc.array_shape, loc.array_size)
    if t == TYPE_PTR_PTR
        return 0
    ref_set(out, t, 0, loc.type_name, loc.type_name_len)

fn ref_of_ident(s: *EmitterState, name: *u8, len: i32, out: *RefTy) -> i32
    var env: RefEnv
    ref_of_ident_in(ref_env_of(@env, s, null), name, len, out)

# The local `name` names, as the emitter keeps it: its LocalVar, or on Sema
# the image RsNote keeps of it (AGAST #4011).  Null when it names none, and
# *is_local says whether it names a local Sema can't type.
pub fn ref_local_in(env: *RefEnv, name: *u8, len: i32, is_local: *i32) -> *LocalVar
    *is_local = 0
    if env.s != null
        let idx: i32 = find_local_idx(env.s, name, len)
        if idx < 0
            return null
        *is_local = 1
        return local_at(env.s, idx)
    let v: *SemaVar = sema_find_local(env.sm, name, len)
    if v == null
        return null
    *is_local = 1
    var n: *RsNote = rs_note(env.sm, v)
    if n != null and n.has_loc == 1
        return @n.loc
    # A binding no hook made an image of: Sema's own type of it.
    if n == null
        n = rs_note_new(env.sm, v)
    n.has_loc = rs_default_loc(env.sm, v, @n.loc)
    if n.has_loc == 0
        return null
    @n.loc

# The LocalVar add_local_full makes, with nothing else known yet.
pub fn rs_loc_new(loc: *LocalVar, name: *u8, len: i32, var_type: i32, type_name: *u8, type_name_len: i32, pointee: i32, arr_size: i32, arr_elem: i32)
    memset(loc as *u8, 0, sizeof(LocalVar))
    loc.name = name
    loc.name_len = len
    loc.var_type = var_type
    loc.type_name = type_name
    loc.type_name_len = type_name_len
    loc.pointee_type = pointee
    loc.array_size = arr_size
    loc.array_elem_type = arr_elem
    loc.array_elem_pointee = TYPE_VOID
    loc.inner_pointee_type = TYPE_VOID
    loc.pointee_array_elem_type = TYPE_VOID
    loc.pointee_array_elem_pointee = TYPE_VOID
    loc.ref_ptr_pointee = TYPE_VOID

# What any other binding (a `for` variable, a match payload, a tuple's) reads
# as: Sema's own type of it, held as the emitter holds it.
pub fn rs_default_loc(sm: *Sema, v: *SemaVar, loc: *LocalVar) -> i32
    var t: SemaTy
    if rs_local(sm, v, @t) == 0 or t.kind == TYPE_UNKNOWN or t.kind == TYPE_VOID
        # A `for` variable let_check leaves unread: Sema's binding type.
        rs_set(@t, v.kind, v.pointee, v.type_name, v.type_name_len)
    if t.kind == v.kind and t.name_len <= 0 and v.type_name_len > 0
        t.name = v.type_name   # a `for` variable over a `[N]S` param: let_check's has no S
        t.name_len = v.type_name_len
    var k: i32 = t.kind
    if k == TYPE_UNKNOWN or k == TYPE_VOID or k == TYPE_PTR_PTR
        return 0
    if k == TYPE_BOOL or v.bk == 1   # BK_BOOL: an i64 slot
        rs_loc_new(loc, v.name, v.name_len, TYPE_I64, null, 0, TYPE_I64, 0, 0)
        loc.is_bool = 1
        return 1
    if k == TYPE_ARRAY
        rs_loc_new(loc, v.name, v.name_len, TYPE_ARRAY, t.name, t.name_len, TYPE_I64, 0, t.pointee)
        loc.array_shape = v.shape
        return 1
    if ref_is_pointer(k) == 1
        rs_loc_new(loc, v.name, v.name_len, k, t.name, t.name_len, t.pointee, 0, 0)
        return 1
    rs_loc_new(loc, v.name, v.name_len, k, t.name, t.name_len, TYPE_I64, 0, 0)
    1

pub fn ref_of_ident_in(env: *RefEnv, name: *u8, len: i32, out: *RefTy) -> i32
    var is_local: i32 = 0
    let loc: *LocalVar = ref_local_in(env, name, len, @is_local)
    if loc != null
        return ref_of_local(loc, out)
    if is_local == 1
        return 0
    var g: *GlobalVarDef = null
    if env.s != null
        g = find_global(env.s, name, len)
    else
        g = sbk_global(env.sm, name, len)
    if g == null
        return 0
    if ref_is_pointer(g.var_type) == 1
        return ref_set(out, g.var_type, g.pointee_type, g.pointee_type_name, g.pointee_type_name_len)
    if g.var_type == TYPE_PTR_PTR
        return 0
    if g.var_type == TYPE_ARRAY
        return ref_set_array(out, g.array_elem_type, g.array_elem_pointee, g.array_elem_type_name, g.array_elem_type_name_len, g.array_shape, g.array_size)
    ref_set(out, g.var_type, 0, g.type_name, g.type_name_len)

pub fn ref_of_fn(f: *FnDef, out: *RefTy) -> i32
    if f == null or f.return_type == TYPE_VOID
        return 0
    if f.ret_ref != null
        return ref_of_param(f.ret_ref, out)
    if f.ret_array != null
        ref_set_elem(out, f.ret_array)
        if f.ret_array_param != null
            out.array_len = f.ret_array_param.param_array_size   # AGAST #3383
        return 1
    if f.return_type == TYPE_PTR or f.return_type == TYPE_PTR_PTR
        # FnDef keeps no pointee, only a struct's name.
        if f.return_type_name_len > 0 and f.return_type == TYPE_PTR
            ref_set(out, TYPE_PTR, TYPE_STRUCT, f.return_type_name, f.return_type_name_len)
            out.name_only = 1
            return 1
        return 0
    ref_set(out, f.return_type, 0, f.return_type_name, f.return_type_name_len)

pub fn ref_of_param(p: *Param, out: *RefTy) -> i32
    if p.param_type == TYPE_PTR_PTR
        return 0
    if p.param_type == TYPE_ARRAY
        return ref_set_array(out, p.param_array_elem_type, p.param_array_elem_pointee, p.param_type_name, p.param_type_name_len, p.param_array_shape, p.param_array_size)   # AGAST #3634: `[N][M]T`
    ref_set(out, p.param_type, p.param_pointee_type, p.param_type_name, p.param_type_name_len)
    if p.param_pointee_type == TYPE_ARRAY
        out.ref_size = p.param_pointee_array_size
        out.ref_elem = p.param_pointee_array_elem_type
        out.ref_shape = p.param_pointee_array_shape   # AGAST #2098
    if p.param_pointee_type == TYPE_PTR
        out.ptr_pointee = p.param_ref_ptr_pointee
    1

fn ref_of_field(env: *RefEnv, e: *Expr, f: *StructField, out: *RefTy) -> i32
    # Sema runs before lower_ref_fields, and asks what it will make the field.
    var t: i32 = f.field_type
    if env.s == null
        t = lowered_field_type(f)
    if ref_is_pointer(t) == 1
        var pointee: i32 = ref_member_pointee(env, e, f)
        # An instance's `*T` field keeps the name and not the kind.
        if pointee == TYPE_VOID and f.field_type_name_len > 0
            pointee = TYPE_STRUCT
        # A primitive `*T` field says what it points at itself (#1304), which
        # the member chain can lose behind an element, `a.a[1].p` (#2368).
        if t == TYPE_PTR and f.field_type_name_len == 0 and f.array_elem_type != TYPE_VOID
            pointee = f.array_elem_type
        return ref_set(out, t, pointee, f.field_type_name, f.field_type_name_len)
    if t == TYPE_ARRAY
        return ref_of_array_field(f, out)
    if t == TYPE_PTR_PTR
        return 0
    ref_set(out, t, 0, f.field_type_name, f.field_type_name_len)

# get_member_pointee_type_exact, for the field `f` that `e` names: on Sema the
# same reading of the field itself.
fn ref_member_pointee(env: *RefEnv, e: *Expr, f: *StructField) -> i32
    if env.s != null
        return get_member_pointee_type_exact(env.s, e)
    if lowered_field_type(f) != TYPE_PTR
        return TYPE_I64
    let pe: i32 = f.array_elem_type
    if ty_int_in(pe, 8, 16) == 1 or ty_int_in(pe, 32, 64) == 1
        return pe
    if pe == TYPE_F32 or pe == TYPE_F64 or pe == TYPE_BOOL
        return pe
    TYPE_VOID

pub fn ref_of_array_field(f: *StructField, out: *RefTy) -> i32
    ref_set_array(out, f.array_elem_type, f.array_elem_pointee, f.array_elem_type_name, f.array_elem_type_name_len, f.array_shape, f.array_size)

# The method `e` (EXPR_METHOD) calls, on the receiver's own type.
pub fn ref_method_def(s: *EmitterState, e: *Expr) -> *FnDef
    # An element through, `p[i].m()`, is the element's type: ref_ty_of gives `p[i]`
    # the Vec's own name (AGAST #2443).
    var en: *u8 = null
    var el: i32 = 0
    if index_through_struct(s, e.left, @en, @el) == 1
        if en == null
            return null
        return method_callee_def(s, en, el, e.ident_ptr, e.ident_len)
    var t: RefTy
    if e.left != null and ref_ty_of(s, e.left, @t) == 1 and t.name_len > 0
        return method_callee_def(s, t.name, t.name_len, e.ident_ptr, e.ident_len)
    var len: i32 = 0
    let name: *u8 = method_recv_type_name(s, e, @len)
    if name == null or len == 0
        return null
    method_callee_def(s, name, len, e.ident_ptr, e.ident_len)

# Fill `out` with the type of `e`.  0 if the tables can't say.
pub fn ref_ty_of(s: *EmitterState, e: *Expr, out: *RefTy) -> i32
    var env: RefEnv
    ref_ty_in(ref_env_of(@env, s, null), e, out)

# ref_ty_of, from either side (AGAST #3926, #4011): only the leaves differ, a
# name's binding, a member's field, a call's fn.
pub fn ref_ty_in(env: *RefEnv, e: *Expr, out: *RefTy) -> i32
    if e == null
        return 0
    let k: i32 = e.kind
    if k == EXPR_IDENT
        return ref_of_ident_in(env, e.ident_ptr, e.ident_len, out)
    if k == EXPR_STRING_LIT
        return ref_set(out, TYPE_STRUCT, 0, c"StrView", 7)
    if k == EXPR_UNARY
        var t: RefTy
        if e.op == OP_ADDR or e.op == OP_ADDR_MUT
            if ref_ty_in(env, e.operand, @t) == 0
                return 0
            if ref_is_pointer(t.kind) == 1
                ref_set(out, TYPE_PTR, TYPE_PTR, t.name, t.name_len)
                out.ptr_pointee = ref_addr_ptr_pointee(@t)
                return 1
            ref_set(out, TYPE_PTR, t.kind, t.name, t.name_len)
            if t.kind == TYPE_ARRAY
                ref_array_referent(env, e.operand, out)
                out.ref_shape = t.shape   # AGAST #2098
            return 1
        if e.op == OP_DEREF
            if ref_ty_in(env, e.operand, @t) == 0
                return 0
            if ref_is_pointer(t.kind) == 0
                *out = t
                return 1
            if t.pointee == TYPE_ARRAY
                return ref_behind(env, e.operand, out)
            if t.pointee == TYPE_VOID or ref_is_pointer(t.pointee) == 1
                return 0
            return ref_set(out, t.pointee, 0, t.name, t.name_len)
        return 0
    if k == EXPR_MEMBER
        let f: *StructField = ref_field_in(env, e)
        if f == null
            return 0
        return ref_of_field(env, e, f, out)
    if k == EXPR_INDEX
        # `p[1..3]` is a pointer, not an element.
        if e.right != null and e.right.kind == EXPR_RANGE
            return 0
        var b: RefTy
        if ref_ty_in(env, e.left, @b) == 0
            return 0
        if b.kind != TYPE_ARRAY and ref_is_pointer(b.kind) == 0
            return 0
        if b.kind == TYPE_ARRAY and b.pointee == TYPE_ARRAY
            return ref_row(@b, out)
        if ref_is_pointer(b.kind) == 1 and b.pointee == TYPE_ARRAY and b.ref_shape != null
            # A plane pointer's `q[i]` is a row of its `[M][N]..T` (#2570,
            # AGAST #4259), as the plane's own is.
            var plane: RefTy
            ref_set_array(@plane, TYPE_ARRAY, TYPE_VOID, b.name, b.name_len, b.ref_shape, 0)
            return ref_row(@plane, out)
        # AGAST #2377: `a[i]` with `a: [N]*T` is a `*T`, so `*a[i]` and
        # `a[i][j]` are read through a pointer: a Drop T is not moved out.
        if b.kind == TYPE_ARRAY and ref_is_pointer(b.pointee) == 1
            let ep: i32 = b.elem_pointee
            if ep == TYPE_VOID or ep == TYPE_ARRAY or ep == TYPE_PTR_PTR or ref_is_pointer(ep) == 1
                return 0
            return ref_set(out, b.pointee, ep, b.name, b.name_len)
        if b.pointee == TYPE_VOID or ref_is_pointer(b.pointee) == 1 or b.pointee == TYPE_ARRAY
            return 0
        return ref_set(out, b.pointee, 0, b.name, b.name_len)
    if k == EXPR_CALL or k == EXPR_METHOD
        return ref_of_fn(ref_call_def_in(env, e), out)
    if k == EXPR_BINARY
        var l: RefTy
        if ref_ty_in(env, e.left, @l) == 1 and ref_is_pointer(l.kind) == 1
            return ref_set(out, l.kind, l.pointee, l.name, l.name_len)
        return 0
    if k == EXPR_CAST and e.op == TYPE_PTR
        return ref_set(out, TYPE_PTR, e.int_val as i32, e.ident_ptr, e.ident_len)
    # AGAST #4058: and `as @S` / `as @&S`, whose pointee the parser keeps too
    # (#3443, #3757): `p as @S` is an `@S` whatever `p` was, so a write through
    # it, `(p as @S).f = v` or `.arr[i] = v`, is through an `@T`, as ritz0 says.
    if k == EXPR_CAST and (e.op == TYPE_REF or e.op == TYPE_MUT_REF) and e.int_val as i32 != TYPE_VOID
        return ref_set(out, e.op, e.int_val as i32, e.ident_ptr, e.ident_len)
    0

# AGAST #2364: U for `@x` of an x of type `t`, when x is a `*U`: a local, a
# field, or a `:& *U` param, which binds as the caller's `*U` (#2075).  A
# reference `q: @&U` or `@U` is a `*U` too (#3160): ref_value_into_ref words
# that misfit as ritz0 does, "a reference to one type".
fn ref_addr_ptr_pointee(t: *RefTy) -> i32
    t.pointee

# `out` is `@a`: its `[N]T`'s N and T, for an `a` that is a local array or a
# `:&` one.  Unknown for anything else.
fn ref_array_referent(env: *RefEnv, e: *Expr, out: *RefTy)
    if e.kind != EXPR_IDENT
        return
    var is_local: i32 = 0
    let loc: *LocalVar = ref_local_in(env, e.ident_ptr, e.ident_len, @is_local)
    if loc == null
        return
    if loc.var_type == TYPE_ARRAY
        out.ref_size = loc.array_size
        out.ref_elem = loc.array_elem_type
    else if loc.is_lent == 1 and loc.pointee_type == TYPE_ARRAY
        out.ref_size = loc.pointee_array_size
        out.ref_elem = loc.pointee_array_elem_type

# The `[N]T` behind `e`, a local `*[N]T`, `@[N]T` or `@&[N]T`.  0 for any other
# pointer: only a local keeps the element.
fn ref_behind(env: *RefEnv, e: *Expr, out: *RefTy) -> i32
    if e.kind != EXPR_IDENT
        return 0
    var is_local: i32 = 0
    let loc: *LocalVar = ref_local_in(env, e.ident_ptr, e.ident_len, @is_local)
    if loc == null
        return 0
    var en_len: i32 = 0
    let en: *u8 = array_ptr_elem_name(loc, @en_len)   # #2548
    # AGAST #3642: a plane `@x[i]` (#2570) is its `[M][N]..T`, as an N-D local
    # is, so `*q = [..]` is judged by shape (R42), not by the flat count
    # pointee_array_size keeps.
    if loc.pointee_array_shape != null
        return ref_set_array(out, TYPE_ARRAY, loc.pointee_array_elem_pointee, en, en_len, loc.pointee_array_shape, 0)
    ref_set_array(out, loc.pointee_array_elem_type, loc.pointee_array_elem_pointee, en, en_len, null, loc.pointee_array_size)

# Does the place `e` lie behind an `@T`, `@&T`, `*T` or `:&`?  ritz0's
# MoveChecker._through_reference.
pub fn ref_through(s: *EmitterState, e0: *Expr) -> i32
    var e: *Expr = e0
    while e != null
        var next: *Expr = null
        if e.kind == EXPR_MEMBER or e.kind == EXPR_INDEX
            next = e.left
        else if e.kind == EXPR_UNARY and e.op == OP_DEREF
            next = e.operand
        else
            if e.kind != EXPR_IDENT
                return 0
            let idx: i32 = find_local_idx(s, e.ident_ptr, e.ident_len)
            if idx < 0
                return 0
            return local_at(s, idx).is_lent
        e = next
        var t: RefTy
        if ref_ty_of(s, e, @t) == 1 and ref_is_pointer(t.kind) == 1
            return 1
    0

# --- One copy over either side (AGAST #3926, #4011) ------------------------------
#
# The queries take a RefEnv: the emitter's locals (s) or Sema's scope (sm).  Only
# the leaves differ: a name's binding, a member's field, a call's fn.
pub struct RefEnv
    s: *EmitterState
    sm: *Sema

pub fn ref_env_of(env: *RefEnv, s: *EmitterState, sm: *Sema) -> *RefEnv
    env.s = s
    env.sm = sm
    env

# What Sema can't read off a SemaVar, kept per scope slot by ref_value.ritz's
# hooks as the emitter keeps it on LocalVar.  A note counts only for the binding
# it was made for: `name` is that binding's, and a slot reused by another
# binding (a match arm's, a `for`'s) has none.
pub struct RsNote
    name: *u8
    # TYPE_REF / TYPE_MUT_REF for an un-annotated `let p = @c` / `@&c` (or a
    # copy of one) the emitter types as a reference (type_ref_view_let), or a
    # match payload of an `@T` / `@&T` variant field; TYPE_VOID otherwise.  What
    # it points at stays: an `@*C` of `let p = @q` keeps its `*C`.
    ref_kind: i32
    ref_pointee: i32
    ref_name: *u8
    ref_name_len: i32
    inner_ref: i32        # Param.param_inner_ref / Stmt.var_inner_ref (AGAST #2399)
    # T of the `[N]T` a `*[N]T` / `@[N]T` / `@&[N]T` points at, whether or not
    # it has a `p#` view (ref_behind); the view's is sema_view_elem's.
    arr_elem: i32
    # The `q#` view's T when emit_var_decl's inference makes an un-annotated
    # `let q = h(p)` a `*[N]T` (infer_array_ptr_let), which index_elem, from
    # what's written, can't know; TYPE_VOID otherwise (AGAST #4011).
    infer_view: i32
    caller_place: i32     # LocalVar.is_caller_place (ref_mark_params)
    # LocalVar.ref_root* (AGAST #2340): the local root this binding definitely
    # refers to, how many loops it was declared in, and what it points at.
    root: *u8
    root_len: i32
    root_loops: i32
    root_pointee: i32
    root_name: *u8
    root_name_len: i32
    # AGAST #4011: the LocalVar the emitter will make for this binding, as far
    # as ref_check's typing reads it (ref_local_in); has_loc 0 when none is.
    has_loc: i32
    loc: LocalVar
    # The fn type a declared local or a param holds (LocalVar.fn_sig, which
    # emit_call calls through); has_fn 0 when no hook made it.
    fn_sig: *FnDef
    has_fn: i32

var RS_NOTES: *RsNote = null
var RS_NOTE_CAP: i32 = 0

# The note on `v`, a binding in Sema's scope; null if none was made for it.
pub fn rs_note(sm: *Sema, v: *SemaVar) -> *RsNote
    if v == null
        return null
    let i: i32 = ((v as i64 - sm.scope as i64) / sizeof(SemaVar)) as i32
    if i < 0 or i >= RS_NOTE_CAP
        return null
    let n: *RsNote = RS_NOTES + i
    if n.name != v.name
        return null
    n

# A fresh note on `v`, the binding just made.
pub fn rs_note_new(sm: *Sema, v: *SemaVar) -> *RsNote
    let i: i32 = ((v as i64 - sm.scope as i64) / sizeof(SemaVar)) as i32
    if i >= RS_NOTE_CAP
        let cap: i32 = i * 2 + 16
        let grown: *RsNote = malloc((cap as i64) * sizeof(RsNote)) as *RsNote
        memset(grown as *u8, 0, (cap as i64) * sizeof(RsNote))
        if RS_NOTES != null
            memcpy(grown as *u8, RS_NOTES as *u8, (RS_NOTE_CAP as i64) * sizeof(RsNote))
            free(RS_NOTES as *u8)
        RS_NOTES = grown
        RS_NOTE_CAP = cap
    let n: *RsNote = RS_NOTES + i
    memset(n as *u8, 0, sizeof(RsNote))
    n.name = v.name
    n.ref_kind = TYPE_VOID
    n.arr_elem = TYPE_VOID
    n.infer_view = TYPE_VOID
    n.root_pointee = TYPE_VOID
    n

# A fn begins: no note is for any of its bindings yet.
pub fn rs_notes_clear()
    if RS_NOTES != null
        memset(RS_NOTES as *u8, 0, (RS_NOTE_CAP as i64) * sizeof(RsNote))

# The field `e` (EXPR_MEMBER) names.
fn ref_field_in(env: *RefEnv, e: *Expr) -> *StructField
    if env.s != null
        return resolve_member_chain_field(env.s, e)
    rs_field(env.sm, e)

# The fn a call or method `e` calls, as ref_view's of_fn asks.
fn ref_call_def_in(env: *RefEnv, e: *Expr) -> *FnDef
    if e.kind == EXPR_METHOD
        if env.s != null
            return ref_method_def(env.s, e)
        return rs_method_def(env.sm, e)
    if env.s != null
        return find_call_fn(env.s, e)
    sema_call_fn(env.sm, e)

# A step `p[i]` that reads through a pointer to an array, a Vec, Span or
# String: its element's kind.  TYPE_VOID when `e` isn't one (index_through).
fn ref_through_kind_in(env: *RefEnv, e: *Expr) -> i32
    if env.s != null
        let through: *LocalVar = index_through(env.s, e)
        if through == null
            return TYPE_VOID
        return through_elem_kind(env.s, through)
    rs_through_kind(env.sm, e)

# What a write meets in `*r` with `r: @@S` or `*@&S`, held as an `@*S` / `**S`
# (AGAST #2399): the `@S` / `@&S` the nearest level was, else 0.
fn ref_deref_ref_in(env: *RefEnv, r: *Expr) -> i32
    if r.kind != EXPR_IDENT
        return 0
    if env.s != null
        let dl: i32 = find_local_idx(env.s, r.ident_ptr, r.ident_len)
        if dl < 0 or local_struct_levels(local_at(env.s, dl)) != 2
            return 0
        return local_at(env.s, dl).inner_ref
    let v: *SemaVar = sema_find_local(env.sm, r.ident_ptr, r.ident_len)
    if v == null or v.lent != null or rs_levels(v) != 2
        return 0
    let n: *RsNote = rs_note(env.sm, v)
    if n == null
        return 0
    n.inner_ref

# --- Sema's side: types of a place's steps -----------------------------------------
#
# ref_ty_of's answer from Sema's scope (ref_ty_in's Sema side; ref_loan.ritz's
# loans read it too, AGAST #3506): a step's kind (TYPE_*), the struct it is or
# points at (name), and an array's element kind (pointee).  0 when Sema can't
# say.

pub fn rs_set(out: *SemaTy, kind: i32, pointee: i32, name: *u8, len: i32) -> i32
    out.kind = kind
    out.pointee = pointee
    out.name = name
    out.name_len = len
    out.fn_sig = null
    out.shape = null
    1

pub fn rs_local(sm: *Sema, v: *SemaVar, out: *SemaTy) -> i32
    let n: *RsNote = rs_note(sm, v)
    if n != null and n.ref_kind != TYPE_VOID
        return rs_set(out, n.ref_kind, n.ref_pointee, n.ref_name, n.ref_name_len)
    let p: *Param = v.lent
    if p != null and p.param_type == TYPE_MUT_REF
        # `c:& C` (and a free fn's `self:& C`) reads as a `C` (§13.4).
        return rs_set(out, p.param_pointee_type, TYPE_VOID, p.param_type_name, p.param_type_name_len)
    var kind: i32 = v.let_kind
    if kind == TYPE_UNKNOWN or kind == TYPE_PTR_PTR
        return 0
    if kind == TYPE_ARRAY
        var elem: i32 = v.let_elem
        if elem == TYPE_VOID
            elem = v.index_elem
        sema_arr_ty(out, elem, v.let_name, v.let_name_len, v.shape)
        return 1
    if ref_is_pointer(kind) == 1
        return rs_set(out, kind, v.let_pointee, v.let_name, v.let_name_len)
    rs_set(out, kind, TYPE_VOID, v.let_name, v.let_name_len)

pub fn rs_ident(sm: *Sema, name: *u8, len: i32, out: *SemaTy) -> i32
    let v: *SemaVar = sema_find_local(sm, name, len)
    if v != null
        return rs_local(sm, v, out)
    let g: *GlobalVarDef = sbk_global(sm, name, len)
    if g == null or g.var_type == TYPE_PTR_PTR
        return 0
    if ref_is_pointer(g.var_type) == 1
        return rs_set(out, g.var_type, g.pointee_type, g.pointee_type_name, g.pointee_type_name_len)
    if g.var_type == TYPE_ARRAY
        sema_arr_ty(out, g.array_elem_type, g.array_elem_type_name, g.array_elem_type_name_len, g.array_shape)
        return 1
    rs_set(out, g.var_type, TYPE_VOID, g.type_name, g.type_name_len)

# What fn `f` returns, as ref_check's ref_of_fn has it.
pub fn rs_fn(f: *FnDef, out: *SemaTy) -> i32
    if f == null or f.return_type == TYPE_VOID
        return 0
    if f.ret_ref != null
        let r: *Param = f.ret_ref
        if r.param_type == TYPE_PTR_PTR or r.param_type == TYPE_ARRAY
            return 0
        return rs_set(out, r.param_type, r.param_pointee_type, r.param_type_name, r.param_type_name_len)
    if f.ret_array != null
        sema_arr_ty(out, f.ret_array.elem, f.ret_array.name, f.ret_array.name_len, f.ret_array.shape)
        return 1
    if f.return_type == TYPE_PTR or f.return_type == TYPE_PTR_PTR
        if f.return_type_name_len > 0 and f.return_type == TYPE_PTR
            return rs_set(out, TYPE_PTR, TYPE_STRUCT, f.return_type_name, f.return_type_name_len)
        return 0
    rs_set(out, f.return_type, TYPE_VOID, f.return_type_name, f.return_type_name_len)

pub fn rs_call_fn(sm: *Sema, e: *Expr) -> *FnDef
    if e.func_name_len > 0 and e.call_type_suffix_len == 0
        let v: *SemaVar = sema_find_local(sm, e.func_name, e.func_name_len)
        if v != null
            return v.fn_sig
    sema_call_fn(sm, e)

# The field `e` (EXPR_MEMBER) names, on its base's struct or what it points at.
pub fn rs_field(sm: *Sema, e: *Expr) -> *StructField
    var b: SemaTy
    if rs_ty(sm, e.left, @b) == 0
        return null
    if b.kind != TYPE_STRUCT and (ref_is_pointer(b.kind) == 0 or b.pointee != TYPE_STRUCT)
        return null
    let st: *StructDef = sema_find_struct(sm, b.name, b.name_len)
    if st == null
        return null
    let idx: i32 = find_field_index(st, e.ident_ptr, e.ident_len)
    if idx < 0
        return null
    get_field_type(st, idx)

pub fn rs_of_field(f: *StructField, out: *SemaTy) -> i32
    let t: i32 = lowered_field_type(f)   # Sema runs before lower_ref_fields
    if ref_is_pointer(t) == 1
        var pointee: i32 = f.ptr_pointee
        if pointee == TYPE_VOID and f.field_type_name_len > 0
            pointee = TYPE_STRUCT
        return rs_set(out, t, pointee, f.field_type_name, f.field_type_name_len)
    if t == TYPE_ARRAY
        sema_arr_ty(out, f.array_elem_type, f.array_elem_type_name, f.array_elem_type_name_len, f.array_shape)
        return 1
    if t == TYPE_PTR_PTR
        return 0
    rs_set(out, t, TYPE_VOID, f.field_type_name, f.field_type_name_len)

pub fn rs_ty(sm: *Sema, e: *Expr, out: *SemaTy) -> i32
    if e == null
        return 0
    let k: i32 = e.kind
    if k == EXPR_IDENT
        return rs_ident(sm, e.ident_ptr, e.ident_len, out)
    if k == EXPR_STRING_LIT
        return rs_set(out, TYPE_STRUCT, TYPE_VOID, c"StrView", 7)
    if k == EXPR_MEMBER
        let f: *StructField = rs_field(sm, e)
        if f == null
            return 0
        return rs_of_field(f, out)
    if k == EXPR_INDEX
        if e.right != null and e.right.kind == EXPR_RANGE
            return 0
        var b: SemaTy
        if rs_ty(sm, e.left, @b) == 0
            return 0
        if b.kind == TYPE_ARRAY
            # Sema's element step: an N-D array's row, else its element.
            return (sema_arr_elem(@b, out) != TYPE_UNKNOWN) as i32
        if ref_is_pointer(b.kind) == 1
            if b.pointee == TYPE_VOID or ref_is_pointer(b.pointee) == 1 or b.pointee == TYPE_ARRAY or b.pointee == TYPE_PTR_PTR
                return 0
            return rs_set(out, b.pointee, TYPE_VOID, b.name, b.name_len)
        return 0
    if k == EXPR_UNARY and e.op == OP_DEREF
        var o: SemaTy
        if rs_ty(sm, e.operand, @o) == 0
            return 0
        if ref_is_pointer(o.kind) == 0
            *out = o
            return 1
        if o.pointee == TYPE_ARRAY
            return rs_behind(sm, e.operand, @o, out)
        if o.pointee == TYPE_VOID or ref_is_pointer(o.pointee) == 1 or o.pointee == TYPE_PTR_PTR
            return 0
        return rs_set(out, o.pointee, TYPE_VOID, o.name, o.name_len)
    if k == EXPR_UNARY and (e.op == OP_ADDR or e.op == OP_ADDR_MUT)
        var a: SemaTy
        if rs_ty(sm, e.operand, @a) == 0
            return 0
        if ref_is_pointer(a.kind) == 1
            return rs_set(out, TYPE_PTR, TYPE_PTR, a.name, a.name_len)
        return rs_set(out, TYPE_PTR, a.kind, a.name, a.name_len)
    if k == EXPR_CALL
        return rs_fn(rs_call_fn(sm, e), out)
    if k == EXPR_METHOD
        return rs_fn(rs_method_def(sm, e), out)
    if k == EXPR_BINARY
        var l: SemaTy
        if rs_ty(sm, e.left, @l) == 1 and ref_is_pointer(l.kind) == 1
            return rs_set(out, l.kind, l.pointee, l.name, l.name_len)
        return 0
    if k == EXPR_CAST and e.op == TYPE_PTR
        return rs_set(out, TYPE_PTR, e.int_val as i32, e.ident_ptr, e.ident_len)
    # AGAST #4058: and `as @S` / `as @&S`, whose pointee the parser keeps too
    # (#3443, #3757): `p as @S` is an `@S` whatever `p` was, so a write through
    # it, `(p as @S).f = v` or `.arr[i] = v`, is through an `@T`, as ritz0 says.
    if k == EXPR_CAST and (e.op == TYPE_REF or e.op == TYPE_MUT_REF) and e.int_val as i32 != TYPE_VOID
        return rs_set(out, e.op, e.int_val as i32, e.ident_ptr, e.ident_len)
    0

# The element of the instantiated `Vec$T` `v`, from its `data: *T` field: a
# struct, or an integer its name spells.  0 otherwise.
pub fn rs_vec_elem(sm: *Sema, v: *SemaTy, out: *SemaTy) -> i32
    if v.name_len <= 4 or *v.name != 'V' or *(v.name + 1) != 'e' or *(v.name + 2) != 'c' or *(v.name + 3) != '$'
        return 0
    let vec_st: *StructDef = sema_find_struct(sm, v.name, v.name_len)
    if vec_st == null
        return 0
    let di: i32 = find_field_index(vec_st, c"data", 4)
    if di < 0
        return 0
    let data: *StructField = get_field_type(vec_st, di)
    if data.field_type != TYPE_PTR or data.field_type_name_len <= 0
        return 0
    if sema_find_struct(sm, data.field_type_name, data.field_type_name_len) != null
        return rs_set(out, TYPE_STRUCT, TYPE_VOID, data.field_type_name, data.field_type_name_len)
    let k: i32 = primitive_type_from_name(v.name + 4, v.name_len - 4)
    if sema_is_int_kind(k) == 0
        return 0
    rs_set(out, k, TYPE_VOID, null, 0)

# rs_ty, also through a Vec's element (`vs[1].a`), for the steps of a place.
# As ritz0's MoveChecker._loan_type.
pub fn rs_loan_ty(sm: *Sema, e: *Expr, out: *SemaTy) -> i32
    if e.kind == EXPR_INDEX or e.kind == EXPR_MEMBER
        var b: SemaTy
        if rs_loan_ty(sm, e.left, @b) == 1 and b.kind == TYPE_STRUCT
            if e.kind == EXPR_INDEX
                if rs_vec_elem(sm, @b, out) == 1
                    return 1
            else
                let st: *StructDef = sema_find_struct(sm, b.name, b.name_len)
                if st != null
                    let fi: i32 = find_field_index(st, e.ident_ptr, e.ident_len)
                    if fi >= 0
                        return rs_of_field(get_field_type(st, fi), out)
    rs_ty(sm, e, out)

# The method `e` (EXPR_METHOD) calls, on its receiver's own type, as
# ref_check's ref_method_def: an element of a Vec is its element's (AGAST
# #2443).  Else bool_check's resolution, which also knows a static call.
pub fn rs_method_def(sm: *Sema, e: *Expr) -> *FnDef
    # An element through, `p[i].m()`, is the element's type (index_through_struct).
    var en: *u8 = null
    var el: i32 = 0
    if rs_through_struct(sm, e.left, @en, @el) == 1
        if en == null
            return null
        return sema_method_fn(sm, en, el, e.ident_ptr, e.ident_len)
    var t: SemaTy
    if e.left != null and rs_loan_ty(sm, e.left, @t) == 1 and t.name_len > 0
        return sema_method_fn(sm, t.name, t.name_len, e.ident_ptr, e.ident_len)
    sbk_method_def(sm, e)

# The `[N]T` behind `e`, a local `*[N]T`, `@[N]T` or `@&[N]T` of type `o`, as
# ref_behind reads it; 0 for any other pointer: only a local keeps the element.
fn rs_behind(sm: *Sema, e: *Expr, o: *SemaTy, out: *SemaTy) -> i32
    if e.kind != EXPR_IDENT
        return 0
    let n: *RsNote = rs_note(sm, sema_find_local(sm, e.ident_ptr, e.ident_len))
    if n == null or n.arr_elem == TYPE_VOID
        return 0
    rs_set(out, TYPE_ARRAY, n.arr_elem, o.name, o.name_len)

# index_through_struct on Sema: 1 when `e` is `p[i]` through a Vec, Span or
# String (or a pointer to one), with the element's struct name in *name (null
# for a scalar element); 0 when `e` isn't one.
fn rs_through_struct(sm: *Sema, e: *Expr, name: **u8, len: *i32) -> i32
    if e == null or e.kind != EXPR_INDEX or e.right == null or e.right.kind == EXPR_RANGE or e.left == null
        return 0
    let lk: i32 = e.left.kind
    if lk != EXPR_IDENT and lk != EXPR_MEMBER and (lk != EXPR_UNARY or e.left.op != OP_DEREF)
        return 0
    var t: SemaTy
    if rs_ty(sm, e.left, @t) == 0
        return 0
    if e.left.kind == EXPR_IDENT and t.kind != TYPE_STRUCT and (ref_is_pointer(t.kind) == 0 or t.pointee != TYPE_STRUCT)
        return 0
    var k: i32 = TYPE_VOID
    var n: *u8 = null
    var l: i32 = 0
    if let_through_elem(sm, t.kind, t.pointee, t.name, t.name_len, @k, @n, @l) == 0
        return 0
    *name = null
    *len = 0
    if k == TYPE_STRUCT or k == TYPE_PTR
        *name = n
        *len = l
    1

# local_struct_levels for a Sema binding, which ref_deref_ref_in asks about 2.
fn rs_levels(v: *SemaVar) -> i32
    if v.kind == TYPE_PTR_PTR
        return ptr_ptr_ident_levels(v.inner)
    if v.kind == TYPE_REF or v.kind == TYPE_MUT_REF
        if v.pointee == TYPE_PTR
            return 2
        if v.pointee == TYPE_PTR_PTR
            return 1 + ptr_ptr_ident_levels(v.inner)
        return 1
    if v.kind == TYPE_PTR
        return 1
    0

# The element kind of a Vec, Span or String `t` is or points at; else TYPE_VOID.
fn rs_buffer_kind(sm: *Sema, t: *SemaTy) -> i32
    var k: i32 = TYPE_VOID
    var n: *u8 = null
    var l: i32 = 0
    if let_through_elem(sm, t.kind, t.pointee, t.name, t.name_len, @k, @n, @l) == 0
        return TYPE_VOID
    k

# index_through's question on Sema: the element kind when `e`, `p[i]` or
# `(*p)[i]`, reads through a Vec, Span or String (or a pointer to one), a field
# that is one, or a `*[N]T` local's `p#` view; else TYPE_VOID.
pub fn rs_through_kind(sm: *Sema, e: *Expr) -> i32
    if e.kind != EXPR_INDEX or e.right == null or e.right.kind == EXPR_RANGE or e.left == null
        return TYPE_VOID
    if e.left.kind == EXPR_INDEX
        return TYPE_VOID
    var root: *Expr = e.left
    if root.kind == EXPR_UNARY and root.op == OP_DEREF
        root = root.operand
    if root == null
        return TYPE_VOID
    var t: SemaTy
    if root.kind != EXPR_IDENT
        # `x.vf[i]`, a field that is a Vec, Span or String or points at one (#2564).
        if root == e.left and root.kind == EXPR_MEMBER and rs_ty(sm, root, @t) == 1
            let bk: i32 = rs_buffer_kind(sm, @t)
            if bk != TYPE_VOID
                return bk
        return rs_base_array_kind(sm, root)
    let v: *SemaVar = sema_find_local(sm, root.ident_ptr, root.ident_len)
    if v == null
        return TYPE_VOID
    let n: *RsNote = rs_note(sm, v)
    if n != null and n.infer_view != TYPE_VOID
        return n.infer_view
    if rs_ty(sm, root, @t) == 0
        return TYPE_VOID
    # `v[i]` on the value itself, but not `(*v)[i]`.
    if t.kind == TYPE_STRUCT
        if root != e.left
            return TYPE_VOID
        return rs_buffer_kind(sm, @t)
    if ref_is_pointer(t.kind) == 1 and t.pointee == TYPE_ARRAY
        return sema_view_elem(sm, v)
    if ref_is_pointer(t.kind) == 1 and t.pointee == TYPE_STRUCT
        return rs_buffer_kind(sm, @t)
    TYPE_VOID

# base_array_view on Sema (AGAST #4011): the element kind of the `*[N]T` that
# `root`, a field, a global or a call, holds (`h.r[i]`, `g[i]`, `h(p)[i]`, #2329);
# TYPE_VOID when it holds none, or T gets no view.
fn rs_base_array_kind(sm: *Sema, root: *Expr) -> i32
    var pa: *Param = null
    if root.kind == EXPR_MEMBER
        let f: *StructField = rs_field(sm, root)
        if f != null
            pa = f.ptr_array
    else if root.kind == EXPR_IDENT
        if sema_find_local(sm, root.ident_ptr, root.ident_len) != null
            return TYPE_VOID
        let g: *GlobalVarDef = sbk_global(sm, root.ident_ptr, root.ident_len)
        if g != null
            pa = g.ptr_array
    else if root.kind == EXPR_CALL
        let fd: *FnDef = rs_call_fn(sm, root)
        if fd != null
            pa = fd.ret_ptr_array
    if pa == null or pa.param_pointee_array_size <= 0
        return TYPE_VOID
    if sx_view_elem_ok(sm, pa.param_pointee_array_elem_type, pa.param_type_name, pa.param_type_name_len) == 0
        return TYPE_VOID
    pa.param_pointee_array_elem_type

# `<file>:<line>:<col>: error: `, the prefix of every ref_check error, in
# that file (AGAST #3621: through diag, as every ritz1 error is).  AGAST #2516:
# the fn being emitted owns the line, and an instance of an imported generic
# (span.ritz's span_get<T>) carries its module's def_file.
fn ref_error_at(line: i32, col: i32)
    diag_error_at(fn_source_file(emitter_current_fn()), diag_span(line, col))

# 1 the first time this place is reported (ref_array_error).
pub fn ref_first_report(line: i32, col: i32) -> i32
    if line == REF_LAST_LINE and col == REF_LAST_COL
        return 0
    REF_LAST_LINE = line
    REF_LAST_COL = col
    1

# `e` is a non-literal array of another element type than its slot's, which
# Sema's slot checks (ref_value.ritz) couldn't name.
pub fn ref_array_error(s: *EmitterState, e: *Expr)
    if ref_first_report(e.span.line, e.span.col) == 0
        return
    ref_error_at(e.span.line, e.span.col)
    eprints_cstr(c"an array only fits a slot of the same element type: write a loop to convert it\n")
    s.error_count = s.error_count + 1

# `a`, a pointer kind, points at what `slot` holds.
pub fn ref_same_pointee(a: *RefTy, slot: *RefTy) -> i32
    if a.pointee != slot.kind
        return 0
    if slot.kind != TYPE_STRUCT
        return 1
    if a.name_len == 0 or slot.name_len == 0
        return 0
    name_eq(a.name, a.name_len, slot.name, slot.name_len)

# A call's by-value result is a temporary, not a place (Aaron's ruling on
# AGAST #2518, LARB review 4): ref_value.ritz's checks, and ownership.ritz's
# lending of one to a call, ask this.
# The call (EXPR_CALL / EXPR_METHOD) whose by-value struct or array result
# `e` is, or is a field or element of; null when `e` is a place.  A step
# through a pointer (`mkp().x`, a `*T` field, `v[i]` of a Vec) reaches one.
pub fn ref_temp_call(s: *EmitterState, e: *Expr) -> *Expr
    var env: RefEnv
    ref_temp_call_in(ref_env_of(@env, s, null), e)

pub fn ref_temp_call_in(env: *RefEnv, e: *Expr) -> *Expr
    var r: *Expr = e
    while r != null and (r.kind == EXPR_MEMBER or r.kind == EXPR_INDEX)
        if r.kind == EXPR_INDEX
            if r.right != null and r.right.kind == EXPR_RANGE
                return null
            if ref_is_through_in(env, r) == 1
                return null
        var t: RefTy
        if ref_ty_in(env, r.left, @t) == 0
            return null
        if t.kind != TYPE_STRUCT and t.kind != TYPE_ARRAY
            return null
        r = r.left
    if r == null or (r.kind != EXPR_CALL and r.kind != EXPR_METHOD)
        return null
    var rt: RefTy
    if ref_ty_in(env, r, @rt) == 0
        return null
    if rt.kind != TYPE_STRUCT and rt.kind != TYPE_ARRAY
        return null
    r

# 1 when `e`, `p[i]`, reads through a pointer to an array, a Vec, Span or
# String (index_through), not a place in `p` itself.
pub fn ref_is_through_in(env: *RefEnv, e: *Expr) -> i32
    if env.s != null
        return (index_through(env.s, e) != null) as i32
    (rs_through_kind(env.sm, e) != TYPE_VOID) as i32

# `r as C` with `r: @C`, `@&C` or `*C` (AGAST #3004): 1 when the cast reads the
# referent, as ritz0 does, so the emitter loads a `%C` copy through `r` and
# resolve_expr_struct_name types it `%C`.  The move-only C was refused above.
# A target other than the referent is left as it was: neither compiler defines
# a struct-to-struct `as` (AGAST #3012).
pub fn ref_cast_reads_referent(s: *EmitterState, e: *Expr) -> i32
    if e.kind != EXPR_CAST or e.op != TYPE_STRUCT or e.ident_len == 0
        return 0
    var a: RefTy
    if ref_ty_of(s, e.left, @a) == 0 or ref_is_pointer(a.kind) == 0
        return 0
    var target: RefTy
    ref_set(@target, TYPE_STRUCT, 0, e.ident_ptr, e.ident_len)
    ref_same_pointee(@a, @target)

# A fn's body is about to be emitted, its params bound.
pub fn ref_begin_fn(s: *EmitterState, f: *FnDef)
    REF_LAST_LINE = 0
    REF_LAST_COL = 0
    ref_mark_params(s, f.params)

# AGAST #2364: U for a local declared `@*U` / `@&*U`; TYPE_VOID otherwise.
pub fn ref_decl_ptr_pointee(stmt: *Stmt) -> i32
    if stmt.var_ref == null or stmt.var_pointee_type != TYPE_PTR
        return TYPE_VOID
    stmt.var_ref.param_ref_ptr_pointee

# `@T` is read-only (LANGUAGE_SPEC §3.2, §13.3, LARB ruling R1, AGAST #2338).
# ritz0's twins are TypeChecker._check_write and _check_let_into_mut, and
# ritz0/test_at_is_read_only.py holds all three compilers to them.

# What a write meets when it goes through a value.
pub const REF_VIEW_VALUE: i32 = 0
pub const REF_VIEW_RAW: i32 = 1
pub const REF_VIEW_MUT: i32 = 2
pub const REF_VIEW_SHARED: i32 = 3
pub const REF_VIEW_UNKNOWN: i32 = 4

fn ref_view_of_kind(kind: i32) -> i32
    if kind == TYPE_REF
        return REF_VIEW_SHARED
    if kind == TYPE_MUT_REF
        return REF_VIEW_MUT
    if kind == TYPE_PTR or kind == TYPE_PTR_PTR
        return REF_VIEW_RAW
    REF_VIEW_VALUE

fn ref_view_of_ident(env: *RefEnv, name: *u8, len: i32) -> i32
    if env.s != null
        let idx: i32 = find_local_idx(env.s, name, len)
        if idx >= 0
            let loc: *LocalVar = local_at(env.s, idx)
            # `c:& C` is a `C`, and so is a by-value `self`.
            if loc.is_lent == 1 or loc.holds_lent_ptr == 1
                return REF_VIEW_VALUE
            return ref_view_of_kind(loc.var_type)
        let g: *GlobalVarDef = find_global(env.s, name, len)
        if g == null
            return REF_VIEW_UNKNOWN
        return ref_view_of_kind(g.var_type)
    let v: *SemaVar = sema_find_local(env.sm, name, len)
    if v != null
        if v.lent != null
            return REF_VIEW_VALUE
        let n: *RsNote = rs_note(env.sm, v)
        if n != null and n.ref_kind != TYPE_VOID
            return ref_view_of_kind(n.ref_kind)
        return ref_view_of_kind(v.kind)
    let sg: *GlobalVarDef = sbk_global(env.sm, name, len)
    if sg == null
        return REF_VIEW_UNKNOWN
    ref_view_of_kind(sg.var_type)

fn ref_view_of_fn(f: *FnDef) -> i32
    var t: RefTy
    if ref_of_fn(f, @t) == 0
        return REF_VIEW_UNKNOWN
    ref_view_of_kind(t.kind)

# What the value of `e` is, as far as a write through it goes.  An `@T` field is a
# `*T` by now (lower_ref_fields), and only its flag says otherwise.
pub fn ref_view(s: *EmitterState, e: *Expr) -> i32
    var env: RefEnv
    ref_view_in(ref_env_of(@env, s, null), e)

pub fn ref_view_in(env: *RefEnv, e: *Expr) -> i32
    if e == null
        return REF_VIEW_UNKNOWN
    let k: i32 = e.kind
    if k == EXPR_IDENT
        return ref_view_of_ident(env, e.ident_ptr, e.ident_len)
    if k == EXPR_UNARY and e.op == OP_ADDR
        return REF_VIEW_SHARED
    if k == EXPR_UNARY and e.op == OP_ADDR_MUT
        return REF_VIEW_MUT
    # #4162: `p as @C` is an `@C` whatever `p` was.  ref_ty_of only types `as *T`,
    # so on the emitter it read as unknown and fit an `@&T` slot.  An `as @&C` needs
    # no case: unknown and mutable both let it into one.
    if k == EXPR_CAST and e.op == TYPE_REF
        return REF_VIEW_SHARED
    if k == EXPR_MEMBER
        let f: *StructField = ref_field_in(env, e)
        if f == null
            return REF_VIEW_UNKNOWN
        if f.field_shared_ref == 1
            return REF_VIEW_SHARED
        if f.field_mut_ref == 1
            return REF_VIEW_MUT
        return ref_view_of_kind(lowered_field_type(f))
    if k == EXPR_CALL or k == EXPR_METHOD
        return ref_view_of_fn(ref_call_def_in(env, e))
    if k == EXPR_INDEX
        # An element through, `p[i]` or `(*p)[i]`, is its own kind: a `*S` one is the
        # pointer's business, anything else is a place in what `p` reaches (#2443).
        let through: i32 = ref_through_kind_in(env, e)
        if through != TYPE_VOID
            return ref_view_of_kind(through)
    # AGAST #2399: `*r` with `r: @@S` or `*@&S` (held as an `@*S` / `**S`) is the
    # `@S` / `@&S` it was.
    if k == EXPR_UNARY and e.op == OP_DEREF and e.operand != null
        let nearest: i32 = ref_deref_ref_in(env, e.operand)
        if nearest == INNER_REF_SHARED
            return REF_VIEW_SHARED
        if nearest == INNER_REF_MUT
            return REF_VIEW_MUT
    var t: RefTy
    if k == EXPR_INDEX or k == EXPR_UNARY and e.op == OP_DEREF
        # What holds a pointer keeps its kind, where ref_ty_of has no pointee to give.
        var from: *Expr = e.left
        if k == EXPR_UNARY
            from = e.operand
        if ref_ty_in(env, from, @t) == 1 and ref_is_pointer(t.pointee) == 1
            return ref_view_of_kind(t.pointee)
    if ref_ty_in(env, e, @t) == 1
        return ref_view_of_kind(t.kind)
    REF_VIEW_UNKNOWN

# AGAST #2399: the reference `.` on `e` reaches the struct through last
# (INNER_REF_*): `p: @@S` or `*@S` is held as an `@*S` / `**S`, whose kind says
# the nearest level is a `*`.
fn ref_inner_ref(env: *RefEnv, e: *Expr) -> i32
    if e.kind == EXPR_IDENT
        if env.s != null
            let idx: i32 = find_local_idx(env.s, e.ident_ptr, e.ident_len)
            if idx >= 0
                return local_at(env.s, idx).inner_ref
            let g: *GlobalVarDef = find_global(env.s, e.ident_ptr, e.ident_len)
            if g != null
                return g.inner_ref
            return 0
        let v: *SemaVar = sema_find_local(env.sm, e.ident_ptr, e.ident_len)
        if v != null
            let n: *RsNote = rs_note(env.sm, v)
            if n == null
                return 0
            return n.inner_ref
        let sg: *GlobalVarDef = sbk_global(env.sm, e.ident_ptr, e.ident_len)
        if sg != null
            return sg.inner_ref
        return 0
    if e.kind == EXPR_MEMBER
        let f: *StructField = ref_field_in(env, e)
        if f != null
            return f.field_inner_ref
    0

# The kind of the field `e` names, or TYPE_VOID.
fn ref_field_kind(env: *RefEnv, e: *Expr) -> i32
    if e.kind != EXPR_MEMBER
        return TYPE_VOID
    let f: *StructField = ref_field_in(env, e)
    if f == null
        return TYPE_VOID
    lowered_field_type(f)

# 1 when writing the place `e` goes through an `@T`.  Walk it from the place to
# its root: a `*T` ends the walk, since what it points at is the pointer's
# business, and so does anything the tables can't type.
pub fn ref_write_is_shared(s: *EmitterState, e0: *Expr) -> i32
    var env: RefEnv
    ref_write_is_shared_in(ref_env_of(@env, s, null), e0)

pub fn ref_write_is_shared_in(env: *RefEnv, e0: *Expr) -> i32
    var e: *Expr = e0
    while e != null
        var base: *Expr = null
        if e.kind == EXPR_MEMBER or e.kind == EXPR_INDEX
            base = e.left
        else if e.kind == EXPR_UNARY and e.op == OP_DEREF
            base = e.operand
        else
            return 0
        if e.kind == EXPR_MEMBER and ref_inner_ref(env, base) == INNER_REF_SHARED
            return 1
        let view: i32 = ref_view_in(env, base)
        var t: RefTy
        let known: i32 = ref_ty_in(env, base, @t)
        if view == REF_VIEW_SHARED
            # `.` reads through every level, so the one nearest the place counts.
            if e.kind == EXPR_MEMBER and known == 1 and (t.pointee == TYPE_PTR or t.pointee == TYPE_PTR_PTR)
                return 0
            # AGAST #2399: an `@*S` field is a `**S` by now (lower_ref_fields).
            if e.kind == EXPR_MEMBER and ref_field_kind(env, base) == TYPE_PTR_PTR
                return 0
            return 1
        if view == REF_VIEW_RAW or view == REF_VIEW_UNKNOWN
            return 0
        e = base
    0

# An `@T` doesn't become an `@&T` (LANGUAGE_SPEC §3.2, §13.3, AGAST #2374).  ritz0's
# twins are TypeChecker._check_borrow, _check_shared_into_mut and _check_receiver,
# and ritz0/test_at_into_mut.py holds all three compilers to them.

# What a `:&` param or `self:&` names is the caller's (ownership.ritz reads it).
# A by-value `self` is a local root, as any by-value param is (#2393).
fn ref_mark_params(s: *EmitterState, p0: *Param)
    var p: *Param = p0
    while p != null
        let idx: i32 = find_local_idx(s, p.name, p.name_len)
        if idx >= 0
            let loc: *LocalVar = local_at(s, idx)
            if p.is_borrow == 1 or loc.holds_lent_ptr == 1
                loc.is_caller_place = 1
            if p.param_pointee_type == TYPE_PTR
                loc.ref_ptr_pointee = p.param_ref_ptr_pointee   # AGAST #2364
        p = p.next

# After a statement is emitted: a declaration's binding exists now.
pub fn ref_after_stmt(s: *EmitterState, stmt: *Stmt)
    if stmt.kind == STMT_VAR_DECL and stmt.var_ref != null
        ref_keep_ptr_pointee(s, stmt)

# AGAST #2364: the local `stmt` declares keeps its `@&*U`'s U.
fn ref_keep_ptr_pointee(s: *EmitterState, stmt: *Stmt)
    let idx: i32 = find_local_idx(s, stmt.var_name, stmt.var_name_len)
    if idx >= 0
        local_at(s, idx).ref_ptr_pointee = ref_decl_ptr_pointee(stmt)

# `a` and `ret` point at the same type.
pub fn ref_same_referent(a: *RefTy, ret: *RefTy) -> i32
    if a.pointee != ret.pointee or a.pointee == TYPE_VOID
        return 0
    if a.pointee != TYPE_STRUCT and a.pointee != TYPE_PTR
        return 1
    if a.name_len == 0 or ret.name_len == 0
        return 0
    name_eq(a.name, a.name_len, ret.name, ret.name_len)

# The element of the instantiated `Vec$T` `v`, from its `data: *T` field (as
# emit_vec_elem_member_ptr finds it): a struct or an integer.  0 otherwise.
pub fn ref_vec_elem(s: *EmitterState, v: *RefTy, out: *RefTy) -> i32
    if v.name_len <= 4 or *v.name != 'V' or *(v.name + 1) != 'e' or *(v.name + 2) != 'c' or *(v.name + 3) != '$'
        return 0
    let vec_st: *StructDef = find_struct(s, v.name, v.name_len)
    if vec_st == null
        return 0
    let di: i32 = find_field_index(vec_st, c"data", 4)
    if di < 0
        return 0
    let data: *StructField = get_field_type(vec_st, di)
    if data.field_type != TYPE_PTR or data.field_type_name_len <= 0
        return 0
    if find_struct(s, data.field_type_name, data.field_type_name_len) != null
        return ref_set(out, TYPE_STRUCT, 0, data.field_type_name, data.field_type_name_len)
    let k: i32 = vec_name_elem_type(v.name, v.name_len)
    if k == TYPE_UNKNOWN
        return 0
    ref_set(out, k, 0, null, 0)
