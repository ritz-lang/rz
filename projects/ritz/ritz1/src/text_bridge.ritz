# The older `*u8` text APIs, read as StrViews (AGAST #4696).
#
# ritz1's emitter grew up on NUL-terminated `*u8` text and `(out_name,
# out_len)` out-parameter pairs.  A file ported to the pattern in ARCHITECTURE.md
# "Emitter style" holds its text as a StrView and does not carry either through
# its own signatures; where it must call one of those older APIs it goes through
# the adapters below, so the `*u8` shows up once, here, and not at every call
# site.  Each adapter is deleted when the API it reads is ported to return a
# StrView; this module's counts in tools/ritz1_ratchet.py go down with them.
#
# A name that was not found is `no_name()`: a StrView with a null `ptr`.

import ritzlib.strview
import ritzlib.cstr

import ast
import ast_expr_syntax   # primitive_name_from_type
import ast_helpers       # enum_name_at, enum_variant_name
import ast_query         # user_variant_ctor_enum, array_ptr_elem_name
import emitter_core

# The null StrView: "no name".
pub fn no_name() -> StrView
    StrView { ptr: null, len: 0 }

# True when `name` is `no_name()`.
pub fn unnamed(name: StrView) -> bool
    name.ptr == null

# What the `(out_name, out_len)` lookup `find` names for `e`; `no_name()` when
# it names nothing.
pub fn named_by(find: fn(*EmitterState, *Expr, **u8, *i32), s: *EmitterState, e: *Expr) -> StrView
    var name: *u8 = null
    var len: i32 = 0
    find(s, e, @name, @len)
    StrView { ptr: name, len: len as i64 }

# A C-string LLVM type spelling (`float_llvm_name`, `elem_mem_llvm`, ...) as the
# text it is; `no_name()` for a null.
pub fn llvm_text(spelling: *u8) -> StrView
    if spelling == null
        return no_name()
    strview_from_cstr(spelling)

# The spelling of primitive type `t` ("i32"); `no_name()` when it has none.
pub fn primitive_spelling(t: TypeKind) -> StrView
    llvm_text(primitive_name_from_type(t))

# A `(out_len) -> *u8` lookup's answer, as the text it is: `no_name()` for a
# null or an empty one.
fn sized_text(name: StrView) -> StrView
    if name.ptr == null or name.len <= 0
        return no_name()
    name

# tagged_enum_arg's payload type of variant `v` of the Option / Result `name`
# (`Option$Tracked`'s 0 is `Tracked`); `no_name()` when it has none.
pub fn tagged_payload(s: *EmitterState, name: StrView, v: i32) -> StrView
    var len: i32 = 0
    let arg: *u8 = tagged_enum_arg(s, name, v, @len)
    sized_text(StrView { ptr: arg, len: len as i64 })

# primitive_arg_spelling's mangling of primitive `t` (`u8`, `f64`).
pub fn primitive_arg_name(t: TypeKind) -> StrView
    var name: *u8 = null
    let len: i32 = primitive_arg_spelling(t, @name)
    sized_text(StrView { ptr: name, len: len as i64 })

# The struct the slot being emitted into names (slot_struct_name).
pub fn slot_struct(s: *EmitterState) -> StrView
    var len: i32 = 0
    let name: *u8 = slot_struct_name(s, @len)
    sized_text(StrView { ptr: name, len: len as i64 })

# The name of variant `vi` of enum `ei`.
pub fn enum_variant_label(ctx: *ParseCtx, ei: i32, vi: i32) -> StrView
    var len: i32 = 0
    let name: *u8 = enum_variant_name(ctx, ei, vi, @len)
    sized_text(StrView { ptr: name, len: len as i64 })

# The name of enum `ei`.
pub fn enum_name_view(ctx: *ParseCtx, ei: i32) -> StrView
    var len: i32 = 0
    let name: *u8 = enum_name_at(ctx, ei, @len)
    sized_text(StrView { ptr: name, len: len as i64 })

# The user enum whose variant the call `e` constructs (user_variant_ctor_enum).
pub fn user_ctor_enum(ctx: *ParseCtx, e: *Expr) -> StrView
    var name: *u8 = null
    var len: i32 = 0
    user_variant_ctor_enum(ctx, e, @name, @len)
    if name == null
        return no_name()
    StrView { ptr: name, len: len as i64 }

# The element struct a `*[N]S` local points at (array_ptr_elem_name); a
# null-ptr view when it has none, which array_src_set takes as is.
pub fn array_ptr_elem(loc: *LocalVar) -> StrView
    var len: i32 = 0
    let name: *u8 = array_ptr_elem_name(loc, @len)
    StrView { ptr: name, len: len as i64 }

# tagged_enum_payload_named's struct/enum name for the carrier side of `name`
# (`allow_enum`: also accept a user-enum payload); `no_name()` when it has none.
pub fn tagged_carrier_payload_named(s: *EmitterState, name: StrView, allow_enum: i32) -> StrView
    var len: i32 = 0
    let p: *u8 = tagged_enum_payload_named(s, name, @len, allow_enum)
    if p == null
        return no_name()
    StrView { ptr: p, len: len as i64 }

# tagged_enum_err_payload_named's struct/enum name for the Err side of `name`
# (`allow_enum`: also accept a user-enum payload); `no_name()` when it has none.
pub fn tagged_err_payload_named(s: *EmitterState, name: StrView, allow_enum: i32) -> StrView
    var len: i32 = 0
    let p: *u8 = tagged_enum_err_payload_named(s, name, @len, allow_enum)
    if p == null
        return no_name()
    StrView { ptr: p, len: len as i64 }
