# ritz1/src/emitter_ir.ritz - typed IR builders
#
# AGAST #1817.  The emitter used to write every LLVM instruction as a handful
# of raw fragments, one call per separator, register and type (AGAST #4766
# deleted that shim).  Every cast, load, store and branch was spelled out inline at each site, so
# the same widen/narrow ladder was copy-pasted 10-19 times across the emitter
# modules (the duplicate clusters ritz-metrics reported).  A change to one
# spelling meant finding every copy.
#
# This module is the one place the instruction shapes live.  A builder takes
# the output buffer, the register counter and the value registers, and
# returns the destination register exactly as the inline sequence did:
# `next_reg` is still called at the same point in the stream, so register
# numbering (and the emitted bytes) are unchanged.
#
# It is a LEAF: it imports no emitter module, so every emitter module can
# import it (AGAST #1818).  The caller passes
# `s.ir.out` and `@s.fcx.reg_counter`.
#
# `ret` deliberately has no builder: a `ret` is written through the
# EmitterState sink (format_into(s, ...)), which runs the ownership drop hook
# first (AGAST #1625, #3508).

import ritzlib.gvec
import ritzlib.string

# =============================================================================
# Casts
# =============================================================================
#
# `%.{r} = <op> <from> %.{v} to <to>` in one format_into rather than five
# fragment calls.  Each builder is specialized on its types so a call
# site carries no IR text at all.

pub fn ir_sext_i8_i64(out: *String, regs: *i32, v: i32) -> i32
    let r: i32 = *regs
    *regs = *regs + 1
    format_into(out, "  %.{r} = sext i8 %.{v} to i64\n")
    r

pub fn ir_sext_i16_i64(out: *String, regs: *i32, v: i32) -> i32
    let r: i32 = *regs
    *regs = *regs + 1
    format_into(out, "  %.{r} = sext i16 %.{v} to i64\n")
    r

pub fn ir_sext_i32_i64(out: *String, regs: *i32, v: i32) -> i32
    let r: i32 = *regs
    *regs = *regs + 1
    format_into(out, "  %.{r} = sext i32 %.{v} to i64\n")
    r

pub fn ir_zext_i1_i64(out: *String, regs: *i32, v: i32) -> i32
    let r: i32 = *regs
    *regs = *regs + 1
    format_into(out, "  %.{r} = zext i1 %.{v} to i64\n")
    r

pub fn ir_zext_i8_i64(out: *String, regs: *i32, v: i32) -> i32
    let r: i32 = *regs
    *regs = *regs + 1
    format_into(out, "  %.{r} = zext i8 %.{v} to i64\n")
    r

pub fn ir_zext_i16_i64(out: *String, regs: *i32, v: i32) -> i32
    let r: i32 = *regs
    *regs = *regs + 1
    format_into(out, "  %.{r} = zext i16 %.{v} to i64\n")
    r

pub fn ir_zext_i32_i64(out: *String, regs: *i32, v: i32) -> i32
    let r: i32 = *regs
    *regs = *regs + 1
    format_into(out, "  %.{r} = zext i32 %.{v} to i64\n")
    r

pub fn ir_trunc_i64_i1(out: *String, regs: *i32, v: i32) -> i32
    let r: i32 = *regs
    *regs = *regs + 1
    format_into(out, "  %.{r} = trunc i64 %.{v} to i1\n")
    r

pub fn ir_trunc_i64_i8(out: *String, regs: *i32, v: i32) -> i32
    let r: i32 = *regs
    *regs = *regs + 1
    format_into(out, "  %.{r} = trunc i64 %.{v} to i8\n")
    r

pub fn ir_trunc_i64_i16(out: *String, regs: *i32, v: i32) -> i32
    let r: i32 = *regs
    *regs = *regs + 1
    format_into(out, "  %.{r} = trunc i64 %.{v} to i16\n")
    r

pub fn ir_trunc_i64_i32(out: *String, regs: *i32, v: i32) -> i32
    let r: i32 = *regs
    *regs = *regs + 1
    format_into(out, "  %.{r} = trunc i64 %.{v} to i32\n")
    r

pub fn ir_inttoptr_ptr(out: *String, regs: *i32, v: i32) -> i32
    let r: i32 = *regs
    *regs = *regs + 1
    format_into(out, "  %.{r} = inttoptr i64 %.{v} to ptr\n")
    r

pub fn ir_ptrtoint_i64(out: *String, regs: *i32, v: i32) -> i32
    let r: i32 = *regs
    *regs = *regs + 1
    format_into(out, "  %.{r} = ptrtoint ptr %.{v} to i64\n")
    r

pub fn ir_fptrunc_f64_f32(out: *String, regs: *i32, v: i32) -> i32
    let r: i32 = *regs
    *regs = *regs + 1
    format_into(out, "  %.{r} = fptrunc double %.{v} to float\n")
    r

pub fn ir_fpext_f32_f64(out: *String, regs: *i32, v: i32) -> i32
    let r: i32 = *regs
    *regs = *regs + 1
    format_into(out, "  %.{r} = fpext float %.{v} to double\n")
    r

# A cast whose target type is not one of the fixed widths above: the LLVM type
# name is already text in the caller (`ptr`, a `%Struct`), never spelled out.
pub fn ir_inttoptr_to(out: *String, regs: *i32, v: i32, to_ty: StrView) -> i32
    let r: i32 = *regs
    *regs = *regs + 1
    format_into(out, "  %.{r} = inttoptr i64 %.{v} to {to_ty}\n")
    r

# =============================================================================
# Loads and stores
# =============================================================================

# `%.{r} = load <ty>, ptr %.{ptr}`.  `ty` is an LLVM type spelling already
# built by the caller (ty_value_llvm, emit_llvm_type_struct's output, ...).
pub fn ir_load(out: *String, regs: *i32, ty: StrView, ptr: i32) -> i32
    let r: i32 = *regs
    *regs = *regs + 1
    format_into(out, "  %.{r} = load {ty}, ptr %.{ptr}\n")
    r

pub fn ir_load_ptr(out: *String, regs: *i32, ptr: i32) -> i32
    let r: i32 = *regs
    *regs = *regs + 1
    format_into(out, "  %.{r} = load ptr, ptr %.{ptr}\n")
    r

pub fn ir_store(out: *String, ty: StrView, val: i32, ptr: i32)
    format_into(out, "  store {ty} %.{val}, ptr %.{ptr}\n")

pub fn ir_store_ptr(out: *String, val: i32, ptr: i32)
    format_into(out, "  store ptr %.{val}, ptr %.{ptr}\n")

# =============================================================================
# Allocation
# =============================================================================

# `%.{r} = alloca <ty>`.  `out` is wherever the caller is emitting: for a
# STATIC alloca that is the function's entry-block buffer
# (EmitterState.entry_allocas; AGAST #4460), for a dynamic one `s.ir.out`.
# Emitter_core's entry_alloca wraps this for the static case.
pub fn ir_alloca(out: *String, regs: *i32, ty: StrView) -> i32
    let r: i32 = *regs
    *regs = *regs + 1
    format_into(out, "  %.{r} = alloca {ty}\n")
    r

# As ir_alloca, for a register the SITE already allocated with next_reg: the
# same line, with no register allocated here, so a site's register numbering
# stays exactly where it was (the prefix it replaces emitted nothing else).
pub fn ir_alloca_at(out: *String, r: i32, ty: StrView)
    format_into(out, "  %.{r} = alloca {ty}\n")

# =============================================================================
# Terminators and branches
# =============================================================================

pub fn ir_br(out: *String, label: i32)
    format_into(out, "  br label %L{label}\n")

pub fn ir_cond_br(out: *String, cond: i32, then_label: i32, else_label: i32)
    format_into(out, "  br i1 %.{cond}, label %L{then_label}, label %L{else_label}\n")

# `%.{r} = phi <ty> [ %.{v}, %L{from} ], ...` is built by the caller: the
# incoming list has a variable length.  The prefix and each entry are here.
pub fn ir_phi_start(out: *String, r: i32, ty: StrView)
    format_into(out, "  %.{r} = phi {ty} [ ")

pub fn ir_phi_entry(out: *String, v: i32, from_label: i32, first: i32)
    if first == 0
        format_into(out, ", [ %.{v}, %L{from_label} ]")
    else
        format_into(out, "[ %.{v}, %L{from_label} ]")

pub fn ir_phi_done(out: *String)
    format_into(out, "\n")
