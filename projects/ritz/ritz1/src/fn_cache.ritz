# ritz1/src/fn_cache.ritz
#
# ritz1's compilation cache: one sig file per source, holding a snapshot of
# the module's emitted IR plus everything that snapshot depends on.
#
# File-level fast path — `check_source_unchanged()` is consulted by
# `main.ritz` before any work is done.  It skips the compile only when ALL of
# these still hold for the sig written by the last compile:
#
#   * `source_hash`   — FNV1a-64 of this source file;
#   * `compiler_hash` — this binary, the target OS and the import search path
#                       (`cache_fingerprint()`; AGAST #1279, #1550, #1807);
#   * `import_hashes` — FNV1a-64 of every file the source transitively
#                       imports, keyed by canonical path (AGAST #1807).
#
# The last one matters because a module's IR bakes in every imported struct
# layout (field offsets, GEP indices), constant and signature: before #1807 a
# struct change in an imported module left the importer's cached IR reading
# fields at their old offsets.  ritz0 closed the same hole in #1674.
#
# Where the sig lives (AGAST #1807, absorbing #1280):
#
#   <cache root>/<compiler>/<canonical source path>.sig
#
#   cache root  $RITZ_CACHE_DIR, else $XDG_CACHE_HOME/ritz, else
#               $HOME/.cache/ritz, else /tmp/ritz-cache
#   compiler    basename of this binary ("ritz1", "ritz1_selfhosted")
#
# It used to be `<src>.ritz.sig`, beside the source and shared with ritz0 and
# ritz1_selfhosted, each writing its own schema over the others' — every
# compiler boundary in a gate threw the cache away.  ritz0 uses the same
# mapping with compiler "ritz0" (ritz0/emitter/fn_cache.py:sig_path_for).
#
# Sig format (JSON):
#   {
#     "source_hash":   "<16 hex>",
#     "compiler_hash": "<16 hex>",
#     "module_ir":     "<the whole emitted .ll>" | null,
#     "import_hashes": {"<canonical path>": "<16 hex>", ...}
#   }
#
# There used to be a per-function cache here too (`lookup_fn_ir` /
# `cache_fn_ir`, a port of ritz0's).  Nothing ever called it, and #1807
# deleted it rather than wire it up: the whole-module snapshot already makes
# a no-change rebuild free, while splicing individual functions would need
# the same import invalidation per function *plus* a replay of everything
# `emit_fn` contributes beyond its body (string constants, extern declares,
# monomorph instantiations) — a new feature with its own staleness risks,
# not a cache fix.

import ritzlib.sys
import ritzlib.io
import ritzlib.str
import ritzlib.string
import ritzlib.strview
import ritzlib.gvec
import ritzlib.memory
import ritzlib.hash
import ritzlib.json
import ritzlib.os.env


# ============================================================================
# Hashing primitives
# ============================================================================

# FNV1a-64 hash of `len` bytes at `data`.
pub fn fnv1a_bytes(data: *u8, len: i64) -> u64
    var h: u64 = fnv1a_init()
    var i: i64 = 0
    while i < len
        h = fnv1a_byte(h, *(data + i))
        i = i + 1
    return h

# Hash entire source file contents.  ritz0 truncates SHA-256 to 16 hex
# chars; we mirror the on-disk shape with FNV1a-64 (also 16 hex chars).
pub fn source_file_hash(src: *u8, len: i64) -> u64
    return fnv1a_bytes(src, len)

# ----------------------------------------------------------------------------
# Compiler identity
# ----------------------------------------------------------------------------
#
# AGAST #1279.  Cached compilation output is only reusable if the *same
# compiler* produced it.  Before this existed, `check_source_unchanged()`
# keyed reuse on the source hash and the .ll mtime alone, so a rebuilt ritz1
# would happily serve IR emitted by the previous ritz1 — including IR the new
# compiler would no longer emit (e.g. the invalid-PHI output fixed in 9aab44f).
# The bootstrap gate then reported pass/fail based on leftover build state
# rather than on the commit under test, in both directions.
#
# `ritz1/Makefile` already lists `$(RITZ1)` as a prerequisite of every
# `build/%_sh.ll`, so make *does* re-invoke ritz1 when the binary changes;
# ritz1's own fast path was overriding make's correct decision.  The fix is to
# make compiler identity part of the cache key so the two agree.
#
# This mirrors `cache.py:compute_compiler_hash()` on the ritz0 side, which
# fingerprints the ritz1 binary by *content*.  We do the same rather than
# using mtime so that a no-op relink producing a byte-identical binary keeps
# the cache warm (reuse is genuinely correct in that case), while any change
# to the emitted-code path invalidates it.

# Read `/proc/self/exe` — the currently executing binary, symlink already
# resolved by the kernel — and return an FNV1a-64 digest of its contents.
#
# Returns 0 when the binary cannot be read.  0 is reserved as the "unknown
# compiler" sentinel: callers MUST treat it as a cache miss, never as a
# match, so an unreadable /proc degrades to a full compile rather than to
# silent reuse of foreign IR.  A sig with no `compiler_hash` field also
# parses as 0, so it fails closed the same way.
pub fn compiler_fingerprint() -> u64
    var sz: i64 = 0
    let buf: *u8 = read_file_to_buf(c"/proc/self/exe", @sz)
    if buf == null
        return 0
    if sz <= 0
        free(buf)
        return 0
    var h: u64 = fnv1a_bytes(buf, sz)
    free(buf)
    # Mix the byte count in too, so a short read can never alias the digest
    # of a genuinely shorter binary.
    h = fnv1a_mix_u64(h, sz as u64)
    # 0 is the "unknown compiler" sentinel; never produce it as a real value.
    if h == 0
        h = 1
    return h

# The identity cached IR is stamped with, and must match to be reused:
#   * the compiler binary (#1279);
#   * the target OS (#1550), since `--target-os` decides which
#     `[[target_os]]` variants reach the IR — without it a harland compile
#     reuses IR a linux compile left behind;
#   * the import search path (`-I` merged with RITZ_PATH; #1807), since it
#     decides which file an import resolves to.  The import hashes only vouch
#     for the files the last compile read; if the same import now resolves
#     to a different file, those files can be unchanged and the IR still
#     stale.
# 0 (unknown) whenever the compiler fingerprint is.
pub fn cache_fingerprint(target_os: *u8, target_os_len: i64, ritz_path: *u8, ritz_path_len: i64) -> u64
    let fp: u64 = compiler_fingerprint()
    if fp == 0
        return 0
    var h: u64 = fnv1a_mix_u64(fp, target_os_len as u64)
    if target_os_len > 0
        h = fnv1a_mix_u64(h, fnv1a_bytes(target_os, target_os_len))
    h = fnv1a_mix_u64(h, ritz_path_len as u64)
    if ritz_path_len > 0
        h = fnv1a_mix_u64(h, fnv1a_bytes(ritz_path, ritz_path_len))
    if h == 0
        h = 1
    return h

# Fold the 8 little-endian bytes of `v` into an in-progress FNV1a-64 state.
fn fnv1a_mix_u64(h: u64, v: u64) -> u64
    var acc: u64 = h
    var x: u64 = v
    var i: i32 = 0
    while i < 8
        acc = fnv1a_byte(acc, (x & 255) as u8)
        x = x >> 8
        i = i + 1
    return acc

# Format a u64 as exactly 16 lowercase hex chars.  Caller provides a
# >= 16-byte buffer; we do NOT null-terminate (caller may extend).
pub fn u64_to_hex16(h: u64, out: *u8)
    var v: u64 = h
    var i: i32 = 15
    while i >= 0
        let nib: u64 = v & 15
        var c: u8 = 0
        if nib < 10
            c = (nib + 48) as u8       # '0' = 48
        else
            c = (nib - 10 + 97) as u8  # 'a' = 97
        *(out + i) = c
        v = v >> 4
        i = i - 1

# Parse a 16-hex-char string back to u64.  Returns 0 on malformed input
# (only `[0-9a-fA-F]` accepted).  Stops at the first non-hex byte.
pub fn hex16_to_u64(s: *u8) -> u64
    if s == null
        return 0
    var v: u64 = 0
    var i: i32 = 0
    while i < 16
        let c: u8 = *(s + i)
        if c == 0
            return v
        var d: u64 = 0
        if c >= 48 and c <= 57           # '0'-'9'
            d = (c - 48) as u64
        else if c >= 97 and c <= 102     # 'a'-'f'
            d = (c - 97 + 10) as u64
        else if c >= 65 and c <= 70      # 'A'-'F'
            d = (c - 65 + 10) as u64
        else
            return v
        v = (v << 4) | d
        i = i + 1
    return v


# ============================================================================
# Sig file location
# ============================================================================

# Append the cache root (see the header) to `out`.
fn push_cache_root(out: *String)
    let explicit: StrView = env_get_or("RITZ_CACHE_DIR", strview_empty())
    if explicit.len > 0
        string_push_bytes(out, explicit.ptr, explicit.len)
        return
    let xdg: StrView = env_get_or("XDG_CACHE_HOME", strview_empty())
    if xdg.len > 0
        string_push_bytes(out, xdg.ptr, xdg.len)
        string_push_str(out, "/ritz")
        return
    let home: StrView = env_get_or("HOME", strview_empty())
    if home.len > 0
        string_push_bytes(out, home.ptr, home.len)
        string_push_str(out, "/.cache/ritz")
        return
    string_push_str(out, "/tmp/ritz-cache")

# Append this compiler's namespace — the basename of the running binary —
# to `out`.  ritz1 and ritz1_selfhosted are different binaries with different
# compiler hashes; sharing one namespace would have them evict each other on
# every alternation, which is the #1280 problem again one level down.
fn push_compiler_namespace(out: *String)
    var buf: [4096]u8
    let n: i64 = sys_readlink(c"/proc/self/exe", @buf[0], 4096)
    var start: i64 = 0
    var i: i64 = 0
    while i < n
        if buf[i] == 47      # '/'
            start = i + 1
        i = i + 1
    if n <= 0 or n >= 4096 or start >= n
        string_push_str(out, "ritz1")
        return
    string_push_bytes(out, @buf[start], n - start)

# Append the canonical absolute path of the existing file `path` to `out`.
# Returns 1 on success, 0 if the file cannot be opened.
#
# The kernel does the canonicalising: open the file and read back
# /proc/self/fd/<n>, which has symlinks, `.` and `..` already resolved —
# the same answer as Python's os.path.realpath, which ritz0 uses.
pub fn push_canonical_path(out: *String, path: *u8) -> i32
    let fd: i32 = sys_open(path, O_RDONLY)
    if fd < 0
        return 0
    var link: String = string_from("/proc/self/fd/")
    string_push_i64(@link, fd as i64)
    var buf: [4096]u8
    let n: i64 = sys_readlink(string_as_ptr(@link), @buf[0], 4096)
    sys_close(fd)
    string_drop(@link)
    if n <= 0 or n >= 4096
        return 0
    string_push_bytes(out, @buf[0], n)
    return 1

# The sig path for `src_path` (see the header), or an empty String when the
# source cannot be canonicalised — callers then neither read nor write a sig.
pub fn sig_path_from_src(src_path: *u8) -> String
    var s: String = string_new()
    push_cache_root(@s)
    string_push(@s, '/')
    push_compiler_namespace(@s)
    # The canonical path starts with '/', which separates it from the namespace.
    if push_canonical_path(@s, src_path) == 0
        string_clear(@s)
        return s
    string_push_str(@s, ".sig")
    return s

# Build "<sig_path>.tmp.<pid>" — used for atomic writes.  The pid keeps two
# concurrent compiles of one source (xdist workers, parallel gates) from
# writing into each other's temp file.
fn sig_tmp_path(sig_path: *u8) -> String
    var s: String = string_from_cstr(sig_path)
    string_push_str(@s, ".tmp.")
    string_push_i64(@s, sys_getpid() as i64)
    return s

# `mkdir -p` the directory part of `path`.  Errors (EEXIST included) are
# ignored: if a directory really is missing, the write that follows fails
# and the caller handles that.
fn mkdir_parents(path: *u8)
    let len: i64 = strlen(path)
    let buf: *u8 = malloc(len + 1)
    if buf == null
        return
    memcpy(buf, path, len + 1)
    var i: i64 = 1
    while i < len
        if *(buf + i) == 47      # '/'
            *(buf + i) = 0
            sys_mkdir(buf, 493)  # 0755
            *(buf + i) = 47
        i = i + 1
    free(buf)


# ============================================================================
# In-memory sig representation
# ============================================================================

struct SigData
    source_hash:   u64
    # Cached whole-module LLVM IR (the entire output .ll), so the fast path
    # can recreate an output the orchestrator deleted.  null = no cache.
    module_ir:     *u8
    module_ir_len: i64
    # FNV1a-64 of the compiler binary + target OS + import search path that
    # produced `module_ir` (AGAST #1279).  0 means "unknown" and never matches.
    compiler_hash: u64
    # Transitive imports: canonical path (heap cstring) and content hash.
    dep_paths:     **u8
    dep_hashes:    *u64
    dep_count:     i32
    dep_cap:       i32
    # 1 when the sig carried an `import_hashes` record.  A sig without one
    # cannot vouch for its imports and is never reused.
    has_deps:      i32

# Allocate a fresh empty SigData on the heap.
pub fn sig_data_new() -> *SigData
    # 96 bytes covers all fields with room for alignment padding.
    let sd: *SigData = malloc(96) as *SigData
    if sd == null
        return null
    sd.source_hash = 0
    sd.compiler_hash = 0
    sd.module_ir = null
    sd.module_ir_len = 0
    sd.dep_paths = null
    sd.dep_hashes = null
    sd.dep_count = 0
    sd.dep_cap = 0
    sd.has_deps = 0
    return sd

fn sig_data_free_deps(sd: *SigData)
    var i: i32 = 0
    while i < sd.dep_count
        let p: *u8 = *(sd.dep_paths + i)
        if p != null
            free(p)
        i = i + 1
    if sd.dep_paths != null
        free(sd.dep_paths as *u8)
    if sd.dep_hashes != null
        free(sd.dep_hashes as *u8)
    sd.dep_paths = null
    sd.dep_hashes = null
    sd.dep_count = 0
    sd.dep_cap = 0

# Free SigData and all owned heap allocations.
pub fn sig_data_free(sd: *SigData)
    if sd == null
        return
    sig_data_free_deps(sd)
    if sd.module_ir != null
        free(sd.module_ir)
    free(sd as *u8)

# Append a dependency, copying `path[0..path_len)`.
fn sig_data_add_dep(sd: *SigData, path: *u8, path_len: i64, h: u64)
    if sd.dep_count >= sd.dep_cap
        var new_cap: i32 = sd.dep_cap * 2
        if new_cap < 16
            new_cap = 16
        let np: **u8 = malloc((new_cap as i64) * 8) as **u8
        let nh: *u64 = malloc((new_cap as i64) * 8) as *u64
        if np == null or nh == null
            return
        if sd.dep_count > 0
            memcpy(np as *u8, sd.dep_paths as *u8, (sd.dep_count as i64) * 8)
            memcpy(nh as *u8, sd.dep_hashes as *u8, (sd.dep_count as i64) * 8)
        if sd.dep_paths != null
            free(sd.dep_paths as *u8)
        if sd.dep_hashes != null
            free(sd.dep_hashes as *u8)
        sd.dep_paths = np
        sd.dep_hashes = nh
        sd.dep_cap = new_cap
    let copy: *u8 = malloc(path_len + 1)
    if copy == null
        return
    memcpy(copy, path, path_len)
    *(copy + path_len) = 0
    *(sd.dep_paths + sd.dep_count) = copy
    *(sd.dep_hashes + sd.dep_count) = h
    sd.dep_count = sd.dep_count + 1


# ============================================================================
# Dependency record for the compile in progress
# ============================================================================
#
# main.ritz's import resolver calls `dep_record_note()` for every file it
# loads, with the exact bytes it is about to parse — so the hash describes
# what this compile actually saw, not what is on disk by the time the sig is
# written.  The record is moved into the outgoing sig by `sig_take_deps()`.

var g_dep_record: *SigData

pub fn dep_record_reset()
    if g_dep_record != null
        sig_data_free(g_dep_record)
    g_dep_record = null

pub fn dep_record_note(path: *u8, data: *u8, len: i64)
    if g_dep_record == null
        g_dep_record = sig_data_new()
        if g_dep_record == null
            return
    var canon: String = string_new()
    if push_canonical_path(@canon, path) == 1
        sig_data_add_dep(g_dep_record, string_as_ptr(@canon), string_len(@canon), fnv1a_bytes(data, len))
    else
        # Unresolvable: record it under a path that can never be read back,
        # so the next fast-path check fails closed.
        sig_data_add_dep(g_dep_record, c"", 0, 0)
    string_drop(@canon)

# Move the recorded dependencies into `sd` and mark it as carrying them
# (a compile with no imports legitimately records none).
pub fn sig_take_deps(sd: *SigData)
    sig_data_free_deps(sd)
    sd.has_deps = 1
    # Through a local: ritz1 cannot yet lower `.field` on a global pointer (#1892)
    # ("unhandled EXPR_MEMBER"), and ritz1 must compile itself.
    let rec: *SigData = g_dep_record
    if rec == null
        return
    sd.dep_paths = rec.dep_paths
    sd.dep_hashes = rec.dep_hashes
    sd.dep_count = rec.dep_count
    sd.dep_cap = rec.dep_cap
    rec.dep_paths = null
    rec.dep_hashes = null
    rec.dep_count = 0
    rec.dep_cap = 0


# ============================================================================
# File helpers
# ============================================================================

# Read entire file into a malloced buffer.  Returns null on missing/empty.
# Sets `*out_len` to the number of bytes read.
fn read_file_to_buf(path: *u8, out_len: *i64) -> *u8
    *out_len = 0
    let fd: i32 = sys_open(path, O_RDONLY)
    if fd < 0
        return null
    # Use stat to learn size.  It is only an upper bound: the file can shrink
    # before we read it, and under valgrind `stat("/proc/self/exe")`
    # describes memcheck while `open` is redirected to the client binary.
    var st: Stat
    let stres: i32 = sys_stat2(path, @st)
    if stres != 0
        sys_close(fd)
        return null
    let sz: i64 = st.st_size
    if sz <= 0
        sys_close(fd)
        return null
    let buf: *u8 = malloc(sz + 1)
    if buf == null
        sys_close(fd)
        return null
    # Report only the bytes actually read.  This used to set `total = sz` on
    # EOF/error, claiming an uninitialised tail as file contents, so the
    # compiler fingerprint hashed garbage (AGAST #1663).
    var total: i64 = 0
    var done: i32 = 0
    while done == 0 and total < sz
        let n: i64 = sys_read(fd, buf + total, sz - total)
        if n < 0
            sys_close(fd)
            free(buf)
            return null
        if n == 0
            done = 1     # EOF: the file is shorter than stat said
        else
            total = total + n
    sys_close(fd)
    if total <= 0
        free(buf)
        return null
    *(buf + total) = 0
    *out_len = total
    return buf

# ============================================================================
# Sig parsing (read)
# ============================================================================

# Parse a sig file.  Returns null on missing/corrupt/structurally unexpected —
# the caller treats null as "no cache, cold start".
pub fn read_sig_file(sig_path: *u8) -> *SigData
    var sz: i64 = 0
    let buf: *u8 = read_file_to_buf(sig_path, @sz)
    if buf == null or sz <= 0
        return null

    let res: JsonResult = json_parse(buf, sz)
    free(buf)
    if res.ok != 1 or res.value == null
        if res.value != null
            json_free(res.value)
        return null
    let root: *JsonValue = res.value
    if root.kind != JSON_OBJECT
        json_free(root)
        return null

    let sd: *SigData = sig_data_new()
    if sd == null
        json_free(root)
        return null

    let sh_node: *JsonValue = json_get_field(root, c"source_hash")
    if sh_node != null and sh_node.kind == JSON_STRING and sh_node.str_val != null
        sd.source_hash = hex16_to_u64(sh_node.str_val)

    # Absent → stays 0, and every reuse check fails closed.
    let ch_node: *JsonValue = json_get_field(root, c"compiler_hash")
    if ch_node != null and ch_node.kind == JSON_STRING and ch_node.str_val != null
        sd.compiler_hash = hex16_to_u64(ch_node.str_val)

    let mir_node: *JsonValue = json_get_field(root, c"module_ir")
    if mir_node != null and mir_node.kind == JSON_STRING and mir_node.str_val != null
        let ml: i64 = mir_node.str_len
        if ml > 0
            let mb: *u8 = malloc(ml + 1)
            if mb != null
                memcpy(mb, mir_node.str_val, ml + 1)
                sd.module_ir = mb
                sd.module_ir_len = ml

    let ih_node: *JsonValue = json_get_field(root, c"import_hashes")
    if ih_node != null and ih_node.kind == JSON_OBJECT
        sig_parse_deps(sd, ih_node)

    json_free(root)
    return sd

# Fill `sd`'s dependencies from the `import_hashes` object.  An entry that is
# not a string hash is recorded with hash 0, which no real file matches.
fn sig_parse_deps(sd: *SigData, obj: *JsonValue)
    sd.has_deps = 1
    var i: i64 = 0
    while i < obj.count
        let key: *u8 = *(obj.keys + i)
        let val: *JsonValue = *(obj.items + i)
        var h: u64 = 0
        if val != null and val.kind == JSON_STRING and val.str_val != null
            h = hex16_to_u64(val.str_val)
        if key != null
            sig_data_add_dep(sd, key, strlen(key), h)
        i = i + 1


# ============================================================================
# Sig emission (write)
# ============================================================================

# Emit a JSON-string-encoded byte sequence (`"..."`) into `buf`.  Mirrors
# `json_emit_string` but lets us pass a (ptr, len) pair so we can emit IR
# blobs that may contain arbitrary bytes.
fn emit_json_string_bytes(buf: *Vec<u8>, s: *u8, len: i64)
    vec_push<u8>(buf, 34)       # '"'
    if s != null and len > 0
        var i: i64 = 0
        while i < len
            let ch: u8 = *(s + i)
            if ch == 34          # '"'
                vec_push<u8>(buf, 92)   # '\'
                vec_push<u8>(buf, 34)
            else if ch == 92      # '\'
                vec_push<u8>(buf, 92)
                vec_push<u8>(buf, 92)
            else if ch == 10      # '\n'
                vec_push<u8>(buf, 92)
                vec_push<u8>(buf, 110)  # 'n'
            else if ch == 13      # '\r'
                vec_push<u8>(buf, 92)
                vec_push<u8>(buf, 114)  # 'r'
            else if ch == 9       # '\t'
                vec_push<u8>(buf, 92)
                vec_push<u8>(buf, 116)  # 't'
            else if ch < 32       # other control chars — emit \uXXXX
                vec_push<u8>(buf, 92)
                vec_push<u8>(buf, 117)  # 'u'
                vec_push<u8>(buf, 48)   # '0'
                vec_push<u8>(buf, 48)   # '0'
                let hi: u8 = (ch >> 4) & 15
                let lo: u8 = ch & 15
                if hi < 10
                    vec_push<u8>(buf, hi + 48)
                else
                    vec_push<u8>(buf, hi - 10 + 97)
                if lo < 10
                    vec_push<u8>(buf, lo + 48)
                else
                    vec_push<u8>(buf, lo - 10 + 97)
            else
                vec_push<u8>(buf, ch)
            i = i + 1
    vec_push<u8>(buf, 34)        # '"'

fn emit_hex16_field(buf: *Vec<u8>, key: *u8, h: u64)
    vec_push_str(buf, key)
    vec_push_str(buf, c": \"")
    var hex: [16]u8
    u64_to_hex16(h, @hex[0])
    var k: i64 = 0
    while k < 16
        vec_push<u8>(buf, hex[k])
        k = k + 1
    vec_push<u8>(buf, 34)        # '"'

# Serialize the `import_hashes` entries (between the braces).  A helper of its
# own so the caller's if/else branches stay single calls (AGAST #1269).
fn sig_serialize_deps(sd: *SigData, buf: *Vec<u8>)
    vec_push<u8>(buf, 10)       # '\n'
    var i: i32 = 0
    while i < sd.dep_count
        vec_push_str(buf, c"    ")
        let p: *u8 = *(sd.dep_paths + i)
        emit_json_string_bytes(buf, p, strlen(p))
        vec_push_str(buf, c": \"")
        var hex: [16]u8
        u64_to_hex16(*(sd.dep_hashes + i), @hex[0])
        var k: i64 = 0
        while k < 16
            vec_push<u8>(buf, hex[k])
            k = k + 1
        vec_push<u8>(buf, 34)    # '"'
        if i + 1 < sd.dep_count
            vec_push<u8>(buf, 44)   # ','
        vec_push<u8>(buf, 10)
        i = i + 1
    vec_push_str(buf, c"  }\n")

# Serialize SigData as JSON into a Vec<u8> (indent=2 + trailing newline).
fn sig_serialize(sd: *SigData, buf: *Vec<u8>)
    vec_push_str(buf, c"{\n")
    emit_hex16_field(buf, c"  \"source_hash\"", sd.source_hash)
    vec_push_str(buf, c",\n")
    emit_hex16_field(buf, c"  \"compiler_hash\"", sd.compiler_hash)
    vec_push_str(buf, c",\n")

    # Always present (null when empty) so the shape is fixed.
    vec_push_str(buf, c"  \"module_ir\": ")
    if sd.module_ir != null and sd.module_ir_len > 0
        emit_json_string_bytes(buf, sd.module_ir, sd.module_ir_len)
    else
        vec_push_str(buf, c"null")
    vec_push_str(buf, c",\n")

    vec_push_str(buf, c"  \"import_hashes\": {")
    if sd.dep_count == 0
        vec_push_str(buf, c"}\n")
    else
        sig_serialize_deps(sd, buf)

    vec_push_str(buf, c"}\n")

# Atomic write: serialize, write "<sig>.tmp.<pid>", rename over "<sig>".
# Creates the sig's directory first.  Returns 0 on success, -1 on failure.
pub fn write_sig_file(sig_path: *u8, sd: *SigData) -> i32
    if sd == null or sig_path == null
        return -1
    if *sig_path == 0
        return -1
    mkdir_parents(sig_path)
    var tmp: String = sig_tmp_path(sig_path)
    let tmp_ptr: *u8 = string_as_ptr(@tmp)

    var buf: Vec<u8> = vec_with_cap<u8>(8192)
    sig_serialize(sd, @buf)

    let fd: i32 = sys_open3(tmp_ptr, O_WRONLY + O_CREAT + O_TRUNC, 420)
    if fd < 0
        vec_drop<u8>(@buf)
        string_drop(@tmp)
        return -1
    let n: i64 = sys_write(fd, buf.data, buf.len as i64)
    sys_close(fd)
    let want: i64 = buf.len as i64
    vec_drop<u8>(@buf)
    if n != want
        sys_unlink(tmp_ptr)
        string_drop(@tmp)
        return -1
    let r: i32 = sys_rename(tmp_ptr, sig_path)
    if r != 0
        sys_unlink(tmp_ptr)
        string_drop(@tmp)
        return -1
    string_drop(@tmp)
    return 0


# ============================================================================
# File-level fast path
# ============================================================================

# 1 when every dependency recorded in `sd` still has the recorded content.
# A sig with no record at all (`has_deps == 0`) answers 0.  An unreadable or
# empty dependency also answers 0: failing closed costs one recompile.
fn sig_deps_unchanged(sd: *SigData) -> i32
    if sd.has_deps == 0
        return 0
    var i: i32 = 0
    while i < sd.dep_count
        var sz: i64 = 0
        let buf: *u8 = read_file_to_buf(*(sd.dep_paths + i), @sz)
        if buf == null
            return 0
        let h: u64 = fnv1a_bytes(buf, sz)
        free(buf)
        if h != *(sd.dep_hashes + i)
            return 0
        i = i + 1
    return 1

# Returns 1 when the requested compilation can be skipped — either:
#   (a) <ll_path> exists with mtime >= the source's, or
#   (b) the sig has a cached `module_ir`, which we WRITE to <ll_path> here.
# Returns 0 if the caller must do a full compile.
#
# BOTH branches are gated on the sig's source hash, its compiler identity
# (`self_fp` is `cache_fingerprint()`; AGAST #1279) and its import hashes
# (AGAST #1807).  Gating only (a) would be worse than useless — (b) is the
# branch that *materialises* stale IR, re-creating a `.ll` that make had
# just deleted and filling it with output that no longer matches the inputs.
pub fn check_source_unchanged(src_path: *u8, src: *u8, src_len: i64, ll_path: *u8, self_fp: u64) -> i32
    if src_path == null or ll_path == null or src == null
        return 0

    var sig_path: String = sig_path_from_src(src_path)
    if string_is_empty(@sig_path) == 1
        string_drop(@sig_path)
        return 0
    let sd: *SigData = read_sig_file(string_as_ptr(@sig_path))
    string_drop(@sig_path)
    if sd == null
        return 0

    let cur: u64 = source_file_hash(src, src_len)
    if cur != sd.source_hash
        sig_data_free(sd)
        return 0

    # Compiler identity.  `self_fp` is 0 when /proc/self/exe is unreadable and
    # `sd.compiler_hash` is 0 for sigs with no such field, so the explicit
    # `== 0` rejection stops two unknowns from comparing equal.
    if self_fp == 0 or sd.compiler_hash == 0 or sd.compiler_hash != self_fp
        sig_data_free(sd)
        return 0

    # Every transitive import must be byte-identical to what was compiled.
    if sig_deps_unchanged(sd) == 0
        sig_data_free(sd)
        return 0

    # Path (a): the requested .ll already exists and is up-to-date.
    var ll_st: Stat
    let lr: i32 = sys_stat2(ll_path, @ll_st)
    if lr == 0
        var src_st: Stat
        let sr: i32 = sys_stat2(src_path, @src_st)
        if sr == 0
            if ll_st.st_mtime > src_st.st_mtime
                sig_data_free(sd)
                return 1
            if ll_st.st_mtime == src_st.st_mtime and ll_st.st_mtime_ns >= src_st.st_mtime_ns
                sig_data_free(sd)
                return 1

    # Path (b): the on-disk .ll is missing or stale, but we have cached IR
    # from a previous run.  Splice it to the requested output path.
    if sd.module_ir != null and sd.module_ir_len > 0
        let fd: i32 = sys_open3(ll_path, O_WRONLY + O_CREAT + O_TRUNC, 420)
        if fd >= 0
            let n: i64 = sys_write(fd, sd.module_ir, sd.module_ir_len)
            sys_close(fd)
            if n == sd.module_ir_len
                sig_data_free(sd)
                return 1

    sig_data_free(sd)
    return 0
