# ritz1/src/fn_cache.ritz
#
# ritz1's compilation cache: one sig file per source, holding a snapshot of
# the module's emitted IR plus everything that snapshot depends on.
#
# File-level fast path — `check_source_unchanged()` is consulted by
# `main.ritz` before any work is done.  It skips the compile only when ALL of
# these still hold for the sig written by the last compile:
#
#   * `source_hash`   — FNV1a-64 of this source file;
#   * `compiler_hash` — this binary, the target OS and the import roots
#                       (`cache_fingerprint()`; AGAST #1279, #1550, #1807,
#                       #2023);
#   * `import_hashes` — FNV1a-64 of every file the source transitively
#                       imports, keyed by canonical path (AGAST #1807);
#   * `import_misses` — every candidate path import resolution probed and
#                       found missing before a hit; each must still be
#                       missing (AGAST #2030).  Resolution is first match, so
#                       a NEW file at one of them changes what an import
#                       resolves to, while every import hash still matches;
#   * `module_ir`     — the output is reused only if it is byte-identical to
#                       it, and otherwise rewritten from it.  The sig is per
#                       source, so this is what ties it to *this* output
#                       (AGAST #2023).
#
# The last one matters because a module's IR bakes in every imported struct
# layout (field offsets, GEP indices), constant and signature: before #1807 a
# struct change in an imported module left the importer's cached IR reading
# fields at their old offsets.  ritz0 closed the same hole in #1674.
#
# Where the sig lives (AGAST #1807, absorbing #1280):
#
#   <cache root>/<compiler>/<canonical source path>.sig
#
#   cache root  $RITZ_CACHE_DIR, else $XDG_CACHE_HOME/ritz, else
#               $HOME/.cache/ritz, else /tmp/ritz-cache
#   compiler    basename of this binary ("ritz1", "ritz1_selfhosted")
#
# It used to be `<src>.ritz.sig`, beside the source and shared with ritz0 and
# ritz1_selfhosted, each writing its own schema over the others' — every
# compiler boundary in a gate threw the cache away.  ritz0 uses the same
# mapping with compiler "ritz0" (ritz0/emitter/fn_cache.py:sig_path_for).
#
# Sig format (JSON):
#   {
#     "source_hash":   "<16 hex>",
#     "compiler_hash": "<16 hex>",
#     "module_ir":     "<the whole emitted .ll>" | null,
#     "import_hashes": {"<canonical path>": "<16 hex>", ...},
#     "import_misses": ["<absolute path>", ...]
#   }
#
# There used to be a per-function cache here too (`lookup_fn_ir` /
# `cache_fn_ir`, a port of ritz0's).  Nothing ever called it, and #1807
# deleted it rather than wire it up: the whole-module snapshot already makes
# a no-change rebuild free, while splicing individual functions would need
# the same import invalidation per function *plus* a replay of everything
# `emit_fn` contributes beyond its body (string constants, extern declares,
# monomorph instantiations) — a new feature with its own staleness risks,
# not a cache fix.

import ritzlib.cstr
import ritzlib.sys
import ritzlib.io
import ritzlib.str
import ritzlib.string
import ritzlib.strview
import ritzlib.gvec
import ritzlib.memory
import ritzlib.hash
import ritzlib.option
import ritzlib.result
import ritzlib.json
import ritzlib.os.env
import ritzlib.timer   # clock_gettime: the exe-id memo's write rule (AGAST #4851)
import ritzlib.fd
import ritzlib.fs { stat, mkdir, rename, unlink, read_link, path_basename }
import iface_text   # iface_text_path, iface_text_derive (AGAST #2113)


# ============================================================================
# Hashing primitives
# ============================================================================

# FNV1a-64 hash of `len` bytes at `data`.
pub fn fnv1a_bytes(data_sv: StrView) -> u64
    var data: *u8 = data_sv.ptr
    var len: i64 = data_sv.len
    var h: u64 = fnv1a_init()
    var i: i64 = 0
    while i < len
        h = fnv1a_byte(h, *(data + i))
        i = i + 1
    return h

# Hash entire source file contents.  ritz0 truncates SHA-256 to 16 hex
# chars; we mirror the on-disk shape with FNV1a-64 (also 16 hex chars).
pub fn source_file_hash(src: StrView) -> u64
    return fnv1a_bytes(src)

# ----------------------------------------------------------------------------
# Compiler identity
# ----------------------------------------------------------------------------
#
# AGAST #1279.  Cached compilation output is only reusable if the *same
# compiler* produced it.  Before this existed, `check_source_unchanged()`
# keyed reuse on the source hash and the .ll mtime alone, so a rebuilt ritz1
# would happily serve IR emitted by the previous ritz1 — including IR the new
# compiler would no longer emit (e.g. the invalid-PHI output fixed in 9aab44f).
# The bootstrap gate then reported pass/fail based on leftover build state
# rather than on the commit under test, in both directions.
#
# `ritz1/Makefile` already lists `$(RITZ1)` as a prerequisite of every
# `build/%_sh.ll`, so make *does* re-invoke ritz1 when the binary changes;
# ritz1's own fast path was overriding make's correct decision.  The fix is to
# make compiler identity part of the cache key so the two agree.
#
# This mirrors `cache.py:compute_compiler_hash()` on the ritz0 side, which
# fingerprints the ritz1 binary by *content*.  We do the same rather than
# using mtime so that a no-op relink producing a byte-identical binary keeps
# the cache warm (reuse is genuinely correct in that case), while any change
# to the emitted-code path invalidates it.

# Read `/proc/self/exe` — the currently executing binary, symlink already
# resolved by the kernel — and return an FNV1a-64 digest of its contents.
#
# Returns 0 when the binary cannot be read.  0 is reserved as the "unknown
# compiler" sentinel: callers MUST treat it as a cache miss, never as a
# match, so an unreadable /proc degrades to a full compile rather than to
# silent reuse of foreign IR.  A sig with no `compiler_hash` field also
# parses as 0, so it fails closed the same way.
#
# The digest is memoized per binary (AGAST #4851, see "exe-id memo" below):
# hashing all of the binary cost ~42M Ir on every run, more than compiling a
# small file, and `rz build` runs ritz1 once per module.  The memo is only
# consulted once the binary is open, so an unreadable one still answers 0.
pub fn compiler_fingerprint() -> u64
    # The clock BEFORE the stat: see exe_ctime_settled.
    var now: Timespec = Timespec { tv_sec: 0, tv_nsec: 0 }
    let clock_ok: bool = clock_gettime(CLOCK_REALTIME, @&now) == 0
    var file: Fd = fd_open("/proc/self/exe", O_RDONLY, 0).unwrap_or(fd_adopt(-1))
    if not file.valid()
        return 0
    # The open file's identity, not the path's: under valgrind `open` is
    # redirected to the client binary while a path stat would describe
    # memcheck (#1663).
    var st: Stat
    var have_st: bool = false
    match file.stat()
        Ok(got) =>
            st = got
            have_st = true
        Err(e) => have_st = false
    if not have_st
        file.close()
        return 0
    var memo: String = exe_memo_path(@&st)
    var record: String = exe_memo_record(@&st)
    let hit: u64 = exe_memo_read(@&memo, @&record)
    if hit != 0
        file.close()
        return hit
    let old_enough: bool = clock_ok and exe_ctime_settled(@&st, @&now)
    let bytes: Vec<u8> = read_fd_to_vec(@file, st.st_size)
    file.close()
    if bytes.len == 0
        return 0
    let sz: i64 = bytes.len
    var h: u64 = fnv1a_bytes(bytes.as_view())
    # Mix the byte count in too, so a short read can never alias the digest
    # of a genuinely shorter binary.
    h = fnv1a_mix_u64(h, sz as u64)
    # 0 is the "unknown compiler" sentinel; never produce it as a real value.
    if h == 0
        h = 1
    if old_enough
        exe_memo_write(@&memo, @&record, h)
    return h

# ----------------------------------------------------------------------------
# exe-id memo (AGAST #4851)
# ----------------------------------------------------------------------------
#
# The content hash of a ritz1 binary, keyed by that binary's stat identity:
#
#   <cache root>/<compiler>/exe-id/<st_dev hex16>-<st_ino hex16>
#   "ritz1-exe-id-v1 <size> <mtime s> <mtime ns> <ctime s> <ctime ns> <hash hex16>\n"
#
# So the binary is hashed once per build of ritz1, not once per run.  What
# the cache key MEANS is unchanged: it is still the content hash, as
# ritz0's cache.py:compute_compiler_hash() takes, and the memo only says
# "this inode, unchanged since, hashed to H".
#
#   * A relink (the linker writes a new file) makes a new inode: the memo
#     misses and the binary is hashed again.  A byte-identical relink gets
#     the same hash, so the sig cache stays warm exactly as before.
#   * An in-place rewrite keeps the inode and can keep the size and, via
#     utime, the mtime, but it sets ctime to the current time, and
#     userspace cannot set ctime back.  ctime is in the key, so it misses.
#   * The one hole is a rewrite in the same clock tick as the stat we keyed
#     on (ctime would not move).  So a memo is written only when ctime is
#     over a second older than the clock read before the stat (racy-git's
#     rule): any later write then lands on a later ctime.  A just-linked
#     binary therefore hashes itself on every run for its first 1-2 seconds.
#   * Anything but an exact, well-formed record of the current stat is a
#     miss: a torn or garbage file is rehashed and rewritten.  Writes are a
#     per-pid temp file renamed into place, so concurrent `rz build` workers
#     never read each other's partial writes.
#   * Per inode rather than one file per compiler name: ritz1 binaries in
#     several worktrees share one cache root and would evict each other.
#     The files are ~80 bytes and inode numbers are reused, so they stay few.

# The memo's path for the binary `st` describes.
fn exe_memo_path(st: @&Stat) -> String
    var s: String = string_new()
    push_cache_root(@s)
    s.push('/')
    push_compiler_namespace(@s)
    s.push_str("/exe-id/")
    var hex: [16]u8
    u64_to_hex16(st.st_dev as u64, @hex[0])
    s.push_span(Span<u8> { ptr: (@hex[0]), len: 16 })
    s.push('-')
    u64_to_hex16(st.st_ino as u64, @hex[0])
    s.push_span(Span<u8> { ptr: (@hex[0]), len: 16 })
    s

# The memo record for `st`, up to and including the space before the hash.
fn exe_memo_record(st: @&Stat) -> String
    var s: String = string_from("ritz1-exe-id-v1 ")
    s.push_i64(st.st_size)
    s.push(' ')
    s.push_i64(st.st_mtime)
    s.push(' ')
    s.push_i64(st.st_mtime_ns)
    s.push(' ')
    s.push_i64(st.st_ctime)
    s.push(' ')
    s.push_i64(st.st_ctime_ns)
    s.push(' ')
    s

# The hash the memo at `memo` records for exactly `record`, or 0 (a miss)
# if the file is absent, for another stat, or malformed in any way.
fn exe_memo_read(memo: @&String, record: @&String) -> u64
    var sz: i64 = 0
    let buf: *u8 = read_file_to_buf(memo.as_view(), @sz)
    if buf == null
        return 0
    let rlen: i64 = record.len()
    var h: u64 = 0
    if sz == rlen + 17
        let line: StrView = StrView { ptr: (buf), len: (sz) }
        if line.slice(0, rlen).eq(record.as_view()) and line.get(rlen + 16) == '\n'
            h = hex16_strict(line.slice(rlen, rlen + 16))
    free(buf)
    h

# Write `record` + `h` to `memo`.  Best effort: a cache root that can't be
# written only means the next run hashes again.
fn exe_memo_write(memo: @&String, record: @&String, h: u64)
    var line: String = string_new()
    line.push_span(Span<u8> { ptr: (record.as_ptr()), len: (record.len()) as i64 })
    var hex: [16]u8
    u64_to_hex16(h, @hex[0])
    line.push_span(Span<u8> { ptr: (@hex[0]), len: 16 })
    line.push('\n')
    mkdir_parents(memo.as_view())
    write_file_atomic(memo.as_view(), line.as_view())

# True when the binary's ctime `st` is over a second before `now`, read before
# the stat, so a memo of it can't be aliased by a later rewrite: any write
# after the stat lands at a ctime no earlier than `now` less one clock tick,
# and ticks are milliseconds.  (A rewrite between the clock read and the
# stat shows up in `st` itself, as a recent ctime.)
fn exe_ctime_settled(st: @&Stat, now: @&Timespec) -> bool
    st.st_ctime + 1 < now.tv_sec

# Exactly 16 hex digits as a u64, or 0 if any byte is not one.  Unlike
# hex16_to_u64, a malformed tail is never half-read into a value.
fn hex16_strict(s: StrView) -> u64
    if s.len != 16
        return 0
    var i: i64 = 0
    while i < 16
        let c: u8 = s.get(i)
        let digit: bool = (c >= '0' and c <= '9') or (c >= 'a' and c <= 'f') or (c >= 'A' and c <= 'F')
        if not digit
            return 0
        i = i + 1
    hex16_to_u64(s)

# The directory imports are tried against first: `path` up to and including
# its last '/', or "./" when it has none.  `ritz1 main.ritz` run from the
# package dir resolves `import a` to `./a.ritz`, as `ritz1 ./main.ritz` and
# ritz0's ImportResolver do; an empty dir probed nothing (AGAST #4934).
# main.ritz's resolver and cache_fingerprint below both take it from here.
pub fn path_dir(path: StrView) -> StrView
    let dir: StrView = path.take(path.len - path_basename(path).len)
    if dir.len == 0
        return "./"
    dir

# The identity cached IR is stamped with, and must match to be reused:
#   * the compiler binary (#1279);
#   * the target OS (#1550) and target arch (#4117), since `--target-os` /
#     `--target-arch` decide which `[[target_os]]` / `[[target_arch]]`
#     variants reach the IR — without them a harland compile reuses IR a
#     linux compile left behind, and an aarch64 compile one built for
#     x86_64;
#   * the import roots (#1807, #2023), since they decide which file an import
#     resolves to.  The import hashes only vouch for the files the last
#     compile read; if the same import now resolves to a different file,
#     those files can be unchanged and the IR still stale.  The roots are:
#       - each `-I` / RITZ_PATH entry, by the directory it NAMES, not its
#         spelling: a relative entry means something else from another cwd,
#         and `rootA` and `/abs/rootA/` are the same root (#2023);
#       - the directory of `input_path`, which imports are tried against
#         first.  The resolver climbs it textually, so its spelling counts
#         too, and a symlinked source resolves from the symlink's directory
#         while sharing the target's sig (#2023);
#       - each `--dep <name>=<dir>` (#3825), its name and the directory it
#         names, in order.  `deps` is main.ritz's `:`-joined list.  Mixed
#         only when there is one, so a compile without leaves its key as is.
#   - `--stack-protector` (#2590): the IR carries sspstrong.  Mixed only
#     when set, likewise.
#   - `--no-red-zone` (#4308): the IR carries noredzone.  Likewise.
# 0 (unknown) whenever the compiler fingerprint is.
pub fn cache_fingerprint(target_os: StrView, target_arch: StrView, ritz_path: StrView, input_path: StrView, deps: StrView, stack_protector: i32, no_red_zone: i32, freestanding: i32) -> u64
    let fp: u64 = compiler_fingerprint()
    if fp == 0
        return 0
    var h: u64 = fnv1a_mix_bytes(fp, target_os)
    # The target arch selects [[target_arch]] variants (#4117), so it is
    # part of the key exactly as the target OS is.
    h = fnv1a_mix_bytes(h, target_arch)

    # Import search path: `:`-separated, empty entries skipped (as the
    # resolver does).
    var start: i64 = 0
    var i: i64 = 0
    while i <= ritz_path.len
        if i == ritz_path.len or ritz_path.get(i) == ':'
            if i > start
                h = fnv1a_mix_dir(h, ritz_path.skip(start).take(i - start))
                if h == 0
                    return 0
            start = i + 1
        i = i + 1

    # The source's directory, the one the resolver probes first (path_dir).
    let dir: StrView = path_dir(input_path)
    h = fnv1a_mix_bytes(fnv1a_mix_u64(h, 3), dir)
    if not dir.starts_with("/")
        h = fnv1a_mix_cwd(h)
    h = fnv1a_mix_dir(h, dir)

    # `--dep` entries: `name=dir`, `:`-separated (main.ritz checks each has
    # its `=`).  The name by its bytes, the dir as a RITZ_PATH entry is.
    if deps.len > 0
        h = fnv1a_mix_u64(h, 5)
        var ds: i64 = 0
        var di: i64 = 0
        while di <= deps.len
            if di == deps.len or deps.get(di) == ':'
                var eq: i64 = ds
                while eq < di and deps.get(eq) != '='
                    eq = eq + 1
                h = fnv1a_mix_bytes(h, deps.skip(ds).take(eq - ds))
                if eq + 1 < di
                    h = fnv1a_mix_dir(h, deps.skip(eq + 1).take(di - eq - 1))
                    if h == 0
                        return 0
                ds = di + 1
            di = di + 1
    if stack_protector != 0
        h = fnv1a_mix_u64(h, 6)
    if no_red_zone != 0
        h = fnv1a_mix_u64(h, 7)
    # A freestanding --target's stops call ritz_platform_fatal (#4607).
    if freestanding != 0
        h = fnv1a_mix_u64(h, 8)
    if h == 0
        h = 1
    return h

# Fold `bytes` into `h`, length first, so adjacent fields cannot alias.
fn fnv1a_mix_bytes(h: u64, bytes: StrView) -> u64
    var acc: u64 = fnv1a_mix_u64(h, bytes.len as u64)
    if bytes.len > 0
        acc = fnv1a_mix_u64(acc, fnv1a_bytes(bytes))
    return acc

# Fold the canonical current directory into `h`.
fn fnv1a_mix_cwd(h: u64) -> u64
    var cwd: String = string_new()
    push_canonical_path(@cwd, ".")
    let acc: u64 = fnv1a_mix_bytes(fnv1a_mix_u64(h, 4), cwd.as_view())
    return acc

# Fold the canonical path of the directory `dir` into `h`.  A
# directory that does not exist resolves no import, so it is left out exactly
# like an absent entry; once created it contributes its path, so the
# fingerprint changes.
fn fnv1a_mix_dir(h: u64, dir: StrView) -> u64
    var canon: String = string_new()
    var acc: u64 = h
    if push_canonical_path(@canon, dir) == 1
        acc = fnv1a_mix_bytes(fnv1a_mix_u64(acc, 1), canon.as_view())
    return acc

# Fold the 8 little-endian bytes of `v` into an in-progress FNV1a-64 state.
fn fnv1a_mix_u64(h: u64, v: u64) -> u64
    var acc: u64 = h
    var x: u64 = v
    var i: i32 = 0
    while i < 8
        acc = fnv1a_byte(acc, (x & 255) as u8)
        x = x >> 8
        i = i + 1
    return acc

# Format a u64 as exactly 16 lowercase hex chars.  Caller provides a
# >= 16-byte buffer; we do NOT null-terminate (caller may extend).
pub fn u64_to_hex16(h: u64, out: *u8)
    var v: u64 = h
    var i: i32 = 15
    while i >= 0
        let nib: u64 = v & 15
        var c: u8 = 0
        if nib < 10
            c = (nib + 48) as u8       # '0' = 48
        else
            c = (nib - 10 + 97) as u8  # 'a' = 97
        *(out + i) = c
        v = v >> 4
        i = i - 1

# Parse a 16-hex-char string back to u64.  Returns 0 on malformed input
# (only `[0-9a-fA-F]` accepted).  Stops at the first non-hex byte or after 16.
pub fn hex16_to_u64(s: StrView) -> u64
    var v: u64 = 0
    var i: i64 = 0
    while i < 16 and i < s.len
        let c: u8 = s.get(i)
        var d: u64 = 0
        if c >= '0' and c <= '9'           # '0'-'9'
            d = (c - 48) as u64
        else if c >= 'a' and c <= 'f'     # 'a'-'f'
            d = (c - 97 + 10) as u64
        else if c >= 'A' and c <= 'F'      # 'A'-'F'
            d = (c - 65 + 10) as u64
        else
            return v
        v = (v << 4) | d
        i = i + 1
    return v


# ============================================================================
# Sig file location
# ============================================================================

# Append the cache root (see the header) to `out`.
fn push_cache_root(out: *String)
    let explicit: StrView = env_get_or("RITZ_CACHE_DIR", strview_empty())
    if explicit.len > 0
        out.push_span(Span<u8> { ptr: (explicit.ptr), len: (explicit.len) as i64 })
        return
    let xdg: StrView = env_get_or("XDG_CACHE_HOME", strview_empty())
    if xdg.len > 0
        out.push_span(Span<u8> { ptr: (xdg.ptr), len: (xdg.len) as i64 })
        out.push_str("/ritz")
        return
    let home: StrView = env_get_or("HOME", strview_empty())
    if home.len > 0
        out.push_span(Span<u8> { ptr: (home.ptr), len: (home.len) as i64 })
        out.push_str("/.cache/ritz")
        return
    out.push_str("/tmp/ritz-cache")

# Append this compiler's namespace — the basename of the running binary —
# to `out`.  ritz1 and ritz1_selfhosted are different binaries with different
# compiler hashes; sharing one namespace would have them evict each other on
# every alternation, which is the #1280 problem again one level down.
fn push_compiler_namespace(out: *String)
    match read_link("/proc/self/exe")
        Ok(exe) =>
            let base: StrView = path_basename(exe.as_view())
            if base.len == 0
                out.push_str("ritz1")
            else
                out.push_str(base)
        Err(e) => out.push_str("ritz1")

# Append the canonical absolute path of the existing file `path` to `out`.
# Returns 1 on success, 0 if the file cannot be opened.
#
# The kernel does the canonicalising: open the file and read back
# /proc/self/fd/<n>, which has symlinks, `.` and `..` already resolved —
# the same answer as Python's os.path.realpath, which ritz0 uses.
pub fn push_canonical_path(out: *String, path: StrView) -> i32
    var file: Fd = fd_open(path, O_RDONLY, 0).unwrap_or(fd_adopt(-1))
    if not file.valid()
        return 0
    var link: String = string_from("/proc/self/fd/")
    link.push_i64(file.raw() as i64)
    let target: Result<String, Errno> = read_link(link.as_view())
    file.close()
    match target
        Ok(t) =>
            if t.len() == 0
                return 0
            out.push_str(t.as_view())
            return 1
        Err(e) => return 0

# The sig path for `src_path` (see the header), or an empty String when the
# source cannot be canonicalised — callers then neither read nor write a sig.
pub fn sig_path_from_src(src_path: StrView) -> String
    var s: String = string_new()
    push_cache_root(@s)
    s.push('/')
    push_compiler_namespace(@s)
    # The canonical path starts with '/', which separates it from the namespace.
    if push_canonical_path(@s, src_path) == 0
        s.clear()
        return s
    s.push_str(".sig")
    return s

# Build "<sig_path>.tmp.<pid>" — used for atomic writes.  The pid keeps two
# concurrent compiles of one source (xdist workers, parallel gates) from
# writing into each other's temp file.
fn sig_tmp_path(sig_path: StrView) -> String
    var s: String = string_from_strview(sig_path)
    s.push_str(".tmp.")
    s.push_i64(sys_getpid() as i64)
    return s

# `mkdir -p` the directory part of `path`.  Errors (EEXIST included) are
# ignored: if a directory really is missing, the write that follows fails
# and the caller handles that.
fn mkdir_parents(path: StrView)
    var i: i64 = 1
    while i < path.len
        if *(path.ptr + i) == '/'
            mkdir(path.take(i), 493)   # 0755
        i = i + 1


# ============================================================================
# In-memory sig representation
# ============================================================================

struct SigData
    source_hash:   u64
    # Cached whole-module LLVM IR (the entire output .ll), so the fast path
    # can recreate an output the orchestrator deleted.  Empty = no cache.
    # Owned: a sig_copy_view copy that sig_data_free frees.
    module_ir:     StrView
    # FNV1a-64 of the compiler binary + target OS + import search path that
    # produced `module_ir` (AGAST #1279).  0 means "unknown" and never matches.
    compiler_hash: u64
    # Transitive imports: canonical path (a heap copy) and content hash.
    dep_paths:     *StrView
    dep_hashes:    *u64
    dep_count:     i32
    dep_cap:       i32
    # 1 when the sig carried an `import_hashes` record.  A sig without one
    # cannot vouch for its imports and is never reused.
    has_deps:      i32
    # Candidates import resolution probed and missed (AGAST #2030): absolute
    # path (a heap copy) and its FNV1a-64, which only speeds up de-duping.
    miss_paths:    *StrView
    miss_hashes:   *u64
    miss_count:    i32
    miss_cap:      i32
    # 1 when the record is complete: read from a well-formed `import_misses`,
    # or taken from a compile that recorded every miss.  A sig without one
    # cannot vouch for its misses and is never reused.
    has_misses:    i32

# Allocate a fresh empty SigData on the heap.
pub fn sig_data_new() -> *SigData
    let sd: *SigData = malloc(sizeof(SigData)) as *SigData
    if sd == null
        return null
    sd.source_hash = 0
    sd.compiler_hash = 0
    sd.module_ir = strview_empty()
    sd.dep_paths = null
    sd.dep_hashes = null
    sd.dep_count = 0
    sd.dep_cap = 0
    sd.has_deps = 0
    sd.miss_paths = null
    sd.miss_hashes = null
    sd.miss_count = 0
    sd.miss_cap = 0
    sd.has_misses = 0
    return sd

fn sig_data_free_deps(sd: *SigData)
    var i: i32 = 0
    while i < sd.dep_count
        let p: StrView = *(sd.dep_paths + i)
        if p.ptr != null
            free(p.ptr)
        i = i + 1
    if sd.dep_paths != null
        free(sd.dep_paths as *u8)
    if sd.dep_hashes != null
        free(sd.dep_hashes as *u8)
    sd.dep_paths = null
    sd.dep_hashes = null
    sd.dep_count = 0
    sd.dep_cap = 0

fn sig_data_free_misses(sd: *SigData)
    var i: i32 = 0
    while i < sd.miss_count
        let p: StrView = *(sd.miss_paths + i)
        if p.ptr != null
            free(p.ptr)
        i = i + 1
    if sd.miss_paths != null
        free(sd.miss_paths as *u8)
    if sd.miss_hashes != null
        free(sd.miss_hashes as *u8)
    sd.miss_paths = null
    sd.miss_hashes = null
    sd.miss_count = 0
    sd.miss_cap = 0

# Free SigData and all owned heap allocations.
pub fn sig_data_free(sd: *SigData)
    if sd == null
        return
    sig_data_free_deps(sd)
    sig_data_free_misses(sd)
    if sd.module_ir.ptr != null
        free(sd.module_ir.ptr)
    free(sd as *u8)

# A heap copy of `v` with a NUL after its last byte, for a SigData to own
# (sig_data_free frees it).  Empty (null ptr) when out of memory.
pub fn sig_copy_view(v: StrView) -> StrView
    let copy: *u8 = malloc(v.len + 1)
    if copy == null
        return strview_empty()
    memcpy(copy, v.ptr, v.len)
    *(copy + v.len) = 0
    StrView { ptr: copy, len: v.len }

# Append a dependency, copying `path_sv`.
fn sig_data_add_dep(sd: *SigData, path_sv: StrView, h: u64)
    if sd.dep_count >= sd.dep_cap
        var new_cap: i32 = sd.dep_cap * 2
        if new_cap < 16
            new_cap = 16
        let np: *StrView = malloc((new_cap as i64) * sizeof(StrView)) as *StrView
        let nh: *u64 = malloc((new_cap as i64) * 8) as *u64
        if np == null or nh == null
            return
        if sd.dep_count > 0
            memcpy(np as *u8, sd.dep_paths as *u8, (sd.dep_count as i64) * sizeof(StrView))
            memcpy(nh as *u8, sd.dep_hashes as *u8, (sd.dep_count as i64) * 8)
        if sd.dep_paths != null
            free(sd.dep_paths as *u8)
        if sd.dep_hashes != null
            free(sd.dep_hashes as *u8)
        sd.dep_paths = np
        sd.dep_hashes = nh
        sd.dep_cap = new_cap
    let copy: StrView = sig_copy_view(path_sv)
    if copy.ptr == null
        return
    *(sd.dep_paths + sd.dep_count) = copy
    *(sd.dep_hashes + sd.dep_count) = h
    sd.dep_count = sd.dep_count + 1

# Append a missed candidate, copying `path_sv`, unless it is
# already listed (one import probes the same candidates from every importer).
# Returns 1 when the path is listed afterwards, 0 if out of memory.
fn sig_data_add_miss(sd: *SigData, path_sv: StrView) -> i32
    let h: u64 = fnv1a_bytes(path_sv)
    var i: i32 = 0
    while i < sd.miss_count
        if *(sd.miss_hashes + i) == h
            if (*(sd.miss_paths + i)).eq(path_sv)
                return 1
        i = i + 1
    if sd.miss_count >= sd.miss_cap
        var new_cap: i32 = sd.miss_cap * 2
        if new_cap < 16
            new_cap = 16
        let np: *StrView = malloc((new_cap as i64) * sizeof(StrView)) as *StrView
        let nh: *u64 = malloc((new_cap as i64) * 8) as *u64
        if np == null or nh == null
            return 0
        if sd.miss_count > 0
            memcpy(np as *u8, sd.miss_paths as *u8, (sd.miss_count as i64) * sizeof(StrView))
            memcpy(nh as *u8, sd.miss_hashes as *u8, (sd.miss_count as i64) * 8)
        if sd.miss_paths != null
            free(sd.miss_paths as *u8)
        if sd.miss_hashes != null
            free(sd.miss_hashes as *u8)
        sd.miss_paths = np
        sd.miss_hashes = nh
        sd.miss_cap = new_cap
    let copy: StrView = sig_copy_view(path_sv)
    if copy.ptr == null
        return 0
    *(sd.miss_paths + sd.miss_count) = copy
    *(sd.miss_hashes + sd.miss_count) = h
    sd.miss_count = sd.miss_count + 1
    return 1


# ============================================================================
# Dependency record for the compile in progress
# ============================================================================
#
# main.ritz's import resolver calls `dep_record_note()` for every file it
# loads, with the exact bytes this compile saw of it — so the hash describes
# what this compile actually saw, not what is on disk by the time the sig is
# written.  The record is moved into the outgoing sig by `sig_take_deps()`.
#
# Those bytes are the import's interface text (AGAST #2113), the one parsed
# or the one stored on a miss: all the importer's IR depends on.  So an edit
# of an import that keeps its text (a body edit that moves no line) keeps
# the importer's sig.  Only when no text could be stored are they the
# source's: sig_deps_unchanged accepts either.
#
# It also calls `dep_record_miss()` for every candidate it probes and misses
# before a hit (AGAST #2030).

var g_dep_record: *SigData
# 1 once a miss could not be recorded: the record is then incomplete, and
# the outgoing sig carries no `import_misses`, so it is never reused.
var g_miss_lost: i32

pub fn dep_record_reset()
    if g_dep_record != null
        sig_data_free(g_dep_record)
    g_dep_record = null
    g_miss_lost = 0

# Record that import resolution probed `path` and found nothing there.  A
# relative path is made absolute against the current directory, which is
# where the resolver's probe looked.
pub fn dep_record_miss(path: StrView)
    if g_dep_record == null
        g_dep_record = sig_data_new()
        if g_dep_record == null
            g_miss_lost = 1
            return
    var abs: String = string_new()
    if path.len == 0 or *(path.ptr) != '/'
        if push_canonical_path(@abs, ".") == 0
            g_miss_lost = 1
            return
        abs.push('/')
    abs.push_str(path)
    if sig_data_add_miss(g_dep_record, abs.as_view()) == 0
        g_miss_lost = 1

pub fn dep_record_note(path: StrView, data: StrView)
    if g_dep_record == null
        g_dep_record = sig_data_new()
        if g_dep_record == null
            return
    var canon: String = string_new()
    if push_canonical_path(@canon, path) == 1
        sig_data_add_dep(g_dep_record, canon.as_view(), fnv1a_bytes(data))
    else
        # Unresolvable: record it under a path that can never be read back,
        # so the next fast-path check fails closed.
        sig_data_add_dep(g_dep_record, "", 0)

# Move the recorded dependencies into `sd` and mark it as carrying them
# (a compile with no imports legitimately records none).
pub fn sig_take_deps(sd: *SigData)
    sig_data_free_deps(sd)
    sig_data_free_misses(sd)
    sd.has_deps = 1
    sd.has_misses = 1
    if g_miss_lost == 1
        sd.has_misses = 0
    if g_dep_record == null
        return
    sd.miss_paths = g_dep_record.miss_paths
    sd.miss_hashes = g_dep_record.miss_hashes
    sd.miss_count = g_dep_record.miss_count
    sd.miss_cap = g_dep_record.miss_cap
    g_dep_record.miss_paths = null
    g_dep_record.miss_hashes = null
    g_dep_record.miss_count = 0
    g_dep_record.miss_cap = 0
    sd.dep_paths = g_dep_record.dep_paths
    sd.dep_hashes = g_dep_record.dep_hashes
    sd.dep_count = g_dep_record.dep_count
    sd.dep_cap = g_dep_record.dep_cap
    g_dep_record.dep_paths = null
    g_dep_record.dep_hashes = null
    g_dep_record.dep_count = 0
    g_dep_record.dep_cap = 0


# ============================================================================
# File helpers
# ============================================================================

# Read entire file into a malloced buffer.  Returns null on missing/empty.
# Sets `*out_len` to the number of bytes read.
fn read_file_to_buf(path: StrView, out_len: *i64) -> *u8
    *out_len = 0
    var file: Fd = fd_open(path, O_RDONLY, 0).unwrap_or(fd_adopt(-1))
    if not file.valid()
        return null
    # The open file's size.  It is only an upper bound: the file can shrink
    # before we read it.
    var sz: i64 = 0
    match file.stat()
        Ok(st) => sz = st.st_size
        Err(e) => sz = 0
    var bytes: Vec<u8> = read_fd_to_vec(@file, sz)
    file.close()
    if bytes.len == 0
        return null
    # Hand the buffer to the caller, who frees it.
    *out_len = bytes.len
    let buf: *u8 = bytes.data
    bytes.data = null
    buf

# Every byte of the open `file`, read to EOF, with a NUL past the last
# one (in the capacity, not counted in `len`).  Capacity starts at
# `size_hint`.  Empty when the file is, when the hint is not positive, or
# when a read fails.  Does not close `file`.
fn read_fd_to_vec(file: @Fd, size_hint: i64) -> Vec<u8>
    var bytes: Vec<u8> = vec_new<u8>()
    if size_hint <= 0 or not bytes.grow(size_hint + 1)
        return bytes
    # `size_hint` is only a first guess at capacity: the file can also be
    # LARGER than stat said (under valgrind, whenever ritz1 outgrows
    # memcheck), so read to EOF and grow the buffer, or the fingerprint
    # hashes a prefix and differs from the native run (AGAST #2414).
    # Report only the bytes actually read.  This used to claim `sz` bytes on
    # EOF/error, an uninitialised tail as file contents, so the compiler
    # fingerprint hashed garbage (AGAST #1663).
    var done: bool = false
    while not done
        if bytes.len + 1 == bytes.cap and not bytes.grow(bytes.cap * 2)
            bytes.clear()
            return bytes
        let n: i64 = file.read(Span<u8> { ptr: bytes.data + bytes.len, len: bytes.cap - 1 - bytes.len }).unwrap_or(-1)
        if n < 0
            bytes.clear()
            return bytes
        if n == 0
            done = true     # EOF: the file is shorter than stat said
        else
            bytes.len = bytes.len + n
    *(bytes.data + bytes.len) = 0
    bytes

# ============================================================================
# Sig parsing (read)
# ============================================================================

# Parse a sig file.  Returns null on missing/corrupt/structurally unexpected —
# the caller treats null as "no cache, cold start".
pub fn read_sig_file(sig_path: StrView) -> *SigData
    var sz: i64 = 0
    let buf: *u8 = read_file_to_buf(sig_path, @sz)
    if buf == null or sz <= 0
        return null

    let parsed: Result<Json, JsonError> = json_parse(strview_from_ptr(buf, sz))
    free(buf)
    match parsed
        Ok(root) => return sig_read_root(@root)
        Err(e) => return null

# The SigData for parsed document `root`, or null if it is not an object.
fn sig_read_root(root: @Json) -> *SigData
    match *root
        Object(_) => pass
        _ => return null

    let sd: *SigData = sig_data_new()
    if sd == null
        return null

    sd.source_hash = sig_hex_field(root, "source_hash")

    # Absent -> stays 0, and every reuse check fails closed.
    sd.compiler_hash = sig_hex_field(root, "compiler_hash")

    match sig_str_field(root, "module_ir")
        Some(ir) =>
            if ir.len > 0
                sd.module_ir = sig_copy_view(ir)
        None => pass

    match root.get_field("import_hashes")
        Some(ih) =>
            if sig_is_object(ih)
                sig_parse_deps(sd, ih)
        None => pass

    match root.get_field("import_misses")
        Some(im) =>
            if sig_is_array(im)
                sig_parse_misses(sd, im)
        None => pass

    return sd

fn sig_is_object(v: @Json) -> bool
    match *v
        Object(_) => return true
        _ => return false

fn sig_is_array(v: @Json) -> bool
    match *v
        Array(_) => return true
        _ => return false

# Field `key` of `root` as a string, or None if absent or not a string:
# a missing field and a wrong-kind one take the same path.
fn sig_str_field(root: @Json, key: StrView) -> Option<StrView>
    match root.get_field(key)
        Some(v) =>
            let j: @Json = v
            return j.get_string()
        None => return None

# Field `key` as a hex hash; 0 if absent or not a string.
fn sig_hex_field(root: @Json, key: StrView) -> u64
    match sig_str_field(root, key)
        Some(s) => return hex16_to_u64(s)
        None => return 0

# Fill `sd`'s missed candidates from the `import_misses` array.  Any entry
# that is not a non-empty string, or that cannot be stored, leaves the record
# incomplete (`has_misses == 0`), so the sig is not reused.
fn sig_parse_misses(sd: *SigData, arr: @Json)
    let n: i64 = arr.array_len()
    var i: i64 = 0
    while i < n
        match arr.get_index(i)
            Some(item) =>
                let j: @Json = item
                match j.get_string()
                    Some(s) =>
                        if s.len <= 0
                            return
                        if sig_data_add_miss(sd, s) == 0
                            return
                    None => return
            None => return
        i = i + 1
    sd.has_misses = 1

# Fill `sd`'s dependencies from the `import_hashes` object.  An entry that is
# not a string hash is recorded with hash 0, which no real file matches.
fn sig_parse_deps(sd: *SigData, obj: @Json)
    sd.has_deps = 1
    let members: Span<JsonMember> = obj.members()
    var i: i64 = 0
    while i < members.len
        let m: *JsonMember = members.get_ptr(i)
        var h: u64 = 0
        match m.value.get_string()
            Some(s) => h = hex16_to_u64(s)
            None => pass
        sig_data_add_dep(sd, m.key.as_view(), h)
        i = i + 1


# ============================================================================
# Sig emission (write)
# ============================================================================

# A sig string: `"..."`, escaped by ritzlib.json.  Length-driven, so an IR
# blob with arbitrary bytes round-trips through read_sig_file's json_parse.
fn emit_sig_string(buf: *Vec<u8>, s_sv: StrView)
    json_emit_bytes(Span<u8> { ptr: (s_sv.ptr), len: (s_sv.len) }, buf)

# `h` as a quoted 16-digit lowercase hex string, the form hex16_to_u64 reads.
fn emit_hex16(buf: *Vec<u8>, h: u64)
    var hex: [16]u8
    u64_to_hex16(h, @hex[0])
    buf.push(34)        # '"'
    buf.push_bytes(@hex[0], 16)
    buf.push(34)

fn emit_hex16_field(buf: *Vec<u8>, key: StrView, h: u64)
    buf.push_view(key)
    buf.push_view(": ")
    emit_hex16(buf, h)

# Serialize SigData as JSON into a Vec<u8> (indent=2 + trailing newline).
fn sig_serialize(sd: *SigData, buf: *Vec<u8>)
    buf.push_view("{\n")
    emit_hex16_field(buf, "  \"source_hash\"", sd.source_hash)
    buf.push_view(",\n")
    emit_hex16_field(buf, "  \"compiler_hash\"", sd.compiler_hash)
    buf.push_view(",\n")

    # Always present (null when empty) so the shape is fixed.
    buf.push_view("  \"module_ir\": ")
    if sd.module_ir.ptr != null and sd.module_ir.len > 0
        emit_sig_string(buf, sd.module_ir)
    else
        let _: bool = buf.push_view("null")
    buf.push_view(",\n")

    buf.push_view("  \"import_hashes\": {")
    if sd.dep_count == 0
        buf.push_view("}")
    else
        buf.push(10)       # '\n'
        var i: i32 = 0
        while i < sd.dep_count
            buf.push_view("    ")
            emit_sig_string(buf, *(sd.dep_paths + i))
            buf.push_view(": ")
            emit_hex16(buf, *(sd.dep_hashes + i))
            if i + 1 < sd.dep_count
                buf.push(44)   # ','
            buf.push(10)
            i = i + 1
        buf.push_view("  }")

    # Omitted when the record is incomplete, so the sig is never reused.
    if sd.has_misses == 1
        buf.push_view(",\n  \"import_misses\": [")
        var j: i32 = 0
        while j < sd.miss_count
            buf.push_view("\n    ")
            emit_sig_string(buf, *(sd.miss_paths + j))
            if j + 1 < sd.miss_count
                buf.push(44)   # ','
            j = j + 1
        if sd.miss_count > 0
            buf.push_view("\n  ")
        buf.push(93)           # ']'
    buf.push_view("\n}\n")

# Atomic write: serialize, then write_file_atomic.  Creates the sig's
# directory first.  Returns 0 on success, -1 on failure.
pub fn write_sig_file(sig_path: StrView, sd: *SigData) -> i32
    if sd == null or sig_path.len == 0
        return -1
    mkdir_parents(sig_path)
    var buf: Vec<u8> = vec_with_cap<u8>(8192)
    sig_serialize(sd, @buf)
    return write_file_atomic(sig_path, buf.as_view())

# Write `data` to "<path>.tmp.<pid>" and rename it over `path`, so a reader
# sees the old file or the whole new one, never a torn one.  The directory
# must exist.  Returns 0 on success, -1 on failure.
fn write_file_atomic(path: StrView, data: StrView) -> i32
    var tmp: String = sig_tmp_path(path)
    var file: Fd = fd_open(tmp.as_view(), O_WRONLY + O_CREAT + O_TRUNC, 420).unwrap_or(fd_adopt(-1))
    if not file.valid()
        return -1
    let wrote: bool = file.write_all(Span<u8> { ptr: data.ptr, len: data.len }).is_ok()
    file.close()
    if not wrote or rename(tmp.as_view(), path).is_err()
        unlink(tmp.as_view())
        return -1
    return 0


# ============================================================================
# File-level fast path
# ============================================================================

# 1 if the interface text of the source bytes `src` hashes to `want`
# (AGAST #2113): the stored one, else derived here (lexed, not parsed, so
# not stored: ritz0 and load_and_parse store only a text whose source parses).
fn dep_text_matches(src: StrView, want: u64) -> i32
    var path: String = iface_text_path(src)
    var tsz: i64 = 0
    var text: *u8 = null
    if path.len() > 0
        text = read_file_to_buf(path.as_view(), @tsz)
    var h: u64 = 0
    if text != null
        h = fnv1a_bytes(StrView { ptr: (text), len: (tsz) })
        free(text)
    else
        var made: Vec<u8> = vec_new<u8>()
        if iface_text_derive(src, @&made) < 0
            return 0
        h = fnv1a_bytes(made.as_view())
    if h == want
        return 1
    0

# 1 when every dependency recorded in `sd` still has the recorded content:
# its source unchanged, or the interface text stored for its current source
# the recorded one (dep_record_note).  A sig with no record at all
# (`has_deps == 0`) answers 0.  An unreadable or empty dependency, or a
# changed one whose text can't be derived, also answers 0: failing closed
# costs one recompile.
fn sig_deps_unchanged(sd: *SigData) -> i32
    if sd.has_deps == 0
        return 0
    var i: i32 = 0
    while i < sd.dep_count
        var sz: i64 = 0
        let buf: *u8 = read_file_to_buf(*(sd.dep_paths + i), @sz)
        if buf == null
            return 0
        let src: StrView = StrView { ptr: buf, len: sz }
        let want: u64 = *(sd.dep_hashes + i)
        var same: i32 = 0
        if fnv1a_bytes(src) == want
            same = 1
        else
            same = dep_text_matches(src, want)
        free(buf)
        if same == 0
            return 0
        i = i + 1
    return 1

# 1 when every candidate import resolution missed last time is still missing
# (AGAST #2030).  A sig with no complete record answers 0.  "Missing" is the
# resolver's own test: `try_open_import` takes the first candidate that opens.
fn sig_misses_absent(sd: *SigData) -> i32
    if sd.has_misses == 0
        return 0
    var i: i32 = 0
    while i < sd.miss_count
        var file: Fd = fd_open(*(sd.miss_paths + i), O_RDONLY, 0).unwrap_or(fd_adopt(-1))
        if file.valid()
            file.close()
            return 0
        i = i + 1
    return 1

# Returns 1 when the requested compilation can be skipped — either:
#   (a) <ll_path> holds exactly the sig's `module_ir` and its mtime is >= the
#       source's, or
#   (b) we WRITE the sig's `module_ir` to <ll_path> here.
# Returns 0 if the caller must do a full compile.
#
# BOTH branches are gated on the sig's source hash, its compiler identity
# (`self_fp` is `cache_fingerprint()`; AGAST #1279) and its import hashes
# (AGAST #1807) and missed candidates (AGAST #2030).  Gating only (a) would be worse than useless — (b) is the
# branch that *materialises* stale IR, re-creating a `.ll` that make had
# just deleted and filling it with output that no longer matches the inputs.
pub fn check_source_unchanged(src_path: StrView, src_sv: StrView, ll_path: StrView, self_fp: u64) -> i32
    var src: *u8 = src_sv.ptr
    if src_path.len == 0 or ll_path.len == 0 or src == null
        return 0

    var sig_path: String = sig_path_from_src(src_path)
    if sig_path.is_empty()
        return 0
    let sd: *SigData = read_sig_file(sig_path.as_view())
    if sd == null
        return 0

    let cur: u64 = source_file_hash(src_sv)
    if cur != sd.source_hash
        sig_data_free(sd)
        return 0

    # Compiler identity.  `self_fp` is 0 when /proc/self/exe is unreadable and
    # `sd.compiler_hash` is 0 for sigs with no such field, so the explicit
    # `== 0` rejection stops two unknowns from comparing equal.
    if self_fp == 0 or sd.compiler_hash == 0 or sd.compiler_hash != self_fp
        sig_data_free(sd)
        return 0

    # Every transitive import must be byte-identical to what was compiled.
    if sig_deps_unchanged(sd) == 0
        sig_data_free(sd)
        return 0

    # ...and must still resolve to those files: no new file may have appeared
    # at a candidate probed before one of them (AGAST #2030).
    if sig_misses_absent(sd) == 0
        sig_data_free(sd)
        return 0

    # Everything above vouches for `module_ir`, not for whatever is at
    # `ll_path`; with no IR there is nothing to vouch for (AGAST #2023).
    if sd.module_ir.ptr == null or sd.module_ir.len <= 0
        sig_data_free(sd)
        return 0

    # Path (a): the requested .ll already holds exactly that IR, and is
    # newer than the source, so make sees it as current — leave it alone.
    #
    # The content check is what makes this per-output (AGAST #2023).  The sig
    # is per source, so before it a `.ll` merely NEWER than the source passed:
    # a --test-table compile's output (test mode writes no sig, so the older
    # default-mode sig still matched), another target OS's IR when that OS's
    # compile into a different path had re-stamped the sig, or a file
    # rewritten behind the sig's back.  ritz0 records a per-output
    # {mode, ir_hash} for this (#2020); ritz1's sig already holds the IR
    # itself, under this mode's fingerprint, so a byte comparison is the same
    # check with nothing extra to keep in step.
    if file_equals(ll_path, sd.module_ir) == 1
        if ll_not_older(ll_path, src_path)
            sig_data_free(sd)
            return 1

    # Path (b): the on-disk .ll is missing, different, or older than the
    # source.  Splice the cached IR to the requested output path.
    var file: Fd = fd_open(ll_path, O_WRONLY + O_CREAT + O_TRUNC, 420).unwrap_or(fd_adopt(-1))
    if file.valid()
        let wrote: bool = file.write_all(Span<u8> { ptr: sd.module_ir.ptr, len: sd.module_ir.len }).is_ok()
        file.close()
        if wrote
            sig_data_free(sd)
            return 1

    sig_data_free(sd)
    return 0

# Is the .ll at `ll_path` at least as new as the source at `src_path`?  False
# when either cannot be stat'ed.
fn ll_not_older(ll_path: StrView, src_path: StrView) -> bool
    match stat(ll_path)
        Ok(ll_st) =>
            match stat(src_path)
                Ok(src_st) =>
                    if ll_st.st_mtime != src_st.st_mtime
                        return ll_st.st_mtime > src_st.st_mtime
                    return ll_st.st_mtime_ns >= src_st.st_mtime_ns
                Err(e) => return false
        Err(e) => return false

# 1 when the file at `path` holds exactly `data[0..len)`, else 0.
fn file_equals(path: StrView, data_sv: StrView) -> i32
    var data: *u8 = data_sv.ptr
    var len: i64 = data_sv.len
    var sz: i64 = 0
    let buf: *u8 = read_file_to_buf(path, @sz)
    if buf == null
        return 0
    var same: i32 = 0
    if sz == len and memcmp(buf, data, len) == 0
        same = 1
    free(buf)
    return same
