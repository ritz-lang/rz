# ritz1/src/discarded_array.ritz - an array field alone as a statement
#
# AGAST #3189.  A whole array is no value: an array field used alone as a
# statement does nothing, so it is refused in #2287's words, at the member.
#
#     struct W
#         a: [2]i32
#     fn f(w: W) -> i32
#         w.a         # error: a whole array is not a value here (...)
#         0
#
# A local, a `:&` param and `*p` are refused where the emitter lowers them
# (emit_expr_ident, emit_unary's deref); a field was loaded whole and thrown
# away.  ritz0 and the rule's own tests: test_array_statement.py.
#
# The statements judged are ritz0's ExprStmts: sema_walk calls this for a
# StmtKind.Expr with a next statement, for the tail of a fn or method that
# returns nothing, and for an arm's last statement before its value (AGAST
# #3920).  LARB R69 (AGAST #3968): also the tail of a block that is no value
# (a loop body, a branch of an `if` used as a statement, else-less always)
# and the value of an arm of an `if` / `match` used as a statement.
#
# Moved off the emitter onto Sema (AGAST #3512, #1816; the #3462 pattern).

import ritzlib.sys
import ritzlib.io

import ast
import ast_helpers
import sema
import deref_field

# Report `e`, a discarded statement's expression, if it is an array field.
pub fn discarded_array_check(sm: *Sema, e: *Expr)
    if e == null or e.kind != ExprKind.Member
        return
    let f: *StructField = df_member_field(sm, e)
    if f == null or f.field_type != TypeKind.Array
        return
    sema_error_at(sm, e.span.line, e.span.col)
    eprints("a whole array is not a value here (index it, copy it into an array of the same type, or take its address with @)\n")

# LARB R69 (AGAST #3968): `e`, a discarded statement's expression, judged
# through an `if` / `match` expression's arms (`if c then w.a else w.b`), as
# ritz0's _infer_arm judges a dropped one's.  Only for a statement's own
# expression: sema_walk_arms judges the arms of one nested in a discarded arm.
pub fn discarded_array_check_value(sm: *Sema, e: *Expr)
    if e == null
        return
    if e.kind != ExprKind.If and e.kind != ExprKind.Match
        discarded_array_check(sm, e)
        return
    var arm: *MatchArm = e.args as *MatchArm
    while arm != null
        if arm.is_pass == 0
            discarded_array_check_value(sm, arm.body)
        arm = arm.next
