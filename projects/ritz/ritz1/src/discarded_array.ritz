# ritz1/src/discarded_array.ritz - an array field alone as a statement
#
# AGAST #3189.  A whole array is no value: an array field used alone as a
# statement does nothing, so it is refused in #2287's words, at the member.
#
#     struct W
#         a: [2]i32
#     fn f(w: W) -> i32
#         w.a         # error: a whole array is not a value here (...)
#         0
#
# A local, a `:&` param and `*p` are refused where the emitter lowers them
# (emit_expr_ident, emit_unary's deref); a field was loaded whole and thrown
# away.  ritz0 and the rule's own tests: test_array_statement.py.
#
# The statements judged are the emitter's: sema_walk calls this for a
# STMT_EXPR with a next statement, and for the tail of a fn or method that
# returns nothing.  The last statement of an inner block (an `if` body, a
# match arm before its value) was never judged; that gap is AGAST #3920.
#
# Moved off the emitter onto Sema (AGAST #3512, #1816; the #3462 pattern).

import ritzlib.sys
import ritzlib.io

import ast
import ast_helpers
import emitter_core
import sema
import deref_field

# Report `e`, a discarded statement's expression, if it is an array field.
pub fn discarded_array_check(sm: *Sema, e: *Expr)
    if e == null or e.kind != EXPR_MEMBER
        return
    let f: *StructField = df_member_field(sm, e)
    if f == null or f.field_type != TYPE_ARRAY
        return
    sema_error_at(sm, e.span.line, e.span.col)
    eprints_cstr(c"a whole array is not a value here (index it, copy it into an array of the same type, or take its address with @)\n")
