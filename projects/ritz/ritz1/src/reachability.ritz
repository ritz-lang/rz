# reachability.ritz - code that can never run is refused (AGAST #2520)
#
# LARB ruling (Aaron, 2026-11-15), extending R13 from match arms to statements:
#
#     fn g(b: i32) -> i32
#         if b > 0
#             return 1
#         else
#             return 2
#         0               # error: unreachable code
#
# A statement can never run when it follows, in the same block, one that never
# lets control past it: a `return`, `break` or `continue`; an `if`/`else`
# (else-if chains and nested ifs too) or a `match` whose every arm diverges;
# a `loop`, or a `while` on the literal `true`, with no `break` that leaves it.
# The first such statement of a block is a located error.
#
# This is a port of ritz0/reachability.py.  Unlike tail_value's
# tail_stmt_diverges, a `break` or `continue` counts: this judges what follows
# a statement in its own block, and both leave that block.  Whether a loop
# ends is tail_value's own tail_stmts_have_break, so the two rules agree.
#
# THE DIFFERENCES ARE ALL IN THE AST:
#
#   * A match or if-expression arm holds its statements in `body_stmts` and a
#     trailing bare expression in `body` (match_arm_set_block).  So a dead
#     tail value after an arm's diverging last statement is the arm's `body`.
#   * Only a match or an if expression holds statements, so as in
#     binder_check.ritz only those expressions are walked.
#
# ritz0/test_dead_tail_after_diverging_if.py holds the three compilers to one
# table, positions included.

import ritzlib.sys
import ritzlib.io

import ast
import ast_helpers
import emitter_core
import binder_check
import tail_value

# =============================================================================
# Does control ever get past this?
# =============================================================================

fn reach_stmt_diverges(st: *Stmt) -> i32
    let k: i32 = st.kind
    if k == STMT_RETURN or k == STMT_BREAK or k == STMT_CONTINUE
        return 1
    if k == STMT_LOOP
        return 1 - tail_stmts_have_break(st.while_body)
    if k == STMT_WHILE
        if tail_is_true_literal(st.while_cond) == 0
            return 0
        return 1 - tail_stmts_have_break(st.while_body)
    if k == STMT_IF
        if st.if_else == null or reach_stmts_diverge(st.if_then) == 0
            return 0
        return reach_stmts_diverge(st.if_else)
    if k == STMT_MATCH
        return reach_arms_diverge(st.if_then as *MatchArm)
    if k == STMT_EXPR
        return reach_expr_diverges(st.expr)
    0

# The first statement of `list` that never lets control past it, or null.
fn reach_first_diverging(list: *Stmt) -> *Stmt
    var st: *Stmt = list
    while st != null
        if reach_stmt_diverges(st) == 1
            return st
        st = st.next
    null

fn reach_stmts_diverge(list: *Stmt) -> i32
    (reach_first_diverging(list) != null) as i32

fn reach_arms_diverge(arms: *MatchArm) -> i32
    if arms == null
        return 0
    var arm: *MatchArm = arms
    while arm != null
        var left: i32 = reach_stmts_diverge(arm.body_stmts)
        if left == 0 and arm.body != null
            left = reach_expr_diverges(arm.body)
        if left == 0
            return 0
        arm = arm.next
    1

fn reach_expr_diverges(e: *Expr) -> i32
    if e == null
        return 0
    if e.kind == EXPR_IF or e.kind == EXPR_MATCH
        return reach_arms_diverge(e.args as *MatchArm)
    0

# =============================================================================
# The walk
# =============================================================================

fn reach_report(file: *u8, span: SrcSpan) -> i32
    eprints_cstr(file)
    eprint_char(':')
    eprint_i64(span.line as i64)
    eprint_char(':')
    eprint_i64(span.col as i64)
    eprints_cstr(c": error: unreachable code\n")
    1

fn reach_check_arms(file: *u8, arms: *MatchArm) -> i32
    var errors: i32 = 0
    var arm: *MatchArm = arms
    while arm != null
        errors = errors + reach_check_stmts(file, arm.body_stmts)
        # The arm's trailing value follows its statements in one block.
        let first: *Stmt = reach_first_diverging(arm.body_stmts)
        if first != null and first.next == null and arm.body != null
            errors = errors + reach_report(file, arm.body.span)
        errors = errors + reach_check_expr(file, arm.body)
        arm = arm.next
    errors

fn reach_check_expr(file: *u8, e: *Expr) -> i32
    if e == null
        return 0
    if e.kind == EXPR_MATCH or e.kind == EXPR_IF
        return reach_check_arms(file, e.args as *MatchArm)
    0

# The blocks a statement holds, as binder_check_stmts walks them.
fn reach_check_inner(file: *u8, s: *Stmt) -> i32
    let k: i32 = s.kind
    if k == STMT_VAR_DECL or k == STMT_TUPLE_DECL
        return reach_check_expr(file, s.var_init)
    if k == STMT_FOR
        return reach_check_stmts(file, s.for_body)
    if k == STMT_IF
        let cond: i32 = reach_check_expr(file, s.if_cond)
        return cond + reach_check_stmts(file, s.if_then) + reach_check_stmts(file, s.if_else)
    if k == STMT_WHILE
        return reach_check_expr(file, s.while_cond) + reach_check_stmts(file, s.while_body)
    if k == STMT_LOOP or k == STMT_DEFER
        return reach_check_stmts(file, s.while_body)
    if k == STMT_MATCH
        return reach_check_arms(file, s.if_then as *MatchArm)
    if k == STMT_RETURN
        return reach_check_expr(file, s.return_value)
    if k == STMT_EXPR
        return reach_check_expr(file, s.expr)
    if k == STMT_ASSIGN
        return reach_check_expr(file, s.assign_value)
    0

# A block: its first dead statement is refused, and every block it holds is
# walked, in source order as ritz0 does.
fn reach_check_stmts(file: *u8, first: *Stmt) -> i32
    var errors: i32 = 0
    var reported: i32 = 0
    var s: *Stmt = first
    while s != null
        errors = errors + reach_check_inner(file, s)
        if reported == 0 and s.next != null and reach_stmt_diverges(s) == 1
            errors = errors + reach_report(file, s.next.span)
            reported = 1
        s = s.next
    errors

fn reach_check_fn(path: *u8, f: *FnDef) -> i32
    var file: *u8 = path
    if f.def_file != null
        file = f.def_file
    reach_check_stmts(file, f.body)

# Every dead statement in the fns binder_judges picks, generic templates
# included.  Runs before monomorphisation, so no clone is judged twice.
# Returns how many it refused; the caller stops on any.
pub fn reach_check_module(m: *Module, path: *u8) -> i32
    var errors: i32 = 0
    var f: *FnDef = m.functions
    while f != null
        if binder_judges(f, 0) == 1
            errors = errors + reach_check_fn(path, f)
        f = f.next
    var ib: *ImplBlock = m.impls
    while ib != null
        let generic: i32 = (ib.type_params != null) as i32
        var method: *FnDef = ib.methods
        while method != null
            if binder_judges(method, generic) == 1
                errors = errors + reach_check_fn(path, method)
            method = method.next
        ib = ib.next
    errors
