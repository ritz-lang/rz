# ritz1/src/emitter_core.ritz - Emitter State & Helpers
#
# Types, state, lookup helpers, type emission, member-access GEP.
# Split from emitter.ritz to keep individual files under ~1500 lines.

import ritzlib.sys
import ritzlib.io
import ritzlib.str
import ritzlib.fmt
import ritzlib.gvec
import ritzlib.memory
import ritzlib.hash
import ritzlib.hashmap

import ast
import ast_helpers   # is_enum_type / enum_variant_index (AGAST #1660)
import tokens_gen

# =============================================================================
# Emitter State
# =============================================================================

# Initial capacities of the growable locals table and string-literal list.
# Both double on demand (AGAST #1905); they were fixed inline arrays whose
# overflow was a located fatal error (#1813), while ritz0 has no limit.
const LOCALS_INIT_CAP: i32 = 256
const STRINGS_INIT_CAP: i32 = 4096  # Self-hosting: merged modules have >256 string literals

# A growable list of names (pointer + length), for the extern and emitted-
# name sets.  Those were fixed arrays (2048 / 512) that silently dropped
# entries past the cap (AGAST #1813): a dropped emitted name is emitted twice,
# a dropped extern is never declared.  Parallel arrays rather than an array
# of structs: ritz1 cannot take `@s.p[i]` through a pointer field.
struct NameList
    names: **u8
    lens: *i32
    count: i32
    cap: i32

struct LocalVar
    name: *u8
    name_len: i32
    reg: i32
    var_type: i32
    type_name: *u8       # Struct name when var_type == TYPE_STRUCT
    type_name_len: i32
    pointee_type: i32    # Element type for pointers (e.g., TYPE_U8 for *u8)
    array_size: i32      # Array size when var_type == TYPE_ARRAY
    array_elem_type: i32 # Element type when var_type == TYPE_ARRAY
    # AGAST #1521: 1 for a local declared `: bool`. emit_var_decl stores bools
    # in an i64 slot and records var_type TYPE_I64, so this is the only place
    # that remembers the declared type (print interpolation prints a bool as
    # true/false).
    is_bool: i32
    # AGAST #2341: T for a local `[N]*T`; TYPE_VOID otherwise.
    array_elem_pointee: i32
    # AGAST #2342: 1 for an unannotated `let x = init` whose init bool_kind can't
    # type.  var_type then says nothing: the parser defaulted it to TYPE_I64.
    bk_unsure: i32
    # AGAST #1671: signature of a `fn(...) -> T`-typed local or param (null
    # otherwise); emit_call uses it for `call <ret> %f(<params>)`.
    fn_sig: *FnDef
    # AGAST #1815: innermost pointee of a `**T` local/param (TYPE_U8 for
    # `**u8`); TYPE_VOID otherwise.  pointee_type is TYPE_PTR for every **T.
    inner_pointee_type: i32
    # AGAST #2028: 1 for a `let` binding (set by emit_stmt from
    # Stmt.var_is_let).  add_local_full clears it, so a `var`, param, loop or
    # match binding that shadows a `let` is mutable.  See let_check.ritz.
    is_let: i32
    # AGAST #2335: 1 for an un-annotated `let` that holds an `@T`.  var_type can't
    # say: `let p = @n` stays an i64, as `let x: i64 = @n` must, and `let p = @c`
    # is a TYPE_PTR.  See let_holds_shared_ref.
    holds_shared_ref: i32
    # AGAST #1953: for a `*[N]T` local or param (pointee_type == TYPE_ARRAY),
    # N and T; 0 / TYPE_VOID otherwise.  A struct T is named by type_name.
    # Read by emit_array_field_copy_from for `x.f = *src`.
    pointee_array_size: i32
    pointee_array_elem_type: i32
    pointee_array_elem_pointee: i32   # AGAST #2343: U for `*[N]*U`
    # AGAST #1509: every dimension of a `var g: [N][M]..T` local (array_size
    # and array_elem_type then hold N and TYPE_ARRAY); null otherwise.
    array_shape: *ArrayShape
    # AGAST #2250: 1 for a `name:& T` param whose T is an integer, a struct or
    # an array (#2279), which ritz0's `_borrow_referent_slot` covers.  `@&T`
    # params stay 0.  add_local_full clears it: the next function reuses these
    # entries.
    # An integer T binds as a plain T local (bind_scalar_borrow_param) and any
    # other T reads as the pointer, so the slot a value goes to decides what to
    # do; see emit_lent_referent and lent_array_local.
    is_lent: i32
    # AGAST #2286: 1 for a `:&` param whose slot holds the borrow's pointer, so
    # the place `@x` names is behind that pointer, not the slot.  Not is_lent:
    # that covers an integer, whose slot IS the caller's variable, and leaves
    # out `:& f64`, `:& bool` and `:& **C`.  `p:& *T` stays 0 as well: its slot
    # is the caller's pointer variable.  A receiver not declared as a reference
    # is 1 too, because `self` is always passed as a `ptr`.  See mark_lent_param.
    holds_lent_ptr: i32
    # AGAST #2340: 1 for a `:&` param, whatever its T, and a by-value `self`: what
    # `@x` names may be the caller's, so x isn't a local root.  See ref_mark_params.
    is_caller_place: i32
    # AGAST #2340: the local root this binding definitely refers to, null if
    # none, how many loops it was declared in, and what it points at, which an
    # un-annotated `let` keeps nowhere else.  See ref_after_stmt.
    ref_root: *u8
    ref_root_len: i32
    ref_root_loops: i32
    ref_root_pointee: i32
    ref_root_name: *u8
    ref_root_name_len: i32

# A let/var seen so far in the current function, with the integer type its
# annotation WROTE (NARROW_UNKNOWN when unannotated or not an integer).
struct NarrowDecl
    name: *u8
    name_len: i32
    decl_type: i32
    # AGAST #2124: what the declaration wrote, for `sizeof(local)`: the
    # annotation (Stmt.var_declared_type, TYPE_VOID when there is none) and
    # the initialiser (null when there is none).
    declared: i32
    init: *Expr

# One method call that resolved to a procedure; see note_method_callee.
struct ProcMethodCall
    call: *Expr
    next: *ProcMethodCall

struct EmitterState
    out: *Vec<u8>
    reg_counter: i32
    label_counter: i32
    # Heap array of `locals_cap` LocalVars (AGAST #1905); index it with
    # local_at.  Grown by add_local_full; never shrinks across fns.
    locals: *LocalVar
    locals_cap: i32
    local_count: i32
    break_label: i32
    continue_label: i32
    module: *Module
    # String literals; entry i is emitted as @.str.i (AGAST #1905).
    strings: NameList
    externs: NameList
    # Deduplication tracking for imports
    emitted_structs: NameList
    # AGAST #2419: tagged enums only a match's constructor scrutinee names.  Its
    # payload's type is known once locals are, so emit_tagged_enum_types' scan
    # can't see them: emit_late_enum_types declares them.
    late_enums: NameList
    emitted_fns: NameList
    emitted_globals: NameList
    # Track last expression value for if/else phi nodes
    last_expr_reg: i32
    # ritz-task-1309 — the block that DEFINED `last_expr_reg`.
    #
    # `last_expr_reg` on its own is just "some register"; it carries no record
    # of where it was produced.  Phi emission needs both halves — the incoming
    # value AND the predecessor block it flows from — and it used to pair
    # `last_expr_reg` with `s.current_label`, silently assuming the two agree.
    # They disagree whenever the value was produced in a *nested* block that
    # the insertion point has since moved past (an inner `if`'s then-block, a
    # loop body).  The result was `phi i64 [ %x, %L20 ]` where %x is neither
    # defined in nor dominated by L20 — SSA-invalid IR that permissive
    # verifiers accepted and LLVM 21 correctly rejects.
    #
    # Keeping the defining label welded to the value makes the mismatch
    # detectable: `last_expr_here` returns the register only when it was
    # defined in the block we are currently emitting into, and 0 otherwise.
    last_expr_label: i32
    # Track current label for phi node predecessors (needed for nested control flow)
    current_label: i32
    # Current function's return type name (for struct returns)
    ret_type_name: *u8
    ret_type_name_len: i32
    # AGAST #1730 — 1 when the current fn returns its (large) struct through
    # a `ptr sret(%T) %ret.sret` first parameter; see struct_ret_uses_sret.
    ret_sret: i32
    # The current fn's return TYPE_* (AGAST #1454).  emit_stmt takes it as a
    # parameter, but a block-bodied match arm reached through emit_expr has
    # none to pass, so its statements read it from here.
    fn_ret_type: i32
    # The value register of the most recent sret call result and the slot it
    # was loaded from, so `return f()` copies the slot instead of the value.
    sret_last_val: i32
    sret_last_slot: i32
    # 1 once any sret copy/zero is emitted: emit_sret_helpers then defines
    # @__ritz_sret_copy / @__ritz_sret_zero for this module.
    sret_helpers_used: i32
    # Tagged-enum context for variant constructors (ritz-task-133).
    # When non-null, `Some(x)` / `Ok(x)` / `None` / `Err(x)` allocas use this
    # struct name instead of falling back to `ret_type_name`.  Set by
    # emit_var_decl / emit_return for explicit `let r: Result<_,_> = Ok(x)`
    # bindings.  Null means "use ret_type_name" (covers tail-expression
    # returns inside a Result-returning fn).
    ctx_enum_name: *u8
    ctx_enum_name_len: i32
    # AGAST #1498: 1 while emitting a call argument (emit_call_arg).  There
    # the only valid enum context is the callee's parameter type, already in
    # ctx_enum_name; resolve_enum_ctx must NOT fall back to ret_type_name.
    ctx_enum_arg: i32
    # AGAST #167: SIMD-typed binding context.  When emitting `let v: v4i32 =
    # simd_loadu(...)`, the var-decl pre-sets these so emit_expr_call's
    # SIMD intrinsic dispatch knows which `<N x iM>` type to produce.  Null
    # means "no SIMD-typed enclosing binding" — intrinsic dispatch then
    # tries to derive the type from arg idents (vector-typed locals).
    ctx_simd_name: *u8
    ctx_simd_name_len: i32
    # AGAST #1666: the merge-phi aggregate type (MatchResult.agg_name) of
    # the most recently completed emit_match, or null when its phi was i64.
    # emit_var_decl reads it right after emitting an untyped `let v = match`
    # initializer to size the slot as `alloca %StrView` rather than i64.
    last_match_agg_name: *u8
    last_match_agg_name_len: i32
    # AGAST #1946: the float phi type (TYPE_F32 / TYPE_F64) of the most
    # recently completed emit_match / emit_if_expr, or 0 when it was not a
    # float.  Read like last_match_agg_name by an untyped `let v = match`.
    last_match_float_ty: i32
    # AGAST #1946: the float type an enclosing `let x: f64 = match ...` /
    # `return match ...` (in a `-> f64` fn) expects of the match, or 0.  The
    # match it is set for consumes and clears it on entry, so it never
    # reaches a nested match inside an arm.
    match_float_hint: i32
    # AGAST #2046: set by a caller that discards the value of the match / if
    # it is about to emit (STMT_MATCH, an expression statement, a match or
    # if nested as an arm).  emit_match / emit_if_expr consume and clear it
    # on entry, as with match_float_hint.  Clear = the value is wanted, and
    # a valueless arm (a void call) is a located error.
    match_no_value: i32
    # AGAST #2046: where the innermost valueless arm of the last valueless
    # match / if is, so an enclosing match reports the void call itself.
    void_arm_line: i32
    void_arm_col: i32
    # ritz-task-193 — O(1) symbol lookups.
    # `local_map`  : fnv1a(name)  -> i32 index into `locals[]`.  Cleared at
    #                each fn/method start (because `local_count` resets to 0)
    #                and rebuilt by emit_match_arm_body after scope unwind.
    #                Shadowing: insert overwrites; outer bindings re-found via
    #                the array-scan fallback when the map points to a stale
    #                (idx >= local_count) or name-mismatched entry.
    # `global_map` : fnv1a(name)  -> *GlobalVarDef  (cast to i64).  Built once
    #                per emit_module from `m.globals` after monomorphization.
    # `fn_map`     : fnv1a(name)  -> *FnDef         (first-occurrence wins to
    #                preserve linked-list head-first semantics).
    # `struct_map` : fnv1a(name)  -> *StructDef     (first-occurrence wins).
    # `const_map`  : fnv1a(name)  -> *ConstEntry    (first-occurrence wins).
    # All five replace linear-scan symbol lookups that made ritz1 5.7×
    # slower than ritz0 cold-builds on valet (67 .ritz files, 11.5k LoC).
    local_map: HashMapI64
    global_map: HashMapI64
    fn_map: HashMapI64
    struct_map: HashMapI64
    const_map: HashMapI64
    # AGAST #1369 — count of expressions the emitter could not lower.
    # The emitter used to have NO way to report failure: when it met something
    # it could not emit it wrote `; ERROR: ...` into the IR as a comment,
    # substituted a zero (or, for an assignment, dropped the store), and
    # returned success.  ritz1 then exited 0, build.py printed its tick, and
    # the program segfaulted or silently computed the wrong answer.
    # emit_module returns this count and main refuses to write the output when
    # it is non-zero.  See emit_ir_error().
    error_count: i32
    # AGAST #2342 — where bool_check last reported; see bool_report_at.
    bool_err_line: i32
    bool_err_col: i32
    match_scrut_kind: i32   # BK_* of the scrutinee of the match being emitted
    # AGAST #2237 — the current fn's method calls that resolved to a procedure,
    # and whether check_tail_value already reported this fn.
    proc_method_calls: *ProcMethodCall
    tail_gap_reported: i32
    # AGAST #2255 — the expression the `return`/`let`/`var` being emitted takes
    # its value from; see reject_procedure_value.
    value_source: *Expr
    # AGAST #1521 — 1 once a print interpolation has called one of the
    # @__ritz_print_* helpers; emit_module then defines them.
    print_helpers_used: i32
    # AGAST #1824 — 1 once a format_into has called @__ritz_fmt_int /
    # @__ritz_fmt_strlen; emit_module then defines them.
    fmt_helpers_used: i32
    # AGAST #1918 — 1 once a `[[packed]]` struct type is emitted; only then
    # does align_packed_accesses scan each fn body.
    packed_types_emitted: i32
    # AGAST #1364 — per-function state for the implicit-narrowing check
    # (narrowing.ritz).  Reset by narrowing_begin_fn at each fn/method start.
    narrow_params: *Param
    narrow_decls: [256]NarrowDecl
    narrow_decl_count: i32
    narrow_decl_overflow: i32
    # AGAST #1869 — assert lowering (emit_assert_stmt, emitter_print.ritz).
    # fn_assert_kind: ASSERT_FN_* of the fn being emitted, set by emit_fn /
    # emit_impl_method.  assert_helpers_used / assert_site_used: emit_module
    # then defines @__ritz_assert_val / the @__ritz_assert_site_* globals.
    # assert_cap_*: emit_expr_binary records the i64 operand registers of
    # the comparison assert_cap_expr (assert_cap_ok = 1 once it has).
    # assert_file_str: @.str index of the source file's basename, or -1.
    fn_assert_kind: i32
    assert_helpers_used: i32
    assert_site_used: i32
    assert_cap_expr: *Expr
    assert_cap_ok: i32
    assert_cap_l: i32
    assert_cap_r: i32
    assert_file_str: i32
    # AGAST #2158 — move checking and drop insertion (ownership.ritz).
    # Allocated by own_init in emit_module.
    own: *OwnState

# AGAST #2242 — a path a binding's value can be moved out along: a move-only
# field of it, or of a field of it that can itself be partly moved.  A path's
# index in OwnBinding.paths is its bit in fmask, fmoved and fshadow.
struct OwnPath
    parent: i32           # the path it is a part of, or -1 (the binding's own)
    idx: i32              # its field index in that struct
    fld: *StructField
    up: i32               # its bit, and those of the paths it is a part of
    down: i32             # its bit, and those of its parts

# AGAST #2158 — a binding that owns a value of a move-only type
# (LANGUAGE_SPEC §13.1): one that implements Drop or holds one.
struct OwnBinding
    name: *u8
    name_len: i32
    local_idx: i32        # its index in s.locals when it was declared
    slot: i32             # register of its storage (alloca / byval pointer)
    flag: i32             # register of its `alloca i1` drop flag
    type_name: *u8
    type_name_len: i32
    moved: i32            # move check: 1 once moved on the path being checked
    move_line: i32
    move_col: i32
    # AGAST #2165: >0 for an array binding of `count` type_name elements
    # (an N-D array counts every leaf), 0 for a single value.
    count: i32
    # AGAST #2165: loop move check.  1 while the binding would be moved here
    # if the innermost loop's head were reached with it moved: set for every
    # unmoved binding on entering a loop body, cleared by assigning to it.
    shadow: i32
    # AGAST #2168, #2242: moves out of a field.  `paths` lists what can be
    # moved out (`path_count` of them, null when nothing can).  `fmask` is
    # the register of an `alloca i32` whose bit i is set at run time while
    # path i is moved out (the drop skips it), or 0 when the binding can't be
    # partly moved (an array, a temporary, a type with its own drop).
    # `fmoved` is the move check's bits of the paths moved on the flow being
    # checked, and `fshadow` its loop shadow per path (as `shadow`, cleared
    # by assigning to the path).  `aux` is used by own_assign_begin's handle
    # only.
    paths: *OwnPath
    path_count: i32
    fmask: i32
    fmoved: i32
    fshadow: i32
    aux: i32
    # AGAST #2173: in own_assign_begin's handle only: the field a field
    # store `x.f... = v` overwrites (the handle is then for its old value),
    # else null; and (#2242) the path it is, or -1, with `aux` the moved
    # paths' mask from before the store.
    old_field: *StructField
    old_path: i32

# Per-function ownership state (ownership.ritz).
struct OwnState
    # The bindings in scope, innermost last.
    live: *OwnBinding
    live_count: i32
    live_cap: i32
    # One entry per open block: the index into `live` where it starts, and
    # 1 once a `return` was checked directly in it (what follows is dead).
    scope_start: *i32
    scope_dead: *i32
    scope_count: i32
    scope_cap: i32
    # Every binding of the fn, in declaration order: the drops before `ret`.
    all: *OwnBinding
    all_count: i32
    all_cap: i32
    # `live` index where the innermost loop body starts; -1 outside a loop.
    loop_base: i32
    # Label counter for the drops own_end_fn inserts before each `ret`.
    ret_seq: i32
    # AGAST #2165.  -1 until known, then 1 when the module has an `impl
    # Drop` at all (without one nothing is move-only).
    has_drop: i32
    # Call expressions the move check found to yield a move-only temporary
    # nobody owns; emit_expr spills each one and moves it to `temps`.
    temp_exprs: **Expr
    temp_expr_count: i32
    temp_expr_cap: i32
    # Temporaries awaiting their drop at the end of their statement (or
    # condition), innermost statement last.  Each is also in `all`.
    temps: *OwnBinding
    temp_count: i32
    temp_cap: i32
    # `temps` index where the statement being emitted starts.
    stmt_mark: i32
    # Loop move check: OWN_EV_* events, OWN_EV_INTS i32s each, and the
    # current loop nesting depth.
    loop_ev: *i32
    loop_ev_count: i32
    loop_ev_cap: i32
    loop_depth: i32
    # 1 when the last own_pop_scope closed a block that ended in a
    # `return` / `break` / `continue`.
    last_pop_dead: i32
    # AGAST #2168: where each field move happened, for diagnostics:
    # [slot, path, line, col] per move, in order.
    fm_loc: *i32
    fm_count: i32
    fm_cap: i32
    # AGAST #2174: the `live` index of the scrutinee the innermost match
    # being emitted owns, or -1 (see own_match_begin).
    match_scrut: i32
    # AGAST #2173: the i1 register own_check_stmt computed for the field
    # store `x.f... = v` being emitted (x owns the field's old value: drop
    # it), or 0.  own_assign_begin consumes it, with (#2242) the path stored
    # to (-1 if it isn't one) and the moved paths' mask before the store.
    fa_cond: i32
    fa_path: i32
    fa_mask: i32

# =============================================================================
# Helpers
# =============================================================================

fn emit_str(s: *EmitterState, text: *u8)
    var i: i32 = 0
    while *(text + i) != 0
        i += 1
    vec_push_bytes<u8>(s.out, text, i as i64)

fn emit_name(s: *EmitterState, name: *u8, len: i32)
    vec_push_bytes<u8>(s.out, name, len as i64)

# AGAST #1369 — record that the emitter could not lower something.
#
# Every caller used to be a bare `emit_str(s, c"  ; ERROR: ...")` that wrote
# the failure into the IR as a COMMENT and carried on.  A comment is not a
# diagnostic: llvm ignores it, the process exits 0, and the caller links
# whatever came out.  For `unknown identifier` the emitter went on to
# substitute `add i64 0, 0`, so `apply(double, 5)` became a call through a
# null pointer; for `unknown variable` it dropped the store outright and the
# program ran to completion with a stale value.
#
# This keeps the IR comment — it is genuinely useful when reading emitted IR
# by hand — but also prints the message to stderr and counts it, so
# emit_module can return non-zero and main can refuse to write the output.
# The IR comment is deliberately still written FIRST, so a developer dumping
# a failed compile's buffer sees the marker in place.
fn emit_ir_error(s: *EmitterState, msg: *u8)
    emit_str(s, c"  ; ERROR: ")
    emit_str(s, msg)
    emit_str(s, c"\n")
    eprints_cstr(c"error: ritz1 cannot emit: ")
    eprints_cstr(msg)
    eprints_cstr(c"\n")
    s.error_count = s.error_count + 1

# Same, for the two sites that append a name to the message before the
# newline.  The caller follows this with emit_name + emit_ir_error_end.
fn emit_ir_error_begin(s: *EmitterState, msg: *u8)
    emit_str(s, c"  ; ERROR: ")
    emit_str(s, msg)
    eprints_cstr(c"error: ritz1 cannot emit: ")
    eprints_cstr(msg)

fn emit_ir_error_end(s: *EmitterState, name: *u8, len: i32)
    emit_name(s, name, len)
    emit_str(s, c"'\n")
    var i: i32 = 0
    while i < len
        eprint_char(*(name + i))
        i += 1
    eprints_cstr(c"'\n")
    s.error_count = s.error_count + 1

# Same, for a message followed by an integer (a kind number, say).
fn emit_ir_error_kind(s: *EmitterState, msg: *u8, kind: i32)
    emit_str(s, c"  ; ERROR: ")
    emit_str(s, msg)
    emit_int(s, kind as i64)
    emit_str(s, c"\n")
    eprints_cstr(c"error: ritz1 cannot emit: ")
    eprints_cstr(msg)
    eprint_int(kind as i64)
    eprints_cstr(c"\n")
    s.error_count = s.error_count + 1

# AGAST #1509: a multi-dimensional array use ritz1 does not lower, as
# `error: <file>:<line>:<col>: <msg>`.  Counts like emit_ir_error, so the
# driver refuses to write the output.
fn emit_nd_error(s: *EmitterState, line: i32, col: i32, msg: *u8)
    emit_str(s, c"  ; ERROR: ")
    emit_str(s, msg)
    emit_str(s, c"\n")
    eprints_cstr(c"error: ")
    if g_emit_file != null
        eprints_cstr(g_emit_file)
    else
        eprints_cstr(c"<input>")
    eprints_cstr(c":")
    eprint_int(line as i64)
    eprints_cstr(c":")
    eprint_int(col as i64)
    eprints_cstr(c": ")
    eprints_cstr(msg)
    eprints_cstr(c"\n")
    s.error_count = s.error_count + 1

# AGAST #1813 — where the emitter is, for fatal capacity errors: the input
# file (set by the driver) and the function being emitted (set by emit_fn).
var g_emit_file: *u8 = null
var g_emit_fn: *FnDef = null

pub fn emitter_set_source_file(path: *u8)
    g_emit_file = path

pub fn emitter_set_current_fn(f: *FnDef)
    g_emit_fn = f

pub fn emitter_source_file() -> *u8
    g_emit_file

pub fn emitter_current_fn() -> *FnDef
    g_emit_fn

# AGAST #1869 — EmitterState.fn_assert_kind: where `assert` may appear.
const ASSERT_FN_PLAIN: i32 = 0    # not allowed
const ASSERT_FN_TEST: i32 = 1     # [[test]]: records call sites for helpers
const ASSERT_FN_HELPER: i32 = 2   # [[test_helper]]: reports the test's call site

# A fixed ritz1 table is full.  Print a located error and exit: carrying on
# without the entry is exactly the silent miscompile this replaces, and the
# driver has not written the output yet.
fn emit_fatal_limit(what: *u8, limit: i32)
    eprints_cstr(c"error: ")
    if g_emit_file != null
        eprints_cstr(g_emit_file)
    else
        eprints_cstr(c"<input>")
    # Through a local: ritz1 cannot lower a member read on a global pointer.
    let f: *FnDef = g_emit_fn
    if f != null
        eprints_cstr(c":")
        eprint_int(f.line as i64)
        eprints_cstr(c": in fn '")
        for i in 0..f.name_len
            eprint_char(*(f.name + i))
        eprints_cstr(c"'")
    eprints_cstr(c": ")
    eprints_cstr(what)
    eprints_cstr(c" (ritz1's limit is ")
    eprint_int(limit as i64)
    eprints_cstr(c")\n")
    sys_exit(1)

# n in decimal, through ritzlib.fmt. A hand-written `'-' then 0 - n` here
# recursed forever on i64::MIN (0 - n wraps to itself), so a u64 literal
# 9223372036854775808 / 0x8000000000000000 hung ritz1 (AGAST #2129).
fn emit_int(s: *EmitterState, n: i64)
    var buf: [20]u8
    let len: i64 = fmt_i64_into(@buf[0], n)
    for i in 0..len
        vec_push<u8>(s.out, buf[i])

fn emit_reg(s: *EmitterState, reg: i32)
    emit_str(s, c"%.")
    emit_int(s, reg as i64)

fn next_reg(s: *EmitterState) -> i32
    let r: i32 = s.reg_counter
    s.reg_counter = s.reg_counter + 1
    r

# AGAST #1335 — the value of `current_label` inside a function's entry block.
#
# The entry block is unlabelled (it is named `entry:`, not `L<n>:`), and
# `label_counter` restarts at 0 for every function, so labels are only unique
# WITHIN a function.  `current_label` used to be left holding the PREVIOUS
# function's last opened block.  Entry-block values were then tagged by
# set_last_expr with that stale label, and whenever it collided with a real
# label of the current function (e.g. an if-without-else's merge block),
# last_expr_here falsely reported the entry-block value as "defined here" —
# so the implicit return depended on the label count of whichever function
# happened to be emitted just before.
#
# next_label never returns a negative number, so -1 can never equal any block
# opened by begin_block: an entry-block value only matches while we are still
# in the entry block.  emit_fn, emit_method and emit_module set this at every
# function boundary.  It is never passed to emit_label/begin_block.
const ENTRY_BLOCK_LABEL: i32 = -1

fn next_label(s: *EmitterState) -> i32
    let l: i32 = s.label_counter
    s.label_counter = s.label_counter + 1
    l

fn emit_label(s: *EmitterState, label: i32)
    emit_str(s, c"L")
    emit_int(s, label as i64)

# ritz-task-1267 — Open a new basic block.
#
# This is the ONLY sanctioned way to start a basic block.  Emitting
# `L<n>:` by hand (emit_label + ":\n") is a bug: `s.current_label` is the
# emitter's insertion point, and every PHI predecessor label we write is
# derived from it.  If a construct opens a block without refreshing
# `s.current_label`, an enclosing IF/short-circuit emitter later names a
# *stale* block as a PHI predecessor — producing IR where the phi entries
# don't match the CFG, and where the incoming value doesn't dominate its
# use.
#
# This was #195 (STMT_BREAK/CONTINUE leaked a stale label) and again
# #1267 (STMT_WHILE / STMT_LOOP / STMT_FOR / STMT_MATCH / assert never
# refreshed it at their exit label — so an `if ... else <loop>` whose
# else-arm ended after the loop attributed the merge PHI to the loop's
# last *body* block instead of the loop-exit block).  Keeping the
# "emit the label" and "record the insertion point" steps welded together
# makes that whole class of bug unrepresentable.
fn begin_block(s: *EmitterState, label: i32)
    emit_label(s, label)
    emit_str(s, c":\n")
    s.current_label = label

# ritz-task-1309 — the three sanctioned accessors for `last_expr_reg`.
#
# Nothing outside these should assign `last_expr_reg` directly: the register
# and the label that defines it must move together or the pair goes stale,
# which is the whole defect these exist to prevent.

# Record `reg` as the last expression value, produced by the block we are
# currently emitting into.
fn set_last_expr(s: *EmitterState, reg: i32)
    s.last_expr_reg = reg
    s.last_expr_label = s.current_label

# Drop the tracked value.  Used where control flow makes any previous value
# unavailable at the new insertion point (break/continue dead blocks, and the
# start of each `if` branch).
fn clear_last_expr(s: *EmitterState)
    s.last_expr_reg = 0
    s.last_expr_label = s.current_label

# Read the last expression value, but ONLY if it was defined in the block we
# are currently emitting into; 0 otherwise.
#
# This is the guard for phi incoming values.  A phi entry `[ %v, %L ]` requires
# %v to be available along the edge from L, and equality of defining block and
# predecessor block is the conservative way to guarantee that without a
# dominator tree.  A value produced in a nested block that the insertion point
# has already left is reported as "no value", which correctly suppresses the
# phi rather than emitting a dominance-violating one.
fn last_expr_here(s: *EmitterState) -> i32
    if s.last_expr_label != s.current_label
        return 0
    return s.last_expr_reg

# The idx-th entry of the locals table.  Indexes through a local copy of the
# pointer field: ritz1 cannot lower `@s.locals[idx]` on a pointer field.
fn local_at(s: *EmitterState, idx: i32) -> *LocalVar
    let base: *LocalVar = s.locals
    return @base[idx]

# Allocate the locals table (emit_module).
pub fn locals_init(s: *EmitterState, cap: i32)
    s.locals = malloc((cap as i64) * sizeof(LocalVar)) as *LocalVar
    s.locals_cap = cap
    s.local_count = 0

# ritz-task-193 — Resolve `name` to an index into `s.locals[]` using the
# per-fn HashMap (fnv1a hash of name bytes).  Falls back to a from-end
# linear scan to handle two cases the map can't:
#   1. Stale map entry: emit_match_arm_body's scope rollback drops bindings
#      from `locals[]` (by decrementing `local_count`) and rebuilds the map,
#      but during the inner-arm window the map already has the inner binding
#      pointing past the rolled-back count.
#   2. Hash collision: FNV1a-64 collisions are rare but not impossible —
#      validate the stored entry's bytes match before trusting the index.
# Both fallbacks fire rarely; the map handles >99% of lookups in O(1).
# Returns -1 when the name isn't bound in any active scope.
#
# Stores `idx + 1` in the map so hashmap_i64_get's 0-on-miss semantics
# unambiguously mean "not found" (idx == 0 is a valid first-local index).
# Avoids the contains+get double-probe pattern.
fn find_local_idx(s: *EmitterState, name: *u8, len: i32) -> i32
    # Fast path: single-probe HashMap lookup with collision check.
    let key: i64 = fnv1a_str(name, len) as i64
    let stored: i64 = hashmap_i64_get(@s.local_map, key)
    if stored > 0
        let idx: i32 = (stored - 1) as i32
        if idx >= 0 and idx < s.local_count
            let loc: *LocalVar = local_at(s, idx)
            if loc.name_len == len
                var j: i32 = 0
                var matched: i32 = 1
                while j < len
                    if *(loc.name + j) != *(name + j)
                        matched = 0
                        break
                    j = j + 1
                if matched == 1
                    return idx
    # Fallback: linear scan from end (innermost scope wins).
    var i: i32 = s.local_count - 1
    while i >= 0
        let loc: *LocalVar = local_at(s, i)
        if loc.name_len == len
            var j: i32 = 0
            var matched: i32 = 1
            while j < len
                if *(loc.name + j) != *(name + j)
                    matched = 0
                    break
                j = j + 1
            if matched == 1
                return i
        i = i - 1
    return -1

fn find_local(s: *EmitterState, name: *u8, len: i32) -> i32
    let idx: i32 = find_local_idx(s, name, len)
    if idx < 0
        return -1
    let loc: *LocalVar = local_at(s, idx)
    return loc.reg

# AGAST #1328: "not a local" miss value for find_local_type.  The old miss
# value was TYPE_I64, which is indistinguishable from a real i64 local —
# twice now (#1325 deref form, #1328 subscript form) a caller treated a
# global pointer as an i64 and silently loaded the wrong width.  -1 collides
# with no TYPE_* kind, so a caller that forgets to handle the miss now takes
# its explicit "unknown" branch instead of impersonating an i64.
const TYPE_UNKNOWN: i32 = -1

fn find_local_type(s: *EmitterState, name: *u8, len: i32) -> i32
    let idx: i32 = find_local_idx(s, name, len)
    if idx < 0
        return TYPE_UNKNOWN
    let loc: *LocalVar = local_at(s, idx)
    return loc.var_type

fn find_local_pointee_type(s: *EmitterState, name: *u8, len: i32) -> i32
    let idx: i32 = find_local_idx(s, name, len)
    if idx < 0
        return TYPE_I64  # Default to i64
    let loc: *LocalVar = local_at(s, idx)
    return loc.pointee_type

# Find the struct type name for a local variable
fn find_local_struct_name(s: *EmitterState, name: *u8, len: i32) -> *LocalVar
    let idx: i32 = find_local_idx(s, name, len)
    if idx < 0
        return null
    return local_at(s, idx)

# AGAST #1644: 1 when emit_expr(e) yields a `ptr` register rather than the
# i64 of ritz1's value model.  A TYPE_MUT_REF local (`x: @&T`) loads as
# `ptr`, so the `*x` read must not inttoptr it, and a `*T` (i64) param must
# ptrtoint it.  `@&v` (OP_ADDR_MUT) is a `ptr` too.
fn expr_is_ptr_valued(s: *EmitterState, e: *Expr) -> i32
    if e == null
        return 0
    if e.kind == EXPR_UNARY and e.op == OP_ADDR_MUT
        return 1
    # AGAST #1754: `v as @&T` yields a `ptr` (see the EXPR_CAST arm).
    if e.kind == EXPR_CAST and e.op == TYPE_MUT_REF
        return 1
    return deref_operand_is_ptr(s, e)

# AGAST #1652/#1672: bring `reg` (the value emit_expr(e) produced) into the
# i64 value model.  A `*T` slot -- `let p: *T = v`, `p = v`, `return v`,
# `x.f = v`, `v as *T` -- holds i64, but `@&v` and an `@&T` local yield
# `ptr`, so those get a ptrtoint.  Any other value is returned unchanged.
fn ptr_value_to_i64(s: *EmitterState, e: *Expr, reg: i32) -> i32
    if expr_is_ptr_valued(s, e) == 0
        return reg
    let r: i32 = next_reg(s)
    emit_str(s, c"  ")
    emit_reg(s, r)
    emit_str(s, c" = ptrtoint ptr ")
    emit_reg(s, reg)
    emit_str(s, c" to i64  ; #1652 @&T->*T\n")
    return r

# AGAST #1754: the inverse -- bring `reg` into an `@&T` (`ptr`) slot.  A
# `*T` value / `-> @&T` call result is i64 and gets an inttoptr; a value
# expr_is_ptr_valued already reports as `ptr` is returned unchanged.
fn i64_value_to_ptr(s: *EmitterState, e: *Expr, reg: i32) -> i32
    if expr_is_ptr_valued(s, e) == 1
        return reg
    let r: i32 = next_reg(s)
    emit_str(s, c"  ")
    emit_reg(s, r)
    emit_str(s, c" = inttoptr i64 ")
    emit_reg(s, reg)
    emit_str(s, c" to ptr  ; #1754 *T->@&T\n")
    return r

# ptr_value_to_i64, but only when the destination slot is i64-lowered
# pointer: `*T` / `**T`, or `@T` (TYPE_REF, i64 too -- AGAST #1754); any
# other slot type gets `reg` back unchanged.
fn ptr_slot_value(s: *EmitterState, slot_type: i32, e: *Expr, reg: i32) -> i32
    if slot_type != TYPE_PTR and slot_type != TYPE_PTR_PTR and slot_type != TYPE_REF
        return reg
    return ptr_value_to_i64(s, e, reg)

# The j-th expression of an argument list (null past the end).
fn nth_arg(args: *Expr, j: i32) -> *Expr
    var a: *Expr = args
    var k: i32 = 0
    while k < j and a != null
        a = a.next
        k = k + 1
    return a

# The ident-only half of expr_is_ptr_valued: the shape `*x` / `*x = v` see.
# The integer kinds a `:&` borrow binds as a plain local (AGAST #1644).
fn is_borrow_scalar_kind(t: i32) -> i32
    if t == TYPE_I8 or t == TYPE_U8 or t == TYPE_I16 or t == TYPE_U16
        return 1
    if t == TYPE_I32 or t == TYPE_U32 or t == TYPE_I64 or t == TYPE_U64
        return 1
    return 0

# AGAST #2290: the `a:& [N]T` param `e` names, of any rank, or null.  It's an
# array local whose slot is the array behind the borrow.
fn lent_array_ident(s: *EmitterState, e: *Expr) -> *LocalVar
    if e == null or e.kind != EXPR_IDENT
        return null
    let loc: *LocalVar = find_local_struct_name(s, e.ident_ptr, e.ident_len)
    if loc == null or loc.var_type != TYPE_ARRAY or loc.is_lent == 0
        return null
    return loc

# AGAST #2321: the `p: *[N]T` / `@[N]T` / `@&[N]T` local called `name`, or null: a
# base whose `p[i]` is element i of the array behind it, stride T.  `a:& [N]T`
# isn't one: it's an array local, and indexes as one.
fn array_ptr_named(s: *EmitterState, name: *u8, len: i32) -> *LocalVar
    let loc: *LocalVar = find_local_struct_name(s, name, len)
    if loc == null or loc.pointee_type != TYPE_ARRAY or loc.pointee_array_size <= 0
        return null
    if loc.var_type != TYPE_PTR and loc.var_type != TYPE_REF and loc.var_type != TYPE_MUT_REF
        return null
    return loc

# The array_ptr_named local that `e` names, or null.
fn array_ptr_index_base(s: *EmitterState, e: *Expr) -> *LocalVar
    if e == null or e.kind != EXPR_IDENT
        return null
    return array_ptr_named(s, e.ident_ptr, e.ident_len)

fn deref_operand_is_ptr(s: *EmitterState, e: *Expr) -> i32
    if e == null or e.kind != EXPR_IDENT
        return 0
    let loc: *LocalVar = find_local_struct_name(s, e.ident_ptr, e.ident_len)
    if loc != null and loc.var_type == TYPE_MUT_REF
        return 1
    # AGAST #2290: `a:& [N]T` reads as the borrow's `ptr` (emit_expr_ident).
    if lent_array_ident(s, e) != null
        return 1
    return 0

# ritz-task-193 — rebuild `local_map` from the current `locals[0..local_count]`.
# Called by emit_match_arm_body after `local_count` is rolled back to drop
# arm-scoped bindings; without this rebuild the map would still hold the
# inner binding's index (now past the count) for the entire fn body, costing
# us the fast-path on every subsequent lookup of that name.
pub fn rebuild_local_map(s: *EmitterState)
    hashmap_i64_clear(@&s.local_map)
    var i: i32 = 0
    while i < s.local_count
        let loc: *LocalVar = local_at(s, i)
        let key: i64 = fnv1a_str(loc.name, loc.name_len) as i64
        # Store `i + 1` so 0 unambiguously means miss in find_local_idx.
        # Insert in order so later (innermost) bindings overwrite earlier
        # (outer) ones — matches the linear-scan-from-end semantics.
        hashmap_i64_insert(@&s.local_map, key, (i + 1) as i64)
        i = i + 1

fn add_local(s: *EmitterState, name: *u8, len: i32, reg: i32, var_type: i32)
    add_local_full(s, name, len, reg, var_type, null, 0, TYPE_I64, 0, 0)

fn add_local_ptr(s: *EmitterState, name: *u8, len: i32, reg: i32, var_type: i32, pointee: i32)
    add_local_full(s, name, len, reg, var_type, null, 0, pointee, 0, 0)

fn add_local_struct(s: *EmitterState, name: *u8, len: i32, reg: i32, var_type: i32, type_name: *u8, type_name_len: i32)
    add_local_full(s, name, len, reg, var_type, type_name, type_name_len, TYPE_I64, 0, 0)

fn add_local_array(s: *EmitterState, name: *u8, len: i32, reg: i32, arr_size: i32, elem_type: i32)
    add_local_full(s, name, len, reg, TYPE_ARRAY, null, 0, TYPE_I64, arr_size, elem_type)

# AGAST #1671: attach a fn-type signature to the just-registered local.
fn set_local_fn_sig(s: *EmitterState, name: *u8, len: i32, sig: *FnDef)
    if sig == null
        return
    let loc: *LocalVar = find_local_struct_name(s, name, len)
    if loc != null
        loc.fn_sig = sig

# AGAST #1815: attach a `**T` local's innermost pointee to the just-registered local.
fn set_local_inner_pointee(s: *EmitterState, name: *u8, len: i32, inner: i32)
    if inner == TYPE_VOID
        return
    let loc: *LocalVar = find_local_struct_name(s, name, len)
    if loc != null
        loc.inner_pointee_type = inner

# AGAST #1953: record N and T on the just-registered `*[N]T` local `name`
# (from Param / Stmt pointee_array_*).  A no-op when size is 0 (not `*[N]T`).
fn set_local_pointee_array(s: *EmitterState, name: *u8, len: i32, size: i32, elem: i32)
    if size <= 0
        return
    let loc: *LocalVar = find_local_struct_name(s, name, len)
    if loc != null and loc.pointee_type == TYPE_ARRAY
        loc.pointee_array_size = size
        loc.pointee_array_elem_type = elem

# AGAST #2343: U, on the same local, for `*[N]*U`.
fn set_local_pointee_elem(s: *EmitterState, name: *u8, len: i32, pointee: i32)
    let loc: *LocalVar = find_local_struct_name(s, name, len)
    if loc != null
        loc.pointee_array_elem_pointee = pointee

fn add_local_full(s: *EmitterState, name: *u8, len: i32, reg: i32, var_type: i32, type_name: *u8, type_name_len: i32, pointee: i32, arr_size: i32, arr_elem: i32)
    if s.local_count >= s.locals_cap
        let cap: i64 = (s.locals_cap as i64) * 2
        s.locals = realloc(s.locals as *u8, cap * sizeof(LocalVar)) as *LocalVar
        s.locals_cap = cap as i32
    let idx: i32 = s.local_count
    let loc: *LocalVar = local_at(s, idx)
    loc.name = name
    loc.name_len = len
    loc.reg = reg
    loc.var_type = var_type
    loc.type_name = type_name
    loc.type_name_len = type_name_len
    loc.pointee_type = pointee
    loc.array_size = arr_size
    loc.array_elem_type = arr_elem
    loc.is_bool = 0
    loc.array_elem_pointee = TYPE_VOID
    loc.bk_unsure = 0
    loc.fn_sig = null
    loc.inner_pointee_type = TYPE_VOID
    loc.is_let = 0
    loc.holds_shared_ref = 0
    loc.pointee_array_size = 0
    loc.pointee_array_elem_type = TYPE_VOID
    loc.pointee_array_elem_pointee = TYPE_VOID
    loc.array_shape = null
    loc.is_lent = 0
    loc.holds_lent_ptr = 0
    loc.is_caller_place = 0
    loc.ref_root = null
    loc.ref_root_len = 0
    loc.ref_root_loops = 0
    loc.ref_root_pointee = TYPE_VOID
    loc.ref_root_name = null
    loc.ref_root_name_len = 0
    s.local_count = idx + 1
    # ritz-task-193 — mirror into HashMap so find_local* hits O(1).
    # Store `idx + 1` so the value is non-zero (0 = miss in
    # hashmap_i64_get).  Same name overwrites (inner shadows outer);
    # the find fallback + rebuild_local_map together preserve correct
    # shadow semantics.
    let key: i64 = fnv1a_str(name, len) as i64
    hashmap_i64_insert(@&s.local_map, key, (idx + 1) as i64)

# ritz-task-193 — module-scope find_* now use HashMaps populated once per
# module by build_symbol_maps in emit_module (after monomorphization fixes
# the function/struct lists).  All three preserve the legacy "first
# occurrence wins" semantics: build_symbol_maps inserts only if not already
# present, so duplicate-by-name nodes (from import-merged modules) resolve
# to the head of the linked list — same as the pre-task-193 linear scan.

# Find a global variable by name - returns the GlobalVarDef or null.
# We never insert a null pointer into global_map, so hashmap_i64_get returning
# 0 unambiguously means "miss" — skip the redundant contains-check that
# would double-probe + double-hash on every lookup.
fn find_global(s: *EmitterState, name: *u8, len: i32) -> *GlobalVarDef
    let key: i64 = fnv1a_str(name, len) as i64
    let g: *GlobalVarDef = hashmap_i64_get(@s.global_map, key) as *GlobalVarDef
    if g == null
        return null
    if name_eq(g.name, g.name_len, name, len) == 1
        return g
    # AGAST #1813: the map is keyed by the 64-bit hash alone, so a hit with
    # another name is a collision, not a miss.  Scan the list (first
    # occurrence wins, as in build_symbol_maps).
    var cur: *GlobalVarDef = s.module.globals
    while cur != null
        if name_eq(cur.name, cur.name_len, name, len) == 1
            return cur
        cur = cur.next
    return null

# Find a function definition by name - returns the FnDef or null.
# Same null-as-miss optimization as find_global.
fn find_fn(s: *EmitterState, name: *u8, len: i32) -> *FnDef
    let key: i64 = fnv1a_str(name, len) as i64
    let fn_def: *FnDef = hashmap_i64_get(@s.fn_map, key) as *FnDef
    if fn_def == null
        return null
    if name_eq(fn_def.name, fn_def.name_len, name, len) == 1
        return fn_def
    # AGAST #1813: the map is keyed by the 64-bit hash alone, so a hit with
    # another name is a collision, not a miss.  Scan the list (first
    # occurrence wins, as in build_symbol_maps).
    var cur: *FnDef = s.module.functions
    while cur != null
        if name_eq(cur.name, cur.name_len, name, len) == 1
            return cur
        cur = cur.next
    return null

# A fn declared with no return type.  `-> void` does not count, as in ritz0's
# _is_void_call (AGAST #2246).
fn fn_is_procedure(fd: *FnDef) -> i32
    if fd == null or fd.return_type != TYPE_VOID or fd.ret_written_void == 1
        return 0
    1

# The file a fn's lines belong to: a specialised generic may come from an import.
fn fn_source_file(f: *FnDef) -> *u8
    if f != null and f.def_file != null
        return f.def_file
    let file: *u8 = emitter_source_file()
    if file != null
        return file
    c"<input>"

# AGAST #2255: `e` called a procedure named `name`.  Its dummy `i32 0` is not a
# value, but `return g(n)` and `let x = g(n)` would bind it.  Judged where a call
# resolves, because only there are a method's callee and a fn-pointer local known.
fn reject_procedure_value(s: *EmitterState, e: *Expr, name: *u8, len: i32)
    if e != s.value_source
        return
    eprints_cstr(fn_source_file(emitter_current_fn()))
    eprint_char(':')
    eprint_i64(e.span.line as i64)
    eprint_char(':')
    eprint_i64(e.span.col as i64)
    eprints_cstr(c": error: `")
    for i in 0..len
        eprint_char(*(name + i))
    eprints_cstr(c"` returns nothing, so its call has no value to use here\n")
    emit_str(s, c"  ; ERROR: a procedure call has no value\n")
    s.error_count = s.error_count + 1

# AGAST #2237: remember that method call `e` dispatched to `fd`.  Only emission
# knows a receiver's type, so check_tail_method_calls reads this after the body.
fn note_method_callee(s: *EmitterState, e: *Expr, fd: *FnDef)
    if fn_is_procedure(fd) == 0
        return
    reject_procedure_value(s, e, e.ident_ptr, e.ident_len)   # AGAST #2255
    let n: *ProcMethodCall = malloc(sizeof(ProcMethodCall)) as *ProcMethodCall
    n.call = e
    n.next = s.proc_method_calls
    s.proc_method_calls = n

# The FnDef a call expression names: `func_name` plus its generic suffix
# (`vec_new` + `$u8`).  Replaces nine copies of a loop that built the name in
# a fixed [256]u8 stack buffer with no bounds check (AGAST #1813).
fn find_call_fn(s: *EmitterState, e: *Expr) -> *FnDef
    if e.func_name_len == 0
        return call_callee_sig(s, e)   # AGAST #1747
    if e.call_type_suffix_len <= 0
        return find_fn(s, e.func_name, e.func_name_len)
    let n: i32 = e.func_name_len + e.call_type_suffix_len
    let buf: *u8 = malloc(n as i64 + 1)
    for i in 0..e.func_name_len
        *(buf + i) = *(e.func_name + i)
    for i in 0..e.call_type_suffix_len
        *(buf + e.func_name_len + i) = *(e.call_type_suffix + i)
    *(buf + n) = 0
    let fd: *FnDef = find_fn(s, buf, n)
    free(buf)
    return fd

# AGAST #1747: the signature of a nameless call's callee expression
# (`fs[i](..)`, built by apply_postfix_p with the callee in `left`), or null
# when it is not statically known.  An element of a `[N]fn(..) -> T` local
# carries the element signature on the local (set_local_fn_sig).
#
# AGAST #2120: so do the other callees whose type is a fn type, so a call
# through each is typed and keeps a fn-type alias's [[callconv]] (the
# signature is the alias's, which carries it): a cast `(p as EfiFn)(..)`, a
# field `(t.f)(..)`, and a fn's result `get()(..)`.
fn call_callee_sig(s: *EmitterState, e: *Expr) -> *FnDef
    if e.func_name_len != 0
        return null
    let c: *Expr = e.left
    if c == null
        return null
    if c.kind == EXPR_INDEX and c.left != null and c.left.kind == EXPR_IDENT
        let lv: *LocalVar = find_local_struct_name(s, c.left.ident_ptr, c.left.ident_len)
        if lv != null and lv.var_type == TYPE_ARRAY
            return lv.fn_sig
    else if c.kind == EXPR_CAST
        return c.fn_sig
    else if c.kind == EXPR_MEMBER
        let f: *StructField = member_field_def(s, c)
        if f != null and f.field_type == TYPE_PTR
            return f.fn_sig
    else if c.kind == EXPR_CALL
        let fd: *FnDef = find_call_fn(s, c)
        if fd != null and fd.return_type == TYPE_PTR
            return fd.ret_fn_sig
    return null

# Find a struct definition by name.  Same null-as-miss optimization.
fn find_struct(s: *EmitterState, name: *u8, len: i32) -> *StructDef
    let key: i64 = fnv1a_str(name, len) as i64
    let st: *StructDef = hashmap_i64_get(@s.struct_map, key) as *StructDef
    if st == null
        return null
    if name_eq(st.name, st.name_len, name, len) == 1
        return st
    # AGAST #1813: the map is keyed by the 64-bit hash alone, so a hit with
    # another name is a collision, not a miss.  Scan the list (first
    # occurrence wins, as in build_symbol_maps).
    var cur: *StructDef = s.module.structs
    while cur != null
        if name_eq(cur.name, cur.name_len, name, len) == 1
            return cur
        cur = cur.next
    return null

# Find field index in a struct (returns -1 if not found)
fn find_field_index(st: *StructDef, field: *u8, field_len: i32) -> i32
    var idx: i32 = 0
    var f: *StructField = st.fields
    while f != null
        if f.name_len == field_len
            var j: i32 = 0
            var matched: i32 = 1
            while j < field_len
                if *(f.name + j) != *(field + j)
                    matched = 0
                    break
                j += 1
            if matched == 1
                return idx
        idx += 1
        f = f.next
    -1

# Get field type from struct definition
fn get_field_type(st: *StructDef, field_idx: i32) -> *StructField
    var idx: i32 = 0
    var f: *StructField = st.fields
    while f != null
        if idx == field_idx
            return f
        idx += 1
        f = f.next
    null

# Result struct for emit_member_ptr - returns pointer register and field info
struct MemberPtrResult
    reg: i32              # Register holding pointer to field
    field: *StructField   # Field info (type, name, etc.)
    success: i32          # 1 if successful, 0 if error

# AGAST #2388: what a `for` over a header binds: `elem`, and `name` when that's a
# struct.  For a pointer element, what it points at, as elem_recorded_pointee has it.
struct ForElem
    elem: i32
    name: *u8
    name_len: i32
    pointee: i32
    pointee_name: *u8
    pointee_name_len: i32

pub fn namelist_init(l: *NameList, cap: i32)
    l.names = malloc((cap as i64) * 8) as **u8
    l.lens = malloc((cap as i64) * 4) as *i32
    l.count = 0
    l.cap = cap

# Index of `name` in the list, or -1.
fn namelist_find(l: *NameList, name: *u8, len: i32) -> i32
    let names: **u8 = l.names
    let lens: *i32 = l.lens
    var i: i32 = 0
    while i < l.count
        let n: i32 = *(lens + i)
        if n == len
            let stored: *u8 = *(names + i)
            if name_eq(stored, n, name, len) == 1
                return i
        i = i + 1
    -1

fn namelist_push(l: *NameList, name: *u8, len: i32)
    if l.count >= l.cap
        let cap: i64 = (l.cap as i64) * 2
        l.names = realloc(l.names as *u8, cap * 8) as **u8
        l.lens = realloc(l.lens as *u8, cap * 4) as *i32
        l.cap = cap as i32
    let names: **u8 = l.names
    let lens: *i32 = l.lens
    *(names + l.count) = name
    *(lens + l.count) = len
    l.count = l.count + 1

fn namelist_count(l: *NameList) -> i32
    l.count

fn namelist_name(l: *NameList, i: i32) -> *u8
    let names: **u8 = l.names
    *(names + i)

fn namelist_len(l: *NameList, i: i32) -> i32
    let lens: *i32 = l.lens
    *(lens + i)

fn add_extern(s: *EmitterState, name: *u8, len: i32)
    if namelist_find(@s.externs, name, len) >= 0
        return  # Already registered
    # Add new external - copy the name since caller might use a stack buffer
    let name_copy: *u8 = malloc(len as i64 + 1) as *u8
    for k in 0..len
        *(name_copy + k) = *(name + k)
    *(name_copy + len) = 0  # Null terminate
    namelist_push(@s.externs, name_copy, len)

# Add extern for method call: TypeName_methodName
# Allocates memory for the mangled name
fn add_method_extern(s: *EmitterState, type_name: *u8, type_len: i32, method_name: *u8, method_len: i32)
    # Calculate total length: TypeName_methodName
    let total_len: i32 = type_len + 1 + method_len

    # Allocate memory for the name (use malloc)
    let name: *u8 = malloc(total_len as i64 + 1) as *u8
    if name == null
        return

    # Copy type name
    for i in 0..type_len
        *(name + i) = *(type_name + i)

    # Add underscore
    *(name + type_len) = 95  # '_'

    # Copy method name
    for i in 0..method_len
        *(name + type_len + 1 + i) = *(method_name + i)

    # Null terminate
    *(name + total_len) = 0

    # Add to externs
    add_extern(s, name, total_len)

# Helper to check if name matches a string
fn name_eq(name: *u8, len: i32, target: *u8, target_len: i32) -> i32
    if len != target_len
        return 0
    for i in 0..len
        if *(name + i) != *(target + i)
            return 0
    1

# =============================================================================
# Named syscall builtins (AGAST #1791)
# =============================================================================
#
# ritz0 lowers a bare call to `write`, `read`, `open`, `close` or `nanosleep`
# to an inline `syscall` (emitter_llvmlite.py, `_emit_syscall`). It tests these
# names AFTER fn-pointer locals and BEFORE user functions, so a module's own
# `fn write` never receives a bare `write(..)` call.
#
# ritz1 redirects such a call to `@__ritz_builtin_<name>`, a weak_odr body
# emitted by emit_builtin_syscall_implementations (emitter.ritz). Because the
# symbol is reserved, it cannot collide with a user's `@write` or libc's.

# 1 if `name` is one of ritz0's named syscall builtins.
fn is_named_syscall_builtin(name: *u8, len: i32) -> i32
    if name_eq(name, len, c"write", 5) == 1
        return 1
    if name_eq(name, len, c"read", 4) == 1
        return 1
    if name_eq(name, len, c"open", 4) == 1
        return 1
    if name_eq(name, len, c"close", 5) == 1
        return 1
    if name_eq(name, len, c"nanosleep", 9) == 1
        return 1
    0

# 1 if this call is lowered as a named syscall builtin: a bare, non-generic
# call to one of the five names that is not a call through a local (ritz0
# resolves fn-pointer locals first).
fn call_is_named_syscall_builtin(s: *EmitterState, e: *Expr) -> i32
    if e.call_type_suffix_len != 0
        return 0
    if is_named_syscall_builtin(e.func_name, e.func_name_len) == 0
        return 0
    if find_local(s, e.func_name, e.func_name_len) >= 0
        return 0
    1

# The builtin's result type as ritz0 gives it: `open` and `close` are
# narrowed to i32, the rest are i64.
fn named_syscall_builtin_type(name: *u8, len: i32) -> i32
    if name_eq(name, len, c"open", 4) == 1
        return TYPE_I32
    if name_eq(name, len, c"close", 5) == 1
        return TYPE_I32
    TYPE_I64

# =============================================================================
# Deduplication Helpers - Track emitted structs/functions to avoid duplicates
# =============================================================================

# Check if a struct has already been emitted
fn was_struct_emitted(s: *EmitterState, name: *u8, len: i32) -> i32
    if namelist_find(@s.emitted_structs, name, len) >= 0
        return 1
    0

# Mark a struct as emitted
fn mark_struct_emitted(s: *EmitterState, name: *u8, len: i32)
    namelist_push(@s.emitted_structs, name, len)

# Check if a function has already been emitted
fn was_fn_emitted(s: *EmitterState, name: *u8, len: i32) -> i32
    if namelist_find(@s.emitted_fns, name, len) >= 0
        return 1
    0

# Mark a function as emitted
fn mark_fn_emitted(s: *EmitterState, name: *u8, len: i32)
    namelist_push(@s.emitted_fns, name, len)

# Check if a global has already been emitted
fn was_global_emitted(s: *EmitterState, name: *u8, len: i32) -> i32
    if namelist_find(@s.emitted_globals, name, len) >= 0
        return 1
    0

# Mark a global as emitted
fn mark_global_emitted(s: *EmitterState, name: *u8, len: i32)
    namelist_push(@s.emitted_globals, name, len)

# Check for well-known constants from ritzlib.sys
fn find_builtin_const(name: *u8, len: i32) -> i64
    # STDIN, STDOUT, STDERR
    if name_eq(name, len, c"STDIN", 5) == 1
        return 0
    if name_eq(name, len, c"STDOUT", 6) == 1
        return 1
    if name_eq(name, len, c"STDERR", 6) == 1
        return 2
    # O_RDONLY, O_WRONLY, O_RDWR
    if name_eq(name, len, c"O_RDONLY", 8) == 1
        return 0
    if name_eq(name, len, c"O_WRONLY", 8) == 1
        return 1
    if name_eq(name, len, c"O_RDWR", 6) == 1
        return 2
    # Return a sentinel that means "not found"
    return -9999

fn is_builtin_const(name: *u8, len: i32) -> i32
    if find_builtin_const(name, len) != -9999
        return 1
    0

fn find_const(s: *EmitterState, name: *u8, len: i32) -> i64
    # First check module constants via HashMap
    let ce: *ConstEntry = find_const_entry(s, name, len)
    if ce != null
        return ce.value
    # Then check builtin constants
    let builtin: i64 = find_builtin_const(name, len)
    if builtin != -9999
        return builtin
    0

# Look up a ConstEntry by name (returns null if not found).  Distinct from
# find_const above which only returns the scalar value — this caller-side
# helper is needed when const-array iter wants the array_size /
# array_elem_type metadata to drive iteration codegen.  Same null-as-miss
# single-probe optimization as find_global.
pub fn find_const_entry(s: *EmitterState, name: *u8, len: i32) -> *ConstEntry
    let key: i64 = fnv1a_str(name, len) as i64
    let ce: *ConstEntry = hashmap_i64_get(@s.const_map, key) as *ConstEntry
    if ce == null
        return null
    if name_eq(ce.name, ce.name_len, name, len) == 1
        return ce
    # AGAST #1813: the map is keyed by the 64-bit hash alone, so a hit with
    # another name is a collision, not a miss.  Scan the list (first
    # occurrence wins, as in build_symbol_maps).
    var cur: *ConstEntry = s.module.constants
    while cur != null
        if name_eq(cur.name, cur.name_len, name, len) == 1
            return cur
        cur = cur.next
    return null

# AGAST #2155: TYPE_F32 / TYPE_F64 when `ce` is a float const whose
# initializer is a constant integer expression (`const F: f64 = -1`,
# `= 2 + K`), with the folded integer in *out; 0 otherwise.  The use site
# must `sitofp` that integer to the const's type: it used to materialise it
# as `add i64 0, <v>` and hand the i64 to float code, which clang rejected.
# Folded here, not read from `ce.value`: a float const is never PENDING, so
# one naming a later integer const was not folded at parse time.
pub fn const_int_init_float_ty(s: *EmitterState, ce: *ConstEntry, out: *i64) -> i32
    if ce == null or (ce.const_type != TYPE_F32 and ce.const_type != TYPE_F64)
        return 0
    if const_fold_int(s.module.constants, ce.value_expr, 1, out) == 0
        return 0
    ce.const_type

fn is_const(s: *EmitterState, name: *u8, len: i32) -> i32
    # Check module constants first via HashMap
    if find_const_entry(s, name, len) != null
        return 1
    # Check builtin constants
    is_builtin_const(name, len)

# ritz-task-193 — allocate the five symbol-table HashMaps.  Called from
# emit_module right after `var s: EmitterState`.  Stack-allocated EmitterState
# starts with garbage HashMap entry pointers, so this MUST run before any
# add_local / find_* call hits the maps with a stale `entries` pointer.
pub fn init_emitter_maps(s: *EmitterState)
    # Pre-size to skip the grow cascade.  512 keeps local_map under the 75%
    # load factor for a fn of up to LOCALS_INIT_CAP locals; past that it grows.
    # Module-scope maps are sized for typical self-host modules (thousands
    # of fns/structs after monomorphization) — undersizing pays an O(N)
    # rehash cost on every doubling.  `hashmap_i64_with_cap` rounds up to
    # power-of-2, so the constants above need not be exact.
    s.local_map = hashmap_i64_with_cap(512)
    s.global_map = hashmap_i64_with_cap(256)
    s.fn_map = hashmap_i64_with_cap(8192)
    s.struct_map = hashmap_i64_with_cap(2048)
    s.const_map = hashmap_i64_with_cap(256)

# ritz-task-193 — populate per-module symbol tables from the AST after
# monomorphization.  emit_module calls this once; the maps stay valid for
# the lifetime of the EmitterState because nothing in the emit pipeline
# mutates `s.module.{globals,functions,structs,constants}` after init.
# First-occurrence wins (skip-if-contains) — preserves the head-first
# semantics of the legacy linked-list scans in the face of duplicate
# entries from import-merged modules.
pub fn build_symbol_maps(s: *EmitterState)
    var g: *GlobalVarDef = s.module.globals
    while g != null
        let kg: i64 = fnv1a_str(g.name, g.name_len) as i64
        if hashmap_i64_contains(@s.global_map, kg) == 0
            hashmap_i64_insert(@&s.global_map, kg, g as i64)
        g = g.next

    var fd: *FnDef = s.module.functions
    while fd != null
        let kf: i64 = fnv1a_str(fd.name, fd.name_len) as i64
        if hashmap_i64_contains(@s.fn_map, kf) == 0
            hashmap_i64_insert(@&s.fn_map, kf, fd as i64)
        fd = fd.next

    var st: *StructDef = s.module.structs
    while st != null
        let ks: i64 = fnv1a_str(st.name, st.name_len) as i64
        if hashmap_i64_contains(@s.struct_map, ks) == 0
            hashmap_i64_insert(@&s.struct_map, ks, st as i64)
        st = st.next

    var ce: *ConstEntry = s.module.constants
    while ce != null
        let kc: i64 = fnv1a_str(ce.name, ce.name_len) as i64
        if hashmap_i64_contains(@s.const_map, kc) == 0
            hashmap_i64_insert(@&s.const_map, kc, ce as i64)
        ce = ce.next

# AGAST #1504: the LLVM element type of a global `var g: [N]T`, exactly as
# emit_globals declares it (`@g = weak_odr global [N x <this>]`). Index
# lowering GEPs `[N x <this>], ptr @g, i64 0, i64 idx` and loads/stores at this
# width, so the declaration and every access must agree. It differs from
# emit_llvm_type, which lowers pointers to i64 and bool to i1. Struct elements
# are not covered here; the declaration names `%T` for those.  AGAST #1970:
# f32 / f64 elements are `float` / `double`, as for a local array (#1966);
# they were `i64`, so `g[i] = 2.5` stored `store i64 %double`.
# AGAST #1509: times a multi-dimensional array's TYPE_ARRAY element reached
# a 1-D element-type helper (field_array_elem_llvm), i.e. an N-D array use
# ritz1 does not lower.  Reported (and failed) by emit_module.
var g_nd_elem_leaks: i32 = 0

pub fn nd_elem_leaks() -> i32
    g_nd_elem_leaks

# AGAST #1509: the LLVM type of `sh` from dimension `from` inward:
# `[4 x [8 x i8]]` for `[4][8]u8` from 0, `[8 x i8]` from 1, and the bare
# leaf at from == rank.  The same spelling the alloca / global declares, so
# every GEP over the array agrees with its layout (ritz0's layout).
fn emit_array_shape_llvm(s: *EmitterState, sh: *ArrayShape, from: i32)
    var d: i32 = from
    while d < sh.rank
        emit_str(s, c"[")
        emit_int(s, sh.dims[d] as i64)
        emit_str(s, c" x ")
        d = d + 1
    if sh.leaf_type == TYPE_STRUCT and sh.leaf_name_len > 0
        emit_llvm_type_struct(s, TYPE_STRUCT, sh.leaf_name, sh.leaf_name_len)
    else
        emit_str(s, local_array_elem_llvm(sh.leaf_type))
    d = from
    while d < sh.rank
        emit_str(s, c"]")
        d = d + 1

fn global_array_elem_llvm(g: *GlobalVarDef) -> *u8
    return local_array_elem_llvm(g.array_elem_type)

# The LLVM element type of a non-struct `[N]T` array, global or local. It is
# the spelling both emit_globals and emit_var_decl's `alloca [N x T]` use, so
# every GEP / load / store over the array must use it too. AGAST #1564: the
# local-array index arms kept their own i8/i32/i64/ptr chains, so a local
# `[N]u32` / `[N]u16` / `[N]i16` was addressed as `[N x i64]` over a narrower
# alloca — 8-byte strides and stores that overran it.
fn array_elem_llvm(t: i32) -> *u8
    if t == TYPE_I32 or t == TYPE_U32
        return c"i32"
    if t == TYPE_U8 or t == TYPE_I8
        return c"i8"
    if t == TYPE_U16 or t == TYPE_I16
        return c"i16"
    if t == TYPE_PTR or t == TYPE_PTR_PTR
        return c"ptr"
    return c"i64"

# The LLVM element type of a non-struct `[N]T` STRUCT FIELD. This is the
# spelling emit_field_llvm_type declares the field with, so it must match
# ritz0's (the cross-compiler struct ABI) and every GEP over the field must
# use it. AGAST #1814: the field ladder lacked u16/i16/u32/f32/f64/bool, so
# `a: [4]u16` was declared `[4 x i64]` (32 bytes) while sizeof counted 8.
fn field_array_elem_llvm(t: i32) -> *u8
    if t == TYPE_ARRAY
        # AGAST #1509: a multi-dimensional array reached a 1-D element path.
        # Every lowered N-D access goes through emit_nd_index_ptr and
        # emit_array_shape_llvm; anything else used to treat the inner
        # array as one i64 and miscompile silently.  emit_module turns the
        # count into a hard error.
        g_nd_elem_leaks = g_nd_elem_leaks + 1
        return c"i64"
    if t == TYPE_F32
        return c"float"
    if t == TYPE_F64
        return c"double"
    if t == TYPE_BOOL
        return c"i1"
    return array_elem_llvm(t)

# The LLVM element type of a LOCAL `[N]T` array (`alloca [N x <this>]`) and
# therefore of every GEP / load / store over it: f32 / f64 elements are real
# `float` / `double`, as for a struct field (ritz0's layout).  AGAST #1966:
# they were `i64` slots, so `let a: [3]f32 = [1.0, 2.0, 3.5]` stored
# `store i64 %double`.  AGAST #2063: a bool element is an `i1` too, so a
# `*bool` has ONE pointee layout whether it points into a local / global
# `[N]bool` or a bool field (it kept an i64 slot, and `p[i]` strode 8
# bytes into a field array or 1 byte into a local one).  A global `[N]T`
# uses it too (global_array_elem_llvm, #1970).
fn local_array_elem_llvm(t: i32) -> *u8
    return field_array_elem_llvm(t)

# Widen an array element just loaded as `ty` (array_elem_llvm(t)) to the i64
# every expression value is carried in: zext unsigned, sext signed, ptrtoint
# pointers. i64 elements are returned as-is.  A bool element (`i1`, #2063)
# is zero-extended.
fn emit_array_elem_widen(s: *EmitterState, val: i32, t: i32, ty: *u8) -> i32
    var op: *u8 = null
    if t == TYPE_U8 or t == TYPE_U16 or t == TYPE_U32 or t == TYPE_BOOL
        op = c" = zext "
    else if t == TYPE_I8 or t == TYPE_I16 or t == TYPE_I32
        op = c" = sext "
    else if t == TYPE_PTR or t == TYPE_PTR_PTR
        op = c" = ptrtoint "
    if op == null
        return val
    let wide: i32 = next_reg(s)
    emit_str(s, c"  ")
    emit_reg(s, wide)
    emit_str(s, op)
    emit_str(s, ty)
    emit_str(s, c" ")
    emit_reg(s, val)
    emit_str(s, c" to i64\n")
    return wide

# The inverse of emit_array_elem_widen for a store: narrow an i64 value to the
# element type `ty` (trunc ints, inttoptr pointers). i64 is returned as-is.
fn emit_array_elem_narrow(s: *EmitterState, val: i32, t: i32, ty: *u8) -> i32
    var op: *u8 = null
    if t == TYPE_U8 or t == TYPE_I8 or t == TYPE_U16 or t == TYPE_I16 or t == TYPE_U32 or t == TYPE_I32
        op = c" = trunc i64 "
    else if t == TYPE_PTR or t == TYPE_PTR_PTR
        op = c" = inttoptr i64 "
    if op == null
        return val
    let narrow: i32 = next_reg(s)
    emit_str(s, c"  ")
    emit_reg(s, narrow)
    emit_str(s, op)
    emit_reg(s, val)
    emit_str(s, c" to ")
    emit_str(s, ty)
    emit_str(s, c"\n")
    return narrow

# AGAST #1596: the element kind for indexing THROUGH a pointer-typed struct
# field (`s.data[i]` with `data: *T` or `**T`). `**T` elements are pointers;
# a `*Struct` element is TYPE_STRUCT (spelled `%T` from field_type_name);
# primitive pointees (integers, since #2053 f32 / f64, and since #2063 bool)
# come from array_elem_type (#1304); their in-memory spelling is
# ptr_field_elem_llvm.  Anything else (an unrecorded pointee, a non-pointer
# field) is TYPE_UNKNOWN: ritz1 cannot address it at the right width, so
# callers must fail closed rather than guess a stride.  bool is an `i1`
# everywhere since #2063 (a local `[N]bool` kept i64 slots, so a `*bool`
# had no single stride).
fn ptr_field_elem_kind(field: *StructField) -> i32
    if field.field_type == TYPE_PTR_PTR
        return TYPE_PTR
    if field.field_type != TYPE_PTR
        return TYPE_UNKNOWN
    if field.field_type_name_len > 0
        return TYPE_STRUCT
    let t: i32 = field.array_elem_type
    if t == TYPE_I8 or t == TYPE_U8 or t == TYPE_I16 or t == TYPE_U16
        return t
    if t == TYPE_I32 or t == TYPE_U32 or t == TYPE_I64 or t == TYPE_U64
        return t
    if t == TYPE_F32 or t == TYPE_F64 or t == TYPE_BOOL
        return t
    return TYPE_UNKNOWN

# AGAST #2053: the LLVM type of ONE pointee of a pointer field, for a `kind`
# from ptr_field_elem_kind: `float` / `double` for f32 / f64 (a local `[N]f64`
# is `double` too since #1966), integers / pointers at their own width.
# array_elem_llvm spells f32 / f64 as i64, which is not what the pointer
# points at.
fn ptr_field_elem_llvm(kind: i32) -> *u8
    return local_array_elem_llvm(kind)

# AGAST #1596: address of element `idx` (an i64 register) through the
# pointer held in a struct field. `field_slot` points AT the field; the
# pointer is loaded from it and the GEP strides by the pointee (`kind` from
# ptr_field_elem_kind, never TYPE_UNKNOWN). The old lowering GEP'd the field
# slot itself as an inline `[0 x T]` array, writing into the struct.
fn emit_ptr_field_elem_addr(s: *EmitterState, field_slot: i32, field: *StructField, kind: i32, idx: i32) -> i32
    let base: i32 = next_reg(s)
    emit_str(s, c"  ")
    emit_reg(s, base)
    emit_str(s, c" = load ptr, ptr ")
    emit_reg(s, field_slot)
    emit_str(s, c"\n")
    let elem_ptr: i32 = next_reg(s)
    emit_str(s, c"  ")
    emit_reg(s, elem_ptr)
    emit_str(s, c" = getelementptr ")
    if kind == TYPE_STRUCT
        emit_llvm_type_struct(s, TYPE_STRUCT, field.field_type_name, field.field_type_name_len)
    else
        emit_str(s, ptr_field_elem_llvm(kind))
    emit_str(s, c", ptr ")
    emit_reg(s, base)
    emit_str(s, c", i64 ")
    emit_reg(s, idx)
    emit_str(s, c"\n")
    return elem_ptr

fn emit_llvm_type(s: *EmitterState, t: i32)
    if t == TYPE_VOID
        emit_str(s, c"void")
    else if t == TYPE_I32 or t == TYPE_U32
        emit_str(s, c"i32")
    else if t == TYPE_I64
        emit_str(s, c"i64")
    else if t == TYPE_U8
        emit_str(s, c"i8")
    else if t == TYPE_I8
        emit_str(s, c"i8")
    else if t == TYPE_U16 or t == TYPE_I16
        emit_str(s, c"i16")
    else if t == TYPE_U64
        emit_str(s, c"i64")
    else if t == TYPE_F32
        emit_str(s, c"float")
    else if t == TYPE_F64
        emit_str(s, c"double")
    else if t == TYPE_BOOL
        emit_str(s, c"i1")
    else if t == TYPE_PTR
        emit_str(s, c"i64")  # Pointers passed as i64
    else if t == TYPE_PTR_PTR
        emit_str(s, c"i64")  # Double pointers also i64
    else if t == TYPE_REF
        emit_str(s, c"i64")  # References are i64 at LLVM level
    else if t == TYPE_MUT_REF
        emit_str(s, c"ptr")  # Mutable references are pointers at LLVM level
    else
        emit_str(s, c"i64")

# Centralised float-type predicate for arith / cmp / cast dispatch.
# Returns 1 for TYPE_F32/F64 OR for the legacy TYPE_STRUCT+name="f32"/"f64"
# representation (some pre-Option-B code paths still surface floats as
# TYPE_STRUCT).  Once everything threads through type_named's new mapping
# the second branch becomes dead; it's kept until the migration settles.
pub fn is_float_type(t: i32, name: *u8, name_len: i32) -> i32
    if t == TYPE_F32 or t == TYPE_F64
        return 1
    if t == TYPE_STRUCT and name != null and name_len == 3
        if *(name + 0) == 102 and *(name + 1) == 51 and *(name + 2) == 50  # f32
            return 1
        if *(name + 0) == 102 and *(name + 1) == 54 and *(name + 2) == 52  # f64
            return 1
    return 0

# Returns 1 if the type name refers to a tagged-enum instantiation
# (`Result$...` or `Option$...`).  After ritz-task-133 these are lowered to a
# real LLVM struct `{ i8, [P x i8], [N x i8] }` (ritz0's layout, #1898) rather
# than the old packed-i64 representation.  Callers that emit payload load /
# store paths still key off this predicate to decide between "scalar slot"
# and "tagged-enum aggregate slot" code shapes.
fn is_tagged_enum_type(name: *u8, name_len: i32) -> i32
    if name_len >= 7
        # "Result$" = 82 101 115 117 108 116 36
        if *(name + 0) == 82
            if *(name + 1) == 101
                if *(name + 2) == 115
                    if *(name + 3) == 117
                        if *(name + 4) == 108
                            if *(name + 5) == 116
                                if *(name + 6) == 36
                                    return 1
        # "Option$" = 79 112 116 105 111 110 36
        if *(name + 0) == 79
            if *(name + 1) == 112
                if *(name + 2) == 116
                    if *(name + 3) == 105
                        if *(name + 4) == 111
                            if *(name + 5) == 110
                                if *(name + 6) == 36
                                    return 1
    return 0

# The concrete struct carried by a tagged enum's Ok/Some variant, named by
# its FIRST type argument; returns the name (a slice of `name`) and its
# length in *out_len, or null when that argument is not a known concrete
# struct (primitives, pointers).  ritz1 mangles every type argument (AGAST
# #1574): `Option<Point>` is `Option$Point`, `Result<String, E>` is
# `Result$String$E` and `Result<Vec<u8>, E>` is `Result$Vec$u8$E`.  Option
# has one argument, the whole suffix; for Result it is the shortest
# `$`-bounded prefix of the suffix naming a concrete struct.  (Not the first
# component alone: `Vec` there is the generic template.)
fn tagged_enum_payload_struct(s: *EmitterState, name: *u8, name_len: i32, out_len: *i32) -> *u8
    return tagged_enum_payload_named(s, name, name_len, out_len, 0)

# AGAST #2100: 1 if `name` is a concrete (non-generic) struct or, when
# allow_enum is 1, a non-generic user enum: a type a tagged-enum payload is
# stored as by value (#1466 builds a user-enum payload as its aggregate).
fn is_concrete_payload_type(s: *EmitterState, name: *u8, len: i32, allow_enum: i32) -> i32
    let st: *StructDef = find_struct(s, name, len)
    if st != null
        return (st.type_params == null) as i32
    if allow_enum == 1 and user_enum_index(name, len) >= 0
        return 1
    0

# tagged_enum_payload_struct; with allow_enum 1 the carried type may also be
# a non-generic user enum (AGAST #2100: `Some(x)` over `Option<Opt>`).
fn tagged_enum_payload_named(s: *EmitterState, name: *u8, name_len: i32, out_len: *i32, allow_enum: i32) -> *u8
    *out_len = 0
    if name == null
        return null
    var dollar: i32 = 0
    while dollar < name_len and *(name + dollar) != 36   # '$'
        dollar = dollar + 1
    let sfx: *u8 = name + dollar + 1
    let sfx_len: i32 = name_len - dollar - 1
    if sfx_len <= 0
        return null
    if dollar == 6 and *name == 79   # "Option": the whole suffix
        if allow_enum == 0 and find_struct(s, sfx, sfx_len) == null
            return null
        if allow_enum == 1 and is_concrete_payload_type(s, sfx, sfx_len, 1) == 0
            return null
        *out_len = sfx_len
        return sfx
    var end: i32 = 0
    while end < sfx_len
        end = end + 1
        while end < sfx_len and *(sfx + end) != 36
            end = end + 1
        if is_concrete_payload_type(s, sfx, end, allow_enum) == 1
            *out_len = end
            return sfx
    return null

# AGAST #1667: the struct type carried by `Result<T, E>`'s Err variant, i.e.
# E, recovered from the mangled `Result$T$E` name.  When T itself names a
# struct (tagged_enum_payload_struct), E is exactly the remainder after it.
# Otherwise T is a primitive and E is the shortest `$`-suffix naming a
# concrete (non-generic) struct: `Result$i64$ArgError` -> `ArgError`,
# `Result$i32$Box$i64` -> `Box$i64`.  Returns null (out_len 0) when E is
# not a struct, or for non-Result names; callers then keep the i64 binding.
fn tagged_enum_err_payload_struct(s: *EmitterState, name: *u8, name_len: i32, out_len: *i32) -> *u8
    return tagged_enum_err_payload_named(s, name, name_len, out_len, 0)

# tagged_enum_err_payload_struct; with allow_enum 1, T and E may also be
# non-generic user enums (AGAST #2100: `Err(e)` over `Result<i64, ArgError>`).
fn tagged_enum_err_payload_named(s: *EmitterState, name: *u8, name_len: i32, out_len: *i32, allow_enum: i32) -> *u8
    *out_len = 0
    if name == null or name_len <= 7
        return null
    # "Result$"
    if *name != 82 or *(name + 1) != 101 or *(name + 6) != 36
        return null
    let sfx: *u8 = name + 7
    let sfx_len: i32 = name_len - 7
    var ok_len: i32 = 0
    let ok_st: *u8 = tagged_enum_payload_named(s, name, name_len, @ok_len, allow_enum)
    if ok_st != null and ok_len > 0
        let rest_len: i32 = sfx_len - ok_len - 1
        if rest_len <= 0
            return null
        let rest: *u8 = sfx + ok_len + 1
        if is_concrete_payload_type(s, rest, rest_len, allow_enum) == 0
            return null
        *out_len = rest_len
        return rest
    # Shortest `$`-bounded suffix first; never the whole suffix (that is T).
    var start: i32 = sfx_len - 1
    while start > 0
        if *(sfx + start - 1) == 36   # '$'
            let cand: *u8 = sfx + start
            let cand_len: i32 = sfx_len - start
            if is_concrete_payload_type(s, cand, cand_len, allow_enum) == 1
                *out_len = cand_len
                return cand
        start = start - 1
    return null

# =============================================================================
# Tagged-enum layout (AGAST #1898) — byte-for-byte ritz0's _define_enum:
#
#     %Result$T$E = type { i8 tag, [pad x i8], [N x i8] payload }
#
# N is the largest payload (T, and E for Result), pad aligns the payload to
# the most-aligned of them: Result<i64, i32> is { i8, [7 x i8], [8 x i8] },
# Option<i32> is { i8, [3 x i8], [4 x i8] }.  ritz1 always emits the pad
# field, as `[0 x i8]` when nothing needs aligning, so the payload is field
# 2 everywhere; a zero-length array adds no bytes and no ABI element, so the
# type stays identical to ritz0's at a call boundary.
#
# ritz1 used one `{ i8, [144 x i8] }` for every instantiation (ritz-task-133,
# #1476).  Self-consistent, but the regression matrix links ritz1-compiled
# callers against ritz0-built ritzlib objects (and bootstrap mixes the two
# compilers' objects), and `file_size(..) -> Result<i64, i32>` came back
# through a 16-byte aggregate read as a 145-byte one with its payload at
# offset 1 instead of 8.
#
# An argument this cannot measure (a type the mangler spells as "", e.g.
# `Option<u32>` -> `Option$`; an unresolved struct; the raw `Result$T$E`
# placeholder) keeps the old conservative size, payload 8-aligned.  Such an
# instantiation is self-consistent within ritz1 but not ritz0-compatible.
# =============================================================================

# 144 = sizeof(Stat), the kernel's struct stat — the widest payload ritzlib
# had when this was the only size (AGAST #1476).
const TAGGED_ENUM_FALLBACK_BYTES: i64 = 144

# Arity of the generic one `$`-component of a mangled name names: Result 2,
# Option 1, a generic struct template its parameter count; 0 for a leaf
# (primitive, concrete struct, pointer to a leaf).  `ptr_` prefixes are
# skipped: `ptr_Vec$u8` is one argument.
fn te_component_arity(s: *EmitterState, name: *u8, len: i32) -> i32
    var p: *u8 = name
    var n: i32 = len
    while n > 4 and *p == 112 and *(p + 1) == 116 and *(p + 2) == 114 and *(p + 3) == 95   # "ptr_"
        p = p + 4
        n = n - 4
    if name_eq(p, n, c"Result", 6) == 1
        return 2
    if name_eq(p, n, c"Option", 6) == 1
        return 1
    let st: *StructDef = find_struct(s, p, n)
    if st == null or st.type_params == null
        return 0
    var k: i32 = 0
    var tp: *TypeParam = st.type_params
    while tp != null
        k = k + 1
        tp = tp.next
    k

# End (exclusive) of the mangled type argument starting at buf[pos]: its
# first component plus one nested argument per generic parameter.
fn te_arg_end(s: *EmitterState, buf: *u8, len: i32, pos: i32) -> i32
    var end: i32 = pos
    while end < len and *(buf + end) != 36   # '$'
        end = end + 1
    let arity: i32 = te_component_arity(s, buf + pos, end - pos)
    var k: i32 = 0
    while k < arity
        if end >= len
            return end
        end = te_arg_end(s, buf, len, end + 1)
        k = k + 1
    end

# The mangled type argument a tagged-enum variant carries: variant 0 is T
# (Ok / Some), variant 1 is Result's E.  null (out_len 0) for Option's None,
# a non-tagged name, or a name that does not split into exactly its
# arguments.  `Result$Vec$u8$i32`, variant 0 -> `Vec$u8`, 1 -> `i32`.
pub fn tagged_enum_arg(s: *EmitterState, name: *u8, len: i32, variant: i32, out_len: *i32) -> *u8
    *out_len = 0
    if name == null or is_tagged_enum_type(name, len) == 0
        return null
    let start: i32 = 7
    if start >= len
        return null
    let is_result: i32 = name_eq(name, 6, c"Result", 6)
    let end0: i32 = te_arg_end(s, name, len, start)
    if is_result == 0
        if variant != 0 or end0 != len
            return null
        *out_len = end0 - start
        return name + start
    if end0 + 1 >= len
        return null
    let e_start: i32 = end0 + 1
    let e_end: i32 = te_arg_end(s, name, len, e_start)
    if e_end != len
        return null
    if variant == 0
        *out_len = end0 - start
        return name + start
    if variant != 1
        return null
    *out_len = e_end - e_start
    return name + e_start

# Size and alignment (to *align) of the type one mangled argument spells,
# laid out as ritz0 does; 0 when it cannot be measured.
fn mangled_type_size_align(s: *EmitterState, name: *u8, len: i32, align: *i64) -> i64
    *align = 1
    if name == null or len <= 0
        return 0
    let ps: i64 = prim_name_size(name, len)
    if ps > 0
        *align = ps
        return ps
    if len > 4 and *name == 112 and *(name + 1) == 116 and *(name + 2) == 114 and *(name + 3) == 95   # "ptr_"
        *align = 8
        return 8
    if is_tagged_enum_type(name, len) == 1
        var pad: i64 = 0
        let n: i64 = tagged_enum_layout(s, name, len, @pad)
        return 1 + pad + n   # all-i8 struct: 1-aligned
    let st: *StructDef = find_struct(s, name, len)
    if st == null
        let uei: i32 = user_enum_index(name, len)
        if uei >= 0
            return user_enum_size(s, uei)   # all-i8 struct: 1-aligned (#1797)
        if is_enum_type(name, len) == 1
            return 1   # generic user enum: unmeasured, tag only
        return 0
    if st.type_params != null
        return 0
    *align = get_struct_align_by_name(s, name, len)
    get_struct_size_by_name(s, name, len)

# Payload byte count N of tagged enum `name`, with the padding between the
# tag and the payload written to *pad.  See the block comment above.
pub fn tagged_enum_layout(s: *EmitterState, name: *u8, len: i32, pad: *i64) -> i64
    *pad = 7
    var t_len: i32 = 0
    let t: *u8 = tagged_enum_arg(s, name, len, 0, @t_len)
    if t == null
        return TAGGED_ENUM_FALLBACK_BYTES
    var align: i64 = 1
    var size: i64 = mangled_type_size_align(s, t, t_len, @align)
    if size == 0
        return TAGGED_ENUM_FALLBACK_BYTES
    if name_eq(name, 6, c"Result", 6) == 1
        var e_len: i32 = 0
        let e: *u8 = tagged_enum_arg(s, name, len, 1, @e_len)
        if e == null
            return TAGGED_ENUM_FALLBACK_BYTES
        var e_align: i64 = 1
        let e_size: i64 = mangled_type_size_align(s, e, e_len, @e_align)
        if e_size == 0
            return TAGGED_ENUM_FALLBACK_BYTES
        if e_size > size
            size = e_size
        if e_align > align
            align = e_align
    *pad = (align - (1 % align)) % align
    size

# =============================================================================
# User-enum layout (AGAST #1797) — ritz0's _define_enum, as for Result/Option:
#
#     %Opt = type { i8 tag, [pad x i8], [N x i8] payload }
#
# N is the largest variant payload, pad aligns it to the most-aligned one.
# A variant's payload is its fields laid out like a struct's (each at its
# own alignment, the total rounded up to the strictest), ritz0's
# _enum_variant_field_layout.  `enum Opt / Vacant / Holds(i32)` is
# { i8, [3 x i8], [4 x i8] }.  As for tagged enums, ritz1 always writes the
# pad field (`[0 x i8]` when nothing needs aligning) so the payload is field
# 2; a zero-length array adds no bytes and no ABI element, so ritz0's
# `{ i8, [N x i8] }` is the same type at a call boundary.  An enum with no
# payload at all stays `{ i8 }`.
#
# Only non-generic enums are measured: a generic `enum Slot<T>` records `T`
# unsubstituted.  (ritzlib's Option / Result are generic and take the
# tagged-enum path above.)
# =============================================================================

# Tracker index of the non-generic user enum `name`, or -1.
pub fn user_enum_index(name: *u8, len: i32) -> i32
    if name == null or len <= 0
        return 0 - 1
    let ei: i32 = enum_find(name, len)
    if ei < 0
        return 0 - 1
    if enum_is_generic(ei) == 1
        return 0 - 1
    ei

# Size of one variant's payload fields, laid out in declaration order at
# their natural alignment and rounded up to the strictest (written to
# *align).  0 for a unit variant.
fn variant_payload_size_align(s: *EmitterState, fields: *StructField, align: *i64) -> i64
    var offset: i64 = 0
    var max_align: i64 = 1
    var f: *StructField = fields
    while f != null
        var falign: i64 = 8
        var fsize: i64 = 8
        if f.field_type == TYPE_ARRAY
            fsize = field_array_size_align(s, f, @falign)
        else
            fsize = elem_size_align(s, f.field_type, f.field_type_name, f.field_type_name_len, @falign)
        if falign < 1
            falign = 1
        let rem: i64 = offset % falign
        if rem != 0
            offset = offset + (falign - rem)
        offset = offset + fsize
        if falign > max_align
            max_align = falign
        f = f.next
    let rem2: i64 = offset % max_align
    if rem2 != 0
        offset = offset + (max_align - rem2)
    *align = max_align
    offset

# Payload byte count N of user enum `ei`, the tag-to-payload padding written
# to *pad.  0 (and pad 0) when no variant carries a payload.
pub fn user_enum_layout(s: *EmitterState, ei: i32, pad: *i64) -> i64
    *pad = 0
    var max_size: i64 = 0
    var max_align: i64 = 1
    let count: i32 = enum_variant_count(ei)
    for vi in 0..count
        var a: i64 = 1
        let sz: i64 = variant_payload_size_align(s, enum_variant_fields(ei, vi), @a)
        if sz > max_size
            max_size = sz
        if a > max_align
            max_align = a
    if max_size > 0
        *pad = (max_align - (1 % max_align)) % max_align
    max_size

# Total byte size of user enum `ei` (1 for a tag-only enum).
pub fn user_enum_size(s: *EmitterState, ei: i32) -> i64
    var pad: i64 = 0
    let n: i64 = user_enum_layout(s, ei, @pad)
    if n == 0
        return 1
    1 + pad + n

# The payload field of tuple variant `vi` of user enum `name` (null when it
# is not one: unit / struct variant, generic or unknown enum).
pub fn user_enum_tuple_field(name: *u8, len: i32, vi: i32) -> *StructField
    let ei: i32 = user_enum_index(name, len)
    if ei < 0 or vi < 0 or vi >= enum_variant_count(ei)
        return null
    if enum_variant_kind(ei, vi) != ENUM_VARIANT_TUPLE
        return null
    enum_variant_fields(ei, vi)

# Width in bits a scalar type code is stored at (see tagged_enum_scalar_bits).
fn type_code_scalar_bits(t: i32, signed: *i32) -> i32
    *signed = 1
    if t == TYPE_I8
        return 8
    if t == TYPE_I16
        return 16
    if t == TYPE_I32
        return 32
    *signed = 0
    if t == TYPE_U8 or t == TYPE_BOOL
        return 8
    if t == TYPE_U16
        return 16
    if t == TYPE_U32
        return 32
    *signed = 1
    64

# Integer width in bits of a scalar payload narrower than i64 — the width it
# is stored at, as ritz0 does — with *signed set for sign- vs zero-extension
# back to ritz1's i64 registers.  64 for i64 / pointers / anything else (the
# i64 store / load ritz1 has always done).  For a user enum (#1797)
# `variant` is the tag of a tuple variant; for Result/Option it is 0 for
# Ok / Some, 1 for Err.
pub fn tagged_enum_scalar_bits(s: *EmitterState, name: *u8, len: i32, variant: i32, signed: *i32) -> i32
    *signed = 1
    if is_tagged_enum_type(name, len) == 0
        let uf: *StructField = user_enum_tuple_field(name, len, variant)
        if uf == null
            return 64
        return type_code_scalar_bits(uf.field_type, signed)
    var c_len: i32 = 0
    let c: *u8 = tagged_enum_arg(s, name, len, variant, @c_len)
    if c == null
        return 64
    if name_eq(c, c_len, c"i8", 2) == 1
        return 8
    if name_eq(c, c_len, c"i16", 3) == 1
        return 16
    if name_eq(c, c_len, c"i32", 3) == 1
        return 32
    *signed = 0
    if name_eq(c, c_len, c"u8", 2) == 1 or name_eq(c, c_len, c"bool", 4) == 1
        return 8
    if name_eq(c, c_len, c"u16", 3) == 1
        return 16
    if name_eq(c, c_len, c"u32", 3) == 1
        return 32
    *signed = 1
    64

# AGAST #1945: TYPE_F32 / TYPE_F64 when the payload of `variant` (as for
# tagged_enum_scalar_bits) is a float, else 0.  Float payloads are stored and
# loaded as float / double, as ritz0 does, never through the i64 path.
pub fn tagged_enum_float_type(s: *EmitterState, name: *u8, len: i32, variant: i32) -> i32
    if is_tagged_enum_type(name, len) == 0
        let uf: *StructField = user_enum_tuple_field(name, len, variant)
        if uf == null
            return 0
        if uf.field_type == TYPE_F32 or uf.field_type == TYPE_F64
            return uf.field_type
        return 0
    var c_len: i32 = 0
    let c: *u8 = tagged_enum_arg(s, name, len, variant, @c_len)
    if c == null
        return 0
    if name_eq(c, c_len, c"f32", 3) == 1
        return TYPE_F32
    if name_eq(c, c_len, c"f64", 3) == 1
        return TYPE_F64
    0

# The LLVM spelling of float type code `t` (TYPE_F32 or TYPE_F64).
pub fn float_llvm_name(t: i32) -> *u8
    if t == TYPE_F32
        return c"float"
    c"double"

# Convert register `val`, of expression type `src_ty`, to float type `dst_ty`
# (TYPE_F32 / TYPE_F64): passthrough, fptrunc, fpext, or sitofp from the i64
# every integer is carried in.  Returns the converted register.
pub fn emit_float_coerce(s: *EmitterState, val: i32, src_ty: i32, dst_ty: i32) -> i32
    if src_ty == dst_ty
        return val
    let r: i32 = next_reg(s)
    emit_str(s, c"  ")
    emit_reg(s, r)
    if src_ty == TYPE_F64 and dst_ty == TYPE_F32
        emit_str(s, c" = fptrunc double ")
    else if src_ty == TYPE_F32 and dst_ty == TYPE_F64
        emit_str(s, c" = fpext float ")
    else
        emit_str(s, c" = sitofp i64 ")
    emit_reg(s, val)
    emit_str(s, c" to ")
    emit_str(s, float_llvm_name(dst_ty))
    emit_str(s, c"\n")
    r

# `<dst> = load i<bits>, ptr <pay_ptr>` widened to i64 for a scalar payload
# of `variant`; returns the i64 register.  See tagged_enum_scalar_bits.
pub fn emit_tagged_payload_load(s: *EmitterState, pay_ptr: i32, name: *u8, len: i32, variant: i32) -> i32
    # AGAST #1945: a float payload loads as float / double, unwidened.
    let ft: i32 = tagged_enum_float_type(s, name, len, variant)
    if ft != 0
        let fr: i32 = next_reg(s)
        emit_str(s, c"  ")
        emit_reg(s, fr)
        emit_str(s, c" = load ")
        emit_str(s, float_llvm_name(ft))
        emit_str(s, c", ptr ")
        emit_reg(s, pay_ptr)
        emit_str(s, c"\n")
        return fr
    var signed: i32 = 1
    let bits: i32 = tagged_enum_scalar_bits(s, name, len, variant, @signed)
    let r: i32 = next_reg(s)
    emit_str(s, c"  ")
    emit_reg(s, r)
    emit_str(s, c" = load i")
    emit_int(s, bits as i64)
    emit_str(s, c", ptr ")
    emit_reg(s, pay_ptr)
    emit_str(s, c"\n")
    if bits == 64
        return r
    let w: i32 = next_reg(s)
    emit_str(s, c"  ")
    emit_reg(s, w)
    if signed == 1
        emit_str(s, c" = sext i")
    else
        emit_str(s, c" = zext i")
    emit_int(s, bits as i64)
    emit_str(s, c" ")
    emit_reg(s, r)
    emit_str(s, c" to i64\n")
    w

# `store i<bits>` of the i64 register `val` into a scalar payload of
# `variant`, truncating first when the payload is narrower.
pub fn emit_tagged_payload_store(s: *EmitterState, val: i32, pay_ptr: i32, name: *u8, len: i32, variant: i32)
    # AGAST #1945: a float payload stores as float / double; `val` must
    # already be of that type (see emit_float_coerce).
    let ft: i32 = tagged_enum_float_type(s, name, len, variant)
    if ft != 0
        emit_str(s, c"  store ")
        emit_str(s, float_llvm_name(ft))
        emit_str(s, c" ")
        emit_reg(s, val)
        emit_str(s, c", ptr ")
        emit_reg(s, pay_ptr)
        emit_str(s, c"\n")
        return
    var signed: i32 = 1
    let bits: i32 = tagged_enum_scalar_bits(s, name, len, variant, @signed)
    var v: i32 = val
    if bits != 64
        v = next_reg(s)
        emit_str(s, c"  ")
        emit_reg(s, v)
        emit_str(s, c" = trunc i64 ")
        emit_reg(s, val)
        emit_str(s, c" to i")
        emit_int(s, bits as i64)
        emit_str(s, c"\n")
    emit_str(s, c"  store i")
    emit_int(s, bits as i64)
    emit_str(s, c" ")
    emit_reg(s, v)
    emit_str(s, c", ptr ")
    emit_reg(s, pay_ptr)
    emit_str(s, c"\n")

# Emit LLVM type with struct name support.  Tagged-enum types emit as the
# named struct so variant constructors / match / return paths share the same
# declared layout.
# Is this name a primitive integer/float/bool type? Used in several places
# where post-monomorphization a generic `T` has been substituted with a
# primitive but the AST still carries TYPE_STRUCT — we must NOT emit `%u16`
# struct references or `{ i8 }` fallback decls for those names.
pub fn is_primitive_type_name(name: *u8, len: i32) -> i32
    if name_eq(name, len, c"i8", 2) == 1
        return 1
    if name_eq(name, len, c"u8", 2) == 1
        return 1
    if name_eq(name, len, c"i16", 3) == 1
        return 1
    if name_eq(name, len, c"u16", 3) == 1
        return 1
    if name_eq(name, len, c"i32", 3) == 1
        return 1
    if name_eq(name, len, c"u32", 3) == 1
        return 1
    if name_eq(name, len, c"i64", 3) == 1
        return 1
    if name_eq(name, len, c"u64", 3) == 1
        return 1
    if name_eq(name, len, c"f32", 3) == 1
        return 1
    if name_eq(name, len, c"f64", 3) == 1
        return 1
    if name_eq(name, len, c"bool", 4) == 1
        return 1
    if name_eq(name, len, c"usize", 5) == 1
        return 1
    if name_eq(name, len, c"isize", 5) == 1
        return 1
    0

# AGAST #167: SIMD vector type names (`v4i32`, `v16i8`, etc).  ritz0 treats
# these as builtin types in name_resolver.BUILTIN_TYPES.  ritz1's parser
# accepts them as struct-name annotations; without explicit recognition they
# fall through to the `%v4i32 = type { i8 }` fallback decl, breaking the
# stride for `simd_*` builtins which must produce/consume real LLVM `<N x iM>`
# vectors.  Returns 1 for all SSE2 (128-bit) and AVX2 (256-bit) name shapes
# the cryptosec / squeeze libs use.
pub fn is_simd_vector_type_name(name: *u8, len: i32) -> i32
    if name_eq(name, len, c"v16i8", 5) == 1
        return 1
    if name_eq(name, len, c"v8i16", 5) == 1
        return 1
    if name_eq(name, len, c"v4i32", 5) == 1
        return 1
    if name_eq(name, len, c"v2i64", 5) == 1
        return 1
    if name_eq(name, len, c"v32i8", 5) == 1
        return 1
    if name_eq(name, len, c"v16i16", 6) == 1
        return 1
    if name_eq(name, len, c"v8i32", 5) == 1
        return 1
    if name_eq(name, len, c"v4i64", 5) == 1
        return 1
    0

# Emit the LLVM `<N x iM>` syntax for a SIMD vector type name.  Caller must
# ensure `is_simd_vector_type_name(name, len) == 1` first.
pub fn emit_simd_vector_type(s: *EmitterState, name: *u8, len: i32)
    if name_eq(name, len, c"v16i8", 5) == 1
        emit_str(s, c"<16 x i8>")
    else if name_eq(name, len, c"v8i16", 5) == 1
        emit_str(s, c"<8 x i16>")
    else if name_eq(name, len, c"v4i32", 5) == 1
        emit_str(s, c"<4 x i32>")
    else if name_eq(name, len, c"v2i64", 5) == 1
        emit_str(s, c"<2 x i64>")
    else if name_eq(name, len, c"v32i8", 5) == 1
        emit_str(s, c"<32 x i8>")
    else if name_eq(name, len, c"v16i16", 6) == 1
        emit_str(s, c"<16 x i16>")
    else if name_eq(name, len, c"v8i32", 5) == 1
        emit_str(s, c"<8 x i32>")
    else if name_eq(name, len, c"v4i64", 5) == 1
        emit_str(s, c"<4 x i64>")

# Element bit width for a SIMD vector type — used by `simd_rotl` to compute
# the wrap-around shift constants.  Returns 0 for non-SIMD names.
pub fn simd_vector_elem_bits(name: *u8, len: i32) -> i32
    if name_eq(name, len, c"v16i8", 5) == 1
        return 8
    if name_eq(name, len, c"v8i16", 5) == 1
        return 16
    if name_eq(name, len, c"v4i32", 5) == 1
        return 32
    if name_eq(name, len, c"v2i64", 5) == 1
        return 64
    if name_eq(name, len, c"v32i8", 5) == 1
        return 8
    if name_eq(name, len, c"v16i16", 6) == 1
        return 16
    if name_eq(name, len, c"v8i32", 5) == 1
        return 32
    if name_eq(name, len, c"v4i64", 5) == 1
        return 64
    0

# Element count for a SIMD vector type — used by `simd_rotl` to broadcast
# constant shift amounts.
pub fn simd_vector_elem_count(name: *u8, len: i32) -> i32
    if name_eq(name, len, c"v16i8", 5) == 1
        return 16
    if name_eq(name, len, c"v8i16", 5) == 1
        return 8
    if name_eq(name, len, c"v4i32", 5) == 1
        return 4
    if name_eq(name, len, c"v2i64", 5) == 1
        return 2
    if name_eq(name, len, c"v32i8", 5) == 1
        return 32
    if name_eq(name, len, c"v16i16", 6) == 1
        return 16
    if name_eq(name, len, c"v8i32", 5) == 1
        return 8
    if name_eq(name, len, c"v4i64", 5) == 1
        return 4
    0

# Element scalar LLVM type ("i8"/"i16"/"i32"/"i64") for a SIMD vector name —
# used for extractelement/insertelement opcodes.
pub fn emit_simd_elem_type(s: *EmitterState, name: *u8, len: i32)
    let bits: i32 = simd_vector_elem_bits(name, len)
    if bits == 8
        emit_str(s, c"i8")
    else if bits == 16
        emit_str(s, c"i16")
    else if bits == 32
        emit_str(s, c"i32")
    else if bits == 64
        emit_str(s, c"i64")

fn emit_llvm_type_struct(s: *EmitterState, t: i32, name: *u8, name_len: i32)
    if t == TYPE_STRUCT
        # Post-monomorphization (and pre-monomorph for explicit primitive
        # type annotations like `let x: f32`), TYPE_STRUCT + name="u16"/
        # "f32"/"i32"/etc. flows through this helper. The parser doesn't
        # have dedicated tokens for primitive types — they're parsed as
        # generic struct-name annotations. Map them back to LLVM
        # primitives so signatures/calls match.
        if name_eq(name, name_len, c"i8", 2) == 1 or name_eq(name, name_len, c"u8", 2) == 1
            emit_str(s, c"i8")
            return
        if name_eq(name, name_len, c"i16", 3) == 1 or name_eq(name, name_len, c"u16", 3) == 1
            emit_str(s, c"i16")
            return
        if name_eq(name, name_len, c"i32", 3) == 1 or name_eq(name, name_len, c"u32", 3) == 1
            emit_str(s, c"i32")
            return
        if name_eq(name, name_len, c"i64", 3) == 1 or name_eq(name, name_len, c"u64", 3) == 1
            emit_str(s, c"i64")
            return
        if name_eq(name, name_len, c"f32", 3) == 1
            emit_str(s, c"float")
            return
        if name_eq(name, name_len, c"f64", 3) == 1
            emit_str(s, c"double")
            return
        if name_eq(name, name_len, c"bool", 4) == 1
            emit_str(s, c"i1")
            return
        if name_eq(name, name_len, c"usize", 5) == 1 or name_eq(name, name_len, c"isize", 5) == 1
            emit_str(s, c"i64")
            return
        if name_eq(name, name_len, c"void", 4) == 1
            # `-> void` parses as TYPE_STRUCT with name "void" because the
            # parser uses the generic type-name slot for unknown names.
            # cryptosec.aes / cryptosec.aes_gcm have `pub fn foo(...) -> void`
            # — without this branch we emit `%void = type { i8 }` and
            # `ret void` mismatches the function signature.
            emit_str(s, c"void")
            return
        # AGAST #167: SIMD vector types (`v4i32`, `v16i8`, etc) lower to
        # native LLVM `<N x iM>` rather than the named-struct fallback.
        # Without this, `let v: v4i32 = simd_loadu(...)` allocas a bogus
        # `%v4i32 = type { i8 }` and stores type-mismatch the call result.
        if is_simd_vector_type_name(name, name_len) == 1
            emit_simd_vector_type(s, name, name_len)
            return
        emit_str(s, c"%")
        emit_name(s, name, name_len)
    else
        emit_llvm_type(s, t)

# =============================================================================
# AGAST #168: layout-equivalence coercion for Span$u8 ↔ StrView.
#
# Both have identical LLVM layout `{ ptr, i64 }` but are nominally distinct
# named struct types — LLVM IR rejects `store %A, ptr <%B-typed slot>`.
# A bare string literal `"..."` lowers to `%Span$u8`, but `let x: StrView = "..."`
# allocates a `%StrView` slot.  We emit a decompose-and-rebuild
# (extractvalue + insertvalue) on each store/assign/return whose source name
# disagrees with the destination name.
# =============================================================================

# Returns 1 if (src_name, dst_name) is the StrView↔Span$u8 layout-equivalent
# pair (in either direction), else 0.  Names of zero length / null pointers
# return 0.
fn is_layout_equiv_pair(src_name: *u8, src_len: i32, dst_name: *u8, dst_len: i32) -> i32
    if src_name == null
        return 0
    if dst_name == null
        return 0
    if src_len == 0
        return 0
    if dst_len == 0
        return 0
    let src_is_span_u8: i32 = name_eq(src_name, src_len, c"Span$u8", 7)
    let src_is_strview: i32 = name_eq(src_name, src_len, c"StrView", 7)
    let dst_is_span_u8: i32 = name_eq(dst_name, dst_len, c"Span$u8", 7)
    let dst_is_strview: i32 = name_eq(dst_name, dst_len, c"StrView", 7)
    if src_is_span_u8 == 1 and dst_is_strview == 1
        return 1
    if src_is_strview == 1 and dst_is_span_u8 == 1
        return 1
    0

# Decompose `%src_name { ptr, i64 }` and rebuild as `%dst_name { ptr, i64 }`.
# Caller must verify is_layout_equiv_pair == 1 before invoking.  Returns
# the register holding the rebuilt aggregate.
fn rebuild_layout_equiv(s: *EmitterState, src_reg: i32, src_name: *u8, src_len: i32, dst_name: *u8, dst_len: i32) -> i32
    let p: i32 = next_reg(s)
    emit_str(s, c"  ")
    emit_reg(s, p)
    emit_str(s, c" = extractvalue %")
    emit_name(s, src_name, src_len)
    emit_str(s, c" ")
    emit_reg(s, src_reg)
    emit_str(s, c", 0\n")
    let l: i32 = next_reg(s)
    emit_str(s, c"  ")
    emit_reg(s, l)
    emit_str(s, c" = extractvalue %")
    emit_name(s, src_name, src_len)
    emit_str(s, c" ")
    emit_reg(s, src_reg)
    emit_str(s, c", 1\n")
    let r1: i32 = next_reg(s)
    emit_str(s, c"  ")
    emit_reg(s, r1)
    emit_str(s, c" = insertvalue %")
    emit_name(s, dst_name, dst_len)
    emit_str(s, c" undef, ptr ")
    emit_reg(s, p)
    emit_str(s, c", 0\n")
    let r2: i32 = next_reg(s)
    emit_str(s, c"  ")
    emit_reg(s, r2)
    emit_str(s, c" = insertvalue %")
    emit_name(s, dst_name, dst_len)
    emit_str(s, c" ")
    emit_reg(s, r1)
    emit_str(s, c", i64 ")
    emit_reg(s, l)
    emit_str(s, c", 1\n")
    r2

# =============================================================================
# AGAST #1730 — large struct returns go through an sret pointer
# =============================================================================
#
# ritz1 used to return every struct as a first-class LLVM aggregate
# (`%v = load %T, ptr %slot` / `ret %T %v`).  For a big struct such as
# ritzlib/lang/tokens.ritz's 22 KB %TokenDefs, InstCombine at -O2 unpacks
# that load into one scalar per leaf (~21k) and clang grows past 13 GB.  Any
# first-class value of such a type does it — a call result stored to a
# local, or a load stored to the sret slot — so the only IR that stays fast
# copies the bytes from pointer to pointer.
#
# A function whose struct return is at least SRET_MIN_BYTES is therefore
# defined `define void @f(ptr sret(%T) %ret.sret, ...)`, every `ret` site
# copies into %ret.sret, and every call site passes a fresh `alloca %T`.
#
# The copy is NOT llvm.memcpy: at these sizes codegen lowers that intrinsic
# to a call to libc `memcpy`, and Ritz links -nostdlib.  It calls a
# module-internal byte loop instead (emit_sret_helpers), which carries
# "no-builtins" so loop-idiom recognition cannot turn it back into memcpy.
#
# This is ABI-identical to the first-class form ritz0 still emits: LLVM
# already demotes a first-class return that does not fit in the return
# registers to a hidden pointer in the first argument register, and returns
# that pointer, exactly as an explicit sret does.  256 bytes is far above
# the largest register return on any target LLVM supports (x86-64: 2 GPRs
# + 2 XMM; AArch64: 8 GPRs + 8 Q regs = 192 B), so objects from either
# compiler keep linking.  Below the threshold nothing changes.
const SRET_MIN_BYTES: i64 = 256

fn struct_ret_uses_sret(s: *EmitterState, t: i32, name: *u8, len: i32) -> i32
    if t != TYPE_STRUCT or name == null or len <= 0
        return 0
    if is_primitive_type_name(name, len) == 1
        return 0
    # Tagged enums (Result$/Option$) are not StructDefs and keep their ABI.
    if is_tagged_enum_type(name, len) == 1
        return 0
    if find_struct(s, name, len) == null
        return 0
    # get_struct_size_by_name rounds nested alignment up, so it may slightly
    # overestimate; that only matters near the threshold, where any size is
    # still memory-returned.  The memcpy length is exact (emit_sret_size).
    if get_struct_size_by_name(s, name, len) < SRET_MIN_BYTES
        return 0
    1

# The exact LLVM alloc size of %T as a constant expression, prefixed `i64 `.
fn emit_sret_size(s: *EmitterState, name: *u8, len: i32)
    emit_str(s, c"i64 ptrtoint (ptr getelementptr (%")
    emit_name(s, name, len)
    emit_str(s, c", ptr null, i32 1) to i64)")

# `ptr sret(%T) ` — the attribute both the definition and every call carry.
fn emit_sret_attr(s: *EmitterState, name: *u8, len: i32)
    emit_str(s, c"ptr sret(%")
    emit_name(s, name, len)
    emit_str(s, c") ")

# AGAST #1739 — large by-value struct PARAMS are `ptr byval(%T) align 8`.
#
# A param of a struct at the sret threshold used to be a first-class %T
# argument (`define @f(%Big %b.arg)` + `store %Big %b.arg, ptr %slot`, and
# every caller loaded the argument first-class), which hangs clang -O2 for
# the same reason #1730 fixed for returns.  It was also not the C ABI: LLVM
# splits a first-class aggregate argument into one scalar per leaf, while C
# passes a large struct in memory.  `ptr byval(%T) align 8` is exactly what
# clang emits for a C `struct T` param on x86-64 SysV (Ritz structs are at
# most 8-aligned).  The callee binds the param to the byval pointer, which it
# owns; the caller spills the argument into a fresh slot right after
# evaluating it (emit_call_arg), so rewrite_large_struct_copies (#1732)
# turns that spill into a pointer-to-pointer copy.  Uses the sret threshold,
# so small structs, tagged enums and primitives keep their ABI.
fn param_uses_byval(s: *EmitterState, p: *Param) -> i32
    if p == null
        return 0
    struct_ret_uses_sret(s, p.param_type, p.param_type_name, p.param_type_name_len)

# `ptr byval(%T) align 8` — what the definition, declare and every call carry.
fn emit_byval_attr(s: *EmitterState, name: *u8, len: i32)
    emit_str(s, c"ptr byval(%")
    emit_name(s, name, len)
    emit_str(s, c") align 8")

# Emit the LLVM type `[N x T]` of a 1-D local array (element struct `name`).
# The spelling matches emit_var_decl's alloca, so a copy loads and stores
# exactly the local's bytes.
fn emit_local_array_llvm_type(s: *EmitterState, size: i32, et: i32, name: *u8, name_len: i32)
    emit_str(s, c"[")
    emit_int(s, size as i64)
    emit_str(s, c" x ")
    if et == TYPE_STRUCT and name_len > 0
        emit_str(s, c"%")
        emit_name(s, name, name_len)
    else
        emit_str(s, local_array_elem_llvm(et))
    emit_str(s, c"]")

# The LLVM type of param `p` in a signature or call argument list.  AGAST #2287:
# a by-value `[N]T` is a first-class `[N x T]`, as ritz0 emits it.
fn emit_param_llvm_type(s: *EmitterState, p: *Param)
    if param_uses_byval(s, p) == 1
        emit_byval_attr(s, p.param_type_name, p.param_type_name_len)
        return
    if p.param_type == TYPE_ARRAY
        emit_local_array_llvm_type(s, p.param_array_size, p.param_array_elem_type, p.param_type_name, p.param_type_name_len)
        return
    emit_llvm_type_struct(s, p.param_type, p.param_type_name, p.param_type_name_len)

# Return from an sret fn by copying the %T at register `src_ptr` (a `ptr`).
fn emit_sret_ret_from_ptr(s: *EmitterState, src_ptr: i32)
    emit_str(s, c"  call void @__ritz_sret_copy(ptr %ret.sret, ptr ")
    emit_reg(s, src_ptr)
    emit_str(s, c", ")
    emit_sret_size(s, s.ret_type_name, s.ret_type_name_len)
    emit_str(s, c")\n")
    emit_str(s, c"  ret void\n")
    s.sret_helpers_used = 1

# Module-internal byte copy / zero used by every sret return.  Defined once
# per module, only when used.  "no-builtins" keeps clang from rewriting the
# loops into libc memcpy/memset calls (see build.py FREESTANDING_FLAGS).
fn emit_sret_helpers(s: *EmitterState)
    if s.sret_helpers_used == 0
        return
    emit_str(s, c"define internal void @__ritz_sret_copy(ptr %d, ptr %s, i64 %n) \"no-builtins\" {\n")
    emit_str(s, c"entry:\n")
    emit_str(s, c"  %z = icmp eq i64 %n, 0\n")
    emit_str(s, c"  br i1 %z, label %done, label %loop\n")
    emit_str(s, c"loop:\n")
    emit_str(s, c"  %i = phi i64 [ 0, %entry ], [ %i1, %loop ]\n")
    emit_str(s, c"  %sp = getelementptr i8, ptr %s, i64 %i\n")
    emit_str(s, c"  %c = load i8, ptr %sp\n")
    emit_str(s, c"  %dp = getelementptr i8, ptr %d, i64 %i\n")
    emit_str(s, c"  store i8 %c, ptr %dp\n")
    emit_str(s, c"  %i1 = add i64 %i, 1\n")
    emit_str(s, c"  %more = icmp ult i64 %i1, %n\n")
    emit_str(s, c"  br i1 %more, label %loop, label %done\n")
    emit_str(s, c"done:\n")
    emit_str(s, c"  ret void\n")
    emit_str(s, c"}\n\n")
    emit_str(s, c"define internal void @__ritz_sret_zero(ptr %d, i64 %n) \"no-builtins\" {\n")
    emit_str(s, c"entry:\n")
    emit_str(s, c"  %z = icmp eq i64 %n, 0\n")
    emit_str(s, c"  br i1 %z, label %done, label %loop\n")
    emit_str(s, c"loop:\n")
    emit_str(s, c"  %i = phi i64 [ 0, %entry ], [ %i1, %loop ]\n")
    emit_str(s, c"  %dp = getelementptr i8, ptr %d, i64 %i\n")
    emit_str(s, c"  store i8 0, ptr %dp\n")
    emit_str(s, c"  %i1 = add i64 %i, 1\n")
    emit_str(s, c"  %more = icmp ult i64 %i1, %n\n")
    emit_str(s, c"  br i1 %more, label %loop, label %done\n")
    emit_str(s, c"done:\n")
    emit_str(s, c"  ret void\n")
    emit_str(s, c"}\n\n")

# Return from an sret fn given a first-class %T value register.  When `val`
# is the load of an sret call's slot (`return f()`), copy the slot itself;
# otherwise spill the value and copy that.
fn emit_sret_ret_value(s: *EmitterState, val: i32)
    if val == s.sret_last_val and s.sret_last_slot > 0
        emit_sret_ret_from_ptr(s, s.sret_last_slot)
        return
    let tmp: i32 = next_reg(s)
    emit_str(s, c"  ")
    emit_reg(s, tmp)
    emit_str(s, c" = alloca %")
    emit_name(s, s.ret_type_name, s.ret_type_name_len)
    emit_str(s, c"\n  store %")
    emit_name(s, s.ret_type_name, s.ret_type_name_len)
    emit_str(s, c" ")
    emit_reg(s, val)
    emit_str(s, c", ptr ")
    emit_reg(s, tmp)
    emit_str(s, c"\n")
    emit_sret_ret_from_ptr(s, tmp)

# Caller side: allocate the result slot for a call to an sret fn.  Emit it
# BEFORE the `call` line; pass it with emit_sret_attr + emit_reg.
fn emit_sret_call_slot(s: *EmitterState, name: *u8, len: i32) -> i32
    let slot: i32 = next_reg(s)
    emit_str(s, c"  ")
    emit_reg(s, slot)
    emit_str(s, c" = alloca %")
    emit_name(s, name, len)
    emit_str(s, c"\n")
    slot

# Caller side, after the call: load the result into `result` as the
# first-class value every consumer expects, and remember the slot.
fn emit_sret_call_result(s: *EmitterState, result: i32, slot: i32, name: *u8, len: i32)
    emit_str(s, c"  ")
    emit_reg(s, result)
    emit_str(s, c" = load %")
    emit_name(s, name, len)
    emit_str(s, c", ptr ")
    emit_reg(s, slot)
    emit_str(s, c"\n")
    s.sret_last_val = result
    s.sret_last_slot = slot

# Coerce the struct value `val` produced by `expr` to the named return type
# `dst_name` when the two are the Span$u8 ↔ StrView layout-equivalent pair;
# otherwise return `val` unchanged.  Shared by every struct `ret` site: the
# explicit `return <expr>` path (#168) and the implicit tail-expression return
# in the emit_fn / emit_impl_method epilogue (#1643), where a tail `"no"` in a
# `-> StrView` fn lowered to `ret %StrView <%Span$u8 value>`.
fn coerce_struct_ret_value(s: *EmitterState, expr: *Expr, val: i32, dst_name: *u8, dst_len: i32) -> i32
    var src_name: *u8 = null
    var src_len: i32 = 0
    resolve_expr_struct_name(s, expr, @src_name, @src_len)
    if is_layout_equiv_pair(src_name, src_len, dst_name, dst_len) == 1
        return rebuild_layout_equiv(s, val, src_name, src_len, dst_name, dst_len)
    val

# AGAST #1600: the user enum a bare identifier `B` denotes as a VALUE — a
# unit variant of exactly one non-generic enum, the name not shadowed by a
# const, local, global or fn (those resolve first in emit_expr_ident).
# Returns the enum index with *out_vi = the tag; -1 if `e` is not one; -2 if
# two enums declare the name (*out_vi / *out_other = the two enum indices,
# for the caller's error).  A payload variant used bare is -1: it is not a
# value without its payload.
fn bare_unit_variant_enum(s: *EmitterState, e: *Expr, out_vi: *i32, out_other: *i32) -> i32
    *out_vi = 0 - 1
    *out_other = 0 - 1
    if e == null or e.kind != EXPR_IDENT
        return 0 - 1
    if is_const(s, e.ident_ptr, e.ident_len) == 1
        return 0 - 1
    if find_local(s, e.ident_ptr, e.ident_len) >= 0
        return 0 - 1
    if find_global(s, e.ident_ptr, e.ident_len) != null
        return 0 - 1
    if find_fn(s, e.ident_ptr, e.ident_len) != null
        return 0 - 1
    let ei: i32 = enum_of_variant_unique(e.ident_ptr, e.ident_len, out_vi, out_other)
    if ei < 0
        return ei
    if enum_variant_kind(ei, *out_vi) != ENUM_VARIANT_UNIT
        *out_vi = 0 - 1
        return 0 - 1
    return ei

# AGAST #1797: the user enum a call `Holds(x)` constructs — a one-payload
# tuple variant of a non-generic enum, resolved as try_emit_user_variant_ctor
# does (it wins over a same-named fn, as in ritz0).  null/0 otherwise.
# AGAST #1610: also a unit variant called with no arguments, `Red()` (built
# with no payload; it used to fall through to a fn call returning i64).
# AGAST #2039: a name two enums declare is no ctor here (null): the caller,
# try_emit_user_variant_ctor, reports it via user_variant_ctor_ambiguous.
pub fn user_variant_ctor_enum(e: *Expr, out_name: **u8, out_len: *i32)
    *out_name = null
    *out_len = 0
    if e == null or e.kind != EXPR_CALL
        return
    var vi: i32 = 0
    var other: i32 = 0
    let ei: i32 = enum_of_variant_unique(e.func_name, e.func_name_len, @vi, @other)
    if ei < 0
        return
    let kind: i32 = enum_variant_kind(ei, vi)
    if kind == ENUM_VARIANT_UNIT
        if e.args != null
            return
    else if kind == ENUM_VARIANT_TUPLE
        if e.args == null or e.args.next != null
            return
    else
        return
    *out_name = enum_name_at(ei, out_len)

# AGAST #2039: a call `B()` / `Holds(x)` whose callee name two or more
# non-generic enums declare as a variant.  Returns 1 and fills *out_a /
# *out_b with the two enums to name (enum_of_variant_unique's -2), else 0.
pub fn user_variant_ctor_ambiguous(e: *Expr, out_a: *i32, out_b: *i32) -> i32
    if e == null or e.kind != EXPR_CALL
        return 0
    if enum_of_variant_unique(e.func_name, e.func_name_len, out_a, out_b) == 0 - 2
        return 1
    return 0

# AGAST #1466: the enum a qualified variant `E.V(args)` (EXPR_METHOD) or
# `E.V` (EXPR_MEMBER) names.  Returns the enum index with *out_vi = the tag,
# or -1 when `e` is not one.  As in ritz0, a local or global named `E`
# shadows the enum (the expression is then a method call / field access on
# it), and a variant beats an impl method of the same name on the enum.
# Generic enums are returned too (callers check enum_is_generic: ritz1 has
# no generic-enum specialisation, so those are located errors).
pub fn qualified_variant(s: *EmitterState, e: *Expr, out_vi: *i32) -> i32
    *out_vi = 0 - 1
    if e == null or (e.kind != EXPR_METHOD and e.kind != EXPR_MEMBER)
        return 0 - 1
    let q: *Expr = e.left
    if q == null or q.kind != EXPR_IDENT
        return 0 - 1
    if find_local(s, q.ident_ptr, q.ident_len) >= 0
        return 0 - 1
    if find_global(s, q.ident_ptr, q.ident_len) != null
        return 0 - 1
    let ei: i32 = enum_find(q.ident_ptr, q.ident_len)
    if ei < 0
        return 0 - 1
    let vi: i32 = enum_variant_index(q.ident_ptr, q.ident_len, e.ident_ptr, e.ident_len)
    if vi < 0
        return 0 - 1
    *out_vi = vi
    return ei

# AGAST #1466: the (non-generic) enum a qualified variant `E.V(args)` or
# `E.V` builds, for type inference (untyped let, match scrutinee, an
# aggregate payload).  null/0 otherwise.
pub fn qualified_variant_enum(s: *EmitterState, e: *Expr, out_name: **u8, out_len: *i32)
    *out_name = null
    *out_len = 0
    var vi: i32 = 0
    let ei: i32 = qualified_variant(s, e, @vi)
    if ei < 0 or enum_is_generic(ei) == 1
        return
    *out_name = enum_name_at(ei, out_len)

# AGAST #1466: a qualified variant ritz1 cannot build, as
# `error: <file>:<line>:<col>: 'E.V' <msg>`.  Counted like emit_ir_error, so
# no output is written; returns a placeholder register.
pub fn emit_qualified_variant_error(s: *EmitterState, e: *Expr, msg: *u8) -> i32
    emit_str(s, c"  ; ERROR: qualified variant ")
    emit_str(s, msg)
    emit_str(s, c"\n")
    eprints_cstr(c"error: ")
    let file: *u8 = emitter_source_file()
    if file != null
        eprints_cstr(file)
    else
        eprints_cstr(c"<input>")
    eprints_cstr(c":")
    eprint_int(e.span.line as i64)
    eprints_cstr(c":")
    eprint_int(e.span.col as i64)
    eprints_cstr(c": '")
    eprint_bytes(e.left.ident_ptr, e.left.ident_len)
    eprints_cstr(c".")
    eprint_bytes(e.ident_ptr, e.ident_len)
    eprints_cstr(c"' ")
    eprints_cstr(msg)
    eprints_cstr(c"\n")
    s.error_count = s.error_count + 1
    let z: i32 = next_reg(s)
    emit_str(s, c"  ")
    emit_reg(s, z)
    emit_str(s, c" = add i64 0, 0\n")
    z

# AGAST #1600 / #2039: `name` (a bare variant used as a value, or the callee
# of a ctor call) is a variant of two enums (`ea`, `eb`).  Whatever the
# expected type, this is a located error asking for the qualified form; ritz0
# prints the same text.  Counted like emit_ir_error, so no output is written;
# returns a placeholder register to keep the IR well-formed.
pub fn emit_ambiguous_variant_error(s: *EmitterState, name: *u8, len: i32, span: SrcSpan, ea: i32, eb: i32) -> i32
    var a_len: i32 = 0
    let a: *u8 = enum_name_at(ea, @a_len)
    var b_len: i32 = 0
    let b: *u8 = enum_name_at(eb, @b_len)
    emit_str(s, c"  ; ERROR: ambiguous enum variant '")
    emit_name(s, name, len)
    emit_str(s, c"'\n")
    eprints_cstr(c"error: ")
    let file: *u8 = emitter_source_file()
    if file != null
        eprints_cstr(file)
    else
        eprints_cstr(c"<input>")
    eprints_cstr(c":")
    eprint_int(span.line as i64)
    eprints_cstr(c":")
    eprint_int(span.col as i64)
    eprints_cstr(c": ambiguous enum variant '")
    eprint_bytes(name, len)
    eprints_cstr(c"': declared by enum '")
    eprint_bytes(a, a_len)
    eprints_cstr(c"' and enum '")
    eprint_bytes(b, b_len)
    eprints_cstr(c"'; qualify it, e.g. '")
    eprint_bytes(a, a_len)
    eprints_cstr(c".")
    eprint_bytes(name, len)
    eprints_cstr(c"'\n")
    s.error_count = s.error_count + 1
    let zero: i32 = next_reg(s)
    emit_str(s, c"  ")
    emit_reg(s, zero)
    emit_str(s, c" = add i64 0, 0\n")
    return zero

fn eprint_bytes(p: *u8, len: i32)
    for i in 0..len
        eprint_char(*(p + i))

# Best-effort resolve the LLVM struct type-name produced by an expression.
# Writes the name pointer and length into the out-pointers, or null/0 if
# the producer's struct type isn't statically known.  Used to detect
# Span$u8 ↔ StrView layout-equivalence pairs at store/assign sites.
fn resolve_expr_struct_name(s: *EmitterState, e: *Expr, out_name: **u8, out_len: *i32)
    *out_name = null
    *out_len = 0
    if e == null
        return
    # Bare "..." literal lowers to %Span$u8 (AGAST #98).
    if e.kind == EXPR_STRING_LIT
        *out_name = c"Span$u8"
        *out_len = 7
        return
    # AGAST #2131: a struct-target cast (`"..." as StrView`) emits its
    # operand's register unchanged, so its LLVM type is the operand's.
    # Reporting that lets the store/arg/return coercions rebuild a
    # `%Span$u8` into the `%StrView` the slot expects.
    if e.kind == EXPR_CAST and e.op == TYPE_STRUCT
        resolve_expr_struct_name(s, e.left, out_name, out_len)
        return
    # Builtin StrView.as_bytes() -> %Span$u8.
    if e.kind == EXPR_METHOD
        if name_eq(e.ident_ptr, e.ident_len, c"as_bytes", 8) == 1
            *out_name = c"Span$u8"
            *out_len = 7
            return
        # AGAST #1466: a qualified variant ctor `Opt.Holds(x)` is the enum.
        qualified_variant_enum(s, e, out_name, out_len)
        if *out_name != null
            return
        # Impl-method call: walk receiver's struct type then impl table.
        var recv_tn: *u8 = null
        var recv_tn_len: i32 = 0
        let rcv: *Expr = e.left
        if rcv != null and rcv.kind == EXPR_IDENT
            let loc: *LocalVar = find_local_struct_name(s, rcv.ident_ptr, rcv.ident_len)
            if loc != null and loc.type_name_len > 0
                recv_tn = loc.type_name
                recv_tn_len = loc.type_name_len
        if recv_tn != null and recv_tn_len > 0
            var ib: *ImplBlock = s.module.impls
            while ib != null
                if name_eq(ib.type_name, ib.type_name_len, recv_tn, recv_tn_len) == 1
                    var m: *FnDef = ib.methods
                    while m != null
                        if name_eq(m.name, m.name_len, e.ident_ptr, e.ident_len) == 1
                            if m.return_type == TYPE_STRUCT and m.return_type_name_len > 0
                                *out_name = m.return_type_name
                                *out_len = m.return_type_name_len
                            return
                        m = m.next
                    return
                ib = ib.next
        return
    # Local binding to a known struct type.  Gate on `var_type == TYPE_STRUCT`
    # — pointer-typed locals (`s: *StrView`, `cstr: *u8`) carry the pointee
    # name in `type_name` (set by param_new for TYPE_PTR per ast_helpers.ritz)
    # but their loaded register holds an `i64`, not the struct aggregate.
    # Reporting the struct name in that case fools callers like
    # try_emit_span_to_i64_arg into emitting `extractvalue %StrView i64`.
    # (AGAST #176)
    if e.kind == EXPR_IDENT
        let loc: *LocalVar = find_local_struct_name(s, e.ident_ptr, e.ident_len)
        if loc != null and loc.type_name_len > 0 and loc.var_type == TYPE_STRUCT
            *out_name = loc.type_name
            *out_len = loc.type_name_len
            return
        # AGAST #189 — scalar struct consts (`const FOO: StrView = "..."`)
        # carry the struct type name in the ConstEntry; surface it so the
        # call-site coercion cascade (try_emit_span_to_i64_arg) can match
        # it like any other StrView/Span aggregate when the param is i64-
        # shaped (`@StrView`, `*u8`, etc.).
        let ce: *ConstEntry = find_const_entry(s, e.ident_ptr, e.ident_len)
        if ce != null and ce.const_type == TYPE_STRUCT and ce.type_name_len > 0
            *out_name = ce.type_name
            *out_len = ce.type_name_len
            return
        # AGAST #1600: a bare unit variant `B` is a value of its enum.
        var vi: i32 = 0
        var other: i32 = 0
        let ei: i32 = bare_unit_variant_enum(s, e, @vi, @other)
        if ei >= 0
            *out_name = enum_name_at(ei, out_len)
        return
    # Function-call return-type lookup.
    if e.kind == EXPR_CALL
        # AGAST #1797: a user-enum payload ctor `Holds(x)` is the enum.
        user_variant_ctor_enum(e, out_name, out_len)
        if *out_name != null
            return
        let fdr: *FnDef = find_call_fn(s, e)
        if fdr != null and fdr.return_type == TYPE_STRUCT and fdr.return_type_name_len > 0
            *out_name = fdr.return_type_name
            *out_len = fdr.return_type_name_len
        return
    # Struct literal carries its own type name.
    if e.kind == EXPR_STRUCT_LIT
        if e.ident_ptr != null and e.ident_len > 0
            *out_name = e.ident_ptr as *u8
            *out_len = e.ident_len
        return

# AGAST #1647: the struct a call or method call returns BY VALUE, so a field
# can be read off it: `mk(true).b`, `p.pair().a`, `Q.make(1).x`.  Writes the
# struct name, or null/0 when the callee or its struct return isn't known.
#
# A method's receiver must be a name: a local (its type, or its pointee for
# `*T`, names the impl) or, when no local or global has the name, a type
# (`Q.make`, a static method), as emit_expr_method resolves it.  A global
# or chained receiver (`a.b().c().x`) is not resolved; emit_expr_method
# can't dispatch either (#2044).
fn call_result_struct_name(s: *EmitterState, e: *Expr, out_name: **u8, out_len: *i32)
    *out_name = null
    *out_len = 0
    if e == null
        return
    var fd: *FnDef = null
    if e.kind == EXPR_CALL
        fd = find_call_fn(s, e)
    else if e.kind == EXPR_METHOD and e.left != null and e.left.kind == EXPR_IDENT
        var recv: *u8 = null
        var recv_len: i32 = 0
        let loc: *LocalVar = find_local_struct_name(s, e.left.ident_ptr, e.left.ident_len)
        if loc != null
            recv = loc.type_name
            recv_len = loc.type_name_len
        else
            let rglob: *GlobalVarDef = find_global(s, e.left.ident_ptr, e.left.ident_len)
            if rglob == null
                recv = e.left.ident_ptr as *u8
                recv_len = e.left.ident_len
            # AGAST #2044: a global receiver (`g_p.pair().a`) -- a struct
            # global's type, or a `*S` global's pointee, as emit_expr_method
            # resolves it.
            else if rglob.var_type == TYPE_STRUCT
                recv = rglob.type_name
                recv_len = rglob.type_name_len
            else if rglob.var_type == TYPE_PTR and rglob.pointee_type == TYPE_STRUCT
                recv = rglob.pointee_type_name
                recv_len = rglob.pointee_type_name_len
        if recv != null and recv_len > 0
            var ib: *ImplBlock = s.module.impls
            while ib != null and fd == null
                if name_eq(ib.type_name, ib.type_name_len, recv, recv_len) == 1
                    var m: *FnDef = ib.methods
                    while m != null and fd == null
                        if name_eq(m.name, m.name_len, e.ident_ptr, e.ident_len) == 1
                            fd = m
                        m = m.next
                ib = ib.next
    if fd == null or fd.return_type != TYPE_STRUCT or fd.return_type_name_len <= 0
        return
    *out_name = fd.return_type_name
    *out_len = fd.return_type_name_len

# AGAST #175: type-only resolution of an EXPR_MEMBER chain rooted at an
# identifier (local or global).  Returns the *StructField for the innermost
# field (e.g. for `a.b.c` returns the field for `c`), or null if any link in
# the chain can't be resolved.  Mirrors emit_member_ptr's traversal but
# emits no IR — used by var-decl narrowing to infer pointee types for
# `let x = @a.b.c[i]` so the binding registers as a *Struct with the right
# type_name.  Without this, chained-member addr-of falls through to
# "; ERROR: unhandled EXPR_MEMBER".
fn resolve_member_chain_field(s: *EmitterState, e: *Expr) -> *StructField
    if e == null
        return null
    if e.kind != EXPR_MEMBER
        return null
    var sname: *u8 = null
    var sname_len: i32 = 0
    if e.left.kind == EXPR_IDENT
        let mloc: *LocalVar = find_local_struct_name(s, e.left.ident_ptr, e.left.ident_len)
        if mloc != null and mloc.type_name_len > 0
            if mloc.var_type == TYPE_PTR or mloc.var_type == TYPE_PTR_PTR or mloc.var_type == TYPE_STRUCT or mloc.var_type == TYPE_REF or mloc.var_type == TYPE_MUT_REF
                sname = mloc.type_name
                sname_len = mloc.type_name_len
        if sname == null
            let mglob: *GlobalVarDef = find_global(s, e.left.ident_ptr, e.left.ident_len)
            if mglob != null and mglob.var_type == TYPE_STRUCT and mglob.type_name_len > 0
                sname = mglob.type_name
                sname_len = mglob.type_name_len
    else if e.left.kind == EXPR_MEMBER
        # Recurse: resolve parent's field, then dereference into the field's struct
        let parent_field: *StructField = resolve_member_chain_field(s, e.left)
        if parent_field != null
            if parent_field.field_type == TYPE_STRUCT and parent_field.field_type_name_len > 0
                sname = parent_field.field_type_name
                sname_len = parent_field.field_type_name_len
            else if (parent_field.field_type == TYPE_PTR or parent_field.field_type == TYPE_PTR_PTR) and parent_field.field_type_name_len > 0
                sname = parent_field.field_type_name
                sname_len = parent_field.field_type_name_len
    # AGAST #1647: `mk().f` / `p.m().f` — the callee's struct return type.
    else if e.left.kind == EXPR_CALL or e.left.kind == EXPR_METHOD
        call_result_struct_name(s, e.left, @sname, @sname_len)
    # AGAST #2152: `arr[i].f` / `p[i].f` / `o.items[i].f` / `g[i][j].f`.
    else if e.left.kind == EXPR_INDEX
        index_elem_struct_name(s, e.left, @sname, @sname_len)
    # AGAST #2152: `(*p).f` / `(*w.p).f`.
    else if e.left.kind == EXPR_UNARY and e.left.op == OP_DEREF
        deref_member_base_struct_name(s, e.left.operand, @sname, @sname_len)
    if sname == null or sname_len == 0
        return null
    let st: *StructDef = find_struct(s, sname, sname_len)
    if st == null
        return null
    let fidx: i32 = find_field_index(st, e.ident_ptr, e.ident_len)
    if fidx < 0
        return null
    return get_field_type(st, fidx)

# AGAST #2152: the struct an index expression `ie` yields an element of, for
# a `.field` on it, or null/0.  Type-only; mirrors emit_member_ptr's
# EXPR_INDEX arms (an N-D chain with a struct leaf, a struct-array or
# `**S` field, a struct / pointer-to-struct array local, a `*S` local, a
# struct-array global).  Shapes emit_member_ptr does not lower stay null.
fn index_elem_struct_name(s: *EmitterState, ie: *Expr, out_name: **u8, out_len: *i32)
    *out_name = null
    *out_len = 0
    if ie == null or ie.kind != EXPR_INDEX or ie.left == null
        return
    # AGAST #2332: an element of `[N]*S`, whatever holds the array.
    if array_elem_pointee(s, ie, out_name, out_len) == TYPE_STRUCT
        return
    if array_elem_pointee(s, ie.left, out_name, out_len) == TYPE_STRUCT
        return   # `a[i][j]`
    var nd_depth: i32 = 0
    let nd_sh: *ArrayShape = nd_index_shape(s, ie, @nd_depth)
    if nd_sh != null
        if nd_depth == nd_sh.rank and nd_sh.leaf_type == TYPE_STRUCT
            *out_name = nd_sh.leaf_name
            *out_len = nd_sh.leaf_name_len
        return
    let b: *Expr = ie.left
    if b.kind == EXPR_MEMBER
        let f: *StructField = resolve_member_chain_field(s, b)
        if f == null
            return
        if f.field_type == TYPE_ARRAY and f.array_elem_type_name_len > 0
            *out_name = f.array_elem_type_name
            *out_len = f.array_elem_type_name_len
        else if f.field_type == TYPE_PTR_PTR and f.field_type_name_len > 0
            *out_name = f.field_type_name
            *out_len = f.field_type_name_len
        return
    if b.kind != EXPR_IDENT
        return
    let lv: *LocalVar = find_local_struct_name(s, b.ident_ptr, b.ident_len)
    if lv != null
        if lv.type_name_len <= 0
            return
        let ae: i32 = lv.array_elem_type
        if lv.var_type == TYPE_ARRAY and (ae == TYPE_STRUCT or ae == TYPE_PTR or ae == TYPE_PTR_PTR)
            *out_name = lv.type_name
            *out_len = lv.type_name_len
        else if lv.var_type == TYPE_PTR
            *out_name = lv.type_name
            *out_len = lv.type_name_len
        return
    let g: *GlobalVarDef = find_global(s, b.ident_ptr, b.ident_len)
    if g != null and g.var_type == TYPE_ARRAY and g.array_elem_type == TYPE_STRUCT and g.array_elem_type_name_len > 0
        *out_name = g.array_elem_type_name
        *out_len = g.array_elem_type_name_len

# AGAST #2152: the struct `(*op).field` reads a field of: the pointee of a
# `*S` local or global, or of a `*S` field (`(*w.p).f`), or null/0.
fn deref_member_base_struct_name(s: *EmitterState, op: *Expr, out_name: **u8, out_len: *i32)
    *out_name = null
    *out_len = 0
    if op == null
        return
    if op.kind == EXPR_IDENT
        let lv: *LocalVar = find_local_struct_name(s, op.ident_ptr, op.ident_len)
        if lv != null
            if lv.var_type == TYPE_PTR and lv.type_name_len > 0
                *out_name = lv.type_name
                *out_len = lv.type_name_len
            return
        let g: *GlobalVarDef = find_global(s, op.ident_ptr, op.ident_len)
        if g != null and g.var_type == TYPE_PTR and g.pointee_type == TYPE_STRUCT and g.pointee_type_name_len > 0
            *out_name = g.pointee_type_name
            *out_len = g.pointee_type_name_len
        return
    if op.kind == EXPR_MEMBER
        let f: *StructField = resolve_member_chain_field(s, op)
        if f != null and f.field_type == TYPE_PTR and f.field_type_name_len > 0
            *out_name = f.field_type_name
            *out_len = f.field_type_name_len



# AGAST #1509 / #2097: type-only N-D array shape resolution (moved here from
# emitter_expr_arith by #2152, since resolve_member_chain_field now needs it
# for an indexed base `g[i][j].m` and nd_array_member_shape needs that).

# The shape of the N-D array an index chain `e` indexes, with the number of
# indices in *out_depth, or null when `e` is not such a chain (base is not a
# local / global N-D array, or the chain is deeper than its rank).  Emits
# nothing, so callers can test before committing to the N-D path.
fn nd_index_shape(s: *EmitterState, e: *Expr, out_depth: *i32) -> *ArrayShape
    if e == null or e.kind != EXPR_INDEX
        return null
    var depth: i32 = 0
    var base: *Expr = e
    while base.kind == EXPR_INDEX
        depth = depth + 1
        base = base.left
    let sh: *ArrayShape = nd_array_base_shape(s, base)
    if sh == null or depth > sh.rank
        return null
    *out_depth = depth
    return sh

# The ArrayShape of the local / global N-D array named `name`, or null.
fn nd_array_name_shape(s: *EmitterState, name: *u8, len: i32) -> *ArrayShape
    if name == null or len <= 0
        return null
    let lv: *LocalVar = find_local_struct_name(s, name, len)
    if lv != null
        if lv.var_type == TYPE_ARRAY
            return lv.array_shape
        return null
    let glob: *GlobalVarDef = find_global(s, name, len)
    if glob != null and glob.var_type == TYPE_ARRAY
        return glob.array_shape
    return null

# The same for an EXPR_IDENT `e` (null for any other expression).
fn nd_array_ident_shape(s: *EmitterState, e: *Expr) -> *ArrayShape
    if e == null or e.kind != EXPR_IDENT
        return null
    return nd_array_name_shape(s, e.ident_ptr, e.ident_len)

# AGAST #2097: the ArrayShape of an N-D struct field named by the member
# chain `e` (`s.m`, `p.m`, `a.b.m`, local or global), or null.  Type-only:
# emits nothing (resolve_member_chain_field mirrors emit_member_ptr).
fn nd_array_member_shape(s: *EmitterState, e: *Expr) -> *ArrayShape
    if e == null or e.kind != EXPR_MEMBER
        return null
    let f: *StructField = resolve_member_chain_field(s, e)
    if f == null or f.field_type != TYPE_ARRAY
        return null
    return f.array_shape

# The N-D array an index chain's base names: a local / global, or a field.
fn nd_array_base_shape(s: *EmitterState, base: *Expr) -> *ArrayShape
    if base == null
        return null
    if base.kind == EXPR_MEMBER
        return nd_array_member_shape(s, base)
    return nd_array_ident_shape(s, base)

# AGAST #1660 — the unit (fieldless) enum an expression's value is, if any.
#
# ritz1 holds a unit-enum value as its `%Enum = type { i8 }` aggregate, never
# as an i64: the qualified-variant ctor (`Kind.A`), an enum-typed param or
# `let` local, an enum-returning call and an enum-typed field load all hand
# back a `%Kind` register.  Callers that would otherwise treat the register as
# i64 (var-decl slot inference, `==` / `!=`) ask this first.  Writes the enum
# name, or null/0 when `e` is not statically a unit enum.  Result$/Option$
# tagged enums are excluded: their aggregate is `{ i8, [N x i8] }`.
fn unit_enum_expr_name(s: *EmitterState, e: *Expr, out_name: **u8, out_len: *i32)
    *out_name = null
    *out_len = 0
    if e == null
        return
    var name: *u8 = null
    var name_len: i32 = 0
    if e.kind == EXPR_MEMBER
        # Qualified variant `Kind.A` (same test as emit_expr_member).
        if e.left != null and e.left.kind == EXPR_IDENT
            if is_enum_type(e.left.ident_ptr, e.left.ident_len) == 1
                if enum_variant_index(e.left.ident_ptr, e.left.ident_len, e.ident_ptr, e.ident_len) >= 0
                    name = e.left.ident_ptr as *u8
                    name_len = e.left.ident_len
        # Enum-typed struct field, at any depth / through any pointer.
        if name == null
            let fld: *StructField = resolve_member_chain_field(s, e)
            if fld != null and fld.field_type == TYPE_STRUCT and fld.field_type_name_len > 0
                name = fld.field_type_name
                name_len = fld.field_type_name_len
    else
        resolve_expr_struct_name(s, e, @name, @name_len)
    if name == null or name_len == 0
        return
    if is_tagged_enum_type(name, name_len) == 1
        return
    if is_enum_type(name, name_len) == 0
        return
    *out_name = name
    *out_len = name_len

# AGAST #176 — Span$u8 / StrView -> i64 coercion at call-site arg passing.
#
# rzrz (and any caller) passes bare `"..."` literals (which lower to %Span$u8
# per #98) to legacy `*u8` / `i64` params (e.g. `eprints_cstr`).  Without a
# coercion the %Span$u8 aggregate flows straight into the call as
# `call ... (i64 %.span)` and the IR verifier rejects the type mismatch.
#
# Mirrors #168's store-site decompose-and-rebuild but emits a single
# `extractvalue` + `ptrtoint` (we only need the ptr field; len is dropped).
#
# Returns a freshly-allocated i64 register holding the coerced value, or -1
# when no coercion was applied (param isn't pointer/i64-shaped, or the arg
# isn't statically resolvable as Span$u8/StrView — caller falls through to
# its existing branch).  Both Span$u8 and StrView are `{ ptr, i64 }` so the
# extract pattern is identical.
fn try_emit_span_to_i64_arg(s: *EmitterState, arg_e: *Expr, param_type: i32, src_reg: i32) -> i32
    # Param must lower to `i64` in the call signature.  TYPE_PTR / TYPE_PTR_PTR
    # / TYPE_REF emit i64 (see emit_llvm_type); TYPE_I64 / TYPE_U64 are i64
    # directly.  TYPE_MUT_REF emits `ptr` so it has its own inttoptr branch
    # in the cascade — skip here to avoid double-handling.
    if param_type != TYPE_PTR and param_type != TYPE_PTR_PTR and param_type != TYPE_REF and param_type != TYPE_I64 and param_type != TYPE_U64
        return -1
    if arg_e == null
        return -1
    var src_name: *u8 = null
    var src_name_len: i32 = 0
    resolve_expr_struct_name(s, arg_e, @src_name, @src_name_len)
    if src_name == null
        return -1
    if src_name_len == 0
        return -1
    let is_span_u8: i32 = name_eq(src_name, src_name_len, c"Span$u8", 7)
    let is_strview: i32 = name_eq(src_name, src_name_len, c"StrView", 7)
    if is_span_u8 == 0 and is_strview == 0
        return -1
    let p: i32 = next_reg(s)
    emit_str(s, c"  ")
    emit_reg(s, p)
    emit_str(s, c" = extractvalue %")
    emit_name(s, src_name, src_name_len)
    emit_str(s, c" ")
    emit_reg(s, src_reg)
    emit_str(s, c", 0\n")
    let pi: i32 = next_reg(s)
    emit_str(s, c"  ")
    emit_reg(s, pi)
    emit_str(s, c" = ptrtoint ptr ")
    emit_reg(s, p)
    emit_str(s, c" to i64\n")
    pi

# =============================================================================
# Native-pointer load/store helpers (task #73 migration)
#
# These replace the old pattern:
#     %v = load i64, ptr %slot
#     %p = inttoptr i64 %v to ptr
# with:
#     %p = load ptr, ptr %slot
#
# Per-site migration keeps the cascade contained — each call site can be
# converted independently, with ritz0 tests + "ritz1 compiles trivial" as gate.
# LLVM opaque pointers mean the alloca type doesn't need to change — we can
# load either i64 or ptr from the same `alloca i64` slot.
# =============================================================================

# Emit `%result = load ptr, ptr %slot_reg` and return the new register index.
fn emit_load_ptr(s: *EmitterState, slot_reg: i32) -> i32
    let result: i32 = next_reg(s)
    emit_str(s, c"  ")
    emit_reg(s, result)
    emit_str(s, c" = load ptr, ptr ")
    emit_reg(s, slot_reg)
    emit_str(s, c"\n")
    result

# Emit `store ptr %val_reg, ptr %slot_reg`.
fn emit_store_ptr(s: *EmitterState, val_reg: i32, slot_reg: i32)
    emit_str(s, c"  store ptr ")
    emit_reg(s, val_reg)
    emit_str(s, c", ptr ")
    emit_reg(s, slot_reg)
    emit_str(s, c"\n")

fn add_string(s: *EmitterState, data: *u8, len: i32) -> i32
    let idx: i32 = namelist_count(@s.strings)
    namelist_push(@s.strings, data, len)
    idx

# =============================================================================
# Type Inference - Determine expression type without emitting code
# =============================================================================

# Helper: find the leftmost/base expression in a chain of binary ops
# e.g., for (a.ptr + pos + i), returns a.ptr
fn find_base_expr(e: *Expr) -> *Expr
    if e.kind == EXPR_BINARY
        return find_base_expr(e.left)
    return e

# Compute size in bytes of a named struct with proper C-style alignment.
# Each field is aligned to its natural alignment; final size rounded up to struct alignment.
fn get_struct_size_by_name(s: *EmitterState, name: *u8, name_len: i32) -> i64
    if name == null or name_len == 0
        return 8
    if is_tagged_enum_type(name, name_len) == 1
        var te_pad: i64 = 0
        let te_n: i64 = tagged_enum_layout(s, name, name_len, @te_pad)
        return 1 + te_pad + te_n   # AGAST #1898: ritz0's layout
    let st: *StructDef = find_struct(s, name, name_len)
    if st == null
        # AGAST #1797: a user enum, `{ i8 }` or `{ i8, [P x i8], [N x i8] }`.
        let uei: i32 = user_enum_index(name, name_len)
        if uei >= 0
            return user_enum_size(s, uei)
        return 8
    # `[[packed]]` (AGAST #1847): fields back to back, no tail padding —
    # the layout of the `<{ ... }>` type emit_one_struct_type writes.
    let packed: i32 = struct_is_packed(st)
    var offset: i64 = 0
    var max_align: i64 = 1
    var f: *StructField = st.fields
    while f != null
        var falign: i64 = 8
        var fsize: i64 = 8
        if f.field_type == TYPE_ARRAY
            # Array: size = elem_size * count, align = elem_align
            fsize = field_array_size_align(s, f, @falign)
        else
            fsize = elem_size_align(s, f.field_type, f.field_type_name, f.field_type_name_len, @falign)

        if packed == 1
            falign = 1
        # Align offset up to falign
        let rem: i64 = offset % falign
        if rem != 0
            offset = offset + (falign - rem)
        offset = offset + fsize
        if falign > max_align
            max_align = falign
        f = f.next

    # Round final size up to struct alignment
    if max_align > 1
        let rem2: i64 = offset % max_align
        if rem2 != 0
            offset = offset + (max_align - rem2)
    return offset

# Alignment of a named struct: its most-aligned field (LLVM DataLayout
# natural alignment). 8 for a name that does not resolve, matching
# get_struct_size_by_name's fallback.
fn get_struct_align_by_name(s: *EmitterState, name: *u8, name_len: i32) -> i64
    if name == null or name_len == 0
        return 8
    if is_tagged_enum_type(name, name_len) == 1
        return 1   # AGAST #1898: { i8, [P x i8], [N x i8] } is 1-aligned
    let st: *StructDef = find_struct(s, name, name_len)
    if st == null
        if user_enum_index(name, name_len) >= 0
            return 1   # AGAST #1797: an all-i8 struct
        return 8
    if struct_is_packed(st) == 1
        return 1   # `[[packed]]`: an LLVM packed struct is 1-aligned (#1847)
    var max_align: i64 = 1
    var f: *StructField = st.fields
    while f != null
        var falign: i64 = 8
        if f.field_type == TYPE_ARRAY
            elem_size_align(s, f.array_elem_type, f.array_elem_type_name, f.array_elem_type_name_len, @falign)
        else
            elem_size_align(s, f.field_type, f.field_type_name, f.field_type_name_len, @falign)
        if falign > max_align
            max_align = falign
        f = f.next
    return max_align

# Byte size of the primitive type spelled `name` (`sizeof(u16)` = 2), or 0
# when `name` is not a primitive (a struct name, to be measured instead).
fn prim_name_size(name: *u8, len: i32) -> i64
    if name_eq(name, len, c"u8", 2) == 1 or name_eq(name, len, c"i8", 2) == 1 or name_eq(name, len, c"bool", 4) == 1
        return 1
    if name_eq(name, len, c"u16", 3) == 1 or name_eq(name, len, c"i16", 3) == 1
        return 2
    if name_eq(name, len, c"u32", 3) == 1 or name_eq(name, len, c"i32", 3) == 1 or name_eq(name, len, c"f32", 3) == 1
        return 4
    if name_eq(name, len, c"u64", 3) == 1 or name_eq(name, len, c"i64", 3) == 1 or name_eq(name, len, c"f64", 3) == 1
        return 8
    if name_eq(name, len, c"usize", 5) == 1 or name_eq(name, len, c"isize", 5) == 1
        return 8
    return 0

# Natural size of one value of kind `t` (a TYPE_* primitive, or TYPE_STRUCT
# named `name`), with its alignment written to `*align`. AGAST #1814: bool
# and f32 were sized 8 and nested structs aligned to 8, so sizeof disagreed
# with the `%T = type` body LLVM lays out. Kinds with no recorded size
# (enums, refs, unresolved names) keep the historical 8/8.
# Size (and, in *align, alignment) of a TYPE_ARRAY field `f`.  AGAST #2097:
# an N-D field `m: [N][M]T` is N*M*sizeof(T), aligned as T, matching the
# `[N x [M x T]]` emit_field_llvm_type declares; the 1-D formula would size
# the TYPE_ARRAY element as one i64.
fn field_array_size_align(s: *EmitterState, f: *StructField, align: *i64) -> i64
    let sh: *ArrayShape = f.array_shape
    if sh == null
        let es: i64 = elem_size_align(s, f.array_elem_type, f.array_elem_type_name, f.array_elem_type_name_len, align)
        return es * (f.array_size as i64)
    var n: i64 = 1
    var d: i32 = 0
    while d < sh.rank
        n = n * (sh.dims[d] as i64)
        d = d + 1
    return n * elem_size_align(s, sh.leaf_type, sh.leaf_name, sh.leaf_name_len, align)

fn elem_size_align(s: *EmitterState, t: i32, name: *u8, name_len: i32, align: *i64) -> i64
    if t == TYPE_STRUCT and name_len > 0
        *align = get_struct_align_by_name(s, name, name_len)
        return get_struct_size_by_name(s, name, name_len)
    let sz: i64 = ptr_pointee_size(s, t, null, 0)
    if sz == 0
        *align = 8
        return 8
    *align = sz
    return sz

# Byte size of one element of a pointer whose pointee is `pointee`
# (a TYPE_* kind; for TYPE_STRUCT, `name`/`name_len` name the struct).
# Returns 0 when the pointee is not known — never guesses.  0 is not a valid
# element size, so callers can tell "unknown" apart from every real answer.
fn ptr_pointee_size(s: *EmitterState, pointee: i32, name: *u8, name_len: i32) -> i64
    if pointee == TYPE_STRUCT
        # get_struct_size_by_name answers 8 for a name it cannot resolve;
        # that is exactly the guess this function exists to refuse.
        if name_len > 0 and find_struct(s, name, name_len) != null
            return get_struct_size_by_name(s, name, name_len)
        return 0
    if pointee == TYPE_U8 or pointee == TYPE_I8 or pointee == TYPE_BOOL
        return 1
    if pointee == TYPE_U16 or pointee == TYPE_I16
        return 2
    if pointee == TYPE_U32 or pointee == TYPE_I32 or pointee == TYPE_F32
        return 4
    if pointee == TYPE_U64 or pointee == TYPE_I64 or pointee == TYPE_F64
        return 8
    if pointee == TYPE_PTR or pointee == TYPE_PTR_PTR
        return 8
    return 0

# "pointer arithmetic on '<name>': element size unknown" — a counted error,
# so main refuses to write the output.  Returns 1 only so the caller can
# finish emitting a syntactically complete instruction; the result is never
# linked because the error count is non-zero.
fn ptr_elem_size_unknown(s: *EmitterState, name: *u8, name_len: i32) -> i64
    emit_ir_error_begin(s, c"pointer arithmetic: element size of pointee unknown for '")
    emit_ir_error_end(s, name, name_len)
    return 1

# The StructField a member expression `recv.field` names, following nested
# receivers (`a.b.c.field`, any depth) and struct-pointer receivers.  null if
# unresolved.  AGAST #1673: the single resolver for member-chain field types;
# the pointee-width, stride and struct-deref paths each used to hardcode one or
# two levels and silently guess (load i64 / raw byte add) past that.
fn member_field_def(s: *EmitterState, e: *Expr) -> *StructField
    if e == null or e.kind != EXPR_MEMBER or e.left == null
        return null
    var recv: *u8 = null
    var recv_len: i32 = 0
    if e.left.kind == EXPR_IDENT
        let lv: *LocalVar = find_local_struct_name(s, e.left.ident_ptr, e.left.ident_len)
        if lv != null
            recv = lv.type_name
            recv_len = lv.type_name_len
        else
            let glob: *GlobalVarDef = find_global(s, e.left.ident_ptr, e.left.ident_len)
            if glob != null
                recv = glob.type_name
                recv_len = glob.type_name_len
    else if e.left.kind == EXPR_MEMBER
        let pf: *StructField = member_field_def(s, e.left)
        var pk: i32 = 0
        if pf != null
            pk = pf.field_type
        if pk == TYPE_STRUCT or pk == TYPE_PTR or pk == TYPE_REF or pk == TYPE_MUT_REF
            recv = pf.field_type_name
            recv_len = pf.field_type_name_len
    # AGAST #1647: `mk().f` / `p.m().f` — the callee's struct return type.
    else if e.left.kind == EXPR_CALL or e.left.kind == EXPR_METHOD
        call_result_struct_name(s, e.left, @recv, @recv_len)
    # AGAST #2332: `a[i].f` with `a: [N]*S`, so `f` has its own type.
    else if e.left.kind == EXPR_INDEX
        array_elem_pointee(s, e.left, @recv, @recv_len)
        if recv == null
            array_elem_pointee(s, e.left.left, @recv, @recv_len)   # `a[i][j].f`
    if recv == null or recv_len <= 0
        return null
    let st: *StructDef = find_struct(s, recv, recv_len)
    if st == null
        return null
    let idx: i32 = find_field_index(st, e.ident_ptr, e.ident_len)
    if idx < 0
        return null
    get_field_type(st, idx)

# Compute size of pointed-to element for pointer arithmetic on a pointer expression.
# Handles identifiers (looks up LocalVar.pointee_type + type_name) and member accesses
# (looks up struct field's pointee info).
#
# AGAST #1451: fails CLOSED.  This used to answer 1 (or 8, via
# get_struct_size_by_name's miss value) for anything it could not resolve,
# and every such guess was a silent wrong address: `let base: *LB` locals
# were registered with pointee TYPE_I64 and scaled by 8 instead of 16.  An
# unknown pointee is now a located emitter error naming the operand.
fn get_ptr_elem_size(s: *EmitterState, e: *Expr) -> i64
    if e.kind == EXPR_IDENT
        let loc: *LocalVar = find_local_struct_name(s, e.ident_ptr, e.ident_len)
        if loc == null
            return ptr_elem_size_unknown(s, e.ident_ptr, e.ident_len)
        # For TYPE_PTR_PTR the element is a pointer (8 bytes)
        if loc.var_type == TYPE_PTR_PTR
            return 8
        if loc.var_type == TYPE_PTR or loc.var_type == TYPE_REF or loc.var_type == TYPE_MUT_REF
            let size: i64 = ptr_pointee_size(s, loc.pointee_type, loc.type_name, loc.type_name_len)
            if size > 0
                return size
        return ptr_elem_size_unknown(s, e.ident_ptr, e.ident_len)
    if e.kind == EXPR_MEMBER
        # AGAST #1673: any member chain (`o.inner.buf.p`), not just `local.f`.
        let field: *StructField = member_field_def(s, e)
        if field != null
            if field.field_type == TYPE_PTR_PTR
                return 8
            if field.field_type == TYPE_PTR or field.field_type == TYPE_REF or field.field_type == TYPE_MUT_REF
                # A struct pointee is named by field_type_name; a
                # primitive one is recorded in array_elem_type
                # (ast_helpers field_new, AGAST #1304).
                var fsize: i64 = 0
                if field.field_type_name_len > 0
                    fsize = ptr_pointee_size(s, TYPE_STRUCT, field.field_type_name, field.field_type_name_len)
                else
                    fsize = ptr_pointee_size(s, field.array_elem_type, null, 0)
                if fsize > 0
                    return fsize
        return ptr_elem_size_unknown(s, e.ident_ptr, e.ident_len)
    emit_ir_error(s, c"pointer arithmetic: element size of pointee unknown for a non-name operand")
    return 1

# AGAST #2332: U when `x` is an element of a `[N]*U` array (local, param, global,
# or field at any depth, N-D too) or that element `+ k`, with a struct U's name in
# *out_name / *out_len.  TYPE_VOID for anything else, so an integer `a[i] + 1`
# stays an integer.  `[N]**U` records no U, and `*[N]*U` is refused (#2347).
fn array_elem_pointee(s: *EmitterState, x: *Expr, out_name: **u8, out_len: *i32) -> i32
    *out_name = null
    *out_len = 0
    var b: *Expr = x
    while b != null and b.kind == EXPR_BINARY and (b.op == OP_ADD or b.op == OP_SUB)
        if is_array_elem_distance(s, b) == 1
            return TYPE_VOID
        b = b.left
    if b == null or b.kind != EXPR_INDEX or b.left == null
        return TYPE_VOID
    if b.right != null and b.right.kind == EXPR_RANGE
        return TYPE_VOID
    var elem: i32 = TYPE_VOID
    var pointee: i32 = TYPE_VOID
    var name: *u8 = null
    var name_len: i32 = 0
    var depth: i32 = 0
    let sh: *ArrayShape = nd_index_shape(s, b, @depth)
    if sh != null
        if depth == sh.rank
            elem = sh.leaf_type
            pointee = sh.leaf_pointee
            name = sh.leaf_name
            name_len = sh.leaf_name_len
    else if b.left.kind == EXPR_MEMBER
        let f: *StructField = resolve_member_chain_field(s, b.left)
        if f != null and f.field_type == TYPE_ARRAY
            elem = f.array_elem_type
            pointee = f.array_elem_pointee
            name = f.array_elem_type_name
            name_len = f.array_elem_type_name_len
    else if b.left.kind == EXPR_IDENT
        let loc: *LocalVar = find_local_struct_name(s, b.left.ident_ptr, b.left.ident_len)
        if loc != null
            if loc.var_type == TYPE_ARRAY
                elem = loc.array_elem_type
                pointee = loc.array_elem_pointee
                name = loc.type_name
                name_len = loc.type_name_len
        else
            let g: *GlobalVarDef = find_global(s, b.left.ident_ptr, b.left.ident_len)
            if g != null and g.var_type == TYPE_ARRAY
                elem = g.array_elem_type
                pointee = g.array_elem_pointee
                name = g.array_elem_type_name
                name_len = g.array_elem_type_name_len
    elem_recorded_pointee(s, elem, pointee, name, name_len, out_name, out_len)

# What an array's record says its element points at: U for an `elem` of TYPE_PTR
# recording `pointee` U, TYPE_VOID otherwise.  A struct U's name goes to *out_name.
fn elem_recorded_pointee(s: *EmitterState, elem: i32, pointee: i32, name: *u8, name_len: i32, out_name: **u8, out_len: *i32) -> i32
    *out_name = null
    *out_len = 0
    if elem != TYPE_PTR
        return TYPE_VOID
    if pointee == TYPE_STRUCT
        if name_len <= 0
            return TYPE_VOID
        *out_name = name
        *out_len = name_len
        return TYPE_STRUCT
    if primitive_name_len(pointee) > 0
        return pointee
    TYPE_VOID

# array_elem_pointee, when the caller doesn't need a struct's name.
fn array_elem_pointee_kind(s: *EmitterState, x: *Expr) -> i32
    var name: *u8 = null
    var name_len: i32 = 0
    array_elem_pointee(s, x, @name, @name_len)

# AGAST #2332: 1 when `e` is `a[i] - q` with `a: [N]*T` and `q` a pointer.  That's
# a distance, in bytes as it always was: an integer with no stride.
fn is_array_elem_distance(s: *EmitterState, e: *Expr) -> i32
    if e.kind != EXPR_BINARY or e.op != OP_SUB or array_elem_pointee_kind(s, e.left) == TYPE_VOID
        return 0
    (array_elem_pointee_kind(s, e.right) != TYPE_VOID or get_expr_type(s, e.right) == TYPE_PTR) as i32

# AGAST #2332: 1 when `e` is `a[i][j]` over an `a: [N]*T` element.  That's a
# pointer index, not an array's, and elem_index_as_deref lowers it.
fn is_array_elem_index(s: *EmitterState, e: *Expr) -> i32
    if e == null or e.kind != EXPR_INDEX or e.left == null or e.left.kind != EXPR_INDEX
        return 0
    (array_elem_pointee_kind(s, e.left) != TYPE_VOID) as i32

# Fill `sum` and `deref` with `*(a[i] + j)` for `e` = `a[i][j]`, so the load and
# the store take the `*` paths: one width and one stride, struct T included.
fn elem_index_as_deref(e: *Expr, sum: *Expr, deref: *Expr)
    sum.kind = EXPR_BINARY
    sum.span = e.span
    sum.op = OP_ADD
    sum.left = e.left
    sum.right = e.right
    sum.next = null
    deref.kind = EXPR_UNARY
    deref.span = e.span
    deref.op = OP_DEREF
    deref.operand = sum
    deref.next = null

# AGAST #1924: the static pointer type of `x`, as a level count plus the
# innermost pointee.  Returns the levels (1 = `*T`, 2 = `**T`, 3 = `***T`)
# and writes T to *out_inner and, for a struct T, its name to *out_name /
# *out_len.  0 when unknown.
#
# Only shapes rooted in a recorded `**T` (or deeper) answer: an identifier
# (local, param, global) or a struct field at any member-chain depth, then
# `y + k` / `y - k` (same type as y) and `*y` (one level fewer).  So
# `*(*(h.rows + i) + k)`, `*(*(*(ppp + i) + j) + k)` and `*(g + i) + k`
# all resolve.  A plain `*T` base answers 0: the callers already handle it.
#
# #1815 / #1941 resolved identifier bases only, exactly two levels deep, so
# a `**T` field, a `***T`, a global `**S` and a monomorphised `**T` param
# still loaded i64 and stepped one byte.
fn ptr_levels_of(s: *EmitterState, x: *Expr, out_inner: *i32, out_name: **u8, out_len: *i32) -> i32
    *out_inner = TYPE_VOID
    *out_name = null
    *out_len = 0
    if x == null
        return 0
    if x.kind == EXPR_BINARY
        if x.op == OP_ADD or x.op == OP_SUB
            return ptr_levels_of(s, x.left, out_inner, out_name, out_len)
        return 0
    if x.kind == EXPR_UNARY
        if x.op != OP_DEREF or x.operand == null
            return 0
        let sub: i32 = ptr_levels_of(s, x.operand, out_inner, out_name, out_len)
        if sub < 2
            *out_inner = TYPE_VOID
            *out_name = null
            *out_len = 0
            return 0
        return sub - 1
    var slot: i32 = TYPE_VOID
    var name: *u8 = null
    var name_len: i32 = 0
    if x.kind == EXPR_IDENT
        let loc: *LocalVar = find_local_struct_name(s, x.ident_ptr, x.ident_len)
        if loc != null
            if loc.var_type != TYPE_PTR_PTR
                return 0
            slot = loc.inner_pointee_type
            name = loc.type_name
            name_len = loc.type_name_len
        else
            let glob: *GlobalVarDef = find_global(s, x.ident_ptr, x.ident_len)
            if glob == null or glob.var_type != TYPE_PTR_PTR
                return 0
            slot = glob.inner_pointee_type
            name = glob.pointee_type_name
            name_len = glob.pointee_type_name_len
    else if x.kind == EXPR_MEMBER
        let fld: *StructField = member_field_def(s, x)
        if fld == null or fld.field_type != TYPE_PTR_PTR
            return 0
        slot = fld.inner_pointee_type
        name = fld.field_type_name
        name_len = fld.field_type_name_len
    else
        return 0
    let levels: i32 = ptr_ptr_slot_levels(slot)
    if levels < 2
        return 0
    let inner: i32 = ptr_ptr_slot_inner(slot)
    *out_inner = inner
    # A primitive `**u8` param still carries a stale parser type name.
    if inner == TYPE_STRUCT
        *out_name = name
        *out_len = name_len
    return levels

# AGAST #1815: the element a `*(pp + i)` (or `*pp`) points at, when that is
# a primitive T: `*(*(pp + i) + k)` loads a T and `*(pp + i) + k` strides by
# sizeof(T).  TYPE_VOID when unknown (not a deref, a struct T, or itself a
# pointer, which loads and stores as i64 anyway) — callers keep their
# previous behaviour then.  AGAST #1924: any base ptr_levels_of resolves.
#
# ritz1's own enum tracker read its `**u8` name table this way under
# self-hosting and got `load i64` for each byte, so it carried a "load each
# byte through an explicit let" workaround (ast_helpers.ritz) for years.
fn deref_ptr_ptr_elem_type(s: *EmitterState, d: *Expr) -> i32
    if d == null or d.kind != EXPR_UNARY or d.op != OP_DEREF or d.operand == null
        return TYPE_VOID
    var inner: i32 = TYPE_VOID
    var name: *u8 = null
    var name_len: i32 = 0
    if ptr_levels_of(s, d, @inner, @name, @name_len) != 1
        return TYPE_VOID
    if inner == TYPE_STRUCT or ptr_pointee_size(s, inner, null, 0) == 0
        return TYPE_VOID
    return inner

# AGAST #1941 / #1924: the element stride of a pointer-valued `*y`, for
# `*pp + 1` / `*(pp + i) + k`: sizeof(T) when `*y` is a `*T` (struct T
# included: sizeof(S)), 8 when it is itself a pointer to pointer
# (`*ppp + 1` with `ppp: ***S`, #1944).  0 when not that shape, which
# ptr_arith_elem_size reads as "not a pointer" (a raw byte add).
fn deref_ptr_ptr_stride(s: *EmitterState, d: *Expr) -> i64
    if d == null or d.kind != EXPR_UNARY or d.op != OP_DEREF or d.operand == null
        return 0
    var inner: i32 = TYPE_VOID
    var name: *u8 = null
    var name_len: i32 = 0
    let levels: i32 = ptr_levels_of(s, d, @inner, @name, @name_len)
    if levels >= 2
        return 8
    if levels == 1
        return ptr_pointee_size(s, inner, name, name_len)
    return 0

# AGAST #1924: the struct S that a pointer-valued `*y` points at (`*(pp + i)`
# with `pp: **S`, `*(t.cells + i)` with a `**S` field, `*g`), so
# `*(*(pp + i) + k)` loads `%S` and `(*(*(pp + i) + k)).f` resolves.
# Writes null/0 when not that shape.
fn deref_ptr_ptr_struct_name(s: *EmitterState, d: *Expr, out_name: **u8, out_len: *i32)
    *out_name = null
    *out_len = 0
    if d == null or d.kind != EXPR_UNARY or d.op != OP_DEREF or d.operand == null
        return
    var inner: i32 = TYPE_VOID
    var name: *u8 = null
    var name_len: i32 = 0
    if ptr_levels_of(s, d, @inner, @name, @name_len) != 1 or inner != TYPE_STRUCT
        return
    *out_name = name
    *out_len = name_len

# Classify an operand of `+`/`-` as pointer arithmetic, and if so give its
# element stride.  Returns 0 for "not a pointer", otherwise the element size
# in bytes (never 0, so 0 is an unambiguous sentinel).
#
# AGAST #1361.  This was previously inline in emit_expr_binary and handled
# exactly two shapes: EXPR_IDENT (`p + i`) and EXPR_MEMBER (`s.ptr + i`).
# An unparenthesised chain associates to the left:
#
#     lines.data + i - 1   ==   SUB( ADD( MEMBER(lines,data), i ), 1 )
#
# so the outer SUB's left operand is EXPR_BINARY, matched neither arm, and
# the `- 1` was emitted as a raw BYTE subtraction.  For a 16-byte element
# that lands 15 bytes short and every field load reads across the element
# boundary.  It does not crash — it silently computes a wrong address, which
# is how `tier2_stdlib/14_uniq` shipped passing every line through instead of
# deduplicating for as long as ritz1 has existed.
#
# The recursion is deliberately down the LEFT spine only: `p + i` is a
# pointer, `i + p` is not treated as one here (that asymmetry is pre-existing
# and shared with the two original arms).  Pointer DIFFERENCE (`p - q`, which
# yields an integer, not a pointer) is likewise still mis-scaled — but it was
# already mis-scaled at depth 0 before this change, so propagating the same
# classification through a chain keeps behaviour consistent rather than
# introducing a second, differently-wrong rule.  Tracked separately.
fn ptr_arith_elem_size(s: *EmitterState, e: *Expr) -> i64
    if e.kind == EXPR_IDENT
        let lt: i32 = find_local_type(s, e.ident_ptr, e.ident_len)
        if lt == TYPE_PTR or lt == TYPE_PTR_PTR or lt == TYPE_REF or lt == TYPE_MUT_REF
            return get_ptr_elem_size(s, e)
        if lt == TYPE_UNKNOWN
            # Global pointer var: the ident isn't a local (find_local_type
            # returns TYPE_UNKNOWN since AGAST #1328; it used to return a
            # TYPE_I64 miss value, so this arm previously also ran for real
            # i64 locals that shadow a global — now it is miss-only).
            # Without this branch, `*(g_arr + i) = ...` for `var g_arr: *T`
            # emits raw `add i64 base, i` (no stride), then stores i64 —
            # wrong for *i32 globals (which the monomorph instantiation
            # tracker uses heavily).  Was the source of the selfhost 8-test
            # gap (vec_push\$T not specialized → declare i64 extern instead
            # of `define i32`).
            let glob: *GlobalVarDef = find_global(s, e.ident_ptr, e.ident_len)
            if glob != null
                if glob.var_type == TYPE_PTR_PTR
                    return 8
                if glob.var_type == TYPE_PTR or glob.var_type == TYPE_REF or glob.var_type == TYPE_MUT_REF
                    # AGAST #2034: size the pointee with ptr_pointee_size, the
                    # table locals and params use.  This arm used to list
                    # only the integer widths, so `g + 1` on a `*f32` / `*f64`
                    # global stepped one byte.  `*S` globals are sized by
                    # emit_expr_binary's deref_pointee_struct_name first; an
                    # unknown pointee keeps the old 1-byte stride.
                    let gsz: i64 = ptr_pointee_size(s, glob.pointee_type, null, 0)
                    if gsz > 0
                        return gsz
                    return 1
        return 0
    if e.kind == EXPR_MEMBER
        # Member field access — check if the field is a pointer type.
        # AGAST #1673: at any chain depth.  `o.mid.buf.p + 1` used to match
        # only `local.f` and fall through to a raw BYTE add for an *i32.
        let fld: *StructField = member_field_def(s, e)
        if fld != null
            if fld.field_type == TYPE_PTR or fld.field_type == TYPE_PTR_PTR or fld.field_type == TYPE_REF or fld.field_type == TYPE_MUT_REF
                return get_ptr_elem_size(s, e)
        return 0
    if e.kind == EXPR_BINARY
        # A chain: `(ptr ± a) ± b`.  The inner result is a pointer iff the
        # inner expression was itself pointer arithmetic, and it carries the
        # same stride.
        if e.op == OP_ADD or e.op == OP_SUB
            return ptr_arith_elem_size(s, e.left)
        return 0
    if e.kind == EXPR_INDEX
        # AGAST #2332: `a[i] + k` with `a: [N]*T` strides by sizeof(T).
        var ae_name: *u8 = null
        var ae_len: i32 = 0
        let ae: i32 = array_elem_pointee(s, e, @ae_name, @ae_len)
        return ptr_pointee_size(s, ae, ae_name, ae_len)
    if e.kind == EXPR_UNARY
        # AGAST #1603: `@arr[i] + n`.  The address of an indexed element is a
        # pointer to that element, so it strides by the element size.  Without
        # this arm the sum classified as "not a pointer" and `+ n` was a raw
        # BYTE offset — `@arr[0] + 2` on a [4]i32 landed half-way into
        # element 0.  (`let q: *i32 = @arr[0]` then `q + 2` was always fine:
        # q is an identifier with a recorded pointee.)
        if (e.op == OP_ADDR or e.op == OP_ADDR_MUT) and e.operand != null and e.operand.kind == EXPR_INDEX
            return index_elem_size(s, e.operand)
        # AGAST #1815 / #1941 / #1924: `*(pp + i) + k` for `pp: **T`
        # strides by sizeof(T) (sizeof(S) for `**S`, 8 for `***T`), whatever
        # the base: local, param, global or struct field.
        return deref_ptr_ptr_stride(s, e)
    return 0

# Byte size of the element an index expression `base[i]` names, for
# `@base[i]` pointer arithmetic (AGAST #1603).  `base` is a local or global
# `[N]T` array, or a pointer (whose stride ptr_arith_elem_size already knows).
# Fails CLOSED like get_ptr_elem_size (#1451): an array whose element size is
# unresolvable is a located emitter error, never a guessed stride.
fn index_elem_size(s: *EmitterState, idx: *Expr) -> i64
    let base: *Expr = idx.left
    if base == null
        return 0
    if base.kind == EXPR_IDENT
        let loc: *LocalVar = find_local_struct_name(s, base.ident_ptr, base.ident_len)
        if loc != null and loc.var_type == TYPE_ARRAY
            let lsize: i64 = ptr_pointee_size(s, loc.array_elem_type, loc.type_name, loc.type_name_len)
            if lsize > 0
                return lsize
            return ptr_elem_size_unknown(s, base.ident_ptr, base.ident_len)
        if loc == null
            let glob: *GlobalVarDef = find_global(s, base.ident_ptr, base.ident_len)
            if glob != null and glob.var_type == TYPE_ARRAY
                let gsize: i64 = ptr_pointee_size(s, glob.array_elem_type, glob.array_elem_type_name, glob.array_elem_type_name_len)
                if gsize > 0
                    return gsize
                return ptr_elem_size_unknown(s, base.ident_ptr, base.ident_len)
    # `@p[i]` for a pointer `p`: the element is p's pointee.
    return ptr_arith_elem_size(s, base)

# Helper: get pointee type for a struct member that is a pointer
# e.g., for span.ptr (where ptr is *u8), returns TYPE_U8.
#
# AGAST #1304: this GUESSES TYPE_U8 for a pointer field whose pointee it
# cannot determine (monomorphised `Vec<T>.data`, for one).  That guess is
# right often enough for loads, but callers that need to know the
# difference between "it is a u8" and "no idea" must use
# get_member_pointee_type_exact below, which returns TYPE_VOID (0) for the
# unknown case.  emit_assign's deref-store depends on that distinction:
# guessing u8 there truncates a struct RHS to one byte.
fn get_member_pointee_type(s: *EmitterState, e: *Expr) -> i32
    let exact: i32 = get_member_pointee_type_exact(s, e)
    if exact == TYPE_VOID
        return TYPE_U8
    return exact

# Like get_member_pointee_type but returns TYPE_VOID (0) rather than
# guessing TYPE_U8 when the field's pointee type is not recorded.
fn get_member_pointee_type_exact(s: *EmitterState, e: *Expr) -> i32
    if e.kind != EXPR_MEMBER
        return TYPE_I64
    # Resolve the field through the whole receiver chain.  Nesting is
    # critical for selfhost: ritz1's own emit_expr_method does
    # `*(e.left.ident_ptr + i)`, and an unresolved receiver returned
    # TYPE_I64 → OP_DEREF emitted `load i64` instead of `load i8`.  This
    # handled exactly `local.f` and `local.m.f` until AGAST #1673;
    # `o.inner.name.ptr` (3+ levels) still loaded i64.
    let field: *StructField = member_field_def(s, e)
    # Return the pointee type based on field's pointer kind.
    # `array_elem_type` is where make_ptr_prim_field records the
    # pointee for primitive pointers (NFA's *i64 indices, Vec$T
    # data, etc.) — without honoring the i16/i32/i64 cases here,
    # `*(struct.ptr_field + i)` would default to TYPE_U8 and
    # emit `load i8`, garbling the actual i64/i32/i16 read.
    # Was the selfhost blocker for the Tier 1 NFA optimization
    # — `nfa.state_trans_offset` is `*i32`; reading it as i8
    # gave bogus offsets and the lexer matched no patterns.
    if field != null and field.field_type == TYPE_PTR
        let pe: i32 = field.array_elem_type
        if pe == TYPE_U8 or pe == TYPE_I8 or pe == TYPE_U16 or pe == TYPE_I16
            return pe
        if pe == TYPE_U32 or pe == TYPE_I32 or pe == TYPE_U64 or pe == TYPE_I64
            return pe
        # AGAST #2053: a `*f32` / `*f64` / `*bool` field.  These fell to
        # the unknown case, so `*r.p` loaded `i8` (the u8 guess) and
        # `*r.p = v` stored `i64 %double`.
        if pe == TYPE_F32 or pe == TYPE_F64 or pe == TYPE_BOOL
            return pe
        # Pointee not recorded — e.g. `data: *T` in a
        # monomorphised generic, where the substituted field
        # carries no array_elem_type.  Report "unknown" and let
        # the caller decide; get_member_pointee_type still
        # guesses u8 for the load paths that relied on it.
        return TYPE_VOID
    return TYPE_I64

# AGAST #1304: pointee type of the pointer expression `ptr` in `*ptr = v`,
# i.e. the width of the destination slot.  Mirrors get_expr_type's OP_DEREF
# arm but returns TYPE_VOID instead of guessing when the pointee is not
# recorded, so emit_assign can fall back to the RHS's own type rather than
# truncating it.  TYPE_I64 doubles as "unknown" in the local/global pointee
# tables, and an i64 store is the default anyway, so it is reported as-is.
fn get_deref_store_type(s: *EmitterState, ptr_expr: *Expr) -> i32
    # AGAST #2119: `*(@s as *i8) = v` / `*@g = v` store the stated pointee.
    let inl_pt: i32 = inline_deref_scalar_pointee(s, ptr_expr)
    if inl_pt != TYPE_VOID
        return inl_pt
    # AGAST #2332: `*a[i] = v` / `*(a[i] + k) = v` with `a: [N]*T`.
    let el_pt: i32 = array_elem_pointee_kind(s, ptr_expr)
    if el_pt != TYPE_VOID
        return el_pt
    if ptr_expr.kind == EXPR_IDENT
        let lpt: i32 = find_local_pointee_type(s, ptr_expr.ident_ptr, ptr_expr.ident_len)
        if lpt != TYPE_I64
            return lpt
        let glob: *GlobalVarDef = find_global(s, ptr_expr.ident_ptr, ptr_expr.ident_len)
        if glob != null
            return glob.pointee_type
        return TYPE_VOID
    if ptr_expr.kind == EXPR_MEMBER
        return get_member_pointee_type_exact(s, ptr_expr)
    if ptr_expr.kind == EXPR_BINARY
        # `*(base + i) = v` — the slot width comes from `base`.
        let base: *Expr = find_base_expr(ptr_expr)
        if base.kind == EXPR_IDENT
            let blpt: i32 = find_local_pointee_type(s, base.ident_ptr, base.ident_len)
            if blpt != TYPE_I64
                return blpt
            let bglob: *GlobalVarDef = find_global(s, base.ident_ptr, base.ident_len)
            if bglob != null
                return bglob.pointee_type
            return TYPE_VOID
        if base.kind == EXPR_MEMBER
            return get_member_pointee_type_exact(s, base)
        # AGAST #1815: `*(*(pp + i) + k) = v`.
        return deref_ptr_ptr_elem_type(s, base)
    if ptr_expr.kind == EXPR_UNARY
        # AGAST #1815: `**pp = v`.
        return deref_ptr_ptr_elem_type(s, ptr_expr)
    return TYPE_VOID

# AGAST #1965: the float width (TYPE_F32 / TYPE_F64) of binop operand `x`,
# or 0 when it is not a float.  An `f32` local can surface as TYPE_STRUCT
# with declared type name "f32", which is_float_type also accepts.
pub fn binop_operand_float_ty(s: *EmitterState, x: *Expr) -> i32
    let t: i32 = get_expr_type(s, x)
    if t == TYPE_F32 or t == TYPE_F64
        return t
    if x.kind == EXPR_IDENT
        let lv: *LocalVar = find_local_struct_name(s, x.ident_ptr, x.ident_len)
        if lv != null and is_float_type(t, lv.type_name, lv.type_name_len) == 1
            if *(lv.type_name + 1) == 51  # "f32"
                return TYPE_F32
            return TYPE_F64
    return 0

# AGAST #1370: float primitive methods, mirroring ritz0's
# _try_emit_float_intrinsic.  0 ceil, 1 floor, 2 round, 3 abs; -1 otherwise.
pub fn float_method_id(name: *u8, len: i32) -> i32
    if len == 4
        if *(name) == 'c' and *(name + 1) == 'e' and *(name + 2) == 'i' and *(name + 3) == 'l'
            return 0
    if len == 5
        if *(name) == 'f' and *(name + 1) == 'l' and *(name + 2) == 'o' and *(name + 3) == 'o' and *(name + 4) == 'r'
            return 1
        if *(name) == 'r' and *(name + 1) == 'o' and *(name + 2) == 'u' and *(name + 3) == 'n' and *(name + 4) == 'd'
            return 2
    if len == 3
        if *(name) == 'a' and *(name + 1) == 'b' and *(name + 2) == 's'
            return 3
    0 - 1

# AGAST #1370: TYPE_F32 / TYPE_F64 when `e` is a float-method call
# (`x.ceil()`, `(x + 0.25).floor()`, `x.abs().ceil()`) on a float receiver,
# 0 otherwise.  The result has the receiver's width, as in ritz0.
pub fn float_method_result_ty(s: *EmitterState, e: *Expr) -> i32
    if e.kind != EXPR_METHOD or e.left == null or e.args != null
        return 0
    if float_method_id(e.ident_ptr, e.ident_len) < 0
        return 0
    binop_operand_float_ty(s, e.left)

# AGAST #2068: the struct name a method call `e` dispatches on, as
# emit_expr_method resolves it, or null.  `*out_len` gets its length.
# Receivers: a local (value or pointer -- loc.type_name names the struct
# either way), a struct / `*S` global, a static `Type.m()`, a struct
# literal, a struct-returning call, and a struct / pointer field.
fn method_recv_type_name(s: *EmitterState, e: *Expr, out_len: *i32) -> *u8
    *out_len = 0
    let rcv: *Expr = e.left
    if rcv == null
        return null
    if rcv.kind == EXPR_IDENT
        let loc: *LocalVar = find_local_struct_name(s, rcv.ident_ptr, rcv.ident_len)
        if loc != null
            *out_len = loc.type_name_len
            return loc.type_name
        let glob: *GlobalVarDef = find_global(s, rcv.ident_ptr, rcv.ident_len)
        if glob != null
            if glob.var_type == TYPE_STRUCT
                *out_len = glob.type_name_len
                return glob.type_name
            if glob.var_type == TYPE_PTR and glob.pointee_type == TYPE_STRUCT
                *out_len = glob.pointee_type_name_len
                return glob.pointee_type_name
            return null
        # Neither local nor global: a static call names its impl type.
        *out_len = rcv.ident_len
        return rcv.ident_ptr as *u8
    if rcv.kind == EXPR_STRUCT_LIT
        *out_len = rcv.ident_len
        return rcv.ident_ptr as *u8
    if rcv.kind == EXPR_CALL
        let fd: *FnDef = find_call_fn(s, rcv)
        if fd != null and fd.return_type == TYPE_STRUCT
            *out_len = fd.return_type_name_len
            return fd.return_type_name
        return null
    if rcv.kind == EXPR_MEMBER
        let fld: *StructField = member_field_def(s, rcv)
        if fld != null and (fld.field_type == TYPE_STRUCT or fld.field_type == TYPE_PTR or fld.field_type == TYPE_REF or fld.field_type == TYPE_MUT_REF)
            *out_len = fld.field_type_name_len
            return fld.field_type_name
    null

# AGAST #2068: TYPE_F32 / TYPE_F64 when `e` calls a user impl method that
# returns one, 0 otherwise.  emit_expr_method leaves that result in a
# `float` / `double` register, so `p.scale(f) + 0.5` must be float math at
# the method's width -- get_expr_type used to call it i64, and the add ran
# at the literal's `double` (`fadd double %<float>`, rejected by clang).
pub fn user_method_float_ret(s: *EmitterState, e: *Expr) -> i32
    let t: i32 = user_method_ret_type(s, e)
    if t == TYPE_F32 or t == TYPE_F64
        return t
    0

# The declared return type of user method call `e`, or TYPE_UNKNOWN.
pub fn user_method_ret_type(s: *EmitterState, e: *Expr) -> i32
    if e.kind != EXPR_METHOD
        return TYPE_UNKNOWN
    var tn_len: i32 = 0
    let tn: *u8 = method_recv_type_name(s, e, @tn_len)
    if tn == null or tn_len == 0
        return TYPE_UNKNOWN
    var ib: *ImplBlock = s.module.impls
    while ib != null
        if name_eq(ib.type_name, ib.type_name_len, tn, tn_len) == 1
            var m: *FnDef = ib.methods
            while m != null
                if name_eq(m.name, m.name_len, e.ident_ptr, e.ident_len) == 1
                    return m.return_type
                m = m.next
        ib = ib.next
    TYPE_UNKNOWN

# AGAST #1965: 1 when `e` is a float literal or a negated one (`-2.5`, which
# #1959 lowers as `fneg double`).  Both are `double`, narrowable to f32.
fn is_float_lit_operand(e: *Expr) -> i32
    if e.kind == EXPR_FLOAT_LIT
        return 1
    if e.kind == EXPR_UNARY and e.op == OP_NEG
        return is_float_lit_operand(e.operand)
    return 0

# AGAST #1965: the float width a binop `e` is computed at, or 0 when neither
# operand is a float.  f32 when both sides are f32, or one is f32 and the
# other a literal / `-literal` (a `double` that narrows); f64 otherwise --
# f64 wins over f32.  emit_expr_binary coerces both operands to it, and
# get_expr_type reports it for float arithmetic so an enclosing op agrees.
pub fn binop_float_width(s: *EmitterState, e: *Expr) -> i32
    let lft: i32 = binop_operand_float_ty(s, e.left)
    let rft: i32 = binop_operand_float_ty(s, e.right)
    if lft == 0 and rft == 0
        return 0
    if lft == TYPE_F32 and (rft == TYPE_F32 or is_float_lit_operand(e.right) == 1)
        return TYPE_F32
    if rft == TYPE_F32 and is_float_lit_operand(e.left) == 1
        return TYPE_F32
    TYPE_F64

# =============================================================================
# Volatile and atomic memory builtins (LANGUAGE_SPEC §18.4-§18.5, AGAST #1879)
# =============================================================================
#
# volatile_load / volatile_store and atomic_* / fence lower to LLVM volatile
# and seq_cst atomic instructions at the width of the pointer's pointee,
# which must be an integer type.  ritz1 carries integers as i64, so results
# come back extended (sext / zext by the pointee's signedness) and value
# operands are truncated, as a call argument would be.

const MEM_VOLATILE_LOAD: i32 = 1
const MEM_VOLATILE_STORE: i32 = 2
const MEM_ATOMIC_LOAD: i32 = 3
const MEM_ATOMIC_STORE: i32 = 4
const MEM_ATOMIC_XCHG: i32 = 5
const MEM_ATOMIC_CMPXCHG: i32 = 6
const MEM_ATOMIC_ADD: i32 = 7
const MEM_ATOMIC_SUB: i32 = 8
const MEM_ATOMIC_AND: i32 = 9
const MEM_ATOMIC_OR: i32 = 10
const MEM_ATOMIC_XOR: i32 = 11
const MEM_FENCE: i32 = 12

# The MEM_* id of a builtin name, 0 for any other name.
fn mem_builtin_id(name: *u8, len: i32) -> i32
    if name_eq(name, len, c"volatile_load", 13) == 1
        return MEM_VOLATILE_LOAD
    if name_eq(name, len, c"volatile_store", 14) == 1
        return MEM_VOLATILE_STORE
    if name_eq(name, len, c"atomic_load", 11) == 1
        return MEM_ATOMIC_LOAD
    if name_eq(name, len, c"atomic_store", 12) == 1
        return MEM_ATOMIC_STORE
    if name_eq(name, len, c"atomic_xchg", 11) == 1
        return MEM_ATOMIC_XCHG
    if name_eq(name, len, c"atomic_cmpxchg", 14) == 1
        return MEM_ATOMIC_CMPXCHG
    if name_eq(name, len, c"atomic_fetch_add", 16) == 1
        return MEM_ATOMIC_ADD
    if name_eq(name, len, c"atomic_fetch_sub", 16) == 1
        return MEM_ATOMIC_SUB
    if name_eq(name, len, c"atomic_fetch_and", 16) == 1
        return MEM_ATOMIC_AND
    if name_eq(name, len, c"atomic_fetch_or", 15) == 1
        return MEM_ATOMIC_OR
    if name_eq(name, len, c"atomic_fetch_xor", 16) == 1
        return MEM_ATOMIC_XOR
    if name_eq(name, len, c"fence", 5) == 1
        return MEM_FENCE
    0

# AGAST #2286: the local `e` names when its slot holds a `:&` borrow's pointer,
# so that `@e` is that pointer (LocalVar.holds_lent_ptr); null otherwise.
fn lent_ptr_local(s: *EmitterState, e: *Expr) -> *LocalVar
    if e == null or e.kind != EXPR_IDENT
        return null
    let loc: *LocalVar = find_local_struct_name(s, e.ident_ptr, e.ident_len)
    if loc == null or loc.holds_lent_ptr == 0
        return null
    return loc

# lent_ptr_local, when `@e` points at a struct, which the local's type_name then
# names.  `c:& **C` and `c:& [2]C` name `C` too, and `@c` isn't a `*C` there.
fn lent_struct_local(s: *EmitterState, e: *Expr) -> *LocalVar
    let loc: *LocalVar = lent_ptr_local(s, e)
    if loc == null or loc.pointee_type != TYPE_STRUCT
        return null
    return loc

# AGAST #2308: the scalar T of a `-> @T` / `-> @&T` fn, or TYPE_VOID.
fn ret_ref_scalar_pointee(f: *FnDef) -> i32
    if f == null or f.ret_ref == null or primitive_name_len(f.ret_ref.param_pointee_type) == 0
        return TYPE_VOID
    return f.ret_ref.param_pointee_type

# The pointee type a pointer expression states inline, or TYPE_VOID: `<e> as
# *T` (the cast records T; AGAST #1453), `@x` (x's own type) and a call that
# returns a reference (#2308).  Shared by the memory builtins (#1879) and the
# `*p` load / `*p = v` store widths (#2119), which otherwise only know a typed
# binding's pointee.
fn inline_ptr_pointee(s: *EmitterState, p: *Expr) -> i32
    if p == null
        return TYPE_VOID
    if p.kind == EXPR_CALL
        return ret_ref_scalar_pointee(find_call_fn(s, p))
    if p.kind == EXPR_CAST and p.op == TYPE_PTR and p.int_val != (TYPE_VOID as i64)
        return p.int_val as i32
    if p.kind == EXPR_UNARY and (p.op == OP_ADDR or p.op == OP_ADDR_MUT) and p.operand != null
        let ae: i32 = addr_of_array_elem_type(s, p.operand)
        if ae != TYPE_VOID
            return ae
        let lent: *LocalVar = lent_ptr_local(s, p.operand)
        if lent != null
            return lent.pointee_type   # AGAST #2286: it reads as the pointer
        return get_expr_type(s, p.operand)
    TYPE_VOID

# The element type of `arr[i]` over an inline array (local, global or
# field), or TYPE_VOID.  get_expr_type calls an integer element i64 (its
# value-model width), but `@arr[i]` points at the element's own slot.
fn addr_of_array_elem_type(s: *EmitterState, x: *Expr) -> i32
    if x.kind != EXPR_INDEX or x.left == null
        return TYPE_VOID
    if x.right != null and x.right.kind == EXPR_RANGE
        return TYPE_VOID
    if x.left.kind == EXPR_IDENT
        let loc: *LocalVar = find_local_struct_name(s, x.left.ident_ptr, x.left.ident_len)
        if loc != null
            if loc.var_type == TYPE_ARRAY
                return loc.array_elem_type
            return TYPE_VOID
        let glob: *GlobalVarDef = find_global(s, x.left.ident_ptr, x.left.ident_len)
        if glob != null and glob.var_type == TYPE_ARRAY
            return glob.array_elem_type
        return TYPE_VOID
    if x.left.kind == EXPR_MEMBER
        let f: *StructField = member_field_def(s, x.left)
        if f != null and f.field_type == TYPE_ARRAY
            return f.array_elem_type
    TYPE_VOID

# AGAST #2119: the scalar (integer / float / bool) pointee of `*p` when `p`
# states it inline, else TYPE_VOID.  `*(@s as *i8)` and `*@g` (g: u32)
# loaded and stored i64, reading / clobbering the slot's neighbours.
# Aggregates are left to deref_pointee_struct_name, which names them.
fn inline_deref_scalar_pointee(s: *EmitterState, p: *Expr) -> i32
    let t: i32 = inline_ptr_pointee(s, p)
    if t != TYPE_VOID and primitive_name_len(t) > 0
        return t
    TYPE_VOID

# The pointee type of a memory builtin's pointer operand.  ritz1's `*p`
# inference only knows a typed binding's pointee (a `*(@x as *u32)` deref
# loads i64), and an atomic must not silently widen, so the two shapes a
# kernel writes inline are resolved here first: `<e> as *T` (the cast
# records T) and `@x` (x's own type).
fn mem_builtin_pointee(s: *EmitterState, arg: *Expr) -> i32
    if arg == null
        return TYPE_VOID
    let inl: i32 = inline_ptr_pointee(s, arg)
    if inl != TYPE_VOID
        return inl
    let d: *Expr = calloc(1, sizeof(Expr)) as *Expr
    d.kind = EXPR_UNARY
    d.op = OP_DEREF
    d.operand = arg
    d.span = arg.span
    get_expr_type(s, d)

# `error: <file>:<line>:<col>: <builtin name> <msg>` (AGAST #1879).
fn mem_builtin_error(s: *EmitterState, e: *Expr, msg: *u8)
    emit_str(s, c"  ; ERROR: memory builtin\n")
    eprints_cstr(c"error: ")
    if g_emit_file != null
        eprints_cstr(g_emit_file)
    else
        eprints_cstr(c"<input>")
    eprints_cstr(c":")
    eprint_int(e.span.line as i64)
    eprints_cstr(c":")
    eprint_int(e.span.col as i64)
    eprints_cstr(c": ")
    var i: i32 = 0
    while i < e.func_name_len
        eprint_char(*(e.func_name + i))
        i += 1
    eprints_cstr(c" ")
    eprints_cstr(msg)
    eprints_cstr(c"\n")
    s.error_count = s.error_count + 1

fn mem_int_type_bits(t: i32) -> i32
    if t == TYPE_I8 or t == TYPE_U8
        return 8
    if t == TYPE_I16 or t == TYPE_U16
        return 16
    if t == TYPE_I32 or t == TYPE_U32
        return 32
    if t == TYPE_I64 or t == TYPE_U64
        return 64
    0

# The type a memory builtin call evaluates to: the pointee for the
# value-returning ones, TYPE_VOID for the stores and fence.
fn mem_builtin_result_type(s: *EmitterState, e: *Expr, id: i32) -> i32
    if id == MEM_VOLATILE_STORE or id == MEM_ATOMIC_STORE or id == MEM_FENCE
        return TYPE_VOID
    mem_builtin_pointee(s, e.args)

fn get_expr_type(s: *EmitterState, e: *Expr) -> i32
    # Returns the Ritz type of an expression
    if e.kind == EXPR_INT_LIT
        return TYPE_I64
    else if e.kind == EXPR_FLOAT_LIT
        # Float literals default to f64; narrowing to f32 happens at
        # binding/argument-coerce sites via fptrunc.
        return TYPE_F64
    else if e.kind == EXPR_CHAR_LIT
        return TYPE_U8   # Character literals are u8
    else if e.kind == EXPR_STRING_LIT
        return TYPE_STRUCT  # Bare "..." is StrView { ptr: *u8, len: i64 } (AGAST #98)
    else if e.kind == EXPR_CSTRING_LIT
        return TYPE_PTR  # c"..." is null-terminated *u8
    # EXPR_SSTRING_LIT removed in AGAST #98 — bare EXPR_STRING_LIT above
    # now covers the same StrView { ptr, len } shape.
    else if e.kind == EXPR_NIL_LIT
        return TYPE_PTR  # nil is a null pointer
    else if e.kind == EXPR_IDENT
        # AGAST #1325: locals first (they shadow globals), then globals.
        # This arm used to consult only the locals table, so a global
        # `var g: *i32` reported TYPE_I64 — find_local_type's miss value,
        # indistinguishable from a real i64 local.  Every caller that
        # branches on TYPE_PTR therefore skipped its pointer path for
        # globals, which made the global-pointee fallbacks in the OP_DEREF
        # arm below unreachable: `*(g + i)` fell through to the i64-load
        # default and read two i32 slots as one i64.  Stores were already
        # global-aware (get_deref_store_type), so the corruption was
        # load-side only and silent.
        let lidx: i32 = find_local_idx(s, e.ident_ptr, e.ident_len)
        if lidx >= 0
            let loc: *LocalVar = local_at(s, lidx)
            return loc.var_type
        let glob: *GlobalVarDef = find_global(s, e.ident_ptr, e.ident_len)
        if glob != null
            return glob.var_type
        # AGAST #2155: `const F: f64 = -1` is a double, not the i64 it folded to.
        var folded: i64 = 0
        let cft: i32 = const_int_init_float_ty(s, find_const_entry(s, e.ident_ptr, e.ident_len), @folded)
        if cft != 0
            return cft
        return TYPE_I64
    else if e.kind == EXPR_INDEX
        # AGAST #2332: `a[i][j]` with `a: [N]*T` is a T.
        if is_array_elem_index(s, e) == 1
            return array_elem_pointee_kind(s, e.left)
        # Indexing: result type depends on base type.
        # AGAST #1328: resolve the base through locals THEN globals — the old
        # code only saw locals, and find_local_type's TYPE_I64 miss value made
        # a global pointer base look like an i64, so `g[i]` on `var g: *i32`
        # skipped both pointer branches and fell to the i64 default.
        if e.left.kind == EXPR_IDENT
            # AGAST #2321: as `a[i]` below.
            let ap: *LocalVar = array_ptr_index_base(s, e.left)
            if ap != null
                let ap_elem: i32 = ap.pointee_array_elem_type
                if ap_elem == TYPE_F32 or ap_elem == TYPE_F64
                    return ap_elem
                return TYPE_I64
            var base_type: i32 = find_local_type(s, e.left.ident_ptr, e.left.ident_len)
            var pointee: i32 = TYPE_UNKNOWN
            if base_type == TYPE_UNKNOWN
                let glob: *GlobalVarDef = find_global(s, e.left.ident_ptr, e.left.ident_len)
                if glob != null
                    base_type = glob.var_type
                    pointee = glob.pointee_type
            else
                pointee = find_local_pointee_type(s, e.left.ident_ptr, e.left.ident_len)
            if base_type == TYPE_PTR_PTR
                return TYPE_PTR  # **u8 indexed gives *u8
            else if base_type == TYPE_PTR
                # AGAST #1975: a range `p[a..b]` is an element pointer
                # (emit_expr_index's #110 lowering), whatever the pointee.
                # It was typed as the element for the integer widths (and u8
                # for f32/f64 after #1973), so `p[2..4] != p + 2` compared a
                # pointer at the element's width.
                if e.right != null and e.right.kind == EXPR_RANGE
                    return TYPE_PTR
                # Element type of *T indexing is the pointee when recorded.
                if pointee == TYPE_I32 or pointee == TYPE_U32 or pointee == TYPE_I16 or pointee == TYPE_U16 or pointee == TYPE_I64 or pointee == TYPE_U64 or pointee == TYPE_I8
                    return pointee
                # AGAST #1973: `p[i]` through a *f32 / *f64 loads a `float` /
                # `double`.
                if pointee == TYPE_F32 or pointee == TYPE_F64
                    return pointee
                return TYPE_U8   # *u8 (or unrecorded pointee) indexed gives u8
            else if base_type == TYPE_ARRAY
                # AGAST #1966: `loc[i]` over a local `[N]f32` / `[N]f64` loads
                # a `float` / `double` (local_array_elem_llvm); say so, or a
                # binop / compare over it picks the other operand's width.
                # A range `loc[a..b]` is an element pointer (i64), not one.
                # AGAST #1970: likewise a global `[N]f32` / `[N]f64`
                # (global_array_elem_llvm).
                let arr_loc: *LocalVar = find_local_struct_name(s, e.left.ident_ptr, e.left.ident_len)
                var arr_elem: i32 = TYPE_UNKNOWN
                if arr_loc != null
                    arr_elem = arr_loc.array_elem_type
                else
                    let arr_glob: *GlobalVarDef = find_global(s, e.left.ident_ptr, e.left.ident_len)
                    if arr_glob != null
                        arr_elem = arr_glob.array_elem_type
                var is_range: i32 = 0
                if e.right != null and e.right.kind == EXPR_RANGE
                    is_range = 1
                if is_range == 0 and (arr_elem == TYPE_F32 or arr_elem == TYPE_F64)
                    return arr_elem
        else if e.left.kind == EXPR_MEMBER and (e.right == null or e.right.kind != EXPR_RANGE)
            # AGAST #1954: `x.f[i]` over a `[N]f32` / `[N]f64` field (any
            # receiver depth, struct pointers included) loads a `float` /
            # `double` (field_array_elem_llvm) — the element's own type.
            let af: *StructField = member_field_def(s, e.left)
            if af != null and af.field_type == TYPE_ARRAY and (af.array_elem_type == TYPE_F32 or af.array_elem_type == TYPE_F64)
                return af.array_elem_type
            # AGAST #2053: `x.p[i]` through a `*f32` / `*f64` field loads a
            # `float` / `double` (ptr_field_elem_llvm) and is not widened.
            if af != null and af.field_type == TYPE_PTR
                let pk: i32 = ptr_field_elem_kind(af)
                if pk == TYPE_F32 or pk == TYPE_F64
                    return pk
        return TYPE_I64  # Default
    else if e.kind == EXPR_UNARY
        if e.op == OP_ADDR
            return TYPE_PTR  # Address-of gives pointer
        else if e.op == OP_ADDR_MUT
            return TYPE_MUT_REF  # Mutable address-of gives mutable reference
        else if e.op == OP_NOT
            # `not <expr>` lowers to `icmp eq + zext to i64` (see
            # emit_expr_unary), so the value-flavoured result is i64
            # regardless of operand type.  Returning the operand's type
            # here would tell STMT_IF "already i1" and skip the i64→i1
            # icmp coerce, wiring an i64 reg into `br i1 ...`.
            return TYPE_I64
        else if e.op == OP_BIT_NOT
            return TYPE_I64
        else if e.op == OP_DEREF
            # AGAST #2119: `*(@s as *i8)` / `*@g` load the stated pointee.
            let inl_pt: i32 = inline_deref_scalar_pointee(s, e.operand)
            if inl_pt != TYPE_VOID
                return inl_pt
            # AGAST #2332: `*a[i]` / `*(a[i] + k)` with `a: [N]*T`.
            let el_pt: i32 = array_elem_pointee_kind(s, e.operand)
            if el_pt != TYPE_VOID
                return el_pt
            # AGAST #1924: `*(ppp + i)` with `ppp: ***T` is itself a `**T`.
            # The arm below calls every deref of a `**` a `*T`, so the next
            # deref out lost the pointee and `*(*(*(ppp + i) + j) + k)`
            # loaded i64.
            var dl_inner: i32 = TYPE_VOID
            var dl_name: *u8 = null
            var dl_len: i32 = 0
            if ptr_levels_of(s, e, @dl_inner, @dl_name, @dl_len) >= 2
                return TYPE_PTR_PTR
            let inner_type: i32 = get_expr_type(s, e.operand)
            if inner_type == TYPE_PTR_PTR
                return TYPE_PTR  # Deref **T gives *T
            else if inner_type == TYPE_PTR
                # Deref *T gives T - look up what T is
                # If operand is an identifier, look up its pointee type
                if e.operand.kind == EXPR_IDENT
                    let local_pt: i32 = find_local_pointee_type(s, e.operand.ident_ptr, e.operand.ident_len)
                    if local_pt != TYPE_I64
                        return local_pt
                    # Fall back to global pointee — without this, *(g_ptr)
                    # for a global *i32 reads as i64 (selfhost monomorph
                    # bug).
                    let glob: *GlobalVarDef = find_global(s, e.operand.ident_ptr, e.operand.ident_len)
                    if glob != null
                        return glob.pointee_type
                    return local_pt
                # If operand is ptr+offset, find base expression and get its pointee type
                else if e.operand.kind == EXPR_BINARY
                    let base: *Expr = find_base_expr(e.operand)
                    if base.kind == EXPR_IDENT
                        let lpt: i32 = find_local_pointee_type(s, base.ident_ptr, base.ident_len)
                        if lpt != TYPE_I64
                            return lpt
                        let glob: *GlobalVarDef = find_global(s, base.ident_ptr, base.ident_len)
                        if glob != null
                            return glob.pointee_type
                        return lpt
                    else if base.kind == EXPR_MEMBER
                        # Member+offset dereference (e.g., *(span.ptr + i))
                        return get_member_pointee_type(s, base)
                    # AGAST #1815: `*(*(pp + i) + k)` for `pp: **T`.
                    let bdpt: i32 = deref_ptr_ptr_elem_type(s, base)
                    if bdpt != TYPE_VOID
                        return bdpt
                # AGAST #1815: `**pp` / `*(*(pp + i))` for `pp: **T`.
                else if e.operand.kind == EXPR_UNARY
                    let udpt: i32 = deref_ptr_ptr_elem_type(s, e.operand)
                    if udpt != TYPE_VOID
                        return udpt
                # Bare member deref: `*param.name` where param.name is *u8
                # (selfhost-only bug — emit_impl_method's `is_self` check
                # `*param.name == 115` was loading i64 instead of i8 because
                # this branch defaulted to TYPE_I64).  Reuse the helper
                # already used for the member+offset path.
                else if e.operand.kind == EXPR_MEMBER
                    return get_member_pointee_type(s, e.operand)
                # AGAST #1975: `*(p[a..b])` -- the range is a pointer into
                # `p` (TYPE_PTR above), so it loads `p`'s integer pointee.
                else if e.operand.kind == EXPR_INDEX and e.operand.right != null and e.operand.right.kind == EXPR_RANGE and e.operand.left.kind == EXPR_IDENT
                    let rb: *Expr = e.operand.left
                    var rb_type: i32 = find_local_type(s, rb.ident_ptr, rb.ident_len)
                    var rb_pt: i32 = TYPE_UNKNOWN
                    if rb_type == TYPE_UNKNOWN
                        let rglob: *GlobalVarDef = find_global(s, rb.ident_ptr, rb.ident_len)
                        if rglob != null
                            rb_type = rglob.var_type
                            rb_pt = rglob.pointee_type
                    else
                        rb_pt = find_local_pointee_type(s, rb.ident_ptr, rb.ident_len)
                    # f32 / f64 included since a float deref lowers (#2022).
                    if rb_type == TYPE_PTR and primitive_name_len(rb_pt) > 0
                        return rb_pt
                return TYPE_I64  # Default for unknown pointer dereference
            else if (inner_type == TYPE_MUT_REF or inner_type == TYPE_REF) and e.operand.kind == EXPR_IDENT
                # AGAST #1644: `*x` with `x: @&i32` loads the pointee's
                # width, as `*q` with `q: *i32` does.  Struct pointees are
                # resolved by name in the OP_DEREF arm before this is asked.
                # AGAST #2308: so does `x: @i32`, which loaded 8 bytes.
                let mr_pt: i32 = find_local_pointee_type(s, e.operand.ident_ptr, e.operand.ident_len)
                if mr_pt != TYPE_STRUCT
                    return mr_pt
                return TYPE_I64
            else
                return TYPE_I64  # Deref *T gives value
        return get_expr_type(s, e.operand)
    else if e.kind == EXPR_BINARY
        # AGAST #1965: float arithmetic is computed at binop_float_width
        # (`y * 2.0` is f32, `y * x` with `x: f64` is f64), not the left type.
        if e.op == OP_ADD or e.op == OP_SUB or e.op == OP_MUL or e.op == OP_DIV
            let bw: i32 = binop_float_width(s, e)
            if bw != 0
                return bw
        return get_expr_type(s, e.left)  # Binary ops preserve left type (simplified)
    else if e.kind == EXPR_MEMBER
        # Look up the field type through the whole receiver chain.  Without
        # nesting, get_expr_type returns TYPE_I64 for `e.left.ident_ptr`, so
        # the surrounding OP_DEREF on `*(e.left.ident_ptr + i)` falls to the
        # i64-load default (selfhost static-method dispatch read 8 bytes
        # instead of 1).  Handled only `l.f` / `l.m.f` until AGAST #1673.
        let mfield: *StructField = member_field_def(s, e)
        if mfield != null
            return mfield.field_type
        return TYPE_I64  # Default for unknown member access
    else if e.kind == EXPR_CALL
        # AGAST #1791: the builtin shadows any user fn of the same name.
        if call_is_named_syscall_builtin(s, e) == 1
            return named_syscall_builtin_type(e.func_name, e.func_name_len)
        # AGAST #1879: volatile / atomic builtins return their pointee type.
        let mem_id: i32 = mem_builtin_id(e.func_name, e.func_name_len)
        if mem_id != 0
            return mem_builtin_result_type(s, e, mem_id)
        # Look up function return type
        # Build full function name with type suffix if generic
        let fn_def: *FnDef = find_call_fn(s, e)
        if fn_def != null
            return fn_def.return_type

        return TYPE_I64  # Default for unknown functions
    else if e.kind == EXPR_CAST
        # Target type stored in e.op (set by expr_cast helper).
        return e.op
    else if e.kind == EXPR_METHOD
        # AGAST #1370: `x.ceil()` on an f32 is an f32 (a `float` register),
        # so `let y = x.ceil()` infers f32 and `x.floor() + 0.5` is f32 math.
        let fmt: i32 = float_method_result_ty(s, e)
        if fmt != 0
            return fmt
        # AGAST #2068: a user method's f32 / f64 return.
        let umt: i32 = user_method_float_ret(s, e)
        if umt != 0
            return umt
    TYPE_I64  # Default fallback

# Does emit_expr leave this bool expression in an i1 register?
#
# AGAST #1646: ritz1 has ONE convention for bools.  Every bool value lives in
# an i64 register; i1 exists only at the ABI edges (call args, `ret`, struct
# field stores) and at `br`, and those sites narrow with `trunc` / `icmp ne`.
# Bool locals (emit_var_decl) and bool params (emit_bool_param_spill, #1497)
# live in i64 slots, bool calls / comparisons / `not` / `and` / `or` zext,
# and bool struct fields zext at the load (emit_expr_member).
#
# The one remaining i1 producer is the load of a bool GLOBAL, which still
# reads its slot as i1 (AGAST #1532 owns bool globals).  Locals and params
# register as TYPE_I64, so a TYPE_BOOL identifier is that global.  Every site
# that must pick between "use as i1" and "narrow an i64" asks this one
# predicate: if / while / assert conditions, bool call args, struct-literal
# bool field stores and print interpolation.
#
# History (AGAST #1367).  Condition sites (STMT_IF, STMT_WHILE) need to know whether the
# register emit_expr just produced can be fed straight into `br i1`, or whether
# it must first be narrowed with `icmp ne i64 ..., 0`.  They used to decide
# that by asking get_expr_type and treating TYPE_BOOL as "already an i1".
#
# That is not the same question.  get_expr_type reports the RITZ type; the br
# needs the LLVM REGISTER WIDTH, and the two disagree wherever emit_expr
# zero-extends a bool into ritz1's uniform i64 value representation:
#
#     %.1 = call i1 @yes()
#     %.2 = zext i1 %.1 to i64     <- TYPE_BOOL, but the register is i64
#     br i1 %.2, ...               <- rejected by clang
#
# get_expr_type's OP_NOT arm already documents exactly this hazard and works
# around it by reporting TYPE_I64; that workaround only covers `not`.  Rather
# than lie about more types, ask the width question directly.
#
# The leaking forms below were MEASURED by sweeping every condition shape and
# classifying the br operand's defining instruction, not derived from reading
# the emitter — reading it predicted that `b and c` on two bool identifiers
# would leak, and it does not.  Measured leaking: a call, a *bool deref, and a
# logical binary whose left operand leaks (get_expr_type delegates EXPR_BINARY
# to its left, so this mirrors the type it will report).  Measured NOT
# leaking: bool identifier, bool struct field, bool array element, `and`/`or`
# over those, comparisons (which report TYPE_I64 and are coerced anyway),
# `not`, and assert's operand.
#
# (That #1367 measurement predates #1646.  Its "bool struct field does not
# leak" was the i1 field load; `and` / `or` over one only "worked" because a
# raw field was never their left operand in a passing program: the operator
# `icmp ne i64`s it, which is invalid IR.  Both now produce i64.)
fn bool_reg_is_i1(s: *EmitterState, e: *Expr) -> i32
    if get_expr_type(s, e) != TYPE_BOOL
        return 0
    if e.kind == EXPR_IDENT
        return 1
    0

# Get the struct type name for a dereference expression that returns TYPE_STRUCT
# Returns the field info if found, null otherwise
# NOTE: Disabled due to parser bug where primitive pointer types have stale type_name values
fn get_deref_struct_type(s: *EmitterState, e: *Expr) -> *StructField
    # For now, always return null until parser properly tracks pointee types
    # TODO: Enable this once parser is fixed
    null

# =============================================================================
# Field type emission (used by emit_expr member access and module-level struct emission)
# =============================================================================

fn emit_field_llvm_type(s: *EmitterState, f: *StructField)
    if f.field_type == TYPE_I32 or f.field_type == TYPE_U32
        emit_str(s, c"i32")
    else if f.field_type == TYPE_I64
        emit_str(s, c"i64")
    else if f.field_type == TYPE_U8 or f.field_type == TYPE_I8
        emit_str(s, c"i8")
    else if f.field_type == TYPE_U16 or f.field_type == TYPE_I16
        emit_str(s, c"i16")
    else if f.field_type == TYPE_F32
        emit_str(s, c"float")
    else if f.field_type == TYPE_F64
        emit_str(s, c"double")
    else if f.field_type == TYPE_BOOL
        emit_str(s, c"i1")
    else if f.field_type == TYPE_PTR or f.field_type == TYPE_PTR_PTR
        emit_str(s, c"ptr")
    else if f.field_type == TYPE_STRUCT
        # Primitive types parsed as struct names (parser has no dedicated
        # tokens) — route through emit_llvm_type_struct for consistent
        # mapping (f32 -> float, u16 -> i16, etc.).
        emit_llvm_type_struct(s, TYPE_STRUCT, f.field_type_name, f.field_type_name_len)
    else if f.field_type == TYPE_ARRAY and f.array_shape != null
        # AGAST #2097: `m: [2][3]i32` is `[2 x [3 x i32]]`, ritz0's ABI.
        emit_array_shape_llvm(s, f.array_shape, 0)
    else if f.field_type == TYPE_ARRAY
        # Emit array type: [N x elem_type]
        emit_str(s, c"[")
        emit_int(s, f.array_size as i64)
        emit_str(s, c" x ")
        if f.array_elem_type == TYPE_STRUCT
            # Emit struct type reference: %StructName
            emit_str(s, c"%")
            emit_name(s, f.array_elem_type_name, f.array_elem_type_name_len)
        else
            emit_str(s, field_array_elem_llvm(f.array_elem_type))
        emit_str(s, c"]")
    else
        emit_str(s, c"i64")
