# ritz1/src/emitter_core.ritz - Emitter State & Helpers
#
# Types, state, lookup helpers, type emission, member-access GEP.
# Split from emitter.ritz to keep individual files under ~1500 lines.

import ritzlib.cstr
import ritzlib.sys
import ritzlib.io
import ritzlib.str
import ritzlib.strview    # strview_eq / strview_starts_with_cstr
import ritzlib.fmt.digits
import ritzlib.gvec
import ritzlib.string   # EmitterState.out: the module's IR, a String on its Arena (AGAST #4696)
import ritzlib.memory
import ritzlib.hash
import ritzlib.hashmap

import ast
import diag            # diag_error_at, fn_display_name (AGAST #3445, #3621, #4018)
import types           # the one primitive type table (AGAST #1889)
import sha256          # sha256_hex, for a private fn's symbol (AGAST #4356)
import ast_helpers   # is_enum_type / enum_variant_index (AGAST #1660)
# name_eq and the other pure AST queries, moved out of here by #3513;
# re-exported, so an emitter module reaches them through emitter_core.
pub import ast_query
import tokens_gen
import emitter_ir      # ir_alloca (AGAST #4460)
import ir_operand      # what a register operand is (AGAST #4696)
import monomorph       # MonoCtx, EmitterState.mono (AGAST #4454)

# =============================================================================
# IR lexical fragments (AGAST #1817)
# =============================================================================
#
# The pieces every emitted instruction shares.  They were spelled as raw
# `c"..."` literals at hundreds of call sites; naming them here gives the IR
# spelling one home and lets the typed builders in emitter_ir.ritz read as
# instructions rather than as a pile of separators.
#
# These are the exact bytes the old literals held, so naming one changes no
# output.  `ret` is NOT here: emit_str runs the ownership drop hook when it
# sees `  ret` (AGAST #1625, #3508), so a ret never goes through a fragment.

pub const IR_INDENT: *u8 = c"  "          # a statement's two-space indent
pub const IR_NL: *u8 = c"\n"              # end of an instruction
pub const IR_PTR_SEP: *u8 = c", ptr "     # the pointer operand separator
pub const IR_SP: *u8 = c" "
pub const IR_TO_I64: *u8 = c" to i64\n"
pub const IR_COMMA: *u8 = c", "
pub const IR_I64_SEP: *u8 = c", i64 "
pub const IR_TO_PTR: *u8 = c" to ptr\n"
pub const IR_COMMA_0: *u8 = c", 0\n"
pub const IR_X: *u8 = c" x "
pub const IR_LABEL_SEP: *u8 = c", label %"
pub const IR_CLOSE: *u8 = c")\n"
pub const IR_I32_ZERO: *u8 = c", i32 0, i32 "
pub const IR_I64_ZERO: *u8 = c", i64 0, i64 "
pub const IR_COMMA_1: *u8 = c", 1\n"
pub const IR_TO_SP: *u8 = c" to "
# Instruction-open fragments.  A builder in emitter_ir.ritz covers the shapes
# whose types the caller already holds as a *u8; these name the prefixes the
# remaining sites share, so the spelling still has one home.
pub const IR_GEP_NAMED: *u8 = c" = getelementptr %"
pub const IR_GEP_ARRAY: *u8 = c" = getelementptr ["
pub const IR_STORE_IND: *u8 = c"  store "
pub const IR_STORE_STRUCT: *u8 = c"  store %"
pub const IR_LOAD: *u8 = c" = load "
pub const IR_LOAD_NAMED: *u8 = c" = load %"
pub const IR_LOAD_PTR: *u8 = c" = load ptr, ptr "
pub const IR_INTTOPTR: *u8 = c" = inttoptr i64 "
pub const IR_TRUNC: *u8 = c" = trunc i64 "
pub const IR_BR: *u8 = c"  br label %"
pub const IR_ADD_ZERO: *u8 = c" = add i64 0, 0\n"
pub const IR_ALLOCA_NAMED: *u8 = c" = alloca %"
pub const IR_ALLOCA: *u8 = c" = alloca "
pub const IR_RBRACK_PTR: *u8 = c"], ptr "
pub const IR_PCT: *u8 = c"%"
pub const IR_AT: *u8 = c"@"
pub const IR_CALL: *u8 = c" = call "
# LLVM type spellings the load/store builders take (AGAST #4464).  A call
# site names one of these instead of its own `c"i64"`, so the spelling is
# written once; `IR_LOAD_PTR` below is the two-fragment equivalent.
pub const IR_TY_I1: *u8 = c"i1"
pub const IR_TY_I8: *u8 = c"i8"
pub const IR_TY_I16: *u8 = c"i16"
pub const IR_TY_I32: *u8 = c"i32"
pub const IR_TY_I64: *u8 = c"i64"
pub const IR_TY_PTR: *u8 = c"ptr"
pub const IR_TY_SPAN_U8: *u8 = c"%Span$u8"
pub const IR_TY_STRVIEW: *u8 = c"%StrView"

# =============================================================================
# Emitter State
# =============================================================================

# Initial capacities of the growable locals table and string-literal list.
# Both double on demand (AGAST #1905); they were fixed inline arrays whose
# overflow was a located fatal error (#1813), while ritz0 has no limit.
const LOCALS_INIT_CAP: i32 = 256
const STRINGS_INIT_CAP: i32 = 4096  # Self-hosting: merged modules have >256 string literals

# A growable list of names (pointer + length), for the extern and emitted-
# name sets.  Those were fixed arrays (2048 / 512) that silently dropped
# entries past the cap (AGAST #1813): a dropped emitted name is emitted twice,
# a dropped extern is never declared.  Parallel arrays rather than an array
# of structs: ritz1 cannot take `@s.p[i]` through a pointer field.
struct NameList
    names: **u8
    lens: *i32
    count: i32
    cap: i32

# A let/var seen so far in the current function, with the integer type its
# annotation WROTE (TypeKind.NarrowUnknown when unannotated or not an integer).
struct NarrowDecl
    name: *u8
    name_len: i32
    decl_type: TypeKind
    # AGAST #2124: what the declaration wrote, for `sizeof(local)`: the
    # annotation (Stmt.var_declared_type, TypeKind.Void when there is none) and
    # the initialiser (null when there is none).
    declared: TypeKind
    init: *Expr

# AGAST #4461 — a whole-struct load of an sret-sized type, held in emission
# order instead of written into the body.  A struct store of the same type and
# register, emitted with nothing in between, replaces it with an
# `@__ritz_sret_copy` call; a use of the register or any intervening
# instruction keeps the load (written back at `off` by
# splice_deferred_struct_loads); a record used for neither is a dead load and
# is dropped as a dead load (#3952).
#
# `off` is an offset into s.out, i.e. into the function body being emitted.
# It is shifted when splice_entry_allocas inserts the entry-block buffer.
const DLOAD_PENDING: i32 = 0
const DLOAD_KEEP: i32 = 1
const DLOAD_DROPPED: i32 = 2

struct DeferredLoad
    reg: i32          # the load's result register (already burned)
    off: i64          # s.out offset the line belongs at
    src_reg: i32      # `ptr %.N` source, or -1 when it is a named global
    src_name: *u8     # `ptr @<name>` source when src_reg < 0
    src_name_len: i32
    ty: *u8          # the struct type name, internal (pre-emit_name) spelling
    ty_len: i32
    state: i32
    used: i32         # 1 once emit_reg referenced the register

struct EmitterState
    # The IR text.  A String drawn from the module's Arena (main.ritz), written
    # through format_into(s, "...") (EmitterState.push_bytes) in ported code and
    # through emit_str (the legacy shim) in the rest.  Points at entry_allocas
    # while a redirect is in effect (#4460).
    out: *String
    # AGAST #4460 — this fn's STATIC allocas, in emission order, and the
    # (buffer offset, source span) of each (frame_limit still locates the
    # largest one).  Written by entry_alloca_begin / entry_alloca and spliced
    # after `entry:` by splice_entry_allocas when the body is complete; a
    # DYNAMIC alloca (`alloca i8, i64 %.N`) is still written to s.out.
    # entry_out_saved is s.out while a redirect is in effect.
    entry_allocas: *String   # in the module's arena, like `out`
    ea_marks: *FrameMark
    ea_count: i32
    ea_cap: i32
    entry_out_saved: *String
    # AGAST #4461 — the deferred large-struct loads of this fn (see
    # DeferredLoad).  Grown for reuse across fns; reset when the body's loads
    # are spliced at the end of each.
    dloads: *DeferredLoad
    dload_count: i32
    dload_cap: i32
    reg_counter: i32
    label_counter: i32
    # Heap array of `locals_cap` LocalVars (AGAST #1905); index it with
    # local_at.  Grown by add_local_full; never shrinks across fns.
    locals: *LocalVar
    locals_cap: i32
    local_count: i32
    break_label: i32
    continue_label: i32
    module: *Module
    # Monomorphisation's tables: a generic enum first named at emission is
    # recorded there (add_enum_instance; AGAST #4454, they were globals).
    mono: *MonoCtx
    # String literals; entry i is emitted as @.str.i (AGAST #1905).
    strings: NameList
    externs: NameList
    # Deduplication tracking for imports
    emitted_structs: NameList
    # AGAST #2419: tagged enums only a match's constructor scrutinee names.  Its
    # payload's type is known once locals are, so emit_tagged_enum_types' scan
    # can't see them: emit_late_enum_types declares them.
    late_enums: NameList
    # AGAST #3005: tuple structs the emitter synthesized for a tuple literal
    # with no tuple type, after emit_struct_types ran: emit_late_enum_types
    # declares them too.
    late_tuples: NameList
    emitted_fns: NameList
    emitted_globals: NameList
    # Track last expression value for if/else phi nodes
    last_expr_reg: i32
    # ritz-task-1309 — the block that DEFINED `last_expr_reg`.
    #
    # `last_expr_reg` on its own is just "some register"; it carries no record
    # of where it was produced.  Phi emission needs both halves — the incoming
    # value AND the predecessor block it flows from — and it used to pair
    # `last_expr_reg` with `s.current_label`, silently assuming the two agree.
    # They disagree whenever the value was produced in a *nested* block that
    # the insertion point has since moved past (an inner `if`'s then-block, a
    # loop body).  The result was `phi i64 [ %x, %L20 ]` where %x is neither
    # defined in nor dominated by L20 — SSA-invalid IR that permissive
    # verifiers accepted and LLVM 21 correctly rejects.
    #
    # Keeping the defining label welded to the value makes the mismatch
    # detectable: `last_expr_here` returns the register only when it was
    # defined in the block we are currently emitting into, and 0 otherwise.
    last_expr_label: i32
    # AGAST #2950: what LLVM type last_expr_reg has, when an `if` / `match`
    # statement set it: LAST_EXPR_I64 or LAST_EXPR_PTR (its phi), else
    # LAST_EXPR_UNKNOWN.  A tail one in a `-> @&T` / `-> *T` fn is converted.
    last_expr_model: i32
    # Track current label for phi node predecessors (needed for nested control flow)
    current_label: i32
    # Current function's return type name (for struct returns)
    ret_type_name: *u8
    ret_type_name_len: i32
    # AGAST #1730 — 1 when the current fn returns its (large) struct through
    # a `ptr sret(%T) %ret.sret` first parameter; see struct_ret_uses_sret.
    ret_sret: i32
    # The current fn's return TYPE_* (AGAST #1454).  emit_stmt takes it as a
    # parameter, but a block-bodied match arm reached through emit_expr has
    # none to pass, so its statements read it from here.
    fn_ret_type: TypeKind
    # The value register of the most recent sret call result and the slot it
    # was loaded from, so `return f()` copies the slot instead of the value.
    sret_last_val: i32
    sret_last_slot: i32
    # 1 once any sret copy/zero is emitted: emit_sret_helpers then defines
    # @__ritz_sret_copy / @__ritz_sret_zero for this module.
    sret_helpers_used: i32
    # Bit 1 / bit 2 once float `%` calls @__ritz_fmod / @__ritz_fmodf: see
    # emit_fmod_helpers (AGAST #3817).
    fmod_helpers_used: i32
    # Tagged-enum context for variant constructors (ritz-task-133).
    # When non-null, `Some(x)` / `Ok(x)` / `None` / `Err(x)` allocas use this
    # struct name instead of falling back to `ret_type_name`.  Set by
    # emit_var_decl / emit_return for explicit `let r: Result<_,_> = Ok(x)`
    # bindings.  Null means "use ret_type_name" (covers tail-expression
    # returns inside a Result-returning fn).
    ctx_enum_name: *u8
    ctx_enum_name_len: i32
    # AGAST #1498: 1 while emitting a call argument (emit_call_arg).  There
    # the only valid enum context is the callee's parameter type, already in
    # ctx_enum_name; resolve_enum_ctx must NOT fall back to ret_type_name.
    ctx_enum_arg: i32
    # AGAST #2296: the struct type of the slot the value being emitted lands
    # in, whatever kind of struct: a typed let's, a parameter's or a store
    # target's (null when it isn't a struct), so `Span.empty()` can take its
    # T from it.  ctx_slot_set is 1 inside such a slot; 0 (a `return`, or no
    # slot yet) falls back to the fn's return type, as ritz0's
    # expected_ritz_type does.
    ctx_slot_name: *u8
    ctx_slot_name_len: i32
    ctx_slot_set: i32
    # AGAST #2330: the expression being emitted into a struct slot, a copy, or null.
    # emit_expr_index lets a struct element of a pointer to an array be that, and
    # nothing else: a struct value is its address, so an integer context took the
    # address as a number and failed at clang.
    struct_copy_expr: *Expr
    # AGAST #167: SIMD-typed binding context.  When emitting `let v: v4i32 =
    # simd_loadu(...)`, the var-decl pre-sets these so emit_expr_call's
    # SIMD intrinsic dispatch knows which `<N x iM>` type to produce.  Null
    # means "no SIMD-typed enclosing binding" — intrinsic dispatch then
    # tries to derive the type from arg idents (vector-typed locals).
    ctx_simd_name: *u8
    ctx_simd_name_len: i32
    # AGAST #1666: the merge-phi aggregate type (MatchResult.agg_name) of
    # the most recently completed emit_match, or null when its phi was i64.
    # emit_var_decl reads it right after emitting an untyped `let v = match`
    # initializer to size the slot as `alloca %StrView` rather than i64.
    last_match_agg_name: *u8
    last_match_agg_name_len: i32
    # AGAST #1946: the float phi type (TypeKind.F32 / TypeKind.F64) of the most
    # recently completed emit_match / emit_if_expr, or 0 when it was not a
    # float.  Read like last_match_agg_name by an untyped `let v = match`.
    last_match_float_ty: TypeKind
    # AGAST #2559: the struct type of the most recently completed statement
    # `if`'s merge phi, or null when it had none or it was i64.  An enclosing
    # `if` whose arm ends in it (an `else if` chain) types its own phi by it.
    last_if_stmt_agg_name: *u8
    last_if_stmt_agg_name_len: i32
    # AGAST #1946: the float type an enclosing `let x: f64 = match ...` /
    # `return match ...` (in a `-> f64` fn) expects of the match, or 0.  The
    # match it is set for consumes and clears it on entry; it re-sets it just
    # before a match / if that is an arm's value tail (AGAST #2092), so it
    # reaches every nested tail but nothing else (scrutinee, condition, arm
    # statements).
    match_float_hint: TypeKind
    # AGAST #3205: the struct or enum a `-> S` fn returns, set while its tail
    # match (a StmtKind.Match) is emitted, or null.  Taken on entry like
    # match_float_hint; the match's phi falls back to it when no arm yields a
    # value (every arm `return`s), so the implicit `ret %S` names no i64 phi.
    match_agg_hint: *u8
    match_agg_hint_len: i32
    # AGAST #2046: set by a caller that discards the value of the match / if
    # it is about to emit (StmtKind.Match, an expression statement, a match or
    # if nested as an arm).  emit_match / emit_if_expr consume and clear it
    # on entry, as with match_float_hint.  Clear = the value is wanted, and
    # a valueless arm (a void call) is a located error.
    match_no_value: i32
    # AGAST #2288: the statement-`if` arm's trailing StmtKind.Expr being emitted
    # (emit_if_stmt_arm), or null.  A `c:& C` there is the arm's value, so it
    # reads the referent.
    if_arm_value: *Stmt
    # AGAST #3749: a statement `if` whose value nobody reads although it is
    # the last of its list: a loop / `unsafe` body's, or one ending an arm of
    # such an `if`.  Its arms get no phi (one with a `next` never does).
    if_stmt_discarded: *Stmt
    # AGAST #2046: where the innermost valueless arm of the last valueless
    # match / if is, so an enclosing match reports the void call itself.
    void_arm_line: i32
    void_arm_col: i32
    # ritz-task-193 — O(1) symbol lookups.
    # `local_map`  : fnv1a(name)  -> i32 index into `locals[]`.  Cleared at
    #                each fn/method start (because `local_count` resets to 0)
    #                and rebuilt by emit_match_arm_body after scope unwind.
    #                Shadowing: insert overwrites; outer bindings re-found via
    #                the array-scan fallback when the map points to a stale
    #                (idx >= local_count) or name-mismatched entry.
    # `global_map` : fnv1a(name)  -> *GlobalVarDef  (cast to i64).  Built once
    #                per emit_module from `m.globals` after monomorphization.
    # `fn_map`     : fnv1a(name)  -> *FnDef         (first-occurrence wins to
    #                preserve linked-list head-first semantics).
    # `struct_map` : fnv1a(name)  -> *StructDef     (first-occurrence wins).
    # `const_map`  : fnv1a(name)  -> *ConstEntry    (first-occurrence wins).
    # All five replace linear-scan symbol lookups that made ritz1 5.7×
    # slower than ritz0 cold-builds on valet (67 .ritz files, 11.5k LoC).
    local_map: HashMapI64
    global_map: HashMapI64
    fn_map: HashMapI64
    struct_map: HashMapI64
    const_map: HashMapI64
    # AGAST #1369 — count of expressions the emitter could not lower.
    # The emitter used to have NO way to report failure: when it met something
    # it could not emit it wrote `; ERROR: ...` into the IR as a comment,
    # substituted a zero (or, for an assignment, dropped the store), and
    # returned success.  ritz1 then exited 0, build.py printed its tick, and
    # the program segfaulted or silently computed the wrong answer.
    # emit_module returns this count and main refuses to write the output when
    # it is non-zero.  See emit_ir_error().
    error_count: i32
    # AGAST #3362 — the last undeclared struct name already reported (by the
    # member access rule, or #3347's literal rule for `String`), so one
    # mistake is one error; see unknown_struct_member_refused.
    unknown_struct_name: *u8
    unknown_struct_name_len: i32
    match_scrut_kind: i32   # BK_* of the scrutinee of the match being emitted
    match_scrut_int: TypeKind    # AGAST #3358: its integer type kind, or 0
    match_scrut_str: i32    # AGAST #1876: 1 when it is a StrView, which string arms compare
    # AGAST #2255, #2260 — the expressions whose value the statements being
    # emitted use, innermost statement last; see want_stmt_values.
    wanted: **Expr
    wanted_count: i32
    wanted_cap: i32
    # AGAST #1521 — 1 once a print interpolation has called one of the
    # @__ritz_print_* helpers; emit_module then defines them.
    print_helpers_used: i32
    # AGAST #1824 — 1 once a format_into has called @__ritz_fmt_int /
    # @__ritz_fmt_strlen; emit_module then defines them.
    fmt_helpers_used: i32
    # AGAST #4462 — per-register packed provenance (index = register), 1 when
    # the register is a pointer derived from a `[[packed]]` struct: a
    # getelementptr whose source type is packed, or whose base is itself
    # packed-derived.  A load/store through a marked register says `align 1`.
    # Grown for reuse across fns and zeroed at each fn's start.
    packed_marks: *u8
    packed_marks_cap: i32
    # AGAST #1364 — per-function table of written integer types
    # (narrowing.ritz), for the codegen paths that read narrowing's rule
    # mid-lowering (enum_as_int, sizeof).  The check
    # itself is Sema's (AGAST #3505).  Reset by narrowing_begin_fn per fn.
    narrow_params: *Param
    narrow_decls: [256]NarrowDecl
    narrow_decl_count: i32
    narrow_decl_overflow: i32
    # AGAST #1869 — assert lowering (emit_assert_stmt, emitter_print.ritz).
    # fn_assert_kind: ASSERT_FN_* of the fn being emitted, set by emit_fn /
    # emit_impl_method.  assert_helpers_used / assert_site_used: emit_module
    # then defines @__ritz_assert_val / the @__ritz_assert_site_* globals.
    # assert_cap_*: emit_expr_binary records the i64 operand registers of
    # the comparison assert_cap_expr (assert_cap_ok = 1 once it has).
    # assert_file_str: @.str index of the source file's basename, or -1.
    fn_assert_kind: i32
    assert_helpers_used: i32
    assert_site_used: i32
    assert_cap_expr: *Expr
    assert_cap_ok: i32
    assert_cap_l: i32
    assert_cap_r: i32
    assert_file_str: i32
    # AGAST #4607 — freestanding stops: PSTOP_* bits.  emit_module sets
    # PSTOP_FREESTANDING from `--target` (a kernel's traps and failing
    # asserts stop through ritz_platform_fatal, never an exit syscall); each
    # such call sets PSTOP_USED, and emit_platform_hooks sets PSTOP_DEFINED
    # when it defines the weak hook, so the module tail declares it only
    # when needed (emit_platform_fatal_decl).
    platform_stop: i32
    # AGAST #2158 — move checking and drop insertion (ownership.ritz).
    # Allocated by own_init in emit_module.
    own: *OwnState
    # AGAST #3508: emit_stmt, for ownership.ritz to emit a deferred statement
    # at a block's exit (own_run_defer) without importing emitter_stmt.
    own_emit_stmt: fn(*EmitterState, *Stmt, TypeKind)
    # AGAST #3513: ownership's own_before_ret and ref_check's
    # ref_cast_reads_referent, so emitter_core imports neither module.
    own_before_ret_fn: fn(*EmitterState)
    ref_cast_reads_referent_fn: fn(*EmitterState, *Expr) -> i32
    # AGAST #3739 — what frame_limit.ritz needs to locate a fn's allocas.
    # fm: (offset in out, span) marks, appended as emit_stmt / emit_expr
    # enter and leave; an alloca line belongs to the last mark at or before
    # it.  fm_line / fm_col: the span now in force.  fs: (alloca reg, name)
    # of every local add_local_full registered this fn, never rolled back.
    fm: *FrameMark
    fm_count: i32
    fm_cap: i32
    fm_line: i32
    fm_col: i32
    fs: *FrameSlot
    fs_count: i32
    fs_cap: i32

# EmitterState.platform_stop bits (AGAST #4607).
pub const PSTOP_FREESTANDING: i32 = 1
pub const PSTOP_USED: i32 = 2
pub const PSTOP_DEFINED: i32 = 4

# AGAST #3739 — from `off` in s.out on, the emitter was at `line`:`col`.
struct FrameMark
    off: i64
    line: i32
    col: i32

# AGAST #3739 — register `reg` holds the local `name` (len bytes).
struct FrameSlot
    reg: i32
    name_len: i32
    name: *u8

# AGAST #2158 — a binding that owns a value of a move-only type
# (LANGUAGE_SPEC §13.1): one that implements Drop or holds one.
struct OwnBinding
    name: *u8
    name_len: i32
    local_idx: i32        # its index in s.locals when it was declared
    slot: i32             # register of its storage (alloca / byval pointer)
    flag: i32             # register of its `alloca i1` drop flag
    type_name: *u8
    type_name_len: i32
    # 1 once a move cleared its flag, until it is assigned again: a match on
    # it owns the value it just moved (own_scrutinee_moved).  The move check
    # itself is own_check.ritz's, on Sema (AGAST #3507).
    moved: i32
    # AGAST #2165: >0 for an array binding of `count` type_name elements
    # (an N-D array counts every leaf), 0 for a single value.
    count: i32
    # AGAST #2168, #2242: moves out of a field.  `paths` lists what can be
    # moved out (`path_count` of them, null when nothing can).  `fmask` is
    # the register of an `alloca iN` (N: path_count in whole 32-bit words,
    # AGAST #2319) whose bit i is set at run time while
    # path i is moved out (the drop skips it), or 0 when the binding can't be
    # partly moved (an array, a temporary, a type with its own drop).  `aux`
    # is used by own_assign_begin's handle only.
    paths: *OwnPath
    path_count: i32
    fmask: i32
    aux: i32
    # AGAST #2173: in own_assign_begin's handle only: the field a field
    # store `x.f... = v` overwrites (the handle is then for its old value),
    # else null; and (#2242) the path it is, or -1, with `aux` the moved
    # paths' mask from before the store.
    old_field: *StructField
    old_path: i32
    # AGAST #3508: its place in the order the fn's bindings and temporaries
    # were registered; a `ret` drops what is live newest first by it.
    seq: i32

# Per-function ownership state (ownership.ritz).
struct OwnState
    # The bindings in scope, innermost last.
    live: *OwnBinding
    live_count: i32
    live_cap: i32
    # One entry per open block: the index into `live` where it starts, and
    # 1 once a `return` was emitted directly in it (what follows is dead).
    scope_start: *i32
    scope_dead: *i32
    scope_count: i32
    scope_cap: i32
    # The next OwnBinding.seq (AGAST #3508).
    seq_next: i32
    # `live` index where the innermost loop body starts; -1 outside a loop.
    loop_base: i32
    # AGAST #4387: `temps` index where it starts, per loop depth as
    # loop_dstart is for defers.  `break` / `continue` drop the pending
    # temporaries from here too.
    loop_tbase: *i32
    loop_tcap: i32
    # Label counter for the drops own_before_ret emits before each `ret`.
    ret_seq: i32
    # AGAST #2165.  -1 until known, then 1 when the module has an `impl
    # Drop` at all (without one nothing is move-only).
    has_drop: i32
    # Call expressions own_walk found to yield a move-only temporary
    # nobody owns; emit_expr spills each one and moves it to `temps`.
    temp_exprs: **Expr
    temp_expr_count: i32
    temp_expr_cap: i32
    # The register own_note_temp spilled last, and its slot: a method
    # receiver that is that temporary is passed as the slot itself, so the
    # method and the drop see one value (AGAST #2262).
    temp_last_reg: i32
    temp_last_slot: i32
    # Temporaries awaiting their drop at the end of their statement (or
    # condition), innermost statement last.  Each is also in `all`.
    temps: *OwnBinding
    temp_count: i32
    temp_cap: i32
    # `temps` index where the statement being emitted starts.
    stmt_mark: i32
    # The current loop nesting depth (loop_dstart's index).
    loop_depth: i32
    # AGAST #2174: the `live` index of the scrutinee the innermost match
    # being emitted owns, or -1 (see own_match_begin).
    match_scrut: i32
    # AGAST #2173: the i1 register own_stmt_moves computed for the field
    # store `x.f... = v` being emitted (x owns the field's old value: drop
    # it), or 0.  own_assign_begin consumes it, with (#2242) the path stored
    # to (-1 if it isn't one) and the moved paths' mask before the store.
    fa_cond: i32
    fa_path: i32
    fa_mask: i32
    # AGAST #1625 (`defer`, LANGUAGE_SPEC §13.7): the registered deferred
    # statements, innermost last: each one's StmtKind.Defer, the `live` count when
    # it was reached (bindings below it were declared before it) and the
    # enclosing fn's return type.  scope_dstart is, per open block, the
    # defer_count where it starts; loop_dstart, per loop depth, the
    # defer_count where the loop body starts (what `break` / `continue` run).
    defer_stmts: **Stmt
    defer_pos: *i32
    # AGAST #4387: the `temps` count when it was reached, as defer_pos is
    # for `live`: a temporary newer than this was made after the defer.
    defer_tpos: *i32
    defer_ret: *TypeKind
    defer_count: i32
    defer_cap: i32
    scope_dstart: *i32
    loop_dstart: *i32
    loop_dcap: i32
    # 1 while a `ret` runs them.
    in_ret: i32

# =============================================================================
# Helpers
# =============================================================================

# `--no-red-zone` (AGAST #4308): every define ritz1 writes, Ritz fns
# (emitter.ritz's emit_fn_attrs) and hand-written helpers alike, carries
# LLVM's noredzone.  clang's -mno-red-zone is a frontend flag that does
# nothing for .ll input, so the attribute has to travel with the IR.
var g_no_red_zone: i32 = 0

pub fn set_no_red_zone_attr(on: i32)
    g_no_red_zone = on

# ` noredzone` after a define's `)` (or its other attributes), when on.
pub fn emit_no_red_zone_attr(s: *EmitterState)
    if g_no_red_zone == 1
        emit_str(s, c" noredzone")

# =============================================================================
# Packed-struct pointer provenance (AGAST #4462)
# =============================================================================
#
# A `[[packed]]` struct is `<{ ... }>`: its fields sit at any byte offset, so
# `p.b: u64` at offset 1 is 1-aligned.  A `load i64, ptr %f` with no `align`
# operand claims ABI alignment 8 instead -- UB that -O2 may exploit.
#
# #1918 answered this with a pass over the finished fn body: scan every
# getelementptr, mark its result when the source type is packed or the base is
# marked, then splice `, align 1` onto loads/stores through a marked register.
# The facts are available as the instruction is emitted, so #4462 records them
# there instead:
#
#   * emit_name, when it emits the source type of a `getelementptr %<name>`
#     line, marks the GEP's result if find_struct(<name>) is packed;
#   * emit_reg, when it emits the base of a getelementptr, marks the result if
#     the base register is marked (so `p.inner.x` propagates: `p.inner` is
#     packed, `Inner` itself is not);
#   * emit_reg, when it emits the pointer operand of a load/store, appends
#     `, align 1` if that register is marked.
#
# A pointer LOADED from memory is a new register and starts afresh, exactly as
# the old pass treated it.  The marks are per fn (register numbers are too).

# Start offset of the line currently being built in s.out.
fn packed_line_start(s: *EmitterState) -> i64
    var i: i64 = s.out.data.len - 1
    while i >= 0 and *(s.out.data.data + i) != 10   # '\n'
        i -= 1
    i + 1

# The module's IR buffers live in its Arena and are sized once, to the room they
# have, so they never grow: a growth would realloc a block no libc allocator
# owns (valgrind, which replaces realloc and free, rejects it), and a String
# that is never dropped never frees one.  So an arena String is a *String whose
# header is in the arena too, and the arena is unmapped whole.
pub const ENTRY_ALLOCA_BYTES: i64 = 33554432   # one fn's static allocas, about 100 bytes each

# A String of `cap` bytes, header and bytes both from `a` (see above); null if
# `a` is out of room.
pub fn arena_string(a: *Allocator, cap: i64) -> *String
    let at: *String = a.malloc(sizeof(String)) as *String
    if at == null
        emit_out_exhausted()
    *at = string_with_cap_in(a, cap)
    at

# `text` inserted into the IR at offset `at`, the bytes after it moving up.
# The two splices (the entry-block allocas, the deferred struct loads) are the
# only places the emitter writes anywhere but the end of the IR.
pub fn out_insert(s: *EmitterState, at: i64, text: StrView)
    let old_len: i64 = s.out.data.len
    if not s.out.data.ensure_cap(old_len + text.len)
        emit_out_exhausted()
    memmove(s.out.data.data + at + text.len, s.out.data.data + at, old_len - at)
    memcpy(s.out.data.data + at, text.ptr, text.len)
    s.out.data.len = old_len + text.len

# The partial line currently being built (no trailing newline yet).
fn packed_line(s: *EmitterState) -> StrView
    let start: i64 = packed_line_start(s)
    StrView { ptr: (s.out.data.data + start), len: (s.out.data.len - start) }

# Does the partial line end with `, ptr ` -- i.e. is a pointer operand next?
fn packed_line_at_ptr_sep(s: *EmitterState) -> i32
    let line: StrView = packed_line(s)
    if line.len < 6
        return 0
    if line.ends_with(strview_from_cstr(c", ptr "))
        return 1
    0

# `%.N` at the start of the current line -> N, or -1.  Only called on a line
# already known to be a getelementptr, whose result is always `  %.N`.
fn packed_gep_dst(s: *EmitterState) -> i32
    let line: StrView = packed_line(s)
    if line.len < 4
        return 0 - 1
    if *(line.ptr + 0) != ' ' or *(line.ptr + 1) != ' '   # "  "
        return 0 - 1
    if *(line.ptr + 2) != '%' or *(line.ptr + 3) != '.'   # "%."
        return 0 - 1
    var i: i64 = 4
    var n: i32 = 0
    var any: i32 = 0
    while i < line.len and *(line.ptr + i) >= '0' and *(line.ptr + i) <= '9'
        n = n * 10 + ((*(line.ptr + i) as i32) - 48)
        any = 1
        i += 1
    if any == 0
        return 0 - 1
    n

# Mark register `reg` as packed-derived, growing the mark array as needed.
pub fn packed_mark(s: *EmitterState, reg: i32)
    if reg < 0
        return
    if reg >= s.packed_marks_cap
        var cap: i32 = s.packed_marks_cap
        if cap < 64
            cap = 64
        while cap <= reg
            cap = cap * 2
        let old: i32 = s.packed_marks_cap
        let grown: *u8 = realloc(s.packed_marks, cap as i64)
        s.packed_marks = grown
        memzero(grown + old, (cap - old) as i64)
        s.packed_marks_cap = cap
    *(s.packed_marks + reg) = 1

# 1 when `reg` is a pointer derived from a packed struct.
pub fn packed_marked(s: *EmitterState, reg: i32) -> i32
    if reg < 0 or s.packed_marks == null or reg >= s.packed_marks_cap
        return 0
    *(s.packed_marks + reg) as i32

# Start a new fn: no register carries provenance from the previous one.
pub fn packed_marks_reset(s: *EmitterState)
    if s.packed_marks != null and s.packed_marks_cap > 0
        memzero(s.packed_marks, s.packed_marks_cap as i64)

# The legacy text shim for the files not yet ported (AGAST #4695): NUL-terminated
# `c"..."` text, one call per fragment.  New and ported code does not call it:
# it writes whole instructions with `format_into(s, "  %.{r} = add i64 %.{a}, %.{b}\n")`
# (EmitterState.push_bytes, below), whose text is a StrView and whose values are
# interpolated.  ritz1/ARCHITECTURE.md "Emitter style" has the pattern.
pub fn emit_str(s: *EmitterState, text: *u8)
    # AGAST #1625, #3508: every way out of a fn is a `ret`, written from
    # dozens of sites once the return value is computed.  The live owned
    # bindings and temporaries drop, and a registered `defer` runs, there:
    # after the value and before the `ret` (own_before_ret).  A `ret` must
    # therefore start the string it is emitted in.
    if *text == ' '
        if emit_str_is_ret(text) == 1
            let before_ret: fn(*EmitterState) = s.own_before_ret_fn
            before_ret(s)
    var i: i32 = 0
    while *(text + i) != 0
        i += 1
    out_append(s, StrView { ptr: (text), len: (i as i64) })

# AGAST #4666: emit_str for a StrView (`"..."`, no NUL needed), with the
# same `ret` hook.
pub fn emit_sv(s: *EmitterState, text: StrView)
    if text.starts_with("  ret ") or text.starts_with("  ret\n")
        let before_ret: fn(*EmitterState) = s.own_before_ret_fn
        before_ret(s)
    out_append(s, text)

# `text` appended to the IR.  The IR lives in the module's Arena, which has a
# fixed size: a module whose text outgrows it stops here, rather than writing a
# truncated .ll that clang would reject (or worse, accept).
fn out_append(s: *EmitterState, text: StrView)
    if not s.out.push_span(Span<u8> { ptr: text.ptr, len: text.len })
        emit_out_exhausted()

fn emit_out_exhausted()
    eprint("error: ritz1's IR for this module does not fit its arena\n")
    sys_exit(1)

# format_into's sink (LANGUAGE_SPEC §2.6): `format_into(s, "  %.{r} = add {ty} ...")`
# appends to the module's IR, one call per piece of the literal, text or value.
#
# This is the one place IR text becomes IR, so the two hooks emit_str and
# emit_reg used to carry between them live here once:
#   * a piece that starts a `ret` first drops the live owned bindings
#     (own_before_ret; AGAST #1625, #3508);
#   * a register operand, which is the digits right after `%.`, is noted as
#     used by the deferred struct loads (#4461) and, after a `ptr` operand,
#     by the packed-align tracking (#4462), exactly as emit_reg notes it.
impl EmitterState
    pub fn push_bytes(self: @&EmitterState, data: Span<u8>)
        let text: StrView = StrView { ptr: data.ptr, len: data.len }
        let reg: i32 = reg_operand_of(self, text)
        if reg < 0
            emit_sv(self, text)
            return
        let kind: i32 = reg_operand_kind(self, 2)
        dload_note_use(self, reg)
        out_append(self, text)
        reg_operand_after(self, reg, kind)

# `  ret ...` / `  ret\n`: the start of a `ret` instruction.
fn emit_str_is_ret(text: *u8) -> i32
    if *(text + 1) != ' '
        return 0
    if *(text + 2) != 'r'
        return 0
    if *(text + 3) != 'e'
        return 0
    if *(text + 4) != 't'
        return 0
    let c: u8 = *(text + 5)
    if c == ' ' or c == 10
        return 1
    0

# AGAST #3446: every name reaches the IR through here, spelled as LANGUAGE_SPEC
# §11.4 and ritz0 spell it: the first `$` splits the base from its type
# arguments, and every argument, nested ones included, is joined by `_`.
# `Pair$i32$u8` is `Pair$i32_u8`, `Box$Pair$i32$u8` is `Box$Pair_i32_u8`.
#
# Inside ritz1 a mangled name keeps a `$` before every component (the parser
# builds it so), and monomorph splits it by each component's arity
# (split_mangled_args): an argument may itself contain `_` (`my_t`, `StrView`
# never, `tuple_i32_i64` always), so the `_` form cannot be split back.  The
# flattening is therefore one-way and happens only here, on the way out.
pub fn emit_name(s: *EmitterState, name_sv: StrView)
    # AGAST #4462: the source type of `  %.N = getelementptr %<name>` decides
    # whether N is a pointer into packed memory.
    let line: StrView = packed_line(s)
    if line.ends_with(strview_from_cstr(c" = getelementptr %"))
        if struct_is_packed(s.mono.pctx, find_struct(s, name_sv)) == 1
            packed_mark(s, packed_gep_dst(s))
    var name: *u8 = name_sv.ptr
    var len: i32 = name_sv.len as i32
    var i: i32 = 0
    while i < len and *(name + i) != '$'   # '$'
        i += 1
    if i >= len
        s.out.push_span(Span<u8> { ptr: (name), len: (len as i64) as i64 })
        return
    # Up to and including the first `$` as is; every later `$` is `_`.
    s.out.push_span(Span<u8> { ptr: (name), len: (i as i64 + 1) as i64 })
    for j in (i + 1)..len
        let c: u8 = *(name + j)
        if c == '$'
            s.out.push(95)   # '_'
        else
            s.out.push(c)

# `  %.{dst} = getelementptr %<struct>`: the start of a GEP over a named struct
# type, left open for the caller's `, ptr %.{base}, i32 0, ...`.  The name goes
# through emit_name, which marks a GEP over a packed struct (AGAST #4462); a
# format_into piece would not.
pub fn gep_struct_open(s: *EmitterState, dst: i32, struct_name: StrView)
    format_into(s, "  %.{dst} = getelementptr %")
    emit_name(s, struct_name)

# `name` spelled for the IR as emit_name spells it, as a String to interpolate:
# `let g = ir_name(n)` then `format_into(s, "@{g.as_view()}")`.  For the sites
# that are not a struct type behind `getelementptr %` (emit_name's packed
# check, AGAST #4462, stays with emit_name for those).
pub fn ir_name(name: StrView) -> String
    var out: String = string_with_cap(name.len + 1)
    var seen_dollar: bool = false
    for i in 0..name.len
        let c: u8 = name.get(i)
        if c == '$' and seen_dollar
            out.push('_')
        else
            out.push(c)
        if c == '$'
            seen_dollar = true
    out

# AGAST #3257: how many counted errors were printed WITHOUT a file:line:col,
# out of s.error_count.  Since #3445 the emit_ir_error family is located, so
# only the errors that have no source construct to point at count here (in
# emitter.ritz: the multi-dimensional global leak tally, and a source
# `struct StrView` / `Span$u8` of the wrong layout, since a StructDef
# records no position).  main prints its
# "emitted N unlowerable expression(s)" summary only when this is non-zero:
# after a located error it is noise.  emit_module runs once per process.
var g_emit_unlocated: i32 = 0

pub fn emit_unlocated_errors() -> i32
    g_emit_unlocated

# Count `n` unlocated errors, both in s.error_count and in g_emit_unlocated.
pub fn count_unlocated_error(s: *EmitterState, n: i32)
    s.error_count = s.error_count + n
    g_emit_unlocated = g_emit_unlocated + n

# AGAST #1369 — record that the emitter could not lower something.
#
# Every caller used to be a bare `emit_str(s, c"  ; ERROR: ...")` that wrote
# the failure into the IR as a COMMENT and carried on.  A comment is not a
# diagnostic: llvm ignores it, the process exits 0, and the caller links
# whatever came out.  For `unknown identifier` the emitter went on to
# substitute `add i64 0, 0`, so `apply(double, 5)` became a call through a
# null pointer; for `unknown variable` it dropped the store outright and the
# program ran to completion with a stale value.
#
# This keeps the IR comment — it is genuinely useful when reading emitted IR
# by hand — but also prints the message to stderr and counts it, so
# emit_module can return non-zero and main can refuse to write the output.
# The IR comment is deliberately still written FIRST, so a developer dumping
# a failed compile's buffer sees the marker in place.
#
# AGAST #3621: the stderr line is located, `<file>:<line>:<col>: error:
# ritz1 cannot emit: <msg>` (diag.ritz), at `span`: the construct that could
# not be lowered.  It was the one unlocated error ritz1 printed, so it no
# longer counts toward main's "emitted N unlowerable" summary (#3257).
pub fn emit_ir_error(s: *EmitterState, span: SrcSpan, msg: *u8)
    emit_ir_error_begin(s, span, msg)
    emit_str(s, IR_NL)
    eprint_char('\n')
    s.error_count = s.error_count + 1

# AGAST #4666: emit_ir_error for a StrView message.
pub fn emit_ir_error_sv(s: *EmitterState, span: SrcSpan, msg: StrView)
    emit_sv(s, "  ; ERROR: ")
    emit_sv(s, msg)
    emit_str(s, IR_NL)
    diag_error_at(diag_source_file(), span)
    eprints("ritz1 cannot emit: ")
    eprints(msg)
    eprints("\n")
    s.error_count = s.error_count + 1

# Same, for the sites that append a name to the message before the newline.
# The caller follows this with emit_ir_error_end, which counts the error.
pub fn emit_ir_error_begin(s: *EmitterState, span: SrcSpan, msg: *u8)
    emit_str(s, c"  ; ERROR: ")
    emit_str(s, msg)
    diag_error_at(diag_source_file(), span)
    eprints("ritz1 cannot emit: ")
    eprints_cstr(msg)

pub fn emit_ir_error_end(s: *EmitterState, name_sv: StrView)
    var name: *u8 = name_sv.ptr
    var len: i32 = name_sv.len as i32
    emit_name(s, StrView { ptr: (name), len: (len) as i64 })
    emit_str(s, c"'\n")
    var i: i32 = 0
    while i < len
        eprint_char(*(name + i))
        i += 1
    eprints("'\n")
    s.error_count = s.error_count + 1

# Same, for a message followed by an integer (a kind number, say).
pub fn emit_ir_error_kind(s: *EmitterState, span: SrcSpan, msg: *u8, kind: i32)
    emit_ir_error_begin(s, span, msg)
    emit_int(s, kind as i64)
    emit_str(s, IR_NL)
    eprint_int(kind as i64)
    eprint_char('\n')
    s.error_count = s.error_count + 1

# AGAST #2296: EmitterState.ctx_slot_*, saved around a slot.
struct SlotCtx
    name: *u8
    name_len: i32
    set: i32

# Enter the slot of declared type (ty, name) after saving the enclosing one in
# `saved`.  A non-struct slot is still a slot: it hides the enclosing one and
# the fn's return type, so neither leaks into an argument.
pub fn enter_slot_ctx(s: *EmitterState, saved: *SlotCtx, ty: TypeKind, name_sv: StrView)
    var name: *u8 = name_sv.ptr
    var name_len: i32 = name_sv.len as i32
    saved.name = s.ctx_slot_name
    saved.name_len = s.ctx_slot_name_len
    saved.set = s.ctx_slot_set
    s.ctx_slot_set = 1
    s.ctx_slot_name = null
    s.ctx_slot_name_len = 0
    if ty == TypeKind.Struct and name != null and name_len > 0
        s.ctx_slot_name = name
        s.ctx_slot_name_len = name_len

pub fn leave_slot_ctx(s: *EmitterState, saved: *SlotCtx)
    s.ctx_slot_name = saved.name
    s.ctx_slot_name_len = saved.name_len
    s.ctx_slot_set = saved.set

# The struct type the value being emitted lands in: the innermost slot's, or
# outside any slot (a `return`, a tail) the fn's return type.  null when
# neither is a struct.
pub fn slot_struct_name(s: *EmitterState, out_len: *i32) -> *u8
    if s.ctx_slot_set == 1
        *out_len = s.ctx_slot_name_len
        return s.ctx_slot_name
    *out_len = s.ret_type_name_len
    return s.ret_type_name

# AGAST #1509: a multi-dimensional array use ritz1 does not lower, as
# `<file>:<line>:<col>: error: <msg>`.  Counts like emit_ir_error, so the
# driver refuses to write the output.
pub fn emit_nd_error(s: *EmitterState, line: i32, col: i32, msg: *u8)
    emit_nd_error_begin(s, line, col)
    eprints_cstr(msg)
    eprints("\n")

# AGAST #4666: emit_nd_error for a StrView message.
pub fn emit_nd_error_sv(s: *EmitterState, line: i32, col: i32, msg: StrView)
    emit_nd_error_begin(s, line, col)
    eprints(msg)
    eprints("\n")

# AGAST #1295: emit_nd_error for a message the caller finishes itself (it
# prints the rest, then a newline): `<file>:<line>:<col>: error: `, counted.
pub fn emit_nd_error_begin(s: *EmitterState, line: i32, col: i32)
    emit_str(s, c"  ; ERROR\n")
    diag_error_at(diag_source_file(), diag_span(line, col))
    s.error_count = s.error_count + 1

# AGAST #1813 — where the emitter is, for fatal capacity errors: the input
# file and the function being emitted (set by emit_fn).  The file itself
# moved to diag (AGAST #4319), so a check module can read it without
# importing the emitter; these names stay as wrappers for emitter call sites.
var g_emit_fn: *FnDef = null

pub fn emitter_set_source_file(path: *u8)
    diag_set_source_file(path)

pub fn emitter_set_current_fn(f: *FnDef)
    g_emit_fn = f

pub fn emitter_source_file() -> *u8
    diag_source_file()

pub fn emitter_current_fn() -> *FnDef
    g_emit_fn

# AGAST #1869 — EmitterState.fn_assert_kind: where `assert` may appear.
const ASSERT_FN_PLAIN: i32 = 0    # not allowed
const ASSERT_FN_TEST: i32 = 1     # [[test]]: records call sites for helpers
const ASSERT_FN_HELPER: i32 = 2   # [[test_helper]]: reports the test's call site

# A fixed ritz1 table is full.  Print a located error and exit: carrying on
# without the entry is exactly the silent miscompile this replaces, and the
# driver has not written the output yet.
#
# `<file>:<line>: error: in fn 'f': <what> ...`.  A FnDef records its line
# but no column, so this is the one emitter error diag_loc can't print
# (#3445): it would have to invent the column.
fn emit_fatal_limit(what: *u8, limit: i32)
    let file: *u8 = diag_source_file()
    if file != null
        eprints_cstr(file)
    else
        eprints("<input>")
    # Through a local: ritz1 cannot lower a member read on a global pointer.
    let f: *FnDef = g_emit_fn
    if f != null
        eprint_char(':')
        eprint("{f.line as i64}: error: in fn '")
        let shown: StrView = fn_display_name(f)
        eprint_bytes(StrView { ptr: (shown.ptr), len: (shown.len as i32) as i64 })
        eprints("': ")
    else
        eprints(": error: ")
    eprints_cstr(what)
    eprint(" (ritz1's limit is {limit as i64})\n")
    sys_exit(1)

# n in decimal, through ritzlib.fmt. A hand-written `'-' then 0 - n` here
# recursed forever on i64::MIN (0 - n wraps to itself), so a u64 literal
# 9223372036854775808 / 0x8000000000000000 hung ritz1 (AGAST #2129).
pub fn emit_int(s: *EmitterState, n: i64)
    var buf: [20]u8
    let digits: StrView = fmt_i64_into(@buf, n)
    for i in 0..digits.len
        s.out.push(buf[i])

pub fn emit_reg(s: *EmitterState, reg: i32)
    # AGAST #4461: any use of a deferred load's register means the copy
    # rewrite cannot fire; the load is written back at fn end.
    dload_note_use(s, reg)
    let kind: i32 = reg_operand_kind(s, 0)
    emit_str(s, c"%.")
    emit_int(s, reg as i64)
    reg_operand_after(s, reg, kind)

# What a register operand about to be written means to the packed-align
# tracking (AGAST #4462): REG_PLAIN, or after a `, ptr ` the base of a
# getelementptr (REG_GEP_BASE) or the pointer of a load/store (REG_ACCESS_PTR).
# Decided from the line so far, before the register's text is appended;
# `written` is how many bytes of that text (`%.`) are already on the line.
fn reg_operand_kind(s: *EmitterState, written: i64) -> i32
    let whole: StrView = packed_line(s)
    reg_operand_kind_of(StrView { ptr: whole.ptr, len: whole.len - written })

# After `%.reg` is written: a packed-derived register keeps its provenance
# through a GEP and is accessed `align 1`.
fn reg_operand_after(s: *EmitterState, reg: i32, kind: i32)
    if kind == REG_PLAIN or packed_marked(s, reg) == 0
        return
    if kind == REG_GEP_BASE
        # `getelementptr ... ptr %.reg`: the result inherits provenance.
        packed_mark(s, packed_gep_dst(s))
    else
        out_append(s, ", align 1")

# The register `text` names when it is the digits of a register operand, i.e.
# the IR so far ends in `%.`; else -1.
fn reg_operand_of(s: *EmitterState, text: StrView) -> i32
    let reg: i32 = register_digits(text)
    if reg < 0
        return reg
    let have: i64 = s.out.data.len
    if have < 2 or *(s.out.data.data + (have - 2)) != '%' or *(s.out.data.data + (have - 1)) != '.'
        return 0 - 1
    reg



pub fn next_reg(s: *EmitterState) -> i32
    let r: i32 = s.reg_counter
    s.reg_counter = s.reg_counter + 1
    r

# =============================================================================
# Deferred large-struct loads (AGAST #4461)
# =============================================================================
#
# #1732's copy rewrite was a text pass over the finished body.  The emitter
# has the same facts where it emits them: a whole-struct load of an
# sret-sized type and the store that consumes it.  This holds such a load's
# line out of the body until the next emission decides:
#
#   * a struct store of the same type and register, with nothing emitted in
#     between, becomes `call void @__ritz_sret_copy(ptr dst, ptr src, i64 n)`;
#   * any use of the register, or any other emission in between, keeps the
#     load, which splice_deferred_struct_loads writes back at its offset;
#   * neither: it is a dead load (e.g. the one every sret call used to leave
#     behind, #3952) and is dropped.
#
# The load site still calls next_reg, so register numbering -- and the gaps
# the dropped loads leave -- are exactly what the old pass produced.

fn dload_note_use(s: *EmitterState, reg: i32)
    var i: i32 = 0
    while i < s.dload_count
        let r: *DeferredLoad = s.dloads + (i as i64)
        if r.state != DLOAD_DROPPED and r.reg == reg
            r.used = 1
            return
        i += 1

# --- line scanners ----------------------------------------------------------
#
# The packed-align pass (#1918) in emitter.ritz and the deferred-load check
# below both need to look at emitted text a line at a time.  These were the
# deleted copy-scan module's; the copy pass is gone, so they are private to
# the emitter's own two uses (AGAST #4461).

# Offset of the first `ch` in `p_sv[from..len)`, or -1.
pub fn scan_find(p_sv: StrView, from: i64, ch: u8) -> i64
    var p: *u8 = p_sv.ptr
    var len: i64 = p_sv.len
    var i: i64 = from
    while i < len
        if *(p + i) == ch
            return i
        i += 1
    0 - 1

# Length of the line starting at `p` (up to `end`), including its '\n'.
pub fn scan_line_len(p: *u8, end: *u8) -> i64
    var q: *u8 = p
    var len: i64 = 0
    while q < end and *q != 10
        q = q + 1
        len += 1
    if q < end
        len += 1
    len

# 1 when the line cannot write memory: an assignment `  %x = <op>` whose op
# is not a call / invoke / atomic RMW, and not an ordered load.  Everything
# else -- `store`, call, branch, label, comment -- is treated as a possible
# write.  This is #1732's test, kept because a deferred load may be rewritten
# only when nothing emitted after it can change the source bytes.
fn dload_cannot_write(p_sv: StrView) -> i32
    var p: *u8 = p_sv.ptr
    var len: i64 = p_sv.len
    if not (StrView { ptr: (p), len: (len) }).starts_with("  %")
        return 0
    let sp: i64 = scan_find(StrView { ptr: (p), len: (len) }, 3, 32)
    if sp < 0 or not (StrView { ptr: (p + sp), len: (len - sp) }).starts_with(" = ")
        return 0
    let op: *u8 = p + sp + 3
    let oplen: i64 = len - sp - 3
    if (StrView { ptr: (op), len: (oplen) }).starts_with("call ") or (StrView { ptr: (op), len: (oplen) }).starts_with("tail call ")
        return 0
    if (StrView { ptr: (op), len: (oplen) }).starts_with("invoke ") or (StrView { ptr: (op), len: (oplen) }).starts_with("atomicrmw ")
        return 0
    if (StrView { ptr: (op), len: (oplen) }).starts_with("cmpxchg ")
        return 0
    if (StrView { ptr: (op), len: (oplen) }).starts_with("load atomic ") or (StrView { ptr: (op), len: (oplen) }).starts_with("load volatile ")
        return 0
    1

# 1 when every line emitted since offset `from` cannot write memory.
pub fn dload_region_cannot_write(s: *EmitterState, from: i64) -> i32
    if from >= s.out.data.len
        return 1
    var p: *u8 = s.out.data.data + from
    let end: *u8 = s.out.data.data + s.out.data.len
    while p < end
        let ll: i64 = scan_line_len(p, end)
        if dload_cannot_write(StrView { ptr: (p), len: (ll) }) == 0
            return 0
        p = p + ll
    1

fn dload_dup(p: *u8, n: i32) -> *u8
    if p == null or n <= 0
        return null
    let d: *u8 = malloc(n as i64)
    memcpy(d, p, n as i64)
    d

pub fn dload_add(s: *EmitterState, reg: i32, ty_sv: StrView, src_reg: i32, src_name: *u8, src_name_len: i32)
    if s.dload_count >= s.dload_cap
        var cap: i32 = 8
        if s.dload_cap > 0
            cap = s.dload_cap * 2
        s.dloads = realloc(s.dloads as *u8, (cap as i64) * sizeof(DeferredLoad)) as *DeferredLoad
        s.dload_cap = cap
    var ty: *u8 = ty_sv.ptr
    var ty_len: i32 = ty_sv.len as i32
    let r: *DeferredLoad = s.dloads + (s.dload_count as i64)
    r.reg = reg
    r.off = s.out.data.len
    r.src_reg = src_reg
    r.src_name = dload_dup(src_name, src_name_len)
    r.src_name_len = src_name_len
    r.ty = dload_dup(ty, ty_len)
    r.ty_len = ty_len
    r.state = DLOAD_PENDING
    r.used = 0
    s.dload_count = s.dload_count + 1

# splice_entry_allocas inserted `n` bytes at body_start: every deferred line
# moved with the body.
pub fn defer_loads_shift(s: *EmitterState, n: i64)
    var i: i32 = 0
    while i < s.dload_count
        let r: *DeferredLoad = s.dloads + (i as i64)
        r.off = r.off + n
        i += 1

# The function body is complete: write each kept load back at its offset,
# drop the rest, and forget the fn.
pub fn splice_deferred_struct_loads(s: *EmitterState)
    if s.dload_count <= 0
        return
    # Whatever is still pending was never paired with a store: dead if no
    # reader, kept (written back) if one.
    var j: i32 = 0
    while j < s.dload_count
        let r: *DeferredLoad = s.dloads + (j as i64)
        if r.state == DLOAD_PENDING
            if r.used == 0
                r.state = DLOAD_DROPPED
            else
                r.state = DLOAD_KEEP
        j += 1
    var i: i32 = 0
    var shift: i64 = 0
    while i < s.dload_count
        let r: *DeferredLoad = s.dloads + (i as i64)
        if r.state == DLOAD_KEEP
            # Render through the ordinary emitters into a scratch buffer, so
            # the line is spelled exactly as the load site spells it.
            var line: String = string_new()
            let saved: *String = s.out
            s.out = @line
            emit_str(s, c"  ")
            emit_reg(s, r.reg)
            emit_str(s, c" = load %")
            emit_name(s, StrView { ptr: (r.ty), len: (r.ty_len) as i64 })
            emit_str(s, IR_PTR_SEP)
            if r.src_reg >= 0
                emit_reg(s, r.src_reg)
            else
                emit_str(s, c"@")
                emit_name(s, StrView { ptr: (r.src_name), len: (r.src_name_len) as i64 })
            emit_str(s, IR_NL)
            s.out = saved
            let at: i64 = r.off + shift
            out_insert(s, at, line.as_view())
            shift = shift + line.len()
            # `line` drops at the end of this iteration (AGAST #2159): its
            # buffer is freed once, by the compiler.
        i += 1
    var k: i32 = 0
    while k < s.dload_count
        let r2: *DeferredLoad = s.dloads + (k as i64)
        if r2.ty != null
            free(r2.ty)
        if r2.src_name != null
            free(r2.src_name)
        k += 1
    s.dload_count = 0

# =============================================================================
# Entry-block alloca buffer (AGAST #4460)
# =============================================================================
#
# Every fixed-size alloca goes to the entry block: a non-entry alloca is a
# dynamic alloca to LLVM and is never reclaimed until the fn returns, so one
# inside a loop is a fresh stack slot per iteration (#1685).  That used to be
# a text pass over the finished body (hoist_entry_allocas); now the emitter
# writes each static alloca into this per-fn buffer as it emits it, and
# splice_entry_allocas (emitter.ritz) inserts the buffer after `entry:`.  The
# order is emission order, exactly what the old stable partition produced.
#
# A runtime-sized ALLOCA — `alloca i8, i64 %.N` from __builtin_alloca(n) — is
# NOT buffered: its size register is defined later than `entry:` and its
# per-call semantics are the point.

# Record where the next alloca line starts in the entry buffer and the source
# span in force, so frame_limit can still name/bound the largest alloca.
pub fn entry_alloca_mark(s: *EmitterState)
    if s.ea_count >= s.ea_cap
        var cap: i32 = 64
        if s.ea_cap > 0
            cap = s.ea_cap * 2
        s.ea_marks = realloc(s.ea_marks as *u8, (cap as i64) * sizeof(FrameMark)) as *FrameMark
        s.ea_cap = cap
    let m: *FrameMark = s.ea_marks + (s.ea_count as i64)
    m.off = s.entry_allocas.data.len
    m.line = s.fm_line
    m.col = s.fm_col
    s.ea_count = s.ea_count + 1

# Begin a static alloca whose type the caller emits itself (a compound array
# or struct type through emit_llvm_type_struct and friends): redirect the
# emitter to the entry buffer, allocate the register, and write the
# `  %.{r} = alloca ` prefix.  The caller writes the type and the line end,
# then calls entry_alloca_end.
pub fn entry_alloca_begin(s: *EmitterState) -> i32
    entry_alloca_mark(s)
    s.entry_out_saved = s.out
    s.out = s.entry_allocas
    let r: i32 = next_reg(s)
    emit_str(s, IR_INDENT)
    emit_reg(s, r)
    emit_str(s, IR_ALLOCA)
    r

pub fn entry_alloca_end(s: *EmitterState)
    s.out = s.entry_out_saved

# A whole static alloca line whose LLVM type is a C string, with an optional
# `  ; <comment>` suffix (null for none).
pub fn entry_alloca(s: *EmitterState, ty: *u8, comment: *u8) -> i32
    entry_alloca_mark(s)
    if comment == null
        ir_alloca(s.entry_allocas, @s.reg_counter, ty)
    else
        ir_alloca_c(s.entry_allocas, @s.reg_counter, ty, comment)

# The same line for a register the caller already took with next_reg.  The
# sites that allocate early (one slot for every branch of a type switch, say)
# keep their next_reg exactly where it was; only the line's destination moves.
pub fn entry_alloca_reg(s: *EmitterState, r: i32, ty: *u8, comment: *u8)
    entry_alloca_mark(s)
    if comment == null
        ir_alloca_at(s.entry_allocas, r, ty)
    else
        ir_alloca_at_c(s.entry_allocas, r, ty, comment)

# entry_alloca_begin for a register already taken: redirect, write the
# `  %.{r} = alloca ` prefix with no new register, then entry_alloca_reg_end.
pub fn entry_alloca_reg_begin(s: *EmitterState, r: i32)
    entry_alloca_mark(s)
    s.entry_out_saved = s.out
    s.out = s.entry_allocas
    emit_str(s, IR_INDENT)
    emit_reg(s, r)
    emit_str(s, IR_ALLOCA)

# entry_alloca_reg_begin when the type starts with a bare struct name
# (`emit_name` emits no `%`): the prefix is `  %.{r} = alloca %`.
pub fn entry_alloca_reg_begin_named(s: *EmitterState, r: i32)
    entry_alloca_mark(s)
    s.entry_out_saved = s.out
    s.out = s.entry_allocas
    emit_str(s, IR_INDENT)
    emit_reg(s, r)
    emit_str(s, IR_ALLOCA_NAMED)

pub fn entry_alloca_reg_end(s: *EmitterState)
    s.out = s.entry_out_saved

# AGAST #1335 — the value of `current_label` inside a function's entry block.
#
# The entry block is unlabelled (it is named `entry:`, not `L<n>:`), and
# `label_counter` restarts at 0 for every function, so labels are only unique
# WITHIN a function.  `current_label` used to be left holding the PREVIOUS
# function's last opened block.  Entry-block values were then tagged by
# set_last_expr with that stale label, and whenever it collided with a real
# label of the current function (e.g. an if-without-else's merge block),
# last_expr_here falsely reported the entry-block value as "defined here" —
# so the implicit return depended on the label count of whichever function
# happened to be emitted just before.
#
# next_label never returns a negative number, so -1 can never equal any block
# opened by begin_block: an entry-block value only matches while we are still
# in the entry block.  emit_fn, emit_method and emit_module set this at every
# function boundary.  It is never passed to emit_label/begin_block.
# The only place a stale label still shows is a dead merge block, so the
# guard is an IR test: ritz0/test_ritz1_entry_block_label.py (AGAST #3526).
const ENTRY_BLOCK_LABEL: i32 = -1

pub fn next_label(s: *EmitterState) -> i32
    let l: i32 = s.label_counter
    s.label_counter = s.label_counter + 1
    l

pub fn emit_label(s: *EmitterState, label: i32)
    emit_str(s, c"L")
    emit_int(s, label as i64)

# ritz-task-1267 — Open a new basic block.
#
# This is the ONLY sanctioned way to start a basic block.  Emitting
# `L<n>:` by hand (emit_label + ":\n") is a bug: `s.current_label` is the
# emitter's insertion point, and every PHI predecessor label we write is
# derived from it.  If a construct opens a block without refreshing
# `s.current_label`, an enclosing IF/short-circuit emitter later names a
# *stale* block as a PHI predecessor — producing IR where the phi entries
# don't match the CFG, and where the incoming value doesn't dominate its
# use.
#
# This was #195 (StmtKind.Break/CONTINUE leaked a stale label) and again
# #1267 (StmtKind.While / StmtKind.Loop / StmtKind.For / StmtKind.Match / assert never
# refreshed it at their exit label — so an `if ... else <loop>` whose
# else-arm ended after the loop attributed the merge PHI to the loop's
# last *body* block instead of the loop-exit block).  Keeping the
# "emit the label" and "record the insertion point" steps welded together
# makes that whole class of bug unrepresentable.
pub fn begin_block(s: *EmitterState, label: i32)
    emit_label(s, label)
    emit_str(s, c":\n")
    s.current_label = label

# ritz-task-1309 — the three sanctioned accessors for `last_expr_reg`.
#
# Nothing outside these should assign `last_expr_reg` directly: the register
# and the label that defines it must move together or the pair goes stale,
# which is the whole defect these exist to prevent.

# Record `reg` as the last expression value, produced by the block we are
# currently emitting into.
const LAST_EXPR_UNKNOWN: i32 = 0
const LAST_EXPR_I64: i32 = 1
const LAST_EXPR_PTR: i32 = 2

pub fn set_last_expr(s: *EmitterState, reg: i32)
    s.last_expr_reg = reg
    s.last_expr_label = s.current_label
    s.last_expr_model = LAST_EXPR_UNKNOWN

# AGAST #2950: an `if` / `match` statement's phi, `ptr` when `ptr_ty` is 1.
pub fn set_last_expr_phi(s: *EmitterState, reg: i32, ptr_ty: i32)
    set_last_expr(s, reg)
    s.last_expr_model = LAST_EXPR_I64
    if ptr_ty == 1
        s.last_expr_model = LAST_EXPR_PTR

# Drop the tracked value.  Used where control flow makes any previous value
# unavailable at the new insertion point (break/continue dead blocks, and the
# start of each `if` branch).
pub fn clear_last_expr(s: *EmitterState)
    s.last_expr_reg = 0
    s.last_expr_label = s.current_label
    s.last_expr_model = LAST_EXPR_UNKNOWN

# Read the last expression value, but ONLY if it was defined in the block we
# are currently emitting into; 0 otherwise.
#
# This is the guard for phi incoming values.  A phi entry `[ %v, %L ]` requires
# %v to be available along the edge from L, and equality of defining block and
# predecessor block is the conservative way to guarantee that without a
# dominator tree.  A value produced in a nested block that the insertion point
# has already left is reported as "no value", which correctly suppresses the
# phi rather than emitting a dominance-violating one.
pub fn last_expr_here(s: *EmitterState) -> i32
    if s.last_expr_label != s.current_label
        return 0
    return s.last_expr_reg

# The idx-th entry of the locals table.  Indexes through a local copy of the
# pointer field: ritz1 cannot lower `@s.locals[idx]` on a pointer field.
pub fn local_at(s: *EmitterState, idx: i32) -> *LocalVar
    let base: *LocalVar = s.locals
    return @base[idx]

# Allocate the locals table (emit_module).
pub fn locals_init(s: *EmitterState, cap: i32)
    s.locals = malloc((cap as i64) * sizeof(LocalVar)) as *LocalVar
    s.locals_cap = cap
    s.local_count = 0
    s.fm_cap = 256   # AGAST #3739: frame_limit's marks and slots
    s.fm = malloc((s.fm_cap as i64) * sizeof(FrameMark)) as *FrameMark
    s.fs_cap = cap
    s.fs = malloc((s.fs_cap as i64) * sizeof(FrameSlot)) as *FrameSlot
    frame_begin_fn(s, 0, 0)

# AGAST #3739: forget the last fn's marks and slots; until a statement or
# expression says otherwise, the fn's allocas are at line:col (its `fn`).
pub fn frame_begin_fn(s: *EmitterState, line: i32, col: i32)
    s.fm_count = 0
    s.fs_count = 0
    s.fm_line = 0
    s.fm_col = 0
    frame_mark(s, line, col)

# AGAST #3739: the emitter is at line:col from here on in s.out.  A mark at
# the offset of the previous one replaces it: nothing was emitted under it.
pub fn frame_mark(s: *EmitterState, line: i32, col: i32)
    s.fm_line = line
    s.fm_col = col
    let off: i64 = s.out.data.len
    if s.fm_count > 0
        let last: *FrameMark = s.fm + ((s.fm_count - 1) as i64)
        if last.off == off
            last.line = line
            last.col = col
            return
    if s.fm_count >= s.fm_cap
        s.fm_cap = s.fm_cap * 2
        s.fm = realloc(s.fm as *u8, (s.fm_cap as i64) * sizeof(FrameMark)) as *FrameMark
    let m: *FrameMark = s.fm + (s.fm_count as i64)
    m.off = off
    m.line = line
    m.col = col
    s.fm_count = s.fm_count + 1

# ritz-task-193 — Resolve `name` to an index into `s.locals[]` using the
# per-fn HashMap (fnv1a hash of name bytes).  Falls back to a from-end
# linear scan to handle two cases the map can't:
#   1. Stale map entry: emit_match_arm_body's scope rollback drops bindings
#      from `locals[]` (by decrementing `local_count`) and rebuilds the map,
#      but during the inner-arm window the map already has the inner binding
#      pointing past the rolled-back count.
#   2. Hash collision: FNV1a-64 collisions are rare but not impossible —
#      validate the stored entry's bytes match before trusting the index.
# Both fallbacks fire rarely; the map handles >99% of lookups in O(1).
# Returns -1 when the name isn't bound in any active scope.
#
# Stores `idx + 1` in the map so hashmap_i64_get's 0-on-miss semantics
# unambiguously mean "not found" (idx == 0 is a valid first-local index).
# Avoids the contains+get double-probe pattern.
pub fn find_local_idx(s: *EmitterState, name_sv: StrView) -> i32
    var name: *u8 = name_sv.ptr
    var len: i32 = name_sv.len as i32
    # Fast path: single-probe HashMap lookup with collision check.
    let key: i64 = fnv1a_str(Span<u8> { ptr: (name), len: (len) as i64 }) as i64
    let stored: i64 = s.local_map.get(key).unwrap_or(0)
    if stored > 0
        let idx: i32 = (stored - 1) as i32
        if idx >= 0 and idx < s.local_count
            let loc: *LocalVar = local_at(s, idx)
            if name_eq(StrView { ptr: (loc.name), len: (loc.name_len) as i64 }, name_sv) == 1
                return idx
    # Fallback: linear scan from end (innermost scope wins).
    var i: i32 = s.local_count - 1
    while i >= 0
        let loc: *LocalVar = local_at(s, i)
        if name_eq(StrView { ptr: (loc.name), len: (loc.name_len) as i64 }, name_sv) == 1
            return i
        i = i - 1
    return -1

pub fn find_local(s: *EmitterState, name_sv: StrView) -> i32
    var name: *u8 = name_sv.ptr
    var len: i32 = name_sv.len as i32
    let idx: i32 = find_local_idx(s, StrView { ptr: (name), len: (len) as i64 })
    if idx < 0
        return -1
    let loc: *LocalVar = local_at(s, idx)
    return loc.reg

pub fn find_local_type(s: *EmitterState, name_sv: StrView) -> TypeKind
    var name: *u8 = name_sv.ptr
    var len: i32 = name_sv.len as i32
    let idx: i32 = find_local_idx(s, StrView { ptr: (name), len: (len) as i64 })
    if idx < 0
        return TypeKind.Unknown
    let loc: *LocalVar = local_at(s, idx)
    return lv_var_type(loc)

pub fn find_local_pointee_type(s: *EmitterState, name_sv: StrView) -> TypeKind
    var name: *u8 = name_sv.ptr
    var len: i32 = name_sv.len as i32
    let idx: i32 = find_local_idx(s, StrView { ptr: (name), len: (len) as i64 })
    if idx < 0
        return TypeKind.I64  # Default to i64
    let loc: *LocalVar = local_at(s, idx)
    return lv_pointee_type(loc)

# Find the struct type name for a local variable
pub fn find_local_struct_name(s: *EmitterState, name_sv: StrView) -> *LocalVar
    var name: *u8 = name_sv.ptr
    var len: i32 = name_sv.len as i32
    let idx: i32 = find_local_idx(s, StrView { ptr: (name), len: (len) as i64 })
    if idx < 0
        return null
    return local_at(s, idx)

# AGAST #1644: 1 when emit_expr(e) yields a `ptr` register rather than the
# i64 of ritz1's value model.  A TypeKind.MutRef local (`x: @&T`) loads as
# `ptr`, so the `*x` read must not inttoptr it, and a `*T` (i64) param must
# ptrtoint it.  `@&v` (OpKind.AddrMut) is a `ptr` too.
pub fn expr_is_ptr_valued(s: *EmitterState, e: *Expr) -> i32
    if e == null
        return 0
    if e.kind == ExprKind.Unary and e.op == OpKind.AddrMut
        return 1
    # AGAST #1754: `v as @&T` yields a `ptr` (see the ExprKind.Cast arm).
    if e.kind == ExprKind.Cast and e.type_kind == TypeKind.MutRef
        return 1
    # AGAST #2950: an if / match whose every value arm is one has a `ptr` phi.
    if e.kind == ExprKind.If or e.kind == ExprKind.Match
        return arms_ptr_valued(s, e.args as *MatchArm)
    return deref_operand_is_ptr(s, e)

# AGAST #2950: 1 when the value arm `e` yields a `ptr`.  A `c` with `c:& C`
# (C a struct) reads the referent (#2288), so it is no `ptr` here.
pub fn arm_value_is_ptr(s: *EmitterState, e: *Expr) -> i32
    if e != null and e.kind == ExprKind.Ident
        let loc: *LocalVar = find_local_struct_name(s, StrView { ptr: (e.ident_ptr), len: (e.ident_len) as i64 })
        if loc != null and lv_is_lent(loc) == 1 and lv_var_type(loc) == TypeKind.MutRef and lv_pointee_type(loc) == TypeKind.Struct
            return 0
    expr_is_ptr_valued(s, e)

# AGAST #2950: the phi of an if / match is a `ptr` when every arm with a value
# yields one (`@&x`, an `@&T` local), and i64 otherwise.  Asked in the scope
# the if / match sits in, before its arms are emitted and by whoever reads its
# value after, so both see the same answer.  An arm can only know more (its
# own `let`, which no name reuses): an `@&` arm in an i64 phi is converted in
# its block (emit_match_arm_body).
pub fn arms_ptr_valued(s: *EmitterState, arms: *MatchArm) -> i32
    var n: i32 = 0
    var a: *MatchArm = arms
    while a != null
        if a.is_pass == 0 and a.body != null
            if arm_value_is_ptr(s, a.body) == 0
                return 0
            n = n + 1
        a = a.next
    (n > 0) as i32

# AGAST #1652/#1672: bring `reg` (the value emit_expr(e) produced) into the
# i64 value model.  A `*T` slot -- `let p: *T = v`, `p = v`, `return v`,
# `x.f = v`, `v as *T` -- holds i64, but `@&v` and an `@&T` local yield
# `ptr`, so those get a ptrtoint.  Any other value is returned unchanged.
pub fn ptr_value_to_i64(s: *EmitterState, e: *Expr, reg: i32) -> i32
    if expr_is_ptr_valued(s, e) == 0
        return reg
    let r: i32 = next_reg(s)
    emit_str(s, IR_INDENT)
    emit_reg(s, r)
    emit_str(s, c" = ptrtoint ptr ")
    emit_reg(s, reg)
    emit_str(s, c" to i64  ; #1652 @&T->*T\n")
    return r

# AGAST #1754: the inverse -- bring `reg` into an `@&T` (`ptr`) slot.  A
# `*T` value / `-> @&T` call result is i64 and gets an inttoptr; a value
# expr_is_ptr_valued already reports as `ptr` is returned unchanged.
pub fn i64_value_to_ptr(s: *EmitterState, e: *Expr, reg: i32) -> i32
    if expr_is_ptr_valued(s, e) == 1
        return reg
    let r: i32 = next_reg(s)
    emit_str(s, IR_INDENT)
    emit_reg(s, r)
    emit_str(s, IR_INTTOPTR)
    emit_reg(s, reg)
    emit_str(s, c" to ptr  ; #1754 *T->@&T\n")
    return r

# ptr_value_to_i64, but only when the destination slot is i64-lowered
# pointer: `*T` / `**T`, or `@T` (TypeKind.Ref, i64 too -- AGAST #1754); any
# other slot type gets `reg` back unchanged.
pub fn ptr_slot_value(s: *EmitterState, slot_type: TypeKind, e: *Expr, reg: i32) -> i32
    if slot_type != TypeKind.Ptr and slot_type != TypeKind.PtrPtr and slot_type != TypeKind.Ref
        return reg
    return ptr_value_to_i64(s, e, reg)

# AGAST #2391: i64_value_to_ptr, but only for an `@&T` (TypeKind.MutRef, `ptr`)
# slot -- a tail `id(p)` or `self` in a `-> @&T` fn is i64 until here.
pub fn mut_ref_slot_value(s: *EmitterState, slot_type: TypeKind, e: *Expr, reg: i32) -> i32
    if slot_type != TypeKind.MutRef
        return reg
    return i64_value_to_ptr(s, e, reg)

# The j-th expression of an argument list (null past the end).
pub fn nth_arg(args: *Expr, j: i32) -> *Expr
    var a: *Expr = args
    var k: i32 = 0
    while k < j and a != null
        a = a.next
        k = k + 1
    return a

# AGAST #2972: the `h:& T` param `e` names when T is an integer or `bool`,
# or null.  bind_scalar_borrow_param binds it as a plain T local whose slot is
# the caller's T, so `*h` is `h`.  Only such a param is a TypeKind.Bool local.
pub fn lent_scalar_ident(s: *EmitterState, e: *Expr) -> *LocalVar
    if e == null or e.kind != ExprKind.Ident
        return null
    let loc: *LocalVar = find_local_struct_name(s, StrView { ptr: (e.ident_ptr), len: (e.ident_len) as i64 })
    if loc == null
        return null
    if lv_var_type(loc) == TypeKind.Bool
        return loc
    if lv_is_lent(loc) == 1 and is_borrow_scalar_kind(lv_var_type(loc)) == 1
        return loc
    return null

# AGAST #2290: the `a:& [N]T` param `e` names, of any rank, or null.  It's an
# array local whose slot is the array behind the borrow.
pub fn lent_array_ident(s: *EmitterState, e: *Expr) -> *LocalVar
    if e == null or e.kind != ExprKind.Ident
        return null
    let loc: *LocalVar = find_local_struct_name(s, StrView { ptr: (e.ident_ptr), len: (e.ident_len) as i64 })
    if loc == null or lv_var_type(loc) != TypeKind.Array or lv_is_lent(loc) == 0
        return null
    return loc

# AGAST #2321: the `p: *[N]T` / `@[N]T` / `@&[N]T` local called `name`, or null: a
# base whose `p[i]` is element i of the array behind it, stride T.  `a:& [N]T`
# isn't one: it's an array local, and indexes as one.
pub fn array_ptr_named(s: *EmitterState, name_sv: StrView) -> *LocalVar
    var name: *u8 = name_sv.ptr
    var len: i32 = name_sv.len as i32
    let loc: *LocalVar = find_local_struct_name(s, StrView { ptr: (name), len: (len) as i64 })
    if loc == null or lv_pointee_type(loc) != TypeKind.Array or lv_pointee_array_size(loc) <= 0
        return null
    if lv_var_type(loc) != TypeKind.Ptr and lv_var_type(loc) != TypeKind.Ref and lv_var_type(loc) != TypeKind.MutRef
        return null
    return loc

# The array_ptr_named local that `e` names, or null.
pub fn array_ptr_index_base(s: *EmitterState, e: *Expr) -> *LocalVar
    if e == null or e.kind != ExprKind.Ident
        return null
    return array_ptr_named(s, StrView { ptr: (e.ident_ptr), len: (e.ident_len) as i64 })

pub fn deref_operand_is_ptr(s: *EmitterState, e: *Expr) -> i32
    if e == null or e.kind != ExprKind.Ident
        return 0
    let loc: *LocalVar = find_local_struct_name(s, StrView { ptr: (e.ident_ptr), len: (e.ident_len) as i64 })
    if loc != null and lv_var_type(loc) == TypeKind.MutRef
        return 1
    # AGAST #1554: and so does a `var g: @&S` global; `*g` inttoptr'd the ptr.
    if loc == null
        let glob: *GlobalVarDef = find_global(s, StrView { ptr: (e.ident_ptr), len: (e.ident_len) as i64 })
        if glob != null and glob.var_type == TypeKind.MutRef
            return 1
    # AGAST #2290: `a:& [N]T` reads as the borrow's `ptr` (emit_expr_ident).
    if lent_array_ident(s, e) != null
        return 1
    return 0

# ritz-task-193 — rebuild `local_map` from the current `locals[0..local_count]`.
# Called by emit_match_arm_body after `local_count` is rolled back to drop
# arm-scoped bindings; without this rebuild the map would still hold the
# inner binding's index (now past the count) for the entire fn body, costing
# us the fast-path on every subsequent lookup of that name.
pub fn rebuild_local_map(s: *EmitterState)
    s.local_map.clear()
    var i: i32 = 0
    while i < s.local_count
        let loc: *LocalVar = local_at(s, i)
        let key: i64 = fnv1a_str(Span<u8> { ptr: (loc.name), len: (loc.name_len) as i64 }) as i64
        # Store `i + 1` so 0 unambiguously means miss in find_local_idx.
        # Insert in order so later (innermost) bindings overwrite earlier
        # (outer) ones — matches the linear-scan-from-end semantics.
        s.local_map.insert(key, (i + 1) as i64)
        i = i + 1

pub fn add_local(s: *EmitterState, name_sv: StrView, reg: i32, var_type: TypeKind)
    var name: *u8 = name_sv.ptr
    var len: i32 = name_sv.len as i32
    add_local_full(s, StrView { ptr: (name), len: (len) as i64 }, reg, var_type, StrView { ptr: (null), len: (0) as i64 }, TypeKind.I64, 0, TypeKind.Void)

pub fn add_local_ptr(s: *EmitterState, name_sv: StrView, reg: i32, var_type: TypeKind, pointee: TypeKind)
    var name: *u8 = name_sv.ptr
    var len: i32 = name_sv.len as i32
    add_local_full(s, StrView { ptr: (name), len: (len) as i64 }, reg, var_type, StrView { ptr: (null), len: (0) as i64 }, pointee, 0, TypeKind.Void)

pub fn add_local_struct(s: *EmitterState, name_sv: StrView, reg: i32, var_type: TypeKind, type_name_sv: StrView)
    var name: *u8 = name_sv.ptr
    var len: i32 = name_sv.len as i32
    var type_name: *u8 = type_name_sv.ptr
    var type_name_len: i32 = type_name_sv.len as i32
    add_local_full(s, StrView { ptr: (name), len: (len) as i64 }, reg, var_type, StrView { ptr: (type_name), len: (type_name_len) as i64 }, TypeKind.I64, 0, TypeKind.Void)

pub fn add_local_array(s: *EmitterState, name_sv: StrView, reg: i32, arr_size: i32, elem_type: TypeKind)
    var name: *u8 = name_sv.ptr
    var len: i32 = name_sv.len as i32
    add_local_full(s, StrView { ptr: (name), len: (len) as i64 }, reg, TypeKind.Array, StrView { ptr: (null), len: (0) as i64 }, TypeKind.I64, arr_size, elem_type)

# AGAST #1671: attach a fn-type signature to the just-registered local.
pub fn set_local_fn_sig(s: *EmitterState, name_sv: StrView, sig: *FnDef)
    var name: *u8 = name_sv.ptr
    var len: i32 = name_sv.len as i32
    if sig == null
        return
    let loc: *LocalVar = find_local_struct_name(s, StrView { ptr: (name), len: (len) as i64 })
    if loc != null
        lv_set_fn_sig(loc, sig)

# AGAST #1815: attach a `**T` local's innermost pointee to the just-registered local.
pub fn set_local_inner_ref(s: *EmitterState, name_sv: StrView, inner_ref: i32)
    var name: *u8 = name_sv.ptr
    var len: i32 = name_sv.len as i32
    let loc: *LocalVar = find_local_struct_name(s, StrView { ptr: (name), len: (len) as i64 })
    if loc != null
        lv_set_inner_ref(loc, inner_ref)

pub fn set_local_inner_pointee(s: *EmitterState, name_sv: StrView, inner: i32)
    var name: *u8 = name_sv.ptr
    var len: i32 = name_sv.len as i32
    if inner == (TypeKind.Void as i32)
        return
    let loc: *LocalVar = find_local_struct_name(s, StrView { ptr: (name), len: (len) as i64 })
    if loc != null
        lv_set_inner_pointee_type(loc, inner)

# AGAST #1953: record N and T on the just-registered `*[N]T` local `name`
# (from Param / Stmt pointee_array_*).  A no-op when size is 0 (not `*[N]T`).
# AGAST #2539: a `**[N]T` holds them too, for the `*[N]T` that `*r` reads, and
# (#2331) an `@*[N]T` or `@&*[N]T` (ref_to_ptr).
pub fn set_local_pointee_array(s: *EmitterState, name_sv: StrView, size: i32, elem: TypeKind)
    var name: *u8 = name_sv.ptr
    var len: i32 = name_sv.len as i32
    if size <= 0
        return
    let loc: *LocalVar = find_local_struct_name(s, StrView { ptr: (name), len: (len) as i64 })
    if loc != null and (lv_pointee_type(loc) == TypeKind.Array or lv_var_type(loc) == TypeKind.PtrPtr or ref_to_ptr(loc) == 1)
        lv_set_pointee_array_size(loc, size)
        lv_set_pointee_array_elem_type(loc, elem)

# AGAST #2331: 1 for a `**S`, `@*S` or `@&*S` local: `*q` is a `*S`.
pub fn ptr_to_struct_ptr(loc: *LocalVar) -> i32
    if lv_var_type(loc) == TypeKind.PtrPtr
        return (lv_inner_pointee_type(loc) == (TypeKind.Struct as i32)) as i32
    ref_to_ptr(loc)

# AGAST #2343: U, on the same local, for `*[N]*U`.
# AGAST #2522: and on its `p#` view, which add_array_view bound before U was known.
pub fn set_local_pointee_elem(s: *EmitterState, name_sv: StrView, pointee: TypeKind)
    var name: *u8 = name_sv.ptr
    var len: i32 = name_sv.len as i32
    let idx: i32 = find_local_idx(s, StrView { ptr: (name), len: (len) as i64 })
    if idx < 0
        return
    let loc: *LocalVar = local_at(s, idx)
    lv_set_pointee_array_elem_pointee(loc, pointee)
    if idx < 1
        return
    let view: *LocalVar = local_at(s, idx - 1)
    if lv_is_array_view(view) == 1 and view.reg == loc.reg
        view_holds_pointers(view, pointee)

# AGAST #2522: the `p#` view of a `*[N]*U` is a `**U`, bound as a `**U` param is:
# pointee TypeKind.Ptr, U the inner pointee.  A `*T` view with a TypeKind.Ptr pointee read
# and stored `*p[i]` at 8 bytes, whatever U was (#2330's 70 for 72).
fn view_holds_pointers(view: *LocalVar, pointee: TypeKind)
    if lv_pointee_type(view) != TypeKind.Ptr or pointee == TypeKind.Void
        return
    lv_set_var_type(view, TypeKind.PtrPtr)
    lv_set_inner_pointee_type(view, (pointee as i32))

# AGAST #2522: 1 for the view of a `*[N]*U` whose U wasn't recorded.  It's still a
# `*T` over pointers, which would read and store `*p[i]` at 8 bytes, so it isn't
# used: `p[i]` keeps #2321's located refusal.
pub fn view_lacks_pointee(view: *LocalVar) -> i32
    (lv_pointee_type(view) == TypeKind.Ptr and lv_var_type(view) != TypeKind.PtrPtr) as i32

# AGAST #2330, LARB R9: `p[i]` on a `*[N]T`, `@[N]T` or `@&[N]T` local is element i
# at stride T, as a place: read, store, `+=`, `@`, `@&`, `.f`, a by-value copy.
# Each of those lowers `*(q + i)` for a `q: *T` already, so the binding of `p` adds
# `p#`, a `*T` over the same slot, and index_through hands `p[i]` over as
# `*(p# + i)`.  The slot holds the array's address, which is element 0's, and a
# store to `p` moves both.  Call it just BEFORE adding `p`, so `p` is still the
# last local (its binders read local_at(count - 1)) and the view rolls back with
# it.  Rows get no view: they keep #2321's located refusal.  A `*[N]*U`'s view is a
# `**U` (set_local_pointee_elem, #2522).
pub fn add_array_view(s: *EmitterState, name_sv: StrView, reg: i32, kind: TypeKind, pointee: TypeKind, size: i32, elem: TypeKind, type_name_sv: StrView)
    var name: *u8 = name_sv.ptr
    var len: i32 = name_sv.len as i32
    var type_name: *u8 = type_name_sv.ptr
    var type_name_len: i32 = type_name_sv.len as i32
    if pointee != TypeKind.Array or size <= 0
        return
    if kind != TypeKind.Ptr and kind != TypeKind.Ref and kind != TypeKind.MutRef
        return
    if array_view_elem_ok(s, elem, StrView { ptr: (type_name), len: (type_name_len) as i64 }) == 0
        return
    let view_name: *u8 = malloc(len as i64 + 1)
    memcpy(view_name, name, len as i64)
    *(view_name + len) = 35   # '#': no identifier has one, so `p#` names only this
    add_local_full(s, StrView { ptr: (view_name), len: (len + 1) as i64 }, reg, TypeKind.Ptr, StrView { ptr: (type_name), len: (type_name_len) as i64 }, elem, 0, TypeKind.Void)
    let view: *LocalVar = local_at(s, s.local_count - 1)
    lv_mark_array_view(view)

# 1 when an array of `elem` gets a view: a scalar, or a struct ritz1 knows.
fn array_view_elem_ok(s: *EmitterState, elem: TypeKind, type_name_sv: StrView) -> i32
    var type_name: *u8 = type_name_sv.ptr
    var type_name_len: i32 = type_name_sv.len as i32
    match elem
        TypeKind.Struct =>
            if type_name_len <= 0 or find_struct(s, StrView { ptr: (type_name), len: (type_name_len) as i64 }) == null
                return 0
        TypeKind.Ptr =>
            # `*[N]*U` (#2522): set_local_pointee_elem makes the view a `**U`.
            return 1
        _ =>
            if elem == TypeKind.PtrPtr or ptr_pointee_size(s, elem, StrView { ptr: (null), len: (0) as i64 }) == 0
                return 0
    1

# AGAST #4122: the shape of the `*[N][M]..T` an element `a[k]` of a
# `var a: [K]*[N][M]..T` local is; null for anything else.
pub fn elem_plane_ptr_shape(s: *EmitterState, e: *Expr) -> *ArrayShape
    if e.kind != ExprKind.Index or e.left == null or e.left.kind != ExprKind.Ident
        return null
    if e.right == null or e.right.kind == ExprKind.Range
        return null
    let loc: *LocalVar = find_local_struct_name(s, StrView { ptr: (e.left.ident_ptr), len: (e.left.ident_len) as i64 })
    if loc == null or lv_var_type(loc) != TypeKind.Array or lv_array_rec(loc) == null
        return null
    lv_array_rec(loc).ptr_plane

# AGAST #2553: the view of `d`, a `*r` with `r` a `**[N]T` local or param, so
# `(*r)[i]` is element i of the array behind `*r`, at stride T, as `p[i]` is on
# the `*[N]T` that `let p = *r` copies (#2539).  It took the byte path: a scalar
# `(*r)[i]` read and stored the wrong bytes, SILENT, and `(*r)[i].f` was
# "unhandled EXPR_MEMBER".  null when `loc` isn't one.
#
# AGAST #2331: and `r: @*[N]T` or `@&*[N]T`, which read the wrong bytes the same way.
pub fn deref_array_view(s: *EmitterState, d: *Expr, loc: *LocalVar) -> *LocalVar
    if lv_pointee_array_size(loc) <= 0
        return null
    if ref_to_ptr(loc) == 0 and (lv_var_type(loc) != TypeKind.PtrPtr or lv_inner_pointee_type(loc) != (TypeKind.Array as i32))
        return null
    var en_len: i32 = 0
    let en: *u8 = array_ptr_elem_name(loc, @en_len)
    unscoped_array_view(s, d, lv_pointee_array_elem_type(loc), StrView { ptr: (en), len: (en_len) as i64 }, lv_pointee_array_elem_pointee(loc))

# AGAST #2329: a view of the `*[N]T` that `root` evaluates to, in no scope: an
# emitting site binds it with through_spill.  null if T gets no view.
pub fn unscoped_array_view(s: *EmitterState, root: *Expr, elem: TypeKind, name_sv: StrView, elem_pointee: TypeKind) -> *LocalVar
    var name: *u8 = name_sv.ptr
    var name_len: i32 = name_sv.len as i32
    if array_view_elem_ok(s, elem, StrView { ptr: (name), len: (name_len) as i64 }) == 0
        return null
    let v: *LocalVar = malloc(sizeof(LocalVar)) as *LocalVar
    lv_loc_init(v, StrView { ptr: (null), len: (0) as i64 }, TypeKind.Ptr, StrView { ptr: (name), len: (name_len) as i64 }, elem, 0, TypeKind.Void)
    lv_mark_array_view(v)
    lv_set_array_view(v, root)
    view_holds_pointers(v, elem_pointee)   # AGAST #2522
    if view_lacks_pointee(v) == 1
        return null
    v

pub fn add_local_full(s: *EmitterState, name_sv: StrView, reg: i32, var_type: TypeKind, type_name_sv: StrView, pointee: TypeKind, arr_size: i32, arr_elem: TypeKind)
    var name: *u8 = name_sv.ptr
    var len: i32 = name_sv.len as i32
    var type_name: *u8 = type_name_sv.ptr
    var type_name_len: i32 = type_name_sv.len as i32
    if s.local_count >= s.locals_cap
        let cap: i64 = (s.locals_cap as i64) * 2
        s.locals = realloc(s.locals as *u8, cap * sizeof(LocalVar)) as *LocalVar
        s.locals_cap = cap as i32
    if s.fs_count >= s.fs_cap   # AGAST #3739: frame_limit names reg's slot
        s.fs_cap = s.fs_cap * 2
        s.fs = realloc(s.fs as *u8, (s.fs_cap as i64) * sizeof(FrameSlot)) as *FrameSlot
    let fslot: *FrameSlot = s.fs + (s.fs_count as i64)
    fslot.reg = reg
    fslot.name = name
    fslot.name_len = len
    s.fs_count = s.fs_count + 1
    let idx: i32 = s.local_count
    let loc: *LocalVar = local_at(s, idx)
    # AGAST #4528: name + slot + the one `*TypeRef`; lv_loc_init clears the
    # binding flags and builds the chain the flat arguments describe.
    lv_loc_init(loc, StrView { ptr: (name), len: (len) as i64 }, var_type, StrView { ptr: (type_name), len: (type_name_len) as i64 }, pointee, arr_size, arr_elem)
    loc.reg = reg
    s.local_count = idx + 1
    # ritz-task-193 — mirror into HashMap so find_local* hits O(1).
    # Store `idx + 1` so the value is non-zero (0 = miss in
    # hashmap_i64_get).  Same name overwrites (inner shadows outer);
    # the find fallback + rebuild_local_map together preserve correct
    # shadow semantics.
    let key: i64 = fnv1a_str(Span<u8> { ptr: (name), len: (len) as i64 }) as i64
    s.local_map.insert(key, (idx + 1) as i64)

# ritz-task-193 — module-scope find_* now use HashMaps populated once per
# module by build_symbol_maps in emit_module (after monomorphization fixes
# the function/struct lists).  All three preserve the legacy "first
# occurrence wins" semantics: build_symbol_maps inserts only if not already
# present, so duplicate-by-name nodes (from import-merged modules) resolve
# to the head of the linked list — same as the pre-task-193 linear scan.

# Find a global variable by name - returns the GlobalVarDef or null.
# We never insert a null pointer into global_map, so hashmap_i64_get returning
# 0 unambiguously means "miss" — skip the redundant contains-check that
# would double-probe + double-hash on every lookup.
pub fn find_global(s: *EmitterState, name_sv: StrView) -> *GlobalVarDef
    var name: *u8 = name_sv.ptr
    var len: i32 = name_sv.len as i32
    let key: i64 = fnv1a_str(Span<u8> { ptr: (name), len: (len) as i64 }) as i64
    let g: *GlobalVarDef = s.global_map.get(key).unwrap_or(0) as *GlobalVarDef
    if g == null
        return null
    if name_eq(StrView { ptr: (g.name), len: (g.name_len) as i64 }, StrView { ptr: (name), len: (len) as i64 }) == 1
        return g
    # AGAST #1813: the map is keyed by the 64-bit hash alone, so a hit with
    # another name is a collision, not a miss.  Scan the list (first
    # occurrence wins, as in build_symbol_maps).
    var cur: *GlobalVarDef = s.module.globals
    while cur != null
        if name_eq(StrView { ptr: (cur.name), len: (cur.name_len) as i64 }, StrView { ptr: (name), len: (len) as i64 }) == 1
            return cur
        cur = cur.next
    return null

# Find a function definition by name - returns the FnDef or null.
# Same null-as-miss optimization as find_global.
pub fn find_fn(s: *EmitterState, name_sv: StrView) -> *FnDef
    var name: *u8 = name_sv.ptr
    var len: i32 = name_sv.len as i32
    let key: i64 = fnv1a_str(Span<u8> { ptr: (name), len: (len) as i64 }) as i64
    let fn_def: *FnDef = s.fn_map.get(key).unwrap_or(0) as *FnDef
    if fn_def == null
        return null
    if name_eq(StrView { ptr: (fn_def.name), len: (fn_def.name_len) as i64 }, StrView { ptr: (name), len: (len) as i64 }) == 1
        return fn_def
    # AGAST #1813: the map is keyed by the 64-bit hash alone, so a hit with
    # another name is a collision, not a miss.  Scan the list (first
    # occurrence wins, as in build_symbol_maps).
    var cur: *FnDef = s.module.functions
    while cur != null
        if name_eq(StrView { ptr: (cur.name), len: (cur.name_len) as i64 }, StrView { ptr: (name), len: (len) as i64 }) == 1
            return cur
        cur = cur.next
    return null

# The file a fn's lines belong to: a specialised generic may come from an import.
# The body moved to diag (AGAST #4319); kept here for the emitter modules that
# import only emitter_core.
pub fn fn_source_file(f: *FnDef) -> *u8
    diag_fn_source_file(f)

# AGAST #4356: 1 for a file's private free fn -- one whose IR symbol carries
# its defining file (AGAST #1858).  As ritz0's LLVMEmitter._private_free:
# not `pub`, not `main`, not a method (`T_m`: twins can't share it, #4609),
# not a monomorph instance ('$'; internal), not a generated `E__from`,
# and not a written `extern fn` (body null).  A declaration-only fn -- a
# written `fn .. = extern`, or one an interface text replaced by one -- has
# the non-null stripped_body() sentinel (#1900), so it is included: an
# importer must spell the symbol its module's object actually defines.
pub fn fn_private_free(f: *FnDef) -> i32
    if f == null or f.is_pub != 0 or f.body == null or f.from_generated != 0
        return 0
    if f.def_file == null or *(f.def_file) == '<'   # '<input>': no real file
        return 0
    if f.name_len == 4 and name_eq(StrView { ptr: (f.name), len: (4) as i64 }, StrView { ptr: (c"main"), len: (4) as i64 }) == 1
        return 0
    var i: i32 = 0
    while i < f.name_len
        if *(f.name + i) == '$'   # '$': a monomorph instance, not the fn
            return 0
        i += 1
    1

# AGAST #4356: `f`'s defining file as an absolute, lexically normalised path,
# so the definition's compile (`m.ritz`) and an importer's (`./m.ritz`, or the
# same path through RITZ_PATH) hash alike.  Freshly allocated; `raw` on a
# getcwd failure, which only risks the old spelling mismatch.
fn fn_def_file_abs(f: *FnDef) -> *u8
    let raw: *u8 = f.def_file
    let rlen: i64 = strlen(raw)
    var abs: *u8 = raw
    var alen: i64 = rlen
    if rlen == 0 or *(raw) != '/'   # '/'
        var cwd: [4096]u8
        let cwdp: *u8 = @cwd[0]
        let n: i64 = sys_getcwd(cwdp, 4096)
        if n <= 0
            return raw
        var clen: i64 = n
        if *(cwdp + clen - 1) == 0
            clen -= 1
        let joined: *u8 = malloc(clen + 1 + rlen + 1)
        memcpy(joined, cwdp, clen)
        *(joined + clen) = 47
        memcpy(joined + clen + 1, raw, rlen)
        *(joined + clen + 1 + rlen) = 0
        abs = joined
        alen = clen + 1 + rlen
    # Split on '/', dropping empty and "." segments and folding "..".
    let out: *u8 = malloc(alen + 2)
    var olen: i32 = 0
    var i: i64 = 0
    while i < alen
        if *(abs + i) == '/'
            i += 1
            continue
        var j: i64 = i
        while j < alen and *(abs + j) != '/'
            j += 1
        let seg: *u8 = abs + i
        let slen: i64 = j - i
        if slen == 1 and *seg == '.'   # "."
            i = j
            continue
        if slen == 2 and *seg == '.' and *(seg + 1) == '.'   # ".."
            while olen > 0 and *(out + olen - 1) != '/'
                olen -= 1
            if olen > 0
                olen -= 1
            i = j
            continue
        *(out + olen) = 47
        olen += 1
        memcpy(out + olen, seg, slen)
        olen += slen as i32
        i = j
    if olen == 0
        *(out + olen) = 47
        olen = 1
    *(out + olen) = 0
    out

# AGAST #4356: the IR symbol of `f`, its length in *out_len.  A private free
# fn's symbol is its name and its defining file's hash (`helper__5e0ed276`),
# so a generic's instance -- emitted in the object of the file that
# instantiates it -- resolves the definition in its own module's object.
# ritz0 does the same since #1858 (LLVMEmitter._symbol_name); every other
# fn's symbol is its name.  A mangled result is freshly allocated.
pub fn fn_symbol(f: *FnDef, out_len: *i32) -> *u8
    *out_len = f.name_len
    if fn_private_free(f) == 0
        return f.name
    var hex: [64]u8
    let file: *u8 = diag_symbol_file_key(fn_def_file_abs(f))
    sha256_hex(StrView { ptr: (file), len: (strlen(file)) }, @hex[0])
    let n: i32 = f.name_len + 10   # "__" + the first 8 hex digits
    let buf: *u8 = malloc(n as i64 + 1)
    memcpy(buf, f.name, f.name_len as i64)
    buf[f.name_len] = 95
    buf[f.name_len + 1] = 95
    for i in 0..8
        buf[f.name_len + 2 + i] = hex[i]
    buf[n] = 0
    *out_len = n
    buf

# AGAST #2260: is `e`'s value used by a statement being emitted?
fn value_wanted(s: *EmitterState, e: *Expr) -> i32
    var i: i32 = 0
    while i < s.wanted_count
        if s.wanted[i] == e
            return 1
        i += 1
    0

fn want_push(s: *EmitterState, e: *Expr)
    if s.wanted_count == s.wanted_cap
        s.wanted_cap = s.wanted_cap * 2 + 16
        s.wanted = realloc(s.wanted as *u8, s.wanted_cap as i64 * 8) as **Expr
    s.wanted[s.wanted_count] = e
    s.wanted_count += 1

fn want_list(s: *EmitterState, list: *Expr)
    var cur: *Expr = list
    while cur != null
        want_value_of(s, cur, 1)
        cur = cur.next

# AGAST #2260: record which expressions in `e` have a used value: `e` itself
# when `consumed`, and always its operands (an argument, an operand, a receiver,
# a scrutinee).  As ritz0's _want_value_of: an `if`/`match` arm's value is not
# itself marked (a used arm with no value is #2046's diagnostic), and an arm's
# statements are judged as they are emitted.
fn want_value_of(s: *EmitterState, e: *Expr, consumed: i32)
    if e == null
        return
    if consumed == 1
        want_push(s, e)
    let k: ExprKind = e.kind
    match k
        ExprKind.Call =>
            if e.func_name_len == 0
                want_value_of(s, e.left, 1)   # a nameless call's callee
            want_list(s, e.args)
        ExprKind.Method =>
            want_value_of(s, e.left, 1)
            want_list(s, e.args)
        ExprKind.Binary | ExprKind.Index | ExprKind.Range =>
            want_value_of(s, e.left, 1)
            want_value_of(s, e.right, 1)
        ExprKind.Unary =>
            want_value_of(s, e.operand, 1)
        ExprKind.Member | ExprKind.Cast | ExprKind.Try | ExprKind.ArrayFill =>
            want_value_of(s, e.left, 1)
        ExprKind.ArrayLit =>
            want_list(s, e.args)
        ExprKind.StructLit =>
            # The field inits are a *FieldInit list recast to *Expr.
            var fi: *FieldInit = e.args as *FieldInit
            while fi != null
                want_value_of(s, fi.value, 1)
                fi = fi.next
        ExprKind.Match | ExprKind.If =>
            want_value_of(s, e.left, 1)
            var arm: *MatchArm = e.args as *MatchArm
            while arm != null
                want_value_of(s, arm.body, 0)
                arm = arm.next
        _ => pass

# AGAST #2255, #2260: push the values `stmt` uses; the caller pops them back to
# the count it saved once `stmt` is emitted.  A procedure hands nothing back, so
# its `return g()` uses no value.
pub fn want_stmt_values(s: *EmitterState, stmt: *Stmt, ret_type: TypeKind)
    let k: StmtKind = stmt.kind
    match k
        StmtKind.VarDecl | StmtKind.TupleDecl =>
            want_value_of(s, stmt.var_init, 1)
        StmtKind.Return =>
            want_value_of(s, stmt.return_value, (ret_type != TypeKind.Void) as i32)
        StmtKind.Assign =>
            if stmt.assign_target_len == 0
                want_value_of(s, stmt.if_cond as *Expr, 0)
            want_value_of(s, stmt.assign_value, 1)
        StmtKind.IndexAssign | StmtKind.LocalFieldIndexAssign =>
            want_value_of(s, stmt.while_cond, 1)
            want_value_of(s, stmt.assign_value, 1)
        StmtKind.LocalFieldAssign | StmtKind.MemberAssign | StmtKind.MemberIndexAssign =>
            want_value_of(s, stmt.assign_value, 1)
        StmtKind.Expr =>
            want_value_of(s, stmt.expr, 0)
        StmtKind.If | StmtKind.Assert | StmtKind.Match =>
            want_value_of(s, stmt.if_cond as *Expr, 1)
        StmtKind.While =>
            want_value_of(s, stmt.while_cond, 1)
        StmtKind.For =>
            want_value_of(s, stmt.for_start, 1)
            want_value_of(s, stmt.for_end, 1)
        _ => pass

# AGAST #2255: `e` called a procedure named `name` (a fn pointer when `len` is
# 0).  Its dummy `i32 0` is not a value, but `return g(n)`, `let x = g(n)`,
# `x = g(n)`, `h(g(n))` and `g(n) + 1` would use it.  Judged where a call
# resolves, because only there are a method's callee and a fn-pointer local known.
pub fn reject_procedure_value(s: *EmitterState, e: *Expr, name_sv: StrView)
    var name: *u8 = name_sv.ptr
    var len: i32 = name_sv.len as i32
    if value_wanted(s, e) == 0
        return
    eprints_cstr(fn_source_file(emitter_current_fn()))
    eprint_char(':')
    eprint_i64(e.span.line as i64)
    eprint_char(':')
    eprint_i64(e.span.col as i64)
    if len == 0
        eprints(": error: this fn pointer")
    else
        eprints(": error: `")
        for i in 0..len
            eprint_char(*(name + i))
        eprint_char('`')
    eprints(" returns nothing, so its call has no value to use here\n")
    emit_str(s, c"  ; ERROR: a procedure call has no value\n")
    s.error_count = s.error_count + 1

# Call `e`, to `name`, resolved to `fd`: a procedure's call has no value to
# use (AGAST #2255).  A procedure call in a `-> T` fn's tail is tail_value's,
# on Sema (AGAST #2237, #3511).
pub fn note_callee(s: *EmitterState, e: *Expr, fd: *FnDef, name_sv: StrView)
    var name: *u8 = name_sv.ptr
    var len: i32 = name_sv.len as i32
    if fn_is_procedure(fd) == 0
        return
    reject_procedure_value(s, e, StrView { ptr: (name), len: (len) as i64 })   # AGAST #2255

pub fn note_method_callee(s: *EmitterState, e: *Expr, fd: *FnDef)
    note_callee(s, e, fd, StrView { ptr: (e.ident_ptr), len: (e.ident_len) as i64 })

# struct_map_find moved to ast_query (AGAST #4319); re-exported through
# `pub import ast_query` above.
pub fn find_struct(s: *EmitterState, name_sv: StrView) -> *StructDef
    var name: *u8 = name_sv.ptr
    var len: i32 = name_sv.len as i32
    struct_map_find(@s.struct_map, s.module, StrView { ptr: (name), len: (len) as i64 })

# Result struct for emit_member_ptr - returns pointer register and field info
struct MemberPtrResult
    reg: i32              # Register holding pointer to field
    field: *StructField   # Field info (type, name, etc.)
    success: i32          # 1 if successful, 0 if error

# AGAST #2388: what a `for` over a header binds: `elem`, and `name` when that's a
# struct.  For a pointer element, what it points at, as elem_recorded_pointee has it.
struct ForElem
    elem: TypeKind
    name: *u8
    name_len: i32
    pointee: TypeKind
    pointee_name: *u8
    pointee_name_len: i32

pub fn namelist_init(l: *NameList, cap: i32)
    l.names = malloc((cap as i64) * 8) as **u8
    l.lens = malloc((cap as i64) * 4) as *i32
    l.count = 0
    l.cap = cap

# Index of `name` in the list, or -1.
pub fn namelist_find(l: *NameList, name_sv: StrView) -> i32
    var name: *u8 = name_sv.ptr
    var len: i32 = name_sv.len as i32
    let names: **u8 = l.names
    let lens: *i32 = l.lens
    var i: i32 = 0
    while i < l.count
        let n: i32 = *(lens + i)
        if n == len
            let stored: *u8 = *(names + i)
            if name_eq(StrView { ptr: (stored), len: (n) as i64 }, StrView { ptr: (name), len: (len) as i64 }) == 1
                return i
        i = i + 1
    -1

pub fn namelist_push(l: *NameList, name_sv: StrView)
    var name: *u8 = name_sv.ptr
    var len: i32 = name_sv.len as i32
    if l.count >= l.cap
        let cap: i64 = (l.cap as i64) * 2
        l.names = realloc(l.names as *u8, cap * 8) as **u8
        l.lens = realloc(l.lens as *u8, cap * 4) as *i32
        l.cap = cap as i32
    let names: **u8 = l.names
    let lens: *i32 = l.lens
    *(names + l.count) = name
    *(lens + l.count) = len
    l.count = l.count + 1

pub fn namelist_count(l: *NameList) -> i32
    l.count

pub fn namelist_name(l: *NameList, i: i32) -> *u8
    let names: **u8 = l.names
    *(names + i)

pub fn namelist_len(l: *NameList, i: i32) -> i32
    let lens: *i32 = l.lens
    *(lens + i)

pub fn add_extern(s: *EmitterState, name_sv: StrView)
    var name: *u8 = name_sv.ptr
    var len: i32 = name_sv.len as i32
    if namelist_find(@s.externs, StrView { ptr: (name), len: (len) as i64 }) >= 0
        return  # Already registered
    # Add new external - copy the name since caller might use a stack buffer
    let name_copy: *u8 = malloc(len as i64 + 1) as *u8
    for k in 0..len
        *(name_copy + k) = *(name + k)
    *(name_copy + len) = 0  # Null terminate
    namelist_push(@s.externs, StrView { ptr: (name_copy), len: (len) as i64 })

# Add extern for method call: TypeName_methodName
# Allocates memory for the mangled name
pub fn add_method_extern(s: *EmitterState, type_name_sv: StrView, method_name_sv: StrView)
    var type_name: *u8 = type_name_sv.ptr
    var type_len: i32 = type_name_sv.len as i32
    var method_name: *u8 = method_name_sv.ptr
    var method_len: i32 = method_name_sv.len as i32
    # Calculate total length: TypeName_methodName
    let total_len: i32 = type_len + 1 + method_len

    # Allocate memory for the name (use malloc)
    let name: *u8 = malloc(total_len as i64 + 1) as *u8
    if name == null
        return

    # Copy type name
    for i in 0..type_len
        *(name + i) = *(type_name + i)

    # Add underscore
    *(name + type_len) = 95  # '_'

    # Copy method name
    for i in 0..method_len
        *(name + type_len + 1 + i) = *(method_name + i)

    # Null terminate
    *(name + total_len) = 0

    # Add to externs
    add_extern(s, StrView { ptr: (name), len: (total_len) as i64 })

# =============================================================================
# Deduplication Helpers - Track emitted structs/functions to avoid duplicates
# =============================================================================

# Check if a struct has already been emitted
pub fn was_struct_emitted(s: *EmitterState, name_sv: StrView) -> i32
    var name: *u8 = name_sv.ptr
    var len: i32 = name_sv.len as i32
    if namelist_find(@s.emitted_structs, StrView { ptr: (name), len: (len) as i64 }) >= 0
        return 1
    0

# Mark a struct as emitted
pub fn mark_struct_emitted(s: *EmitterState, name_sv: StrView)
    var name: *u8 = name_sv.ptr
    var len: i32 = name_sv.len as i32
    namelist_push(@s.emitted_structs, StrView { ptr: (name), len: (len) as i64 })

# Check if a function has already been emitted
pub fn was_fn_emitted(s: *EmitterState, name_sv: StrView) -> i32
    var name: *u8 = name_sv.ptr
    var len: i32 = name_sv.len as i32
    if namelist_find(@s.emitted_fns, StrView { ptr: (name), len: (len) as i64 }) >= 0
        return 1
    0

# Mark a function as emitted
pub fn mark_fn_emitted(s: *EmitterState, name_sv: StrView)
    var name: *u8 = name_sv.ptr
    var len: i32 = name_sv.len as i32
    namelist_push(@s.emitted_fns, StrView { ptr: (name), len: (len) as i64 })

# Check if a global has already been emitted
pub fn was_global_emitted(s: *EmitterState, name_sv: StrView) -> i32
    var name: *u8 = name_sv.ptr
    var len: i32 = name_sv.len as i32
    if namelist_find(@s.emitted_globals, StrView { ptr: (name), len: (len) as i64 }) >= 0
        return 1
    0

# Mark a global as emitted
pub fn mark_global_emitted(s: *EmitterState, name_sv: StrView)
    var name: *u8 = name_sv.ptr
    var len: i32 = name_sv.len as i32
    namelist_push(@s.emitted_globals, StrView { ptr: (name), len: (len) as i64 })

# find_builtin_const / is_builtin_const moved to ast_query (AGAST #4319);
# re-exported through `pub import ast_query` above.

pub fn find_const(s: *EmitterState, name_sv: StrView) -> i64
    var name: *u8 = name_sv.ptr
    var len: i32 = name_sv.len as i32
    # First check module constants via HashMap
    let ce: *ConstEntry = find_const_entry(s, StrView { ptr: (name), len: (len) as i64 })
    if ce != null
        return ce.value
    # Then check builtin constants
    let builtin: i64 = find_builtin_const(StrView { ptr: (name), len: (len) as i64 })
    if builtin != -9999
        return builtin
    0

# Look up a ConstEntry by name (returns null if not found).  Distinct from
# find_const above which only returns the scalar value — this caller-side
# helper is needed when const-array iter wants the array_size /
# array_elem_type metadata to drive iteration codegen.  Same null-as-miss
# single-probe optimization as find_global.
pub fn find_const_entry(s: *EmitterState, name_sv: StrView) -> *ConstEntry
    var name: *u8 = name_sv.ptr
    var len: i32 = name_sv.len as i32
    let key: i64 = fnv1a_str(Span<u8> { ptr: (name), len: (len) as i64 }) as i64
    let ce: *ConstEntry = s.const_map.get(key).unwrap_or(0) as *ConstEntry
    if ce == null
        return null
    if name_eq(StrView { ptr: (ce.name), len: (ce.name_len) as i64 }, StrView { ptr: (name), len: (len) as i64 }) == 1
        return ce
    # AGAST #1813: the map is keyed by the 64-bit hash alone, so a hit with
    # another name is a collision, not a miss.  Scan the list (first
    # occurrence wins, as in build_symbol_maps).
    var cur: *ConstEntry = s.module.constants
    while cur != null
        if name_eq(StrView { ptr: (cur.name), len: (cur.name_len) as i64 }, StrView { ptr: (name), len: (len) as i64 }) == 1
            return cur
        cur = cur.next
    return null

# AGAST #2155: TypeKind.F32 / TypeKind.F64 when `ce` is a float const whose
# initializer is a constant integer expression (`const F: f64 = -1`,
# `= 2 + K`), with the folded integer in *out; 0 otherwise.  The use site
# must `sitofp` that integer to the const's type: it used to materialise it
# as `add i64 0, <v>` and hand the i64 to float code, which clang rejected.
# Folded here, not read from `ce.value`: a float const is never PENDING, so
# one naming a later integer const was not folded at parse time.
pub fn const_int_init_float_ty(s: *EmitterState, ce: *ConstEntry, out: *i64) -> TypeKind
    if ce == null or (ce.const_type != TypeKind.F32 and ce.const_type != TypeKind.F64)
        return TypeKind.Void
    if const_fold_int(s.module.constants, ce.value_expr, 1, out) == 0
        return TypeKind.Void
    ce.const_type

# AGAST #2176: TypeKind.F32 / TypeKind.F64 when `ce` is a float const initialised by a
# float literal or a negated one (`= 1.5`, `= -1.5`); 0 otherwise.  The use
# site emits value_expr (a `double`) and narrows it for f32.  Such a const has
# no integer fold, so its `ce.value` is 0, and the use site emitted that as
# `add i64 0, 0` and handed the i64 to float code, which clang rejected.
pub fn const_float_lit_init_ty(ce: *ConstEntry) -> TypeKind
    if ce == null or (ce.const_type != TypeKind.F32 and ce.const_type != TypeKind.F64)
        return TypeKind.Void
    if ce.value_expr == null or is_float_lit_operand(ce.value_expr) == 0
        return TypeKind.Void
    ce.const_type

pub fn is_const(s: *EmitterState, name_sv: StrView) -> i32
    var name: *u8 = name_sv.ptr
    var len: i32 = name_sv.len as i32
    # Check module constants first via HashMap
    if find_const_entry(s, StrView { ptr: (name), len: (len) as i64 }) != null
        return 1
    # Check builtin constants
    is_builtin_const(StrView { ptr: (name), len: (len) as i64 })

# ritz-task-193 — allocate the five symbol-table HashMaps.  Called from
# emit_module right after `var s: EmitterState`.  Stack-allocated EmitterState
# starts with garbage HashMap entry pointers, so this MUST run before any
# add_local / find_* call hits the maps with a stale `entries` pointer.
pub fn init_emitter_maps(s: *EmitterState)
    # Pre-size to skip the grow cascade.  512 keeps local_map under the 75%
    # load factor for a fn of up to LOCALS_INIT_CAP locals; past that it grows.
    # Module-scope maps are sized for typical self-host modules (thousands
    # of fns/structs after monomorphization) — undersizing pays an O(N)
    # rehash cost on every doubling.  `hashmap_i64_with_cap` rounds up to
    # power-of-2, so the constants above need not be exact.
    s.local_map = hashmap_i64_with_cap(512)
    s.global_map = hashmap_i64_with_cap(256)
    s.fn_map = hashmap_i64_with_cap(8192)
    s.struct_map = hashmap_i64_with_cap(2048)
    s.const_map = hashmap_i64_with_cap(256)

# ritz-task-193 — populate per-module symbol tables from the AST after
# monomorphization.  emit_module calls this once; the maps stay valid for
# the lifetime of the EmitterState because nothing in the emit pipeline
# mutates `s.module.{globals,functions,structs,constants}` after init.
# First-occurrence wins (skip-if-contains) — preserves the head-first
# semantics of the legacy linked-list scans in the face of duplicate
# entries from import-merged modules.
pub fn build_symbol_maps(s: *EmitterState)
    var g: *GlobalVarDef = s.module.globals
    while g != null
        let kg: i64 = fnv1a_str(Span<u8> { ptr: (g.name), len: (g.name_len) as i64 }) as i64
        if not s.global_map.contains(kg)
            s.global_map.insert(kg, g as i64)
        g = g.next

    var fd: *FnDef = s.module.functions
    while fd != null
        let kf: i64 = fnv1a_str(Span<u8> { ptr: (fd.name), len: (fd.name_len) as i64 }) as i64
        if not s.fn_map.contains(kf)
            s.fn_map.insert(kf, fd as i64)
        fd = fd.next

    var st: *StructDef = s.module.structs
    while st != null
        let ks: i64 = fnv1a_str(Span<u8> { ptr: (st.name), len: (st.name_len) as i64 }) as i64
        if not s.struct_map.contains(ks)
            s.struct_map.insert(ks, st as i64)
        st = st.next

    var ce: *ConstEntry = s.module.constants
    while ce != null
        let kc: i64 = fnv1a_str(Span<u8> { ptr: (ce.name), len: (ce.name_len) as i64 }) as i64
        if not s.const_map.contains(kc)
            s.const_map.insert(kc, ce as i64)
        ce = ce.next

# AGAST #1509: times a multi-dimensional array's TypeKind.Array element reached
# a 1-D element-type helper (elem_mem_llvm), i.e. an N-D array use ritz1 does
# not lower.  Reported (and failed) by emit_module.
var g_nd_elem_leaks: i32 = 0

pub fn nd_elem_leaks() -> i32
    g_nd_elem_leaks

# The LLVM type of ONE element of a non-struct `[N]T` -- a local, global or
# const array, a struct field array, or the pointee of a `*T` -- and so of
# every GEP / load / store over it: types.ritz's memory spelling (ritz0's
# layout).  AGAST #1889: this replaced six ladders (array_elem_llvm,
# field_/local_/global_array_elem_llvm, ptr_field_elem_llvm, and the
# local-array index arms) that each knew a different subset of the
# primitives (#1564 u16/i16/u32, #1814 fields, #1966 f32/f64, #2063 bool).
# A struct element is spelled `%T` by its caller; anything else unknown is
# an i64 slot.
pub fn elem_mem_llvm(t: TypeKind) -> *u8
    if t == TypeKind.Array
        # AGAST #1509: every lowered N-D access goes through
        # emit_nd_index_ptr / emit_array_shape_llvm; anything else used to
        # treat the inner array as one i64 and miscompile silently.
        # emit_module turns the count into a hard error.
        g_nd_elem_leaks = g_nd_elem_leaks + 1
        return c"i64"
    let m: *u8 = ty_mem_llvm(t)
    if m == null
        return c"i64"
    m

# AGAST #1509: the LLVM type of `sh` from dimension `from` inward:
# `[4 x [8 x i8]]` for `[4][8]u8` from 0, `[8 x i8]` from 1, and the bare
# leaf at from == rank.  The same spelling the alloca / global declares, so
# every GEP over the array agrees with its layout (ritz0's layout).
pub fn emit_array_shape_llvm(s: *EmitterState, sh: *ArrayShape, from: i32)
    var d: i32 = from
    while d < sh.rank
        emit_str(s, c"[")
        emit_int(s, sh.dims[d] as i64)
        emit_str(s, IR_X)
        d = d + 1
    if sh.leaf_type == TypeKind.Struct and sh.leaf_name_len > 0
        emit_llvm_type_struct(s, TypeKind.Struct, StrView { ptr: (sh.leaf_name), len: (sh.leaf_name_len) as i64 })
    else
        emit_str(s, elem_mem_llvm(sh.leaf_type))
    d = from
    while d < sh.rank
        emit_str(s, c"]")
        d = d + 1

# Widen an array element just loaded as `ty` (elem_mem_llvm(t)) to the i64
# every expression value is carried in: zext unsigned, sext signed, ptrtoint
# pointers. i64 elements are returned as-is.  A bool element (`i1`, #2063)
# is zero-extended.
pub fn emit_array_elem_widen(s: *EmitterState, val: i32, t: TypeKind, ty: *u8) -> i32
    var op: *u8 = null
    if ty_bits(t) == 64
        return val
    if ty_is_signed(t) == 1
        op = c" = sext "
    else if ty_bits(t) > 0
        op = c" = zext "   # unsigned, and bool's i1 (#2063)
    else if ty_is_ptr(t) == 1
        op = c" = ptrtoint "
    if op == null
        return val
    let wide: i32 = next_reg(s)
    emit_str(s, IR_INDENT)
    emit_reg(s, wide)
    emit_str(s, op)
    emit_str(s, ty)
    emit_str(s, IR_SP)
    emit_reg(s, val)
    emit_str(s, IR_TO_I64)
    return wide

# The inverse of emit_array_elem_widen for a store: narrow an i64 value to the
# element type `ty` (trunc ints, inttoptr pointers). i64 is returned as-is.
pub fn emit_array_elem_narrow(s: *EmitterState, val: i32, t: TypeKind, ty: *u8) -> i32
    var op: *u8 = null
    if ty_int_in(t, 8, 32) == 1
        op = c" = trunc i64 "
    else if t == TypeKind.Ptr or t == TypeKind.PtrPtr
        op = c" = inttoptr i64 "
    if op == null
        return val
    let narrow: i32 = next_reg(s)
    emit_str(s, IR_INDENT)
    emit_reg(s, narrow)
    emit_str(s, op)
    emit_reg(s, val)
    emit_str(s, IR_TO_SP)
    emit_str(s, ty)
    emit_str(s, IR_NL)
    return narrow

# AGAST #3972: 1 when `f` is a `*S` field whose element `x.f[i]` is an S, a
# known struct.  The value, member, address and type paths each ask this, so
# they agree on which fields they take.  A pointer to a Vec, Span or String
# indexes through it (#3816): every one of them asks index_through first.
pub fn ptr_field_struct_elem(s: *EmitterState, f: *StructField) -> i32
    if f == null or f.field_type != TypeKind.Ptr or ptr_field_elem_kind(f) != TypeKind.Struct
        return 0
    (find_struct(s, StrView { ptr: (f.field_type_name), len: (f.field_type_name_len) as i64 }) != null) as i32

# AGAST #1596: address of element `idx` (an i64 register) through the
# pointer held in a struct field. `field_slot` points AT the field; the
# pointer is loaded from it and the GEP strides by the pointee (`kind` from
# ptr_field_elem_kind, never TypeKind.Unknown). The old lowering GEP'd the field
# slot itself as an inline `[0 x T]` array, writing into the struct.
pub fn emit_ptr_field_elem_addr(s: *EmitterState, field_slot: i32, field: *StructField, kind: TypeKind, idx: i32) -> i32
    let base: i32 = next_reg(s)
    emit_load_into(s, IR_TY_PTR, base, field_slot)
    let elem_ptr: i32 = next_reg(s)
    emit_str(s, IR_INDENT)
    emit_reg(s, elem_ptr)
    emit_str(s, c" = getelementptr ")
    if kind == TypeKind.Struct
        emit_llvm_type_struct(s, TypeKind.Struct, StrView { ptr: (field.field_type_name), len: (field.field_type_name_len) as i64 })
    else
        emit_str(s, elem_mem_llvm(kind))
    emit_str(s, IR_PTR_SEP)
    emit_reg(s, base)
    emit_str(s, IR_I64_SEP)
    emit_reg(s, idx)
    emit_str(s, IR_NL)
    return elem_ptr

# Centralised float-type predicate for arith / cmp / cast dispatch.
# Returns 1 for TypeKind.F32/F64 OR for the legacy TypeKind.Struct+name="f32"/"f64"
# representation (some pre-Option-B code paths still surface floats as
# TypeKind.Struct).  Once everything threads through type_named's new mapping
# the second branch becomes dead; it's kept until the migration settles.
pub fn is_float_type(t: TypeKind, name_sv: StrView) -> i32
    var name: *u8 = name_sv.ptr
    var name_len: i32 = name_sv.len as i32
    if t == TypeKind.F32 or t == TypeKind.F64
        return 1
    if t == TypeKind.Struct and name != null and name_len == 3
        if *(name + 0) == 'f' and *(name + 1) == '3' and *(name + 2) == '2'  # f32
            return 1
        if *(name + 0) == 'f' and *(name + 1) == '6' and *(name + 2) == '4'  # f64
            return 1
    return 0

# The concrete struct carried by a tagged enum's Ok/Some variant, named by
# its FIRST type argument; returns the name (a slice of `name`) and its
# length in *out_len, or null when that argument is not a known concrete
# struct (primitives, pointers).  ritz1 mangles every type argument (AGAST
# #1574): `Option<Point>` is `Option$Point`, `Result<String, E>` is
# `Result$String$E` and `Result<Vec<u8>, E>` is `Result$Vec$u8$E`.  Option
# has one argument, the whole suffix; for Result it is the shortest
# `$`-bounded prefix of the suffix naming a concrete struct.  (Not the first
# component alone: `Vec` there is the generic template.)
fn tagged_enum_payload_struct(s: *EmitterState, name_sv: StrView, out_len: *i32) -> *u8
    var name: *u8 = name_sv.ptr
    var name_len: i32 = name_sv.len as i32
    return tagged_enum_payload_named(s, StrView { ptr: (name), len: (name_len) as i64 }, out_len, 0)

# AGAST #2100: 1 if `name` is a concrete (non-generic) struct or, when
# allow_enum is 1, a non-generic user enum: a type a tagged-enum payload is
# stored as by value (#1466 builds a user-enum payload as its aggregate).
pub fn is_concrete_payload_type(s: *EmitterState, name_sv: StrView, allow_enum: i32) -> i32
    var name: *u8 = name_sv.ptr
    var len: i32 = name_sv.len as i32
    let st: *StructDef = find_struct(s, StrView { ptr: (name), len: (len) as i64 })
    if st != null
        return (st.type_params == null) as i32
    if allow_enum == 1 and user_enum_index(s.mono.pctx, StrView { ptr: (name), len: (len) as i64 }) >= 0
        return 1
    0

# tagged_enum_payload_struct; with allow_enum 1 the carried type may also be
# a non-generic user enum (AGAST #2100: `Some(x)` over `Option<Opt>`).
pub fn tagged_enum_payload_named(s: *EmitterState, name_sv: StrView, out_len: *i32, allow_enum: i32) -> *u8
    var name: *u8 = name_sv.ptr
    var name_len: i32 = name_sv.len as i32
    *out_len = 0
    if name == null
        return null
    var dollar: i32 = 0
    while dollar < name_len and *(name + dollar) != '$'   # '$'
        dollar = dollar + 1
    let sfx: *u8 = name + dollar + 1
    let sfx_len: i32 = name_len - dollar - 1
    if sfx_len <= 0
        return null
    if dollar == 6 and *name == 'O'   # "Option": the whole suffix
        if allow_enum == 0 and find_struct(s, StrView { ptr: (sfx), len: (sfx_len) as i64 }) == null
            return null
        if allow_enum == 1 and is_concrete_payload_type(s, StrView { ptr: (sfx), len: (sfx_len) as i64 }, 1) == 0
            return null
        *out_len = sfx_len
        return sfx
    var end: i32 = 0
    while end < sfx_len
        end = end + 1
        while end < sfx_len and *(sfx + end) != '$'
            end = end + 1
        if is_concrete_payload_type(s, StrView { ptr: (sfx), len: (end) as i64 }, allow_enum) == 1
            *out_len = end
            return sfx
    return null

# AGAST #1667: the struct type carried by `Result<T, E>`'s Err variant, i.e.
# E, recovered from the mangled `Result$T$E` name.  When T itself names a
# struct (tagged_enum_payload_struct), E is exactly the remainder after it.
# Otherwise T is a primitive and E is the shortest `$`-suffix naming a
# concrete (non-generic) struct: `Result$i64$ArgError` -> `ArgError`,
# `Result$i32$Box$i64` -> `Box$i64`.  Returns null (out_len 0) when E is
# not a struct, or for non-Result names; callers then keep the i64 binding.
fn tagged_enum_err_payload_struct(s: *EmitterState, name_sv: StrView, out_len: *i32) -> *u8
    var name: *u8 = name_sv.ptr
    var name_len: i32 = name_sv.len as i32
    return tagged_enum_err_payload_named(s, StrView { ptr: (name), len: (name_len) as i64 }, out_len, 0)

# tagged_enum_err_payload_struct; with allow_enum 1, T and E may also be
# non-generic user enums (AGAST #2100: `Err(e)` over `Result<i64, ArgError>`).
pub fn tagged_enum_err_payload_named(s: *EmitterState, name_sv: StrView, out_len: *i32, allow_enum: i32) -> *u8
    var name: *u8 = name_sv.ptr
    var name_len: i32 = name_sv.len as i32
    *out_len = 0
    if name == null or name_len <= 7
        return null
    # "Result$"
    if *name != 'R' or *(name + 1) != 'e' or *(name + 6) != '$'
        return null
    let sfx: *u8 = name + 7
    let sfx_len: i32 = name_len - 7
    var ok_len: i32 = 0
    let ok_st: *u8 = tagged_enum_payload_named(s, StrView { ptr: (name), len: (name_len) as i64 }, @ok_len, allow_enum)
    if ok_st != null and ok_len > 0
        let rest_len: i32 = sfx_len - ok_len - 1
        if rest_len <= 0
            return null
        let rest: *u8 = sfx + ok_len + 1
        if is_concrete_payload_type(s, StrView { ptr: (rest), len: (rest_len) as i64 }, allow_enum) == 0
            return null
        *out_len = rest_len
        return rest
    # Shortest `$`-bounded suffix first; never the whole suffix (that is T).
    var start: i32 = sfx_len - 1
    while start > 0
        if *(sfx + start - 1) == '$'   # '$'
            let cand: *u8 = sfx + start
            let cand_len: i32 = sfx_len - start
            if is_concrete_payload_type(s, StrView { ptr: (cand), len: (cand_len) as i64 }, allow_enum) == 1
                *out_len = cand_len
                return cand
        start = start - 1
    return null

# =============================================================================
# Tagged-enum layout (AGAST #1898) — byte-for-byte ritz0's _define_enum:
#
#     %Result$T$E = type { i8 tag, [pad x i8], [N x i8] payload }
#
# N is the largest payload (T, and E for Result), pad aligns the payload to
# the most-aligned of them: Result<i64, i32> is { i8, [7 x i8], [8 x i8] },
# Option<i32> is { i8, [3 x i8], [4 x i8] }.  ritz1 always emits the pad
# field, as `[0 x i8]` when nothing needs aligning, so the payload is field
# 2 everywhere; a zero-length array adds no bytes and no ABI element, so the
# type stays identical to ritz0's at a call boundary.
#
# ritz1 used one `{ i8, [144 x i8] }` for every instantiation (ritz-task-133,
# #1476).  Self-consistent, but the regression matrix links ritz1-compiled
# callers against ritz0-built ritzlib objects (and bootstrap mixes the two
# compilers' objects), and `file_size(..) -> Result<i64, i32>` came back
# through a 16-byte aggregate read as a 145-byte one with its payload at
# offset 1 instead of 8.
#
# An argument this cannot measure (a type the mangler spells as "", e.g.
# `Option<u32>` -> `Option$`; an unresolved struct; the raw `Result$T$E`
# placeholder) keeps the old conservative size, payload 8-aligned.  Such an
# instantiation is self-consistent within ritz1 but not ritz0-compatible.
# =============================================================================

# 144 = sizeof(Stat), the kernel's struct stat — the widest payload ritzlib
# had when this was the only size (AGAST #1476).
const TAGGED_ENUM_FALLBACK_BYTES: i64 = 144

# te_component_arity, te_arg_end and tagged_enum_arg_in moved to ast_query
# (AGAST #4319); re-exported through `pub import ast_query` above.

# The mangled type argument a tagged-enum variant carries: variant 0 is T
# (Ok / Some), variant 1 is Result's E.  null (out_len 0) for Option's None,
# a non-tagged name, or a name that does not split into exactly its
# arguments.  `Result$Vec$u8$i32`, variant 0 -> `Vec$u8`, 1 -> `i32`.
pub fn tagged_enum_arg(s: *EmitterState, name_sv: StrView, variant: i32, out_len: *i32) -> *u8
    var name: *u8 = name_sv.ptr
    var len: i32 = name_sv.len as i32
    tagged_enum_arg_in(s.mono.pctx, @s.struct_map, s.module, StrView { ptr: (name), len: (len) as i64 }, variant, out_len)

# AGAST #2272: is a mangled argument `unit`, the `()` type?  It is zero bytes,
# 1-aligned: `Result<(), i32>` is { i8, [3 x i8], [4 x i8] }, as in ritz0.
pub fn is_unit_arg(name_sv: StrView) -> i32
    var name: *u8 = name_sv.ptr
    var len: i32 = name_sv.len as i32
    name_eq(StrView { ptr: (name), len: (len) as i64 }, StrView { ptr: (c"unit"), len: (4) as i64 })

# Size and alignment (to *align) of the type one mangled argument spells,
# laid out as ritz0 does; 0 when it cannot be measured.
pub fn mangled_type_size_align(s: *EmitterState, name_sv: StrView, align: *i64) -> i64
    var name: *u8 = name_sv.ptr
    var len: i32 = name_sv.len as i32
    *align = 1
    if name == null or len <= 0
        return 0
    if is_unit_arg(StrView { ptr: (name), len: (len) as i64 }) == 1
        return 0   # measured: zero bytes (tagged_enum_layout tells it apart)
    let ps: i64 = ty_store_size(ty_from_name(StrView { ptr: (name), len: (len) as i64 }))
    if ps > 0
        *align = ps
        return ps
    if mangled_ref_prefix(StrView { ptr: (name), len: (len) as i64 }) > 0   # "ptr_" / "ref_" / "refmut_"
        *align = 8
        return 8
    if is_tagged_enum_type(StrView { ptr: (name), len: (len) as i64 }) == 1
        var pad: i64 = 0
        let n: i64 = tagged_enum_layout(s, StrView { ptr: (name), len: (len) as i64 }, @pad)
        return 1 + pad + n   # all-i8 struct: 1-aligned
    let st: *StructDef = find_struct(s, StrView { ptr: (name), len: (len) as i64 })
    if st == null
        let uei: i32 = user_enum_index(s.mono.pctx, StrView { ptr: (name), len: (len) as i64 })
        if uei >= 0
            *align = user_enum_align(s.mono.pctx, uei)   # 1 unless a repr enum (#1797, #4574)
            return user_enum_size(s, uei)
        if is_enum_type(s.mono.pctx, StrView { ptr: (name), len: (len) as i64 }) == 1
            return 1   # generic user enum: unmeasured, tag only
        return 0
    if st.type_params != null
        return 0
    *align = get_struct_align_by_name(s, StrView { ptr: (name), len: (len) as i64 })
    get_struct_size_by_name(s, StrView { ptr: (name), len: (len) as i64 })

# Payload byte count N of tagged enum `name`, with the padding between the
# tag and the payload written to *pad.  See the block comment above.
pub fn tagged_enum_layout(s: *EmitterState, name_sv: StrView, pad: *i64) -> i64
    var name: *u8 = name_sv.ptr
    var len: i32 = name_sv.len as i32
    *pad = 7
    var t_len: i32 = 0
    let t: *u8 = tagged_enum_arg(s, StrView { ptr: (name), len: (len) as i64 }, 0, @t_len)
    if t == null
        return TAGGED_ENUM_FALLBACK_BYTES
    var align: i64 = 1
    var size: i64 = mangled_type_size_align(s, StrView { ptr: (t), len: (t_len) as i64 }, @align)
    if size == 0 and is_unit_arg(StrView { ptr: (t), len: (t_len) as i64 }) == 0
        return TAGGED_ENUM_FALLBACK_BYTES
    if name_eq(StrView { ptr: (name), len: (6) as i64 }, StrView { ptr: (c"Result"), len: (6) as i64 }) == 1
        var e_len: i32 = 0
        let e: *u8 = tagged_enum_arg(s, StrView { ptr: (name), len: (len) as i64 }, 1, @e_len)
        if e == null
            return TAGGED_ENUM_FALLBACK_BYTES
        var e_align: i64 = 1
        let e_size: i64 = mangled_type_size_align(s, StrView { ptr: (e), len: (e_len) as i64 }, @e_align)
        if e_size == 0 and is_unit_arg(StrView { ptr: (e), len: (e_len) as i64 }) == 0
            return TAGGED_ENUM_FALLBACK_BYTES
        if e_size > size
            size = e_size
        if e_align > align
            align = e_align
    *pad = (align - (1 % align)) % align
    size

# =============================================================================
# User-enum layout (AGAST #1797) — ritz0's _define_enum, as for Result/Option:
#
#     %Opt = type { i8 tag, [pad x i8], [N x i8] payload }
#
# N is the largest variant payload, pad aligns it to the most-aligned one.
# A variant's payload is its fields laid out like a struct's (each at its
# own alignment, the total rounded up to the strictest), ritz0's
# _enum_variant_field_layout.  `enum Opt / Vacant / Holds(i32)` is
# { i8, [3 x i8], [4 x i8] }.  As for tagged enums, ritz1 always writes the
# pad field (`[0 x i8]` when nothing needs aligning) so the payload is field
# 2; a zero-length array adds no bytes and no ABI element, so ritz0's
# `{ i8, [N x i8] }` is the same type at a call boundary.  An enum with no
# payload at all stays `{ i8 }`.
#
# Only non-generic enums are measured: a generic `enum Slot<T>` records `T`
# unsubstituted.  (ritzlib's Option / Result are generic and take the
# tagged-enum path above.)
# =============================================================================

# AGAST #2453: a let's type a bare constructor can build: an Option / Result,
# or a user enum, whose `Ok(5)` / `Some(5)` is its own variant
# (users_variant_wins).  resolve_enum_ctx still takes only the builtins.
pub fn is_ctor_slot_enum(ctx: *ParseCtx, name_sv: StrView) -> i32
    var name: *u8 = name_sv.ptr
    var len: i32 = name_sv.len as i32
    if is_tagged_enum_type(StrView { ptr: (name), len: (len) as i64 }) == 1
        return 1
    if user_enum_index(ctx, StrView { ptr: (name), len: (len) as i64 }) >= 0
        return 1
    0

# Size and alignment (written to *align) of one payload field `f`, as a
# struct field is laid out: an array at its element's, anything else at its
# type's.
fn payload_field_size_align(s: *EmitterState, f: *StructField, align: *i64) -> i64
    var falign: i64 = 8
    var fsize: i64 = 8
    if f.field_type == TypeKind.Array
        fsize = field_array_size_align(s, f, @falign)
    else
        fsize = elem_size_align(s, f.field_type, StrView { ptr: (f.field_type_name), len: (f.field_type_name_len) as i64 }, @falign)
    if falign < 1
        falign = 1
    *align = falign
    fsize

# Size of one variant's payload fields, laid out in declaration order at
# their natural alignment and rounded up to the strictest (written to
# *align).  0 for a unit variant.
fn variant_payload_size_align(s: *EmitterState, fields: *StructField, align: *i64) -> i64
    var offset: i64 = 0
    var max_align: i64 = 1
    var f: *StructField = fields
    while f != null
        var falign: i64 = 1
        let fsize: i64 = payload_field_size_align(s, f, @falign)
        let rem: i64 = offset % falign
        if rem != 0
            offset = offset + (falign - rem)
        offset = offset + fsize
        if falign > max_align
            max_align = falign
        f = f.next
    let rem2: i64 = offset % max_align
    if rem2 != 0
        offset = offset + (max_align - rem2)
    *align = max_align
    offset

# AGAST #1295: the byte offset of field `k` within a variant's payload, laid
# out exactly as variant_payload_size_align lays it out (ritz0's
# _enum_variant_field_layout).  Construction and binding both take it from
# here, so they cannot disagree on where a field lives.
fn variant_field_offset(s: *EmitterState, fields: *StructField, k: i32) -> i64
    var offset: i64 = 0
    var i: i32 = 0
    var f: *StructField = fields
    while f != null
        var falign: i64 = 1
        let fsize: i64 = payload_field_size_align(s, f, @falign)
        let rem: i64 = offset % falign
        if rem != 0
            offset = offset + (falign - rem)
        if i == k
            return offset
        offset = offset + fsize
        i += 1
        f = f.next
    offset

# Payload byte count N of user enum `ei`, the tag-to-payload padding written
# to *pad.  0 (and pad 0) when no variant carries a payload.
pub fn user_enum_layout(s: *EmitterState, ei: i32, pad: *i64) -> i64
    *pad = 0
    var max_size: i64 = 0
    var max_align: i64 = 1
    let count: i32 = enum_variant_count(s.mono.pctx, ei)
    for vi in 0..count
        var a: i64 = 1
        let sz: i64 = variant_payload_size_align(s, enum_variant_fields(s.mono.pctx, ei, vi), @a)
        if sz > max_size
            max_size = sz
        if a > max_align
            max_align = a
    if max_size > 0
        *pad = (max_align - (1 % max_align)) % max_align
    max_size

# Total byte size of user enum `ei`: a tag-only enum is its tag, 1 byte or
# its repr type's size (AGAST #4574).
pub fn user_enum_size(s: *EmitterState, ei: i32) -> i64
    var pad: i64 = 0
    let n: i64 = user_enum_layout(s, ei, @pad)
    if n == 0
        return enum_tag_size(s.mono.pctx, ei)
    1 + pad + n

# Field 0 of the enum named `name_sv` (AGAST #4574): its LLVM type, and
# the value variant index `vi` stores there -- the repr type and the
# discriminant for an `enum E: <int>`, else i8 and the index (Option /
# Result and generic instances included).
pub fn enum_tag_ty_named(ctx: *ParseCtx, name_sv: StrView) -> *u8
    let ei: i32 = user_enum_index(ctx, name_sv)
    if ei < 0
        return IR_TY_I8
    enum_tag_llvm(ctx, ei)

pub fn enum_tag_value_named(ctx: *ParseCtx, name_sv: StrView, vi: i32) -> i64
    let ei: i32 = user_enum_index(ctx, name_sv)
    if ei < 0
        return vi as i64
    enum_tag_value(ctx, ei, vi)

# Alignment of user enum `ei`: its repr type's for `enum E: <int>`
# (AGAST #4574), else 1 (an all-i8 struct, #1797).
pub fn user_enum_align(ctx: *ParseCtx, ei: i32) -> i64
    enum_tag_size(ctx, ei)

# Field count of variant `vi` of user enum `ei` (0 for a unit variant).
pub fn enum_variant_field_count(ctx: *ParseCtx, ei: i32, vi: i32) -> i32
    var n: i32 = 0
    var f: *StructField = enum_variant_fields(ctx, ei, vi)
    while f != null
        n += 1
        f = f.next
    n

# AGAST #1295: byte offset of the payload field `sel` names within the
# payload buffer: 0 for field 0, for Result / Option and for anything not a
# user enum's variant.
pub fn variant_sel_offset(s: *EmitterState, name_sv: StrView, sel: i32) -> i64
    var name: *u8 = name_sv.ptr
    var len: i32 = name_sv.len as i32
    if sel < VARIANT_FIELD_STRIDE
        return 0
    let ei: i32 = user_enum_index(s.mono.pctx, StrView { ptr: (name), len: (len) as i64 })
    if ei < 0
        return 0
    let vi: i32 = sel % VARIANT_FIELD_STRIDE
    if vi >= enum_variant_count(s.mono.pctx, ei)
        return 0
    variant_field_offset(s, enum_variant_fields(s.mono.pctx, ei, vi), sel / VARIANT_FIELD_STRIDE)

# AGAST #1295: a pointer to the payload field `sel` names in the enum at
# `slot_reg`: field 2 (the `[N x i8]` buffer, AGAST #1898), then the field's
# byte offset into it.  The buffer is reached by GEP over the enum struct
# and then by an `i8` GEP, never a single index on the array (the stride
# trap of ENUM_VARIANTS.md section 3.3).
pub fn emit_payload_ptr(s: *EmitterState, slot_reg: i32, name_sv: StrView, sel: i32) -> i32
    var name: *u8 = name_sv.ptr
    var len: i32 = name_sv.len as i32
    let pay_ptr: i32 = next_reg(s)
    emit_str(s, IR_INDENT)
    emit_reg(s, pay_ptr)
    emit_str(s, IR_GEP_NAMED)
    emit_name(s, StrView { ptr: (name), len: (len) as i64 })
    emit_str(s, IR_PTR_SEP)
    emit_reg(s, slot_reg)
    emit_str(s, c", i32 0, i32 2\n")
    let off: i64 = variant_sel_offset(s, StrView { ptr: (name), len: (len) as i64 }, sel)
    if off == 0
        return pay_ptr
    let fld: i32 = next_reg(s)
    emit_str(s, IR_INDENT)
    emit_reg(s, fld)
    emit_str(s, c" = getelementptr i8, ptr ")
    emit_reg(s, pay_ptr)
    emit_str(s, IR_I64_SEP)
    emit_int(s, off)
    emit_str(s, IR_NL)
    fld

# Integer width in bits of a scalar payload narrower than i64 — the width it
# is stored at, as ritz0 does — with *signed set for sign- vs zero-extension
# back to ritz1's i64 registers.  64 for i64 / pointers / anything else (the
# i64 store / load ritz1 has always done).  For a user enum (#1797)
# `variant` is the tag of a tuple variant; for Result/Option it is 0 for
# Ok / Some, 1 for Err.
pub fn tagged_enum_scalar_bits(s: *EmitterState, name_sv: StrView, variant: i32, signed: *i32) -> i32
    var name: *u8 = name_sv.ptr
    var len: i32 = name_sv.len as i32
    *signed = 1
    if is_tagged_enum_type(StrView { ptr: (name), len: (len) as i64 }) == 0
        let uf: *StructField = user_enum_tuple_field(s.mono.pctx, StrView { ptr: (name), len: (len) as i64 }, variant)
        if uf == null
            return 64
        return type_code_scalar_bits(uf.field_type, signed)
    var c_len: i32 = 0
    let c: *u8 = tagged_enum_arg(s, StrView { ptr: (name), len: (len) as i64 }, variant, @c_len)
    if c == null
        return 64
    if name_eq(StrView { ptr: (c), len: (c_len) as i64 }, StrView { ptr: (c"i8"), len: (2) as i64 }) == 1
        return 8
    if name_eq(StrView { ptr: (c), len: (c_len) as i64 }, StrView { ptr: (c"i16"), len: (3) as i64 }) == 1
        return 16
    if name_eq(StrView { ptr: (c), len: (c_len) as i64 }, StrView { ptr: (c"i32"), len: (3) as i64 }) == 1
        return 32
    *signed = 0
    if name_eq(StrView { ptr: (c), len: (c_len) as i64 }, StrView { ptr: (c"u8"), len: (2) as i64 }) == 1 or name_eq(StrView { ptr: (c), len: (c_len) as i64 }, StrView { ptr: (c"bool"), len: (4) as i64 }) == 1
        return 8
    if name_eq(StrView { ptr: (c), len: (c_len) as i64 }, StrView { ptr: (c"u16"), len: (3) as i64 }) == 1
        return 16
    if name_eq(StrView { ptr: (c), len: (c_len) as i64 }, StrView { ptr: (c"u32"), len: (3) as i64 }) == 1
        return 32
    *signed = 1
    64

# AGAST #3116: the type code of `variant`'s payload (as for
# tagged_enum_scalar_bits) when it is an integer narrower than i64, so a match
# binding of it is that type, as a `let v: u8` is: `Full(v)` over `Slot<u8>`
# was an i64, `sizeof(v)` 8 and `v + v` unwrapped.  0 for anything else: i64,
# bool, a float, a pointer, an aggregate.
pub fn tagged_enum_narrow_int_type(s: *EmitterState, name_sv: StrView, variant: i32) -> TypeKind
    var name: *u8 = name_sv.ptr
    var len: i32 = name_sv.len as i32
    let t: TypeKind = tagged_enum_int_type(s, StrView { ptr: (name), len: (len) as i64 }, variant)
    if ty_int_bits(t) == 64
        return TypeKind.Void
    t

# AGAST #3345: the payload's integer type, i64 / u64 included, else 0.  What
# the payload binding is to the lossy-conversion check (float_slot.ritz).
pub fn tagged_enum_int_type(s: *EmitterState, name_sv: StrView, variant: i32) -> TypeKind
    var name: *u8 = name_sv.ptr
    var len: i32 = name_sv.len as i32
    tagged_enum_int_type_in(s.mono.pctx, @s.struct_map, s.module, StrView { ptr: (name), len: (len) as i64 }, variant)

# tagged_enum_int_type over a struct map of `m`: Sema's narrowing check reads
# a match binding's payload type with it (AGAST #3505).
pub fn tagged_enum_int_type_in(ctx: *ParseCtx, structs: *HashMapI64, m: *Module, name_sv: StrView, variant: i32) -> TypeKind
    var name: *u8 = name_sv.ptr
    var len: i32 = name_sv.len as i32
    var t: TypeKind = TypeKind.Void
    if is_tagged_enum_type(StrView { ptr: (name), len: (len) as i64 }) == 0
        let uf: *StructField = user_enum_tuple_field(ctx, StrView { ptr: (name), len: (len) as i64 }, variant)
        if uf == null or uf.array_size != 0
            return TypeKind.Void
        t = uf.field_type
    else
        var c_len: i32 = 0
        let c: *u8 = tagged_enum_arg_in(ctx, structs, m, StrView { ptr: (name), len: (len) as i64 }, variant, @c_len)
        if c == null
            return TypeKind.Void
        if name_eq(StrView { ptr: (c), len: (c_len) as i64 }, StrView { ptr: (c"i8"), len: (2) as i64 }) == 1
            t = TypeKind.I8
        else if name_eq(StrView { ptr: (c), len: (c_len) as i64 }, StrView { ptr: (c"u8"), len: (2) as i64 }) == 1
            t = TypeKind.U8
        else if name_eq(StrView { ptr: (c), len: (c_len) as i64 }, StrView { ptr: (c"i16"), len: (3) as i64 }) == 1
            t = TypeKind.I16
        else if name_eq(StrView { ptr: (c), len: (c_len) as i64 }, StrView { ptr: (c"u16"), len: (3) as i64 }) == 1
            t = TypeKind.U16
        else if name_eq(StrView { ptr: (c), len: (c_len) as i64 }, StrView { ptr: (c"i32"), len: (3) as i64 }) == 1
            t = TypeKind.I32
        else if name_eq(StrView { ptr: (c), len: (c_len) as i64 }, StrView { ptr: (c"u32"), len: (3) as i64 }) == 1
            t = TypeKind.U32
        else if name_eq(StrView { ptr: (c), len: (c_len) as i64 }, StrView { ptr: (c"i64"), len: (3) as i64 }) == 1
            t = TypeKind.I64
        else if name_eq(StrView { ptr: (c), len: (c_len) as i64 }, StrView { ptr: (c"u64"), len: (3) as i64 }) == 1
            t = TypeKind.U64
    if ty_int_in(t, 8, 32) == 1
        return t
    if ty_int_bits(t) == 64
        return t
    TypeKind.Void

# AGAST #1945: TypeKind.F32 / TypeKind.F64 when the payload of `variant` (as for
# tagged_enum_scalar_bits) is a float, else 0.  Float payloads are stored and
# loaded as float / double, as ritz0 does, never through the i64 path.
pub fn tagged_enum_float_type(s: *EmitterState, name_sv: StrView, variant: i32) -> TypeKind
    var name: *u8 = name_sv.ptr
    var len: i32 = name_sv.len as i32
    if is_tagged_enum_type(StrView { ptr: (name), len: (len) as i64 }) == 0
        let uf: *StructField = user_enum_tuple_field(s.mono.pctx, StrView { ptr: (name), len: (len) as i64 }, variant)
        if uf == null
            return TypeKind.Void
        if uf.field_type == TypeKind.F32 or uf.field_type == TypeKind.F64
            return uf.field_type
        return TypeKind.Void
    var c_len: i32 = 0
    let c: *u8 = tagged_enum_arg(s, StrView { ptr: (name), len: (len) as i64 }, variant, @c_len)
    if c == null
        return TypeKind.Void
    if name_eq(StrView { ptr: (c), len: (c_len) as i64 }, StrView { ptr: (c"f32"), len: (3) as i64 }) == 1
        return TypeKind.F32
    if name_eq(StrView { ptr: (c), len: (c_len) as i64 }, StrView { ptr: (c"f64"), len: (3) as i64 }) == 1
        return TypeKind.F64
    TypeKind.Void

# The LLVM spelling of float type code `t` (TypeKind.F32 or TypeKind.F64).
pub fn float_llvm_name(t: TypeKind) -> *u8
    if t == TypeKind.F32
        return c"float"
    c"double"

# Convert register `val`, of expression type `src_ty`, to float type `dst_ty`
# (TypeKind.F32 / TypeKind.F64): passthrough, fptrunc, fpext, or sitofp from the i64
# every integer is carried in.  Returns the converted register.
pub fn emit_float_coerce(s: *EmitterState, val: i32, src_ty: TypeKind, dst_ty: TypeKind) -> i32
    if src_ty == dst_ty
        return val
    let r: i32 = next_reg(s)
    emit_str(s, IR_INDENT)
    emit_reg(s, r)
    if src_ty == TypeKind.F64 and dst_ty == TypeKind.F32
        emit_str(s, c" = fptrunc double ")
    else if src_ty == TypeKind.F32 and dst_ty == TypeKind.F64
        emit_str(s, c" = fpext float ")
    else
        emit_str(s, c" = sitofp i64 ")
    emit_reg(s, val)
    emit_str(s, IR_TO_SP)
    emit_str(s, float_llvm_name(dst_ty))
    emit_str(s, IR_NL)
    r

# `val_reg`, the i64 register integer expression `value` was emitted into,
# converted for an f32 / f64 slot of type `dst_ty`: by `uitofp` when `unsigned`
# (the source type is an unsigned integer exact there: u8 / u16 / u32 sit
# zero-extended in their i64 register), else by `sitofp`.  Returns the
# converted register.
# AGAST #4376: moved here from float_slot.ritz, which is Sema's and imports no
# emitter module.  Its callers pass float_slot_unsigned(value) for `unsigned`.
pub fn emit_int_into_float_slot(s: *EmitterState, val_reg: i32, unsigned: i32, dst_ty: TypeKind) -> i32
    if unsigned == 0
        return emit_float_coerce(s, val_reg, TypeKind.I64, dst_ty)
    let r: i32 = next_reg(s)
    emit_str(s, IR_INDENT)
    emit_reg(s, r)
    emit_str(s, c" = uitofp i64 ")
    emit_reg(s, val_reg)
    emit_str(s, IR_TO_SP)
    emit_str(s, float_llvm_name(dst_ty))
    emit_str(s, IR_NL)
    r


# `<dst> = load i<bits>, ptr <pay_ptr>` widened to i64 for a scalar payload
# of `variant`; returns the i64 register.  See tagged_enum_scalar_bits.
pub fn emit_tagged_payload_load(s: *EmitterState, pay_ptr: i32, name_sv: StrView, variant: i32) -> i32
    var name: *u8 = name_sv.ptr
    var len: i32 = name_sv.len as i32
    # AGAST #1945: a float payload loads as float / double, unwidened.
    let ft: TypeKind = tagged_enum_float_type(s, StrView { ptr: (name), len: (len) as i64 }, variant)
    if ft != TypeKind.Void
        let fr: i32 = next_reg(s)
        emit_str(s, IR_INDENT)
        emit_reg(s, fr)
        emit_str(s, IR_LOAD)
        emit_str(s, float_llvm_name(ft))
        emit_str(s, IR_PTR_SEP)
        emit_reg(s, pay_ptr)
        emit_str(s, IR_NL)
        return fr
    var signed: i32 = 1
    let bits: i32 = tagged_enum_scalar_bits(s, StrView { ptr: (name), len: (len) as i64 }, variant, @signed)
    let r: i32 = next_reg(s)
    emit_str(s, IR_INDENT)
    emit_reg(s, r)
    emit_str(s, c" = load i")
    emit_int(s, bits as i64)
    emit_str(s, IR_PTR_SEP)
    emit_reg(s, pay_ptr)
    emit_str(s, IR_NL)
    if bits == 64
        return r
    let w: i32 = next_reg(s)
    emit_str(s, IR_INDENT)
    emit_reg(s, w)
    if signed == 1
        emit_str(s, c" = sext i")
    else
        emit_str(s, c" = zext i")
    emit_int(s, bits as i64)
    emit_str(s, IR_SP)
    emit_reg(s, r)
    emit_str(s, IR_TO_I64)
    w

# `store i<bits>` of the i64 register `val` into a scalar payload of
# `variant`, truncating first when the payload is narrower.
pub fn emit_tagged_payload_store(s: *EmitterState, val: i32, pay_ptr: i32, name_sv: StrView, variant: i32)
    var name: *u8 = name_sv.ptr
    var len: i32 = name_sv.len as i32
    # AGAST #1945: a float payload stores as float / double; `val` must
    # already be of that type (see emit_float_coerce).
    let ft: TypeKind = tagged_enum_float_type(s, StrView { ptr: (name), len: (len) as i64 }, variant)
    if ft != TypeKind.Void
        emit_str(s, IR_STORE_IND)
        emit_str(s, float_llvm_name(ft))
        emit_str(s, IR_SP)
        emit_reg(s, val)
        emit_str(s, IR_PTR_SEP)
        emit_reg(s, pay_ptr)
        emit_str(s, IR_NL)
        return
    var signed: i32 = 1
    let bits: i32 = tagged_enum_scalar_bits(s, StrView { ptr: (name), len: (len) as i64 }, variant, @signed)
    var v: i32 = val
    if bits != 64
        v = next_reg(s)
        emit_str(s, IR_INDENT)
        emit_reg(s, v)
        emit_str(s, IR_TRUNC)
        emit_reg(s, val)
        emit_str(s, c" to i")
        emit_int(s, bits as i64)
        emit_str(s, IR_NL)
    emit_str(s, c"  store i")
    emit_int(s, bits as i64)
    emit_str(s, IR_SP)
    emit_reg(s, v)
    emit_str(s, IR_PTR_SEP)
    emit_reg(s, pay_ptr)
    emit_str(s, IR_NL)

# Emit LLVM type with struct name support.  Tagged-enum types emit as the
# named struct so variant constructors / match / return paths share the same
# declared layout.

# Emit the LLVM `<N x iM>` syntax for a SIMD vector type name.  Caller must
# ensure `is_simd_vector_type_name(name, len) == 1` first.
pub fn emit_simd_vector_type(s: *EmitterState, name_sv: StrView)
    var name: *u8 = name_sv.ptr
    var len: i32 = name_sv.len as i32
    if name_eq(StrView { ptr: (name), len: (len) as i64 }, StrView { ptr: (c"v16i8"), len: (5) as i64 }) == 1
        emit_str(s, c"<16 x i8>")
    else if name_eq(StrView { ptr: (name), len: (len) as i64 }, StrView { ptr: (c"v8i16"), len: (5) as i64 }) == 1
        emit_str(s, c"<8 x i16>")
    else if name_eq(StrView { ptr: (name), len: (len) as i64 }, StrView { ptr: (c"v4i32"), len: (5) as i64 }) == 1
        emit_str(s, c"<4 x i32>")
    else if name_eq(StrView { ptr: (name), len: (len) as i64 }, StrView { ptr: (c"v2i64"), len: (5) as i64 }) == 1
        emit_str(s, c"<2 x i64>")
    else if name_eq(StrView { ptr: (name), len: (len) as i64 }, StrView { ptr: (c"v32i8"), len: (5) as i64 }) == 1
        emit_str(s, c"<32 x i8>")
    else if name_eq(StrView { ptr: (name), len: (len) as i64 }, StrView { ptr: (c"v16i16"), len: (6) as i64 }) == 1
        emit_str(s, c"<16 x i16>")
    else if name_eq(StrView { ptr: (name), len: (len) as i64 }, StrView { ptr: (c"v8i32"), len: (5) as i64 }) == 1
        emit_str(s, c"<8 x i32>")
    else if name_eq(StrView { ptr: (name), len: (len) as i64 }, StrView { ptr: (c"v4i64"), len: (5) as i64 }) == 1
        emit_str(s, c"<4 x i64>")

# Element bit width for a SIMD vector type — used by `simd_rotl` to compute
# the wrap-around shift constants.  Returns 0 for non-SIMD names.
pub fn simd_vector_elem_bits(name_sv: StrView) -> i32
    var name: *u8 = name_sv.ptr
    var len: i32 = name_sv.len as i32
    if name_eq(StrView { ptr: (name), len: (len) as i64 }, StrView { ptr: (c"v16i8"), len: (5) as i64 }) == 1
        return 8
    if name_eq(StrView { ptr: (name), len: (len) as i64 }, StrView { ptr: (c"v8i16"), len: (5) as i64 }) == 1
        return 16
    if name_eq(StrView { ptr: (name), len: (len) as i64 }, StrView { ptr: (c"v4i32"), len: (5) as i64 }) == 1
        return 32
    if name_eq(StrView { ptr: (name), len: (len) as i64 }, StrView { ptr: (c"v2i64"), len: (5) as i64 }) == 1
        return 64
    if name_eq(StrView { ptr: (name), len: (len) as i64 }, StrView { ptr: (c"v32i8"), len: (5) as i64 }) == 1
        return 8
    if name_eq(StrView { ptr: (name), len: (len) as i64 }, StrView { ptr: (c"v16i16"), len: (6) as i64 }) == 1
        return 16
    if name_eq(StrView { ptr: (name), len: (len) as i64 }, StrView { ptr: (c"v8i32"), len: (5) as i64 }) == 1
        return 32
    if name_eq(StrView { ptr: (name), len: (len) as i64 }, StrView { ptr: (c"v4i64"), len: (5) as i64 }) == 1
        return 64
    0

# Element count for a SIMD vector type — used by `simd_rotl` to broadcast
# constant shift amounts.
pub fn simd_vector_elem_count(name_sv: StrView) -> i32
    var name: *u8 = name_sv.ptr
    var len: i32 = name_sv.len as i32
    if name_eq(StrView { ptr: (name), len: (len) as i64 }, StrView { ptr: (c"v16i8"), len: (5) as i64 }) == 1
        return 16
    if name_eq(StrView { ptr: (name), len: (len) as i64 }, StrView { ptr: (c"v8i16"), len: (5) as i64 }) == 1
        return 8
    if name_eq(StrView { ptr: (name), len: (len) as i64 }, StrView { ptr: (c"v4i32"), len: (5) as i64 }) == 1
        return 4
    if name_eq(StrView { ptr: (name), len: (len) as i64 }, StrView { ptr: (c"v2i64"), len: (5) as i64 }) == 1
        return 2
    if name_eq(StrView { ptr: (name), len: (len) as i64 }, StrView { ptr: (c"v32i8"), len: (5) as i64 }) == 1
        return 32
    if name_eq(StrView { ptr: (name), len: (len) as i64 }, StrView { ptr: (c"v16i16"), len: (6) as i64 }) == 1
        return 16
    if name_eq(StrView { ptr: (name), len: (len) as i64 }, StrView { ptr: (c"v8i32"), len: (5) as i64 }) == 1
        return 8
    if name_eq(StrView { ptr: (name), len: (len) as i64 }, StrView { ptr: (c"v4i64"), len: (5) as i64 }) == 1
        return 4
    0

# Element scalar LLVM type ("i8"/"i16"/"i32"/"i64") for a SIMD vector name —
# used for extractelement/insertelement opcodes.
pub fn emit_simd_elem_type(s: *EmitterState, name_sv: StrView)
    var name: *u8 = name_sv.ptr
    var len: i32 = name_sv.len as i32
    let bits: i32 = simd_vector_elem_bits(StrView { ptr: (name), len: (len) as i64 })
    if bits == 8
        emit_str(s, c"i8")
    else if bits == 16
        emit_str(s, c"i16")
    else if bits == 32
        emit_str(s, c"i32")
    else if bits == 64
        emit_str(s, c"i64")

pub fn emit_llvm_type_struct(s: *EmitterState, t: TypeKind, name_sv: StrView)
    var name: *u8 = name_sv.ptr
    var name_len: i32 = name_sv.len as i32
    if t == TypeKind.Struct
        # Post-monomorphization (and pre-monomorph for explicit primitive
        # type annotations like `let x: f32`), TypeKind.Struct + name="u16"/
        # "f32"/"i32"/etc. flows through this helper. The parser doesn't
        # have dedicated tokens for primitive types — they're parsed as
        # generic struct-name annotations. Map them back to LLVM
        # primitives so signatures/calls match.
        let prim: TypeKind = ty_from_name(StrView { ptr: (name), len: (name_len) as i64 })
        if prim != TypeKind.Void
            emit_str(s, ty_mem_llvm(prim))
            return
        if name_eq(StrView { ptr: (name), len: (name_len) as i64 }, StrView { ptr: (c"void"), len: (4) as i64 }) == 1
            # `-> void` parses as TypeKind.Struct with name "void" because the
            # parser uses the generic type-name slot for unknown names.
            # cryptosec.aes / cryptosec.aes_gcm have `pub fn foo(...) -> void`
            # — without this branch we emit `%void = type { i8 }` and
            # `ret void` mismatches the function signature.
            emit_str(s, c"void")
            return
        # AGAST #167: SIMD vector types (`v4i32`, `v16i8`, etc) lower to
        # native LLVM `<N x iM>` rather than the named-struct fallback.
        # Without this, `let v: v4i32 = simd_loadu(...)` allocas a bogus
        # `%v4i32 = type { i8 }` and stores type-mismatch the call result.
        if is_simd_vector_type_name(StrView { ptr: (name), len: (name_len) as i64 }) == 1
            emit_simd_vector_type(s, StrView { ptr: (name), len: (name_len) as i64 })
            return
        emit_str(s, IR_PCT)
        emit_name(s, StrView { ptr: (name), len: (name_len) as i64 })
    else
        emit_str(s, ty_value_llvm(t))

# =============================================================================
# AGAST #168: layout-equivalence coercion for Span$u8 ↔ StrView.
#
# Both have identical LLVM layout `{ ptr, i64 }` but are nominally distinct
# named struct types — LLVM IR rejects `store %A, ptr <%B-typed slot>`.
# A bare string literal `"..."` lowers to `%Span$u8`, but `let x: StrView = "..."`
# allocates a `%StrView` slot.  We emit a decompose-and-rebuild
# (extractvalue + insertvalue) on each store/assign/return whose source name
# disagrees with the destination name.
# =============================================================================

# Returns 1 if (src_name, dst_name) is the StrView↔Span$u8 layout-equivalent
# pair (in either direction), else 0.  Names of zero length / null pointers
# return 0.
pub fn is_layout_equiv_pair(src_name_sv: StrView, dst_name_sv: StrView) -> i32
    var src_name: *u8 = src_name_sv.ptr
    var src_len: i32 = src_name_sv.len as i32
    var dst_name: *u8 = dst_name_sv.ptr
    var dst_len: i32 = dst_name_sv.len as i32
    if src_name == null
        return 0
    if dst_name == null
        return 0
    if src_len == 0
        return 0
    if dst_len == 0
        return 0
    let src_is_span_u8: i32 = name_eq(StrView { ptr: (src_name), len: (src_len) as i64 }, StrView { ptr: (c"Span$u8"), len: (7) as i64 })
    let src_is_strview: i32 = name_eq(StrView { ptr: (src_name), len: (src_len) as i64 }, StrView { ptr: (c"StrView"), len: (7) as i64 })
    let dst_is_span_u8: i32 = name_eq(StrView { ptr: (dst_name), len: (dst_len) as i64 }, StrView { ptr: (c"Span$u8"), len: (7) as i64 })
    let dst_is_strview: i32 = name_eq(StrView { ptr: (dst_name), len: (dst_len) as i64 }, StrView { ptr: (c"StrView"), len: (7) as i64 })
    if src_is_span_u8 == 1 and dst_is_strview == 1
        return 1
    if src_is_strview == 1 and dst_is_span_u8 == 1
        return 1
    0

# Decompose `%src_name { ptr, i64 }` and rebuild as `%dst_name { ptr, i64 }`.
# Caller must verify is_layout_equiv_pair == 1 before invoking.  Returns
# the register holding the rebuilt aggregate.
pub fn rebuild_layout_equiv(s: *EmitterState, src_reg: i32, src_name_sv: StrView, dst_name_sv: StrView) -> i32
    var src_name: *u8 = src_name_sv.ptr
    var src_len: i32 = src_name_sv.len as i32
    var dst_name: *u8 = dst_name_sv.ptr
    var dst_len: i32 = dst_name_sv.len as i32
    let p: i32 = next_reg(s)
    emit_str(s, IR_INDENT)
    emit_reg(s, p)
    emit_str(s, c" = extractvalue %")
    emit_name(s, StrView { ptr: (src_name), len: (src_len) as i64 })
    emit_str(s, IR_SP)
    emit_reg(s, src_reg)
    emit_str(s, IR_COMMA_0)
    let l: i32 = next_reg(s)
    emit_str(s, IR_INDENT)
    emit_reg(s, l)
    emit_str(s, c" = extractvalue %")
    emit_name(s, StrView { ptr: (src_name), len: (src_len) as i64 })
    emit_str(s, IR_SP)
    emit_reg(s, src_reg)
    emit_str(s, IR_COMMA_1)
    let r1: i32 = next_reg(s)
    emit_str(s, IR_INDENT)
    emit_reg(s, r1)
    emit_str(s, c" = insertvalue %")
    emit_name(s, StrView { ptr: (dst_name), len: (dst_len) as i64 })
    emit_str(s, c" undef, ptr ")
    emit_reg(s, p)
    emit_str(s, IR_COMMA_0)
    let r2: i32 = next_reg(s)
    emit_str(s, IR_INDENT)
    emit_reg(s, r2)
    emit_str(s, c" = insertvalue %")
    emit_name(s, StrView { ptr: (dst_name), len: (dst_len) as i64 })
    emit_str(s, IR_SP)
    emit_reg(s, r1)
    emit_str(s, IR_I64_SEP)
    emit_reg(s, l)
    emit_str(s, IR_COMMA_1)
    r2

# =============================================================================
# AGAST #1730 — large struct returns go through an sret pointer
# =============================================================================
#
# ritz1 used to return every struct as a first-class LLVM aggregate
# (`%v = load %T, ptr %slot` / `ret %T %v`).  For a big struct such as the
# 22 KB %TokenDefs of the since-deleted ritzlib/lang/tokens.ritz (inline as
# TOKENDEFS in ritz0/test_ritz1_large_struct_ret.py), InstCombine at -O2 unpacks
# that load into one scalar per leaf (~21k) and clang grows past 13 GB.  Any
# first-class value of such a type does it — a call result stored to a
# local, or a load stored to the sret slot — so the only IR that stays fast
# copies the bytes from pointer to pointer.
#
# A function whose struct return is at least SRET_MIN_BYTES is therefore
# defined `define void @f(ptr sret(%T) %ret.sret, ...)`, every `ret` site
# copies into %ret.sret, and every call site passes a fresh `alloca %T`.
#
# The copy is NOT llvm.memcpy: at these sizes codegen lowers that intrinsic
# to a call to libc `memcpy`, and Ritz links -nostdlib.  It calls a
# module-internal byte loop instead (emit_sret_helpers), which carries
# "no-builtins" so loop-idiom recognition cannot turn it back into memcpy.
#
# This is ABI-identical to the first-class form ritz0 still emits: LLVM
# already demotes a first-class return that does not fit in the return
# registers to a hidden pointer in the first argument register, and returns
# that pointer, exactly as an explicit sret does.  256 bytes is far above
# the largest register return on any target LLVM supports (x86-64: 2 GPRs
# + 2 XMM; AArch64: 8 GPRs + 8 Q regs = 192 B), so objects from either
# compiler keep linking.  Below the threshold nothing changes.
const SRET_MIN_BYTES: i64 = 256

# AGAST #3668: LLVM's verifier refuses a `byval` type whose alloc size is
# 2^32 bytes or more ("huge 'byval' arguments are unsupported").  ritz1 wrote
# that IR and exited 0, so clang crashed later with no source location.
pub const BYVAL_MAX_BYTES: i64 = 4294967296

# The fixed text of the byval refusal message; the type is printed twice
# (AGAST #1820: no magic alloc sizes).
const BYVAL_MSG_BASE: i64 = 320

# AGAST #1466: the enum a qualified variant `E.V(args)` (ExprKind.Method) or
# `E.V` (ExprKind.Member) names.  Returns the enum index with *out_vi = the tag,
# or -1 when `e` is not one.  As in ritz0, a local or global named `E`
# shadows the enum (the expression is then a method call / field access on
# it), and a variant beats an impl method of the same name on the enum.
# Generic enums are returned too (callers check enum_is_generic: ritz1 has
# no generic-enum specialisation, so those are located errors).
pub fn qualified_variant(s: *EmitterState, e: *Expr, out_vi: *i32) -> i32
    *out_vi = 0 - 1
    if e == null or (e.kind != ExprKind.Method and e.kind != ExprKind.Member)
        return 0 - 1
    let q: *Expr = e.left
    if q == null or q.kind != ExprKind.Ident
        return 0 - 1
    if find_local(s, StrView { ptr: (q.ident_ptr), len: (q.ident_len) as i64 }) >= 0
        return 0 - 1
    if find_global(s, StrView { ptr: (q.ident_ptr), len: (q.ident_len) as i64 }) != null
        return 0 - 1
    let ei: i32 = enum_find(s.mono.pctx, StrView { ptr: (q.ident_ptr), len: (q.ident_len) as i64 })
    if ei < 0
        return 0 - 1
    let vi: i32 = enum_variant_index(s.mono.pctx, StrView { ptr: (q.ident_ptr), len: (q.ident_len) as i64 }, StrView { ptr: (e.ident_ptr), len: (e.ident_len) as i64 })
    if vi < 0
        return 0 - 1
    *out_vi = vi
    return ei

# AGAST #1466: the (non-generic) enum a qualified variant `E.V(args)` or
# `E.V` builds, for type inference (untyped let, match scrutinee, an
# aggregate payload).  null/0 otherwise.
pub fn qualified_variant_enum(s: *EmitterState, e: *Expr, out_name: **u8, out_len: *i32)
    *out_name = null
    *out_len = 0
    var vi: i32 = 0
    let ei: i32 = qualified_variant(s, e, @vi)
    if ei < 0 or enum_is_generic(s.mono.pctx, ei) == 1
        return
    *out_name = enum_name_at(s.mono.pctx, ei, out_len)

# AGAST #1466: a qualified variant ritz1 cannot build, as
# `<file>:<line>:<col>: error: 'E.V' <msg>`.  Counted like emit_ir_error, so
# no output is written; returns a placeholder register.  Also `'Span.empty'`
# with no slot to type it (AGAST #2296): any `Type.method` call fits.
pub fn emit_qualified_variant_error(s: *EmitterState, e: *Expr, msg: *u8) -> i32
    emit_qualified_variant_error_sv(s, e, strview_from_cstr(msg))

# AGAST #4759: emit_qualified_variant_error for a StrView message.
pub fn emit_qualified_variant_error_sv(s: *EmitterState, e: *Expr, msg: StrView) -> i32
    format_into(s, "  ; ERROR: qualified variant {msg}\n")
    diag_error_at(emitter_source_file(), e.span)
    eprints("'")
    eprint_bytes(StrView { ptr: e.left.ident_ptr, len: e.left.ident_len as i64 })
    eprints(".")
    eprint_bytes(StrView { ptr: e.ident_ptr, len: e.ident_len as i64 })
    eprints("' ")
    eprints(msg)
    eprints("\n")
    s.error_count = s.error_count + 1
    let z: i32 = next_reg(s)
    format_into(s, "  %.{z} = add i64 0, 0\n")
    z

# AGAST #2215: `q.n` is module access, which LANGUAGE_SPEC §15.3 removed,
# when `q` names no value or type in scope (a local, global, const, fn,
# struct, enum, built-in type or impl'd type) and `n` names a const, global
# or fn.  `E.V` and a value's `.field` are not.  ritz0: _is_module_item.
pub fn is_module_item(s: *EmitterState, q: *u8, ql: i32, n: *u8, nl: i32) -> i32
    if find_local(s, StrView { ptr: (q), len: (ql) as i64 }) >= 0 or find_global(s, StrView { ptr: (q), len: (ql) as i64 }) != null
        return 0
    if is_const(s, StrView { ptr: (q), len: (ql) as i64 }) == 1 or find_fn(s, StrView { ptr: (q), len: (ql) as i64 }) != null
        return 0
    if is_enum_type(s.mono.pctx, StrView { ptr: (q), len: (ql) as i64 }) == 1 or find_struct(s, StrView { ptr: (q), len: (ql) as i64 }) != null
        return 0
    if name_eq(StrView { ptr: (q), len: (ql) as i64 }, StrView { ptr: (c"Span"), len: (4) as i64 }) == 1 or name_eq(StrView { ptr: (q), len: (ql) as i64 }, StrView { ptr: (c"StrView"), len: (7) as i64 }) == 1
        return 0
    if name_eq(StrView { ptr: (q), len: (ql) as i64 }, StrView { ptr: (c"Option"), len: (6) as i64 }) == 1 or name_eq(StrView { ptr: (q), len: (ql) as i64 }, StrView { ptr: (c"Result"), len: (6) as i64 }) == 1
        return 0
    var ib: *ImplBlock = s.module.impls
    while ib != null
        if name_eq(StrView { ptr: (ib.type_name), len: (ib.type_name_len) as i64 }, StrView { ptr: (q), len: (ql) as i64 }) == 1
            return 0
        ib = ib.next
    if is_const(s, StrView { ptr: (n), len: (nl) as i64 }) == 1 or find_global(s, StrView { ptr: (n), len: (nl) as i64 }) != null or find_fn(s, StrView { ptr: (n), len: (nl) as i64 }) != null
        return 1
    0

# The error for module access `q.n` at line:col, worded as ritz0's
# module_item_access_removed (ritz0/qualified_access.py).  Counted like
# emit_ir_error, so no output is written.  Returns a dummy register.
pub fn emit_module_item_error(s: *EmitterState, q: *u8, ql: i32, n: *u8, nl: i32, line: i32, col: i32) -> i32
    emit_str(s, c"  ; ERROR: module.item access\n")
    diag_error_at(emitter_source_file(), diag_span(line, col))
    eprint_char('`')
    eprint_bytes(StrView { ptr: (q), len: (ql) as i64 })
    eprints(".")
    eprint_bytes(StrView { ptr: (n), len: (nl) as i64 })
    eprints("`: there is no `module.item` access (LANGUAGE_SPEC §15.3). ")
    eprints("Imported names share one namespace, so write `")
    eprint_bytes(StrView { ptr: (n), len: (nl) as i64 })
    eprints("`\n")
    s.error_count = s.error_count + 1
    let z: i32 = next_reg(s)
    emit_str(s, IR_INDENT)
    emit_reg(s, z)
    emit_str(s, IR_ADD_ZERO)
    z

# AGAST #1600 / #2039: `name` (a bare variant used as a value, or the callee
# of a ctor call) is a variant of two enums (`ea`, `eb`).  Whatever the
# expected type, this is a located error asking for the qualified form; ritz0
# prints the same text.  Counted like emit_ir_error, so no output is written;
# returns a placeholder register to keep the IR well-formed.
pub fn emit_ambiguous_variant_error(s: *EmitterState, name_sv: StrView, span: SrcSpan, ea: i32, eb: i32) -> i32
    var name: *u8 = name_sv.ptr
    var len: i32 = name_sv.len as i32
    var a_len: i32 = 0
    let a: *u8 = enum_name_at(s.mono.pctx, ea, @a_len)
    var b_len: i32 = 0
    let b: *u8 = enum_name_at(s.mono.pctx, eb, @b_len)
    emit_str(s, c"  ; ERROR: ambiguous enum variant '")
    emit_name(s, StrView { ptr: (name), len: (len) as i64 })
    emit_str(s, c"'\n")
    diag_error_at(emitter_source_file(), span)
    eprints("ambiguous enum variant '")
    eprint_bytes(StrView { ptr: (name), len: (len) as i64 })
    eprints("': declared by enum '")
    eprint_bytes(StrView { ptr: (a), len: (a_len) as i64 })
    eprints("' and enum '")
    eprint_bytes(StrView { ptr: (b), len: (b_len) as i64 })
    eprints("'; qualify it, e.g. '")
    eprint_bytes(StrView { ptr: (a), len: (a_len) as i64 })
    eprints(".")
    eprint_bytes(StrView { ptr: (name), len: (len) as i64 })
    eprints("'\n")
    s.error_count = s.error_count + 1
    let zero: i32 = next_reg(s)
    emit_str(s, IR_INDENT)
    emit_reg(s, zero)
    emit_str(s, IR_ADD_ZERO)
    return zero

# AGAST #4666: the struct a bare "..." lowers to: `Span$u8` (AGAST #98), or
# the layout-equal `StrView` when the program declares its own `Span<T>` of
# another layout, whose `Span$u8` a literal is not (ritz0: the program's Span
# shadows the builtin; a literal is a StrView there).
pub fn strlit_struct(s: *EmitterState) -> StrView
    let own: *StructDef = find_struct(s, "Span$u8")
    if own != null and view_layout_ok(own) == 0
        return "StrView"
    "Span$u8"

# The field of `st` the member `e` names; null when `st` is null or has no such
# field.  A field reached through `Deref` was rewritten to `(*S_deref(@s)).f`
# before this is asked (deref_field.ritz, AGAST #3015).
pub fn member_field_of(s: *EmitterState, st: *StructDef, e: *Expr) -> *StructField
    if st == null
        return null
    let fidx: i32 = find_field_index(st, StrView { ptr: (e.ident_ptr), len: (e.ident_len) as i64 })
    if fidx < 0
        return null
    return get_field_type(st, fidx)

# The base an index chain `e` indexes, with the number of indices in
# *out_depth: the innermost non-index operand, or (AGAST #4122) an element
# `a[k]` of a `[K]*[N][M]T` local, a plane pointer `a[k][i][j]` indexes.
pub fn nd_chain_base(s: *EmitterState, e: *Expr, out_depth: *i32) -> *Expr
    var depth: i32 = 0
    var base: *Expr = e
    while base.kind == ExprKind.Index and elem_plane_ptr_shape(s, base) == null
        depth = depth + 1
        base = base.left
    *out_depth = depth
    base

# AGAST #4122: 1 when the local `lv` holds a plane pointer's address, not the
# plane pointer: a `**[N][M]T` (#3635), an `@*[N][M]T` or an `@&*[N][M]T`.
# Only `*lv` is the plane pointer; its slot is loaded twice.
pub fn local_holds_plane_ptr(lv: *LocalVar) -> i32
    # A `let q = @x[i]` plane (#2570) is an `@[M*N]T` with a shape: its
    # pointee is the array, not a pointer.
    if lv_pointee_array_shape(lv) == null or lv_pointee_type(lv) != TypeKind.Ptr
        return 0
    if lv_var_type(lv) == TypeKind.PtrPtr or lv_var_type(lv) == TypeKind.Ref or lv_var_type(lv) == TypeKind.MutRef
        return 1
    0

# The ArrayShape of the local / global N-D array named `name`, or null.
pub fn nd_array_name_shape(s: *EmitterState, name_sv: StrView) -> *ArrayShape
    var name: *u8 = name_sv.ptr
    var len: i32 = name_sv.len as i32
    if name == null or len <= 0
        return null
    let lv: *LocalVar = find_local_struct_name(s, StrView { ptr: (name), len: (len) as i64 })
    if lv != null
        if lv_var_type(lv) == TypeKind.Array
            return lv_array_shape(lv)
        return null
    let glob: *GlobalVarDef = find_global(s, StrView { ptr: (name), len: (len) as i64 })
    if glob != null and glob.var_type == TypeKind.Array
        return glob.array_shape
    return null

# The same for an ExprKind.Ident `e` (null for any other expression).
pub fn nd_array_ident_shape(s: *EmitterState, e: *Expr) -> *ArrayShape
    if e == null or e.kind != ExprKind.Ident
        return null
    return nd_array_name_shape(s, StrView { ptr: (e.ident_ptr), len: (e.ident_len) as i64 })

# AGAST #4450: 1 when `name` is a user enum held as its own `%E` aggregate
# (`{ i8 }` for a fieldless one), the type unit_enum_expr_name answers;
# Option$ / Result$ carriers are not.
pub fn is_user_enum_name(ctx: *ParseCtx, name_sv: StrView) -> i32
    if name_sv.ptr == null or name_sv.len <= 0
        return 0
    if is_tagged_enum_type(name_sv) == 1
        return 0
    is_enum_type(ctx, name_sv)

# AGAST #4450: 1 when a `*T` / `[N]T` element named `name` is an aggregate
# loaded and stored whole as its `%T` and strode by sizeof(T): a struct
# find_struct knows, or a user enum.  The element paths gated on find_struct
# alone, so an enum element took the scalar arms: `p[i] = E.X` through a
# `*E` stored an i64 at an 8-byte stride.
pub fn is_elem_aggregate_name(s: *EmitterState, name_sv: StrView) -> i32
    if name_sv.ptr == null or name_sv.len <= 0
        return 0
    if find_struct(s, name_sv) != null
        return 1
    is_user_enum_name(s.mono.pctx, name_sv)

# Emit `  %.dst = load <ty>, ptr %.ptr` for a destination the site has
# already allocated with next_reg.  The instruction shape lives here rather
# than in emitter_ir.ritz's ir_load because the pointer operand must go
# through emit_reg: #4462 appends `, align 1` for a packed-derived register
# and #4461 notes a deferred load's use.  A leaf builder writing raw bytes
# would silently drop both, so the state-aware spelling is emitter_core's.
pub fn emit_load_into(s: *EmitterState, ty: *u8, dst: i32, ptr: i32)
    emit_str(s, IR_INDENT)
    emit_reg(s, dst)
    emit_str(s, IR_LOAD)
    emit_str(s, ty)
    emit_str(s, IR_PTR_SEP)
    emit_reg(s, ptr)
    emit_str(s, IR_NL)

# As emit_load_into, allocating the destination: `%.N = load <ty>, ptr %.ptr`.
pub fn emit_load_new(s: *EmitterState, ty: *u8, ptr: i32) -> i32
    let dst: i32 = next_reg(s)
    emit_load_into(s, ty, dst, ptr)
    dst

# Emit `  store <ty> %.val, ptr %.ptr`.
pub fn emit_store_typed(s: *EmitterState, ty: *u8, val: i32, ptr: i32)
    emit_str(s, IR_STORE_IND)
    emit_str(s, ty)
    emit_str(s, IR_SP)
    emit_reg(s, val)
    emit_str(s, IR_PTR_SEP)
    emit_reg(s, ptr)
    emit_str(s, IR_NL)

# Emit `  store <ty> <imm>, ptr %.ptr` (a constant store).
pub fn emit_store_imm(s: *EmitterState, ty: *u8, imm: i64, ptr: i32)
    emit_str(s, IR_STORE_IND)
    emit_str(s, ty)
    emit_str(s, IR_SP)
    emit_int(s, imm)
    emit_str(s, IR_PTR_SEP)
    emit_reg(s, ptr)
    emit_str(s, IR_NL)

# Emit `  %.dst = load <ty>, ptr @<name>` (a global's storage).
pub fn emit_load_global(s: *EmitterState, ty: *u8, dst: i32, name_sv: StrView)
    emit_str(s, IR_INDENT)
    emit_reg(s, dst)
    emit_str(s, IR_LOAD)
    emit_str(s, ty)
    emit_str(s, IR_PTR_SEP)
    emit_str(s, IR_AT)
    emit_name(s, name_sv)
    emit_str(s, IR_NL)

# Emit `  store <ty> %.val, ptr @<name>` (a global's storage).
pub fn emit_store_global(s: *EmitterState, ty: *u8, val: i32, name_sv: StrView)
    emit_str(s, IR_STORE_IND)
    emit_str(s, ty)
    emit_str(s, IR_SP)
    emit_reg(s, val)
    emit_str(s, IR_PTR_SEP)
    emit_str(s, IR_AT)
    emit_name(s, name_sv)
    emit_str(s, IR_NL)

# Emit `%result = load ptr, ptr %slot_reg` and return the new register index.
pub fn emit_load_ptr(s: *EmitterState, slot_reg: i32) -> i32
    emit_load_new(s, IR_TY_PTR, slot_reg)

# Emit `store ptr %val_reg, ptr %slot_reg`.
fn emit_store_ptr(s: *EmitterState, val_reg: i32, slot_reg: i32)
    emit_store_typed(s, IR_TY_PTR, val_reg, slot_reg)

# `text` as a string-table entry the emitter composed itself: copied into the
# heap (never freed: one module per process), since the table keeps the pointer
# for the whole module.
pub fn intern_string(s: *EmitterState, text: StrView) -> i32
    let copy: *u8 = malloc(text.len)
    memcpy(copy, text.ptr, text.len)
    add_string(s, StrView { ptr: copy, len: text.len })

pub fn add_string(s: *EmitterState, data_sv: StrView) -> i32
    var data: *u8 = data_sv.ptr
    var len: i32 = data_sv.len as i32
    let idx: i32 = namelist_count(@s.strings)
    namelist_push(@s.strings, StrView { ptr: (data), len: (len) as i64 })
    idx

# =============================================================================
# Type Inference - Determine expression type without emitting code
# =============================================================================

# Compute size in bytes of a named struct with proper C-style alignment.
# Each field is aligned to its natural alignment; final size rounded up to struct alignment.
pub fn get_struct_size_by_name(s: *EmitterState, name_sv: StrView) -> i64
    var name: *u8 = name_sv.ptr
    var name_len: i32 = name_sv.len as i32
    if name == null or name_len == 0
        return 8
    if is_tagged_enum_type(StrView { ptr: (name), len: (name_len) as i64 }) == 1
        var te_pad: i64 = 0
        let te_n: i64 = tagged_enum_layout(s, StrView { ptr: (name), len: (name_len) as i64 }, @te_pad)
        return 1 + te_pad + te_n   # AGAST #1898: ritz0's layout
    let st: *StructDef = find_struct(s, StrView { ptr: (name), len: (name_len) as i64 })
    if st == null
        # AGAST #1797: a user enum, `{ i8 }` or `{ i8, [P x i8], [N x i8] }`.
        let uei: i32 = user_enum_index(s.mono.pctx, StrView { ptr: (name), len: (name_len) as i64 })
        if uei >= 0
            return user_enum_size(s, uei)
        return 8
    # `[[packed]]` (AGAST #1847): fields back to back, no tail padding —
    # the layout of the `<{ ... }>` type emit_one_struct_type writes.
    let packed: i32 = struct_is_packed(s.mono.pctx, st)
    var offset: i64 = 0
    var max_align: i64 = 1
    var f: *StructField = st.fields
    while f != null
        var falign: i64 = 8
        var fsize: i64 = 8
        if f.field_type == TypeKind.Array
            # Array: size = elem_size * count, align = elem_align
            fsize = field_array_size_align(s, f, @falign)
        else
            fsize = elem_size_align(s, f.field_type, StrView { ptr: (f.field_type_name), len: (f.field_type_name_len) as i64 }, @falign)

        if packed == 1
            falign = 1
        # Align offset up to falign
        let rem: i64 = offset % falign
        if rem != 0
            offset = offset + (falign - rem)
        offset = offset + fsize
        if falign > max_align
            max_align = falign
        f = f.next

    # Round final size up to struct alignment
    if max_align > 1
        let rem2: i64 = offset % max_align
        if rem2 != 0
            offset = offset + (max_align - rem2)
    return offset

# Alignment of a named struct: its most-aligned field (LLVM DataLayout
# natural alignment). 8 for a name that does not resolve, matching
# get_struct_size_by_name's fallback.
pub fn get_struct_align_by_name(s: *EmitterState, name_sv: StrView) -> i64
    var name: *u8 = name_sv.ptr
    var name_len: i32 = name_sv.len as i32
    if name == null or name_len == 0
        return 8
    if is_tagged_enum_type(StrView { ptr: (name), len: (name_len) as i64 }) == 1
        return 1   # AGAST #1898: { i8, [P x i8], [N x i8] } is 1-aligned
    let st: *StructDef = find_struct(s, StrView { ptr: (name), len: (name_len) as i64 })
    if st == null
        let uei: i32 = user_enum_index(s.mono.pctx, StrView { ptr: (name), len: (name_len) as i64 })
        if uei >= 0
            return user_enum_align(s.mono.pctx, uei)   # AGAST #1797, #4574
        return 8
    if struct_is_packed(s.mono.pctx, st) == 1
        return 1   # `[[packed]]`: an LLVM packed struct is 1-aligned (#1847)
    var max_align: i64 = 1
    var f: *StructField = st.fields
    while f != null
        var falign: i64 = 8
        if f.field_type == TypeKind.Array
            elem_size_align(s, f.array_elem_type, StrView { ptr: (f.array_elem_type_name), len: (f.array_elem_type_name_len) as i64 }, @falign)
        else
            elem_size_align(s, f.field_type, StrView { ptr: (f.field_type_name), len: (f.field_type_name_len) as i64 }, @falign)
        if falign > max_align
            max_align = falign
        f = f.next
    return max_align

# Natural size of one value of kind `t` (a TYPE_* primitive, or TypeKind.Struct
# named `name`), with its alignment written to `*align`. AGAST #1814: bool
# and f32 were sized 8 and nested structs aligned to 8, so sizeof disagreed
# with the `%T = type` body LLVM lays out. Kinds with no recorded size
# (enums, refs, unresolved names) keep the historical 8/8.
# Size (and, in *align, alignment) of a TypeKind.Array field `f`.  AGAST #2097:
# an N-D field `m: [N][M]T` is N*M*sizeof(T), aligned as T, matching the
# `[N x [M x T]]` emit_field_llvm_type declares; the 1-D formula would size
# the TypeKind.Array element as one i64.
pub fn field_array_size_align(s: *EmitterState, f: *StructField, align: *i64) -> i64
    let sh: *ArrayShape = f.array_shape
    if sh == null
        let es: i64 = elem_size_align(s, f.array_elem_type, StrView { ptr: (f.array_elem_type_name), len: (f.array_elem_type_name_len) as i64 }, align)
        return es * (f.array_size as i64)
    var n: i64 = 1
    var d: i32 = 0
    while d < sh.rank
        n = n * (sh.dims[d] as i64)
        d = d + 1
    return n * elem_size_align(s, sh.leaf_type, StrView { ptr: (sh.leaf_name), len: (sh.leaf_name_len) as i64 }, align)

pub fn elem_size_align(s: *EmitterState, t: TypeKind, name_sv: StrView, align: *i64) -> i64
    var name: *u8 = name_sv.ptr
    var name_len: i32 = name_sv.len as i32
    # AGAST #3656: a SIMD vector (`v4i64`) is `<4 x i64>`.  On x86-64 its
    # size is rounded up to a power of two and it is aligned to that size
    # (<4 x i64>: 32, 32), as ritz0's _abi_size_align measures it.  It used
    # to fall to get_struct_size_by_name's 8/8 for an unresolved name.
    if t == TypeKind.Struct and name_len > 0 and is_simd_vector_type_name(StrView { ptr: (name), len: (name_len) as i64 }) == 1
        let vbytes: i64 = (simd_vector_elem_bits(StrView { ptr: (name), len: (name_len) as i64 }) as i64) * (simd_vector_elem_count(StrView { ptr: (name), len: (name_len) as i64 }) as i64) / 8
        var vsz: i64 = 1
        while vsz < vbytes
            vsz = vsz * 2
        *align = vsz
        return vsz
    if t == TypeKind.Struct and name_len > 0
        *align = get_struct_align_by_name(s, StrView { ptr: (name), len: (name_len) as i64 })
        return get_struct_size_by_name(s, StrView { ptr: (name), len: (name_len) as i64 })
    let sz: i64 = ptr_pointee_size(s, t, StrView { ptr: (null), len: (0) as i64 })
    if sz == 0
        *align = 8
        return 8
    *align = sz
    return sz

# Byte size of one element of a pointer whose pointee is `pointee`
# (a TYPE_* kind; for TypeKind.Struct, `name`/`name_len` name the struct).
# Returns 0 when the pointee is not known — never guesses.  0 is not a valid
# element size, so callers can tell "unknown" apart from every real answer.
pub fn ptr_pointee_size(s: *EmitterState, pointee: TypeKind, name_sv: StrView) -> i64
    var name: *u8 = name_sv.ptr
    var name_len: i32 = name_sv.len as i32
    if pointee == TypeKind.Struct
        # get_struct_size_by_name answers 8 for a name it cannot resolve;
        # that is exactly the guess this function exists to refuse.
        if name_len > 0 and find_struct(s, StrView { ptr: (name), len: (name_len) as i64 }) != null
            return get_struct_size_by_name(s, StrView { ptr: (name), len: (name_len) as i64 })
        # AGAST #1578: an Option / Result instance (`Vec$Option$i64.data + i`)
        # is no struct find_struct knows, but tagged_enum_layout sizes it, the
        # same layout the `%Option$i64 = type` declaration is written with.
        if is_tagged_enum_type(StrView { ptr: (name), len: (name_len) as i64 }) == 1
            return get_struct_size_by_name(s, StrView { ptr: (name), len: (name_len) as i64 })
        # AGAST #2411: `usize` / `isize` parse as a struct name, so a
        # `Vec$usize.data + i` had no size.  A primitive's name is its size.
        let ps: i64 = ty_store_size(ty_from_name(StrView { ptr: (name), len: (name_len) as i64 }))
        if ps > 0
            return ps
        # AGAST #2411: and `Vec$C.data + i` over a non-generic user enum
        # strides at the enum's own layout (#1797).
        let uei: i32 = user_enum_index(s.mono.pctx, StrView { ptr: (name), len: (name_len) as i64 })
        if uei >= 0
            return user_enum_size(s, uei)
        return 0
    return ty_store_size(pointee)

# "pointer arithmetic on '<name>': element size unknown" — a counted error,
# so main refuses to write the output.  Returns 1 only so the caller can
# finish emitting a syntactically complete instruction; the result is never
# linked because the error count is non-zero.  `span` is the operand's.
pub fn ptr_elem_size_unknown(s: *EmitterState, span: SrcSpan, name_sv: StrView) -> i64
    var name: *u8 = name_sv.ptr
    var name_len: i32 = name_sv.len as i32
    emit_ir_error_begin(s, span, c"pointer arithmetic: element size of pointee unknown for '")
    emit_ir_error_end(s, StrView { ptr: (name), len: (name_len) as i64 })
    return 1

# The StructField a member expression `recv.field` names, following nested
# receivers (`a.b.c.field`, any depth) and struct-pointer receivers.  null if
# unresolved.  AGAST #1673: the single resolver for member-chain field types;
# the pointee-width, stride and struct-deref paths each used to hardcode one or
# two levels and silently guess (load i64 / raw byte add) past that.
# AGAST #3824: the ConstEntry of `id`, an identifier naming a struct const
# lowered to a `%S` global, `const K: StrView = "..."` (#189: the gate
# emit_expr_ident loads it whole under); null for anything else.
pub fn struct_const_global(s: *EmitterState, id: *Expr) -> *ConstEntry
    if id == null or id.kind != ExprKind.Ident
        return null
    if is_const(s, StrView { ptr: (id.ident_ptr), len: (id.ident_len) as i64 }) == 0
        return null
    let ce: *ConstEntry = find_const_entry(s, StrView { ptr: (id.ident_ptr), len: (id.ident_len) as i64 })
    if ce == null or ce.const_type != TypeKind.Struct or ce.type_name_len <= 0
        return null
    if ce.value_expr == null
        return null
    # LARB R60: a struct-literal or const-of-const initialiser is lowered to
    # the same read-only `%S` global as the older `"..."` StrView const, so
    # `C.f` GEPs into it and `@C` is `@S` (R48).
    ce

# What an array's record says its element points at: U for an `elem` of TypeKind.Ptr
# recording `pointee` U, TypeKind.Void otherwise.  A struct U's name goes to *out_name.
pub fn elem_recorded_pointee(s: *EmitterState, elem: TypeKind, pointee: TypeKind, name_sv: StrView, out_name: **u8, out_len: *i32) -> TypeKind
    var name: *u8 = name_sv.ptr
    var name_len: i32 = name_sv.len as i32
    *out_name = null
    *out_len = 0
    if elem != TypeKind.Ptr
        return TypeKind.Void
    if pointee == TypeKind.Struct
        if name_len <= 0
            return TypeKind.Void
        *out_name = name
        *out_len = name_len
        return TypeKind.Struct
    if primitive_name_len(pointee) > 0
        return pointee
    TypeKind.Void

# ptr_root_pointee for a callee `fd` (a fn or, AGAST #3528, a method)
# returning `*T`: TypeKind.Struct (name written) for a `*S`, the primitive kind for
# a scalar `*T`, else 0 (fd null, or not a `*T` return).
pub fn fn_ptr_return_pointee(s: *EmitterState, fd: *FnDef, out_name: **u8, out_len: *i32) -> TypeKind
    if fd == null or fd.return_type != TypeKind.Ptr
        return TypeKind.Void
    # capture_fn_return_type names a primitive pointee ("i32") on
    # return_type_name (#1984), as ptr_arith_elem_size reads it (#2540).
    let rp: TypeKind = primitive_type_from_name(StrView { ptr: (fd.return_type_name), len: (fd.return_type_name_len) as i64 })
    if rp != TypeKind.Void   # primitive_type_from_name's miss value
        return rp
    let name: *u8 = fd.return_type_name
    let name_len: i32 = fd.return_type_name_len
    # AGAST #4450: a user enum pointee is named as a struct's is.
    if is_elem_aggregate_name(s, StrView { ptr: (name), len: (name_len) as i64 }) == 0
        return TypeKind.Void
    *out_name = name
    *out_len = name_len
    TypeKind.Struct

# AGAST #2376: 1 when `x` (past any `+ k`) is an array element `a[i]` or its
# address `@a[i]`, the roots ptr_levels_of resolves through an array's record.
pub fn elem_rooted(x: *Expr) -> i32
    var b: *Expr = x
    while b != null and b.kind == ExprKind.Binary and (b.op == OpKind.Add or b.op == OpKind.Sub)
        b = b.left
    if b == null
        return 0
    if b.kind == ExprKind.Unary and (b.op == OpKind.Addr or b.op == OpKind.AddrMut)
        b = b.operand
    (b != null and b.kind == ExprKind.Index) as i32

# AGAST #1965: the float width (TypeKind.F32 / TypeKind.F64) of binop operand `x`,
# or 0 when it is not a float.  An `f32` local can surface as TypeKind.Struct
# with declared type name "f32", which is_float_type also accepts.
pub fn binop_operand_float_ty(s: *EmitterState, x: *Expr) -> TypeKind
    let t: TypeKind = expr_slot_ty(x)
    if t == TypeKind.F32 or t == TypeKind.F64
        return t
    if x.kind == ExprKind.Ident
        let lv: *LocalVar = find_local_struct_name(s, StrView { ptr: (x.ident_ptr), len: (x.ident_len) as i64 })
        if lv != null and is_float_type(t, StrView { ptr: (lv_type_name(lv)), len: (lv_type_name_len(lv)) as i64 }) == 1
            if *(lv_type_name(lv) + 1) == '3'  # "f32"
                return TypeKind.F32
            return TypeKind.F64
    return TypeKind.Void

# AGAST #1370: float primitive methods, mirroring ritz0's
# _try_emit_float_intrinsic.  0 ceil, 1 floor, 2 round, 3 abs; -1 otherwise.
pub fn float_method_id(name_sv: StrView) -> i32
    var name: *u8 = name_sv.ptr
    var len: i32 = name_sv.len as i32
    if len == 4
        if *(name) == 'c' and *(name + 1) == 'e' and *(name + 2) == 'i' and *(name + 3) == 'l'
            return 0
    if len == 5
        if *(name) == 'f' and *(name + 1) == 'l' and *(name + 2) == 'o' and *(name + 3) == 'o' and *(name + 4) == 'r'
            return 1
        if *(name) == 'r' and *(name + 1) == 'o' and *(name + 2) == 'u' and *(name + 3) == 'n' and *(name + 4) == 'd'
            return 2
    if len == 3
        if *(name) == 'a' and *(name + 1) == 'b' and *(name + 2) == 's'
            return 3
    0 - 1

# AGAST #1370: TypeKind.F32 / TypeKind.F64 when `e` is a float-method call
# (`x.ceil()`, `(x + 0.25).floor()`, `x.abs().ceil()`) on a float receiver,
# 0 otherwise.  The result has the receiver's width, as in ritz0.
pub fn float_method_result_ty(s: *EmitterState, e: *Expr) -> TypeKind
    if e.kind != ExprKind.Method or e.left == null or e.args != null
        return TypeKind.Void
    if float_method_id(StrView { ptr: (e.ident_ptr), len: (e.ident_len) as i64 }) < 0
        return TypeKind.Void
    binop_operand_float_ty(s, e.left)

# 1 when an impl (any, generic or not) is for the type named `name`.  Such a
# type beats a global of its name that can't be a receiver, `String.from(x)`
# beside `var String: i32`, as in ritz0 (AGAST #2575); a struct global (or a
# `*S` one) still shadows it, as a local or param does.  monomorph's rewrite_static_ufcs_call hid this for the UFCS
# table's types until LARB R66 (#3497) deleted the table.
pub fn global_is_receiver(g: *GlobalVarDef) -> i32
    if g.var_type == TypeKind.Struct
        return 1
    (g.var_type == TypeKind.Ptr and g.pointee_type == TypeKind.Struct) as i32

pub fn impl_type_named(s: *EmitterState, name_sv: StrView) -> i32
    var name: *u8 = name_sv.ptr
    var len: i32 = name_sv.len as i32
    var ib: *ImplBlock = s.module.impls
    while ib != null
        if name_eq(StrView { ptr: (ib.type_name), len: (ib.type_name_len) as i64 }, StrView { ptr: (name), len: (len) as i64 }) == 1
            return 1
        ib = ib.next
    0

# AGAST #1965: the float width a binop `e` is computed at, or 0 when neither
# operand is a float.  f32 when both sides are f32, or one is f32 and the
# other a literal / `-literal` (a `double` that narrows); f64 otherwise --
# f64 wins over f32.  emit_expr_binary coerces both operands to it, and
# get_expr_type reports it for float arithmetic so an enclosing op agrees.
pub fn binop_float_width(s: *EmitterState, e: *Expr) -> TypeKind
    let lft: TypeKind = binop_operand_float_ty(s, e.left)
    let rft: TypeKind = binop_operand_float_ty(s, e.right)
    if lft == TypeKind.Void and rft == TypeKind.Void
        return TypeKind.Void
    if lft == TypeKind.F32 and (rft == TypeKind.F32 or is_float_lit_operand(e.right) == 1)
        return TypeKind.F32
    if rft == TypeKind.F32 and is_float_lit_operand(e.left) == 1
        return TypeKind.F32
    TypeKind.F64

# =============================================================================
# Volatile and atomic memory builtins (LANGUAGE_SPEC §18.4-§18.5, AGAST #1879)
# =============================================================================
#
# volatile_load / volatile_store and atomic_* / fence lower to LLVM volatile
# and seq_cst atomic instructions at the width of the pointer's pointee,
# which must be an integer type.  ritz1 carries integers as i64, so results
# come back extended (sext / zext by the pointee's signedness) and value
# operands are truncated, as a call argument would be.

# AGAST #2286: the local `e` names when its slot holds a `:&` borrow's pointer,
# so that `@e` is that pointer (LocalVar.holds_lent_ptr); null otherwise.
pub fn lent_ptr_local(s: *EmitterState, e: *Expr) -> *LocalVar
    if e == null or e.kind != ExprKind.Ident
        return null
    let loc: *LocalVar = find_local_struct_name(s, StrView { ptr: (e.ident_ptr), len: (e.ident_len) as i64 })
    if loc == null or lv_holds_lent_ptr(loc) == 0
        return null
    return loc

# lent_ptr_local, when `@e` points at a struct, which the local's type_name then
# names.  `c:& **C` and `c:& [2]C` name `C` too, and `@c` isn't a `*C` there.
pub fn lent_struct_local(s: *EmitterState, e: *Expr) -> *LocalVar
    let loc: *LocalVar = lent_ptr_local(s, e)
    if loc == null or lv_pointee_type(loc) != TypeKind.Struct
        return null
    return loc

# `<file>:<line>:<col>: error: <builtin name> <msg>` (AGAST #1879).
pub fn mem_builtin_error(s: *EmitterState, e: *Expr, msg: *u8)
    emit_str(s, c"  ; ERROR: memory builtin\n")
    diag_error_at(diag_source_file(), e.span)
    var i: i32 = 0
    while i < e.func_name_len
        eprint_char(*(e.func_name + i))
        i += 1
    eprints(" ")
    eprints_cstr(msg)
    eprints("\n")
    s.error_count = s.error_count + 1

pub fn mem_int_type_bits(t: TypeKind) -> i32
    if ty_int_bits(t) == 8
        return 8
    if ty_int_bits(t) == 16
        return 16
    if ty_int_bits(t) == 32
        return 32
    if ty_int_bits(t) == 64
        return 64
    0

# Get the struct type name for a dereference expression that returns TypeKind.Struct
# Returns the field info if found, null otherwise
# NOTE: Disabled due to parser bug where primitive pointer types have stale type_name values
fn get_deref_struct_type(s: *EmitterState, e: *Expr) -> *StructField
    # For now, always return null until parser properly tracks pointee types
    # TODO: Enable this once parser is fixed
    null

# =============================================================================
# Field type emission (used by emit_expr member access and module-level struct emission)
# =============================================================================

pub fn emit_field_llvm_type(s: *EmitterState, f: *StructField)
    let prim: *u8 = ty_mem_llvm(f.field_type)
    if prim != null
        emit_str(s, prim)
    else if f.field_type == TypeKind.Struct
        # Primitive types parsed as struct names (parser has no dedicated
        # tokens) — route through emit_llvm_type_struct for consistent
        # mapping (f32 -> float, u16 -> i16, etc.).
        emit_llvm_type_struct(s, TypeKind.Struct, StrView { ptr: (f.field_type_name), len: (f.field_type_name_len) as i64 })
    else if f.field_type == TypeKind.Array and f.array_shape != null
        # AGAST #2097: `m: [2][3]i32` is `[2 x [3 x i32]]`, ritz0's ABI.
        emit_array_shape_llvm(s, f.array_shape, 0)
    else if f.field_type == TypeKind.Array
        # Emit array type: [N x elem_type]
        emit_str(s, c"[")
        emit_int(s, f.array_size as i64)
        emit_str(s, IR_X)
        if f.array_elem_type == TypeKind.Struct and is_simd_vector_type_name(StrView { ptr: (f.array_elem_type_name), len: (f.array_elem_type_name_len) as i64 }) == 1
            # AGAST #3656: `[8]v4i64` is `[8 x <4 x i64>]`; no `%v4i64`
            # type is declared, so `%v4i64` would not assemble.
            emit_simd_vector_type(s, StrView { ptr: (f.array_elem_type_name), len: (f.array_elem_type_name_len) as i64 })
        else if f.array_elem_type == TypeKind.Struct
            # Emit struct type reference: %StructName
            emit_str(s, IR_PCT)
            emit_name(s, StrView { ptr: (f.array_elem_type_name), len: (f.array_elem_type_name_len) as i64 })
        else
            emit_str(s, elem_mem_llvm(f.array_elem_type))
        emit_str(s, c"]")
    else
        emit_str(s, c"i64")
