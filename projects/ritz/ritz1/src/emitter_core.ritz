# ritz1/src/emitter_core.ritz - Emitter State & Helpers
#
# Types, state, lookup helpers, type emission, member-access GEP.
# Split from emitter.ritz to keep individual files under ~1500 lines.

import ritzlib.sys
import ritzlib.io
import ritzlib.str
import ritzlib.fmt.digits
import ritzlib.gvec
import ritzlib.memory
import ritzlib.hash
import ritzlib.hashmap

import ast
import diag            # diag_error_at, fn_display_name (AGAST #3445, #3621, #4018)
import types           # the one primitive type table (AGAST #1889)
import sha256          # sha256_hex, for a private fn's symbol (AGAST #4356)
import ast_helpers   # is_enum_type / enum_variant_index (AGAST #1660)
# name_eq and the other pure AST queries, moved out of here by #3513;
# re-exported, so an emitter module reaches them through emitter_core.
pub import ast_query
import index_through # index_through (AGAST #2440)
import tokens_gen
import emitter_expr
import emitter_expr_arith
import emitter_expr_call

# =============================================================================
# Emitter State
# =============================================================================

# Initial capacities of the growable locals table and string-literal list.
# Both double on demand (AGAST #1905); they were fixed inline arrays whose
# overflow was a located fatal error (#1813), while ritz0 has no limit.
const LOCALS_INIT_CAP: i32 = 256
const STRINGS_INIT_CAP: i32 = 4096  # Self-hosting: merged modules have >256 string literals

# A growable list of names (pointer + length), for the extern and emitted-
# name sets.  Those were fixed arrays (2048 / 512) that silently dropped
# entries past the cap (AGAST #1813): a dropped emitted name is emitted twice,
# a dropped extern is never declared.  Parallel arrays rather than an array
# of structs: ritz1 cannot take `@s.p[i]` through a pointer field.
struct NameList
    names: **u8
    lens: *i32
    count: i32
    cap: i32

# A let/var seen so far in the current function, with the integer type its
# annotation WROTE (NARROW_UNKNOWN when unannotated or not an integer).
struct NarrowDecl
    name: *u8
    name_len: i32
    decl_type: i32
    # AGAST #2124: what the declaration wrote, for `sizeof(local)`: the
    # annotation (Stmt.var_declared_type, TYPE_VOID when there is none) and
    # the initialiser (null when there is none).
    declared: i32
    init: *Expr

struct EmitterState
    out: *Vec<u8>
    reg_counter: i32
    label_counter: i32
    # Heap array of `locals_cap` LocalVars (AGAST #1905); index it with
    # local_at.  Grown by add_local_full; never shrinks across fns.
    locals: *LocalVar
    locals_cap: i32
    local_count: i32
    break_label: i32
    continue_label: i32
    module: *Module
    # String literals; entry i is emitted as @.str.i (AGAST #1905).
    strings: NameList
    externs: NameList
    # Deduplication tracking for imports
    emitted_structs: NameList
    # AGAST #2419: tagged enums only a match's constructor scrutinee names.  Its
    # payload's type is known once locals are, so emit_tagged_enum_types' scan
    # can't see them: emit_late_enum_types declares them.
    late_enums: NameList
    # AGAST #3005: tuple structs the emitter synthesized for a tuple literal
    # with no tuple type, after emit_struct_types ran: emit_late_enum_types
    # declares them too.
    late_tuples: NameList
    emitted_fns: NameList
    emitted_globals: NameList
    # Track last expression value for if/else phi nodes
    last_expr_reg: i32
    # ritz-task-1309 — the block that DEFINED `last_expr_reg`.
    #
    # `last_expr_reg` on its own is just "some register"; it carries no record
    # of where it was produced.  Phi emission needs both halves — the incoming
    # value AND the predecessor block it flows from — and it used to pair
    # `last_expr_reg` with `s.current_label`, silently assuming the two agree.
    # They disagree whenever the value was produced in a *nested* block that
    # the insertion point has since moved past (an inner `if`'s then-block, a
    # loop body).  The result was `phi i64 [ %x, %L20 ]` where %x is neither
    # defined in nor dominated by L20 — SSA-invalid IR that permissive
    # verifiers accepted and LLVM 21 correctly rejects.
    #
    # Keeping the defining label welded to the value makes the mismatch
    # detectable: `last_expr_here` returns the register only when it was
    # defined in the block we are currently emitting into, and 0 otherwise.
    last_expr_label: i32
    # AGAST #2950: what LLVM type last_expr_reg has, when an `if` / `match`
    # statement set it: LAST_EXPR_I64 or LAST_EXPR_PTR (its phi), else
    # LAST_EXPR_UNKNOWN.  A tail one in a `-> @&T` / `-> *T` fn is converted.
    last_expr_model: i32
    # Track current label for phi node predecessors (needed for nested control flow)
    current_label: i32
    # Current function's return type name (for struct returns)
    ret_type_name: *u8
    ret_type_name_len: i32
    # AGAST #1730 — 1 when the current fn returns its (large) struct through
    # a `ptr sret(%T) %ret.sret` first parameter; see struct_ret_uses_sret.
    ret_sret: i32
    # The current fn's return TYPE_* (AGAST #1454).  emit_stmt takes it as a
    # parameter, but a block-bodied match arm reached through emit_expr has
    # none to pass, so its statements read it from here.
    fn_ret_type: i32
    # The value register of the most recent sret call result and the slot it
    # was loaded from, so `return f()` copies the slot instead of the value.
    sret_last_val: i32
    sret_last_slot: i32
    # 1 once any sret copy/zero is emitted: emit_sret_helpers then defines
    # @__ritz_sret_copy / @__ritz_sret_zero for this module.
    sret_helpers_used: i32
    # Bit 1 / bit 2 once float `%` calls @__ritz_fmod / @__ritz_fmodf: see
    # emit_fmod_helpers (AGAST #3817).
    fmod_helpers_used: i32
    # Tagged-enum context for variant constructors (ritz-task-133).
    # When non-null, `Some(x)` / `Ok(x)` / `None` / `Err(x)` allocas use this
    # struct name instead of falling back to `ret_type_name`.  Set by
    # emit_var_decl / emit_return for explicit `let r: Result<_,_> = Ok(x)`
    # bindings.  Null means "use ret_type_name" (covers tail-expression
    # returns inside a Result-returning fn).
    ctx_enum_name: *u8
    ctx_enum_name_len: i32
    # AGAST #1498: 1 while emitting a call argument (emit_call_arg).  There
    # the only valid enum context is the callee's parameter type, already in
    # ctx_enum_name; resolve_enum_ctx must NOT fall back to ret_type_name.
    ctx_enum_arg: i32
    # AGAST #2296: the struct type of the slot the value being emitted lands
    # in, whatever kind of struct: a typed let's, a parameter's or a store
    # target's (null when it isn't a struct), so `Span.empty()` can take its
    # T from it.  ctx_slot_set is 1 inside such a slot; 0 (a `return`, or no
    # slot yet) falls back to the fn's return type, as ritz0's
    # expected_ritz_type does.
    ctx_slot_name: *u8
    ctx_slot_name_len: i32
    ctx_slot_set: i32
    # AGAST #2330: the expression being emitted into a struct slot, a copy, or null.
    # emit_expr_index lets a struct element of a pointer to an array be that, and
    # nothing else: a struct value is its address, so an integer context took the
    # address as a number and failed at clang.
    struct_copy_expr: *Expr
    # AGAST #167: SIMD-typed binding context.  When emitting `let v: v4i32 =
    # simd_loadu(...)`, the var-decl pre-sets these so emit_expr_call's
    # SIMD intrinsic dispatch knows which `<N x iM>` type to produce.  Null
    # means "no SIMD-typed enclosing binding" — intrinsic dispatch then
    # tries to derive the type from arg idents (vector-typed locals).
    ctx_simd_name: *u8
    ctx_simd_name_len: i32
    # AGAST #1666: the merge-phi aggregate type (MatchResult.agg_name) of
    # the most recently completed emit_match, or null when its phi was i64.
    # emit_var_decl reads it right after emitting an untyped `let v = match`
    # initializer to size the slot as `alloca %StrView` rather than i64.
    last_match_agg_name: *u8
    last_match_agg_name_len: i32
    # AGAST #1946: the float phi type (TYPE_F32 / TYPE_F64) of the most
    # recently completed emit_match / emit_if_expr, or 0 when it was not a
    # float.  Read like last_match_agg_name by an untyped `let v = match`.
    last_match_float_ty: i32
    # AGAST #2559: the struct type of the most recently completed statement
    # `if`'s merge phi, or null when it had none or it was i64.  An enclosing
    # `if` whose arm ends in it (an `else if` chain) types its own phi by it.
    last_if_stmt_agg_name: *u8
    last_if_stmt_agg_name_len: i32
    # AGAST #1946: the float type an enclosing `let x: f64 = match ...` /
    # `return match ...` (in a `-> f64` fn) expects of the match, or 0.  The
    # match it is set for consumes and clears it on entry; it re-sets it just
    # before a match / if that is an arm's value tail (AGAST #2092), so it
    # reaches every nested tail but nothing else (scrutinee, condition, arm
    # statements).
    match_float_hint: i32
    # AGAST #3205: the struct or enum a `-> S` fn returns, set while its tail
    # match (a STMT_MATCH) is emitted, or null.  Taken on entry like
    # match_float_hint; the match's phi falls back to it when no arm yields a
    # value (every arm `return`s), so the implicit `ret %S` names no i64 phi.
    match_agg_hint: *u8
    match_agg_hint_len: i32
    # AGAST #2046: set by a caller that discards the value of the match / if
    # it is about to emit (STMT_MATCH, an expression statement, a match or
    # if nested as an arm).  emit_match / emit_if_expr consume and clear it
    # on entry, as with match_float_hint.  Clear = the value is wanted, and
    # a valueless arm (a void call) is a located error.
    match_no_value: i32
    # AGAST #2288: the statement-`if` arm's trailing STMT_EXPR being emitted
    # (emit_if_stmt_arm), or null.  A `c:& C` there is the arm's value, so it
    # reads the referent.
    if_arm_value: *Stmt
    # AGAST #3749: a statement `if` whose value nobody reads although it is
    # the last of its list: a loop / `unsafe` body's, or one ending an arm of
    # such an `if`.  Its arms get no phi (one with a `next` never does).
    if_stmt_discarded: *Stmt
    # AGAST #2046: where the innermost valueless arm of the last valueless
    # match / if is, so an enclosing match reports the void call itself.
    void_arm_line: i32
    void_arm_col: i32
    # ritz-task-193 — O(1) symbol lookups.
    # `local_map`  : fnv1a(name)  -> i32 index into `locals[]`.  Cleared at
    #                each fn/method start (because `local_count` resets to 0)
    #                and rebuilt by emit_match_arm_body after scope unwind.
    #                Shadowing: insert overwrites; outer bindings re-found via
    #                the array-scan fallback when the map points to a stale
    #                (idx >= local_count) or name-mismatched entry.
    # `global_map` : fnv1a(name)  -> *GlobalVarDef  (cast to i64).  Built once
    #                per emit_module from `m.globals` after monomorphization.
    # `fn_map`     : fnv1a(name)  -> *FnDef         (first-occurrence wins to
    #                preserve linked-list head-first semantics).
    # `struct_map` : fnv1a(name)  -> *StructDef     (first-occurrence wins).
    # `const_map`  : fnv1a(name)  -> *ConstEntry    (first-occurrence wins).
    # All five replace linear-scan symbol lookups that made ritz1 5.7×
    # slower than ritz0 cold-builds on valet (67 .ritz files, 11.5k LoC).
    local_map: HashMapI64
    global_map: HashMapI64
    fn_map: HashMapI64
    struct_map: HashMapI64
    const_map: HashMapI64
    # AGAST #1369 — count of expressions the emitter could not lower.
    # The emitter used to have NO way to report failure: when it met something
    # it could not emit it wrote `; ERROR: ...` into the IR as a comment,
    # substituted a zero (or, for an assignment, dropped the store), and
    # returned success.  ritz1 then exited 0, build.py printed its tick, and
    # the program segfaulted or silently computed the wrong answer.
    # emit_module returns this count and main refuses to write the output when
    # it is non-zero.  See emit_ir_error().
    error_count: i32
    # AGAST #3362 — the last undeclared struct name already reported (by the
    # member access rule, or #3347's literal rule for `String`), so one
    # mistake is one error; see unknown_struct_member_refused.
    unknown_struct_name: *u8
    unknown_struct_name_len: i32
    match_scrut_kind: i32   # BK_* of the scrutinee of the match being emitted
    match_scrut_int: i32    # AGAST #3358: its integer type kind, or 0
    match_scrut_str: i32    # AGAST #1876: 1 when it is a StrView, which string arms compare
    # AGAST #2255, #2260 — the expressions whose value the statements being
    # emitted use, innermost statement last; see want_stmt_values.
    wanted: **Expr
    wanted_count: i32
    wanted_cap: i32
    # AGAST #1521 — 1 once a print interpolation has called one of the
    # @__ritz_print_* helpers; emit_module then defines them.
    print_helpers_used: i32
    # AGAST #1824 — 1 once a format_into has called @__ritz_fmt_int /
    # @__ritz_fmt_strlen; emit_module then defines them.
    fmt_helpers_used: i32
    # AGAST #1918 — 1 once a `[[packed]]` struct type is emitted; only then
    # does align_packed_accesses scan each fn body.
    packed_types_emitted: i32
    # AGAST #1364 — per-function table of written integer types
    # (narrowing.ritz), for the codegen paths that read narrowing's rule
    # mid-lowering (enum_as_int, sizeof).  The check
    # itself is Sema's (AGAST #3505).  Reset by narrowing_begin_fn per fn.
    narrow_params: *Param
    narrow_decls: [256]NarrowDecl
    narrow_decl_count: i32
    narrow_decl_overflow: i32
    # AGAST #1869 — assert lowering (emit_assert_stmt, emitter_print.ritz).
    # fn_assert_kind: ASSERT_FN_* of the fn being emitted, set by emit_fn /
    # emit_impl_method.  assert_helpers_used / assert_site_used: emit_module
    # then defines @__ritz_assert_val / the @__ritz_assert_site_* globals.
    # assert_cap_*: emit_expr_binary records the i64 operand registers of
    # the comparison assert_cap_expr (assert_cap_ok = 1 once it has).
    # assert_file_str: @.str index of the source file's basename, or -1.
    fn_assert_kind: i32
    assert_helpers_used: i32
    assert_site_used: i32
    assert_cap_expr: *Expr
    assert_cap_ok: i32
    assert_cap_l: i32
    assert_cap_r: i32
    assert_file_str: i32
    # AGAST #2158 — move checking and drop insertion (ownership.ritz).
    # Allocated by own_init in emit_module.
    own: *OwnState
    # AGAST #3508: emit_stmt, for ownership.ritz to emit a deferred statement
    # at a block's exit (own_run_defer) without importing emitter_stmt.
    own_emit_stmt: fn(*EmitterState, *Stmt, i32)
    # AGAST #3513: ownership's own_before_ret and ref_check's
    # ref_cast_reads_referent, so emitter_core imports neither module.
    own_before_ret_fn: fn(*EmitterState)
    ref_cast_reads_referent_fn: fn(*EmitterState, *Expr) -> i32
    # AGAST #3739 — what frame_limit.ritz needs to locate a fn's allocas.
    # fm: (offset in out, span) marks, appended as emit_stmt / emit_expr
    # enter and leave; an alloca line belongs to the last mark at or before
    # it.  fm_line / fm_col: the span now in force.  fs: (alloca reg, name)
    # of every local add_local_full registered this fn, never rolled back.
    fm: *FrameMark
    fm_count: i32
    fm_cap: i32
    fm_line: i32
    fm_col: i32
    fs: *FrameSlot
    fs_count: i32
    fs_cap: i32

# AGAST #3739 — from `off` in s.out on, the emitter was at `line`:`col`.
struct FrameMark
    off: i64
    line: i32
    col: i32

# AGAST #3739 — register `reg` holds the local `name` (len bytes).
struct FrameSlot
    reg: i32
    name_len: i32
    name: *u8

# AGAST #2158 — a binding that owns a value of a move-only type
# (LANGUAGE_SPEC §13.1): one that implements Drop or holds one.
struct OwnBinding
    name: *u8
    name_len: i32
    local_idx: i32        # its index in s.locals when it was declared
    slot: i32             # register of its storage (alloca / byval pointer)
    flag: i32             # register of its `alloca i1` drop flag
    type_name: *u8
    type_name_len: i32
    # 1 once a move cleared its flag, until it is assigned again: a match on
    # it owns the value it just moved (own_scrutinee_moved).  The move check
    # itself is own_check.ritz's, on Sema (AGAST #3507).
    moved: i32
    # AGAST #2165: >0 for an array binding of `count` type_name elements
    # (an N-D array counts every leaf), 0 for a single value.
    count: i32
    # AGAST #2168, #2242: moves out of a field.  `paths` lists what can be
    # moved out (`path_count` of them, null when nothing can).  `fmask` is
    # the register of an `alloca iN` (N: path_count in whole 32-bit words,
    # AGAST #2319) whose bit i is set at run time while
    # path i is moved out (the drop skips it), or 0 when the binding can't be
    # partly moved (an array, a temporary, a type with its own drop).  `aux`
    # is used by own_assign_begin's handle only.
    paths: *OwnPath
    path_count: i32
    fmask: i32
    aux: i32
    # AGAST #2173: in own_assign_begin's handle only: the field a field
    # store `x.f... = v` overwrites (the handle is then for its old value),
    # else null; and (#2242) the path it is, or -1, with `aux` the moved
    # paths' mask from before the store.
    old_field: *StructField
    old_path: i32
    # AGAST #3508: its place in the order the fn's bindings and temporaries
    # were registered; a `ret` drops what is live newest first by it.
    seq: i32

# Per-function ownership state (ownership.ritz).
struct OwnState
    # The bindings in scope, innermost last.
    live: *OwnBinding
    live_count: i32
    live_cap: i32
    # One entry per open block: the index into `live` where it starts, and
    # 1 once a `return` was emitted directly in it (what follows is dead).
    scope_start: *i32
    scope_dead: *i32
    scope_count: i32
    scope_cap: i32
    # The next OwnBinding.seq (AGAST #3508).
    seq_next: i32
    # `live` index where the innermost loop body starts; -1 outside a loop.
    loop_base: i32
    # AGAST #4387: `temps` index where it starts, per loop depth as
    # loop_dstart is for defers.  `break` / `continue` drop the pending
    # temporaries from here too.
    loop_tbase: *i32
    loop_tcap: i32
    # Label counter for the drops own_before_ret emits before each `ret`.
    ret_seq: i32
    # AGAST #2165.  -1 until known, then 1 when the module has an `impl
    # Drop` at all (without one nothing is move-only).
    has_drop: i32
    # Call expressions own_walk found to yield a move-only temporary
    # nobody owns; emit_expr spills each one and moves it to `temps`.
    temp_exprs: **Expr
    temp_expr_count: i32
    temp_expr_cap: i32
    # The register own_note_temp spilled last, and its slot: a method
    # receiver that is that temporary is passed as the slot itself, so the
    # method and the drop see one value (AGAST #2262).
    temp_last_reg: i32
    temp_last_slot: i32
    # Temporaries awaiting their drop at the end of their statement (or
    # condition), innermost statement last.  Each is also in `all`.
    temps: *OwnBinding
    temp_count: i32
    temp_cap: i32
    # `temps` index where the statement being emitted starts.
    stmt_mark: i32
    # The current loop nesting depth (loop_dstart's index).
    loop_depth: i32
    # AGAST #2174: the `live` index of the scrutinee the innermost match
    # being emitted owns, or -1 (see own_match_begin).
    match_scrut: i32
    # AGAST #2173: the i1 register own_stmt_moves computed for the field
    # store `x.f... = v` being emitted (x owns the field's old value: drop
    # it), or 0.  own_assign_begin consumes it, with (#2242) the path stored
    # to (-1 if it isn't one) and the moved paths' mask before the store.
    fa_cond: i32
    fa_path: i32
    fa_mask: i32
    # AGAST #1625 (`defer`, LANGUAGE_SPEC §13.7): the registered deferred
    # statements, innermost last: each one's STMT_DEFER, the `live` count when
    # it was reached (bindings below it were declared before it) and the
    # enclosing fn's return type.  scope_dstart is, per open block, the
    # defer_count where it starts; loop_dstart, per loop depth, the
    # defer_count where the loop body starts (what `break` / `continue` run).
    defer_stmts: **Stmt
    defer_pos: *i32
    # AGAST #4387: the `temps` count when it was reached, as defer_pos is
    # for `live`: a temporary newer than this was made after the defer.
    defer_tpos: *i32
    defer_ret: *i32
    defer_count: i32
    defer_cap: i32
    scope_dstart: *i32
    loop_dstart: *i32
    loop_dcap: i32
    # 1 while a `ret` runs them.
    in_ret: i32

# =============================================================================
# Helpers
# =============================================================================

# `--no-red-zone` (AGAST #4308): every define ritz1 writes, Ritz fns
# (emitter.ritz's emit_fn_attrs) and hand-written helpers alike, carries
# LLVM's noredzone.  clang's -mno-red-zone is a frontend flag that does
# nothing for .ll input, so the attribute has to travel with the IR.
var g_no_red_zone: i32 = 0

pub fn set_no_red_zone_attr(on: i32)
    g_no_red_zone = on

# ` noredzone` after a define's `)` (or its other attributes), when on.
pub fn emit_no_red_zone_attr(s: *EmitterState)
    if g_no_red_zone == 1
        emit_str(s, c" noredzone")

pub fn emit_str(s: *EmitterState, text: *u8)
    # AGAST #1625, #3508: every way out of a fn is a `ret`, written from
    # dozens of sites once the return value is computed.  The live owned
    # bindings and temporaries drop, and a registered `defer` runs, there:
    # after the value and before the `ret` (own_before_ret).  A `ret` must
    # therefore start the string it is emitted in.
    if *text == 32
        if emit_str_is_ret(text) == 1
            let before_ret: fn(*EmitterState) = s.own_before_ret_fn
            before_ret(s)
    var i: i32 = 0
    while *(text + i) != 0
        i += 1
    vec_push_bytes<u8>(s.out, text, i as i64)

# `  ret ...` / `  ret\n`: the start of a `ret` instruction.
fn emit_str_is_ret(text: *u8) -> i32
    if *(text + 1) != 32
        return 0
    if *(text + 2) != 114
        return 0
    if *(text + 3) != 101
        return 0
    if *(text + 4) != 116
        return 0
    let c: u8 = *(text + 5)
    if c == 32 or c == 10
        return 1
    0

# AGAST #3446: every name reaches the IR through here, spelled as LANGUAGE_SPEC
# §11.4 and ritz0 spell it: the first `$` splits the base from its type
# arguments, and every argument, nested ones included, is joined by `_`.
# `Pair$i32$u8` is `Pair$i32_u8`, `Box$Pair$i32$u8` is `Box$Pair_i32_u8`.
#
# Inside ritz1 a mangled name keeps a `$` before every component (the parser
# builds it so), and monomorph splits it by each component's arity
# (split_mangled_args): an argument may itself contain `_` (`my_t`, `StrView`
# never, `tuple_i32_i64` always), so the `_` form cannot be split back.  The
# flattening is therefore one-way and happens only here, on the way out.
pub fn emit_name(s: *EmitterState, name: *u8, len: i32)
    var i: i32 = 0
    while i < len and *(name + i) != 36   # '$'
        i += 1
    if i >= len
        vec_push_bytes<u8>(s.out, name, len as i64)
        return
    # Up to and including the first `$` as is; every later `$` is `_`.
    vec_push_bytes<u8>(s.out, name, i as i64 + 1)
    for j in (i + 1)..len
        let c: u8 = *(name + j)
        if c == 36
            vec_push<u8>(s.out, 95)   # '_'
        else
            vec_push<u8>(s.out, c)

# AGAST #3257: how many counted errors were printed WITHOUT a file:line:col,
# out of s.error_count.  Since #3445 the emit_ir_error family is located, so
# only the errors that have no source construct to point at count here (in
# emitter.ritz: the multi-dimensional global leak tally, and a source
# `struct StrView` / `Span$u8` of the wrong layout, since a StructDef
# records no position).  main prints its
# "emitted N unlowerable expression(s)" summary only when this is non-zero:
# after a located error it is noise.  emit_module runs once per process.
var g_emit_unlocated: i32 = 0

pub fn emit_unlocated_errors() -> i32
    g_emit_unlocated

# Count `n` unlocated errors, both in s.error_count and in g_emit_unlocated.
pub fn count_unlocated_error(s: *EmitterState, n: i32)
    s.error_count = s.error_count + n
    g_emit_unlocated = g_emit_unlocated + n

# AGAST #1369 — record that the emitter could not lower something.
#
# Every caller used to be a bare `emit_str(s, c"  ; ERROR: ...")` that wrote
# the failure into the IR as a COMMENT and carried on.  A comment is not a
# diagnostic: llvm ignores it, the process exits 0, and the caller links
# whatever came out.  For `unknown identifier` the emitter went on to
# substitute `add i64 0, 0`, so `apply(double, 5)` became a call through a
# null pointer; for `unknown variable` it dropped the store outright and the
# program ran to completion with a stale value.
#
# This keeps the IR comment — it is genuinely useful when reading emitted IR
# by hand — but also prints the message to stderr and counts it, so
# emit_module can return non-zero and main can refuse to write the output.
# The IR comment is deliberately still written FIRST, so a developer dumping
# a failed compile's buffer sees the marker in place.
#
# AGAST #3621: the stderr line is located, `<file>:<line>:<col>: error:
# ritz1 cannot emit: <msg>` (diag.ritz), at `span`: the construct that could
# not be lowered.  It was the one unlocated error ritz1 printed, so it no
# longer counts toward main's "emitted N unlowerable" summary (#3257).
pub fn emit_ir_error(s: *EmitterState, span: SrcSpan, msg: *u8)
    emit_ir_error_begin(s, span, msg)
    emit_str(s, c"\n")
    eprint_char('\n')
    s.error_count = s.error_count + 1

# Same, for the sites that append a name to the message before the newline.
# The caller follows this with emit_ir_error_end, which counts the error.
pub fn emit_ir_error_begin(s: *EmitterState, span: SrcSpan, msg: *u8)
    emit_str(s, c"  ; ERROR: ")
    emit_str(s, msg)
    diag_error_at(diag_source_file(), span)
    eprints_cstr(c"ritz1 cannot emit: ")
    eprints_cstr(msg)

pub fn emit_ir_error_end(s: *EmitterState, name: *u8, len: i32)
    emit_name(s, name, len)
    emit_str(s, c"'\n")
    var i: i32 = 0
    while i < len
        eprint_char(*(name + i))
        i += 1
    eprints_cstr(c"'\n")
    s.error_count = s.error_count + 1

# Same, for a message followed by an integer (a kind number, say).
pub fn emit_ir_error_kind(s: *EmitterState, span: SrcSpan, msg: *u8, kind: i32)
    emit_ir_error_begin(s, span, msg)
    emit_int(s, kind as i64)
    emit_str(s, c"\n")
    eprint_int(kind as i64)
    eprint_char('\n')
    s.error_count = s.error_count + 1

# AGAST #2296: EmitterState.ctx_slot_*, saved around a slot.
struct SlotCtx
    name: *u8
    name_len: i32
    set: i32

# Enter the slot of declared type (ty, name) after saving the enclosing one in
# `saved`.  A non-struct slot is still a slot: it hides the enclosing one and
# the fn's return type, so neither leaks into an argument.
pub fn enter_slot_ctx(s: *EmitterState, saved: *SlotCtx, ty: i32, name: *u8, name_len: i32)
    saved.name = s.ctx_slot_name
    saved.name_len = s.ctx_slot_name_len
    saved.set = s.ctx_slot_set
    s.ctx_slot_set = 1
    s.ctx_slot_name = null
    s.ctx_slot_name_len = 0
    if ty == TYPE_STRUCT and name != null and name_len > 0
        s.ctx_slot_name = name
        s.ctx_slot_name_len = name_len

pub fn leave_slot_ctx(s: *EmitterState, saved: *SlotCtx)
    s.ctx_slot_name = saved.name
    s.ctx_slot_name_len = saved.name_len
    s.ctx_slot_set = saved.set

# The struct type the value being emitted lands in: the innermost slot's, or
# outside any slot (a `return`, a tail) the fn's return type.  null when
# neither is a struct.
pub fn slot_struct_name(s: *EmitterState, out_len: *i32) -> *u8
    if s.ctx_slot_set == 1
        *out_len = s.ctx_slot_name_len
        return s.ctx_slot_name
    *out_len = s.ret_type_name_len
    return s.ret_type_name

# AGAST #1509: a multi-dimensional array use ritz1 does not lower, as
# `<file>:<line>:<col>: error: <msg>`.  Counts like emit_ir_error, so the
# driver refuses to write the output.
pub fn emit_nd_error(s: *EmitterState, line: i32, col: i32, msg: *u8)
    emit_nd_error_begin(s, line, col)
    eprints_cstr(msg)
    eprints_cstr(c"\n")

# AGAST #1295: emit_nd_error for a message the caller finishes itself (it
# prints the rest, then a newline): `<file>:<line>:<col>: error: `, counted.
pub fn emit_nd_error_begin(s: *EmitterState, line: i32, col: i32)
    emit_str(s, c"  ; ERROR\n")
    diag_error_at(diag_source_file(), diag_span(line, col))
    s.error_count = s.error_count + 1

# AGAST #1813 — where the emitter is, for fatal capacity errors: the input
# file and the function being emitted (set by emit_fn).  The file itself
# moved to diag (AGAST #4319), so a check module can read it without
# importing the emitter; these names stay as wrappers for emitter call sites.
var g_emit_fn: *FnDef = null

pub fn emitter_set_source_file(path: *u8)
    diag_set_source_file(path)

pub fn emitter_set_current_fn(f: *FnDef)
    g_emit_fn = f

pub fn emitter_source_file() -> *u8
    diag_source_file()

pub fn emitter_current_fn() -> *FnDef
    g_emit_fn

# AGAST #1869 — EmitterState.fn_assert_kind: where `assert` may appear.
const ASSERT_FN_PLAIN: i32 = 0    # not allowed
const ASSERT_FN_TEST: i32 = 1     # [[test]]: records call sites for helpers
const ASSERT_FN_HELPER: i32 = 2   # [[test_helper]]: reports the test's call site

# A fixed ritz1 table is full.  Print a located error and exit: carrying on
# without the entry is exactly the silent miscompile this replaces, and the
# driver has not written the output yet.
#
# `<file>:<line>: error: in fn 'f': <what> ...`.  A FnDef records its line
# but no column, so this is the one emitter error diag_loc can't print
# (#3445): it would have to invent the column.
fn emit_fatal_limit(what: *u8, limit: i32)
    let file: *u8 = diag_source_file()
    if file != null
        eprints_cstr(file)
    else
        eprints_cstr(c"<input>")
    # Through a local: ritz1 cannot lower a member read on a global pointer.
    let f: *FnDef = g_emit_fn
    if f != null
        eprint_char(':')
        eprint_int(f.line as i64)
        eprints_cstr(c": error: in fn '")
        let shown: StrView = fn_display_name(f)
        eprint_bytes(shown.ptr, shown.len as i32)
        eprints_cstr(c"': ")
    else
        eprints_cstr(c": error: ")
    eprints_cstr(what)
    eprints_cstr(c" (ritz1's limit is ")
    eprint_int(limit as i64)
    eprints_cstr(c")\n")
    sys_exit(1)

# n in decimal, through ritzlib.fmt. A hand-written `'-' then 0 - n` here
# recursed forever on i64::MIN (0 - n wraps to itself), so a u64 literal
# 9223372036854775808 / 0x8000000000000000 hung ritz1 (AGAST #2129).
pub fn emit_int(s: *EmitterState, n: i64)
    var buf: [20]u8
    let len: i64 = fmt_i64_into(@buf[0], n)
    for i in 0..len
        vec_push<u8>(s.out, buf[i])

pub fn emit_reg(s: *EmitterState, reg: i32)
    emit_str(s, c"%.")
    emit_int(s, reg as i64)

pub fn next_reg(s: *EmitterState) -> i32
    let r: i32 = s.reg_counter
    s.reg_counter = s.reg_counter + 1
    r

# AGAST #1335 — the value of `current_label` inside a function's entry block.
#
# The entry block is unlabelled (it is named `entry:`, not `L<n>:`), and
# `label_counter` restarts at 0 for every function, so labels are only unique
# WITHIN a function.  `current_label` used to be left holding the PREVIOUS
# function's last opened block.  Entry-block values were then tagged by
# set_last_expr with that stale label, and whenever it collided with a real
# label of the current function (e.g. an if-without-else's merge block),
# last_expr_here falsely reported the entry-block value as "defined here" —
# so the implicit return depended on the label count of whichever function
# happened to be emitted just before.
#
# next_label never returns a negative number, so -1 can never equal any block
# opened by begin_block: an entry-block value only matches while we are still
# in the entry block.  emit_fn, emit_method and emit_module set this at every
# function boundary.  It is never passed to emit_label/begin_block.
# The only place a stale label still shows is a dead merge block, so the
# guard is an IR test: ritz0/test_ritz1_entry_block_label.py (AGAST #3526).
const ENTRY_BLOCK_LABEL: i32 = -1

pub fn next_label(s: *EmitterState) -> i32
    let l: i32 = s.label_counter
    s.label_counter = s.label_counter + 1
    l

pub fn emit_label(s: *EmitterState, label: i32)
    emit_str(s, c"L")
    emit_int(s, label as i64)

# ritz-task-1267 — Open a new basic block.
#
# This is the ONLY sanctioned way to start a basic block.  Emitting
# `L<n>:` by hand (emit_label + ":\n") is a bug: `s.current_label` is the
# emitter's insertion point, and every PHI predecessor label we write is
# derived from it.  If a construct opens a block without refreshing
# `s.current_label`, an enclosing IF/short-circuit emitter later names a
# *stale* block as a PHI predecessor — producing IR where the phi entries
# don't match the CFG, and where the incoming value doesn't dominate its
# use.
#
# This was #195 (STMT_BREAK/CONTINUE leaked a stale label) and again
# #1267 (STMT_WHILE / STMT_LOOP / STMT_FOR / STMT_MATCH / assert never
# refreshed it at their exit label — so an `if ... else <loop>` whose
# else-arm ended after the loop attributed the merge PHI to the loop's
# last *body* block instead of the loop-exit block).  Keeping the
# "emit the label" and "record the insertion point" steps welded together
# makes that whole class of bug unrepresentable.
pub fn begin_block(s: *EmitterState, label: i32)
    emit_label(s, label)
    emit_str(s, c":\n")
    s.current_label = label

# ritz-task-1309 — the three sanctioned accessors for `last_expr_reg`.
#
# Nothing outside these should assign `last_expr_reg` directly: the register
# and the label that defines it must move together or the pair goes stale,
# which is the whole defect these exist to prevent.

# Record `reg` as the last expression value, produced by the block we are
# currently emitting into.
const LAST_EXPR_UNKNOWN: i32 = 0
const LAST_EXPR_I64: i32 = 1
const LAST_EXPR_PTR: i32 = 2

pub fn set_last_expr(s: *EmitterState, reg: i32)
    s.last_expr_reg = reg
    s.last_expr_label = s.current_label
    s.last_expr_model = LAST_EXPR_UNKNOWN

# AGAST #2950: an `if` / `match` statement's phi, `ptr` when `ptr_ty` is 1.
pub fn set_last_expr_phi(s: *EmitterState, reg: i32, ptr_ty: i32)
    set_last_expr(s, reg)
    s.last_expr_model = LAST_EXPR_I64
    if ptr_ty == 1
        s.last_expr_model = LAST_EXPR_PTR

# Drop the tracked value.  Used where control flow makes any previous value
# unavailable at the new insertion point (break/continue dead blocks, and the
# start of each `if` branch).
pub fn clear_last_expr(s: *EmitterState)
    s.last_expr_reg = 0
    s.last_expr_label = s.current_label
    s.last_expr_model = LAST_EXPR_UNKNOWN

# Read the last expression value, but ONLY if it was defined in the block we
# are currently emitting into; 0 otherwise.
#
# This is the guard for phi incoming values.  A phi entry `[ %v, %L ]` requires
# %v to be available along the edge from L, and equality of defining block and
# predecessor block is the conservative way to guarantee that without a
# dominator tree.  A value produced in a nested block that the insertion point
# has already left is reported as "no value", which correctly suppresses the
# phi rather than emitting a dominance-violating one.
pub fn last_expr_here(s: *EmitterState) -> i32
    if s.last_expr_label != s.current_label
        return 0
    return s.last_expr_reg

# The idx-th entry of the locals table.  Indexes through a local copy of the
# pointer field: ritz1 cannot lower `@s.locals[idx]` on a pointer field.
pub fn local_at(s: *EmitterState, idx: i32) -> *LocalVar
    let base: *LocalVar = s.locals
    return @base[idx]

# Allocate the locals table (emit_module).
pub fn locals_init(s: *EmitterState, cap: i32)
    s.locals = malloc((cap as i64) * sizeof(LocalVar)) as *LocalVar
    s.locals_cap = cap
    s.local_count = 0
    s.fm_cap = 256   # AGAST #3739: frame_limit's marks and slots
    s.fm = malloc((s.fm_cap as i64) * sizeof(FrameMark)) as *FrameMark
    s.fs_cap = cap
    s.fs = malloc((s.fs_cap as i64) * sizeof(FrameSlot)) as *FrameSlot
    frame_begin_fn(s, 0, 0)

# AGAST #3739: forget the last fn's marks and slots; until a statement or
# expression says otherwise, the fn's allocas are at line:col (its `fn`).
pub fn frame_begin_fn(s: *EmitterState, line: i32, col: i32)
    s.fm_count = 0
    s.fs_count = 0
    s.fm_line = 0
    s.fm_col = 0
    frame_mark(s, line, col)

# AGAST #3739: the emitter is at line:col from here on in s.out.  A mark at
# the offset of the previous one replaces it: nothing was emitted under it.
pub fn frame_mark(s: *EmitterState, line: i32, col: i32)
    s.fm_line = line
    s.fm_col = col
    let off: i64 = s.out.len
    if s.fm_count > 0
        let last: *FrameMark = s.fm + ((s.fm_count - 1) as i64)
        if last.off == off
            last.line = line
            last.col = col
            return
    if s.fm_count >= s.fm_cap
        s.fm_cap = s.fm_cap * 2
        s.fm = realloc(s.fm as *u8, (s.fm_cap as i64) * sizeof(FrameMark)) as *FrameMark
    let m: *FrameMark = s.fm + (s.fm_count as i64)
    m.off = off
    m.line = line
    m.col = col
    s.fm_count = s.fm_count + 1

# ritz-task-193 — Resolve `name` to an index into `s.locals[]` using the
# per-fn HashMap (fnv1a hash of name bytes).  Falls back to a from-end
# linear scan to handle two cases the map can't:
#   1. Stale map entry: emit_match_arm_body's scope rollback drops bindings
#      from `locals[]` (by decrementing `local_count`) and rebuilds the map,
#      but during the inner-arm window the map already has the inner binding
#      pointing past the rolled-back count.
#   2. Hash collision: FNV1a-64 collisions are rare but not impossible —
#      validate the stored entry's bytes match before trusting the index.
# Both fallbacks fire rarely; the map handles >99% of lookups in O(1).
# Returns -1 when the name isn't bound in any active scope.
#
# Stores `idx + 1` in the map so hashmap_i64_get's 0-on-miss semantics
# unambiguously mean "not found" (idx == 0 is a valid first-local index).
# Avoids the contains+get double-probe pattern.
pub fn find_local_idx(s: *EmitterState, name: *u8, len: i32) -> i32
    # Fast path: single-probe HashMap lookup with collision check.
    let key: i64 = fnv1a_str(name, len) as i64
    let stored: i64 = hashmap_i64_get(@s.local_map, key)
    if stored > 0
        let idx: i32 = (stored - 1) as i32
        if idx >= 0 and idx < s.local_count
            let loc: *LocalVar = local_at(s, idx)
            if loc.name_len == len
                var j: i32 = 0
                var matched: i32 = 1
                while j < len
                    if *(loc.name + j) != *(name + j)
                        matched = 0
                        break
                    j = j + 1
                if matched == 1
                    return idx
    # Fallback: linear scan from end (innermost scope wins).
    var i: i32 = s.local_count - 1
    while i >= 0
        let loc: *LocalVar = local_at(s, i)
        if loc.name_len == len
            var j: i32 = 0
            var matched: i32 = 1
            while j < len
                if *(loc.name + j) != *(name + j)
                    matched = 0
                    break
                j = j + 1
            if matched == 1
                return i
        i = i - 1
    return -1

pub fn find_local(s: *EmitterState, name: *u8, len: i32) -> i32
    let idx: i32 = find_local_idx(s, name, len)
    if idx < 0
        return -1
    let loc: *LocalVar = local_at(s, idx)
    return loc.reg

pub fn find_local_type(s: *EmitterState, name: *u8, len: i32) -> i32
    let idx: i32 = find_local_idx(s, name, len)
    if idx < 0
        return TYPE_UNKNOWN
    let loc: *LocalVar = local_at(s, idx)
    return loc.var_type

fn find_local_pointee_type(s: *EmitterState, name: *u8, len: i32) -> i32
    let idx: i32 = find_local_idx(s, name, len)
    if idx < 0
        return TYPE_I64  # Default to i64
    let loc: *LocalVar = local_at(s, idx)
    return loc.pointee_type

# Find the struct type name for a local variable
pub fn find_local_struct_name(s: *EmitterState, name: *u8, len: i32) -> *LocalVar
    let idx: i32 = find_local_idx(s, name, len)
    if idx < 0
        return null
    return local_at(s, idx)

# AGAST #1644: 1 when emit_expr(e) yields a `ptr` register rather than the
# i64 of ritz1's value model.  A TYPE_MUT_REF local (`x: @&T`) loads as
# `ptr`, so the `*x` read must not inttoptr it, and a `*T` (i64) param must
# ptrtoint it.  `@&v` (OP_ADDR_MUT) is a `ptr` too.
pub fn expr_is_ptr_valued(s: *EmitterState, e: *Expr) -> i32
    if e == null
        return 0
    if e.kind == EXPR_UNARY and e.op == OP_ADDR_MUT
        return 1
    # AGAST #1754: `v as @&T` yields a `ptr` (see the EXPR_CAST arm).
    if e.kind == EXPR_CAST and e.op == TYPE_MUT_REF
        return 1
    # AGAST #2950: an if / match whose every value arm is one has a `ptr` phi.
    if e.kind == EXPR_IF or e.kind == EXPR_MATCH
        return arms_ptr_valued(s, e.args as *MatchArm)
    return deref_operand_is_ptr(s, e)

# AGAST #2950: 1 when the value arm `e` yields a `ptr`.  A `c` with `c:& C`
# (C a struct) reads the referent (#2288), so it is no `ptr` here.
pub fn arm_value_is_ptr(s: *EmitterState, e: *Expr) -> i32
    if e != null and e.kind == EXPR_IDENT
        let loc: *LocalVar = find_local_struct_name(s, e.ident_ptr, e.ident_len)
        if loc != null and loc.is_lent == 1 and loc.var_type == TYPE_MUT_REF and loc.pointee_type == TYPE_STRUCT
            return 0
    expr_is_ptr_valued(s, e)

# AGAST #2950: the phi of an if / match is a `ptr` when every arm with a value
# yields one (`@&x`, an `@&T` local), and i64 otherwise.  Asked in the scope
# the if / match sits in, before its arms are emitted and by whoever reads its
# value after, so both see the same answer.  An arm can only know more (its
# own `let`, which no name reuses): an `@&` arm in an i64 phi is converted in
# its block (emit_match_arm_body).
pub fn arms_ptr_valued(s: *EmitterState, arms: *MatchArm) -> i32
    var n: i32 = 0
    var a: *MatchArm = arms
    while a != null
        if a.is_pass == 0 and a.body != null
            if arm_value_is_ptr(s, a.body) == 0
                return 0
            n = n + 1
        a = a.next
    (n > 0) as i32

# AGAST #1652/#1672: bring `reg` (the value emit_expr(e) produced) into the
# i64 value model.  A `*T` slot -- `let p: *T = v`, `p = v`, `return v`,
# `x.f = v`, `v as *T` -- holds i64, but `@&v` and an `@&T` local yield
# `ptr`, so those get a ptrtoint.  Any other value is returned unchanged.
pub fn ptr_value_to_i64(s: *EmitterState, e: *Expr, reg: i32) -> i32
    if expr_is_ptr_valued(s, e) == 0
        return reg
    let r: i32 = next_reg(s)
    emit_str(s, c"  ")
    emit_reg(s, r)
    emit_str(s, c" = ptrtoint ptr ")
    emit_reg(s, reg)
    emit_str(s, c" to i64  ; #1652 @&T->*T\n")
    return r

# AGAST #1754: the inverse -- bring `reg` into an `@&T` (`ptr`) slot.  A
# `*T` value / `-> @&T` call result is i64 and gets an inttoptr; a value
# expr_is_ptr_valued already reports as `ptr` is returned unchanged.
pub fn i64_value_to_ptr(s: *EmitterState, e: *Expr, reg: i32) -> i32
    if expr_is_ptr_valued(s, e) == 1
        return reg
    let r: i32 = next_reg(s)
    emit_str(s, c"  ")
    emit_reg(s, r)
    emit_str(s, c" = inttoptr i64 ")
    emit_reg(s, reg)
    emit_str(s, c" to ptr  ; #1754 *T->@&T\n")
    return r

# ptr_value_to_i64, but only when the destination slot is i64-lowered
# pointer: `*T` / `**T`, or `@T` (TYPE_REF, i64 too -- AGAST #1754); any
# other slot type gets `reg` back unchanged.
pub fn ptr_slot_value(s: *EmitterState, slot_type: i32, e: *Expr, reg: i32) -> i32
    if slot_type != TYPE_PTR and slot_type != TYPE_PTR_PTR and slot_type != TYPE_REF
        return reg
    return ptr_value_to_i64(s, e, reg)

# AGAST #2391: i64_value_to_ptr, but only for an `@&T` (TYPE_MUT_REF, `ptr`)
# slot -- a tail `id(p)` or `self` in a `-> @&T` fn is i64 until here.
pub fn mut_ref_slot_value(s: *EmitterState, slot_type: i32, e: *Expr, reg: i32) -> i32
    if slot_type != TYPE_MUT_REF
        return reg
    return i64_value_to_ptr(s, e, reg)

# The j-th expression of an argument list (null past the end).
pub fn nth_arg(args: *Expr, j: i32) -> *Expr
    var a: *Expr = args
    var k: i32 = 0
    while k < j and a != null
        a = a.next
        k = k + 1
    return a

# AGAST #2972: the `h:& T` param `e` names when T is an integer or `bool`,
# or null.  bind_scalar_borrow_param binds it as a plain T local whose slot is
# the caller's T, so `*h` is `h`.  Only such a param is a TYPE_BOOL local.
pub fn lent_scalar_ident(s: *EmitterState, e: *Expr) -> *LocalVar
    if e == null or e.kind != EXPR_IDENT
        return null
    let loc: *LocalVar = find_local_struct_name(s, e.ident_ptr, e.ident_len)
    if loc == null
        return null
    if loc.var_type == TYPE_BOOL
        return loc
    if loc.is_lent == 1 and is_borrow_scalar_kind(loc.var_type) == 1
        return loc
    return null

# AGAST #2290: the `a:& [N]T` param `e` names, of any rank, or null.  It's an
# array local whose slot is the array behind the borrow.
pub fn lent_array_ident(s: *EmitterState, e: *Expr) -> *LocalVar
    if e == null or e.kind != EXPR_IDENT
        return null
    let loc: *LocalVar = find_local_struct_name(s, e.ident_ptr, e.ident_len)
    if loc == null or loc.var_type != TYPE_ARRAY or loc.is_lent == 0
        return null
    return loc

# AGAST #2321: the `p: *[N]T` / `@[N]T` / `@&[N]T` local called `name`, or null: a
# base whose `p[i]` is element i of the array behind it, stride T.  `a:& [N]T`
# isn't one: it's an array local, and indexes as one.
pub fn array_ptr_named(s: *EmitterState, name: *u8, len: i32) -> *LocalVar
    let loc: *LocalVar = find_local_struct_name(s, name, len)
    if loc == null or loc.pointee_type != TYPE_ARRAY or loc.pointee_array_size <= 0
        return null
    if loc.var_type != TYPE_PTR and loc.var_type != TYPE_REF and loc.var_type != TYPE_MUT_REF
        return null
    return loc

# The array_ptr_named local that `e` names, or null.
pub fn array_ptr_index_base(s: *EmitterState, e: *Expr) -> *LocalVar
    if e == null or e.kind != EXPR_IDENT
        return null
    return array_ptr_named(s, e.ident_ptr, e.ident_len)

pub fn deref_operand_is_ptr(s: *EmitterState, e: *Expr) -> i32
    if e == null or e.kind != EXPR_IDENT
        return 0
    let loc: *LocalVar = find_local_struct_name(s, e.ident_ptr, e.ident_len)
    if loc != null and loc.var_type == TYPE_MUT_REF
        return 1
    # AGAST #1554: and so does a `var g: @&S` global; `*g` inttoptr'd the ptr.
    if loc == null
        let glob: *GlobalVarDef = find_global(s, e.ident_ptr, e.ident_len)
        if glob != null and glob.var_type == TYPE_MUT_REF
            return 1
    # AGAST #2290: `a:& [N]T` reads as the borrow's `ptr` (emit_expr_ident).
    if lent_array_ident(s, e) != null
        return 1
    return 0

# ritz-task-193 — rebuild `local_map` from the current `locals[0..local_count]`.
# Called by emit_match_arm_body after `local_count` is rolled back to drop
# arm-scoped bindings; without this rebuild the map would still hold the
# inner binding's index (now past the count) for the entire fn body, costing
# us the fast-path on every subsequent lookup of that name.
pub fn rebuild_local_map(s: *EmitterState)
    hashmap_i64_clear(@&s.local_map)
    var i: i32 = 0
    while i < s.local_count
        let loc: *LocalVar = local_at(s, i)
        let key: i64 = fnv1a_str(loc.name, loc.name_len) as i64
        # Store `i + 1` so 0 unambiguously means miss in find_local_idx.
        # Insert in order so later (innermost) bindings overwrite earlier
        # (outer) ones — matches the linear-scan-from-end semantics.
        hashmap_i64_insert(@&s.local_map, key, (i + 1) as i64)
        i = i + 1

pub fn add_local(s: *EmitterState, name: *u8, len: i32, reg: i32, var_type: i32)
    add_local_full(s, name, len, reg, var_type, null, 0, TYPE_I64, 0, 0)

pub fn add_local_ptr(s: *EmitterState, name: *u8, len: i32, reg: i32, var_type: i32, pointee: i32)
    add_local_full(s, name, len, reg, var_type, null, 0, pointee, 0, 0)

pub fn add_local_struct(s: *EmitterState, name: *u8, len: i32, reg: i32, var_type: i32, type_name: *u8, type_name_len: i32)
    add_local_full(s, name, len, reg, var_type, type_name, type_name_len, TYPE_I64, 0, 0)

pub fn add_local_array(s: *EmitterState, name: *u8, len: i32, reg: i32, arr_size: i32, elem_type: i32)
    add_local_full(s, name, len, reg, TYPE_ARRAY, null, 0, TYPE_I64, arr_size, elem_type)

# AGAST #1671: attach a fn-type signature to the just-registered local.
pub fn set_local_fn_sig(s: *EmitterState, name: *u8, len: i32, sig: *FnDef)
    if sig == null
        return
    let loc: *LocalVar = find_local_struct_name(s, name, len)
    if loc != null
        loc.fn_sig = sig

# AGAST #1815: attach a `**T` local's innermost pointee to the just-registered local.
pub fn set_local_inner_ref(s: *EmitterState, name: *u8, len: i32, inner_ref: i32)
    let loc: *LocalVar = find_local_struct_name(s, name, len)
    if loc != null
        loc.inner_ref = inner_ref

pub fn set_local_inner_pointee(s: *EmitterState, name: *u8, len: i32, inner: i32)
    if inner == TYPE_VOID
        return
    let loc: *LocalVar = find_local_struct_name(s, name, len)
    if loc != null
        loc.inner_pointee_type = inner

# AGAST #1953: record N and T on the just-registered `*[N]T` local `name`
# (from Param / Stmt pointee_array_*).  A no-op when size is 0 (not `*[N]T`).
# AGAST #2539: a `**[N]T` holds them too, for the `*[N]T` that `*r` reads, and
# (#2331) an `@*[N]T` or `@&*[N]T` (ref_to_ptr).
pub fn set_local_pointee_array(s: *EmitterState, name: *u8, len: i32, size: i32, elem: i32)
    if size <= 0
        return
    let loc: *LocalVar = find_local_struct_name(s, name, len)
    if loc != null and (loc.pointee_type == TYPE_ARRAY or loc.var_type == TYPE_PTR_PTR or ref_to_ptr(loc) == 1)
        loc.pointee_array_size = size
        loc.pointee_array_elem_type = elem

# AGAST #2331: 1 for a `**S`, `@*S` or `@&*S` local: `*q` is a `*S`.
pub fn ptr_to_struct_ptr(loc: *LocalVar) -> i32
    if loc.var_type == TYPE_PTR_PTR
        return (loc.inner_pointee_type == TYPE_STRUCT) as i32
    ref_to_ptr(loc)

# AGAST #2343: U, on the same local, for `*[N]*U`.
# AGAST #2522: and on its `p#` view, which add_array_view bound before U was known.
pub fn set_local_pointee_elem(s: *EmitterState, name: *u8, len: i32, pointee: i32)
    let idx: i32 = find_local_idx(s, name, len)
    if idx < 0
        return
    let loc: *LocalVar = local_at(s, idx)
    loc.pointee_array_elem_pointee = pointee
    if idx < 1
        return
    let view: *LocalVar = local_at(s, idx - 1)
    if view.array_view == 1 and view.reg == loc.reg
        view_holds_pointers(view, pointee)

# AGAST #2522: the `p#` view of a `*[N]*U` is a `**U`, bound as a `**U` param is:
# pointee TYPE_PTR, U the inner pointee.  A `*T` view with a TYPE_PTR pointee read
# and stored `*p[i]` at 8 bytes, whatever U was (#2330's 70 for 72).
fn view_holds_pointers(view: *LocalVar, pointee: i32)
    if view.pointee_type != TYPE_PTR or pointee == TYPE_VOID
        return
    view.var_type = TYPE_PTR_PTR
    view.inner_pointee_type = pointee

# AGAST #2522: 1 for the view of a `*[N]*U` whose U wasn't recorded.  It's still a
# `*T` over pointers, which would read and store `*p[i]` at 8 bytes, so it isn't
# used: `p[i]` keeps #2321's located refusal.
pub fn view_lacks_pointee(view: *LocalVar) -> i32
    (view.pointee_type == TYPE_PTR and view.var_type != TYPE_PTR_PTR) as i32

# AGAST #2330, LARB R9: `p[i]` on a `*[N]T`, `@[N]T` or `@&[N]T` local is element i
# at stride T, as a place: read, store, `+=`, `@`, `@&`, `.f`, a by-value copy.
# Each of those lowers `*(q + i)` for a `q: *T` already, so the binding of `p` adds
# `p#`, a `*T` over the same slot, and index_through hands `p[i]` over as
# `*(p# + i)`.  The slot holds the array's address, which is element 0's, and a
# store to `p` moves both.  Call it just BEFORE adding `p`, so `p` is still the
# last local (its binders read local_at(count - 1)) and the view rolls back with
# it.  Rows get no view: they keep #2321's located refusal.  A `*[N]*U`'s view is a
# `**U` (set_local_pointee_elem, #2522).
pub fn add_array_view(s: *EmitterState, name: *u8, len: i32, reg: i32, kind: i32, pointee: i32, size: i32, elem: i32, type_name: *u8, type_name_len: i32)
    if pointee != TYPE_ARRAY or size <= 0
        return
    if kind != TYPE_PTR and kind != TYPE_REF and kind != TYPE_MUT_REF
        return
    if array_view_elem_ok(s, elem, type_name, type_name_len) == 0
        return
    let view_name: *u8 = malloc(len as i64 + 1)
    memcpy(view_name, name, len as i64)
    *(view_name + len) = 35   # '#': no identifier has one, so `p#` names only this
    add_local_full(s, view_name, len + 1, reg, TYPE_PTR, type_name, type_name_len, elem, 0, 0)
    let view: *LocalVar = local_at(s, s.local_count - 1)
    view.array_view = 1

# 1 when an array of `elem` gets a view: a scalar, or a struct ritz1 knows.
fn array_view_elem_ok(s: *EmitterState, elem: i32, type_name: *u8, type_name_len: i32) -> i32
    if elem == TYPE_STRUCT
        if type_name_len <= 0 or find_struct(s, type_name, type_name_len) == null
            return 0
    else if elem == TYPE_PTR
        # `*[N]*U` (#2522): set_local_pointee_elem makes the view a `**U`.
        return 1
    else if elem == TYPE_PTR_PTR or ptr_pointee_size(s, elem, null, 0) == 0
        return 0
    1

# AGAST #2329: what a `*[N]T`, `@[N]T` or `@&[N]T` base that isn't a local was
# declared as: a field `h.r`, a global `g` or a call `h(p)`.  Each records the type
# as a param would (ptr_array_of_last), so `x[i]` on one is element i at stride T,
# as on a local (LARB R9).  null for anything else, a local included.
pub fn base_ptr_array(s: *EmitterState, e: *Expr) -> *Param
    if e == null
        return null
    var pa: *Param = null
    if e.kind == EXPR_MEMBER
        let f: *StructField = member_field_def(s, e)
        if f != null
            pa = f.ptr_array
    else if e.kind == EXPR_IDENT
        if find_local_struct_name(s, e.ident_ptr, e.ident_len) != null
            return null
        let g: *GlobalVarDef = find_global(s, e.ident_ptr, e.ident_len)
        if g != null
            pa = g.ptr_array
    else if e.kind == EXPR_CALL
        let fd: *FnDef = find_call_fn(s, e)
        if fd != null
            pa = fd.ret_ptr_array
    else if e.kind == EXPR_CAST
        pa = e.cast_ptr_array   # AGAST #4122: `x as *[N][M]T`
    if pa == null or pa.param_pointee_array_size <= 0
        return null
    # AGAST #4122: a `**[N][M]T` field, global or return records its `*x`
    # (ptr_array_of_last); x itself is no array pointer.  base_plane_ptr_ptr.
    if pa.param_type == TYPE_PTR_PTR
        return null
    pa

# AGAST #4122: the shape of the `*[N][M]..T` that `*e` reads, `e` a `**[N][M]..T`
# field `s.q`, global `gq` or call `f()`; null for anything else, a local included.
fn base_plane_ptr_ptr(s: *EmitterState, e: *Expr) -> *ArrayShape
    var pa: *Param = null
    if e.kind == EXPR_MEMBER
        let f: *StructField = member_field_def(s, e)
        if f != null
            pa = f.ptr_array
    else if e.kind == EXPR_IDENT
        if find_local_struct_name(s, e.ident_ptr, e.ident_len) != null
            return null
        let g: *GlobalVarDef = find_global(s, e.ident_ptr, e.ident_len)
        if g != null
            pa = g.ptr_array
    else if e.kind == EXPR_CALL
        let fd: *FnDef = find_call_fn(s, e)
        if fd != null
            pa = fd.ret_ptr_array
    if pa == null or pa.param_type != TYPE_PTR_PTR
        return null
    pa.param_pointee_array_shape

# AGAST #4122: the shape of the `*[N][M]..T` an element `a[k]` of a
# `var a: [K]*[N][M]..T` local is; null for anything else.
fn elem_plane_ptr_shape(s: *EmitterState, e: *Expr) -> *ArrayShape
    if e.kind != EXPR_INDEX or e.left == null or e.left.kind != EXPR_IDENT
        return null
    if e.right == null or e.right.kind == EXPR_RANGE
        return null
    let loc: *LocalVar = find_local_struct_name(s, e.left.ident_ptr, e.left.ident_len)
    if loc == null or loc.var_type != TYPE_ARRAY or loc.array_rec == null
        return null
    loc.array_rec.ptr_plane

# AGAST #2304: the stride of `x + k` on `x`, a `*[N]T` field or global: a row,
# N * sizeof(T), as on a local (#2330, LARB R9).  A global stepped one byte and a
# field refused.  0 when `x` isn't one or T has no size.
pub fn base_ptr_array_row_size(s: *EmitterState, e: *Expr) -> i64
    let pa: *Param = base_ptr_array(s, e)
    if pa == null or pa.param_type != TYPE_PTR
        return 0
    let elem: i64 = ptr_pointee_size(s, pa.param_pointee_array_elem_type, pa.param_type_name, pa.param_type_name_len)
    if elem <= 0
        return 0
    elem * (pa.param_pointee_array_size as i64)

# AGAST #2329: the view of `root`, a base_ptr_array, as add_array_view would bind it
# for a local, but in no scope, holding `root` in array_base; null if it has none.
pub fn base_array_view(s: *EmitterState, root: *Expr) -> *LocalVar
    let pa: *Param = base_ptr_array(s, root)
    if pa == null
        return null
    return unscoped_array_view(s, root, pa.param_pointee_array_elem_type, pa.param_type_name, pa.param_type_name_len, pa.param_pointee_array_elem_pointee)

# AGAST #2553: the view of `d`, a `*r` with `r` a `**[N]T` local or param, so
# `(*r)[i]` is element i of the array behind `*r`, at stride T, as `p[i]` is on
# the `*[N]T` that `let p = *r` copies (#2539).  It took the byte path: a scalar
# `(*r)[i]` read and stored the wrong bytes, SILENT, and `(*r)[i].f` was
# "unhandled EXPR_MEMBER".  null when `loc` isn't one.
#
# AGAST #2331: and `r: @*[N]T` or `@&*[N]T`, which read the wrong bytes the same way.
pub fn deref_array_view(s: *EmitterState, d: *Expr, loc: *LocalVar) -> *LocalVar
    if loc.pointee_array_size <= 0
        return null
    if ref_to_ptr(loc) == 0 and (loc.var_type != TYPE_PTR_PTR or loc.inner_pointee_type != TYPE_ARRAY)
        return null
    var en_len: i32 = 0
    let en: *u8 = array_ptr_elem_name(loc, @en_len)
    unscoped_array_view(s, d, loc.pointee_array_elem_type, en, en_len, loc.pointee_array_elem_pointee)

# AGAST #2329: a view of the `*[N]T` that `root` evaluates to, in no scope: an
# emitting site binds it with through_spill.  null if T gets no view.
pub fn unscoped_array_view(s: *EmitterState, root: *Expr, elem: i32, name: *u8, name_len: i32, elem_pointee: i32) -> *LocalVar
    if array_view_elem_ok(s, elem, name, name_len) == 0
        return null
    let v: *LocalVar = malloc(sizeof(LocalVar)) as *LocalVar
    memset(v as *u8, 0, sizeof(LocalVar))
    v.var_type = TYPE_PTR
    v.pointee_type = elem
    v.type_name = name
    v.type_name_len = name_len
    v.array_view = 1
    v.array_base = root
    v.inner_pointee_type = TYPE_VOID
    v.pointee_array_elem_type = TYPE_VOID
    v.pointee_array_elem_pointee = TYPE_VOID
    view_holds_pointers(v, elem_pointee)   # AGAST #2522
    if view_lacks_pointee(v) == 1
        return null
    v

var g_base_spills: i32 = 0

# "#" + up to 20 digits of an i64 + NUL (AGAST #1820: no magic alloc sizes).
const BASE_SPILL_NAME_BUF: i64 = 24

# AGAST #2329: `view`, bound, at an emitting site.  A base_array_view's base is
# evaluated once, into a `*T` local named `#k`, so `x[i]` is `*(#k + i)` the way a
# local's is `*(p# + i)`; anything else is `view` itself.
pub fn through_spill(s: *EmitterState, view: *LocalVar) -> *LocalVar
    if view == null or view.array_base == null
        return view
    let val: i32 = emit_expr(s, view.array_base)
    let slot: i32 = next_reg(s)
    emit_str(s, c"  ")
    emit_reg(s, slot)
    emit_str(s, c" = alloca i64\n  store i64 ")
    emit_reg(s, val)
    emit_str(s, c", ptr ")
    emit_reg(s, slot)
    emit_str(s, c"\n")
    g_base_spills = g_base_spills + 1
    let name: *u8 = malloc(BASE_SPILL_NAME_BUF)
    *name = 35   # '#': no identifier has one
    let len: i32 = 1 + fmt_i64_into(name + 1, g_base_spills as i64) as i32
    add_local_full(s, name, len, slot, TYPE_PTR, view.type_name, view.type_name_len, view.pointee_type, 0, 0)
    let bound: *LocalVar = local_at(s, s.local_count - 1)
    bound.array_view = 1
    bound

pub fn add_local_full(s: *EmitterState, name: *u8, len: i32, reg: i32, var_type: i32, type_name: *u8, type_name_len: i32, pointee: i32, arr_size: i32, arr_elem: i32)
    if s.local_count >= s.locals_cap
        let cap: i64 = (s.locals_cap as i64) * 2
        s.locals = realloc(s.locals as *u8, cap * sizeof(LocalVar)) as *LocalVar
        s.locals_cap = cap as i32
    if s.fs_count >= s.fs_cap   # AGAST #3739: frame_limit names reg's slot
        s.fs_cap = s.fs_cap * 2
        s.fs = realloc(s.fs as *u8, (s.fs_cap as i64) * sizeof(FrameSlot)) as *FrameSlot
    let fslot: *FrameSlot = s.fs + (s.fs_count as i64)
    fslot.reg = reg
    fslot.name = name
    fslot.name_len = len
    s.fs_count = s.fs_count + 1
    let idx: i32 = s.local_count
    let loc: *LocalVar = local_at(s, idx)
    loc.name = name
    loc.name_len = len
    loc.reg = reg
    loc.var_type = var_type
    loc.type_name = type_name
    loc.type_name_len = type_name_len
    loc.pointee_type = pointee
    loc.array_size = arr_size
    loc.array_elem_type = arr_elem
    loc.is_bool = 0
    loc.array_elem_pointee = TYPE_VOID
    loc.bk_unsure = 0
    loc.bk_ptr = 0
    loc.fn_sig = null
    loc.inner_pointee_type = TYPE_VOID
    loc.is_let = 0
    loc.inner_ref = 0
    loc.pointee_array_size = 0
    loc.pointee_array_elem_type = TYPE_VOID
    loc.pointee_array_elem_pointee = TYPE_VOID
    loc.pointee_array_elem_name = null
    loc.pointee_array_elem_name_len = 0
    loc.array_shape = null
    loc.pointee_array_shape = null
    loc.array_rec = null
    loc.is_lent = 0
    loc.holds_lent_ptr = 0
    loc.is_lent_self = 0
    loc.not_fn = 0
    loc.array_view = 0
    loc.array_base = null
    loc.str_view = 0
    s.local_count = idx + 1
    # ritz-task-193 — mirror into HashMap so find_local* hits O(1).
    # Store `idx + 1` so the value is non-zero (0 = miss in
    # hashmap_i64_get).  Same name overwrites (inner shadows outer);
    # the find fallback + rebuild_local_map together preserve correct
    # shadow semantics.
    let key: i64 = fnv1a_str(name, len) as i64
    hashmap_i64_insert(@&s.local_map, key, (idx + 1) as i64)

# ritz-task-193 — module-scope find_* now use HashMaps populated once per
# module by build_symbol_maps in emit_module (after monomorphization fixes
# the function/struct lists).  All three preserve the legacy "first
# occurrence wins" semantics: build_symbol_maps inserts only if not already
# present, so duplicate-by-name nodes (from import-merged modules) resolve
# to the head of the linked list — same as the pre-task-193 linear scan.

# Find a global variable by name - returns the GlobalVarDef or null.
# We never insert a null pointer into global_map, so hashmap_i64_get returning
# 0 unambiguously means "miss" — skip the redundant contains-check that
# would double-probe + double-hash on every lookup.
pub fn find_global(s: *EmitterState, name: *u8, len: i32) -> *GlobalVarDef
    let key: i64 = fnv1a_str(name, len) as i64
    let g: *GlobalVarDef = hashmap_i64_get(@s.global_map, key) as *GlobalVarDef
    if g == null
        return null
    if name_eq(g.name, g.name_len, name, len) == 1
        return g
    # AGAST #1813: the map is keyed by the 64-bit hash alone, so a hit with
    # another name is a collision, not a miss.  Scan the list (first
    # occurrence wins, as in build_symbol_maps).
    var cur: *GlobalVarDef = s.module.globals
    while cur != null
        if name_eq(cur.name, cur.name_len, name, len) == 1
            return cur
        cur = cur.next
    return null

# Find a function definition by name - returns the FnDef or null.
# Same null-as-miss optimization as find_global.
pub fn find_fn(s: *EmitterState, name: *u8, len: i32) -> *FnDef
    let key: i64 = fnv1a_str(name, len) as i64
    let fn_def: *FnDef = hashmap_i64_get(@s.fn_map, key) as *FnDef
    if fn_def == null
        return null
    if name_eq(fn_def.name, fn_def.name_len, name, len) == 1
        return fn_def
    # AGAST #1813: the map is keyed by the 64-bit hash alone, so a hit with
    # another name is a collision, not a miss.  Scan the list (first
    # occurrence wins, as in build_symbol_maps).
    var cur: *FnDef = s.module.functions
    while cur != null
        if name_eq(cur.name, cur.name_len, name, len) == 1
            return cur
        cur = cur.next
    return null

# The file a fn's lines belong to: a specialised generic may come from an import.
# The body moved to diag (AGAST #4319); kept here for the emitter modules that
# import only emitter_core.
pub fn fn_source_file(f: *FnDef) -> *u8
    diag_fn_source_file(f)

# AGAST #4356: 1 for a file's private free fn -- one whose IR symbol carries
# its defining file (AGAST #1858).  As ritz0's LLVMEmitter._private_free:
# not `pub`, not `main`, not a method (`T_m` cannot clash across files),
# not a monomorph instance ('$'; linkonce_odr), not a generated `E__from`,
# and not a written `extern fn` (body null).  A declaration-only fn -- a
# written `fn .. = extern`, or one an interface text replaced by one -- has
# the non-null stripped_body() sentinel (#1900), so it is included: an
# importer must spell the symbol its module's object actually defines.
pub fn fn_private_free(f: *FnDef) -> i32
    if f == null or f.is_pub != 0 or f.body == null or f.from_generated != 0
        return 0
    if f.def_file == null or *(f.def_file) == 60   # '<input>': no real file
        return 0
    if f.name_len == 4 and name_eq(f.name, 4, c"main", 4) == 1
        return 0
    var i: i32 = 0
    while i < f.name_len
        if *(f.name + i) == 36   # '$': a monomorph instance, not the fn
            return 0
        i += 1
    1

# AGAST #4356: `f`'s defining file as an absolute, lexically normalised path,
# so the definition's compile (`m.ritz`) and an importer's (`./m.ritz`, or the
# same path through RITZ_PATH) hash alike.  Freshly allocated; `raw` on a
# getcwd failure, which only risks the old spelling mismatch.
fn fn_def_file_abs(f: *FnDef) -> *u8
    let raw: *u8 = f.def_file
    let rlen: i64 = strlen(raw)
    var abs: *u8 = raw
    var alen: i64 = rlen
    if rlen == 0 or *(raw) != 47   # '/'
        var cwd: [4096]u8
        let cwdp: *u8 = @cwd[0]
        let n: i64 = sys_getcwd(cwdp, 4096)
        if n <= 0
            return raw
        var clen: i64 = n
        if *(cwdp + clen - 1) == 0
            clen -= 1
        let joined: *u8 = malloc(clen + 1 + rlen + 1)
        memcpy(joined, cwdp, clen)
        *(joined + clen) = 47
        memcpy(joined + clen + 1, raw, rlen)
        *(joined + clen + 1 + rlen) = 0
        abs = joined
        alen = clen + 1 + rlen
    # Split on '/', dropping empty and "." segments and folding "..".
    let out: *u8 = malloc(alen + 2)
    var olen: i32 = 0
    var i: i64 = 0
    while i < alen
        if *(abs + i) == 47
            i += 1
            continue
        var j: i64 = i
        while j < alen and *(abs + j) != 47
            j += 1
        let seg: *u8 = abs + i
        let slen: i64 = j - i
        if slen == 1 and *seg == 46   # "."
            i = j
            continue
        if slen == 2 and *seg == 46 and *(seg + 1) == 46   # ".."
            while olen > 0 and *(out + olen - 1) != 47
                olen -= 1
            if olen > 0
                olen -= 1
            i = j
            continue
        *(out + olen) = 47
        olen += 1
        memcpy(out + olen, seg, slen)
        olen += slen as i32
        i = j
    if olen == 0
        *(out + olen) = 47
        olen = 1
    *(out + olen) = 0
    out

# AGAST #4356: the IR symbol of `f`, its length in *out_len.  A private free
# fn's symbol is its name and its defining file's hash (`helper__5e0ed276`),
# so a generic's instance -- emitted in the object of the file that
# instantiates it -- resolves the definition in its own module's object.
# ritz0 does the same since #1858 (LLVMEmitter._symbol_name); every other
# fn's symbol is its name.  A mangled result is freshly allocated.
pub fn fn_symbol(f: *FnDef, out_len: *i32) -> *u8
    *out_len = f.name_len
    if fn_private_free(f) == 0
        return f.name
    var hex: [64]u8
    let file: *u8 = fn_def_file_abs(f)
    sha256_hex(file, strlen(file), @hex[0])
    let n: i32 = f.name_len + 10   # "__" + the first 8 hex digits
    let buf: *u8 = malloc(n as i64 + 1)
    memcpy(buf, f.name, f.name_len as i64)
    buf[f.name_len] = 95
    buf[f.name_len + 1] = 95
    for i in 0..8
        buf[f.name_len + 2 + i] = hex[i]
    buf[n] = 0
    *out_len = n
    buf

# AGAST #2260: is `e`'s value used by a statement being emitted?
fn value_wanted(s: *EmitterState, e: *Expr) -> i32
    var i: i32 = 0
    while i < s.wanted_count
        if s.wanted[i] == e
            return 1
        i += 1
    0

fn want_push(s: *EmitterState, e: *Expr)
    if s.wanted_count == s.wanted_cap
        s.wanted_cap = s.wanted_cap * 2 + 16
        s.wanted = realloc(s.wanted as *u8, s.wanted_cap as i64 * 8) as **Expr
    s.wanted[s.wanted_count] = e
    s.wanted_count += 1

fn want_list(s: *EmitterState, list: *Expr)
    var cur: *Expr = list
    while cur != null
        want_value_of(s, cur, 1)
        cur = cur.next

# AGAST #2260: record which expressions in `e` have a used value: `e` itself
# when `consumed`, and always its operands (an argument, an operand, a receiver,
# a scrutinee).  As ritz0's _want_value_of: an `if`/`match` arm's value is not
# itself marked (a used arm with no value is #2046's diagnostic), and an arm's
# statements are judged as they are emitted.
fn want_value_of(s: *EmitterState, e: *Expr, consumed: i32)
    if e == null
        return
    if consumed == 1
        want_push(s, e)
    let k: i32 = e.kind
    if k == EXPR_CALL
        if e.func_name_len == 0
            want_value_of(s, e.left, 1)   # a nameless call's callee
        want_list(s, e.args)
    else if k == EXPR_METHOD
        want_value_of(s, e.left, 1)
        want_list(s, e.args)
    else if k == EXPR_BINARY or k == EXPR_INDEX or k == EXPR_RANGE
        want_value_of(s, e.left, 1)
        want_value_of(s, e.right, 1)
    else if k == EXPR_UNARY
        want_value_of(s, e.operand, 1)
    else if k == EXPR_MEMBER or k == EXPR_CAST or k == EXPR_TRY or k == EXPR_ARRAY_FILL
        want_value_of(s, e.left, 1)
    else if k == EXPR_ARRAY_LIT
        want_list(s, e.args)
    else if k == EXPR_STRUCT_LIT
        # The field inits are a *FieldInit list recast to *Expr.
        var fi: *FieldInit = e.args as *FieldInit
        while fi != null
            want_value_of(s, fi.value, 1)
            fi = fi.next
    else if k == EXPR_MATCH or k == EXPR_IF
        want_value_of(s, e.left, 1)
        var arm: *MatchArm = e.args as *MatchArm
        while arm != null
            want_value_of(s, arm.body, 0)
            arm = arm.next

# AGAST #2255, #2260: push the values `stmt` uses; the caller pops them back to
# the count it saved once `stmt` is emitted.  A procedure hands nothing back, so
# its `return g()` uses no value.
pub fn want_stmt_values(s: *EmitterState, stmt: *Stmt, ret_type: i32)
    let k: i32 = stmt.kind
    if k == STMT_VAR_DECL or k == STMT_TUPLE_DECL
        want_value_of(s, stmt.var_init, 1)
    else if k == STMT_RETURN
        want_value_of(s, stmt.return_value, (ret_type != TYPE_VOID) as i32)
    else if k == STMT_ASSIGN
        if stmt.assign_target_len == 0
            want_value_of(s, stmt.if_cond as *Expr, 0)
        want_value_of(s, stmt.assign_value, 1)
    else if k == STMT_INDEX_ASSIGN or k == STMT_LOCAL_FIELD_INDEX_ASSIGN
        want_value_of(s, stmt.while_cond, 1)
        want_value_of(s, stmt.assign_value, 1)
    else if k == STMT_LOCAL_FIELD_ASSIGN or k == STMT_MEMBER_ASSIGN or k == STMT_MEMBER_INDEX_ASSIGN
        want_value_of(s, stmt.assign_value, 1)
    else if k == STMT_EXPR
        want_value_of(s, stmt.expr, 0)
    else if k == STMT_IF or k == STMT_ASSERT or k == STMT_MATCH
        want_value_of(s, stmt.if_cond as *Expr, 1)
    else if k == STMT_WHILE
        want_value_of(s, stmt.while_cond, 1)
    else if k == STMT_FOR
        want_value_of(s, stmt.for_start, 1)
        want_value_of(s, stmt.for_end, 1)

# AGAST #2255: `e` called a procedure named `name` (a fn pointer when `len` is
# 0).  Its dummy `i32 0` is not a value, but `return g(n)`, `let x = g(n)`,
# `x = g(n)`, `h(g(n))` and `g(n) + 1` would use it.  Judged where a call
# resolves, because only there are a method's callee and a fn-pointer local known.
pub fn reject_procedure_value(s: *EmitterState, e: *Expr, name: *u8, len: i32)
    if value_wanted(s, e) == 0
        return
    eprints_cstr(fn_source_file(emitter_current_fn()))
    eprint_char(':')
    eprint_i64(e.span.line as i64)
    eprint_char(':')
    eprint_i64(e.span.col as i64)
    if len == 0
        eprints_cstr(c": error: this fn pointer")
    else
        eprints_cstr(c": error: `")
        for i in 0..len
            eprint_char(*(name + i))
        eprint_char('`')
    eprints_cstr(c" returns nothing, so its call has no value to use here\n")
    emit_str(s, c"  ; ERROR: a procedure call has no value\n")
    s.error_count = s.error_count + 1

# Call `e`, to `name`, resolved to `fd`: a procedure's call has no value to
# use (AGAST #2255).  A procedure call in a `-> T` fn's tail is tail_value's,
# on Sema (AGAST #2237, #3511).
pub fn note_callee(s: *EmitterState, e: *Expr, fd: *FnDef, name: *u8, len: i32)
    if fn_is_procedure(fd) == 0
        return
    reject_procedure_value(s, e, name, len)   # AGAST #2255

pub fn note_method_callee(s: *EmitterState, e: *Expr, fd: *FnDef)
    note_callee(s, e, fd, e.ident_ptr, e.ident_len)

# The FnDef a call expression names: `func_name` plus its generic suffix
# (`vec_new` + `$u8`).  Replaces nine copies of a loop that built the name in
# a fixed [256]u8 stack buffer with no bounds check (AGAST #1813).
pub fn find_call_fn(s: *EmitterState, e: *Expr) -> *FnDef
    if e.func_name_len == 0
        return call_callee_sig(s, e)   # AGAST #1747
    if e.call_type_suffix_len <= 0
        # AGAST #3666: a typed fn-pointer local of this name is the callee, as
        # emit_call has it (#2246), so `let r = h(s)` takes h's result type.
        if find_local(s, e.func_name, e.func_name_len) >= 0
            let lv: *LocalVar = find_local_struct_name(s, e.func_name, e.func_name_len)
            if lv != null and lv.fn_sig != null and lv.var_type != TYPE_ARRAY
                return lv.fn_sig
        let f: *FnDef = find_fn(s, e.func_name, e.func_name_len)
        if f != null
            return f
        # R10: `let p = C_mk(c)` takes the method's type (AGAST #2447).
        return find_impl_method_by_symbol(s.module, e.func_name, e.func_name_len)
    let n: i32 = e.func_name_len + e.call_type_suffix_len
    let buf: *u8 = malloc(n as i64 + 1)
    for i in 0..e.func_name_len
        *(buf + i) = *(e.func_name + i)
    for i in 0..e.call_type_suffix_len
        *(buf + e.func_name_len + i) = *(e.call_type_suffix + i)
    *(buf + n) = 0
    let fd: *FnDef = find_fn(s, buf, n)
    free(buf)
    return fd

# AGAST #1747: the signature of a nameless call's callee expression
# (`fs[i](..)`, built by apply_postfix_p with the callee in `left`), or null
# when it is not statically known.  An element of a `[N]fn(..) -> T` local
# carries the element signature on the local (set_local_fn_sig).
#
# AGAST #2120: so do the other callees whose type is a fn type, so a call
# through each is typed and keeps a fn-type alias's [[callconv]] (the
# signature is the alias's, which carries it): a cast `(p as EfiFn)(..)`, a
# field `(t.f)(..)`, and a fn's result `get()(..)`.
pub fn call_callee_sig(s: *EmitterState, e: *Expr) -> *FnDef
    if e.func_name_len != 0
        return null
    value_fn_sig(s, e.left)

# The signature of the fn value `c` (null when not statically known): the
# callee of a nameless call, or an untyped `let h = c` (AGAST #3666).
pub fn value_fn_sig(s: *EmitterState, c: *Expr) -> *FnDef
    if c == null
        return null
    if c.kind == EXPR_INDEX and c.left != null and c.left.kind == EXPR_IDENT
        let lv: *LocalVar = find_local_struct_name(s, c.left.ident_ptr, c.left.ident_len)
        if lv != null and lv.var_type == TYPE_ARRAY
            return lv.fn_sig
    # AGAST #3666: an element of a `fs: [N]fn(..) -> T` field, `(t.fs[i])(..)`.
    # It was the untyped `call i64 %f(i64 ..)`, wrong for a by-value struct.
    else if c.kind == EXPR_INDEX and c.left != null and c.left.kind == EXPR_MEMBER and c.right != null and c.right.kind != EXPR_RANGE
        let af: *StructField = member_field_def(s, c.left)
        if af != null and af.field_type == TYPE_ARRAY
            return af.elem_fn_sig
    else if c.kind == EXPR_CAST
        return c.fn_sig
    else if c.kind == EXPR_MEMBER
        let f: *StructField = member_field_def(s, c)
        if f != null and f.field_type == TYPE_PTR
            return f.fn_sig
    else if c.kind == EXPR_CALL
        let fd: *FnDef = find_call_fn(s, c)
        if fd != null and fd.return_type == TYPE_PTR
            return fd.ret_fn_sig
    return null

# struct_map_find moved to ast_query (AGAST #4319); re-exported through
# `pub import ast_query` above.
pub fn find_struct(s: *EmitterState, name: *u8, len: i32) -> *StructDef
    struct_map_find(@s.struct_map, s.module, name, len)

# Result struct for emit_member_ptr - returns pointer register and field info
struct MemberPtrResult
    reg: i32              # Register holding pointer to field
    field: *StructField   # Field info (type, name, etc.)
    success: i32          # 1 if successful, 0 if error

# AGAST #2388: what a `for` over a header binds: `elem`, and `name` when that's a
# struct.  For a pointer element, what it points at, as elem_recorded_pointee has it.
struct ForElem
    elem: i32
    name: *u8
    name_len: i32
    pointee: i32
    pointee_name: *u8
    pointee_name_len: i32

pub fn namelist_init(l: *NameList, cap: i32)
    l.names = malloc((cap as i64) * 8) as **u8
    l.lens = malloc((cap as i64) * 4) as *i32
    l.count = 0
    l.cap = cap

# Index of `name` in the list, or -1.
pub fn namelist_find(l: *NameList, name: *u8, len: i32) -> i32
    let names: **u8 = l.names
    let lens: *i32 = l.lens
    var i: i32 = 0
    while i < l.count
        let n: i32 = *(lens + i)
        if n == len
            let stored: *u8 = *(names + i)
            if name_eq(stored, n, name, len) == 1
                return i
        i = i + 1
    -1

pub fn namelist_push(l: *NameList, name: *u8, len: i32)
    if l.count >= l.cap
        let cap: i64 = (l.cap as i64) * 2
        l.names = realloc(l.names as *u8, cap * 8) as **u8
        l.lens = realloc(l.lens as *u8, cap * 4) as *i32
        l.cap = cap as i32
    let names: **u8 = l.names
    let lens: *i32 = l.lens
    *(names + l.count) = name
    *(lens + l.count) = len
    l.count = l.count + 1

pub fn namelist_count(l: *NameList) -> i32
    l.count

pub fn namelist_name(l: *NameList, i: i32) -> *u8
    let names: **u8 = l.names
    *(names + i)

pub fn namelist_len(l: *NameList, i: i32) -> i32
    let lens: *i32 = l.lens
    *(lens + i)

pub fn add_extern(s: *EmitterState, name: *u8, len: i32)
    if namelist_find(@s.externs, name, len) >= 0
        return  # Already registered
    # Add new external - copy the name since caller might use a stack buffer
    let name_copy: *u8 = malloc(len as i64 + 1) as *u8
    for k in 0..len
        *(name_copy + k) = *(name + k)
    *(name_copy + len) = 0  # Null terminate
    namelist_push(@s.externs, name_copy, len)

# Add extern for method call: TypeName_methodName
# Allocates memory for the mangled name
pub fn add_method_extern(s: *EmitterState, type_name: *u8, type_len: i32, method_name: *u8, method_len: i32)
    # Calculate total length: TypeName_methodName
    let total_len: i32 = type_len + 1 + method_len

    # Allocate memory for the name (use malloc)
    let name: *u8 = malloc(total_len as i64 + 1) as *u8
    if name == null
        return

    # Copy type name
    for i in 0..type_len
        *(name + i) = *(type_name + i)

    # Add underscore
    *(name + type_len) = 95  # '_'

    # Copy method name
    for i in 0..method_len
        *(name + type_len + 1 + i) = *(method_name + i)

    # Null terminate
    *(name + total_len) = 0

    # Add to externs
    add_extern(s, name, total_len)

# =============================================================================
# Deduplication Helpers - Track emitted structs/functions to avoid duplicates
# =============================================================================

# Check if a struct has already been emitted
pub fn was_struct_emitted(s: *EmitterState, name: *u8, len: i32) -> i32
    if namelist_find(@s.emitted_structs, name, len) >= 0
        return 1
    0

# Mark a struct as emitted
pub fn mark_struct_emitted(s: *EmitterState, name: *u8, len: i32)
    namelist_push(@s.emitted_structs, name, len)

# Check if a function has already been emitted
pub fn was_fn_emitted(s: *EmitterState, name: *u8, len: i32) -> i32
    if namelist_find(@s.emitted_fns, name, len) >= 0
        return 1
    0

# Mark a function as emitted
pub fn mark_fn_emitted(s: *EmitterState, name: *u8, len: i32)
    namelist_push(@s.emitted_fns, name, len)

# Check if a global has already been emitted
pub fn was_global_emitted(s: *EmitterState, name: *u8, len: i32) -> i32
    if namelist_find(@s.emitted_globals, name, len) >= 0
        return 1
    0

# Mark a global as emitted
pub fn mark_global_emitted(s: *EmitterState, name: *u8, len: i32)
    namelist_push(@s.emitted_globals, name, len)

# find_builtin_const / is_builtin_const moved to ast_query (AGAST #4319);
# re-exported through `pub import ast_query` above.

pub fn find_const(s: *EmitterState, name: *u8, len: i32) -> i64
    # First check module constants via HashMap
    let ce: *ConstEntry = find_const_entry(s, name, len)
    if ce != null
        return ce.value
    # Then check builtin constants
    let builtin: i64 = find_builtin_const(name, len)
    if builtin != -9999
        return builtin
    0

# Look up a ConstEntry by name (returns null if not found).  Distinct from
# find_const above which only returns the scalar value — this caller-side
# helper is needed when const-array iter wants the array_size /
# array_elem_type metadata to drive iteration codegen.  Same null-as-miss
# single-probe optimization as find_global.
pub fn find_const_entry(s: *EmitterState, name: *u8, len: i32) -> *ConstEntry
    let key: i64 = fnv1a_str(name, len) as i64
    let ce: *ConstEntry = hashmap_i64_get(@s.const_map, key) as *ConstEntry
    if ce == null
        return null
    if name_eq(ce.name, ce.name_len, name, len) == 1
        return ce
    # AGAST #1813: the map is keyed by the 64-bit hash alone, so a hit with
    # another name is a collision, not a miss.  Scan the list (first
    # occurrence wins, as in build_symbol_maps).
    var cur: *ConstEntry = s.module.constants
    while cur != null
        if name_eq(cur.name, cur.name_len, name, len) == 1
            return cur
        cur = cur.next
    return null

# AGAST #2155: TYPE_F32 / TYPE_F64 when `ce` is a float const whose
# initializer is a constant integer expression (`const F: f64 = -1`,
# `= 2 + K`), with the folded integer in *out; 0 otherwise.  The use site
# must `sitofp` that integer to the const's type: it used to materialise it
# as `add i64 0, <v>` and hand the i64 to float code, which clang rejected.
# Folded here, not read from `ce.value`: a float const is never PENDING, so
# one naming a later integer const was not folded at parse time.
pub fn const_int_init_float_ty(s: *EmitterState, ce: *ConstEntry, out: *i64) -> i32
    if ce == null or (ce.const_type != TYPE_F32 and ce.const_type != TYPE_F64)
        return 0
    if const_fold_int(s.module.constants, ce.value_expr, 1, out) == 0
        return 0
    ce.const_type

# AGAST #2176: TYPE_F32 / TYPE_F64 when `ce` is a float const initialised by a
# float literal or a negated one (`= 1.5`, `= -1.5`); 0 otherwise.  The use
# site emits value_expr (a `double`) and narrows it for f32.  Such a const has
# no integer fold, so its `ce.value` is 0, and the use site emitted that as
# `add i64 0, 0` and handed the i64 to float code, which clang rejected.
pub fn const_float_lit_init_ty(ce: *ConstEntry) -> i32
    if ce == null or (ce.const_type != TYPE_F32 and ce.const_type != TYPE_F64)
        return 0
    if ce.value_expr == null or is_float_lit_operand(ce.value_expr) == 0
        return 0
    ce.const_type

pub fn is_const(s: *EmitterState, name: *u8, len: i32) -> i32
    # Check module constants first via HashMap
    if find_const_entry(s, name, len) != null
        return 1
    # Check builtin constants
    is_builtin_const(name, len)

# ritz-task-193 — allocate the five symbol-table HashMaps.  Called from
# emit_module right after `var s: EmitterState`.  Stack-allocated EmitterState
# starts with garbage HashMap entry pointers, so this MUST run before any
# add_local / find_* call hits the maps with a stale `entries` pointer.
pub fn init_emitter_maps(s: *EmitterState)
    # Pre-size to skip the grow cascade.  512 keeps local_map under the 75%
    # load factor for a fn of up to LOCALS_INIT_CAP locals; past that it grows.
    # Module-scope maps are sized for typical self-host modules (thousands
    # of fns/structs after monomorphization) — undersizing pays an O(N)
    # rehash cost on every doubling.  `hashmap_i64_with_cap` rounds up to
    # power-of-2, so the constants above need not be exact.
    s.local_map = hashmap_i64_with_cap(512)
    s.global_map = hashmap_i64_with_cap(256)
    s.fn_map = hashmap_i64_with_cap(8192)
    s.struct_map = hashmap_i64_with_cap(2048)
    s.const_map = hashmap_i64_with_cap(256)

# ritz-task-193 — populate per-module symbol tables from the AST after
# monomorphization.  emit_module calls this once; the maps stay valid for
# the lifetime of the EmitterState because nothing in the emit pipeline
# mutates `s.module.{globals,functions,structs,constants}` after init.
# First-occurrence wins (skip-if-contains) — preserves the head-first
# semantics of the legacy linked-list scans in the face of duplicate
# entries from import-merged modules.
pub fn build_symbol_maps(s: *EmitterState)
    var g: *GlobalVarDef = s.module.globals
    while g != null
        let kg: i64 = fnv1a_str(g.name, g.name_len) as i64
        if not hashmap_i64_contains(@s.global_map, kg)
            hashmap_i64_insert(@&s.global_map, kg, g as i64)
        g = g.next

    var fd: *FnDef = s.module.functions
    while fd != null
        let kf: i64 = fnv1a_str(fd.name, fd.name_len) as i64
        if not hashmap_i64_contains(@s.fn_map, kf)
            hashmap_i64_insert(@&s.fn_map, kf, fd as i64)
        fd = fd.next

    var st: *StructDef = s.module.structs
    while st != null
        let ks: i64 = fnv1a_str(st.name, st.name_len) as i64
        if not hashmap_i64_contains(@s.struct_map, ks)
            hashmap_i64_insert(@&s.struct_map, ks, st as i64)
        st = st.next

    var ce: *ConstEntry = s.module.constants
    while ce != null
        let kc: i64 = fnv1a_str(ce.name, ce.name_len) as i64
        if not hashmap_i64_contains(@s.const_map, kc)
            hashmap_i64_insert(@&s.const_map, kc, ce as i64)
        ce = ce.next

# AGAST #1509: times a multi-dimensional array's TYPE_ARRAY element reached
# a 1-D element-type helper (elem_mem_llvm), i.e. an N-D array use ritz1 does
# not lower.  Reported (and failed) by emit_module.
var g_nd_elem_leaks: i32 = 0

pub fn nd_elem_leaks() -> i32
    g_nd_elem_leaks

# The LLVM type of ONE element of a non-struct `[N]T` -- a local, global or
# const array, a struct field array, or the pointee of a `*T` -- and so of
# every GEP / load / store over it: types.ritz's memory spelling (ritz0's
# layout).  AGAST #1889: this replaced six ladders (array_elem_llvm,
# field_/local_/global_array_elem_llvm, ptr_field_elem_llvm, and the
# local-array index arms) that each knew a different subset of the
# primitives (#1564 u16/i16/u32, #1814 fields, #1966 f32/f64, #2063 bool).
# A struct element is spelled `%T` by its caller; anything else unknown is
# an i64 slot.
pub fn elem_mem_llvm(t: i32) -> *u8
    if t == TYPE_ARRAY
        # AGAST #1509: every lowered N-D access goes through
        # emit_nd_index_ptr / emit_array_shape_llvm; anything else used to
        # treat the inner array as one i64 and miscompile silently.
        # emit_module turns the count into a hard error.
        g_nd_elem_leaks = g_nd_elem_leaks + 1
        return c"i64"
    let m: *u8 = ty_mem_llvm(t)
    if m == null
        return c"i64"
    m

# AGAST #1509: the LLVM type of `sh` from dimension `from` inward:
# `[4 x [8 x i8]]` for `[4][8]u8` from 0, `[8 x i8]` from 1, and the bare
# leaf at from == rank.  The same spelling the alloca / global declares, so
# every GEP over the array agrees with its layout (ritz0's layout).
pub fn emit_array_shape_llvm(s: *EmitterState, sh: *ArrayShape, from: i32)
    var d: i32 = from
    while d < sh.rank
        emit_str(s, c"[")
        emit_int(s, sh.dims[d] as i64)
        emit_str(s, c" x ")
        d = d + 1
    if sh.leaf_type == TYPE_STRUCT and sh.leaf_name_len > 0
        emit_llvm_type_struct(s, TYPE_STRUCT, sh.leaf_name, sh.leaf_name_len)
    else
        emit_str(s, elem_mem_llvm(sh.leaf_type))
    d = from
    while d < sh.rank
        emit_str(s, c"]")
        d = d + 1

# Widen an array element just loaded as `ty` (elem_mem_llvm(t)) to the i64
# every expression value is carried in: zext unsigned, sext signed, ptrtoint
# pointers. i64 elements are returned as-is.  A bool element (`i1`, #2063)
# is zero-extended.
pub fn emit_array_elem_widen(s: *EmitterState, val: i32, t: i32, ty: *u8) -> i32
    var op: *u8 = null
    if ty_bits(t) == 64
        return val
    if ty_is_signed(t) == 1
        op = c" = sext "
    else if ty_bits(t) > 0
        op = c" = zext "   # unsigned, and bool's i1 (#2063)
    else if ty_is_ptr(t) == 1
        op = c" = ptrtoint "
    if op == null
        return val
    let wide: i32 = next_reg(s)
    emit_str(s, c"  ")
    emit_reg(s, wide)
    emit_str(s, op)
    emit_str(s, ty)
    emit_str(s, c" ")
    emit_reg(s, val)
    emit_str(s, c" to i64\n")
    return wide

# The inverse of emit_array_elem_widen for a store: narrow an i64 value to the
# element type `ty` (trunc ints, inttoptr pointers). i64 is returned as-is.
pub fn emit_array_elem_narrow(s: *EmitterState, val: i32, t: i32, ty: *u8) -> i32
    var op: *u8 = null
    if ty_int_in(t, 8, 32) == 1
        op = c" = trunc i64 "
    else if t == TYPE_PTR or t == TYPE_PTR_PTR
        op = c" = inttoptr i64 "
    if op == null
        return val
    let narrow: i32 = next_reg(s)
    emit_str(s, c"  ")
    emit_reg(s, narrow)
    emit_str(s, op)
    emit_reg(s, val)
    emit_str(s, c" to ")
    emit_str(s, ty)
    emit_str(s, c"\n")
    return narrow

# AGAST #3972: 1 when `f` is a `*S` field whose element `x.f[i]` is an S, a
# known struct.  The value, member, address and type paths each ask this, so
# they agree on which fields they take.  A pointer to a Vec, Span or String
# indexes through it (#3816): every one of them asks index_through first.
pub fn ptr_field_struct_elem(s: *EmitterState, f: *StructField) -> i32
    if f == null or f.field_type != TYPE_PTR or ptr_field_elem_kind(f) != TYPE_STRUCT
        return 0
    (find_struct(s, f.field_type_name, f.field_type_name_len) != null) as i32

# AGAST #1596: address of element `idx` (an i64 register) through the
# pointer held in a struct field. `field_slot` points AT the field; the
# pointer is loaded from it and the GEP strides by the pointee (`kind` from
# ptr_field_elem_kind, never TYPE_UNKNOWN). The old lowering GEP'd the field
# slot itself as an inline `[0 x T]` array, writing into the struct.
pub fn emit_ptr_field_elem_addr(s: *EmitterState, field_slot: i32, field: *StructField, kind: i32, idx: i32) -> i32
    let base: i32 = next_reg(s)
    emit_str(s, c"  ")
    emit_reg(s, base)
    emit_str(s, c" = load ptr, ptr ")
    emit_reg(s, field_slot)
    emit_str(s, c"\n")
    let elem_ptr: i32 = next_reg(s)
    emit_str(s, c"  ")
    emit_reg(s, elem_ptr)
    emit_str(s, c" = getelementptr ")
    if kind == TYPE_STRUCT
        emit_llvm_type_struct(s, TYPE_STRUCT, field.field_type_name, field.field_type_name_len)
    else
        emit_str(s, elem_mem_llvm(kind))
    emit_str(s, c", ptr ")
    emit_reg(s, base)
    emit_str(s, c", i64 ")
    emit_reg(s, idx)
    emit_str(s, c"\n")
    return elem_ptr

# Centralised float-type predicate for arith / cmp / cast dispatch.
# Returns 1 for TYPE_F32/F64 OR for the legacy TYPE_STRUCT+name="f32"/"f64"
# representation (some pre-Option-B code paths still surface floats as
# TYPE_STRUCT).  Once everything threads through type_named's new mapping
# the second branch becomes dead; it's kept until the migration settles.
pub fn is_float_type(t: i32, name: *u8, name_len: i32) -> i32
    if t == TYPE_F32 or t == TYPE_F64
        return 1
    if t == TYPE_STRUCT and name != null and name_len == 3
        if *(name + 0) == 102 and *(name + 1) == 51 and *(name + 2) == 50  # f32
            return 1
        if *(name + 0) == 102 and *(name + 1) == 54 and *(name + 2) == 52  # f64
            return 1
    return 0

# The concrete struct carried by a tagged enum's Ok/Some variant, named by
# its FIRST type argument; returns the name (a slice of `name`) and its
# length in *out_len, or null when that argument is not a known concrete
# struct (primitives, pointers).  ritz1 mangles every type argument (AGAST
# #1574): `Option<Point>` is `Option$Point`, `Result<String, E>` is
# `Result$String$E` and `Result<Vec<u8>, E>` is `Result$Vec$u8$E`.  Option
# has one argument, the whole suffix; for Result it is the shortest
# `$`-bounded prefix of the suffix naming a concrete struct.  (Not the first
# component alone: `Vec` there is the generic template.)
fn tagged_enum_payload_struct(s: *EmitterState, name: *u8, name_len: i32, out_len: *i32) -> *u8
    return tagged_enum_payload_named(s, name, name_len, out_len, 0)

# AGAST #2100: 1 if `name` is a concrete (non-generic) struct or, when
# allow_enum is 1, a non-generic user enum: a type a tagged-enum payload is
# stored as by value (#1466 builds a user-enum payload as its aggregate).
pub fn is_concrete_payload_type(s: *EmitterState, name: *u8, len: i32, allow_enum: i32) -> i32
    let st: *StructDef = find_struct(s, name, len)
    if st != null
        return (st.type_params == null) as i32
    if allow_enum == 1 and user_enum_index(name, len) >= 0
        return 1
    0

# tagged_enum_payload_struct; with allow_enum 1 the carried type may also be
# a non-generic user enum (AGAST #2100: `Some(x)` over `Option<Opt>`).
pub fn tagged_enum_payload_named(s: *EmitterState, name: *u8, name_len: i32, out_len: *i32, allow_enum: i32) -> *u8
    *out_len = 0
    if name == null
        return null
    var dollar: i32 = 0
    while dollar < name_len and *(name + dollar) != 36   # '$'
        dollar = dollar + 1
    let sfx: *u8 = name + dollar + 1
    let sfx_len: i32 = name_len - dollar - 1
    if sfx_len <= 0
        return null
    if dollar == 6 and *name == 79   # "Option": the whole suffix
        if allow_enum == 0 and find_struct(s, sfx, sfx_len) == null
            return null
        if allow_enum == 1 and is_concrete_payload_type(s, sfx, sfx_len, 1) == 0
            return null
        *out_len = sfx_len
        return sfx
    var end: i32 = 0
    while end < sfx_len
        end = end + 1
        while end < sfx_len and *(sfx + end) != 36
            end = end + 1
        if is_concrete_payload_type(s, sfx, end, allow_enum) == 1
            *out_len = end
            return sfx
    return null

# AGAST #1667: the struct type carried by `Result<T, E>`'s Err variant, i.e.
# E, recovered from the mangled `Result$T$E` name.  When T itself names a
# struct (tagged_enum_payload_struct), E is exactly the remainder after it.
# Otherwise T is a primitive and E is the shortest `$`-suffix naming a
# concrete (non-generic) struct: `Result$i64$ArgError` -> `ArgError`,
# `Result$i32$Box$i64` -> `Box$i64`.  Returns null (out_len 0) when E is
# not a struct, or for non-Result names; callers then keep the i64 binding.
fn tagged_enum_err_payload_struct(s: *EmitterState, name: *u8, name_len: i32, out_len: *i32) -> *u8
    return tagged_enum_err_payload_named(s, name, name_len, out_len, 0)

# tagged_enum_err_payload_struct; with allow_enum 1, T and E may also be
# non-generic user enums (AGAST #2100: `Err(e)` over `Result<i64, ArgError>`).
pub fn tagged_enum_err_payload_named(s: *EmitterState, name: *u8, name_len: i32, out_len: *i32, allow_enum: i32) -> *u8
    *out_len = 0
    if name == null or name_len <= 7
        return null
    # "Result$"
    if *name != 82 or *(name + 1) != 101 or *(name + 6) != 36
        return null
    let sfx: *u8 = name + 7
    let sfx_len: i32 = name_len - 7
    var ok_len: i32 = 0
    let ok_st: *u8 = tagged_enum_payload_named(s, name, name_len, @ok_len, allow_enum)
    if ok_st != null and ok_len > 0
        let rest_len: i32 = sfx_len - ok_len - 1
        if rest_len <= 0
            return null
        let rest: *u8 = sfx + ok_len + 1
        if is_concrete_payload_type(s, rest, rest_len, allow_enum) == 0
            return null
        *out_len = rest_len
        return rest
    # Shortest `$`-bounded suffix first; never the whole suffix (that is T).
    var start: i32 = sfx_len - 1
    while start > 0
        if *(sfx + start - 1) == 36   # '$'
            let cand: *u8 = sfx + start
            let cand_len: i32 = sfx_len - start
            if is_concrete_payload_type(s, cand, cand_len, allow_enum) == 1
                *out_len = cand_len
                return cand
        start = start - 1
    return null

# =============================================================================
# Tagged-enum layout (AGAST #1898) — byte-for-byte ritz0's _define_enum:
#
#     %Result$T$E = type { i8 tag, [pad x i8], [N x i8] payload }
#
# N is the largest payload (T, and E for Result), pad aligns the payload to
# the most-aligned of them: Result<i64, i32> is { i8, [7 x i8], [8 x i8] },
# Option<i32> is { i8, [3 x i8], [4 x i8] }.  ritz1 always emits the pad
# field, as `[0 x i8]` when nothing needs aligning, so the payload is field
# 2 everywhere; a zero-length array adds no bytes and no ABI element, so the
# type stays identical to ritz0's at a call boundary.
#
# ritz1 used one `{ i8, [144 x i8] }` for every instantiation (ritz-task-133,
# #1476).  Self-consistent, but the regression matrix links ritz1-compiled
# callers against ritz0-built ritzlib objects (and bootstrap mixes the two
# compilers' objects), and `file_size(..) -> Result<i64, i32>` came back
# through a 16-byte aggregate read as a 145-byte one with its payload at
# offset 1 instead of 8.
#
# An argument this cannot measure (a type the mangler spells as "", e.g.
# `Option<u32>` -> `Option$`; an unresolved struct; the raw `Result$T$E`
# placeholder) keeps the old conservative size, payload 8-aligned.  Such an
# instantiation is self-consistent within ritz1 but not ritz0-compatible.
# =============================================================================

# 144 = sizeof(Stat), the kernel's struct stat — the widest payload ritzlib
# had when this was the only size (AGAST #1476).
const TAGGED_ENUM_FALLBACK_BYTES: i64 = 144

# te_component_arity, te_arg_end and tagged_enum_arg_in moved to ast_query
# (AGAST #4319); re-exported through `pub import ast_query` above.

# The mangled type argument a tagged-enum variant carries: variant 0 is T
# (Ok / Some), variant 1 is Result's E.  null (out_len 0) for Option's None,
# a non-tagged name, or a name that does not split into exactly its
# arguments.  `Result$Vec$u8$i32`, variant 0 -> `Vec$u8`, 1 -> `i32`.
pub fn tagged_enum_arg(s: *EmitterState, name: *u8, len: i32, variant: i32, out_len: *i32) -> *u8
    tagged_enum_arg_in(@s.struct_map, s.module, name, len, variant, out_len)

# AGAST #2272: is a mangled argument `unit`, the `()` type?  It is zero bytes,
# 1-aligned: `Result<(), i32>` is { i8, [3 x i8], [4 x i8] }, as in ritz0.
pub fn is_unit_arg(name: *u8, len: i32) -> i32
    name_eq(name, len, c"unit", 4)

# Size and alignment (to *align) of the type one mangled argument spells,
# laid out as ritz0 does; 0 when it cannot be measured.
pub fn mangled_type_size_align(s: *EmitterState, name: *u8, len: i32, align: *i64) -> i64
    *align = 1
    if name == null or len <= 0
        return 0
    if is_unit_arg(name, len) == 1
        return 0   # measured: zero bytes (tagged_enum_layout tells it apart)
    let ps: i64 = ty_store_size(ty_from_name(name, len))
    if ps > 0
        *align = ps
        return ps
    if mangled_ref_prefix(name, len) > 0   # "ptr_" / "ref_" / "refmut_"
        *align = 8
        return 8
    if is_tagged_enum_type(name, len) == 1
        var pad: i64 = 0
        let n: i64 = tagged_enum_layout(s, name, len, @pad)
        return 1 + pad + n   # all-i8 struct: 1-aligned
    let st: *StructDef = find_struct(s, name, len)
    if st == null
        let uei: i32 = user_enum_index(name, len)
        if uei >= 0
            return user_enum_size(s, uei)   # all-i8 struct: 1-aligned (#1797)
        if is_enum_type(name, len) == 1
            return 1   # generic user enum: unmeasured, tag only
        return 0
    if st.type_params != null
        return 0
    *align = get_struct_align_by_name(s, name, len)
    get_struct_size_by_name(s, name, len)

# Payload byte count N of tagged enum `name`, with the padding between the
# tag and the payload written to *pad.  See the block comment above.
pub fn tagged_enum_layout(s: *EmitterState, name: *u8, len: i32, pad: *i64) -> i64
    *pad = 7
    var t_len: i32 = 0
    let t: *u8 = tagged_enum_arg(s, name, len, 0, @t_len)
    if t == null
        return TAGGED_ENUM_FALLBACK_BYTES
    var align: i64 = 1
    var size: i64 = mangled_type_size_align(s, t, t_len, @align)
    if size == 0 and is_unit_arg(t, t_len) == 0
        return TAGGED_ENUM_FALLBACK_BYTES
    if name_eq(name, 6, c"Result", 6) == 1
        var e_len: i32 = 0
        let e: *u8 = tagged_enum_arg(s, name, len, 1, @e_len)
        if e == null
            return TAGGED_ENUM_FALLBACK_BYTES
        var e_align: i64 = 1
        let e_size: i64 = mangled_type_size_align(s, e, e_len, @e_align)
        if e_size == 0 and is_unit_arg(e, e_len) == 0
            return TAGGED_ENUM_FALLBACK_BYTES
        if e_size > size
            size = e_size
        if e_align > align
            align = e_align
    *pad = (align - (1 % align)) % align
    size

# =============================================================================
# User-enum layout (AGAST #1797) — ritz0's _define_enum, as for Result/Option:
#
#     %Opt = type { i8 tag, [pad x i8], [N x i8] payload }
#
# N is the largest variant payload, pad aligns it to the most-aligned one.
# A variant's payload is its fields laid out like a struct's (each at its
# own alignment, the total rounded up to the strictest), ritz0's
# _enum_variant_field_layout.  `enum Opt / Vacant / Holds(i32)` is
# { i8, [3 x i8], [4 x i8] }.  As for tagged enums, ritz1 always writes the
# pad field (`[0 x i8]` when nothing needs aligning) so the payload is field
# 2; a zero-length array adds no bytes and no ABI element, so ritz0's
# `{ i8, [N x i8] }` is the same type at a call boundary.  An enum with no
# payload at all stays `{ i8 }`.
#
# Only non-generic enums are measured: a generic `enum Slot<T>` records `T`
# unsubstituted.  (ritzlib's Option / Result are generic and take the
# tagged-enum path above.)
# =============================================================================

# AGAST #2453: a let's type a bare constructor can build: an Option / Result,
# or a user enum, whose `Ok(5)` / `Some(5)` is its own variant
# (users_variant_wins).  resolve_enum_ctx still takes only the builtins.
pub fn is_ctor_slot_enum(name: *u8, len: i32) -> i32
    if is_tagged_enum_type(name, len) == 1
        return 1
    if user_enum_index(name, len) >= 0
        return 1
    0

# Size and alignment (written to *align) of one payload field `f`, as a
# struct field is laid out: an array at its element's, anything else at its
# type's.
fn payload_field_size_align(s: *EmitterState, f: *StructField, align: *i64) -> i64
    var falign: i64 = 8
    var fsize: i64 = 8
    if f.field_type == TYPE_ARRAY
        fsize = field_array_size_align(s, f, @falign)
    else
        fsize = elem_size_align(s, f.field_type, f.field_type_name, f.field_type_name_len, @falign)
    if falign < 1
        falign = 1
    *align = falign
    fsize

# Size of one variant's payload fields, laid out in declaration order at
# their natural alignment and rounded up to the strictest (written to
# *align).  0 for a unit variant.
fn variant_payload_size_align(s: *EmitterState, fields: *StructField, align: *i64) -> i64
    var offset: i64 = 0
    var max_align: i64 = 1
    var f: *StructField = fields
    while f != null
        var falign: i64 = 1
        let fsize: i64 = payload_field_size_align(s, f, @falign)
        let rem: i64 = offset % falign
        if rem != 0
            offset = offset + (falign - rem)
        offset = offset + fsize
        if falign > max_align
            max_align = falign
        f = f.next
    let rem2: i64 = offset % max_align
    if rem2 != 0
        offset = offset + (max_align - rem2)
    *align = max_align
    offset

# AGAST #1295: the byte offset of field `k` within a variant's payload, laid
# out exactly as variant_payload_size_align lays it out (ritz0's
# _enum_variant_field_layout).  Construction and binding both take it from
# here, so they cannot disagree on where a field lives.
fn variant_field_offset(s: *EmitterState, fields: *StructField, k: i32) -> i64
    var offset: i64 = 0
    var i: i32 = 0
    var f: *StructField = fields
    while f != null
        var falign: i64 = 1
        let fsize: i64 = payload_field_size_align(s, f, @falign)
        let rem: i64 = offset % falign
        if rem != 0
            offset = offset + (falign - rem)
        if i == k
            return offset
        offset = offset + fsize
        i += 1
        f = f.next
    offset

# Payload byte count N of user enum `ei`, the tag-to-payload padding written
# to *pad.  0 (and pad 0) when no variant carries a payload.
pub fn user_enum_layout(s: *EmitterState, ei: i32, pad: *i64) -> i64
    *pad = 0
    var max_size: i64 = 0
    var max_align: i64 = 1
    let count: i32 = enum_variant_count(ei)
    for vi in 0..count
        var a: i64 = 1
        let sz: i64 = variant_payload_size_align(s, enum_variant_fields(ei, vi), @a)
        if sz > max_size
            max_size = sz
        if a > max_align
            max_align = a
    if max_size > 0
        *pad = (max_align - (1 % max_align)) % max_align
    max_size

# Total byte size of user enum `ei` (1 for a tag-only enum).
pub fn user_enum_size(s: *EmitterState, ei: i32) -> i64
    var pad: i64 = 0
    let n: i64 = user_enum_layout(s, ei, @pad)
    if n == 0
        return 1
    1 + pad + n

# Field count of variant `vi` of user enum `ei` (0 for a unit variant).
pub fn enum_variant_field_count(ei: i32, vi: i32) -> i32
    var n: i32 = 0
    var f: *StructField = enum_variant_fields(ei, vi)
    while f != null
        n += 1
        f = f.next
    n

# AGAST #1295: byte offset of the payload field `sel` names within the
# payload buffer: 0 for field 0, for Result / Option and for anything not a
# user enum's variant.
pub fn variant_sel_offset(s: *EmitterState, name: *u8, len: i32, sel: i32) -> i64
    if sel < VARIANT_FIELD_STRIDE
        return 0
    let ei: i32 = user_enum_index(name, len)
    if ei < 0
        return 0
    let vi: i32 = sel % VARIANT_FIELD_STRIDE
    if vi >= enum_variant_count(ei)
        return 0
    variant_field_offset(s, enum_variant_fields(ei, vi), sel / VARIANT_FIELD_STRIDE)

# AGAST #1295: a pointer to the payload field `sel` names in the enum at
# `slot_reg`: field 2 (the `[N x i8]` buffer, AGAST #1898), then the field's
# byte offset into it.  The buffer is reached by GEP over the enum struct
# and then by an `i8` GEP, never a single index on the array (the stride
# trap of ENUM_VARIANTS.md section 3.3).
pub fn emit_payload_ptr(s: *EmitterState, slot_reg: i32, name: *u8, len: i32, sel: i32) -> i32
    let pay_ptr: i32 = next_reg(s)
    emit_str(s, c"  ")
    emit_reg(s, pay_ptr)
    emit_str(s, c" = getelementptr %")
    emit_name(s, name, len)
    emit_str(s, c", ptr ")
    emit_reg(s, slot_reg)
    emit_str(s, c", i32 0, i32 2\n")
    let off: i64 = variant_sel_offset(s, name, len, sel)
    if off == 0
        return pay_ptr
    let fld: i32 = next_reg(s)
    emit_str(s, c"  ")
    emit_reg(s, fld)
    emit_str(s, c" = getelementptr i8, ptr ")
    emit_reg(s, pay_ptr)
    emit_str(s, c", i64 ")
    emit_int(s, off)
    emit_str(s, c"\n")
    fld

# Integer width in bits of a scalar payload narrower than i64 — the width it
# is stored at, as ritz0 does — with *signed set for sign- vs zero-extension
# back to ritz1's i64 registers.  64 for i64 / pointers / anything else (the
# i64 store / load ritz1 has always done).  For a user enum (#1797)
# `variant` is the tag of a tuple variant; for Result/Option it is 0 for
# Ok / Some, 1 for Err.
pub fn tagged_enum_scalar_bits(s: *EmitterState, name: *u8, len: i32, variant: i32, signed: *i32) -> i32
    *signed = 1
    if is_tagged_enum_type(name, len) == 0
        let uf: *StructField = user_enum_tuple_field(name, len, variant)
        if uf == null
            return 64
        return type_code_scalar_bits(uf.field_type, signed)
    var c_len: i32 = 0
    let c: *u8 = tagged_enum_arg(s, name, len, variant, @c_len)
    if c == null
        return 64
    if name_eq(c, c_len, c"i8", 2) == 1
        return 8
    if name_eq(c, c_len, c"i16", 3) == 1
        return 16
    if name_eq(c, c_len, c"i32", 3) == 1
        return 32
    *signed = 0
    if name_eq(c, c_len, c"u8", 2) == 1 or name_eq(c, c_len, c"bool", 4) == 1
        return 8
    if name_eq(c, c_len, c"u16", 3) == 1
        return 16
    if name_eq(c, c_len, c"u32", 3) == 1
        return 32
    *signed = 1
    64

# AGAST #3116: the type code of `variant`'s payload (as for
# tagged_enum_scalar_bits) when it is an integer narrower than i64, so a match
# binding of it is that type, as a `let v: u8` is: `Full(v)` over `Slot<u8>`
# was an i64, `sizeof(v)` 8 and `v + v` unwrapped.  0 for anything else: i64,
# bool, a float, a pointer, an aggregate.
pub fn tagged_enum_narrow_int_type(s: *EmitterState, name: *u8, len: i32, variant: i32) -> i32
    let t: i32 = tagged_enum_int_type(s, name, len, variant)
    if ty_int_bits(t) == 64
        return 0
    t

# AGAST #3345: the payload's integer type, i64 / u64 included, else 0.  What
# the payload binding is to the lossy-conversion check (float_slot.ritz).
pub fn tagged_enum_int_type(s: *EmitterState, name: *u8, len: i32, variant: i32) -> i32
    tagged_enum_int_type_in(@s.struct_map, s.module, name, len, variant)

# tagged_enum_int_type over a struct map of `m`: Sema's narrowing check reads
# a match binding's payload type with it (AGAST #3505).
pub fn tagged_enum_int_type_in(structs: *HashMapI64, m: *Module, name: *u8, len: i32, variant: i32) -> i32
    var t: i32 = 0
    if is_tagged_enum_type(name, len) == 0
        let uf: *StructField = user_enum_tuple_field(name, len, variant)
        if uf == null or uf.array_size != 0
            return 0
        t = uf.field_type
    else
        var c_len: i32 = 0
        let c: *u8 = tagged_enum_arg_in(structs, m, name, len, variant, @c_len)
        if c == null
            return 0
        if name_eq(c, c_len, c"i8", 2) == 1
            t = TYPE_I8
        else if name_eq(c, c_len, c"u8", 2) == 1
            t = TYPE_U8
        else if name_eq(c, c_len, c"i16", 3) == 1
            t = TYPE_I16
        else if name_eq(c, c_len, c"u16", 3) == 1
            t = TYPE_U16
        else if name_eq(c, c_len, c"i32", 3) == 1
            t = TYPE_I32
        else if name_eq(c, c_len, c"u32", 3) == 1
            t = TYPE_U32
        else if name_eq(c, c_len, c"i64", 3) == 1
            t = TYPE_I64
        else if name_eq(c, c_len, c"u64", 3) == 1
            t = TYPE_U64
    if ty_int_in(t, 8, 32) == 1
        return t
    if ty_int_bits(t) == 64
        return t
    0

# AGAST #1945: TYPE_F32 / TYPE_F64 when the payload of `variant` (as for
# tagged_enum_scalar_bits) is a float, else 0.  Float payloads are stored and
# loaded as float / double, as ritz0 does, never through the i64 path.
pub fn tagged_enum_float_type(s: *EmitterState, name: *u8, len: i32, variant: i32) -> i32
    if is_tagged_enum_type(name, len) == 0
        let uf: *StructField = user_enum_tuple_field(name, len, variant)
        if uf == null
            return 0
        if uf.field_type == TYPE_F32 or uf.field_type == TYPE_F64
            return uf.field_type
        return 0
    var c_len: i32 = 0
    let c: *u8 = tagged_enum_arg(s, name, len, variant, @c_len)
    if c == null
        return 0
    if name_eq(c, c_len, c"f32", 3) == 1
        return TYPE_F32
    if name_eq(c, c_len, c"f64", 3) == 1
        return TYPE_F64
    0

# The LLVM spelling of float type code `t` (TYPE_F32 or TYPE_F64).
pub fn float_llvm_name(t: i32) -> *u8
    if t == TYPE_F32
        return c"float"
    c"double"

# Convert register `val`, of expression type `src_ty`, to float type `dst_ty`
# (TYPE_F32 / TYPE_F64): passthrough, fptrunc, fpext, or sitofp from the i64
# every integer is carried in.  Returns the converted register.
pub fn emit_float_coerce(s: *EmitterState, val: i32, src_ty: i32, dst_ty: i32) -> i32
    if src_ty == dst_ty
        return val
    let r: i32 = next_reg(s)
    emit_str(s, c"  ")
    emit_reg(s, r)
    if src_ty == TYPE_F64 and dst_ty == TYPE_F32
        emit_str(s, c" = fptrunc double ")
    else if src_ty == TYPE_F32 and dst_ty == TYPE_F64
        emit_str(s, c" = fpext float ")
    else
        emit_str(s, c" = sitofp i64 ")
    emit_reg(s, val)
    emit_str(s, c" to ")
    emit_str(s, float_llvm_name(dst_ty))
    emit_str(s, c"\n")
    r

# `val_reg`, the i64 register integer expression `value` was emitted into,
# converted for an f32 / f64 slot of type `dst_ty`: by `uitofp` when `unsigned`
# (the source type is an unsigned integer exact there: u8 / u16 / u32 sit
# zero-extended in their i64 register), else by `sitofp`.  Returns the
# converted register.
# AGAST #4376: moved here from float_slot.ritz, which is Sema's and imports no
# emitter module.  Its callers pass float_slot_unsigned(value) for `unsigned`.
pub fn emit_int_into_float_slot(s: *EmitterState, val_reg: i32, unsigned: i32, dst_ty: i32) -> i32
    if unsigned == 0
        return emit_float_coerce(s, val_reg, TYPE_I64, dst_ty)
    let r: i32 = next_reg(s)
    emit_str(s, c"  ")
    emit_reg(s, r)
    emit_str(s, c" = uitofp i64 ")
    emit_reg(s, val_reg)
    emit_str(s, c" to ")
    emit_str(s, float_llvm_name(dst_ty))
    emit_str(s, c"\n")
    r


# `<dst> = load i<bits>, ptr <pay_ptr>` widened to i64 for a scalar payload
# of `variant`; returns the i64 register.  See tagged_enum_scalar_bits.
pub fn emit_tagged_payload_load(s: *EmitterState, pay_ptr: i32, name: *u8, len: i32, variant: i32) -> i32
    # AGAST #1945: a float payload loads as float / double, unwidened.
    let ft: i32 = tagged_enum_float_type(s, name, len, variant)
    if ft != 0
        let fr: i32 = next_reg(s)
        emit_str(s, c"  ")
        emit_reg(s, fr)
        emit_str(s, c" = load ")
        emit_str(s, float_llvm_name(ft))
        emit_str(s, c", ptr ")
        emit_reg(s, pay_ptr)
        emit_str(s, c"\n")
        return fr
    var signed: i32 = 1
    let bits: i32 = tagged_enum_scalar_bits(s, name, len, variant, @signed)
    let r: i32 = next_reg(s)
    emit_str(s, c"  ")
    emit_reg(s, r)
    emit_str(s, c" = load i")
    emit_int(s, bits as i64)
    emit_str(s, c", ptr ")
    emit_reg(s, pay_ptr)
    emit_str(s, c"\n")
    if bits == 64
        return r
    let w: i32 = next_reg(s)
    emit_str(s, c"  ")
    emit_reg(s, w)
    if signed == 1
        emit_str(s, c" = sext i")
    else
        emit_str(s, c" = zext i")
    emit_int(s, bits as i64)
    emit_str(s, c" ")
    emit_reg(s, r)
    emit_str(s, c" to i64\n")
    w

# `store i<bits>` of the i64 register `val` into a scalar payload of
# `variant`, truncating first when the payload is narrower.
pub fn emit_tagged_payload_store(s: *EmitterState, val: i32, pay_ptr: i32, name: *u8, len: i32, variant: i32)
    # AGAST #1945: a float payload stores as float / double; `val` must
    # already be of that type (see emit_float_coerce).
    let ft: i32 = tagged_enum_float_type(s, name, len, variant)
    if ft != 0
        emit_str(s, c"  store ")
        emit_str(s, float_llvm_name(ft))
        emit_str(s, c" ")
        emit_reg(s, val)
        emit_str(s, c", ptr ")
        emit_reg(s, pay_ptr)
        emit_str(s, c"\n")
        return
    var signed: i32 = 1
    let bits: i32 = tagged_enum_scalar_bits(s, name, len, variant, @signed)
    var v: i32 = val
    if bits != 64
        v = next_reg(s)
        emit_str(s, c"  ")
        emit_reg(s, v)
        emit_str(s, c" = trunc i64 ")
        emit_reg(s, val)
        emit_str(s, c" to i")
        emit_int(s, bits as i64)
        emit_str(s, c"\n")
    emit_str(s, c"  store i")
    emit_int(s, bits as i64)
    emit_str(s, c" ")
    emit_reg(s, v)
    emit_str(s, c", ptr ")
    emit_reg(s, pay_ptr)
    emit_str(s, c"\n")

# Emit LLVM type with struct name support.  Tagged-enum types emit as the
# named struct so variant constructors / match / return paths share the same
# declared layout.

# Emit the LLVM `<N x iM>` syntax for a SIMD vector type name.  Caller must
# ensure `is_simd_vector_type_name(name, len) == 1` first.
pub fn emit_simd_vector_type(s: *EmitterState, name: *u8, len: i32)
    if name_eq(name, len, c"v16i8", 5) == 1
        emit_str(s, c"<16 x i8>")
    else if name_eq(name, len, c"v8i16", 5) == 1
        emit_str(s, c"<8 x i16>")
    else if name_eq(name, len, c"v4i32", 5) == 1
        emit_str(s, c"<4 x i32>")
    else if name_eq(name, len, c"v2i64", 5) == 1
        emit_str(s, c"<2 x i64>")
    else if name_eq(name, len, c"v32i8", 5) == 1
        emit_str(s, c"<32 x i8>")
    else if name_eq(name, len, c"v16i16", 6) == 1
        emit_str(s, c"<16 x i16>")
    else if name_eq(name, len, c"v8i32", 5) == 1
        emit_str(s, c"<8 x i32>")
    else if name_eq(name, len, c"v4i64", 5) == 1
        emit_str(s, c"<4 x i64>")

# Element bit width for a SIMD vector type — used by `simd_rotl` to compute
# the wrap-around shift constants.  Returns 0 for non-SIMD names.
pub fn simd_vector_elem_bits(name: *u8, len: i32) -> i32
    if name_eq(name, len, c"v16i8", 5) == 1
        return 8
    if name_eq(name, len, c"v8i16", 5) == 1
        return 16
    if name_eq(name, len, c"v4i32", 5) == 1
        return 32
    if name_eq(name, len, c"v2i64", 5) == 1
        return 64
    if name_eq(name, len, c"v32i8", 5) == 1
        return 8
    if name_eq(name, len, c"v16i16", 6) == 1
        return 16
    if name_eq(name, len, c"v8i32", 5) == 1
        return 32
    if name_eq(name, len, c"v4i64", 5) == 1
        return 64
    0

# Element count for a SIMD vector type — used by `simd_rotl` to broadcast
# constant shift amounts.
pub fn simd_vector_elem_count(name: *u8, len: i32) -> i32
    if name_eq(name, len, c"v16i8", 5) == 1
        return 16
    if name_eq(name, len, c"v8i16", 5) == 1
        return 8
    if name_eq(name, len, c"v4i32", 5) == 1
        return 4
    if name_eq(name, len, c"v2i64", 5) == 1
        return 2
    if name_eq(name, len, c"v32i8", 5) == 1
        return 32
    if name_eq(name, len, c"v16i16", 6) == 1
        return 16
    if name_eq(name, len, c"v8i32", 5) == 1
        return 8
    if name_eq(name, len, c"v4i64", 5) == 1
        return 4
    0

# Element scalar LLVM type ("i8"/"i16"/"i32"/"i64") for a SIMD vector name —
# used for extractelement/insertelement opcodes.
pub fn emit_simd_elem_type(s: *EmitterState, name: *u8, len: i32)
    let bits: i32 = simd_vector_elem_bits(name, len)
    if bits == 8
        emit_str(s, c"i8")
    else if bits == 16
        emit_str(s, c"i16")
    else if bits == 32
        emit_str(s, c"i32")
    else if bits == 64
        emit_str(s, c"i64")

pub fn emit_llvm_type_struct(s: *EmitterState, t: i32, name: *u8, name_len: i32)
    if t == TYPE_STRUCT
        # Post-monomorphization (and pre-monomorph for explicit primitive
        # type annotations like `let x: f32`), TYPE_STRUCT + name="u16"/
        # "f32"/"i32"/etc. flows through this helper. The parser doesn't
        # have dedicated tokens for primitive types — they're parsed as
        # generic struct-name annotations. Map them back to LLVM
        # primitives so signatures/calls match.
        let prim: i32 = ty_from_name(name, name_len)
        if prim != TYPE_VOID
            emit_str(s, ty_mem_llvm(prim))
            return
        if name_eq(name, name_len, c"void", 4) == 1
            # `-> void` parses as TYPE_STRUCT with name "void" because the
            # parser uses the generic type-name slot for unknown names.
            # cryptosec.aes / cryptosec.aes_gcm have `pub fn foo(...) -> void`
            # — without this branch we emit `%void = type { i8 }` and
            # `ret void` mismatches the function signature.
            emit_str(s, c"void")
            return
        # AGAST #167: SIMD vector types (`v4i32`, `v16i8`, etc) lower to
        # native LLVM `<N x iM>` rather than the named-struct fallback.
        # Without this, `let v: v4i32 = simd_loadu(...)` allocas a bogus
        # `%v4i32 = type { i8 }` and stores type-mismatch the call result.
        if is_simd_vector_type_name(name, name_len) == 1
            emit_simd_vector_type(s, name, name_len)
            return
        emit_str(s, c"%")
        emit_name(s, name, name_len)
    else
        emit_str(s, ty_value_llvm(t))

# =============================================================================
# AGAST #168: layout-equivalence coercion for Span$u8 ↔ StrView.
#
# Both have identical LLVM layout `{ ptr, i64 }` but are nominally distinct
# named struct types — LLVM IR rejects `store %A, ptr <%B-typed slot>`.
# A bare string literal `"..."` lowers to `%Span$u8`, but `let x: StrView = "..."`
# allocates a `%StrView` slot.  We emit a decompose-and-rebuild
# (extractvalue + insertvalue) on each store/assign/return whose source name
# disagrees with the destination name.
# =============================================================================

# Returns 1 if (src_name, dst_name) is the StrView↔Span$u8 layout-equivalent
# pair (in either direction), else 0.  Names of zero length / null pointers
# return 0.
pub fn is_layout_equiv_pair(src_name: *u8, src_len: i32, dst_name: *u8, dst_len: i32) -> i32
    if src_name == null
        return 0
    if dst_name == null
        return 0
    if src_len == 0
        return 0
    if dst_len == 0
        return 0
    let src_is_span_u8: i32 = name_eq(src_name, src_len, c"Span$u8", 7)
    let src_is_strview: i32 = name_eq(src_name, src_len, c"StrView", 7)
    let dst_is_span_u8: i32 = name_eq(dst_name, dst_len, c"Span$u8", 7)
    let dst_is_strview: i32 = name_eq(dst_name, dst_len, c"StrView", 7)
    if src_is_span_u8 == 1 and dst_is_strview == 1
        return 1
    if src_is_strview == 1 and dst_is_span_u8 == 1
        return 1
    0

# Decompose `%src_name { ptr, i64 }` and rebuild as `%dst_name { ptr, i64 }`.
# Caller must verify is_layout_equiv_pair == 1 before invoking.  Returns
# the register holding the rebuilt aggregate.
pub fn rebuild_layout_equiv(s: *EmitterState, src_reg: i32, src_name: *u8, src_len: i32, dst_name: *u8, dst_len: i32) -> i32
    let p: i32 = next_reg(s)
    emit_str(s, c"  ")
    emit_reg(s, p)
    emit_str(s, c" = extractvalue %")
    emit_name(s, src_name, src_len)
    emit_str(s, c" ")
    emit_reg(s, src_reg)
    emit_str(s, c", 0\n")
    let l: i32 = next_reg(s)
    emit_str(s, c"  ")
    emit_reg(s, l)
    emit_str(s, c" = extractvalue %")
    emit_name(s, src_name, src_len)
    emit_str(s, c" ")
    emit_reg(s, src_reg)
    emit_str(s, c", 1\n")
    let r1: i32 = next_reg(s)
    emit_str(s, c"  ")
    emit_reg(s, r1)
    emit_str(s, c" = insertvalue %")
    emit_name(s, dst_name, dst_len)
    emit_str(s, c" undef, ptr ")
    emit_reg(s, p)
    emit_str(s, c", 0\n")
    let r2: i32 = next_reg(s)
    emit_str(s, c"  ")
    emit_reg(s, r2)
    emit_str(s, c" = insertvalue %")
    emit_name(s, dst_name, dst_len)
    emit_str(s, c" ")
    emit_reg(s, r1)
    emit_str(s, c", i64 ")
    emit_reg(s, l)
    emit_str(s, c", 1\n")
    r2

# =============================================================================
# AGAST #1730 — large struct returns go through an sret pointer
# =============================================================================
#
# ritz1 used to return every struct as a first-class LLVM aggregate
# (`%v = load %T, ptr %slot` / `ret %T %v`).  For a big struct such as the
# 22 KB %TokenDefs of the since-deleted ritzlib/lang/tokens.ritz (inline as
# TOKENDEFS in ritz0/test_ritz1_large_struct_ret.py), InstCombine at -O2 unpacks
# that load into one scalar per leaf (~21k) and clang grows past 13 GB.  Any
# first-class value of such a type does it — a call result stored to a
# local, or a load stored to the sret slot — so the only IR that stays fast
# copies the bytes from pointer to pointer.
#
# A function whose struct return is at least SRET_MIN_BYTES is therefore
# defined `define void @f(ptr sret(%T) %ret.sret, ...)`, every `ret` site
# copies into %ret.sret, and every call site passes a fresh `alloca %T`.
#
# The copy is NOT llvm.memcpy: at these sizes codegen lowers that intrinsic
# to a call to libc `memcpy`, and Ritz links -nostdlib.  It calls a
# module-internal byte loop instead (emit_sret_helpers), which carries
# "no-builtins" so loop-idiom recognition cannot turn it back into memcpy.
#
# This is ABI-identical to the first-class form ritz0 still emits: LLVM
# already demotes a first-class return that does not fit in the return
# registers to a hidden pointer in the first argument register, and returns
# that pointer, exactly as an explicit sret does.  256 bytes is far above
# the largest register return on any target LLVM supports (x86-64: 2 GPRs
# + 2 XMM; AArch64: 8 GPRs + 8 Q regs = 192 B), so objects from either
# compiler keep linking.  Below the threshold nothing changes.
const SRET_MIN_BYTES: i64 = 256

pub fn struct_ret_uses_sret(s: *EmitterState, t: i32, name: *u8, len: i32) -> i32
    if t != TYPE_STRUCT or name == null or len <= 0
        return 0
    if is_primitive_type_name(name, len) == 1
        return 0
    # Tagged enums (Result$/Option$) are not StructDefs and keep their ABI.
    if is_tagged_enum_type(name, len) == 1
        return 0
    if find_struct(s, name, len) == null
        return 0
    # get_struct_size_by_name is the padded LLVM alloc size.  It must be
    # exact, and ritz0's _sret_struct_type must measure the same way: for a
    # PARAM this predicate is the ABI (byval vs first-class), so a struct
    # that only padding lifts to 256 B is byval in both (AGAST #1744,
    # test_byval_exact_size.py).
    if get_struct_size_by_name(s, name, len) < SRET_MIN_BYTES
        return 0
    1

# The exact LLVM alloc size of %T as a constant expression, prefixed `i64 `.
pub fn emit_sret_size(s: *EmitterState, name: *u8, len: i32)
    emit_str(s, c"i64 ptrtoint (ptr getelementptr (%")
    emit_name(s, name, len)
    emit_str(s, c", ptr null, i32 1) to i64)")

# `ptr sret(%T) ` — the attribute both the definition and every call carry.
pub fn emit_sret_attr(s: *EmitterState, name: *u8, len: i32)
    emit_str(s, c"ptr sret(%")
    emit_name(s, name, len)
    emit_str(s, c") ")

# AGAST #1739 — large by-value struct PARAMS are `ptr byval(%T) align 8`.
#
# A param of a struct at the sret threshold used to be a first-class %T
# argument (`define @f(%Big %b.arg)` + `store %Big %b.arg, ptr %slot`, and
# every caller loaded the argument first-class), which hangs clang -O2 for
# the same reason #1730 fixed for returns.  It was also not the C ABI: LLVM
# splits a first-class aggregate argument into one scalar per leaf, while C
# passes a large struct in memory.  `ptr byval(%T) align 8` is exactly what
# clang emits for a C `struct T` param on x86-64 SysV (a struct aligned past
# 8, one of `v4i64`, takes its own alignment: AGAST #3656).  The callee
# binds the param to the byval pointer, which it owns; the caller spills the argument into a fresh slot right after
# evaluating it (emit_call_arg), so rewrite_large_struct_copies (#1732)
# turns that spill into a pointer-to-pointer copy.  Uses the sret threshold,
# so small structs, tagged enums and primitives keep their ABI.
pub fn param_uses_byval(s: *EmitterState, p: *Param) -> i32
    if p == null
        return 0
    struct_ret_uses_sret(s, p.param_type, p.param_type_name, p.param_type_name_len)

# `ptr byval(%T) align A` — what the definition, declare and every call
# carry.  A is 8, or %T's own alignment when that is more: a struct of
# `v4i64` is 32-aligned, and clang gives an over-aligned C struct its type's
# alignment (AGAST #3656).  ritz0's _byval_align writes the same A.
fn emit_byval_attr(s: *EmitterState, name: *u8, len: i32)
    emit_str(s, c"ptr byval(%")
    emit_name(s, name, len)
    emit_str(s, c") align ")
    var a: i64 = get_struct_align_by_name(s, name, len)
    if a < 8
        a = 8
    emit_int(s, a)

# Emit the LLVM type `[N x T]` of a 1-D local array (element struct `name`).
# The spelling matches emit_var_decl's alloca, so a copy loads and stores
# exactly the local's bytes.
pub fn emit_local_array_llvm_type(s: *EmitterState, size: i32, et: i32, name: *u8, name_len: i32)
    emit_str(s, c"[")
    emit_int(s, size as i64)
    emit_str(s, c" x ")
    if et == TYPE_STRUCT and name_len > 0
        emit_str(s, c"%")
        emit_name(s, name, name_len)
    else
        emit_str(s, elem_mem_llvm(et))
    emit_str(s, c"]")

# AGAST #2306 / #3181 — large by-value ARRAYS are `ptr byval` / `ptr sret`.
#
# #2287 / #2302 made a by-value `[N]T` param and a `-> [N]T` return a
# first-class `[N x T]`, which LLVM splits into one scalar per element: at
# N = 16384 u8 clang -O2 hangs, and at 65536 -O0 crashes.  As #1739 / #1730
# did for large structs, an array of at least SRET_MIN_BYTES is passed
# `ptr byval([N x T]) align A` and returned through `ptr sret([N x T])`, the
# same ABI ritz0 emits (both compilers changed together).  A is the
# ELEMENT's natural alignment, not 8: a byval `align` also promises that the
# pointer the caller passes is that aligned, and a `[N]u8` local is only
# 1-aligned.  x86-64 SysV rounds a byval stack slot up to 8 anyway.
#
# The `[N]T` is described by a Param: the param itself, or ret_array_of(f)
# for a return.  Below the threshold nothing changes.

# The byte size of the `[N]T` that `p` holds, with its alignment in *align.
fn array_param_size_align(s: *EmitterState, p: *Param, align: *i64) -> i64
    *align = 8
    if p == null or p.param_type != TYPE_ARRAY
        return 0
    let sh: *ArrayShape = p.param_array_shape
    if sh != null
        # AGAST #3634: `[N][M]..T` is every leaf, at the leaf's alignment.
        return elem_size_align(s, sh.leaf_type, sh.leaf_name, sh.leaf_name_len, align) * (shape_leaf_count(sh) as i64)
    let es: i64 = elem_size_align(s, p.param_array_elem_type, p.param_type_name, p.param_type_name_len, align)
    es * (p.param_array_size as i64)

# 1 when the `[N]T` `p` holds is passed byval / returned sret (AGAST #2306).
pub fn array_param_uses_byval(s: *EmitterState, p: *Param) -> i32
    var align: i64 = 8
    if array_param_size_align(s, p, @align) < SRET_MIN_BYTES
        return 0
    1

# AGAST #3668: the padded LLVM alloc size of a param passed `ptr byval`, a
# struct (param_uses_byval) or an `[N]T` (array_param_uses_byval); 0 for any
# other param.  i64 throughout: a byval past 4 GiB is what this measures.
pub fn param_byval_bytes(s: *EmitterState, p: *Param) -> i64
    if param_uses_byval(s, p) == 1
        return get_struct_size_by_name(s, p.param_type_name, p.param_type_name_len)
    if p == null or p.param_type != TYPE_ARRAY or array_param_uses_byval(s, p) == 0
        return 0
    var align: i64 = 8
    array_param_size_align(s, p, @align)

# AGAST #3668: LLVM's verifier refuses a `byval` type whose alloc size is
# 2^32 bytes or more ("huge 'byval' arguments are unsupported").  ritz1 wrote
# that IR and exited 0, so clang crashed later with no source location.
pub const BYVAL_MAX_BYTES: i64 = 4294967296

# Append `n` bytes of `src` to `buf` at `*at`.
pub fn hb_put(buf: *u8, at: *i64, src: *u8, n: i64)
    memcpy(buf + *at, src, n)
    *at = *at + n

pub fn hb_puts(buf: *u8, at: *i64, src: *u8)
    hb_put(buf, at, src, strlen(src))

# A Ritz leaf type `T` of kind `t`, a struct named `name`.  "?" when unknown.
pub fn hb_put_leaf(buf: *u8, at: *i64, t: i32, name: *u8, name_len: i32)
    let prim: *u8 = primitive_name_from_type(t)
    if prim != null
        hb_puts(buf, at, prim)
    else if name != null and name_len > 0
        hb_put(buf, at, name, name_len as i64)
    else
        hb_puts(buf, at, c"?")

# The param's type as written: `H`, or `[1073741825]i32` for an array.
pub fn hb_put_param_type(buf: *u8, at: *i64, p: *Param)
    if p.param_type != TYPE_ARRAY
        hb_put(buf, at, p.param_type_name, p.param_type_name_len as i64)
        return
    var num: [24]u8 = [0; 24]
    itoa(p.param_array_size as i64, @num[0])
    hb_puts(buf, at, c"[")
    hb_puts(buf, at, @num[0])
    hb_puts(buf, at, c"]")
    if p.param_array_elem_type == TYPE_PTR
        hb_puts(buf, at, c"*")
        hb_put_leaf(buf, at, p.param_array_elem_pointee, p.param_type_name, p.param_type_name_len)
        return
    hb_put_leaf(buf, at, p.param_array_elem_type, p.param_type_name, p.param_type_name_len)

# The fixed text of the byval refusal message; the type is printed twice
# (AGAST #1820: no magic alloc sizes).
const BYVAL_MSG_BASE: i64 = 320

# AGAST #3690: a call through a fn type whose by-value param `p` (the
# `n`th, 1-based) is past LLVM's byval limit is refused at the type's `fn`
# token (sig.line / sig.col; an alias's own, for a call through it), in
# ritz0's words.  An uncalled fn type is a plain `ptr`: nothing to refuse.
# Returns 1 when it refused.
pub fn refuse_huge_fn_type_byval(s: *EmitterState, sig: *FnDef) -> i32
    var refused: i32 = 0
    var n: i32 = 1
    var p: *Param = sig.params
    while p != null
        let bytes: i64 = param_byval_bytes(s, p)
        if bytes >= BYVAL_MAX_BYTES and refused == 0
            let buf: *u8 = malloc(BYVAL_MSG_BASE + 2 * (p.param_type_name_len as i64))
            var at: i64 = 0
            var num: [24]u8 = [0; 24]
            itoa(n as i64, @num[0])
            hb_puts(buf, @at, c"parameter #")
            hb_puts(buf, @at, @num[0])
            hb_puts(buf, @at, c" of this fn type is ")
            itoa(bytes, @num[0])
            hb_puts(buf, @at, @num[0])
            hb_puts(buf, @at, c" bytes, too large to pass by value (LLVM's byval limit is 4 GiB); take it by reference: `@")
            hb_put_param_type(buf, @at, p)
            hb_puts(buf, @at, c"` or `@&")
            hb_put_param_type(buf, @at, p)
            hb_puts(buf, @at, c"`")
            *(buf + at) = 0
            emit_nd_error(s, sig.line, sig.col, buf)
            refused = 1
        n += 1
        p = p.next
    refused

# The `[N x T]` value type of the array `p` holds (its allocas and loads).
# AGAST #3634: a `[N][M]..T` is the nested `[N x [M x T]]`, as ritz0 spells it.
pub fn emit_array_value_llvm_type(s: *EmitterState, p: *Param)
    if p.param_array_shape != null
        emit_array_shape_llvm(s, p.param_array_shape, 0)
        return
    emit_local_array_llvm_type(s, p.param_array_size, p.param_array_elem_type, p.param_type_name, p.param_type_name_len)

# `ptr byval([N x T]) align A`, A the element's alignment (AGAST #2306).
fn emit_byval_array_attr(s: *EmitterState, p: *Param)
    var align: i64 = 8
    array_param_size_align(s, p, @align)
    emit_str(s, c"ptr byval(")
    emit_array_value_llvm_type(s, p)
    emit_str(s, c") align ")
    emit_int(s, align)

# `i64 sizeof([N x T])` as a constant expression, as emit_sret_size spells it.
pub fn emit_array_sret_size(s: *EmitterState, p: *Param)
    emit_str(s, c"i64 ptrtoint (ptr getelementptr (")
    emit_array_value_llvm_type(s, p)
    emit_str(s, c", ptr null, i32 1) to i64)")

# `ptr sret([N x T]) ` (AGAST #3181).
pub fn emit_sret_array_attr(s: *EmitterState, ra: *Param)
    emit_str(s, c"ptr sret(")
    emit_array_value_llvm_type(s, ra)
    emit_str(s, c") ")

# The `-> [N]T` of `f` when it is returned through sret, or null (AGAST #3181).
pub fn fn_sret_array(s: *EmitterState, f: *FnDef) -> *Param
    let ra: *Param = ret_array_of(f)
    if ra == null or array_param_uses_byval(s, ra) == 0
        return null
    ra

# Caller side of a `-> [N]T` sret call: the fresh `[N x T]` slot it writes,
# which is also the call's value (a `ptr`; emit_call_array_store copies it).
fn emit_sret_array_call_slot(s: *EmitterState, ra: *Param) -> i32
    let slot: i32 = next_reg(s)
    emit_str(s, c"  ")
    emit_reg(s, slot)
    emit_str(s, c" = alloca ")
    emit_array_value_llvm_type(s, ra)
    emit_str(s, c"  ; #3181 sret array\n")
    slot

# A call's sret slot, when callee `f` returns `[N]T` through one (AGAST #3181);
# `slot` (a struct's, or 0) otherwise.  Each call site keeps its struct path.
pub fn emit_call_sret_array_slot(s: *EmitterState, f: *FnDef, slot: i32) -> i32
    let ra: *Param = fn_sret_array(s, f)
    if ra == null
        return slot
    emit_sret_array_call_slot(s, ra)

# The `ptr sret(...)` an sret call passes: `[N x T]` or the struct `name`.
pub fn emit_call_sret_attr(s: *EmitterState, f: *FnDef, name: *u8, len: i32)
    let ra: *Param = fn_sret_array(s, f)
    if ra != null
        emit_sret_array_attr(s, ra)
        return
    emit_sret_attr(s, name, len)

# After an sret call: a struct is loaded into `result` (emit_sret_call_result);
# an array's value is its slot, which emit_call_array_store copies from.
pub fn emit_call_sret_result(s: *EmitterState, f: *FnDef, result: i32, slot: i32, name: *u8, len: i32) -> i32
    if fn_sret_array(s, f) != null
        return slot
    emit_sret_call_result(s, result, slot, name, len)
    result

# The LLVM type of param `p` in a signature or call argument list.  AGAST #2287:
# a by-value `[N]T` is a first-class `[N x T]`, as ritz0 emits it; a large one
# is `ptr byval` (AGAST #2306).
pub fn emit_param_llvm_type(s: *EmitterState, p: *Param)
    if param_uses_byval(s, p) == 1
        emit_byval_attr(s, p.param_type_name, p.param_type_name_len)
        return
    if p.param_type == TYPE_ARRAY
        if array_param_uses_byval(s, p) == 1
            emit_byval_array_attr(s, p)
            return
        emit_array_value_llvm_type(s, p)
        return
    emit_llvm_type_struct(s, p.param_type, p.param_type_name, p.param_type_name_len)

# AGAST #2302: the `-> [N]T` of `f` as a by-value param would hold it, or null.
pub fn ret_array_of(f: *FnDef) -> *Param
    if f == null or f.return_type != TYPE_ARRAY
        return null
    return f.ret_array_param

# The non-sret return type of `f` in a definition, declare or call: a `-> [N]T`
# is a first-class `[N x T]`, as ritz0 emits it (AGAST #2302), and `void` when
# large: it then comes back through `ptr sret([N x T])` (AGAST #3181).
pub fn emit_fn_ret_llvm_type(s: *EmitterState, f: *FnDef)
    let ra: *Param = ret_array_of(f)
    if ra != null and array_param_uses_byval(s, ra) == 1
        emit_str(s, c"void")
        return
    if ra != null
        emit_array_value_llvm_type(s, ra)   # AGAST #3634: `[N][M]T` too
        return
    emit_llvm_type_struct(s, f.return_type, f.return_type_name, f.return_type_name_len)

# Return from an sret fn by copying the %T at register `src_ptr` (a `ptr`).
pub fn emit_sret_ret_from_ptr(s: *EmitterState, src_ptr: i32)
    emit_str(s, c"  call void @__ritz_sret_copy(ptr %ret.sret, ptr ")
    emit_reg(s, src_ptr)
    emit_str(s, c", ")
    emit_sret_size(s, s.ret_type_name, s.ret_type_name_len)
    emit_str(s, c")\n")
    emit_str(s, c"  ret void\n")
    s.sret_helpers_used = 1

# Module-internal byte copy / zero used by every sret return.  Defined once
# per module, only when used.  "no-builtins" keeps clang from rewriting the
# loops into libc memcpy/memset calls (see build.py FREESTANDING_FLAGS).
pub fn emit_sret_helpers(s: *EmitterState)
    if s.sret_helpers_used == 0
        return
    emit_str(s, c"define internal void @__ritz_sret_copy(ptr %d, ptr %s, i64 %n) \"no-builtins\"")
    emit_no_red_zone_attr(s)
    emit_str(s, c" {\n")
    emit_str(s, c"entry:\n")
    emit_str(s, c"  %z = icmp eq i64 %n, 0\n")
    emit_str(s, c"  br i1 %z, label %done, label %loop\n")
    emit_str(s, c"loop:\n")
    emit_str(s, c"  %i = phi i64 [ 0, %entry ], [ %i1, %loop ]\n")
    emit_str(s, c"  %sp = getelementptr i8, ptr %s, i64 %i\n")
    emit_str(s, c"  %c = load i8, ptr %sp\n")
    emit_str(s, c"  %dp = getelementptr i8, ptr %d, i64 %i\n")
    emit_str(s, c"  store i8 %c, ptr %dp\n")
    emit_str(s, c"  %i1 = add i64 %i, 1\n")
    emit_str(s, c"  %more = icmp ult i64 %i1, %n\n")
    emit_str(s, c"  br i1 %more, label %loop, label %done\n")
    emit_str(s, c"done:\n")
    emit_str(s, c"  ret void\n")
    emit_str(s, c"}\n\n")
    emit_str(s, c"define internal void @__ritz_sret_zero(ptr %d, i64 %n) \"no-builtins\"")
    emit_no_red_zone_attr(s)
    emit_str(s, c" {\n")
    emit_str(s, c"entry:\n")
    emit_str(s, c"  %z = icmp eq i64 %n, 0\n")
    emit_str(s, c"  br i1 %z, label %done, label %loop\n")
    emit_str(s, c"loop:\n")
    emit_str(s, c"  %i = phi i64 [ 0, %entry ], [ %i1, %loop ]\n")
    emit_str(s, c"  %dp = getelementptr i8, ptr %d, i64 %i\n")
    emit_str(s, c"  store i8 0, ptr %dp\n")
    emit_str(s, c"  %i1 = add i64 %i, 1\n")
    emit_str(s, c"  %more = icmp ult i64 %i1, %n\n")
    emit_str(s, c"  br i1 %more, label %loop, label %done\n")
    emit_str(s, c"done:\n")
    emit_str(s, c"  ret void\n")
    emit_str(s, c"}\n\n")

# Emit `line` with each `#` replaced by `ty`, for emit_fmod_fn's template.
fn emit_typed_line(s: *EmitterState, line: *u8, ty: *u8)
    var i: i32 = 0
    var start: i32 = 0
    while *(line + i) != 0
        if *(line + i) == 35
            vec_push_bytes<u8>(s.out, line + start, (i - start) as i64)
            emit_str(s, ty)
            start = i + 1
        i += 1
    vec_push_bytes<u8>(s.out, line + start, (i - start) as i64)
    emit_str(s, c"\n")

# @__ritz_fmod / @__ritz_fmodf: C's fmod, exactly, at float type `ty`.  Float
# `%` can't be `frem`: x86-64 lowers it to a libm fmod call and Ritz links no
# libc (AGAST #3817).  Binary long division: double |y| up to just past |x|,
# then halve back down to |y|, subtracting where it fits (|x| < |y| subtracts
# nothing).  Each subtraction is
# exact (Sterbenz: d <= r < 2d) and so is each halving (it retraces a
# doubling).  Mirrors ritz0's _fmod_helper.
fn emit_fmod_fn(s: *EmitterState, name: *u8, ty: *u8)
    emit_str(s, c"define internal ")
    emit_str(s, ty)
    emit_str(s, c" @")
    emit_str(s, name)
    emit_typed_line(s, c"(# %x, # %y) {", ty)
    emit_typed_line(s, c"entry:", ty)
    emit_typed_line(s, c"  %xn = fcmp olt # %x, 0.0", ty)
    emit_typed_line(s, c"  %xf = fneg # %x", ty)
    emit_typed_line(s, c"  %ax = select i1 %xn, # %xf, # %x", ty)
    emit_typed_line(s, c"  %yn = fcmp olt # %y, 0.0", ty)
    emit_typed_line(s, c"  %yf = fneg # %y", ty)
    emit_typed_line(s, c"  %ay = select i1 %yn, # %yf, # %y", ty)
    # y == 0, x infinite, or either NaN: NaN (unordered compares are true).
    emit_typed_line(s, c"  %yz = fcmp ueq # %ay, 0.0", ty)
    emit_typed_line(s, c"  %xi = fcmp ueq # %ax, 0x7FF0000000000000", ty)
    emit_typed_line(s, c"  %bad = or i1 %yz, %xi", ty)
    emit_typed_line(s, c"  br i1 %bad, label %nan, label %up", ty)
    emit_typed_line(s, c"nan:", ty)
    emit_typed_line(s, c"  ret # 0x7FF8000000000000", ty)
    emit_typed_line(s, c"up:", ty)
    emit_typed_line(s, c"  %t = phi # [ %ay, %entry ], [ %t2, %up ]", ty)
    emit_typed_line(s, c"  %t2 = fmul # %t, 2.0", ty)
    emit_typed_line(s, c"  %more = fcmp ole # %t2, %ax", ty)
    emit_typed_line(s, c"  br i1 %more, label %up, label %down", ty)
    emit_typed_line(s, c"down:", ty)
    emit_typed_line(s, c"  %r = phi # [ %ax, %up ], [ %r2, %down ]", ty)
    emit_typed_line(s, c"  %d = phi # [ %t, %up ], [ %d2, %down ]", ty)
    emit_typed_line(s, c"  %ge = fcmp oge # %r, %d", ty)
    emit_typed_line(s, c"  %rs = fsub # %r, %d", ty)
    emit_typed_line(s, c"  %r2 = select i1 %ge, # %rs, # %r", ty)
    emit_typed_line(s, c"  %d2 = fmul # %d, 0.5", ty)
    emit_typed_line(s, c"  %again = fcmp ogt # %d, %ay", ty)
    emit_typed_line(s, c"  br i1 %again, label %down, label %done", ty)
    emit_typed_line(s, c"done:", ty)
    emit_typed_line(s, c"  %rn = fneg # %r2", ty)
    emit_typed_line(s, c"  %res = select i1 %xn, # %rn, # %r2", ty)
    emit_typed_line(s, c"  ret # %res", ty)
    emit_str(s, c"}\n\n")

# The fmod helpers float `%` called in this module (fmod_helpers_used: 1 for
# f64, 2 for f32), defined once each.
pub fn emit_fmod_helpers(s: *EmitterState)
    if (s.fmod_helpers_used & 1) != 0
        emit_fmod_fn(s, c"__ritz_fmod", c"double")
    if (s.fmod_helpers_used & 2) != 0
        emit_fmod_fn(s, c"__ritz_fmodf", c"float")

# Return from an sret fn given a first-class %T value register.  When `val`
# is the load of an sret call's slot (`return f()`), copy the slot itself;
# otherwise spill the value and copy that.
pub fn emit_sret_ret_value(s: *EmitterState, val: i32)
    if val == s.sret_last_val and s.sret_last_slot > 0
        emit_sret_ret_from_ptr(s, s.sret_last_slot)
        return
    let tmp: i32 = next_reg(s)
    emit_str(s, c"  ")
    emit_reg(s, tmp)
    emit_str(s, c" = alloca %")
    emit_name(s, s.ret_type_name, s.ret_type_name_len)
    emit_str(s, c"\n  store %")
    emit_name(s, s.ret_type_name, s.ret_type_name_len)
    emit_str(s, c" ")
    emit_reg(s, val)
    emit_str(s, c", ptr ")
    emit_reg(s, tmp)
    emit_str(s, c"\n")
    emit_sret_ret_from_ptr(s, tmp)

# Caller side: allocate the result slot for a call to an sret fn.  Emit it
# BEFORE the `call` line; pass it with emit_sret_attr + emit_reg.
pub fn emit_sret_call_slot(s: *EmitterState, name: *u8, len: i32) -> i32
    let slot: i32 = next_reg(s)
    emit_str(s, c"  ")
    emit_reg(s, slot)
    emit_str(s, c" = alloca %")
    emit_name(s, name, len)
    emit_str(s, c"\n")
    slot

# Caller side, after the call: load the result into `result` as the
# first-class value every consumer expects, and remember the slot.
fn emit_sret_call_result(s: *EmitterState, result: i32, slot: i32, name: *u8, len: i32)
    emit_str(s, c"  ")
    emit_reg(s, result)
    emit_str(s, c" = load %")
    emit_name(s, name, len)
    emit_str(s, c", ptr ")
    emit_reg(s, slot)
    emit_str(s, c"\n")
    s.sret_last_val = result
    s.sret_last_slot = slot

# Coerce the struct value `val` produced by `expr` to the named return type
# `dst_name` when the two are the Span$u8 ↔ StrView layout-equivalent pair;
# otherwise return `val` unchanged.  Shared by every struct `ret` site: the
# explicit `return <expr>` path (#168) and the implicit tail-expression return
# in the emit_fn / emit_impl_method epilogue (#1643), where a tail `"no"` in a
# `-> StrView` fn lowered to `ret %StrView <%Span$u8 value>`.
pub fn coerce_struct_ret_value(s: *EmitterState, expr: *Expr, val: i32, dst_name: *u8, dst_len: i32) -> i32
    var src_name: *u8 = null
    var src_len: i32 = 0
    resolve_expr_struct_name(s, expr, @src_name, @src_len)
    if is_layout_equiv_pair(src_name, src_len, dst_name, dst_len) == 1
        return rebuild_layout_equiv(s, val, src_name, src_len, dst_name, dst_len)
    val

# AGAST #1600: the user enum a bare identifier `B` denotes as a VALUE — a
# unit variant of exactly one non-generic enum, the name not shadowed by a
# const, local, global or fn (those resolve first in emit_expr_ident).
# Returns the enum index with *out_vi = the tag; -1 if `e` is not one; -2 if
# two enums declare the name (*out_vi / *out_other = the two enum indices,
# for the caller's error).  A payload variant used bare is -1: it is not a
# value without its payload.
pub fn bare_unit_variant_enum(s: *EmitterState, e: *Expr, out_vi: *i32, out_other: *i32) -> i32
    *out_vi = 0 - 1
    *out_other = 0 - 1
    if e == null or e.kind != EXPR_IDENT
        return 0 - 1
    if is_const(s, e.ident_ptr, e.ident_len) == 1
        return 0 - 1
    if find_local(s, e.ident_ptr, e.ident_len) >= 0
        return 0 - 1
    if find_global(s, e.ident_ptr, e.ident_len) != null
        return 0 - 1
    if find_fn(s, e.ident_ptr, e.ident_len) != null
        return 0 - 1
    let ei: i32 = enum_of_variant_unique(e.ident_ptr, e.ident_len, out_vi, out_other)
    if ei < 0
        return ei
    if enum_variant_kind(ei, *out_vi) != ENUM_VARIANT_UNIT
        *out_vi = 0 - 1
        return 0 - 1
    return ei

# AGAST #1466: the enum a qualified variant `E.V(args)` (EXPR_METHOD) or
# `E.V` (EXPR_MEMBER) names.  Returns the enum index with *out_vi = the tag,
# or -1 when `e` is not one.  As in ritz0, a local or global named `E`
# shadows the enum (the expression is then a method call / field access on
# it), and a variant beats an impl method of the same name on the enum.
# Generic enums are returned too (callers check enum_is_generic: ritz1 has
# no generic-enum specialisation, so those are located errors).
pub fn qualified_variant(s: *EmitterState, e: *Expr, out_vi: *i32) -> i32
    *out_vi = 0 - 1
    if e == null or (e.kind != EXPR_METHOD and e.kind != EXPR_MEMBER)
        return 0 - 1
    let q: *Expr = e.left
    if q == null or q.kind != EXPR_IDENT
        return 0 - 1
    if find_local(s, q.ident_ptr, q.ident_len) >= 0
        return 0 - 1
    if find_global(s, q.ident_ptr, q.ident_len) != null
        return 0 - 1
    let ei: i32 = enum_find(q.ident_ptr, q.ident_len)
    if ei < 0
        return 0 - 1
    let vi: i32 = enum_variant_index(q.ident_ptr, q.ident_len, e.ident_ptr, e.ident_len)
    if vi < 0
        return 0 - 1
    *out_vi = vi
    return ei

# AGAST #1466: the (non-generic) enum a qualified variant `E.V(args)` or
# `E.V` builds, for type inference (untyped let, match scrutinee, an
# aggregate payload).  null/0 otherwise.
pub fn qualified_variant_enum(s: *EmitterState, e: *Expr, out_name: **u8, out_len: *i32)
    *out_name = null
    *out_len = 0
    var vi: i32 = 0
    let ei: i32 = qualified_variant(s, e, @vi)
    if ei < 0 or enum_is_generic(ei) == 1
        return
    *out_name = enum_name_at(ei, out_len)

# AGAST #1466: a qualified variant ritz1 cannot build, as
# `<file>:<line>:<col>: error: 'E.V' <msg>`.  Counted like emit_ir_error, so
# no output is written; returns a placeholder register.  Also `'Span.empty'`
# with no slot to type it (AGAST #2296): any `Type.method` call fits.
pub fn emit_qualified_variant_error(s: *EmitterState, e: *Expr, msg: *u8) -> i32
    emit_str(s, c"  ; ERROR: qualified variant ")
    emit_str(s, msg)
    emit_str(s, c"\n")
    diag_error_at(emitter_source_file(), e.span)
    eprints_cstr(c"'")
    eprint_bytes(e.left.ident_ptr, e.left.ident_len)
    eprints_cstr(c".")
    eprint_bytes(e.ident_ptr, e.ident_len)
    eprints_cstr(c"' ")
    eprints_cstr(msg)
    eprints_cstr(c"\n")
    s.error_count = s.error_count + 1
    let z: i32 = next_reg(s)
    emit_str(s, c"  ")
    emit_reg(s, z)
    emit_str(s, c" = add i64 0, 0\n")
    z

# AGAST #2215: `q.n` is module access, which LANGUAGE_SPEC §15.3 removed,
# when `q` names no value or type in scope (a local, global, const, fn,
# struct, enum, built-in type or impl'd type) and `n` names a const, global
# or fn.  `E.V` and a value's `.field` are not.  ritz0: _is_module_item.
pub fn is_module_item(s: *EmitterState, q: *u8, ql: i32, n: *u8, nl: i32) -> i32
    if find_local(s, q, ql) >= 0 or find_global(s, q, ql) != null
        return 0
    if is_const(s, q, ql) == 1 or find_fn(s, q, ql) != null
        return 0
    if is_enum_type(q, ql) == 1 or find_struct(s, q, ql) != null
        return 0
    if name_eq(q, ql, c"Span", 4) == 1 or name_eq(q, ql, c"StrView", 7) == 1
        return 0
    if name_eq(q, ql, c"Option", 6) == 1 or name_eq(q, ql, c"Result", 6) == 1
        return 0
    var ib: *ImplBlock = s.module.impls
    while ib != null
        if name_eq(ib.type_name, ib.type_name_len, q, ql) == 1
            return 0
        ib = ib.next
    if is_const(s, n, nl) == 1 or find_global(s, n, nl) != null or find_fn(s, n, nl) != null
        return 1
    0

# The error for module access `q.n` at line:col, worded as ritz0's
# module_item_access_removed (ritz0/qualified_access.py).  Counted like
# emit_ir_error, so no output is written.  Returns a dummy register.
pub fn emit_module_item_error(s: *EmitterState, q: *u8, ql: i32, n: *u8, nl: i32, line: i32, col: i32) -> i32
    emit_str(s, c"  ; ERROR: module.item access\n")
    diag_error_at(emitter_source_file(), diag_span(line, col))
    eprint_char('`')
    eprint_bytes(q, ql)
    eprints_cstr(c".")
    eprint_bytes(n, nl)
    eprints_cstr(c"`: there is no `module.item` access (LANGUAGE_SPEC §15.3). ")
    eprints_cstr(c"Imported names share one namespace, so write `")
    eprint_bytes(n, nl)
    eprints_cstr(c"`\n")
    s.error_count = s.error_count + 1
    let z: i32 = next_reg(s)
    emit_str(s, c"  ")
    emit_reg(s, z)
    emit_str(s, c" = add i64 0, 0\n")
    z

# AGAST #1600 / #2039: `name` (a bare variant used as a value, or the callee
# of a ctor call) is a variant of two enums (`ea`, `eb`).  Whatever the
# expected type, this is a located error asking for the qualified form; ritz0
# prints the same text.  Counted like emit_ir_error, so no output is written;
# returns a placeholder register to keep the IR well-formed.
pub fn emit_ambiguous_variant_error(s: *EmitterState, name: *u8, len: i32, span: SrcSpan, ea: i32, eb: i32) -> i32
    var a_len: i32 = 0
    let a: *u8 = enum_name_at(ea, @a_len)
    var b_len: i32 = 0
    let b: *u8 = enum_name_at(eb, @b_len)
    emit_str(s, c"  ; ERROR: ambiguous enum variant '")
    emit_name(s, name, len)
    emit_str(s, c"'\n")
    diag_error_at(emitter_source_file(), span)
    eprints_cstr(c"ambiguous enum variant '")
    eprint_bytes(name, len)
    eprints_cstr(c"': declared by enum '")
    eprint_bytes(a, a_len)
    eprints_cstr(c"' and enum '")
    eprint_bytes(b, b_len)
    eprints_cstr(c"'; qualify it, e.g. '")
    eprint_bytes(a, a_len)
    eprints_cstr(c".")
    eprint_bytes(name, len)
    eprints_cstr(c"'\n")
    s.error_count = s.error_count + 1
    let zero: i32 = next_reg(s)
    emit_str(s, c"  ")
    emit_reg(s, zero)
    emit_str(s, c" = add i64 0, 0\n")
    return zero

# Best-effort resolve the LLVM struct type-name produced by an expression.
# Writes the name pointer and length into the out-pointers, or null/0 if
# the producer's struct type isn't statically known.  Used to detect
# Span$u8 ↔ StrView layout-equivalence pairs at store/assign sites.
pub fn resolve_expr_struct_name(s: *EmitterState, e: *Expr, out_name: **u8, out_len: *i32)
    *out_name = null
    *out_len = 0
    if e == null
        return
    # Bare "..." literal lowers to %Span$u8 (AGAST #98).
    if e.kind == EXPR_STRING_LIT
        *out_name = c"Span$u8"
        *out_len = 7
        return
    # AGAST #2131: a struct-target cast (`"..." as StrView`) emits its
    # operand's register unchanged, so its LLVM type is the operand's.
    # Reporting that lets the store/arg/return coercions rebuild a
    # `%Span$u8` into the `%StrView` the slot expects.
    if e.kind == EXPR_CAST and e.op == TYPE_STRUCT
        # AGAST #3004: `r as C` through a reference loads the `%C` itself.
        let reads_referent: fn(*EmitterState, *Expr) -> i32 = s.ref_cast_reads_referent_fn
        if reads_referent(s, e) == 1
            *out_name = e.ident_ptr
            *out_len = e.ident_len
            return
        resolve_expr_struct_name(s, e.left, out_name, out_len)
        return
    # Builtin StrView.as_bytes() -> %Span$u8.
    if e.kind == EXPR_METHOD
        if name_eq(e.ident_ptr, e.ident_len, c"as_bytes", 8) == 1
            *out_name = c"Span$u8"
            *out_len = 7
            return
        # AGAST #1466: a qualified variant ctor `Opt.Holds(x)` is the enum.
        qualified_variant_enum(s, e, out_name, out_len)
        if *out_name != null
            return
        # Impl-method call: walk receiver's struct type then impl table.
        var recv_tn: *u8 = null
        var recv_tn_len: i32 = 0
        let rcv: *Expr = e.left
        if rcv != null and rcv.kind == EXPR_IDENT
            let loc: *LocalVar = find_local_struct_name(s, rcv.ident_ptr, rcv.ident_len)
            if loc != null and loc.type_name_len > 0
                recv_tn = loc.type_name
                recv_tn_len = loc.type_name_len
        if recv_tn != null and recv_tn_len > 0
            var ib: *ImplBlock = s.module.impls
            while ib != null
                if name_eq(ib.type_name, ib.type_name_len, recv_tn, recv_tn_len) == 1
                    var m: *FnDef = ib.methods
                    while m != null
                        if name_eq(m.name, m.name_len, e.ident_ptr, e.ident_len) == 1
                            if m.return_type == TYPE_STRUCT and m.return_type_name_len > 0
                                *out_name = m.return_type_name
                                *out_len = m.return_type_name_len
                            return
                        m = m.next
                    return
                ib = ib.next
        return
    # Local binding to a known struct type.  Gate on `var_type == TYPE_STRUCT`
    # — pointer-typed locals (`s: *StrView`, `cstr: *u8`) carry the pointee
    # name in `type_name` (set by param_new for TYPE_PTR per ast_helpers.ritz)
    # but their loaded register holds an `i64`, not the struct aggregate.
    # Reporting the struct name in that case fools callers like
    # try_emit_span_to_i64_arg into emitting `extractvalue %StrView i64`.
    # (AGAST #176)
    if e.kind == EXPR_IDENT
        let loc: *LocalVar = find_local_struct_name(s, e.ident_ptr, e.ident_len)
        if loc != null and loc.type_name_len > 0 and loc.var_type == TYPE_STRUCT
            *out_name = loc.type_name
            *out_len = loc.type_name_len
            return
        # AGAST #189 — scalar struct consts (`const FOO: StrView = "..."`)
        # carry the struct type name in the ConstEntry; surface it so the
        # call-site coercion cascade (try_emit_span_to_i64_arg) can match
        # it like any other StrView/Span aggregate when the param is i64-
        # shaped (`@StrView`, `*u8`, etc.).
        let ce: *ConstEntry = find_const_entry(s, e.ident_ptr, e.ident_len)
        if ce != null and ce.const_type == TYPE_STRUCT and ce.type_name_len > 0
            *out_name = ce.type_name
            *out_len = ce.type_name_len
            return
        # AGAST #1600: a bare unit variant `B` is a value of its enum.
        var vi: i32 = 0
        var other: i32 = 0
        let ei: i32 = bare_unit_variant_enum(s, e, @vi, @other)
        if ei >= 0
            *out_name = enum_name_at(ei, out_len)
        return
    # Function-call return-type lookup.
    if e.kind == EXPR_CALL
        # AGAST #1797: a user-enum payload ctor `Holds(x)` is the enum.
        user_variant_ctor_enum(e, out_name, out_len)
        if *out_name != null
            return
        let fdr: *FnDef = find_call_fn(s, e)
        if fdr != null and fdr.return_type == TYPE_STRUCT and fdr.return_type_name_len > 0
            *out_name = fdr.return_type_name
            *out_len = fdr.return_type_name_len
        return
    # Struct literal carries its own type name.
    if e.kind == EXPR_STRUCT_LIT
        if e.ident_ptr != null and e.ident_len > 0
            *out_name = e.ident_ptr as *u8
            *out_len = e.ident_len
        return

# AGAST #1647: the struct a call or method call returns BY VALUE, so a field
# can be read off it: `mk(true).b`, `p.pair().a`, `Q.make(1).x`.  Writes the
# struct name, or null/0 when the callee or its struct return isn't known.
#
# A method's receiver names its impl as method_recv_type_name resolves it:
# a local, global or type (`Q.make`), a call or method chain (`a.b().c().x`,
# #2594), a field (`self.f.get(1)`) or an element (`self.ws[i].m()`, #3622).
pub fn call_result_struct_name(s: *EmitterState, e: *Expr, out_name: **u8, out_len: *i32)
    *out_name = null
    *out_len = 0
    let fd: *FnDef = call_callee_def(s, e)
    if fd == null
        # AGAST #3161: no FnDef, but a built-in Span slice (`s.slice(1, 3).len()`).
        span_builtin_slice_struct(s, e, out_name, out_len)
        # AGAST #3620: or `.unwrap()` / `.unwrap_or(d)` of an Option<S> or
        # Result<S, E>, whose S names the next link of a chain
        # (`r.focused_window().unwrap().raw()`, prism's test_input).
        if *out_len == 0
            unwrap_payload_struct_name(s, e, out_name, out_len)
            if *out_len > 0 and find_struct(s, *out_name, *out_len) == null
                *out_name = null
                *out_len = 0
        return
    if fd.return_type != TYPE_STRUCT or fd.return_type_name_len <= 0
        return
    *out_name = fd.return_type_name
    *out_len = fd.return_type_name_len

# AGAST #2594: the struct payload `init` = `r.unwrap()` gives, `r` an
# Option<S> or Result<S, E> (try_emit_enum_unwrap loads it as a `%S`), or
# null/0.  AGAST #3250 / #2863: `r.unwrap_or(d)` gives the same `%S` (its
# select is on `%S`), so `let t = r.unwrap_or(d)` is an `%S` slot too.
pub fn unwrap_payload_struct_name(s: *EmitterState, init: *Expr, out_name: **u8, out_len: *i32)
    if init.kind != EXPR_METHOD or init.left == null
        return
    let is_unwrap: bool = init.args == null and name_eq(init.ident_ptr, init.ident_len, c"unwrap", 6) == 1
    let is_unwrap_or: bool = init.args != null and init.args.next == null and name_eq(init.ident_ptr, init.ident_len, c"unwrap_or", 9) == 1
    if not is_unwrap and not is_unwrap_or
        return
    var enum_name: *u8 = null
    var enum_len: i32 = 0
    call_result_struct_name(s, init.left, @enum_name, @enum_len)
    if enum_len == 0
        resolve_expr_struct_name(s, init.left, @enum_name, @enum_len)
    if enum_len == 0
        return
    if starts_with(enum_name, enum_len, c"Option$", 7) == 0 and starts_with(enum_name, enum_len, c"Result$", 7) == 0
        return
    # A user-enum payload too (AGAST #3620), as try_emit_enum_unwrap loads it.
    var pay_len: i32 = 0
    let pay: *u8 = tagged_enum_payload_named(s, enum_name, enum_len, @pay_len, 1)
    if pay != null and pay_len > 0
        *out_name = pay
        *out_len = pay_len

# AGAST #3161: `.slice(lo, hi)` on a `Span<T>` that no FnDef resolves (the
# callers ask only once method_callee_def found none) is try_emit_span_builtin's
# struct operation, whose result is the receiver's own %Span$T: name it, so an
# untyped `let t = s.slice(1, 3)` or a chain `s.slice(1, 3).len()` has a type
# with no ritzlib.span to give one.  The receiver is a local (its type, or its
# pointee for `*Span<T>`) or a call or method call call_result_struct_name
# types (another slice: `s.slice(0, 4).slice(2, 3)`).  Null/0 otherwise.
pub fn span_builtin_slice_struct(s: *EmitterState, e: *Expr, out_name: **u8, out_len: *i32)
    *out_name = null
    *out_len = 0
    if e == null or e.kind != EXPR_METHOD or e.left == null
        return
    if name_eq(e.ident_ptr, e.ident_len, c"slice", 5) == 0
        return
    if e.args == null or e.args.next == null or e.args.next.next != null
        return
    var recv: *u8 = null
    var recv_len: i32 = 0
    if e.left.kind == EXPR_IDENT
        let loc: *LocalVar = find_local_struct_name(s, e.left.ident_ptr, e.left.ident_len)
        if loc != null
            recv = loc.type_name
            recv_len = loc.type_name_len
    else
        call_result_struct_name(s, e.left, @recv, @recv_len)
    if recv == null or starts_with(recv, recv_len, c"Span$", 5) == 0
        return
    *out_name = recv
    *out_len = recv_len

# AGAST #2870: the pointee a call or method call returns a `*S` of, by the same
# callee resolution: `mkp()[i].f` is element i of what it points at.  Null/0
# otherwise.  A scalar pointee is named too (monomorph's `-> *T` names "i32"):
# find_struct, the caller's, turns it away.
pub fn call_result_pointee_struct(s: *EmitterState, e: *Expr, out_name: **u8, out_len: *i32)
    *out_name = null
    *out_len = 0
    let fd: *FnDef = call_callee_def(s, e)
    if fd == null or fd.return_type != TYPE_PTR or fd.return_type_name_len <= 0
        return
    *out_name = fd.return_type_name
    *out_len = fd.return_type_name_len

# AGAST #2299: the struct S a call returning `*S` points at, so `e[i]` is an
# S in place; null when the callee is unknown or returns anything else.
pub fn call_ptr_elem_struct(s: *EmitterState, e: *Expr) -> *StructDef
    var name: *u8 = null
    var len: i32 = 0
    call_result_pointee_struct(s, e, @name, @len)
    if len <= 0
        return null
    find_struct(s, name, len)

# AGAST #2879: the struct S a call or method call returns a `*S` to, so a
# field of its result is a place: `sp(@s).x = 3`, `s.me().arr[2] = 5`.  The
# callee is found as call_result_struct_name finds it; null when it isn't
# known, or returns anything but a pointer to a struct.
pub fn call_result_ptr_struct(s: *EmitterState, e: *Expr) -> *StructDef
    let fd: *FnDef = call_callee_def(s, e)
    if fd == null or fd.return_type_name_len <= 0
        return null
    # AGAST #3015: an `@S` / `@&S` result is S's address too (`deref`'s, whose
    # reference is the receiver of a method reached through `Deref`).
    if fd.return_type != TYPE_PTR and fd.return_type != TYPE_REF and fd.return_type != TYPE_MUT_REF
        return null
    if fd.ret_ptr_array != null
        return null
    find_struct(s, fd.return_type_name, fd.return_type_name_len)

# The FnDef call_result_struct_name resolves `e` to, or null.
pub fn call_callee_def(s: *EmitterState, e: *Expr) -> *FnDef
    if e == null
        return null
    var fd: *FnDef = null
    if e.kind == EXPR_CALL
        fd = find_call_fn(s, e)
    else if e.kind == EXPR_METHOD and e.left != null
        # The impl the receiver names, as emit_expr_method dispatches it: a
        # local, global or type (AGAST #2044), a call or method chain (#2295,
        # #2594, #2946, #2883), a field (`self.f.get(1)`) or an element
        # (`self.ws[i].bounds()`, #3622).  One resolver, method_recv_type_name.
        var recv_len: i32 = 0
        let recv: *u8 = method_recv_type_name(s, e, @recv_len)
        if recv != null and recv_len > 0
            var ib: *ImplBlock = s.module.impls
            while ib != null and fd == null
                if name_eq(ib.type_name, ib.type_name_len, recv, recv_len) == 1
                    var m: *FnDef = ib.methods
                    while m != null and fd == null
                        if name_eq(m.name, m.name_len, e.ident_ptr, e.ident_len) == 1
                            fd = m
                        m = m.next
                ib = ib.next
            # AGAST #2726: no impl of that name -- a UFCS helper or a
            # specialized generic impl method, as emit_expr_method dispatches.
            # #2451 makes `v[lo..hi]` the call `v.slice(lo, hi)` (vec_slice$T /
            # span_slice$T), so `v[1..3].len` is a field of this call's result.
            if fd == null
                fd = method_callee_def(s, recv, recv_len, e.ident_ptr, e.ident_len)
    fd

# AGAST #2302: the `-> [N]T` (as a by-value param holds it) of the call `e`,
# or null.  A call through a `fn() -> [N]T` local is typed by its signature, as
# emit_expr's EXPR_CALL arm calls it; a direct, method or static call by its
# FnDef.
pub fn call_ret_array(s: *EmitterState, e: *Expr) -> *Param
    if e == null or (e.kind != EXPR_CALL and e.kind != EXPR_METHOD)
        return null
    if e.kind == EXPR_CALL and e.func_name_len > 0 and e.call_type_suffix_len == 0
        let lv: *LocalVar = find_local_struct_name(s, e.func_name, e.func_name_len)
        if lv != null
            return ret_array_of(lv.fn_sig)
    return ret_array_of(call_callee_def(s, e))

# AGAST #175: type-only resolution of an EXPR_MEMBER chain rooted at an
# identifier (local or global).  Returns the *StructField for the innermost
# field (e.g. for `a.b.c` returns the field for `c`), or null if any link in
# the chain can't be resolved.  Mirrors emit_member_ptr's traversal but
# emits no IR — used by var-decl narrowing to infer pointee types for
# `let x = @a.b.c[i]` so the binding registers as a *Struct with the right
# type_name.  Without this, chained-member addr-of falls through to
# "; ERROR: unhandled EXPR_MEMBER".
pub fn resolve_member_chain_field(s: *EmitterState, e: *Expr) -> *StructField
    if e == null
        return null
    if e.kind != EXPR_MEMBER
        return null
    var sname: *u8 = null
    var sname_len: i32 = 0
    if e.left.kind == EXPR_IDENT
        let mloc: *LocalVar = find_local_struct_name(s, e.left.ident_ptr, e.left.ident_len)
        if mloc != null and mloc.type_name_len > 0
            if mloc.var_type == TYPE_PTR or mloc.var_type == TYPE_PTR_PTR or mloc.var_type == TYPE_STRUCT or mloc.var_type == TYPE_REF or mloc.var_type == TYPE_MUT_REF
                sname = mloc.type_name
                sname_len = mloc.type_name_len
        if sname == null
            let mglob: *GlobalVarDef = find_global(s, e.left.ident_ptr, e.left.ident_len)
            if mglob != null and mglob.var_type == TYPE_STRUCT and mglob.type_name_len > 0
                sname = mglob.type_name
                sname_len = mglob.type_name_len
    else if e.left.kind == EXPR_MEMBER
        # Recurse: resolve parent's field, then dereference into the field's struct
        let parent_field: *StructField = resolve_member_chain_field(s, e.left)
        if parent_field != null
            if parent_field.field_type == TYPE_STRUCT and parent_field.field_type_name_len > 0
                sname = parent_field.field_type_name
                sname_len = parent_field.field_type_name_len
            else if (parent_field.field_type == TYPE_PTR or parent_field.field_type == TYPE_PTR_PTR) and parent_field.field_type_name_len > 0
                sname = parent_field.field_type_name
                sname_len = parent_field.field_type_name_len
    # AGAST #1647: `mk().f` / `p.m().f` — the callee's struct return type.
    else if e.left.kind == EXPR_CALL or e.left.kind == EXPR_METHOD
        call_result_struct_name(s, e.left, @sname, @sname_len)
        # AGAST #2517: `mkp().f`, a field of the struct a `*S` call points
        # at, as emit_member_ptr reaches it (#2879): `mkp().m[1][2]` indexes it.
        if sname == null
            let pst: *StructDef = call_result_ptr_struct(s, e.left)
            if pst != null
                return member_field_of(s, pst, e)
    # AGAST #2152: `arr[i].f` / `p[i].f` / `o.items[i].f` / `g[i][j].f`.
    else if e.left.kind == EXPR_INDEX
        index_elem_struct_name(s, e.left, @sname, @sname_len)
    # AGAST #2152: `(*p).f` / `(*w.p).f`.
    else if e.left.kind == EXPR_UNARY and e.left.op == OP_DEREF
        deref_member_base_struct_name(s, e.left.operand, @sname, @sname_len)
    if sname == null or sname_len == 0
        return null
    member_field_of(s, find_struct(s, sname, sname_len), e)

# The field of `st` the member `e` names; null when `st` is null or has no such
# field.  A field reached through `Deref` was rewritten to `(*S_deref(@s)).f`
# before this is asked (deref_field.ritz, AGAST #3015).
fn member_field_of(s: *EmitterState, st: *StructDef, e: *Expr) -> *StructField
    if st == null
        return null
    let fidx: i32 = find_field_index(st, e.ident_ptr, e.ident_len)
    if fidx < 0
        return null
    return get_field_type(st, fidx)

# AGAST #2152: the struct an index expression `ie` yields an element of, for
# a `.field` on it, or null/0.  Type-only; mirrors emit_member_ptr's
# EXPR_INDEX arms (an N-D chain with a struct leaf, a struct-array or
# `**S` field, a struct / pointer-to-struct array local, a `*S` local, a
# struct-array global).  Shapes emit_member_ptr does not lower stay null.
pub fn index_elem_struct_name(s: *EmitterState, ie: *Expr, out_name: **u8, out_len: *i32)
    *out_name = null
    *out_len = 0
    if ie == null or ie.kind != EXPR_INDEX or ie.left == null
        return
    if index_through_struct(s, ie, out_name, out_len) == 1
        return   # AGAST #2440
    # AGAST #2332: an element of `[N]*S`, whatever holds the array.
    if array_elem_pointee(s, ie, out_name, out_len) == TYPE_STRUCT
        return
    if array_elem_pointee(s, ie.left, out_name, out_len) == TYPE_STRUCT
        return   # `a[i][j]`
    var nd_depth: i32 = 0
    let nd_sh: *ArrayShape = nd_index_shape(s, ie, @nd_depth)
    if nd_sh != null
        if nd_depth == nd_sh.rank and nd_sh.leaf_type == TYPE_STRUCT
            *out_name = nd_sh.leaf_name
            *out_len = nd_sh.leaf_name_len
        return
    let b: *Expr = ie.left
    if b.kind == EXPR_MEMBER
        let f: *StructField = resolve_member_chain_field(s, b)
        if f == null
            return
        if f.field_type == TYPE_ARRAY and f.array_elem_type_name_len > 0
            *out_name = f.array_elem_type_name
            *out_len = f.array_elem_type_name_len
        else if f.field_type == TYPE_PTR_PTR and f.field_type_name_len > 0
            *out_name = f.field_type_name
            *out_len = f.field_type_name_len
        # AGAST #3972: an element of a `*S` field, `s.rs[i]`, as emit_member_ptr
        # lowers it.  `let m = @s.rs[0].m` left `m` untyped.
        else if ptr_field_struct_elem(s, f) == 1
            *out_name = f.field_type_name
            *out_len = f.field_type_name_len
        return
    if b.kind != EXPR_IDENT
        return
    let lv: *LocalVar = find_local_struct_name(s, b.ident_ptr, b.ident_len)
    if lv != null
        if lv.type_name_len <= 0
            return
        let ae: i32 = lv.array_elem_type
        if lv.var_type == TYPE_ARRAY and (ae == TYPE_STRUCT or ae == TYPE_PTR or ae == TYPE_PTR_PTR)
            *out_name = lv.type_name
            *out_len = lv.type_name_len
        else if lv.var_type == TYPE_PTR
            *out_name = lv.type_name
            *out_len = lv.type_name_len
        return
    let g: *GlobalVarDef = find_global(s, b.ident_ptr, b.ident_len)
    if g != null and g.var_type == TYPE_ARRAY and g.array_elem_type == TYPE_STRUCT and g.array_elem_type_name_len > 0
        *out_name = g.array_elem_type_name
        *out_len = g.array_elem_type_name_len
        return
    # AGAST #3671: an element of a module `const T: [N]S = [...]`, which
    # emit_member_ptr reaches like a `[N]S` global.  Unnamed, `T[0].s` typed
    # as i64 (`*(T[0].s + 1)` loaded 8 bytes) and an f32 `T[0].a` as f64.
    let ce: *ConstEntry = const_struct_array_elem(s, ie)
    if ce != null
        *out_name = ce.array_elem_type_name
        *out_len = ce.array_elem_type_name_len

# AGAST #3360: `e` is `A[i]` of a module `const A: [N]S = [...]` that no
# local or global of the name shadows: A's ConstEntry, else null.  Its
# element is a place in the const's read-only data, so a method call on it
# lends it as a global's would; let_check refuses every mutable lend.
pub fn const_struct_array_elem(s: *EmitterState, e: *Expr) -> *ConstEntry
    if e == null or e.kind != EXPR_INDEX or e.left == null or e.left.kind != EXPR_IDENT
        return null
    if e.right == null or e.right.kind == EXPR_RANGE
        return null
    if find_local_idx(s, e.left.ident_ptr, e.left.ident_len) >= 0 or find_global(s, e.left.ident_ptr, e.left.ident_len) != null
        return null
    let ce: *ConstEntry = find_const_entry(s, e.left.ident_ptr, e.left.ident_len)
    if ce == null or ce.const_type != TYPE_ARRAY or ce.array_elem_type != TYPE_STRUCT or ce.array_elem_type_name_len <= 0
        return null
    # emit_const_array_entry declares `[N x %S]` for a literal or a struct
    # fill (const_struct_fill_global: AGAST #3946, #3978).
    if ce.value_expr == null or (ce.value_expr.kind != EXPR_ARRAY_LIT and const_struct_fill_global(ce) == 0)
        return null
    ce

# AGAST #2592: the struct `ie` reads by value -- an element of a `[N]S` local,
# global or field, which emit_expr_index loads as a `%S` -- or null/0.  Unlike
# index_elem_struct_name, an element of `[N]*S` or of a `*S` is a pointer, not
# an S, so it names nothing here.
pub fn index_struct_value_name(s: *EmitterState, ie: *Expr, out_name: **u8, out_len: *i32)
    *out_name = null
    *out_len = 0
    if ie == null or ie.kind != EXPR_INDEX or ie.left == null or ie.right == null
        return
    if ie.right.kind == EXPR_RANGE
        return
    # AGAST #3306: a full-depth chain over an N-D `[..]S` (local, global,
    # field, plane pointer) is the `%S` emit_nd_index_value loads; a row
    # (`g[i]` of `[N][M]S`) is no S, whatever the base's element type says.
    var nd_depth: i32 = 0
    let nd_sh: *ArrayShape = nd_index_shape(s, ie, @nd_depth)
    if nd_sh != null
        if nd_depth == nd_sh.rank and nd_sh.leaf_type == TYPE_STRUCT and nd_sh.leaf_name_len > 0
            *out_name = nd_sh.leaf_name
            *out_len = nd_sh.leaf_name_len
        return
    let b: *Expr = ie.left
    if b.kind == EXPR_MEMBER
        let f: *StructField = resolve_member_chain_field(s, b)
        if f != null and f.field_type == TYPE_ARRAY and f.array_elem_type == TYPE_STRUCT and f.array_elem_type_name_len > 0
            *out_name = f.array_elem_type_name
            *out_len = f.array_elem_type_name_len
        # AGAST #3972: and an element of a `*S` field, which emit_expr_index
        # loads as the %S.  `let e = h.f[i]` stayed an i64: "unhandled EXPR_MEMBER".
        else if ptr_field_struct_elem(s, f) == 1
            *out_name = f.field_type_name
            *out_len = f.field_type_name_len
        return
    if b.kind != EXPR_IDENT
        return
    let lv: *LocalVar = find_local_struct_name(s, b.ident_ptr, b.ident_len)
    if lv != null
        if lv.var_type == TYPE_ARRAY and lv.array_elem_type == TYPE_STRUCT and lv.type_name_len > 0
            *out_name = lv.type_name
            *out_len = lv.type_name_len
        return
    let g: *GlobalVarDef = find_global(s, b.ident_ptr, b.ident_len)
    if g != null and g.var_type == TYPE_ARRAY and g.array_elem_type == TYPE_STRUCT and g.array_elem_type_name_len > 0
        *out_name = g.array_elem_type_name
        *out_len = g.array_elem_type_name_len
        return
    # AGAST #1866: an element of a `const T: [N]S` table (`[N]StrView` too),
    # so `let r = T[i]` infers an S as ritz0 does, not "a whole struct".
    let ce: *ConstEntry = const_struct_array_elem(s, ie)
    if ce != null
        *out_name = ce.array_elem_type_name
        *out_len = ce.array_elem_type_name_len

# AGAST #2152: the struct `(*op).field` reads a field of: the pointee of a
# `*S` local or global, or of a `*S` field (`(*w.p).f`), or null/0.
pub fn deref_member_base_struct_name(s: *EmitterState, op: *Expr, out_name: **u8, out_len: *i32)
    *out_name = null
    *out_len = 0
    if op == null
        return
    if op.kind == EXPR_IDENT
        let lv: *LocalVar = find_local_struct_name(s, op.ident_ptr, op.ident_len)
        if lv != null
            if lv.var_type == TYPE_PTR and lv.type_name_len > 0
                *out_name = lv.type_name
                *out_len = lv.type_name_len
            return
        let g: *GlobalVarDef = find_global(s, op.ident_ptr, op.ident_len)
        if g != null and g.var_type == TYPE_PTR and g.pointee_type == TYPE_STRUCT and g.pointee_type_name_len > 0
            *out_name = g.pointee_type_name
            *out_len = g.pointee_type_name_len
        return
    if op.kind == EXPR_MEMBER
        let f: *StructField = resolve_member_chain_field(s, op)
        if f != null and f.field_type == TYPE_PTR and f.field_type_name_len > 0
            *out_name = f.field_type_name
            *out_len = f.field_type_name_len
        return
    # AGAST #3015: `(*S_deref(@b)).f`, a field reached through `Deref` (R17),
    # and any call returning `*S`, `@S` or `@&S`.
    if op.kind == EXPR_CALL or op.kind == EXPR_METHOD
        let cst: *StructDef = call_result_ptr_struct(s, op)
        if cst != null
            *out_name = cst.name
            *out_len = cst.name_len



# AGAST #1509 / #2097: type-only N-D array shape resolution (moved here from
# emitter_expr_arith by #2152, since resolve_member_chain_field now needs it
# for an indexed base `g[i][j].m` and nd_array_member_shape needs that).

# The shape of the N-D array an index chain `e` indexes, with the number of
# indices in *out_depth, or null when `e` is not such a chain (base is not a
# local / global N-D array, or the chain is deeper than its rank).  Emits
# nothing, so callers can test before committing to the N-D path.
pub fn nd_index_shape(s: *EmitterState, e: *Expr, out_depth: *i32) -> *ArrayShape
    if e == null or e.kind != EXPR_INDEX
        return null
    var depth: i32 = 0
    let base: *Expr = nd_chain_base(s, e, @depth)
    if depth == 0   # AGAST #4122: `a[k]` itself is the plane pointer, no chain
        return null
    var sh: *ArrayShape = nd_array_base_shape(s, base)
    if sh == null
        sh = plane_ptr_shape(s, base)   # AGAST #2570: `q[i][j]`, q a plane pointer
    if sh == null or depth > sh.rank
        return null
    *out_depth = depth
    return sh

# The base an index chain `e` indexes, with the number of indices in
# *out_depth: the innermost non-index operand, or (AGAST #4122) an element
# `a[k]` of a `[K]*[N][M]T` local, a plane pointer `a[k][i][j]` indexes.
pub fn nd_chain_base(s: *EmitterState, e: *Expr, out_depth: *i32) -> *Expr
    var depth: i32 = 0
    var base: *Expr = e
    while base.kind == EXPR_INDEX and elem_plane_ptr_shape(s, base) == null
        depth = depth + 1
        base = base.left
    *out_depth = depth
    base

# AGAST #3306: the struct S when `e` is a full-depth index chain over an N-D
# `[..]S` (`g[i][j]`, `s.m[i][j]`, `q[i][j]`), whose element is a `%S`
# place; null for a row, a scalar leaf, a leaf naming no struct (#3141) or
# anything else.
pub fn nd_struct_leaf(s: *EmitterState, e: *Expr) -> *StructDef
    var depth: i32 = 0
    let sh: *ArrayShape = nd_index_shape(s, e, @depth)
    if sh == null or depth != sh.rank or sh.leaf_type != TYPE_STRUCT or sh.leaf_name_len <= 0
        return null
    find_struct(s, sh.leaf_name, sh.leaf_name_len)

# AGAST #2570: the plane `[M][N]..T` that the local `e` points at, when `e`
# is a plane pointer (LocalVar.pointee_array_shape); null otherwise.  Not in
# nd_array_name_shape: that one says the name IS an array (whole-array
# assignment, argument dims), which a pointer isn't.
# AGAST #2098: `*q` too, the whole `[M][N]..T` q points at, so `(*q)[i][j]` is
# `q[i][j]`.
#
# AGAST #3635: and a `*[N][M]..T` held elsewhere: a field `s.p`, a global `gp`
# or a call `f()` (base_ptr_array, which records the shape), or `*` of one;
# and `*r`, r a `**[N][M]..T` local or param (r itself is no plane pointer).
# emit_plane_ptr loads the pointer each of these is.
pub fn plane_ptr_shape(s: *EmitterState, e: *Expr) -> *ArrayShape
    if e == null
        return null
    var x: *Expr = e
    var deref: i32 = 0
    if e.kind == EXPR_UNARY and e.op == OP_DEREF and e.operand != null
        x = e.operand
        deref = 1
    if x.kind == EXPR_IDENT
        let lv: *LocalVar = find_local_struct_name(s, x.ident_ptr, x.ident_len)
        if lv != null
            # AGAST #4122: `*r` too, r an `@*[N][M]T` / `@&*[N][M]T` local or param.
            if local_holds_plane_ptr(lv) == 1 and deref == 0
                return null
            return lv.pointee_array_shape
    # AGAST #4122: `a[k]` (and `*a[k]`), a `[K]*[N][M]T` local's element.
    let el: *ArrayShape = elem_plane_ptr_shape(s, x)
    if el != null
        return el
    # AGAST #4122: `*s.q`, `*gq`, `*f()` through a `**[N][M]T` field, global, call.
    if deref == 1
        let held: *ArrayShape = base_plane_ptr_ptr(s, x)
        if held != null
            return held
    let pa: *Param = base_ptr_array(s, x)
    if pa == null or pa.param_type != TYPE_PTR
        return null
    pa.param_pointee_array_shape

# AGAST #4122: 1 when the local `lv` holds a plane pointer's address, not the
# plane pointer: a `**[N][M]T` (#3635), an `@*[N][M]T` or an `@&*[N][M]T`.
# Only `*lv` is the plane pointer; its slot is loaded twice.
fn local_holds_plane_ptr(lv: *LocalVar) -> i32
    # A `let q = @x[i]` plane (#2570) is an `@[M*N]T` with a shape: its
    # pointee is the array, not a pointer.
    if lv.pointee_array_shape == null or lv.pointee_type != TYPE_PTR
        return 0
    if lv.var_type == TYPE_PTR_PTR or lv.var_type == TYPE_REF or lv.var_type == TYPE_MUT_REF
        return 1
    0

# AGAST #2098 / #3635: the `ptr` a plane_ptr_shape base `e` is, in a register:
# a local's slot loaded (twice for `*r`, r a `**`), else `e` (or the X of a
# `*X`) evaluated.
pub fn emit_plane_ptr(s: *EmitterState, e: *Expr) -> i32
    var x: *Expr = e
    if e.kind == EXPR_UNARY and e.op == OP_DEREF and e.operand != null
        x = e.operand
    if x.kind == EXPR_IDENT
        let lv: *LocalVar = find_local_struct_name(s, x.ident_ptr, x.ident_len)
        if lv != null
            var r: i32 = next_reg(s)
            emit_str(s, c"  ")
            emit_reg(s, r)
            emit_str(s, c" = load ptr, ptr ")
            emit_reg(s, lv.reg)
            emit_str(s, c"\n")
            if local_holds_plane_ptr(lv) == 1   # AGAST #4122: a ref too
                let r2: i32 = next_reg(s)
                emit_str(s, c"  ")
                emit_reg(s, r2)
                emit_str(s, c" = load ptr, ptr ")
                emit_reg(s, r)
                emit_str(s, c"\n")
                r = r2
            return r
    let v: i32 = emit_expr(s, x)
    let ptr: i32 = next_reg(s)
    emit_str(s, c"  ")
    emit_reg(s, ptr)
    emit_str(s, c" = inttoptr i64 ")
    emit_reg(s, v)
    emit_str(s, c" to ptr\n")
    # AGAST #4122: `*s.q` / `*gq` / `*f()` loads the `*[N][M]T` the `**` holds.
    if x != e and base_plane_ptr_ptr(s, x) != null
        let held: i32 = next_reg(s)
        emit_str(s, c"  ")
        emit_reg(s, held)
        emit_str(s, c" = load ptr, ptr ")
        emit_reg(s, ptr)
        emit_str(s, c"\n")
        return held
    ptr

# AGAST #2570: the plane `e`, an index chain two or more short of its N-D
# array's rank, names: the dims after the chain, and the leaf.  `@x[i]` with
# `x: [L][M][N]T` is `[M][N]T`.  null for anything else (a row or an element
# is one or no dimension: other arms type those).
pub fn nd_plane_shape(s: *EmitterState, e: *Expr) -> *ArrayShape
    var depth: i32 = 0
    let sh: *ArrayShape = nd_index_shape(s, e, @depth)
    if sh == null or depth > sh.rank - 2
        return null
    nd_shape_from(sh, depth)

# The ArrayShape of the local / global N-D array named `name`, or null.
pub fn nd_array_name_shape(s: *EmitterState, name: *u8, len: i32) -> *ArrayShape
    if name == null or len <= 0
        return null
    let lv: *LocalVar = find_local_struct_name(s, name, len)
    if lv != null
        if lv.var_type == TYPE_ARRAY
            return lv.array_shape
        return null
    let glob: *GlobalVarDef = find_global(s, name, len)
    if glob != null and glob.var_type == TYPE_ARRAY
        return glob.array_shape
    return null

# The same for an EXPR_IDENT `e` (null for any other expression).
pub fn nd_array_ident_shape(s: *EmitterState, e: *Expr) -> *ArrayShape
    if e == null or e.kind != EXPR_IDENT
        return null
    return nd_array_name_shape(s, e.ident_ptr, e.ident_len)

# AGAST #2097: the ArrayShape of an N-D struct field named by the member
# chain `e` (`s.m`, `p.m`, `a.b.m`, local or global), or null.  Type-only:
# emits nothing (resolve_member_chain_field mirrors emit_member_ptr).
pub fn nd_array_member_shape(s: *EmitterState, e: *Expr) -> *ArrayShape
    if e == null or e.kind != EXPR_MEMBER
        return null
    let f: *StructField = resolve_member_chain_field(s, e)
    if f == null or f.field_type != TYPE_ARRAY
        return null
    return f.array_shape

# The N-D array an index chain's base names: a local / global, or a field.
pub fn nd_array_base_shape(s: *EmitterState, base: *Expr) -> *ArrayShape
    if base == null
        return null
    if base.kind == EXPR_MEMBER
        return nd_array_member_shape(s, base)
    return nd_array_ident_shape(s, base)

# AGAST #1660 — the unit (fieldless) enum an expression's value is, if any.
#
# ritz1 holds a unit-enum value as its `%Enum = type { i8 }` aggregate, never
# as an i64: the qualified-variant ctor (`Kind.A`), an enum-typed param or
# `let` local, an enum-returning call and an enum-typed field load all hand
# back a `%Kind` register.  Callers that would otherwise treat the register as
# i64 (var-decl slot inference, `==` / `!=`) ask this first.  Writes the enum
# name, or null/0 when `e` is not statically a unit enum.  Result$/Option$
# tagged enums are excluded: their aggregate is `{ i8, [N x i8] }`.
pub fn unit_enum_expr_name(s: *EmitterState, e: *Expr, out_name: **u8, out_len: *i32)
    *out_name = null
    *out_len = 0
    if e == null
        return
    var name: *u8 = null
    var name_len: i32 = 0
    if e.kind == EXPR_MEMBER
        # Qualified variant `Kind.A` (same test as emit_expr_member).
        if e.left != null and e.left.kind == EXPR_IDENT
            if is_enum_type(e.left.ident_ptr, e.left.ident_len) == 1
                if enum_variant_index(e.left.ident_ptr, e.left.ident_len, e.ident_ptr, e.ident_len) >= 0
                    name = e.left.ident_ptr as *u8
                    name_len = e.left.ident_len
        # Enum-typed struct field, at any depth / through any pointer.
        if name == null
            let fld: *StructField = resolve_member_chain_field(s, e)
            if fld != null and fld.field_type == TYPE_STRUCT and fld.field_type_name_len > 0
                name = fld.field_type_name
                name_len = fld.field_type_name_len
    else
        resolve_expr_struct_name(s, e, @name, @name_len)
    if name == null or name_len == 0
        return
    if is_tagged_enum_type(name, name_len) == 1
        return
    if is_enum_type(name, name_len) == 0
        return
    *out_name = name
    *out_len = name_len

# AGAST #176 — Span$u8 / StrView -> i64 coercion at call-site arg passing.
#
# rzrz (and any caller) passes bare `"..."` literals (which lower to %Span$u8
# per #98) to legacy `*u8` / `i64` params (e.g. `eprints_cstr`).  Without a
# coercion the %Span$u8 aggregate flows straight into the call as
# `call ... (i64 %.span)` and the IR verifier rejects the type mismatch.
#
# Mirrors #168's store-site decompose-and-rebuild but emits a single
# `extractvalue` + `ptrtoint` (we only need the ptr field; len is dropped).
#
# Returns a freshly-allocated i64 register holding the coerced value, or -1
# when no coercion was applied (param isn't pointer/i64-shaped, or the arg
# isn't statically resolvable as Span$u8/StrView — caller falls through to
# its existing branch).  Both Span$u8 and StrView are `{ ptr, i64 }` so the
# extract pattern is identical.
pub fn try_emit_span_to_i64_arg(s: *EmitterState, arg_e: *Expr, param_type: i32, src_reg: i32) -> i32
    # Param must lower to `i64` in the call signature.  TYPE_PTR / TYPE_PTR_PTR
    # / TYPE_REF emit i64 (see emit_llvm_type); TYPE_I64 / TYPE_U64 are i64
    # directly.  TYPE_MUT_REF emits `ptr` so it has its own inttoptr branch
    # in the cascade — skip here to avoid double-handling.
    if ty_int_bits(param_type) != 64 and param_type != TYPE_PTR and param_type != TYPE_PTR_PTR and param_type != TYPE_REF
        return -1
    if arg_e == null
        return -1
    var src_name: *u8 = null
    var src_name_len: i32 = 0
    resolve_expr_struct_name(s, arg_e, @src_name, @src_name_len)
    if src_name == null
        return -1
    if src_name_len == 0
        return -1
    let is_span_u8: i32 = name_eq(src_name, src_name_len, c"Span$u8", 7)
    let is_strview: i32 = name_eq(src_name, src_name_len, c"StrView", 7)
    if is_span_u8 == 0 and is_strview == 0
        return -1
    let p: i32 = next_reg(s)
    emit_str(s, c"  ")
    emit_reg(s, p)
    emit_str(s, c" = extractvalue %")
    emit_name(s, src_name, src_name_len)
    emit_str(s, c" ")
    emit_reg(s, src_reg)
    emit_str(s, c", 0\n")
    let pi: i32 = next_reg(s)
    emit_str(s, c"  ")
    emit_reg(s, pi)
    emit_str(s, c" = ptrtoint ptr ")
    emit_reg(s, p)
    emit_str(s, c" to i64\n")
    pi

# =============================================================================
# Native-pointer load/store helpers (task #73 migration)
#
# These replace the old pattern:
#     %v = load i64, ptr %slot
#     %p = inttoptr i64 %v to ptr
# with:
#     %p = load ptr, ptr %slot
#
# Per-site migration keeps the cascade contained — each call site can be
# converted independently, with ritz0 tests + "ritz1 compiles trivial" as gate.
# LLVM opaque pointers mean the alloca type doesn't need to change — we can
# load either i64 or ptr from the same `alloca i64` slot.
# =============================================================================

# Emit `%result = load ptr, ptr %slot_reg` and return the new register index.
pub fn emit_load_ptr(s: *EmitterState, slot_reg: i32) -> i32
    let result: i32 = next_reg(s)
    emit_str(s, c"  ")
    emit_reg(s, result)
    emit_str(s, c" = load ptr, ptr ")
    emit_reg(s, slot_reg)
    emit_str(s, c"\n")
    result

# Emit `store ptr %val_reg, ptr %slot_reg`.
fn emit_store_ptr(s: *EmitterState, val_reg: i32, slot_reg: i32)
    emit_str(s, c"  store ptr ")
    emit_reg(s, val_reg)
    emit_str(s, c", ptr ")
    emit_reg(s, slot_reg)
    emit_str(s, c"\n")

pub fn add_string(s: *EmitterState, data: *u8, len: i32) -> i32
    let idx: i32 = namelist_count(@s.strings)
    namelist_push(@s.strings, data, len)
    idx

# =============================================================================
# Type Inference - Determine expression type without emitting code
# =============================================================================

# Compute size in bytes of a named struct with proper C-style alignment.
# Each field is aligned to its natural alignment; final size rounded up to struct alignment.
pub fn get_struct_size_by_name(s: *EmitterState, name: *u8, name_len: i32) -> i64
    if name == null or name_len == 0
        return 8
    if is_tagged_enum_type(name, name_len) == 1
        var te_pad: i64 = 0
        let te_n: i64 = tagged_enum_layout(s, name, name_len, @te_pad)
        return 1 + te_pad + te_n   # AGAST #1898: ritz0's layout
    let st: *StructDef = find_struct(s, name, name_len)
    if st == null
        # AGAST #1797: a user enum, `{ i8 }` or `{ i8, [P x i8], [N x i8] }`.
        let uei: i32 = user_enum_index(name, name_len)
        if uei >= 0
            return user_enum_size(s, uei)
        return 8
    # `[[packed]]` (AGAST #1847): fields back to back, no tail padding —
    # the layout of the `<{ ... }>` type emit_one_struct_type writes.
    let packed: i32 = struct_is_packed(st)
    var offset: i64 = 0
    var max_align: i64 = 1
    var f: *StructField = st.fields
    while f != null
        var falign: i64 = 8
        var fsize: i64 = 8
        if f.field_type == TYPE_ARRAY
            # Array: size = elem_size * count, align = elem_align
            fsize = field_array_size_align(s, f, @falign)
        else
            fsize = elem_size_align(s, f.field_type, f.field_type_name, f.field_type_name_len, @falign)

        if packed == 1
            falign = 1
        # Align offset up to falign
        let rem: i64 = offset % falign
        if rem != 0
            offset = offset + (falign - rem)
        offset = offset + fsize
        if falign > max_align
            max_align = falign
        f = f.next

    # Round final size up to struct alignment
    if max_align > 1
        let rem2: i64 = offset % max_align
        if rem2 != 0
            offset = offset + (max_align - rem2)
    return offset

# Alignment of a named struct: its most-aligned field (LLVM DataLayout
# natural alignment). 8 for a name that does not resolve, matching
# get_struct_size_by_name's fallback.
fn get_struct_align_by_name(s: *EmitterState, name: *u8, name_len: i32) -> i64
    if name == null or name_len == 0
        return 8
    if is_tagged_enum_type(name, name_len) == 1
        return 1   # AGAST #1898: { i8, [P x i8], [N x i8] } is 1-aligned
    let st: *StructDef = find_struct(s, name, name_len)
    if st == null
        if user_enum_index(name, name_len) >= 0
            return 1   # AGAST #1797: an all-i8 struct
        return 8
    if struct_is_packed(st) == 1
        return 1   # `[[packed]]`: an LLVM packed struct is 1-aligned (#1847)
    var max_align: i64 = 1
    var f: *StructField = st.fields
    while f != null
        var falign: i64 = 8
        if f.field_type == TYPE_ARRAY
            elem_size_align(s, f.array_elem_type, f.array_elem_type_name, f.array_elem_type_name_len, @falign)
        else
            elem_size_align(s, f.field_type, f.field_type_name, f.field_type_name_len, @falign)
        if falign > max_align
            max_align = falign
        f = f.next
    return max_align

# Natural size of one value of kind `t` (a TYPE_* primitive, or TYPE_STRUCT
# named `name`), with its alignment written to `*align`. AGAST #1814: bool
# and f32 were sized 8 and nested structs aligned to 8, so sizeof disagreed
# with the `%T = type` body LLVM lays out. Kinds with no recorded size
# (enums, refs, unresolved names) keep the historical 8/8.
# Size (and, in *align, alignment) of a TYPE_ARRAY field `f`.  AGAST #2097:
# an N-D field `m: [N][M]T` is N*M*sizeof(T), aligned as T, matching the
# `[N x [M x T]]` emit_field_llvm_type declares; the 1-D formula would size
# the TYPE_ARRAY element as one i64.
pub fn field_array_size_align(s: *EmitterState, f: *StructField, align: *i64) -> i64
    let sh: *ArrayShape = f.array_shape
    if sh == null
        let es: i64 = elem_size_align(s, f.array_elem_type, f.array_elem_type_name, f.array_elem_type_name_len, align)
        return es * (f.array_size as i64)
    var n: i64 = 1
    var d: i32 = 0
    while d < sh.rank
        n = n * (sh.dims[d] as i64)
        d = d + 1
    return n * elem_size_align(s, sh.leaf_type, sh.leaf_name, sh.leaf_name_len, align)

pub fn elem_size_align(s: *EmitterState, t: i32, name: *u8, name_len: i32, align: *i64) -> i64
    # AGAST #3656: a SIMD vector (`v4i64`) is `<4 x i64>`.  On x86-64 its
    # size is rounded up to a power of two and it is aligned to that size
    # (<4 x i64>: 32, 32), as ritz0's _abi_size_align measures it.  It used
    # to fall to get_struct_size_by_name's 8/8 for an unresolved name.
    if t == TYPE_STRUCT and name_len > 0 and is_simd_vector_type_name(name, name_len) == 1
        let vbytes: i64 = (simd_vector_elem_bits(name, name_len) as i64) * (simd_vector_elem_count(name, name_len) as i64) / 8
        var vsz: i64 = 1
        while vsz < vbytes
            vsz = vsz * 2
        *align = vsz
        return vsz
    if t == TYPE_STRUCT and name_len > 0
        *align = get_struct_align_by_name(s, name, name_len)
        return get_struct_size_by_name(s, name, name_len)
    let sz: i64 = ptr_pointee_size(s, t, null, 0)
    if sz == 0
        *align = 8
        return 8
    *align = sz
    return sz

# Byte size of one element of a pointer whose pointee is `pointee`
# (a TYPE_* kind; for TYPE_STRUCT, `name`/`name_len` name the struct).
# Returns 0 when the pointee is not known — never guesses.  0 is not a valid
# element size, so callers can tell "unknown" apart from every real answer.
pub fn ptr_pointee_size(s: *EmitterState, pointee: i32, name: *u8, name_len: i32) -> i64
    if pointee == TYPE_STRUCT
        # get_struct_size_by_name answers 8 for a name it cannot resolve;
        # that is exactly the guess this function exists to refuse.
        if name_len > 0 and find_struct(s, name, name_len) != null
            return get_struct_size_by_name(s, name, name_len)
        # AGAST #1578: an Option / Result instance (`Vec$Option$i64.data + i`)
        # is no struct find_struct knows, but tagged_enum_layout sizes it, the
        # same layout the `%Option$i64 = type` declaration is written with.
        if is_tagged_enum_type(name, name_len) == 1
            return get_struct_size_by_name(s, name, name_len)
        # AGAST #2411: `usize` / `isize` parse as a struct name, so a
        # `Vec$usize.data + i` had no size.  A primitive's name is its size.
        let ps: i64 = ty_store_size(ty_from_name(name, name_len))
        if ps > 0
            return ps
        # AGAST #2411: and `Vec$C.data + i` over a non-generic user enum
        # strides at the enum's own layout (#1797).
        let uei: i32 = user_enum_index(name, name_len)
        if uei >= 0
            return user_enum_size(s, uei)
        return 0
    return ty_store_size(pointee)

# "pointer arithmetic on '<name>': element size unknown" — a counted error,
# so main refuses to write the output.  Returns 1 only so the caller can
# finish emitting a syntactically complete instruction; the result is never
# linked because the error count is non-zero.  `span` is the operand's.
fn ptr_elem_size_unknown(s: *EmitterState, span: SrcSpan, name: *u8, name_len: i32) -> i64
    emit_ir_error_begin(s, span, c"pointer arithmetic: element size of pointee unknown for '")
    emit_ir_error_end(s, name, name_len)
    return 1

# The StructField a member expression `recv.field` names, following nested
# receivers (`a.b.c.field`, any depth) and struct-pointer receivers.  null if
# unresolved.  AGAST #1673: the single resolver for member-chain field types;
# the pointee-width, stride and struct-deref paths each used to hardcode one or
# two levels and silently guess (load i64 / raw byte add) past that.
# AGAST #3824: the ConstEntry of `id`, an identifier naming a struct const
# lowered to a `%S` global, `const K: StrView = "..."` (#189: the gate
# emit_expr_ident loads it whole under); null for anything else.
pub fn struct_const_global(s: *EmitterState, id: *Expr) -> *ConstEntry
    if id == null or id.kind != EXPR_IDENT
        return null
    if is_const(s, id.ident_ptr, id.ident_len) == 0
        return null
    let ce: *ConstEntry = find_const_entry(s, id.ident_ptr, id.ident_len)
    if ce == null or ce.const_type != TYPE_STRUCT or ce.type_name_len <= 0
        return null
    if ce.value_expr == null
        return null
    # LARB R60: a struct-literal or const-of-const initialiser is lowered to
    # the same read-only `%S` global as the older `"..."` StrView const, so
    # `C.f` GEPs into it and `@C` is `@S` (R48).
    ce

pub fn member_field_def(s: *EmitterState, e: *Expr) -> *StructField
    if e == null or e.kind != EXPR_MEMBER or e.left == null
        return null
    var recv: *u8 = null
    var recv_len: i32 = 0
    if e.left.kind == EXPR_IDENT
        let lv: *LocalVar = find_local_struct_name(s, e.left.ident_ptr, e.left.ident_len)
        if lv != null
            recv = lv.type_name
            recv_len = lv.type_name_len
        else
            let glob: *GlobalVarDef = find_global(s, e.left.ident_ptr, e.left.ident_len)
            if glob != null
                recv = glob.type_name
                recv_len = glob.type_name_len
                # AGAST #1554: `g.f` with `var g: *S` / `@S`.  Unnamed,
                # `g.items + 1` on an `items: *D` field strode 1 byte, SILENT.
                if recv == null
                    recv = global_pointee_struct(glob, @recv_len)
            else
                # AGAST #3824: `K.f` on a struct const.  Unnamed, `K.ptr + 4`
                # was untyped and `*(K.ptr + 4)` loaded an i64, SILENT.
                let kce: *ConstEntry = struct_const_global(s, e.left)
                if kce != null
                    recv = kce.type_name
                    recv_len = kce.type_name_len
    else if e.left.kind == EXPR_MEMBER
        let pf: *StructField = member_field_def(s, e.left)
        var pk: i32 = 0
        if pf != null
            pk = pf.field_type
        if pk == TYPE_STRUCT or pk == TYPE_PTR or pk == TYPE_REF or pk == TYPE_MUT_REF
            recv = pf.field_type_name
            recv_len = pf.field_type_name_len
    # AGAST #1647: `mk().f` / `p.m().f` — the callee's struct return type.
    else if e.left.kind == EXPR_CALL or e.left.kind == EXPR_METHOD
        call_result_struct_name(s, e.left, @recv, @recv_len)
    # AGAST #2332: `a[i].f` with `a: [N]*S`, so `f` has its own type.  #2566: and
    # `a[i].f` with `a: [N]S` by value (a local, global or field), through
    # index_elem_struct_name, which mirrors emit_member_ptr.  Untyped, `a[1].p + 1`
    # on a `p: *i32` stepped one byte, SILENT, and `a[i].vf[j]` found no Vec.
    else if e.left.kind == EXPR_INDEX
        index_elem_struct_name(s, e.left, @recv, @recv_len)
    # AGAST #2450: `(*p).f`, `(*(p + k)).f`, `(*(v.data)).f`: the struct `*X`
    # loads.  Unresolved, `(*hp).q + 1` on a `q: *i32` stepped one byte.
    else if e.left.kind == EXPR_UNARY and e.left.op == OP_DEREF and e.left.operand != null
        deref_pointee_struct_name(s, e.left.operand, @recv, @recv_len)
        # AGAST #2331: `(*q).f` with `q: **S`, `@*S` or `@&*S`: `*q` is a `*S`,
        # and `.` sees through it.  Untyped, `(*q).data + i` stepped one byte.
        if recv == null and e.left.operand.kind == EXPR_IDENT
            let dq: *LocalVar = find_local_struct_name(s, e.left.operand.ident_ptr, e.left.operand.ident_len)
            if dq != null and ptr_to_struct_ptr(dq) == 1
                recv = dq.type_name
                recv_len = dq.type_name_len
    if recv == null or recv_len <= 0
        return null
    let st: *StructDef = find_struct(s, recv, recv_len)
    if st == null
        return null
    let idx: i32 = find_field_index(st, e.ident_ptr, e.ident_len)
    if idx < 0
        return null
    get_field_type(st, idx)

# Compute size of pointed-to element for pointer arithmetic on a pointer expression.
# Handles identifiers (looks up LocalVar.pointee_type + type_name) and member accesses
# (looks up struct field's pointee info).
#
# AGAST #1451: fails CLOSED.  This used to answer 1 (or 8, via
# get_struct_size_by_name's miss value) for anything it could not resolve,
# and every such guess was a silent wrong address: `let base: *LB` locals
# were registered with pointee TYPE_I64 and scaled by 8 instead of 16.  An
# unknown pointee is now a located emitter error naming the operand.
fn get_ptr_elem_size(s: *EmitterState, e: *Expr) -> i64
    if e.kind == EXPR_IDENT
        let loc: *LocalVar = find_local_struct_name(s, e.ident_ptr, e.ident_len)
        if loc == null
            return ptr_elem_size_unknown(s, e.span, e.ident_ptr, e.ident_len)
        # For TYPE_PTR_PTR the element is a pointer (8 bytes)
        if loc.var_type == TYPE_PTR_PTR
            return 8
        if loc.var_type == TYPE_PTR or loc.var_type == TYPE_REF or loc.var_type == TYPE_MUT_REF
            # AGAST #2330, LARB R9: `p + i` on a `*[N]T` walks rows, at stride `[N]T`.
            if loc.pointee_type == TYPE_ARRAY and loc.pointee_array_size > 0
                var row_len: i32 = 0
                let row_name: *u8 = array_ptr_elem_name(loc, @row_len)   # #2548
                let row_elem: i64 = ptr_pointee_size(s, loc.pointee_array_elem_type, row_name, row_len)
                if row_elem > 0
                    return row_elem * (loc.pointee_array_size as i64)
            let size: i64 = ptr_pointee_size(s, loc.pointee_type, loc.type_name, loc.type_name_len)
            if size > 0
                return size
        return ptr_elem_size_unknown(s, e.span, e.ident_ptr, e.ident_len)
    if e.kind == EXPR_MEMBER
        # AGAST #1673: any member chain (`o.inner.buf.p`), not just `local.f`.
        let field: *StructField = member_field_def(s, e)
        if field != null
            if field.field_type == TYPE_PTR_PTR
                return 8
            if field.field_type == TYPE_PTR or field.field_type == TYPE_REF or field.field_type == TYPE_MUT_REF
                # A struct pointee is named by field_type_name; a
                # primitive one is recorded in array_elem_type
                # (ast_helpers field_new, AGAST #1304).
                var fsize: i64 = 0
                if field.field_type_name_len > 0
                    fsize = ptr_pointee_size(s, TYPE_STRUCT, field.field_type_name, field.field_type_name_len)
                else
                    fsize = ptr_pointee_size(s, field.array_elem_type, null, 0)
                if fsize > 0
                    return fsize
        return ptr_elem_size_unknown(s, e.span, e.ident_ptr, e.ident_len)
    emit_ir_error(s, e.span, c"pointer arithmetic: element size of pointee unknown for a non-name operand")
    return 1

# AGAST #2332: U when `x` is an element of a `[N]*U` array (local, param, global,
# or field at any depth, N-D too) or that element `+ k`, with a struct U's name in
# *out_name / *out_len.  TYPE_VOID for anything else, so an integer `a[i] + 1`
# stays an integer.  `p[i]` through a `*[N]*U` is such an element too (#2522); a
# `[N]**U` element is ptr_levels_of's.
pub fn array_elem_pointee(s: *EmitterState, x: *Expr, out_name: **u8, out_len: *i32) -> i32
    *out_name = null
    *out_len = 0
    var b: *Expr = x
    while b != null and b.kind == EXPR_BINARY and (b.op == OP_ADD or b.op == OP_SUB)
        if is_ptr_distance(s, b) == 1
            return TYPE_VOID
        b = b.left
    var elem: i32 = TYPE_VOID
    var pointee: i32 = TYPE_VOID
    var name: *u8 = null
    var name_len: i32 = 0
    array_elem_record(s, b, @elem, @pointee, @name, @name_len)
    elem_recorded_pointee(s, elem, pointee, name, name_len, out_name, out_len)

# What the array that `b` = `a[i]` indexes records of its element: the element's
# kind, what it points at (U for `[N]*U`, the packed inner-pointee slot for
# `[N]**U`, AGAST #2376) and the struct name.  TYPE_VOID in *out_elem when `b`
# isn't a whole element of a recorded array.
pub fn array_elem_record(s: *EmitterState, b: *Expr, out_elem: *i32, out_pointee: *i32, out_name: **u8, out_len: *i32)
    *out_elem = TYPE_VOID
    *out_pointee = TYPE_VOID
    *out_name = null
    *out_len = 0
    if b == null or b.kind != EXPR_INDEX or b.left == null
        return
    if b.right != null and b.right.kind == EXPR_RANGE
        return
    # AGAST #2522: `p[i]` through a `*[N]*U`, `@[N]*U` or `@&[N]*U` is an element of
    # the array behind it (LARB R9), and its `**U` view records U.  Without this
    # `*p[i] = v` stored 8 bytes into a U, and `p[i][j]` / `p[i] + k` had no stride.
    let view: *LocalVar = index_through(s, b)
    if view != null and view.array_view == 1
        if view.var_type == TYPE_PTR_PTR
            *out_elem = TYPE_PTR
            *out_pointee = view.inner_pointee_type
            *out_name = view.type_name
            *out_len = view.type_name_len
        return
    var depth: i32 = 0
    let sh: *ArrayShape = nd_index_shape(s, b, @depth)
    if sh != null
        if depth == sh.rank
            *out_elem = sh.leaf_type
            *out_pointee = sh.leaf_pointee
            *out_name = sh.leaf_name
            *out_len = sh.leaf_name_len
    else if b.left.kind == EXPR_MEMBER
        let f: *StructField = resolve_member_chain_field(s, b.left)
        if f != null and f.field_type == TYPE_ARRAY
            *out_elem = f.array_elem_type
            *out_pointee = f.array_elem_pointee
            *out_name = f.array_elem_type_name
            *out_len = f.array_elem_type_name_len
    else if b.left.kind == EXPR_IDENT
        let loc: *LocalVar = find_local_struct_name(s, b.left.ident_ptr, b.left.ident_len)
        if loc != null
            if loc.var_type == TYPE_ARRAY
                *out_elem = loc.array_elem_type
                *out_pointee = loc.array_elem_pointee
                *out_name = loc.type_name
                *out_len = loc.type_name_len
        else
            let g: *GlobalVarDef = find_global(s, b.left.ident_ptr, b.left.ident_len)
            if g != null and g.var_type == TYPE_ARRAY
                *out_elem = g.array_elem_type
                *out_pointee = g.array_elem_pointee
                *out_name = g.array_elem_type_name
                *out_len = g.array_elem_type_name_len
            else
                # AGAST #1866: an element of a `const T: [N]*U` table.  Without
                # this `*(T[i] + 1)` loaded an i64, not a U.
                let ce: *ConstEntry = find_const_entry(s, b.left.ident_ptr, b.left.ident_len)
                if ce != null and ce.const_type == TYPE_ARRAY
                    *out_elem = ce.array_elem_type
                    *out_pointee = ce.array_elem_pointee
                    *out_name = ce.array_elem_type_name
                    *out_len = ce.array_elem_type_name_len

# What an array's record says its element points at: U for an `elem` of TYPE_PTR
# recording `pointee` U, TYPE_VOID otherwise.  A struct U's name goes to *out_name.
pub fn elem_recorded_pointee(s: *EmitterState, elem: i32, pointee: i32, name: *u8, name_len: i32, out_name: **u8, out_len: *i32) -> i32
    *out_name = null
    *out_len = 0
    if elem != TYPE_PTR
        return TYPE_VOID
    if pointee == TYPE_STRUCT
        if name_len <= 0
            return TYPE_VOID
        *out_name = name
        *out_len = name_len
        return TYPE_STRUCT
    if primitive_name_len(pointee) > 0
        return pointee
    TYPE_VOID

# AGAST #2369: what `x` = `a[i]` refers to when `a` is an `[N]@U` or `[N]@&U`,
# as array_elem_pointee answers for an `[N]*U`.  Apart from it because a
# reference has no arithmetic or index of its own (LARB R9): only `.` reaches
# through one, so only the member paths ask.
pub fn array_elem_referent(s: *EmitterState, x: *Expr, out_name: **u8, out_len: *i32) -> i32
    var elem: i32 = TYPE_VOID
    var pointee: i32 = TYPE_VOID
    var name: *u8 = null
    var name_len: i32 = 0
    array_elem_record(s, x, @elem, @pointee, @name, @name_len)
    if elem != TYPE_REF and elem != TYPE_MUT_REF
        *out_name = null
        *out_len = 0
        return TYPE_VOID
    elem_recorded_pointee(s, TYPE_PTR, pointee, name, name_len, out_name, out_len)

# array_elem_pointee, when the caller doesn't need a struct's name.
pub fn array_elem_pointee_kind(s: *EmitterState, x: *Expr) -> i32
    var name: *u8 = null
    var name_len: i32 = 0
    array_elem_pointee(s, x, @name, @name_len)

# AGAST #2928 / #2597: 1 when `e` is `q - p` on two pointers.  That's a distance
# (LANGUAGE_SPEC §7.1 "Pointer difference"): an i64 count of elements, with no
# stride of its own, so `(q - p) + 1` is one more.  #2332 had this for `a[i] - q`
# with `a: [N]*T` only, and in bytes; every other pair was `q - p * sizeof(T)`.
# The right operand is checked first: it's what tells `p - n` from `q - p`, and
# it keeps a long `a - b - c` integer chain from re-walking its left side.
pub fn is_ptr_distance(s: *EmitterState, e: *Expr) -> i32
    if e.kind != EXPR_BINARY or e.op != OP_SUB
        return 0
    if expr_is_pointer(s, e.right) == 0
        return 0
    expr_is_pointer(s, e.left)

# 1 when `x` is a pointer value: one ptr_arith_elem_size strides, an element of
# a `[N]*T` array, or anything get_expr_type types as a pointer or reference.
pub fn expr_is_pointer(s: *EmitterState, x: *Expr) -> i32
    if x == null
        return 0
    if array_elem_pointee_kind(s, x) != TYPE_VOID or ptr_arith_elem_size(s, x) != 0
        return 1
    let t: i32 = expr_slot_ty(x)
    (t == TYPE_PTR or t == TYPE_PTR_PTR or t == TYPE_REF or t == TYPE_MUT_REF) as i32

# AGAST #2332: 1 when `e` is `a[i][j]` over an `a: [N]*T` element.  That's a
# pointer index, not an array's, and elem_index_as_deref lowers it.
pub fn is_array_elem_index(s: *EmitterState, e: *Expr) -> i32
    if e == null or e.kind != EXPR_INDEX or e.left == null or e.left.kind != EXPR_INDEX
        return 0
    (array_elem_pointee_kind(s, e.left) != TYPE_VOID) as i32

# AGAST #3058: 1 when `e` is `b[i][j]` over a `b: [N]**T` element (or deeper),
# which indexes the `**T` b[i] as a pointer: `*(b[i] + j)`.  A range isn't one.
pub fn is_ptr_ptr_elem_index(s: *EmitterState, e: *Expr) -> i32
    if e == null or e.kind != EXPR_INDEX or e.left == null or e.left.kind != EXPR_INDEX
        return 0
    if e.right == null or e.right.kind == EXPR_RANGE
        return 0
    var inner: i32 = TYPE_VOID
    var name: *u8 = null
    var name_len: i32 = 0
    (ptr_levels_of(s, e.left, @inner, @name, @name_len) >= 2) as i32

# AGAST #3052: the S of `p[i]` with `p` a `*S` local (or param), as `*(p + i)`
# loads it (#2542), into `*out_name` / `*out_len`; null/0 for anything else.  A
# range isn't one.  The name is deref_pointee_struct_name's, so a tagged enum
# pointee answers too.
pub fn ptr_local_struct_index(s: *EmitterState, e: *Expr, out_name: **u8, out_len: *i32)
    *out_name = null
    *out_len = 0
    if e == null or e.kind != EXPR_INDEX or e.left == null or e.left.kind != EXPR_IDENT
        return
    if e.right == null or e.right.kind == EXPR_RANGE
        return
    let lv: *LocalVar = find_local_struct_name(s, e.left.ident_ptr, e.left.ident_len)
    if lv == null or lv.var_type != TYPE_PTR or lv.pointee_type != TYPE_STRUCT
        return
    deref_pointee_struct_name(s, e.left, out_name, out_len)

# Fill `sum` and `deref` with `*(a[i] + j)` for `e` = `a[i][j]`, so the load and
# the store take the `*` paths: one width and one stride, struct T included.
pub fn elem_index_as_deref(s: *EmitterState, e: *Expr, sum: *Expr, deref: *Expr)
    sum.kind = EXPR_BINARY
    sum.slot_type = TYPE_VOID      # AGAST #3225: no wider slot yet
    sum.span = e.span
    sum.op = OP_ADD
    sum.left = e.left
    sum.right = e.right
    sum.next = null
    deref.kind = EXPR_UNARY
    deref.span = e.span
    deref.op = OP_DEREF
    deref.operand = sum
    deref.next = null
    # AGAST #4410: these nodes never meet Sema's walk, so note the slots the
    # emit path reads: the `+` keeps its left operand's pointer slot, and the
    # deref is the element `e` names (formerly get_expr_type's answer).
    if e.left != null
        expr_note_sema_ty(sum, expr_slot_ty(e.left))
    # The deref is its element: array_elem_pointee_kind on the `+ k` operand
    # (formerly get_expr_type's answer); i64 is its default.
    let dpt: i32 = array_elem_pointee_kind(s, sum)
    expr_note_sema_ty(deref, dpt)

# AGAST #1924: the static pointer type of `x`, as a level count plus the
# innermost pointee.  Returns the levels (1 = `*T`, 2 = `**T`, 3 = `***T`)
# and writes T to *out_inner and, for a struct T, its name to *out_name /
# *out_len.  0 when unknown.
#
# Only shapes rooted in a recorded `**T` (or deeper) answer: an identifier
# (local, param, global) or a struct field at any member-chain depth, then
# `y + k` / `y - k` (same type as y) and `*y` (one level fewer).  So
# `*(*(h.rows + i) + k)`, `*(*(*(ppp + i) + j) + k)` and `*(g + i) + k`
# all resolve.  A plain `*T` base answers 0: the callers already handle it.
#
# #1815 / #1941 resolved identifier bases only, exactly two levels deep, so
# a `**T` field, a `***T`, a global `**S` and a monomorphised `**T` param
# still loaded i64 and stepped one byte.
pub fn ptr_levels_of(s: *EmitterState, x: *Expr, out_inner: *i32, out_name: **u8, out_len: *i32) -> i32
    *out_inner = TYPE_VOID
    *out_name = null
    *out_len = 0
    if x == null
        return 0
    if x.kind == EXPR_BINARY
        if x.op == OP_ADD or x.op == OP_SUB
            return ptr_levels_of(s, x.left, out_inner, out_name, out_len)
        return 0
    if x.kind == EXPR_UNARY
        if (x.op == OP_ADDR or x.op == OP_ADDR_MUT) and x.operand != null and x.operand.kind == EXPR_INDEX
            return addr_of_elem_levels(s, x.operand, out_inner, out_name, out_len)
        if x.op != OP_DEREF or x.operand == null
            return 0
        let sub: i32 = ptr_levels_of(s, x.operand, out_inner, out_name, out_len)
        if sub < 2
            *out_inner = TYPE_VOID
            *out_name = null
            *out_len = 0
            return 0
        return sub - 1
    var slot: i32 = TYPE_VOID
    var name: *u8 = null
    var name_len: i32 = 0
    if x.kind == EXPR_IDENT
        let loc: *LocalVar = find_local_struct_name(s, x.ident_ptr, x.ident_len)
        if loc != null
            # AGAST #3079: an `@*T` / `@&*T` is as deep as a `**T` and packs T
            # the same way (`let r = @q` of a `*E`: `**r = E.B` stores an %E).
            if loc.var_type != TYPE_PTR_PTR and ref_to_ptr(loc) == 0
                return 0
            slot = loc.inner_pointee_type
            name = loc.type_name
            name_len = loc.type_name_len
        else
            let glob: *GlobalVarDef = find_global(s, x.ident_ptr, x.ident_len)
            if glob == null or glob.var_type != TYPE_PTR_PTR
                return 0
            slot = glob.inner_pointee_type
            name = glob.pointee_type_name
            name_len = glob.pointee_type_name_len
    else if x.kind == EXPR_MEMBER
        let fld: *StructField = member_field_def(s, x)
        if fld == null or fld.field_type != TYPE_PTR_PTR
            return 0
        slot = fld.inner_pointee_type
        name = fld.field_type_name
        name_len = fld.field_type_name_len
    else if x.kind == EXPR_INDEX
        # AGAST #2376: an element of a `[N]**T` array, which records T packed.
        var elem: i32 = TYPE_VOID
        array_elem_record(s, x, @elem, @slot, @name, @name_len)
        if elem != TYPE_PTR_PTR
            return 0
    else if x.kind == EXPR_CAST
        # AGAST #2544: `x as **S`, whose slot cast_tail_new records.
        if x.op != TYPE_PTR_PTR
            return 0
        slot = x.int_val as i32
        name = x.ident_ptr
        name_len = x.ident_len
    else if x.kind == EXPR_CALL
        # AGAST #2544: `f()` with `f() -> **S`.  The FnDef names S with a
        # `ptr_` per level past two (monomorph's spelling, #2791); only a
        # struct S is recorded by name, so a `-> **u8` answers 0.
        let fd: *FnDef = find_call_fn(s, x)
        if fd == null or fd.return_type != TYPE_PTR_PTR or fd.return_type_name == null
            return 0
        name = fd.return_type_name
        name_len = fd.return_type_name_len
        var extra: i32 = 0
        while name_len > 4 and memcmp(name, c"ptr_", 4) == 0
            name = name + 4
            name_len = name_len - 4
            extra = extra + 1
        if find_struct(s, name, name_len) == null
            return 0
        slot = TYPE_STRUCT + extra * PTR_DEPTH_UNIT
    else
        return 0
    let levels: i32 = ptr_ptr_slot_levels(slot)
    if levels < 2
        return 0
    let inner: i32 = ptr_ptr_slot_inner(slot)
    *out_inner = inner
    # A primitive `**u8` param still carries a stale parser type name.
    if inner == TYPE_STRUCT
        *out_name = name
        *out_len = name_len
    return levels

# AGAST #2575 / #2598: the pointee of `x` when it is pointer arithmetic on a
# `*T`: `y + k` or `y - k` down the left spine (as ptr_arith_elem_size reads a
# chain), rooted in a call returning `*T` (`vec_as_ptr<E>(@v) + 1`,
# `mkp() + 1`) or a `*T` local or param (`p + 1`).  Returns TYPE_STRUCT and
# writes the struct's name for a `*S`, the primitive kind (TYPE_I32, ...) for
# a scalar `*T`, else 0.  An un-annotated `let e = <x>` takes `*T` from it, as
# if annotated.  It was an i64 with no pointee: `e.b` was "unhandled
# EXPR_MEMBER", `*e = v` stored 8 bytes whatever T was, and `e + 1` stepped
# one byte (#2598, silently).
pub fn ptr_arith_pointee(s: *EmitterState, x: *Expr, out_name: **u8, out_len: *i32) -> i32
    *out_name = null
    *out_len = 0
    if x == null or x.kind != EXPR_BINARY or (x.op != OP_ADD and x.op != OP_SUB)
        return 0
    # `q - p` of two pointers is a count, not a pointer.
    if x.op == OP_SUB and (ptr_arith_elem_size(s, x.right) != 0 or ptr_root_pointee(s, x.right, out_name, out_len) != 0)
        *out_name = null
        *out_len = 0
        return 0
    if x.left.kind == EXPR_BINARY
        return ptr_arith_pointee(s, x.left, out_name, out_len)
    ptr_root_pointee(s, x.left, out_name, out_len)

# The pointee of `x` when it is a call returning `*T` or a `*T` local or
# param: TYPE_STRUCT (name written) for a `*S`, the primitive kind for a
# scalar `*T`, else 0.
pub fn ptr_root_pointee(s: *EmitterState, x: *Expr, out_name: **u8, out_len: *i32) -> i32
    var name: *u8 = null
    var name_len: i32 = 0
    if x.kind == EXPR_CALL
        return fn_ptr_return_pointee(s, find_call_fn(s, x), out_name, out_len)
    else if x.kind == EXPR_IDENT
        let loc: *LocalVar = find_local_struct_name(s, x.ident_ptr, x.ident_len)
        if loc == null
            return 0
        # An inferred `let q = @x[i]` is an `@T` and doesn't step (LARB R20).
        if loc.var_type != TYPE_PTR
            return 0
        if primitive_name_len(loc.pointee_type) > 0
            return loc.pointee_type
        name = loc.type_name
        name_len = loc.type_name_len
    # AGAST #2596: a `*T` field at any depth, `v.data` of a `Vec<E>`.  A
    # struct pointee is named by field_type_name, a primitive one recorded in
    # array_elem_type (#1304), as ptr_arith_elem_size reads it.
    else if x.kind == EXPR_MEMBER
        let fld: *StructField = member_field_def(s, x)
        if fld == null or fld.field_type != TYPE_PTR
            return 0
        if fld.field_type_name_len == 0
            if primitive_name_len(fld.array_elem_type) > 0
                return fld.array_elem_type
            return 0
        name = fld.field_type_name
        name_len = fld.field_type_name_len
    # AGAST #3204: `p as *T`, the step R20 (#3106) gives an `@T`.  The parser
    # records the pointee on the cast (int_val = kind, ident_ptr = struct
    # name; apply_cast_tail), so `let q = (p as *C) + 1` is a `*C`, as
    # `let q = p as *C` already was.  It was an i64: `q.x` "unhandled
    # EXPR_MEMBER", `*q` an 8-byte load.
    else if x.kind == EXPR_CAST
        if x.op != TYPE_PTR
            return 0
        let ck: i32 = x.int_val as i32
        if primitive_name_len(ck) > 0
            return ck
        if ck != TYPE_STRUCT
            return 0
        name = x.ident_ptr
        name_len = x.ident_len
    else
        return 0
    if name == null or name_len == 0 or find_struct(s, name, name_len) == null
        return 0
    *out_name = name
    *out_len = name_len
    TYPE_STRUCT

# The FnDef a call `f()` (find_call_fn) or, AGAST #4060, a method call
# `b.m()` (method_call_def) dispatches to; null for any other expression.
pub fn call_fn_def(s: *EmitterState, x: *Expr) -> *FnDef
    if x.kind == EXPR_CALL
        return find_call_fn(s, x)
    if x.kind == EXPR_METHOD
        return method_call_def(s, x)
    null

# ptr_root_pointee for a callee `fd` (a fn or, AGAST #3528, a method)
# returning `*T`: TYPE_STRUCT (name written) for a `*S`, the primitive kind for
# a scalar `*T`, else 0 (fd null, or not a `*T` return).
pub fn fn_ptr_return_pointee(s: *EmitterState, fd: *FnDef, out_name: **u8, out_len: *i32) -> i32
    if fd == null or fd.return_type != TYPE_PTR
        return 0
    # capture_fn_return_type names a primitive pointee ("i32") on
    # return_type_name (#1984), as ptr_arith_elem_size reads it (#2540).
    let rp: i32 = primitive_type_from_name(fd.return_type_name, fd.return_type_name_len)
    if rp != 0   # primitive_type_from_name's miss value
        return rp
    let name: *u8 = fd.return_type_name
    let name_len: i32 = fd.return_type_name_len
    if name == null or name_len == 0 or find_struct(s, name, name_len) == null
        return 0
    *out_name = name
    *out_len = name_len
    TYPE_STRUCT

# AGAST #2376:`@a[i]` points at an element that is itself a pointer: a `**U`
# for `a: [N]*U`, one level more than the element for `a: [N]**U`.  0 for any
# other element, which isn't a pointer to pointer.
fn addr_of_elem_levels(s: *EmitterState, x: *Expr, out_inner: *i32, out_name: **u8, out_len: *i32) -> i32
    var elem: i32 = TYPE_VOID
    var pointee: i32 = TYPE_VOID
    var name: *u8 = null
    var name_len: i32 = 0
    array_elem_record(s, x, @elem, @pointee, @name, @name_len)
    if elem == TYPE_PTR
        let u: i32 = elem_recorded_pointee(s, elem, pointee, name, name_len, out_name, out_len)
        if u == TYPE_VOID
            return 0
        *out_inner = u
        return 2
    if elem != TYPE_PTR_PTR or ptr_ptr_slot_levels(pointee) < 2
        return 0
    *out_inner = ptr_ptr_slot_inner(pointee)
    if *out_inner == TYPE_STRUCT
        *out_name = name
        *out_len = name_len
    ptr_ptr_slot_levels(pointee) + 1

# AGAST #2376: 1 when `x` (past any `+ k`) is an array element `a[i]` or its
# address `@a[i]`, the roots ptr_levels_of resolves through an array's record.
pub fn elem_rooted(x: *Expr) -> i32
    var b: *Expr = x
    while b != null and b.kind == EXPR_BINARY and (b.op == OP_ADD or b.op == OP_SUB)
        b = b.left
    if b == null
        return 0
    if b.kind == EXPR_UNARY and (b.op == OP_ADDR or b.op == OP_ADDR_MUT)
        b = b.operand
    (b != null and b.kind == EXPR_INDEX) as i32

# AGAST #1815: the element a `*(pp + i)` (or `*pp`) points at, when that is
# a primitive T: `*(*(pp + i) + k)` loads a T and `*(pp + i) + k` strides by
# sizeof(T).  TYPE_VOID when unknown (not a deref, a struct T, or itself a
# pointer, which loads and stores as i64 anyway) — callers keep their
# previous behaviour then.  AGAST #1924: any base ptr_levels_of resolves.
#
# ritz1's own enum tracker read its `**u8` name table this way under
# self-hosting and got `load i64` for each byte, so it carried a "load each
# byte through an explicit let" workaround (ast_helpers.ritz) for years.
fn deref_ptr_ptr_elem_type(s: *EmitterState, d: *Expr) -> i32
    if d == null or d.kind != EXPR_UNARY or d.op != OP_DEREF or d.operand == null
        return TYPE_VOID
    var inner: i32 = TYPE_VOID
    var name: *u8 = null
    var name_len: i32 = 0
    if ptr_levels_of(s, d, @inner, @name, @name_len) != 1
        return TYPE_VOID
    if inner == TYPE_STRUCT or ptr_pointee_size(s, inner, null, 0) == 0
        return TYPE_VOID
    return inner

# AGAST #3186: the scalar T an element `x[i]` points at when `x` is a `**T`
# (exactly two levels), or TYPE_VOID: not that shape, or T is a struct
# (deref_pointee_struct_name names those) or has no known size.
fn ptr_ptr_index_scalar(s: *EmitterState, x: *Expr) -> i32
    var inner: i32 = TYPE_VOID
    var name: *u8 = null
    var name_len: i32 = 0
    if ptr_levels_of(s, x, @inner, @name, @name_len) != 2
        return TYPE_VOID
    if inner == TYPE_STRUCT or ptr_pointee_size(s, inner, null, 0) == 0
        return TYPE_VOID
    return inner

# AGAST #2537: the scalar T that `(*r)[i]` reads when `*r` is a `*T` (`r: **T`,
# a `let r = @q` or a `**T` param).  emit_expr_index fell to its byte path for
# it (`getelementptr i8` + `load i8`) whatever T was, while `*(*r + k)` already
# had T's stride.  TYPE_VOID when not that shape, or T isn't a scalar, or the
# index is a range (refused before this is asked).
pub fn deref_index_elem(s: *EmitterState, e: *Expr) -> i32
    if e == null or e.kind != EXPR_INDEX or e.left == null
        return TYPE_VOID
    if e.right != null and e.right.kind == EXPR_RANGE
        return TYPE_VOID
    let t: i32 = deref_ptr_ptr_elem_type(s, e.left)
    if ty_int_in(t, 8, 32) == 1
        return t
    if ty_int_bits(t) == 64 or t == TYPE_F32 or t == TYPE_F64 or t == TYPE_BOOL
        return t
    return TYPE_VOID

# AGAST #1941 / #1924: the element stride of a pointer-valued `*y`, for
# `*pp + 1` / `*(pp + i) + k`: sizeof(T) when `*y` is a `*T` (struct T
# included: sizeof(S)), 8 when it is itself a pointer to pointer
# (`*ppp + 1` with `ppp: ***S`, #1944).  0 when not that shape, which
# ptr_arith_elem_size reads as "not a pointer" (a raw byte add).
fn deref_ptr_ptr_stride(s: *EmitterState, d: *Expr) -> i64
    if d == null or d.kind != EXPR_UNARY or d.op != OP_DEREF or d.operand == null
        return 0
    var inner: i32 = TYPE_VOID
    var name: *u8 = null
    var name_len: i32 = 0
    let levels: i32 = ptr_levels_of(s, d, @inner, @name, @name_len)
    if levels >= 2
        return 8
    if levels == 1
        return ptr_pointee_size(s, inner, name, name_len)
    return 0

# AGAST #1924: the struct S that a pointer-valued `*y` points at (`*(pp + i)`
# with `pp: **S`, `*(t.cells + i)` with a `**S` field, `*g`), so
# `*(*(pp + i) + k)` loads `%S` and `(*(*(pp + i) + k)).f` resolves.
# Writes null/0 when not that shape.
pub fn deref_ptr_ptr_struct_name(s: *EmitterState, d: *Expr, out_name: **u8, out_len: *i32)
    *out_name = null
    *out_len = 0
    if d == null or d.kind != EXPR_UNARY or d.op != OP_DEREF or d.operand == null
        return
    var inner: i32 = TYPE_VOID
    var name: *u8 = null
    var name_len: i32 = 0
    if ptr_levels_of(s, d, @inner, @name, @name_len) != 1 or inner != TYPE_STRUCT
        return
    *out_name = name
    *out_len = name_len

# Classify an operand of `+`/`-` as pointer arithmetic, and if so give its
# element stride.  Returns 0 for "not a pointer", otherwise the element size
# in bytes (never 0, so 0 is an unambiguous sentinel).
#
# AGAST #1361.  This was previously inline in emit_expr_binary and handled
# exactly two shapes: EXPR_IDENT (`p + i`) and EXPR_MEMBER (`s.ptr + i`).
# An unparenthesised chain associates to the left:
#
#     lines.data + i - 1   ==   SUB( ADD( MEMBER(lines,data), i ), 1 )
#
# so the outer SUB's left operand is EXPR_BINARY, matched neither arm, and
# the `- 1` was emitted as a raw BYTE subtraction.  For a 16-byte element
# that lands 15 bytes short and every field load reads across the element
# boundary.  It does not crash — it silently computes a wrong address, which
# is how `tier2_stdlib/14_uniq` shipped passing every line through instead of
# deduplicating for as long as ritz1 has existed.
#
# The recursion is deliberately down the LEFT spine only: `p + i` is a
# pointer, `i + p` is not treated as one here (that asymmetry is pre-existing
# and shared with the two original arms).  Pointer DIFFERENCE (`p - q`, which
# yields an integer, not a pointer) is likewise still mis-scaled — but it was
# already mis-scaled at depth 0 before this change, so propagating the same
# classification through a chain keeps behaviour consistent rather than
# introducing a second, differently-wrong rule.  Tracked separately.
pub fn ptr_arith_elem_size(s: *EmitterState, e: *Expr) -> i64
    if e.kind == EXPR_IDENT
        let lt: i32 = find_local_type(s, e.ident_ptr, e.ident_len)
        if lt == TYPE_PTR or lt == TYPE_PTR_PTR or lt == TYPE_REF or lt == TYPE_MUT_REF
            return get_ptr_elem_size(s, e)
        if lt == TYPE_UNKNOWN
            # Global pointer var: the ident isn't a local (find_local_type
            # returns TYPE_UNKNOWN since AGAST #1328; it used to return a
            # TYPE_I64 miss value, so this arm previously also ran for real
            # i64 locals that shadow a global — now it is miss-only).
            # Without this branch, `*(g_arr + i) = ...` for `var g_arr: *T`
            # emits raw `add i64 base, i` (no stride), then stores i64 —
            # wrong for *i32 globals (which the monomorph instantiation
            # tracker uses heavily).  Was the source of the selfhost 8-test
            # gap (vec_push\$T not specialized → declare i64 extern instead
            # of `define i32`).
            let glob: *GlobalVarDef = find_global(s, e.ident_ptr, e.ident_len)
            if glob != null
                if glob.var_type == TYPE_PTR_PTR
                    return 8
                let grow: i64 = base_ptr_array_row_size(s, e)   # AGAST #2304
                if grow > 0
                    return grow
                if glob.var_type == TYPE_PTR or glob.var_type == TYPE_REF or glob.var_type == TYPE_MUT_REF
                    # AGAST #2034: size the pointee with ptr_pointee_size, the
                    # table locals and params use.  This arm used to list
                    # only the integer widths, so `g + 1` on a `*f32` / `*f64`
                    # global stepped one byte.  `*S` globals are sized by
                    # emit_expr_binary's deref_pointee_struct_name first; an
                    # unknown pointee keeps the old 1-byte stride.
                    let gsz: i64 = ptr_pointee_size(s, glob.pointee_type, null, 0)
                    if gsz > 0
                        return gsz
                    return 1
        return 0
    if e.kind == EXPR_MEMBER
        # Member field access — check if the field is a pointer type.
        # AGAST #1673: at any chain depth.  `o.mid.buf.p + 1` used to match
        # only `local.f` and fall through to a raw BYTE add for an *i32.
        let fld: *StructField = member_field_def(s, e)
        if fld != null
            let frow: i64 = base_ptr_array_row_size(s, e)   # AGAST #2304
            if frow > 0
                return frow
            if fld.field_type == TYPE_PTR or fld.field_type == TYPE_PTR_PTR or fld.field_type == TYPE_REF or fld.field_type == TYPE_MUT_REF
                return get_ptr_elem_size(s, e)
        return 0
    if e.kind == EXPR_BINARY
        # A chain: `(ptr ± a) ± b`.  The inner result is a pointer iff the
        # inner expression was itself pointer arithmetic, and it carries the
        # same stride.
        if e.op == OP_ADD or e.op == OP_SUB
            if is_ptr_distance(s, e) == 1
                return 0   # AGAST #2928: `q - p` is a count, not a pointer
            return ptr_arith_elem_size(s, e.left)
        return 0
    if e.kind == EXPR_INDEX
        # AGAST #2332: `a[i] + k` with `a: [N]*T` strides by sizeof(T).
        var ae_name: *u8 = null
        var ae_len: i32 = 0
        let ae: i32 = array_elem_pointee(s, e, @ae_name, @ae_len)
        # AGAST #3058: `b[i] + k` with `b: [N]**T` steps a pointer, 8 bytes.  It
        # was a raw byte add, so `b[i][1]` read 1 byte into b[i]'s first pointer.
        if ae == TYPE_VOID
            var pp_inner: i32 = TYPE_VOID
            if ptr_levels_of(s, e, @pp_inner, @ae_name, @ae_len) >= 2
                return 8
        return ptr_pointee_size(s, ae, ae_name, ae_len)
    if e.kind == EXPR_UNARY
        # AGAST #1603: `@arr[i] + n`.  The address of an indexed element is a
        # pointer to that element, so it strides by the element size.  Without
        # this arm the sum classified as "not a pointer" and `+ n` was a raw
        # BYTE offset — `@arr[0] + 2` on a [4]i32 landed half-way into
        # element 0.  (`let q: *i32 = @arr[0]` then `q + 2` was always fine:
        # q is an identifier with a recorded pointee.)
        if (e.op == OP_ADDR or e.op == OP_ADDR_MUT) and e.operand != null and e.operand.kind == EXPR_INDEX
            return index_elem_size(s, e.operand)
        # AGAST #1815 / #1941 / #1924: `*(pp + i) + k` for `pp: **T`
        # strides by sizeof(T) (sizeof(S) for `**S`, 8 for `***T`), whatever
        # the base: local, param, global or struct field.
        return deref_ptr_ptr_stride(s, e)
    if e.kind == EXPR_CALL or e.kind == EXPR_METHOD
        # AGAST #2540: `f() + k` with `f() -> *T` strides by sizeof(T).  It
        # was a raw byte add, so `*(ident(p) + 2)` on a `*i32` read 2 bytes
        # in.  capture_fn_return_type names a primitive pointee ("i32") on
        # return_type_name (#1984); a struct pointee names the struct.
        # AGAST #4060: and `b.m() + k`, a method returning `*T` / `**T`.
        let fd: *FnDef = call_fn_def(s, e)
        if fd == null
            return 0
        if fd.return_type == TYPE_PTR_PTR
            return 8
        if fd.return_type != TYPE_PTR
            return 0
        let rp: i32 = primitive_type_from_name(fd.return_type_name, fd.return_type_name_len)
        var csz: i64 = 0
        if rp != 0   # primitive_type_from_name's miss value
            csz = ptr_pointee_size(s, rp, null, 0)
        else
            csz = ptr_pointee_size(s, TYPE_STRUCT, fd.return_type_name, fd.return_type_name_len)
        # AGAST #2791: the call IS a pointer, so 0 ("not a pointer") would
        # be a raw byte add.  Fail closed (#1451), as a local's stride does.
        if csz > 0
            return csz
        return ptr_elem_size_unknown(s, e.span, fd.name, fd.name_len)
    if e.kind == EXPR_CAST and e.op == TYPE_PTR
        # AGAST #2540: `(x as *T) + k`.  apply_cast_tail records the pointee
        # kind on int_val and a struct pointee's name on ident_ptr (#1453).
        return ptr_pointee_size(s, e.int_val as i32, e.ident_ptr, e.ident_len)
    if e.kind == EXPR_CAST and e.op == TYPE_PTR_PTR
        # AGAST #3834: `(x as **T) + k` steps a pointer, 8 bytes, as a
        # `**T` local or global does.  It was a raw byte add, so
        # `*((x as **T) + 1)` loaded a pointer from 1 byte in: a SIGSEGV.
        return 8
    return 0

# Byte size of the element an index expression `base[i]` names, for
# `@base[i]` pointer arithmetic (AGAST #1603).  `base` is a local or global
# `[N]T` array, or a pointer (whose stride ptr_arith_elem_size already knows).
# Fails CLOSED like get_ptr_elem_size (#1451): an array whose element size is
# unresolvable is a located emitter error, never a guessed stride.
fn index_elem_size(s: *EmitterState, idx: *Expr) -> i64
    let base: *Expr = idx.left
    if base == null
        return 0
    if base.kind == EXPR_IDENT
        let loc: *LocalVar = find_local_struct_name(s, base.ident_ptr, base.ident_len)
        if loc != null and loc.var_type == TYPE_ARRAY
            let lsize: i64 = ptr_pointee_size(s, loc.array_elem_type, loc.type_name, loc.type_name_len)
            if lsize > 0
                return lsize
            return ptr_elem_size_unknown(s, base.span, base.ident_ptr, base.ident_len)
        if loc == null
            let glob: *GlobalVarDef = find_global(s, base.ident_ptr, base.ident_len)
            if glob != null and glob.var_type == TYPE_ARRAY
                let gsize: i64 = ptr_pointee_size(s, glob.array_elem_type, glob.array_elem_type_name, glob.array_elem_type_name_len)
                if gsize > 0
                    return gsize
                return ptr_elem_size_unknown(s, base.span, base.ident_ptr, base.ident_len)
    # AGAST #4249: `@x.buf[0] + i` with `buf: [N]T` a struct field strides by
    # sizeof(T).  The member fell to ptr_arith_elem_size, which knows only a
    # pointer field, so it was a raw byte add.  N-D fields keep that path.
    if base.kind == EXPR_MEMBER
        let fld: *StructField = member_field_def(s, base)
        if fld != null and fld.field_type == TYPE_ARRAY and fld.array_shape == null
            let fsize: i64 = ptr_pointee_size(s, fld.array_elem_type, fld.array_elem_type_name, fld.array_elem_type_name_len)
            if fsize > 0
                return fsize
    # AGAST #2440: through a reference or pointer it's the buffer's element.
    let through: *LocalVar = index_through(s, idx)
    if through != null and through.array_base != null
        return ptr_pointee_size(s, through.pointee_type, through.type_name, through.type_name_len)   # #2329
    if through != null
        var th: ThroughIndex
        index_through_fill(s, idx, through, @th)
        return ptr_arith_elem_size(s, @th.sum)
    # `@p[i]` for a pointer `p`: the element is p's pointee.
    return ptr_arith_elem_size(s, base)

# Helper: get pointee type for a struct member that is a pointer
# e.g., for span.ptr (where ptr is *u8), returns TYPE_U8.
#
# AGAST #1304: this GUESSES TYPE_U8 for a pointer field whose pointee it
# cannot determine (monomorphised `Vec<T>.data`, for one).  That guess is
# right often enough for loads, but callers that need to know the
# difference between "it is a u8" and "no idea" must use
# get_member_pointee_type_exact below, which returns TYPE_VOID (0) for the
# unknown case.  emit_assign's deref-store depends on that distinction:
# guessing u8 there truncates a struct RHS to one byte.
fn get_member_pointee_type(s: *EmitterState, e: *Expr) -> i32
    let exact: i32 = get_member_pointee_type_exact(s, e)
    if exact == TYPE_VOID
        return TYPE_U8
    return exact

# Like get_member_pointee_type but returns TYPE_VOID (0) rather than
# guessing TYPE_U8 when the field's pointee type is not recorded.
pub fn get_member_pointee_type_exact(s: *EmitterState, e: *Expr) -> i32
    if e.kind != EXPR_MEMBER
        return TYPE_I64
    # Resolve the field through the whole receiver chain.  Nesting is
    # critical for selfhost: ritz1's own emit_expr_method does
    # `*(e.left.ident_ptr + i)`, and an unresolved receiver returned
    # TYPE_I64 → OP_DEREF emitted `load i64` instead of `load i8`.  This
    # handled exactly `local.f` and `local.m.f` until AGAST #1673;
    # `o.inner.name.ptr` (3+ levels) still loaded i64.
    let field: *StructField = member_field_def(s, e)
    # Return the pointee type based on field's pointer kind.
    # `array_elem_type` is where make_ptr_prim_field records the
    # pointee for primitive pointers (NFA's *i64 indices, Vec$T
    # data, etc.) — without honoring the i16/i32/i64 cases here,
    # `*(struct.ptr_field + i)` would default to TYPE_U8 and
    # emit `load i8`, garbling the actual i64/i32/i16 read.
    # Was the selfhost blocker for the Tier 1 NFA optimization
    # — `nfa.state_trans_offset` is `*i32`; reading it as i8
    # gave bogus offsets and the lexer matched no patterns.
    if field != null and field.field_type == TYPE_PTR
        let pe: i32 = field.array_elem_type
        if ty_int_in(pe, 8, 16) == 1
            return pe
        if ty_int_in(pe, 32, 64) == 1
            return pe
        # AGAST #2053: a `*f32` / `*f64` / `*bool` field.  These fell to
        # the unknown case, so `*r.p` loaded `i8` (the u8 guess) and
        # `*r.p = v` stored `i64 %double`.
        if pe == TYPE_F32 or pe == TYPE_F64 or pe == TYPE_BOOL
            return pe
        # Pointee not recorded — e.g. `data: *T` in a
        # monomorphised generic, where the substituted field
        # carries no array_elem_type.  Report "unknown" and let
        # the caller decide; get_member_pointee_type still
        # guesses u8 for the load paths that relied on it.
        return TYPE_VOID
    return TYPE_I64

# AGAST #1304: pointee type of the pointer expression `ptr` in `*ptr = v`,
# i.e. the width of the destination slot.  Mirrors get_expr_type's OP_DEREF
# arm but returns TYPE_VOID instead of guessing when the pointee is not
# recorded, so emit_assign can fall back to the RHS's own type rather than
# truncating it.  TYPE_I64 doubles as "unknown" in the local/global pointee
# tables, and an i64 store is the default anyway, so it is reported as-is.
pub fn get_deref_store_type(s: *EmitterState, ptr_expr: *Expr) -> i32
    # AGAST #2119: `*(@s as *i8) = v` / `*@g = v` store the stated pointee.
    let inl_pt: i32 = inline_deref_scalar_pointee(s, ptr_expr)
    if inl_pt != TYPE_VOID
        return inl_pt
    # AGAST #2332: `*a[i] = v` / `*(a[i] + k) = v` with `a: [N]*T`.
    let el_pt: i32 = array_elem_pointee_kind(s, ptr_expr)
    if el_pt != TYPE_VOID
        return el_pt
    # AGAST #3186: `*X[i] = v` with `X` a `**T` (a field `h.f`, a local, a
    # param): `X[i]` is the `*T` `*(X + i)`, so the slot is a T.  Unresolved,
    # this stored the RHS's whole i64 over a 4- or 1-byte T.
    if ptr_expr.kind == EXPR_INDEX and ptr_expr.right != null and ptr_expr.right.kind != EXPR_RANGE
        let ix_pt: i32 = ptr_ptr_index_scalar(s, ptr_expr.left)
        if ix_pt != TYPE_VOID
            return ix_pt
    if ptr_expr.kind == EXPR_IDENT
        let lpt: i32 = find_local_pointee_type(s, ptr_expr.ident_ptr, ptr_expr.ident_len)
        if lpt != TYPE_I64
            return lpt
        let glob: *GlobalVarDef = find_global(s, ptr_expr.ident_ptr, ptr_expr.ident_len)
        if glob != null
            return glob.pointee_type
        return TYPE_VOID
    if ptr_expr.kind == EXPR_MEMBER
        return get_member_pointee_type_exact(s, ptr_expr)
    if ptr_expr.kind == EXPR_BINARY
        # `*(base + i) = v` — the slot width comes from `base`.
        let base: *Expr = find_base_expr(ptr_expr)
        if base.kind == EXPR_IDENT
            let blpt: i32 = find_local_pointee_type(s, base.ident_ptr, base.ident_len)
            if blpt != TYPE_I64
                return blpt
            let bglob: *GlobalVarDef = find_global(s, base.ident_ptr, base.ident_len)
            if bglob != null
                return bglob.pointee_type
            return TYPE_VOID
        if base.kind == EXPR_MEMBER
            return get_member_pointee_type_exact(s, base)
        # AGAST #1815: `*(*(pp + i) + k) = v`.
        return deref_ptr_ptr_elem_type(s, base)
    if ptr_expr.kind == EXPR_UNARY
        # AGAST #1815: `**pp = v`.
        return deref_ptr_ptr_elem_type(s, ptr_expr)
    return TYPE_VOID

# AGAST #1965: the float width (TYPE_F32 / TYPE_F64) of binop operand `x`,
# or 0 when it is not a float.  An `f32` local can surface as TYPE_STRUCT
# with declared type name "f32", which is_float_type also accepts.
pub fn binop_operand_float_ty(s: *EmitterState, x: *Expr) -> i32
    let t: i32 = expr_slot_ty(x)
    if t == TYPE_F32 or t == TYPE_F64
        return t
    if x.kind == EXPR_IDENT
        let lv: *LocalVar = find_local_struct_name(s, x.ident_ptr, x.ident_len)
        if lv != null and is_float_type(t, lv.type_name, lv.type_name_len) == 1
            if *(lv.type_name + 1) == 51  # "f32"
                return TYPE_F32
            return TYPE_F64
    return 0

# AGAST #1370: float primitive methods, mirroring ritz0's
# _try_emit_float_intrinsic.  0 ceil, 1 floor, 2 round, 3 abs; -1 otherwise.
pub fn float_method_id(name: *u8, len: i32) -> i32
    if len == 4
        if *(name) == 'c' and *(name + 1) == 'e' and *(name + 2) == 'i' and *(name + 3) == 'l'
            return 0
    if len == 5
        if *(name) == 'f' and *(name + 1) == 'l' and *(name + 2) == 'o' and *(name + 3) == 'o' and *(name + 4) == 'r'
            return 1
        if *(name) == 'r' and *(name + 1) == 'o' and *(name + 2) == 'u' and *(name + 3) == 'n' and *(name + 4) == 'd'
            return 2
    if len == 3
        if *(name) == 'a' and *(name + 1) == 'b' and *(name + 2) == 's'
            return 3
    0 - 1

# AGAST #1370: TYPE_F32 / TYPE_F64 when `e` is a float-method call
# (`x.ceil()`, `(x + 0.25).floor()`, `x.abs().ceil()`) on a float receiver,
# 0 otherwise.  The result has the receiver's width, as in ritz0.
pub fn float_method_result_ty(s: *EmitterState, e: *Expr) -> i32
    if e.kind != EXPR_METHOD or e.left == null or e.args != null
        return 0
    if float_method_id(e.ident_ptr, e.ident_len) < 0
        return 0
    binop_operand_float_ty(s, e.left)

# AGAST #4180: the struct a `(*p).m()` or `(p as @S).m()` receiver reaches,
# as emit_expr_method's deref and cast arms (#2145, #4161) dispatch it, or
# null.  So a member of the result (`(*p).me().x`) finds its struct.
pub fn deref_cast_recv_struct(s: *EmitterState, rcv: *Expr, out_len: *i32) -> *u8
    *out_len = 0
    if rcv.kind == EXPR_UNARY and rcv.op == OP_DEREF
        var dname: *u8 = null
        deref_pointee_struct_name(s, rcv.operand, @dname, out_len)
        return dname
    if rcv.kind == EXPR_CAST and (rcv.op == TYPE_PTR or rcv.op == TYPE_REF or rcv.op == TYPE_MUT_REF) and rcv.int_val == (TYPE_STRUCT as i64)
        *out_len = rcv.ident_len
        return rcv.ident_ptr as *u8
    null

# 1 when an impl (any, generic or not) is for the type named `name`.  Such a
# type beats a global of its name that can't be a receiver, `String.from(x)`
# beside `var String: i32`, as in ritz0 (AGAST #2575); a struct global (or a
# `*S` one) still shadows it, as a local or param does.  monomorph's rewrite_static_ufcs_call hid this for the UFCS
# table's types until LARB R66 (#3497) deleted the table.
pub fn global_is_receiver(g: *GlobalVarDef) -> i32
    if g.var_type == TYPE_STRUCT
        return 1
    (g.var_type == TYPE_PTR and g.pointee_type == TYPE_STRUCT) as i32

pub fn impl_type_named(s: *EmitterState, name: *u8, len: i32) -> i32
    var ib: *ImplBlock = s.module.impls
    while ib != null
        if name_eq(ib.type_name, ib.type_name_len, name, len) == 1
            return 1
        ib = ib.next
    0

# AGAST #2068: the struct name a method call `e` dispatches on, as
# emit_expr_method resolves it, or null.  `*out_len` gets its length.
# AGAST #3267: a `%Span$u8` receiver (ritz1's `let h = "..."`) with no
# `Span$u8_<m>` of its own dispatches to `impl StrView`'s `m`, as
# emit_expr_method does, so a chained `h.slice(..).get(..)` is typed by
# StrView_slice's return.  The UFCS fallback did this until R66 (#3497).
pub fn method_recv_type_name(s: *EmitterState, e: *Expr, out_len: *i32) -> *u8
    let tn: *u8 = method_recv_type_name_of(s, e, out_len)
    if tn == null or name_eq(tn, *out_len, c"Span$u8", 7) == 0
        return tn
    if span_u8_method_is_strview(s, e.ident_ptr, e.ident_len) == 1
        *out_len = 7
        return c"StrView"
    tn

# 1 when `Span$u8` has no method `m` (a specialised `Span$u8_<m>`) and
# `impl StrView` has one (`StrView_<m>`).
pub fn span_u8_method_is_strview(s: *EmitterState, m: *u8, m_len: i32) -> i32
    let n: i32 = 8 + m_len
    let buf: *u8 = malloc(n as i64 + 1)
    memcpy(buf, c"Span$u8_", 8)
    memcpy(buf + 8, m, m_len as i64)
    *(buf + n) = 0
    let own: *FnDef = find_fn(s, buf, n)
    memcpy(buf, c"StrView_", 8)
    let sv: *FnDef = find_impl_method_by_symbol(s.module, buf, n)
    free(buf)
    (own == null and sv != null) as i32

fn method_recv_type_name_of(s: *EmitterState, e: *Expr, out_len: *i32) -> *u8
# Receivers: a local (value or pointer -- loc.type_name names the struct
# either way), a struct / `*S` global, a static `Type.m()`, a struct
# literal, a struct-returning call, and a struct / pointer field.
    *out_len = 0
    let rcv: *Expr = e.left
    if rcv == null
        return null
    if rcv.kind == EXPR_IDENT
        let loc: *LocalVar = find_local_struct_name(s, rcv.ident_ptr, rcv.ident_len)
        if loc != null
            *out_len = loc.type_name_len
            return loc.type_name
        var glob: *GlobalVarDef = find_global(s, rcv.ident_ptr, rcv.ident_len)
        if glob != null and global_is_receiver(glob) == 0 and impl_type_named(s, rcv.ident_ptr, rcv.ident_len) == 1
            glob = null
        if glob != null
            if glob.var_type == TYPE_STRUCT
                *out_len = glob.type_name_len
                return glob.type_name
            if glob.var_type == TYPE_PTR and glob.pointee_type == TYPE_STRUCT
                *out_len = glob.pointee_type_name_len
                return glob.pointee_type_name
            return null
        # Neither local nor global: a static call names its impl type.
        *out_len = rcv.ident_len
        return rcv.ident_ptr as *u8
    if rcv.kind == EXPR_STRUCT_LIT
        *out_len = rcv.ident_len
        return rcv.ident_ptr as *u8
    # AGAST #3156: a bare "..." is a StrView (#98), so `"lit".m()` dispatches
    # as on a StrView local.  (Its value is a %Span$u8 of the same layout;
    # emit_expr_method rebuilds it under the StrView name.)  A c"..." is a
    # `*u8` and has no methods.
    if rcv.kind == EXPR_STRING_LIT
        *out_len = 7
        return c"StrView"
    # AGAST #2295 / #3620: a call's or method call's struct return names the
    # impl (`mp().get()`, `Color.red().is_opaque()`, `c.me().is_zero()`).
    # #2946 / #2883: or its `*S` return (`sp(@s).me()`, `s.me().me()`), as
    # emit_expr_method's EXPR_CALL / EXPR_METHOD arms dispatch it.
    if rcv.kind == EXPR_CALL or rcv.kind == EXPR_METHOD
        var cname: *u8 = null
        call_result_struct_name(s, rcv, @cname, out_len)
        if *out_len > 0
            return cname
        let cst: *StructDef = call_result_ptr_struct(s, rcv)
        if cst != null
            *out_len = cst.name_len
            return cst.name
        *out_len = 0
        return null
    if rcv.kind == EXPR_MEMBER
        let fld: *StructField = member_field_def(s, rcv)
        if fld != null and (fld.field_type == TYPE_STRUCT or fld.field_type == TYPE_PTR or fld.field_type == TYPE_REF or fld.field_type == TYPE_MUT_REF)
            *out_len = fld.field_type_name_len
            return fld.field_type_name
        return null
    # AGAST #3622: an element (`self.ws[i].m()` over a `Vec<S>` field,
    # `arr[i].m()`, `p[i].m()`, `a[i][j].m()`): the struct it is, or points
    # at, as emit_expr_method's EXPR_INDEX arms dispatch on.
    if rcv.kind == EXPR_INDEX
        var iname: *u8 = null
        index_elem_struct_name(s, rcv, @iname, out_len)
        return iname
    if rcv.kind == EXPR_UNARY or rcv.kind == EXPR_CAST
        return deref_cast_recv_struct(s, rcv, out_len)   # AGAST #4180
    null

# AGAST #2068: TYPE_F32 / TYPE_F64 when `e` calls a user impl method that
# returns one, 0 otherwise.  emit_expr_method leaves that result in a
# `float` / `double` register, so `p.scale(f) + 0.5` must be float math at
# the method's width -- get_expr_type used to call it i64, and the add ran
# at the literal's `double` (`fadd double %<float>`, rejected by clang).
pub fn user_method_float_ret(s: *EmitterState, e: *Expr) -> i32
    let t: i32 = user_method_ret_type(s, e)
    if t == TYPE_F32 or t == TYPE_F64
        return t
    0

# The declared return type of user method call `e`, or TYPE_UNKNOWN.
pub fn user_method_ret_type(s: *EmitterState, e: *Expr) -> i32
    if e.kind != EXPR_METHOD
        return TYPE_UNKNOWN
    var tn_len: i32 = 0
    let tn: *u8 = method_recv_type_name(s, e, @tn_len)
    if tn == null or tn_len == 0
        return TYPE_UNKNOWN
    var ib: *ImplBlock = s.module.impls
    while ib != null
        if name_eq(ib.type_name, ib.type_name_len, tn, tn_len) == 1
            var m: *FnDef = ib.methods
            while m != null
                if name_eq(m.name, m.name_len, e.ident_ptr, e.ident_len) == 1
                    return m.return_type
                m = m.next
        ib = ib.next
    TYPE_UNKNOWN

# AGAST #1965: the float width a binop `e` is computed at, or 0 when neither
# operand is a float.  f32 when both sides are f32, or one is f32 and the
# other a literal / `-literal` (a `double` that narrows); f64 otherwise --
# f64 wins over f32.  emit_expr_binary coerces both operands to it, and
# get_expr_type reports it for float arithmetic so an enclosing op agrees.
pub fn binop_float_width(s: *EmitterState, e: *Expr) -> i32
    let lft: i32 = binop_operand_float_ty(s, e.left)
    let rft: i32 = binop_operand_float_ty(s, e.right)
    if lft == 0 and rft == 0
        return 0
    if lft == TYPE_F32 and (rft == TYPE_F32 or is_float_lit_operand(e.right) == 1)
        return TYPE_F32
    if rft == TYPE_F32 and is_float_lit_operand(e.left) == 1
        return TYPE_F32
    TYPE_F64

# =============================================================================
# Volatile and atomic memory builtins (LANGUAGE_SPEC §18.4-§18.5, AGAST #1879)
# =============================================================================
#
# volatile_load / volatile_store and atomic_* / fence lower to LLVM volatile
# and seq_cst atomic instructions at the width of the pointer's pointee,
# which must be an integer type.  ritz1 carries integers as i64, so results
# come back extended (sext / zext by the pointee's signedness) and value
# operands are truncated, as a call argument would be.

# AGAST #2286: the local `e` names when its slot holds a `:&` borrow's pointer,
# so that `@e` is that pointer (LocalVar.holds_lent_ptr); null otherwise.
pub fn lent_ptr_local(s: *EmitterState, e: *Expr) -> *LocalVar
    if e == null or e.kind != EXPR_IDENT
        return null
    let loc: *LocalVar = find_local_struct_name(s, e.ident_ptr, e.ident_len)
    if loc == null or loc.holds_lent_ptr == 0
        return null
    return loc

# lent_ptr_local, when `@e` points at a struct, which the local's type_name then
# names.  `c:& **C` and `c:& [2]C` name `C` too, and `@c` isn't a `*C` there.
pub fn lent_struct_local(s: *EmitterState, e: *Expr) -> *LocalVar
    let loc: *LocalVar = lent_ptr_local(s, e)
    if loc == null or loc.pointee_type != TYPE_STRUCT
        return null
    return loc

# The pointee type a pointer expression states inline, or TYPE_VOID: `<e> as
# *T` (the cast records T; AGAST #1453), `@x` (x's own type) and a call that
# returns a reference (#2308).  Shared by the memory builtins (#1879) and the
# `*p` load / `*p = v` store widths (#2119), which otherwise only know a typed
# binding's pointee.
fn inline_ptr_pointee(s: *EmitterState, p: *Expr) -> i32
    if p == null
        return TYPE_VOID
    if p.kind == EXPR_CALL
        let fd: *FnDef = find_call_fn(s, p)
        # AGAST #2540: `*f()` with `f() -> *T` (T scalar) loads a T, not an
        # i64: capture_fn_return_type names the primitive pointee (#1984).
        if fd != null and fd.return_type == TYPE_PTR
            return primitive_type_from_name(fd.return_type_name, fd.return_type_name_len)
        return ret_ref_scalar_pointee(fd)
    if p.kind == EXPR_METHOD
        # AGAST #2327: so does `*x.m()` of a `-> @T` / `-> @&T` method, its
        # callee resolved as `let p = x.m()` resolves it (#2308).
        var mt_len: i32 = 0
        let mt: *u8 = method_recv_type_name(s, p, @mt_len)
        if mt == null or mt_len <= 0
            return TYPE_VOID
        let md: *FnDef = method_callee_def(s, mt, mt_len, p.ident_ptr, p.ident_len)
        # AGAST #3176: and of a `-> *T` method, as the call arm does (#2540).
        if md != null and md.return_type == TYPE_PTR
            return primitive_type_from_name(md.return_type_name, md.return_type_name_len)
        return ret_ref_scalar_pointee(md)
    if p.kind == EXPR_BINARY and (p.op == OP_ADD or p.op == OP_SUB) and p.left != null
        # AGAST #2540: `*(f() + k)` / `*((x as *T) + k)` point at the same T
        # as their left operand; ptr_arith_elem_size steps by its size.
        # AGAST #4060: and `*(b.m() + k)`, a `-> *T` method.  It loaded an i64.
        if is_ptr_distance(s, p) == 1
            return TYPE_VOID
        let lk: i32 = p.left.kind
        if lk == EXPR_CALL or lk == EXPR_METHOD or lk == EXPR_CAST or lk == EXPR_BINARY
            return inline_ptr_pointee(s, p.left)
        return TYPE_VOID
    if p.kind == EXPR_CAST and p.op == TYPE_PTR and p.int_val != (TYPE_VOID as i64)
        return p.int_val as i32
    if p.kind == EXPR_UNARY and (p.op == OP_ADDR or p.op == OP_ADDR_MUT) and p.operand != null
        let ae: i32 = addr_of_array_elem_type(s, p.operand)
        if ae != TYPE_VOID
            return ae
        let lent: *LocalVar = lent_ptr_local(s, p.operand)
        if lent != null
            return lent.pointee_type   # AGAST #2286: it reads as the pointer
        return expr_slot_ty(p.operand)
    TYPE_VOID

# The element type of `arr[i]` over an inline array (local, global or
# field), or TYPE_VOID.  get_expr_type calls an integer element i64 (its
# value-model width), but `@arr[i]` points at the element's own slot.
fn addr_of_array_elem_type(s: *EmitterState, x: *Expr) -> i32
    if x.kind != EXPR_INDEX or x.left == null
        return TYPE_VOID
    if x.right != null and x.right.kind == EXPR_RANGE
        return TYPE_VOID
    if x.left.kind == EXPR_IDENT
        let loc: *LocalVar = find_local_struct_name(s, x.left.ident_ptr, x.left.ident_len)
        if loc != null
            if loc.var_type == TYPE_ARRAY
                return loc.array_elem_type
            return TYPE_VOID
        let glob: *GlobalVarDef = find_global(s, x.left.ident_ptr, x.left.ident_len)
        if glob != null and glob.var_type == TYPE_ARRAY
            return glob.array_elem_type
        return TYPE_VOID
    if x.left.kind == EXPR_MEMBER
        let f: *StructField = member_field_def(s, x.left)
        if f != null and f.field_type == TYPE_ARRAY
            return f.array_elem_type
    TYPE_VOID

# AGAST #2119: the scalar (integer / float / bool) pointee of `*p` when `p`
# states it inline, else TYPE_VOID.  `*(@s as *i8)` and `*@g` (g: u32)
# loaded and stored i64, reading / clobbering the slot's neighbours.
# Aggregates are left to deref_pointee_struct_name, which names them.
pub fn inline_deref_scalar_pointee(s: *EmitterState, p: *Expr) -> i32
    let t: i32 = inline_ptr_pointee(s, p)
    if t != TYPE_VOID and primitive_name_len(t) > 0
        return t
    TYPE_VOID

# The pointee type of a memory builtin's pointer operand.  ritz1's `*p`
# inference only knows a typed binding's pointee (a `*(@x as *u32)` deref
# loads i64), and an atomic must not silently widen, so the two shapes a
# kernel writes inline are resolved here first: `<e> as *T` (the cast
# records T) and `@x` (x's own type).
pub fn mem_builtin_pointee(s: *EmitterState, arg: *Expr) -> i32
    if arg == null
        return TYPE_VOID
    let inl: i32 = inline_ptr_pointee(s, arg)
    if inl != TYPE_VOID
        return inl
    # AGAST #4410: get_deref_store_type reports TYPE_VOID for a pointee it
    # cannot name; get_expr_type's `*arg` default (and its i64 miss value)
    # was i64, which is also the atomic default width.
    let dst: i32 = get_deref_store_type(s, arg)
    if dst != TYPE_VOID
        return dst
    TYPE_I64

# `<file>:<line>:<col>: error: <builtin name> <msg>` (AGAST #1879).
pub fn mem_builtin_error(s: *EmitterState, e: *Expr, msg: *u8)
    emit_str(s, c"  ; ERROR: memory builtin\n")
    diag_error_at(diag_source_file(), e.span)
    var i: i32 = 0
    while i < e.func_name_len
        eprint_char(*(e.func_name + i))
        i += 1
    eprints_cstr(c" ")
    eprints_cstr(msg)
    eprints_cstr(c"\n")
    s.error_count = s.error_count + 1

pub fn mem_int_type_bits(t: i32) -> i32
    if ty_int_bits(t) == 8
        return 8
    if ty_int_bits(t) == 16
        return 16
    if ty_int_bits(t) == 32
        return 32
    if ty_int_bits(t) == 64
        return 64
    0

# The type a memory builtin call evaluates to: the pointee for the
# value-returning ones, TYPE_VOID for the stores and fence.
fn mem_builtin_result_type(s: *EmitterState, e: *Expr, id: i32) -> i32
    if id == MEM_VOLATILE_STORE or id == MEM_ATOMIC_STORE or id == MEM_FENCE
        return TYPE_VOID
    mem_builtin_pointee(s, e.args)

pub fn synth_slot_ty(s: *EmitterState, e: *Expr) -> i32
    # Returns the Ritz type of an expression
    # AGAST #4404 (#1816): a literal's slot type is decided by the node
    # itself, so Sema annotates it (sema_walk -> sema_note_expr_ty) and the
    # emitter reads the annotation (expr_slot_ty) instead of keeping its own
    # copy of the rule.
    if e.kind == EXPR_INT_LIT or e.kind == EXPR_FLOAT_LIT or e.kind == EXPR_CHAR_LIT or e.kind == EXPR_STRING_LIT or e.kind == EXPR_CSTRING_LIT or e.kind == EXPR_NIL_LIT
        return expr_slot_ty(e)
    else if e.kind == EXPR_IDENT
        # AGAST #1325: locals first (they shadow globals), then globals.
        # This arm used to consult only the locals table, so a global
        # `var g: *i32` reported TYPE_I64 — find_local_type's miss value,
        # indistinguishable from a real i64 local.  Every caller that
        # branches on TYPE_PTR therefore skipped its pointer path for
        # globals, which made the global-pointee fallbacks in the OP_DEREF
        # arm below unreachable: `*(g + i)` fell through to the i64-load
        # default and read two i32 slots as one i64.  Stores were already
        # global-aware (get_deref_store_type), so the corruption was
        # load-side only and silent.
        let lidx: i32 = find_local_idx(s, e.ident_ptr, e.ident_len)
        if lidx >= 0
            let loc: *LocalVar = local_at(s, lidx)
            return loc.var_type
        let glob: *GlobalVarDef = find_global(s, e.ident_ptr, e.ident_len)
        if glob != null
            return glob.var_type
        # AGAST #2155: `const F: f64 = -1` is a double, not the i64 it folded to.
        var folded: i64 = 0
        let cft: i32 = const_int_init_float_ty(s, find_const_entry(s, e.ident_ptr, e.ident_len), @folded)
        if cft != 0
            return cft
        # AGAST #2176: so is `const G: f32 = 2.5`, an f32.
        let lft: i32 = const_float_lit_init_ty(find_const_entry(s, e.ident_ptr, e.ident_len))
        if lft != 0
            return lft
        return TYPE_I64
    else if e.kind == EXPR_INDEX
        # AGAST #2332: `a[i][j]` with `a: [N]*T` is a T.
        if is_array_elem_index(s, e) == 1
            return array_elem_pointee_kind(s, e.left)
        # AGAST #2440: what `*(p.data + i)` is.
        let through: *LocalVar = index_through(s, e)
        if through != null and through.array_base != null
            return through.pointee_type   # the element of `h.r[i]`, `g[i]`, `h(p)[i]` (#2329)
        if through != null
            var th: ThroughIndex
            index_through_fill(s, e, through, @th)
            return synth_slot_ty(s, @th.deref)
        # AGAST #2537: `(*r)[i]` with `r: **T` is a T, as `*(*r + i)` is.
        let dix: i32 = deref_index_elem(s, e)
        if dix != TYPE_VOID
            return dix
        # AGAST #2767: a full-rank `x[i][j]` over an N-D `[N][M]f32` / `f64`
        # (local, global or field) loads a `float` / `double`, as the 1-D
        # arms below say for `[N]f32`.  It fell to the i64 default, so a
        # literal beside it stayed a double (`fcmp double` on a `float`) and
        # `x[i][j] + 1.0` was stored as an i64.
        var nd_depth: i32 = 0
        let nd_sh: *ArrayShape = nd_index_shape(s, e, @nd_depth)
        if nd_sh != null and nd_depth == nd_sh.rank and (e.right == null or e.right.kind != EXPR_RANGE)
            if nd_sh.leaf_type == TYPE_F32 or nd_sh.leaf_type == TYPE_F64
                return nd_sh.leaf_type
            # AGAST #4428: a full-rank index over an N-D array of pointers is
            # that pointer (Sema's array view types it so).
            if nd_sh.leaf_type == TYPE_PTR or nd_sh.leaf_type == TYPE_PTR_PTR
                return nd_sh.leaf_type
        # Indexing: result type depends on base type.
        # AGAST #1328: resolve the base through locals THEN globals — the old
        # code only saw locals, and find_local_type's TYPE_I64 miss value made
        # a global pointer base look like an i64, so `g[i]` on `var g: *i32`
        # skipped both pointer branches and fell to the i64 default.
        if e.left.kind == EXPR_IDENT
            # AGAST #2321: as `a[i]` below.
            let ap: *LocalVar = array_ptr_index_base(s, e.left)
            if ap != null
                let ap_elem: i32 = ap.pointee_array_elem_type
                if ap_elem == TYPE_F32 or ap_elem == TYPE_F64
                    return ap_elem
                return TYPE_I64
            var base_type: i32 = find_local_type(s, e.left.ident_ptr, e.left.ident_len)
            var pointee: i32 = TYPE_UNKNOWN
            if base_type == TYPE_UNKNOWN
                let glob: *GlobalVarDef = find_global(s, e.left.ident_ptr, e.left.ident_len)
                if glob != null
                    base_type = glob.var_type
                    pointee = glob.pointee_type
            else
                pointee = find_local_pointee_type(s, e.left.ident_ptr, e.left.ident_len)
            if base_type == TYPE_PTR_PTR
                return TYPE_PTR  # **u8 indexed gives *u8
            else if base_type == TYPE_PTR
                # Element type of *T indexing is the pointee when recorded.
                # AGAST #1973: `p[i]` through a *f32 / *f64 loads a `float` /
                # `double`.
                if ty_is_int(pointee) == 1 or ty_is_float(pointee) == 1
                    return pointee
                return TYPE_U8   # *u8 (or unrecorded pointee) indexed gives u8
            else if base_type == TYPE_ARRAY
                # AGAST #1966: `loc[i]` over a local `[N]f32` / `[N]f64` loads
                # a `float` / `double` (local_array_elem_llvm); say so, or a
                # binop / compare over it picks the other operand's width.
                # AGAST #1970: likewise a global `[N]f32` / `[N]f64`
                # (global_array_elem_llvm).  (No range case: an array can't be
                # sliced, #2521.)
                let arr_loc: *LocalVar = find_local_struct_name(s, e.left.ident_ptr, e.left.ident_len)
                var arr_elem: i32 = TYPE_UNKNOWN
                if arr_loc != null
                    arr_elem = arr_loc.array_elem_type
                else
                    let arr_glob: *GlobalVarDef = find_global(s, e.left.ident_ptr, e.left.ident_len)
                    if arr_glob != null
                        arr_elem = arr_glob.array_elem_type
                if arr_elem == TYPE_F32 or arr_elem == TYPE_F64
                    return arr_elem
        else if e.left.kind == EXPR_MEMBER
            # AGAST #1954: `x.f[i]` over a `[N]f32` / `[N]f64` field (any
            # receiver depth, struct pointers included) loads a `float` /
            # `double` (field_array_elem_llvm) — the element's own type.
            let af: *StructField = member_field_def(s, e.left)
            if af != null and af.field_type == TYPE_ARRAY and (af.array_elem_type == TYPE_F32 or af.array_elem_type == TYPE_F64)
                return af.array_elem_type
            # AGAST #2053: `x.p[i]` through a `*f32` / `*f64` field loads a
            # `float` / `double` (ptr_field_elem_llvm) and is not widened.
            if af != null and af.field_type == TYPE_PTR
                let pk: i32 = ptr_field_elem_kind(af)
                if pk == TYPE_F32 or pk == TYPE_F64
                    return pk
        return TYPE_I64  # Default
    else if e.kind == EXPR_UNARY
        # AGAST #4404: these four are node-local; Sema annotates them.
        if e.op == OP_ADDR or e.op == OP_ADDR_MUT or e.op == OP_NOT or e.op == OP_BIT_NOT
            return expr_slot_ty(e)
        else if e.op == OP_DEREF
            # AGAST #2119: `*(@s as *i8)` / `*@g` load the stated pointee.
            let inl_pt: i32 = inline_deref_scalar_pointee(s, e.operand)
            if inl_pt != TYPE_VOID
                return inl_pt
            # AGAST #4249: `*(@a[0] + i)` / `*(@x - k)` load the base's
            # inline pointee too.  The ptr+offset arm below knows only an
            # ident / member / `*pp` base, so this loaded i64: 21_ls's
            # newline count over a `[N]u8` saw one line of six.
            if e.operand.kind == EXPR_BINARY and (e.operand.op == OP_ADD or e.operand.op == OP_SUB)
                let off_pt: i32 = inline_deref_scalar_pointee(s, find_base_expr(e.operand))
                if off_pt != TYPE_VOID
                    return off_pt
            # AGAST #2332: `*a[i]` / `*(a[i] + k)` with `a: [N]*T`.
            let el_pt: i32 = array_elem_pointee_kind(s, e.operand)
            if el_pt != TYPE_VOID
                return el_pt
            # AGAST #3186: `*X[i]` with `X` a `**T` loads a T, as
            # get_deref_store_type stores one.  It loaded i64.
            if e.operand.kind == EXPR_INDEX and e.operand.right != null and e.operand.right.kind != EXPR_RANGE
                let ix_pt: i32 = ptr_ptr_index_scalar(s, e.operand.left)
                if ix_pt != TYPE_VOID
                    return ix_pt
            # AGAST #1924: `*(ppp + i)` with `ppp: ***T` is itself a `**T`.
            # The arm below calls every deref of a `**` a `*T`, so the next
            # deref out lost the pointee and `*(*(*(ppp + i) + j) + k)`
            # loaded i64.
            var dl_inner: i32 = TYPE_VOID
            var dl_name: *u8 = null
            var dl_len: i32 = 0
            let dl_levels: i32 = ptr_levels_of(s, e, @dl_inner, @dl_name, @dl_len)
            if dl_levels >= 2
                return TYPE_PTR_PTR
            # AGAST #2376: `*a[i]` with `a: [N]**T` (or `*@a[i]` with `a: [N]*T`)
            # is a `*T`, so `**a[i]` reads its T below.  The element itself isn't
            # typed as a `**`.
            if dl_levels == 1 and elem_rooted(e.operand) == 1
                return TYPE_PTR
            let inner_type: i32 = synth_slot_ty(s, e.operand)
            if inner_type == TYPE_PTR_PTR
                return TYPE_PTR  # Deref **T gives *T
            else if inner_type == TYPE_PTR
                # Deref *T gives T - look up what T is
                # If operand is an identifier, look up its pointee type
                if e.operand.kind == EXPR_IDENT
                    let local_pt: i32 = find_local_pointee_type(s, e.operand.ident_ptr, e.operand.ident_len)
                    if local_pt != TYPE_I64
                        return local_pt
                    # Fall back to global pointee — without this, *(g_ptr)
                    # for a global *i32 reads as i64 (selfhost monomorph
                    # bug).
                    let glob: *GlobalVarDef = find_global(s, e.operand.ident_ptr, e.operand.ident_len)
                    if glob != null
                        return glob.pointee_type
                    return local_pt
                # If operand is ptr+offset, find base expression and get its pointee type
                else if e.operand.kind == EXPR_BINARY
                    let base: *Expr = find_base_expr(e.operand)
                    if base.kind == EXPR_IDENT
                        let lpt: i32 = find_local_pointee_type(s, base.ident_ptr, base.ident_len)
                        if lpt != TYPE_I64
                            return lpt
                        let glob: *GlobalVarDef = find_global(s, base.ident_ptr, base.ident_len)
                        if glob != null
                            return glob.pointee_type
                        return lpt
                    else if base.kind == EXPR_MEMBER
                        # Member+offset dereference (e.g., *(span.ptr + i))
                        return get_member_pointee_type(s, base)
                    # AGAST #1815: `*(*(pp + i) + k)` for `pp: **T`.
                    let bdpt: i32 = deref_ptr_ptr_elem_type(s, base)
                    if bdpt != TYPE_VOID
                        return bdpt
                # AGAST #1815: `**pp` / `*(*(pp + i))` for `pp: **T`.
                else if e.operand.kind == EXPR_UNARY
                    let udpt: i32 = deref_ptr_ptr_elem_type(s, e.operand)
                    if udpt != TYPE_VOID
                        return udpt
                # Bare member deref: `*param.name` where param.name is *u8
                # (selfhost-only bug — emit_impl_method's `is_self` check
                # `*param.name == 115` was loading i64 instead of i8 because
                # this branch defaulted to TYPE_I64).  Reuse the helper
                # already used for the member+offset path.
                else if e.operand.kind == EXPR_MEMBER
                    return get_member_pointee_type(s, e.operand)
                return TYPE_I64  # Default for unknown pointer dereference
            else if (inner_type == TYPE_MUT_REF or inner_type == TYPE_REF) and e.operand.kind == EXPR_IDENT
                # AGAST #1644: `*x` with `x: @&i32` loads the pointee's
                # width, as `*q` with `q: *i32` does.  Struct pointees are
                # resolved by name in the OP_DEREF arm before this is asked.
                # AGAST #2308: so does `x: @i32`, which loaded 8 bytes.
                let mr_pt: i32 = find_local_pointee_type(s, e.operand.ident_ptr, e.operand.ident_len)
                if mr_pt != TYPE_STRUCT
                    return mr_pt
                return TYPE_I64
            else
                return TYPE_I64  # Deref *T gives value
        return synth_slot_ty(s, e.operand)
    else if e.kind == EXPR_BINARY
        # AGAST #1965: float arithmetic is computed at binop_float_width
        # (`y * 2.0` is f32, `y * x` with `x: f64` is f64), not the left type.
        # AGAST #3817: `%` too, or `y % x` read as f32 was fpext'd again.
        if e.op == OP_ADD or e.op == OP_SUB or e.op == OP_MUL or e.op == OP_DIV or e.op == OP_MOD
            let bw: i32 = binop_float_width(s, e)
            if bw != 0
                return bw
        # AGAST #3931: a comparison is a bool whatever its operands, held in
        # the emitter's bool slot, TYPE_I64 (#1646), as Sema's sema_expr_ty
        # types it TYPE_BOOL.  Sema annotates the slot (AGAST #4404).
        if e.op >= OP_EQ and e.op <= OP_GE
            return expr_slot_ty(e)
        return synth_slot_ty(s, e.left)  # Binary ops preserve left type (simplified)
    else if e.kind == EXPR_MEMBER
        # Look up the field type through the whole receiver chain.  Without
        # nesting, get_expr_type returns TYPE_I64 for `e.left.ident_ptr`, so
        # the surrounding OP_DEREF on `*(e.left.ident_ptr + i)` falls to the
        # i64-load default (selfhost static-method dispatch read 8 bytes
        # instead of 1).  Handled only `l.f` / `l.m.f` until AGAST #1673.
        let mfield: *StructField = member_field_def(s, e)
        if mfield != null
            return mfield.field_type
        return TYPE_I64  # Default for unknown member access
    else if e.kind == EXPR_CALL
        # AGAST #1879: volatile / atomic builtins return their pointee type.
        let mem_id: i32 = mem_builtin_id(e.func_name, e.func_name_len)
        if mem_id != 0
            return mem_builtin_result_type(s, e, mem_id)
        # AGAST #3995: a user-enum variant ctor `One(3)` / `Rect(3, 4)` is
        # its enum, as emit_expr_call builds it ahead of any fn of the name.
        var uen: *u8 = null
        var uen_len: i32 = 0
        user_enum_ctor_call(e, @uen, @uen_len)
        if uen != null
            return TYPE_STRUCT
        # Look up function return type
        # Build full function name with type suffix if generic
        let fn_def: *FnDef = find_call_fn(s, e)
        if fn_def != null
            return fn_def.return_type

        return TYPE_I64  # Default for unknown functions
    else if e.kind == EXPR_CAST
        # Target type stored in e.op (set by expr_cast helper); Sema
        # annotates it (AGAST #4404).
        return expr_slot_ty(e)
    else if e.kind == EXPR_METHOD
        # AGAST #1370: `x.ceil()` on an f32 is an f32 (a `float` register),
        # so `let y = x.ceil()` infers f32 and `x.floor() + 0.5` is f32 math.
        let fmt: i32 = float_method_result_ty(s, e)
        if fmt != 0
            return fmt
        # AGAST #2068: a user method's f32 / f64 return.
        let umt: i32 = user_method_float_ret(s, e)
        if umt != 0
            return umt
    TYPE_I64  # Default fallback

# Get the struct type name for a dereference expression that returns TYPE_STRUCT
# Returns the field info if found, null otherwise
# NOTE: Disabled due to parser bug where primitive pointer types have stale type_name values
fn get_deref_struct_type(s: *EmitterState, e: *Expr) -> *StructField
    # For now, always return null until parser properly tracks pointee types
    # TODO: Enable this once parser is fixed
    null

# =============================================================================
# Field type emission (used by emit_expr member access and module-level struct emission)
# =============================================================================

pub fn emit_field_llvm_type(s: *EmitterState, f: *StructField)
    let prim: *u8 = ty_mem_llvm(f.field_type)
    if prim != null
        emit_str(s, prim)
    else if f.field_type == TYPE_STRUCT
        # Primitive types parsed as struct names (parser has no dedicated
        # tokens) — route through emit_llvm_type_struct for consistent
        # mapping (f32 -> float, u16 -> i16, etc.).
        emit_llvm_type_struct(s, TYPE_STRUCT, f.field_type_name, f.field_type_name_len)
    else if f.field_type == TYPE_ARRAY and f.array_shape != null
        # AGAST #2097: `m: [2][3]i32` is `[2 x [3 x i32]]`, ritz0's ABI.
        emit_array_shape_llvm(s, f.array_shape, 0)
    else if f.field_type == TYPE_ARRAY
        # Emit array type: [N x elem_type]
        emit_str(s, c"[")
        emit_int(s, f.array_size as i64)
        emit_str(s, c" x ")
        if f.array_elem_type == TYPE_STRUCT and is_simd_vector_type_name(f.array_elem_type_name, f.array_elem_type_name_len) == 1
            # AGAST #3656: `[8]v4i64` is `[8 x <4 x i64>]`; no `%v4i64`
            # type is declared, so `%v4i64` would not assemble.
            emit_simd_vector_type(s, f.array_elem_type_name, f.array_elem_type_name_len)
        else if f.array_elem_type == TYPE_STRUCT
            # Emit struct type reference: %StructName
            emit_str(s, c"%")
            emit_name(s, f.array_elem_type_name, f.array_elem_type_name_len)
        else
            emit_str(s, elem_mem_llvm(f.array_elem_type))
        emit_str(s, c"]")
    else
        emit_str(s, c"i64")
