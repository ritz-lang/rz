# ritz1/src/field_slot.ritz - a struct-literal field given a struct of another type
#
# AGAST #3563.  LARB R49: only a `"..."` literal fits a `Span<u8>` slot; a
# StrView value never converts.  #3441 refused it at a let, an argument, a
# return and a tail (let_check.ritz another_struct_source); a struct-literal
# field took it, and ritz1 stored the StrView's bytes into the field:
#
#     struct H
#         s: Span<u8>
#     fn f(v: StrView) -> H
#         H { s: v }       # error: field `s` of `H` is `Span<u8>`, not `StrView`
#
# Any known struct of another type than the field's is refused the same way,
# at the value.  ritz0 gives the same words (emitter_llvmlite.py
# _emit_struct_lit_field).  A `Span<u8>` into a `StrView` field converts
# (#168), and a value Sema can't type is left to the emitter.

import ritzlib.sys
import ritzlib.io

import ast
import ast_helpers
import emitter_core
import sema
import sema_type

# Check every field of struct literal `e`, and of the literals nested in it.
pub fn struct_lit_field_check(sm: *Sema, e: *Expr)
    if e == null or e.kind != EXPR_STRUCT_LIT
        return
    let st: *StructDef = sema_find_struct(sm, e.ident_ptr, e.ident_len)
    var fi: *FieldInit = e.args as *FieldInit
    while fi != null
        if st != null
            let idx: i32 = find_field_index(st, fi.name, fi.name_len)
            if idx >= 0
                field_slot_check(sm, st, get_field_type(st, idx), fi.value)
        struct_lit_field_check(sm, fi.value)
        fi = fi.next

fn field_slot_check(sm: *Sema, st: *StructDef, f: *StructField, value: *Expr)
    if value == null or f.field_type != TYPE_STRUCT
        return
    # A `"..."` takes its slot's type: Sema says StrView, but it fits a
    # `Span<u8>` field (R49, R62).
    if value.kind == EXPR_STRING_LIT
        return
    var t: SemaTy
    if sema_expr_ty(sm, value, @t) != TYPE_STRUCT
        return
    if name_eq(t.name, t.name_len, f.field_type_name, f.field_type_name_len) == 1
        return
    if is_layout_equiv_pair(t.name, t.name_len, f.field_type_name, f.field_type_name_len) == 1 and name_eq(t.name, t.name_len, c"StrView", 7) == 0
        return
    # An enum, an alias, or a generic's parameter isn't a struct here.
    if sema_find_struct(sm, t.name, t.name_len) == null or sema_find_struct(sm, f.field_type_name, f.field_type_name_len) == null
        return
    sema_error_at(sm, value.span.line, value.span.col)
    eprints_cstr(c"field `")
    eprint_bytes(f.name, f.name_len)
    eprints_cstr(c"` of `")
    eprint_bytes(st.name, st.name_len)
    eprints_cstr(c"` is `")
    eprint_source_type(f.field_type_name, f.field_type_name_len)
    eprints_cstr(c"`, not `")
    eprint_bytes(t.name, t.name_len)
    eprints_cstr(c"`\n")

# A mangled one-argument instance `A$B` as ritz0 spells it, `A<B>`; any other
# name as it is (a `$`-joined list can't say where each argument ends).
fn eprint_source_type(name: *u8, len: i32)
    var dollar: i32 = -1
    var i: i32 = 0
    while i < len
        if name[i] == '$'
            if dollar >= 0
                eprint_bytes(name, len)
                return
            dollar = i
        i += 1
    if dollar <= 0
        eprint_bytes(name, len)
        return
    eprint_bytes(name, dollar)
    eprint_char('<')
    eprint_bytes(name + dollar + 1, len - dollar - 1)
    eprint_char('>')
