# ritz1/src/field_slot.ritz - a struct-literal field given a struct of another type
#
# AGAST #3563.  LARB R49: only a `"..."` literal fits a `Span<u8>` slot; a
# StrView value never converts, nor a `Span<u8>` value to a StrView (#3564).  #3441 refused it at a let, an argument, a
# return and a tail (let_check.ritz another_struct_source); a struct-literal
# field took it, and ritz1 stored the StrView's bytes into the field:
#
#     struct H
#         s: Span<u8>
#     fn f(v: StrView) -> H
#         H { s: v }       # error: field `s` of `H` is `Span<u8>`, not `StrView`
#
# Any known struct of another type than the field's is refused the same way,
# at the value.  ritz0 gives the same words (emitter_llvmlite.py
# _emit_struct_lit_field).  A `Span<u8>` into a `StrView` field converts
# (#168), and a value Sema can't type is left to the emitter.

import ritzlib.sys
import ritzlib.io

import ast
import ast_helpers
import ast_query   # name_eq & co., off emitter_core (AGAST #3513)
import sema
import sema_type

# Check every field of struct literal `e`, and of the literals nested in it.
pub fn struct_lit_field_check(sm: *Sema, e: *Expr)
    if e == null or e.kind != EXPR_STRUCT_LIT
        return
    let st: *StructDef = sema_find_struct(sm, StrView { ptr: (e.ident_ptr), len: (e.ident_len) as i64 })
    var fi: *FieldInit = e.args as *FieldInit
    while fi != null
        if st != null
            let idx: i32 = find_field_index(st, StrView { ptr: (fi.name), len: (fi.name_len) as i64 })
            if idx >= 0
                field_slot_check(sm, st, get_field_type(st, idx), fi.value)
        struct_lit_field_check(sm, fi.value)
        fi = fi.next

fn field_slot_check(sm: *Sema, st: *StructDef, f: *StructField, value: *Expr)
    if value == null or f.field_type != TYPE_STRUCT
        return
    # A `"..."` takes its slot's type: Sema says StrView, but it fits a
    # `Span<u8>` field (R49, R62).
    if value.kind == EXPR_STRING_LIT
        return
    var t: SemaTy
    if sema_expr_ty(sm, value, @t) != TYPE_STRUCT
        return
    if name_eq(StrView { ptr: (t.name), len: (t.name_len) as i64 }, StrView { ptr: (f.field_type_name), len: (f.field_type_name_len) as i64 }) == 1
        return
    # Nor does a `Span<u8>` value fit a StrView field (#3564): Sema types a
    # local bound to a `"..."` as the StrView it is.
    # An enum, an alias, or a generic's parameter isn't a struct here.
    if sema_find_struct(sm, StrView { ptr: (t.name), len: (t.name_len) as i64 }) == null or sema_find_struct(sm, StrView { ptr: (f.field_type_name), len: (f.field_type_name_len) as i64 }) == null
        return
    sema_error_at(sm, value.span.line, value.span.col)
    eprints_cstr(c"field `")
    eprint_bytes(StrView { ptr: (f.name), len: (f.name_len) as i64 })
    eprints_cstr(c"` of `")
    eprint_bytes(StrView { ptr: (st.name), len: (st.name_len) as i64 })
    eprints_cstr(c"` is `")
    eprint_source_type(StrView { ptr: (f.field_type_name), len: (f.field_type_name_len) as i64 })
    eprints_cstr(c"`, not `")
    eprint_bytes(StrView { ptr: (t.name), len: (t.name_len) as i64 })
    eprints_cstr(c"`\n")

# A field's type as ritz0 spells it: the built-in `Span$B` as written,
# `Span<B>`; any other name as it is.  ritz0 names a program's own generic
# instance mangled, `Box2$u8` (AGAST #3428), and a `$`-joined list can't say
# where each argument ends anyway.
fn eprint_source_type(name_sv: StrView)
    var name: *u8 = name_sv.ptr
    var len: i32 = name_sv.len as i32
    if len < 5 or name_eq(StrView { ptr: (name), len: (5) as i64 }, StrView { ptr: (c"Span$"), len: (5) as i64 }) == 0
        eprint_bytes(StrView { ptr: (name), len: (len) as i64 })
        return
    var dollar: i32 = -1
    var i: i32 = 0
    while i < len
        if name[i] == '$'
            if dollar >= 0
                eprint_bytes(StrView { ptr: (name), len: (len) as i64 })
                return
            dollar = i
        i += 1
    if dollar <= 0
        eprint_bytes(StrView { ptr: (name), len: (len) as i64 })
        return
    eprint_bytes(StrView { ptr: (name), len: (dollar) as i64 })
    eprint_char('<')
    eprint_bytes(StrView { ptr: (name + dollar + 1), len: (len - dollar - 1) as i64 })
    eprint_char('>')
