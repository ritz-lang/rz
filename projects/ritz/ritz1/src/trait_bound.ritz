# trait_bound.ritz - trait bounds `<T: A + B>`, checked on Sema
#
# LANGUAGE_SPEC §11.5, LARB R55, AGAST #3469 (ritz0's half: #3468,
# ritz0/trait_bounds.py).  A type parameter of a fn, struct, enum or impl may
# name the traits it needs.  A bound is a check only: it doesn't change how a
# method on `T` is found (that happens after substitution, §11.4).  Two rules,
# each located, with ritz0's messages:
#
#   * An unknown trait is an error at the bound, used or not:
#       unknown trait `Nonesuch` in the bound on `U`
#   * Each instance's type arguments need an impl of each trait, exact
#     (`impl Area for Sq`) or through a generic impl (`impl<T> Drop for
#     Box<T>` covers every `Box<..>`, with that impl's own bounds on its
#     args), else an error at the type argument as first written, or at the
#     call when the arguments were inferred:
#       `Nope` doesn't implement `Area`, which `T` of `total` requires
#     An impl's bounds are on its type's args, named `impl W`.
#
# The instances are monomorph's trackers, so every instance is judged,
# inferred or transitive.  Where one was first written comes from
# ast_helpers' GenericUse notes; a transitive instance (`total<U>` inside
# another generic) is at that call's argument, as ritz0 reports it.

import ritzlib.cstr
import ritzlib.io
import ritzlib.memory
import ritzlib.str
import ritzlib.sys

import ast
import ast_helpers
import diag
import monomorph
import sema

fn tb_eq(a: StrView, b: StrView) -> i32
    if a.len != b.len
        return 0
    (memcmp(a.ptr, b.ptr, a.len) == 0) as i32

fn tb_write(s: StrView)
    sys_write(2, s.ptr, s.len)

fn tb_file(sm: *Sema, file: StrView) -> StrView
    if file.len == 0
        return sm.file
    file

fn tb_dollar(s: StrView) -> i32
    var k: i32 = 0
    while k < s.len and s.get(k) != '$'   # '$'
        k = k + 1
    k

fn tb_has_bounds(tps: *TypeParam) -> i32
    var tp: *TypeParam = tps
    while tp != null
        if tp.bounds != null
            return 1
        tp = tp.next
    0

# ----------------------------------------------------------------------------
# Unknown traits, at the bound
# ----------------------------------------------------------------------------

fn tb_trait_known(ctx: *ParseCtx, name_sv: StrView) -> i32
    if trait_declared(ctx, name_sv) == 1 or is_compiler_trait(name_sv) == 1
        return 1
    0

fn tb_unknown_in(sm: *Sema, tps: *TypeParam)
    var tp: *TypeParam = tps
    while tp != null
        var b: *TraitBound = tp.bounds
        while b != null
            if tb_trait_known(sm.pctx, b.name) == 0
                diag_error_at(tb_file(sm, b.file), b.span)
                eprints("unknown trait `")
                tb_write(b.name)
                eprints("` in the bound on `")
                tb_write(tp.name)
                eprints("`\n")
                sm.error_count = sm.error_count + 1
            b = b.next
        tp = tp.next

fn tb_unknown_check(sm: *Sema)
    let m: *Module = sm.module
    var f: *FnDef = m.functions
    while f != null
        tb_unknown_in(sm, f.type_params)
        f = f.next
    var st: *StructDef = m.structs
    while st != null
        tb_unknown_in(sm, st.type_params)
        st = st.next
    for ei in 0..enum_count(sm.pctx)
        if enum_is_generic(sm.pctx, ei) == 1
            tb_unknown_in(sm, generic_enum_params(sm.pctx, ei))
    var ib: *ImplBlock = m.impls
    while ib != null
        tb_unknown_in(sm, ib.type_params)
        ib = ib.next

# ----------------------------------------------------------------------------
# Which types implement which traits
# ----------------------------------------------------------------------------

# The `n` arguments of an instance's suffix `$a1$a2..`, each as a
# one-argument suffix `$ai` (split_mangled_args).  One parameter takes the
# whole suffix (`Bag$Bag$Nope`), as monomorph's own split does.  Returns the
# count, or -1 when the suffix doesn't split into `n`.
fn tb_split(ctx: *ParseCtx, m: *Module, n: i32, suffix_sv: StrView, starts: *i32, lens: *i32) -> i32
    var suffix_len: i32 = suffix_sv.len as i32
    if n == 1
        *starts = 0
        *lens = suffix_len
        return 1
    if split_mangled_args(ctx, m, suffix_sv, starts, lens) != n
        return -1
    n

# A bound an instance misses: type parameter `param` (its index) and the
# bound of it its argument doesn't implement.
struct UnmetBound
    param: i32
    bound: *TraitBound

# The first bound of `tps` that the args of `suffix` miss; None when every
# bound is met or the suffix doesn't split.
fn tb_unmet(ctx: *ParseCtx, m: *Module, tps: *TypeParam, suffix_sv: StrView) -> Option<UnmetBound>
    let n: i32 = count_type_params(tps)
    if n == 0 or tb_has_bounds(tps) == 0
        return None
    let cap: i64 = 4 * (mangled_arg_capacity(suffix_sv) + 1) as i64
    let starts: *i32 = malloc(cap) as *i32
    let lens: *i32 = malloc(cap) as *i32
    var miss: Option<UnmetBound> = None
    if tb_split(ctx, m, n, suffix_sv, starts, lens) == n
        var tp: *TypeParam = tps
        var i: i32 = 0
        while tp != null and miss.is_none()
            # Skip the `$` each argument's suffix starts with.
            let arg: StrView = mangled_arg(suffix_sv, starts, lens, i).skip(1)
            var b: *TraitBound = tp.bounds
            while b != null and miss.is_none()
                if tb_implements(ctx, m, arg, b.name) == 0
                    miss = Some(UnmetBound { param: i, bound: b })
                b = b.next
            tp = tp.next
            i = i + 1
    free(starts as *u8)
    free(lens as *u8)
    miss

# Does the type `arg` (mangled: `Sq`, `Bag$Sq`, `ptr_Sq`) implement `trait`?
# Exactly, by a non-generic impl for its name, or through a generic impl of
# its generic type whose own bounds its args meet (§12.2: an impl covers
# every instantiation).  A pointer, reference, array or primitive has none.
fn tb_implements(ctx: *ParseCtx, m: *Module, arg: StrView, tname_sv: StrView) -> i32
    let k: i32 = tb_dollar(arg)
    var ib: *ImplBlock = m.impls
    while ib != null
        if ib.trait_name.ptr != null and tb_eq(ib.trait_name, tname_sv) == 1 and tb_eq(ib.type_name, arg.take(k)) == 1
            if k == arg.len and ib.type_params == null
                return 1
            if k < arg.len and ib.type_params != null
                if tb_unmet(ctx, m, ib.type_params, arg.skip(k)).is_none()
                    return 1
                return 0
        ib = ib.next
    0

# ----------------------------------------------------------------------------
# Spelling a mangled type as written: `Bag$Nope` is `Bag<Nope>`
# ----------------------------------------------------------------------------

fn tb_eprint_type(ctx: *ParseCtx, m: *Module, s: StrView)
    if s.len > 7 and s.starts_with("refmut_")
        eprints("@&")
        tb_eprint_type(ctx, m, s.skip(7))
        return
    if s.len > 4 and s.starts_with("ref_")
        eprint_char('@')
        tb_eprint_type(ctx, m, s.skip(4))
        return
    if s.len > 4 and s.starts_with("ptr_")
        eprint_char('*')
        tb_eprint_type(ctx, m, s.skip(4))
        return
    let k: i32 = tb_dollar(s)
    tb_write(s.take(k))
    if k >= s.len
        return
    let arity: i32 = mangled_component_arity(ctx, m, s.take(k))
    if arity <= 0
        tb_write(s.skip(k))   # no template to say how it nests
        return
    let cap: i64 = 4 * (mangled_arg_capacity(s.skip(k)) + 1) as i64
    let starts: *i32 = malloc(cap) as *i32
    let lens: *i32 = malloc(cap) as *i32
    if tb_split(ctx, m, arity, s.skip(k), starts, lens) != arity
        tb_write(s.skip(k))
    else
        eprint_char('<')
        for i in 0..arity
            if i > 0
                eprints(", ")
            tb_eprint_type(ctx, m, s.skip(k + *(starts + i) + 1).take(*(lens + i) - 1))
        eprint_char('>')
    free(starts as *u8)
    free(lens as *u8)

# ----------------------------------------------------------------------------
# One instance
# ----------------------------------------------------------------------------

# Is the instance's argument still a parameter (`W$T`, a template's own
# spelling of its type, or `total$U` inside another generic)?  Such a
# spelling is no instance: the one its parameters become is judged.
fn tb_has_free_param(ctx: *ParseCtx, m: *Module, suffix: StrView) -> i32
    var pos: i32 = 0
    while pos < suffix.len
        var end: i32 = pos + 1
        while end < suffix.len and suffix.get(end) != '$'
            end = end + 1
        var c: StrView = suffix.skip(pos + 1).take(end - pos - 1)
        # The name under `ptr_` / `ref_` / `refmut_` / `arrN_` pieces.
        var j: i32 = (c.len as i32) - 1
        while j >= 0 and c.get(j) != '_'   # '_'
            j = j - 1
        c = c.skip(j + 1)
        if c.len > 0 and c.get(0) >= 'A' and c.get(0) <= 'Z' and module_declares_type(ctx, m, c) == 0 and find_generic_struct(m, c) == null and trait_declared(ctx, c) == 0
            return 1
        pos = end
    0

# A transitive instance (`total$Nope` from `outer<Nope>`'s `total<U>(x)`) was
# never written as such: its first use is the generic one, `total<U>`, whose
# argument ritz0 reports at too (its monomorph substitutes into that call).
fn tb_use_in_generic(ctx: *ParseCtx, m: *Module, name_sv: StrView) -> *GenericUse
    var found: *GenericUse = null
    var u: *GenericUse = generic_use_list(ctx)
    while u != null
        if tb_eq(u.name, name_sv) == 1 and tb_has_free_param(ctx, m, u.suffix) == 1
            found = u
        u = u.next
    found

# Judge one instance `name` + `suffix` of a generic whose parameters are
# `tps`, named `owner` (with `impl ` before it when `is_impl`).  Reports the
# first unmet bound; returns 1 if it did.
fn tb_check_instance(sm: *Sema, owner_sv: StrView, is_impl: i32, tps: *TypeParam, name_sv: StrView, suffix_sv: StrView) -> i32
    let m: *Module = sm.module
    if tb_has_bounds(tps) == 0 or tb_has_free_param(sm.pctx, m, suffix_sv) == 1
        return 0
    var i: i32 = 0
    var bound: *TraitBound = null
    match tb_unmet(sm.pctx, m, tps, suffix_sv)
        Some(ub) =>
            i = ub.param
            bound = ub.bound
        None =>
            return 0
    var tp: *TypeParam = tps
    for k in 0..i
        tp = tp.next
    # Where: the argument as first written, else the inferred call; for a
    # transitive instance the generic call it came from; else the bound.
    var file: StrView = bound.file
    var at: SrcSpan = bound.span
    var u: *GenericUse = generic_use_first(sm.pctx, name_sv, suffix_sv)
    if u == null
        u = tb_use_in_generic(sm.pctx, m, name_sv)
    if u != null
        var ga: *GenericArg = u.args
        for k in 0..i
            if ga != null
                ga = ga.next
        if ga != null and ga.at.line > 0
            file = u.file
            at = ga.at
        else if u.at.line > 0
            file = u.file
            at = u.at
    let cap: i64 = 4 * (mangled_arg_capacity(suffix_sv) + 1) as i64
    let starts: *i32 = malloc(cap) as *i32
    let lens: *i32 = malloc(cap) as *i32
    tb_split(sm.pctx, m, count_type_params(tps), suffix_sv, starts, lens)
    diag_error_at(tb_file(sm, file), at)
    eprint_char('`')
    tb_eprint_type(sm.pctx, m, mangled_arg(suffix_sv, starts, lens, i).skip(1))
    eprints("` doesn't implement `")
    tb_write(bound.name)
    eprints("`, which `")
    tb_write(tp.name)
    eprints("` of `")
    if is_impl == 1
        eprints("impl ")
    tb_write(owner_sv)
    eprints("` requires\n")
    sm.error_count = sm.error_count + 1
    free(starts as *u8)
    free(lens as *u8)
    1

fn tb_generic_fn(m: *Module, name_sv: StrView) -> *FnDef
    var f: *FnDef = m.functions
    while f != null
        if f.type_params != null and tb_eq(f.name, name_sv) == 1
            return f
        f = f.next
    null

# A generic type's instance: its own bounds, then each generic impl's.
fn tb_check_type_instance(sm: *Sema, tps: *TypeParam, name_sv: StrView, suffix_sv: StrView)
    if tps != null and tb_check_instance(sm, name_sv, 0, tps, name_sv, suffix_sv) == 1
        return
    var ib: *ImplBlock = sm.module.impls
    while ib != null
        if ib.type_params != null and tb_eq(ib.type_name, name_sv) == 1
            if tb_check_instance(sm, name_sv, 1, ib.type_params, name_sv, suffix_sv) == 1
                return
        ib = ib.next

pub fn trait_bound_check(mono: *MonoCtx, sm: *Sema)
    let before: i32 = sm.error_count
    tb_unknown_check(sm)
    if sm.error_count > before
        return
    let m: *Module = sm.module
    for i in 0..get_struct_instantiation_count(mono)
        let name_sv: StrView = get_struct_instantiation_name(mono, i)
        var tps: *TypeParam = null
        let st: *StructDef = find_generic_struct(m, name_sv)
        if st != null
            tps = st.type_params
        tb_check_type_instance(sm, tps, name_sv, get_struct_instantiation_suffix(mono, i))
    # A generic enum's instances (`Slot$Nope`) are recorded as enums.
    for ei in 0..enum_count(sm.pctx)
        let ename: StrView = enum_name_at(sm.pctx, ei)
        let k: i32 = tb_dollar(ename)
        if (k as i64) < ename.len
            let base_sv: StrView = ename.take(k as i64)
            let base: i32 = enum_find(sm.pctx, base_sv)
            if base >= 0 and enum_is_generic(sm.pctx, base) == 1
                tb_check_instance(sm, base_sv, 0, generic_enum_params(sm.pctx, base), base_sv, ename.skip(k as i64))
    for i in 0..get_instantiation_count(mono)
        let name_sv: StrView = get_instantiation_name(mono, i)
        let f: *FnDef = tb_generic_fn(m, name_sv)
        if f != null
            tb_check_instance(sm, name_sv, 0, f.type_params, name_sv, get_instantiation_suffix(mono, i))
