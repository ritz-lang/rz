# ritz1/src/struct_cast.ritz - `as` between two structs is a located refusal
#
# LARB R72 (AGAST #4000, #3012).  LANGUAGE_SPEC §7.5: `as` doesn't convert
# between two struct types, by value or through a reference, even when their
# fields match: build the other struct from the fields.
#
#     struct C
#         x: i32
#     struct D
#         x: i32
#     fn f(r: @C) -> i32
#         let d: D = r as D     # error: build `D { x: r.x }`
#         d.x
#
# ritz0 refuses this in its emitter; ritz1 lowered it instead -- `store %D
# <%C reg>` by value, `store %D <i64>` through a reference -- and clang
# refused the IR.  The rule is a check, so it runs on Sema (sema_walk calls
# struct_cast_check on every EXPR_CAST), before emission.
#
# What R72 leaves legal stays accepted:
#   - `r as C` with `r` an `@C`, `@&C` or `*C`: a copy of the referent (§13,
#     AGAST #3004).  The source is the struct behind the reference, and its
#     name is C's, so the names match below.
#   - `@c as *D`: a pointer cast.  Its target is TYPE_PTR, not a struct, so
#     this check never sees it.
#   - `p as *D` with `p: *C`: likewise a pointer re-typed.
#
# One-sided, as the other Sema rules are: only a source Sema can name is
# judged.  A missed refusal is a parity gap with ritz0; a false one would
# refuse a valid program.

import ritzlib.io

import ast
import ast_query   # name_eq, eprint_bytes (AGAST #3513)
import sema
import sema_type

# 1 when `kind` is a reference or a pointer, whose struct (if any) is its
# `pointee`.  The emitter's val.type.pointee test in ritz0.
fn sc_is_indirect(kind: i32) -> i32
    (kind == TYPE_PTR or kind == TYPE_REF or kind == TYPE_MUT_REF) as i32

# `as` to a struct by value, from a different struct or from a reference or
# pointer to one: refuse at the `as`, in ritz0's words.
pub fn struct_cast_check(sm: *Sema, e: *Expr)
    if e == null or e.kind != EXPR_CAST
        return
    # The target must be a struct by value: `as *D` / `as @D` re-type a
    # pointer and are not this rule.
    if e.op != TYPE_STRUCT or e.ident_ptr == null or e.ident_len == 0
        return
    if sema_find_struct(sm, e.ident_ptr, e.ident_len) == null
        return
    # The source, as ritz0 reads val.type: a struct is itself, an `@T` / `*T`
    # is what it points at.  Anything Sema can't name is left alone.
    var src: SemaTy
    let k: i32 = sema_expr_ty(sm, e.left, @src)
    var inner: i32 = k
    if sc_is_indirect(k) == 1
        inner = src.pointee
    if inner != TYPE_STRUCT or src.name == null or src.name_len == 0
        return
    if sema_find_struct(sm, src.name, src.name_len) == null
        return
    # `r as C` reads a copy of the referent: same struct, so not this rule.
    if name_eq(src.name, src.name_len, e.ident_ptr, e.ident_len) == 1
        return
    # Located at the `as` (AGAST #3040 records it on the cast node), else at
    # the expression's start.
    var line: i32 = e.span.line
    var col: i32 = e.span.col
    if e.bracket.line > 0
        line = e.bracket.line
        col = e.bracket.col
    sema_error_at(sm, line, col)
    eprints("cannot cast `")
    eprint_bytes(src.name, src.name_len)
    eprints("` to `")
    eprint_bytes(e.ident_ptr, e.ident_len)
    eprints("`: `as` doesn't convert between structs: build a `")
    eprint_bytes(e.ident_ptr, e.ident_len)
    eprints("` from the fields\n")
