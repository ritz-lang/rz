# ritz1/src/sema_walk.ritz - the Sema pass: walk the module, run the checks
#
# AGAST #3462 (#1816).  sema_check_module is main's checking phase, between
# monomorphisation and emit_module; see sema.ritz.  A new check is a call
# from here into a `*_check(sm: *Sema, ..)` fn, never from the emitter.
#
# Layout (AGAST #3904): every #1816 room adds an import and calls here, so
# keep two rooms' additions from abutting, which is what makes git conflict.
# The project imports are one per line, in name order, each in its own
# paragraph: a new one goes at its sorted place.  Each check's call (with its
# `if` guard) is its own paragraph: a new call is a new paragraph, placed
# where its order against the others needs it.  The calls' order is the order
# their errors are reported in, so moving one changes output.
# test_ritz1_sema_walk_layout.py holds the file to this.
#
# The walk visits what binder_check visits: every statement list (fn body,
# if / else, while, for, loop, unsafe, defer, match and if-expression arms)
# and the match / if expressions in a statement's value.  parser_alloc does
# not zero the fields one statement kind leaves unset, so only the fields
# each kind sets are read.
#
# It binds each local with its declared type (AGAST #3501): a param's (a `:&
# S` param's struct S), a `let` / `var`'s annotation or else its initialiser's
# sema_expr_ty, a `for` variable an element of what it iterates, a `V(x)` arm
# binding V's payload and a `let (a, b)` binding its field (AGAST #3810).  A
# range's `for` variable, a catch-all arm binding and a scalar `:&` param are
# bound TypeKind.Unknown.  It visits every sub-expression of a statement, so
# RITZ1_SEMA_PROBE (sema_probe.ritz) can pin sema_expr_ty against the
# emitter's typing on each.

import ritzlib.cstr
import ritzlib.hash
import ritzlib.hashmap
import ritzlib.io
import ritzlib.memory
import ritzlib.str
import ritzlib.sys

import ast

import ast_helpers

import ast_query   # name_eq & co., off emitter_core (AGAST #3513)

import bool_check

import call_check   # AGAST #1629, on Sema since #3503

import deref_field   # `.` through Deref (AGAST #3015 / #3509)

import diag   # the located error prefix (AGAST #3445)

import discarded_array   # AGAST #3189, on Sema since #3512

import enum_as_int   # AGAST #2136, on Sema since #3511

import field_slot

import float_compare

import float_slot   # pointer into a float (AGAST #3626, on Sema since #3892)

import fn_slot   # a fn value fits its fn-typed slot (AGAST #4310)

import generic_method

import if_arm_value   # AGAST #1613, on Sema since #3512

import import_vis   # AGAST #3891

import index_refuse   # §7.8 / R9's index refusals (AGAST #3893)

import intrinsic_check   # x86 / SIMD intrinsics' arity and operands (AGAST #4657)

import let_check   # AGAST #2028 / #3504

import literal_slot   # AGAST #2341, on Sema since #3510

import monomorph   # MonoCtx: trait_bound reads its instances (AGAST #4454)

import must_use

import narrowing   # check_implicit_narrowing (AGAST #3505)

import no_effect   # a statement with no effect (LARB R64, AGAST #3492)

import own_check   # the move check (AGAST #2158), on Sema since #3507

import pass_value   # AGAST #3740, #3759

import ptr_arith   # `*T ± int`, `*T - *T` and nothing else (§7.1, AGAST #4657)

import ref_loan   # §13.5 borrow conflicts (AGAST #2438), on Sema since #3506

import ref_value   # `@T` read-only, return-of-local (AGAST #3926)

import sema

import sema_index_store

import sema_probe

import sema_type

import slot_kind   # a value's kind in its slot (AGAST #4653)

import slot_narrowing   # assignment, argument, return (#4081), struct field (#4218)

import struct_cast   # `as` between two structs (LARB R72, AGAST #4000)

import tail_value   # AGAST #2236, on Sema since #3511

import trait_bound   # §11.5 trait bounds (AGAST #3469)

import wrapping   # `+%` / `-%` / `*%` integer operands (LARB R63, AGAST #3486)

# AGAST #3891: a use, in the input's own code, of a name that reaches the
# input only through some module's plain `import` (import_vis.ritz).  A
# generic's `$` suffix (`Vec$i32`) is not part of the name written.
fn sema_vis_use(sm: *Sema, line: i32, col: i32, name_sv: StrView)
    var name: *u8 = name_sv.ptr
    var len: i32 = name_sv.len as i32
    if name == null or len <= 0
        return
    if sm.cur_fn == null or (sm.cur_fn.def_file != null and not streq(sm.cur_fn.def_file, sm.file))
        return
    sema_vis_report(sm, line, col, StrView { ptr: (name), len: (len) as i64 })

# AGAST #3907: the input's type-alias uses, wherever written (the parser
# resolved each to its target, so no walk sees the name).
fn sema_vis_alias_uses(sm: *Sema)
    var i: i32 = vis_alias_uses_from()

    let end: i32 = vis_alias_uses_to()
    while i < end
        var span: SrcSpan
        let name_sv: StrView = alias_use_at(sm.pctx, i, @span)
        sema_vis_report(sm, span.line, span.col, name_sv)
        i = i + 1

fn sema_vis_report(sm: *Sema, line: i32, col: i32, name_sv: StrView)
    var name: *u8 = name_sv.ptr
    var len: i32 = name_sv.len as i32
    var n: i32 = 0
    while n < len and name[n] != '$'
        n = n + 1
    # AGAST #3934: `heap e`'s call is the compiler's; ritz0 finds malloc in
    # any module loaded, imported plainly or not.
    if is_heap_new(StrView { ptr: (name), len: (n) as i64 }) == 1
        return
    let h: *VisEntry = vis_hidden(StrView { ptr: (name), len: (n) as i64 })
    if h == null
        return
    sema_error_at(sm, line, col)
    eprint_char('`')
    eprint_bytes(StrView { ptr: (name), len: (n) as i64 })
    eprints("` is undefined (#3891): it comes from `")
    eprints_cstr(h.origin)
    eprints("`; import it, or have `")
    eprints_cstr(h.via)
    eprints("` `pub import` it\n")

# AGAST #3042: what `owner`, an ExprKind.If / ExprKind.Match, yields: the struct its
# arm's value `body` is, typed in the arm's scope, with its bindings and
# `let`s.  The first arm that types wins: ritz0 types an `if` by its
# then-branch.  match_scrutinee_type reads it for `match (if c then b else d)`.
fn sema_note_arm_value(sm: *Sema, owner: *Expr, arm: *MatchArm)
    if owner == null or owner.value_ty_name != null or arm.is_pass != 0
        return
    # An `E.V(..)` (which sema_expr_ty types since AGAST #3810), or a unit
    # variant `E.V` (since #4251), types no arm here: ritz1 refuses a variant
    # two enums declare on such a scrutinee.
    if arm.body != null and arm.body.kind == ExprKind.Method and rl_qualified_variant(sm, arm.body) == 1
        return
    if arm.body != null and arm.body.kind == ExprKind.Member and sema_enum_name(sm, arm.body.left) != null
        return
    var t: SemaTy
    if sema_expr_ty(sm, arm.body, @t) == TypeKind.Struct and t.name != null and t.name_len > 0
        owner.value_ty_name = t.name
        owner.value_ty_name_len = t.name_len

# A bare-name arm's binding.  AGAST #4596: over an enum, a name that isn't one
# of its variants binds the scrutinee's value (§8.2), typed as the enum, as
# emit_match_arm_body binds it (both judge by arm_binds_enum_value).  Any other
# bare name stays untyped here.
fn sema_bind_arm_name(sm: *Sema, arm: *MatchArm, scrut: *Expr)
    let name: StrView = StrView { ptr: (arm.pattern_name), len: (arm.pattern_name_len) as i64 }
    if scrut != null
        var t: SemaTy
        if sema_expr_ty(sm, scrut, @t) == TypeKind.Struct and t.name != null and t.name_len > 0
            let tn: StrView = StrView { ptr: (t.name), len: (t.name_len) as i64 }
            if (user_enum_index(sm.pctx, tn) >= 0 or is_tagged_enum_type(tn) == 1) and arm_binds_enum_value(sm.pctx, arm, tn) == 1
                sema_bind_ty(sm, name, @t, 0)
                return
    sema_bind(sm, name)

# `scrut` is the match's scrutinee; null for an if-expression's arms.  `owner`
# is the ExprKind.If / ExprKind.Match the arms are of; null for a match statement.
# `discard`: the match / if's value is discarded, so its arms' are (#3980).
fn sema_walk_arms(sm: *Sema, scrut: *Expr, arms: *MatchArm, owner: *Expr, discard: i32)
    own_check_arms_begin(sm, scrut)   # AGAST #3507: a match owns what it moves

    var mv: MatchValue
    match_value_begin(sm, @mv, owner, discard)   # AGAST #4656: a match used as a value

    var arm: *MatchArm = arms
    while arm != null
        # AGAST #3907: `E.V =>` / `E.V(v) =>` names the enum E.
        if arm.qualifier != null and sema_is_local(sm, StrView { ptr: (arm.qualifier), len: (arm.qualifier_len) as i64 }) == 0
            sema_vis_use(sm, arm.head_span.line, arm.head_span.col, StrView { ptr: (arm.qualifier), len: (arm.qualifier_len) as i64 })
        call_check_pattern_qualifier(sm, arm)   # AGAST #4665
        let mark: i32 = sm.scope_top
        ref_loan_enter()   # AGAST #3506: an arm is a block for loans

        own_check_arm_begin(sm)   # AGAST #3507: from the state before the arms

        if arm.pattern_kind == PAT_VARIANT
            # AGAST #1295: each binding of `V(a, b, ..)` in turn.
            let nb: i32 = arm_bind_count(arm)
            for k in 0..nb
                arm_select_bind(arm, k)
                if arm.pattern_inner_kind == PAT_IDENT
                    var pt: SemaTy
                    sema_arm_payload_ty(sm, arm, scrut, @pt)   # AGAST #3810
                    sema_bind_ty(sm, StrView { ptr: (arm.pattern_inner_name), len: (arm.pattern_inner_name_len) as i64 }, @pt, 0)
                    bool_note_arm(sm, arm, scrut)

                    ref_value_note_arm(sm, arm, scrut)   # AGAST #3926

                    ref_value_bind_arm(sm, arm)   # AGAST #4011

                    own_check_arm_bound(sm, arm)   # AGAST #3507: it may own the payload

                narrow_sema_arm(sm, scrut, arm)
            arm_select_bind(arm, 0)
        else
            if arm.pattern_kind == PAT_IDENT
                sema_bind_arm_name(sm, arm, scrut)
                bool_note_arm(sm, arm, scrut)

                own_check_arm_binds_scrut(sm, arm, scrut)   # AGAST #4602

            narrow_sema_arm(sm, scrut, arm)

        # AGAST #4543: a value-wanted match arm's block tail that is an
        # else-less `if` has no value; report it at that `if` (#1406's
        # position, as ritz0 does), before the arm is walked.
        if owner != null and owner.kind == ExprKind.Match and discard == 0
            if_arm_check_match_arm(sm, arm)

        # match_arm_set_block keeps an arm's trailing expression apart in
        # arm.body, so the last of body_stmts is never the arm's value: a
        # call there is discarded (AGAST #3515).  With no arm.body the last
        # statement isn't an expression, so the flag changes nothing there.
        # The arm's `let`s stay bound for its trailing expression: `let b =
        # ..` then `b.p()` (AGAST #2237 / #3511); the arm's mark drops them.
        sema_walk_block(sm, arm.body_stmts, 1)
        # AGAST #4081: a match statement in the fn's tail chain yields the
        # fn's value, judged with the arm's bindings and `let`s in scope.
        if owner == null and discard == 0 and arm.is_pass == 0
            slot_narrowing_tail(sm, arm.body)

        # AGAST #3015: a match arm's value, with its binding in scope (an
        # if-expression's arms were resolved with their statement).  Before
        # let_check, as the emitter used to run them.
        if scrut != null and arm.is_pass == 0
            deref_field_expr(sm, arm.body)

        if arm.is_pass == 0
            let_check_expr(sm, arm.body)   # AGAST #2028: as emit_match_arm_body

        enum_as_int_expr(sm, arm.body)   # AGAST #2136 / #3511

        if arm.is_pass == 0
            ref_loan_check_value(sm, arm.body)   # AGAST #3506

            ref_value_check_value(sm, arm.body)   # AGAST #3926

        # LARB R69 (AGAST #3968 / #3997): a discarded match / if's arm value
        # is a discarded statement's.
        if discard == 1 and arm.is_pass == 0
            discarded_array_check(sm, arm.body)

            must_use_check(sm, arm.body)

            no_effect_check(sm, arm.body)   # LARB R64 / R69

        if_arm_discard_next(discard)

        own_check_arm_value(sm, arm, discard)   # AGAST #3507: the arm's value moves out
        sema_walk_expr(sm, arm.body)
        sema_note_arm_value(sm, owner, arm)   # after it: a nested `if`'s own note

        float_arm_note(sm, owner, arm)   # AGAST #3892, likewise

        match_value_note(sm, @mv, arm)   # AGAST #4656, likewise

        own_check_arm_end(sm)   # AGAST #3507: before its bindings leave scope

        ref_loan_leave()
        sm.scope_top = mark
        arm = arm.next
    float_arms_settle(sm, owner, arms)   # AGAST #3892

    match_value_settle(sm, @mv, owner)   # AGAST #4656

    own_check_arms_end(sm, scrut)   # AGAST #3507

# 0 when `e` is a `not` / `and` / `or` whose operand names nothing
# (call_check_names_nothing): call_check reports the name, as ritz0's name
# resolver does before any typing (AGAST #4665).
fn sema_bool_operand_named(sm: *Sema, e: *Expr) -> i32
    if e.kind == ExprKind.Unary and call_check_names_nothing(sm, e.operand) == 1
        return 0

    if e.kind == ExprKind.Binary and (call_check_names_nothing(sm, e.left) == 1 or call_check_names_nothing(sm, e.right) == 1)
        return 0
    1

# Every sub-expression, for the probe; a match or an if/else expression's
# arms hold statements.
fn sema_walk_expr(sm: *Sema, e: *Expr)
    let discard: i32 = if_arm_take_discard()   # AGAST #3980
    if e == null
        return
    sema_note_expr_ty(sm, e)   # AGAST #4404: the emitter reads this
    sema_probe_record(sm, e)

    if sema_bool_operand_named(sm, e) == 1   # AGAST #4665: call_check says it
        bool_check_expr(sm, e)   # AGAST #2342

    float_check_compare(sm, e)   # AGAST #3607

    struct_cast_check(sm, e)   # LARB R72 (AGAST #4000)

    if call_check_muted() == 0
        literal_expr(sm, e)   # AGAST #2341 / #3510: before its operands

    wrapping_check(sm, e)   # LARB R63 (AGAST #3486): integer operands

    ptr_arith_check(sm, e)   # §7.1 (AGAST #4657): pointer operands

    const_arith_check(sm, e)   # LARB R63 (AGAST #4665): constant operands

    if e.kind == ExprKind.Ident
        call_check_ident(sm, e)   # AGAST #4595: "Unknown identifier"

    let k: ExprKind = e.kind
    if k == ExprKind.Ident and sema_is_local(sm, StrView { ptr: (e.ident_ptr), len: (e.ident_len) as i64 }) == 0
        sema_vis_use(sm, e.span.line, e.span.col, StrView { ptr: (e.ident_ptr), len: (e.ident_len) as i64 })
    else if k == ExprKind.Call and sema_is_local(sm, StrView { ptr: (e.func_name), len: (e.func_name_len) as i64 }) == 0
        sema_vis_use(sm, e.span.line, e.span.col, StrView { ptr: (e.func_name), len: (e.func_name_len) as i64 })
    else if k == ExprKind.StructLit
        sema_vis_use(sm, e.span.line, e.span.col, StrView { ptr: (e.ident_ptr), len: (e.ident_len) as i64 })
    match k
        ExprKind.Match | ExprKind.If =>
            if discard == 0
                if_arm_check(sm, e)   # AGAST #1613 / #3512: both arms, before the condition
            sema_walk_expr(sm, e.left)
            var scrut: *Expr = null
            if k == ExprKind.Match
                scrut = e.left
            sema_walk_arms(sm, scrut, e.args as *MatchArm, e, discard)
        ExprKind.Binary | ExprKind.Index | ExprKind.Range =>
            if k == ExprKind.Index
                # One report per `[` (AGAST #3755 / #3893): a scalar element is
                # both's since Sema types it (#3943).
                if index_scalar_check(sm, e) == 0
                    index_refuse_check(sm, e)
            sema_walk_expr(sm, e.left)
            sema_walk_expr(sm, e.right)
        ExprKind.Unary =>
            deref_value_check(sm, e)   # AGAST #3893: `*v`, v a value
            sema_walk_expr(sm, e.operand)
        ExprKind.Cast | ExprKind.Member | ExprKind.Try | ExprKind.ArrayFill =>
            if k == ExprKind.Member and e.left != null and e.left.kind == ExprKind.Ident
                call_check_variant(sm, e)      # AGAST #4665: `E.C`, no such variant

            if k == ExprKind.Member and e.left != null and e.left.kind == ExprKind.Ident
                call_check_qualifier(e.left)   # AGAST #4595: `E.V` names no value

            if k == ExprKind.Try
                call_check_try(sm, e)          # AGAST #4665

            sema_walk_expr(sm, e.left)
        ExprKind.Call =>
            # LARB R37 (AGAST #3373), else AGAST #1629 / #3503.  let_check's
            # argument rule first, as emit_expr_call ran it first (#3294 / #3504).
            let gm: i32 = generic_method_check(sm, e)

            let_another_struct_call(sm, e)

            if gm == 0
                call_check_call(sm, e)

            if call_check_muted() == 0
                intrinsic_check_call(sm, e)   # AGAST #4657: an intrinsic's arity and operands

            if call_check_muted() == 0
                literal_call(sm, e)   # AGAST #2341: after the call's own check

            if call_check_muted() == 0
                fn_slot_call(sm, e)   # AGAST #4310

            if call_check_muted() == 0
                slot_narrowing_call(sm, e)   # AGAST #4081

            # `sizeof(x)` and a non-literal `print(x)` never lower their operand.
            let mute: i32 = call_check_mutes(e)

            let in_sizeof: i32 = let_check_sizeof_of(e)   # AGAST #3504

            call_check_mute(mute)

            let_check_sizeof(in_sizeof)
            sema_walk_list(sm, e.args)
            let_check_sizeof(0 - in_sizeof)

            call_check_mute(0 - mute)
        ExprKind.ArrayLit =>
            sema_walk_list(sm, e.args)
            array_lit_one_type(sm, e)   # AGAST #4656
        ExprKind.Method =>
            # After the receiver, as emit_expr_method lowers it first.
            let_another_struct_method(sm, e)   # AGAST #3294

            let_check_receiver(sm, e)          # AGAST #2403

            if e.left != null and e.left.kind == ExprKind.Ident
                call_check_qualifier(e.left)   # AGAST #4595: `T.m(..)` names no value

            sema_walk_expr(sm, e.left)
            call_check_method(sm, e)      # AGAST #1629 / #3503

            if call_check_muted() == 0
                literal_method(sm, e)     # after its receiver, as emit_expr_method

            if call_check_muted() == 0
                slot_narrowing_method(sm, e)   # AGAST #4081
            sema_walk_list(sm, e.args)
        ExprKind.StructLit =>
            struct_lit_field_check(sm, e)   # LARB R49 (AGAST #3563)

            slot_kind_struct_lit(sm, e)   # AGAST #4653

            fn_slot_struct_lit(sm, e)   # AGAST #4310

            if call_check_muted() == 0
                slot_narrowing_struct_lit(sm, e)   # AGAST #4218

            var fi: *FieldInit = e.args as *FieldInit
            while fi != null
                sema_walk_expr(sm, fi.value)
                fi = fi.next
        _ => pass

fn sema_walk_list(sm: *Sema, first: *Expr)
    var a: *Expr = first
    while a != null
        sema_walk_expr(sm, a)
        a = a.next

# The declared type of a `let` / `var`, else its initialiser's.
fn sema_bind_decl(sm: *Sema, st: *Stmt)
    var t: SemaTy
    if st.var_declared_type != TypeKind.Void
        t.kind = st.var_type
        t.name = st.var_type_name
        t.name_len = st.var_type_name_len
        t.pointee = st.var_pointee_type
        # On a `[N]fn(..)` array var_fn_sig is the element's signature.
        t.fn_sig = null
        if st.var_type == TypeKind.Ptr
            t.fn_sig = st.var_fn_sig
    else
        sema_expr_ty(sm, st.var_init, @t)
        # AGAST #4081: `let t = take` holds fn `take`, so `t(..)` takes its
        # params (its kind stays unknown, as the bare name's).
        let init: *Expr = st.var_init
        if t.fn_sig == null and init != null and init.kind == ExprKind.Ident and sema_find_local(sm, StrView { ptr: (init.ident_ptr), len: (init.ident_len) as i64 }) == null
            t.fn_sig = sema_find_fn(sm, StrView { ptr: (init.ident_ptr), len: (init.ident_len) as i64 })
    sema_bind_ty(sm, StrView { ptr: (st.var_name), len: (st.var_name_len) as i64 }, @t, st.var_is_let)
    # AGAST #4410: `let r = @q` with `q` a scalar `*T` is a `**T` held as a
    # PTR_PTR local (the emitter's infer_ref_to_scalar_pointer_let), so `**r`
    # reads a T.  Sema's source typer has only the `@`'s PTR.
    if st.var_declared_type == TypeKind.Void and sm.scope_top > 0 and st.var_init != null
        if st.var_init.kind == ExprKind.Unary and (st.var_init.op == OpKind.Addr or st.var_init.op == OpKind.AddrMut) and st.var_init.operand != null and st.var_init.operand.kind == ExprKind.Ident
            let src: *SemaVar = sema_find_local(sm, StrView { ptr: (st.var_init.operand.ident_ptr), len: (st.var_init.operand.ident_len) as i64 })
            if src != null and (src.kind == TypeKind.Ptr or src.kind == TypeKind.PtrPtr) and src.type_name_len == 0
                var inner: i32 = (src.pointee as i32)
                if src.kind == TypeKind.PtrPtr
                    inner = src.inner
                let leaf: TypeKind = ptr_ptr_slot_inner(inner)
                if type_is_scalar_leaf(leaf)
                    if src.kind == TypeKind.PtrPtr
                        inner = ptr_slot_deepen(inner, 1)
                    let lv0: *SemaVar = @sm.scope[sm.scope_top - 1]
                    lv0.kind = TypeKind.PtrPtr
                    lv0.pointee = TypeKind.Ptr
                    lv0.inner = inner
    # AGAST #4410: an unannotated local's slot is its initialiser's, which
    # emit_var_decl infers (a float method's width, else i64).  The initialiser
    # has been walked and annotated, so read that here.
    if st.var_declared_type == TypeKind.Void and sm.scope_top > 0
        let lv: *SemaVar = @sm.scope[sm.scope_top - 1]
        lv.float_src = float_slot_src(sm, st.var_init)   # AGAST #3998
        let af: TypeKind = sema_arm_float_slot(sm, st.var_init)
        if af != TypeKind.Void
            lv.init_slot = af     # a float if / match slot (last_match_float_ty)
        else
            lv.init_slot = expr_sema_ty(st.var_init)
            # AGAST #4410: Sema's source typer leaves a deref init unknown, but
            # emit_var_decl infers its pointee (`let v = **r` is a T).  The slot
            # typer resolves it; an if / match / array literal keeps its own
            # rule above.
            if lv.init_slot == TypeKind.Unknown and st.var_init != null
                let ik: ExprKind = st.var_init.kind
                if ik != ExprKind.If and ik != ExprKind.Match and ik != ExprKind.ArrayLit and ik != ExprKind.ArrayFill
                    lv.init_slot = sema_slot_ty(sm, st.var_init)
            # AGAST #4410: `let q = a[1]` with `a:& [N]*T` is the emitter's
            # element (`a *T`).  Only the borrow-param array view needs this:
            # other bases keep Sema's source typing (and the emitter's own
            # inference mirrors it).
            if st.var_init != null and st.var_init.kind == ExprKind.Index and st.var_init.left != null and st.var_init.left.kind == ExprKind.Ident and st.var_init.right != null and st.var_init.right.kind != ExprKind.Range
                let src: *SemaVar = sema_find_local(sm, StrView { ptr: (st.var_init.left.ident_ptr), len: (st.var_init.left.ident_len) as i64 })
                if src != null and src.kind == TypeKind.Unknown and src.lent != null and src.lent.param_pointee_type == TypeKind.Array
                    lv.init_slot = src.lent.param_pointee_array_elem_type
                    if src.lent.param_pointee_array_elem_pointee != TypeKind.Void
                        lv.pointee = src.lent.param_pointee_array_elem_pointee
        # AGAST #4410: an untyped `let a = [@p, ..]` is an `[N]*T`; keep the
        # element's pointee T so `*a[i]` loads its width.
        if st.var_init != null and (st.var_init.kind == ExprKind.ArrayLit or st.var_init.kind == ExprKind.ArrayFill)
            var first: *Expr = st.var_init.args
            if st.var_init.kind == ExprKind.ArrayFill
                first = st.var_init.left
            if first != null
                var ft: SemaTy
                sema_expr_ty(sm, first, @ft)
                if ft.kind == TypeKind.Ptr or ft.kind == TypeKind.Ref or ft.kind == TypeKind.MutRef
                    lv.pointee = ft.pointee
    sema_index_note_decl(sm, st)   # its element, for sema_elem_ty (AGAST #3943)
    # AGAST #4428: an unannotated `let q = <array element>` / `@<element>` /
    # `*<**T>` takes the emitter's inferred type (infer_array_elem_let /
    # infer_elem_ptr_ptr_let), so `*q` / `**q` read the element's width.
    # After sema_index_note_decl, whose pointer-copy arm clears index_elem.
    sema_note_elem_init(sm, st)

# `for x in it`: x is an element of `it` (or of what `@it` / `@&it` points
# at), read outside the loop's binding; a range's x is left unknown.
fn sema_bind_for(sm: *Sema, st: *Stmt)
    var t: SemaTy
    sema_ty_unknown(@t)
    if st.for_end == null
        var it: *Expr = st.for_start
        if it != null and it.kind == ExprKind.Unary and (it.op == OpKind.Addr or it.op == OpKind.AddrMut)
            it = it.operand
        sema_elem_ty(sm, it, @t)
    sema_bind_ty(sm, StrView { ptr: (st.for_var), len: (st.for_var_len) as i64 }, @t, 0)
    # AGAST #4410: an element of a `[N]*U` array (`for p in w.a`, `for p in T`)
    # is a `*U`; record U so `*p` keeps its width (the emitter's
    # LocalVar.pointee_type).  An array-literal iterable (`for x in [1.5, ..]`)
    # takes its element's slot.
    if st.for_end == null and sm.scope_top > 0
        let lv: *SemaVar = @sm.scope[sm.scope_top - 1]
        var itv: *Expr = st.for_start
        if itv != null and itv.kind == ExprKind.Unary and (itv.op == OpKind.Addr or itv.op == OpKind.AddrMut)
            itv = itv.operand
        if itv != null
            let ep: TypeKind = sema_iter_pointee(sm, itv)
            if ep != TypeKind.Void
                lv.pointee = ep
            let es: TypeKind = sema_iter_elem_slot(sm, itv)
            if es != TypeKind.Unknown
                lv.init_slot = es
    # AGAST #4410: a range's variable is the bound's slot (the emitter takes it
    # from `0..n`'s n), which sema_elem_ty leaves unknown for a range.
    if st.for_end != null and sm.scope_top > 0
        let lv: *SemaVar = @sm.scope[sm.scope_top - 1]
        lv.init_slot = expr_sema_ty(st.for_end)

# `let (a, b, ..) = init`: each binding is its field of init's tuple struct,
# typed before any is bound.
fn sema_bind_tuple(sm: *Sema, st: *Stmt)
    var tup: SemaTy
    sema_expr_ty(sm, st.var_init, @tup)
    sema_tuple_pattern_check(sm, st, @tup)   # LARB R67, AGAST #3500
    var t: SemaTy
    sema_tuple_field_ty(sm, @tup, 0, @t)
    sema_bind_ty(sm, StrView { ptr: (st.var_name), len: (st.var_name_len) as i64 }, @t, 0)
    sema_tuple_inner_note(sm, @tup, 0)
    sema_tuple_field_ty(sm, @tup, 1, @t)
    sema_bind_ty(sm, StrView { ptr: (st.assign_target), len: (st.assign_target_len) as i64 }, @t, 0)
    sema_tuple_inner_note(sm, @tup, 1)
    bool_note_tuple(sm, st)
    var i: i32 = 2
    var tn: *TupleName = st.tuple_more   # AGAST #109
    while tn != null
        sema_tuple_field_ty(sm, @tup, i, @t)
        sema_bind_ty(sm, StrView { ptr: (tn.name), len: (tn.len) as i64 }, @t, 0)
        sema_tuple_inner_note(sm, @tup, i)
        tn = tn.next
        i += 1

# LARB R67 (AGAST #3500): a `(…)` pattern destructures tuples only.  A named
# struct is read by its fields: binding them by position silently rebinds
# every name after a field is added.  A tuple's fields are named "0", "1", …,
# so a struct-typed initialiser whose first field is not "0" is a named struct.
# Reported at the `(`, worded as ritz0's let_rules.tuple_pattern_on_struct
# (#3499); a generic's mangled `Pair$i32` names `Pair`.
#
# Sema can't type every initialiser (an Option/Result payload's `unwrap`, say):
# the receiver sbk_receiver resolves still names the struct, and the emitter
# binds by it.  Unjudged when that names none (a missed refusal, a parity gap).
fn sema_tuple_pattern_check(sm: *Sema, st: *Stmt, tup: *SemaTy)
    var name: *u8 = tup.name
    var name_len: i32 = tup.name_len
    var sd: *StructDef = null
    if tup.kind == TypeKind.Struct and name != null and name_len > 0
        sd = sema_recv_struct(sm, tup)
        if sd == null
            return   # an enum, not a named struct
    else
        sbk_receiver(sm, st.var_init, @name, @name_len)
        if name == null or name_len <= 0
            return
        sd = sema_find_struct(sm, StrView { ptr: (name), len: (name_len) as i64 })
        if sd == null
            return
    if sd.fields != null and sd.fields.name_len == 1 and *sd.fields.name == '0'
        sema_tuple_count_check(sm, st, sd)   # AGAST #4665
        return   # a tuple: its elements are fields "0", "1", ...
    var len: i32 = name_len
    var i: i32 = 0
    while i < len and *(name + i) != '$'
        i += 1
    sm.error_count = sm.error_count + 1
    diag_error_name(sema_file(sm).ptr, st.paren_span, c"`", StrView { ptr: (name), len: (i) as i64 }, c"` is a struct, not a tuple: read its fields")

# `let (a, b) = t` of a 3-tuple: ritz0's words, at the `let` (AGAST #4665).
# ritz1 bound the first two and dropped the third.
fn sema_tuple_count_check(sm: *Sema, st: *Stmt, sd: *StructDef)
    var want: i32 = 0
    var f: *StructField = sd.fields
    while f != null
        want += 1
        f = f.next
    var got: i32 = 2
    var tn: *TupleName = st.tuple_more
    while tn != null
        got += 1
        tn = tn.next
    if want == got
        return
    sema_error_at(sm, st.span.line, st.span.col)
    eprints("Tuple destructuring mismatch: expected ")
    eprint_i64(want as i64)
    eprints(" elements, got ")
    eprint_i64(got as i64)
    eprints(" names\n")

# AGAST #4428: a `**T` tuple element binds with its packed inner, so `**w`
# (a `let (w, ..)` of a `(**u8, i32)`) loads a u8, as the emitter's binding
# records it.
fn sema_tuple_inner_note(sm: *Sema, tup: *SemaTy, i: i32)
    if sm.scope_top <= 0
        return
    let inner: i32 = sema_tuple_field_inner(sm, tup, i)
    if inner != (TypeKind.Void as i32)
        let lv: *SemaVar = @sm.scope[sm.scope_top - 1]
        lv.inner = inner

fn sema_bind_param(sm: *Sema, p: *Param)
    var t: SemaTy
    if p.is_borrow == 1 and p.param_pointee_type == TypeKind.Struct
        # `x:& S` reads as its S for `.` (§13.4), as ref_check's ref_of_local
        # has it.  A scalar `h:& T` is still read and written as `*h`, which
        # bool_check judges off the param itself: left unknown.
        t.kind = TypeKind.Struct
        t.name = p.param_type_name
        t.name_len = p.param_type_name_len
        t.pointee = TypeKind.Void
        t.fn_sig = null
    else if p.is_borrow == 1
        sema_ty_unknown(@t)
    else
        t.kind = p.param_type
        t.name = p.param_type_name
        t.name_len = p.param_type_name_len
        t.pointee = p.param_pointee_type
        t.fn_sig = p.fn_sig
    if p.is_self_borrow == 1 and p.param_type == TypeKind.Struct and p.param_type_name_len == 0 and sm.cur_impl != null
        # AGAST #3975: a bare `self:&` is its impl's struct, so `self.f` and
        # `self.f.m()` are typed as under a bare `self`.
        t.name = sm.cur_impl.type_name
        t.name_len = sm.cur_impl.type_name_len
    sema_bind_ty(sm, StrView { ptr: (p.name), len: (p.name_len) as i64 }, @t, 0)
    # As sema_bind_decl: `ws[i].f` of a `ws: [N]S` param (AGAST #3512).
    sema_index_note_param(sm, p)
    if (p.is_borrow == 1 or p.is_self_borrow == 1) and sm.scope_top > 0
        let lv: *SemaVar = @sm.scope[sm.scope_top - 1]
        lv.lent = p

fn sema_is_assign(kind: StmtKind) -> i32
    (kind == StmtKind.Assign or kind == StmtKind.MemberAssign or kind == StmtKind.MemberIndexAssign or kind == StmtKind.IndexAssign or kind == StmtKind.LocalFieldAssign or kind == StmtKind.LocalFieldIndexAssign) as i32

# A block: what it binds goes out of scope at its end.  A `let` is bound
# after its initialiser.  `void_tail` is 1 for the body of a fn that returns
# nothing, whose last statement is discarded too.
fn sema_walk_stmts(sm: *Sema, first: *Stmt, void_tail: i32)
    let mark: i32 = sm.scope_top
    ref_loan_enter()   # AGAST #3506: a loan ends with its holder's block

    own_check_block_enter(sm)   # AGAST #3507: a block for the move check
    sema_walk_block(sm, first, void_tail)

    own_check_block_leave(sm)   # AGAST #3507: its deferred statements run

    ref_loan_leave()
    sm.scope_top = mark

# sema_walk_stmts, leaving what the block binds in scope for the caller to drop.
fn sema_walk_block(sm: *Sema, first: *Stmt, void_tail: i32)
    let tail_value: i32 = if_arm_take_tail()   # AGAST #3980
    var st: *Stmt = first
    while st != null
        pass_value_check(sm, st)   # AGAST #3759

        # AGAST #3015 / #3509: `.` through Deref, before any check that reads
        # members.  pass_value only looks for `pass`, which a step never holds.
        deref_field_stmt(sm, st)
        let fn_tail: i32 = (st.next == null and sm.cur_fn != null and first == sm.cur_fn.body) as i32

        # AGAST #3507: the move check, as the emitter ran it on each statement
        # before lowering it; a fn's value tail is a move (own_check_tail).
        own_check_stmt(sm, st, (fn_tail == 1 and sm.cur_fn.return_type != TypeKind.Void) as i32)

        if fn_tail == 1
            bool_check_tail(sm, st)   # AGAST #2342

        # AGAST #2028: a fn's tail expression is its return value, not a
        # statement; #3293 judges it.  An `@&` of a `let` in it is refused as
        # anywhere else (AGAST #3804: the emitter never let-checked it).
        if fn_tail == 1 and st.kind == StmtKind.Expr
            return_check_another_struct(sm, st.expr, st.expr.span.line, st.expr.span.col)

            let_check_expr(sm, st.expr)
        else
            let_check_stmt(sm, st)
        sema_enum_as_int(sm, st, first)   # AGAST #2136 / #3511
        if fn_tail == 1
            literal_fn_tail(sm, st)   # AGAST #2341

            slot_kind_tail(sm, st)    # AGAST #4653

        if fn_tail == 1
            fn_slot_tail(sm, st)   # AGAST #4310

        if tail_value == 1 and st.next == null and st.kind == StmtKind.Expr
            slot_narrowing_tail(sm, st.expr)   # AGAST #4081: the fn's value

        ref_loan_check_stmt(sm, st)   # AGAST #2438 / #3506

        ref_value_check_stmt(sm, st)   # AGAST #3926
        match st.kind
            StmtKind.VarDecl =>
                if st.var_declared_type != TypeKind.Void
                    sema_vis_use(sm, st.span.line, st.span.col, StrView { ptr: (st.var_type_name), len: (st.var_type_name_len) as i64 })
                bool_check_decl(sm, st)   # AGAST #2342

                literal_decl(sm, st)      # AGAST #2341

                slot_kind_decl(sm, st)    # AGAST #4653

                fn_slot_decl(sm, st)      # AGAST #4310

                match_value_let(sm, st)   # AGAST #4656
                sema_walk_expr(sm, st.var_init)
                check_implicit_narrowing(sm, st)   # AGAST #1364 / #3505
                sema_bind_decl(sm, st)
                let_note_decl(sm, st)   # AGAST #3504

                eai_note_decl(sm, st)   # AGAST #3511

                narrow_sema_decl(sm, st)

                bool_note_decl(sm, st)
            StmtKind.TupleDecl =>
                sema_walk_expr(sm, st.var_init)
                sema_bind_tuple(sm, st)
            StmtKind.For =>
                sema_walk_expr(sm, st.for_start)
                sema_walk_expr(sm, st.for_end)
                let for_mark: i32 = sm.scope_top
                sema_bind_for(sm, st)
                narrow_sema_for(sm, st)   # AGAST #4080

                bool_note_for(sm, st)

                let_note_for(sm, st)   # AGAST #2389: an element is a `let`

                own_check_loop_enter(sm)   # AGAST #3507
                sema_walk_stmts(sm, st.for_body, 0)

                own_check_loop_exit(sm)
                sm.scope_top = for_mark
            StmtKind.If =>
                if call_check_names_nothing(sm, st.if_cond) == 0   # AGAST #4665
                    bool_check_cond(sm, st.if_cond, c"if condition")
                sema_walk_expr(sm, st.if_cond)
                var in_tail: i32 = (tail_value == 1 and st.next == null) as i32
                # An arm's else-less tail already has if_arm_value's "no value"
                # error: its tail was wanted as a value, so it is not also a
                # statement with no effect (LARB R64 / R69, AGAST #3492).
                if if_arm_no_else_at(st.span.line, st.span.col) == 1
                    in_tail = 1

                if_arm_want_tail(in_tail)

                own_check_if_then(sm, st)   # AGAST #3507: the arms' moves merge
                sema_walk_stmts(sm, st.if_then, 0)

                own_check_if_else(sm, st)

                if_arm_want_tail(in_tail)
                sema_walk_stmts(sm, st.if_else, 0)

                own_check_if_end(sm, st)
            StmtKind.While =>
                bool_check_cond(sm, st.while_cond, c"while condition")
                sema_walk_expr(sm, st.while_cond)

                own_check_loop_enter(sm)   # AGAST #3507
                sema_walk_stmts(sm, st.while_body, 0)

                own_check_loop_exit(sm)
            StmtKind.Loop | StmtKind.Defer | StmtKind.Unsafe =>
                if_arm_want_tail((st.kind == StmtKind.Unsafe and tail_value == 1 and st.next == null) as i32)

                # AGAST #3507: a loop's body; a `defer`'s runs at its block's exits,
                # not here; an `unsafe` block's bindings are its block's.
                if st.kind == StmtKind.Loop
                    own_check_loop_enter(sm)

                if st.kind == StmtKind.Defer
                    own_check_mute(1)

                if st.kind == StmtKind.Unsafe
                    own_check_unsafe()
                sema_walk_stmts(sm, st.while_body, 0)

                if st.kind == StmtKind.Loop
                    own_check_loop_exit(sm)

                if st.kind == StmtKind.Defer
                    own_check_mute(0 - 1)
            StmtKind.Match =>
                sema_walk_expr(sm, st.if_cond)
                # AGAST #3980: its arms are values only if it is the block's.
                let discard_m: i32 = (tail_value == 0 or st.next != null) as i32
                match_value_stmt_at(sm, st)   # AGAST #4656
                sema_walk_arms(sm, st.if_cond, st.if_then as *MatchArm, null, discard_m)
            StmtKind.Return =>
                bool_check_return(sm, st.return_value)

                if st.return_value != null
                    return_check_another_struct(sm, st.return_value, st.span.line, st.span.col)   # AGAST #3293

                literal_return(sm, st.return_value)   # AGAST #2341

                slot_kind_return(sm, st)   # AGAST #4653

                if st.return_value != null
                    fn_slot_return(sm, st)   # AGAST #4310

                slot_narrowing_return(sm, st.return_value)   # AGAST #4081
                sema_walk_expr(sm, st.return_value)
            StmtKind.Expr =>
                # Only a block's last statement can be its value (AGAST #2137).
                # LARB R69 (AGAST #3997): the last line of a block that is no
                # value — a loop body, a statement `if`'s branch, a statement
                # `match`'s arm — is discarded too (tail_value, #3980).
                if st.next != null or void_tail == 1 or tail_value == 0
                    must_use_check_value(sm, st.expr)

                # AGAST #3189 / #3512 / #3920: as ritz0 judges an ExprStmt: an
                # arm's last statement before its value too.  LARB R69 (AGAST
                # #3968): so is the last line of a block that is no value, a loop
                # body or a statement `if`'s branch (tail_value, #3980).
                if st.next != null or void_tail == 1 or tail_value == 0
                    discarded_array_check_value(sm, st.expr)

                # LARB R64 / R69 (AGAST #3492): a statement that computes a value
                # and throws it away.  The same positions as the two above.
                # AGAST #4665: a name nothing declares is call_check's
                # "Unknown identifier", not a discarded value.
                if (st.next != null or void_tail == 1 or tail_value == 0) and call_check_names_nothing(sm, st.expr) == 0
                    no_effect_check_value(sm, st.expr)
                sema_walk_expr(sm, st.expr)
            StmtKind.Assert =>
                bool_check_cond(sm, st.if_cond, c"assert condition")
                sema_walk_expr(sm, st.if_cond)
            _ =>
                if sema_is_assign(st.kind) == 1
                    bool_check_stmt(sm, st)   # AGAST #2342

                    literal_stmt(sm, st)      # AGAST #2341

                    slot_kind_assign(sm, st)  # AGAST #4653

                    fn_slot_assign(sm, st)    # AGAST #4310

                    slot_narrowing_assign(sm, st)   # AGAST #4081

                    if st.kind == StmtKind.Assign and st.assign_target_len == 0
                        index_store_check(sm, st.if_cond)   # AGAST #3565

                        index_whole_array_check(sm, st.if_cond, st)   # AGAST #3893
                        sema_walk_expr(sm, st.if_cond)
                    else
                        match st.kind
                            StmtKind.IndexAssign =>
                                index_name_scalar_check(sm, st)   # AGAST #3755

                                index_refuse_name_store(sm, st)   # AGAST #3893
                                sema_walk_expr(sm, st.while_cond)
                            StmtKind.LocalFieldIndexAssign | StmtKind.MemberIndexAssign =>
                                index_field_scalar_check(sm, st)   # AGAST #3799
                            _ => pass
                    sema_walk_expr(sm, st.assign_value)
        ref_loan_after(sm, st)   # a declaration holds its `@x` (AGAST #3506)

        ref_value_after(sm, st)   # its binding's notes (AGAST #3926)

        own_check_after(sm, st)   # AGAST #3507: registers what it binds
        st = st.next

# enum_as_int (AGAST #2136 / #3511) on statement `st` of the list `first`:
# a fn's trailing expression is its returned value, as emit_fn judged it.
fn sema_enum_as_int(sm: *Sema, st: *Stmt, first: *Stmt)
    if sm.cur_fn == null
        return
    if st.next == null and st.kind == StmtKind.Expr and first == sm.cur_fn.body
        enum_as_int_tail(sm, st.expr, sm.cur_fn.return_type)
    else
        enum_as_int_stmt(sm, st, sm.cur_fn.return_type)

fn sema_walk_fn(sm: *Sema, f: *FnDef)
    if f.body == null or fn_is_naked(sm.pctx, f) == 1
        return
    sm.scope_top = 0
    sm.cur_fn = f
    variant_site_set(sm.pctx, diag_fn_source_file(f))   # AGAST #4609
    sema_vis_use(sm, f.line, f.col, StrView { ptr: (f.return_type_name), len: (f.return_type_name_len) as i64 })
    var p: *Param = f.params
    while p != null
        sema_vis_use(sm, f.line, f.col, StrView { ptr: (p.param_type_name), len: (p.param_type_name_len) as i64 })
        sema_bind_param(sm, p)
        let_note_param(sm, p)   # AGAST #2250: a `c:& C` holds its referent

        narrow_sema_param(sm, p)

        bool_note_param(sm, p)
        p = p.next

    eai_begin_fn()

    ref_loan_begin_fn()

    ref_value_begin_fn(sm, f)   # AGAST #3926

    own_check_begin_fn(sm, f)   # AGAST #3507: by-value move-only params

    if_arm_want_tail((f.return_type != TypeKind.Void) as i32)   # AGAST #3980
    sema_walk_stmts(sm, f.body, (f.return_type == TypeKind.Void) as i32)
    tail_value_check(sm, f)   # AGAST #2236 / #3511, after call_check's notes

    own_check_end_fn(sm, f)   # AGAST #3507: the fn's `ret`
    sm.scope_top = 0
    sm.cur_fn = null
    variant_site_set(sm.pctx, null)

# 1 when a fn of `f`'s name was walked already: emit_module lowers only the
# first of a name (was_fn_emitted).  `seen` maps fnv1a(name) to that fn.
fn sema_seen_before(m: *Module, seen: *HashMapI64, f: *FnDef) -> i32
    let k: i64 = fnv1a_str(Span<u8> { ptr: (f.name), len: (f.name_len) as i64 }) as i64
    let hit: *FnDef = seen.get(k).unwrap_or(0) as *FnDef
    if hit == null
        seen.insert(k, f as i64)
        return 0
    if name_eq(StrView { ptr: (hit.name), len: (hit.name_len) as i64 }, StrView { ptr: (f.name), len: (f.name_len) as i64 }) == 1
        return 1
    # A hash collision: scan the walked fns before `f` by name.
    var cur: *FnDef = m.functions
    while cur != f
        if cur.type_params == null and cur.is_local == 1 and name_eq(StrView { ptr: (cur.name), len: (cur.name_len) as i64 }, StrView { ptr: (f.name), len: (f.name_len) as i64 }) == 1
            return 1
        cur = cur.next
    0

# LARB R79 (AGAST #4007): `Future` is the built-in "some async fn's future";
# it has no size, so every by-value slot written with it -- a `let` / `var`,
# a struct field, a param, a return type, an array element -- is refused where
# the name is written, as ritz0's future_rules.py does.  ritz1's mirror is
# #4007; the slot fitting (`@&NAME$Future` into `@&Future`) is sema_type's.
fn fv_named_future(name: *u8, len: i32) -> i32
    if name == null or len != 6
        return 0
    name_eq(StrView { ptr: (name), len: (6) as i64 }, "Future")

fn fv_error(ctx: *ParseCtx, name: *u8) -> i32
    let at: *TypeNameAt = type_name_written_at(ctx, name)
    if at == null or at.reported == 1
        return 0
    at.reported = 1
    diag_error(at.file, diag_span(at.line, at.col), c"`Future` has no size; take it by reference, `@&Future`")
    1

# 1 when `ty` (a `TypeKind.Array` of `elem`) is `Future` by value, refused.
fn fv_slot(ctx: *ParseCtx, ty: TypeKind, elem: TypeKind, name: *u8, len: i32) -> i32
    var by_value: i32 = 0
    if ty == TypeKind.Struct
        by_value = 1
    else if ty == TypeKind.Array and elem == TypeKind.Struct
        by_value = 1
    if by_value == 0 or fv_named_future(name, len) == 0
        return 0
    fv_error(ctx, name)

fn fv_stmts(ctx: *ParseCtx, s: *Stmt) -> i32
    var n: i32 = 0
    var cur: *Stmt = s
    while cur != null
        let k: StmtKind = cur.kind
        match k
            StmtKind.VarDecl =>
                n = n + fv_slot(ctx, cur.var_type, cur.var_array_elem_type, cur.var_type_name, cur.var_type_name_len)
                if cur.var_array != null
                    n = n + fv_slot(ctx, cur.var_type, cur.var_array.elem, cur.var_array.name, cur.var_array.name_len)
            StmtKind.If =>
                n = n + fv_stmts(ctx, cur.if_then)
                n = n + fv_stmts(ctx, cur.if_else)
            StmtKind.While | StmtKind.Loop | StmtKind.Defer | StmtKind.Unsafe =>
                n = n + fv_stmts(ctx, cur.while_body)
            StmtKind.For =>
                n = n + fv_stmts(ctx, cur.for_body)
            StmtKind.Match =>
                var arm: *MatchArm = cur.if_then as *MatchArm
                while arm != null
                    n = n + fv_stmts(ctx, arm.body_stmts)
                    arm = arm.next
            _ => pass
        cur = cur.next
    n

fn fv_fn(ctx: *ParseCtx, f: *FnDef) -> i32
    var n: i32 = fv_slot(ctx, f.return_type, TypeKind.Void, f.return_type_name, f.return_type_name_len)
    if f.ret_array_param != null
        n = n + fv_slot(ctx, TypeKind.Array, f.ret_array_param.param_array_elem_type, f.ret_array_param.param_type_name, f.ret_array_param.param_type_name_len)
    var p: *Param = f.params
    while p != null
        n = n + fv_slot(ctx, p.param_type, p.param_array_elem_type, p.param_type_name, p.param_type_name_len)
        p = p.next
    n + fv_stmts(ctx, f.body)

fn fv_module(ctx: *ParseCtx, m: *Module) -> i32
    var n: i32 = 0
    var st: *StructDef = m.structs
    while st != null
        var fld: *StructField = st.fields
        while fld != null
            n = n + fv_slot(ctx, fld.field_type, fld.array_elem_type, fld.field_type_name, fld.field_type_name_len)
            n = n + fv_slot(ctx, TypeKind.Array, fld.array_elem_type, fld.array_elem_type_name, fld.array_elem_type_name_len)
            fld = fld.next
        st = st.next
    var g: *GlobalVarDef = m.globals
    while g != null
        n = n + fv_slot(ctx, g.var_type, g.array_elem_type, g.type_name, g.type_name_len)
        n = n + fv_slot(ctx, TypeKind.Array, g.array_elem_type, g.array_elem_type_name, g.array_elem_type_name_len)
        g = g.next
    var f: *FnDef = m.functions
    while f != null
        n = n + fv_fn(ctx, f)
        f = f.next
    var ib: *ImplBlock = m.impls
    while ib != null
        var method: *FnDef = ib.methods
        while method != null
            n = n + fv_fn(ctx, method)
            method = method.next
        ib = ib.next
    n

# Run every Sema check over the fns emit_module lowers.  Returns how many
# errors it reported; main stops the compile on any.
pub fn sema_check_module(mono: *MonoCtx, m: *Module, path: *u8) -> i32
    let sm: *Sema = malloc(sizeof(Sema)) as *Sema
    sema_init(mono.pctx, sm, m, path)
    deref_impls_check(sm)   # AGAST #3015: a `DerefMut` impl needs its `Deref`

    trait_bound_check(mono, sm)   # AGAST #3469: `<T: A + B>`, at each instance

    bool_check_globals(sm)   # AGAST #2342: before the fns, as the emitter

    literal_globals(sm)      # AGAST #2341

    sema_note_module_inits(sm)   # AGAST #4404: global / const initialisers

    sema_vis_alias_uses(sm)  # AGAST #3907

    sm.error_count = sm.error_count + fv_module(mono.pctx, m)   # LARB R79 / AGAST #4007

    var seen: HashMapI64 = hashmap_i64_with_cap(4096)
    var f: *FnDef = m.functions
    while f != null
        if f.type_params == null and f.is_local == 1 and sema_seen_before(m, @&seen, f) == 0
            sema_walk_fn(sm, f)
        f = f.next
    var ib: *ImplBlock = m.impls
    while ib != null
        if ib.type_params == null
            var method: *FnDef = ib.methods
            while method != null
                if method.is_local == 1
                    sm.cur_impl = ib
                    sema_walk_fn(sm, method)
                    sm.cur_impl = null
                method = method.next
        ib = ib.next

    array_lit_settle(sm, own_check_errors())   # AGAST #4656: after the move check

    own_check_flush(sm)   # AGAST #3507: only on a module the other checks pass
    sm.error_count
