# main_abi.ritz - the program entry ABI (docs/V1_ABI_CLEANUP.md, AGAST #200, #204)
#
# ritz1's half of ritz0/main_abi.py; read that module's docstring for the
# design.  In short: the runtime's only `_start` calls the C symbol
# `main(argc, argv, envp)`.  A user's `main` takes one of
#
#     pub fn main()
#     pub fn main(args: Span<StrView>)
#     pub fn main(args: Span<StrView>, env: Span<StrView>)
#
# (each with or without `-> i32`).  `fn main() -> i32` *is* that symbol.
# Every other shape is renamed `__ritz_main`, and an adapter
# `main(argc, argv, envp) -> i32` written in Ritz builds the spans and calls
# it.  A `main` with no return type takes the adapter even with no params:
# ritz1 emits a return-less fn as `define void`, so before #200 such a
# program exited with whatever was left in rax.  C's `(argc: i32, argv:
# **u8)` and `(argc, argv, envp)` are refused (#204, MSG_C); the adapter is
# the only `main` with that signature, and it is generated after the check.
#
# The messages, the adapter text and RUNTIME_SOURCE are byte-identical to
# ritz0's (MSG_SHAPE, MSG_RET, MSG_PUB, adapter_source, RUNTIME_SOURCE), so
# both compilers refuse the same mains in the same words and give the same
# program.  This module decides and writes the text; main.ritz's lower_main
# lexes and parses it with ritz1's own front end and merges the fns into the
# input file's module (as add_enum_from_fns does for `E.from`).
#
# ritz1's AST keeps a type as a kind plus side-channel names, not ritz0's
# type tree, so the shape test reads those: `Span<StrView>` is the struct
# kind named `Span$StrView` (as is its sugar `[StrView]`, which ritz0 also
# desugars to Span<StrView>), `**u8` is TypeKind.PtrPtr whose innermost pointee
# is u8 at depth 2.  Type aliases are already replayed by the parser, so an
# alias of `i32` or `Span<StrView>` is accepted here where ritz0 (which sees
# the alias name) refuses it; `-> void` likewise reads as no return type.

import ritzlib.sys
import ritzlib.io
import ritzlib.string

import ast
import ast_helpers
import diag

# The shapes `main_abi_shape` answers (ritz0's None, 'c', 'span', 'unit').
pub const MAIN_SHAPE_NONE: i32 = 0
pub const MAIN_SHAPE_C: i32 = 1
pub const MAIN_SHAPE_SPAN: i32 = 2
pub const MAIN_SHAPE_UNIT: i32 = 3

fn ma_eq(a_sv: StrView, b_sv: StrView) -> i32
    var a: *u8 = a_sv.ptr
    var alen: i32 = a_sv.len as i32
    var b: *u8 = b_sv.ptr
    var blen: i32 = b_sv.len as i32
    if alen != blen or a == null
        return 0
    var i: i32 = 0
    while i < alen
        if *(a + i) != *(b + i)
            return 0
        i += 1
    1

# `Span<StrView>` (or `[StrView]`): the mangled generic struct name.
fn ma_is_span_strview(p: *Param) -> i32
    if p.param_type != TypeKind.Struct
        return 0
    ma_eq(p.param_type_name, "Span$StrView")

# `**u8`: exactly two plain-pointer levels over u8 (`***u8` packs a depth
# into the slot, `*@u8` marks an inner reference).
fn ma_is_ptr_ptr_u8(p: *Param) -> i32
    (p.param_type == TypeKind.PtrPtr and p.param_inner_pointee_type == (TypeKind.U8 as i32) and p.param_inner_ref == INNER_REF_NONE) as i32

# MAIN_SHAPE_UNIT for `()`, MAIN_SHAPE_SPAN for a Ritz-native param list,
# MAIN_SHAPE_C for C's refused `(argc: i32, argv: **u8[, envp: **u8])`,
# MAIN_SHAPE_NONE for anything else (ritz0's shape()).
pub fn main_abi_shape(f: *FnDef) -> i32
    var n: i32 = 0
    var all_span: i32 = 1
    var p: *Param = f.params
    while p != null
        if ma_is_span_strview(p) == 0
            all_span = 0
        n += 1
        p = p.next
    if n == 0
        return MAIN_SHAPE_UNIT
    if all_span == 1 and n <= 2
        return MAIN_SHAPE_SPAN
    if (n == 2 or n == 3) and f.params.param_type == TypeKind.I32
        var q: *Param = f.params.next
        while q != null
            if ma_is_ptr_ptr_u8(q) == 0
                return MAIN_SHAPE_NONE
            q = q.next
        return MAIN_SHAPE_C
    MAIN_SHAPE_NONE

# This file's own `main` (the first top-level fn of that name), or null.
# Called on the input file's module before its imports merge, as ritz0's
# find_main runs before _resolve.
pub fn main_abi_find(m: *Module) -> *FnDef
    var f: *FnDef = m.functions
    while f != null
        if ma_eq(f.name, "main") == 1
            return f
        f = f.next
    null

# Report this `main`'s entry-ABI error, if any, at its declaration, as
# `file:line:col: error: <msg>` (ritz0's check_main).  Returns the count.
pub fn main_abi_check(ctx: *ParseCtx, f: *FnDef, path: StrView) -> i32
    let at: SrcSpan = diag_span(f.line, f.col)
    let kind: i32 = main_abi_shape(f)
    # A written `fn main(..) = extern` is ritz0's is_decl; ritz1 has no
    # separate `extern fn` spelling, so fn_is_decl covers both.
    if kind == MAIN_SHAPE_NONE or f.type_params != null or fn_is_decl(ctx, f) == 1
        diag_error(path, at, "`main` must take `()`, `(args: Span<StrView>)` or `(args: Span<StrView>, env: Span<StrView>)`")
        return 1
    if kind == MAIN_SHAPE_C
        diag_error(path, at, "`main` takes `Span<StrView>`, not C's `argc`/`argv`: write `pub fn main(args: Span<StrView>)`")
        return 1
    if f.return_type != TypeKind.Void and f.return_type != TypeKind.I32
        diag_error(path, at, "`main` must return `i32` or nothing")
        return 1
    if kind == MAIN_SHAPE_SPAN and f.is_pub == 0
        diag_error(path, at, "`main` taking `Span<StrView>` must be `pub`: write `pub fn main(...)`")
        return 1
    0

# ritz0's MSG_CALL (AGAST #4198): once main took the adapter, `main` is the
# adapter's (argc, argv, envp), so call_check's cc_adapted_main refuses a
# call to it in these words, not as an arity error against the adapter.
pub fn main_abi_call_msg() -> StrView
    "`main` is the program's entry point and cannot be called"

pub fn main_abi_needs_adapter(f: *FnDef) -> i32
    (main_abi_shape(f) == MAIN_SHAPE_SPAN or f.return_type == TypeKind.Void) as i32

fn ma_param_count(f: *FnDef) -> i32
    var n: i32 = 0
    var p: *Param = f.params
    while p != null
        n += 1
        p = p.next
    n

# The `main` the C entry calls (ritz0's adapter_source): it calls
# `__ritz_main` (the user's main) with the spans it takes, and returns its
# i32, or 0 if it returns nothing.  For a main with params, RUNTIME_SOURCE
# follows after a blank line, as in ritz0's lower_main.
pub fn main_abi_source(f: *FnDef, out: @&String)
    let n: i32 = ma_param_count(f)
    var call: String = string_from("__ritz_main(")
    if n > 0
        call.push_str("__ritz_args(argc, argv)")
    if n > 1
        call.push_str(", __ritz_env(envp)")
    call.push_str(")")
    out.push_str("pub fn main(argc: i32, argv: **u8, envp: **u8) -> i32\n")
    if f.return_type != TypeKind.Void
        out.push_str("    return ")
        out.push_string(@call)
        out.push_str("\n")
    else
        out.push_str("    ")
        out.push_string(@call)
        out.push_str("\n    0\n")
    if n > 0
        out.push_str("\n")
        main_abi_runtime_source(out)

# ritz0's RUNTIME_SOURCE, byte for byte: the runtime half of the entry path,
# in Ritz.  One `mmap` for the views, then a `strlen` per string.  Added
# only for a main with params, so `main()` pays nothing.  SYS_mmap is 9,
# PROT_READ|PROT_WRITE is 3, MAP_PRIVATE|MAP_ANONYMOUS is 0x22.  The mmap
# is Linux's, and serves Harland too: its mmap is also 9, has the same flag
# values and reads the first four arguments (indium's span_args, #4019).
fn main_abi_runtime_source(out: @&String)
    out.push_str("fn __ritz_views(n: i64, p: **u8) -> Span<StrView>\n")
    out.push_str("    var r: i64 = 9\n")
    out.push_str("    var addr: i64 = 0\n")
    out.push_str("    var size: i64 = n * 16 + 16\n")
    out.push_str("    var prot: i64 = 3\n")
    out.push_str("    var flags: i64 = 34\n")
    out.push_str("    var fd: i64 = -1\n")
    out.push_str("    var off: i64 = 0\n")
    out.push_str("    asm x86_64 (inout r: rax, in addr: rdi, in size: rsi, in prot: rdx, in flags: r10, in fd: r8, in off: r9, clobber rcx, clobber r11):\n")
    out.push_str("        syscall\n")
    out.push_str("    var out: Span<StrView>\n")
    out.push_str("    out.ptr = null\n")
    out.push_str("    out.len = 0\n")
    out.push_str("    if r < 0\n")
    out.push_str("        return out\n")
    out.push_str("    let views: *StrView = r as *StrView\n")
    out.push_str("    var i: i64 = 0\n")
    out.push_str("    while i < n\n")
    out.push_str("        let s: *u8 = p[i]\n")
    out.push_str("        var k: i64 = 0\n")
    out.push_str("        while s[k] != 0\n")
    out.push_str("            k = k + 1\n")
    out.push_str("        views[i].ptr = s\n")
    out.push_str("        views[i].len = k\n")
    out.push_str("        i = i + 1\n")
    out.push_str("    out.ptr = views\n")
    out.push_str("    out.len = n\n")
    out.push_str("    out\n")
    out.push_str("\n")
    out.push_str("fn __ritz_args(argc: i32, argv: **u8) -> Span<StrView>\n")
    out.push_str("    __ritz_views(argc as i64, argv)\n")
    out.push_str("\n")
    out.push_str("fn __ritz_env(envp: **u8) -> Span<StrView>\n")
    out.push_str("    var n: i64 = 0\n")
    out.push_str("    if envp != null\n")
    out.push_str("        while envp[n] != null\n")
    out.push_str("            n = n + 1\n")
    out.push_str("    __ritz_views(n, envp)\n")

# Give the user's main its adapted name; the adapter takes `main`.
pub fn main_abi_rename(f: *FnDef)
    f.name = "__ritz_main"   # ritz0's ADAPTED_NAME
