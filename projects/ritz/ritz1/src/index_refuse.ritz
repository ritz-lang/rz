# ritz1/src/index_refuse.ritz - what has nothing to index, on Sema
#
# AGAST #3893 (#1816).  index_through.ritz refused these mid-lowering, on
# EmitterState's locals; they are rules of the language, not limits of the
# lowering, so they run from sema_walk now, in the same words at the same
# places (ritz0's, from _index_through, _struct_index and array_rules):
#
#   - `p[i]` with `p` an `@T` / `@&T` (an un-annotated `let p = @x` too,
#     #2445 / #3079) whose T is no array, Vec, Span or String (LARB R9);
#   - `x[i][j]` with `x[i]` a scalar or a struct without `Index` (#2452, §7.8);
#   - `*v` with `v` a struct or sized scalar by value (#2452, #2885);
#   - `(*p)[i]` with `p` a `*T` to a struct without `Index` or a sized scalar
#     (#3132, §7.8);
#   - `p[i] = b` with `p` a `*[N]T` / `@[N]T` / `@&[N]T` and `b` a whole
#     array (#2330).
#
# A local is typed as the emitter's LocalVar had it: rs_local (ref_check's Sema
# side), which knows the inference's `@T` of `let p = @x`, and a `:&` param by
# what it was written.  An element is Sema's one typer's (sema_arr_elem): an
# `@x[i]` of an N-D `x` is an `@` to a row, until `x[i][j]..` is full rank
# (AGAST #4259), and a plane pointer has no `p#` view (sema_view_elem).  index_through keeps the lowering, and the one refusal
# that is a limit of it: a slice through a pointer it doesn't lower.

import ritzlib.cstr
import ritzlib.sys
import ritzlib.io
import ritzlib.str
import ritzlib.memory

import ast
import ast_helpers
import ast_query   # name_eq & co., off emitter_core (AGAST #3513)
import let_check       # let_through_elem
import ref_check       # rs_local, rs_note, ref_is_pointer
import sema
import sema_type
import struct_index    # si_traits, si_is_struct, si_eprint_needs_index
import types           # ty_int_in, ty_is_float
import ritzlib.strview

# 1 for a scalar type no ritz1 local uses to hold a pointer (AGAST #2885): an
# i64 or u64 may, so neither is refused.
fn ir_sized_scalar(t: TypeKind) -> i32
    (ty_int_in(t, 8, 32) == 1 or ty_is_float(t) == 1) as i32

# `x`, a name, as the emitter's local of it: 1 and its type in *out, its `:&`
# param in *lent; 0 when it's no local or Sema can't say.  A `:&` param is
# what it was written (a `c:& C` is an `@&C`); rs_local reads it as its C.
fn ir_local(sm: *Sema, x: *Expr, out: *SemaTy, lent: **Param) -> *SemaVar
    *lent = null
    if x == null or x.kind != ExprKind.Ident
        return null
    let v: *SemaVar = sema_find_local(sm, x.ident)
    if v == null
        return null
    if v.lent != null
        let p: *Param = v.lent
        let ipt: TypeKind = ptr_slot_flat(p.param_inner_pointee_type)
        if p.is_borrow == 1 and p.param_pointee_type == TypeKind.Ptr and (ipt == TypeKind.Array or primitive_name_len(ipt) > 0 or (ipt == TypeKind.Struct and p.param_type_name.len > 0))
            # AGAST #2075 / #3103: `p:& *T` binds as the caller's `*T` local
            # (bind_scalar_borrow_param), not as a lent one.
            rs_set(out, TypeKind.Ptr, ipt, p.param_type_name)
            return v
        *lent = p
        rs_set(out, p.param_type, p.param_pointee_type, p.param_type_name)
        return v
    if rs_local(sm, v, out) == 0
        return null
    v

# The error prefix at `e`'s `[`: the parser's record of it, else (an index
# the compiler built) the start of `e`.
fn ir_at_bracket(sm: *Sema, e: *Expr)
    var line: i32 = e.span.line
    var col: i32 = e.span.col
    if e.bracket.line > 0
        line = e.bracket.line
        col = e.bracket.col
    sema_error_at(sm, line, col)

# needs_index's words for `name` (or, with `name` null, the scalar `kind`) at
# `e`'s `[`; 0 when a scalar `kind` has no name.
fn ir_needs_index(sm: *Sema, e: *Expr, name_sv: StrView, kind: TypeKind) -> i32
    var name: *u8 = name_sv.ptr
    var len: i32 = name_sv.len as i32
    var n: *u8 = name
    var l: i32 = len
    if n == null
        n = primitive_name_from_type(kind)
        if n == null
            return 0
        l = strlen(n) as i32
    ir_at_bracket(sm, e)
    si_eprint_needs_index(StrView { ptr: (n), len: (l) as i64 })
    1

# 1 when a struct of this name has something to index: a Vec, Span or String,
# or one that implements `Index`.  An unknown name is given the benefit.
fn ir_struct_indexes(sm: *Sema, name_sv: StrView) -> i32
    var name: *u8 = name_sv.ptr
    var len: i32 = name_sv.len as i32
    if name == null or len <= 0 or name_is_indexable(name_sv) == 1
        return 1
    ((si_traits(sm.module, name_sv) & SI_INDEX) != 0) as i32

# `p[i]`, `p` a local `@T` / `@&T` whose T is no array, Vec, Span or String:
# a reference is one value (LARB R9, AGAST #2440).  `(*q)[i]` names what is
# behind the reference, so it isn't one of these.
fn ir_reference_refused(sm: *Sema, e: *Expr) -> i32
    var t: SemaTy
    var lent: *Param = null
    let v: *SemaVar = ir_local(sm, e.left, @t, @lent)
    if v == null
        return 0
    if t.kind != TypeKind.Ref and t.kind != TypeKind.MutRef
        return 0
    if t.pointee == TypeKind.Array
        return 0
    if t.pointee == TypeKind.Struct and name_is_indexable(t.name) == 1
        return 0
    sema_error_at(sm, e.span.line, e.span.col)
    eprints("a reference is one value, not a buffer: `[]` needs an array, Vec, Span or String behind it\n")
    1

# AGAST #2452: `x[i][j]`, `e`, with `x[i]` an element of a local `[N]T`, of a
# `*[N]T`'s view, or of a Vec, Span or String (or a pointer to one) that has
# nothing to index: a scalar, or a struct without `Index`.  An element that is
# a pointer is a raw buffer, and one that's a Vec, Span or String indexes
# (#2442).  A scalar element Sema's typer names is index_scalar_check's
# (#3755, #3943), which reports first; these are the rest (a struct, and the
# bases rs_ty types where sema_expr_ty can't).
fn ir_element_refused(sm: *Sema, e: *Expr) -> i32
    let inner: *Expr = e.left
    if inner.right == null or inner.right.kind == ExprKind.Range
        return 0
    var root: *Expr = inner.left
    if root == null
        return 0
    var t: SemaTy
    var lent: *Param = null
    let v: *SemaVar = ir_local(sm, root, @t, @lent)
    if v != null and lent == null and t.kind == TypeKind.Array
        # An element of a local `[N]T`: a row of an N-D one indexes.
        var el: SemaTy
        let ek: TypeKind = sema_arr_elem(@t, @el)
        match ek
            TypeKind.Unknown | TypeKind.Array =>
                return 0
            TypeKind.Struct =>
                if ir_struct_indexes(sm, el.name) == 1
                    return 0
                return ir_needs_index(sm, e, el.name, TypeKind.Struct)
            _ => pass
        return ir_needs_index(sm, e, strview_empty(), ek)
    if v != null and lent == null
        # An element of the `[N]T` a `*[N]T` points at (its `p#` view).
        let view: TypeKind = sema_view_elem(sm, v)
        if view != TypeKind.Void
            if view == TypeKind.Struct
                if ir_struct_indexes(sm, v.type_name) == 1
                    return 0
                return ir_needs_index(sm, e, v.type_name, TypeKind.Struct)
            return ir_needs_index(sm, e, strview_empty(), view)
    # An element of a Vec, Span or String, or of what a pointer to one points
    # at: `v[i]`, `(*p)[i]`, `x.vf[i]`.
    let rk: ExprKind = root.kind
    if rk != ExprKind.Ident and rk != ExprKind.Member and (rk != ExprKind.Unary or root.op != OpKind.Deref)
        return 0
    if v == null and rs_ty(sm, root, @t) == 0
        return 0
    if rk == ExprKind.Ident and t.kind != TypeKind.Struct and (ref_is_pointer(t.kind) == 0 or t.pointee != TypeKind.Struct)
        return 0
    var k: TypeKind = TypeKind.Void
    var n: *u8 = null
    var l: i32 = 0
    if let_through_elem(sm, t.kind, t.pointee, t.name, @k, @n, @l) == 0
        return 0
    if k == TypeKind.Struct
        if n == null or l <= 0 or sema_find_struct(sm, StrView { ptr: (n), len: (l) as i64 }) == null or ir_struct_indexes(sm, StrView { ptr: (n), len: (l) as i64 }) == 1
            return 0
        return ir_needs_index(sm, e, StrView { ptr: (n), len: (l) as i64 }, TypeKind.Struct)
    ir_needs_index(sm, e, strview_empty(), k)

# AGAST #3132: `(*p)[i]`, `e`, with `p` a local `*T` and T a struct without
# `Index` or a sized scalar: `*p` is one T, with nothing to index.  A
# `p:& *T` param is the same.  A `*[N]T`, `**T` or `*Vec<T>` isn't this shape
# (#2330, #2537, #2331), and an i64 `*p` may hold a pointer.
fn ir_deref_pointee_refused(sm: *Sema, e: *Expr) -> i32
    var t: SemaTy
    var lent: *Param = null
    if ir_local(sm, e.left.operand, @t, @lent) == null
        return 0
    if t.kind != TypeKind.Ptr or t.pointee == TypeKind.Array
        return 0
    if t.pointee == TypeKind.Struct
        if t.name.ptr == null or t.name.len == 0 or name_is_indexable(t.name) == 1
            return 0
        if si_is_struct(sm.module, t.name) == 0 or ir_struct_indexes(sm, t.name) == 1
            return 0
        return ir_needs_index(sm, e, t.name, TypeKind.Struct)
    if ir_sized_scalar(t.pointee) == 0
        return 0
    ir_needs_index(sm, e, strview_empty(), t.pointee)

# `e`, an ExprKind.Index read or store target.  sema_walk_expr calls this for
# every index it visits, after index_scalar_check.  A slice (`p[a..b]`) meets
# the reference rule only, as index_refused had it.
pub fn index_refuse_check(sm: *Sema, e: *Expr)
    if e == null or e.kind != ExprKind.Index or e.left == null or e.right == null
        return
    let b: *Expr = e.left
    if b.kind == ExprKind.Ident
        ir_reference_refused(sm, e)
    else if e.right.kind == ExprKind.Range
        return
    else if b.kind == ExprKind.Index
        ir_element_refused(sm, e)
    else if b.kind == ExprKind.Unary and b.op == OpKind.Deref
        ir_deref_pointee_refused(sm, e)

# `p[i] = v` / `p[i] op= v`, a StmtKind.IndexAssign on the name st.assign_target,
# index st.while_cond, `[` at st.bracket: index_refuse_check on that target.
pub fn index_refuse_name_store(sm: *Sema, st: *Stmt)
    var root: Expr
    var target: Expr
    memset(@root as *u8, 0, sizeof(Expr))
    memset(@target as *u8, 0, sizeof(Expr))
    root.kind = ExprKind.Ident
    root.span = st.span
    root.ident = st.assign_target
    target.kind = ExprKind.Index
    target.span = st.span
    target.bracket = st.bracket
    target.left = @root
    target.right = st.while_cond
    index_refuse_check(sm, @target)
    index_whole_array_check(sm, @target, st)

# AGAST #2452 / #2885: `*v`, `d`, with `v` a local struct or sized scalar by
# value: there is no pointer to follow.  An i64 or u64 local may hold a
# pointer, and an integer `:&` borrow binds as a plain T, so neither is
# refused.  ritz0 says the same, from array_rules.NOT_A_POINTER: of a `.`'s
# or a method's receiver too, `(*v).f` / `(*v).m()`, which the emitter never
# refused ("unhandled EXPR_MEMBER", "cannot determine receiver type").
pub fn deref_value_check(sm: *Sema, d: *Expr)
    if d == null or d.kind != ExprKind.Unary or d.op != OpKind.Deref
        return
    var t: SemaTy
    var lent: *Param = null
    if ir_local(sm, d.operand, @t, @lent) == null or lent != null
        return
    if t.kind != TypeKind.Struct and ir_sized_scalar(t.kind) == 0
        return
    sema_error_at(sm, d.span.line, d.span.col)
    eprints("`*x` needs `x` to be a pointer or a reference: this one is a value\n")

# AGAST #2330: `p[i] = b`, `target` the store's ExprKind.Index (`p[i]` or
# `(*p)[i]`) and `st` the assignment, with `p` a local `*[N]T`, `@[N]T` or
# `@&[N]T` the emitter views (add_array_view) and `b` a whole array.  `p[i]`
# is one T (LARB R9); ritz0 stored `b` a row on.  ritz0 says the same, from
# array_rules.ELEMENT_NOT_ARRAY.
pub fn index_whole_array_check(sm: *Sema, target: *Expr, st: *Stmt)
    let value: *Expr = st.assign_value
    if target == null or target.kind != ExprKind.Index or target.left == null or value == null
        return
    if target.right == null or target.right.kind == ExprKind.Range
        return
    var root: *Expr = target.left
    if root.kind == ExprKind.Unary and root.op == OpKind.Deref
        root = root.operand
    if root == null or root.kind != ExprKind.Ident
        return
    let v: *SemaVar = sema_find_local(sm, root.ident)
    if v == null or sema_view_elem(sm, v) == TypeKind.Void
        return
    let literal: i32 = (value.kind == ExprKind.ArrayLit or value.kind == ExprKind.ArrayFill) as i32
    if literal == 0 and sema_expr_type(sm, value) != TypeKind.Array
        return
    sema_error_at(sm, st.span.line, st.span.col)
    eprints("`p[i]` is one element of the array behind `p`, not the whole array: `*p = a` stores the array\n")
