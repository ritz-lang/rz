# ritz1/src/float_slot.ritz - a number into a float slot: only where exact
#
# AGAST #2945, LANGUAGE_SPEC §7.5 "Integer and float conversions".
#
#     let x: u32 = 4000000000
#     let d: f64 = x          # 4e9, by uitofp; sitofp would read the top bit
#     let e: f64 = big_i64    # error: write `big_i64 as f64`
#
# A non-literal integer converts implicitly into an f32 / f64 slot (a let/var
# initialiser, an assignment, an argument, a return, a field) only when every
# value of its type is exact there: f64 takes i8 i16 i32 u8 u16 u32, f32 takes
# i8 i16 u8 u16.  It converts by its own signedness.  Every other pair is an
# error asking for `as`.  A literal is exempt.
#
# This is ritz0's `_int_into_float_slot`, and ritz0/test_implicit_int_to_float.py
# feeds the same programs to both; the words are ritz0/float_rules.py's.  The
# source type comes from narrowing.ritz's narrow_src_type, which answers
# NARROW_UNKNOWN when unsure: then the value converts as before (sitofp of the
# i64 register) and nothing is refused, so a gap here is a missed refusal,
# never a refused program ritz0 accepts.
#
# WHERE IT RUNS (AGAST #3510, #1816).  The source type is a type fact, so
# Sema finds it: float_slot_check runs at each f32 / f64 slot literal_slot.ritz
# visits, refuses an inexact source there, and annotates a value whose exact
# source is unsigned (float_slot_note).  The emitter's emit_int_into_float_slot
# only reads that annotation to pick `uitofp` over `sitofp`.
#
# A POINTER IN A FLOAT SLOT (AGAST #3626, on Sema since #3892).  LARB R1 / R4,
# LANGUAGE_SPEC §7.5: nothing but a number lands in an f32 / f64.  Sema refuses
# a value sema_bool_kind is sure is a pointer, in ritz0's words ("cannot use a
# pointer as a float", _reject_pointer_into_float), at the value: in every
# slot float_slot_check sees, and in an if / match with no float slot whose
# arms Sema types as float (float_arm_note), as one beside a float arm.
# ritz0/test_let_float_pointer.py feeds the same programs to all three.

import ritzlib.sys
import ritzlib.io
import ritzlib.hashmap
import ritzlib.memory

import ast
import types           # the one primitive type table (AGAST #1889)
import ast_helpers
import narrowing
import bool_check
import sema
import sema_type   # sema_expr_ty: what a pointer points at

# Is `e` built from integer literals alone (`4000000000`, `-3`, `2 * 3`)?
# ritz0's _int_literal_only.
pub fn fs_literal_only(e: *Expr) -> i32
    if e == null
        return 0
    if e.kind == EXPR_INT_LIT or e.kind == EXPR_CHAR_LIT
        return 1
    if e.kind == EXPR_UNARY and (e.op == OP_NEG or e.op == OP_BIT_NOT)
        return fs_literal_only(e.operand)
    if e.kind == EXPR_BINARY and narrow_is_arith_op(e.op) == 1
        if fs_literal_only(e.left) == 1 and fs_literal_only(e.right) == 1
            return 1
    0

# Where a value is reported: ritz0's _value_span (a binary at its left
# operand, a cast at its operand).
fn fs_report_at(e: *Expr) -> *Expr
    var at: *Expr = e
    while at.kind == EXPR_BINARY or at.kind == EXPR_CAST
        at = at.left
    at

# Is every value of integer type `src` exact in float type `dst`?
fn fs_exact(src: i32, dst: i32) -> i32
    let bits: i32 = ty_bits(src)
    if dst == TYPE_F64
        return if bits <= 32 then 1 else 0
    if bits <= 16 then 1 else 0

# ---- An f64 into an f32 slot (LARB R70, AGAST #3998) ----
#
# §7.5 "Float narrowing": an f64 value into an f32 slot is the same error as
# an inexact integer into a float, asking for `as f32` (the message below is
# ritz0's float_rules.f64_into_f32).  Exempt: a float literal, and a constant
# expression of them (`0.1`, `0.0 - 7.5`, `-(1.0 / 4.0)`), evaluated as f64
# and rounded once.  f32 into f64 stays implicit.  Where Sema cannot type the
# value it accepts rather than guesses (§7.5, as the integer rule above).

# Is `e` a float literal, or a constant expression of float literals?  ritz0's
# _float_literal_only, including an if / match whose every arm is one.  An
# integer literal counts: it is a float's when the other operand is.
fn fs_float_literal_only(e: *Expr) -> i32
    if e == null
        return 0
    if e.kind == EXPR_FLOAT_LIT or e.kind == EXPR_INT_LIT
        return 1
    if e.kind == EXPR_UNARY and e.op == OP_NEG
        return fs_float_literal_only(e.operand)
    if e.kind == EXPR_BINARY
        if e.op == OP_ADD or e.op == OP_SUB or e.op == OP_MUL or e.op == OP_DIV or e.op == OP_MOD
            if fs_float_literal_only(e.left) == 1 and fs_float_literal_only(e.right) == 1
                return 1
        return 0
    if e.kind == EXPR_IF or e.kind == EXPR_MATCH
        return fs_float_arms_literal_only(e.args as *MatchArm)
    0

# 1 when every value arm of `arm` is a float literal / constant expression.
# An if / match expression always has one, and no arms at all is read as
# literal too: that misses a refusal rather than inventing one.
fn fs_float_arms_literal_only(arm: *MatchArm) -> i32
    var a: *MatchArm = arm
    while a != null
        if a.is_pass == 0 and a.body != null
            if fs_float_literal_only(a.body) == 0
                return 0
        a = a.next
    1

# The float width (TYPE_F32 / TYPE_F64) of `e` as a value, or 0 when Sema
# cannot say.  An if / match takes the width of its non-literal arms: a float
# literal arm takes the other sides' width (§7.1), so it is a wildcard.
pub fn float_slot_src(sm: *Sema, e: *Expr) -> i32
    if e == null
        return 0
    if e.kind == EXPR_IF or e.kind == EXPR_MATCH
        return fs_float_merge(sm, e.args as *MatchArm)
    if e.kind == EXPR_IDENT
        let v: *SemaVar = sema_find_local(sm, e.ident_ptr, e.ident_len)
        if v != null
            if v.kind == TYPE_F32 or v.kind == TYPE_F64
                return v.kind
            if v.float_src == TYPE_F32 or v.float_src == TYPE_F64
                return v.float_src
    # An integer literal operand leaves the expression untyped here (`y * 2`),
    # and that is a gap, not a guess; a float literal is exempt above.
    let t: i32 = sema_expr_type(sm, e)
    if t == TYPE_F32 or t == TYPE_F64
        return t
    0

# The float width an if / match yields, from its non-literal arms (f32 with
# f64 widens to f64).  0 when none is a typed float.
fn fs_float_merge(sm: *Sema, arm: *MatchArm) -> i32
    var merged: i32 = TYPE_VOID
    var a: *MatchArm = arm
    while a != null
        if a.is_pass == 0 and a.body != null
            if fs_float_literal_only(a.body) == 0
                let w: i32 = float_slot_src(sm, a.body)
                if w == 0
                    return 0
                if merged == TYPE_VOID
                    merged = w
                else if merged != w
                    merged = TYPE_F64
        a = a.next
    merged

# `value`, of wider number type `src`, lands in float slot `dst`: the located
# error both rules share, in ritz0's words (float_rules).  `line` > 0 reports
# at `line:1` -- a match arm's Block span in ritz0 (AGAST #4439) -- else at the
# value.
fn fs_report_narrow_at(sm: *Sema, value: *Expr, src: i32, dst: i32, line: i32)
    if line > 0
        if bool_sema_report_line(sm, line) == 0
            return
    else if bool_sema_report_at(sm, fs_report_at(value)) == 0
        return
    eprints_cstr(c"implicit conversion from `")
    eprints_cstr(ty_name(src))
    eprints_cstr(c"` to `")
    eprints_cstr(c_float_name(dst))
    eprints_cstr(c"` can lose precision: write `<expr> as ")
    eprints_cstr(c_float_name(dst))
    eprints_cstr(c"`\n")

fn fs_report_narrow(sm: *Sema, value: *Expr, src: i32, dst: i32)
    fs_report_narrow_at(sm, value, src, dst, 0)

# `value`, of float type where narrow_sema_src_type answered NARROW_UNKNOWN,
# lands in float slot `dst`: refuse an f64 value in an f32 slot (LARB R70).
fn fs_float_narrow_check(sm: *Sema, value: *Expr, dst: i32)
    if dst != TYPE_F32 or fs_float_literal_only(value) == 1
        return
    if float_slot_src(sm, value) == TYPE_F64
        fs_report_narrow(sm, value, TYPE_F64, TYPE_F32)

# fs_float_narrow_check with `value`'s type already known: from the declaration
# its block tail names (`src`), which `float_slot_src` cannot recover once the
# block scope has closed (#4439).  `line` > 0 is the arm Block to report at.
fn fs_float_narrow_check_at(sm: *Sema, value: *Expr, src: i32, dst: i32, line: i32)
    if line == 0
        fs_float_narrow_check(sm, value, dst)
        return
    if dst != TYPE_F32 or fs_float_literal_only(value) == 1
        return
    var w: i32 = src
    if w != TYPE_F64
        w = float_slot_src(sm, value)
    if w == TYPE_F64
        fs_report_narrow_at(sm, value, TYPE_F64, TYPE_F32, line)

# Sema's annotation: the values landing in a float slot whose source type is
# an unsigned integer exact there (u8 / u16 / u32), keyed by the Expr, mapped
# to that type.  Absent means signed or unknown: `sitofp`, as before.
var g_fs_unsigned: *HashMapI64 = null
var g_fs_ready: i32 = 0

fn float_slot_note(value: *Expr, src: i32)
    if g_fs_ready == 0
        g_fs_unsigned = malloc(sizeof(HashMapI64)) as *HashMapI64
        *g_fs_unsigned = hashmap_i64_with_cap(256)
        g_fs_ready = 1
    hashmap_i64_insert(@&(*g_fs_unsigned), value as i64, src as i64)

# The unsigned source type Sema noted for `value`, or 0.
pub fn float_slot_unsigned(value: *Expr) -> i32
    if g_fs_ready == 0 or value == null
        return 0
    hashmap_i64_get(@(*g_fs_unsigned), value as i64) as i32

# `value` lands in an f32 / f64 slot of type `dst` (a Sema check, AGAST #3510):
# refuse an inexact integer source (see the header), and note an unsigned one.
pub fn float_slot_check(sm: *Sema, value: *Expr, dst: i32)
    float_slot_check_at(sm, value, dst, 0)

# float_slot_check, with a `line` > 0 to report a float narrowing at (a match
# arm's Block, AGAST #4439).
pub fn float_slot_check_at(sm: *Sema, value: *Expr, dst: i32, line: i32)
    if value == null or float_slot_pointer(sm, value, dst) == 1 or fs_literal_only(value) == 1
        return
    float_slot_judge_at(sm, value, narrow_sema_src_type(sm, value), dst, line)

# `value`, of integer type `src` (or NARROW_*), lands in a float slot `dst`.
pub fn float_slot_judge(sm: *Sema, value: *Expr, src: i32, dst: i32)
    float_slot_judge_at(sm, value, src, dst, 0)

# float_slot_judge, with a `line` > 0 to report a float narrowing at: the
# match arm's Block whose tail named a block-local declaration (#4439).
pub fn float_slot_judge_at(sm: *Sema, value: *Expr, src: i32, dst: i32, line: i32)
    # A float source narrows only from f64 to f32 (LARB R70, AGAST #3998);
    # narrow_sema_src_type types integers alone, so a float reaches the first
    # arm as NARROW_UNKNOWN and is typed here.
    if src == TYPE_F32
        return
    if src == TYPE_F64 or src == NARROW_UNKNOWN or src == NARROW_LIT or ty_bits(src) <= 1
        fs_float_narrow_check_at(sm, value, src, dst, line)
        return
    if fs_exact(src, dst) == 0
        fs_report_narrow(sm, value, src, dst)
        return
    if ty_is_unsigned(src) == 1
        float_slot_note(value, src)

# The slot is known where it is declared, but an arm's value may name the
# arm's binding (`Some(x) => x`), in scope only while the walk is inside the
# arm: so literal_slot defers the check to the value (float_slot_defer), and
# sema_walk runs it when it reaches that value (float_slot_due), with the
# bindings it sees then, as the emitter did.
var g_fs_pending: *HashMapI64 = null
var g_fs_pending_ready: i32 = 0

# A deferred slot packs its type in the low bits and, above them, the match
# arm Block line to report at (AGAST #4439; 0 reports at the value).
const FS_DST_MASK: i64 = 65535
const FS_LINE_SHIFT: i64 = 16

pub fn float_slot_defer(value: *Expr, dst: i32)
    float_slot_defer_at(value, dst, 0)

pub fn float_slot_defer_at(value: *Expr, dst: i32, line: i32)
    if value == null
        return
    if g_fs_pending_ready == 0
        g_fs_pending = malloc(sizeof(HashMapI64)) as *HashMapI64
        *g_fs_pending = hashmap_i64_with_cap(256)
        g_fs_pending_ready = 1
    let key: i64 = (dst as i64) | ((line as i64) << FS_LINE_SHIFT)
    hashmap_i64_insert(@&(*g_fs_pending), value as i64, key)

# `e` is about to be walked: run the check deferred to it, if any.
pub fn float_slot_due(sm: *Sema, e: *Expr)
    if g_fs_pending_ready == 0
        return
    let key: i64 = hashmap_i64_get(@(*g_fs_pending), e as i64)
    if key != 0
        hashmap_i64_remove(@&(*g_fs_pending), e as i64)
        let dst: i32 = (key & FS_DST_MASK) as i32
        let line: i32 = (key >> FS_LINE_SHIFT) as i32
        float_slot_check_at(sm, e, dst, line)

# `val_reg`, the i64 register integer expression `value` was emitted into,
# converted for an f32 / f64 slot of type `dst_ty` (see emit_int_into_float_slot
# in emitter_core, AGAST #4376: moved there so Sema's float_slot imports no
# emitter module).  Its callers pass float_slot_unsigned(value).

# ---- A pointer into a float (AGAST #3626, #3892; see the header) ----

# The pointer values already reported: a pointer arm of a nested if in a float
# slot is the slot's and its if's, and is said once.
var g_fs_ptr_said: *HashMapI64 = null
var g_fs_ptr_said_ready: i32 = 0

# 1 if pointer `value` was said already (or is another rule's to say), else
# 0 and it is now.
fn fs_pointer_said(value: *Expr) -> i32
    if g_fs_ptr_said_ready == 0
        g_fs_ptr_said = malloc(sizeof(HashMapI64)) as *HashMapI64
        *g_fs_ptr_said = hashmap_i64_with_cap(64)
        g_fs_ptr_said_ready = 1
    if hashmap_i64_get(@(*g_fs_ptr_said), value as i64) != 0
        return 1
    hashmap_i64_insert(@&(*g_fs_ptr_said), value as i64, 1)
    0

# Report `value`, a pointer landing in a float, once.
pub fn float_slot_pointer_at(sm: *Sema, value: *Expr)
    if fs_pointer_said(value) == 0 and bool_sema_report_at(sm, fs_report_at(value)) == 1
        eprints_cstr(c"cannot use a pointer as a float\n")

# 1 if `value`, landing in a float slot of type `dst`, is surely a pointer:
# reported, unless it points at a `dst`.  `r` (`r: *f64` / `@f64`) in an f64
# slot is ref_check's "a reference or pointer doesn't fit a by-value slot:
# write `*` to read through it", as in ritz0 (test_ref_into_value.py): noted
# as said, so its if / match (float_arms_settle) leaves it to ref_check too.
pub fn float_slot_pointer(sm: *Sema, value: *Expr, dst: i32) -> i32
    if sema_bool_kind(sm, value) != BK_PTR
        return 0
    var t: SemaTy
    var pointee: i32 = TYPE_VOID
    let k: i32 = sema_expr_ty(sm, value, @t)
    if k == TYPE_PTR or k == TYPE_REF or k == TYPE_MUT_REF
        pointee = t.pointee
    float_slot_pointer_to(sm, value, pointee, dst)
    1

# float_slot_pointer for a `value` known to point at `pointee` (TYPE_VOID if
# unknown).
pub fn float_slot_pointer_to(sm: *Sema, value: *Expr, pointee: i32, dst: i32)
    if pointee == dst
        fs_pointer_said(value)
    else
        float_slot_pointer_at(sm, value)

# An if / match's arms, judged in each arm's scope as the walk leaves it
# (float_arm_note), then settled once all are (float_arms_settle): the if /
# matches with a float arm, and the arm values that are pointers.
var g_fs_float_owner: *HashMapI64 = null   # EXPR_IF / EXPR_MATCH -> 1: an arm is a float
var g_fs_ptr_arm: *HashMapI64 = null       # arm value -> 1: a pointer
var g_fs_arms_ready: i32 = 0

fn fs_arms_init()
    if g_fs_arms_ready == 0
        g_fs_float_owner = malloc(sizeof(HashMapI64)) as *HashMapI64
        *g_fs_float_owner = hashmap_i64_with_cap(64)
        g_fs_ptr_arm = malloc(sizeof(HashMapI64)) as *HashMapI64
        *g_fs_ptr_arm = hashmap_i64_with_cap(64)
        g_fs_arms_ready = 1

# The walk just left `arm` of `owner` (an EXPR_IF / EXPR_MATCH), with the
# arm's bindings and `let`s still in scope.  A nested if / match arm is a
# float when one of its own arms is (it was settled first); it is never a
# pointer arm here: its own pointer arm is its own.
pub fn float_arm_note(sm: *Sema, owner: *Expr, arm: *MatchArm)
    if owner == null or arm.is_pass != 0 or arm.body == null
        return
    fs_arms_init()
    let v: *Expr = arm.body
    if v.kind == EXPR_IF or v.kind == EXPR_MATCH
        if hashmap_i64_get(@(*g_fs_float_owner), v as i64) != 0
            hashmap_i64_insert(@&(*g_fs_float_owner), owner as i64, 1)
        return
    let k: i32 = sema_bool_kind(sm, v)
    if k == BK_FLOAT
        hashmap_i64_insert(@&(*g_fs_float_owner), owner as i64, 1)
    else if k == BK_PTR
        hashmap_i64_insert(@&(*g_fs_ptr_arm), v as i64, 1)

# Every arm of `owner` was noted: with a float arm, each pointer arm, on
# either side of it, is refused (as LARB R43 refuses an integer arm).
pub fn float_arms_settle(sm: *Sema, owner: *Expr, arms: *MatchArm)
    if owner == null or g_fs_arms_ready == 0
        return
    if hashmap_i64_get(@(*g_fs_float_owner), owner as i64) == 0
        return
    var arm: *MatchArm = arms
    while arm != null
        if arm.is_pass == 0 and arm.body != null and hashmap_i64_get(@(*g_fs_ptr_arm), arm.body as i64) != 0
            float_slot_pointer_at(sm, arm.body)
        arm = arm.next

fn c_float_name(t: i32) -> *u8
    if t == TYPE_F32
        return c"f32"
    c"f64"
