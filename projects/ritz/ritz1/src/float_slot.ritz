# ritz1/src/float_slot.ritz - a number into a float slot: only where exact
#
# AGAST #2945, LANGUAGE_SPEC §7.5 "Integer and float conversions".
#
#     let x: u32 = 4000000000
#     let d: f64 = x          # 4e9, by uitofp; sitofp would read the top bit
#     let e: f64 = big_i64    # error: write `big_i64 as f64`
#
# A non-literal integer converts implicitly into an f32 / f64 slot (a let/var
# initialiser, an assignment, an argument, a return, a field) only when every
# value of its type is exact there: f64 takes i8 i16 i32 u8 u16 u32, f32 takes
# i8 i16 u8 u16.  It converts by its own signedness.  Every other pair is an
# error asking for `as`.  A literal is exempt.
#
# This is ritz0's `_int_into_float_slot`, and ritz0/test_implicit_int_to_float.py
# feeds the same programs to both; the words are ritz0/float_rules.py's.  The
# source type comes from narrowing.ritz's narrow_src_type, which answers
# TypeKind.NarrowUnknown when unsure: then the value converts as before (sitofp of the
# i64 register) and nothing is refused, so a gap here is a missed refusal,
# never a refused program ritz0 accepts.
#
# WHERE IT RUNS (AGAST #3510, #1816).  The source type is a type fact, so
# Sema finds it: float_slot_check runs at each f32 / f64 slot literal_slot.ritz
# visits, refuses an inexact source there, and annotates a value whose exact
# source is unsigned (float_slot_note).  The emitter's emit_int_into_float_slot
# only reads that annotation to pick `uitofp` over `sitofp`.
#
# A POINTER IN A FLOAT SLOT (AGAST #3626, on Sema since #3892).  LARB R1 / R4,
# LANGUAGE_SPEC §7.5: nothing but a number lands in an f32 / f64.  Sema refuses
# a value sema_bool_kind is sure is a pointer, in ritz0's words ("cannot use a
# pointer as a float", _reject_pointer_into_float), at the value: in every
# slot float_slot_check sees, and in an if / match with no float slot whose
# arms Sema types as float (float_arm_note), as one beside a float arm.
# ritz0/test_let_float_pointer.py feeds the same programs to all three.

import ritzlib.cstr
import ritzlib.sys
import ritzlib.io
import ritzlib.hashmap
import ritzlib.memory

import ast
import types           # the one primitive type table (AGAST #1889)
import ast_helpers
import ast_query   # name_eq
import narrowing
import bool_check
import sema
import sema_type   # sema_expr_ty: what a pointer points at

# Is `e` built from integer literals alone (`4000000000`, `-3`, `2 * 3`)?
# ritz0's _int_literal_only.
pub fn fs_literal_only(e: *Expr) -> i32
    if e == null
        return 0
    if e.kind == ExprKind.IntLit or e.kind == ExprKind.CharLit
        return 1
    if e.kind == ExprKind.Unary and (e.op == OpKind.Neg or e.op == OpKind.BitNot)
        return fs_literal_only(e.operand)
    if e.kind == ExprKind.Binary and narrow_is_arith_op(e.op) == 1
        if fs_literal_only(e.left) == 1 and fs_literal_only(e.right) == 1
            return 1
    0

# Where a value is reported: ritz0's _value_span (a binary at its left
# operand, a cast at its operand).
fn fs_report_at(e: *Expr) -> *Expr
    var at: *Expr = e
    while at.kind == ExprKind.Binary or at.kind == ExprKind.Cast
        at = at.left
    at

# Is every value of integer type `src` exact in float type `dst`?
fn fs_exact(src: TypeKind, dst: TypeKind) -> i32
    let bits: i32 = ty_bits(src)
    if dst == TypeKind.F64
        return if bits <= 32 then 1 else 0
    if bits <= 16 then 1 else 0

# ---- An f64 into an f32 slot (LARB R70, AGAST #3998) ----
#
# §7.5 "Float narrowing": an f64 value into an f32 slot is the same error as
# an inexact integer into a float, asking for `as f32` (the message below is
# ritz0's float_rules.f64_into_f32).  Exempt: a float literal, and a constant
# expression of them (`0.1`, `0.0 - 7.5`, `-(1.0 / 4.0)`), evaluated as f64
# and rounded once.  f32 into f64 stays implicit.  Where Sema cannot type the
# value it accepts rather than guesses (§7.5, as the integer rule above).

# Is `e` a float literal, or a constant expression of float literals?  ritz0's
# _float_literal_only, including an if / match whose every arm is one.  An
# integer literal counts: it is a float's when the other operand is.
fn fs_float_literal_only(e: *Expr) -> i32
    if e == null
        return 0
    if e.kind == ExprKind.FloatLit or e.kind == ExprKind.IntLit
        return 1
    if e.kind == ExprKind.Unary and e.op == OpKind.Neg
        return fs_float_literal_only(e.operand)
    match e.kind
        ExprKind.Binary =>
            if e.op == OpKind.Add or e.op == OpKind.Sub or e.op == OpKind.Mul or e.op == OpKind.Div or e.op == OpKind.Mod
                if fs_float_literal_only(e.left) == 1 and fs_float_literal_only(e.right) == 1
                    return 1
            return 0
        ExprKind.If | ExprKind.Match =>
            return fs_float_arms_literal_only(e.args as *MatchArm)
        _ => pass
    0

# 1 when every value arm of `arm` is a float literal / constant expression.
# An if / match expression always has one, and no arms at all is read as
# literal too: that misses a refusal rather than inventing one.
fn fs_float_arms_literal_only(arm: *MatchArm) -> i32
    var a: *MatchArm = arm
    while a != null
        if a.is_pass == 0 and a.body != null
            if fs_float_literal_only(a.body) == 0
                return 0
        a = a.next
    1

# The float width (TypeKind.F32 / TypeKind.F64) of `e` as a value, or 0 when Sema
# cannot say.  An if / match takes the width of its non-literal arms: a float
# literal arm takes the other sides' width (§7.1), so it is a wildcard.
pub fn float_slot_src(sm: *Sema, e: *Expr) -> TypeKind
    if e == null
        return TypeKind.Void
    if e.kind == ExprKind.If or e.kind == ExprKind.Match
        return fs_float_merge(sm, e.args as *MatchArm)
    if e.kind == ExprKind.Ident
        let v: *SemaVar = sema_find_local(sm, e.ident)
        if v != null
            if v.kind == TypeKind.F32 or v.kind == TypeKind.F64
                return v.kind
            if v.float_src == TypeKind.F32 or v.float_src == TypeKind.F64
                return v.float_src
    # An integer literal operand leaves the expression untyped here (`y * 2`),
    # and that is a gap, not a guess; a float literal is exempt above.
    let t: TypeKind = sema_expr_type(sm, e)
    if t == TypeKind.F32 or t == TypeKind.F64
        return t
    TypeKind.Void

# The float width an if / match yields, from its non-literal arms (f32 with
# f64 widens to f64).  0 when none is a typed float.
fn fs_float_merge(sm: *Sema, arm: *MatchArm) -> TypeKind
    var merged: TypeKind = TypeKind.Void
    var a: *MatchArm = arm
    while a != null
        if a.is_pass == 0 and a.body != null
            if fs_float_literal_only(a.body) == 0
                let w: TypeKind = float_slot_src(sm, a.body)
                if w == TypeKind.Void
                    return TypeKind.Void
                if merged == TypeKind.Void
                    merged = w
                else if merged != w
                    merged = TypeKind.F64
        a = a.next
    merged

# `value`, of wider number type `src`, lands in float slot `dst`: the located
# error both rules share, in ritz0's words (float_rules).  `line` > 0 reports
# at `line:col`, else `line:1` (an arm's Block, whose span ritz0 reports as its
# first line, column 1, AGAST #4439); with no line, at the value.  An `if`
# expression is reported at itself, column and all (AGAST #4441).
fn fs_report_narrow_at(sm: *Sema, value: *Expr, src: TypeKind, dst: TypeKind, line: i32, col: i32)
    if line > 0
        if col > 0
            if bool_sema_report_pos(sm, line, col) == 0
                return
        else if bool_sema_report_line(sm, line) == 0
            return
    else if bool_sema_report_at(sm, fs_report_at(value)) == 0
        return
    eprints("implicit conversion from `")
    eprints(ty_name(src))
    eprints("` to `")
    eprints(c_float_name(dst))
    eprints("` can lose precision: write `<expr> as ")
    eprints(c_float_name(dst))
    eprints("`\n")

fn fs_report_narrow(sm: *Sema, value: *Expr, src: TypeKind, dst: TypeKind)
    fs_report_narrow_at(sm, value, src, dst, 0, 0)

# `value`, of float type where narrow_sema_src_type answered TypeKind.NarrowUnknown,
# lands in float slot `dst`: refuse an f64 value in an f32 slot (LARB R70).
# `src` is the type a block tail's declaration gave it (#4439, #4441), or
# NARROW_* when only the value can say.  `line` > 0 is the place to report at,
# as fs_report_narrow_at takes it.
fn fs_float_narrow_check_at(sm: *Sema, value: *Expr, src: TypeKind, dst: TypeKind, line: i32, col: i32)
    if dst != TypeKind.F32 or fs_float_literal_only(value) == 1
        return
    # A known source decides it; only when Sema has none (NARROW_*) does the
    # value have to answer for itself, which it can't once its scope closes.
    var w: TypeKind = src
    if w != TypeKind.F64
        w = float_slot_src(sm, value)
    if w == TypeKind.F64
        fs_report_narrow_at(sm, value, TypeKind.F64, TypeKind.F32, line, col)

# Sema's annotation: the values landing in a float slot whose source type is
# an unsigned integer exact there (u8 / u16 / u32), keyed by the Expr, mapped
# to that type.  Absent means signed or unknown: `sitofp`, as before.
var g_fs_unsigned: *HashMapI64 = null
var g_fs_ready: i32 = 0

fn float_slot_note(value: *Expr, src: TypeKind)
    if g_fs_ready == 0
        g_fs_unsigned = malloc(sizeof(HashMapI64)) as *HashMapI64
        *g_fs_unsigned = hashmap_i64_with_cap(256)
        g_fs_ready = 1
    (*g_fs_unsigned).insert(value as i64, src as i64)

# The unsigned source type Sema noted for `value`, or 0.
pub fn float_slot_unsigned(value: *Expr) -> i32
    if g_fs_ready == 0 or value == null
        return 0
    (*g_fs_unsigned).get(value as i64).unwrap_or(0) as i32

# `value` lands in an f32 / f64 slot of type `dst` (a Sema check, AGAST #3510):
# refuse an inexact integer source (see the header), and note an unsigned one.
pub fn float_slot_check(sm: *Sema, value: *Expr, dst: TypeKind)
    float_slot_check_at(sm, value, dst, 0, 0)

# float_slot_check, with a `line` > 0 to report a float narrowing at: an arm's
# Block (AGAST #4439), or an `if` expression's own line and column (#4441).
pub fn float_slot_check_at(sm: *Sema, value: *Expr, dst: TypeKind, line: i32, col: i32)
    if value == null or float_slot_pointer(sm, value, dst) == 1 or fs_literal_only(value) == 1
        return
    float_slot_judge_at(sm, value, narrow_sema_src_type(sm, value), dst, line, col)

# `value`, of integer type `src` (or NARROW_*), lands in a float slot `dst`.
pub fn float_slot_judge(sm: *Sema, value: *Expr, src: TypeKind, dst: TypeKind)
    float_slot_judge_at(sm, value, src, dst, 0, 0)

# float_slot_judge, with a `line` > 0 to report a float narrowing at: the
# match arm's Block whose tail named a block-local declaration (#4439), or the
# `if` expression itself, column and all (#4441).
pub fn float_slot_judge_at(sm: *Sema, value: *Expr, src: TypeKind, dst: TypeKind, line: i32, col: i32)
    # A float source narrows only from f64 to f32 (LARB R70, AGAST #3998);
    # narrow_sema_src_type types integers alone, so a float reaches the first
    # arm as TypeKind.NarrowUnknown and is typed here.
    if src == TypeKind.F32
        return
    if src == TypeKind.F64 or src == TypeKind.NarrowUnknown or src == TypeKind.NarrowLit or ty_bits(src) <= 1
        fs_float_narrow_check_at(sm, value, src, dst, line, col)
        return
    if fs_exact(src, dst) == 0
        fs_report_narrow(sm, value, src, dst)
        return
    if ty_is_unsigned(src) == 1
        float_slot_note(value, src)

# The slot is known where it is declared, but an arm's value may name the
# arm's binding (`Some(x) => x`), in scope only while the walk is inside the
# arm: so literal_slot defers the check to the value (float_slot_defer), and
# sema_walk runs it when it reaches that value (float_slot_due), with the
# bindings it sees then, as the emitter did.
var g_fs_pending: *HashMapI64 = null
var g_fs_pending_ready: i32 = 0

# A deferred slot packs its type in the low bits and, above them, the place to
# report a narrowing at: the line, then the column (0 for either meaning "as
# before": no line reports at the value, no column at the line's column 1).
# AGAST #4439, #4441.
const FS_DST_MASK: i64 = 65535
const FS_LINE_SHIFT: i64 = 16
const FS_COL_SHIFT: i64 = 32

pub fn float_slot_defer(value: *Expr, dst: TypeKind)
    float_slot_defer_at(value, dst, 0, 0)

pub fn float_slot_defer_at(value: *Expr, dst: TypeKind, line: i32, col: i32)
    if value == null
        return
    if g_fs_pending_ready == 0
        g_fs_pending = malloc(sizeof(HashMapI64)) as *HashMapI64
        *g_fs_pending = hashmap_i64_with_cap(256)
        g_fs_pending_ready = 1
    let key: i64 = (dst as i64) | ((line as i64) << FS_LINE_SHIFT) | ((col as i64) << FS_COL_SHIFT)
    (*g_fs_pending).insert(value as i64, key)

# `e` is about to be walked: run the check deferred to it, if any.
pub fn float_slot_due(sm: *Sema, e: *Expr)
    if g_fs_pending_ready == 0
        return
    let key: i64 = (*g_fs_pending).get(e as i64).unwrap_or(0)
    if key != 0
        (*g_fs_pending).remove(e as i64)
        let dst: TypeKind = type_kind_of((key & FS_DST_MASK) as i32)
        let line: i32 = ((key >> FS_LINE_SHIFT) & FS_DST_MASK) as i32
        let col: i32 = ((key >> FS_COL_SHIFT) & FS_DST_MASK) as i32
        float_slot_check_at(sm, e, dst, line, col)

# `val_reg`, the i64 register integer expression `value` was emitted into,
# converted for an f32 / f64 slot of type `dst_ty` (see emit_int_into_float_slot
# in emitter_core, AGAST #4376: moved there so Sema's float_slot imports no
# emitter module).  Its callers pass float_slot_unsigned(value).

# ---- A pointer into a float (AGAST #3626, #3892; see the header) ----

# The pointer values already reported: a pointer arm of a nested if in a float
# slot is the slot's and its if's, and is said once.
var g_fs_ptr_said: *HashMapI64 = null
var g_fs_ptr_said_ready: i32 = 0

# 1 if pointer `value` was said already (or is another rule's to say), else
# 0 and it is now.
fn fs_pointer_said(value: *Expr) -> i32
    if g_fs_ptr_said_ready == 0
        g_fs_ptr_said = malloc(sizeof(HashMapI64)) as *HashMapI64
        *g_fs_ptr_said = hashmap_i64_with_cap(64)
        g_fs_ptr_said_ready = 1
    if (*g_fs_ptr_said).get(value as i64).unwrap_or(0) != 0
        return 1
    (*g_fs_ptr_said).insert(value as i64, 1)
    0

# Report `value`, a pointer landing in a float, once.
pub fn float_slot_pointer_at(sm: *Sema, value: *Expr)
    if fs_pointer_said(value) == 0 and bool_sema_report_at(sm, fs_report_at(value)) == 1
        eprints("cannot use a pointer as a float\n")

# 1 if `value`, landing in a float slot of type `dst`, is surely a pointer:
# reported, unless it points at a `dst`.  `r` (`r: *f64` / `@f64`) in an f64
# slot is ref_check's "a reference or pointer doesn't fit a by-value slot:
# write `*` to read through it", as in ritz0 (test_ref_into_value.py): noted
# as said, so its if / match (float_arms_settle) leaves it to ref_check too.
pub fn float_slot_pointer(sm: *Sema, value: *Expr, dst: TypeKind) -> i32
    if sema_bool_kind(sm, value) != BK_PTR
        return 0
    var t: SemaTy
    var pointee: TypeKind = TypeKind.Void
    let k: TypeKind = sema_expr_ty(sm, value, @t)
    if k == TypeKind.Ptr or k == TypeKind.Ref or k == TypeKind.MutRef
        pointee = t.pointee
    float_slot_pointer_to(sm, value, pointee, dst)
    1

# float_slot_pointer for a `value` known to point at `pointee` (TypeKind.Void if
# unknown).
pub fn float_slot_pointer_to(sm: *Sema, value: *Expr, pointee: TypeKind, dst: TypeKind)
    if pointee == dst
        fs_pointer_said(value)
    else
        float_slot_pointer_at(sm, value)

# An if / match's arms, judged in each arm's scope as the walk leaves it
# (float_arm_note), then settled once all are (float_arms_settle): the if /
# matches with a float arm, and the arm values that are pointers.
var g_fs_float_owner: *HashMapI64 = null   # ExprKind.If / ExprKind.Match -> 1: an arm is a float
var g_fs_ptr_arm: *HashMapI64 = null       # arm value -> 1: a pointer
var g_fs_arms_ready: i32 = 0

fn fs_arms_init()
    if g_fs_arms_ready == 0
        g_fs_float_owner = malloc(sizeof(HashMapI64)) as *HashMapI64
        *g_fs_float_owner = hashmap_i64_with_cap(64)
        g_fs_ptr_arm = malloc(sizeof(HashMapI64)) as *HashMapI64
        *g_fs_ptr_arm = hashmap_i64_with_cap(64)
        g_fs_arms_ready = 1

# The walk just left `arm` of `owner` (an ExprKind.If / ExprKind.Match), with the
# arm's bindings and `let`s still in scope.  A nested if / match arm is a
# float when one of its own arms is (it was settled first); it is never a
# pointer arm here: its own pointer arm is its own.
pub fn float_arm_note(sm: *Sema, owner: *Expr, arm: *MatchArm)
    if owner == null or arm.is_pass != 0 or arm.body == null
        return
    fs_arms_init()
    let v: *Expr = arm.body
    if v.kind == ExprKind.If or v.kind == ExprKind.Match
        if (*g_fs_float_owner).get(v as i64).unwrap_or(0) != 0
            (*g_fs_float_owner).insert(owner as i64, 1)
        return
    let k: i32 = sema_bool_kind(sm, v)
    if k == BK_FLOAT
        (*g_fs_float_owner).insert(owner as i64, 1)
    else if k == BK_PTR
        (*g_fs_ptr_arm).insert(v as i64, 1)

# Every arm of `owner` was noted: with a float arm, each pointer arm, on
# either side of it, is refused (as LARB R43 refuses an integer arm).
pub fn float_arms_settle(sm: *Sema, owner: *Expr, arms: *MatchArm)
    if owner == null or g_fs_arms_ready == 0
        return
    if (*g_fs_float_owner).get(owner as i64).unwrap_or(0) == 0
        return
    var arm: *MatchArm = arms
    while arm != null
        if arm.is_pass == 0 and arm.body != null and (*g_fs_ptr_arm).get(arm.body as i64).unwrap_or(0) != 0
            float_slot_pointer_at(sm, arm.body)
        arm = arm.next

fn c_float_name(t: TypeKind) -> StrView
    if t == TypeKind.F32
        return "f32"
    "f64"

# ---- An integer arm beside a float arm (LARB R43, AGAST #4933) ----
#
#     let a = match c          # error, at the `match`: write `1.0`, or
#         0 => 1.5             # `let a: f64 = ...`
#         _ => 1
#
# An if / match whose value is used and whose arms yield both an integer and
# a float has no type to merge at, unless it lands in a float slot that gives
# it one (§7.5: then an integer arm converts, float_slot_check above).  Those
# slots are ritz0's (_float_slot, _float_tail_ids): a typed `let` / `var`, a
# `return` or fn tail at a float return type, an f32 / f64 parameter, and
# every if / match that is a value tail of one of them.  An assignment or a
# field is not one (ritz0 refuses `x = if c then 0 else 1.5` too).
#
# ritz0 refuses it at the merge whose own arms mix: the inner `if` of
# `if a then 1 else if b then 2.5 else 3`, the outer one when the outer arm
# is what mixes.  So sema_walk opens a FloatMix at each if / match
# (float_mix_begin), notes each arm's value while the arm's bindings are in
# scope (float_mix_value / float_mix_tail), and judges the merge once its
# arms are walked (float_mix_settle).  A nested merge is its parent's arm as
# what it yields, and one refused yields nothing, so it is said once.  The
# emitter used to refuse this at the arm, as it merged (AGAST #3385).

const FM_INT: i32 = 1
const FM_FLOAT: i32 = 2
const FM_KNOWN: i32 = 4   # Sema.fm_class: the merge was judged

# TypeKind.F32 / TypeKind.F64 when a slot of type (`ty`, `ty_name`) is a
# float, else TypeKind.Void (the emitter's slot_float_type).
fn fm_slot_type(ty: TypeKind, ty_name: StrView) -> TypeKind
    if ty == TypeKind.F32 or ty == TypeKind.F64
        return ty
    if ty == TypeKind.Struct and name_eq(ty_name, "f32") == 1
        return TypeKind.F32
    if ty == TypeKind.Struct and name_eq(ty_name, "f64") == 1
        return TypeKind.F64
    TypeKind.Void

fn fm_last(list: *Stmt) -> *Stmt
    var last: *Stmt = list
    while last != null and last.next != null
        last = last.next
    last

# `e` and each if / match that is its value tail land in the float slot.
fn fm_mark(sm: *Sema, e: *Expr)
    if e == null or (e.kind != ExprKind.If and e.kind != ExprKind.Match)
        return
    sm.fm_slot.insert(e as i64, 1)
    fm_mark_arms(sm, e.args as *MatchArm)

fn fm_mark_arms(sm: *Sema, arms: *MatchArm)
    var arm: *MatchArm = arms
    while arm != null
        if arm.is_pass == 0
            fm_mark(sm, arm.body)
        else
            fm_mark_stmt(sm, fm_last(arm.body_stmts))
        arm = arm.next

# The statement form: a block's last statement, the value it ends in.
fn fm_mark_stmt(sm: *Sema, st: *Stmt)
    if st == null
        return
    match st.kind
        StmtKind.Expr =>
            fm_mark(sm, st.expr)
        StmtKind.If =>
            sm.fm_slot.insert(st as i64, 1)
            fm_mark_stmt(sm, fm_last(st.if_then))
            fm_mark_stmt(sm, fm_last(st.if_else))
        StmtKind.Match =>
            sm.fm_slot.insert(st as i64, 1)
            fm_mark_arms(sm, st.if_then as *MatchArm)
        _ => pass

# `e` lands in a slot of type (`ty`, `ty_name`): a typed `let` / `var`'s
# initialiser, a `return`'s value or a fn's tail expression.
pub fn float_mix_slot(sm: *Sema, e: *Expr, ty: TypeKind, ty_name: StrView)
    if fm_slot_type(ty, ty_name) != TypeKind.Void
        fm_mark(sm, e)

# A fn's tail `if` / `match` statement `st`, at return type (`ty`, `ty_name`).
pub fn float_mix_slot_stmt(sm: *Sema, st: *Stmt, ty: TypeKind, ty_name: StrView)
    if fm_slot_type(ty, ty_name) != TypeKind.Void
        fm_mark_stmt(sm, st)

fn fm_args(sm: *Sema, params: *Param, args: *Expr)
    var p: *Param = params
    var a: *Expr = args
    while p != null and a != null
        float_mix_slot(sm, a, p.param_type, p.param_type_name)
        p = p.next
        a = a.next

# The arguments of call `e` land in its callee's parameters: a fn, a fn
# pointer local, a nameless callee (`hs[0](..)`), a method or a static one.
pub fn float_mix_args(sm: *Sema, e: *Expr)
    if e.kind == ExprKind.Call
        if e.func_name.len == 0
            let sig: *FnDef = sbk_value_fn_sig(sm, e.left)
            if sig != null
                fm_args(sm, sig.params, e.args)
            return
        let v: *SemaVar = sema_find_local(sm, e.func_name)
        if v != null
            if v.fn_sig != null
                fm_args(sm, v.fn_sig.params, e.args)
            return
        let fd: *FnDef = sema_call_fn(sm, e)
        if fd != null
            fm_args(sm, fd.params, e.args)
        return
    if e.kind != ExprKind.Method
        return
    let tn: StrView = sbk_method_recv(sm, e)
    if tn.ptr == null
        return
    let md: *FnDef = sema_method_fn(sm, tn, e.ident)
    if md == null or md.params == null
        return
    # `self` is the receiver, not the first argument (literal_method's rule).
    if name_eq(md.params.name, "self") == 1
        fm_args(sm, md.params.next, e.args)
    else
        fm_args(sm, md.params, e.args)

# Open the if / match `key` (its Expr or Stmt), refused at `line`:`col`;
# `want` false when its value is discarded.  float_mix_settle closes it.
pub fn float_mix_begin(sm: *Sema, mx: *FloatMix, key: i64, want: bool, line: i32, col: i32)
    mx.key = key
    mx.want = want
    mx.seen = 0
    mx.line = line
    mx.col = col
    mx.up = sm.fmix
    sm.fmix = Some(mx)

# What the judged if / match `key` yields, as its parent's arm: 0 if unjudged.
fn fm_class_of(sm: *Sema, key: i64) -> i32
    (sm.fm_class.get(key).unwrap_or(0) as i32) & (FM_INT | FM_FLOAT)

# What value `v` yields as an arm, typed in the arm's scope: FM_INT, FM_FLOAT
# or 0 (unsure, or neither).
fn fm_value_class(sm: *Sema, v: *Expr) -> i32
    if v.kind == ExprKind.If or v.kind == ExprKind.Match
        return fm_class_of(sm, v as i64)
    let k: i32 = sema_bool_kind(sm, v)
    if k == BK_FLOAT
        return FM_FLOAT
    if k == BK_INT
        return FM_INT
    0

# The open merge `mx` has an arm that yields `class`.
fn fm_note(mx: *FloatMix, class: i32)
    if mx.want
        mx.seen = mx.seen | class

# `v` is an arm's value of the innermost open merge, its bindings in scope.
pub fn float_mix_value(sm: *Sema, v: *Expr)
    if v == null
        return
    match sm.fmix
        Some(mx) => fm_note(mx, fm_value_class(sm, v))
        None => pass

# `st` is the last statement of an arm of the innermost open merge (a
# statement `if`'s branch): its value.
pub fn float_mix_tail(sm: *Sema, st: *Stmt)
    match st.kind
        StmtKind.Expr =>
            float_mix_value(sm, st.expr)
        StmtKind.If | StmtKind.Match =>
            match sm.fmix
                Some(mx) => fm_note(mx, fm_class_of(sm, st as i64))
                None => pass
        _ => pass

# Every arm of `mx` was noted: refuse it if they mix with no float slot.
pub fn float_mix_settle(sm: *Sema, mx: *FloatMix)
    sm.fmix = mx.up
    if not mx.want
        return
    var seen: i32 = mx.seen
    if seen == (FM_INT | FM_FLOAT) and not sm.fm_slot.contains(mx.key)
        sema_error_at(sm, mx.line, mx.col)
        eprints("match arms yield both an integer and a float value; write the integer arm as a float (`0.0`) or annotate the binding\n")
        seen = 0
    sm.fm_class.insert(mx.key, (seen | FM_KNOWN) as i64)
