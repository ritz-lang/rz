# struct_variants.ritz - same-named struct definitions (AGAST #4111).
#
# Struct names share one flat namespace across the import closure
# (LANGUAGE_SPEC §15.3), and a `[[target_os]]` struct exists only on its
# target (§17.2).  ritz0's rule (import_resolver.py `_register_item` StructDef
# branch and `resolve_struct_variants`), mirrored here:
#
#   - two definitions that always coexist (both ungated, or both gated to the
#     same target) must be identical, whatever the target being compiled;
#   - a gated definition beside an ungated one coexists only on its own
#     target, so they must be identical only when compiling for it;
#   - an identical repeat is never a conflict.
#
# ritz1 drops a gated-out item at parse time (ast_helpers
# check_target_os_filter), so the module never holds it.  The parser
# therefore notes EVERY struct here as it parses it, kept or not, with its
# target and a hash of its definition; struct_variants_check runs once the
# whole import closure is parsed.
#
# "Identical" is ritz0's `_structs_equal`: the same field names and types.
# Here it is the token stream from the struct's name to its end, without
# layout tokens (comments are not tokens), so neither `pub` nor formatting
# counts.

import ritzlib.cstr
import ritzlib.sys
import ritzlib.io
import ritzlib.memory
import ritzlib.str
import ritzlib.string
import ritzlib.hash

import tokens_gen

struct StructVariant
    name: StrView
    line: i32
    file: StrView            # the defining file (shared copy, never freed)
    target: u64          # hash of the [[target_os]]/[[target_arch]] gate; 0 if ungated
    exists: i32          # 1 if the struct exists on the target compiled for
    body: u64            # hash of the definition's tokens
    kind: i32            # TYPE_NOTE_STRUCT / _ENUM / _ALIAS (AGAST #4609)

# AGAST #4609: enums and type aliases are noted too, for type_twins.ritz
# (types follow the fn rule, LANGUAGE_SPEC §15.3); struct_variants_check
# reads only structs.
pub const TYPE_NOTE_STRUCT: i32 = 0
pub const TYPE_NOTE_ENUM: i32 = 1
pub const TYPE_NOTE_ALIAS: i32 = 2

var g_sv: *StructVariant = null
var g_sv_count: i64 = 0
var g_sv_cap: i64 = 0

# A fn gated out by [[target_os]]/[[target_arch]] (AGAST #4055, #4117): name,
# line, file, target.
struct FnVariant
    name: StrView
    line: i32
    file: StrView            # the defining file (shared copy, never freed)
    target: u64          # hash of the [[target_os]]/[[target_arch]] gate; never 0

var g_fv: *FnVariant = null
var g_fv_count: i64 = 0
var g_fv_cap: i64 = 0

# Forget every noted struct and fn: the driver re-parses from scratch (#1475).
pub fn struct_variants_reset()
    g_sv_count = 0
    g_fv_count = 0

# The hash a `[[target_os = "<os>"]]` (or `[[target_arch = "<arch>"]]`)
# value is noted under, prefixed by the attribute name so an os and an arch
# of one spelling cannot collide; never 0.
pub fn struct_variant_target_hash(attr_sv: StrView, val_sv: StrView) -> u64
    var attr: *u8 = attr_sv.ptr
    var attr_len: i32 = attr_sv.len as i32
    var val: *u8 = val_sv.ptr
    var val_len: i32 = val_sv.len as i32
    var h: u64 = fnv1a_str(Span<u8> { ptr: (attr), len: (attr_len) as i64 })
    var i: i32 = 0
    while i < val_len
        h = fnv1a_byte(h, *(val + i))
        i = i + 1
    if h == 0
        return 1
    h

# One gated item's target identity: its os hash and arch hash (either may be
# 0 for an attribute it doesn't carry), combined in a fixed order.  Two
# definitions of one name conflict iff their keys are equal.
pub fn struct_variant_target_pair_key(os_h: u64, arch_h: u64) -> u64
    if os_h == 0
        return arch_h
    if arch_h == 0
        return os_h
    var h: u64 = fnv1a_u64(fnv1a_init(), os_h)
    h = fnv1a_u64(h, arch_h)
    if h == 0
        return 1
    h

# Hash of the tokens [from, to) that make up one struct definition.
fn sv_body_hash(tokens: *Token, from: i32, to: i32) -> u64
    var h: u64 = fnv1a_init()
    var i: i32 = from
    while i < to
        let t: *Token = tokens + i
        let k: i32 = t.kind
        if k != TOK_NEWLINE and k != TOK_INDENT and k != TOK_DEDENT
            h = fnv1a_i32(h, k)
            h = fnv1a_i32(h, t.len)
            var j: i32 = 0
            while j < t.len
                h = fnv1a_byte(h, *(t.start + j))
                j = j + 1
        i = i + 1
    h

# Note the struct whose name is at `name` and whose tokens end before `end`
# (the parser's position just after it).  `target` is 0 for an ungated
# struct; `exists` is 0 if [[target_os]] filtered it out.
pub fn struct_variant_note(tokens: *Token, end: i32, name_sv: StrView, file: StrView, target: u64, exists: i32)
    type_note(tokens, end, name_sv, file, target, exists, TYPE_NOTE_STRUCT)

# Note any type declaration: a struct, an enum or a type alias (`kind`).
pub fn type_note(tokens: *Token, end: i32, name_sv: StrView, file: StrView, target: u64, exists: i32, kind: i32)
    var name: *u8 = name_sv.ptr
    # The name token: the last one before `end` that starts at `name`.
    var from: i32 = end - 1
    while from >= 0 and (tokens + from).start != name
        from = from - 1
    if from < 0
        return
    if g_sv_count == g_sv_cap
        var cap: i64 = g_sv_cap * 2
        if cap == 0
            cap = 64
        let grown: *StructVariant = realloc(g_sv as *u8, cap * sizeof(StructVariant)) as *StructVariant
        if grown == null
            eprints("error: ritz1: out of memory recording struct definitions\n")
            sys_exit(70)
        g_sv = grown
        g_sv_cap = cap
    let v: *StructVariant = g_sv + g_sv_count
    v.name = name_sv
    v.line = (tokens + from).line
    v.file = file
    v.target = target
    v.exists = exists
    v.body = sv_body_hash(tokens, from, end)
    v.kind = kind
    g_sv_count = g_sv_count + 1

# Every type noted since the last reset, in parse order (AGAST #4609).
pub fn type_note_count() -> i64
    g_sv_count

pub fn type_note_at(i: i64) -> *StructVariant
    g_sv + i

fn sv_same_name(a: *StructVariant, b: *StructVariant) -> i32
    a.name.eq(b.name) as i32

# 1 if `a` and `b` (same name) both exist together somewhere relevant: always
# (same gate), or on this target (one ungated, the other kept).
fn sv_coexist(a: *StructVariant, b: *StructVariant) -> i32
    if a.target == b.target
        return 1
    if a.target == 0 and b.exists == 1
        return 1
    if b.target == 0 and a.exists == 1
        return 1
    0

# AGAST #4609: two always-coexisting definitions from two files are twins,
# conflicting only in a file that sees both: type_twins.ritz judges them.
fn sv_twins(a: *StructVariant, b: *StructVariant) -> i32
    if a.target != b.target or a.file.len == 0 or b.file.len == 0
        return 0
    # One file's notes share its parse's copy of its path (ast_helpers
    # parse_file_copy_shared).
    if a.file.ptr == b.file.ptr
        return 0
    1

# "Error: <later>:<line>: Conflicting struct definition for 'P': defined in
# both <earlier> and <later>", ritz0's words.
fn sv_report(earlier: *StructVariant, later: *StructVariant)
    var msg: String = string_from("Error: ")
    if later.file.len > 0
        msg.push_str(later.file)
    msg.push(':')
    msg.push_i64(later.line as i64)
    msg.push_str(": Conflicting struct definition for '")
    msg.push_span(Span<u8> { ptr: later.name.ptr, len: (later.name.len) as i64 })
    msg.push_str("': defined in both ")
    if earlier.file.len > 0
        msg.push_str(earlier.file)
    msg.push_str(" and ")
    if later.file.len > 0
        msg.push_str(later.file)
    eprintln_string(@msg)

# Report every pair of differing definitions that coexist.  Each later
# definition is reported once, against the first it conflicts with.
# Returns -1 if there was one, else 0.
pub fn struct_variants_check() -> i32
    var bad: i32 = 0
    var i: i64 = 1
    while i < g_sv_count
        let b: *StructVariant = g_sv + i
        var j: i64 = 0
        while j < i
            let a: *StructVariant = g_sv + j
            if a.kind == TYPE_NOTE_STRUCT and b.kind == TYPE_NOTE_STRUCT and a.body != b.body and sv_same_name(a, b) == 1 and sv_coexist(a, b) == 1 and sv_twins(a, b) == 0
                sv_report(a, b)
                bad = 1
                j = i
            j = j + 1
        i = i + 1
    if bad == 1
        return -1
    0

# =============================================================================
# Gated-out fns (AGAST #4055)
# =============================================================================
#
# LANGUAGE_SPEC §17.2: two fns of one name gated to the same target are an
# error whatever the target compiled for, as in ritz0 (import_resolver.py
# `_register_item` FnDef branch).  Two kept ones are main.ritz's
# fns_conflict; two gated out never reach the module, so the parser notes
# each here and fn_variants_check pairs them once the import closure is
# parsed.  Bodies are not compared: any second definition conflicts.

pub fn fn_variant_note(name_sv: StrView, line: i32, file: StrView, target: u64)
    if g_fv_count == g_fv_cap
        var cap: i64 = g_fv_cap * 2
        if cap == 0
            cap = 64
        let grown: *FnVariant = realloc(g_fv as *u8, cap * sizeof(FnVariant)) as *FnVariant
        if grown == null
            eprints("error: ritz1: out of memory recording gated fns\n")
            sys_exit(70)
        g_fv = grown
        g_fv_cap = cap
    let v: *FnVariant = g_fv + g_fv_count
    v.name = name_sv
    v.line = line
    v.file = file
    v.target = target
    g_fv_count = g_fv_count + 1

fn fv_same_name(a: *FnVariant, b: *FnVariant) -> i32
    a.name.eq(b.name) as i32

# "Error: <later>:<line>: Conflicting function definition for 'X': defined
# in both <earlier> and <later>", main.ritz report_fn_conflict's words.
fn fv_report(earlier: *FnVariant, later: *FnVariant)
    var msg: String = string_from("Error: ")
    if later.file.len > 0
        msg.push_str(later.file)
    msg.push(':')
    msg.push_i64(later.line as i64)
    msg.push_str(": Conflicting function definition for '")
    msg.push_span(Span<u8> { ptr: later.name.ptr, len: (later.name.len) as i64 })
    msg.push_str("': defined in both ")
    if earlier.file.len > 0
        msg.push_str(earlier.file)
    msg.push_str(" and ")
    if later.file.len > 0
        msg.push_str(later.file)
    eprintln_string(@msg)

# Report each later gated-out fn against the first of its name and target.
# Returns -1 if there was one, else 0.
pub fn fn_variants_check() -> i32
    var bad: i32 = 0
    var i: i64 = 1
    while i < g_fv_count
        let b: *FnVariant = g_fv + i
        var j: i64 = 0
        while j < i
            let a: *FnVariant = g_fv + j
            if a.target == b.target and fv_same_name(a, b) == 1
                fv_report(a, b)
                bad = 1
                j = i
            j = j + 1
        i = i + 1
    if bad == 1
        return -1
    0
