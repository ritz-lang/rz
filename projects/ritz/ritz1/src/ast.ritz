# ritz1/src/ast.ritz - Abstract Syntax Tree Definitions
#
# Simple AST structures for the ritz1 compiler.
# Designed to be easy to parse and emit to LLVM IR.

import tokens_gen
import ritzlib.gvec     # ParseCtx's twin tables (AGAST #4609)
import ritzlib.option   # TypeKind.from (type_kind_of)

# Expression kinds
pub enum ExprKind: i32
    Unset = 0   # a zeroed Expr: no kind yet
    IntLit = 1
    StringLit = 2
    NilLit = 3  # nil literal (null pointer)
    Ident = 4
    Binary = 5
    Unary = 6
    Call = 7
    Cast = 8
    Index = 9  # Array/pointer indexing: expr[index]
    Member = 10  # Member access: expr.field (TODO: not yet implemented in emitter)
    StructLit = 11  # Struct literal: Type { field: value, ... }
    Method = 12      # Method call: expr.method(args)
    CharLit = 13    # Character literal: 'a'
    Range = 14       # Range expression: start..end (left=start, right=end)
    ArrayLit = 15   # Array literal: [a, b, c] (parser-only; ignored by emitter when stored in consts)
    CstringLit = 16 # C-string literal: c"..." (null-terminated *u8)
    # EXPR_SSTRING_LIT (slot 17) was removed in AGAST #98 — bare ExprKind.StringLit
    # now emits a StrView aggregate of the same shape. Slot kept as a hole so
    # subsequent EXPR_* values stay stable.
    Match = 18       # Match expression: match scrutinee \n pattern => body ...
    Try = 19         # Try operator: expr? — on Ok/Some continue with payload,
    # on Err/None early-return the encoded value. Inner expr
    # lives in `left`. (AGAST #134)
    # Float literal — value is the raw source bytes; emitter parses + emits as
    # `float`/`double` constant.  Storage shares string_val because
    # IEEE-754 bit-exact reconstruction needs the raw decimal repr.
    FloatLit = 20
    # Array fill literal: `[value; N]` — repeated initialization. (AGAST #178)
    # `left` holds the value expression; `int_val` holds the count (extracted
    # from the count token in the grammar action — only int literal counts are
    # supported, mirroring ritz0).
    ArrayFill = 21
    # If/else expression (AGAST #1613): `let n = if c` + indented arms + `else`.
    # Condition in `left`; `args` holds two wildcard MatchArms (then, else) built
    # by expr_if / match_arm_set_block, so the arms' values, block statements and
    # struct-typed phi go through the same machinery as ExprKind.Match arms.
    If = 22
    # A type as `sizeof`'s operand (AGAST #2124): `sizeof([8]u8)`, and
    # monomorph's `sizeof(T)` substitution.  int_val = element count (1 for a
    # non-array), op = the leaf TYPE_* kind, ident = the leaf
    # struct name (TypeKind.Struct only).  Only sizeof reads it.
    TypeOperand = 23
    # AGAST #1456: `await e` (operand in .operand).  async_lower.ritz lowers every
    # one before any check (AGAST #3814); no later pass sees one.
    Await = 24

# Expr.lit_kind of an ExprKind.IntLit (AGAST #2236).
const LIT_PLAIN: i32 = 0   # a number
const LIT_TRUE: i32 = 1    # `true`
const LIT_PASS: i32 = 2    # `pass` in expression position
const LIT_FALSE: i32 = 3   # `false`
const LIT_UNIT: i32 = 4    # `()`, the unit value (AGAST #2272)

# Pattern kinds (used by MatchArm)
# NOTE: pattern kinds live in their own namespace — not confused with EXPR_/STMT_.
const PAT_INT_LIT: i32 = 1   # Integer literal pattern (42)
const PAT_WILDCARD: i32 = 2  # Wildcard pattern (_)
const PAT_IDENT: i32 = 3     # Identifier binding OR unit variant (None, x)
const PAT_VARIANT: i32 = 4   # Variant with inner pattern: Some(v), Ok(_)
const PAT_BOOL: i32 = 5      # `true` / `false`; pattern_int is 1 / 0 (AGAST #2344)
const PAT_STR: i32 = 6       # "text"; its cooked bytes in pattern_name/_len (AGAST #1876)
const PAT_CHAR: i32 = 7      # '('; its byte in pattern_int, an integer typed u8 (LARB R72, #4196)

# Binary operators
pub enum OpKind: i32
    Unset = 0   # not an operator (a zeroed Expr.op)
    Add = 1
    Sub = 2
    Mul = 3
    Div = 4
    Mod = 5
    Eq = 6
    Ne = 7
    Lt = 8
    Gt = 9
    Le = 10
    Ge = 11
    And = 12
    Or = 13
    # Bitwise operators
    BitAnd = 14
    BitOr = 15
    BitXor = 16
    Shl = 17
    Shr = 18
    # Unary operators
    Neg = 20
    Not = 21
    Deref = 22  # Pointer dereference: *expr
    Addr = 23      # Address-of: @expr
    BitNot = 24   # Bitwise NOT: ~expr
    AddrMut = 25  # Mutable address-of: @&expr
    # Wrapping operators (LARB R63, AGAST #3486).  Parser-side codes only: the
    # grammar's `+%` / `-%` / `*%` and their `op=` forms arrive as these, and
    # binary_op_new / expr_binary and the compound-assign builders turn one into
    # its plain OpKind.Add / OpKind.Sub / OpKind.Mul with Expr.wrapping set.  No Expr keeps
    # one, so every pass past the parser sees the plain operator plus the flag.
    AddWrap = 26
    SubWrap = 27
    MulWrap = 28

# Statement kinds
pub enum StmtKind: i32
    Unset = 0   # a zeroed Stmt: no kind yet
    VarDecl = 1
    Assign = 2
    Return = 3
    If = 4
    While = 5
    Expr = 6
    MemberAssign = 7  # ptr.field = value
    MemberIndexAssign = 8  # ptr.field[index] = value
    IndexAssign = 9  # name[index] = value
    Break = 10        # break statement
    Continue = 11     # continue statement (for future use)
    LocalFieldAssign = 12  # local_var.field = value
    LocalFieldIndexAssign = 13  # local_var.field[index] = value
    For = 14  # for i in start..end { body }
    Loop = 15 # loop { body } - infinite loop with break
    Match = 16 # match scrutinee \n pattern => body ...
    # `assert <cond>` — runtime check; if cond evaluates 0/false the program
    # exits with status 1 via inline syscall(60).  The condition expression
    # is stored in `if_cond` (reusing StmtKind.If's slot — the lowering is
    # semantically a guarded if).  Message text is not yet plumbed.
    Assert = 17
    # `let (x, y) = expr` — destructure a 2-field tuple into two locals (LARB R67:
    # a named struct is refused, at paren_span).  First name lives in var_name
    # (slot reused), second in assign_target.  Init expression in var_init.  The
    # emitter resolves the tuple type from the init expression and extractvalue's
    # fields 0 and 1.
    TupleDecl = 18
    # G9b (AGAST #1899): the body of an imported fn stripped to its interface
    # (main.ritz strip_to_interface).  A no-op that every body walker skips; the
    # fn keeps a non-null body because `body == null` means `extern fn`.
    Stripped = 19
    # `defer <stmt>` / `defer` + block (LANGUAGE_SPEC §13.7, AGAST #1625).  The
    # deferred statement list is in while_body (null for a bare `defer`), and
    # defer_is_block is 1 for the block form.  Nothing is emitted at the
    # `defer`: own_defer registers it, and it is emitted at each exit of its
    # block, interleaved with the drops (ownership.ritz).
    Defer = 20
    # `unsafe` + block (AGAST #2248).  The body is in while_body, as a `loop`'s.
    # A block for scope and drops, never a loop: a `break` in it leaves the loop
    # around it, and it diverges exactly when its body does (ritz0 UnsafeBlock).
    Unsafe = 21
    # `asm ARCH (clauses): <raw lines>` (LANGUAGE_SPEC §18.6, LARB R50, AGAST
    # #3394).  Everything is in asm_block; the statement holds no expressions or
    # statements, so a walker has nothing to descend into.  ritz1 parses and checks
    # it (stmt_asm, ast_helpers.ritz) and lowers it (emitter_asm.ritz, AGAST #3395).
    Asm = 22

# asm operand directions (AsmOperand.dir).  ASM_CLOBBER marks a `clobber REG`
# clause while the grammar builds the clause list; stmt_asm moves it to
# AsmBlock.clobbers, so no operand in a finished block has it.
const ASM_IN: i32 = 0
const ASM_OUT: i32 = 1
const ASM_INOUT: i32 = 2
const ASM_CLOBBER: i32 = 3
const ASM_UNKNOWN: i32 = 4   # a clause word that is none of the above

# x86_64 general registers, by their 64-bit names: the index is the bit in
# AsmBlock.clobbers.  ASM_REG_NONE is an operand that isn't pinned.
const ASM_REG_NONE: i32 = -1
const ASM_REG_RSP: i32 = 4
const ASM_REG_RBP: i32 = 5

# Type kinds
pub enum TypeKind: i32
    # Void = 0: a repr enum holds its discriminant (AGAST #4574), so a
    # zeroed field is Void, as the i32 was.
    Void = 0       # No return type (void)
    I32 = 1
    I64 = 2
    U8 = 3
    Bool = 4
    Ptr = 5
    PtrPtr = 6  # Pointer-to-pointer (**u8, etc.)
    I8 = 7
    U64 = 8       # Unsigned 64-bit integer
    U16 = 9       # Unsigned 16-bit integer
    U32 = 10      # Unsigned 32-bit integer
    I16 = 11      # Signed 16-bit integer
    # IEEE-754 floats — first-class type kinds rather than TypeKind.Struct+name="f32"
    # (the half-measure from `04c944e`).  is_float_type() centralises the check;
    # emit_llvm_type / arith / cmp / cast paths dispatch on these to use
    # float/double + fadd/fmul/fcmp/sitofp/fptosi instead of integer ops.
    F32 = 12      # 32-bit IEEE-754 single precision
    F64 = 13      # 64-bit IEEE-754 double precision
    Struct = 100  # Named struct type (100+ reserved for structs)
    Array = 101   # Array type [N]T - stores size and element type
    Ref = 102     # Immutable reference @T (emits as pointer)
    MutRef = 103 # Mutable reference @@T (emits as pointer)
    # AGAST #1328: "not a local" miss value for find_local_type (was
    # ast_query.ritz TypeKind.Unknown).  The old miss value was I64, which a
    # caller took for a real i64 local; Unknown collides with no kind.
    Unknown = -1
    # AGAST #4450: an inner-pointee slot (see PTR_DEPTH_UNIT) read as a kind
    # when it packs levels past `**`: ptr_slot_flat's answer for a `***T`.
    # It equals no other kind, as the packed i32 it replaces did.
    DeepPtr = 1024
    # AGAST #4450: analysis sentinels, kinds no declared type has: a
    # narrowing check's "cannot tell" (was narrowing.ritz TypeKind.NarrowUnknown)
    # and its bare integer literal (TypeKind.NarrowLit), and fn_slot's fn-typed
    # slot (was fn_slot.ritz TypeKind.FnSig = 9001, renumbered off NarrowUnknown).
    NarrowUnknown = 9001
    NarrowLit = 9002
    FnSig = 9003

# AGAST #1924: a `**T` records its innermost pointee T in one i32 slot
# (Stmt.var_inner_pointee_type, Param.param_inner_pointee_type,
# GlobalVarDef / StructField / LocalVar.inner_pointee_type).  A deeper
# pointer packs its extra levels into the same slot: `***T` is
# T + PTR_DEPTH_UNIT, `****T` is T + 2 * PTR_DEPTH_UNIT.  Every reader that
# asks "is this a **S?" (`== TypeKind.Struct`) therefore still answers no for
# `***S`, and every copy of the slot carries the depth with it.  Decode
# with ptr_ptr_slot_levels / ptr_ptr_slot_inner below.
const PTR_DEPTH_UNIT: i32 = 1024

# AGAST #2399: the indirection nearest a pointee (Param.param_inner_ref and the
# like).  A reference is a pointer, so `@@S` is held as an `@*S` and `*@&S` as a
# `**S`; this says that level was an `@T` or `@&T`, which decides a write
# through it (§13.3) and what `*p` is.
const INNER_REF_NONE: i32 = 0     # a `*T`, or no level
const INNER_REF_SHARED: i32 = 1   # an `@T`
const INNER_REF_MUT: i32 = 2      # an `@&T`, or a `:&` borrow

# AGAST #1924: decode an inner-pointee slot (see PTR_DEPTH_UNIT).  Levels
# of the whole pointer type: 2 for `**T`, 3 for `***T`; 0 when the slot
# records nothing.
pub fn ptr_ptr_slot_levels(slot: i32) -> i32
    if slot == (TypeKind.Void as i32) or slot < 0
        return 0
    return 2 + slot / PTR_DEPTH_UNIT

# The innermost pointee T of an inner-pointee slot.
pub fn ptr_ptr_slot_inner(slot: i32) -> TypeKind
    if slot < 0
        return TypeKind.Void
    type_kind_of(slot % PTR_DEPTH_UNIT)

# The slot with its innermost pointee replaced by `inner` (depth kept), for
# monomorph's `**T` -> `**i32`.
pub fn ptr_ptr_slot_subst(slot: i32, inner: TypeKind) -> i32
    return slot - (ptr_ptr_slot_inner(slot) as i32) + (inner as i32)

# AGAST #4450: the levels past `**` a slot packs (0 for a `**T`).
pub fn ptr_slot_extra(slot: i32) -> i32
    slot / PTR_DEPTH_UNIT

# AGAST #4450: `slot` with `n` more levels past `**`: a `**T` slot deepened
# by one is the `***T` slot.  These helpers are the only code that knows the
# packing; every other reader goes through them.
pub fn ptr_slot_deepen(slot: i32, n: i32) -> i32
    slot + n * PTR_DEPTH_UNIT

# AGAST #4450: an inner-pointee slot read as a kind: its kind for a `**T`,
# DeepPtr when it packs more levels (matching no other kind, as the packed
# value did).
pub fn ptr_slot_flat(slot: i32) -> TypeKind
    if ptr_slot_extra(slot) > 0
        return TypeKind.DeepPtr
    type_kind_of(slot)

# AGAST #4450: the TypeKind an i32 encodes (a packed slot's kind, an encoded
# Expr.sema_ty, a loop counter over the scalar kinds); Unknown for a value
# that is no kind.
pub fn type_kind_of(v: i32) -> TypeKind
    match TypeKind.from(v)
        Some(k) => k
        None => TypeKind.Unknown

# AGAST #4450: the scalar leaf kinds (I32 .. F64 but the two pointer kinds),
# which were range checks on the old i32 codes.
pub fn type_is_scalar_leaf(t: TypeKind) -> bool
    match t
        TypeKind.I32 => true
        TypeKind.I64 => true
        TypeKind.U8 => true
        TypeKind.Bool => true
        TypeKind.I8 => true
        TypeKind.U64 => true
        TypeKind.U16 => true
        TypeKind.U32 => true
        TypeKind.I16 => true
        TypeKind.F32 => true
        TypeKind.F64 => true
        _ => false

# AGAST #4450: `t < TypeKind.Struct and t not a pointer kind` on the old codes:
# Unknown, Void and the scalar leaves.
pub fn type_is_below_struct_nonptr(t: TypeKind) -> bool
    match t
        TypeKind.Unknown => true
        TypeKind.Void => true
        _ => type_is_scalar_leaf(t)

# AGAST #4450: OpKind's ordered groups, which were range checks on the old
# i32 codes.  Eq .. Ge: the comparisons.
pub fn op_is_comparison(op: OpKind) -> bool
    match op
        OpKind.Eq => true
        OpKind.Ne => true
        OpKind.Lt => true
        OpKind.Gt => true
        OpKind.Le => true
        OpKind.Ge => true
        _ => false

# Eq .. Or: the comparisons and the logical `and` / `or` (a bool result).
pub fn op_is_cmp_or_logic(op: OpKind) -> bool
    match op
        OpKind.And => true
        OpKind.Or => true
        _ => op_is_comparison(op)

# BitAnd .. Shr: the bitwise operators and the shifts.
pub fn op_is_bitwise(op: OpKind) -> bool
    match op
        OpKind.BitAnd => true
        OpKind.BitOr => true
        OpKind.BitXor => true
        OpKind.Shl => true
        OpKind.Shr => true
        _ => false

# Source location span for DWARF debug info.  Named SrcSpan, not Span, so it
# does not collide with ritzlib.span's Span<T>, which main.ritz reaches
# through ritzlib.os.env (AGAST #1750).
struct SrcSpan
  line: i32
  col: i32

# AGAST #109: a destructure's third and later names, `c, d` of
# `let (a, b, c, d) = e`, in order (Stmt.tuple_more).  `_` binds nothing.
struct TupleName
  name: *u8
  len: i32
  span: SrcSpan
  next: *TupleName

# AGAST #1509: the full shape of a multi-dimensional array type `[d0][d1]..T`.
# A nested array is still TypeKind.Array with array_size = d0 and array_elem_type
# = TypeKind.Array; this records every dimension (outermost first) and the leaf
# T, which the 1-D fields cannot hold.  Built by type_array, carried only by
# the declarations ritz1 lowers (local and global `var`); every other site
# that meets a nested array type rejects it (nd_array_reject).
const MAX_ARRAY_RANK: i32 = 8

struct ArrayShape
  rank: i32                 # number of dimensions, >= 2
  dims: [8]i32              # MAX_ARRAY_RANK; dims[0] is the outermost
  leaf_type: TypeKind            # T (never TypeKind.Array)
  leaf_name: StrView            # struct name when leaf_type == TypeKind.Struct
  leaf_pointee: TypeKind         # AGAST #2343: U when T is `*U`; TypeKind.Void otherwise

# AGAST #2343: an array's element, where a type is kept only long enough to judge
# a store: a fn's `-> [N]T` and `x as [N]T`.
struct ArrayElem
  elem: TypeKind                 # T (TypeKind.Array for `[N][M]..T`)
  pointee: TypeKind              # U for `[N]*U`; TypeKind.Void otherwise
  name: StrView                 # the struct T or U
  shape: *ArrayShape        # non-null for `[N][M]..T`
  # AGAST #2995: for `[N]*[M]T`, the `[M]T` an element points at, and M; null / 0
  # otherwise.  The outer `[N]` overwrites the parser's last_array_* with its own.
  ptr_array: *ArrayElem
  ptr_array_size: i32
  # AGAST #4122: for `[K]*[N][M]..T`, the `[N][M]..T` an element points at
  # (a plane pointer's shape); null otherwise.
  ptr_plane: *ArrayShape

# Expression node
struct Expr
  kind: ExprKind
  span: SrcSpan  # Source location for DWARF debug info
  # For ExprKind.IntLit
  int_val: i64
  # For ExprKind.StringLit
  string_val: StrView
  # For ExprKind.Ident
  # For ExprKind.Cast to `*T` (AGAST #1453): ident = the pointee
  # struct name (null for a non-struct pointee), cast_ptr_kind = the pointee
  # kind (TypeKind.Struct, TypeKind.I32, ...; TypeKind.Void when unknown).  For ExprKind.Cast to
  # a struct `C`, ident = `C` (AGAST #2288).  For a parsed
  # ExprKind.IntLit, its source text if it is 2^64 or more, else null (#3083).
  ident: StrView
  # For ExprKind.Binary and ExprKind.Index
  op: OpKind
  left: *Expr     # Binary: left operand, Index: base expression
  right: *Expr    # Binary: right operand, Index: index expression
  # AGAST #3486 (LARB R63): 1 on an ExprKind.Binary the source wrote `+%`, `-%` or
  # `*%` (and on the `op=` desugaring of `+%=` etc.).  op holds the plain
  # operator, so every rule for `+` applies; only these two differ: a wider
  # slot doesn't widen it (literal_slot.lit_slot_arith stops there), and on a
  # float or a pointer it is refused (wrapping.ritz).  emitter_expr_arith wraps
  # the result back to the operand type.  parser_alloc zeroes it.
  wrapping: i32
  # For ExprKind.Unary
  operand: *Expr
  # For ExprKind.Call
  func_name: StrView
  call_type_suffix: StrView       # Type suffix for generic calls, e.g., "$u8" for vec_new<u8>()
  args: *Expr        # Linked list of args (using 'next' below)
  # For ExprKind.Method: receiver in 'left', method name in 'ident', args in 'args'
  # Linked list
  next: *Expr
  # AGAST #2120: for ExprKind.Cast to a fn type, its signature (with the alias's
  # [[callconv]]), so `(p as EfiFn)(..)` calls typed; null otherwise.  Set
  # only by the cast constructors: read it on ExprKind.Cast nodes alone.
  fn_sig: *FnDef
  # AGAST #2341: for ExprKind.Cast, the pointee of a pointer target.
  cast_pointee: TypeKind
  # AGAST #4450: for ExprKind.Cast, the target type; for ExprKind.TypeOperand, the
  # leaf type.  (Held in `op` until then, which is an operator everywhere
  # else.)
  type_kind: TypeKind
  # AGAST #4450: for ExprKind.Cast to `*T`, T's kind (AGAST #1453; TypeKind.Void when
  # unknown), with ident naming a struct T.  Held in int_val
  # until then.
  cast_ptr_kind: i32
  # AGAST #2343: for ExprKind.Cast to `[N]T`, its element; null otherwise.
  cast_array: *ArrayElem
  # AGAST #4122: for ExprKind.Cast to `*[N][M]..T`, the type as a param records
  # it (base_ptr_array reads it); null otherwise.
  cast_ptr_array: *Param
  # AGAST #2236: for ExprKind.IntLit, how it was written (LIT_*).  `true` and `1`
  # both lower to the integer 1, and `pass` and `0` to 0, but tail_value.ritz
  # has to tell them apart.  Set by the expr_int family only: parser_alloc
  # does not zero, so read it on ExprKind.IntLit nodes alone.
  lit_kind: i32
  # AGAST #2452: for ExprKind.Index, where its `[` is, so an error about the index
  # is located there as ritz0's are (`sv[0][1]` names the second `[`).  Line 0
  # for an index the compiler built: read it through index_bracket_line/_col.
  # For an ExprKind.Member (and the ExprKind.Method it may become) the parser builds,
  # where its field name is (AGAST #3015): R17's errors are located there.
  # For an ExprKind.Cast the parser builds, where its `as` is (AGAST #3040), line
  # 0 for one the compiler built.
  bracket: SrcSpan
  # AGAST #3225: for an ExprKind.Binary `/` or `%`, the integer slot it lands in
  # directly (through `+ - * / % << & | ^` and unary `-`), TypeKind.Void if none:
  # in a wider slot it divides at the slot's type (literal_slot.ritz,
  # lit_slot_arith).  Every ExprKind.Binary constructor sets it; read it there alone.
  slot_type: TypeKind
  # AGAST #3509: Sema's annotation on an ExprKind.Call it made for `.` through
  # `Deref` / `DerefMut` (deref_field.ritz); null on every other node
  # (parser_alloc zeroes what it hands out).
  deref_step: *DerefStep
  # AGAST #3042: Sema's annotation on an ExprKind.If / ExprKind.Match: the struct (an
  # enum, `G$i32` included) its value is, typed from its first arm Sema can
  # type, in that arm's scope (sema_walk_arms).  match_scrutinee_type reads it
  # for `match (if c then b else d)`, which otherwise guessed its enum from
  # the arms.  Null when no arm types as a struct, and on every other node.
  value_ty_name: StrView
  # AGAST #2847: monomorph's annotation on an ExprKind.Method it made for `m[k]`
  # on a struct (§7.8, struct_index.ritz); null on every other node.
  index_step: *IndexStep
  # AGAST #4033: own_check's annotation on an ExprKind.Cast `@x as *U` of a
  # binding with unwritten parts (§13.6): 1 when the cast writes them, with
  # own_raw_bits their path set (0 when x was unwritten whole).  The emitter
  # sets x's drop flag and clears those mask bits there (own_raw_written).
  own_raw: i32
  own_raw_bits: i32
  # AGAST #4404: Sema's annotation.  The TYPE_* kind its expr typer
  # (sema_type.ritz, `sema_expr_ty`) gave this node in the scope sema_walk
  # reached it in, encoded +2: 0 means "not annotated", 1 TypeKind.Unknown, 2
  # TypeKind.Void, and so on.  Read it through expr_sema_ty (ast_query.ritz).
  # The emitter reads types from here instead of re-deriving them from
  # EmitterState (#1816).
  sema_ty: i32
  # AGAST #4428: Sema's annotation on an initialiser that is an array element
  # or an element's address (sema_note_elem_init).  The pointer binding it
  # infers: levels (0 unset, 1 `*T`, 2 `**T`, ..), the innermost pointee
  # slot, and a struct pointee's name.  emit_var_decl applies it when its own
  # inference (infer_array_elem_let / infer_elem_ptr_ptr_let) cannot place a
  # base the emitter's views don't record -- a `& [N]**T` borrow param.
  sema_levels: i32
  sema_inner: i32
  sema_ptr_name: StrView
  # AGAST #4697: Sema's annotation on the "..." literal a print-family call
  # splits (interp_split_literal): one InterpParse per placeholder Sema parsed
  # (call_check.ritz, cc_interp_names), in source order; null on every other
  # node.  The emitter lowers these nodes (interp_parsed_at); it parses
  # nothing itself.
  interp: *InterpParse

# AGAST #4697: one parsed print placeholder, on its literal (Expr.interp).
# `at` is the byte offset in the literal's raw text (Expr.ident, quotes
# included) of the expression's first byte, just after its `{`; `expr` is
# that text up to its spec's `:` (or the `}`), parsed by interp_parse_expr.
struct InterpParse
  at: i32
  expr: *Expr
  next: *InterpParse

# AGAST #2847: an `index` / `index_mut` / `index_set` call monomorph made for
# `m[k]`, so ref_loan sees the place it was (R11a: `[k]` is an index step).
struct IndexStep
  place: *Expr   # `m[k]` as written (`m[k].f…` for a field store); null when the use borrows nothing
  use: i32       # SI_USE_* (struct_index.ritz)
  addr: i32      # 1 for `@m[k]` / `@&m[k]`: the call is the reference
  at: SrcSpan    # where a store is refused: its statement

# AGAST #3509: a `deref` / `deref_mut` call Sema made for `s.f` (deref_field.ritz).
struct DerefStep
  fd: *FnDef     # the `S_deref` / `S_deref_mut` it calls (what Sema types the step by)
  recv: *Expr    # the place it lends, when held by value; null for a pointer or reference

# Statement node
struct Stmt
  kind: StmtKind
  span: SrcSpan  # Source location for DWARF debug info
  # For StmtKind.TupleDecl: where the pattern's `(` is.  LARB R67's refusal
  # points there (AGAST #3500), as ritz0's LetTupleStmt.paren_span does.
  paren_span: SrcSpan
  # For StmtKind.VarDecl
  var_name: StrView
  # AGAST #4528: the `*TypeRef` the declaration's type was parsed from
  # (null for an unannotated `let` / `var`).  The flat var_* facts below are
  # derived from it by the parser and stay for the Sema-side readers; lowering
  # registers the local from the chain.
  var_ty: *TypeRef
  var_type: TypeKind
  var_type_name: StrView    # Struct name when var_type == TypeKind.Struct
  var_array_size: i32       # Array size when var_type == TypeKind.Array
  var_array_elem_type: TypeKind  # Element type when var_type == TypeKind.Array
  var_array_shape: *ArrayShape  # AGAST #1509: non-null for `[N][M]..T`
  var_pointee_type: TypeKind    # Element type when var_type == TypeKind.Ptr (e.g., TypeKind.U8 for *u8)
  var_array_elem_pointee: TypeKind  # AGAST #2341: T for `[N]*T`; TypeKind.Void otherwise
  var_array: *ArrayElem     # AGAST #2995: the element of a `[N]T` local; null otherwise
  var_init: *Expr
  # For StmtKind.Assign
  assign_target: StrView
  assign_value: *Expr
  # For StmtKind.Return
  return_value: *Expr
  # For StmtKind.If
  if_cond: *Expr
  if_then: *Stmt     # Body (linked list of statements)
  if_else: *Stmt     # Optional else body
  # For StmtKind.While
  while_cond: *Expr
  while_body: *Stmt
  # For StmtKind.For (for i in start..end { body })
  for_var: StrView       # Loop variable name
  for_start: *Expr       # Range start expression
  for_end: *Expr         # Range end expression
  for_body: *Stmt        # Loop body (linked list of statements)
  for_inclusive: i32     # 1 for `start..=end` (bound `<=`), 0 for `start..end` (AGAST #1530)
  # For StmtKind.Expr
  expr: *Expr
  # Linked list
  next: *Stmt
  # AGAST #1671: signature of a `let f: fn(...) -> T` local (null otherwise).
  var_fn_sig: *FnDef
  # AGAST #1364: the type the programmer WROTE on a let/var (TypeKind.Void when
  # there was no annotation).  var_type cannot answer that: the parser
  # defaults a missing annotation to TypeKind.I64.  AGAST #4407: the emitter's
  # own inference no longer writes var_type, so this stays the parser's.
  # src_file is the arena path for the narrowing diagnostic, set only for an
  # integer annotation narrower than 64 bits (the only ones that can narrow).
  var_declared_type: TypeKind
  var_src_file: StrView
  # AGAST #1815: for `**T` (exactly two levels), the innermost pointee T
  # (TypeKind.U8 for **u8, ...); TypeKind.Void otherwise.  var_pointee_type is
  # TypeKind.Ptr for every **T, so without this `*(*(pp + i) + k)` cannot
  # know its element width or stride.
  var_inner_pointee_type: i32
  # AGAST #2399: the reference nearest the pointee, INNER_REF_*: `@@S` and `*@S`
  # are held as an `@*S` / `**S`, and this keeps what that level was.
  var_inner_ref: i32
  # AGAST #2028: 1 for a StmtKind.VarDecl written `let` (stmt_let_decl), 0 for
  # `var`.  emit_stmt copies it to LocalVar.is_let; let_check.ritz rejects
  # writes and `@&` into that binding's own storage.
  var_is_let: i32
  # AGAST #1953: for a StmtKind.VarDecl annotated `*[N]T`, N and T (as
  # Param.param_pointee_array_*); 0 / TypeKind.Void otherwise.
  var_pointee_array_size: i32
  var_pointee_array_elem_type: TypeKind
  var_pointee_array_elem_pointee: TypeKind  # AGAST #2343: U for `*[N]*U`; TypeKind.Void otherwise
  # AGAST #3663: the name S in `*[N]S` / `*[N]*S` (a generic's T among them);
  # empty otherwise.  Only monomorph reads it: the emitter names S from the
  # initializer.  A `*[N]T` local had no T, so its element stayed a struct "T".
  var_pointee_array_elem_name: StrView
  # AGAST #2570: for an inferred `let q = @x[i]` that leaves a plane of an N-D
  # array, the plane's `[M][N]..T` (pointee_array_size is then M*N.., the
  # flat count, and the elem T); null otherwise.  Set by infer_array_ptr_let.
  var_pointee_array_shape: *ArrayShape
  # AGAST #2308: for a StmtKind.VarDecl annotated `@T` / `@&T`, that type as a
  # param would declare it, which is where its referent is recorded; null
  # otherwise.  See capture_var_type.
  var_ref: *Param
  # AGAST #1869: for StmtKind.Assert, the `, "message"` text (empty if none).
  # Set by stmt_assert only: parser_alloc does not zero, so no other kind
  # may read it.  monomorph's byte copy carries it to clones.
  assert_msg: StrView
  # AGAST #2407: where a let / var / tuple / for statement's (first) name is,
  # for binder_check.ritz.  `span` is the keyword's, for DWARF.  Zero when
  # the statement binds nothing.
  name_span: SrcSpan
  # AGAST #2407: a tuple decl's second name's place (stmt_named2).
  name2_span: SrcSpan
  # AGAST #109: a tuple decl's names after its second, null for two.  Set by
  # stmt_tuple_decl only (parser_alloc does not zero); monomorph's byte copy
  # carries it to clones.
  tuple_more: *TupleName
  # AGAST #1625: for StmtKind.Defer, 1 for the block form (`defer` + an indented
  # block), 0 for `defer <stmt>`.  Set by stmt_defer only.
  defer_is_block: i32
  # AGAST #3394: for StmtKind.Asm, the block.  Set by stmt_asm only.
  asm_block: *AsmBlock
  # AGAST #2886: for StmtKind.IndexAssign, `n[i] = v` / `n[i] op= v`, where its `[`
  # is.  Set by stmt_assign_index only (parser_alloc does not zero).
  # AGAST #3015: for StmtKind.LocalFieldAssign, StmtKind.LocalFieldIndexAssign,
  # StmtKind.MemberAssign and StmtKind.MemberIndexAssign, where the field name is.
  bracket: SrcSpan
  # AGAST #2847: for StmtKind.LocalFieldIndexAssign and StmtKind.MemberIndexAssign,
  # where its `[` is (the token after the field name), so §7.8's errors are
  # located there.  Set by their constructors only.
  index_at: SrcSpan

# One line of an asm block, as written (AGAST #3394): leading indentation and
# a `#` comment are already gone (the lexer's asm body mode, lexer.ritz),
# and `{{` / `}}` are still doubled, for the emitter.  `text` points into the
# source; `span` is where its first character is.
struct AsmLine
  text: *u8
  len: i32
  span: SrcSpan
  next: *AsmLine

# An asm operand (AGAST #3394): a clause `in|out|inout name (: reg)?`, or a
# `{name}` in the text that no clause names (then an ASM_IN, unpinned).
struct AsmOperand
  name: StrView
  span: SrcSpan        # the name in its clause, else its first `{name}`
  dir: i32             # ASM_IN / ASM_OUT / ASM_INOUT
  reg: i32             # pinned register, ASM_REG_* index; ASM_REG_NONE if not
  reg_name: StrView        # the register as written (`rax`); null if not pinned
  reg_span: SrcSpan    # where reg_name is
  in_clause: i32       # 1 if a clause names it
  text_span: SrcSpan   # its first `{name}` in the text; line 0 if none
  kind: StrView            # the clause's first word (`in`, `out`, ...); null if none
  kind_span: SrcSpan
  next: *AsmOperand

# The body of a StmtKind.Asm (AGAST #3394).
struct AsmBlock
  arch: StrView
  lines: *AsmLine
  operands: *AsmOperand   # clause operands in clause order, then text-only inputs
  clobbers: i32           # bit (1 << ASM_REG_*) per `clobber` clause
  clause_count: i32       # every clause, `clobber` ones included
  first_clause: SrcSpan   # the first clause's first word; line 0 if none

# Generic type parameter (e.g., T in fn vec_new<T>())
struct TypeParam
  name: StrView
  next: *TypeParam  # For multiple params: <K, V>
  bounds: *TraitBound   # `<T: A + B>` (LANGUAGE_SPEC §11.5, AGAST #3469); null if none

# One trait of a type parameter's bound, `A` of `<T: A + B>`, where it is
# written: an unknown trait is an error there (trait_bound.ritz).
struct TraitBound
  name: StrView
  span: SrcSpan
  file: StrView     # the file it is written in (empty: the main file)
  next: *TraitBound

# Function parameter
struct Param
  name: StrView
  # AGAST #4528: the `*TypeRef` the parameter's type was parsed from.  The
  # flat param_* facts below are derived from it by the parser; lowering
  # registers the local from the chain.
  param_ty: *TypeRef
  param_type: TypeKind
  param_type_name: StrView  # Struct name when param_type == TypeKind.Struct
  param_pointee_type: TypeKind   # Element type when param_type == TypeKind.Ptr
  next: *Param
  # AGAST #1644: 1 for the `name:& T` borrow spelling.  It has the same
  # TypeKind.MutRef as `name: @&T`, but ritz0 auto-dereferences it: `x` reads
  # the pointee and `x = v` writes it.  (At the end to preserve layout; the
  # parser allocates 56 bytes and monomorph's clone 48, both >= 48.)
  is_borrow: i32
  # AGAST #1671: the signature of a `fn(...) -> T` param (null otherwise).
  # The param's own type is still TypeKind.Ptr; this only lets a call through
  # it use the callee's real LLVM signature.  Brings Param to 56 bytes,
  # which is what the parser allocates (monomorph clones with sizeof).
  fn_sig: *FnDef
  # AGAST #1815: innermost pointee of a `**T` param, as Stmt.var_inner_pointee_type.
  param_inner_pointee_type: i32
  # AGAST #2399: the reference nearest the pointee, INNER_REF_*: `@@S` and `*@S`
  # are held as an `@*S` / `**S`, and this keeps what that level was.
  param_inner_ref: i32
  # AGAST #1953: for a `*[N]T` param (param_pointee_type == TypeKind.Array), N
  # and T; 0 / TypeKind.Void otherwise.  A struct T is named by param_type_name.
  # Both allocators (param_new, monomorph's clone) use sizeof(Param).
  param_pointee_array_size: i32
  param_pointee_array_elem_type: TypeKind
  param_pointee_array_elem_pointee: TypeKind  # AGAST #2343: U for `*[N]*U`; TypeKind.Void otherwise
  # AGAST #2290: every dimension of a `:& [N][M]..T` referent; null otherwise.
  param_pointee_array_shape: *ArrayShape
  # AGAST #2287: for a by-value `[N]T` param (param_type == TypeKind.Array), N and
  # T; 0 / TypeKind.Void otherwise.  A struct or `*S` T is named by param_type_name,
  # as LocalVar.type_name names it.
  param_array_size: i32
  param_array_elem_type: TypeKind
  param_array_elem_pointee: TypeKind   # AGAST #2341: T for `[N]*T`; TypeKind.Void otherwise
  # AGAST #3634: every dimension of a by-value `[N][M]..T` (param_array_size is
  # then N and param_array_elem_type TypeKind.Array, as on an N-D local); null
  # otherwise.  A return type's ret_array_param carries it the same way.
  param_array_shape: *ArrayShape
  # AGAST #2286: 1 for `self:& T`, which is otherwise the same Param as
  # `self: @&T`.  It isn't is_borrow: that would make `self` an is_lent local.
  is_self_borrow: i32
  # AGAST #2308: U for `@*U` / `@&*U` / `:& *U` (param_pointee_type is then
  # TypeKind.Ptr, and a struct U is named by param_type_name); TypeKind.Void otherwise.
  param_ref_ptr_pointee: TypeKind
  # AGAST #2407: where the name is, for binder_check.ritz; zero when unknown.
  name_span: SrcSpan

# Function definition
struct FnDef
  name: StrView
  params: *Param
  return_type: TypeKind
  return_type_name: StrView   # Struct name when return_type == TypeKind.Struct
  body: *Stmt        # Linked list of statements
  line: i32          # Source line for DWARF debug info
  next: *FnDef
  type_params: *TypeParam   # Generic type parameters: <T>, <K, V>, etc. (at end to preserve layout)
  # AGAST #194: per-source-file emit control. Set to 1 by main() for fns
  # parsed from the input file (before resolve_imports), and by monomorph
  # for cloned instantiations (so each user module emits its own
  # internal copy, AGAST #4609). Imported (non-local) fns get is_local==0 and emit
  # as `declare` rather than full bodies, dropping per-file IR size by
  # an order of magnitude.
  is_local: i32
  # AGAST #2120: the signature of a fn-typed return (`-> EfiFn`), so
  # `get()(..)` calls typed and with the alias's [[callconv]]; null otherwise.
  ret_fn_sig: *FnDef
  # AGAST #2148: for a top-level fn, the file that defined it (a shared arena
  # copy; null for a fn no item dispatcher added), 1 if it carried a
  # [[target_os]] attribute, and 1 if it is a generated `E__from`.  Read by
  # main.ritz's fn-conflict checks only.
  def_file: StrView
  target_gated: i32
  from_generated: i32
  # AGAST #2308: for `-> @T` / `-> @&T`, that type as a param would declare it,
  # so a `:&` param returned here can be checked against it; null otherwise.
  ret_ref: *Param
  # AGAST #2343: for `-> [N]T`, its element; null otherwise.
  ret_array: *ArrayElem
  # AGAST #2329: for `-> *[N]T`, `-> @[N]T` or `-> @&[N]T`, that type as a param
  # would hold it (ptr_array_of_last); null otherwise.
  ret_ptr_array: *Param
  # AGAST #2302: for `-> [N]T`, that type as a by-value param would hold it
  # (param_array_size, param_array_elem_type, param_type_name), so the return
  # is spelled `[N x T]` as ritz0 spells it; null otherwise.
  ret_array_param: *Param
  # AGAST #3419 (LARB R45a): 1 for `pub fn`, so a call from another file to
  # one without it is refused (call_check's cc_private).  A monomorph instance
  # is 1: it has no declaration of its own to mark.  `col` is the declaration's
  # column (its `pub` or `fn`), for that error's note; 0 when unknown.
  is_pub: i32
  col: i32
  # AGAST #3419: 1 for a written `fn .. = extern` (decl_fn_def_new), which
  # declares a symbol defined elsewhere and isn't checked for `pub`; 0 for a
  # body strip_to_interface dropped, which shares its stripped_body().
  extern_decl: i32
  # AGAST #1456: 1 for `[pub] async fn` (fn_async).  async_lower.ritz lowers
  # each top-level one to ritz0's state machine (AGAST #3814).
  is_async: i32
  # AGAST #3507: the bindings of this fn that own a move-only value, as
  # Sema's move check (own_check.ritz) found them; null when none does.
  # ownership.ritz gives exactly these a drop flag.
  own_binds: *OwnedBinds
  # AGAST #4844: for a monomorph instance, where it was instantiated (the
  # notes an error inside it carries, diag.ritz); null for any other fn.
  inst_site: *InstSite

# AGAST #4844: the expression that first named a generic instance, as
# monomorph recorded it: `line:col` in the body of the requesting fn, which
# is `from` (a non-generic fn) or `from_site.inst` (another instance, made
# after the request, whose own inst_site continues the chain); how many other
# places name it; the instance as written (`name<args>.method`: `args` the
# mangled suffix "$Line", `method` empty for a generic fn); and `inst`, the
# instance once made.  diag_inst_notes prints the chain; ritz0's twin is
# instance_site.py.
pub struct InstSite
  line: i32
  col: i32
  from: *FnDef
  from_site: *InstSite
  more: i32
  name: StrView
  args: StrView
  method: StrView
  inst: *FnDef

# AGAST #3507: a fn's owned bindings (FnDef.own_binds): a by-value param, a
# `let` / `var`, a `let (a, b)` name or a match's payload binding that holds a
# move-only value (§13.1), each by the name pointer it was declared with, so
# every lowering of that declaration (a deferred statement is lowered at each
# exit) is the same binding.
struct OwnedBinds
  names: **u8
  count: i32
  cap: i32

# AGAST #4035 (#1889 FIX step 1): the parser's type, recursively.  A pointer or
# reference is the `pointee` chain; an array is `elem` plus `count` (and
# `shape` when it is multi-dimensional).  What used to be 17 `Parser.last_*`
# side channels is now the recursion itself, so a consumer the grammar hands a
# `*TypeRef` answers every question from it.
#
# `kind` is the flat TYPE_* code the rest of the compiler already speaks: a
# pointer whose pointee is a pointer is TypeKind.PtrPtr, exactly as the old
# type_ptr computed, so flat AST fields and the IR do not move.
struct TypeRef
  kind: TypeKind
  # AGAST #4450: when kind is DeepPtr, the packed inner-pointee slot it stands
  # for (lv_set_inner_pointee_type); 0 otherwise.
  deep_slot: i32
  name: StrView            # struct/generic name when kind == TypeKind.Struct
  pointee: *TypeRef    # inner of `*T` / `@T` / `@&T`; null otherwise
  elem: *TypeRef       # element of `[N]T`; null otherwise
  count: i64           # N of `[N]T`; 0 when unknown
  shape: *ArrayShape   # `[N][M]..T` shape; null for 1-D
  array_rec: *ArrayElem  # the `[N]T` record (ptr_array / ptr_plane) for a local
  fn_sig: *FnDef       # `fn(..) -> T` signature; null otherwise
  # AGAST #2399: the indirection nearest the pointee (INNER_REF_*), as
  # `inner_ref_of` reported; it is the inner level's when that is itself one.
  inner_ref: i32
  # For `@T` / `@&T`: the referent's flat kind, as `last_ref_inner_type` held.
  ref_inner: TypeKind

# Const declaration
struct ConstEntry
  name: StrView
  const_type: TypeKind   # Type of the constant (TypeKind.I32, TypeKind.I64, etc.)
  value: i64        # For integer constants (holds val.int_val)
  next: *ConstEntry
  # Extra metadata for non-integer constants (e.g., const arrays of struct literals).
  # Appended at the end to preserve the layout assumed by existing code that uses
  # only the classic fields above.
  value_expr: *Expr                 # Original AST for the initializer (null for int-only consts)
  array_size: i32                   # Array length when const_type == TypeKind.Array
  array_elem_type: TypeKind              # Element type (TypeKind.Struct, TypeKind.I32, etc.)
  array_elem_type_name: StrView     # Struct name when array_elem_type == TypeKind.Struct
  array_elem_pointee: TypeKind           # AGAST #2341: T for `[N]*T`; TypeKind.Void otherwise
  ptr_pointee: TypeKind                  # AGAST #2341: T for `const P: *T`
  # AGAST #189: struct type name for scalar `const FOO: StructTy = ...` —
  # the parser captures `last_type_name` from `parse_type_spec` so the
  # emitter can lower the const as a `%StructTy { ... }` global.
  type_name: StrView
  # AGAST #1502: `value` is the FOLDED initializer, not `value_expr.int_val`
  # (which is 0 for `-7`).  fold_state is one of CONST_FOLD_* (ast_helpers):
  # an integer const whose initializer names a const not yet parsed (a later
  # or imported one) stays PENDING until the emitter resolves it against the
  # merged module; one that cannot be folded is a located error there.
  # src_file is an arena copy (empty renders as "<input>"), recorded only for
  # consts not folded at parse time — the only ones that can error.
  fold_state: i32
  src_file: StrView
  line: i32
  col: i32
  # AGAST #2149: the file that defined this const (a shared arena copy, empty
  # when unknown) and 1 if it carried a [[target_os]] attribute.  Read by
  # main.ritz's check_const_conflicts only.
  def_file: StrView
  target_gated: i32
  # LARB R60 (AGAST #3480): 1 when this entry is a synthetic context standing
  # for a module-level `var`'s initialiser, so the shared const evaluator
  # reports `global 'g'` rather than `const 'g'` and a top-level string uses
  # the string pool rather than a `@.const.` backing global.  0 for a real
  # `const`.  The parser arena is zeroed, so every parsed entry gets 0.
  is_global: i32

# ConstEntry.fold_state (AGAST #1502)
const CONST_FOLD_DONE: i32 = 0      # `value` holds the folded initializer
const CONST_FOLD_PENDING: i32 = 1   # integer const not folded yet
const CONST_FOLD_ACTIVE: i32 = 2    # being resolved (cycle guard)
const CONST_FOLD_BAD: i32 = 3       # not a constant integer expression

# Struct field
struct StructField
  name: StrView
  field_type: TypeKind
  # For TypeKind.Struct fields (nested structs):
  field_type_name: StrView     # Struct name when field_type == TypeKind.Struct
  # For TypeKind.Array fields:
  array_size: i32              # Number of elements (e.g., 16 for [16]i32)
  array_elem_type: TypeKind         # Element type (e.g., TypeKind.I32, TypeKind.Struct)
  array_elem_type_name: StrView    # Struct name when array_elem_type == TypeKind.Struct
  array_elem_pointee: TypeKind      # AGAST #2341: T for `[N]*T`; TypeKind.Void otherwise
  ptr_pointee: TypeKind             # AGAST #2341: T for `p: *T`; TypeKind.Void otherwise
  field_mut_ref: i32           # AGAST #2337: 1 for `r: @&T`, which lower_ref_fields leaves a `*T`
  field_shared_ref: i32        # AGAST #2338: 1 for `r: @T`, likewise
  # AGAST #2399: the reference nearest the pointee, INNER_REF_*: `@@S` and `*@S`
  # are held as an `@*S` / `**S`, and this keeps what that level was.
  field_inner_ref: i32
  next: *StructField
  # AGAST #1924: for a `**T` field, T (packed with any deeper levels, see
  # PTR_DEPTH_UNIT); TypeKind.Void otherwise.  `*(*(s.rows + i) + k)` reads it.
  inner_pointee_type: i32
  # AGAST #2120: a fn-typed field's signature (`f: EfiFn`), null otherwise.
  fn_sig: *FnDef
  # AGAST #2097: every dimension of a `m: [N][M]..T` field (directly or via
  # a `type Grid = [N][M]T` alias), null for any other type.  array_size /
  # array_elem_type still hold the outer dim and TypeKind.Array.
  array_shape: *ArrayShape
  # AGAST #2329: for `r: *[N]T`, `@[N]T` or `@&[N]T`, that type as a param would
  # hold it (ptr_array_of_last); null otherwise.  `h.r[i]` is element i.
  ptr_array: *Param
  # AGAST #3151: U for an `r: @*U` / `@&*U` field, as Param.param_ref_ptr_pointee
  # keeps it (a struct U's name is field_type_name); TypeKind.Void otherwise, and in
  # a generic's instance, whose U may be a parameter.
  field_ref_ptr_pointee: TypeKind
  # AGAST #3666: for `fs: [N]fn(..) -> T`, the element's signature, so
  # `(t.fs[i])(..)` calls typed; null otherwise.  Not fn_sig, whose readers
  # take it to mean the field itself is a fn.
  elem_fn_sig: *FnDef

# Struct definition
struct StructDef
  name: StrView
  fields: *StructField
  next: *StructDef
  type_params: *TypeParam   # Generic type parameters: <T>, <K, V>, etc. (at end to preserve layout)
  # AGAST #3494 (LARB R65): the file that declares it, so an `impl` in
  # another file is refused (impl_placement.ritz); empty when unknown.
  def_file: StrView

# One variant of an enum declaration (AGAST #3994).  Before this it was a
# row in ast_helpers' parallel enum-variant tracker arrays; the data is
# unchanged, it just lives in the AST now.
struct EnumVariant
  name: StrView             # Points into the file's source
  kind: i32                 # ENUM_VARIANT_UNIT / _TUPLE / _STRUCT
  fields: *StructField      # Payload fields in declaration order; null for a unit variant
  discr: i64                # Discriminant bits: explicit `= N`, else the previous + 1, the first 0
  discr_neg: i32            # 1 when the discriminant is negative (else the bits read as a u64)
  next: *EnumVariant

# An enum declaration (AGAST #3994).  Before this it was an index into
# ast_helpers' parallel enum tracker arrays; it is an AST node now.
# `ei` in the compiler is a 0-based index into the program's merged list of
# these (Module.enums), preserving declaration order.
struct EnumDef
  name: StrView             # Points into the file's source; generic_enum_params
                            # reads the `<...>` that follows it
  generic: i32              # 1 for `enum Name<T>`, ENUM_INSTANCE for a monomorph instance, else 0
  repr: TypeKind                 # Representation type (TypeKind.U64, ...), 0 for none
  is_pub: i32               # 1 for `pub enum`
  line: i32                 # Line of the name (where the generated `from` source starts)
  variants: *EnumVariant
  next: *EnumDef
  # AGAST #3494 (LARB R65): the file that declares it, as StructDef.def_file.
  # Empty for a monomorph instance, which no file declares.
  def_file: StrView

# Import path segment (linked list for "ritzlib.sys" -> ["ritzlib", "sys"])
struct ImportPath
  segment: StrView   # The segment, in the source
  next: *ImportPath  # Next segment

# A name in `import m { a, b }`, where it is written (AGAST #3467: LARB R54
# refuses one `m` doesn't define, at the name).
struct ImportItem
  name: StrView      # Points into the file's source
  line: i32
  col: i32
  next: *ImportItem  # The next name, in source order

# Import declaration
struct ImportDecl
  path: *ImportPath  # Path segments (e.g., ritzlib.sys)
  next: *ImportDecl  # Next import
  is_pub: i32        # 1 for `pub import`, a re-export (AGAST #3891)
  items: *ImportItem # The selective list; null for a plain import (#3467)

# Global variable definition
struct GlobalVarDef
  name: StrView
  var_type: TypeKind          # TypeKind.I32, TypeKind.I64, TypeKind.Ptr, TypeKind.Struct, etc.
  type_name: StrView     # For struct types
  init_expr: *Expr       # Optional initializer expression (can be 0)
  next: *GlobalVarDef
  # Pointee type for var_type == TypeKind.Ptr — needed so emit_expr_arith
  # can scale `*(g + i)` by the right element size.  Without this, *i32
  # globals like `var g_inst_name_lens: *i32 = null` emit raw `add i64`
  # without stride and `load i64` without width, producing garbage reads
  # — surfaced as the selfhost-only 8-test gap (monomorph couldn't read
  # back instantiation name_lens, so specialization names were lost).
  pointee_type: TypeKind
  # AGAST #190: array dimensions for `var g: [N]T` globals.  Without these
  # the global was emitted as `i64 zeroinitializer` instead of
  # `[N x %T] zeroinitializer`, and any `g[i]` indexing flowed through the
  # generic emit_expr path with no array-stride context — producing
  # "; ERROR: unhandled EXPR_MEMBER" for `g[i].field` (nexus's
  # `var g_fallback: [100]FallbackPage` in store.ritz fallback_init /
  # fallback_find).  Mirrors LocalVar.array_size / array_elem_type.
  array_size: i32                   # Array size when var_type == TypeKind.Array
  array_elem_type: TypeKind              # Element type (TypeKind.Struct, TypeKind.I32, ...)
  array_elem_type_name: StrView     # Struct name when array_elem_type == TypeKind.Struct
  array_shape: *ArrayShape          # AGAST #1509: non-null for `[N][M]..T`
  array_elem_pointee: TypeKind           # AGAST #2341: T for `[N]*T`; TypeKind.Void otherwise
  # AGAST #1501: where the declaration lives, so emit_global_vars can give a
  # non-constant initializer a "<file>:<line>:<col>" error.  src_file is a
  # copy in the parser arena (the driver drops an import's path String once
  # the import is parsed); null renders as "<input>".
  src_file: StrView
  line: i32
  col: i32
  # AGAST #1908: St for `var g: *St`, null otherwise.  Read only by
  # emit_ptr_elem_member_ptr (`g[i].field`); type_name stays null for
  # pointers because its other readers treat it as "g is a St value".
  pointee_type_name: StrView
  # AGAST #1815: innermost pointee of a `var g: **T`, as Stmt.var_inner_pointee_type.
  inner_pointee_type: i32
  inner_ref: i32   # AGAST #2399: as Stmt.var_inner_ref
  # AGAST #1879: 1 for `extern var NAME: T` -- a data symbol defined in
  # another object, emitted as `@NAME = external global T`.
  is_extern: i32
  # AGAST #2329: for `var g: *[N]T` (or `@[N]T`, `@&[N]T`), that type as a param
  # would hold it (ptr_array_of_last); null otherwise.  `g[i]` is element i.
  ptr_array: *Param
  # AGAST #4324: the signature of `var g: fn(..) -> T` (a fn-typed global's
  # TypeKind.Ptr), so an assignment to it is judged and its type spelled as a
  # local's is; null for every other global.
  fn_sig: *FnDef

# Impl block definition
# Represents: impl<T> Trait for Type { methods... } or impl<T> Type { methods... }
# For "impl<T> Drop for Vec<T>":
#   - trait_name = "Drop" (ptr/len)
#   - type_name = "Vec" (ptr/len)
#   - type_params = linked list with T
#   - methods = linked list of FnDef
# For inherent impl "impl<T> Vec<T>":
#   - trait_name = nil (0 ptr)
#   - type_name = "Vec" (ptr/len)
struct ImplBlock
  trait_name: StrView    # Trait name (empty for inherent impl)
  type_name: StrView     # Type being implemented for (e.g., "Vec", "String")
  type_params: *TypeParam # Generic params: <T>, <K, V>, etc.
  methods: *FnDef        # Linked list of methods
  next: *ImplBlock       # Next impl block in module
  # AGAST #3015: where the trait name is, for `Deref` / `DerefMut` (R17's
  # rule-1 errors are located there) and "unknown trait" (#4211); zero for
  # an inherent impl.
  trait_span: SrcSpan
  # AGAST #3162: where the `impl` keyword is, and its file (empty: the main
  # file), so an impl on a built-in type is refused there.
  impl_span: SrcSpan
  def_file: StrView
  # AGAST #3264: where the target's name is ("unknown type" is located there).
  type_span: SrcSpan
  # AGAST #4294: 1 for `impl Trait for *u8`; type_name is then "ptr_u8".
  ptr_target: i32
  # AGAST #4002 (LARB R81) / #3494 (LARB R65): the target's type arguments as
  # written (`<u8>` of `impl G<u8>`, `<K, i32>` of `impl<K> Speak for P<K,
  # i32>`); null when it wrote none.  refuse_impls_on_unknown_types judges each
  # one, and impl_placement.ritz refuses an impl that pins a concrete
  # instantiation.  In `impl Box<T>` without `<T>`, `T` is an ordinary type
  # name; when it names nothing it is "unknown type `T`", at `at`.
  impl_args: *GenericArg

# Module (top-level)
struct Module
  imports: *ImportDecl   # List of import declarations
  constants: *ConstEntry
  structs: *StructDef
  enums: *EnumDef        # Enum declarations (AGAST #3994), in declaration order
  functions: *FnDef
  globals: *GlobalVarDef # Global variables
  impls: *ImplBlock      # Impl blocks

# Postfix operation kinds
const POSTFIX_CALL: i32 = 1
const POSTFIX_INDEX: i32 = 2
const POSTFIX_MEMBER: i32 = 3
const POSTFIX_CAST: i32 = 4
const POSTFIX_TRY: i32 = 5       # Try operator `?`; applied by apply_postfix_p (AGAST #134)

# Binary operation chain (for left-factored grammar)
# Used to avoid exponential backtracking in expression parsing
struct BinaryOp
  op: OpKind           # OpKind.Add, OpKind.Sub, etc.
  right: *Expr      # Right operand
  next: *BinaryOp   # Next operation in chain (for a + b + c)

# Cast operation chain (for left-factored cast expression)
# Handles: expr as type1 as type2 ...
struct CastTail
  cast_type: TypeKind    # TypeKind.I32, TypeKind.Ptr, etc.
  # AGAST #1453: for `as *T`, the pointee kind (TypeKind.Struct, TypeKind.I32, ...)
  # and, for a struct pointee, its name.  TypeKind.Void / null when unknown.
  # Copied onto the ExprKind.Cast node by apply_cast_tail.
  pointee_type: i32
  # #4035: the `*T` / `@T` / `@&T` pointee a cast leaves on the ExprKind.Cast node
  # (Expr.cast_pointee), derived from the tail's *TypeRef.
  cast_pointee: TypeKind
  next: *CastTail   # Next cast in chain
  pointee_name: StrView
  fn_sig: *FnDef    # AGAST #2120: `as Fn` (outermost cast only), else null
  array: *ArrayElem # AGAST #2343: `as [N]T` (outermost cast only), else null
  ptr_array: *Param # AGAST #4122: `as *[N][M]T` (outermost cast only), else null
  as_at: SrcSpan    # AGAST #3040: where this tail's `as` is

# A generic type argument as the parser captured it (first_generic_type_arg):
# its kind, its mangled spelling, and where it is written.
struct GenericArg
    ty: TypeKind
    name: StrView
    next: *GenericArg
    # AGAST #4021: the name the argument ends with as written (`Nope` of
    # `*Nope`), which type_generic_with_saved notes; null when it ends with
    # no name (`Vec<T>`, whose own arguments were noted).
    written: StrView
    # AGAST #3469: where the argument starts (`B` of `A<B<C>>`), so a failed
    # trait bound is located at it; line 0 when unknown.
    at: SrcSpan

# Postfix operation (for building expression chains)
struct PostfixOp
  kind: i32
  # For POSTFIX_CALL
  args: *Expr
  call_type_suffix: StrView      # Type suffix for generic calls, e.g., "$u8" for vec_new<u8>()
  call_targs: *GenericArg    # its type args as written (AGAST #3469); null if none
  # For POSTFIX_INDEX
  index: *Expr
  # For POSTFIX_MEMBER
  member_name: StrView
  # For POSTFIX_CAST
  cast_type: TypeKind
  # Linked list
  next: *PostfixOp
  # For POSTFIX_INDEX: where its `[` is (AGAST #2452), for the ExprKind.Index it makes
  bracket: SrcSpan

# Match arm: one case of a match expression/statement
# For StmtKind.Match / ExprKind.Match:
#   - Stmt uses if_cond = scrutinee expr, if_then recast as *MatchArm
#   - Expr uses left = scrutinee expr, args recast as *MatchArm
# Pattern data is inlined (flat) so we don't need a separate Pattern struct.
# Variant patterns use pattern_inner_kind to describe the single payload slot.
struct MatchArm
    pattern_kind: i32              # PAT_INT_LIT | PAT_WILDCARD | PAT_IDENT | PAT_VARIANT | PAT_BOOL | PAT_STR | PAT_CHAR
    pattern_int: i64               # Value when PAT_INT_LIT, PAT_CHAR or PAT_BOOL
    pattern_name: StrView          # Name when PAT_IDENT (binding) or PAT_VARIANT (constructor name); bytes when PAT_STR
    pattern_inner_kind: i32        # For PAT_VARIANT: PAT_WILDCARD or PAT_IDENT (payload binding)
    pattern_inner_name: StrView    # For PAT_VARIANT with PAT_IDENT inner
    body: *Expr                    # Arm body expression (null when is_pass == 1)
    is_pass: i32                   # 1 if arm body is `pass` (no-op; emits default i64 0)
    # Block-bodied arm (`None =>` + indented statements, AGAST #1454) or a
    # statement arm (`5 => r = 5`, #1617): the statements run before `body`.
    # match_arm_set_block detaches a trailing bare expression into `body`, so
    # every pass that only reads `body` still sees the arm's value.  Null for
    # an expression arm.
    body_stmts: *Stmt
    next: *MatchArm                # Linked list of arms
    # AGAST #2236: where a `pass` arm's `pass` is, for the diagnostic in
    # tail_value.ritz.  An arm has no other span, and is_pass drops the
    # expression that carried one.  Zero for every other arm.
    pass_span: SrcSpan
    # AGAST #2344: where a PAT_BOOL arm's pattern is, for the error when the
    # scrutinee is no bool.  Zero for every other arm.
    bool_span: SrcSpan
    # AGAST #2405, #2407: where a PAT_VARIANT arm's payload name is, for the
    # error when it binds a module value's name (binder_check.ritz).  Zero for
    # every other arm.
    pattern_inner_span: SrcSpan
    # AGAST #2407: where a bare PAT_IDENT arm's name is, for the error when it
    # binds a module value's name (binder_check.ritz).  Zero for every other
    # arm, a qualified `E.V` included: that one is always a variant.
    pattern_span: SrcSpan
    # AGAST #2431: where an arm's pattern begins (`Ok` in `Ok(v)`, `E` in
    # `E.V` / `E.V(v)`, `5`, `_`), for the error when the scrutinee's enum
    # doesn't declare it, and for the error at an arm no value can reach and
    # the arm that covers it (#2349).
    head_span: SrcSpan
    # AGAST #2215: the `m` of a qualified PAT_IDENT `m.K` (empty otherwise), for
    # the error when it is module access rather than an enum's variant.
    qualifier: StrView
    # AGAST #1295: a PAT_VARIANT arm's positional bindings, `Rect(w, h)`.
    # pattern_bind_count is how many it names (0 for a non-variant arm, 1 for
    # the single-binding `Some(v)`); pattern_binds lists them all (a `_` is a
    # wildcard slot) when there are two or more, null otherwise.  The
    # pattern_inner_* fields always describe the SELECTED binding, field
    # pattern_field_sel of the variant (arm_select_bind): every pass that
    # handled the one binding walks the others by selecting each in turn.
    pattern_binds: *TupleName
    pattern_bind_count: i32
    pattern_field_sel: i32
    # AGAST #3028: 1 for a block or statement arm (match_arm_set_block), even
    # `0 =>` + one `t`, which leaves body_stmts null like `0 => t`.  Its value
    # is a block's tail; an expression arm's is the match's own.
    is_block: i32
    # AGAST #4543: 1 on the synthetic `pass` else-arm expr_if_open adds to an
    # else-less block `if` used as a value, so if_arm_check can tell it from a
    # real arm whose block merely ends without an expression (also is_pass).
    else_missing: i32
    # AGAST #4450: an or-pattern `A | B | C =>`.  This arm's own pattern
    # fields are the first alternative; or_next chains the others, each a
    # MatchArm holding only a pattern (no body, no next).  Null for an arm
    # with one pattern.  arm_pattern_next walks an arm list alternative by
    # alternative.
    or_next: *MatchArm

# Field initializer in struct literal
struct FieldInit
  name: StrView
  value: *Expr
  next: *FieldInit

# Token structure is defined in tokens_gen.ritz to avoid duplication
# Parser state
struct Parser
  tokens: *Token
  token_count: i32
  pos: i32
  error: i32
  error_msg: *u8
  heap_base: *u8
  heap_offset: i64
  module: *Module
  # For variable type declarations - stores the type name before initializer parsing overwrites it
  var_type_name: StrView
  # AGAST #2805: and the pointee and inner pointee slot of a `*T` / `**T`
  # annotation, which `<*S>` in the initializer would overwrite.
  var_pointee: TypeKind
  var_inner_pointee: i32
  var_inner_ref: i32
  # Conditional compilation: set to 1 by parse_attr when it sees
  # [[target_os = "xxx"]] where xxx != the target OS. Consumed (and reset) by
  # parse_item's module_add_* calls to skip adding that item to the module.
  skip_item: i32
  # AGAST #1671: the signature latched across a `let` initializer, so a
  # `fn(...) -> T`-typed local calls typed.
  var_fn_sig: *FnDef
  # AGAST #2943: high-water mark of p.pos, raised by p_advance.  Backtracking
  # rewinds p.pos but not this, so when an item fails it is the token the
  # deepest attempt stopped at (the `>>` of a bad type), which
  # parser_report_dropped_item reports.  It is never lowered: items parse in
  # order, so a failing item's mark is past any earlier item's, and a
  # recovery re-try from an anchor inside the failed item keeps the mark
  # already reported and is not reported again.
  max_pos: i32
  # AGAST #1819: farthest EXPECTED-token failure, for the "expected ..." half
  # of a located parse error.  p_expect records the token index it failed at
  # (only raising the mark) and the kinds it wanted there, as a 3x u64 bitset
  # (token kinds are 0..141).  Rewinding p.pos does not rewind these;
  # p_clear_fail starts a fresh item.  fail_pos is -1 when nothing has failed.
  fail_pos: i32
  fail_b0: u64
  fail_b1: u64
  fail_b2: u64
  # AGAST #4623: the compile's parse state, shared by every file's Parser
  # (ParseCtx, below); set by parser_init.
  ctx: *ParseCtx

# =============================================================================
# ParseCtx: the compile's parse state (AGAST #4623)
# =============================================================================
# What ast_helpers.ritz kept in module globals.  ast_helpers documents each
# field (its `# State: ParseCtx.x` lines) and makes the one per compile
# (parse_ctx_new); it is declared here so Parser.ctx resolves, as are the
# list nodes it holds, each documented where ast_helpers fills it.

struct ParseCtx
    parser_arena_cap: i64
    fn_count: i32
    target_os: StrView
    target_arch: StrView
    test_fns: *i64
    test_fn_count: i64
    test_fn_cap: i64
    gated_names: **u8
    gated_lens: *i32
    gated_count: i32
    gated_cap: i32
    parse_file: StrView
    dropped_items: i32
    last_drop_at: i32
    parse_reported: i32
    attr_bits: i32
    attr_target_os: u64
    attr_target_arch: u64
    attr_errors: i32
    attr_last_err: *u8
    item_attrs: *i64
    item_attr_count: i64
    item_attr_cap: i64
    index_impl_last_err: *u8
    generic_method_last_err: *u8
    stripped_body: Stmt
    decl_last_err: *u8
    trait_names: **u8
    trait_lens: *i32
    trait_files: *StrView
    trait_count: i32
    trait_cap: i32
    shared_file_copy: StrView
    drop_last_err: *FnDef
    type_name_at: *TypeNameAt
    tn_pending: *TnNote   # noted, no item has claimed them yet
    tn_scopes: *TnScope
    tn_enum_params: *TypeParam   # the enum being parsed
    var_ref: *Param
    var_array: *ArrayElem
    var_array_size: i32
    var_ptr_array_size: i32
    var_ptr_array_elem: TypeKind
    var_ptr_array_elem_pointee: TypeKind
    var_ptr_array_shape: *ArrayShape   # AGAST #2098: `*[N][M]T`
    var_ptr_array_elem_name: StrView   # AGAST #3663: S in `*[N]S`
    var_latch: *VarLatch
    nd_reject_line: i32
    nd_reject_col: i32
    lit_len_line: i32
    lit_len_col: i32
    dyn_last: *u8
    closure_last: *u8
    array_len_pending: i32
    array_len_reparse: i32
    array_len_seed: *ConstEntry
    array_len_line: i32
    array_len_col: i32
    alias_table: **u8
    alias_count: i32
    alias_stale: bool   # AGAST #4769: a replayed alias changed; parse again
    tdl_names: **u8
    tdl_lens: *i32
    tdl_count: i32
    tdl_cap: i32
    aul_names: **u8
    aul_lens: *i32
    aul_spans: *SrcSpan
    aul_count: i32
    aul_cap: i32
    generic_uses: *GenericUse
    tuple_regs: *TupleReg
    tuple_lits: i32
    tuple_ret_slot: *StructDef
    tuple_p: *Parser   # tuple_resolve_module's, for the AST built here
    tuple_split_n: i32   # numbers the arm-index locals, unique per compile
    asm_last_block: *u8
    pass_bound: i32
    open_if_end: i32
    named_forms: *NamedForm
    program_enums: *EnumDef
    # AGAST #4609: type_twins.ritz's renames, and the variant views and the
    # current use's file ast_helpers enum_of_variant_unique reads.
    twin_renames: Vec<TwinRename>
    variant_views: Vec<VariantView>
    variant_site: StrView

# AGAST #4609 (type_twins.ritz): the twin `name`, renamed `new_name` in the
# module whose VisMod key is `seer` (one pointer per module).
struct TwinRename
    name: StrView
    new_name: StrView
    seer: *u8

# AGAST #4609 (enum_of_variant_unique): does the file `site` (a fn's
# diag_fn_source_file) see the enum `e`?
struct VariantView
    site: StrView
    e: *EnumDef
    seen: i32

struct TypeNameAt
    name: *u8
    line: i32
    col: i32
    file: StrView
    reported: i32
    next: *TypeNameAt

struct TnNote
    name: *u8
    len: i32
    next: *TnNote

struct TnScope
    inner: *TypeParam   # the item's own type parameters
    outer: *TypeParam   # a method's impl's
    notes: *TnNote
    fn_def: *FnDef      # the method impl_block_new looks for, else null
    next: *TnScope

struct VarLatch
    tokens: *Token
    line: i32
    col: i32
    below: *VarLatch
    type_name: StrView
    pointee: TypeKind
    inner_pointee: i32
    inner_ref: i32   # AGAST #2399
    fn_sig: *FnDef
    ref: *Param
    array: *ArrayElem
    array_size: i32
    ptr_array_size: i32
    ptr_array_elem: TypeKind
    ptr_array_elem_pointee: TypeKind
    ptr_array_shape: *ArrayShape
    ptr_array_elem_name: StrView

struct GenericUse
    name: StrView          # `Holder`, `total`
    suffix: StrView        # `$Nope`
    args: *GenericArg  # as written, each with its `at`; null when inferred
    at: SrcSpan        # an inferred call: the call; line 0 otherwise
    file: StrView          # empty: the main file
    next: *GenericUse

struct TupleElem
    ga: *GenericArg       # the element's mangled spelling
    field: *StructField   # the element as a field of the synthesized struct
    next: *TupleElem

struct TupleReg
    def: *StructDef
    fresh: i32       # 1 until the module that registered it ends
    next: *TupleReg
    elems: *TupleElem   # AGAST #2975: each element's spelling, for tuple_subst
    placed: i32         # 1 once def is in a module's struct list

struct NamedForm
    arm: *MatchArm   # a named pattern, else null
    lit: *Expr       # a struct literal (ExprKind.StructLit), else null
    name: StrView        # the variant's name (a literal's, which may be a struct's)
    qual: StrView        # the `E` of `E.V { .. }`, else null
    span: SrcSpan    # where the form begins, for its errors
    file: StrView
    next: *NamedForm

# Note: AST construction helpers are in ast_helpers.ritz (with parser allocation)
# The simpler helpers below are deprecated and were used for early development.
# They conflict with ast_helpers.ritz functions that have different signatures.
