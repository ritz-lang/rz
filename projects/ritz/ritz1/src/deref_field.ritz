# deref_field.ritz - `.` through a struct's `Deref` / `DerefMut` (LANGUAGE_SPEC
# §7.7, LARB ruling R17, AGAST #3015), resolved on Sema (AGAST #3509, #1816).
#
# A struct opts into `.` reaching through it with two compiler-known traits,
# resolved statically by name like `Drop` and R15's `Index`:
#
#   impl Deref for S        fn deref(self: @S) -> @T
#   impl DerefMut for S     fn deref_mut(self: @&S) -> @&T
#
# `s.f` is S's own field or method first; otherwise, when S implements `Deref`,
# T's, one step only.  Sema resolves each statement as its walk reaches it
# (sema_walk.ritz), with the statement's locals in its typed scope, before any
# other check sees it: a field reached through the trait, `s.f`, becomes
# `(*S_deref(@s)).f` for a shared use and `(*S_deref_mut(@&s)).f` for a mutable
# one, and a method of T, `s.m()`, takes the reference the call returns as its
# receiver.  Each call made here carries its annotation, Expr.deref_step: the
# method it calls and the place it lends.  The emitter lowers ordinary places
# (find_call_fn finds `S_deref` by its symbol) and ref_check reads the
# annotation; the emitter rewrites nothing.
#
#   shared   a read, `s.f.g`, `s.f[i]`, `@s.f`, `for x in s.f`, `s.m()` (self: @T)
#   mutable  `s.f = v`, `s.f op= v`, `s.f[i] = v`, `s.f.g = v`, `@&s.f`, a `:&`
#            argument, `s.m()` with `self: @&T`
#
# `s.f op= v` calls `deref_mut` once: its read and store share the call
# (struct_index.ritz's si_once, AGAST #2529).
#
# The errors are ritz0's words (ritz0/deref_rules.py), located at the field
# name; ritz0/test_ritz1_box_field.py holds all three compilers to them.  The
# calls made here are steps of their receiver's place for the loan check
# (ref_check.ritz, R11a): df_step_recv.

import ritzlib.cstr
import ritzlib.sys
import ritzlib.io
import ritzlib.memory
import ritzlib.str
import ritzlib.string  # strview_join3 (AGAST #4915); messages are built in a String
import ritzlib.fmt.digits  # fmt_u64_into (AGAST #4924)

import ast
import ast_helpers
import struct_index
import ast_query   # name_eq & co., off emitter_core (AGAST #3513)
import sema
import sema_type
import ritzlib.strview

# Which traits a struct implements, as a mask.
const DF_DEREF: i32 = 1
const DF_DEREF_MUT: i32 = 2

# How a place is used, which picks the method (and spells a refusal).
const DF_READ: i32 = 0
const DF_STORE: i32 = 1       # `s.f = v`, `s.f[i] = v`, `s.f.g = v`
const DF_COMPOUND: i32 = 2    # `s.f op= v`
const DF_ADDR_MUT: i32 = 3    # `@&s.f`, a `:&` argument
const DF_MUT_CALL: i32 = 4    # `s.f.m()` with a mutating `m` (g_df_call)

var g_df_call: StrView     # the mutating method's name, under DF_MUT_CALL
var g_df_once: i32 = 0      # 1 while walking the place of `x op= v`
var g_df_changed: i32 = 0   # the steps made, so a statement form knows to convert

# ----------------------------------------------------------------------------
# The steps: each call made here carries a DerefStep (ast.ritz), with the place
# it lends (null when its receiver is already a pointer or reference, which is
# no place of a local).  Every other Expr's deref_step is null.
# ----------------------------------------------------------------------------

# 1 when `e` is a `deref` / `deref_mut` call made here.
pub fn df_is_step(e: *Expr) -> i32
    (e != null and e.kind == ExprKind.Call and e.deref_step != null) as i32

# The place `x` whose step the call `e` is, when `x` is held by value; else null.
pub fn df_step_recv(e: *Expr) -> *Expr
    if df_is_step(e) == 0
        return null
    e.deref_step.recv

# `*e` with `e` a step on a place held by value: that place, else null.  A step
# `*` is a path step of it (R17 rule 6).
pub fn df_deref_step_recv(e: *Expr) -> *Expr
    if e == null or e.kind != ExprKind.Unary or e.op != OpKind.Deref
        return null
    df_step_recv(e.operand)

# ----------------------------------------------------------------------------
# Messages
# ----------------------------------------------------------------------------

# `…` (U+2026).
fn df_put_ellipsis(b:& String)
    b.push_str("…")

# How many type parameters the generic struct `head` declares, 0 for any other name.
fn df_arity(sm: *Sema, head_sv: StrView) -> i32
    var st: *StructDef = sm.module.structs
    while st != null
        if st.type_params != null and name_eq(st.name, head_sv) == 1
            var n: i32 = 0
            var tp: *TypeParam = st.type_params
            while tp != null
                n += 1
                tp = tp.next
            return n
        st = st.next
    0

# Append the type at `pos` of the mangled `name` to `out`, as the source
# spells it.  False when the arities can't account for the name.
fn df_display_take(sm: *Sema, name: StrView, pos:& i32, out:& String) -> bool
    let start: i32 = pos
    var end: i32 = start
    while end < name.len and name.get(end) != '$'
        end += 1
    if end == start
        return false
    let head: StrView = name.skip(start).take(end - start)
    out.push_str(head)
    pos = end
    let n: i32 = df_arity(sm, head)
    if n == 0
        return true
    out.push('<')
    var k: i32 = 0
    while k < n
        if pos >= name.len
            return false
        pos = pos + 1   # the `$`
        if k > 0
            out.push_str(", ")
        if not df_display_take(sm, name, pos, out)
            return false
        k += 1
    out.push('>')
    true

# A monomorphised type name as the source spells it: `Box$H` is `Box<H>`,
# `Pair$i64$i32` is `Pair<i64, i32>` (ritz0: deref_rules.display).
fn df_display(sm: *Sema, name: StrView, out:& String)
    var tmp: String = string_new()
    var pos: i32 = 0
    if df_display_take(sm, name, pos, tmp) and pos == name.len
        out.push_string(@tmp)
    else
        out.push_str(name)

# 1 for a receiver spelled as written: an ident, or a member chain of idents.
fn df_plain(x: *Expr) -> i32
    if x == null
        return 0
    match x.kind
        ExprKind.Ident =>
            return 1
        ExprKind.Member =>
            return df_plain(x.left)
        _ => pass
    0

fn df_spell_plain(x: *Expr, out:& String)
    if x.kind == ExprKind.Member
        df_spell_plain(x.left, out)
        out.push('.')
    out.push_str(x.ident)

# The receiver `x` as the source writes it, or `s`.
fn df_spell(x: *Expr, out:& String)
    if df_plain(x) == 1
        df_spell_plain(x, out)
    else
        out.push('s')

# Each place reported once: a match arm's value can be walked twice, and the
# emitter's own refusal (df_no_field_once) says what Sema did not.
var g_df_err_at: *i64 = null
var g_df_err_count: i32 = 0
var g_df_err_cap: i32 = 0

# 1 the first time `line:col` is asked, recording it; 0 after.
fn df_first_at(line: i32, col: i32) -> i32
    let key: i64 = ((line as i64) << 20) | (col as i64)
    var i: i32 = 0
    while i < g_df_err_count
        if *(g_df_err_at + i) == key
            return 0
        i += 1
    if g_df_err_count == g_df_err_cap
        var cap: i32 = 16
        if g_df_err_cap > 0
            cap = g_df_err_cap * 2
        let grown: *i64 = malloc((cap as i64) * 8) as *i64
        var j: i32 = 0
        while j < g_df_err_count
            *(grown + j) = *(g_df_err_at + j)
            j += 1
        g_df_err_at = grown
        g_df_err_cap = cap
    *(g_df_err_at + g_df_err_count) = key
    g_df_err_count += 1
    1

# A located error (diag's `<file>:<line>:<col>: error: `, AGAST #3445), in
# the words the emitter used.
fn df_error(sm: *Sema, line: i32, col: i32, msg: StrView)
    sema_error_at(sm, line, col)
    eprints(msg)
    eprints("\n")

fn df_report(sm: *Sema, line: i32, col: i32, msg: StrView)
    if df_first_at(line, col) == 1
        df_error(sm, line, col, msg)

# Where the field (or method) name of the member `e` is.
pub fn df_line(e: *Expr) -> i32
    if e.bracket.line > 0
        return e.bracket.line
    e.span.line

pub fn df_col(e: *Expr) -> i32
    if e.bracket.line > 0
        return e.bracket.col
    e.span.col

# ----------------------------------------------------------------------------
# Lookup: the type of a receiver is sema_expr_ty's (AGAST #3810), with the
# locals sema_walk binds typed.  TypeKind.Unknown is left alone, as the emitter
# left a receiver it could not type.
# ----------------------------------------------------------------------------

fn df_is_ptr(kind: TypeKind) -> i32
    (kind == TypeKind.Ptr or kind == TypeKind.Ref or kind == TypeKind.MutRef) as i32

# The struct `x.f` looks in, through `*` / `@` / `@&` (§7.7's auto-deref), or an
# element `vv[i]`; null otherwise.
fn df_struct_of(sm: *Sema, x: *Expr) -> *StructDef
    if x == null
        return null
    var b: SemaTy
    sema_expr_ty(sm, x, @b)
    let st: *StructDef = sema_recv_struct(sm, @b)
    # A container is no element's type: unknown, left alone.
    if st != null and x.kind == ExprKind.Index and si_built_in(st.name) == 1
        return null
    st

fn df_base_len(name: StrView) -> i32
    var i: i32 = 0
    while i < name.len and name.get(i) != '$'
        i += 1
    i

# The traits `st` implements: a non-generic impl names it, a generic one its base
# (`impl<T> Deref for Box<T>` is `Box$H`'s).
fn df_traits(sm: *Sema, st: *StructDef) -> i32
    var mask: i32 = 0
    let bl: i32 = df_base_len(st.name)
    var ib: *ImplBlock = sm.module.impls
    while ib != null
        if ib.trait_name.ptr != null
            var hit: i32 = 0
            if ib.type_params == null
                hit = name_eq(ib.type_name, st.name)
            else if bl < (st.name.len as i32)
                hit = name_eq(ib.type_name, st.name.take(bl as i64))
            if hit == 1
                if name_eq(ib.trait_name, "Deref") == 1
                    mask = mask | DF_DEREF
                else if name_eq(ib.trait_name, "DerefMut") == 1
                    mask = mask | DF_DEREF_MUT
        ib = ib.next
    mask

# `st`'s `deref`, whose `-> @T` names the T it reaches; null when there's none.
fn df_deref_fn(sm: *Sema, st: *StructDef) -> *FnDef
    let fd: *FnDef = sema_method_fn(sm, st.name, "deref")
    if fd == null or fd.return_type_name.ptr == null or fd.return_type_name.len <= 0
        return null
    fd

fn df_field(st: *StructDef, name_sv: StrView) -> *StructField
    if st == null
        return null
    let fi: i32 = find_field_index(st, name_sv)
    if fi < 0
        return null
    get_field_type(st, fi)

# The field the member `e` (`x.f`) names, its receiver typed as `.` types it
# (sema_expr_ty: a name, `*p`, an element, a call or a method call's result); null
# when `e` is no member or the receiver isn't a known struct.  Read once the
# statement is resolved (deref_field_stmt), as discarded_array does (#3512).
pub fn df_member_field(sm: *Sema, e: *Expr) -> *StructField
    if e == null or e.kind != ExprKind.Member or e.left == null
        return null
    var r: SemaTy
    sema_expr_ty(sm, e.left, @r)
    df_field(sema_recv_struct(sm, @r), e.ident)

# The struct a field of that type is, by value or behind a pointer or reference.
fn df_field_struct(sm: *Sema, f: *StructField) -> *StructDef
    if f == null or f.field_type_name.len <= 0
        return null
    if f.field_type == TypeKind.Struct or f.field_type == TypeKind.Ptr or f.field_type == TypeKind.Ref or f.field_type == TypeKind.MutRef
        return sema_find_struct(sm, f.field_type_name)
    null

# The struct `x` will be once its members are rewritten (a receiver's type,
# known before the receiver is walked).
fn df_peek_struct(sm: *Sema, x: *Expr) -> *StructDef
    if x == null
        return null
    if x.kind == ExprKind.Member and x.left != null
        let bst: *StructDef = df_peek_struct(sm, x.left)
        if bst != null
            var f: *StructField = df_field(bst, x.ident)
            if f == null and (df_traits(sm, bst) & DF_DEREF) != 0
                let dfd: *FnDef = df_deref_fn(sm, bst)
                if dfd != null
                    f = df_field(sema_find_struct(sm, dfd.return_type_name), x.ident)
            return df_field_struct(sm, f)
    df_struct_of(sm, x)

# 1 when the method `fd` may write its receiver: `self: @&T`, `self:& T`, or a
# `*T` one (a UFCS helper's `v: *Vec<T>`).
fn df_fn_mutates(fd: *FnDef) -> i32
    if fd == null or fd.params == null
        return 0
    let p: *Param = fd.params
    if p.param_type == TypeKind.MutRef or p.param_type == TypeKind.Ptr or p.is_self_borrow == 1
        return 1
    0

# ----------------------------------------------------------------------------
# Refusals (R17 rule 5; ritz0: deref_rules.no_field / neither_has / needs_deref_mut)
# ----------------------------------------------------------------------------

fn df_no_field_text(sm: *Sema, e: *Expr, st: *StructDef) -> String
    var m: String = string_new()
    m.push('`')
    df_display(sm, st.name, m)
    m.push_str("` has no field `")
    m.push_str(e.ident)
    m.push('`')
    # A `*T` field whose T has it: the hint names the step.
    var f: *StructField = st.fields
    while f != null
        if f.field_type == TypeKind.Ptr and f.field_type_name.len > 0
            if df_field(sema_find_struct(sm, f.field_type_name), e.ident) != null
                m.push_str(": it points at one: `")
                df_spell(e.left, m)
                m.push('.')
                m.push_str(f.name)
                m.push('.')
                m.push_str(e.ident)
                m.push_str("`, or implement `Deref`")
                f = null
        if f != null
            f = f.next
    m

fn df_no_field(sm: *Sema, e: *Expr, st: *StructDef)
    let text: String = df_no_field_text(sm, e, st)
    df_report(sm, df_line(e), df_col(e), text.as_view())

# AGAST #4655: a struct literal's initialiser for a field `st` lacks (`P {
# x: 1, y: 2 }`, `Span<u8> { ptr: p, size: 3 }`), at the value, in rule
# 5(a)'s words; ritz0: layout.py _struct_lit_field_indices.
pub fn df_no_lit_field(sm: *Sema, st: *StructDef, field: StrView, line: i32, col: i32)
    var m: String = string_new()
    m.push('`')
    df_display(sm, st.name, m)
    m.push_str("` has no field `")
    m.push_str(field)
    m.push('`')
    df_report(sm, line, col, m.as_view())

# The emitter's fallback (emitter_expr_access.ritz): `x.f` with no field `f`
# on an `x` Sema could not type, so nothing above judged it.  The words, or
# null when this place was reported already.  `m` is the module being
# emitted.  Called directly from emitter_expr_access.ritz (out of scope for
# the StrView conversion, AGAST #4772): kept `-> *u8`, adapting
# df_no_field_text's StrView at this boundary.
var g_df_emit_sema: *Sema = null

pub fn df_no_field_once(ctx: *ParseCtx, m: *Module, e: *Expr, st: *StructDef) -> *u8
    if df_first_at(df_line(e), df_col(e)) == 0
        return null
    if g_df_emit_sema == null or g_df_emit_sema.module != m
        g_df_emit_sema = malloc(sizeof(Sema)) as *Sema
        sema_init(ctx, g_df_emit_sema, m, "")
    # The emitter prints it as a `*u8` and keeps it: a NUL-terminated buffer
    # the String hands over.
    var text: String = df_no_field_text(g_df_emit_sema, e, st)
    text.into_view().ptr

fn df_neither(sm: *Sema, e: *Expr, st: *StructDef, t_sv: StrView)
    var m: String = string_new()
    m.push_str("neither `")
    df_display(sm, st.name, m)
    m.push_str("` nor `")
    df_display(sm, t_sv, m)
    m.push_str("` has a field `")
    m.push_str(e.ident)
    m.push('`')
    df_report(sm, df_line(e), df_col(e), m.as_view())

# 5(c): the use is spelled with the place stopping at the field reached through
# the trait (`r.a = …` for `r.a[1] = 7`); `is_method` for `r.m()` itself.
fn df_needs_mut(sm: *Sema, e: *Expr, st: *StructDef, ctx: i32, is_method: i32)
    var m: String = string_new()
    m.push('`')
    if ctx == DF_ADDR_MUT
        m.push_str("@&")
    df_spell(e.left, m)
    m.push('.')
    m.push_str(e.ident)
    if is_method == 1
        m.push_str("()")
    else if ctx == DF_STORE
        m.push_str(" = ")
        df_put_ellipsis(m)
    else if ctx == DF_COMPOUND
        m.push_str(" op= ")
        df_put_ellipsis(m)
    else if ctx == DF_MUT_CALL
        m.push('.')
        m.push_str(g_df_call)
        m.push_str("()")
    m.push_str("` needs `DerefMut`, and `")
    df_display(sm, st.name, m)
    m.push_str("` implements only `Deref`")
    df_report(sm, df_line(e), df_col(e), m.as_view())

# ----------------------------------------------------------------------------
# The rewrite
# ----------------------------------------------------------------------------

# `S_deref(@x)` / `S_deref_mut(@&x)`, or with `x` itself when it's a pointer or
# a reference to S already.
fn df_step(sm: *Sema, x: *Expr, st: *StructDef, mutable: i32) -> *Expr
    var meth: StrView = "deref"
    if mutable == 1
        meth = "deref_mut"
    let call: *Expr = si_new_expr(ExprKind.Call, x.span.line, x.span.col)
    call.func_name = strview_join3(st.name, "_", meth)  # Type_method, AGAST #4915
    call.call_type_suffix = strview_empty()
    var recv: *Expr = null
    var arg: *Expr = x
    var t: SemaTy
    if sema_expr_ty(sm, x, @t) != TypeKind.Unknown and df_is_ptr(t.kind) == 1
        # `self: @&S` from an `@S`: §3.2's refusal, which ref_check can't say
        # once the write is a call.
        if mutable == 1 and t.kind == TypeKind.Ref
            df_error(sm, x.span.line, x.span.col, "cannot write through an `@T`: make it `@&T`")
    else
        arg = si_new_expr(ExprKind.Unary, x.span.line, x.span.col)
        if mutable == 1
            arg.op = OpKind.AddrMut
        else
            arg.op = OpKind.Addr
        arg.operand = x
        recv = x
    call.args = arg
    let step: *DerefStep = malloc(sizeof(DerefStep)) as *DerefStep
    step.fd = sema_method_fn(sm, st.name, meth)
    step.recv = recv
    call.deref_step = step
    if g_df_once == 1
        si_once_add(call)
    g_df_changed += 1
    call

fn df_mutable(ctx: i32) -> i32
    (ctx != DF_READ) as i32

# `x.f`, its base already walked: through the trait when f isn't S's own.
fn df_member(sm: *Sema, e: *Expr, ctx: i32)
    let x: *Expr = e.left
    if x == null
        return
    let st: *StructDef = df_struct_of(sm, x)
    if st == null or find_field_index(st, e.ident) >= 0
        return
    let mask: i32 = df_traits(sm, st)
    var dfd: *FnDef = null
    if (mask & DF_DEREF) != 0
        dfd = df_deref_fn(sm, st)
    if dfd == null
        df_no_field(sm, e, st)
        return
    let tst: *StructDef = sema_find_struct(sm, dfd.return_type_name)
    if df_field(tst, e.ident) == null
        df_neither(sm, e, st, dfd.return_type_name)
        return
    let mutable: i32 = df_mutable(ctx)
    if mutable == 1 and (mask & DF_DEREF_MUT) == 0
        df_needs_mut(sm, e, st, ctx, 0)
        return
    e.left = si_deref(df_step(sm, x, st, mutable), x.span.line, x.span.col)

# The context the base of a place takes: a mutable use mutates what it's in.
fn df_down(ctx: i32) -> i32
    ctx

fn df_args(sm: *Sema, a0: *Expr, p0: *Param)
    var a: *Expr = a0
    var p: *Param = p0
    while a != null
        if p != null and p.is_borrow == 1
            df_walk(sm, a, DF_ADDR_MUT)
        else
            df_walk(sm, a, DF_READ)
        if p != null
            p = p.next
        a = a.next

# ----------------------------------------------------------------------------
# A fn field called like a method (LARB R41, LANGUAGE_SPEC §5.5, AGAST #3381;
# ritz0's side is #3380).  With no method `f`, `h.f(args)` on a struct with a
# `fn(...)` field `f` is `(h.f)(args)`: `h` isn't passed.  It's rewritten here,
# before any check, into the nameless call the emitter already lowers.  A
# method and a fn field both named `f` refuse `h.f(args)` at `f`, in ritz0's
# words (ref_rules.method_and_field).  `(h.f)(args)` never reaches here.
# ----------------------------------------------------------------------------

# `x` as ritz0's _field_call_text spells it: a name, an integer, else `...`.
fn df_put_call_part(x: *Expr, out:& String)
    if x != null and x.kind == ExprKind.Ident
        out.push_str(x.ident)
    else if x != null and x.kind == ExprKind.IntLit and x.ident.ptr == null
        # A literal is never negative (`-5` is a Neg over `5`); a u64 literal
        # of 2^63 and up is held as a negative i64, so read it as u64
        # (AGAST #4572: `0 - v` stopped ritz1 on 0x8000000000000000).
        var digits: [20]u8
        out.push_str(fmt_u64_into(@digits, x.int_val as u64))
    else
        out.push_str("...")

fn df_method_and_field(sm: *Sema, e: *Expr, st: *StructDef)
    var m: String = string_new()
    m.push('`')
    m.push_str(e.ident)
    m.push_str("` is both a method and a field of `")
    df_display(sm, st.name, m)
    m.push_str("`: write `(")
    df_put_call_part(e.left, m)
    m.push('.')
    m.push_str(e.ident)
    m.push_str(")(")
    var a: *Expr = e.args
    while a != null
        df_put_call_part(a, m)
        if a.next != null
            m.push_str(", ")
        a = a.next
    m.push_str(")` for the field")
    df_report(sm, df_line(e), df_col(e), m.as_view())

# 1 when `e`, a method call `x.f(args)`, became the field call `(x.f)(args)`.
fn df_fn_field_call(sm: *Sema, e: *Expr) -> i32
    let st: *StructDef = df_peek_struct(sm, e.left)
    if st == null
        return 0
    let f: *StructField = df_field(st, e.ident)
    if f == null or f.fn_sig == null
        return 0
    if sema_method_fn(sm, st.name, e.ident) != null
        df_method_and_field(sm, e, st)
        return 0
    let callee: *Expr = si_new_expr(ExprKind.Member, e.left.span.line, e.left.span.col)
    callee.left = e.left
    callee.ident = e.ident
    callee.bracket = e.bracket
    e.kind = ExprKind.Call
    e.left = callee
    e.ident = strview_empty()
    e.func_name = strview_empty()
    e.call_type_suffix = strview_empty()
    1

# `x.m(args)`: S's own method, else T's through the trait, whose receiver is
# then the reference `deref` / `deref_mut` returns.
fn df_method(sm: *Sema, e: *Expr)
    let x: *Expr = e.left
    if x == null
        df_args(sm, e.args, null)
        return
    var fd: *FnDef = null
    var through: i32 = 0
    let rst: *StructDef = df_peek_struct(sm, x)
    if rst != null
        fd = sema_method_fn(sm, rst.name, e.ident)
        if fd == null and (df_traits(sm, rst) & DF_DEREF) != 0
            let dfd: *FnDef = df_deref_fn(sm, rst)
            if dfd != null
                let tst: *StructDef = sema_find_struct(sm, dfd.return_type_name)
                if tst != null
                    fd = sema_method_fn(sm, tst.name, e.ident)
                    if fd != null
                        through = 1
    let mutates: i32 = df_fn_mutates(fd)
    let saved: StrView = g_df_call
    if mutates == 1
        g_df_call = e.ident
        df_walk(sm, x, DF_MUT_CALL)
    else
        df_walk(sm, x, DF_READ)
    g_df_call = saved
    if through == 1
        let xst: *StructDef = df_struct_of(sm, e.left)
        if xst != null
            if mutates == 1 and (df_traits(sm, xst) & DF_DEREF_MUT) == 0
                df_needs_mut(sm, e, xst, DF_MUT_CALL, 1)
            else
                e.left = df_step(sm, e.left, xst, mutates)
    var p: *Param = null
    if fd != null and fd.params != null
        p = fd.params.next
    df_args(sm, e.args, p)

# The fn a named call calls, as the emitter's find_call_fn has it: a typed
# fn-pointer local of that name first (AGAST #3666), else sema_call_fn.
fn df_call_fn(sm: *Sema, e: *Expr) -> *FnDef
    if e.call_type_suffix.len <= 0
        let v: *SemaVar = sema_find_local(sm, e.func_name)
        if v != null and v.fn_sig != null and v.kind != TypeKind.Array
            return v.fn_sig
    sema_call_fn(sm, e)

fn df_walk_list(sm: *Sema, a0: *Expr)
    var a: *Expr = a0
    while a != null
        df_walk(sm, a, DF_READ)
        a = a.next

fn df_walk(sm: *Sema, e: *Expr, ctx: i32)
    if e == null
        return
    let k: ExprKind = e.kind
    match k
        ExprKind.Member =>
            df_walk(sm, e.left, df_down(ctx))
            df_member(sm, e, ctx)
        ExprKind.Method =>
            if df_fn_field_call(sm, e) == 1
                df_walk(sm, e, ctx)   # now `(h.f)(args)`
                return
            df_method(sm, e)
        ExprKind.Call =>
            if df_is_step(e) == 1
                return
            if e.func_name.len == 0
                df_walk(sm, e.left, DF_READ)
                df_args(sm, e.args, null)
                return
            var p: *Param = null
            let fd: *FnDef = df_call_fn(sm, e)
            if fd != null
                p = fd.params
            df_args(sm, e.args, p)
        ExprKind.Unary =>
            if e.op == OpKind.AddrMut
                df_walk(sm, e.operand, DF_ADDR_MUT)
            else
                df_walk(sm, e.operand, DF_READ)
        ExprKind.Index =>
            df_walk(sm, e.left, df_down(ctx))
            df_walk(sm, e.right, DF_READ)
        ExprKind.Binary | ExprKind.Range =>
            df_walk(sm, e.left, DF_READ)
            df_walk(sm, e.right, DF_READ)
        ExprKind.Cast | ExprKind.Try | ExprKind.ArrayFill =>
            df_walk(sm, e.left, DF_READ)
        ExprKind.StructLit =>
            var fi: *FieldInit = e.args as *FieldInit
            while fi != null
                df_walk(sm, fi.value, DF_READ)
                fi = fi.next
        ExprKind.ArrayLit =>
            df_walk_list(sm, e.args)
        ExprKind.If =>
            # An `if`'s arms bind nothing; a `match`'s arms do, and Sema's walk
            # resolves them with their bindings in scope (deref_field_expr).
            df_walk(sm, e.left, DF_READ)
            var arm: *MatchArm = e.args as *MatchArm
            while arm != null
                if arm.is_pass == 0 and arm.body != null
                    df_walk(sm, arm.body, DF_READ)
                arm = arm.next
        ExprKind.Match =>
            df_walk(sm, e.left, DF_READ)
        _ => pass

# An expression outside any statement: a match arm's value, walked by Sema
# once the arm's bindings are in scope.
pub fn deref_field_expr(sm: *Sema, e: *Expr)
    df_walk(sm, e, DF_READ)

fn df_ident(name_sv: StrView, line: i32, col: i32) -> *Expr
    let id: *Expr = si_new_expr(ExprKind.Ident, line, col)
    id.ident = name_sv
    id

fn df_member_node(base: *Expr, name_sv: StrView, at: *Stmt) -> *Expr
    let m: *Expr = si_new_expr(ExprKind.Member, base.span.line, base.span.col)
    m.left = base
    m.ident = name_sv
    m.bracket.line = at.bracket.line
    m.bracket.col = at.bracket.col
    m

fn df_index_node(base: *Expr, key: *Expr) -> *Expr
    let x: *Expr = si_new_expr(ExprKind.Index, base.span.line, base.span.col)
    x.left = base
    x.right = key
    x.bracket.line = 0
    x

# The target `t` of a store statement, walked as one: when anything in it went
# through the trait, the statement becomes `t = v` (StmtKind.Assign with an
# expression target), and a compound one's read shares `t`.
fn df_store(sm: *Sema, stmt: *Stmt, t: *Expr, compound: i32)
    g_df_changed = 0
    g_df_once = compound
    if compound == 1
        df_walk(sm, t, DF_COMPOUND)
    else
        df_walk(sm, t, DF_STORE)
    g_df_once = 0
    if g_df_changed > 0
        stmt.kind = StmtKind.Assign
        stmt.if_cond = t
        stmt.assign_target = strview_empty()
        if compound == 1
            stmt.assign_value.left = t
    df_walk(sm, stmt.assign_value, DF_READ)

fn df_is_compound(v: *Expr) -> i32
    (v != null and v.kind == ExprKind.Binary and v.left != null) as i32

# Resolve the expressions statement `stmt` owns (not its nested blocks: Sema's
# walk reaches them with their own locals in scope).
pub fn deref_field_stmt(sm: *Sema, stmt: *Stmt)
    if stmt == null
        return
    let k: StmtKind = stmt.kind
    let v: *Expr = stmt.assign_value
    match k
        StmtKind.VarDecl | StmtKind.TupleDecl =>
            df_walk(sm, stmt.var_init, DF_READ)
        StmtKind.Assign =>
            if stmt.assign_target.len > 0
                df_walk(sm, v, DF_READ)
                return
            let t: *Expr = stmt.if_cond
            var compound: i32 = 0
            if df_is_compound(v) == 1 and v.left == t
                compound = 1
            g_df_once = compound
            if compound == 1
                df_walk(sm, t, DF_COMPOUND)
            else
                df_walk(sm, t, DF_STORE)
            g_df_once = 0
            df_walk(sm, v, DF_READ)
        StmtKind.LocalFieldAssign =>
            var t: *Expr = null
            var compound: i32 = 0
            if df_is_compound(v) == 1 and v.left.kind == ExprKind.Member and v.left.ident.ptr == stmt.assign_target.ptr and v.left.left != null and v.left.left.kind == ExprKind.Ident and v.left.left.ident.ptr == stmt.var_name.ptr
                compound = 1
                t = v.left
            else
                t = df_member_node(df_ident(stmt.var_name, stmt.span.line, stmt.span.col), stmt.assign_target, stmt)
            df_store(sm, stmt, t, compound)
        StmtKind.LocalFieldIndexAssign =>
            var t: *Expr = null
            var compound: i32 = 0
            if df_is_compound(v) == 1 and v.left.kind == ExprKind.Index and v.left.right == stmt.while_cond
                compound = 1
                t = v.left
            else
                let fm: *Expr = df_member_node(df_ident(stmt.var_name, stmt.span.line, stmt.span.col), stmt.assign_target, stmt)
                t = df_index_node(fm, stmt.while_cond)
            df_store(sm, stmt, t, compound)
        StmtKind.MemberAssign | StmtKind.MemberIndexAssign =>
            if stmt.if_cond == null
                return
            # The compound forms read `(*p).f`: the target is built afresh, and
            # the read takes it when the statement converts.
            var t: *Expr = df_member_node(stmt.if_cond, stmt.assign_target, stmt)
            var compound: i32 = 0
            if k == StmtKind.MemberIndexAssign
                t = df_index_node(t, stmt.while_cond)
                if df_is_compound(v) == 1 and v.left.kind == ExprKind.Index and v.left.right == stmt.while_cond
                    compound = 1
            else if df_is_compound(v) == 1 and v.left.kind == ExprKind.Member and v.left.left != null and v.left.left.kind == ExprKind.Unary and v.left.left.operand == stmt.if_cond
                compound = 1
            df_store(sm, stmt, t, compound)
        StmtKind.IndexAssign =>
            df_walk(sm, stmt.while_cond, DF_READ)
            df_walk(sm, v, DF_READ)
        StmtKind.Return =>
            df_walk(sm, stmt.return_value, DF_READ)
        StmtKind.Expr =>
            df_walk(sm, stmt.expr, DF_READ)
        StmtKind.If | StmtKind.Match | StmtKind.Assert =>
            df_walk(sm, stmt.if_cond, DF_READ)
        StmtKind.While =>
            df_walk(sm, stmt.while_cond, DF_READ)
        StmtKind.For =>
            df_walk(sm, stmt.for_start, DF_READ)
            df_walk(sm, stmt.for_end, DF_READ)
        _ => pass

# ----------------------------------------------------------------------------
# Rule 1: `impl DerefMut for S` needs `impl Deref for S`, reaching the same T.
# Located at the trait name.  ritz0: deref_rules.deref_mut_alone / targets_differ.
# ----------------------------------------------------------------------------

fn df_impl_type(ib: *ImplBlock, out:& String)
    out.push_str(ib.type_name)
    if ib.type_params == null
        return
    out.push('<')
    var tp: *TypeParam = ib.type_params
    while tp != null
        out.push_str(tp.name)
        if tp.next != null
            out.push_str(", ")
        tp = tp.next
    out.push('>')

fn df_impl_method(ib: *ImplBlock, name_sv: StrView) -> *FnDef
    var f: *FnDef = ib.methods
    while f != null
        if name_eq(f.name, name_sv) == 1
            return f
        f = f.next
    null

pub fn deref_impls_check(sm: *Sema)
    var ib: *ImplBlock = sm.module.impls
    while ib != null
        if ib.trait_name.ptr != null and name_eq(ib.trait_name, "DerefMut") == 1
            var d: *ImplBlock = sm.module.impls
            while d != null
                if d.trait_name.ptr != null and name_eq(d.trait_name, "Deref") == 1 and name_eq(d.type_name, ib.type_name) == 1 and (d.type_params == null) == (ib.type_params == null)
                    break
                d = d.next
            var m: String = string_new()
            if d == null
                m.push('`')
                df_impl_type(ib, m)
                m.push_str("` implements `DerefMut` without `Deref`")
                df_report(sm, ib.trait_span.line, ib.trait_span.col, m.as_view())
            else
                let fm: *FnDef = df_impl_method(ib, "deref_mut")
                let fd: *FnDef = df_impl_method(d, "deref")
                if fm != null and fd != null and fm.return_type_name.ptr != null and fd.return_type_name.ptr != null and name_eq(fm.return_type_name, fd.return_type_name) == 0
                    m.push_str("`DerefMut` for `")
                    df_impl_type(ib, m)
                    m.push_str("` reaches `")
                    m.push_str(fm.return_type_name)
                    m.push_str("`, but its `Deref` reaches `")
                    m.push_str(fd.return_type_name)
                    m.push('`')
                    df_report(sm, ib.trait_span.line, ib.trait_span.col, m.as_view())
        ib = ib.next
