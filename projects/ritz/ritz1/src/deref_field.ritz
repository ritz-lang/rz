# deref_field.ritz - `.` through a struct's `Deref` / `DerefMut` (LANGUAGE_SPEC
# §7.7, LARB ruling R17, AGAST #3015), resolved on Sema (AGAST #3509, #1816).
#
# A struct opts into `.` reaching through it with two compiler-known traits,
# resolved statically by name like `Drop` and R15's `Index`:
#
#   impl Deref for S        fn deref(self: @S) -> @T
#   impl DerefMut for S     fn deref_mut(self: @&S) -> @&T
#
# `s.f` is S's own field or method first; otherwise, when S implements `Deref`,
# T's, one step only.  Sema resolves each statement as its walk reaches it
# (sema_walk.ritz), with the statement's locals in its typed scope, before any
# other check sees it: a field reached through the trait, `s.f`, becomes
# `(*S_deref(@s)).f` for a shared use and `(*S_deref_mut(@&s)).f` for a mutable
# one, and a method of T, `s.m()`, takes the reference the call returns as its
# receiver.  Each call made here carries its annotation, Expr.deref_step: the
# method it calls and the place it lends.  The emitter lowers ordinary places
# (find_call_fn finds `S_deref` by its symbol) and ref_check reads the
# annotation; the emitter rewrites nothing.
#
#   shared   a read, `s.f.g`, `s.f[i]`, `@s.f`, `for x in s.f`, `s.m()` (self: @T)
#   mutable  `s.f = v`, `s.f op= v`, `s.f[i] = v`, `s.f.g = v`, `@&s.f`, a `:&`
#            argument, `s.m()` with `self: @&T`
#
# `s.f op= v` calls `deref_mut` once: its read and store share the call
# (struct_index.ritz's si_once, AGAST #2529).
#
# The errors are ritz0's words (ritz0/deref_rules.py), located at the field
# name; ritz0/test_ritz1_box_field.py holds all three compilers to them.  The
# calls made here are steps of their receiver's place for the loan check
# (ref_check.ritz, R11a): df_step_recv.

import ritzlib.sys
import ritzlib.io
import ritzlib.memory
import ritzlib.str

import ast
import ast_helpers
import struct_index
import emitter_core   # name_eq, find_field_index, get_field_type (pure helpers, as sema's)
import sema
import sema_type

# Which traits a struct implements, as a mask.
const DF_DEREF: i32 = 1
const DF_DEREF_MUT: i32 = 2

# How a place is used, which picks the method (and spells a refusal).
const DF_READ: i32 = 0
const DF_STORE: i32 = 1       # `s.f = v`, `s.f[i] = v`, `s.f.g = v`
const DF_COMPOUND: i32 = 2    # `s.f op= v`
const DF_ADDR_MUT: i32 = 3    # `@&s.f`, a `:&` argument
const DF_MUT_CALL: i32 = 4    # `s.f.m()` with a mutating `m` (g_df_call)

var g_df_call: *u8 = null
var g_df_call_len: i32 = 0
var g_df_once: i32 = 0      # 1 while walking the place of `x op= v`
var g_df_changed: i32 = 0   # the steps made, so a statement form knows to convert

# ----------------------------------------------------------------------------
# The steps: each call made here carries a DerefStep (ast.ritz), with the place
# it lends (null when its receiver is already a pointer or reference, which is
# no place of a local).  Every other Expr's deref_step is null.
# ----------------------------------------------------------------------------

# 1 when `e` is a `deref` / `deref_mut` call made here.
pub fn df_is_step(e: *Expr) -> i32
    (e != null and e.kind == EXPR_CALL and e.deref_step != null) as i32

# The place `x` whose step the call `e` is, when `x` is held by value; else null.
pub fn df_step_recv(e: *Expr) -> *Expr
    if df_is_step(e) == 0
        return null
    e.deref_step.recv

# `*e` with `e` a step on a place held by value: that place, else null.  A step
# `*` is a path step of it (R17 rule 6).
pub fn df_deref_step_recv(e: *Expr) -> *Expr
    if e == null or e.kind != EXPR_UNARY or e.op != OP_DEREF
        return null
    df_step_recv(e.operand)

# ----------------------------------------------------------------------------
# Messages
# ----------------------------------------------------------------------------

struct DfBuf
    data: *u8
    len: i32
    cap: i32

fn df_buf_init(b: *DfBuf)
    b.cap = 128
    b.len = 0
    b.data = malloc(b.cap as i64)
    *b.data = 0

fn df_put(b: *DfBuf, p: *u8, n: i32)
    if b.len + n + 1 > b.cap
        var cap: i32 = b.cap * 2
        while b.len + n + 1 > cap
            cap = cap * 2
        let d: *u8 = malloc(cap as i64)
        memcpy(d, b.data, b.len as i64)
        b.data = d
        b.cap = cap
    if n > 0
        memcpy(b.data + b.len, p, n as i64)
    b.len += n
    *(b.data + b.len) = 0

fn df_puts(b: *DfBuf, p: *u8)
    df_put(b, p, strlen(p) as i32)

fn df_putc(b: *DfBuf, c: u8)
    if b.len + 2 > b.cap
        let d: *u8 = malloc((b.cap * 2) as i64)
        memcpy(d, b.data, b.len as i64)
        b.data = d
        b.cap = b.cap * 2
    *(b.data + b.len) = c
    b.len += 1
    *(b.data + b.len) = 0

# `…` (U+2026).
fn df_put_ellipsis(b: *DfBuf)
    df_putc(b, 0xE2 as u8)
    df_putc(b, 0x80 as u8)
    df_putc(b, 0xA6 as u8)

# How many type parameters the generic struct `head` declares, 0 for any other name.
fn df_arity(sm: *Sema, head: *u8, len: i32) -> i32
    var st: *StructDef = sm.module.structs
    while st != null
        if st.type_params != null and name_eq(st.name, st.name_len, head, len) == 1
            var n: i32 = 0
            var tp: *TypeParam = st.type_params
            while tp != null
                n += 1
                tp = tp.next
            return n
        st = st.next
    0

# One type at `*pos` of the mangled `name`, as the source spells it.  0 when
# the arities can't account for the name.
fn df_display_take(sm: *Sema, name: *u8, len: i32, pos: *i32, out: *DfBuf) -> i32
    let start: i32 = *pos
    var end: i32 = start
    while end < len and *(name + end) != '$'
        end += 1
    if end == start
        return 0
    df_put(out, name + start, end - start)
    *pos = end
    let n: i32 = df_arity(sm, name + start, end - start)
    if n == 0
        return 1
    df_putc(out, '<')
    var k: i32 = 0
    while k < n
        if *pos >= len
            return 0
        *pos = *pos + 1   # the `$`
        if k > 0
            df_puts(out, c", ")
        if df_display_take(sm, name, len, pos, out) == 0
            return 0
        k += 1
    df_putc(out, '>')
    1

# A monomorphised type name as the source spells it: `Box$H` is `Box<H>`,
# `Pair$i64$i32` is `Pair<i64, i32>` (ritz0: deref_rules.display).
fn df_display(sm: *Sema, name: *u8, len: i32, out: *DfBuf)
    var tmp: DfBuf
    df_buf_init(@tmp)
    var pos: i32 = 0
    if df_display_take(sm, name, len, @pos, @tmp) == 1 and pos == len
        df_put(out, tmp.data, tmp.len)
    else
        df_put(out, name, len)

# 1 for a receiver spelled as written: an ident, or a member chain of idents.
fn df_plain(x: *Expr) -> i32
    if x == null
        return 0
    if x.kind == EXPR_IDENT
        return 1
    if x.kind == EXPR_MEMBER
        return df_plain(x.left)
    0

fn df_spell_plain(x: *Expr, out: *DfBuf)
    if x.kind == EXPR_MEMBER
        df_spell_plain(x.left, out)
        df_putc(out, '.')
    df_put(out, x.ident_ptr, x.ident_len)

# The receiver `x` as the source writes it, or `s`.
fn df_spell(x: *Expr, out: *DfBuf)
    if df_plain(x) == 1
        df_spell_plain(x, out)
    else
        df_putc(out, 's')

# Each place reported once: a match arm's value can be walked twice, and the
# emitter's own refusal (df_no_field_once) says what Sema did not.
var g_df_err_at: *i64 = null
var g_df_err_count: i32 = 0
var g_df_err_cap: i32 = 0

# 1 the first time `line:col` is asked, recording it; 0 after.
fn df_first_at(line: i32, col: i32) -> i32
    let key: i64 = ((line as i64) << 20) | (col as i64)
    var i: i32 = 0
    while i < g_df_err_count
        if *(g_df_err_at + i) == key
            return 0
        i += 1
    if g_df_err_count == g_df_err_cap
        var cap: i32 = 16
        if g_df_err_cap > 0
            cap = g_df_err_cap * 2
        let grown: *i64 = malloc((cap as i64) * 8) as *i64
        var j: i32 = 0
        while j < g_df_err_count
            *(grown + j) = *(g_df_err_at + j)
            j += 1
        g_df_err_at = grown
        g_df_err_cap = cap
    *(g_df_err_at + g_df_err_count) = key
    g_df_err_count += 1
    1

# A located error (diag's `<file>:<line>:<col>: error: `, AGAST #3445), in
# the words the emitter used.
fn df_error(sm: *Sema, line: i32, col: i32, msg: *u8)
    sema_error_at(sm, line, col)
    eprints_cstr(msg)
    eprints_cstr(c"\n")

fn df_report(sm: *Sema, line: i32, col: i32, msg: *u8)
    if df_first_at(line, col) == 1
        df_error(sm, line, col, msg)

# Where the field (or method) name of the member `e` is.
pub fn df_line(e: *Expr) -> i32
    if e.bracket.line > 0
        return e.bracket.line
    e.span.line

pub fn df_col(e: *Expr) -> i32
    if e.bracket.line > 0
        return e.bracket.col
    e.span.col

# ----------------------------------------------------------------------------
# Lookup: the type of a receiver, from Sema's scope (AGAST #3509).
#
# sema_expr_ty types names, members, calls, `@x` and casts; a receiver is also
# `*p`, an element `a[i]`, a method call's result or a `:&` param, which it
# leaves unknown (AGAST #3501's scope).  df_ty adds those for `.`'s receiver
# alone.  TYPE_UNKNOWN is left alone, as the emitter left a receiver it could
# not type.
# ----------------------------------------------------------------------------

fn df_is_ptr(kind: i32) -> i32
    (kind == TYPE_PTR or kind == TYPE_REF or kind == TYPE_MUT_REF) as i32

fn df_ty_set(t: *SemaTy, kind: i32, name: *u8, name_len: i32, pointee: i32) -> i32
    t.kind = kind
    t.name = name
    t.name_len = name_len
    t.pointee = pointee
    t.fn_sig = null
    kind

fn df_ty_none(t: *SemaTy) -> i32
    sema_ty_unknown(t)
    TYPE_UNKNOWN

# The struct a type is, or points at; null for any other.
fn df_ty_struct(sm: *Sema, t: *SemaTy) -> *StructDef
    if t.name == null or t.name_len <= 0
        return null
    if t.kind == TYPE_STRUCT
        return sema_find_struct(sm, t.name, t.name_len)
    # A fn's `-> @T` keeps no pointee kind: its name says it is a struct.
    if df_is_ptr(t.kind) == 1 and (t.pointee == TYPE_STRUCT or t.pointee == TYPE_VOID)
        return sema_find_struct(sm, t.name, t.name_len)
    null

fn df_fn_ty(fd: *FnDef, t: *SemaTy) -> i32
    if fd == null or fd.return_type == TYPE_VOID
        return df_ty_none(t)
    df_ty_set(t, fd.return_type, fd.return_type_name, fd.return_type_name_len, TYPE_VOID)

# The param `v` is, when it is one of the fn's params (they're bound first).
fn df_param_of(sm: *Sema, v: *SemaVar) -> *Param
    if sm.cur_fn == null
        return null
    let at: i64 = ((v as i64) - (sm.scope as i64)) / sizeof(SemaVar)
    var i: i64 = 0
    var p: *Param = sm.cur_fn.params
    while p != null
        if i == at
            if name_eq(p.name, p.name_len, v.name, v.name_len) == 1
                return p
            return null
        i += 1
        p = p.next
    null

fn df_field_ty(f: *StructField, t: *SemaTy) -> i32
    var pointee: i32 = TYPE_VOID
    if f.field_type == TYPE_PTR
        pointee = f.ptr_pointee
    df_ty_set(t, f.field_type, f.field_type_name, f.field_type_name_len, pointee)

# An element of `b` (`b[i]`, or what `for x in b` binds): of an array, of a
# pointer to a struct, or of a Vec.
fn df_elem_ty(sm: *Sema, b: *Expr, t: *SemaTy) -> i32
    if b == null
        return df_ty_none(t)
    if b.kind == EXPR_IDENT
        let v: *SemaVar = sema_find_local(sm, b.ident_ptr, b.ident_len)
        if v != null and v.kind == TYPE_ARRAY
            if v.elem == TYPE_STRUCT and v.type_name_len > 0
                return df_ty_set(t, TYPE_STRUCT, v.type_name, v.type_name_len, TYPE_VOID)
            if df_is_ptr(v.elem) == 1 and v.type_name_len > 0
                return df_ty_set(t, v.elem, v.type_name, v.type_name_len, TYPE_STRUCT)
            return df_ty_none(t)
        if v == null
            var g: *GlobalVarDef = sm.module.globals
            while g != null
                if name_eq(g.name, g.name_len, b.ident_ptr, b.ident_len) == 1
                    if g.var_type == TYPE_ARRAY and g.array_elem_type == TYPE_STRUCT and g.array_elem_type_name_len > 0
                        return df_ty_set(t, TYPE_STRUCT, g.array_elem_type_name, g.array_elem_type_name_len, TYPE_VOID)
                    g = null
                else
                    g = g.next
    if b.kind == EXPR_MEMBER and b.left != null
        var r: SemaTy
        df_ty(sm, b.left, @r)
        let f: *StructField = df_field(df_ty_struct(sm, @r), b.ident_ptr, b.ident_len)
        if f != null and f.field_type == TYPE_ARRAY
            if f.array_elem_type == TYPE_STRUCT and f.array_elem_type_name_len > 0
                return df_ty_set(t, TYPE_STRUCT, f.array_elem_type_name, f.array_elem_type_name_len, TYPE_VOID)
            return df_ty_none(t)
    var bt: SemaTy
    df_ty(sm, b, @bt)
    # A Vec's element is what its `data: *T` points at, through a `@Vec<T>` /
    # `*Vec<T>` too (ref_check's ref_ty_of takes those for the Vec itself).
    let held: i32 = (bt.kind == TYPE_STRUCT or (df_is_ptr(bt.kind) == 1 and bt.pointee == TYPE_STRUCT)) as i32
    if held == 1 and bt.name_len > 4 and name_eq(bt.name, 4, c"Vec$", 4) == 1
        let f: *StructField = df_field(sema_find_struct(sm, bt.name, bt.name_len), c"data", 4)
        if f != null and f.field_type == TYPE_PTR and f.field_type_name_len > 0
            return df_ty_set(t, TYPE_STRUCT, f.field_type_name, f.field_type_name_len, TYPE_VOID)
        return df_ty_none(t)
    if df_is_ptr(bt.kind) == 1 and bt.pointee == TYPE_STRUCT and bt.name_len > 0
        return df_ty_set(t, TYPE_STRUCT, bt.name, bt.name_len, TYPE_VOID)
    df_ty_none(t)

fn df_index_ty(sm: *Sema, x: *Expr, t: *SemaTy) -> i32
    if x.right != null and x.right.kind == EXPR_RANGE
        return df_ty_none(t)
    df_elem_ty(sm, x.left, t)

# --- Notes on the bindings Sema leaves untyped (SemaVar.recv) --------------

# The binding sema_walk just made.
fn df_last(sm: *Sema) -> *SemaVar
    if sm.scope_top <= 0
        return null
    @sm.scope[sm.scope_top - 1]

fn df_note(sm: *Sema, v: *SemaVar, t: *SemaTy)
    if v != null and v.kind == TYPE_UNKNOWN and t.kind != TYPE_UNKNOWN
        let n: *SemaTy = malloc(sizeof(SemaTy)) as *SemaTy
        df_ty_set(n, t.kind, t.name, t.name_len, t.pointee)
        v.recv = n

fn df_note_struct(sm: *Sema, v: *SemaVar, st: *StructDef)
    if st != null
        var t: SemaTy
        df_ty_set(@t, TYPE_STRUCT, st.name, st.name_len, TYPE_VOID)
        df_note(sm, v, @t)

# `let x = init` Sema could not type: init's type as df_ty tells it.
pub fn df_note_decl(sm: *Sema, st: *Stmt)
    let v: *SemaVar = df_last(sm)
    if v == null or v.kind != TYPE_UNKNOWN or st.var_declared_type != TYPE_VOID
        return
    sm.scope_top = sm.scope_top - 1   # init is read before the binding
    var t: SemaTy
    df_ty(sm, st.var_init, @t)
    sm.scope_top = sm.scope_top + 1
    df_note(sm, v, @t)

# `for x in it`: x is an element of `it` (or of what `@it` / `@&it` points at).
pub fn df_note_for(sm: *Sema, st: *Stmt)
    if st.for_end != null
        return
    let v: *SemaVar = df_last(sm)
    if v == null
        return
    var it: *Expr = st.for_start
    if it != null and it.kind == EXPR_UNARY and (it.op == OP_ADDR or it.op == OP_ADDR_MUT)
        it = it.operand
    sm.scope_top = sm.scope_top - 1   # `it` is read outside the loop's binding
    var t: SemaTy
    df_elem_ty(sm, it, @t)
    sm.scope_top = sm.scope_top + 1
    df_note(sm, v, @t)

# The struct an `Option$S` carries in Some, or a `Result$S$E` in Ok / Err (its
# shortest `$`-split naming structs on both sides is taken); null otherwise.
fn df_tagged_payload(sm: *Sema, name: *u8, len: i32, is_err: i32) -> *StructDef
    var d: i32 = 0
    while d < len and *(name + d) != '$'
        d += 1
    if d >= len
        return null
    let sfx: *u8 = name + d + 1
    let sfx_len: i32 = len - d - 1
    if name_eq(name, d, c"Option", 6) == 1
        if is_err == 1
            return null
        return sema_find_struct(sm, sfx, sfx_len)
    if name_eq(name, d, c"Result", 6) == 0
        return null
    var cut: i32 = 0
    while cut < sfx_len
        if *(sfx + cut) == '$'
            let ok: *StructDef = sema_find_struct(sm, sfx, cut)
            if ok != null or cut + 1 < sfx_len
                if is_err == 0 and ok != null
                    return ok
                if is_err == 1
                    let er: *StructDef = sema_find_struct(sm, sfx + cut + 1, sfx_len - cut - 1)
                    if er != null
                        return er
        cut += 1
    null

# A match arm's binding `V(x)`: V's payload.  A catch-all name is left
# untyped, as the emitter left it: a `match` on a struct value is refused (by
# ritz0 too), and resolving `.` on one only lets it reach unlowerable IR.
pub fn df_note_arm(sm: *Sema, arm: *MatchArm, scrut: *Expr)
    let v: *SemaVar = df_last(sm)
    if v == null or scrut == null or v.kind != TYPE_UNKNOWN or arm.pattern_kind == PAT_IDENT
        return
    sm.scope_top = sm.scope_top - 1   # the scrutinee is read outside the arm
    var t: SemaTy
    df_ty(sm, scrut, @t)
    sm.scope_top = sm.scope_top + 1
    if t.kind == TYPE_UNKNOWN
        return
    if t.name == null or t.name_len <= 0
        return
    if is_tagged_enum_type(t.name, t.name_len) == 1
        var is_err: i32 = 0
        if name_eq(arm.pattern_name, arm.pattern_name_len, c"Err", 3) == 1 or name_eq(arm.pattern_name, arm.pattern_name_len, c"None", 4) == 1
            is_err = 1
        df_note_struct(sm, v, df_tagged_payload(sm, t.name, t.name_len, is_err))
    else if user_enum_index(t.name, t.name_len) >= 0
        let uf: *StructField = user_enum_tuple_field(t.name, t.name_len, enum_variant_index(t.name, t.name_len, arm.pattern_name, arm.pattern_name_len))
        if uf != null
            var ft: SemaTy
            df_field_ty(uf, @ft)
            df_note(sm, v, @ft)

# `let (a, b, ..) = init`: each binding is its field of init's tuple struct.
pub fn df_note_tuple(sm: *Sema, st: *Stmt)
    var n: i32 = 2
    var tn: *TupleName = st.tuple_more
    while tn != null
        n += 1
        tn = tn.next
    if sm.scope_top < n
        return
    let first: i32 = sm.scope_top - n
    let top: i32 = sm.scope_top
    sm.scope_top = first   # init is read before the bindings
    var t: SemaTy
    df_ty(sm, st.var_init, @t)
    sm.scope_top = top
    let ts: *StructDef = df_ty_struct(sm, @t)
    if ts == null
        return
    var f: *StructField = ts.fields
    var i: i32 = first
    while i < top and f != null
        var ft: SemaTy
        df_field_ty(f, @ft)
        df_note(sm, @sm.scope[i], @ft)
        f = f.next
        i += 1

# The type of the receiver `x` into `t`; TYPE_UNKNOWN when it can't be told.
fn df_ty(sm: *Sema, x: *Expr, t: *SemaTy) -> i32
    if x == null
        return df_ty_none(t)
    let k: i32 = x.kind
    if k == EXPR_IDENT
        let v: *SemaVar = sema_find_local(sm, x.ident_ptr, x.ident_len)
        if v != null and v.kind == TYPE_UNKNOWN
            # A binding Sema leaves untyped: deref_field's own note on it.
            if v.recv != null
                return df_ty_set(t, v.recv.kind, v.recv.name, v.recv.name_len, v.recv.pointee)
            # `b:& T` (an `@&T` spelled as a borrow) reads as a T (§13.4), as
            # ref_check's ref_of_local has it: `.` lends it, `@b`.
            let p: *Param = df_param_of(sm, v)
            if p != null and p.is_borrow == 1
                return df_ty_set(t, p.param_pointee_type, p.param_type_name, p.param_type_name_len, TYPE_VOID)
            return df_ty_none(t)
        return sema_expr_ty(sm, x, t)
    if k == EXPR_UNARY and x.op == OP_DEREF
        var o: SemaTy
        df_ty(sm, x.operand, @o)
        if df_is_ptr(o.kind) == 1 and df_ty_struct(sm, @o) != null
            return df_ty_set(t, TYPE_STRUCT, o.name, o.name_len, TYPE_VOID)
        return df_ty_none(t)
    if k == EXPR_MEMBER
        if x.left == null
            return df_ty_none(t)
        var r: SemaTy
        df_ty(sm, x.left, @r)
        let f: *StructField = df_field(df_ty_struct(sm, @r), x.ident_ptr, x.ident_len)
        if f == null
            return df_ty_none(t)
        return df_field_ty(f, t)
    if k == EXPR_INDEX
        return df_index_ty(sm, x, t)
    if k == EXPR_CALL
        if x.deref_step != null
            return df_fn_ty(x.deref_step.fd, t)
        return sema_expr_ty(sm, x, t)
    if k == EXPR_METHOD
        # `E.V(..)` builds the enum E.
        let el: *Expr = x.left
        if el != null and el.kind == EXPR_IDENT and sema_find_local(sm, el.ident_ptr, el.ident_len) == null and user_enum_index(el.ident_ptr, el.ident_len) >= 0
            return df_ty_set(t, TYPE_STRUCT, el.ident_ptr, el.ident_len, TYPE_VOID)
        var r: SemaTy
        df_ty(sm, x.left, @r)
        let st: *StructDef = df_ty_struct(sm, @r)
        if st == null
            return df_ty_none(t)
        return df_fn_ty(sema_method_fn(sm, st.name, st.name_len, x.ident_ptr, x.ident_len), t)
    sema_expr_ty(sm, x, t)

# The struct `x.f` looks in, through `*` / `@` / `@&` (§7.7's auto-deref), or an
# element `vv[i]`; null otherwise.
fn df_struct_of(sm: *Sema, x: *Expr) -> *StructDef
    if x == null
        return null
    var b: SemaTy
    df_ty(sm, x, @b)
    let st: *StructDef = df_ty_struct(sm, @b)
    # A container is no element's type: unknown, left alone.
    if st != null and x.kind == EXPR_INDEX and si_built_in(st.name, st.name_len) == 1
        return null
    st

fn df_base_len(name: *u8, len: i32) -> i32
    var i: i32 = 0
    while i < len and *(name + i) != '$'
        i += 1
    i

# The traits `st` implements: a non-generic impl names it, a generic one its base
# (`impl<T> Deref for Box<T>` is `Box$H`'s).
fn df_traits(sm: *Sema, st: *StructDef) -> i32
    var mask: i32 = 0
    let bl: i32 = df_base_len(st.name, st.name_len)
    var ib: *ImplBlock = sm.module.impls
    while ib != null
        if ib.trait_name != null
            var hit: i32 = 0
            if ib.type_params == null
                hit = name_eq(ib.type_name, ib.type_name_len, st.name, st.name_len)
            else if bl < st.name_len
                hit = name_eq(ib.type_name, ib.type_name_len, st.name, bl)
            if hit == 1
                if name_eq(ib.trait_name, ib.trait_name_len, c"Deref", 5) == 1
                    mask = mask | DF_DEREF
                else if name_eq(ib.trait_name, ib.trait_name_len, c"DerefMut", 8) == 1
                    mask = mask | DF_DEREF_MUT
        ib = ib.next
    mask

# `st`'s `deref`, whose `-> @T` names the T it reaches; null when there's none.
fn df_deref_fn(sm: *Sema, st: *StructDef) -> *FnDef
    let fd: *FnDef = sema_method_fn(sm, st.name, st.name_len, c"deref", 5)
    if fd == null or fd.return_type_name == null or fd.return_type_name_len <= 0
        return null
    fd

fn df_field(st: *StructDef, name: *u8, len: i32) -> *StructField
    if st == null
        return null
    let fi: i32 = find_field_index(st, name, len)
    if fi < 0
        return null
    get_field_type(st, fi)

# The field the member `e` (`x.f`) names, its receiver typed as `.` types it
# (df_ty: a name, `*p`, an element, a call or a method call's result); null
# when `e` is no member or the receiver isn't a known struct.  Read once the
# statement is resolved (deref_field_stmt), as discarded_array does (#3512).
pub fn df_member_field(sm: *Sema, e: *Expr) -> *StructField
    if e == null or e.kind != EXPR_MEMBER or e.left == null
        return null
    var r: SemaTy
    df_ty(sm, e.left, @r)
    df_field(df_ty_struct(sm, @r), e.ident_ptr, e.ident_len)

# The struct a field of that type is, by value or behind a pointer or reference.
fn df_field_struct(sm: *Sema, f: *StructField) -> *StructDef
    if f == null or f.field_type_name_len <= 0
        return null
    if f.field_type == TYPE_STRUCT or f.field_type == TYPE_PTR or f.field_type == TYPE_REF or f.field_type == TYPE_MUT_REF
        return sema_find_struct(sm, f.field_type_name, f.field_type_name_len)
    null

# The struct `x` will be once its members are rewritten (a receiver's type,
# known before the receiver is walked).
fn df_peek_struct(sm: *Sema, x: *Expr) -> *StructDef
    if x == null
        return null
    if x.kind == EXPR_MEMBER and x.left != null
        let bst: *StructDef = df_peek_struct(sm, x.left)
        if bst != null
            var f: *StructField = df_field(bst, x.ident_ptr, x.ident_len)
            if f == null and (df_traits(sm, bst) & DF_DEREF) != 0
                let dfd: *FnDef = df_deref_fn(sm, bst)
                if dfd != null
                    f = df_field(sema_find_struct(sm, dfd.return_type_name, dfd.return_type_name_len), x.ident_ptr, x.ident_len)
            return df_field_struct(sm, f)
    df_struct_of(sm, x)

# 1 when the method `fd` may write its receiver: `self: @&T`, `self:& T`, or a
# `*T` one (a UFCS helper's `v: *Vec<T>`).
fn df_fn_mutates(fd: *FnDef) -> i32
    if fd == null or fd.params == null
        return 0
    let p: *Param = fd.params
    if p.param_type == TYPE_MUT_REF or p.param_type == TYPE_PTR or p.is_self_borrow == 1
        return 1
    0

# ----------------------------------------------------------------------------
# Refusals (R17 rule 5; ritz0: deref_rules.no_field / neither_has / needs_deref_mut)
# ----------------------------------------------------------------------------

fn df_no_field_text(sm: *Sema, e: *Expr, st: *StructDef) -> *u8
    var m: DfBuf
    df_buf_init(@m)
    df_putc(@m, '`')
    df_display(sm, st.name, st.name_len, @m)
    df_puts(@m, c"` has no field `")
    df_put(@m, e.ident_ptr, e.ident_len)
    df_putc(@m, '`')
    # A `*T` field whose T has it: the hint names the step.
    var f: *StructField = st.fields
    while f != null
        if f.field_type == TYPE_PTR and f.field_type_name_len > 0
            if df_field(sema_find_struct(sm, f.field_type_name, f.field_type_name_len), e.ident_ptr, e.ident_len) != null
                df_puts(@m, c": it points at one: `")
                df_spell(e.left, @m)
                df_putc(@m, '.')
                df_put(@m, f.name, f.name_len)
                df_putc(@m, '.')
                df_put(@m, e.ident_ptr, e.ident_len)
                df_puts(@m, c"`, or implement `Deref`")
                f = null
        if f != null
            f = f.next
    m.data

fn df_no_field(sm: *Sema, e: *Expr, st: *StructDef)
    df_report(sm, df_line(e), df_col(e), df_no_field_text(sm, e, st))

# The emitter's fallback (emitter_expr_access.ritz): `x.f` with no field `f`
# on an `x` Sema could not type, so nothing above judged it.  The words, or
# null when this place was reported already.  `m` is the module being emitted.
var g_df_emit_sema: *Sema = null

pub fn df_no_field_once(m: *Module, e: *Expr, st: *StructDef) -> *u8
    if df_first_at(df_line(e), df_col(e)) == 0
        return null
    if g_df_emit_sema == null or g_df_emit_sema.module != m
        g_df_emit_sema = malloc(sizeof(Sema)) as *Sema
        sema_init(g_df_emit_sema, m, c"<input>")
    df_no_field_text(g_df_emit_sema, e, st)

fn df_neither(sm: *Sema, e: *Expr, st: *StructDef, t: *u8, t_len: i32)
    var m: DfBuf
    df_buf_init(@m)
    df_puts(@m, c"neither `")
    df_display(sm, st.name, st.name_len, @m)
    df_puts(@m, c"` nor `")
    df_display(sm, t, t_len, @m)
    df_puts(@m, c"` has a field `")
    df_put(@m, e.ident_ptr, e.ident_len)
    df_putc(@m, '`')
    df_report(sm, df_line(e), df_col(e), m.data)

# 5(c): the use is spelled with the place stopping at the field reached through
# the trait (`r.a = …` for `r.a[1] = 7`); `is_method` for `r.m()` itself.
fn df_needs_mut(sm: *Sema, e: *Expr, st: *StructDef, ctx: i32, is_method: i32)
    var m: DfBuf
    df_buf_init(@m)
    df_putc(@m, '`')
    if ctx == DF_ADDR_MUT
        df_puts(@m, c"@&")
    df_spell(e.left, @m)
    df_putc(@m, '.')
    df_put(@m, e.ident_ptr, e.ident_len)
    if is_method == 1
        df_puts(@m, c"()")
    else if ctx == DF_STORE
        df_puts(@m, c" = ")
        df_put_ellipsis(@m)
    else if ctx == DF_COMPOUND
        df_puts(@m, c" op= ")
        df_put_ellipsis(@m)
    else if ctx == DF_MUT_CALL
        df_putc(@m, '.')
        df_put(@m, g_df_call, g_df_call_len)
        df_puts(@m, c"()")
    df_puts(@m, c"` needs `DerefMut`, and `")
    df_display(sm, st.name, st.name_len, @m)
    df_puts(@m, c"` implements only `Deref`")
    df_report(sm, df_line(e), df_col(e), m.data)

# ----------------------------------------------------------------------------
# The rewrite
# ----------------------------------------------------------------------------

# `S_deref(@x)` / `S_deref_mut(@&x)`, or with `x` itself when it's a pointer or
# a reference to S already.
fn df_step(sm: *Sema, x: *Expr, st: *StructDef, mutable: i32) -> *Expr
    var meth: *u8 = c"deref"
    var meth_len: i32 = 5
    if mutable == 1
        meth = c"deref_mut"
        meth_len = 9
    let n: i32 = st.name_len + 1 + meth_len
    let name: *u8 = malloc((n + 1) as i64)
    memcpy(name, st.name, st.name_len as i64)
    *(name + st.name_len) = '_'
    memcpy(name + st.name_len + 1, meth, meth_len as i64)
    *(name + n) = 0
    let call: *Expr = si_new_expr(EXPR_CALL, x.span.line, x.span.col)
    call.func_name = name
    call.func_name_len = n
    call.call_type_suffix = null
    call.call_type_suffix_len = 0
    var recv: *Expr = null
    var arg: *Expr = x
    var t: SemaTy
    if df_ty(sm, x, @t) != TYPE_UNKNOWN and df_is_ptr(t.kind) == 1
        # `self: @&S` from an `@S`: §3.2's refusal, which ref_check can't say
        # once the write is a call.
        if mutable == 1 and t.kind == TYPE_REF
            df_error(sm, x.span.line, x.span.col, c"cannot write through an `@T`: make it `@&T`")
    else
        arg = si_new_expr(EXPR_UNARY, x.span.line, x.span.col)
        if mutable == 1
            arg.op = OP_ADDR_MUT
        else
            arg.op = OP_ADDR
        arg.operand = x
        recv = x
    call.args = arg
    let step: *DerefStep = malloc(sizeof(DerefStep)) as *DerefStep
    step.fd = sema_method_fn(sm, st.name, st.name_len, meth, meth_len)
    step.recv = recv
    call.deref_step = step
    if g_df_once == 1
        si_once_add(call)
    g_df_changed += 1
    call

fn df_mutable(ctx: i32) -> i32
    (ctx != DF_READ) as i32

# `x.f`, its base already walked: through the trait when f isn't S's own.
fn df_member(sm: *Sema, e: *Expr, ctx: i32)
    let x: *Expr = e.left
    if x == null
        return
    let st: *StructDef = df_struct_of(sm, x)
    if st == null or find_field_index(st, e.ident_ptr, e.ident_len) >= 0
        return
    let mask: i32 = df_traits(sm, st)
    var dfd: *FnDef = null
    if (mask & DF_DEREF) != 0
        dfd = df_deref_fn(sm, st)
    if dfd == null
        df_no_field(sm, e, st)
        return
    let tst: *StructDef = sema_find_struct(sm, dfd.return_type_name, dfd.return_type_name_len)
    if df_field(tst, e.ident_ptr, e.ident_len) == null
        df_neither(sm, e, st, dfd.return_type_name, dfd.return_type_name_len)
        return
    let mutable: i32 = df_mutable(ctx)
    if mutable == 1 and (mask & DF_DEREF_MUT) == 0
        df_needs_mut(sm, e, st, ctx, 0)
        return
    e.left = si_deref(df_step(sm, x, st, mutable), x.span.line, x.span.col)

# The context the base of a place takes: a mutable use mutates what it's in.
fn df_down(ctx: i32) -> i32
    ctx

fn df_args(sm: *Sema, a0: *Expr, p0: *Param)
    var a: *Expr = a0
    var p: *Param = p0
    while a != null
        if p != null and p.is_borrow == 1
            df_walk(sm, a, DF_ADDR_MUT)
        else
            df_walk(sm, a, DF_READ)
        if p != null
            p = p.next
        a = a.next

# ----------------------------------------------------------------------------
# A fn field called like a method (LARB R41, LANGUAGE_SPEC §5.5, AGAST #3381;
# ritz0's side is #3380).  With no method `f`, `h.f(args)` on a struct with a
# `fn(...)` field `f` is `(h.f)(args)`: `h` isn't passed.  It's rewritten here,
# before any check, into the nameless call the emitter already lowers.  A
# method and a fn field both named `f` refuse `h.f(args)` at `f`, in ritz0's
# words (ref_rules.method_and_field).  `(h.f)(args)` never reaches here.
# ----------------------------------------------------------------------------

# `x` as ritz0's _field_call_text spells it: a name, an integer, else `...`.
fn df_put_call_part(x: *Expr, out: *DfBuf)
    if x != null and x.kind == EXPR_IDENT
        df_put(out, x.ident_ptr, x.ident_len)
    else if x != null and x.kind == EXPR_INT_LIT and x.ident_ptr == null
        var v: i64 = x.int_val
        if v < 0
            df_putc(out, '-')
            v = 0 - v
        var digits: [20]u8
        var n: i32 = 0
        while n == 0 or v > 0
            digits[n] = ('0' as i64 + v % 10) as u8
            v = v / 10
            n += 1
        while n > 0
            n -= 1
            df_putc(out, digits[n])
    else
        df_puts(out, c"...")

fn df_method_and_field(sm: *Sema, e: *Expr, st: *StructDef)
    var m: DfBuf
    df_buf_init(@m)
    df_putc(@m, '`')
    df_put(@m, e.ident_ptr, e.ident_len)
    df_puts(@m, c"` is both a method and a field of `")
    df_display(sm, st.name, st.name_len, @m)
    df_puts(@m, c"`: write `(")
    df_put_call_part(e.left, @m)
    df_putc(@m, '.')
    df_put(@m, e.ident_ptr, e.ident_len)
    df_puts(@m, c")(")
    var a: *Expr = e.args
    while a != null
        df_put_call_part(a, @m)
        if a.next != null
            df_puts(@m, c", ")
        a = a.next
    df_puts(@m, c")` for the field")
    df_report(sm, df_line(e), df_col(e), m.data)

# 1 when `e`, a method call `x.f(args)`, became the field call `(x.f)(args)`.
fn df_fn_field_call(sm: *Sema, e: *Expr) -> i32
    let st: *StructDef = df_peek_struct(sm, e.left)
    if st == null
        return 0
    let f: *StructField = df_field(st, e.ident_ptr, e.ident_len)
    if f == null or f.fn_sig == null
        return 0
    if sema_method_fn(sm, st.name, st.name_len, e.ident_ptr, e.ident_len) != null
        df_method_and_field(sm, e, st)
        return 0
    let callee: *Expr = si_new_expr(EXPR_MEMBER, e.left.span.line, e.left.span.col)
    callee.left = e.left
    callee.ident_ptr = e.ident_ptr
    callee.ident_len = e.ident_len
    callee.bracket = e.bracket
    e.kind = EXPR_CALL
    e.left = callee
    e.ident_ptr = null
    e.ident_len = 0
    e.func_name = null
    e.func_name_len = 0
    e.call_type_suffix = null
    e.call_type_suffix_len = 0
    1

# `x.m(args)`: S's own method, else T's through the trait, whose receiver is
# then the reference `deref` / `deref_mut` returns.
fn df_method(sm: *Sema, e: *Expr)
    let x: *Expr = e.left
    if x == null
        df_args(sm, e.args, null)
        return
    var fd: *FnDef = null
    var through: i32 = 0
    let rst: *StructDef = df_peek_struct(sm, x)
    if rst != null
        fd = sema_method_fn(sm, rst.name, rst.name_len, e.ident_ptr, e.ident_len)
        if fd == null and (df_traits(sm, rst) & DF_DEREF) != 0
            let dfd: *FnDef = df_deref_fn(sm, rst)
            if dfd != null
                let tst: *StructDef = sema_find_struct(sm, dfd.return_type_name, dfd.return_type_name_len)
                if tst != null
                    fd = sema_method_fn(sm, tst.name, tst.name_len, e.ident_ptr, e.ident_len)
                    if fd != null
                        through = 1
    let mutates: i32 = df_fn_mutates(fd)
    let saved: *u8 = g_df_call
    let saved_len: i32 = g_df_call_len
    if mutates == 1
        g_df_call = e.ident_ptr
        g_df_call_len = e.ident_len
        df_walk(sm, x, DF_MUT_CALL)
    else
        df_walk(sm, x, DF_READ)
    g_df_call = saved
    g_df_call_len = saved_len
    if through == 1
        let xst: *StructDef = df_struct_of(sm, e.left)
        if xst != null
            if mutates == 1 and (df_traits(sm, xst) & DF_DEREF_MUT) == 0
                df_needs_mut(sm, e, xst, DF_MUT_CALL, 1)
            else
                e.left = df_step(sm, e.left, xst, mutates)
    var p: *Param = null
    if fd != null and fd.params != null
        p = fd.params.next
    df_args(sm, e.args, p)

# The fn a named call calls, as the emitter's find_call_fn has it: a typed
# fn-pointer local of that name first (AGAST #3666), else sema_call_fn.
fn df_call_fn(sm: *Sema, e: *Expr) -> *FnDef
    if e.call_type_suffix_len <= 0
        let v: *SemaVar = sema_find_local(sm, e.func_name, e.func_name_len)
        if v != null and v.fn_sig != null and v.kind != TYPE_ARRAY
            return v.fn_sig
    sema_call_fn(sm, e)

fn df_walk_list(sm: *Sema, a0: *Expr)
    var a: *Expr = a0
    while a != null
        df_walk(sm, a, DF_READ)
        a = a.next

fn df_walk(sm: *Sema, e: *Expr, ctx: i32)
    if e == null
        return
    let k: i32 = e.kind
    if k == EXPR_MEMBER
        df_walk(sm, e.left, df_down(ctx))
        df_member(sm, e, ctx)
    else if k == EXPR_METHOD
        if df_fn_field_call(sm, e) == 1
            df_walk(sm, e, ctx)   # now `(h.f)(args)`
            return
        df_method(sm, e)
    else if k == EXPR_CALL
        if df_is_step(e) == 1
            return
        if e.func_name_len == 0
            df_walk(sm, e.left, DF_READ)
            df_args(sm, e.args, null)
            return
        var p: *Param = null
        let fd: *FnDef = df_call_fn(sm, e)
        if fd != null
            p = fd.params
        df_args(sm, e.args, p)
    else if k == EXPR_UNARY
        if e.op == OP_ADDR_MUT
            df_walk(sm, e.operand, DF_ADDR_MUT)
        else
            df_walk(sm, e.operand, DF_READ)
    else if k == EXPR_INDEX
        df_walk(sm, e.left, df_down(ctx))
        df_walk(sm, e.right, DF_READ)
    else if k == EXPR_BINARY or k == EXPR_RANGE
        df_walk(sm, e.left, DF_READ)
        df_walk(sm, e.right, DF_READ)
    else if k == EXPR_CAST or k == EXPR_TRY or k == EXPR_ARRAY_FILL
        df_walk(sm, e.left, DF_READ)
    else if k == EXPR_STRUCT_LIT
        var fi: *FieldInit = e.args as *FieldInit
        while fi != null
            df_walk(sm, fi.value, DF_READ)
            fi = fi.next
    else if k == EXPR_ARRAY_LIT
        df_walk_list(sm, e.args)
    else if k == EXPR_IF
        # An `if`'s arms bind nothing; a `match`'s arms do, and Sema's walk
        # resolves them with their bindings in scope (deref_field_expr).
        df_walk(sm, e.left, DF_READ)
        var arm: *MatchArm = e.args as *MatchArm
        while arm != null
            if arm.is_pass == 0 and arm.body != null
                df_walk(sm, arm.body, DF_READ)
            arm = arm.next
    else if k == EXPR_MATCH
        df_walk(sm, e.left, DF_READ)

# An expression outside any statement: a match arm's value, walked by Sema
# once the arm's bindings are in scope.
pub fn deref_field_expr(sm: *Sema, e: *Expr)
    df_walk(sm, e, DF_READ)

fn df_ident(name: *u8, len: i32, line: i32, col: i32) -> *Expr
    let id: *Expr = si_new_expr(EXPR_IDENT, line, col)
    id.ident_ptr = name
    id.ident_len = len
    id

fn df_member_node(base: *Expr, name: *u8, len: i32, at: *Stmt) -> *Expr
    let m: *Expr = si_new_expr(EXPR_MEMBER, base.span.line, base.span.col)
    m.left = base
    m.ident_ptr = name
    m.ident_len = len
    m.bracket.line = at.bracket.line
    m.bracket.col = at.bracket.col
    m

fn df_index_node(base: *Expr, key: *Expr) -> *Expr
    let x: *Expr = si_new_expr(EXPR_INDEX, base.span.line, base.span.col)
    x.left = base
    x.right = key
    x.bracket.line = 0
    x

# The target `t` of a store statement, walked as one: when anything in it went
# through the trait, the statement becomes `t = v` (STMT_ASSIGN with an
# expression target), and a compound one's read shares `t`.
fn df_store(sm: *Sema, stmt: *Stmt, t: *Expr, compound: i32)
    g_df_changed = 0
    g_df_once = compound
    if compound == 1
        df_walk(sm, t, DF_COMPOUND)
    else
        df_walk(sm, t, DF_STORE)
    g_df_once = 0
    if g_df_changed > 0
        stmt.kind = STMT_ASSIGN
        stmt.if_cond = t
        stmt.assign_target = null
        stmt.assign_target_len = 0
        if compound == 1
            stmt.assign_value.left = t
    df_walk(sm, stmt.assign_value, DF_READ)

fn df_is_compound(v: *Expr) -> i32
    (v != null and v.kind == EXPR_BINARY and v.left != null) as i32

# Resolve the expressions statement `stmt` owns (not its nested blocks: Sema's
# walk reaches them with their own locals in scope).
pub fn deref_field_stmt(sm: *Sema, stmt: *Stmt)
    if stmt == null
        return
    let k: i32 = stmt.kind
    let v: *Expr = stmt.assign_value
    if k == STMT_VAR_DECL or k == STMT_TUPLE_DECL
        df_walk(sm, stmt.var_init, DF_READ)
    else if k == STMT_ASSIGN
        if stmt.assign_target_len > 0
            df_walk(sm, v, DF_READ)
            return
        let t: *Expr = stmt.if_cond
        var compound: i32 = 0
        if df_is_compound(v) == 1 and v.left == t
            compound = 1
        g_df_once = compound
        if compound == 1
            df_walk(sm, t, DF_COMPOUND)
        else
            df_walk(sm, t, DF_STORE)
        g_df_once = 0
        df_walk(sm, v, DF_READ)
    else if k == STMT_LOCAL_FIELD_ASSIGN
        var t: *Expr = null
        var compound: i32 = 0
        if df_is_compound(v) == 1 and v.left.kind == EXPR_MEMBER and v.left.ident_ptr == stmt.assign_target and v.left.left != null and v.left.left.kind == EXPR_IDENT and v.left.left.ident_ptr == stmt.var_name
            compound = 1
            t = v.left
        else
            t = df_member_node(df_ident(stmt.var_name, stmt.var_name_len, stmt.span.line, stmt.span.col), stmt.assign_target, stmt.assign_target_len, stmt)
        df_store(sm, stmt, t, compound)
    else if k == STMT_LOCAL_FIELD_INDEX_ASSIGN
        var t: *Expr = null
        var compound: i32 = 0
        if df_is_compound(v) == 1 and v.left.kind == EXPR_INDEX and v.left.right == stmt.while_cond
            compound = 1
            t = v.left
        else
            let fm: *Expr = df_member_node(df_ident(stmt.var_name, stmt.var_name_len, stmt.span.line, stmt.span.col), stmt.assign_target, stmt.assign_target_len, stmt)
            t = df_index_node(fm, stmt.while_cond)
        df_store(sm, stmt, t, compound)
    else if k == STMT_MEMBER_ASSIGN or k == STMT_MEMBER_INDEX_ASSIGN
        if stmt.if_cond == null
            return
        # The compound forms read `(*p).f`: the target is built afresh, and
        # the read takes it when the statement converts.
        var t: *Expr = df_member_node(stmt.if_cond, stmt.assign_target, stmt.assign_target_len, stmt)
        var compound: i32 = 0
        if k == STMT_MEMBER_INDEX_ASSIGN
            t = df_index_node(t, stmt.while_cond)
            if df_is_compound(v) == 1 and v.left.kind == EXPR_INDEX and v.left.right == stmt.while_cond
                compound = 1
        else if df_is_compound(v) == 1 and v.left.kind == EXPR_MEMBER and v.left.left != null and v.left.left.kind == EXPR_UNARY and v.left.left.operand == stmt.if_cond
            compound = 1
        df_store(sm, stmt, t, compound)
    else if k == STMT_INDEX_ASSIGN
        df_walk(sm, stmt.while_cond, DF_READ)
        df_walk(sm, v, DF_READ)
    else if k == STMT_RETURN
        df_walk(sm, stmt.return_value, DF_READ)
    else if k == STMT_EXPR
        df_walk(sm, stmt.expr, DF_READ)
    else if k == STMT_IF or k == STMT_MATCH or k == STMT_ASSERT
        df_walk(sm, stmt.if_cond, DF_READ)
    else if k == STMT_WHILE
        df_walk(sm, stmt.while_cond, DF_READ)
    else if k == STMT_FOR
        df_walk(sm, stmt.for_start, DF_READ)
        df_walk(sm, stmt.for_end, DF_READ)

# ----------------------------------------------------------------------------
# Rule 1: `impl DerefMut for S` needs `impl Deref for S`, reaching the same T.
# Located at the trait name.  ritz0: deref_rules.deref_mut_alone / targets_differ.
# ----------------------------------------------------------------------------

fn df_impl_type(ib: *ImplBlock, out: *DfBuf)
    df_put(out, ib.type_name, ib.type_name_len)
    if ib.type_params == null
        return
    df_putc(out, '<')
    var tp: *TypeParam = ib.type_params
    while tp != null
        df_put(out, tp.name, tp.name_len)
        if tp.next != null
            df_puts(out, c", ")
        tp = tp.next
    df_putc(out, '>')

fn df_impl_method(ib: *ImplBlock, name: *u8, len: i32) -> *FnDef
    var f: *FnDef = ib.methods
    while f != null
        if name_eq(f.name, f.name_len, name, len) == 1
            return f
        f = f.next
    null

pub fn deref_impls_check(sm: *Sema)
    var ib: *ImplBlock = sm.module.impls
    while ib != null
        if ib.trait_name != null and name_eq(ib.trait_name, ib.trait_name_len, c"DerefMut", 8) == 1
            var d: *ImplBlock = sm.module.impls
            while d != null
                if d.trait_name != null and name_eq(d.trait_name, d.trait_name_len, c"Deref", 5) == 1 and name_eq(d.type_name, d.type_name_len, ib.type_name, ib.type_name_len) == 1 and (d.type_params == null) == (ib.type_params == null)
                    break
                d = d.next
            var m: DfBuf
            df_buf_init(@m)
            if d == null
                df_putc(@m, '`')
                df_impl_type(ib, @m)
                df_puts(@m, c"` implements `DerefMut` without `Deref`")
                df_report(sm, ib.trait_span.line, ib.trait_span.col, m.data)
            else
                let fm: *FnDef = df_impl_method(ib, c"deref_mut", 9)
                let fd: *FnDef = df_impl_method(d, c"deref", 5)
                if fm != null and fd != null and fm.return_type_name != null and fd.return_type_name != null and name_eq(fm.return_type_name, fm.return_type_name_len, fd.return_type_name, fd.return_type_name_len) == 0
                    df_puts(@m, c"`DerefMut` for `")
                    df_impl_type(ib, @m)
                    df_puts(@m, c"` reaches `")
                    df_put(@m, fm.return_type_name, fm.return_type_name_len)
                    df_puts(@m, c"`, but its `Deref` reaches `")
                    df_put(@m, fd.return_type_name, fd.return_type_name_len)
                    df_putc(@m, '`')
                    df_report(sm, ib.trait_span.line, ib.trait_span.col, m.data)
        ib = ib.next
