# async_lower.ritz - `async fn` / `await` lowered to ritz0's state machine (AGAST #3814)
#
# An AST-to-AST pass main runs once, after imports merge and before any check,
# so everything downstream sees plain fns and structs.  It builds the items
# ritz0 builds (ritz0/async_transform_v2.py generate_state_machine,
# emitter_llvmlite.py _transform_async_functions / _emit_await), with the same
# names and layout, so an executor written against one compiler's futures
# polls the other's:
#
#     async fn f(x: i32) -> T               struct f$Future
#         let a: i32 = await g(x)               __state: i32
#         a + 1                                 __result: T     # none for a unit fn
#                                               x: i32          # params, in order
#                                               a: i32          # locals, by name
#                                           fn f(x: i32) -> f$Future
#                                               f$Future { __state: 0, x: x }
#                                           fn f$poll(self: *f$Future) -> bool
#                                               while true
#                                                   if self.__state == 0
#                                                       self.__future_0 = g(self.x)
#                                                       self.__state = 1
#                                                       continue
#                                                   if self.__state == 1
#                                                       if !g$poll(@self.__future_0)
#                                                           return false  # Pending
#                                                       self.a = self.__future_0.__result
#                                                       self.__result = self.a + 1
#                                                       return true       # Ready
#
#   * With no await the whole body is the poll, its params read through
#     `self`: Ready at once.  With one, every local lives in the future and
#     the body is a graph of states (AGAST #3727): the poll is a dispatch loop
#     over them, each await a resume point that returns Pending and is
#     resumed there by the next poll, wherever it is (a loop, an arm).  The
#     awaited future lives in the future, so it is polled again, not rebuilt.
#     ritz0's _CfgBuilder step for step, so the fields come in its order:
#     __state, params, locals by name, then each await's result / future.
#   * The poll answers bool (LARB R78, AGAST #3728): true once the body has
#     finished, its value stored in the future's `__result`, of the fn's
#     declared type (a unit fn's future has none).  `await` polls until true,
#     then reads the field.  An awaited expression that is not an async fn's
#     call is a hand-written poll source: an i32, -1 while Pending.
#   * `async fn main` is `__main_future` + `main$poll`, and a sync `main`
#     polls it to completion.
#   * `await g(..)` anywhere else (a sync fn) polls g's future until Ready,
#     through a private `__await_g` this file defines; `await` of a sync call
#     is the call.
#   * A bare call to an async fn, as a statement or into a typed let, only
#     builds its future: refused (LANGUAGE_SPEC §16.2, #1395), in ritz0's words.
#
# As in ritz0, an impl's async method is a plain method.  Generated nodes are
# zero-filled, so every optional AST field reads as "none"; type facts are
# copied from the param or let they come from.

import ritzlib.sys
import ritzlib.io
import ritzlib.memory
import ritzlib.string

import ast
import diag

# ---------------------------------------------------------------------------
# Names and nodes
# ---------------------------------------------------------------------------

fn al_zalloc(size: i64) -> *u8
    calloc(1, size)

fn al_clen(s: *u8) -> i32
    var n: i32 = 0
    while *(s + n) != 0
        n += 1
    n

fn al_eq(a_sv: StrView, b_sv: StrView) -> i32
    var a: *u8 = a_sv.ptr
    var alen: i32 = a_sv.len as i32
    var b: *u8 = b_sv.ptr
    var blen: i32 = b_sv.len as i32
    if alen != blen
        return 0
    var i: i32 = 0
    while i < alen
        if *(a + i) != *(b + i)
            return 0
        i += 1
    1

# Bytewise order of two names, as Python's sorted() orders ritz0's fields.
fn al_less(a_sv: StrView, b_sv: StrView) -> i32
    var a: *u8 = a_sv.ptr
    var alen: i32 = a_sv.len as i32
    var b: *u8 = b_sv.ptr
    var blen: i32 = b_sv.len as i32
    var i: i32 = 0
    while i < alen and i < blen
        if *(a + i) != *(b + i)
            return (*(a + i) < *(b + i)) as i32
        i += 1
    (alen < blen) as i32

# `a` then `b` (`blen` bytes), NUL-terminated; its length goes to `*out_len`.
fn al_join(a_sv: StrView, b_sv: StrView, out_len: *i32) -> *u8
    var a: *u8 = a_sv.ptr
    var alen: i32 = a_sv.len as i32
    var b: *u8 = b_sv.ptr
    var blen: i32 = b_sv.len as i32
    let r: *u8 = al_zalloc((alen + blen + 1) as i64)
    var i: i32 = 0
    while i < alen
        *(r + i) = *(a + i)
        i += 1
    var j: i32 = 0
    while j < blen
        *(r + alen + j) = *(b + j)
        j += 1
    *out_len = alen + blen
    r

# `<name>$Future` and `<name>$poll`: the items an async fn generates.  `$` is
# no identifier character (lexer.ritz), so no Ritz source can spell either:
# they are the compiler's alone and can't clash with a user's `fetch_poll` or
# `fetch_Future` (AGAST #3606).  The spelling lives here and nowhere else.
const AL_FUTURE_SUFFIX: i32 = 7
const AL_POLL_SUFFIX: i32 = 5

fn al_future_struct_name(name: *u8, name_len: i32, out_len: *i32) -> *u8
    al_join(StrView { ptr: (name), len: (name_len) as i64 }, StrView { ptr: (c"$Future"), len: (AL_FUTURE_SUFFIX) as i64 }, out_len)

fn al_poll_fn_name(name: *u8, name_len: i32, out_len: *i32) -> *u8
    al_join(StrView { ptr: (name), len: (name_len) as i64 }, StrView { ptr: (c"$poll"), len: (AL_POLL_SUFFIX) as i64 }, out_len)

# `<prefix><n>`: `__future_3`.
fn al_numbered(prefix: *u8, n: i32, out_len: *i32) -> *u8
    var digits: [12]u8
    var k: i32 = 0
    var v: i32 = n
    if v == 0
        digits[0] = '0'
        k = 1
    while v > 0
        digits[k] = ('0' as i32 + v % 10) as u8
        v = v / 10
        k += 1
    var rev: [12]u8
    var i: i32 = 0
    while i < k
        rev[i] = digits[k - 1 - i]
        i += 1
    al_join(StrView { ptr: (prefix), len: (al_clen(prefix)) as i64 }, StrView { ptr: (@rev[0]), len: (k) as i64 }, out_len)

fn al_expr(kind: i32, span: SrcSpan) -> *Expr
    let e: *Expr = al_zalloc(sizeof(Expr)) as *Expr
    e.kind = kind
    e.span = span
    e.slot_type = TYPE_VOID
    e

fn al_int(v: i64, span: SrcSpan) -> *Expr
    let e: *Expr = al_expr(EXPR_INT_LIT, span)
    e.int_val = v
    e.lit_kind = LIT_PLAIN
    e

fn al_ident(name_sv: StrView, span: SrcSpan) -> *Expr
    var name: *u8 = name_sv.ptr
    var len: i32 = name_sv.len as i32
    let e: *Expr = al_expr(EXPR_IDENT, span)
    e.ident_ptr = name
    e.ident_len = len
    e

# `self.<name>`
fn al_self_field(name_sv: StrView, span: SrcSpan) -> *Expr
    var name: *u8 = name_sv.ptr
    var len: i32 = name_sv.len as i32
    let e: *Expr = al_expr(EXPR_MEMBER, span)
    e.left = al_ident(StrView { ptr: (c"self"), len: (4) as i64 }, span)
    e.ident_ptr = name
    e.ident_len = len
    e.bracket = span
    e

fn al_binary(op: i32, left: *Expr, right: *Expr) -> *Expr
    let e: *Expr = al_expr(EXPR_BINARY, left.span)
    e.op = op
    e.left = left
    e.right = right
    e

# `0 - 1`: a hand-written poll source's Pending, written as ritz0 writes it.
fn al_pending(span: SrcSpan) -> *Expr
    al_binary(OP_SUB, al_int(0, span), al_int(1, span))

fn al_call(name_sv: StrView, args: *Expr, span: SrcSpan) -> *Expr
    var name: *u8 = name_sv.ptr
    var len: i32 = name_sv.len as i32
    let e: *Expr = al_expr(EXPR_CALL, span)
    e.func_name = name
    e.func_name_len = len
    e.args = args
    e

fn al_addr_of(name_sv: StrView, span: SrcSpan) -> *Expr
    var name: *u8 = name_sv.ptr
    var len: i32 = name_sv.len as i32
    let e: *Expr = al_expr(EXPR_UNARY, span)
    e.op = OP_ADDR
    e.operand = al_ident(StrView { ptr: (name), len: (len) as i64 }, span)
    e

fn al_stmt(kind: i32, span: SrcSpan) -> *Stmt
    let s: *Stmt = al_zalloc(sizeof(Stmt)) as *Stmt
    s.kind = kind
    s.span = span
    s

fn al_expr_stmt(e: *Expr) -> *Stmt
    let s: *Stmt = al_stmt(STMT_EXPR, e.span)
    s.expr = e
    s

fn al_return(v: *Expr, span: SrcSpan) -> *Stmt
    let s: *Stmt = al_stmt(STMT_RETURN, span)
    s.return_value = v
    s

fn al_if(cond: *Expr, then_body: *Stmt, span: SrcSpan) -> *Stmt
    let s: *Stmt = al_stmt(STMT_IF, span)
    s.if_cond = cond
    s.if_then = then_body
    s

# `self.<name> = v`
fn al_assign_self(name_sv: StrView, v: *Expr, span: SrcSpan) -> *Stmt
    var name: *u8 = name_sv.ptr
    var len: i32 = name_sv.len as i32
    let s: *Stmt = al_stmt(STMT_MEMBER_ASSIGN, span)
    s.if_cond = al_ident(StrView { ptr: (c"self"), len: (4) as i64 }, span)
    s.assign_target = name
    s.assign_target_len = len
    s.bracket = span
    s.assign_value = v
    s

fn al_assign_name(name_sv: StrView, v: *Expr, span: SrcSpan) -> *Stmt
    var name: *u8 = name_sv.ptr
    var len: i32 = name_sv.len as i32
    let s: *Stmt = al_stmt(STMT_ASSIGN, span)
    s.assign_target = name
    s.assign_target_len = len
    s.assign_value = v
    s

# `let`/`var <name>: i32 = init` (ty TYPE_I32), or `: <type_name>` (TYPE_STRUCT).
fn al_decl(name_sv: StrView, ty: i32, type_name_sv: StrView, init: *Expr, is_let: i32, file: *u8, span: SrcSpan) -> *Stmt
    var name: *u8 = name_sv.ptr
    var len: i32 = name_sv.len as i32
    var type_name: *u8 = type_name_sv.ptr
    var type_name_len: i32 = type_name_sv.len as i32
    let s: *Stmt = al_stmt(STMT_VAR_DECL, span)
    s.var_name = name
    s.var_name_len = len
    s.var_type = ty
    s.var_declared_type = ty
    s.var_type_name = type_name
    s.var_type_name_len = type_name_len
    s.var_pointee_type = TYPE_I64
    if ty == TYPE_I32
        s.var_src_file = file
    s.var_init = init
    s.var_is_let = is_let
    s.name_span = span
    s

# `head` with `s` linked at its end.
fn al_append(head: *Stmt, s: *Stmt) -> *Stmt
    if head == null
        return s
    var cur: *Stmt = head
    while cur.next != null
        cur = cur.next
    cur.next = s
    head

fn al_last(head: *Stmt) -> *Stmt
    var cur: *Stmt = head
    while cur != null and cur.next != null
        cur = cur.next
    cur

# A fn generated from `orig`: its line, file, visibility and locality.
fn al_fn(orig: *FnDef, name_sv: StrView, params: *Param, ret: i32, ret_name_sv: StrView, body: *Stmt) -> *FnDef
    var name: *u8 = name_sv.ptr
    var len: i32 = name_sv.len as i32
    var ret_name: *u8 = ret_name_sv.ptr
    var ret_len: i32 = ret_name_sv.len as i32
    let f: *FnDef = al_zalloc(sizeof(FnDef)) as *FnDef
    f.name = name
    f.name_len = len
    f.params = params
    f.return_type = ret
    f.return_type_name = ret_name
    f.return_type_name_len = ret_len
    f.body = body
    f.line = orig.line
    f.col = orig.col
    f.is_local = orig.is_local
    f.is_pub = orig.is_pub
    f.def_file = orig.def_file
    f.target_gated = orig.target_gated
    f

# ---------------------------------------------------------------------------
# The module's async fns
# ---------------------------------------------------------------------------

struct AlAsync
    name: *u8
    len: i32
    params: *Param
    f: *FnDef           # its declaration: the result type an await reads
    helper: *FnDef      # its `__await_<name>`, once a sync fn awaits it
    held: *FnDef        # its `__await_held_<name>`, once one awaits a held future
    next: *AlAsync

var g_al_async: *AlAsync = null
var g_al_module: *Module = null
var g_al_path: *u8 = null

fn al_find_async(name_sv: StrView) -> *AlAsync
    var name: *u8 = name_sv.ptr
    var len: i32 = name_sv.len as i32
    if name == null
        return null
    var a: *AlAsync = g_al_async
    while a != null
        if al_eq(StrView { ptr: (a.name), len: (a.len) as i64 }, StrView { ptr: (name), len: (len) as i64 }) == 1
            return a
        a = a.next
    null

fn al_call_of_async(e: *Expr) -> *AlAsync
    if e == null or e.kind != EXPR_CALL or e.call_type_suffix_len != 0
        return null
    al_find_async(StrView { ptr: (e.func_name), len: (e.func_name_len) as i64 })

# 1 when `s` ends with `suffix`.
fn al_ends_with(s: StrView, suffix: StrView) -> i32
    if suffix.len == 0 or s.len < suffix.len
        return 0
    var i: i64 = 0
    while i < suffix.len
        if *(s.ptr + s.len - suffix.len + i) != *(suffix.ptr + i)
            return 0
        i += 1
    1

fn al_find_fn(name_sv: StrView) -> *FnDef
    var name: *u8 = name_sv.ptr
    var len: i32 = name_sv.len as i32
    var f: *FnDef = g_al_module.functions
    while f != null
        if al_eq(StrView { ptr: (f.name), len: (f.name_len) as i64 }, StrView { ptr: (name), len: (len) as i64 }) == 1
            return f
        f = f.next
    null

# The file a fn's diagnostics name.
fn al_file(f: *FnDef) -> *u8
    if f.is_local == 0 and f.def_file != null
        return f.def_file
    g_al_path

# ---------------------------------------------------------------------------
# Analysis: the await points and the locals of one async fn
# ---------------------------------------------------------------------------

# A field of the future: a param, or a local of the async fn.
struct AlLocal
    name: *u8
    len: i32
    ty: i32
    type_name: *u8
    type_name_len: i32
    pointee: i32
    inner_pointee: i32
    inner_ref: i32
    is_param: i32
    # -1 until a declaration is met, then 1 when every declaration of this
    # name is in a re-entered block and dies before a state boundary, 0 when
    # it must be a field (AGAST #4527); zalloc's 0 is the safe default.
    poll_ok: i32
    unsupported: i32    # a type the future can't hold yet (array, reference, fn)
    span: SrcSpan
    next: *AlLocal

# An await (or a short-circuit `&&` / `||`) a state drove, and the field its
# value is stored in.
struct AlPoint
    await_expr: *Expr
    result: *u8
    result_len: i32
    next: *AlPoint

struct AlBlock
    idx: i32
    head: *Stmt
    closed: i32         # 1: ends in a jump or a return
    next: *AlBlock

# A name read through another field: an awaiting `for`'s var (#4188).  A
# null field hides the name: a lowered `match` arm's binding (#4189).
struct AlRename
    name: *u8
    len: i32
    field: *u8
    flen: i32
    next: *AlRename

struct AlLoop
    head: *AlBlock      # tests the condition: `continue` goes here
    exit: *AlBlock      # after the loop: `break` goes here
    defers: *AlDefer    # the defers active where the body begins (AGAST #4191)

# A `defer` registered in a block of the fn being lowered: its (rewritten)
# body, and the next one outward, innermost first.  Every exit edge of the
# block runs it, which the emitter's own defer scope can't see across states
# (AGAST #4191).
struct AlDefer
    body: *Stmt
    next: *AlDefer

# Where a value goes.
const AL_TO_NONE: i32 = 0      # discarded
const AL_TO_RETURN: i32 = 1    # the poll's Ready
const AL_TO_FIELD: i32 = 2     # self.<name>
const AL_TO_ASSIGN: i32 = 3    # the assignment `stmt`, with this value
const AL_TO_RESULT: i32 = 4    # self.__result, a Ready's value without finishing

struct AlDest
    kind: i32
    name: *u8
    len: i32
    stmt: *Stmt
    span: SrcSpan

struct AlFn
    f: *FnDef
    file: *u8
    locals: *AlLocal
    points: *AlPoint
    npoints: i32        # the awaits in the body
    untyped: *Stmt      # the first local whose type can't be inferred
    sync: i32           # 1: lowering awaits of a sync fn, not an async body
    # The state machine (#3727)
    blocks: *AlBlock
    last_block: *AlBlock
    nblocks: i32
    cur: *AlBlock       # the open state; null after a jump
    nawaits: i32        # awaits lowered so far
    nshorts: i32        # `&&` / `||` with an awaiting right operand, so far
    nifs: i32           # awaiting `if` operands lowered so far (#4190)
    extra: *AlLocal     # the fields it adds, in order
    renames: *AlRename  # innermost first
    nfors: i32          # awaiting `for`s lowered so far
    nmatches: i32       # `__match_K` scrutinee fields added so far
    defers: *AlDefer    # the defers registered so far, innermost first
    errs: i32

fn al_fn_init(a: *AlFn, f: *FnDef, sync: i32)
    a.f = f
    a.file = al_file(f)
    a.locals = null
    a.points = null
    a.npoints = 0
    a.untyped = null
    a.sync = sync
    a.blocks = null
    a.last_block = null
    a.nblocks = 0
    a.cur = null
    a.nawaits = 0
    a.nshorts = 0
    a.nifs = 0
    a.extra = null
    a.renames = null
    a.nfors = 0
    a.nmatches = 0
    a.defers = null
    a.errs = 0

fn al_local_find(a: *AlFn, name_sv: StrView) -> *AlLocal
    var name: *u8 = name_sv.ptr
    var len: i32 = name_sv.len as i32
    var l: *AlLocal = a.locals
    while l != null
        if al_eq(StrView { ptr: (l.name), len: (l.len) as i64 }, StrView { ptr: (name), len: (len) as i64 }) == 1
            return l
        l = l.next
    null

# The local `name`, added at the end of a's list if new (ritz0's dict keeps
# the first insertion and the last type).
fn al_local(a: *AlFn, name_sv: StrView, span: SrcSpan) -> *AlLocal
    var name: *u8 = name_sv.ptr
    var len: i32 = name_sv.len as i32
    var l: *AlLocal = al_local_find(a, StrView { ptr: (name), len: (len) as i64 })
    if l != null
        return l
    l = al_zalloc(sizeof(AlLocal)) as *AlLocal
    l.name = name
    l.len = len
    l.span = span
    l.poll_ok = 0 - 1
    if a.locals == null
        a.locals = l
    else
        var cur: *AlLocal = a.locals
        while cur.next != null
            cur = cur.next
        cur.next = l
    l

fn al_set_scalar(l: *AlLocal, ty: i32)
    l.ty = ty
    l.type_name = null
    l.type_name_len = 0
    l.pointee = TYPE_I64
    l.inner_pointee = TYPE_VOID
    l.inner_ref = INNER_REF_NONE
    l.unsupported = 0

fn al_set_struct(l: *AlLocal, name_sv: StrView)
    var name: *u8 = name_sv.ptr
    var len: i32 = name_sv.len as i32
    al_set_scalar(l, TYPE_STRUCT)
    l.type_name = name
    l.type_name_len = len

# A primitive type's kind from its name (`i64`), as a `-> *i64` return names
# its pointee; 0 for any other name (a struct's).
fn al_prim_of(name_sv: StrView) -> i32
    var name: *u8 = name_sv.ptr
    var len: i32 = name_sv.len as i32
    if name == null
        return 0
    var t: i32 = TYPE_I8
    let kinds: [11]i32 = [TYPE_I8, TYPE_I16, TYPE_I32, TYPE_I64, TYPE_U8, TYPE_U16, TYPE_U32, TYPE_U64, TYPE_BOOL, TYPE_F32, TYPE_F64]
    var i: i32 = 0
    while i < 11
        let n: *u8 = al_prim_name(kinds[i])
        if al_eq(StrView { ptr: (n), len: (al_clen(n)) as i64 }, StrView { ptr: (name), len: (len) as i64 }) == 1
            return kinds[i]
        i += 1
    0

# `l` holds async fn f's result, of its declared type (LARB R78, AGAST #3728):
# 1; 0 for a unit fn, or a type ritz1 can't hold in a future yet (an array, a
# reference, a fn).
fn al_set_ret(l: *AlLocal, f: *FnDef) -> i32
    let t: i32 = f.return_type
    if t == TYPE_VOID or f.ret_fn_sig != null or f.ret_ref != null or f.ret_array != null or f.ret_ptr_array != null
        return 0
    if t == TYPE_STRUCT
        al_set_struct(l, StrView { ptr: (f.return_type_name), len: (f.return_type_name_len) as i64 })
        return 1
    if t == TYPE_PTR
        if f.return_type_name == null
            return 0
        al_set_scalar(l, TYPE_PTR)
        let pt: i32 = al_prim_of(StrView { ptr: (f.return_type_name), len: (f.return_type_name_len) as i64 })
        if pt != 0
            l.pointee = pt
        else
            l.pointee = TYPE_STRUCT
            l.type_name = f.return_type_name
            l.type_name_len = f.return_type_name_len
        return 1
    if t == TYPE_PTR_PTR or al_type_unsupported(t, TYPE_VOID) == 1
        return 0
    al_set_scalar(l, t)
    1

fn al_type_unsupported(ty: i32, pointee: i32) -> i32
    if ty == TYPE_ARRAY or ty == TYPE_REF or ty == TYPE_MUT_REF
        return 1
    if (ty == TYPE_PTR or ty == TYPE_PTR_PTR) and pointee == TYPE_ARRAY
        return 1
    0

fn al_local_of_param(a: *AlFn, p: *Param)
    let l: *AlLocal = al_local(a, StrView { ptr: (p.name), len: (p.name_len) as i64 }, p.name_span)
    l.is_param = 1
    l.ty = p.param_type
    l.type_name = p.param_type_name
    l.type_name_len = p.param_type_name_len
    l.pointee = p.param_pointee_type
    l.inner_pointee = p.param_inner_pointee_type
    l.inner_ref = p.param_inner_ref
    l.unsupported = al_type_unsupported(p.param_type, p.param_pointee_type)
    if p.fn_sig != null or p.is_borrow == 1
        l.unsupported = 1

# A scalar kind's literal-free type, as ritz0's _infer_type answers it; 0 if
# it can't tell.  Fills `l` on success.
# The async fn whose `<name>$Future` a held local `e` is (R79): `var p =
# slow()`, then `await p`.  Null for anything else.
fn al_held_async(a: *AlFn, e: *Expr) -> *AlAsync
    if e == null or e.kind != EXPR_IDENT
        return null
    let l: *AlLocal = al_local_find(a, StrView { ptr: (e.ident_ptr), len: (e.ident_len) as i64 })
    if l == null or l.ty != TYPE_STRUCT or l.type_name == null
        return null
    if al_ends_with(StrView { ptr: (l.type_name), len: (l.type_name_len) as i64 }, StrView { ptr: (c"$Future"), len: (7) as i64 }) == 0
        return null
    al_find_async(StrView { ptr: (l.type_name), len: (l.type_name_len - 7) as i64 })

fn al_infer(a: *AlFn, e: *Expr, l: *AlLocal) -> i32
    if e == null
        return 0
    let k: i32 = e.kind
    if k == EXPR_AWAIT
        let g: *AlAsync = al_call_of_async(e.operand)
        if g == null
            let h: *AlAsync = al_held_async(a, e.operand)
            if h != null
                return al_set_ret(l, h.f)
            al_set_scalar(l, TYPE_I32)   # a hand-written poll source's i32
            return 1
        return al_set_ret(l, g.f)   # the awaited fn's result (#1318, R78)
    if k == EXPR_INT_LIT
        if e.lit_kind == LIT_TRUE or e.lit_kind == LIT_FALSE
            al_set_scalar(l, TYPE_BOOL)
        else
            al_set_scalar(l, TYPE_I64)
        return 1
    if k == EXPR_FLOAT_LIT
        al_set_scalar(l, TYPE_F64)
        return 1
    if k == EXPR_CHAR_LIT
        al_set_scalar(l, TYPE_U8)
        return 1
    if k == EXPR_IDENT
        let src: *AlLocal = al_local_find(a, StrView { ptr: (e.ident_ptr), len: (e.ident_len) as i64 })
        if src == null or src.ty == TYPE_VOID
            return 0
        l.ty = src.ty
        l.type_name = src.type_name
        l.type_name_len = src.type_name_len
        l.pointee = src.pointee
        l.inner_pointee = src.inner_pointee
        l.inner_ref = src.inner_ref
        l.unsupported = src.unsupported
        return 1
    if k == EXPR_CAST
        if e.op == TYPE_STRUCT or e.op == TYPE_PTR or e.op == TYPE_PTR_PTR or e.op == TYPE_ARRAY or e.op == TYPE_REF or e.op == TYPE_MUT_REF
            return 0
        al_set_scalar(l, e.op)
        return 1
    if k == EXPR_BINARY
        if e.op >= OP_EQ and e.op <= OP_OR
            al_set_scalar(l, TYPE_BOOL)
            return 1
        if e.op != OP_SHL and e.op != OP_SHR and e.left.kind == EXPR_INT_LIT and e.right.kind != EXPR_INT_LIT
            return al_infer(a, e.right, l)
        return al_infer(a, e.left, l)
    if k == EXPR_UNARY
        if e.op == OP_NOT
            al_set_scalar(l, TYPE_BOOL)
            return 1
        if e.op == OP_NEG or e.op == OP_BIT_NOT
            return al_infer(a, e.operand, l)
        return 0
    if k == EXPR_CALL and e.func_name != null and e.call_type_suffix_len == 0
        if al_local_find(a, StrView { ptr: (e.func_name), len: (e.func_name_len) as i64 }) != null
            return 0
        let f: *FnDef = al_find_fn(StrView { ptr: (e.func_name), len: (e.func_name_len) as i64 })
        if f == null or f.type_params != null
            return 0
        if f.is_async == 1
            # A bare call is the fn's future (#1395).
            var n: i32 = 0
            let fut: *u8 = al_future_struct_name(f.name, f.name_len, @n)
            al_set_struct(l, StrView { ptr: (fut), len: (n) as i64 })
            return 1
        if f.return_type == TYPE_STRUCT
            al_set_struct(l, StrView { ptr: (f.return_type_name), len: (f.return_type_name_len) as i64 })
            return 1
        if f.return_type == TYPE_VOID or f.return_type == TYPE_PTR or f.return_type == TYPE_PTR_PTR or al_type_unsupported(f.return_type, TYPE_VOID) == 1
            return 0
        al_set_scalar(l, f.return_type)
        return 1
    0

fn al_an_stmts(a: *AlFn, s: *Stmt, top: i32)
    var cur: *Stmt = s
    while cur != null
        al_an_stmt(a, cur, top)
        cur = cur.next

fn al_an_arms(a: *AlFn, arm: *MatchArm)
    var cur: *MatchArm = arm
    while cur != null
        al_an_stmts(a, cur.body_stmts, 0)
        al_an_expr(a, cur.body)
        cur = cur.next

fn al_an_decl(a: *AlFn, s: *Stmt, top: i32)
    # The local's type, before its value is walked (an await in it is not a
    # local yet).  Untyped: its value's, as ritz0 infers it (#3762).
    var t: AlLocal
    t.unsupported = 0
    var typed: i32 = 0
    if s.var_declared_type != TYPE_VOID
        typed = 1
        t.ty = s.var_type
        t.type_name = s.var_type_name
        t.type_name_len = s.var_type_name_len
        t.pointee = s.var_pointee_type
        t.inner_pointee = s.var_inner_pointee_type
        t.inner_ref = s.var_inner_ref
        t.unsupported = al_type_unsupported(s.var_type, s.var_pointee_type)
        if s.var_fn_sig != null
            t.unsupported = 1
    else if al_infer(a, s.var_init, @t) == 1
        typed = 1
    else if a.untyped == null
        a.untyped = s
    al_an_expr(a, s.var_init)
    let l: *AlLocal = al_local(a, StrView { ptr: (s.var_name), len: (s.var_name_len) as i64 }, s.span)
    if typed == 1
        l.ty = t.ty
        l.type_name = t.type_name
        l.type_name_len = t.type_name_len
        l.pointee = t.pointee
        l.inner_pointee = t.inner_pointee
        l.inner_ref = t.inner_ref
        l.unsupported = t.unsupported

fn al_an_stmt(a: *AlFn, s: *Stmt, top: i32)
    let k: i32 = s.kind
    if k == STMT_VAR_DECL
        al_an_decl(a, s, top)
    else if k == STMT_EXPR
        al_an_expr(a, s.expr)
    else if k == STMT_RETURN
        al_an_expr(a, s.return_value)
    else if k == STMT_IF
        al_an_expr(a, s.if_cond)
        al_an_stmts(a, s.if_then, 0)
        al_an_stmts(a, s.if_else, 0)
    else if k == STMT_WHILE
        al_an_expr(a, s.while_cond)
        al_an_stmts(a, s.while_body, 0)
    else if k == STMT_FOR
        al_an_expr(a, s.for_start)
        al_an_expr(a, s.for_end)
        al_an_stmts(a, s.for_body, 0)
    else if k == STMT_LOOP or k == STMT_DEFER or k == STMT_UNSAFE
        al_an_stmts(a, s.while_body, 0)
    else if k == STMT_MATCH
        al_an_expr(a, s.if_cond)
        al_an_arms(a, s.if_then as *MatchArm)
    else if k == STMT_ASSIGN or k == STMT_MEMBER_ASSIGN or k == STMT_MEMBER_INDEX_ASSIGN or k == STMT_INDEX_ASSIGN or k == STMT_LOCAL_FIELD_ASSIGN or k == STMT_LOCAL_FIELD_INDEX_ASSIGN
        al_an_expr(a, s.assign_value)

fn al_an_list(a: *AlFn, e: *Expr)
    var cur: *Expr = e
    while cur != null
        al_an_expr(a, cur)
        cur = cur.next

fn al_an_expr(a: *AlFn, e: *Expr)
    if e == null
        return
    let k: i32 = e.kind
    if k == EXPR_AWAIT
        al_an_expr(a, e.operand)
        a.npoints += 1
    else if k == EXPR_BINARY or k == EXPR_RANGE or k == EXPR_INDEX
        al_an_expr(a, e.left)
        al_an_expr(a, e.right)
    else if k == EXPR_UNARY
        al_an_expr(a, e.operand)
    else if k == EXPR_CALL
        if e.func_name == null
            al_an_expr(a, e.left)
        al_an_list(a, e.args)
    else if k == EXPR_METHOD
        al_an_expr(a, e.left)
        al_an_list(a, e.args)
    else if k == EXPR_MEMBER or k == EXPR_CAST or k == EXPR_TRY or k == EXPR_ARRAY_FILL
        al_an_expr(a, e.left)
    else if k == EXPR_IF or k == EXPR_MATCH
        al_an_expr(a, e.left)
        al_an_arms(a, e.args as *MatchArm)
    else if k == EXPR_STRUCT_LIT
        var fi: *FieldInit = e.args as *FieldInit
        while fi != null
            al_an_expr(a, fi.value)
            fi = fi.next
    else if k == EXPR_ARRAY_LIT
        al_an_list(a, e.args)

# ---------------------------------------------------------------------------
# Rewriting: a body's names read through `self`, and its awaits lowered
# ---------------------------------------------------------------------------

# Is `name` held in the future?  Params always; the other locals that outlive
# a state boundary, when the fn awaits.  One that dies within one state of a
# re-entered block stays a local of the poll (AGAST #4527).
fn al_is_field(a: *AlFn, name_sv: StrView) -> i32
    var name: *u8 = name_sv.ptr
    var len: i32 = name_sv.len as i32
    if a.sync == 1 or name == null
        return 0
    let l: *AlLocal = al_local_find(a, StrView { ptr: (name), len: (len) as i64 })
    if l == null
        return 0
    if l.is_param == 1
        return 1
    if a.npoints > 0 and l.poll_ok != 1
        return 1
    0

fn al_rename_of(a: *AlFn, name_sv: StrView) -> *AlRename
    var name: *u8 = name_sv.ptr
    var len: i32 = name_sv.len as i32
    var r: *AlRename = a.renames
    while r != null
        if al_eq(StrView { ptr: (r.name), len: (r.len) as i64 }, StrView { ptr: (name), len: (len) as i64 }) == 1
            return r
        r = r.next
    null

fn al_point_of(a: *AlFn, e: *Expr) -> *AlPoint
    var p: *AlPoint = a.points
    while p != null
        if p.await_expr == e
            return p
        p = p.next
    null

# The `__await_<g>` that drives g's future to completion (ritz0's
# _emit_await_poll_loop as a fn), built the first time a sync fn awaits g.
fn al_await_helper(g: *AlAsync, span: SrcSpan) -> *FnDef
    if g.helper != null
        return g.helper
    # Its params: copies of g's own.
    var params: *Param = null
    var last: *Param = null
    var args: *Expr = null
    var last_arg: *Expr = null
    var p: *Param = g.params
    while p != null
        let c: *Param = al_zalloc(sizeof(Param)) as *Param
        let src: *u8 = p as *u8
        let dst: *u8 = c as *u8
        var i: i64 = 0
        while i < sizeof(Param)
            *(dst + i) = *(src + i)
            i += 1
        c.next = null
        if last == null
            params = c
        else
            last.next = c
        last = c
        let arg: *Expr = al_ident(StrView { ptr: (p.name), len: (p.name_len) as i64 }, span)
        if last_arg == null
            args = arg
        else
            last_arg.next = arg
        last_arg = arg
        p = p.next
    var n: i32 = 0
    let name: *u8 = al_join(StrView { ptr: (c"__await_"), len: (8) as i64 }, StrView { ptr: (g.name), len: (g.len) as i64 }, @n)
    var fl: i32 = 0
    let fut: *u8 = al_future_struct_name(g.name, g.len, @fl)
    var pl: i32 = 0
    let poll: *u8 = al_poll_fn_name(g.name, g.len, @pl)
    var tail: i32 = AL_DRIVE_RESULT
    if g.f.return_type == TYPE_VOID
        tail = AL_DRIVE_NONE
    let body: *Stmt = al_drive_body(StrView { ptr: (g.name), len: (g.len) as i64 }, args, StrView { ptr: (fut), len: (fl) as i64 }, StrView { ptr: (poll), len: (pl) as i64 }, tail, span)
    var orig: FnDef
    orig.line = span.line
    orig.col = span.col
    orig.is_local = 1
    orig.is_pub = 0
    orig.def_file = null   # private to this file, which defines it
    orig.target_gated = 0
    let f: *FnDef = al_fn(@orig, StrView { ptr: (name), len: (n) as i64 }, params, g.f.return_type, StrView { ptr: (g.f.return_type_name), len: (g.f.return_type_name_len) as i64 }, body)
    module_append_fn(g_al_module, f)
    g.helper = f
    f

# What a drive's body ends with.
const AL_DRIVE_NONE: i32 = 0     # nothing: a unit fn's
const AL_DRIVE_RESULT: i32 = 1   # the future's `__result`
const AL_DRIVE_ZERO: i32 = 2     # 0: a unit `async fn main`'s exit code

# `fn __await_held_<name>(p: *<name>$Future) -> T`: poll the held future until
# it answers true (R79; one already finished answers at once, without running
# its body again), then read its result.
fn al_held_helper(g: *AlAsync, span: SrcSpan) -> *FnDef
    if g.held != null
        return g.held
    var fl: i32 = 0
    let fut: *u8 = al_future_struct_name(g.name, g.len, @fl)
    var pl: i32 = 0
    let poll: *u8 = al_poll_fn_name(g.name, g.len, @pl)
    let p: *Param = al_zalloc(sizeof(Param)) as *Param
    p.name = c"p"
    p.name_len = 1
    p.param_type = TYPE_PTR
    p.param_pointee_type = TYPE_STRUCT
    p.param_type_name = fut
    p.param_type_name_len = fl
    let w: *Stmt = al_stmt(STMT_WHILE, span)
    w.while_cond = al_poll_not_ready(al_call(StrView { ptr: (poll), len: (pl) as i64 }, al_ident(StrView { ptr: (c"p"), len: (1) as i64 }, span), span))
    w.while_body = al_stmt(STMT_CONTINUE, span)
    var body: *Stmt = w
    if g.f.return_type != TYPE_VOID
        body = al_append(body, al_expr_stmt(al_result_of(al_ident(StrView { ptr: (c"p"), len: (1) as i64 }, span), span)))
    var n: i32 = 0
    let name: *u8 = al_join(StrView { ptr: (c"__await_held_"), len: (13) as i64 }, StrView { ptr: (g.name), len: (g.len) as i64 }, @n)
    var orig: FnDef
    orig.line = span.line
    orig.col = span.col
    orig.is_local = 1
    orig.is_pub = 0
    orig.def_file = null   # private to this file, which defines it
    orig.target_gated = 0
    let f: *FnDef = al_fn(@orig, StrView { ptr: (name), len: (n) as i64 }, p, g.f.return_type, StrView { ptr: (g.f.return_type_name), len: (g.f.return_type_name_len) as i64 }, body)
    module_append_fn(g_al_module, f)
    g.held = f
    f

#     var __future: <fut> = <ctor>(args)
#     while !<poll>(@__future)       # false while Pending (LARB R78)
#         continue
#     __future.__result              # as `tail` says
fn al_drive_body(ctor_sv: StrView, args: *Expr, fut_sv: StrView, poll_sv: StrView, tail: i32, span: SrcSpan) -> *Stmt
    var ctor: *u8 = ctor_sv.ptr
    var ctor_len: i32 = ctor_sv.len as i32
    var fut: *u8 = fut_sv.ptr
    var fut_len: i32 = fut_sv.len as i32
    var poll: *u8 = poll_sv.ptr
    var poll_len: i32 = poll_sv.len as i32
    var body: *Stmt = al_decl(StrView { ptr: (c"__future"), len: (8) as i64 }, TYPE_STRUCT, StrView { ptr: (fut), len: (fut_len) as i64 }, al_call(StrView { ptr: (ctor), len: (ctor_len) as i64 }, args, span), 0, null, span)
    let w: *Stmt = al_stmt(STMT_WHILE, span)
    w.while_cond = al_poll_not_ready(al_call(StrView { ptr: (poll), len: (poll_len) as i64 }, al_addr_of(StrView { ptr: (c"__future"), len: (8) as i64 }, span), span))
    w.while_body = al_stmt(STMT_CONTINUE, span)
    body = al_append(body, w)
    if tail == AL_DRIVE_RESULT
        body = al_append(body, al_expr_stmt(al_result_of(al_ident(StrView { ptr: (c"__future"), len: (8) as i64 }, span), span)))
    else if tail == AL_DRIVE_ZERO
        body = al_append(body, al_expr_stmt(al_int(0, span)))
    body

fn module_append_fn(m: *Module, f: *FnDef)
    f.next = null
    if m.functions == null
        m.functions = f
        return
    var cur: *FnDef = m.functions
    while cur.next != null
        cur = cur.next
    cur.next = f

fn al_rw_list(a: *AlFn, e: *Expr) -> *Expr
    var head: *Expr = null
    var prev: *Expr = null
    var cur: *Expr = e
    while cur != null
        let nxt: *Expr = cur.next
        let n: *Expr = al_rw_expr(a, cur)
        n.next = nxt
        if prev == null
            head = n
        else
            prev.next = n
        prev = n
        cur = nxt
    head

fn al_rw_arms(a: *AlFn, arm: *MatchArm)
    var cur: *MatchArm = arm
    while cur != null
        cur.body_stmts = al_rw_stmts(a, cur.body_stmts)
        if cur.body != null
            cur.body = al_rw_expr(a, cur.body)
        cur = cur.next

# `e` rewritten; a replacement takes over e's place in its list.
fn al_rw_expr(a: *AlFn, e: *Expr) -> *Expr
    if e == null
        return null
    let k: i32 = e.kind
    if k == EXPR_IDENT
        let r: *AlRename = al_rename_of(a, StrView { ptr: (e.ident_ptr), len: (e.ident_len) as i64 })
        if r != null and r.field == null
            return e
        if r != null
            let m: *Expr = al_self_field(StrView { ptr: (r.field), len: (r.flen) as i64 }, e.span)
            m.next = e.next
            return m
        if al_is_field(a, StrView { ptr: (e.ident_ptr), len: (e.ident_len) as i64 }) == 1
            let m: *Expr = al_self_field(StrView { ptr: (e.ident_ptr), len: (e.ident_len) as i64 }, e.span)
            m.next = e.next
            return m
        return e
    if k == EXPR_AWAIT or k == EXPR_IF or (k == EXPR_BINARY and (e.op == OP_AND or e.op == OP_OR))
        let p: *AlPoint = al_point_of(a, e)
        if p != null
            # A state already drove it (an await, a short-circuit whose right
            # operand awaits, or an awaiting `if` operand): its value is stored.
            let m: *Expr = al_self_field(StrView { ptr: (p.result), len: (p.result_len) as i64 }, e.span)
            m.next = e.next
            return m
    if k == EXPR_AWAIT
        var op: *Expr = al_rw_expr(a, e.operand)
        let g: *AlAsync = al_call_of_async(op)
        if g != null
            let h: *FnDef = al_await_helper(g, e.span)
            op.func_name = h.name
            op.func_name_len = h.name_len
            op.next = e.next
            return op
        # `await p`, p a held future: drive it in place, then read its result.
        let h: *AlAsync = al_held_async(a, op)
        if h != null
            let hf: *FnDef = al_held_helper(h, e.span)
            let call: *Expr = al_call(StrView { ptr: (hf.name), len: (hf.name_len) as i64 }, al_addr_of(StrView { ptr: (op.ident_ptr), len: (op.ident_len) as i64 }, e.span), e.span)
            call.func_name_len = hf.name_len
            call.next = e.next
            return call
        op.next = e.next
        return op
    if k == EXPR_BINARY or k == EXPR_RANGE or k == EXPR_INDEX
        e.left = al_rw_expr(a, e.left)
        e.right = al_rw_expr(a, e.right)
    else if k == EXPR_UNARY
        e.operand = al_rw_expr(a, e.operand)
    else if k == EXPR_CALL
        if e.func_name == null
            e.left = al_rw_expr(a, e.left)
        e.args = al_rw_list(a, e.args)
    else if k == EXPR_METHOD
        e.left = al_rw_expr(a, e.left)
        e.args = al_rw_list(a, e.args)
    else if k == EXPR_MEMBER or k == EXPR_CAST or k == EXPR_TRY or k == EXPR_ARRAY_FILL
        e.left = al_rw_expr(a, e.left)
    else if k == EXPR_IF or k == EXPR_MATCH
        e.left = al_rw_expr(a, e.left)
        al_rw_arms(a, e.args as *MatchArm)
    else if k == EXPR_STRUCT_LIT
        var fi: *FieldInit = e.args as *FieldInit
        while fi != null
            fi.value = al_rw_expr(a, fi.value)
            fi = fi.next
    else if k == EXPR_ARRAY_LIT
        e.args = al_rw_list(a, e.args)
    e

# A scalar local's zero (0, false, null); null for an array or struct.
fn al_zero_of(a: *AlFn, s: *Stmt) -> *Expr
    let l: *AlLocal = al_local_find(a, StrView { ptr: (s.var_name), len: (s.var_name_len) as i64 })
    if l == null or l.ty == TYPE_STRUCT or l.ty == TYPE_ARRAY
        return null
    if l.ty == TYPE_PTR or l.ty == TYPE_PTR_PTR
        return al_expr(EXPR_NIL_LIT, s.span)
    let z: *Expr = al_int(0, s.span)
    if l.ty == TYPE_BOOL
        z.lit_kind = LIT_FALSE
    z

fn al_rw_part(a: *AlFn, e: *Expr, hoist: i32) -> *Expr
    if hoist == 1
        return al_hoist(a, e)
    al_rw_expr(a, e)

# An assignment's target, rewritten (and with `hoist`, its awaits driven
# first): a name held in the future is written through `self`, whatever the
# assignment's form (#3727: `n[i] = v`, `p.f = v`).
fn al_rw_target(a: *AlFn, s: *Stmt, hoist: i32)
    let k: i32 = s.kind
    if k == STMT_ASSIGN
        if s.assign_target == null
            s.if_cond = al_rw_part(a, s.if_cond, hoist)
        else if al_is_field(a, StrView { ptr: (s.assign_target), len: (s.assign_target_len) as i64 }) == 1
            s.kind = STMT_MEMBER_ASSIGN
            s.if_cond = al_ident(StrView { ptr: (c"self"), len: (4) as i64 }, s.span)
            s.bracket = s.span
    else if k == STMT_MEMBER_ASSIGN
        s.if_cond = al_rw_part(a, s.if_cond, hoist)
    else if k == STMT_MEMBER_INDEX_ASSIGN
        s.if_cond = al_rw_part(a, s.if_cond, hoist)
        s.while_cond = al_rw_part(a, s.while_cond, hoist)
    else if k == STMT_INDEX_ASSIGN
        s.while_cond = al_rw_part(a, s.while_cond, hoist)
        if al_is_field(a, StrView { ptr: (s.assign_target), len: (s.assign_target_len) as i64 }) == 1
            s.kind = STMT_MEMBER_INDEX_ASSIGN
            s.if_cond = al_ident(StrView { ptr: (c"self"), len: (4) as i64 }, s.span)
            s.index_at = s.bracket   # its `[` (AGAST #2847)
    else if k == STMT_LOCAL_FIELD_ASSIGN or k == STMT_LOCAL_FIELD_INDEX_ASSIGN
        if k == STMT_LOCAL_FIELD_INDEX_ASSIGN
            s.while_cond = al_rw_part(a, s.while_cond, hoist)
        if al_is_field(a, StrView { ptr: (s.var_name), len: (s.var_name_len) as i64 }) == 1
            s.if_cond = al_self_field(StrView { ptr: (s.var_name), len: (s.var_name_len) as i64 }, s.span)
            if k == STMT_LOCAL_FIELD_ASSIGN
                s.kind = STMT_MEMBER_ASSIGN
            else
                s.kind = STMT_MEMBER_INDEX_ASSIGN

# A statement may be rewritten to several (a `return`'s Ready, R78): each
# one's chain is spliced in its place.
fn al_rw_stmts(a: *AlFn, s: *Stmt) -> *Stmt
    var head: *Stmt = null
    var prev: *Stmt = null
    var cur: *Stmt = s
    while cur != null
        let nxt: *Stmt = cur.next
        cur.next = null
        let n: *Stmt = al_rw_stmt(a, cur)
        let last: *Stmt = al_last(n)
        last.next = nxt
        if prev == null
            head = n
        else
            prev.next = n
        prev = last
        cur = nxt
    head

fn al_rw_stmt(a: *AlFn, s: *Stmt) -> *Stmt
    let k: i32 = s.kind
    if k == STMT_VAR_DECL
        s.var_init = al_rw_expr(a, s.var_init)
        if al_is_field(a, StrView { ptr: (s.var_name), len: (s.var_name_len) as i64 }) == 1
            # The local lives in the future, where its uses read it.  One with
            # no value is zeroed if a scalar; an array or struct is only its
            # field (ritz0 alike).
            var v: *Expr = s.var_init
            if v == null
                v = al_zero_of(a, s)
                if v == null
                    s.kind = STMT_STRIPPED
                    return s
            return al_assign_self(StrView { ptr: (s.var_name), len: (s.var_name_len) as i64 }, v, s.span)
    else if k == STMT_ASSIGN or k == STMT_MEMBER_ASSIGN or k == STMT_MEMBER_INDEX_ASSIGN or k == STMT_INDEX_ASSIGN or k == STMT_LOCAL_FIELD_ASSIGN or k == STMT_LOCAL_FIELD_INDEX_ASSIGN
        al_rw_target(a, s, 0)
        s.assign_value = al_rw_expr(a, s.assign_value)
    else if k == STMT_RETURN
        s.return_value = al_rw_expr(a, s.return_value)
        if a.sync == 0
            return al_poll_ready(a, s.return_value, s.span)
    else if k == STMT_EXPR
        s.expr = al_rw_expr(a, s.expr)
    else if k == STMT_IF
        s.if_cond = al_rw_expr(a, s.if_cond)
        s.if_then = al_rw_stmts(a, s.if_then)
        s.if_else = al_rw_stmts(a, s.if_else)
    else if k == STMT_WHILE
        s.while_cond = al_rw_expr(a, s.while_cond)
        s.while_body = al_rw_stmts(a, s.while_body)
    else if k == STMT_FOR
        s.for_start = al_rw_expr(a, s.for_start)
        s.for_end = al_rw_expr(a, s.for_end)
        s.for_body = al_rw_stmts(a, s.for_body)
    else if k == STMT_LOOP or k == STMT_DEFER or k == STMT_UNSAFE
        s.while_body = al_rw_stmts(a, s.while_body)
    else if k == STMT_MATCH
        s.if_cond = al_rw_expr(a, s.if_cond)
        al_rw_arms(a, s.if_then as *MatchArm)
    else if k == STMT_ASSERT
        s.if_cond = al_rw_expr(a, s.if_cond)
    s

# ---------------------------------------------------------------------------
# How a poll answers: Pending, or Ready with its result stored
# ---------------------------------------------------------------------------
#
# LARB R78 (AGAST #3728): every poll returns `bool`, true once the body has
# finished, having written its value into the future's `__result` (none for a
# unit fn).  The state machine asks only these.  ritz0's PollAbi.

fn al_false(span: SrcSpan) -> *Expr
    let e: *Expr = al_int(0, span)
    e.lit_kind = LIT_FALSE
    e

# `fut.__result`
fn al_result_of(fut: *Expr, span: SrcSpan) -> *Expr
    let e: *Expr = al_expr(EXPR_MEMBER, span)
    e.left = fut
    e.ident_ptr = c"__result"
    e.ident_len = 8
    e.bracket = span
    e

# Whether an inner generated poll's answer, `polled`, is Pending: `!polled`.
fn al_poll_not_ready(polled: *Expr) -> *Expr
    let e: *Expr = al_expr(EXPR_UNARY, polled.span)
    e.op = OP_NOT
    e.operand = polled
    e

# Whether an awaited poll source's i32 `answer` is Pending (-1).
fn al_poll_is_pending(answer: *Expr) -> *Expr
    al_binary(OP_EQ, answer, al_pending(answer.span))

# Return Pending from this poll.
fn al_poll_pending_stmt(span: SrcSpan) -> *Stmt
    al_return(al_false(span), span)

# Return Ready from this poll: `self.__result = v` (a unit fn's `v` only
# runs), `self.__state = -1` (R79: a later poll is true at once), then
# `return true`.  A chain of statements.
fn al_poll_ready(a: *AlFn, v: *Expr, span: SrcSpan) -> *Stmt
    let done: *Stmt = al_return(al_true(span), span)
    let finish: *Stmt = al_assign_self(StrView { ptr: (c"__state"), len: (7) as i64 }, al_pending(span), span)
    finish.next = done
    if v == null
        return finish
    v.next = null
    var first: *Stmt = null
    if a.f.return_type != TYPE_VOID
        first = al_assign_self(StrView { ptr: (c"__result"), len: (8) as i64 }, v, span)
    else if v.kind != EXPR_INT_LIT and v.kind != EXPR_MEMBER and v.kind != EXPR_IDENT
        first = al_expr_stmt(v)
    else
        return finish
    first.next = finish
    first

# A straight poll's statements (no await), its tail value made the Ready:
# stored in `__result`, then `true`; through an `if`'s or a `match`'s arms.
# A unit fn's poll ends in `true`.
fn al_ready_tail(a: *AlFn, s: *Stmt, span: SrcSpan) -> *Stmt
    if a.f.return_type == TYPE_VOID
        return al_append(s, al_expr_stmt(al_true(span)))
    al_value_tail(s)

fn al_value_tail(s: *Stmt) -> *Stmt
    if s == null
        return null
    var prev: *Stmt = null
    var t: *Stmt = s
    while t.next != null
        prev = t
        t = t.next
    if t.kind == STMT_EXPR
        let st: *Stmt = al_assign_self(StrView { ptr: (c"__result"), len: (8) as i64 }, t.expr, t.span)
        st.next = al_expr_stmt(al_true(t.span))
        if prev == null
            return st
        prev.next = st
        return s
    if t.kind == STMT_IF and t.if_else != null
        t.if_then = al_value_tail(t.if_then)
        t.if_else = al_value_tail(t.if_else)
    else if t.kind == STMT_MATCH
        var arm: *MatchArm = t.if_then as *MatchArm
        while arm != null
            if arm.body != null and arm.is_pass == 0
                let st: *Stmt = al_assign_self(StrView { ptr: (c"__result"), len: (8) as i64 }, arm.body, arm.body.span)
                arm.body_stmts = al_append(arm.body_stmts, st)
                arm.body = al_true(st.span)
            else
                arm.body_stmts = al_value_tail(arm.body_stmts)
            arm = arm.next
    s

# `await g(..)` of a unit g where a value is wanted.
fn al_no_value(a: *AlFn, g: *AlAsync, span: SrcSpan)
    var m: String = string_new()
    m.push_str("`await ")
    m.push_span(Span<u8> { ptr: (g.name), len: (g.len as i64) as i64 })
    m.push_str("(..)` has no value: `")
    m.push_span(Span<u8> { ptr: (g.name), len: (g.len as i64) as i64 })
    m.push_str("` is a unit async fn")
    al_refuse(a, @&m, span)

# ---------------------------------------------------------------------------
# The state machine (AGAST #3727): the body as a graph of states
# ---------------------------------------------------------------------------
#
# Each state is a straight run of statements that ends by jumping to another
# state (`self.__state = N` + `continue` in the poll's dispatch loop),
# returning Ready, or returning Pending at a resume point.  An await is its
# own state: it polls the awaited future, kept in the future struct, and
# returns Pending until it is Ready, so the next poll resumes there.  Loops and
# branches are edges between states, so an await in a `while` runs on every
# pass and only the taken arm's do.  A statement with no await (and no
# `break` / `continue` out of a loop that has one) is kept whole, rewritten in
# place.  ritz0's _CfgBuilder, step for step: the fields it adds (await results,
# awaited futures) come in the same order, so the futures' layouts agree.

fn al_dest(kind: i32, span: SrcSpan) -> AlDest
    var d: AlDest
    d.kind = kind
    d.name = null
    d.len = 0
    d.stmt = null
    d.span = span
    d

fn al_true(span: SrcSpan) -> *Expr
    let e: *Expr = al_int(1, span)
    e.lit_kind = LIT_TRUE
    e

fn al_copy_stmt(s: *Stmt) -> *Stmt
    let c: *Stmt = al_zalloc(sizeof(Stmt)) as *Stmt
    let src: *u8 = s as *u8
    let dst: *u8 = c as *u8
    var i: i64 = 0
    while i < sizeof(Stmt)
        *(dst + i) = *(src + i)
        i += 1
    c.next = null
    c

# `s`'s statements, each copied: a deferred body runs at several exits, and
# one chain can't be linked into several states (AGAST #4191).
fn al_copy_stmts(s: *Stmt) -> *Stmt
    var head: *Stmt = null
    var prev: *Stmt = null
    var cur: *Stmt = s
    while cur != null
        let c: *Stmt = al_copy_stmt(cur)
        if prev == null
            head = c
        else
            prev.next = c
        prev = c
        cur = cur.next
    head

# A field the lowering adds, after the locals: an await result or a future.
fn al_extra(a: *AlFn, name_sv: StrView) -> *AlLocal
    var name: *u8 = name_sv.ptr
    var len: i32 = name_sv.len as i32
    let l: *AlLocal = al_zalloc(sizeof(AlLocal)) as *AlLocal
    l.name = name
    l.len = len
    if a.extra == null
        a.extra = l
    else
        var cur: *AlLocal = a.extra
        while cur.next != null
            cur = cur.next
        cur.next = l
    l

# The await `e`'s result is stored in self.<name>.
fn al_add_point(a: *AlFn, e: *Expr, name_sv: StrView)
    var name: *u8 = name_sv.ptr
    var len: i32 = name_sv.len as i32
    let p: *AlPoint = al_zalloc(sizeof(AlPoint)) as *AlPoint
    p.await_expr = e
    p.result = name
    p.result_len = len
    p.next = a.points
    a.points = p

# -- what a statement holds -------------------------------------------------

fn al_await_in_list(e: *Expr) -> *Expr
    var cur: *Expr = e
    while cur != null
        let r: *Expr = al_await_in(cur)
        if r != null
            return r
        cur = cur.next
    null

fn al_await_in_arms(arm: *MatchArm) -> *Expr
    var cur: *MatchArm = arm
    while cur != null
        var r: *Expr = al_await_in_stmts(cur.body_stmts)
        if r == null
            r = al_await_in(cur.body)
        if r != null
            return r
        cur = cur.next
    null

# The first await in `e`, in evaluation order.
fn al_await_in(e: *Expr) -> *Expr
    if e == null
        return null
    let k: i32 = e.kind
    if k == EXPR_AWAIT
        return e
    var r: *Expr = null
    if k == EXPR_BINARY or k == EXPR_RANGE or k == EXPR_INDEX
        r = al_await_in(e.left)
        if r == null
            r = al_await_in(e.right)
    else if k == EXPR_UNARY
        r = al_await_in(e.operand)
    else if k == EXPR_CALL
        if e.func_name == null
            r = al_await_in(e.left)
        if r == null
            r = al_await_in_list(e.args)
    else if k == EXPR_METHOD
        r = al_await_in(e.left)
        if r == null
            r = al_await_in_list(e.args)
    else if k == EXPR_MEMBER or k == EXPR_CAST or k == EXPR_TRY or k == EXPR_ARRAY_FILL
        r = al_await_in(e.left)
    else if k == EXPR_IF or k == EXPR_MATCH
        r = al_await_in(e.left)
        if r == null
            r = al_await_in_arms(e.args as *MatchArm)
    else if k == EXPR_STRUCT_LIT
        var fi: *FieldInit = e.args as *FieldInit
        while fi != null and r == null
            r = al_await_in(fi.value)
            fi = fi.next
    else if k == EXPR_ARRAY_LIT
        r = al_await_in_list(e.args)
    r

fn al_await_in_stmts(s: *Stmt) -> *Expr
    var cur: *Stmt = s
    while cur != null
        let r: *Expr = al_await_in_stmt(cur)
        if r != null
            return r
        cur = cur.next
    null

fn al_await_in_stmt(s: *Stmt) -> *Expr
    let k: i32 = s.kind
    var r: *Expr = null
    if k == STMT_VAR_DECL
        r = al_await_in(s.var_init)
    else if k == STMT_EXPR
        r = al_await_in(s.expr)
    else if k == STMT_RETURN
        r = al_await_in(s.return_value)
    else if k == STMT_IF
        r = al_await_in(s.if_cond)
        if r == null
            r = al_await_in_stmts(s.if_then)
        if r == null
            r = al_await_in_stmts(s.if_else)
    else if k == STMT_WHILE
        r = al_await_in(s.while_cond)
        if r == null
            r = al_await_in_stmts(s.while_body)
    else if k == STMT_FOR
        r = al_await_in(s.for_start)
        if r == null
            r = al_await_in(s.for_end)
        if r == null
            r = al_await_in_stmts(s.for_body)
    else if k == STMT_LOOP or k == STMT_DEFER or k == STMT_UNSAFE
        r = al_await_in_stmts(s.while_body)
    else if k == STMT_MATCH
        r = al_await_in(s.if_cond)
        if r == null
            r = al_await_in_arms(s.if_then as *MatchArm)
    else if k == STMT_ASSIGN or k == STMT_MEMBER_ASSIGN or k == STMT_MEMBER_INDEX_ASSIGN or k == STMT_INDEX_ASSIGN or k == STMT_LOCAL_FIELD_ASSIGN or k == STMT_LOCAL_FIELD_INDEX_ASSIGN
        if k != STMT_INDEX_ASSIGN and k != STMT_LOCAL_FIELD_ASSIGN and k != STMT_LOCAL_FIELD_INDEX_ASSIGN
            r = al_await_in(s.if_cond)
        if r == null and k != STMT_ASSIGN and k != STMT_MEMBER_ASSIGN and k != STMT_LOCAL_FIELD_ASSIGN
            r = al_await_in(s.while_cond)
        if r == null
            r = al_await_in(s.assign_value)
    else if k == STMT_ASSERT
        r = al_await_in(s.if_cond)
    r

# A `break` / `continue` in `s` that leaves it for an enclosing loop.
fn al_jump_in_arms(arm: *MatchArm) -> *Stmt
    var cur: *MatchArm = arm
    while cur != null
        let r: *Stmt = al_jump_in_stmts(cur.body_stmts)
        if r != null
            return r
        cur = cur.next
    null

fn al_jump_in_expr(e: *Expr) -> *Stmt
    if e != null and (e.kind == EXPR_IF or e.kind == EXPR_MATCH)
        return al_jump_in_arms(e.args as *MatchArm)
    null

fn al_jump_in_stmts(s: *Stmt) -> *Stmt
    var cur: *Stmt = s
    while cur != null
        let r: *Stmt = al_jump_in_stmt(cur)
        if r != null
            return r
        cur = cur.next
    null

fn al_jump_in_stmt(s: *Stmt) -> *Stmt
    let k: i32 = s.kind
    if k == STMT_BREAK or k == STMT_CONTINUE
        return s
    if k == STMT_IF
        let r: *Stmt = al_jump_in_stmts(s.if_then)
        if r != null
            return r
        return al_jump_in_stmts(s.if_else)
    if k == STMT_DEFER or k == STMT_UNSAFE
        return al_jump_in_stmts(s.while_body)
    if k == STMT_MATCH
        return al_jump_in_arms(s.if_then as *MatchArm)
    if k == STMT_EXPR
        return al_jump_in_expr(s.expr)
    if k == STMT_VAR_DECL
        return al_jump_in_expr(s.var_init)
    null   # a loop's own jumps are its own

# -- which locals stay poll locals (AGAST #4527) ---------------------------
#
# A local declared in a block the machine re-enters (a loop body, or a
# `defer` body, which runs at every exit edge) becomes one field of the
# future, so each run overwrites the last value and nothing drops it.  One
# that is dead before any state boundary in the same activation crosses no
# `await` and can stay a poll local: the emitter's own block-end drop then
# frees it once per run.  A local anywhere else, or one live across a
# boundary, stays a field as before.  ritz0's al_poll_locals is the same.

# Whether `name` is read or written in `e`.
fn al_mentions_expr(e: *Expr, name: *u8, len: i32) -> i32
    if e == null
        return 0
    let k: i32 = e.kind
    if k == EXPR_IDENT
        return al_eq(StrView { ptr: (e.ident_ptr), len: (e.ident_len) as i64 }, StrView { ptr: (name), len: (len) as i64 })
    var r: i32 = 0
    if k == EXPR_BINARY or k == EXPR_RANGE or k == EXPR_INDEX
        r = al_mentions_expr(e.left, name, len)
        if r == 0
            r = al_mentions_expr(e.right, name, len)
    else if k == EXPR_UNARY
        r = al_mentions_expr(e.operand, name, len)
    else if k == EXPR_CALL
        if e.func_name == null
            r = al_mentions_expr(e.left, name, len)
        if r == 0
            r = al_mentions_list(e.args, name, len)
    else if k == EXPR_METHOD
        r = al_mentions_expr(e.left, name, len)
        if r == 0
            r = al_mentions_list(e.args, name, len)
    else if k == EXPR_MEMBER or k == EXPR_CAST or k == EXPR_TRY or k == EXPR_ARRAY_FILL
        r = al_mentions_expr(e.left, name, len)
    else if k == EXPR_IF or k == EXPR_MATCH
        r = al_mentions_expr(e.left, name, len)
        if r == 0
            r = al_mentions_arms(e.args as *MatchArm, name, len)
    else if k == EXPR_STRUCT_LIT
        var fi: *FieldInit = e.args as *FieldInit
        while fi != null and r == 0
            r = al_mentions_expr(fi.value, name, len)
            fi = fi.next
    else if k == EXPR_ARRAY_LIT
        r = al_mentions_list(e.args, name, len)
    r

fn al_mentions_list(e: *Expr, name: *u8, len: i32) -> i32
    var cur: *Expr = e
    while cur != null
        if al_mentions_expr(cur, name, len) == 1
            return 1
        cur = cur.next
    0

fn al_mentions_arms(arm: *MatchArm, name: *u8, len: i32) -> i32
    var cur: *MatchArm = arm
    while cur != null
        if al_mentions_stmts(cur.body_stmts, name, len) == 1
            return 1
        if al_mentions_expr(cur.body, name, len) == 1
            return 1
        cur = cur.next
    0

fn al_mentions_stmts(s: *Stmt, name: *u8, len: i32) -> i32
    var cur: *Stmt = s
    while cur != null
        if al_mentions_stmt(cur, name, len) == 1
            return 1
        cur = cur.next
    0

fn al_mentions_stmt(s: *Stmt, name: *u8, len: i32) -> i32
    let k: i32 = s.kind
    if k == STMT_VAR_DECL
        # Its own name is a declaration, not a use.  A `let x = x + 1`'s
        # initializer still reads the outer `x`.
        return al_mentions_expr(s.var_init, name, len)
    if k == STMT_EXPR
        return al_mentions_expr(s.expr, name, len)
    if k == STMT_RETURN
        return al_mentions_expr(s.return_value, name, len)
    if k == STMT_IF
        if al_mentions_expr(s.if_cond, name, len) == 1
            return 1
        if al_mentions_stmts(s.if_then, name, len) == 1
            return 1
        return al_mentions_stmts(s.if_else, name, len)
    if k == STMT_WHILE
        if al_mentions_expr(s.while_cond, name, len) == 1
            return 1
        return al_mentions_stmts(s.while_body, name, len)
    if k == STMT_FOR
        if al_mentions_expr(s.for_start, name, len) == 1
            return 1
        if al_mentions_expr(s.for_end, name, len) == 1
            return 1
        return al_mentions_stmts(s.for_body, name, len)
    if k == STMT_LOOP or k == STMT_DEFER or k == STMT_UNSAFE
        return al_mentions_stmts(s.while_body, name, len)
    if k == STMT_MATCH
        if al_mentions_expr(s.if_cond, name, len) == 1
            return 1
        return al_mentions_arms(s.if_then as *MatchArm, name, len)
    if k == STMT_ASSERT
        return al_mentions_expr(s.if_cond, name, len)
    if k == STMT_ASSIGN or k == STMT_MEMBER_ASSIGN or k == STMT_MEMBER_INDEX_ASSIGN or k == STMT_INDEX_ASSIGN or k == STMT_LOCAL_FIELD_ASSIGN or k == STMT_LOCAL_FIELD_INDEX_ASSIGN
        if s.assign_target != null and al_eq(StrView { ptr: (s.assign_target), len: (s.assign_target_len) as i64 }, StrView { ptr: (name), len: (len) as i64 }) == 1
            return 1
        # The base and index of the other forms, as al_await_in_stmt reads them.
        if k != STMT_INDEX_ASSIGN and k != STMT_LOCAL_FIELD_ASSIGN and k != STMT_LOCAL_FIELD_INDEX_ASSIGN
            if al_mentions_expr(s.if_cond, name, len) == 1
                return 1
        if k != STMT_ASSIGN and k != STMT_MEMBER_ASSIGN and k != STMT_LOCAL_FIELD_ASSIGN
            if al_mentions_expr(s.while_cond, name, len) == 1
                return 1
        return al_mentions_expr(s.assign_value, name, len)
    0

# Whether lowering `s` ends the state it starts in: it holds an `await`, or a
# `break` / `continue` out of a loop that lowers it.
fn al_splits_stmt(s: *Stmt) -> i32
    if al_await_in_stmt(s) != null
        return 1
    let k: i32 = s.kind
    if k == STMT_WHILE
        return (al_jump_in_stmts(s.while_body) != null) as i32
    if k == STMT_FOR
        return (al_jump_in_stmts(s.for_body) != null) as i32
    if k == STMT_LOOP
        return (al_jump_in_stmts(s.while_body) != null) as i32
    (al_jump_in_stmt(s) != null) as i32

# Whether `s` uses `name` in a state other than the one before it.
fn al_uses_across_stmt(s: *Stmt, name: *u8, len: i32, split: i32) -> i32
    let k: i32 = s.kind
    if k == STMT_DEFER
        # A defer body runs at exits, after any await on the way out.
        return al_mentions_stmts(s.while_body, name, len)
    if k == STMT_WHILE or k == STMT_FOR or k == STMT_LOOP
        if al_splits_stmt(s) == 1 or split == 1
            return al_mentions_stmt(s, name, len)
        return 0
    if al_splits_stmt(s) == 1
        return al_mentions_stmt(s, name, len)
    if split == 1
        return al_mentions_stmt(s, name, len)
    0

# Whether `name`, declared before `rest`, is used after a state boundary in
# the same activation.
fn al_crosses_after(name: *u8, len: i32, rest: *Stmt) -> i32
    var split: i32 = 0
    var cur: *Stmt = rest
    while cur != null
        if cur.kind == STMT_VAR_DECL and al_eq(StrView { ptr: (cur.var_name), len: (cur.var_name_len) as i64 }, StrView { ptr: (name), len: (len) as i64 }) == 1
            return 0   # a redeclaration shadows it; its own decl is checked
        if al_uses_across_stmt(cur, name, len, split) == 1
            return 1
        if al_splits_stmt(cur) == 1
            split = 1
        cur = cur.next
    0

# Mark each local's poll_ok from its declarations, `reentered` 1 inside a
# loop or defer body.
fn al_mark_walk_stmts(a: *AlFn, s: *Stmt, reentered: i32)
    var cur: *Stmt = s
    while cur != null
        if cur.kind == STMT_VAR_DECL
            var crosses: i32 = 0
            if al_await_in(cur.var_init) != null
                crosses = 1
            else
                crosses = al_crosses_after(cur.var_name, cur.var_name_len, cur.next)
            let l: *AlLocal = al_local_find(a, StrView { ptr: (cur.var_name), len: (cur.var_name_len) as i64 })
            if l != null
                if reentered == 0 or crosses == 1
                    l.poll_ok = 0
                else if l.poll_ok == 0 - 1
                    l.poll_ok = 1
        al_mark_walk_stmt(a, cur, reentered)
        cur = cur.next

fn al_mark_walk_stmt(a: *AlFn, s: *Stmt, reentered: i32)
    let k: i32 = s.kind
    if k == STMT_IF
        al_mark_walk_expr(a, s.if_cond, reentered)
        al_mark_walk_stmts(a, s.if_then, reentered)
        al_mark_walk_stmts(a, s.if_else, reentered)
    else if k == STMT_WHILE
        al_mark_walk_expr(a, s.while_cond, reentered)
        al_mark_walk_stmts(a, s.while_body, 1)
    else if k == STMT_FOR
        al_mark_walk_expr(a, s.for_start, reentered)
        al_mark_walk_expr(a, s.for_end, reentered)
        al_mark_walk_stmts(a, s.for_body, 1)
    else if k == STMT_LOOP
        al_mark_walk_stmts(a, s.while_body, 1)
    else if k == STMT_DEFER
        # A `defer` body is one synchronous region: it runs whole at each
        # exit edge, so its own locals never cross a state.
        al_mark_walk_stmts(a, s.while_body, 1)
    else if k == STMT_UNSAFE
        al_mark_walk_stmts(a, s.while_body, reentered)
    else if k == STMT_MATCH
        al_mark_walk_expr(a, s.if_cond, reentered)
        al_mark_walk_arms(a, s.if_then as *MatchArm, reentered)
    else if k == STMT_VAR_DECL
        al_mark_walk_expr(a, s.var_init, reentered)
    else if k == STMT_EXPR
        al_mark_walk_expr(a, s.expr, reentered)
    else if k == STMT_RETURN
        al_mark_walk_expr(a, s.return_value, reentered)
    else if k == STMT_ASSERT
        al_mark_walk_expr(a, s.if_cond, reentered)
    else if k == STMT_ASSIGN or k == STMT_MEMBER_ASSIGN or k == STMT_MEMBER_INDEX_ASSIGN or k == STMT_INDEX_ASSIGN or k == STMT_LOCAL_FIELD_ASSIGN or k == STMT_LOCAL_FIELD_INDEX_ASSIGN
        if k != STMT_INDEX_ASSIGN and k != STMT_LOCAL_FIELD_ASSIGN and k != STMT_LOCAL_FIELD_INDEX_ASSIGN
            al_mark_walk_expr(a, s.if_cond, reentered)
        if k != STMT_ASSIGN and k != STMT_MEMBER_ASSIGN and k != STMT_LOCAL_FIELD_ASSIGN
            al_mark_walk_expr(a, s.while_cond, reentered)
        al_mark_walk_expr(a, s.assign_value, reentered)

fn al_mark_walk_expr(a: *AlFn, e: *Expr, reentered: i32)
    if e == null
        return
    let k: i32 = e.kind
    if k == EXPR_BINARY or k == EXPR_RANGE or k == EXPR_INDEX
        al_mark_walk_expr(a, e.left, reentered)
        al_mark_walk_expr(a, e.right, reentered)
    else if k == EXPR_UNARY
        al_mark_walk_expr(a, e.operand, reentered)
    else if k == EXPR_CALL
        if e.func_name == null
            al_mark_walk_expr(a, e.left, reentered)
        al_mark_walk_list(a, e.args, reentered)
    else if k == EXPR_METHOD
        al_mark_walk_expr(a, e.left, reentered)
        al_mark_walk_list(a, e.args, reentered)
    else if k == EXPR_MEMBER or k == EXPR_CAST or k == EXPR_TRY or k == EXPR_ARRAY_FILL
        al_mark_walk_expr(a, e.left, reentered)
    else if k == EXPR_IF or k == EXPR_MATCH
        al_mark_walk_expr(a, e.left, reentered)
        al_mark_walk_arms(a, e.args as *MatchArm, reentered)
    else if k == EXPR_STRUCT_LIT
        var fi: *FieldInit = e.args as *FieldInit
        while fi != null
            al_mark_walk_expr(a, fi.value, reentered)
            fi = fi.next
    else if k == EXPR_ARRAY_LIT
        al_mark_walk_list(a, e.args, reentered)

fn al_mark_walk_list(a: *AlFn, e: *Expr, reentered: i32)
    var cur: *Expr = e
    while cur != null
        al_mark_walk_expr(a, cur, reentered)
        cur = cur.next

fn al_mark_walk_arms(a: *AlFn, arm: *MatchArm, reentered: i32)
    var cur: *MatchArm = arm
    while cur != null
        al_mark_walk_stmts(a, cur.body_stmts, reentered)
        al_mark_walk_expr(a, cur.body, reentered)
        cur = cur.next

fn al_needs(a: *AlFn, s: *Stmt, lp: *AlLoop) -> i32
    if al_await_in_stmt(s) != null
        return 1
    if lp != null and al_jump_in_stmt(s) != null
        return 1
    # A return runs every active defer, which the emitter can't see across
    # states: lower the statement that holds it (AGAST #4191).
    if a.defers != null and al_return_in_stmt(s) == 1
        return 1
    0

# Does `s` hold a `return`?  A return leaves every block, so with an active
# defer it must be lowered even with no await (AGAST #4191).
fn al_return_in_arms(arm: *MatchArm) -> i32
    var cur: *MatchArm = arm
    while cur != null
        if al_return_in_stmts(cur.body_stmts) == 1
            return 1
        cur = cur.next
    0

fn al_return_in_stmts(s: *Stmt) -> i32
    var cur: *Stmt = s
    while cur != null
        if al_return_in_stmt(cur) == 1
            return 1
        cur = cur.next
    0

fn al_return_in_stmt(s: *Stmt) -> i32
    let k: i32 = s.kind
    if k == STMT_RETURN
        return 1
    if k == STMT_IF
        if al_return_in_stmts(s.if_then) == 1
            return 1
        return al_return_in_stmts(s.if_else)
    # A return inside a nested loop still leaves the function.
    if k == STMT_WHILE or k == STMT_LOOP or k == STMT_DEFER or k == STMT_UNSAFE
        return al_return_in_stmts(s.while_body)
    if k == STMT_FOR
        return al_return_in_stmts(s.for_body)
    if k == STMT_MATCH
        return al_return_in_arms(s.if_then as *MatchArm)
    0

fn al_needs_expr(e: *Expr, lp: *AlLoop) -> i32
    if al_await_in(e) != null
        return 1
    (lp != null and al_jump_in_expr(e) != null) as i32

# -- refusals ---------------------------------------------------------------

# The first error only, as ritz0 stops at its first.
fn al_refuse(a: *AlFn, m: @&String, span: SrcSpan)
    if a.errs == 0
        diag_error_buf(a.file, span, m)
    a.errs += 1

fn al_unplaced(a: *AlFn, what: *u8, span: SrcSpan)
    var m: String = string_new()
    m.push_str("`await` inside ")
    m.push_span(Span<u8> { ptr: (what), len: (al_clen(what) as i64) as i64 })
    m.push_str(" in an async fn is not supported yet (AGAST #4013)")
    al_refuse(a, @&m, span)

# Where a refused statement is: its first await, else its jump, else itself.
fn al_culprit(s: *Stmt) -> SrcSpan
    let e: *Expr = al_await_in_stmt(s)
    if e != null
        return e.span
    let j: *Stmt = al_jump_in_stmt(s)
    if j != null
        return j.span
    s.span

# -- states -----------------------------------------------------------------

fn al_new_block(a: *AlFn) -> *AlBlock
    let b: *AlBlock = al_zalloc(sizeof(AlBlock)) as *AlBlock
    b.idx = a.nblocks
    a.nblocks += 1
    if a.last_block == null
        a.blocks = b
    else
        a.last_block.next = b
    a.last_block = b
    b

# The open state, or a fresh (unreachable) one after a jump.
fn al_at(a: *AlFn) -> *AlBlock
    if a.cur == null
        a.cur = al_new_block(a)
    a.cur

fn al_emit(a: *AlFn, s: *Stmt)
    if s == null
        return
    s.next = null
    let b: *AlBlock = al_at(a)
    b.head = al_append(b.head, s)

# A chain of statements, appended whole.
fn al_emit_all(a: *AlFn, s: *Stmt)
    if s == null
        return
    let b: *AlBlock = al_at(a)
    b.head = al_append(b.head, s)

# Register a `defer`'s (already rewritten) body in the open block (AGAST
# #4191).  Nothing runs here: the body runs at each exit edge.
fn al_add_defer(a: *AlFn, body: *Stmt)
    let d: *AlDefer = al_zalloc(sizeof(AlDefer)) as *AlDefer
    d.body = body
    d.next = a.defers
    a.defers = d

# Run the defers above `stop`, innermost first and, within one block, in
# reverse order (LARB §13.7).  Each is emitted as a fresh copy: its block may
# exit at several edges.
fn al_run_defers(a: *AlFn, stop: *AlDefer)
    var d: *AlDefer = a.defers
    while d != stop
        al_emit_all(a, al_copy_stmts(d.body))
        d = d.next

fn al_close(a: *AlFn)
    let b: *AlBlock = al_at(a)
    b.closed = 1
    a.cur = null

fn al_set_state(n: i32, span: SrcSpan) -> *Stmt
    al_assign_self(StrView { ptr: (c"__state"), len: (7) as i64 }, al_int(n as i64, span), span)

fn al_goto(a: *AlFn, target: *AlBlock, span: SrcSpan)
    al_emit(a, al_set_state(target.idx, span))
    al_emit(a, al_stmt(STMT_CONTINUE, span))
    al_close(a)

fn al_branch(a: *AlFn, cond: *Expr, then_b: *AlBlock, else_b: *AlBlock, span: SrcSpan)
    let s: *Stmt = al_if(cond, al_set_state(then_b.idx, span), span)
    s.if_else = al_set_state(else_b.idx, span)
    al_emit(a, s)
    al_emit(a, al_stmt(STMT_CONTINUE, span))
    al_close(a)

# `return v` from the async fn: Ready, v in `__result` (a unit fn's v has
# already run, delivered for its effects).  A Ready leaves every block, so
# every active defer runs, innermost first, after v is stored (AGAST #4191).
fn al_ret(a: *AlFn, v: *Expr, span: SrcSpan)
    var value: *Expr = v
    if a.f.return_type == TYPE_VOID
        value = null
    if a.defers == null
        al_emit_all(a, al_poll_ready(a, value, span))
        al_close(a)
        return
    al_store_ready(a, value, span)
    al_run_defers(a, null)
    al_emit(a, al_assign_self(StrView { ptr: (c"__state"), len: (7) as i64 }, al_pending(span), span))
    al_emit(a, al_return(al_true(span), span))
    al_close(a)

# The value store of a Ready, without its finish: `al_poll_ready` minus
# `__state = -1` and `return true`, so the defers can run in between.
fn al_store_ready(a: *AlFn, v: *Expr, span: SrcSpan)
    if v == null
        return
    v.next = null
    if a.f.return_type != TYPE_VOID
        al_emit(a, al_assign_self(StrView { ptr: (c"__result"), len: (8) as i64 }, v, span))
    else if v.kind != EXPR_INT_LIT and v.kind != EXPR_MEMBER and v.kind != EXPR_IDENT
        al_emit(a, al_expr_stmt(v))

# -- values -----------------------------------------------------------------

# Drive each await in `e` in its own state, in evaluation order, storing its
# result; then `e` rewritten to read the results.
fn al_hoist(a: *AlFn, e: *Expr) -> *Expr
    if e == null
        return null
    al_hoist_walk(a, e, null)
    al_rw_expr(a, e)

fn al_hoist_list(a: *AlFn, e: *Expr) -> *Expr
    var cur: *Expr = e
    while cur != null
        al_hoist_walk(a, cur, null)
        cur = cur.next
    al_rw_list(a, e)

fn al_hoist_arms(a: *AlFn, arm: *MatchArm, under: *u8)
    var cur: *MatchArm = arm
    while cur != null
        let s: *Expr = al_await_in_stmts(cur.body_stmts)
        if s != null
            al_unplaced(a, under, s.span)
        al_hoist_walk(a, cur.body, under)
        cur = cur.next

# `under`: what the await would be inside, which has no state edge for it
# (null: nothing).
fn al_hoist_walk(a: *AlFn, e: *Expr, under: *u8)
    if e == null
        return
    let k: i32 = e.kind
    if k == EXPR_AWAIT
        if under != null
            al_unplaced(a, under, e.span)
            return
        var n: i32 = 0
        let tmp: *u8 = al_numbered(c"__await_result_", a.nawaits, @n)
        # Of the awaited fn's result type (R78); a poll source's i32.  A held
        # future's (`await p`, R79) is its async fn's.
        let g: *AlAsync = al_call_of_async(e.operand)
        var held: *AlAsync = null
        if g == null
            held = al_held_async(a, e.operand)
        var callee: *FnDef = null
        if g != null
            callee = g.f
        else if held != null
            callee = held.f
        if callee != null and callee.return_type == TYPE_VOID
            if g != null
                al_no_value(a, g, e.span)
            else
                al_no_value(a, held, e.span)
            return
        let res: *AlLocal = al_extra(a, StrView { ptr: (tmp), len: (n) as i64 })
        if callee == null or al_set_ret(res, callee) == 0
            al_set_scalar(res, TYPE_I32)
        var d: AlDest = al_dest(AL_TO_FIELD, e.span)
        d.name = tmp
        d.len = n
        al_lower_await(a, e, @d)
        al_add_point(a, e, StrView { ptr: (tmp), len: (n) as i64 })
    else if k == EXPR_IF and under == null and (e.args as *MatchArm).next != null and al_await_in(e) != null
        al_if_value(a, e)
    else if k == EXPR_IF or k == EXPR_MATCH
        al_hoist_walk(a, e.left, under)
        var u: *u8 = under
        if u == null
            if k == EXPR_IF
                u = c"an `if` inside an expression"
            else
                u = c"a `match` inside an expression"
        al_hoist_arms(a, e.args as *MatchArm, u)
    else if k == EXPR_BINARY and (e.op == OP_AND or e.op == OP_OR) and under == null and al_await_in(e.right) != null
        al_short_circuit(a, e)
    else if k == EXPR_BINARY or k == EXPR_RANGE or k == EXPR_INDEX
        al_hoist_walk(a, e.left, under)
        al_hoist_walk(a, e.right, under)
    else if k == EXPR_UNARY
        al_hoist_walk(a, e.operand, under)
    else if k == EXPR_CALL or k == EXPR_METHOD
        if k == EXPR_METHOD or e.func_name == null
            al_hoist_walk(a, e.left, under)
        var arg: *Expr = e.args
        while arg != null
            al_hoist_walk(a, arg, under)
            arg = arg.next
    else if k == EXPR_MEMBER or k == EXPR_CAST or k == EXPR_TRY or k == EXPR_ARRAY_FILL
        al_hoist_walk(a, e.left, under)
    else if k == EXPR_STRUCT_LIT
        var fi: *FieldInit = e.args as *FieldInit
        while fi != null
            al_hoist_walk(a, fi.value, under)
            fi = fi.next
    else if k == EXPR_ARRAY_LIT
        var el: *Expr = e.args
        while el != null
            al_hoist_walk(a, el, under)
            el = el.next

# `l && r` / `l || r` whose `r` awaits (AGAST #4013): `r`, and its awaits,
# run only when `l` doesn't decide the value.  ritz0's _short_circuit.
#
#     __short_K = l
#     if __short_K { -> R } else { -> J }    # `||`: the arms swap
#   R: __short_K = r                         # r's awaits in states
#   J: ... the expression reads __short_K
fn al_short_circuit(a: *AlFn, e: *Expr)
    al_hoist_walk(a, e.left, null)
    var n: i32 = 0
    let tmp: *u8 = al_numbered(c"__short_", a.nshorts, @n)
    a.nshorts += 1
    al_set_scalar(al_extra(a, StrView { ptr: (tmp), len: (n) as i64 }), TYPE_BOOL)
    let left: *Expr = al_rw_expr(a, e.left)
    left.next = null
    al_emit(a, al_assign_self(StrView { ptr: (tmp), len: (n) as i64 }, left, e.span))
    let rhs: *AlBlock = al_new_block(a)
    let join: *AlBlock = al_new_block(a)
    let known: *Expr = al_self_field(StrView { ptr: (tmp), len: (n) as i64 }, e.span)
    if e.op == OP_AND
        al_branch(a, known, rhs, join, e.span)
    else
        al_branch(a, known, join, rhs, e.span)
    a.cur = rhs
    let right: *Expr = al_hoist(a, e.right)
    right.next = null
    al_emit(a, al_assign_self(StrView { ptr: (tmp), len: (n) as i64 }, right, e.span))
    al_goto(a, join, e.span)
    a.cur = join
    al_add_point(a, e, StrView { ptr: (tmp), len: (n) as i64 })

# A value's type into `l`, as al_infer tells it, read also through a value
# `if` (al_if_type) and the arithmetic over one: an awaiting `if` operand's
# `__if_K` field (AGAST #4190).  Only that field's: an untyped `let`'s is
# al_infer's alone.  ritz0's _IfTyper.
fn al_value_type(a: *AlFn, e: *Expr, l: *AlLocal) -> i32
    if e == null
        return 0
    let k: i32 = e.kind
    if k == EXPR_IF
        return al_if_type(a, e, l)
    if k == EXPR_BINARY and (e.op < OP_EQ or e.op > OP_OR)
        if e.op != OP_SHL and e.op != OP_SHR and e.left.kind == EXPR_INT_LIT and e.right.kind != EXPR_INT_LIT
            return al_value_type(a, e.right, l)
        return al_value_type(a, e.left, l)
    if k == EXPR_UNARY and (e.op == OP_NEG or e.op == OP_BIT_NOT)
        return al_value_type(a, e.operand, l)
    al_infer(a, e, l)

# A value `if`'s type: its first arm's whose value isn't a bare literal (`7`
# takes the other arm's type); else its first arm's that tells (`i64`).
fn al_if_type(a: *AlFn, e: *Expr, l: *AlLocal) -> i32
    let then_arm: *MatchArm = e.args as *MatchArm
    if then_arm == null or then_arm.next == null
        return 0
    var arm: *MatchArm = then_arm
    while arm != null
        if arm.body != null and al_untyped_int(arm.body) == 0 and al_value_type(a, arm.body, l) == 1
            return 1
        arm = arm.next
    arm = then_arm
    while arm != null
        if al_value_type(a, arm.body, l) == 1
            return 1
        arm = arm.next
    0

# A value `if` that is an operand and awaits (AGAST #4190): each arm runs in
# states of its own, its awaits only when it is taken, and writes the value
# to a field the expression reads.  al_short_circuit, with two arms; ritz0's
# _CfgBuilder._if_value.
#
#     if c { -> T } else { -> E }    # c's awaits first
#   T: __if_K = then-value           # its awaits in states
#   E: __if_K = else-value
#   J: ... the expression reads __if_K
fn al_if_value(a: *AlFn, e: *Expr)
    let jump: *Stmt = al_jump_in_expr(e)
    if jump != null
        # An arm's `break` would leave the dispatch loop, not the user's.
        # ritz0's row (jump_in_awaiting_operand): ritz1's operand `if` is
        # the inline form, whose arms hold no `break`, so it can't reach here.
        var jm: String = string_new()
        jm.push_str("`break` / `continue` inside an expression of an async fn's loop that awaits is not supported yet (AGAST #4013)")
        al_refuse(a, @&jm, jump.span)
        return
    var t: AlLocal
    if al_if_type(a, e, @t) == 0
        var m: String = string_new()
        m.push_str("cannot infer the type of the `if`'s value, which `")
        m.push_span(Span<u8> { ptr: (a.f.name), len: (a.f.name_len as i64) as i64 })
        m.push_str("`'s future holds across an `await`: cast an arm (`x as i32`)")
        al_refuse(a, @&m, e.span)
        return
    al_hoist_walk(a, e.left, null)
    var n: i32 = 0
    let tmp: *u8 = al_numbered(c"__if_", a.nifs, @n)
    a.nifs += 1
    al_if_type(a, e, al_extra(a, StrView { ptr: (tmp), len: (n) as i64 }))
    let cond: *Expr = al_rw_expr(a, e.left)
    cond.next = null
    let then_arm: *MatchArm = e.args as *MatchArm
    let then_b: *AlBlock = al_new_block(a)
    let else_b: *AlBlock = al_new_block(a)
    let join: *AlBlock = al_new_block(a)
    al_branch(a, cond, then_b, else_b, e.span)
    var d: AlDest = al_dest(AL_TO_FIELD, e.span)
    d.name = tmp
    d.len = n
    a.cur = then_b
    al_lower_arm(a, then_arm, @d, null)
    if a.cur != null
        al_goto(a, join, e.span)
    a.cur = else_b
    al_lower_arm(a, then_arm.next, @d, null)
    if a.cur != null
        al_goto(a, join, e.span)
    a.cur = join
    al_add_point(a, e, StrView { ptr: (tmp), len: (n) as i64 })

# `await inner` into `d`: a resume point.  An async fn's call builds its
# future into a field once, and the resume state polls it until it answers
# true (R78), so a Pending one is polled again on the next poll, not rebuilt;
# then it reads the future's `__result`.  Anything else awaited is a
# hand-written poll source, evaluated again at each poll until it is not -1.
fn al_lower_await(a: *AlFn, aw: *Expr, d: *AlDest)
    let k: i32 = a.nawaits
    a.nawaits += 1
    let span: SrcSpan = aw.span
    let inner: *Expr = aw.operand
    let g: *AlAsync = al_call_of_async(inner)
    if g != null
        var fl: i32 = 0
        let fut: *u8 = al_numbered(c"__future_", k, @fl)
        var tl: i32 = 0
        let fut_ty: *u8 = al_future_struct_name(g.name, g.len, @tl)
        al_set_struct(al_extra(a, StrView { ptr: (fut), len: (fl) as i64 }), StrView { ptr: (fut_ty), len: (tl) as i64 })
        let args: *Expr = al_hoist_list(a, inner.args)
        # The user's call of g, at its own span: a private g of another file
        # is refused here (#3925).  g$poll is the compiler's own call.
        al_emit(a, al_assign_self(StrView { ptr: (fut), len: (fl) as i64 }, al_call(StrView { ptr: (g.name), len: (g.len) as i64 }, args, inner.span), span))
        var pl: i32 = 0
        let poll: *u8 = al_poll_fn_name(g.name, g.len, @pl)
        let addr: *Expr = al_expr(EXPR_UNARY, span)
        addr.op = OP_ADDR
        addr.operand = al_self_field(StrView { ptr: (fut), len: (fl) as i64 }, span)
        let resume: *AlBlock = al_new_block(a)
        al_goto(a, resume, span)
        a.cur = resume
        al_emit(a, al_if(al_poll_not_ready(al_call(StrView { ptr: (poll), len: (pl) as i64 }, addr, span)), al_poll_pending_stmt(span), span))
        if g.f.return_type == TYPE_VOID
            # A unit fn's future has no result to deliver.
            if d.kind == AL_TO_NONE
                return
            if d.kind == AL_TO_RETURN and a.f.return_type == TYPE_VOID
                al_ret(a, null, span)
                return
            al_no_value(a, g, span)
            return
        al_deliver(a, al_result_of(al_self_field(StrView { ptr: (fut), len: (fl) as i64 }, span), span), d)
        return
    # `await p`, p a held future (R79): its future already lives in a field of
    # ours (`self.p`), so the resume state polls it in place; one already
    # finished answers true at once and only its `__result` is read.
    let held: *AlAsync = al_held_async(a, inner)
    if held != null
        var hpl: i32 = 0
        let hpoll: *u8 = al_poll_fn_name(held.name, held.len, @hpl)
        let haddr: *Expr = al_expr(EXPR_UNARY, span)
        haddr.op = OP_ADDR
        haddr.operand = al_self_field(StrView { ptr: (inner.ident_ptr), len: (inner.ident_len) as i64 }, span)
        let hresume: *AlBlock = al_new_block(a)
        al_goto(a, hresume, span)
        a.cur = hresume
        al_emit(a, al_if(al_poll_not_ready(al_call(StrView { ptr: (hpoll), len: (hpl) as i64 }, haddr, span)), al_poll_pending_stmt(span), span))
        if held.f.return_type == TYPE_VOID
            if d.kind == AL_TO_NONE
                return
            if d.kind == AL_TO_RETURN and a.f.return_type == TYPE_VOID
                al_ret(a, null, span)
                return
            al_no_value(a, held, span)
            return
        al_deliver(a, al_result_of(al_self_field(StrView { ptr: (inner.ident_ptr), len: (inner.ident_len) as i64 }, span), span), d)
        return
    var anl: i32 = 0
    let answer: *u8 = al_numbered(c"__poll_", k, @anl)
    let polled: *Expr = al_hoist(a, inner)
    polled.next = null
    let resume: *AlBlock = al_new_block(a)
    al_goto(a, resume, span)
    a.cur = resume
    al_emit(a, al_decl(StrView { ptr: (answer), len: (anl) as i64 }, TYPE_I32, StrView { ptr: (null), len: (0) as i64 }, polled, 1, a.file, span))
    al_emit(a, al_if(al_poll_is_pending(al_ident(StrView { ptr: (answer), len: (anl) as i64 }, span)), al_poll_pending_stmt(span), span))
    al_deliver(a, al_ident(StrView { ptr: (answer), len: (anl) as i64 }, span), d)

fn al_deliver(a: *AlFn, v: *Expr, d: *AlDest)
    v.next = null
    if d.kind == AL_TO_NONE
        # A value nobody reads: kept only for its effects.
        if v.kind != EXPR_INT_LIT and v.kind != EXPR_MEMBER and v.kind != EXPR_IDENT
            al_emit(a, al_expr_stmt(v))
    else if d.kind == AL_TO_RETURN
        if a.f.return_type == TYPE_VOID
            var none: AlDest = al_dest(AL_TO_NONE, v.span)
            al_deliver(a, v, @none)
        al_ret(a, v, v.span)
    else if d.kind == AL_TO_FIELD
        al_emit(a, al_assign_self(StrView { ptr: (d.name), len: (d.len) as i64 }, v, d.span))
    else if d.kind == AL_TO_RESULT
        # A Ready's value store on its own; the defers and the finish follow.
        al_emit(a, al_assign_self(StrView { ptr: (c"__result"), len: (8) as i64 }, v, d.span))
    else
        let s: *Stmt = al_copy_stmt(d.stmt)
        s.assign_value = v
        al_emit(a, s)

# A then/else arm of an EXPR_IF: its statements, then its value.
fn al_lower_arm(a: *AlFn, arm: *MatchArm, d: *AlDest, lp: *AlLoop)
    # The arm is a block: statements, then its value, then its defers.
    let saved: *AlDefer = a.defers
    var cur: *Stmt = arm.body_stmts
    while cur != null
        let nxt: *Stmt = cur.next
        al_lower_stmt(a, cur, lp)
        cur = nxt
    if arm.body != null and arm.is_pass == 0
        al_lower_value(a, arm.body, d, lp)
    else if d.kind == AL_TO_RETURN and a.cur != null
        al_ret(a, null, d.span)
    if a.cur != null
        al_run_defers(a, saved)
    a.defers = saved

# Evaluate `e` into `d`.
fn al_lower_value(a: *AlFn, e: *Expr, d: *AlDest, lp: *AlLoop)
    if al_needs_expr(e, lp) == 0 and (e.kind != EXPR_MATCH or al_arms_need(a, e.args as *MatchArm, lp) == 0)
        al_deliver(a, al_rw_expr(a, e), d)
    else if e.kind == EXPR_IF
        let cond: *Expr = al_hoist(a, e.left)
        let then_arm: *MatchArm = e.args as *MatchArm
        let then_b: *AlBlock = al_new_block(a)
        let else_b: *AlBlock = al_new_block(a)
        let join: *AlBlock = al_new_block(a)
        al_branch(a, cond, then_b, else_b, e.span)
        a.cur = then_b
        al_lower_arm(a, then_arm, d, lp)
        if a.cur != null
            al_goto(a, join, e.span)
        a.cur = else_b
        if then_arm.next != null
            al_lower_arm(a, then_arm.next, d, lp)
        if a.cur != null
            al_goto(a, join, e.span)
        a.cur = join
    else if e.kind == EXPR_MATCH and al_arms_need(a, e.args as *MatchArm, lp) == 1
        al_lower_match(a, e.left, e.args as *MatchArm, d, lp, e.span)
    else if e.kind == EXPR_AWAIT
        al_lower_await(a, e, d)
    else
        al_deliver(a, al_hoist(a, e), d)

# An `if` statement; with `d`, each branch's last statement is its value.
fn al_lower_if(a: *AlFn, s: *Stmt, d: *AlDest, lp: *AlLoop)
    let cond: *Expr = al_hoist(a, s.if_cond)
    let then_b: *AlBlock = al_new_block(a)
    let else_b: *AlBlock = al_new_block(a)
    let join: *AlBlock = al_new_block(a)
    al_branch(a, cond, then_b, else_b, s.span)
    a.cur = then_b
    al_lower_list(a, s.if_then, d, lp)
    if a.cur != null
        al_goto(a, join, s.span)
    a.cur = else_b
    al_lower_list(a, s.if_else, d, lp)
    if a.cur != null
        al_goto(a, join, s.span)
    a.cur = join

# `while cond` (`loop`: cond null): the condition's awaits re-run each pass.
fn al_lower_while(a: *AlFn, cond: *Expr, body: *Stmt, span: SrcSpan)
    let head: *AlBlock = al_new_block(a)
    al_goto(a, head, span)
    a.cur = head
    var c: *Expr = null
    if cond == null
        c = al_true(span)
    else
        c = al_hoist(a, cond)
    let body_b: *AlBlock = al_new_block(a)
    let exit_b: *AlBlock = al_new_block(a)
    al_branch(a, c, body_b, exit_b, span)
    a.cur = body_b
    var lp: AlLoop
    lp.head = head
    lp.exit = exit_b
    lp.defers = a.defers
    var none: AlDest = al_dest(AL_TO_NONE, span)
    al_lower_list(a, body, @none, @lp)
    if a.cur != null
        al_goto(a, head, span)
    a.cur = exit_b

# `5` or `-5`: a literal that takes the other operand's type (LARB R21).
fn al_untyped_int(e: *Expr) -> i32
    var x: *Expr = e
    if x.kind == EXPR_UNARY and x.op == OP_NEG
        x = x.operand
    (x.kind == EXPR_INT_LIT and x.lit_kind == LIT_PLAIN) as i32

# An awaiting `for`'s var's type, into `l`: its start's, unless that is a
# bare literal (`0..n`) or untold; then its end's.  0 if neither tells.
# ritz0's _CfgBuilder._for_type.
fn al_for_type(a: *AlFn, s: *Stmt, l: *AlLocal) -> i32
    if al_untyped_int(s.for_start) == 0 and al_infer(a, s.for_start, l) == 1
        return 1
    al_infer(a, s.for_end, l)

# `for v in a..b` (#4188): v and the end are future fields, `__for_K` and
# `__for_end_K`, the end evaluated once; then a `while __for_K < __for_end_K`
# whose `continue` goes to the increment.  ritz0's _CfgBuilder._lower_for.
fn al_lower_for(a: *AlFn, s: *Stmt)
    let span: SrcSpan = s.span
    if s.for_end == null
        al_unplaced(a, c"a `for` over an iterable", al_culprit(s))
        return
    var t: AlLocal
    if al_for_type(a, s, @t) == 0
        var m: String = string_new()
        m.push_str("cannot infer the type of `")
        m.push_span(Span<u8> { ptr: (s.for_var), len: (s.for_var_len as i64) as i64 })
        m.push_str("`, which `")
        m.push_span(Span<u8> { ptr: (a.f.name), len: (a.f.name_len as i64) as i64 })
        m.push_str("`'s future holds across an `await`: cast a bound of its range (`0..(n as i64)`)")
        al_refuse(a, @&m, span)
        return
    let k: i32 = a.nfors
    a.nfors += 1
    var vl: i32 = 0
    let var_f: *u8 = al_numbered(c"__for_", k, @vl)
    var el: i32 = 0
    let end_f: *u8 = al_numbered(c"__for_end_", k, @el)
    al_for_type(a, s, al_extra(a, StrView { ptr: (var_f), len: (vl) as i64 }))
    al_for_type(a, s, al_extra(a, StrView { ptr: (end_f), len: (el) as i64 }))
    let start: *Expr = al_hoist(a, s.for_start)
    start.next = null
    al_emit(a, al_assign_self(StrView { ptr: (var_f), len: (vl) as i64 }, start, span))
    let end: *Expr = al_hoist(a, s.for_end)
    end.next = null
    al_emit(a, al_assign_self(StrView { ptr: (end_f), len: (el) as i64 }, end, span))
    let head: *AlBlock = al_new_block(a)
    al_goto(a, head, span)
    a.cur = head
    var op: i32 = OP_LT
    if s.for_inclusive == 1
        op = OP_LE
    let cond: *Expr = al_binary(op, al_self_field(StrView { ptr: (var_f), len: (vl) as i64 }, span), al_self_field(StrView { ptr: (end_f), len: (el) as i64 }, span))
    let body_b: *AlBlock = al_new_block(a)
    let incr: *AlBlock = al_new_block(a)
    let exit_b: *AlBlock = al_new_block(a)
    al_branch(a, cond, body_b, exit_b, span)
    a.cur = body_b
    let r: *AlRename = al_zalloc(sizeof(AlRename)) as *AlRename
    r.name = s.for_var
    r.len = s.for_var_len
    r.field = var_f
    r.flen = vl
    r.next = a.renames
    a.renames = r
    var lp: AlLoop
    lp.head = incr
    lp.exit = exit_b
    lp.defers = a.defers
    var none: AlDest = al_dest(AL_TO_NONE, span)
    al_lower_list(a, s.for_body, @none, @lp)
    a.renames = r.next
    if a.cur != null
        al_goto(a, incr, span)
    a.cur = incr
    let step: *Expr = al_binary(OP_ADD, al_self_field(StrView { ptr: (var_f), len: (vl) as i64 }, span), al_int(1, span))
    al_emit(a, al_assign_self(StrView { ptr: (var_f), len: (vl) as i64 }, step, span))
    al_goto(a, head, span)
    a.cur = exit_b

# Does an arm of a `match` await, jump out of the loop `lp`, or return while
# a defer is active?
fn al_arms_need(a: *AlFn, arm: *MatchArm, lp: *AlLoop) -> i32
    if al_await_in_arms(arm) != null
        return 1
    if lp != null and al_jump_in_arms(arm) != null
        return 1
    if a.defers != null and al_return_in_arms(arm) == 1
        return 1
    0

fn al_hide(a: *AlFn, name_sv: StrView)
    var name: *u8 = name_sv.ptr
    var len: i32 = name_sv.len as i32
    let r: *AlRename = al_zalloc(sizeof(AlRename)) as *AlRename
    r.name = name
    r.len = len
    r.next = a.renames
    a.renames = r

# The names `arm`'s pattern binds, hidden from the rewrite (they are the
# arm's, not a field or a `for` var); how many.  A bare name may be a unit
# variant (`None`), which ritz0's parser can't tell either: it counts.
# ritz0's _pattern_names.
fn al_arm_names(a: *AlFn, arm: *MatchArm) -> i32
    if arm.pattern_kind == PAT_IDENT and arm.qualifier == null
        al_hide(a, StrView { ptr: (arm.pattern_name), len: (arm.pattern_name_len) as i64 })
        return 1
    if arm.pattern_kind != PAT_VARIANT
        return 0
    if arm.pattern_binds == null
        if arm.pattern_inner_kind != PAT_IDENT
            return 0
        al_hide(a, StrView { ptr: (arm.pattern_inner_name), len: (arm.pattern_inner_name_len) as i64 })
        return 1
    var n: i32 = 0
    var t: *TupleName = arm.pattern_binds
    while t != null
        let c0: u8 = *(t.name)
        if t.len != 1 or c0 != '_'   # `_`: a wildcard slot
            al_hide(a, StrView { ptr: (t.name), len: (t.len) as i64 })
            n += 1
        t = t.next
    n

fn al_copy_arm(arm: *MatchArm) -> *MatchArm
    let c: *MatchArm = al_zalloc(sizeof(MatchArm)) as *MatchArm
    let src: *u8 = arm as *u8
    let dst: *u8 = c as *u8
    var i: i64 = 0
    while i < sizeof(MatchArm)
        *(dst + i) = *(src + i)
        i += 1
    c.next = null
    c

# `arms`' patterns over `scrut`, arm `sel` running `body` (the others
# nothing): the same patterns, so the same arm is taken and the match stays
# exhaustive.  Arm `j` of a dispatch (`sel` -1) jumps to state `entries[j]`.
fn al_rematch(arms: *MatchArm, scrut: *Expr, sel: i32, body: *Stmt, entries: **AlBlock, span: SrcSpan) -> *Stmt
    var head: *MatchArm = null
    var last: *MatchArm = null
    var j: i32 = 0
    var cur: *MatchArm = arms
    while cur != null
        let c: *MatchArm = al_copy_arm(cur)
        c.body = null
        c.is_pass = 1
        c.is_block = 1
        c.body_stmts = null
        if sel < 0
            let to: *AlBlock = *(entries + j)
            c.body_stmts = al_set_state(to.idx, span)
        else if j == sel
            c.body_stmts = body
        if last == null
            head = c
        else
            last.next = c
        last = c
        j += 1
        cur = cur.next
    let s: *Stmt = al_stmt(STMT_MATCH, span)
    s.if_cond = scrut
    s.if_then = head as *Stmt
    s

# A `match` whose arms await, or jump out of the loop (#4189): each arm is a
# state, entered by matching the scrutinee once.  ritz0's
# _CfgBuilder._lower_match.
#
# An arm's names are bound by the match, which a later state of the arm
# doesn't run.  When an arm binds one, the scrutinee is a future field,
# `__match_K`, and each of that arm's states runs inside a match of it over
# the same patterns (a pattern binds no `mut` name and has no guard, so the
# same arm is taken with the same values):
#
#     __match_K = scrutinee
#     match __match_K { p0 => -> A0, p1 => -> A1 }
#   A1: match __match_K { p0 => {}, p1 => { ...A1's statements } }
fn al_lower_match(a: *AlFn, scrut: *Expr, arms: *MatchArm, d: *AlDest, lp: *AlLoop, span: SrcSpan)
    var binds: i32 = 0
    var narms: i32 = 0
    let saved: *AlRename = a.renames
    var cur: *MatchArm = arms
    while cur != null
        binds += al_arm_names(a, cur)
        narms += 1
        cur = cur.next
    a.renames = saved
    # Its type is told before the hoist rewrites it.
    var t: AlLocal
    var typed: i32 = 0
    if binds > 0
        typed = al_infer(a, scrut, @t)
    let at: SrcSpan = scrut.span
    var sc: *Expr = al_hoist(a, scrut)
    sc.next = null
    var field: *u8 = null
    var fl: i32 = 0
    if binds > 0
        if typed == 0
            var m: String = string_new()
            m.push_str("cannot infer the type of the `match`'s scrutinee, which `")
            m.push_span(Span<u8> { ptr: (a.f.name), len: (a.f.name_len as i64) as i64 })
            m.push_str("`'s future holds across an `await`: match a typed local (`let v: T = ...`)")
            al_refuse(a, @&m, at)
            return
        field = al_numbered(c"__match_", a.nmatches, @fl)
        a.nmatches += 1
        let x: *AlLocal = al_extra(a, StrView { ptr: (field), len: (fl) as i64 })
        x.ty = t.ty
        x.type_name = t.type_name
        x.type_name_len = t.type_name_len
        x.pointee = t.pointee
        x.inner_pointee = t.inner_pointee
        x.inner_ref = t.inner_ref
        x.unsupported = t.unsupported
        al_emit(a, al_assign_self(StrView { ptr: (field), len: (fl) as i64 }, sc, span))
        sc = al_self_field(StrView { ptr: (field), len: (fl) as i64 }, span)
    let entries: **AlBlock = al_zalloc((narms as i64) * 8) as **AlBlock
    var j: i32 = 0
    while j < narms
        *(entries + j) = al_new_block(a)
        j += 1
    let join: *AlBlock = al_new_block(a)
    al_emit(a, al_rematch(arms, sc, -1, null, entries, span))
    al_emit(a, al_stmt(STMT_CONTINUE, span))
    al_close(a)
    j = 0
    cur = arms
    while cur != null
        let first: i32 = a.nblocks
        a.cur = *(entries + j)
        let named: i32 = al_arm_names(a, cur)
        al_lower_arm(a, cur, d, lp)
        a.renames = saved
        if a.cur != null
            al_goto(a, join, span)
        if named > 0
            # A nested match's states are wrapped already: this match goes
            # around, so its names are in scope there too.
            var b: *AlBlock = a.blocks
            while b != null
                if b == *(entries + j) or b.idx >= first
                    b.head = al_rematch(arms, al_self_field(StrView { ptr: (field), len: (fl) as i64 }, span), j, b.head, entries, span)
                b = b.next
        j += 1
        cur = cur.next
    a.cur = join

# The statements `s`; with `d`, the last one is the list's value.  It is a
# block: its fall-through exit runs its defers (AGAST #4191).
fn al_lower_list(a: *AlFn, s: *Stmt, d: *AlDest, lp: *AlLoop)
    let saved: *AlDefer = a.defers
    var cur: *Stmt = s
    while cur != null
        let nxt: *Stmt = cur.next
        if nxt == null and d.kind != AL_TO_NONE
            al_lower_tail(a, cur, d, lp)
        else
            al_lower_stmt(a, cur, lp)
        cur = nxt
    if a.cur != null
        al_run_defers(a, saved)
    a.defers = saved

fn al_lower_tail(a: *AlFn, s: *Stmt, d: *AlDest, lp: *AlLoop)
    if s.kind == STMT_EXPR
        al_lower_value(a, s.expr, d, lp)
        return
    if s.kind == STMT_IF and s.if_else != null
        al_lower_if(a, s, d, lp)
        return
    if s.kind == STMT_MATCH and al_arms_need(a, s.if_then as *MatchArm, lp) == 0
        # Its arms' values go to `d` in place (its scrutinee's awaits first).
        s.if_cond = al_hoist(a, s.if_cond)
        al_rw_arms(a, s.if_then as *MatchArm)
        let open: i32 = al_deliver_arms(a, s.if_then as *MatchArm, d)
        al_emit(a, s)
        if d.kind == AL_TO_RETURN and a.cur != null
            if open == 0
                al_close(a)   # every arm is Ready: nothing follows (#4189)
            else
                al_ret(a, null, s.span)
        return
    if s.kind == STMT_MATCH
        al_lower_match(a, s.if_cond, s.if_then as *MatchArm, d, lp, s.span)
        return
    al_lower_stmt(a, s, lp)
    if d.kind == AL_TO_RETURN and a.cur != null
        al_ret(a, null, s.span)

# Each arm's value `v` becomes the statement that puts it in `d`; how many
# arms have none.
fn al_deliver_arms(a: *AlFn, arm: *MatchArm, d: *AlDest) -> i32
    var open: i32 = 0
    var cur: *MatchArm = arm
    while cur != null
        if cur.body != null and cur.is_pass == 0
            let held: *AlBlock = a.cur
            let tmp: *AlBlock = al_zalloc(sizeof(AlBlock)) as *AlBlock
            a.cur = tmp
            al_deliver(a, cur.body, d)
            a.cur = held
            cur.body_stmts = al_append(cur.body_stmts, tmp.head)
            cur.body = null
            cur.is_pass = 1
        else
            open += 1
        cur = cur.next
    open

fn al_lower_stmt(a: *AlFn, s: *Stmt, lp: *AlLoop)
    let k: i32 = s.kind
    if k == STMT_DEFER
        # Nothing runs at the `defer`: its body runs at each exit of this
        # block, which al_run_defers places on every edge (AGAST #4191).
        let aw: *Expr = al_await_in_stmts(s.while_body)
        if aw != null
            var m: String = string_new()
            m.push_str("`await` inside a `defer` in an async fn is not supported yet (AGAST #4013)")
            al_refuse(a, @&m, aw.span)
            return
        al_add_defer(a, al_rw_stmts(a, s.while_body))
        return
    if al_needs(a, s, lp) == 0
        s.next = null
        al_emit_all(a, al_rw_stmt(a, s))
        if k == STMT_RETURN
            al_close(a)
        return
    if k == STMT_VAR_DECL
        var d: AlDest = al_dest(AL_TO_FIELD, s.span)
        d.name = s.var_name
        d.len = s.var_name_len
        al_lower_value(a, s.var_init, @d, lp)
    else if k == STMT_ASSIGN or k == STMT_MEMBER_ASSIGN or k == STMT_MEMBER_INDEX_ASSIGN or k == STMT_INDEX_ASSIGN or k == STMT_LOCAL_FIELD_ASSIGN or k == STMT_LOCAL_FIELD_INDEX_ASSIGN
        al_rw_target(a, s, 1)
        var d: AlDest = al_dest(AL_TO_ASSIGN, s.span)
        d.stmt = s
        al_lower_value(a, s.assign_value, @d, lp)
    else if k == STMT_RETURN
        if s.return_value == null
            al_ret(a, null, s.span)
        else
            var d: AlDest = al_dest(AL_TO_RETURN, s.span)
            al_lower_value(a, s.return_value, @d, lp)
    else if k == STMT_EXPR
        var d: AlDest = al_dest(AL_TO_NONE, s.span)
        al_lower_value(a, s.expr, @d, lp)
    else if k == STMT_IF
        var d: AlDest = al_dest(AL_TO_NONE, s.span)
        al_lower_if(a, s, @d, lp)
    else if k == STMT_WHILE
        al_lower_while(a, s.while_cond, s.while_body, s.span)
    else if k == STMT_LOOP
        al_lower_while(a, null, s.while_body, s.span)
    else if k == STMT_BREAK
        al_run_defers(a, lp.defers)
        al_goto(a, lp.exit, s.span)
    else if k == STMT_CONTINUE
        al_run_defers(a, lp.defers)
        al_goto(a, lp.head, s.span)
    else if k == STMT_UNSAFE
        var d: AlDest = al_dest(AL_TO_NONE, s.span)
        al_lower_list(a, s.while_body, @d, lp)
    else if k == STMT_MATCH and al_arms_need(a, s.if_then as *MatchArm, lp) == 1
        var d: AlDest = al_dest(AL_TO_NONE, s.span)
        al_lower_match(a, s.if_cond, s.if_then as *MatchArm, @d, lp, s.span)
    else if k == STMT_MATCH
        # Only its scrutinee awaits: the match runs whole, after it.
        s.if_cond = al_hoist(a, s.if_cond)
        al_rw_arms(a, s.if_then as *MatchArm)
        al_emit(a, s)
    else if k == STMT_FOR
        al_lower_for(a, s)
    else
        al_unplaced(a, c"this statement", al_culprit(s))

# The poll's body: `while true` over `if self.__state == N` for each state.
fn al_dispatch(a: *AlFn, span: SrcSpan) -> *Stmt
    var arms: *Stmt = null
    var b: *AlBlock = a.blocks
    while b != null
        var body: *Stmt = b.head
        if b.closed == 0
            body = al_append(body, al_poll_pending_stmt(span))   # unreachable
        let cond: *Expr = al_binary(OP_EQ, al_self_field(StrView { ptr: (c"__state"), len: (7) as i64 }, span), al_int(b.idx as i64, span))
        arms = al_append(arms, al_if(cond, body, span))
        b = b.next
    # It never ends (no `break`), so nothing follows it: ritz1 knows a `while
    # true` diverges, and would refuse anything after it as unreachable.
    let w: *Stmt = al_stmt(STMT_WHILE, span)
    w.while_cond = al_true(span)
    w.while_body = arms
    w

# ---------------------------------------------------------------------------
# The future, its constructor and its poll
# ---------------------------------------------------------------------------

fn al_field_of(l: *AlLocal) -> *StructField
    let f: *StructField = al_zalloc(sizeof(StructField)) as *StructField
    f.name = l.name
    f.name_len = l.len
    f.field_type = l.ty
    f.ptr_pointee = TYPE_VOID
    f.inner_pointee_type = l.inner_pointee
    f.field_inner_ref = l.inner_ref
    # As field_new: a struct, or a pointer to one, is named; a primitive
    # pointee is recorded in array_elem_type (#1304), which `p + i` strides by.
    if l.ty == TYPE_STRUCT
        f.field_type_name = l.type_name
        f.field_type_name_len = l.type_name_len
    else if l.ty == TYPE_PTR
        f.ptr_pointee = l.pointee
        if l.pointee == TYPE_STRUCT
            f.field_type_name = l.type_name
            f.field_type_name_len = l.type_name_len
        else
            f.array_elem_type = l.pointee
    else if l.ty == TYPE_PTR_PTR and l.type_name_len > 0
        f.field_type_name = l.type_name
        f.field_type_name_len = l.type_name_len
    f

# The signature every generated future's header poll fn has: `fn(*u8) -> bool`.
fn al_poll_sig(orig: *FnDef) -> *FnDef
    let p: *Param = al_zalloc(sizeof(Param)) as *Param
    p.name = c"f"
    p.name_len = 1
    p.param_type = TYPE_PTR
    p.param_pointee_type = TYPE_U8
    al_fn(orig, StrView { ptr: (null), len: (0) as i64 }, p, TYPE_BOOL, StrView { ptr: (null), len: (0) as i64 }, null)

# `struct <f>$Future { __poll, __state, __result, params in order, the other
# locals by name }` -- R79's header first, poll fn pointer, then R78's state
# and result.
fn al_future_struct(a: *AlFn, name_sv: StrView) -> *StructDef
    var name: *u8 = name_sv.ptr
    var len: i32 = name_sv.len as i32
    let poll: *StructField = al_zalloc(sizeof(StructField)) as *StructField
    poll.name = c"__poll"
    poll.name_len = 6
    poll.field_type = TYPE_PTR
    poll.ptr_pointee = TYPE_VOID
    poll.fn_sig = al_poll_sig(a.f)
    let head: *StructField = poll
    var last: *StructField = head
    var state: AlLocal
    state.name = c"__state"
    state.len = 7
    al_set_scalar(@state, TYPE_I32)
    last.next = al_field_of(@state)
    last = last.next
    var res: AlLocal
    res.name = c"__result"
    res.len = 8
    if al_set_ret(@res, a.f) == 1
        # Where the poll leaves its value (LARB R78).
        last.next = al_field_of(@res)
        last = last.next
    var l: *AlLocal = a.locals
    while l != null
        if l.is_param == 1
            last.next = al_field_of(l)
            last = last.next
        l = l.next
    if a.npoints > 0
        var placed: *AlLocal = null   # the last one placed, in name order
        var more: i32 = 1
        while more == 1
            # The least name above `placed`: a selection sort, with no list
            # surgery on a.locals.
            var best: *AlLocal = null
            var c: *AlLocal = a.locals
            while c != null
                if c.is_param == 0 and c.poll_ok != 1 and (placed == null or al_less(StrView { ptr: (placed.name), len: (placed.len) as i64 }, StrView { ptr: (c.name), len: (c.len) as i64 }) == 1)
                    if best == null or al_less(StrView { ptr: (c.name), len: (c.len) as i64 }, StrView { ptr: (best.name), len: (best.len) as i64 }) == 1
                        best = c
                c = c.next
            if best == null
                more = 0
            else
                last.next = al_field_of(best)
                last = last.next
                placed = best
    # Then the state machine's own: await results and awaited futures.
    var x: *AlLocal = a.extra
    while x != null
        last.next = al_field_of(x)
        last = last.next
        x = x.next
    let s: *StructDef = al_zalloc(sizeof(StructDef)) as *StructDef
    s.name = name
    s.name_len = len
    s.fields = head
    s

# `fn <ctor>(params) -> <f>$Future`: `<f>$Future { __poll: <poll>, __state:
# 0, p: p, .. }`; a local's field is left out, so zero, as ritz0 sets it.
fn al_constructor(a: *AlFn, name_sv: StrView, fut_sv: StrView, poll_sv: StrView) -> *FnDef
    var name: *u8 = name_sv.ptr
    var len: i32 = name_sv.len as i32
    var fut: *u8 = fut_sv.ptr
    var fut_len: i32 = fut_sv.len as i32
    var poll: *u8 = poll_sv.ptr
    var poll_len: i32 = poll_sv.len as i32
    let f: *FnDef = a.f
    let span: SrcSpan = SrcSpan { line: f.line, col: f.col }
    let head: *FieldInit = al_zalloc(sizeof(FieldInit)) as *FieldInit
    head.name = c"__poll"
    head.name_len = 6
    head.value = al_ident(StrView { ptr: (poll), len: (poll_len) as i64 }, span)
    let state: *FieldInit = al_zalloc(sizeof(FieldInit)) as *FieldInit
    state.name = c"__state"
    state.name_len = 7
    state.value = al_int(0, span)
    head.next = state
    var last: *FieldInit = state
    var p: *Param = f.params
    while p != null
        let fi: *FieldInit = al_zalloc(sizeof(FieldInit)) as *FieldInit
        fi.name = p.name
        fi.name_len = p.name_len
        fi.value = al_ident(StrView { ptr: (p.name), len: (p.name_len) as i64 }, span)
        last.next = fi
        last = fi
        p = p.next
    let lit: *Expr = al_expr(EXPR_STRUCT_LIT, span)
    lit.ident_ptr = fut
    lit.ident_len = fut_len
    lit.args = head as *Expr
    al_fn(f, StrView { ptr: (name), len: (len) as i64 }, f.params, TYPE_STRUCT, StrView { ptr: (fut), len: (fut_len) as i64 }, al_expr_stmt(lit))

# The body with an await, as states; state 0 is its entry.
fn al_lower_body(a: *AlFn, span: SrcSpan)
    a.cur = al_new_block(a)
    var d: AlDest = al_dest(AL_TO_RETURN, span)
    al_lower_list(a, a.f.body, @d, null)
    if a.cur != null
        al_ret(a, null, span)   # off the end: a unit fn's Ready

# `fn <f>$poll(self: *<f>$Future) -> bool`
fn al_poll(a: *AlFn, name_sv: StrView, fut_sv: StrView) -> *FnDef
    var name: *u8 = name_sv.ptr
    var len: i32 = name_sv.len as i32
    var fut: *u8 = fut_sv.ptr
    var fut_len: i32 = fut_sv.len as i32
    let f: *FnDef = a.f
    let span: SrcSpan = SrcSpan { line: f.line, col: f.col }
    var body: *Stmt = null
    if a.npoints == 0
        # The whole body is the poll, its params read through `self`.  It
        # always finishes in this call, so mark it done before it runs (R79):
        # a later poll answers true at once, without running the body again.
        body = al_ready_tail(a, al_rw_stmts(a, f.body), span)
        let fin: *Stmt = al_assign_self(StrView { ptr: (c"__state"), len: (7) as i64 }, al_pending(span), span)
        fin.next = body
        body = fin
    else
        al_lower_body(a, span)
        body = al_dispatch(a, span)
    # R79's finished guard, first of all: a poll of a finished future is true
    # at once and runs nothing.
    let guard: *Stmt = al_if(al_poll_is_pending(al_self_field(StrView { ptr: (c"__state"), len: (7) as i64 }, span)), al_return(al_true(span), span), span)
    guard.next = body
    body = guard
    let self_p: *Param = al_zalloc(sizeof(Param)) as *Param
    self_p.name = c"self"
    self_p.name_len = 4
    self_p.param_type = TYPE_PTR
    self_p.param_type_name = fut
    self_p.param_type_name_len = fut_len
    self_p.param_pointee_type = TYPE_STRUCT
    self_p.name_span = span
    let poll: *FnDef = al_fn(f, StrView { ptr: (name), len: (len) as i64 }, self_p, TYPE_BOOL, StrView { ptr: (null), len: (0) as i64 }, body)
    # A private async fn is refused once, at the call of its constructor:
    # cc_private skips a fn with no file.  (Not from_generated, which would
    # make a pub poll weak_odr.)  A local poll's file is the input's anyway.
    poll.def_file = null
    poll

# Analyse async fn `f`; 0, or the errors it reported.
fn al_analyse(a: *AlFn) -> i32
    let f: *FnDef = a.f
    var res: AlLocal
    if f.return_type != TYPE_VOID and al_set_ret(@res, f) == 0
        diag_error_name(a.file, diag_span(f.line, f.col), c"ritz1 can't yet hold `", StrView { ptr: (f.name), len: (f.name_len) as i64 }, c"`'s result type in a future: an array, reference or fn type")
        return 1
    var p: *Param = f.params
    while p != null
        al_local_of_param(a, p)
        p = p.next
    al_an_stmts(a, f.body, 1)
    if a.npoints > 0
        # Which locals may stay poll locals rather than future fields.
        al_mark_walk_stmts(a, f.body, 0)
    if a.npoints == 0
        # Only the params are fields.
        var errs: i32 = 0
        var l: *AlLocal = a.locals
        while l != null
            if l.is_param == 1 and l.unsupported == 1
                diag_error_name(a.file, l.span, c"ritz1 can't yet hold `", StrView { ptr: (l.name), len: (l.len) as i64 }, c"`'s type in a future: an array, reference or fn type")
                errs += 1
            l = l.next
        return errs
    # With an await every local is a field of the future, which needs its
    # type (#3762).
    if a.untyped != null
        let s: *Stmt = a.untyped
        var m: String = string_new()
        m.push_str("cannot infer the type of `")
        m.push_span(Span<u8> { ptr: (s.var_name), len: (s.var_name_len as i64) as i64 })
        m.push_str("`, which `")
        m.push_span(Span<u8> { ptr: (f.name), len: (f.name_len as i64) as i64 })
        m.push_str("`'s future holds across an `await`: give `")
        m.push_span(Span<u8> { ptr: (s.var_name), len: (s.var_name_len as i64) as i64 })
        m.push_str("` a type (`let ")
        m.push_span(Span<u8> { ptr: (s.var_name), len: (s.var_name_len as i64) as i64 })
        m.push_str(": T = ...`)")
        diag_error_buf(a.file, s.span, @m)
        return 1
    var errs: i32 = 0
    var l: *AlLocal = a.locals
    while l != null
        if l.unsupported == 1
            diag_error_name(a.file, l.span, c"ritz1 can't yet hold `", StrView { ptr: (l.name), len: (l.len) as i64 }, c"`'s type in a future: an array, reference or fn type")
            errs += 1
        l = l.next
    errs

# Lower async fn `f`: its future struct joins m's structs, and its
# constructor and poll (and for `main`, the sync wrapper) take its place in
# the fn list, after `prev` (null: at the head).  0, or the errors reported.
fn al_lower_fn(m: *Module, prev: *FnDef, f: *FnDef) -> i32
    var a: AlFn
    al_fn_init(@a, f, 0)
    if f.type_params != null
        diag_error_name(a.file, diag_span(f.line, f.col), c"async fn '", StrView { ptr: (f.name), len: (f.name_len) as i64 }, c"' is generic, which ritz1 can't lower to a state machine")
        return 1
    let errs: i32 = al_analyse(@a)
    if errs > 0
        return errs
    var fl: i32 = 0
    let fut: *u8 = al_future_struct_name(f.name, f.name_len, @fl)
    var pl: i32 = 0
    let poll_name: *u8 = al_poll_fn_name(f.name, f.name_len, @pl)
    # The poll first: its state machine adds fields to the future.
    let poll: *FnDef = al_poll(@a, StrView { ptr: (poll_name), len: (pl) as i64 }, StrView { ptr: (fut), len: (fl) as i64 })
    if a.errs > 0
        return a.errs
    let st: *StructDef = al_future_struct(@a, StrView { ptr: (fut), len: (fl) as i64 })
    var sl: *StructDef = m.structs
    if sl == null
        m.structs = st
    else
        while sl.next != null
            sl = sl.next
        sl.next = st
    let is_main: i32 = al_eq(StrView { ptr: (f.name), len: (f.name_len) as i64 }, StrView { ptr: (c"main"), len: (4) as i64 })
    var ctor: *FnDef = null
    if is_main == 1
        ctor = al_constructor(@a, StrView { ptr: (c"__main_future"), len: (13) as i64 }, StrView { ptr: (fut), len: (fl) as i64 }, StrView { ptr: (poll_name), len: (pl) as i64 })
    else
        ctor = al_constructor(@a, StrView { ptr: (f.name), len: (f.name_len) as i64 }, StrView { ptr: (fut), len: (fl) as i64 }, StrView { ptr: (poll_name), len: (pl) as i64 })
    ctor.next = poll
    poll.next = f.next
    if is_main == 1
        let span: SrcSpan = SrcSpan { line: f.line, col: f.col }
        var tail: i32 = AL_DRIVE_RESULT
        if f.return_type == TYPE_VOID
            tail = AL_DRIVE_ZERO
        let body: *Stmt = al_drive_body(StrView { ptr: (c"__main_future"), len: (13) as i64 }, null, StrView { ptr: (fut), len: (fl) as i64 }, StrView { ptr: (poll_name), len: (pl) as i64 }, tail, span)
        let wrapper: *FnDef = al_fn(f, StrView { ptr: (c"main"), len: (4) as i64 }, null, TYPE_I32, StrView { ptr: (null), len: (0) as i64 }, body)
        wrapper.is_pub = 1
        poll.next = wrapper
        wrapper.next = f.next
    if prev == null
        m.functions = ctor
    else
        prev.next = ctor
    0

# ---------------------------------------------------------------------------
# LANGUAGE_SPEC §16.2: a bare call to an async fn
# ---------------------------------------------------------------------------

fn al_prim_name(t: i32) -> *u8
    if t == TYPE_I8
        return c"i8"
    if t == TYPE_I16
        return c"i16"
    if t == TYPE_I32
        return c"i32"
    if t == TYPE_I64
        return c"i64"
    if t == TYPE_U8
        return c"u8"
    if t == TYPE_U16
        return c"u16"
    if t == TYPE_U32
        return c"u32"
    if t == TYPE_U64
        return c"u64"
    if t == TYPE_BOOL
        return c"bool"
    if t == TYPE_F32
        return c"f32"
    if t == TYPE_F64
        return c"f64"
    null

# A let's written type, as ritz0 formats it in the message.
fn al_push_type(m: @&String, s: *Stmt)
    let t: i32 = s.var_declared_type
    if t == TYPE_STRUCT
        m.push_span(Span<u8> { ptr: (s.var_type_name), len: (s.var_type_name_len as i64) as i64 })
        return
    if t == TYPE_PTR
        m.push_str("*")
        if s.var_pointee_type == TYPE_STRUCT
            m.push_span(Span<u8> { ptr: (s.var_type_name), len: (s.var_type_name_len as i64) as i64 })
            return
        let pn: *u8 = al_prim_name(s.var_pointee_type)
        if pn != null
            m.push_span(Span<u8> { ptr: (pn), len: (al_clen(pn) as i64) as i64 })
        return
    let n: *u8 = al_prim_name(t)
    if n != null
        m.push_span(Span<u8> { ptr: (n), len: (al_clen(n) as i64) as i64 })

fn al_bare_call_error(file: *u8, call: *Expr) -> i32
    var m: String = string_new()
    m.push_str("calling async fn `")
    m.push_span(Span<u8> { ptr: (call.func_name), len: (call.func_name_len as i64) as i64 })
    m.push_str("` without `await` builds its future and drops it; its body never runs: write `await ")
    m.push_span(Span<u8> { ptr: (call.func_name), len: (call.func_name_len as i64) as i64 })
    m.push_str("(...)`")
    diag_error_buf(file, call.span, @m)
    1

fn al_typed_let_error(file: *u8, s: *Stmt, call: *Expr) -> i32
    var m: String = string_new()
    m.push_str("`")
    m.push_span(Span<u8> { ptr: (s.var_name), len: (s.var_name_len as i64) as i64 })
    m.push_str("` is declared `")
    al_push_type(@&m, s)
    m.push_str("` but `")
    m.push_span(Span<u8> { ptr: (call.func_name), len: (call.func_name_len as i64) as i64 })
    m.push_str("(...)` is an async fn call, which without `await` is its future: write `await ")
    m.push_span(Span<u8> { ptr: (call.func_name), len: (call.func_name_len as i64) as i64 })
    m.push_str("(...)`")
    diag_error_buf(file, s.span, @m)
    1

# The bare async calls of a statement list.  `value` is 1 when the list's
# last statement is the value of its fn (a `-> T` fn's tail, or an arm of one).
fn al_bare_stmts(file: *u8, s: *Stmt, value: i32) -> i32
    var errs: i32 = 0
    var cur: *Stmt = s
    while cur != null
        let tail: i32 = (value == 1 and cur.next == null) as i32
        let k: i32 = cur.kind
        if k == STMT_EXPR
            if tail == 0 and al_call_of_async(cur.expr) != null
                errs += al_bare_call_error(file, cur.expr)
            else if cur.expr != null and (cur.expr.kind == EXPR_IF or cur.expr.kind == EXPR_MATCH)
                errs += al_bare_arms(file, cur.expr.args as *MatchArm, tail)
        else if k == STMT_VAR_DECL
            let g: *AlAsync = al_call_of_async(cur.var_init)
            if g != null and cur.var_declared_type != TYPE_VOID
                var fl: i32 = 0
                let fut: *u8 = al_future_struct_name(g.name, g.len, @fl)
                # R79: a by-value `Future` is Sema's refusal, at the name.
                let byval_future: i32 = (cur.var_declared_type == TYPE_STRUCT and al_eq(StrView { ptr: (cur.var_type_name), len: (cur.var_type_name_len) as i64 }, StrView { ptr: (c"Future"), len: (6) as i64 }) == 1) as i32
                if byval_future == 0
                    if cur.var_declared_type != TYPE_STRUCT or al_eq(StrView { ptr: (cur.var_type_name), len: (cur.var_type_name_len) as i64 }, StrView { ptr: (fut), len: (fl) as i64 }) == 0
                        errs += al_typed_let_error(file, cur, cur.var_init)
        else if k == STMT_IF
            errs += al_bare_stmts(file, cur.if_then, tail)
            errs += al_bare_stmts(file, cur.if_else, tail)
        else if k == STMT_MATCH
            errs += al_bare_arms(file, cur.if_then as *MatchArm, tail)
        else if k == STMT_WHILE or k == STMT_LOOP or k == STMT_DEFER or k == STMT_UNSAFE
            errs += al_bare_stmts(file, cur.while_body, 0)
        else if k == STMT_FOR
            errs += al_bare_stmts(file, cur.for_body, 0)
        cur = cur.next
    errs

fn al_bare_arms(file: *u8, arm: *MatchArm, value: i32) -> i32
    var errs: i32 = 0
    var cur: *MatchArm = arm
    while cur != null
        errs += al_bare_stmts(file, cur.body_stmts, (value == 1 and cur.body == null) as i32)
        cur = cur.next
    errs

fn al_bare_fn(f: *FnDef) -> i32
    if f.is_local != 1 or f.body == null
        return 0
    al_bare_stmts(g_al_path, f.body, (f.return_type != TYPE_VOID) as i32)

# Awaits in a sync fn: polled to completion in place.
fn al_sync_fn(f: *FnDef)
    if f.body == null
        return
    var a: AlFn
    al_fn_init(@a, f, 1)
    # Its locals, so `await p` (p a held future, R79) knows p's future type.
    al_an_stmts(@a, f.body, 1)
    f.body = al_rw_stmts(@a, f.body)

# R79: the built-in `Future`, "some async fn's future", which only a
# reference can hold.  It is the futures' one header field, the poll fn
# pointer, so any `NAME$Future` fits an `@&Future` slot (Sema); and
# `future_poll(f: @&Future)` calls that header fn on the future f names.
#
# Only a module that names `Future` or calls `future_poll` gets them: the
# AST is otherwise exactly the source's, which the Sema probes compare.
fn al_future_name(name: *u8, len: i32) -> i32
    if name == null or len != 6
        return 0
    al_eq(StrView { ptr: (name), len: (6) as i64 }, StrView { ptr: (c"Future"), len: (6) as i64 })

# 1 when `e` or anything under it calls `future_poll`.
fn al_future_call(e: *Expr) -> i32
    if e == null
        return 0
    let k: i32 = e.kind
    if k == EXPR_CALL
        if e.func_name != null and e.func_name_len == 11
            if al_eq(StrView { ptr: (e.func_name), len: (11) as i64 }, StrView { ptr: (c"future_poll"), len: (11) as i64 }) == 1
                return 1
    var r: i32 = 0
    if k == EXPR_BINARY or k == EXPR_RANGE or k == EXPR_INDEX
        r = al_future_call(e.left)
        if r == 0
            r = al_future_call(e.right)
    else if k == EXPR_UNARY
        r = al_future_call(e.operand)
    else if k == EXPR_CALL or k == EXPR_METHOD
        if k == EXPR_METHOD or e.func_name == null
            r = al_future_call(e.left)
        var arg: *Expr = e.args
        while arg != null and r == 0
            r = al_future_call(arg)
            arg = arg.next
    else if k == EXPR_MEMBER or k == EXPR_CAST or k == EXPR_TRY or k == EXPR_ARRAY_FILL
        r = al_future_call(e.left)
    else if k == EXPR_IF or k == EXPR_MATCH
        r = al_future_call(e.left)
        var arm: *MatchArm = e.args as *MatchArm
        while arm != null and r == 0
            r = al_future_call(arm.body)
            arm = arm.next
    else if k == EXPR_STRUCT_LIT
        var fi: *FieldInit = e.args as *FieldInit
        while fi != null and r == 0
            r = al_future_call(fi.value)
            fi = fi.next
    else if k == EXPR_ARRAY_LIT
        var el: *Expr = e.args
        while el != null and r == 0
            r = al_future_call(el)
            el = el.next
    r

fn al_future_stmts(s: *Stmt) -> i32
    var cur: *Stmt = s
    while cur != null
        if al_future_stmt(cur) == 1
            return 1
        cur = cur.next
    0

# A statement's written `Future` slots and `future_poll` calls, its own and
# its children's.
fn al_future_stmt(s: *Stmt) -> i32
    let k: i32 = s.kind
    if k == STMT_VAR_DECL
        if al_future_name(s.var_type_name, s.var_type_name_len) == 1
            return 1
        if s.var_array != null and al_future_name(s.var_array.name, s.var_array.name_len) == 1
            return 1
        return al_future_call(s.var_init)
    if k == STMT_EXPR
        return al_future_call(s.expr)
    if k == STMT_RETURN
        return al_future_call(s.return_value)
    if k == STMT_IF
        if al_future_call(s.if_cond) == 1 or al_future_stmts(s.if_then) == 1
            return 1
        return al_future_stmts(s.if_else)
    if k == STMT_WHILE
        if al_future_call(s.while_cond) == 1
            return 1
        return al_future_stmts(s.while_body)
    if k == STMT_FOR
        if al_future_call(s.for_start) == 1 or al_future_call(s.for_end) == 1
            return 1
        return al_future_stmts(s.for_body)
    if k == STMT_LOOP or k == STMT_DEFER or k == STMT_UNSAFE
        return al_future_stmts(s.while_body)
    if k == STMT_MATCH
        if al_future_call(s.if_cond) == 1
            return 1
        var arm: *MatchArm = s.if_then as *MatchArm
        while arm != null
            if al_future_call(arm.body) == 1 or al_future_stmts(arm.body_stmts) == 1
                return 1
            arm = arm.next
        return 0
    if k == STMT_ASSIGN or k == STMT_MEMBER_ASSIGN or k == STMT_MEMBER_INDEX_ASSIGN or k == STMT_INDEX_ASSIGN or k == STMT_LOCAL_FIELD_ASSIGN or k == STMT_LOCAL_FIELD_INDEX_ASSIGN
        if k != STMT_INDEX_ASSIGN and k != STMT_LOCAL_FIELD_ASSIGN and k != STMT_LOCAL_FIELD_INDEX_ASSIGN
            if al_future_call(s.if_cond) == 1
                return 1
        if k != STMT_ASSIGN and k != STMT_MEMBER_ASSIGN and k != STMT_LOCAL_FIELD_ASSIGN
            if al_future_call(s.while_cond) == 1
                return 1
        return al_future_call(s.assign_value)
    if k == STMT_ASSERT
        return al_future_call(s.if_cond)
    0

fn al_future_fn(f: *FnDef) -> i32
    if al_future_name(f.return_type_name, f.return_type_name_len) == 1
        return 1
    if f.ret_array_param != null and al_future_name(f.ret_array_param.param_type_name, f.ret_array_param.param_type_name_len) == 1
        return 1
    var p: *Param = f.params
    while p != null
        if al_future_name(p.param_type_name, p.param_type_name_len) == 1
            return 1
        p = p.next
    al_future_stmts(f.body)

fn al_future_used(m: *Module) -> i32
    var st: *StructDef = m.structs
    while st != null
        var fld: *StructField = st.fields
        while fld != null
            if al_future_name(fld.field_type_name, fld.field_type_name_len) == 1 or al_future_name(fld.array_elem_type_name, fld.array_elem_type_name_len) == 1
                return 1
            fld = fld.next
        st = st.next
    var g: *GlobalVarDef = m.globals
    while g != null
        if al_future_name(g.type_name, g.type_name_len) == 1 or al_future_name(g.array_elem_type_name, g.array_elem_type_name_len) == 1
            return 1
        g = g.next
    var f: *FnDef = m.functions
    while f != null
        if al_future_fn(f) == 1
            return 1
        f = f.next
    var ib: *ImplBlock = m.impls
    while ib != null
        var method: *FnDef = ib.methods
        while method != null
            if al_future_fn(method) == 1
                return 1
            method = method.next
        ib = ib.next
    0

fn al_inject_future(m: *Module)
    if al_future_used(m) == 0
        return
    var s: *StructDef = m.structs
    while s != null
        if al_eq(StrView { ptr: (s.name), len: (s.name_len) as i64 }, StrView { ptr: (c"Future"), len: (6) as i64 }) == 1
            return
        s = s.next
    let span: SrcSpan = SrcSpan { line: 1, col: 1 }
    var orig: FnDef
    orig.line = 1
    orig.col = 1
    orig.is_local = 1
    orig.is_pub = 0
    orig.def_file = null
    orig.target_gated = 0
    let st: *StructDef = al_zalloc(sizeof(StructDef)) as *StructDef
    st.name = c"Future"
    st.name_len = 6
    st.fields = al_zalloc(sizeof(StructField)) as *StructField
    st.fields.name = c"__poll"
    st.fields.name_len = 6
    st.fields.field_type = TYPE_PTR
    st.fields.ptr_pointee = TYPE_VOID
    st.fields.fn_sig = al_poll_sig(@orig)
    if m.structs == null
        m.structs = st
    else
        var last: *StructDef = m.structs
        while last.next != null
            last = last.next
        last.next = st
    # `fn future_poll(f: @&Future) -> bool`: `(f.__poll)(f)`; the header's fn
    # takes `*u8`, so the future's pointer is what is passed.
    let p: *Param = al_zalloc(sizeof(Param)) as *Param
    p.name = c"f"
    p.name_len = 1
    p.param_type = TYPE_PTR
    p.param_pointee_type = TYPE_STRUCT
    p.param_type_name = c"Future"
    p.param_type_name_len = 6
    p.param_inner_ref = INNER_REF_MUT
    let mem: *Expr = al_expr(EXPR_MEMBER, span)
    mem.left = al_ident(StrView { ptr: (c"f"), len: (1) as i64 }, span)
    mem.ident_ptr = c"__poll"
    mem.ident_len = 6
    mem.bracket = span
    let call: *Expr = al_expr(EXPR_CALL, span)
    call.left = mem
    call.args = al_ident(StrView { ptr: (c"f"), len: (1) as i64 }, span)
    let f: *FnDef = al_fn(@orig, StrView { ptr: (c"future_poll"), len: (11) as i64 }, p, TYPE_BOOL, StrView { ptr: (null), len: (0) as i64 }, al_return(call, span))
    f.is_pub = 1
    # Every unit injects its own copy (#4007).  A generated pub fn is
    # `weak_odr` with a comdat (AGAST #3386, #201), so the linker keeps one,
    # as for a generated `E.from` two files both declare.  Without it each
    # object's copy is a duplicate definition of `future_poll`.
    f.from_generated = 1
    module_append_fn(m, f)

# ---------------------------------------------------------------------------
# The pass
# ---------------------------------------------------------------------------

# Lower every async fn of `m` and every await, after refusing each bare call
# to an async fn.  `path` is the input file.  Returns the errors it reported;
# main stops on any.
pub fn async_lower_module(m: *Module, path: *u8) -> i32
    g_al_module = m
    g_al_path = path
    g_al_async = null
    al_inject_future(m)
    var f: *FnDef = m.functions
    while f != null
        if f.is_async == 1
            let entry: *AlAsync = al_zalloc(sizeof(AlAsync)) as *AlAsync
            entry.name = f.name
            entry.len = f.name_len
            entry.params = f.params
            entry.f = f
            entry.next = g_al_async
            g_al_async = entry
        f = f.next
    var errs: i32 = 0
    if g_al_async != null
        f = m.functions
        while f != null
            errs += al_bare_fn(f)
            f = f.next
        var ib: *ImplBlock = m.impls
        while ib != null
            var method: *FnDef = ib.methods
            while method != null
                errs += al_bare_fn(method)
                method = method.next
            ib = ib.next
    if errs > 0
        return errs
    # Each async fn becomes its future, constructor and poll.
    var prev: *FnDef = null
    f = m.functions
    while f != null
        let nxt: *FnDef = f.next
        if f.is_async == 1
            errs += al_lower_fn(m, prev, f)
            # The last fn the lowering put in f's place.
            if prev == null
                prev = m.functions
            else
                prev = prev.next
            while prev.next != nxt
                prev = prev.next
        else
            prev = f
        f = nxt
    if errs > 0
        return errs
    # Every other await: in a sync fn (or a method), polled to completion.
    # A helper this adds is appended, and has no await of its own.
    f = m.functions
    while f != null
        al_sync_fn(f)
        f = f.next
    var ib: *ImplBlock = m.impls
    while ib != null
        var method: *FnDef = ib.methods
        while method != null
            al_sync_fn(method)
            method = method.next
        ib = ib.next
    0
