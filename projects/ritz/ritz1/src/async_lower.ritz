# async_lower.ritz - `async fn` / `await` lowered to ritz0's state machine (AGAST #3814)
#
# An AST-to-AST pass main runs once, after imports merge and before any check,
# so everything downstream sees plain fns and structs.  It builds the items
# ritz0 builds (ritz0/async_transform_v2.py generate_state_machine,
# emitter_llvmlite.py _transform_async_functions / _emit_await), with the same
# names and layout, so an executor written against one compiler's futures
# polls the other's:
#
#     async fn f(x: i32) -> T               struct f$Future
#         let a: i32 = await g(x)               __state: i32
#         a + 1                                 __result: T     # none for a unit fn
#                                               x: i32          # params, in order
#                                               a: i32          # locals, by name
#                                           fn f(x: i32) -> f$Future
#                                               f$Future { __state: 0, x: x }
#                                           fn f$poll(self: *f$Future) -> bool
#                                               while true
#                                                   if self.__state == 0
#                                                       self.__future_0 = g(self.x)
#                                                       self.__state = 1
#                                                       continue
#                                                   if self.__state == 1
#                                                       if !g$poll(@self.__future_0)
#                                                           return false  # Pending
#                                                       self.a = self.__future_0.__result
#                                                       self.__result = self.a + 1
#                                                       return true       # Ready
#
#   * With no await the whole body is the poll, its params read through
#     `self`: Ready at once.  With one, every local lives in the future and
#     the body is a graph of states (AGAST #3727): the poll is a dispatch loop
#     over them, each await a resume point that returns Pending and is
#     resumed there by the next poll, wherever it is (a loop, an arm).  The
#     awaited future lives in the future, so it is polled again, not rebuilt.
#     ritz0's _CfgBuilder step for step, so the fields come in its order:
#     __state, params, locals by name, then each await's result / future.
#   * The poll answers bool (LARB R78, AGAST #3728): true once the body has
#     finished, its value stored in the future's `__result`, of the fn's
#     declared type (a unit fn's future has none).  `await` polls until true,
#     then reads the field.  An awaited expression that is not an async fn's
#     call is a hand-written poll source: an `Option<T>`, `None` while
#     Pending and `Some(v)` once Ready, so any T is a result (AGAST #4558).
#     T is the declared return type's, of the fn or method it calls (#4604).
#   * `async fn main` is `__main_future` + `main$poll`, and a sync `main`
#     polls it to completion.
#   * `await g(..)` anywhere else (a sync fn) polls g's future until Ready,
#     through a private `__await_g` this file defines; a poll source can't be
#     awaited there, since nothing can suspend (AGAST #4558).
#   * A bare call to an async fn, as a statement or into a typed let, only
#     builds its future: refused (LANGUAGE_SPEC §16.2, #1395), in ritz0's words.
#
# As in ritz0, an impl's async method is a plain method.  Generated nodes are
# zero-filled, so every optional AST field reads as "none"; type facts are
# copied from the param or let they come from.

import ritzlib.sys
import ritzlib.io
import ritzlib.memory
import ritzlib.string
import ritzlib.cstr
import ritzlib.strview

import ast
import diag
import async_ast       # its node builders and names (al_expr, al_decl, al_fn)

# ---------------------------------------------------------------------------
# The module's async fns
# ---------------------------------------------------------------------------

struct AlAsync
    name: StrView
    params: *Param
    f: *FnDef           # its declaration: the result type an await reads
    helper: *FnDef      # its `__await_<name>`, once a sync fn awaits it
    held: *FnDef        # its `__await_held_<name>`, once one awaits a held future
    next: *AlAsync

var g_al_async: *AlAsync = null
var g_al_module: *Module = null
var g_al_path: StrView

fn al_find_async(name_sv: StrView) -> *AlAsync
    var name: *u8 = name_sv.ptr
    var len: i32 = name_sv.len as i32
    if name == null
        return null
    var a: *AlAsync = g_al_async
    while a != null
        if al_eq(a.name, name_sv) == 1
            return a
        a = a.next
    null

fn al_call_of_async(e: *Expr) -> *AlAsync
    if e == null or e.kind != ExprKind.Call or e.call_type_suffix.len != 0
        return null
    al_find_async(e.func_name)

# 1 when `s` starts with `prefix`.
fn al_starts_with(s: StrView, prefix: StrView) -> i32
    if s.len < prefix.len
        return 0
    var i: i64 = 0
    while i < prefix.len
        if *(s.ptr + i) != *(prefix.ptr + i)
            return 0
        i += 1
    1

# 1 when `s` ends with `suffix`.
fn al_ends_with(s: StrView, suffix: StrView) -> i32
    if suffix.len == 0 or s.len < suffix.len
        return 0
    var i: i64 = 0
    while i < suffix.len
        if *(s.ptr + s.len - suffix.len + i) != *(suffix.ptr + i)
            return 0
        i += 1
    1

fn al_find_fn(name_sv: StrView) -> *FnDef
    var f: *FnDef = g_al_module.functions
    while f != null
        if al_eq(f.name, name_sv) == 1
            return f
        f = f.next
    null

# The file a fn's diagnostics name.
fn al_file(f: *FnDef) -> StrView
    if f.is_local == 0 and f.def_file.len > 0
        return f.def_file
    g_al_path

# ---------------------------------------------------------------------------
# Analysis: the await points and the locals of one async fn
# ---------------------------------------------------------------------------

# A field of the future: a param, or a local of the async fn.
struct AlLocal
    name: StrView
    ty: TypeKind
    type_name: StrView
    pointee: TypeKind
    inner_pointee: i32
    inner_ref: i32
    is_param: i32
    # -1 until a declaration is met, then 1 when every declaration of this
    # name is in a re-entered block and dies before a state boundary, 0 when
    # it must be a field (AGAST #4527); zalloc's 0 is the safe default.
    poll_ok: i32
    unsupported: i32    # a type the future can't hold yet (array, reference, fn)
    span: SrcSpan
    next: *AlLocal

# An await (or a short-circuit `&&` / `||`) a state drove, and the field its
# value is stored in.
struct AlPoint
    await_expr: *Expr
    result: StrView
    next: *AlPoint

struct AlBlock
    idx: i32
    head: *Stmt
    closed: i32         # 1: ends in a jump or a return
    next: *AlBlock

# A name read through another field: an awaiting `for`'s var (#4188).  A
# null field hides the name: a lowered `match` arm's binding (#4189).
struct AlRename
    name: StrView
    field: StrView
    next: *AlRename

struct AlLoop
    head: *AlBlock      # tests the condition: `continue` goes here
    exit: *AlBlock      # after the loop: `break` goes here
    defers: *AlDefer    # the defers active where the body begins (AGAST #4191)

# A `defer` registered in a block of the fn being lowered: its (rewritten)
# body, and the next one outward, innermost first.  Every exit edge of the
# block runs it, which the emitter's own defer scope can't see across states
# (AGAST #4191).
struct AlDefer
    body: *Stmt
    next: *AlDefer

# Where a value goes.
const AL_TO_NONE: i32 = 0      # discarded
const AL_TO_RETURN: i32 = 1    # the poll's Ready
const AL_TO_FIELD: i32 = 2     # self.<name>
const AL_TO_ASSIGN: i32 = 3    # the assignment `stmt`, with this value
const AL_TO_RESULT: i32 = 4    # self.__result, a Ready's value without finishing

struct AlDest
    kind: i32
    name: StrView
    stmt: *Stmt
    span: SrcSpan

struct AlFn
    f: *FnDef
    file: StrView
    locals: *AlLocal
    points: *AlPoint
    npoints: i32        # the awaits in the body
    untyped: *Stmt      # the first local whose type can't be inferred
    sync: i32           # 1: lowering awaits of a sync fn, not an async body
    # The state machine (#3727)
    blocks: *AlBlock
    last_block: *AlBlock
    nblocks: i32
    cur: *AlBlock       # the open state; null after a jump
    nawaits: i32        # awaits lowered so far
    nshorts: i32        # `&&` / `||` with an awaiting right operand, so far
    nifs: i32           # awaiting `if` operands lowered so far (#4190)
    extra: *AlLocal     # the fields it adds, in order
    renames: *AlRename  # innermost first
    nfors: i32          # awaiting `for`s lowered so far
    nmatches: i32       # `__match_K` scrutinee fields added so far
    defers: *AlDefer    # the defers registered so far, innermost first
    errs: i32

fn al_fn_init(a: *AlFn, f: *FnDef, sync: i32)
    a.f = f
    a.file = al_file(f)
    a.locals = null
    a.points = null
    a.npoints = 0
    a.untyped = null
    a.sync = sync
    a.blocks = null
    a.last_block = null
    a.nblocks = 0
    a.cur = null
    a.nawaits = 0
    a.nshorts = 0
    a.nifs = 0
    a.extra = null
    a.renames = null
    a.nfors = 0
    a.nmatches = 0
    a.defers = null
    a.errs = 0

fn al_local_find(a: *AlFn, name_sv: StrView) -> *AlLocal
    var len: i32 = name_sv.len as i32
    var l: *AlLocal = a.locals
    while l != null
        if al_eq(l.name, name_sv) == 1
            return l
        l = l.next
    null

# The local `name`, added at the end of a's list if new (ritz0's dict keeps
# the first insertion and the last type).
fn al_local(a: *AlFn, name_sv: StrView, span: SrcSpan) -> *AlLocal
    var l: *AlLocal = al_local_find(a, name_sv)
    if l != null
        return l
    l = al_zalloc(sizeof(AlLocal)) as *AlLocal
    l.name = name_sv
    l.span = span
    l.poll_ok = 0 - 1
    if a.locals == null
        a.locals = l
    else
        var cur: *AlLocal = a.locals
        while cur.next != null
            cur = cur.next
        cur.next = l
    l

fn al_set_scalar(l: *AlLocal, ty: TypeKind)
    l.ty = ty
    l.type_name = strview_empty()
    l.pointee = TypeKind.I64
    l.inner_pointee = (TypeKind.Void as i32)
    l.inner_ref = INNER_REF_NONE
    l.unsupported = 0

fn al_set_struct(l: *AlLocal, name_sv: StrView)
    al_set_scalar(l, TypeKind.Struct)
    l.type_name = name_sv

# A primitive type's kind from its name (`i64`), as a `-> *i64` return names
# its pointee; 0 for any other name (a struct's).
fn al_prim_of(name_sv: StrView) -> TypeKind
    var name: *u8 = name_sv.ptr
    if name == null
        return TypeKind.Void
    var t: TypeKind = TypeKind.I8
    let kinds: [11]TypeKind = [TypeKind.I8, TypeKind.I16, TypeKind.I32, TypeKind.I64, TypeKind.U8, TypeKind.U16, TypeKind.U32, TypeKind.U64, TypeKind.Bool, TypeKind.F32, TypeKind.F64]
    var i: i32 = 0
    while i < 11
        let n: StrView = al_prim_name(kinds[i])
        if al_eq(n, name_sv) == 1
            return kinds[i]
        i += 1
    TypeKind.Void

# `l` holds async fn f's result, of its declared type (LARB R78, AGAST #3728):
# 1; 0 for a unit fn, or a type ritz1 can't hold in a future yet (an array, a
# reference, a fn).
fn al_set_ret(l: *AlLocal, f: *FnDef) -> i32
    let t: TypeKind = f.return_type
    if t == TypeKind.Void or f.ret_fn_sig != null or f.ret_ref != null or f.ret_array != null or f.ret_ptr_array != null
        return 0
    match t
        TypeKind.Struct =>
            al_set_struct(l, f.return_type_name)
            return 1
        TypeKind.Ptr =>
            if f.return_type_name.ptr == null
                return 0
            al_set_scalar(l, TypeKind.Ptr)
            let pt: TypeKind = al_prim_of(f.return_type_name)
            if pt != TypeKind.Void
                l.pointee = pt
            else
                l.pointee = TypeKind.Struct
                l.type_name = f.return_type_name
            return 1
        _ => pass
    if t == TypeKind.PtrPtr or al_type_unsupported(t, TypeKind.Void) == 1
        return 0
    al_set_scalar(l, t)
    1

fn al_type_unsupported(ty: TypeKind, pointee: TypeKind) -> i32
    if ty == TypeKind.Array or ty == TypeKind.Ref or ty == TypeKind.MutRef
        return 1
    if (ty == TypeKind.Ptr or ty == TypeKind.PtrPtr) and pointee == TypeKind.Array
        return 1
    0

fn al_local_of_param(a: *AlFn, p: *Param)
    let l: *AlLocal = al_local(a, p.name, p.name_span)
    l.is_param = 1
    l.ty = p.param_type
    l.type_name = p.param_type_name
    l.pointee = p.param_pointee_type
    l.inner_pointee = p.param_inner_pointee_type
    l.inner_ref = p.param_inner_ref
    l.unsupported = al_type_unsupported(p.param_type, p.param_pointee_type)
    if p.fn_sig != null or p.is_borrow == 1
        l.unsupported = 1

# A scalar kind's literal-free type, as ritz0's _infer_type answers it; 0 if
# it can't tell.  Fills `l` on success.
# The async fn whose `<name>$Future` a held local `e` is (R79): `var p =
# slow()`, then `await p`.  Null for anything else.
fn al_held_async(a: *AlFn, e: *Expr) -> *AlAsync
    if e == null or e.kind != ExprKind.Ident
        return null
    let l: *AlLocal = al_local_find(a, e.ident)
    if l == null or l.ty != TypeKind.Struct or l.type_name.ptr == null
        return null
    if al_ends_with(l.type_name, "$Future") == 0
        return null
    al_find_async(l.type_name.take(l.type_name.len - 7))   # drop the `$Future`

# The struct a method receiver local `l` (`S`, `*S`) names; empty otherwise.
fn al_recv_type(l: *AlLocal) -> StrView
    if l == null or l.type_name.ptr == null
        return strview_empty()
    if l.ty == TypeKind.Struct or (l.ty == TypeKind.Ptr and l.pointee == TypeKind.Struct)
        return l.type_name
    strview_empty()

# The method `name` of an inherent or trait impl on struct `ty`; null if none.
fn al_find_method(ty_sv: StrView, name_sv: StrView) -> *FnDef
    var ib: *ImplBlock = g_al_module.impls
    while ib != null
        if ib.type_params == null and al_eq(ib.type_name, ty_sv) == 1
            var m: *FnDef = ib.methods
            while m != null
                if al_eq(m.name, name_sv) == 1
                    return m
                m = m.next
        ib = ib.next
    null

# The sync fn or method a poll source `e` calls (AGAST #4604): `src(..)` of a
# declared fn, or `r.m(..)` with r a local or param of a struct type with an
# impl declaring m.  Null when no declaration says (a fn pointer's call, a
# receiver of untold type); ritz0's poll_source_fn.
fn al_source_fn(a: *AlFn, e: *Expr) -> *FnDef
    if e == null
        return null
    if e.kind == ExprKind.Call and e.func_name.ptr != null
        if e.call_type_suffix.len != 0 or al_local_find(a, e.func_name) != null
            return null
        let f: *FnDef = al_find_fn(e.func_name)
        if f == null or f.type_params != null
            return null
        return f
    if e.kind == ExprKind.Method and e.left != null and e.left.kind == ExprKind.Ident
        let r: *AlLocal = al_local_find(a, e.left.ident)
        let ty: StrView = al_recv_type(r)
        if ty.ptr == null
            return null
        let m: *FnDef = al_find_method(ty, e.ident)
        if m == null or m.type_params != null
            return null
        return m
    null

# `l` holds poll source f's T, of its declared `-> Option<T>` (monomorphised
# `Option$T`): 1; 0 when f returns no Option, or a T ritz1 can't hold in a
# future (AGAST #4604).  ritz0's PollAbi.source_value_type.
fn al_set_source_value(l: *AlLocal, f: *FnDef) -> i32
    if f.return_type != TypeKind.Struct or f.return_type_name.ptr == null or f.return_type_name.len <= 7
        return 0
    if al_starts_with(f.return_type_name, "Option$") == 0
        return 0
    let t: StrView = StrView { ptr: (f.return_type_name.ptr + 7), len: ((f.return_type_name.len as i32) - 7) as i64 }
    let prim: TypeKind = al_prim_of(t)
    if prim != TypeKind.Void
        al_set_scalar(l, prim)
        return 1
    if al_starts_with(t, "ptr_") == 1
        let inner: StrView = StrView { ptr: (t.ptr + 4), len: (t.len - 4) }
        if al_starts_with(inner, "ptr_") == 1 or al_type_name_unheld(inner) == 1
            return 0
        al_set_scalar(l, TypeKind.Ptr)
        let pt: TypeKind = al_prim_of(inner)
        if pt != TypeKind.Void
            l.pointee = pt
        else
            l.pointee = TypeKind.Struct
            l.type_name = inner
        return 1
    if al_type_name_unheld(t) == 1
        return 0
    al_set_struct(l, t)
    1

# 1 when a mangled type argument names a type a future can't hold as a struct
# field by name: a reference (`ref_`, `refmut_`) or an array (`arr4_`).
fn al_type_name_unheld(t: StrView) -> i32
    if al_starts_with(t, "ref_") == 1 or al_starts_with(t, "refmut_") == 1
        return 1
    if t.len > 3 and al_starts_with(t, "arr") == 1 and *(t.ptr + 3) >= 48 and *(t.ptr + 3) <= 57
        return 1
    0

# `await e` in an async fn, e no async fn's call nor a held future: a poll
# source, refused at the await when no declaration types it, or it returns no
# `Option<T>` (AGAST #4558, #4604), in ritz0's words (check_poll_source).
# Run as the analysis walks, so in source order and before the locals'.
fn al_check_source(a: *AlFn, aw: *Expr)
    let inner: *Expr = aw.operand
    if al_call_of_async(inner) != null or al_held_async(a, inner) != null
        return
    let f: *FnDef = al_source_fn(a, inner)
    if f == null
        var m: String = string_new()
        m.push_str("`await`: the poll source's type is unknown; a poll source is a call of a fn or method declared to return `Option<T>`")
        al_refuse(a, @&m, aw.span)
        return
    var probe: AlLocal
    if al_set_source_value(@probe, f) == 1
        return
    var m: String = string_new()
    m.push_str("`await ")
    if inner.kind == ExprKind.Method
        m.push_span(Span<u8> { ptr: inner.left.ident.ptr, len: (inner.left.ident.len) as i64 })
        m.push_str(".")
    m.push_span(Span<u8> { ptr: f.name.ptr, len: (f.name.len) as i64 })
    m.push_str("(..)`: a poll source returns `Option<T>` (`None` while Pending, `Some(v)` when Ready); `")
    m.push_span(Span<u8> { ptr: f.name.ptr, len: (f.name.len) as i64 })
    m.push_str("` does not")
    al_refuse(a, @&m, aw.span)

fn al_infer(a: *AlFn, e: *Expr, l: *AlLocal) -> i32
    if e == null
        return 0
    let k: ExprKind = e.kind
    match k
        ExprKind.Await =>
            let g: *AlAsync = al_call_of_async(e.operand)
            if g == null
                let h: *AlAsync = al_held_async(a, e.operand)
                if h != null
                    return al_set_ret(l, h.f)
                # A hand-written poll source's T, of its `Option<T>` (#4604).
                let src: *FnDef = al_source_fn(a, e.operand)
                if src == null
                    return 0
                return al_set_source_value(l, src)
            return al_set_ret(l, g.f)   # the awaited fn's result (#1318, R78)
        ExprKind.IntLit =>
            if e.lit_kind == LIT_TRUE or e.lit_kind == LIT_FALSE
                al_set_scalar(l, TypeKind.Bool)
            else
                al_set_scalar(l, TypeKind.I64)
            return 1
        ExprKind.FloatLit =>
            al_set_scalar(l, TypeKind.F64)
            return 1
        ExprKind.CharLit =>
            al_set_scalar(l, TypeKind.U8)
            return 1
        ExprKind.Ident =>
            let src: *AlLocal = al_local_find(a, e.ident)
            if src == null or src.ty == TypeKind.Void
                return 0
            l.ty = src.ty
            l.type_name = src.type_name
            l.pointee = src.pointee
            l.inner_pointee = src.inner_pointee
            l.inner_ref = src.inner_ref
            l.unsupported = src.unsupported
            return 1
        ExprKind.Cast =>
            if e.type_kind == TypeKind.Struct or e.type_kind == TypeKind.Ptr or e.type_kind == TypeKind.PtrPtr or e.type_kind == TypeKind.Array or e.type_kind == TypeKind.Ref or e.type_kind == TypeKind.MutRef
                return 0
            al_set_scalar(l, e.type_kind)
            return 1
        ExprKind.Binary =>
            if op_is_cmp_or_logic(e.op)
                al_set_scalar(l, TypeKind.Bool)
                return 1
            if e.op != OpKind.Shl and e.op != OpKind.Shr and e.left.kind == ExprKind.IntLit and e.right.kind != ExprKind.IntLit
                return al_infer(a, e.right, l)
            return al_infer(a, e.left, l)
        ExprKind.Unary =>
            match e.op
                OpKind.Not =>
                    al_set_scalar(l, TypeKind.Bool)
                    return 1
                OpKind.Neg | OpKind.BitNot =>
                    return al_infer(a, e.operand, l)
                _ => pass
            return 0
        _ => pass
    if k == ExprKind.Call and e.func_name.ptr != null and e.call_type_suffix.len == 0
        if al_local_find(a, e.func_name) != null
            return 0
        let f: *FnDef = al_find_fn(e.func_name)
        if f == null or f.type_params != null
            return 0
        if f.is_async == 1
            # A bare call is the fn's future (#1395).
            let fut: StrView = al_future_struct_name(f.name)
            al_set_struct(l, fut)
            return 1
        if f.return_type == TypeKind.Struct
            al_set_struct(l, f.return_type_name)
            return 1
        if f.return_type == TypeKind.Void or f.return_type == TypeKind.Ptr or f.return_type == TypeKind.PtrPtr or al_type_unsupported(f.return_type, TypeKind.Void) == 1
            return 0
        al_set_scalar(l, f.return_type)
        return 1
    0

fn al_an_stmts(a: *AlFn, s: *Stmt, top: i32)
    var cur: *Stmt = s
    while cur != null
        al_an_stmt(a, cur, top)
        cur = cur.next

fn al_an_arms(a: *AlFn, arm: *MatchArm)
    var cur: *MatchArm = arm
    while cur != null
        al_an_stmts(a, cur.body_stmts, 0)
        al_an_expr(a, cur.body)
        cur = cur.next

fn al_an_decl(a: *AlFn, s: *Stmt, top: i32)
    # The local's type, before its value is walked (an await in it is not a
    # local yet).  Untyped: its value's, as ritz0 infers it (#3762).
    var t: AlLocal
    t.unsupported = 0
    var typed: i32 = 0
    if s.var_declared_type != TypeKind.Void
        typed = 1
        t.ty = s.var_type
        t.type_name = s.var_type_name
        t.pointee = s.var_pointee_type
        t.inner_pointee = s.var_inner_pointee_type
        t.inner_ref = s.var_inner_ref
        t.unsupported = al_type_unsupported(s.var_type, s.var_pointee_type)
        if s.var_fn_sig != null
            t.unsupported = 1
    else if al_infer(a, s.var_init, @t) == 1
        typed = 1
    else if a.untyped == null
        a.untyped = s
    al_an_expr(a, s.var_init)
    let l: *AlLocal = al_local(a, s.var_name, s.span)
    if typed == 1
        l.ty = t.ty
        l.type_name = t.type_name
        l.pointee = t.pointee
        l.inner_pointee = t.inner_pointee
        l.inner_ref = t.inner_ref
        l.unsupported = t.unsupported

fn al_an_stmt(a: *AlFn, s: *Stmt, top: i32)
    let k: StmtKind = s.kind
    match k
        StmtKind.VarDecl =>
            al_an_decl(a, s, top)
        StmtKind.Expr =>
            al_an_expr(a, s.expr)
        StmtKind.Return =>
            al_an_expr(a, s.return_value)
        StmtKind.If =>
            al_an_expr(a, s.if_cond)
            al_an_stmts(a, s.if_then, 0)
            al_an_stmts(a, s.if_else, 0)
        StmtKind.While =>
            al_an_expr(a, s.while_cond)
            al_an_stmts(a, s.while_body, 0)
        StmtKind.For =>
            al_an_expr(a, s.for_start)
            al_an_expr(a, s.for_end)
            al_an_stmts(a, s.for_body, 0)
        StmtKind.Loop | StmtKind.Defer | StmtKind.Unsafe =>
            al_an_stmts(a, s.while_body, 0)
        StmtKind.Match =>
            al_an_expr(a, s.if_cond)
            al_an_arms(a, s.if_then as *MatchArm)
        StmtKind.Assign | StmtKind.MemberAssign | StmtKind.MemberIndexAssign | StmtKind.IndexAssign | StmtKind.LocalFieldAssign | StmtKind.LocalFieldIndexAssign =>
            al_an_expr(a, s.assign_value)
        _ => pass

fn al_an_list(a: *AlFn, e: *Expr)
    var cur: *Expr = e
    while cur != null
        al_an_expr(a, cur)
        cur = cur.next

fn al_an_expr(a: *AlFn, e: *Expr)
    if e == null
        return
    let k: ExprKind = e.kind
    match k
        ExprKind.Await =>
            al_an_expr(a, e.operand)
            if a.sync == 0
                al_check_source(a, e)
            a.npoints += 1
        ExprKind.Binary | ExprKind.Range | ExprKind.Index =>
            al_an_expr(a, e.left)
            al_an_expr(a, e.right)
        ExprKind.Unary =>
            al_an_expr(a, e.operand)
        ExprKind.Call =>
            if e.func_name.ptr == null
                al_an_expr(a, e.left)
            al_an_list(a, e.args)
        ExprKind.Method =>
            al_an_expr(a, e.left)
            al_an_list(a, e.args)
        ExprKind.Member | ExprKind.Cast | ExprKind.Try | ExprKind.ArrayFill =>
            al_an_expr(a, e.left)
        ExprKind.If | ExprKind.Match =>
            al_an_expr(a, e.left)
            al_an_arms(a, e.args as *MatchArm)
        ExprKind.StructLit =>
            var fi: *FieldInit = e.args as *FieldInit
            while fi != null
                al_an_expr(a, fi.value)
                fi = fi.next
        ExprKind.ArrayLit =>
            al_an_list(a, e.args)
        _ => pass

# ---------------------------------------------------------------------------
# Rewriting: a body's names read through `self`, and its awaits lowered
# ---------------------------------------------------------------------------

# Is `name` held in the future?  Params always; the other locals that outlive
# a state boundary, when the fn awaits.  One that dies within one state of a
# re-entered block stays a local of the poll (AGAST #4527).
fn al_is_field(a: *AlFn, name_sv: StrView) -> i32
    var name: *u8 = name_sv.ptr
    if a.sync == 1 or name == null
        return 0
    let l: *AlLocal = al_local_find(a, name_sv)
    if l == null
        return 0
    if l.is_param == 1
        return 1
    if a.npoints > 0 and l.poll_ok != 1
        return 1
    0

fn al_rename_of(a: *AlFn, name_sv: StrView) -> *AlRename
    var len: i32 = name_sv.len as i32
    var r: *AlRename = a.renames
    while r != null
        if al_eq(r.name, name_sv) == 1
            return r
        r = r.next
    null

fn al_point_of(a: *AlFn, e: *Expr) -> *AlPoint
    var p: *AlPoint = a.points
    while p != null
        if p.await_expr == e
            return p
        p = p.next
    null

# The `__await_<g>` that drives g's future to completion (ritz0's
# _emit_await_poll_loop as a fn), built the first time a sync fn awaits g.
fn al_await_helper(g: *AlAsync, span: SrcSpan) -> *FnDef
    if g.helper != null
        return g.helper
    # Its params: copies of g's own.
    var params: *Param = null
    var last: *Param = null
    var args: *Expr = null
    var last_arg: *Expr = null
    var p: *Param = g.params
    while p != null
        let c: *Param = al_zalloc(sizeof(Param)) as *Param
        let src: *u8 = p as *u8
        let dst: *u8 = c as *u8
        var i: i64 = 0
        while i < sizeof(Param)
            *(dst + i) = *(src + i)
            i += 1
        c.next = null
        if last == null
            params = c
        else
            last.next = c
        last = c
        let arg: *Expr = al_ident(p.name, span)
        if last_arg == null
            args = arg
        else
            last_arg.next = arg
        last_arg = arg
        p = p.next
    let name: StrView = al_join("__await_", g.name)
    let fut: StrView = al_future_struct_name(g.name)
    let poll: StrView = al_poll_fn_name(g.name)
    var tail: i32 = AL_DRIVE_RESULT
    if g.f.return_type == TypeKind.Void
        tail = AL_DRIVE_NONE
    let body: *Stmt = al_drive_body(g.name, args, fut, poll, tail, span)
    var orig: FnDef
    orig.line = span.line
    orig.col = span.col
    orig.is_local = 1
    orig.is_pub = 0
    orig.def_file = strview_empty()   # private to this file, which defines it
    orig.target_gated = 0
    let f: *FnDef = al_fn(@orig, name, params, g.f.return_type, g.f.return_type_name, body)
    module_append_fn(g_al_module, f)
    g.helper = f
    f

# What a drive's body ends with.
const AL_DRIVE_NONE: i32 = 0     # nothing: a unit fn's
const AL_DRIVE_RESULT: i32 = 1   # the future's `__result`
const AL_DRIVE_ZERO: i32 = 2     # 0: a unit `async fn main`'s exit code

# `fn __await_held_<name>(p: *<name>$Future) -> T`: poll the held future until
# it answers true (R79; one already finished answers at once, without running
# its body again), then read its result.
fn al_held_helper(g: *AlAsync, span: SrcSpan) -> *FnDef
    if g.held != null
        return g.held
    let fut: StrView = al_future_struct_name(g.name)
    let poll: StrView = al_poll_fn_name(g.name)
    let p: *Param = al_zalloc(sizeof(Param)) as *Param
    p.name = "p"
    p.param_type = TypeKind.Ptr
    p.param_pointee_type = TypeKind.Struct
    p.param_type_name = fut
    let w: *Stmt = al_stmt(StmtKind.While, span)
    w.while_cond = al_poll_not_ready(al_call(poll, al_ident("p", span), span))
    w.while_body = al_stmt(StmtKind.Continue, span)
    var body: *Stmt = w
    if g.f.return_type != TypeKind.Void
        body = al_append(body, al_expr_stmt(al_result_of(al_ident("p", span), span)))
    let name: StrView = al_join("__await_held_", g.name)
    var orig: FnDef
    orig.line = span.line
    orig.col = span.col
    orig.is_local = 1
    orig.is_pub = 0
    orig.def_file = strview_empty()   # private to this file, which defines it
    orig.target_gated = 0
    let f: *FnDef = al_fn(@orig, name, p, g.f.return_type, g.f.return_type_name, body)
    module_append_fn(g_al_module, f)
    g.held = f
    f

#     var __future: <fut> = <ctor>(args)
#     while !<poll>(@__future)       # false while Pending (LARB R78)
#         continue
#     __future.__result              # as `tail` says
fn al_drive_body(ctor_sv: StrView, args: *Expr, fut_sv: StrView, poll_sv: StrView, tail: i32, span: SrcSpan) -> *Stmt
    var body: *Stmt = al_decl("__future", TypeKind.Struct, fut_sv, al_call(ctor_sv, args, span), 0, strview_empty(), span)
    let w: *Stmt = al_stmt(StmtKind.While, span)
    w.while_cond = al_poll_not_ready(al_call(poll_sv, al_addr_of("__future", span), span))
    w.while_body = al_stmt(StmtKind.Continue, span)
    body = al_append(body, w)
    if tail == AL_DRIVE_RESULT
        body = al_append(body, al_expr_stmt(al_result_of(al_ident("__future", span), span)))
    else if tail == AL_DRIVE_ZERO
        body = al_append(body, al_expr_stmt(al_int(0, span)))
    body

fn module_append_fn(m: *Module, f: *FnDef)
    f.next = null
    if m.functions == null
        m.functions = f
        return
    var cur: *FnDef = m.functions
    while cur.next != null
        cur = cur.next
    cur.next = f

fn al_rw_list(a: *AlFn, e: *Expr) -> *Expr
    var head: *Expr = null
    var prev: *Expr = null
    var cur: *Expr = e
    while cur != null
        let nxt: *Expr = cur.next
        let n: *Expr = al_rw_expr(a, cur)
        n.next = nxt
        if prev == null
            head = n
        else
            prev.next = n
        prev = n
        cur = nxt
    head

fn al_rw_arms(a: *AlFn, arm: *MatchArm)
    var cur: *MatchArm = arm
    while cur != null
        cur.body_stmts = al_rw_stmts(a, cur.body_stmts)
        if cur.body != null
            cur.body = al_rw_expr(a, cur.body)
        cur = cur.next

# `e` rewritten; a replacement takes over e's place in its list.
fn al_rw_expr(a: *AlFn, e: *Expr) -> *Expr
    if e == null
        return null
    let k: ExprKind = e.kind
    if k == ExprKind.Ident
        let r: *AlRename = al_rename_of(a, e.ident)
        if r != null and r.field.ptr == null
            return e
        if r != null
            let m: *Expr = al_self_field(r.field, e.span)
            m.next = e.next
            return m
        if al_is_field(a, e.ident) == 1
            let m: *Expr = al_self_field(e.ident, e.span)
            m.next = e.next
            return m
        return e
    if k == ExprKind.Await or k == ExprKind.If or (k == ExprKind.Binary and (e.op == OpKind.And or e.op == OpKind.Or))
        let p: *AlPoint = al_point_of(a, e)
        if p != null
            # A state already drove it (an await, a short-circuit whose right
            # operand awaits, or an awaiting `if` operand): its value is stored.
            let m: *Expr = al_self_field(p.result, e.span)
            m.next = e.next
            return m
    if k == ExprKind.Await
        var op: *Expr = al_rw_expr(a, e.operand)
        let g: *AlAsync = al_call_of_async(op)
        if g != null
            let h: *FnDef = al_await_helper(g, e.span)
            op.func_name = h.name
            op.next = e.next
            return op
        # `await p`, p a held future: drive it in place, then read its result.
        let h: *AlAsync = al_held_async(a, op)
        if h != null
            let hf: *FnDef = al_held_helper(h, e.span)
            let call: *Expr = al_call(hf.name, al_addr_of(op.ident, e.span), e.span)
            call.func_name.len = hf.name.len
            call.next = e.next
            return call
        # Anything else is a poll source, which only an async fn can await:
        # it may be Pending, and nothing here can suspend (AGAST #4558).
        var m: String = string_new()
        m.push_str("`await` of a poll source outside an async fn: a poll source can only be awaited in an async fn, which can suspend while it is Pending")
        al_refuse(a, @&m, e.span)
        op.next = e.next
        return op
    match k
        ExprKind.Binary | ExprKind.Range | ExprKind.Index =>
            e.left = al_rw_expr(a, e.left)
            e.right = al_rw_expr(a, e.right)
        ExprKind.Unary =>
            e.operand = al_rw_expr(a, e.operand)
        ExprKind.Call =>
            if e.func_name.ptr == null
                e.left = al_rw_expr(a, e.left)
            e.args = al_rw_list(a, e.args)
        ExprKind.Method =>
            e.left = al_rw_expr(a, e.left)
            e.args = al_rw_list(a, e.args)
        ExprKind.Member | ExprKind.Cast | ExprKind.Try | ExprKind.ArrayFill =>
            e.left = al_rw_expr(a, e.left)
        ExprKind.If | ExprKind.Match =>
            e.left = al_rw_expr(a, e.left)
            al_rw_arms(a, e.args as *MatchArm)
        ExprKind.StructLit =>
            var fi: *FieldInit = e.args as *FieldInit
            while fi != null
                fi.value = al_rw_expr(a, fi.value)
                fi = fi.next
        ExprKind.ArrayLit =>
            e.args = al_rw_list(a, e.args)
        _ => pass
    e

# A scalar local's zero (0, false, null); null for an array or struct.
fn al_zero_of(a: *AlFn, s: *Stmt) -> *Expr
    let l: *AlLocal = al_local_find(a, s.var_name)
    if l == null or l.ty == TypeKind.Struct or l.ty == TypeKind.Array
        return null
    if l.ty == TypeKind.Ptr or l.ty == TypeKind.PtrPtr
        return al_expr(ExprKind.NilLit, s.span)
    let z: *Expr = al_int(0, s.span)
    if l.ty == TypeKind.Bool
        z.lit_kind = LIT_FALSE
    z

fn al_rw_part(a: *AlFn, e: *Expr, hoist: i32) -> *Expr
    if hoist == 1
        return al_hoist(a, e)
    al_rw_expr(a, e)

# An assignment's target, rewritten (and with `hoist`, its awaits driven
# first): a name held in the future is written through `self`, whatever the
# assignment's form (#3727: `n[i] = v`, `p.f = v`).
fn al_rw_target(a: *AlFn, s: *Stmt, hoist: i32)
    let k: StmtKind = s.kind
    match k
        StmtKind.Assign =>
            if s.assign_target.ptr == null
                s.if_cond = al_rw_part(a, s.if_cond, hoist)
            else if al_is_field(a, s.assign_target) == 1
                s.kind = StmtKind.MemberAssign
                s.if_cond = al_ident("self", s.span)
                s.bracket = s.span
        StmtKind.MemberAssign =>
            s.if_cond = al_rw_part(a, s.if_cond, hoist)
        StmtKind.MemberIndexAssign =>
            s.if_cond = al_rw_part(a, s.if_cond, hoist)
            s.while_cond = al_rw_part(a, s.while_cond, hoist)
        StmtKind.IndexAssign =>
            s.while_cond = al_rw_part(a, s.while_cond, hoist)
            if al_is_field(a, s.assign_target) == 1
                s.kind = StmtKind.MemberIndexAssign
                s.if_cond = al_ident("self", s.span)
                s.index_at = s.bracket   # its `[` (AGAST #2847)
        StmtKind.LocalFieldAssign | StmtKind.LocalFieldIndexAssign =>
            if k == StmtKind.LocalFieldIndexAssign
                s.while_cond = al_rw_part(a, s.while_cond, hoist)
            if al_is_field(a, s.var_name) == 1
                s.if_cond = al_self_field(s.var_name, s.span)
                if k == StmtKind.LocalFieldAssign
                    s.kind = StmtKind.MemberAssign
                else
                    s.kind = StmtKind.MemberIndexAssign
        _ => pass

# A statement may be rewritten to several (a `return`'s Ready, R78): each
# one's chain is spliced in its place.
fn al_rw_stmts(a: *AlFn, s: *Stmt) -> *Stmt
    var head: *Stmt = null
    var prev: *Stmt = null
    var cur: *Stmt = s
    while cur != null
        let nxt: *Stmt = cur.next
        cur.next = null
        let n: *Stmt = al_rw_stmt(a, cur)
        let last: *Stmt = al_last(n)
        last.next = nxt
        if prev == null
            head = n
        else
            prev.next = n
        prev = last
        cur = nxt
    head

fn al_rw_stmt(a: *AlFn, s: *Stmt) -> *Stmt
    let k: StmtKind = s.kind
    match k
        StmtKind.VarDecl =>
            s.var_init = al_rw_expr(a, s.var_init)
            if al_is_field(a, s.var_name) == 1
                # The local lives in the future, where its uses read it.  One with
                # no value is zeroed if a scalar; an array or struct is only its
                # field (ritz0 alike).
                var v: *Expr = s.var_init
                if v == null
                    v = al_zero_of(a, s)
                    if v == null
                        s.kind = StmtKind.Stripped
                        return s
                return al_assign_self(s.var_name, v, s.span)
        StmtKind.Assign | StmtKind.MemberAssign | StmtKind.MemberIndexAssign | StmtKind.IndexAssign | StmtKind.LocalFieldAssign | StmtKind.LocalFieldIndexAssign =>
            al_rw_target(a, s, 0)
            s.assign_value = al_rw_expr(a, s.assign_value)
        StmtKind.Return =>
            s.return_value = al_rw_expr(a, s.return_value)
            if a.sync == 0
                return al_poll_ready(a, s.return_value, s.span)
        StmtKind.Expr =>
            s.expr = al_rw_expr(a, s.expr)
        StmtKind.If =>
            s.if_cond = al_rw_expr(a, s.if_cond)
            s.if_then = al_rw_stmts(a, s.if_then)
            s.if_else = al_rw_stmts(a, s.if_else)
        StmtKind.While =>
            s.while_cond = al_rw_expr(a, s.while_cond)
            s.while_body = al_rw_stmts(a, s.while_body)
        StmtKind.For =>
            s.for_start = al_rw_expr(a, s.for_start)
            s.for_end = al_rw_expr(a, s.for_end)
            s.for_body = al_rw_stmts(a, s.for_body)
        StmtKind.Loop | StmtKind.Defer | StmtKind.Unsafe =>
            s.while_body = al_rw_stmts(a, s.while_body)
        StmtKind.Match =>
            s.if_cond = al_rw_expr(a, s.if_cond)
            al_rw_arms(a, s.if_then as *MatchArm)
        StmtKind.Assert =>
            s.if_cond = al_rw_expr(a, s.if_cond)
        _ => pass
    s

# ---------------------------------------------------------------------------
# How a poll answers: Pending, or Ready with its result stored
# ---------------------------------------------------------------------------
#
# LARB R78 (AGAST #3728): every poll returns `bool`, true once the body has
# finished, having written its value into the future's `__result` (none for a
# unit fn).  The state machine asks only these.  ritz0's PollAbi.

fn al_false(span: SrcSpan) -> *Expr
    let e: *Expr = al_int(0, span)
    e.lit_kind = LIT_FALSE
    e

# `fut.__result`
fn al_result_of(fut: *Expr, span: SrcSpan) -> *Expr
    let e: *Expr = al_expr(ExprKind.Member, span)
    e.left = fut
    e.ident = "__result"
    e.bracket = span
    e

# Whether an inner generated poll's answer, `polled`, is Pending: `!polled`.
fn al_poll_not_ready(polled: *Expr) -> *Expr
    let e: *Expr = al_expr(ExprKind.Unary, polled.span)
    e.op = OpKind.Not
    e.operand = polled
    e

# Whether an awaited poll source's `answer` is Pending: `answer.is_none()`.
fn al_poll_source_is_pending(answer: *Expr) -> *Expr
    al_method0(answer, "is_none", answer.span)

# A Ready poll source's value: `answer.unwrap()`, read once it is not None.
fn al_poll_source_value(answer: *Expr) -> *Expr
    al_method0(answer, "unwrap", answer.span)

# Whether a future's `__state` says its body has finished: `__state == -1`.
fn al_state_is_done(state: *Expr) -> *Expr
    al_binary(OpKind.Eq, state, al_pending(state.span))

# Return Pending from this poll.
fn al_poll_pending_stmt(span: SrcSpan) -> *Stmt
    al_return(al_false(span), span)

# Return Ready from this poll: `self.__result = v` (a unit fn's `v` only
# runs), `self.__state = -1` (R79: a later poll is true at once), then
# `return true`.  A chain of statements.
fn al_poll_ready(a: *AlFn, v: *Expr, span: SrcSpan) -> *Stmt
    let done: *Stmt = al_return(al_true(span), span)
    let finish: *Stmt = al_assign_self("__state", al_pending(span), span)
    finish.next = done
    if v == null
        return finish
    v.next = null
    var first: *Stmt = null
    if a.f.return_type != TypeKind.Void
        first = al_assign_self("__result", v, span)
    else if v.kind != ExprKind.IntLit and v.kind != ExprKind.Member and v.kind != ExprKind.Ident
        first = al_expr_stmt(v)
    else
        return finish
    first.next = finish
    first

# A straight poll's statements (no await), its tail value made the Ready:
# stored in `__result`, then `true`; through an `if`'s or a `match`'s arms.
# A unit fn's poll ends in `true`.
fn al_ready_tail(a: *AlFn, s: *Stmt, span: SrcSpan) -> *Stmt
    if a.f.return_type == TypeKind.Void
        return al_append(s, al_expr_stmt(al_true(span)))
    al_value_tail(s)

fn al_value_tail(s: *Stmt) -> *Stmt
    if s == null
        return null
    var prev: *Stmt = null
    var t: *Stmt = s
    while t.next != null
        prev = t
        t = t.next
    if t.kind == StmtKind.Expr
        let st: *Stmt = al_assign_self("__result", t.expr, t.span)
        st.next = al_expr_stmt(al_true(t.span))
        if prev == null
            return st
        prev.next = st
        return s
    if t.kind == StmtKind.If and t.if_else != null
        t.if_then = al_value_tail(t.if_then)
        t.if_else = al_value_tail(t.if_else)
    else if t.kind == StmtKind.Match
        var arm: *MatchArm = t.if_then as *MatchArm
        while arm != null
            if arm.body != null and arm.is_pass == 0
                let st: *Stmt = al_assign_self("__result", arm.body, arm.body.span)
                arm.body_stmts = al_append(arm.body_stmts, st)
                arm.body = al_true(st.span)
            else
                arm.body_stmts = al_value_tail(arm.body_stmts)
            arm = arm.next
    s

# `await g(..)` of a unit g where a value is wanted.
fn al_no_value(a: *AlFn, g: *AlAsync, span: SrcSpan)
    var m: String = string_new()
    m.push_str("`await ")
    m.push_str(g.name)
    m.push_str("(..)` has no value: `")
    m.push_str(g.name)
    m.push_str("` is a unit async fn")
    al_refuse(a, @&m, span)

# ---------------------------------------------------------------------------
# The state machine (AGAST #3727): the body as a graph of states
# ---------------------------------------------------------------------------
#
# Each state is a straight run of statements that ends by jumping to another
# state (`self.__state = N` + `continue` in the poll's dispatch loop),
# returning Ready, or returning Pending at a resume point.  An await is its
# own state: it polls the awaited future, kept in the future struct, and
# returns Pending until it is Ready, so the next poll resumes there.  Loops and
# branches are edges between states, so an await in a `while` runs on every
# pass and only the taken arm's do.  A statement with no await (and no
# `break` / `continue` out of a loop that has one) is kept whole, rewritten in
# place.  ritz0's _CfgBuilder, step for step: the fields it adds (await results,
# awaited futures) come in the same order, so the futures' layouts agree.

fn al_dest(kind: i32, span: SrcSpan) -> AlDest
    var d: AlDest
    d.kind = kind
    d.name = strview_empty()
    d.stmt = null
    d.span = span
    d

fn al_true(span: SrcSpan) -> *Expr
    let e: *Expr = al_int(1, span)
    e.lit_kind = LIT_TRUE
    e

fn al_copy_stmt(s: *Stmt) -> *Stmt
    let c: *Stmt = al_zalloc(sizeof(Stmt)) as *Stmt
    let src: *u8 = s as *u8
    let dst: *u8 = c as *u8
    var i: i64 = 0
    while i < sizeof(Stmt)
        *(dst + i) = *(src + i)
        i += 1
    c.next = null
    c

# `s`'s statements, each copied: a deferred body runs at several exits, and
# one chain can't be linked into several states (AGAST #4191).
fn al_copy_stmts(s: *Stmt) -> *Stmt
    var head: *Stmt = null
    var prev: *Stmt = null
    var cur: *Stmt = s
    while cur != null
        let c: *Stmt = al_copy_stmt(cur)
        if prev == null
            head = c
        else
            prev.next = c
        prev = c
        cur = cur.next
    head

# A field the lowering adds, after the locals: an await result or a future.
fn al_extra(a: *AlFn, name_sv: StrView) -> *AlLocal
    let l: *AlLocal = al_zalloc(sizeof(AlLocal)) as *AlLocal
    l.name = name_sv
    if a.extra == null
        a.extra = l
    else
        var cur: *AlLocal = a.extra
        while cur.next != null
            cur = cur.next
        cur.next = l
    l

# The await `e`'s result is stored in self.<name>.
fn al_add_point(a: *AlFn, e: *Expr, name_sv: StrView)
    let p: *AlPoint = al_zalloc(sizeof(AlPoint)) as *AlPoint
    p.await_expr = e
    p.result = name_sv
    p.next = a.points
    a.points = p

# -- what a statement holds -------------------------------------------------

fn al_await_in_list(e: *Expr) -> *Expr
    var cur: *Expr = e
    while cur != null
        let r: *Expr = al_await_in(cur)
        if r != null
            return r
        cur = cur.next
    null

fn al_await_in_arms(arm: *MatchArm) -> *Expr
    var cur: *MatchArm = arm
    while cur != null
        var r: *Expr = al_await_in_stmts(cur.body_stmts)
        if r == null
            r = al_await_in(cur.body)
        if r != null
            return r
        cur = cur.next
    null

# The first await in `e`, in evaluation order.
fn al_await_in(e: *Expr) -> *Expr
    if e == null
        return null
    let k: ExprKind = e.kind
    if k == ExprKind.Await
        return e
    var r: *Expr = null
    match k
        ExprKind.Binary | ExprKind.Range | ExprKind.Index =>
            r = al_await_in(e.left)
            if r == null
                r = al_await_in(e.right)
        ExprKind.Unary =>
            r = al_await_in(e.operand)
        ExprKind.Call =>
            if e.func_name.ptr == null
                r = al_await_in(e.left)
            if r == null
                r = al_await_in_list(e.args)
        ExprKind.Method =>
            r = al_await_in(e.left)
            if r == null
                r = al_await_in_list(e.args)
        ExprKind.Member | ExprKind.Cast | ExprKind.Try | ExprKind.ArrayFill =>
            r = al_await_in(e.left)
        ExprKind.If | ExprKind.Match =>
            r = al_await_in(e.left)
            if r == null
                r = al_await_in_arms(e.args as *MatchArm)
        ExprKind.StructLit =>
            var fi: *FieldInit = e.args as *FieldInit
            while fi != null and r == null
                r = al_await_in(fi.value)
                fi = fi.next
        ExprKind.ArrayLit =>
            r = al_await_in_list(e.args)
        _ => pass
    r

fn al_await_in_stmts(s: *Stmt) -> *Expr
    var cur: *Stmt = s
    while cur != null
        let r: *Expr = al_await_in_stmt(cur)
        if r != null
            return r
        cur = cur.next
    null

fn al_await_in_stmt(s: *Stmt) -> *Expr
    let k: StmtKind = s.kind
    var r: *Expr = null
    match k
        StmtKind.VarDecl =>
            r = al_await_in(s.var_init)
        StmtKind.Expr =>
            r = al_await_in(s.expr)
        StmtKind.Return =>
            r = al_await_in(s.return_value)
        StmtKind.If =>
            r = al_await_in(s.if_cond)
            if r == null
                r = al_await_in_stmts(s.if_then)
            if r == null
                r = al_await_in_stmts(s.if_else)
        StmtKind.While =>
            r = al_await_in(s.while_cond)
            if r == null
                r = al_await_in_stmts(s.while_body)
        StmtKind.For =>
            r = al_await_in(s.for_start)
            if r == null
                r = al_await_in(s.for_end)
            if r == null
                r = al_await_in_stmts(s.for_body)
        StmtKind.Loop | StmtKind.Defer | StmtKind.Unsafe =>
            r = al_await_in_stmts(s.while_body)
        StmtKind.Match =>
            r = al_await_in(s.if_cond)
            if r == null
                r = al_await_in_arms(s.if_then as *MatchArm)
        StmtKind.Assign | StmtKind.MemberAssign | StmtKind.MemberIndexAssign | StmtKind.IndexAssign | StmtKind.LocalFieldAssign | StmtKind.LocalFieldIndexAssign =>
            if k != StmtKind.IndexAssign and k != StmtKind.LocalFieldAssign and k != StmtKind.LocalFieldIndexAssign
                r = al_await_in(s.if_cond)
            if r == null and k != StmtKind.Assign and k != StmtKind.MemberAssign and k != StmtKind.LocalFieldAssign
                r = al_await_in(s.while_cond)
            if r == null
                r = al_await_in(s.assign_value)
        StmtKind.Assert =>
            r = al_await_in(s.if_cond)
        _ => pass
    r

# A `break` / `continue` in `s` that leaves it for an enclosing loop.
fn al_jump_in_arms(arm: *MatchArm) -> *Stmt
    var cur: *MatchArm = arm
    while cur != null
        let r: *Stmt = al_jump_in_stmts(cur.body_stmts)
        if r != null
            return r
        cur = cur.next
    null

fn al_jump_in_expr(e: *Expr) -> *Stmt
    if e != null and (e.kind == ExprKind.If or e.kind == ExprKind.Match)
        return al_jump_in_arms(e.args as *MatchArm)
    null

fn al_jump_in_stmts(s: *Stmt) -> *Stmt
    var cur: *Stmt = s
    while cur != null
        let r: *Stmt = al_jump_in_stmt(cur)
        if r != null
            return r
        cur = cur.next
    null

fn al_jump_in_stmt(s: *Stmt) -> *Stmt
    let k: StmtKind = s.kind
    match k
        StmtKind.Break | StmtKind.Continue =>
            return s
        StmtKind.If =>
            let r: *Stmt = al_jump_in_stmts(s.if_then)
            if r != null
                return r
            return al_jump_in_stmts(s.if_else)
        StmtKind.Defer | StmtKind.Unsafe =>
            return al_jump_in_stmts(s.while_body)
        StmtKind.Match =>
            return al_jump_in_arms(s.if_then as *MatchArm)
        StmtKind.Expr =>
            return al_jump_in_expr(s.expr)
        StmtKind.VarDecl =>
            return al_jump_in_expr(s.var_init)
        _ => pass
    null   # a loop's own jumps are its own

# -- which locals stay poll locals (AGAST #4527) ---------------------------
#
# A local declared in a block the machine re-enters (a loop body, or a
# `defer` body, which runs at every exit edge) becomes one field of the
# future, so each run overwrites the last value and nothing drops it.  One
# that is dead before any state boundary in the same activation crosses no
# `await` and can stay a poll local: the emitter's own block-end drop then
# frees it once per run.  A local anywhere else, or one live across a
# boundary, stays a field as before.  ritz0's al_poll_locals is the same.

# Whether `name` is read or written in `e`.
fn al_mentions_expr(e: *Expr, name: StrView) -> i32
    if e == null
        return 0
    let k: ExprKind = e.kind
    if k == ExprKind.Ident
        return al_eq(e.ident, name)
    var r: i32 = 0
    match k
        ExprKind.Binary | ExprKind.Range | ExprKind.Index =>
            r = al_mentions_expr(e.left, name)
            if r == 0
                r = al_mentions_expr(e.right, name)
        ExprKind.Unary =>
            r = al_mentions_expr(e.operand, name)
        ExprKind.Call =>
            if e.func_name.ptr == null
                r = al_mentions_expr(e.left, name)
            if r == 0
                r = al_mentions_list(e.args, name)
        ExprKind.Method =>
            r = al_mentions_expr(e.left, name)
            if r == 0
                r = al_mentions_list(e.args, name)
        ExprKind.Member | ExprKind.Cast | ExprKind.Try | ExprKind.ArrayFill =>
            r = al_mentions_expr(e.left, name)
        ExprKind.If | ExprKind.Match =>
            r = al_mentions_expr(e.left, name)
            if r == 0
                r = al_mentions_arms(e.args as *MatchArm, name)
        ExprKind.StructLit =>
            var fi: *FieldInit = e.args as *FieldInit
            while fi != null and r == 0
                r = al_mentions_expr(fi.value, name)
                fi = fi.next
        ExprKind.ArrayLit =>
            r = al_mentions_list(e.args, name)
        _ => pass
    r

fn al_mentions_list(e: *Expr, name: StrView) -> i32
    var cur: *Expr = e
    while cur != null
        if al_mentions_expr(cur, name) == 1
            return 1
        cur = cur.next
    0

fn al_mentions_arms(arm: *MatchArm, name: StrView) -> i32
    var cur: *MatchArm = arm
    while cur != null
        if al_mentions_stmts(cur.body_stmts, name) == 1
            return 1
        if al_mentions_expr(cur.body, name) == 1
            return 1
        cur = cur.next
    0

fn al_mentions_stmts(s: *Stmt, name: StrView) -> i32
    var cur: *Stmt = s
    while cur != null
        if al_mentions_stmt(cur, name) == 1
            return 1
        cur = cur.next
    0

fn al_mentions_stmt(s: *Stmt, name: StrView) -> i32
    let k: StmtKind = s.kind
    match k
        StmtKind.VarDecl =>
            # Its own name is a declaration, not a use.  A `let x = x + 1`'s
            # initializer still reads the outer `x`.
            return al_mentions_expr(s.var_init, name)
        StmtKind.Expr =>
            return al_mentions_expr(s.expr, name)
        StmtKind.Return =>
            return al_mentions_expr(s.return_value, name)
        StmtKind.If =>
            if al_mentions_expr(s.if_cond, name) == 1
                return 1
            if al_mentions_stmts(s.if_then, name) == 1
                return 1
            return al_mentions_stmts(s.if_else, name)
        StmtKind.While =>
            if al_mentions_expr(s.while_cond, name) == 1
                return 1
            return al_mentions_stmts(s.while_body, name)
        StmtKind.For =>
            if al_mentions_expr(s.for_start, name) == 1
                return 1
            if al_mentions_expr(s.for_end, name) == 1
                return 1
            return al_mentions_stmts(s.for_body, name)
        StmtKind.Loop | StmtKind.Defer | StmtKind.Unsafe =>
            return al_mentions_stmts(s.while_body, name)
        StmtKind.Match =>
            if al_mentions_expr(s.if_cond, name) == 1
                return 1
            return al_mentions_arms(s.if_then as *MatchArm, name)
        StmtKind.Assert =>
            return al_mentions_expr(s.if_cond, name)
        StmtKind.Assign | StmtKind.MemberAssign | StmtKind.MemberIndexAssign | StmtKind.IndexAssign | StmtKind.LocalFieldAssign | StmtKind.LocalFieldIndexAssign =>
            if al_eq(s.assign_target, name) == 1
                return 1
            # The base and index of the other forms, as al_await_in_stmt reads them.
            if k != StmtKind.IndexAssign and k != StmtKind.LocalFieldAssign and k != StmtKind.LocalFieldIndexAssign
                if al_mentions_expr(s.if_cond, name) == 1
                    return 1
            if k != StmtKind.Assign and k != StmtKind.MemberAssign and k != StmtKind.LocalFieldAssign
                if al_mentions_expr(s.while_cond, name) == 1
                    return 1
            return al_mentions_expr(s.assign_value, name)
        _ => pass
    0

# Whether lowering `s` ends the state it starts in: it holds an `await`, or a
# `break` / `continue` out of a loop that lowers it.
fn al_splits_stmt(s: *Stmt) -> i32
    if al_await_in_stmt(s) != null
        return 1
    let k: StmtKind = s.kind
    match k
        StmtKind.While =>
            return (al_jump_in_stmts(s.while_body) != null) as i32
        StmtKind.For =>
            return (al_jump_in_stmts(s.for_body) != null) as i32
        StmtKind.Loop =>
            return (al_jump_in_stmts(s.while_body) != null) as i32
        _ => pass
    (al_jump_in_stmt(s) != null) as i32

# Whether `s` uses `name` in a state other than the one before it.
fn al_uses_across_stmt(s: *Stmt, name: StrView, split: i32) -> i32
    let k: StmtKind = s.kind
    match k
        StmtKind.Defer =>
            # A defer body runs at exits, after any await on the way out.
            return al_mentions_stmts(s.while_body, name)
        StmtKind.While | StmtKind.For | StmtKind.Loop =>
            if al_splits_stmt(s) == 1 or split == 1
                return al_mentions_stmt(s, name)
            return 0
        _ => pass
    if al_splits_stmt(s) == 1
        return al_mentions_stmt(s, name)
    if split == 1
        return al_mentions_stmt(s, name)
    0

# Whether `name`, declared before `rest`, is used after a state boundary in
# the same activation.
fn al_crosses_after(name: StrView, rest: *Stmt) -> i32
    var split: i32 = 0
    var cur: *Stmt = rest
    while cur != null
        if cur.kind == StmtKind.VarDecl and al_eq(cur.var_name, name) == 1
            return 0   # a redeclaration shadows it; its own decl is checked
        if al_uses_across_stmt(cur, name, split) == 1
            return 1
        if al_splits_stmt(cur) == 1
            split = 1
        cur = cur.next
    0

# Mark each local's poll_ok from its declarations, `reentered` 1 inside a
# loop or defer body.
fn al_mark_walk_stmts(a: *AlFn, s: *Stmt, reentered: i32)
    var cur: *Stmt = s
    while cur != null
        if cur.kind == StmtKind.VarDecl
            var crosses: i32 = 0
            if al_await_in(cur.var_init) != null
                crosses = 1
            else
                crosses = al_crosses_after(cur.var_name, cur.next)
            let l: *AlLocal = al_local_find(a, cur.var_name)
            if l != null
                if reentered == 0 or crosses == 1
                    l.poll_ok = 0
                else if l.poll_ok == 0 - 1
                    l.poll_ok = 1
        al_mark_walk_stmt(a, cur, reentered)
        cur = cur.next

fn al_mark_walk_stmt(a: *AlFn, s: *Stmt, reentered: i32)
    let k: StmtKind = s.kind
    match k
        StmtKind.If =>
            al_mark_walk_expr(a, s.if_cond, reentered)
            al_mark_walk_stmts(a, s.if_then, reentered)
            al_mark_walk_stmts(a, s.if_else, reentered)
        StmtKind.While =>
            al_mark_walk_expr(a, s.while_cond, reentered)
            al_mark_walk_stmts(a, s.while_body, 1)
        StmtKind.For =>
            al_mark_walk_expr(a, s.for_start, reentered)
            al_mark_walk_expr(a, s.for_end, reentered)
            al_mark_walk_stmts(a, s.for_body, 1)
        StmtKind.Loop =>
            al_mark_walk_stmts(a, s.while_body, 1)
        StmtKind.Defer =>
            # A `defer` body is one synchronous region: it runs whole at each
            # exit edge, so its own locals never cross a state.
            al_mark_walk_stmts(a, s.while_body, 1)
        StmtKind.Unsafe =>
            al_mark_walk_stmts(a, s.while_body, reentered)
        StmtKind.Match =>
            al_mark_walk_expr(a, s.if_cond, reentered)
            al_mark_walk_arms(a, s.if_then as *MatchArm, reentered)
        StmtKind.VarDecl =>
            al_mark_walk_expr(a, s.var_init, reentered)
        StmtKind.Expr =>
            al_mark_walk_expr(a, s.expr, reentered)
        StmtKind.Return =>
            al_mark_walk_expr(a, s.return_value, reentered)
        StmtKind.Assert =>
            al_mark_walk_expr(a, s.if_cond, reentered)
        StmtKind.Assign | StmtKind.MemberAssign | StmtKind.MemberIndexAssign | StmtKind.IndexAssign | StmtKind.LocalFieldAssign | StmtKind.LocalFieldIndexAssign =>
            if k != StmtKind.IndexAssign and k != StmtKind.LocalFieldAssign and k != StmtKind.LocalFieldIndexAssign
                al_mark_walk_expr(a, s.if_cond, reentered)
            if k != StmtKind.Assign and k != StmtKind.MemberAssign and k != StmtKind.LocalFieldAssign
                al_mark_walk_expr(a, s.while_cond, reentered)
            al_mark_walk_expr(a, s.assign_value, reentered)
        _ => pass

fn al_mark_walk_expr(a: *AlFn, e: *Expr, reentered: i32)
    if e == null
        return
    let k: ExprKind = e.kind
    match k
        ExprKind.Binary | ExprKind.Range | ExprKind.Index =>
            al_mark_walk_expr(a, e.left, reentered)
            al_mark_walk_expr(a, e.right, reentered)
        ExprKind.Unary =>
            al_mark_walk_expr(a, e.operand, reentered)
        ExprKind.Call =>
            if e.func_name.ptr == null
                al_mark_walk_expr(a, e.left, reentered)
            al_mark_walk_list(a, e.args, reentered)
        ExprKind.Method =>
            al_mark_walk_expr(a, e.left, reentered)
            al_mark_walk_list(a, e.args, reentered)
        ExprKind.Member | ExprKind.Cast | ExprKind.Try | ExprKind.ArrayFill =>
            al_mark_walk_expr(a, e.left, reentered)
        ExprKind.If | ExprKind.Match =>
            al_mark_walk_expr(a, e.left, reentered)
            al_mark_walk_arms(a, e.args as *MatchArm, reentered)
        ExprKind.StructLit =>
            var fi: *FieldInit = e.args as *FieldInit
            while fi != null
                al_mark_walk_expr(a, fi.value, reentered)
                fi = fi.next
        ExprKind.ArrayLit =>
            al_mark_walk_list(a, e.args, reentered)
        _ => pass

fn al_mark_walk_list(a: *AlFn, e: *Expr, reentered: i32)
    var cur: *Expr = e
    while cur != null
        al_mark_walk_expr(a, cur, reentered)
        cur = cur.next

fn al_mark_walk_arms(a: *AlFn, arm: *MatchArm, reentered: i32)
    var cur: *MatchArm = arm
    while cur != null
        al_mark_walk_stmts(a, cur.body_stmts, reentered)
        al_mark_walk_expr(a, cur.body, reentered)
        cur = cur.next

fn al_needs(a: *AlFn, s: *Stmt, lp: *AlLoop) -> i32
    if al_await_in_stmt(s) != null
        return 1
    if lp != null and al_jump_in_stmt(s) != null
        return 1
    # A return runs every active defer, which the emitter can't see across
    # states: lower the statement that holds it (AGAST #4191).
    if a.defers != null and al_return_in_stmt(s) == 1
        return 1
    0

# Does `s` hold a `return`?  A return leaves every block, so with an active
# defer it must be lowered even with no await (AGAST #4191).
fn al_return_in_arms(arm: *MatchArm) -> i32
    var cur: *MatchArm = arm
    while cur != null
        if al_return_in_stmts(cur.body_stmts) == 1
            return 1
        cur = cur.next
    0

fn al_return_in_stmts(s: *Stmt) -> i32
    var cur: *Stmt = s
    while cur != null
        if al_return_in_stmt(cur) == 1
            return 1
        cur = cur.next
    0

fn al_return_in_stmt(s: *Stmt) -> i32
    let k: StmtKind = s.kind
    match k
        StmtKind.Return =>
            return 1
        StmtKind.If =>
            if al_return_in_stmts(s.if_then) == 1
                return 1
            return al_return_in_stmts(s.if_else)
        # A return inside a nested loop still leaves the function.
        StmtKind.While | StmtKind.Loop | StmtKind.Defer | StmtKind.Unsafe =>
            return al_return_in_stmts(s.while_body)
        StmtKind.For =>
            return al_return_in_stmts(s.for_body)
        StmtKind.Match =>
            return al_return_in_arms(s.if_then as *MatchArm)
        _ => pass
    0

fn al_needs_expr(e: *Expr, lp: *AlLoop) -> i32
    if al_await_in(e) != null
        return 1
    (lp != null and al_jump_in_expr(e) != null) as i32

# -- refusals ---------------------------------------------------------------

# The first error only, as ritz0 stops at its first.
fn al_refuse(a: *AlFn, m: @&String, span: SrcSpan)
    if a.errs == 0
        diag_error_buf(a.file, span, m)
    a.errs += 1

fn al_unplaced(a: *AlFn, what: StrView, span: SrcSpan)
    var m: String = string_new()
    format_into(@&m, "`await` inside {what} in an async fn is not supported yet (AGAST #4013)")
    al_refuse(a, @&m, span)

# Where a refused statement is: its first await, else its jump, else itself.
fn al_culprit(s: *Stmt) -> SrcSpan
    let e: *Expr = al_await_in_stmt(s)
    if e != null
        return e.span
    let j: *Stmt = al_jump_in_stmt(s)
    if j != null
        return j.span
    s.span

# -- states -----------------------------------------------------------------

fn al_new_block(a: *AlFn) -> *AlBlock
    let b: *AlBlock = al_zalloc(sizeof(AlBlock)) as *AlBlock
    b.idx = a.nblocks
    a.nblocks += 1
    if a.last_block == null
        a.blocks = b
    else
        a.last_block.next = b
    a.last_block = b
    b

# The open state, or a fresh (unreachable) one after a jump.
fn al_at(a: *AlFn) -> *AlBlock
    if a.cur == null
        a.cur = al_new_block(a)
    a.cur

fn al_emit(a: *AlFn, s: *Stmt)
    if s == null
        return
    s.next = null
    let b: *AlBlock = al_at(a)
    b.head = al_append(b.head, s)

# A chain of statements, appended whole.
fn al_emit_all(a: *AlFn, s: *Stmt)
    if s == null
        return
    let b: *AlBlock = al_at(a)
    b.head = al_append(b.head, s)

# Register a `defer`'s (already rewritten) body in the open block (AGAST
# #4191).  Nothing runs here: the body runs at each exit edge.
fn al_add_defer(a: *AlFn, body: *Stmt)
    let d: *AlDefer = al_zalloc(sizeof(AlDefer)) as *AlDefer
    d.body = body
    d.next = a.defers
    a.defers = d

# Run the defers above `stop`, innermost first and, within one block, in
# reverse order (LARB §13.7).  Each is emitted as a fresh copy: its block may
# exit at several edges.
fn al_run_defers(a: *AlFn, stop: *AlDefer)
    var d: *AlDefer = a.defers
    while d != stop
        al_emit_all(a, al_copy_stmts(d.body))
        d = d.next

fn al_close(a: *AlFn)
    let b: *AlBlock = al_at(a)
    b.closed = 1
    a.cur = null

fn al_set_state(n: i32, span: SrcSpan) -> *Stmt
    al_assign_self("__state", al_int(n as i64, span), span)

fn al_goto(a: *AlFn, target: *AlBlock, span: SrcSpan)
    al_emit(a, al_set_state(target.idx, span))
    al_emit(a, al_stmt(StmtKind.Continue, span))
    al_close(a)

fn al_branch(a: *AlFn, cond: *Expr, then_b: *AlBlock, else_b: *AlBlock, span: SrcSpan)
    let s: *Stmt = al_if(cond, al_set_state(then_b.idx, span), span)
    s.if_else = al_set_state(else_b.idx, span)
    al_emit(a, s)
    al_emit(a, al_stmt(StmtKind.Continue, span))
    al_close(a)

# `return v` from the async fn: Ready, v in `__result` (a unit fn's v has
# already run, delivered for its effects).  A Ready leaves every block, so
# every active defer runs, innermost first, after v is stored (AGAST #4191).
fn al_ret(a: *AlFn, v: *Expr, span: SrcSpan)
    var value: *Expr = v
    if a.f.return_type == TypeKind.Void
        value = null
    if a.defers == null
        al_emit_all(a, al_poll_ready(a, value, span))
        al_close(a)
        return
    al_store_ready(a, value, span)
    al_run_defers(a, null)
    al_emit(a, al_assign_self("__state", al_pending(span), span))
    al_emit(a, al_return(al_true(span), span))
    al_close(a)

# The value store of a Ready, without its finish: `al_poll_ready` minus
# `__state = -1` and `return true`, so the defers can run in between.
fn al_store_ready(a: *AlFn, v: *Expr, span: SrcSpan)
    if v == null
        return
    v.next = null
    if a.f.return_type != TypeKind.Void
        al_emit(a, al_assign_self("__result", v, span))
    else if v.kind != ExprKind.IntLit and v.kind != ExprKind.Member and v.kind != ExprKind.Ident
        al_emit(a, al_expr_stmt(v))

# -- values -----------------------------------------------------------------

# Drive each await in `e` in its own state, in evaluation order, storing its
# result; then `e` rewritten to read the results.
fn al_hoist(a: *AlFn, e: *Expr) -> *Expr
    if e == null
        return null
    al_hoist_walk(a, e, "")
    al_rw_expr(a, e)

fn al_hoist_list(a: *AlFn, e: *Expr) -> *Expr
    var cur: *Expr = e
    while cur != null
        al_hoist_walk(a, cur, "")
        cur = cur.next
    al_rw_list(a, e)

fn al_hoist_arms(a: *AlFn, arm: *MatchArm, under: StrView)
    var cur: *MatchArm = arm
    while cur != null
        let s: *Expr = al_await_in_stmts(cur.body_stmts)
        if s != null
            al_unplaced(a, under, s.span)
        al_hoist_walk(a, cur.body, under)
        cur = cur.next

# `under`: what the await would be inside, which has no state edge for it
# (empty: nothing).
fn al_hoist_walk(a: *AlFn, e: *Expr, under: StrView)
    if e == null
        return
    let k: ExprKind = e.kind
    if k == ExprKind.Await
        if under.len > 0
            al_unplaced(a, under, e.span)
            return
        let tmp: StrView = al_numbered("__await_result_", a.nawaits)
        # Of the awaited fn's result type (R78); a poll source's T.  A held
        # future's (`await p`, R79) is its async fn's.
        let g: *AlAsync = al_call_of_async(e.operand)
        var held: *AlAsync = null
        if g == null
            held = al_held_async(a, e.operand)
        var callee: *FnDef = null
        if g != null
            callee = g.f
        else if held != null
            callee = held.f
        if callee != null and callee.return_type == TypeKind.Void
            if g != null
                al_no_value(a, g, e.span)
            else
                al_no_value(a, held, e.span)
            return
        let res: *AlLocal = al_extra(a, tmp)
        if callee != null
            if al_set_ret(res, callee) == 0
                al_set_scalar(res, TypeKind.I32)
        else
            # A poll source's T, of its `Option<T>` (AGAST #4604); the
            # analysis refused one with none.
            let src: *FnDef = al_source_fn(a, e.operand)
            if src == null or al_set_source_value(res, src) == 0
                al_set_scalar(res, TypeKind.I32)
        var d: AlDest = al_dest(AL_TO_FIELD, e.span)
        d.name = tmp
        al_lower_await(a, e, @d)
        al_add_point(a, e, tmp)
    else if k == ExprKind.If and under.len == 0 and (e.args as *MatchArm).next != null and al_await_in(e) != null
        al_if_value(a, e)
    else if k == ExprKind.If or k == ExprKind.Match
        al_hoist_walk(a, e.left, under)
        var u: StrView = under
        if u.len == 0
            if k == ExprKind.If
                u = "an `if` inside an expression"
            else
                u = "a `match` inside an expression"
        al_hoist_arms(a, e.args as *MatchArm, u)
    else if k == ExprKind.Binary and (e.op == OpKind.And or e.op == OpKind.Or) and under.len == 0 and al_await_in(e.right) != null
        al_short_circuit(a, e)
    else
        match k
            ExprKind.Binary | ExprKind.Range | ExprKind.Index =>
                al_hoist_walk(a, e.left, under)
                al_hoist_walk(a, e.right, under)
            ExprKind.Unary =>
                al_hoist_walk(a, e.operand, under)
            ExprKind.Call | ExprKind.Method =>
                if k == ExprKind.Method or e.func_name.ptr == null
                    al_hoist_walk(a, e.left, under)
                var arg: *Expr = e.args
                while arg != null
                    al_hoist_walk(a, arg, under)
                    arg = arg.next
            ExprKind.Member | ExprKind.Cast | ExprKind.Try | ExprKind.ArrayFill =>
                al_hoist_walk(a, e.left, under)
            ExprKind.StructLit =>
                var fi: *FieldInit = e.args as *FieldInit
                while fi != null
                    al_hoist_walk(a, fi.value, under)
                    fi = fi.next
            ExprKind.ArrayLit =>
                var el: *Expr = e.args
                while el != null
                    al_hoist_walk(a, el, under)
                    el = el.next
            _ => pass

# `l && r` / `l || r` whose `r` awaits (AGAST #4013): `r`, and its awaits,
# run only when `l` doesn't decide the value.  ritz0's _short_circuit.
#
#     __short_K = l
#     if __short_K { -> R } else { -> J }    # `||`: the arms swap
#   R: __short_K = r                         # r's awaits in states
#   J: ... the expression reads __short_K
fn al_short_circuit(a: *AlFn, e: *Expr)
    al_hoist_walk(a, e.left, "")
    let tmp: StrView = al_numbered("__short_", a.nshorts)
    a.nshorts += 1
    al_set_scalar(al_extra(a, tmp), TypeKind.Bool)
    let left: *Expr = al_rw_expr(a, e.left)
    left.next = null
    al_emit(a, al_assign_self(tmp, left, e.span))
    let rhs: *AlBlock = al_new_block(a)
    let join: *AlBlock = al_new_block(a)
    let known: *Expr = al_self_field(tmp, e.span)
    if e.op == OpKind.And
        al_branch(a, known, rhs, join, e.span)
    else
        al_branch(a, known, join, rhs, e.span)
    a.cur = rhs
    let right: *Expr = al_hoist(a, e.right)
    right.next = null
    al_emit(a, al_assign_self(tmp, right, e.span))
    al_goto(a, join, e.span)
    a.cur = join
    al_add_point(a, e, tmp)

# A value's type into `l`, as al_infer tells it, read also through a value
# `if` (al_if_type) and the arithmetic over one: an awaiting `if` operand's
# `__if_K` field (AGAST #4190).  Only that field's: an untyped `let`'s is
# al_infer's alone.  ritz0's _IfTyper.
fn al_value_type(a: *AlFn, e: *Expr, l: *AlLocal) -> i32
    if e == null
        return 0
    let k: ExprKind = e.kind
    if k == ExprKind.If
        return al_if_type(a, e, l)
    if k == ExprKind.Binary and not op_is_cmp_or_logic(e.op)
        if e.op != OpKind.Shl and e.op != OpKind.Shr and e.left.kind == ExprKind.IntLit and e.right.kind != ExprKind.IntLit
            return al_value_type(a, e.right, l)
        return al_value_type(a, e.left, l)
    if k == ExprKind.Unary and (e.op == OpKind.Neg or e.op == OpKind.BitNot)
        return al_value_type(a, e.operand, l)
    al_infer(a, e, l)

# A value `if`'s type: its first arm's whose value isn't a bare literal (`7`
# takes the other arm's type); else its first arm's that tells (`i64`).
fn al_if_type(a: *AlFn, e: *Expr, l: *AlLocal) -> i32
    let then_arm: *MatchArm = e.args as *MatchArm
    if then_arm == null or then_arm.next == null
        return 0
    var arm: *MatchArm = then_arm
    while arm != null
        if arm.body != null and al_untyped_int(arm.body) == 0 and al_value_type(a, arm.body, l) == 1
            return 1
        arm = arm.next
    arm = then_arm
    while arm != null
        if al_value_type(a, arm.body, l) == 1
            return 1
        arm = arm.next
    0

# A value `if` that is an operand and awaits (AGAST #4190): each arm runs in
# states of its own, its awaits only when it is taken, and writes the value
# to a field the expression reads.  al_short_circuit, with two arms; ritz0's
# _CfgBuilder._if_value.
#
#     if c { -> T } else { -> E }    # c's awaits first
#   T: __if_K = then-value           # its awaits in states
#   E: __if_K = else-value
#   J: ... the expression reads __if_K
fn al_if_value(a: *AlFn, e: *Expr)
    let jump: *Stmt = al_jump_in_expr(e)
    if jump != null
        # An arm's `break` would leave the dispatch loop, not the user's.
        # ritz0's row (jump_in_awaiting_operand): ritz1's operand `if` is
        # the inline form, whose arms hold no `break`, so it can't reach here.
        var jm: String = string_new()
        jm.push_str("`break` / `continue` inside an expression of an async fn's loop that awaits is not supported yet (AGAST #4013)")
        al_refuse(a, @&jm, jump.span)
        return
    var t: AlLocal
    if al_if_type(a, e, @t) == 0
        var m: String = string_new()
        m.push_str("cannot infer the type of the `if`'s value, which `")
        m.push_span(Span<u8> { ptr: a.f.name.ptr, len: (a.f.name.len) as i64 })
        m.push_str("`'s future holds across an `await`: cast an arm (`x as i32`)")
        al_refuse(a, @&m, e.span)
        return
    al_hoist_walk(a, e.left, "")
    let tmp: StrView = al_numbered("__if_", a.nifs)
    a.nifs += 1
    al_if_type(a, e, al_extra(a, tmp))
    let cond: *Expr = al_rw_expr(a, e.left)
    cond.next = null
    let then_arm: *MatchArm = e.args as *MatchArm
    let then_b: *AlBlock = al_new_block(a)
    let else_b: *AlBlock = al_new_block(a)
    let join: *AlBlock = al_new_block(a)
    al_branch(a, cond, then_b, else_b, e.span)
    var d: AlDest = al_dest(AL_TO_FIELD, e.span)
    d.name = tmp
    a.cur = then_b
    al_lower_arm(a, then_arm, @d, null)
    if a.cur != null
        al_goto(a, join, e.span)
    a.cur = else_b
    al_lower_arm(a, then_arm.next, @d, null)
    if a.cur != null
        al_goto(a, join, e.span)
    a.cur = join
    al_add_point(a, e, tmp)

# `await inner` into `d`: a resume point.  An async fn's call builds its
# future into a field once, and the resume state polls it until it answers
# true (R78), so a Pending one is polled again on the next poll, not rebuilt;
# then it reads the future's `__result`.  Anything else awaited is a
# hand-written poll source, an `Option<T>` evaluated again at each poll
# until it is `Some(v)`, and the await is `v`: any T, an i32's -1 and -4096
# among them (AGAST #4558), T from the callee's declared type (#4604).
fn al_lower_await(a: *AlFn, aw: *Expr, d: *AlDest)
    let k: i32 = a.nawaits
    a.nawaits += 1
    let span: SrcSpan = aw.span
    let inner: *Expr = aw.operand
    let g: *AlAsync = al_call_of_async(inner)
    if g != null
        let fut: StrView = al_numbered("__future_", k)
        let fut_ty: StrView = al_future_struct_name(g.name)
        al_set_struct(al_extra(a, fut), fut_ty)
        let args: *Expr = al_hoist_list(a, inner.args)
        # The user's call of g, at its own span: a private g of another file
        # is refused here (#3925).  g$poll is the compiler's own call.
        al_emit(a, al_assign_self(fut, al_call(g.name, args, inner.span), span))
        let poll: StrView = al_poll_fn_name(g.name)
        let addr: *Expr = al_expr(ExprKind.Unary, span)
        addr.op = OpKind.Addr
        addr.operand = al_self_field(fut, span)
        let resume: *AlBlock = al_new_block(a)
        al_goto(a, resume, span)
        a.cur = resume
        al_emit(a, al_if(al_poll_not_ready(al_call(poll, addr, span)), al_poll_pending_stmt(span), span))
        if g.f.return_type == TypeKind.Void
            # A unit fn's future has no result to deliver.
            if d.kind == AL_TO_NONE
                return
            if d.kind == AL_TO_RETURN and a.f.return_type == TypeKind.Void
                al_ret(a, null, span)
                return
            al_no_value(a, g, span)
            return
        al_deliver(a, al_result_of(al_self_field(fut, span), span), d)
        return
    # `await p`, p a held future (R79): its future already lives in a field of
    # ours (`self.p`), so the resume state polls it in place; one already
    # finished answers true at once and only its `__result` is read.
    let held: *AlAsync = al_held_async(a, inner)
    if held != null
        let hpoll: StrView = al_poll_fn_name(held.name)
        let haddr: *Expr = al_expr(ExprKind.Unary, span)
        haddr.op = OpKind.Addr
        haddr.operand = al_self_field(inner.ident, span)
        let hresume: *AlBlock = al_new_block(a)
        al_goto(a, hresume, span)
        a.cur = hresume
        al_emit(a, al_if(al_poll_not_ready(al_call(hpoll, haddr, span)), al_poll_pending_stmt(span), span))
        if held.f.return_type == TypeKind.Void
            if d.kind == AL_TO_NONE
                return
            if d.kind == AL_TO_RETURN and a.f.return_type == TypeKind.Void
                al_ret(a, null, span)
                return
            al_no_value(a, held, span)
            return
        al_deliver(a, al_result_of(al_self_field(inner.ident, span), span), d)
        return
    # The source's own `Option<T>` (AGAST #4604): the analysis refused one
    # no declaration types.
    let src: *FnDef = al_source_fn(a, inner)
    var src_ty: StrView = "Option$i32"
    if src != null and src.return_type_name.ptr != null
        src_ty = src.return_type_name
    let answer: StrView = al_numbered("__poll_", k)
    let polled: *Expr = al_hoist(a, inner)
    polled.next = null
    let resume: *AlBlock = al_new_block(a)
    al_goto(a, resume, span)
    a.cur = resume
    al_emit(a, al_decl(answer, TypeKind.Struct, src_ty, polled, 1, a.file, span))
    al_emit(a, al_if(al_poll_source_is_pending(al_ident(answer, span)), al_poll_pending_stmt(span), span))
    al_deliver(a, al_poll_source_value(al_ident(answer, span)), d)

fn al_deliver(a: *AlFn, v: *Expr, d: *AlDest)
    v.next = null
    if d.kind == AL_TO_NONE
        # A value nobody reads: kept only for its effects.
        if v.kind != ExprKind.IntLit and v.kind != ExprKind.Member and v.kind != ExprKind.Ident
            al_emit(a, al_expr_stmt(v))
    else if d.kind == AL_TO_RETURN
        if a.f.return_type == TypeKind.Void
            var none: AlDest = al_dest(AL_TO_NONE, v.span)
            al_deliver(a, v, @none)
        al_ret(a, v, v.span)
    else if d.kind == AL_TO_FIELD
        al_emit(a, al_assign_self(d.name, v, d.span))
    else if d.kind == AL_TO_RESULT
        # A Ready's value store on its own; the defers and the finish follow.
        al_emit(a, al_assign_self("__result", v, d.span))
    else
        let s: *Stmt = al_copy_stmt(d.stmt)
        s.assign_value = v
        al_emit(a, s)

# A then/else arm of an ExprKind.If: its statements, then its value.
fn al_lower_arm(a: *AlFn, arm: *MatchArm, d: *AlDest, lp: *AlLoop)
    # The arm is a block: statements, then its value, then its defers.
    let saved: *AlDefer = a.defers
    var cur: *Stmt = arm.body_stmts
    while cur != null
        let nxt: *Stmt = cur.next
        al_lower_stmt(a, cur, lp)
        cur = nxt
    if arm.body != null and arm.is_pass == 0
        al_lower_value(a, arm.body, d, lp)
    else if d.kind == AL_TO_RETURN and a.cur != null
        al_ret(a, null, d.span)
    if a.cur != null
        al_run_defers(a, saved)
    a.defers = saved

# Evaluate `e` into `d`.
fn al_lower_value(a: *AlFn, e: *Expr, d: *AlDest, lp: *AlLoop)
    if al_needs_expr(e, lp) == 0 and (e.kind != ExprKind.Match or al_arms_need(a, e.args as *MatchArm, lp) == 0)
        al_deliver(a, al_rw_expr(a, e), d)
    else if e.kind == ExprKind.If
        let cond: *Expr = al_hoist(a, e.left)
        let then_arm: *MatchArm = e.args as *MatchArm
        let then_b: *AlBlock = al_new_block(a)
        let else_b: *AlBlock = al_new_block(a)
        let join: *AlBlock = al_new_block(a)
        al_branch(a, cond, then_b, else_b, e.span)
        a.cur = then_b
        al_lower_arm(a, then_arm, d, lp)
        if a.cur != null
            al_goto(a, join, e.span)
        a.cur = else_b
        if then_arm.next != null
            al_lower_arm(a, then_arm.next, d, lp)
        if a.cur != null
            al_goto(a, join, e.span)
        a.cur = join
    else if e.kind == ExprKind.Match and al_arms_need(a, e.args as *MatchArm, lp) == 1
        al_lower_match(a, e.left, e.args as *MatchArm, d, lp, e.span)
    else if e.kind == ExprKind.Await
        al_lower_await(a, e, d)
    else
        al_deliver(a, al_hoist(a, e), d)

# An `if` statement; with `d`, each branch's last statement is its value.
fn al_lower_if(a: *AlFn, s: *Stmt, d: *AlDest, lp: *AlLoop)
    let cond: *Expr = al_hoist(a, s.if_cond)
    let then_b: *AlBlock = al_new_block(a)
    let else_b: *AlBlock = al_new_block(a)
    let join: *AlBlock = al_new_block(a)
    al_branch(a, cond, then_b, else_b, s.span)
    a.cur = then_b
    al_lower_list(a, s.if_then, d, lp)
    if a.cur != null
        al_goto(a, join, s.span)
    a.cur = else_b
    al_lower_list(a, s.if_else, d, lp)
    if a.cur != null
        al_goto(a, join, s.span)
    a.cur = join

# `while cond` (`loop`: cond null): the condition's awaits re-run each pass.
fn al_lower_while(a: *AlFn, cond: *Expr, body: *Stmt, span: SrcSpan)
    let head: *AlBlock = al_new_block(a)
    al_goto(a, head, span)
    a.cur = head
    var c: *Expr = null
    if cond == null
        c = al_true(span)
    else
        c = al_hoist(a, cond)
    let body_b: *AlBlock = al_new_block(a)
    let exit_b: *AlBlock = al_new_block(a)
    al_branch(a, c, body_b, exit_b, span)
    a.cur = body_b
    var lp: AlLoop
    lp.head = head
    lp.exit = exit_b
    lp.defers = a.defers
    var none: AlDest = al_dest(AL_TO_NONE, span)
    al_lower_list(a, body, @none, @lp)
    if a.cur != null
        al_goto(a, head, span)
    a.cur = exit_b

# `5` or `-5`: a literal that takes the other operand's type (LARB R21).
fn al_untyped_int(e: *Expr) -> i32
    var x: *Expr = e
    if x.kind == ExprKind.Unary and x.op == OpKind.Neg
        x = x.operand
    (x.kind == ExprKind.IntLit and x.lit_kind == LIT_PLAIN) as i32

# An awaiting `for`'s var's type, into `l`: its start's, unless that is a
# bare literal (`0..n`) or untold; then its end's.  0 if neither tells.
# ritz0's _CfgBuilder._for_type.
fn al_for_type(a: *AlFn, s: *Stmt, l: *AlLocal) -> i32
    if al_untyped_int(s.for_start) == 0 and al_infer(a, s.for_start, l) == 1
        return 1
    al_infer(a, s.for_end, l)

# `for v in a..b` (#4188): v and the end are future fields, `__for_K` and
# `__for_end_K`, the end evaluated once; then a `while __for_K < __for_end_K`
# whose `continue` goes to the increment.  ritz0's _CfgBuilder._lower_for.
fn al_lower_for(a: *AlFn, s: *Stmt)
    let span: SrcSpan = s.span
    if s.for_end == null
        al_unplaced(a, "a `for` over an iterable", al_culprit(s))
        return
    var t: AlLocal
    if al_for_type(a, s, @t) == 0
        var m: String = string_new()
        m.push_str("cannot infer the type of `")
        m.push_span(Span<u8> { ptr: s.for_var.ptr, len: (s.for_var.len) as i64 })
        m.push_str("`, which `")
        m.push_span(Span<u8> { ptr: a.f.name.ptr, len: (a.f.name.len) as i64 })
        m.push_str("`'s future holds across an `await`: cast a bound of its range (`0..(n as i64)`)")
        al_refuse(a, @&m, span)
        return
    let k: i32 = a.nfors
    a.nfors += 1
    let var_f: StrView = al_numbered("__for_", k)
    let end_f: StrView = al_numbered("__for_end_", k)
    al_for_type(a, s, al_extra(a, var_f))
    al_for_type(a, s, al_extra(a, end_f))
    let start: *Expr = al_hoist(a, s.for_start)
    start.next = null
    al_emit(a, al_assign_self(var_f, start, span))
    let end: *Expr = al_hoist(a, s.for_end)
    end.next = null
    al_emit(a, al_assign_self(end_f, end, span))
    let head: *AlBlock = al_new_block(a)
    al_goto(a, head, span)
    a.cur = head
    var op: OpKind = OpKind.Lt
    if s.for_inclusive == 1
        op = OpKind.Le
    let cond: *Expr = al_binary(op, al_self_field(var_f, span), al_self_field(end_f, span))
    let body_b: *AlBlock = al_new_block(a)
    let incr: *AlBlock = al_new_block(a)
    let exit_b: *AlBlock = al_new_block(a)
    al_branch(a, cond, body_b, exit_b, span)
    a.cur = body_b
    let r: *AlRename = al_zalloc(sizeof(AlRename)) as *AlRename
    r.name = s.for_var
    r.field = var_f
    r.next = a.renames
    a.renames = r
    var lp: AlLoop
    lp.head = incr
    lp.exit = exit_b
    lp.defers = a.defers
    var none: AlDest = al_dest(AL_TO_NONE, span)
    al_lower_list(a, s.for_body, @none, @lp)
    a.renames = r.next
    if a.cur != null
        al_goto(a, incr, span)
    a.cur = incr
    let step: *Expr = al_binary(OpKind.Add, al_self_field(var_f, span), al_int(1, span))
    al_emit(a, al_assign_self(var_f, step, span))
    al_goto(a, head, span)
    a.cur = exit_b

# Does an arm of a `match` await, jump out of the loop `lp`, or return while
# a defer is active?
fn al_arms_need(a: *AlFn, arm: *MatchArm, lp: *AlLoop) -> i32
    if al_await_in_arms(arm) != null
        return 1
    if lp != null and al_jump_in_arms(arm) != null
        return 1
    if a.defers != null and al_return_in_arms(arm) == 1
        return 1
    0

fn al_hide(a: *AlFn, name_sv: StrView)
    let r: *AlRename = al_zalloc(sizeof(AlRename)) as *AlRename
    r.name = name_sv
    r.next = a.renames
    a.renames = r

# The names `arm`'s pattern binds, hidden from the rewrite (they are the
# arm's, not a field or a `for` var); how many.  A bare name may be a unit
# variant (`None`), which ritz0's parser can't tell either: it counts.
# ritz0's _pattern_names.
fn al_arm_names(a: *AlFn, arm: *MatchArm) -> i32
    if arm.pattern_kind == PAT_IDENT and arm.qualifier.ptr == null
        al_hide(a, arm.pattern_name)
        return 1
    if arm.pattern_kind != PAT_VARIANT
        return 0
    if arm.pattern_binds == null
        if arm.pattern_inner_kind != PAT_IDENT
            return 0
        al_hide(a, arm.pattern_inner_name)
        return 1
    var n: i32 = 0
    var t: *TupleName = arm.pattern_binds
    while t != null
        let c0: u8 = *(t.name.ptr)
        if t.name.len != 1 or c0 != '_'   # `_`: a wildcard slot
            al_hide(a, t.name)
            n += 1
        t = t.next
    n

fn al_copy_arm(arm: *MatchArm) -> *MatchArm
    let c: *MatchArm = al_zalloc(sizeof(MatchArm)) as *MatchArm
    let src: *u8 = arm as *u8
    let dst: *u8 = c as *u8
    var i: i64 = 0
    while i < sizeof(MatchArm)
        *(dst + i) = *(src + i)
        i += 1
    c.next = null
    c

# `arms`' patterns over `scrut`, arm `sel` running `body` (the others
# nothing): the same patterns, so the same arm is taken and the match stays
# exhaustive.  Arm `j` of a dispatch (`sel` -1) jumps to state `entries[j]`.
fn al_rematch(arms: *MatchArm, scrut: *Expr, sel: i32, body: *Stmt, entries: **AlBlock, span: SrcSpan) -> *Stmt
    var head: *MatchArm = null
    var last: *MatchArm = null
    var j: i32 = 0
    var cur: *MatchArm = arms
    while cur != null
        let c: *MatchArm = al_copy_arm(cur)
        c.body = null
        c.is_pass = 1
        c.is_block = 1
        c.body_stmts = null
        if sel < 0
            let to: *AlBlock = *(entries + j)
            c.body_stmts = al_set_state(to.idx, span)
        else if j == sel
            c.body_stmts = body
        if last == null
            head = c
        else
            last.next = c
        last = c
        j += 1
        cur = cur.next
    let s: *Stmt = al_stmt(StmtKind.Match, span)
    s.if_cond = scrut
    s.if_then = head as *Stmt
    s

# A `match` whose arms await, or jump out of the loop (#4189): each arm is a
# state, entered by matching the scrutinee once.  ritz0's
# _CfgBuilder._lower_match.
#
# An arm's names are bound by the match, which a later state of the arm
# doesn't run.  When an arm binds one, the scrutinee is a future field,
# `__match_K`, and each of that arm's states runs inside a match of it over
# the same patterns (a pattern binds no `mut` name and has no guard, so the
# same arm is taken with the same values):
#
#     __match_K = scrutinee
#     match __match_K { p0 => -> A0, p1 => -> A1 }
#   A1: match __match_K { p0 => {}, p1 => { ...A1's statements } }
fn al_lower_match(a: *AlFn, scrut: *Expr, arms: *MatchArm, d: *AlDest, lp: *AlLoop, span: SrcSpan)
    var binds: i32 = 0
    var narms: i32 = 0
    let saved: *AlRename = a.renames
    var cur: *MatchArm = arms
    while cur != null
        binds += al_arm_names(a, cur)
        narms += 1
        cur = cur.next
    a.renames = saved
    # Its type is told before the hoist rewrites it.
    var t: AlLocal
    var typed: i32 = 0
    if binds > 0
        typed = al_infer(a, scrut, @t)
    let at: SrcSpan = scrut.span
    var sc: *Expr = al_hoist(a, scrut)
    sc.next = null
    var field: StrView = strview_empty()
    if binds > 0
        if typed == 0
            var m: String = string_new()
            m.push_str("cannot infer the type of the `match`'s scrutinee, which `")
            m.push_span(Span<u8> { ptr: a.f.name.ptr, len: (a.f.name.len) as i64 })
            m.push_str("`'s future holds across an `await`: match a typed local (`let v: T = ...`)")
            al_refuse(a, @&m, at)
            return
        field = al_numbered("__match_", a.nmatches)
        a.nmatches += 1
        let x: *AlLocal = al_extra(a, field)
        x.ty = t.ty
        x.type_name = t.type_name
        x.pointee = t.pointee
        x.inner_pointee = t.inner_pointee
        x.inner_ref = t.inner_ref
        x.unsupported = t.unsupported
        al_emit(a, al_assign_self(field, sc, span))
        sc = al_self_field(field, span)
    let entries: **AlBlock = al_zalloc((narms as i64) * 8) as **AlBlock
    var j: i32 = 0
    while j < narms
        *(entries + j) = al_new_block(a)
        j += 1
    let join: *AlBlock = al_new_block(a)
    al_emit(a, al_rematch(arms, sc, -1, null, entries, span))
    al_emit(a, al_stmt(StmtKind.Continue, span))
    al_close(a)
    j = 0
    cur = arms
    while cur != null
        let first: i32 = a.nblocks
        a.cur = *(entries + j)
        let named: i32 = al_arm_names(a, cur)
        al_lower_arm(a, cur, d, lp)
        a.renames = saved
        if a.cur != null
            al_goto(a, join, span)
        if named > 0
            # A nested match's states are wrapped already: this match goes
            # around, so its names are in scope there too.
            var b: *AlBlock = a.blocks
            while b != null
                if b == *(entries + j) or b.idx >= first
                    b.head = al_rematch(arms, al_self_field(field, span), j, b.head, entries, span)
                b = b.next
        j += 1
        cur = cur.next
    a.cur = join

# The statements `s`; with `d`, the last one is the list's value.  It is a
# block: its fall-through exit runs its defers (AGAST #4191).
fn al_lower_list(a: *AlFn, s: *Stmt, d: *AlDest, lp: *AlLoop)
    let saved: *AlDefer = a.defers
    var cur: *Stmt = s
    while cur != null
        let nxt: *Stmt = cur.next
        if nxt == null and d.kind != AL_TO_NONE
            al_lower_tail(a, cur, d, lp)
        else
            al_lower_stmt(a, cur, lp)
        cur = nxt
    if a.cur != null
        al_run_defers(a, saved)
    a.defers = saved

fn al_lower_tail(a: *AlFn, s: *Stmt, d: *AlDest, lp: *AlLoop)
    if s.kind == StmtKind.Expr
        al_lower_value(a, s.expr, d, lp)
        return
    if s.kind == StmtKind.If and s.if_else != null
        al_lower_if(a, s, d, lp)
        return
    if s.kind == StmtKind.Match and al_arms_need(a, s.if_then as *MatchArm, lp) == 0
        # Its arms' values go to `d` in place (its scrutinee's awaits first).
        s.if_cond = al_hoist(a, s.if_cond)
        al_rw_arms(a, s.if_then as *MatchArm)
        let open: i32 = al_deliver_arms(a, s.if_then as *MatchArm, d)
        al_emit(a, s)
        if d.kind == AL_TO_RETURN and a.cur != null
            if open == 0
                al_close(a)   # every arm is Ready: nothing follows (#4189)
            else
                al_ret(a, null, s.span)
        return
    if s.kind == StmtKind.Match
        al_lower_match(a, s.if_cond, s.if_then as *MatchArm, d, lp, s.span)
        return
    al_lower_stmt(a, s, lp)
    if d.kind == AL_TO_RETURN and a.cur != null
        al_ret(a, null, s.span)

# Each arm's value `v` becomes the statement that puts it in `d`; how many
# arms have none.
fn al_deliver_arms(a: *AlFn, arm: *MatchArm, d: *AlDest) -> i32
    var open: i32 = 0
    var cur: *MatchArm = arm
    while cur != null
        if cur.body != null and cur.is_pass == 0
            let held: *AlBlock = a.cur
            let tmp: *AlBlock = al_zalloc(sizeof(AlBlock)) as *AlBlock
            a.cur = tmp
            al_deliver(a, cur.body, d)
            a.cur = held
            cur.body_stmts = al_append(cur.body_stmts, tmp.head)
            cur.body = null
            cur.is_pass = 1
        else
            open += 1
        cur = cur.next
    open

fn al_lower_stmt(a: *AlFn, s: *Stmt, lp: *AlLoop)
    let k: StmtKind = s.kind
    if k == StmtKind.Defer
        # Nothing runs at the `defer`: its body runs at each exit of this
        # block, which al_run_defers places on every edge (AGAST #4191).
        let aw: *Expr = al_await_in_stmts(s.while_body)
        if aw != null
            var m: String = string_new()
            m.push_str("`await` inside a `defer` in an async fn is not supported yet (AGAST #4013)")
            al_refuse(a, @&m, aw.span)
            return
        al_add_defer(a, al_rw_stmts(a, s.while_body))
        return
    if al_needs(a, s, lp) == 0
        s.next = null
        al_emit_all(a, al_rw_stmt(a, s))
        if k == StmtKind.Return
            al_close(a)
        return
    match k
        StmtKind.VarDecl =>
            var d: AlDest = al_dest(AL_TO_FIELD, s.span)
            d.name = s.var_name
            al_lower_value(a, s.var_init, @d, lp)
        StmtKind.Assign | StmtKind.MemberAssign | StmtKind.MemberIndexAssign | StmtKind.IndexAssign | StmtKind.LocalFieldAssign | StmtKind.LocalFieldIndexAssign =>
            al_rw_target(a, s, 1)
            var d: AlDest = al_dest(AL_TO_ASSIGN, s.span)
            d.stmt = s
            al_lower_value(a, s.assign_value, @d, lp)
        StmtKind.Return =>
            if s.return_value == null
                al_ret(a, null, s.span)
            else
                var d: AlDest = al_dest(AL_TO_RETURN, s.span)
                al_lower_value(a, s.return_value, @d, lp)
        StmtKind.Expr =>
            var d: AlDest = al_dest(AL_TO_NONE, s.span)
            al_lower_value(a, s.expr, @d, lp)
        StmtKind.If =>
            var d: AlDest = al_dest(AL_TO_NONE, s.span)
            al_lower_if(a, s, @d, lp)
        StmtKind.While =>
            al_lower_while(a, s.while_cond, s.while_body, s.span)
        StmtKind.Loop =>
            al_lower_while(a, null, s.while_body, s.span)
        StmtKind.Break =>
            al_run_defers(a, lp.defers)
            al_goto(a, lp.exit, s.span)
        StmtKind.Continue =>
            al_run_defers(a, lp.defers)
            al_goto(a, lp.head, s.span)
        StmtKind.Unsafe =>
            var d: AlDest = al_dest(AL_TO_NONE, s.span)
            al_lower_list(a, s.while_body, @d, lp)
        _ =>
            if k == StmtKind.Match and al_arms_need(a, s.if_then as *MatchArm, lp) == 1
                var d: AlDest = al_dest(AL_TO_NONE, s.span)
                al_lower_match(a, s.if_cond, s.if_then as *MatchArm, @d, lp, s.span)
            else
                match k
                    StmtKind.Match =>
                        # Only its scrutinee awaits: the match runs whole, after it.
                        s.if_cond = al_hoist(a, s.if_cond)
                        al_rw_arms(a, s.if_then as *MatchArm)
                        al_emit(a, s)
                    StmtKind.For =>
                        al_lower_for(a, s)
                    _ =>
                        al_unplaced(a, "this statement", al_culprit(s))

# The poll's body: `while true` over `if self.__state == N` for each state.
fn al_dispatch(a: *AlFn, span: SrcSpan) -> *Stmt
    var arms: *Stmt = null
    var b: *AlBlock = a.blocks
    while b != null
        var body: *Stmt = b.head
        if b.closed == 0
            body = al_append(body, al_poll_pending_stmt(span))   # unreachable
        let cond: *Expr = al_binary(OpKind.Eq, al_self_field("__state", span), al_int(b.idx as i64, span))
        arms = al_append(arms, al_if(cond, body, span))
        b = b.next
    # It never ends (no `break`), so nothing follows it: ritz1 knows a `while
    # true` diverges, and would refuse anything after it as unreachable.
    let w: *Stmt = al_stmt(StmtKind.While, span)
    w.while_cond = al_true(span)
    w.while_body = arms
    w

# ---------------------------------------------------------------------------
# The future, its constructor and its poll
# ---------------------------------------------------------------------------

fn al_field_of(l: *AlLocal) -> *StructField
    let f: *StructField = al_zalloc(sizeof(StructField)) as *StructField
    f.name = l.name
    f.field_type = l.ty
    f.ptr_pointee = TypeKind.Void
    f.inner_pointee_type = l.inner_pointee
    f.field_inner_ref = l.inner_ref
    # As field_new: a struct, or a pointer to one, is named; a primitive
    # pointee is recorded in array_elem_type (#1304), which `p + i` strides by.
    match l.ty
        TypeKind.Struct =>
            f.field_type_name = l.type_name
        TypeKind.Ptr =>
            f.ptr_pointee = l.pointee
            if l.pointee == TypeKind.Struct
                f.field_type_name = l.type_name
            else
                f.array_elem_type = l.pointee
        _ =>
            if l.ty == TypeKind.PtrPtr and l.type_name.len > 0
                f.field_type_name = l.type_name
    f

# The signature every generated future's header poll fn has: `fn(*u8) -> bool`.
fn al_poll_sig(orig: *FnDef) -> *FnDef
    let p: *Param = al_zalloc(sizeof(Param)) as *Param
    p.name = "f"
    p.param_type = TypeKind.Ptr
    p.param_pointee_type = TypeKind.U8
    al_fn(orig, strview_empty(), p, TypeKind.Bool, strview_empty(), null)

# `struct <f>$Future { __poll, __state, __result, params in order, the other
# locals by name }` -- R79's header first, poll fn pointer, then R78's state
# and result.
fn al_future_struct(a: *AlFn, name_sv: StrView) -> *StructDef
    var len: i32 = name_sv.len as i32
    let poll: *StructField = al_zalloc(sizeof(StructField)) as *StructField
    poll.name = "__poll"
    poll.field_type = TypeKind.Ptr
    poll.ptr_pointee = TypeKind.Void
    poll.fn_sig = al_poll_sig(a.f)
    let head: *StructField = poll
    var last: *StructField = head
    var state: AlLocal
    state.name = "__state"
    al_set_scalar(@state, TypeKind.I32)
    last.next = al_field_of(@state)
    last = last.next
    var res: AlLocal
    res.name = "__result"
    if al_set_ret(@res, a.f) == 1
        # Where the poll leaves its value (LARB R78).
        last.next = al_field_of(@res)
        last = last.next
    var l: *AlLocal = a.locals
    while l != null
        if l.is_param == 1
            last.next = al_field_of(l)
            last = last.next
        l = l.next
    if a.npoints > 0
        var placed: *AlLocal = null   # the last one placed, in name order
        var more: i32 = 1
        while more == 1
            # The least name above `placed`: a selection sort, with no list
            # surgery on a.locals.
            var best: *AlLocal = null
            var c: *AlLocal = a.locals
            while c != null
                if c.is_param == 0 and c.poll_ok != 1 and (placed == null or al_less(placed.name, c.name) == 1)
                    if best == null or al_less(c.name, best.name) == 1
                        best = c
                c = c.next
            if best == null
                more = 0
            else
                last.next = al_field_of(best)
                last = last.next
                placed = best
    # Then the state machine's own: await results and awaited futures.
    var x: *AlLocal = a.extra
    while x != null
        last.next = al_field_of(x)
        last = last.next
        x = x.next
    let s: *StructDef = al_zalloc(sizeof(StructDef)) as *StructDef
    s.name = name_sv
    s.fields = head
    s

# `fn <ctor>(params) -> <f>$Future`: `<f>$Future { __poll: <poll>, __state:
# 0, p: p, .. }`; a local's field is left out, so zero, as ritz0 sets it.
fn al_constructor(a: *AlFn, name_sv: StrView, fut_sv: StrView, poll_sv: StrView) -> *FnDef
    let f: *FnDef = a.f
    let span: SrcSpan = SrcSpan { line: f.line, col: f.col }
    let head: *FieldInit = al_zalloc(sizeof(FieldInit)) as *FieldInit
    head.name = "__poll"
    head.value = al_ident(poll_sv, span)
    let state: *FieldInit = al_zalloc(sizeof(FieldInit)) as *FieldInit
    state.name = "__state"
    state.value = al_int(0, span)
    head.next = state
    var last: *FieldInit = state
    var p: *Param = f.params
    while p != null
        let fi: *FieldInit = al_zalloc(sizeof(FieldInit)) as *FieldInit
        fi.name = p.name
        fi.value = al_ident(p.name, span)
        last.next = fi
        last = fi
        p = p.next
    let lit: *Expr = al_expr(ExprKind.StructLit, span)
    lit.ident = fut_sv
    lit.args = head as *Expr
    al_fn(f, name_sv, f.params, TypeKind.Struct, fut_sv, al_expr_stmt(lit))

# The body with an await, as states; state 0 is its entry.
fn al_lower_body(a: *AlFn, span: SrcSpan)
    a.cur = al_new_block(a)
    var d: AlDest = al_dest(AL_TO_RETURN, span)
    al_lower_list(a, a.f.body, @d, null)
    if a.cur != null
        al_ret(a, null, span)   # off the end: a unit fn's Ready

# `fn <f>$poll(self: *<f>$Future) -> bool`
fn al_poll(a: *AlFn, name_sv: StrView, fut_sv: StrView) -> *FnDef
    let f: *FnDef = a.f
    let span: SrcSpan = SrcSpan { line: f.line, col: f.col }
    var body: *Stmt = null
    if a.npoints == 0
        # The whole body is the poll, its params read through `self`.  It
        # always finishes in this call, so mark it done before it runs (R79):
        # a later poll answers true at once, without running the body again.
        body = al_ready_tail(a, al_rw_stmts(a, f.body), span)
        let fin: *Stmt = al_assign_self("__state", al_pending(span), span)
        fin.next = body
        body = fin
    else
        al_lower_body(a, span)
        body = al_dispatch(a, span)
    # R79's finished guard, first of all: a poll of a finished future is true
    # at once and runs nothing.
    let guard: *Stmt = al_if(al_state_is_done(al_self_field("__state", span)), al_return(al_true(span), span), span)
    guard.next = body
    body = guard
    let self_p: *Param = al_zalloc(sizeof(Param)) as *Param
    self_p.name = "self"
    self_p.param_type = TypeKind.Ptr
    self_p.param_type_name = fut_sv
    self_p.param_pointee_type = TypeKind.Struct
    self_p.name_span = span
    let poll: *FnDef = al_fn(f, name_sv, self_p, TypeKind.Bool, strview_empty(), body)
    # A private async fn is refused once, at the call of its constructor:
    # cc_private skips a fn with no file.  (Not from_generated, which would
    # make a pub poll weak_odr.)  A local poll's file is the input's anyway.
    poll.def_file = strview_empty()
    poll

# Analyse async fn `f`; 0, or the errors it reported.
fn al_analyse(a: *AlFn) -> i32
    let f: *FnDef = a.f
    var res: AlLocal
    if f.return_type != TypeKind.Void and al_set_ret(@res, f) == 0
        diag_error_name(a.file, diag_span(f.line, f.col), "ritz1 can't yet hold `", f.name, "`'s result type in a future: an array, reference or fn type")
        return 1
    var p: *Param = f.params
    while p != null
        al_local_of_param(a, p)
        p = p.next
    al_an_stmts(a, f.body, 1)
    # A poll source refused as the walk met it (AGAST #4604), as ritz0's
    # analyzer raises there, before any local's error.
    if a.errs > 0
        return a.errs
    if a.npoints > 0
        # Which locals may stay poll locals rather than future fields.
        al_mark_walk_stmts(a, f.body, 0)
    if a.npoints == 0
        # Only the params are fields.
        var errs: i32 = 0
        var l: *AlLocal = a.locals
        while l != null
            if l.is_param == 1 and l.unsupported == 1
                diag_error_name(a.file, l.span, "ritz1 can't yet hold `", l.name, "`'s type in a future: an array, reference or fn type")
                errs += 1
            l = l.next
        return errs
    # With an await every local is a field of the future, which needs its
    # type (#3762).
    if a.untyped != null
        let s: *Stmt = a.untyped
        var m: String = string_new()
        m.push_str("cannot infer the type of `")
        m.push_span(Span<u8> { ptr: s.var_name.ptr, len: (s.var_name.len) as i64 })
        m.push_str("`, which `")
        m.push_span(Span<u8> { ptr: f.name.ptr, len: (f.name.len) as i64 })
        m.push_str("`'s future holds across an `await`: give `")
        m.push_span(Span<u8> { ptr: s.var_name.ptr, len: (s.var_name.len) as i64 })
        m.push_str("` a type (`let ")
        m.push_span(Span<u8> { ptr: s.var_name.ptr, len: (s.var_name.len) as i64 })
        m.push_str(": T = ...`)")
        diag_error_buf(a.file, s.span, @m)
        return 1
    var errs: i32 = 0
    var l: *AlLocal = a.locals
    while l != null
        if l.unsupported == 1
            diag_error_name(a.file, l.span, "ritz1 can't yet hold `", l.name, "`'s type in a future: an array, reference or fn type")
            errs += 1
        l = l.next
    errs

# Lower async fn `f`: its future struct joins m's structs, and its
# constructor and poll (and for `main`, the sync wrapper) take its place in
# the fn list, after `prev` (null: at the head).  0, or the errors reported.
fn al_lower_fn(m: *Module, prev: *FnDef, f: *FnDef) -> i32
    var a: AlFn
    al_fn_init(@a, f, 0)
    if f.type_params != null
        diag_error_name(a.file, diag_span(f.line, f.col), "async fn '", f.name, "' is generic, which ritz1 can't lower to a state machine")
        return 1
    let errs: i32 = al_analyse(@a)
    if errs > 0
        return errs
    let fut: StrView = al_future_struct_name(f.name)
    let poll_name: StrView = al_poll_fn_name(f.name)
    # The poll first: its state machine adds fields to the future.
    let poll: *FnDef = al_poll(@a, poll_name, fut)
    if a.errs > 0
        return a.errs
    let st: *StructDef = al_future_struct(@a, fut)
    var sl: *StructDef = m.structs
    if sl == null
        m.structs = st
    else
        while sl.next != null
            sl = sl.next
        sl.next = st
    let is_main: i32 = al_eq(f.name, "main")
    var ctor: *FnDef = null
    if is_main == 1
        ctor = al_constructor(@a, "__main_future", fut, poll_name)
    else
        ctor = al_constructor(@a, f.name, fut, poll_name)
    ctor.next = poll
    poll.next = f.next
    if is_main == 1
        let span: SrcSpan = SrcSpan { line: f.line, col: f.col }
        var tail: i32 = AL_DRIVE_RESULT
        if f.return_type == TypeKind.Void
            tail = AL_DRIVE_ZERO
        let body: *Stmt = al_drive_body("__main_future", null, fut, poll_name, tail, span)
        let wrapper: *FnDef = al_fn(f, "main", null, TypeKind.I32, strview_empty(), body)
        wrapper.is_pub = 1
        poll.next = wrapper
        wrapper.next = f.next
    if prev == null
        m.functions = ctor
    else
        prev.next = ctor
    0

# ---------------------------------------------------------------------------
# LANGUAGE_SPEC §16.2: a bare call to an async fn
# ---------------------------------------------------------------------------

fn al_prim_name(t: TypeKind) -> StrView
    match t
        TypeKind.I8 =>
            return "i8"
        TypeKind.I16 =>
            return "i16"
        TypeKind.I32 =>
            return "i32"
        TypeKind.I64 =>
            return "i64"
        TypeKind.U8 =>
            return "u8"
        TypeKind.U16 =>
            return "u16"
        TypeKind.U32 =>
            return "u32"
        TypeKind.U64 =>
            return "u64"
        TypeKind.Bool =>
            return "bool"
        TypeKind.F32 =>
            return "f32"
        TypeKind.F64 =>
            return "f64"
        _ => pass
    strview_empty()

# A let's written type, as ritz0 formats it in the message.
fn al_push_type(m: @&String, s: *Stmt)
    let t: TypeKind = s.var_declared_type
    match t
        TypeKind.Struct =>
            m.push_span(Span<u8> { ptr: s.var_type_name.ptr, len: (s.var_type_name.len) as i64 })
            return
        TypeKind.Ptr =>
            m.push_str("*")
            if s.var_pointee_type == TypeKind.Struct
                m.push_span(Span<u8> { ptr: s.var_type_name.ptr, len: (s.var_type_name.len) as i64 })
                return
            let pn: StrView = al_prim_name(s.var_pointee_type)
            if pn.ptr != null
                m.push_span(Span<u8> { ptr: (pn.ptr), len: (pn.len) as i64 })
            return
        _ => pass
    let n: StrView = al_prim_name(t)
    if n.ptr != null
        m.push_span(Span<u8> { ptr: (n.ptr), len: (n.len) as i64 })

fn al_bare_call_error(file: StrView, call: *Expr) -> i32
    var m: String = string_new()
    m.push_str("calling async fn `")
    m.push_span(Span<u8> { ptr: call.func_name.ptr, len: (call.func_name.len) as i64 })
    m.push_str("` without `await` builds its future and drops it; its body never runs: write `await ")
    m.push_span(Span<u8> { ptr: call.func_name.ptr, len: (call.func_name.len) as i64 })
    m.push_str("(...)`")
    diag_error_buf(file, call.span, @m)
    1

fn al_typed_let_error(file: StrView, s: *Stmt, call: *Expr) -> i32
    var m: String = string_new()
    m.push_str("`")
    m.push_span(Span<u8> { ptr: s.var_name.ptr, len: (s.var_name.len) as i64 })
    m.push_str("` is declared `")
    al_push_type(@&m, s)
    m.push_str("` but `")
    m.push_span(Span<u8> { ptr: call.func_name.ptr, len: (call.func_name.len) as i64 })
    m.push_str("(...)` is an async fn call, which without `await` is its future: write `await ")
    m.push_span(Span<u8> { ptr: call.func_name.ptr, len: (call.func_name.len) as i64 })
    m.push_str("(...)`")
    diag_error_buf(file, s.span, @m)
    1

# The bare async calls of a statement list.  `value` is 1 when the list's
# last statement is the value of its fn (a `-> T` fn's tail, or an arm of one).
fn al_bare_stmts(file: StrView, s: *Stmt, value: i32) -> i32
    var errs: i32 = 0
    var cur: *Stmt = s
    while cur != null
        let tail: i32 = (value == 1 and cur.next == null) as i32
        let k: StmtKind = cur.kind
        match k
            StmtKind.Expr =>
                if tail == 0 and al_call_of_async(cur.expr) != null
                    errs += al_bare_call_error(file, cur.expr)
                else if cur.expr != null and (cur.expr.kind == ExprKind.If or cur.expr.kind == ExprKind.Match)
                    errs += al_bare_arms(file, cur.expr.args as *MatchArm, tail)
            StmtKind.VarDecl =>
                let g: *AlAsync = al_call_of_async(cur.var_init)
                if g != null and cur.var_declared_type != TypeKind.Void
                    let fut: StrView = al_future_struct_name(g.name)
                    # R79: a by-value `Future` is Sema's refusal, at the name.
                    let byval_future: i32 = (cur.var_declared_type == TypeKind.Struct and al_eq(cur.var_type_name, "Future") == 1) as i32
                    if byval_future == 0
                        if cur.var_declared_type != TypeKind.Struct or al_eq(cur.var_type_name, fut) == 0
                            errs += al_typed_let_error(file, cur, cur.var_init)
            StmtKind.If =>
                errs += al_bare_stmts(file, cur.if_then, tail)
                errs += al_bare_stmts(file, cur.if_else, tail)
            StmtKind.Match =>
                errs += al_bare_arms(file, cur.if_then as *MatchArm, tail)
            StmtKind.While | StmtKind.Loop | StmtKind.Defer | StmtKind.Unsafe =>
                errs += al_bare_stmts(file, cur.while_body, 0)
            StmtKind.For =>
                errs += al_bare_stmts(file, cur.for_body, 0)
            _ => pass
        cur = cur.next
    errs

fn al_bare_arms(file: StrView, arm: *MatchArm, value: i32) -> i32
    var errs: i32 = 0
    var cur: *MatchArm = arm
    while cur != null
        errs += al_bare_stmts(file, cur.body_stmts, (value == 1 and cur.body == null) as i32)
        cur = cur.next
    errs

fn al_bare_fn(f: *FnDef) -> i32
    if f.is_local != 1 or f.body == null
        return 0
    al_bare_stmts(g_al_path, f.body, (f.return_type != TypeKind.Void) as i32)

# Awaits in a sync fn: polled to completion in place.
# Answers the errors it reported (a poll source awaited there, AGAST #4558).
fn al_sync_fn(f: *FnDef) -> i32
    if f.body == null
        return 0
    var a: AlFn
    al_fn_init(@a, f, 1)
    # Its locals, so `await p` (p a held future, R79) knows p's future type.
    al_an_stmts(@a, f.body, 1)
    f.body = al_rw_stmts(@a, f.body)
    a.errs

# R79: the built-in `Future`, "some async fn's future", which only a
# reference can hold.  It is the futures' one header field, the poll fn
# pointer, so any `NAME$Future` fits an `@&Future` slot (Sema); and
# `future_poll(f: @&Future)` calls that header fn on the future f names.
#
# Only a module that names `Future` or calls `future_poll` gets them: the
# AST is otherwise exactly the source's, which the Sema probes compare.
fn al_future_name(name: StrView) -> i32
    al_eq(name, "Future")

# 1 when `e` or anything under it calls `future_poll`.
fn al_future_call(e: *Expr) -> i32
    if e == null
        return 0
    let k: ExprKind = e.kind
    if k == ExprKind.Call
        if e.func_name.ptr != null and e.func_name.len == 11
            if al_eq(e.func_name, "future_poll") == 1
                return 1
    var r: i32 = 0
    match k
        ExprKind.Binary | ExprKind.Range | ExprKind.Index =>
            r = al_future_call(e.left)
            if r == 0
                r = al_future_call(e.right)
        ExprKind.Unary =>
            r = al_future_call(e.operand)
        ExprKind.Call | ExprKind.Method =>
            if k == ExprKind.Method or e.func_name.ptr == null
                r = al_future_call(e.left)
            var arg: *Expr = e.args
            while arg != null and r == 0
                r = al_future_call(arg)
                arg = arg.next
        ExprKind.Member | ExprKind.Cast | ExprKind.Try | ExprKind.ArrayFill =>
            r = al_future_call(e.left)
        ExprKind.If | ExprKind.Match =>
            r = al_future_call(e.left)
            var arm: *MatchArm = e.args as *MatchArm
            while arm != null and r == 0
                r = al_future_call(arm.body)
                arm = arm.next
        ExprKind.StructLit =>
            var fi: *FieldInit = e.args as *FieldInit
            while fi != null and r == 0
                r = al_future_call(fi.value)
                fi = fi.next
        ExprKind.ArrayLit =>
            var el: *Expr = e.args
            while el != null and r == 0
                r = al_future_call(el)
                el = el.next
        _ => pass
    r

fn al_future_stmts(s: *Stmt) -> i32
    var cur: *Stmt = s
    while cur != null
        if al_future_stmt(cur) == 1
            return 1
        cur = cur.next
    0

# A statement's written `Future` slots and `future_poll` calls, its own and
# its children's.
fn al_future_stmt(s: *Stmt) -> i32
    let k: StmtKind = s.kind
    match k
        StmtKind.VarDecl =>
            if al_future_name(s.var_type_name) == 1
                return 1
            if s.var_array != null and al_future_name(s.var_array.name) == 1
                return 1
            return al_future_call(s.var_init)
        StmtKind.Expr =>
            return al_future_call(s.expr)
        StmtKind.Return =>
            return al_future_call(s.return_value)
        StmtKind.If =>
            if al_future_call(s.if_cond) == 1 or al_future_stmts(s.if_then) == 1
                return 1
            return al_future_stmts(s.if_else)
        StmtKind.While =>
            if al_future_call(s.while_cond) == 1
                return 1
            return al_future_stmts(s.while_body)
        StmtKind.For =>
            if al_future_call(s.for_start) == 1 or al_future_call(s.for_end) == 1
                return 1
            return al_future_stmts(s.for_body)
        StmtKind.Loop | StmtKind.Defer | StmtKind.Unsafe =>
            return al_future_stmts(s.while_body)
        StmtKind.Match =>
            if al_future_call(s.if_cond) == 1
                return 1
            var arm: *MatchArm = s.if_then as *MatchArm
            while arm != null
                if al_future_call(arm.body) == 1 or al_future_stmts(arm.body_stmts) == 1
                    return 1
                arm = arm.next
            return 0
        StmtKind.Assign | StmtKind.MemberAssign | StmtKind.MemberIndexAssign | StmtKind.IndexAssign | StmtKind.LocalFieldAssign | StmtKind.LocalFieldIndexAssign =>
            if k != StmtKind.IndexAssign and k != StmtKind.LocalFieldAssign and k != StmtKind.LocalFieldIndexAssign
                if al_future_call(s.if_cond) == 1
                    return 1
            if k != StmtKind.Assign and k != StmtKind.MemberAssign and k != StmtKind.LocalFieldAssign
                if al_future_call(s.while_cond) == 1
                    return 1
            return al_future_call(s.assign_value)
        StmtKind.Assert =>
            return al_future_call(s.if_cond)
        _ => pass
    0

fn al_future_fn(f: *FnDef) -> i32
    if al_future_name(f.return_type_name) == 1
        return 1
    if f.ret_array_param != null and al_future_name(f.ret_array_param.param_type_name) == 1
        return 1
    var p: *Param = f.params
    while p != null
        if al_future_name(p.param_type_name) == 1
            return 1
        p = p.next
    al_future_stmts(f.body)

fn al_future_used(m: *Module) -> i32
    var st: *StructDef = m.structs
    while st != null
        var fld: *StructField = st.fields
        while fld != null
            if al_future_name(fld.field_type_name) == 1 or al_future_name(fld.array_elem_type_name) == 1
                return 1
            fld = fld.next
        st = st.next
    var g: *GlobalVarDef = m.globals
    while g != null
        if al_future_name(g.type_name) == 1 or al_future_name(g.array_elem_type_name) == 1
            return 1
        g = g.next
    var f: *FnDef = m.functions
    while f != null
        if al_future_fn(f) == 1
            return 1
        f = f.next
    var ib: *ImplBlock = m.impls
    while ib != null
        var method: *FnDef = ib.methods
        while method != null
            if al_future_fn(method) == 1
                return 1
            method = method.next
        ib = ib.next
    0

fn al_inject_future(m: *Module)
    if al_future_used(m) == 0
        return
    var s: *StructDef = m.structs
    while s != null
        if al_eq(s.name, "Future") == 1
            return
        s = s.next
    let span: SrcSpan = SrcSpan { line: 1, col: 1 }
    var orig: FnDef
    orig.line = 1
    orig.col = 1
    orig.is_local = 1
    orig.is_pub = 0
    orig.def_file = strview_empty()
    orig.target_gated = 0
    let st: *StructDef = al_zalloc(sizeof(StructDef)) as *StructDef
    st.name = "Future"
    st.fields = al_zalloc(sizeof(StructField)) as *StructField
    st.fields.name = "__poll"
    st.fields.field_type = TypeKind.Ptr
    st.fields.ptr_pointee = TypeKind.Void
    st.fields.fn_sig = al_poll_sig(@orig)
    if m.structs == null
        m.structs = st
    else
        var last: *StructDef = m.structs
        while last.next != null
            last = last.next
        last.next = st
    # `fn future_poll(f: @&Future) -> bool`: `(f.__poll)(f)`; the header's fn
    # takes `*u8`, so the future's pointer is what is passed.
    let p: *Param = al_zalloc(sizeof(Param)) as *Param
    p.name = "f"
    p.param_type = TypeKind.Ptr
    p.param_pointee_type = TypeKind.Struct
    p.param_type_name = "Future"
    p.param_inner_ref = INNER_REF_MUT
    let mem: *Expr = al_expr(ExprKind.Member, span)
    mem.left = al_ident("f", span)
    mem.ident = "__poll"
    mem.bracket = span
    let call: *Expr = al_expr(ExprKind.Call, span)
    call.left = mem
    call.args = al_ident("f", span)
    let f: *FnDef = al_fn(@orig, "future_poll", p, TypeKind.Bool, strview_empty(), al_return(call, span))
    f.is_pub = 1
    # Every unit injects its own copy (#4007).  A generated pub fn is
    # `weak_odr` with a comdat (AGAST #3386, #201), so the linker keeps one,
    # as for a generated `E.from` two files both declare.  Without it each
    # object's copy is a duplicate definition of `future_poll`.
    f.from_generated = 1
    module_append_fn(m, f)

# ---------------------------------------------------------------------------
# The pass
# ---------------------------------------------------------------------------

# Lower every async fn of `m` and every await, after refusing each bare call
# to an async fn.  `path` is the input file.  Returns the errors it reported;
# main stops on any.
pub fn async_lower_module(m: *Module, path: StrView) -> i32
    g_al_module = m
    g_al_path = path
    g_al_async = null
    al_inject_future(m)
    var f: *FnDef = m.functions
    while f != null
        if f.is_async == 1
            let entry: *AlAsync = al_zalloc(sizeof(AlAsync)) as *AlAsync
            entry.name = f.name
            entry.params = f.params
            entry.f = f
            entry.next = g_al_async
            g_al_async = entry
        f = f.next
    var errs: i32 = 0
    if g_al_async != null
        f = m.functions
        while f != null
            errs += al_bare_fn(f)
            f = f.next
        var ib: *ImplBlock = m.impls
        while ib != null
            var method: *FnDef = ib.methods
            while method != null
                errs += al_bare_fn(method)
                method = method.next
            ib = ib.next
    if errs > 0
        return errs
    # Each async fn becomes its future, constructor and poll.
    var prev: *FnDef = null
    f = m.functions
    while f != null
        let nxt: *FnDef = f.next
        if f.is_async == 1
            errs += al_lower_fn(m, prev, f)
            # The last fn the lowering put in f's place.
            if prev == null
                prev = m.functions
            else
                prev = prev.next
            while prev.next != nxt
                prev = prev.next
        else
            prev = f
        f = nxt
    if errs > 0
        return errs
    # Every other await: in a sync fn (or a method), polled to completion.
    # A helper this adds is appended, and has no await of its own.
    f = m.functions
    while f != null
        errs += al_sync_fn(f)
        f = f.next
    var ib: *ImplBlock = m.impls
    while ib != null
        var method: *FnDef = ib.methods
        while method != null
            errs += al_sync_fn(method)
            method = method.next
        ib = ib.next
    errs
