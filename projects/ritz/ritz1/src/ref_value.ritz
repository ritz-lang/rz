# ritz1/src/ref_value.ritz - ref_check's value and slot checks, on Sema
#
# AGAST #3926 and #4011 (#1816) moved ref_check.ritz's checks off the emitter;
# sema_walk calls the hooks below.  What the emitter still asks (ref_ty_of,
# ref_through, ref_temp_call, ref_view, ...) stays in ref_check.ritz, and the
# place queries both sides need are one copy there over a RefEnv.
#
# `@T` is read-only (LANGUAGE_SPEC §3.2, §13.3, LARB R1, AGAST #2338): a write
# through an `@T` (`p.f = v`, `p[i] = v`, `*p = v`, through a chain of fields)
# is an error, and so is `@&` of such a place.  An `@T` doesn't become an `@&T`
# (AGAST #2374): a method taking `self: @&T` on a receiver reached through an
# `@T` is.  ritz0's twins are TypeChecker._check_write, _check_borrow and
# _check_receiver; ritz0/test_at_is_read_only.py and test_at_into_mut.py hold
# all three compilers to them.
#
# A reference to a local doesn't leave its fn (LANGUAGE_SPEC §13.5, LARB R2,
# AGAST #2340): a `return` or tail of `@x`, of a binding definitely holding one,
# or of a call returning `@U` / `@&U` that was given one.  Statements are seen
# in order, as ritz0 sees them: a `var` that's written stops counting there, and
# a loop can reach that write first.  ritz0's twin is TypeChecker._check_return;
# ritz0/test_return_local_ref.py holds all three compilers to it.  LARB R57
# (AGAST #3473) makes a `-> Span<T>` return a reference slot: `@x` in one and a
# view `v[a..b]` of a local Vec or String are refused alike, directly or through
# a Span binding that holds one.
#
# The slot checks (LANGUAGE_SPEC §13.2-13.4, LARB R1): an `@T`, `@&T` or `*T`
# where a `T` goes is a located error at every slot: argument, `let`/`var`,
# `=`, `return`, tail, field, element, variant payload.  There's no implicit
# deref, and `@x` into a by-value slot is the same mistake.  So is a `T` where
# a reference goes: a `name:& T` param has type `T` in its body, and a
# reference is written (AGAST #2336, #2337).  `@x` or an `@T` doesn't fit an
# `@&T` or `:&` slot (#2339, #2374), nor `@x` of another type than a `:&`
# param's (#2367).  ritz0's twin is TypeChecker._check_ref_slot; ref_rules.py
# has the wording, and ritz0/test_ref_into_value.py and test_value_into_ref.py
# hold all three compilers to it.
#
# LARB R71 (LANGUAGE_SPEC §3.2, AGAST #3999): a pointer or reference *value*
# fits a pointer or reference slot only when the pointees are the same type, at
# a `let`/`var`, an `=` and a `return` as at an argument.  The byte pointer is
# the way between (a `*T` or `@T` into a `*u8`, a `*u8` into any `*T`), `null`
# fits any pointer, and a cast is the escape hatch.  ritz0's twin is
# TypeChecker._check_other_pointee; ritz0/test_array_pointee_assign.py holds all
# three compilers to it.
#
# LANGUAGE_SPEC §3.3, LARB R5 / R42: a non-literal `[N]T1` fits `[N]T2` only if
# T1 is T2, at the same slots and under `as`, and a literal is its slot's N
# long (AGAST #2343, #3383); a whole array is not a pointer (#3054); `[v; n]`
# of a move-only v (#2963).  ritz0's twin is TypeChecker._check_array_slot;
# array_rules.py has the wording and ritz0/test_array_store_rule.py holds all
# three compilers to it.  A cast to a reference of a value, or of a reference
# to a move-only T to the T (#2370, #2985), and a call's temporary used as a
# place (#2518, #3050, #3215) are refused here too.
#
# Types are read with ref_check's ref_ty_in over Sema's scope.  What Sema's
# scope doesn't keep (an inferred `let`'s reference kind, a `**`'s nearest
# level, a `:&`'s caller place, the root a binding refers to, and the LocalVar
# the emitter will make for it) is noted per binding in ref_check's RsNote.
# What can't be typed stays unjudged: wrongly refusing a valid program is
# worse than leaving it to clang.
#
# An `if` or `match` can't be judged where it lands: its arms bind their own
# names.  So a slot's tails are noted when the slot is met (rv_note_*) and
# judged as each one is reached, its bindings in scope (rv_landed).  One report
# per place: the first check to refuse it speaks.

import ritzlib.cstr
import ritzlib.sys
import ritzlib.io
import ritzlib.memory
import ritzlib.str     # memset

import ast
import ast_helpers
import diag   # diag_error_at, diag_eprint_lent (AGAST #3621, #2847)
import ast_query          # name_eq, eprint_*, LocalVar and its naming helpers,
                          # ptr_ptr_ident_levels, param_borrows_struct_ptr_ptr,
                          # lent_self_call_view_in (AGAST #4391: was resolved
                          # through emitter_core/emitter_expr/emitter_expr_call)
import sema
import sema_type
import bool_check         # sbk_global
import deref_field        # df_is_step (AGAST #3015)
import let_check          # let_addr_of_own, let_error_addr (AGAST #2338)
import ownership          # own_type_is_move_only_in (#2963), own_start_of
import ref_check          # RefEnv, RefTy, RsNote and the place queries
import ref_loan           # rl_param_lends, rl_qualified_variant, rl_expr_*

# Where the last error was reported: one report per place.
var RV_LAST_LINE: i32 = 0
var RV_LAST_COL: i32 = 0
# The loops around the statement being checked.
var RV_LOOPS: i32 = 0
# What the fn returns; `returned` is 1 when it leaves as a pointer or reference.
var RV_RET: RefTy
# A `-> *[N]T` return as a param would carry it, which ref_of_fn keeps no N and T
# for; ok only when the fn has one (AGAST #3999, LARB R71).
var RV_RET_ARRAY: RefTy
var RV_RET_ARRAY_OK: i32 = 0
# A tail and the slot it lands in.
struct RvTail
    e: *Expr
    slot: RefTy

# The tails of the slots met so far, judged as they're reached (with their
# arms' bindings in scope).
var RV_TAILS: *RvTail = null
var RV_TAIL_COUNT: i32 = 0
var RV_TAIL_CAP: i32 = 0
# The argument rv_args is walking: an `@` that is it is lent to the call.
var RV_ARG_EXPR: *Expr = null
# >0 while rv_args judges an argument against its param's slot (LARB R71,
# AGAST #3999): a call's pointer and reference words there are #1948's.
var RV_IN_ARG: i32 = 0
# A declaration's root, its type, the reference kind its binding takes, and its
# initialiser's type, until ref_value_after can give them to the binding.
var RV_DECL_ROOT: *u8 = null
var RV_DECL_ROOT_LEN: i32 = 0
var RV_DECL_TY: RefTy
var RV_DECL_KIND: TypeKind = TypeKind.Void
var RV_DECL_REF: RefTy
var RV_DECL_INIT: RefTy
var RV_DECL_INIT_OK: i32 = 0
var RV_DECL_FN: *FnDef = null

fn rv_env(sm: *Sema, env: *RefEnv) -> *RefEnv
    env.s = null
    env.sm = sm
    env

# ref_ty_of, on Sema's scope.
fn rv_ty(sm: *Sema, e: *Expr, out: *RefTy) -> i32
    var env: RefEnv
    ref_ty_in(rv_env(sm, @env), e, out)

# The image of the local `x` names (RsNote.loc); null if none, or not a local.
fn rv_loc(sm: *Sema, x: *Expr) -> *LocalVar
    if x == null or x.kind != ExprKind.Ident
        return null
    var env: RefEnv
    var is_local: i32 = 0
    ref_local_in(rv_env(sm, @env), StrView { ptr: (x.ident_ptr), len: (x.ident_len) as i64 }, @is_local)

fn rv_first_report(line: i32, col: i32) -> i32
    if line == RV_LAST_LINE and col == RV_LAST_COL
        return 0
    RV_LAST_LINE = line
    RV_LAST_COL = col
    1

# `<file>:<line>:<col>: error: ` once per place: 1 when the caller is to write
# the rest of the line.
fn rv_report(sm: *Sema, line: i32, col: i32) -> i32
    if rv_first_report(line, col) == 0
        return 0
    diag_error_at(sema_file(sm), diag_span(line, col))
    sm.error_count = sm.error_count + 1
    1

fn rv_error(sm: *Sema, line: i32, col: i32, msg: *u8) -> i32
    if rv_report(sm, line, col) == 0
        return 0
    eprints_cstr(msg)
    1

fn rv_error_at(sm: *Sema, e: *Expr, msg: *u8)
    rv_error(sm, e.span.line, e.span.col, msg)

# --- `@T` is read-only -------------------------------------------------------------

fn rv_shared(sm: *Sema, e: *Expr) -> i32
    var env: RefEnv
    ref_write_is_shared_in(rv_env(sm, @env), e)

# The statement forms the parser splits a place into, put back together.
fn rv_writes_shared(sm: *Sema, stmt: *Stmt) -> i32
    let k: StmtKind = stmt.kind
    var root: Expr
    var member: Expr
    var element: Expr
    match k
        StmtKind.Assign =>
            if stmt.assign_target_len > 0
                return 0
            return rv_shared(sm, stmt.if_cond as *Expr)
        StmtKind.IndexAssign =>
            rl_expr_ident(@root, StrView { ptr: (stmt.assign_target), len: (stmt.assign_target_len) as i64 })
            rl_expr_index(@element, @root, null)
            return rv_shared(sm, @element)
        _ => pass
    match k
        StmtKind.LocalFieldAssign | StmtKind.LocalFieldIndexAssign =>
            rl_expr_ident(@root, StrView { ptr: (stmt.var_name), len: (stmt.var_name_len) as i64 })
            rl_expr_member(@member, @root, StrView { ptr: (stmt.assign_target), len: (stmt.assign_target_len) as i64 })
        StmtKind.MemberAssign | StmtKind.MemberIndexAssign =>
            rl_expr_member(@member, stmt.if_cond as *Expr, StrView { ptr: (stmt.assign_target), len: (stmt.assign_target_len) as i64 })
        _ =>
            return 0
    if k == StmtKind.LocalFieldAssign or k == StmtKind.MemberAssign
        return rv_shared(sm, @member)
    rl_expr_index(@element, @member, null)
    rv_shared(sm, @element)

fn rv_check_write(sm: *Sema, stmt: *Stmt)
    if rv_writes_shared(sm, stmt) == 0
        return
    # `(*p).f = v` starts at the `(`, and the place at the `*`.
    var col: i32 = stmt.span.col
    if stmt.kind == StmtKind.MemberAssign or stmt.kind == StmtKind.MemberIndexAssign
        col = col + 1
    rv_error(sm, stmt.span.line, col, c"cannot write through an `@T`: make it `@&T`\n")

# `e` is a mutable borrow of its operand.
fn rv_check_borrow(sm: *Sema, e: *Expr)
    if rv_shared(sm, e.operand) == 1
        rv_error_at(sm, e, c"cannot borrow through an `@T` as mutable: make it `@&T`\n")

# A method taking `self: @&T` writes what its receiver reaches, as `recv.f = v`
# would: `.` finds the receiver the same way.  `p` is its first param, whatever
# that's called: a standalone function takes the receiver there too.  A bare
# `self:&` is a TypeKind.Struct param marked is_self_borrow, the same borrow as
# `self:& T` (#2389, #3983).
fn rv_check_receiver(sm: *Sema, e: *Expr, p: *Param)
    if p == null
        return
    if p.param_type != TypeKind.MutRef and (p.param_type != TypeKind.Struct or p.is_self_borrow != 1)
        return
    var member: Expr
    rl_expr_member(@member, e.left, StrView { ptr: (e.ident_ptr), len: (e.ident_len) as i64 })
    if rv_shared(sm, @member) == 1
        rv_error(sm, e.left.span.line, e.left.span.col, c"an `@T` doesn't fit an `@&T` slot: make it `@&T`\n")

# `e` lands in an `@&T` or a `:&` param, which `@x` never does (LANGUAGE_SPEC §13.3,
# AGAST #2339).  Of a `let`, or of a place behind an `@T`, `@&x` wouldn't do either,
# so those say what would.  ritz0's twin is TypeChecker._check_addr_into_mut.
fn rv_addr_into_mut(sm: *Sema, e: *Expr)
    if let_addr_of_own(sm, e) == 1
        if rv_first_report(e.span.line, e.span.col) == 1
            let_error_addr(sm, e)
    else if e.kind == ExprKind.Unary and e.op == OpKind.Addr
        if rv_shared(sm, e.operand) == 1
            rv_check_borrow(sm, e)
        else
            rv_error_at(sm, e, c"`@x` is shared and doesn't fit an `@&T` or `:&` slot: write `@&x`\n")

# `e` lands in an `@&T`: an `@T` doesn't become one (#2374).  `@x` is
# rv_addr_into_mut's.  An `@&T` reached through an `@T`, as `h.m` of `h: @H`
# is, is read-only too (#2381): what `e` points at is walked.
fn rv_shared_into_mut(sm: *Sema, e: *Expr)
    if e.kind == ExprKind.Unary and e.op == OpKind.Addr
        return
    var env: RefEnv
    let view: i32 = ref_view_in(rv_env(sm, @env), e)
    if view == REF_VIEW_SHARED
        rv_error_at(sm, e, c"an `@T` doesn't fit an `@&T` slot: make it `@&T`\n")
        return
    if view != REF_VIEW_MUT
        return
    var pointee: Expr
    memset(@pointee as *u8, 0, sizeof(Expr))
    pointee.kind = ExprKind.Unary
    pointee.op = OpKind.Deref
    pointee.operand = e
    if rv_shared(sm, @pointee) == 1
        rv_error_at(sm, e, c"an `@T` doesn't fit an `@&T` slot: make it `@&T`\n")

# --- A reference to a local doesn't leave its fn ------------------------------------

# The local root the place `e` is in, reached with no pointer or reference on the
# path; null if it's not in one, or Sema can't say.
fn rv_local_root(sm: *Sema, e0: *Expr) -> *SemaVar
    var e: *Expr = e0
    while e != null
        if e.kind == ExprKind.Ident
            let v: *SemaVar = sema_find_local(sm, StrView { ptr: (e.ident_ptr), len: (e.ident_len) as i64 })
            if v == null
                return null
            let n: *RsNote = rs_note(sm, v)
            if n != null and n.caller_place == 1
                return null
            return v
        if e.kind != ExprKind.Member and e.kind != ExprKind.Index
            return null
        var base: RefTy
        if rv_ty(sm, e.left, @base) == 0 or ref_is_pointer(base.kind) == 1
            return null
        if e.kind == ExprKind.Index and (base.kind != TypeKind.Array or e.right == null or e.right.kind == ExprKind.Range)
            return null
        e = e.left
    null

# 1 when `t` is a Vec or String: a `v[a..b]` of one in a Span slot is a view of
# v's storage rather than a copy (§7.8, LARB R57).  A Span's slice views what
# that Span does, so it lends nothing for R2.
fn rv_is_vec_or_string(t: *SemaTy) -> i32
    if t.kind != TypeKind.Struct or t.name == null
        return 0
    if t.name_len > 4 and (StrView { ptr: (t.name), len: (t.name_len) as i64 }).starts_with("Vec$")
        return 1
    name_eq(StrView { ptr: (t.name), len: (t.name_len) as i64 }, "String")

# LARB R57 (AGAST #3473): the local root a Span `v[a..b]` views, `v` a Vec or
# String held by value.  monomorph makes the view a Span struct literal in a
# Span slot; an unrewritten slice is its index.  Null when `e` isn't a view of
# a Vec or String, or `v` isn't a local root.
fn rv_span_view_root(sm: *Sema, e: *Expr, len: *i32) -> *u8
    let base: *Expr = span_view_base(e)
    if base == null
        return null
    var t: SemaTy
    if sema_expr_ty(sm, base, @t) == TypeKind.Void or rv_is_vec_or_string(@t) == 0
        return null
    let root: *SemaVar = rv_local_root(sm, base)
    if root == null
        return null
    *len = root.name_len
    root.name

# 1 when `stmt`, a declaration, writes a `Span<T>` type (LARB R57).
fn rv_decl_is_span(stmt: *Stmt) -> i32
    if stmt.var_declared_type != TypeKind.Struct or stmt.var_type_name_len <= 5
        return 0
    ((StrView { ptr: (stmt.var_type_name), len: (stmt.var_type_name_len) as i64 }).starts_with("Span$")) as i32

# The name of the local root `e` definitely refers to, with its length in `len`:
# `@x` of one, or a binding that holds such a reference.  Null if there's none.
fn rv_referent(sm: *Sema, e: *Expr, len: *i32) -> *u8
    if e == null
        return null
    if e.kind == ExprKind.Unary and (e.op == OpKind.Addr or e.op == OpKind.AddrMut)
        let root: *SemaVar = rv_local_root(sm, e.operand)
        if root == null
            return null
        *len = root.name_len
        return root.name
    if e.kind != ExprKind.Ident
        return null
    let v: *SemaVar = sema_find_local(sm, StrView { ptr: (e.ident_ptr), len: (e.ident_len) as i64 })
    let n: *RsNote = rs_note(sm, v)
    # A loop can reach a `var`'s later write before this read.
    if n == null or n.root == null or v.is_let == 0 and RV_LOOPS > n.root_loops
        return null
    *len = n.root_len
    n.root

# What `e`, which rv_referent named a root for, has: a binding keeps it.
fn rv_referent_ty(sm: *Sema, e: *Expr, out: *RefTy) -> i32
    if e.kind == ExprKind.Ident
        let v: *SemaVar = sema_find_local(sm, StrView { ptr: (e.ident_ptr), len: (e.ident_len) as i64 })
        if v != null
            let n: *RsNote = rs_note(sm, v)
            if n == null
                return ref_set(out, TypeKind.Ptr, TypeKind.Void, StrView { ptr: (null), len: (0) as i64 })
            return ref_set(out, TypeKind.Ptr, n.root_pointee, StrView { ptr: (n.root_name), len: (n.root_name_len) as i64 })
    rv_ty(sm, e, out)

# `name` is written, or its address may let it be: if it's a `var`, what it holds
# is no longer definite.
fn rv_forget_name(sm: *Sema, name_sv: StrView)
    var name: *u8 = name_sv.ptr
    var len: i32 = name_sv.len as i32
    let v: *SemaVar = sema_find_local(sm, StrView { ptr: (name), len: (len) as i64 })
    if v == null or v.is_let == 1
        return
    let n: *RsNote = rs_note(sm, v)
    if n != null
        n.root = null

fn rv_forget(sm: *Sema, e: *Expr)
    if e != null and e.kind == ExprKind.Ident
        rv_forget_name(sm, StrView { ptr: (e.ident_ptr), len: (e.ident_len) as i64 })

# The local root `a` refers to, if it has `ret`'s pointee.  A `:&` param or a
# receiver borrows `a` itself when it's that `U`.
fn rv_gives_referent(sm: *Sema, a: *Expr, lent: i32, ret: *RefTy, len: *i32) -> *u8
    var t: RefTy
    let root: *u8 = rv_referent(sm, a, len)
    if root != null
        if rv_referent_ty(sm, a, @t) == 1 and ref_same_referent(@t, ret) == 1
            return root
        return null
    if lent == 0
        return null
    let place: *SemaVar = rv_local_root(sm, a)
    if place == null or rv_ty(sm, a, @t) == 0
        return null
    var held: RefTy
    ref_set(@held, TypeKind.Ptr, t.kind, StrView { ptr: (t.name), len: (t.name_len) as i64 })
    if ref_same_referent(@held, ret) == 0
        return null
    *len = place.name_len
    place.name

# The local root a call returning `@U` or `@&U` was given a reference to, with
# pointee `U`: the result may be that reference, so a raw `*U` return, which no
# reference has to live through, isn't asked.
fn rv_call_referent(sm: *Sema, e: *Expr, len: *i32) -> *u8
    var f: *FnDef = null
    if e.kind == ExprKind.Method
        f = rs_method_def(sm, e)
    else
        f = sema_call_fn(sm, e)
    var ret: RefTy
    if f == null or f.ret_ref == null or ref_of_fn(f, @ret) == 0
        return null
    var p: *Param = f.params
    if p != null and name_eq(StrView { ptr: (p.name), len: (p.name_len) as i64 }, "self") == 1
        p = p.next
    if e.kind == ExprKind.Method
        let by_self: *u8 = rv_gives_referent(sm, e.left, 1, @ret, len)
        if by_self != null
            return by_self
    var a: *Expr = e.args
    while a != null
        var lent: i32 = 0
        if p != null
            lent = p.is_borrow
            p = p.next
        let root: *u8 = rv_gives_referent(sm, a, lent, @ret, len)
        if root != null
            return root
        a = a.next
    null

# `e` is a return value or a tail of one.  It runs after the `@&T` slot checks
# on `e` (rv_into), so a place they refuse is reported once, in their words.
fn rv_check_return(sm: *Sema, e: *Expr)
    var len: i32 = 0
    var root: *u8 = rv_referent(sm, e, @len)
    # LARB R57: a Span return of a view of a local Vec or String, as `@x` in a
    # Span slot already is by rv_referent.
    if root == null and rv_is_span(@RV_RET) == 1
        root = rv_span_view_root(sm, e, @len)
    if root == null and (e.kind == ExprKind.Call or e.kind == ExprKind.Method)
        root = rv_call_referent(sm, e, @len)
    if root == null or rv_report(sm, e.span.line, e.span.col) == 0
        return
    eprints("cannot return a reference to local `")
    eprint_bytes(StrView { ptr: (root), len: (len) as i64 })
    eprints("`: it ends with the fn\n")

# LARB R71 (AGAST #3999): a pointer value returned from a `-> *[N]T` fn, whose
# slot ref_of_fn keeps no N and T for, judged against the return type a param
# would carry.  Only a pointer value: an array value's own words are elsewhere
# (`a whole array is not a value here`), and `@x` is the stricter §3.2 rule's.
fn rv_return_pointee(sm: *Sema, e: *Expr)
    if rv_judges_value(sm, e) == 0
        return
    var a: RefTy
    if rv_ty(sm, e, @a) == 0 or ref_is_pointer(a.kind) == 0
        return
    if rv_other_value_pointee(sm, @a, @RV_RET_ARRAY) == 1
        rv_error_other_type(sm, e)

# --- Slot errors ---------------------------------------------------------------------

fn rv_error_slot(sm: *Sema, e: *Expr)
    if e.kind == ExprKind.Unary and (e.op == OpKind.Addr or e.op == OpKind.AddrMut)
        rv_error_at(sm, e, c"`@x` doesn't fit a by-value slot: drop the `@`\n")
    else
        rv_error_at(sm, e, c"a reference or pointer doesn't fit a by-value slot: write `*` to read through it\n")

fn rv_error_value(sm: *Sema, e: *Expr, slot: *RefTy)
    if slot.kind == TypeKind.MutRef
        rv_error_at(sm, e, c"a value doesn't fit a reference slot: write `@&x` to borrow it\n")
    else
        rv_error_at(sm, e, c"a value doesn't fit a reference slot: write `@x` to borrow it\n")

fn rv_error_other_pointer(sm: *Sema, e: *Expr)
    rv_error_at(sm, e, c"a reference to one pointer type doesn't fit a reference to another\n")

fn rv_error_other_type(sm: *Sema, e: *Expr)
    rv_error_at(sm, e, c"a reference to one type doesn't fit a reference to another: cast it with `as`\n")

# `e` is a non-literal array of another element type than its slot's.
fn rv_array_error(sm: *Sema, e: *Expr)
    rv_error_at(sm, e, c"an array only fits a slot of the same element type: write a loop to convert it\n")

# AGAST #3054: a whole `[N]T` into a `*U`, U not an array (a `*[M]U` is
# rv_is_referent's, below), nor one the tables can't name.  The emitter's
# whole-array words say "take its address with @", and `@a` is refused again
# there, so this slot names `@a[0]`.  ritz0's words, from array_rules.py
# (WHOLE_ARRAY_INTO_POINTER).
fn rv_error_array_into_pointer(sm: *Sema, e: *Expr)
    rv_error_at(sm, e, c"a whole array is not a pointer: `@a[0]` points at its first element\n")

# `e`'s `*U` isn't the `*U` its slot refers to.  `@q` of a reference `q` is
# ritz0's "a reference to one type" (TypeChecker._other_referent, AGAST #3160);
# any other `*U` is "one pointer type".
fn rv_error_other_pointee(sm: *Sema, e: *Expr)
    if rv_addr_of_reference(sm, e) == 1
        rv_error_other_type(sm, e)
    else
        rv_error_other_pointer(sm, e)

# --- What a slot takes ---------------------------------------------------------------

fn rv_same_shape(a: *ArrayShape, b: *ArrayShape) -> i32
    if a == null or b == null
        return 1
    if a.rank != b.rank or a.leaf_type != b.leaf_type
        return 0
    for i in 0..a.rank
        if a.dims[i] != b.dims[i]
            return 0
    if a.leaf_type != TypeKind.Struct or a.leaf_name_len == 0 or b.leaf_name_len == 0
        return 1
    name_eq(StrView { ptr: (a.leaf_name), len: (a.leaf_name_len) as i64 }, StrView { ptr: (b.leaf_name), len: (b.leaf_name_len) as i64 })

# 0 only when `a`'s element is known not to be `slot`'s: what the tables can't
# name stays unjudged.
fn rv_same_element(a: *RefTy, slot: *RefTy) -> i32
    if a.pointee == TypeKind.Void or slot.pointee == TypeKind.Void
        return 1
    if a.pointee != slot.pointee
        return 0
    if a.pointee == TypeKind.Array
        return rv_same_shape(a.shape, slot.shape)
    if a.pointee == TypeKind.Ptr and a.elem_pointee != TypeKind.Void and slot.elem_pointee != TypeKind.Void
        if a.elem_pointee != slot.elem_pointee
            return 0
    if a.pointee != TypeKind.Struct and (a.pointee != TypeKind.Ptr or a.elem_pointee != TypeKind.Struct)
        return 1
    if a.name_len == 0 or slot.name_len == 0
        return 1
    name_eq(StrView { ptr: (a.name), len: (a.name_len) as i64 }, StrView { ptr: (slot.name), len: (slot.name_len) as i64 })

# 1 for `@x` or `@&x`, written where the slot is.
fn rv_is_written(e: *Expr) -> i32
    if e.kind == ExprKind.Unary and (e.op == OpKind.Addr or e.op == OpKind.AddrMut)
        return 1
    0

# 1 when R71 judges `e` as a pointer or reference value.  Not a written `@x`
# (the stricter §3.2 rule's), not a cast (the escape hatch R71 itself names), and
# not arithmetic on an `@x` the tables can't vouch for (rv_unsure_pointer_arith).
fn rv_judges_value(sm: *Sema, e: *Expr) -> i32
    if rv_is_written(e) == 1 or e.kind == ExprKind.Cast
        return 0
    if rv_unsure_pointer_arith(sm, e) == 1
        return 0
    1

# 1 when `e` is pointer arithmetic whose pointer operand is `@x` of an element
# through a Vec, Span or String: ref_ty_in types that address as the container's
# (its `[i]` runs through to the element only at the emitter), so the pointee
# it names is no element (AGAST #3999, rv_unsure_referent).
fn rv_unsure_pointer_arith(sm: *Sema, e: *Expr) -> i32
    if e == null or e.kind != ExprKind.Binary
        return 0
    if rv_unsure_referent(sm, e.left) == 1
        return 1
    rv_unsure_pointer_arith(sm, e.left)

# `a` goes to the `name:& T` param `p`: `@x` / `@&x` of another type than T
# would be reinterpreted (#2367, #2368).  A bare place is check_lent_ref_arg's
# "argument N has the wrong type".  ritz0's twin is
# TypeChecker._check_lent_referent.
fn rv_lent_referent(sm: *Sema, a: *Expr, p: *Param)
    if rv_is_written(a) == 0
        return
    var slot: RefTy
    if ref_of_param(p, @slot) == 0
        return
    var t: RefTy
    if rv_ty(sm, a, @t) == 0
        return
    if ref_is_pointer(t.kind) == 1 and rv_unsure_referent(sm, a) == 0 and rv_other_written(sm, a, @t, @slot) == 1
        rv_error_other_type(sm, a)

# rv_other_referent for `e`, `@x` of type `a`: a `bool` local is a `bool`,
# though its slot is kept wider.
fn rv_other_written(sm: *Sema, e: *Expr, a: *RefTy, slot: *RefTy) -> i32
    let kept: TypeKind = a.pointee
    let x: *LocalVar = rv_loc(sm, e.operand)
    if x != null and x.is_bool == 1
        a.pointee = TypeKind.Bool
    let other: i32 = rv_other_referent(sm, a, slot)
    a.pointee = kept
    other

# 1 when `e` is `@x` of what the tables can't vouch for: an element through a
# pointer to an array, a Vec, Span or String (index_through), where ref_ty_in
# names the container (AGAST #2443), not the element.  An un-annotated scalar `let` / `var` is typed as its initialiser
# since AGAST #2527 (inferred_int_init), so the local table vouches for it.
fn rv_unsure_referent(sm: *Sema, e: *Expr) -> i32
    let x: *Expr = e.operand
    if x == null or x.kind != ExprKind.Index
        return 0
    var env: RefEnv
    ref_is_through_in(rv_env(sm, @env), x)

# `a` is `@x` of an `x` known not to be what `slot` refers to: exactly, not by
# width (Aaron's ruling on AGAST #2368), so `@&u32` doesn't fit `@&i32`.  ritz0's
# twin is TypeChecker._other_referent.  A `*T` x into an `@*U` is
# rv_value_into_ref's own question, "a reference to one pointer type", and what
# the tables can't name stays unjudged.
fn rv_other_referent(sm: *Sema, a: *RefTy, slot: *RefTy) -> i32
    var x: TypeKind = a.pointee
    var want: TypeKind = slot.pointee
    # A field, an element or a payload keeps a `*S`'s name and not the kind.
    if want == TypeKind.Void and slot.name_len > 0
        want = TypeKind.Struct
    # The parser names a `-> *X` return after the last type it saw when X isn't
    # a struct (`-> *[2]i32` after a `*C`), so that name only judges a struct.
    if slot.name_only == 1 and x != TypeKind.Struct
        return 0
    # A scalar pointee with a name contradicts itself: a generic's `v: T` at
    # `T = *i32` or `*C` keeps the name and a defaulted kind (`i64`).
    if want != TypeKind.Struct and want != TypeKind.Array and slot.name_len > 0
        return 0
    # A pointer referent is another type than any the tables name; two of them
    # are rv_value_into_ref's "a reference to one pointer type".
    let xp: i32 = (x == TypeKind.Ptr or x == TypeKind.PtrPtr) as i32
    let wp: i32 = (want == TypeKind.Ptr or want == TypeKind.PtrPtr) as i32
    if xp == 1 and wp == 1
        return 0
    if xp == 1
        return rv_judged(sm, want, slot)
    if wp == 1
        return rv_judged(sm, x, a)
    if rv_judged(sm, x, a) == 0 or rv_judged(sm, want, slot) == 0
        return 0
    if x != want
        return 1
    if x == TypeKind.Struct
        # R79: any async fn's `NAME$Future` fits a slot for the built-in
        # `Future`, by reference.
        if sema_future_ref_fits(slot.name, slot.name_len, a.name, a.name_len) == 1
            return 0
        return 1 - name_eq(StrView { ptr: (a.name), len: (a.name_len) as i64 }, StrView { ptr: (slot.name), len: (slot.name_len) as i64 })
    if x == TypeKind.Array
        if a.ref_shape != null or slot.ref_shape != null
            return rv_shapes_differ(a, slot)   # AGAST #2098
        if a.ref_size > 0 and slot.ref_size > 0 and a.ref_size != slot.ref_size
            return 1
        if rv_judged(sm, a.ref_elem, a) == 1 and rv_judged(sm, slot.ref_elem, slot) == 1
            if a.ref_elem != slot.ref_elem
                return 1
            if a.ref_elem == TypeKind.Struct
                return 1 - name_eq(StrView { ptr: (a.name), len: (a.name_len) as i64 }, StrView { ptr: (slot.name), len: (slot.name_len) as i64 })
    0

# AGAST #2098: 1 when two array referents, one of them N-D, differ: in rank, a
# dimension or the leaf.  A known 1-D `[6]T` is another type than `[2][3]T`; a
# referent of unknown size (a pointer local's) is unjudged.
fn rv_shapes_differ(x: *RefTy, y: *RefTy) -> i32
    let a: *ArrayShape = x.ref_shape
    let b: *ArrayShape = y.ref_shape
    if a == null or b == null
        if (a == null and x.ref_size <= 0) or (b == null and y.ref_size <= 0)
            return 0
        return 1
    if a.rank != b.rank or a.leaf_type != b.leaf_type
        return 1
    var i: i32 = 0
    while i < a.rank
        if a.dims[i] != b.dims[i]
            return 1
        i = i + 1
    if a.leaf_type == TypeKind.Struct
        return 1 - name_eq(StrView { ptr: (a.leaf_name), len: (a.leaf_name_len) as i64 }, StrView { ptr: (b.leaf_name), len: (b.leaf_name_len) as i64 })
    0

# 1 when `kind`, with `t`'s name, is a referent the tables name: a scalar, an
# array, or a struct that is one.  A `*i32` return or field, or a generic's
# `*T`, keeps a name and no kind, so a name that isn't a struct is unjudged.
fn rv_judged(sm: *Sema, kind: TypeKind, t: *RefTy) -> i32
    if kind == TypeKind.Void or kind == TypeKind.Unknown or kind == TypeKind.Ptr or kind == TypeKind.PtrPtr
        return 0
    if ref_is_pointer(kind) == 1
        return 0
    if kind != TypeKind.Struct
        return 1
    if t.name_len == 0 or sema_find_struct(sm, StrView { ptr: (t.name), len: (t.name_len) as i64 }) == null
        return 0
    1

# 1 when `e` names a `name:& T` param.
fn rv_names_lent(sm: *Sema, e: *Expr) -> i32
    let loc: *LocalVar = rv_loc(sm, e)
    if loc == null
        return 0
    lv_is_lent(loc)

# `a`, which `e` has, is what `slot` refers to.
fn rv_is_referent(a: *RefTy, slot: *RefTy) -> i32
    # A field, an element or a payload keeps a `*S`'s name and not the kind.
    if slot.pointee == TypeKind.Void and slot.name_len > 0 and a.kind == TypeKind.Struct
        return name_eq(StrView { ptr: (a.name), len: (a.name_len) as i64 }, StrView { ptr: (slot.name), len: (slot.name_len) as i64 })
    if a.kind != slot.pointee
        return 0
    if a.kind != TypeKind.Struct
        return 1
    name_eq(StrView { ptr: (a.name), len: (a.name_len) as i64 }, StrView { ptr: (slot.name), len: (slot.name_len) as i64 })

# LARB R71 (AGAST #3999): 1 when `a`, a pointer or reference *value*, is known
# not to fit pointer or reference `slot`, into which it lands.  0 when it fits:
# the byte pointer bridges both ways (a `*T` or `@T` value into a plain `*u8`
# slot, and a plain `*u8` value into any `*T` slot), the pointees are the same
# type, or what the tables can't name stays unjudged.  `null` isn't a pointer
# type here, so it fits.  `@x` is the stricter §3.2 rule's (rv_other_written),
# never this; the caller tests that.  At a call, a struct for another struct
# keeps #1948's "argument N ... has the wrong type", as does a pointee of
# another LLVM type in a reference param; only a pointee a sign apart is
# R71's.  ritz0's twin is TypeChecker._check_other_pointee.
fn rv_other_value_pointee(sm: *Sema, a: *RefTy, slot: *RefTy) -> i32
    if ref_is_pointer(a.kind) == 0 or ref_is_pointer(slot.kind) == 0
        return 0
    # The byte pointer, both ways: a plain `*u8` slot, or a plain `*u8` value in
    # any `*T` slot.  `@u8` is neither (`@x` keeps §3.2), and a `@T` slot takes
    # only a byte pointee, never the bridge.
    if slot.kind == TypeKind.Ptr
        if slot.pointee == TypeKind.U8
            return 0
        if a.kind == TypeKind.Ptr and a.pointee == TypeKind.U8
            return 0
    # A struct for another struct at a call is #1948's words, as for `@x`.
    if RV_IN_ARG > 0 and a.pointee == TypeKind.Struct and slot.pointee == TypeKind.Struct
        return 0
    # A generic's `T = *S` / `*[N]E` keeps the type's name (a struct's, or the
    # mangled array spelling `arrN_E`) while the tables default the pointee kind
    # to a scalar.  A plain scalar names nothing, so such a contradictory record
    # is unjudged (AGAST #3999: ritzlib's HashMap<_, *Entry>, `id<*[2]i32>`).
    if a.name_len > 0 and rv_is_scalar_kind(a.pointee) == 1
        return 0
    # A generic's `[N]S` arrives as the struct S on one side and the array [N]S
    # on the other (the pointer value lost its shape).  With one name, the names
    # decide; where they don't speak, it's unjudged.
    if a.pointee == TypeKind.Struct and slot.pointee == TypeKind.Array or a.pointee == TypeKind.Array and slot.pointee == TypeKind.Struct
        if a.name_len == 0 or slot.name_len == 0
            return 0
        return 1 - name_eq(StrView { ptr: (a.name), len: (a.name_len) as i64 }, StrView { ptr: (slot.name), len: (slot.name_len) as i64 })
    if rv_other_referent(sm, a, slot) == 0
        return 0
    # Into a reference param, a pointee of another LLVM type is #1948's too: the
    # emitter compares the pointer types.  What passes that, a pointee a sign
    # apart (`@i32` into an `@u32` param), is R71's.
    if RV_IN_ARG > 0 and (slot.kind == TypeKind.Ref or slot.kind == TypeKind.MutRef) and rv_signed_kind(a.pointee) != rv_signed_kind(slot.pointee)
        return 0
    1

# `k`'s LLVM integer type: an unsigned kind as the signed one it shares bits with,
# so a difference only in sign reads as no difference (R71's #1948 exemption).
fn rv_signed_kind(k: TypeKind) -> TypeKind
    match k
        TypeKind.U32 =>
            return TypeKind.I32
        TypeKind.U64 =>
            return TypeKind.I64
        TypeKind.U16 =>
            return TypeKind.I16
        TypeKind.U8 =>
            return TypeKind.I8
        _ => pass
    k

# 1 for a scalar pointee kind (a number, bool or float): the kind the tables give
# a generic's pointer pointee when they didn't carry it (R71's name-vs-kind fixup).
fn rv_is_scalar_kind(k: TypeKind) -> i32
    match k
        TypeKind.Void | TypeKind.Unknown | TypeKind.Struct | TypeKind.Array =>
            return 0
        TypeKind.Ptr | TypeKind.PtrPtr =>
            return 0
        _ => pass
    1

# `e`, of type `a`, lands in reference or pointer `slot`.  Only a pointer fits:
# a `T` never does, and `@T` and `@&T` take nothing else.  `*U` is a `T` too, for
# an `@*U`.  A plain integer into a `*U` of another `U` is a pointer as an
# integer, which is another question; a `:&` param isn't one.
fn rv_value_into_ref(sm: *Sema, e: *Expr, a: *RefTy, slot: *RefTy)
    if ref_is_pointer(a.kind) == 1
        if rv_is_written(e) == 1 and rv_unsure_referent(sm, e) == 0 and rv_other_written(sm, e, a, slot) == 1
            rv_error_other_type(sm, e)
            return
        if rv_is_ptr_ptr_referent(a, slot) == 1
            rv_error_value(sm, e, slot)
            return
        # A plain pointer slot, or a reference to a non-pointer: a pointer or
        # reference value of another pointee doesn't fit (LARB R71).  `@x` is
        # the stricter §3.2 rule's, above; a reference to a pointer is the
        # branch below's.
        if slot.pointee != TypeKind.Ptr or slot.kind == TypeKind.Ptr
            if rv_judges_value(sm, e) == 1 and rv_other_value_pointee(sm, a, slot) == 1
                rv_error_other_type(sm, e)
            return
        if a.kind == TypeKind.Ptr and a.pointee != TypeKind.Ptr
            rv_error_value(sm, e, slot)
        else if a.pointee == TypeKind.Ptr and a.name_len > 0 and slot.name_len > 0
            if name_eq(StrView { ptr: (a.name), len: (a.name_len) as i64 }, StrView { ptr: (slot.name), len: (slot.name_len) as i64 }) == 0
                rv_error_other_pointee(sm, e)
        else if a.pointee == TypeKind.Ptr and rv_other_ptr_pointee(a, slot) == 1
            rv_error_other_pointee(sm, e)
        return
    if slot.kind != TypeKind.Ptr or rv_is_referent(a, slot) == 1 or rv_names_lent(sm, e) == 1
        rv_error_value(sm, e, slot)
    else if a.kind == TypeKind.Array and slot.pointee != TypeKind.Void and slot.pointee != TypeKind.Unknown
        rv_error_array_into_pointer(sm, e)

# AGAST #3048: 1 when `a` is a `*T` and `slot` a `**T` of that very T: the
# `*T` is the value a `**T` refers to, so `@q` is what's meant (Aaron's ruling:
# no implicit `*T` -> `**T`; `q as **T` says it on purpose).  Exactly T, as
# ritz0's `same`: a `*U` of another U is a pointer as an integer (#2370).
fn rv_is_ptr_ptr_referent(a: *RefTy, slot: *RefTy) -> i32
    if a.kind != TypeKind.Ptr or slot.kind != TypeKind.Ptr or slot.pointee != TypeKind.Ptr
        return 0
    let t: TypeKind = slot.ptr_pointee
    if t == TypeKind.Void or t == TypeKind.Unknown or a.pointee != t
        return 0
    if t != TypeKind.Struct
        return 1
    if a.name_len == 0 or slot.held_name_len == 0
        return 0
    name_eq(StrView { ptr: (a.name), len: (a.name_len) as i64 }, StrView { ptr: (slot.held_name), len: (slot.held_name_len) as i64 })

# 1 when `e` is `@q` / `@&q` of a `q` that is an `@U` or `@&U`.
fn rv_addr_of_reference(sm: *Sema, e: *Expr) -> i32
    if rv_is_written(e) == 0
        return 0
    var t: RefTy
    if rv_ty(sm, e.operand, @t) == 0
        return 0
    (t.kind == TypeKind.Ref or t.kind == TypeKind.MutRef) as i32

# AGAST #2364: 1 when `a`'s `*U` pointee is known not to be `slot`'s.  A scalar
# U has no name for the branch above to compare, so the kinds are, exactly, as
# ritz0's TypeChecker does (`*u32` isn't `*i32`); so is a struct U against a
# scalar one.  A U either side didn't record stays unjudged.  A generic's
# instance keeps U's name even when it's a scalar (`g<i64>`), and its kind with it.
fn rv_other_ptr_pointee(a: *RefTy, slot: *RefTy) -> i32
    let x: TypeKind = a.ptr_pointee
    let want: TypeKind = slot.ptr_pointee
    if x == TypeKind.Void or x == TypeKind.Unknown or want == TypeKind.Void or want == TypeKind.Unknown
        return 0
    (x != want) as i32

fn rv_is_span(slot: *RefTy) -> i32
    if slot.kind != TypeKind.Struct or slot.name_len <= 5
        return 0
    return ((StrView { ptr: (slot.name), len: (slot.name_len) as i64 }).starts_with("Span$")) as i32

# --- The tails of a slot -------------------------------------------------------------

fn rv_tail_set(t: *RvTail, e: *Expr, slot: *RefTy)
    t.e = e
    t.slot = *slot

fn rv_note(e: *Expr, slot: *RefTy)
    if RV_TAIL_COUNT == RV_TAIL_CAP
        let cap: i32 = RV_TAIL_CAP * 2 + 16
        let grown: *RvTail = malloc((cap as i64) * sizeof(RvTail)) as *RvTail
        for i in 0..RV_TAIL_COUNT
            let old: *RvTail = RV_TAILS + i
            rv_tail_set(grown + i, old.e, @old.slot)
        if RV_TAILS != null
            free(RV_TAILS as *u8)
        RV_TAILS = grown
        RV_TAIL_CAP = cap
    rv_tail_set(RV_TAILS + RV_TAIL_COUNT, e, slot)
    RV_TAIL_COUNT = RV_TAIL_COUNT + 1

fn rv_note_arms(arms: *MatchArm, slot: *RefTy)
    var arm: *MatchArm = arms
    while arm != null
        if arm.is_pass == 0 and arm.body != null
            rv_note_value(arm.body, slot)
        else
            rv_note_stmts(arm.body_stmts, slot)
        arm = arm.next

fn rv_note_value(e: *Expr, slot: *RefTy)
    if e == null
        return
    if e.kind == ExprKind.If or e.kind == ExprKind.Match
        rv_note_arms(e.args as *MatchArm, slot)
    else
        rv_note(e, slot)

# The last statement of `list` is its value.
fn rv_note_stmts(list: *Stmt, slot: *RefTy)
    var st: *Stmt = list
    if st == null
        return
    while st.next != null
        st = st.next
    match st.kind
        StmtKind.Expr =>
            rv_note_value(st.expr, slot)
        StmtKind.If =>
            rv_note_stmts(st.if_then, slot)
            rv_note_stmts(st.if_else, slot)
        StmtKind.Match =>
            rv_note_arms(st.if_then as *MatchArm, slot)
        _ => pass

# `e` is about to be reached as a tail: judge it against the slot it was noted
# for, now its arm's bindings are in scope.
fn rv_landed(sm: *Sema, e: *Expr)
    for i in 0..RV_TAIL_COUNT
        let t: *RvTail = RV_TAILS + i
        if t.e == e
            rv_into(sm, e, @t.slot)
            return

# --- A value lands in a slot ---------------------------------------------------------

# AGAST #3383 (LANGUAGE_SPEC §3.3, LARB R42): an array literal or fill is its
# array slot's N long, at every slot.  ast_helpers has the rule and its words;
# rv_into reaches each nested literal with its row as the slot.
fn rv_literal_length(sm: *Sema, e: *Expr, slot: *RefTy)
    var one: ArrayShape
    var shape: *ArrayShape = slot.shape
    if shape == null
        one.rank = 1
        one.dims[0] = slot.array_len
        one.leaf_type = slot.pointee
        one.leaf_name = slot.name
        one.leaf_name_len = slot.name_len
        one.leaf_pointee = slot.elem_pointee
        shape = @one
    if array_lit_wrong_length(e, shape, 0) == 0 or rv_first_report(e.span.line, e.span.col) == 0
        return
    array_lit_length_report(sema_file(sm), e, shape, 0)
    sm.error_count = sm.error_count + 1

# `e`'s value lands in `slot`.
fn rv_into(sm: *Sema, e: *Expr, slot: *RefTy)
    if e == null or slot.kind == TypeKind.Void and slot.returned == 0
        return
    if e.kind == ExprKind.If or e.kind == ExprKind.Match
        rv_note_value(e, slot)
        return
    if slot.kind == TypeKind.MutRef
        rv_addr_into_mut(sm, e)
        rv_shared_into_mut(sm, e)
    if slot.returned == 1
        rv_check_return(sm, e)
        if RV_RET_ARRAY_OK == 1
            rv_return_pointee(sm, e)
    if slot.kind == TypeKind.Void
        return
    if slot.kind == TypeKind.Array
        rv_literal_length(sm, e, slot)
    if e.kind == ExprKind.ArrayLit and slot.kind == TypeKind.Array
        var part: RefTy
        rv_element(slot, @part)
        var el: *Expr = e.args
        while el != null
            rv_into(sm, el, @part)
            el = el.next
        return
    if e.kind == ExprKind.ArrayFill and slot.kind == TypeKind.Array
        var fill: RefTy
        rv_element(slot, @fill)
        rv_into(sm, e.left, @fill)
        return
    var a: RefTy
    if rv_ty(sm, e, @a) == 1
        if ref_is_pointer(slot.kind) == 1
            rv_value_into_ref(sm, e, @a, slot)
        else if a.kind == TypeKind.Array and rv_is_span(slot) == 1
            rv_error_value(sm, e, slot)
        else if ref_is_pointer(a.kind) == 1 and ref_same_pointee(@a, slot) == 1
            rv_error_slot(sm, e)
        else if a.kind == TypeKind.Array and slot.kind == TypeKind.Array and rv_same_element(@a, slot) == 0
            rv_array_error(sm, e)
    rv_into_variant(sm, e, slot)

# What an element of the array `slot` lands in.
fn rv_element(slot: *RefTy, out: *RefTy)
    if slot.pointee != TypeKind.Array or ref_row(slot, out) == 0
        ref_set(out, slot.pointee, TypeKind.Void, StrView { ptr: (slot.name), len: (slot.name_len) as i64 })
        out.elem_pointee = TypeKind.Void

# `Some(x)`, `Ok(x)` or `Err(x)` into an instance of Option or Result: its name
# says what the payload is, for a struct.
fn rv_into_variant(sm: *Sema, e: *Expr, slot: *RefTy)
    if e.kind != ExprKind.Call or e.args == null or slot.kind != TypeKind.Struct
        return
    var variant: i32 = 0
    if name_eq(StrView { ptr: (e.func_name), len: (e.func_name_len) as i64 }, "Err") == 1
        variant = 1
    else if name_eq(StrView { ptr: (e.func_name), len: (e.func_name_len) as i64 }, "Some") == 0 and name_eq(StrView { ptr: (e.func_name), len: (e.func_name_len) as i64 }, "Ok") == 0
        return
    var len: i32 = 0
    let name: *u8 = tagged_enum_arg_in(sm.pctx, @sm.struct_map, sm.module, StrView { ptr: (slot.name), len: (slot.name_len) as i64 }, variant, @len)
    if name == null
        return
    var part: RefTy
    if rv_of_mangled_ref(sm, StrView { ptr: (name), len: (len) as i64 }, @part) == 0
        if sema_find_struct(sm, StrView { ptr: (name), len: (len) as i64 }) == null
            return
        ref_set(@part, TypeKind.Struct, TypeKind.Void, StrView { ptr: (name), len: (len) as i64 })
    rv_into(sm, e.args, @part)

# AGAST #2384: the slot a reference type argument spells, as ref_of_param
# makes one for a parameter of that type: "refmut_C" is `@&C`, "ref_i32"
# `@i32`, "refmut_ptr_C" `@&*C`, "ref_arr2_i8" `@[2]i8`.  0 for anything
# else, or a referent this can't read back (it goes unjudged, as before).
fn rv_of_mangled_ref(sm: *Sema, name_sv: StrView, out: *RefTy) -> i32
    var name: *u8 = name_sv.ptr
    var len: i32 = name_sv.len as i32
    var kind: TypeKind = TypeKind.Ref
    var k: i32 = 4
    if len > 7 and (StrView { ptr: (name), len: (len) as i64 }).starts_with("refmut_")
        kind = TypeKind.MutRef
        k = 7
    else if len <= 4 or not (StrView { ptr: (name), len: (len) as i64 }).starts_with("ref_")
        return 0
    let r: *u8 = name + k
    let n: i32 = len - k
    let prim: TypeKind = primitive_type_from_name(StrView { ptr: (r), len: (n) as i64 })
    if prim != TypeKind.Void
        return ref_set(out, kind, prim, StrView { ptr: (null), len: (0) as i64 })
    if n > 4 and (StrView { ptr: (r), len: (n) as i64 }).starts_with("ptr_")
        # The pointer's own pointee is only a name here, as for a struct one.
        if primitive_type_from_name(StrView { ptr: (r + 4), len: (n - 4) as i64 }) != TypeKind.Void
            return ref_set(out, kind, TypeKind.Ptr, StrView { ptr: (null), len: (0) as i64 })
        return ref_set(out, kind, TypeKind.Ptr, StrView { ptr: (r + 4), len: (n - 4) as i64 })
    var size: i32 = 0
    var elem: TypeKind = TypeKind.Void
    if rv_mangled_array(r, n, @size, @elem) == 1
        ref_set(out, kind, TypeKind.Array, StrView { ptr: (null), len: (0) as i64 })
        out.ref_size = size
        out.ref_elem = elem
        return 1
    if sema_find_struct(sm, StrView { ptr: (r), len: (n) as i64 }) == null
        return 0
    ref_set(out, kind, TypeKind.Struct, StrView { ptr: (r), len: (n) as i64 })

# "arr" N "_" E with E a primitive: N to *size, E's TYPE_* to *elem.  1 if so.
fn rv_mangled_array(r: *u8, n: i32, size: *i32, elem: *TypeKind) -> i32
    if n < 6 or not (StrView { ptr: (r), len: (n) as i64 }).starts_with("arr")
        return 0
    var pos: i32 = 3
    var v: i32 = 0
    while pos < n and *(r + pos) >= '0' and *(r + pos) <= '9'
        v = v * 10 + (*(r + pos) - 48) as i32
        pos = pos + 1
    if pos == 3 or pos + 1 >= n or *(r + pos) != '_'   # '_'
        return 0
    let t: TypeKind = primitive_type_from_name(StrView { ptr: (r + pos + 1), len: (n - pos - 1) as i64 })
    if t == TypeKind.Void
        return 0
    *size = v
    *elem = t
    1

# A `**T` slot, at a field, a `let` or an `=` (AGAST #2370, #2528): a pointer
# whose referent is a pointer, whatever T is.  Nameless, so rv_other_referent
# judges `@n` of any type the tables name as another type, and a `:&` param
# bare is a value; `@q` of a `*U` and a `**U` value stay unjudged.  It keeps T
# (`inner`, a `**T`'s inner-pointee slot, and a struct T's name) in ptr_pointee
# and held_name, so a `*T` value is judged as the value it is (AGAST #3048); a
# `***T` keeps none.
fn rv_ptr_ptr_slot(out: *RefTy, inner: i32, name_sv: StrView) -> i32
    var name: *u8 = name_sv.ptr
    var len: i32 = name_sv.len as i32
    ref_set(out, TypeKind.Ptr, TypeKind.Ptr, StrView { ptr: (null), len: (0) as i64 })
    if ptr_ptr_slot_levels(inner) != 2
        return 1
    out.ptr_pointee = ptr_ptr_slot_inner(inner)
    if out.ptr_pointee == TypeKind.Struct
        out.held_name = name
        out.held_name_len = len
    1

# The slot an `=` to the name `name` writes: what it holds, or a `**T` slot.
fn rv_slot_of_name(sm: *Sema, name_sv: StrView, out: *RefTy) -> i32
    var name: *u8 = name_sv.ptr
    var len: i32 = name_sv.len as i32
    var env: RefEnv
    if ref_of_ident_in(rv_env(sm, @env), StrView { ptr: (name), len: (len) as i64 }, out) == 1
        return 1
    var is_local: i32 = 0
    let loc: *LocalVar = ref_local_in(rv_env(sm, @env), StrView { ptr: (name), len: (len) as i64 }, @is_local)
    if is_local == 1
        if loc == null or lv_var_type(loc) != TypeKind.PtrPtr
            return 0
        return rv_ptr_ptr_slot(out, lv_inner_pointee_type(loc), StrView { ptr: (lv_type_name(loc)), len: (lv_type_name_len(loc)) as i64 })
    let g: *GlobalVarDef = sbk_global(sm, StrView { ptr: (name), len: (len) as i64 })
    if g == null or g.var_type != TypeKind.PtrPtr
        return 0
    rv_ptr_ptr_slot(out, g.inner_pointee_type, StrView { ptr: (g.pointee_type_name), len: (g.pointee_type_name_len) as i64 })

# What field `f` takes, as a slot: as lower_ref_fields will make it, which Sema
# runs before.
fn rv_field_slot(f: *StructField, out: *RefTy)
    let t: TypeKind = lowered_field_type(f)
    if t == TypeKind.Array
        ref_of_array_field(f, out)
    else if f.field_ref_ptr_pointee != TypeKind.Void
        rv_field_ptr_slot(f, out)
    else if t == TypeKind.PtrPtr
        rv_ptr_ptr_slot(out, f.inner_pointee_type, StrView { ptr: (f.field_type_name), len: (f.field_type_name_len) as i64 })
    else if t == TypeKind.Ptr and f.field_mut_ref == 1
        ref_set(out, TypeKind.MutRef, f.array_elem_type, StrView { ptr: (f.field_type_name), len: (f.field_type_name_len) as i64 })
    else
        ref_set(out, t, f.array_elem_type, StrView { ptr: (f.field_type_name), len: (f.field_type_name_len) as i64 })

# AGAST #3151: an `r: @*U` / `@&*U` field is the reference to a `*U` it was
# written as, as a param is (ref_of_param), and not the nameless `**` slot
# lower_ref_fields leaves: `w.r = @&h` of an `h:& *C` misfits an `@&*D`.
fn rv_field_ptr_slot(f: *StructField, out: *RefTy)
    var kind: TypeKind = TypeKind.Ref
    if f.field_mut_ref == 1
        kind = TypeKind.MutRef
    ref_set(out, kind, TypeKind.Ptr, StrView { ptr: (f.field_type_name), len: (f.field_type_name_len) as i64 })
    out.ptr_pointee = f.field_ref_ptr_pointee

fn rv_decl_slot(stmt: *Stmt, out: *RefTy) -> i32
    if stmt.var_declared_type == TypeKind.Void
        return 0
    match stmt.var_type
        TypeKind.PtrPtr =>
            return rv_ptr_ptr_slot(out, stmt.var_inner_pointee_type, StrView { ptr: (stmt.var_type_name), len: (stmt.var_type_name_len) as i64 })
        TypeKind.Array =>
            return ref_set_array(out, stmt.var_array_elem_type, stmt.var_array_elem_pointee, StrView { ptr: (stmt.var_type_name), len: (stmt.var_type_name_len) as i64 }, stmt.var_array_shape, stmt.var_array_size)
        _ => pass
    ref_set(out, stmt.var_type, stmt.var_pointee_type, StrView { ptr: (stmt.var_type_name), len: (stmt.var_type_name_len) as i64 })
    if stmt.var_pointee_type == TypeKind.Array
        out.ref_size = stmt.var_pointee_array_size
        out.ref_elem = stmt.var_pointee_array_elem_type
        out.ref_shape = stmt.var_pointee_array_shape   # AGAST #2098
        if stmt.var_ref != null
            out.ref_shape = stmt.var_ref.param_pointee_array_shape   # `@[N][M]T`
    out.ptr_pointee = ref_decl_ptr_pointee(stmt)
    1

# `x.f = v` and `p.f = v`: the field is named by assign_target, on `owner`.
fn rv_into_field(sm: *Sema, stmt: *Stmt, owner: *RefTy)
    if owner.name_len == 0
        return
    let st: *StructDef = sema_find_struct(sm, StrView { ptr: (owner.name), len: (owner.name_len) as i64 })
    if st == null
        return
    let idx: i32 = find_field_index(st, StrView { ptr: (stmt.assign_target), len: (stmt.assign_target_len) as i64 })
    if idx < 0
        return
    var slot: RefTy
    rv_field_slot(get_field_type(st, idx), @slot)
    rv_into(sm, stmt.assign_value, @slot)

# --- Casts and `[v; n]` --------------------------------------------------------------

# `[v; n]` copies its one value into each element: n > 1 of a move-only `v`
# would drop it n times (AGAST #2963). ritz0's words, from array_rules.py.
fn rv_check_fill(sm: *Sema, e: *Expr)
    if e.int_val <= 1
        return
    var name: *u8 = null
    var len: i32 = 0
    if e.left.kind == ExprKind.StructLit
        name = e.left.ident_ptr
        len = e.left.ident_len
    else
        var t: RefTy
        if rv_ty(sm, e.left, @t) == 0 or ref_is_pointer(t.kind) == 1
            return
        name = t.name
        len = t.name_len
    if len == 0 or own_type_is_move_only_in(sm.pctx, sm.module, @sm.struct_map, StrView { ptr: (name), len: (len) as i64 }) == 0
        return
    rv_error_at(sm, e, c"`[v; n]` copies `v` into every element: a move-only value fills one, `[v; 1]`\n")

# `c as @&C`, `c as @C` or `c as *C` with `c` a struct or array value, a `:&`
# param's included (AGAST #2370): a cast isn't a borrow, so it's the bare form's
# error, as ritz0's TypeChecker._check_cast_to_ref.  An integer source is the
# integer-to-pointer cast and stays; a string literal is a `*u8` already, and a
# StrView or String into a `*T` has LARB R3's own words (AGAST #2341).
fn rv_cast_value_to_ref(sm: *Sema, e: *Expr)
    if e.type_kind != TypeKind.Ptr and e.type_kind != TypeKind.Ref and e.type_kind != TypeKind.MutRef
        return
    if e.left == null or e.left.kind == ExprKind.StringLit
        return
    var a: RefTy
    if rv_ty(sm, e.left, @a) == 0
        return
    if a.kind != TypeKind.Struct and a.kind != TypeKind.Array
        return
    if e.type_kind == TypeKind.Ptr and a.kind == TypeKind.Struct
        if name_eq(StrView { ptr: (a.name), len: (a.name_len) as i64 }, "StrView") == 1 or name_eq(StrView { ptr: (a.name), len: (a.name_len) as i64 }, "String") == 1
            return
    var target: RefTy
    ref_set(@target, e.type_kind, TypeKind.Void, StrView { ptr: (null), len: (0) as i64 })
    rv_error_value(sm, e.left, @target)

# `r as T` with `r: @T`, `@&T` or `*T` and T move-only (AGAST #2985): the
# plain slot's error, at `r`, as ritz0's MoveChecker._check_ref_cast.  Without
# it the cast copies the value out from behind the reference, and both owners
# drop it.  A copy T is left alone, and so is a cast to a pointer type.
fn rv_cast_move_only(sm: *Sema, e: *Expr)
    if e.type_kind != TypeKind.Struct or e.ident_len == 0
        return
    if own_type_is_move_only_in(sm.pctx, sm.module, @sm.struct_map, StrView { ptr: (e.ident_ptr), len: (e.ident_len) as i64 }) == 0
        return
    var target: RefTy
    ref_set(@target, TypeKind.Struct, TypeKind.Void, StrView { ptr: (e.ident_ptr), len: (e.ident_len) as i64 })
    rv_into(sm, e.left, @target)

# --- A call's temporary --------------------------------------------------------------
#
# A call's by-value result is a temporary, not a place (Aaron's ruling on
# AGAST #2518, LARB review 4).  A store into it, a method writing `self` on
# it, and an `@` of it that outlives its statement are refused; an `@` passed
# straight to a call is lent until that call returns (#3050, own_lend_temps).
# ritz0's words are ref_rules.STORE_INTO_TEMP, MUT_SELF_ON_TEMP and
# ADDR_OF_TEMP; ritz0/test_call_temporary_place.py holds all three compilers.

fn rv_temp_call(sm: *Sema, e: *Expr) -> *Expr
    var env: RefEnv
    ref_temp_call_in(rv_env(sm, @env), e)

# `mk().x = 1`, `mk().n[1] = 3`, `mk().x += 1`: at the place's start.
fn rv_check_temp_store(sm: *Sema, stmt: *Stmt)
    if stmt.kind != StmtKind.Assign or stmt.assign_target_len != 0
        return
    let place: *Expr = stmt.if_cond as *Expr
    if place == null or (place.kind != ExprKind.Member and place.kind != ExprKind.Index)
        return
    if rv_temp_call(sm, place) == null
        return
    rv_error_at(sm, own_start_of(place), c"a store into a call's temporary is lost: bind the call to a local first\n")

# `mk().bump()` with `self: @&T` / `self:& T` stores into the temporary as
# R1 exception 4's auto-ref lends it.  `p` is the method's first param.
fn rv_check_temp_receiver(sm: *Sema, e: *Expr, p: *Param)
    if p == null or param_is_self(p) == 0 or p.param_type != TypeKind.MutRef
        return
    if rv_temp_call(sm, e.left) == null
        return
    # `mk().rp.bump()` with `rp: *R`: the auto-deref lands on what `rp`
    # points at, a real place, as `mk().rp.x = 7` stores into it (#3235).
    var rt: RefTy
    if rv_ty(sm, e.left, @rt) == 1 and ref_is_pointer(rt.kind) == 1
        return
    rv_error_at(sm, own_start_of(e.left), c"a method that writes `self` can't take a call's temporary: bind the call to a local first\n")

# `@mk()`, `@&mk().n[1]`: only as a call's argument.
fn rv_check_temp_addr(sm: *Sema, e: *Expr)
    if e == RV_ARG_EXPR or rv_temp_call(sm, e.operand) == null
        return
    rv_error_at(sm, e, c"`@` of a call's temporary outlives it: bind the call to a local first, or pass it straight to a call\n")

# A call whose result is or holds a reference can't take a lent temporary:
# the temporary drops as the call returns, so `id(@make(5)).id` would read a
# dropped value (Aaron's ruling on AGAST #3215).  ritz0's words are
# ref_rules.lent_temp_escapes; ritz0/test_ownership_free_count.py holds all
# three compilers.

# 1 when the struct or enum `name` holds a pointer or reference.
fn rv_named_holds_ptr(sm: *Sema, name_sv: StrView, depth: i32) -> i32
    var name: *u8 = name_sv.ptr
    var len: i32 = name_sv.len as i32
    if name == null or len <= 0 or depth > 16
        return 0
    let st: *StructDef = sema_find_struct(sm, StrView { ptr: (name), len: (len) as i64 })
    if st != null
        return rv_fields_hold_ptr(sm, st.fields, depth + 1)
    let ei: i32 = user_enum_index(sm.pctx, StrView { ptr: (name), len: (len) as i64 })
    if ei < 0
        return 0
    var vi: i32 = 0
    while vi < enum_variant_count(sm.pctx, ei)
        if rv_fields_hold_ptr(sm, enum_variant_fields(sm.pctx, ei, vi), depth + 1) == 1
            return 1
        vi += 1
    0

fn rv_fields_hold_ptr(sm: *Sema, fields: *StructField, depth: i32) -> i32
    var f: *StructField = fields
    while f != null
        let t: TypeKind = lowered_field_type(f)
        if f.fn_sig == null and (ref_is_pointer(t) == 1 or t == TypeKind.PtrPtr)
            return 1
        if t == TypeKind.Struct and rv_named_holds_ptr(sm, StrView { ptr: (f.field_type_name), len: (f.field_type_name_len) as i64 }, depth) == 1
            return 1
        if t == TypeKind.Array
            if ref_is_pointer(f.array_elem_type) == 1 or f.array_elem_type == TypeKind.PtrPtr
                return 1
            if f.array_elem_type == TypeKind.Struct and rv_named_holds_ptr(sm, StrView { ptr: (f.array_elem_type_name), len: (f.array_elem_type_name_len) as i64 }, depth) == 1
                return 1
        f = f.next
    0

# 1 when `f` returns a pointer or reference, or a value holding one.
fn rv_returns_ptr(sm: *Sema, f: *FnDef) -> i32
    if f == null or f.ret_fn_sig != null
        return 0
    let t: TypeKind = f.return_type
    if ref_is_pointer(t) == 1 or t == TypeKind.PtrPtr or f.ret_ref != null
        return 1
    if f.ret_array != null
        let a: *ArrayElem = f.ret_array
        if ref_is_pointer(a.elem) == 1 or a.elem == TypeKind.PtrPtr
            return 1
        if a.elem == TypeKind.Struct
            return rv_named_holds_ptr(sm, StrView { ptr: (a.name), len: (a.name_len) as i64 }, 0)
        return 0
    if t == TypeKind.Struct
        return rv_named_holds_ptr(sm, StrView { ptr: (f.return_type_name), len: (f.return_type_name_len) as i64 }, 0)
    0

# At the first argument of a call that lends a temporary, when `f` returns one.
fn rv_check_lent_escape(sm: *Sema, args: *Expr, f: *FnDef)
    var a: *Expr = args
    while a != null
        if a.kind == ExprKind.Unary and (a.op == OpKind.Addr or a.op == OpKind.AddrMut) and rv_temp_call(sm, a.operand) != null
            if rv_returns_ptr(sm, f) == 0 or rv_report(sm, a.span.line, a.span.col) == 0
                return
            eprints("this call returns a reference, and `")
            diag_eprint_lent(a)
            eprints("` lends a temporary that's dropped when the call returns: bind it to a local first\n")
            return
        a = a.next

# --- The walk -----------------------------------------------------------------------

fn rv_walk_list(sm: *Sema, a0: *Expr)
    var a: *Expr = a0
    while a != null
        rv_walk(sm, a)
        a = a.next

# A variant's payload, into its fields' slots.
fn rv_payload(sm: *Sema, a0: *Expr, ei: i32, vi: i32)
    var a: *Expr = a0
    var f: *StructField = enum_variant_fields(sm.pctx, ei, vi)
    while a != null and f != null
        var slot: RefTy
        rv_field_slot(f, @slot)
        rv_into(sm, a, @slot)
        a = a.next
        f = f.next

# A call's arguments, into `f`'s params from `p0`.  What a `:&` param is lent
# may be written, so a binding passed to one no longer definitely refers to
# its root.
fn rv_args(sm: *Sema, a0: *Expr, f: *FnDef, p0: *Param)
    var a: *Expr = a0
    var p: *Param = p0
    while a != null
        if p != null
            var slot: RefTy
            if p.is_borrow == 1
                rv_addr_into_mut(sm, a)
                rv_lent_referent(sm, a, p)
            else if ref_of_param(p, @slot) == 1
                RV_IN_ARG = RV_IN_ARG + 1
                rv_into(sm, a, @slot)
                RV_IN_ARG = RV_IN_ARG - 1
            if p.is_borrow == 1 or f != null and rl_param_lends(sm, f, p) == 1
                rv_forget(sm, a)
            p = p.next
        let held: *Expr = RV_ARG_EXPR
        RV_ARG_EXPR = a
        rv_walk(sm, a)
        RV_ARG_EXPR = held
        a = a.next

# The by-value slots of a method found by a looser name, `a.cmp(b)` for
# `strview_cmp(a, b)` or `v.push(x)` for `vec_push$C(v, x)`: param 0 takes the
# receiver, so the arguments line up from `p0`, its next.  `@x` or a reference
# into one is refused as in the free call (AGAST #3154).  Only the by-value
# slots: the receiver, and what a reference slot takes, stay as they were.
fn rv_value_args(sm: *Sema, a0: *Expr, p0: *Param)
    var a: *Expr = a0
    var p: *Param = p0
    while a != null and p != null
        var slot: RefTy
        if p.is_borrow == 0 and ref_of_param(p, @slot) == 1 and ref_is_pointer(slot.kind) == 0 and rv_is_span(@slot) == 0
            var got: RefTy
            if rv_ty(sm, a, @got) == 1 and ref_is_pointer(got.kind) == 1 and ref_same_pointee(@got, @slot) == 1
                rv_error_slot(sm, a)
        a = a.next
        p = p.next

fn rv_walk_struct(sm: *Sema, e: *Expr)
    let st: *StructDef = sema_find_struct(sm, StrView { ptr: (e.ident_ptr), len: (e.ident_len) as i64 })
    var fi: *FieldInit = e.args as *FieldInit
    while fi != null
        if st != null
            let idx: i32 = find_field_index(st, StrView { ptr: (fi.name), len: (fi.name_len) as i64 })
            if idx >= 0
                var slot: RefTy
                rv_field_slot(get_field_type(st, idx), @slot)
                rv_into(sm, fi.value, @slot)
        rv_walk(sm, fi.value)
        fi = fi.next

# The enum a qualified variant `E.V(args)` names, with V's index in *vi; -1
# when `e` isn't one (qualified_variant).
fn rv_qualified_variant(sm: *Sema, e: *Expr, vi: *i32) -> i32
    if rl_qualified_variant(sm, e) == 0
        return 0 - 1
    *vi = enum_variant_index(sm.pctx, StrView { ptr: (e.left.ident_ptr), len: (e.left.ident_len) as i64 }, StrView { ptr: (e.ident_ptr), len: (e.ident_len) as i64 })
    enum_find(sm.pctx, StrView { ptr: (e.left.ident_ptr), len: (e.left.ident_len) as i64 })

# The fn a named call `e` calls, as emit_call does: a local named like a fn is
# the local (#2407, #2417), and `C_bump(c)` of a `self:& C` lends c (#3278).
fn rv_call_def(sm: *Sema, e: *Expr) -> *FnDef
    if e.func_name_len > 0 and e.call_type_suffix_len == 0
        let v: *SemaVar = sema_find_local(sm, StrView { ptr: (e.func_name), len: (e.func_name_len) as i64 })
        if v != null
            let n: *RsNote = rs_note(sm, v)
            if n != null and n.has_fn == 1
                return n.fn_sig
            return v.fn_sig
    lent_self_call_view_in(sm.module, sema_call_fn(sm, e))

# Every slot, borrow and receiver inside `e`.  An `if` or `match` is its
# condition here: its arms come through ref_value_check_value and the
# statement hooks.
fn rv_walk(sm: *Sema, e: *Expr)
    if e == null
        return
    let k: ExprKind = e.kind
    match k
        ExprKind.Call =>
            if e.func_name_len == 6 and name_eq(StrView { ptr: (e.func_name), len: (e.func_name_len) as i64 }, "sizeof") == 1
                return
            # AGAST #3015: `S_deref(@b)` made for `b.f` (R17) is a step of the
            # place `b.f`, which the borrow it's in is of; it lends nothing itself.
            if df_is_step(e) == 1
                let sa: *Expr = e.args
                if sa != null and sa.kind == ExprKind.Unary and (sa.op == OpKind.Addr or sa.op == OpKind.AddrMut)
                    rv_walk(sm, sa.operand)
                else
                    rv_walk(sm, sa)
                return
            var en: *u8 = null
            var el: i32 = 0
            user_variant_ctor_enum(sm.pctx, e, @en, @el)
            if en != null
                var vi: i32 = 0
                var other: i32 = 0
                let ei: i32 = enum_of_variant_unique(sm.pctx, StrView { ptr: (e.func_name), len: (e.func_name_len) as i64 }, @vi, @other)
                if ei >= 0
                    rv_payload(sm, e.args, ei, vi)
                rv_walk_list(sm, e.args)
                return
            let f: *FnDef = rv_call_def(sm, e)
            var p: *Param = null
            if f != null
                p = f.params
            rv_check_lent_escape(sm, e.args, f)
            rv_args(sm, e.args, f, p)
        ExprKind.Method =>
            var qv: i32 = 0
            let qe: i32 = rv_qualified_variant(sm, e, @qv)
            if qe >= 0
                rv_payload(sm, e.args, qe, qv)
                rv_walk_list(sm, e.args)
                return
            rv_walk(sm, e.left)
            var mp: *Param = null
            let m: *FnDef = rs_method_def(sm, e)
            if m != null
                # A method found by a looser name, `v.push(x)` for `vec_push(v, x)`,
                # takes the receiver as an argument: its params don't line up, so
                # the slots go unjudged, as in ritz0.
                mp = m.params
                rv_check_temp_receiver(sm, e, mp)
                rv_check_receiver(sm, e, mp)
                if mp != null and name_eq(StrView { ptr: (mp.name), len: (mp.name_len) as i64 }, "self") == 1
                    mp = mp.next
                else
                    if mp != null
                        rv_value_args(sm, e.args, mp.next)
                    mp = null
            rv_check_lent_escape(sm, e.args, m)
            rv_args(sm, e.args, null, mp)
        ExprKind.StructLit =>
            rv_walk_struct(sm, e)
        ExprKind.ArrayLit =>
            rv_walk_list(sm, e.args)
        ExprKind.ArrayFill =>
            rv_check_fill(sm, e)
            rv_walk(sm, e.left)
        ExprKind.Unary =>
            if e.op == OpKind.AddrMut or e.op == OpKind.Addr
                rv_check_temp_addr(sm, e)
            if e.op == OpKind.AddrMut
                rv_check_borrow(sm, e)
            if e.op == OpKind.AddrMut or e.op == OpKind.Addr
                rv_forget(sm, e.operand)
            rv_walk(sm, e.operand)
        ExprKind.Binary | ExprKind.Index | ExprKind.Range =>
            rv_walk(sm, e.left)
            rv_walk(sm, e.right)
        ExprKind.Member | ExprKind.Cast | ExprKind.Try | ExprKind.Match | ExprKind.If =>
            if k == ExprKind.Cast and e.cast_array != null
                var target: RefTy
                ref_set_elem(@target, e.cast_array)
                rv_into(sm, e.left, @target)
            if k == ExprKind.Cast
                rv_cast_move_only(sm, e)
                rv_cast_value_to_ref(sm, e)
            rv_walk(sm, e.left)
        _ => pass

# --- What Sema's scope doesn't keep -------------------------------------------------

# What a `:&` param or `self:&` names is the caller's (AGAST #2340).  A
# by-value `self` is a local root, as any by-value param is (#2393).
fn rv_caller_place(p: *Param) -> i32
    (p.is_borrow == 1 or p.is_self_borrow == 1) as i32

# set_local_pointee_array, on the image.
fn rv_loc_pointee_array(loc: *LocalVar, size: i32, elem: TypeKind)
    if size <= 0
        return
    if lv_pointee_type(loc) == TypeKind.Array or lv_var_type(loc) == TypeKind.PtrPtr or ref_to_ptr(loc) == 1
        lv_set_pointee_array_size(loc, size)
        lv_set_pointee_array_elem_type(loc, elem)

# The LocalVar emit_fn binds for param `p` (bind_* and mark_lent_param): what
# ref_check's typing reads of it.
#
# In an impl's method (`ib` non-null) emit_impl_method binds a lent `self`
# one level from its struct as a pointer to the impl's type, whose `@self` is
# the pointer it holds (AGAST #2286, #3071, #3079).
fn rv_param_loc(p: *Param, loc: *LocalVar, ib: *ImplBlock)
    let pt: TypeKind = p.param_pointee_type
    if p.param_type == TypeKind.Bool
        rs_loc_new(loc, StrView { ptr: (p.name), len: (p.name_len) as i64 }, TypeKind.I64, StrView { ptr: (null), len: (0) as i64 }, TypeKind.I64, 0, TypeKind.Void)   # emit_bool_param_spill
        loc.is_bool = 1
        return
    if ib != null and param_self_is_ptr(p) == 1 and self_struct_levels(p) < 2
        var self_kind: TypeKind = TypeKind.Ptr
        if p.param_type == TypeKind.Ref and p.is_self_borrow == 0
            self_kind = TypeKind.Ref
        rs_loc_new(loc, StrView { ptr: (p.name), len: (p.name_len) as i64 }, self_kind, StrView { ptr: (ib.type_name), len: (ib.type_name_len) as i64 }, TypeKind.Struct, 0, TypeKind.Void)
        if p.param_type == TypeKind.Struct or p.is_self_borrow == 1
            lv_set_holds_lent_ptr(loc, 1)
        rv_mark_lent(p, loc)
        return
    if p.param_type == TypeKind.Array
        rs_loc_new(loc, StrView { ptr: (p.name), len: (p.name_len) as i64 }, TypeKind.Array, StrView { ptr: (p.param_type_name), len: (p.param_type_name_len) as i64 }, TypeKind.I64, p.param_array_size, p.param_array_elem_type)
        lv_set_array_elem_pointee(loc, p.param_array_elem_pointee)
        lv_set_array_shape(loc, p.param_array_shape)
        return
    let lent: i32 = rv_scalar_borrow_loc(p, loc)
    if lent == 1
        rv_mark_lent(p, loc)
    if lent > 0
        return
    let t: TypeKind = p.param_type
    match t
        TypeKind.Ptr | TypeKind.PtrPtr | TypeKind.Ref | TypeKind.MutRef =>
            rs_loc_new(loc, StrView { ptr: (p.name), len: (p.name_len) as i64 }, t, StrView { ptr: (p.param_type_name), len: (p.param_type_name_len) as i64 }, pt, 0, TypeKind.Void)
            var inner: i32 = p.param_inner_pointee_type
            if inner == (TypeKind.Void as i32)
                inner = (p.param_ref_ptr_pointee as i32)
            if inner != (TypeKind.Void as i32)
                lv_set_inner_pointee_type(loc, inner)
            lv_set_inner_ref(loc, p.param_inner_ref)
            rv_loc_pointee_array(loc, p.param_pointee_array_size, p.param_pointee_array_elem_type)
            # bind_nd_pointee_param's `*[N][M]T` plane shape, and (#4313) an
            # `@[N][M]T` / `@&[N][M]T` one.  Its `**[N][M]T` and `@*[N][M]T`
            # arms (#4122) set it on a pointer-to-pointer, which ref_ty_in never
            # reads (only a pointee array's shape is a slot's).
            if (t == TypeKind.Ptr or t == TypeKind.Ref or t == TypeKind.MutRef) and p.param_pointee_array_shape != null and lv_pointee_type(loc) == TypeKind.Array
                lv_set_pointee_array_shape(loc, p.param_pointee_array_shape)
            lv_set_pointee_array_elem_pointee(loc, p.param_pointee_array_elem_pointee)
            name_array_ptr_param_loc(loc, p)
        TypeKind.Struct =>
            rs_loc_new(loc, StrView { ptr: (p.name), len: (p.name_len) as i64 }, t, StrView { ptr: (p.param_type_name), len: (p.param_type_name_len) as i64 }, TypeKind.I64, 0, TypeKind.Void)
        _ =>
            rs_loc_new(loc, StrView { ptr: (p.name), len: (p.name_len) as i64 }, t, StrView { ptr: (null), len: (0) as i64 }, TypeKind.I64, 0, TypeKind.Void)
    rv_mark_lent(p, loc)

# bind_scalar_borrow_param's locals: a `name:& T` whose `name` reads as T.
fn rv_scalar_borrow_loc(p: *Param, loc: *LocalVar) -> i32
    if p.is_borrow != 1 or p.param_type != TypeKind.MutRef
        return 0
    let pt: TypeKind = p.param_pointee_type
    match pt
        TypeKind.Array =>
            rs_loc_new(loc, StrView { ptr: (p.name), len: (p.name_len) as i64 }, TypeKind.Array, StrView { ptr: (p.param_type_name), len: (p.param_type_name_len) as i64 }, TypeKind.Array, p.param_pointee_array_size, p.param_pointee_array_elem_type)
            rv_loc_pointee_array(loc, p.param_pointee_array_size, p.param_pointee_array_elem_type)
            lv_set_pointee_array_elem_pointee(loc, p.param_pointee_array_elem_pointee)
            lv_set_array_elem_pointee(loc, p.param_pointee_array_elem_pointee)
            lv_set_array_shape(loc, p.param_pointee_array_shape)
            return 1
        TypeKind.Ptr =>
            let ipt: TypeKind = ptr_slot_flat(p.param_inner_pointee_type)
            if ipt == TypeKind.Array and p.param_pointee_array_size > 0
                rs_loc_new(loc, StrView { ptr: (p.name), len: (p.name_len) as i64 }, TypeKind.Ptr, StrView { ptr: (p.param_type_name), len: (p.param_type_name_len) as i64 }, TypeKind.Array, 0, TypeKind.Void)
                rv_loc_pointee_array(loc, p.param_pointee_array_size, p.param_pointee_array_elem_type)
                lv_set_pointee_array_elem_pointee(loc, p.param_pointee_array_elem_pointee)
                # AGAST #4122: `p:& *[N][M]T` is a plane pointer, as a `p: *[N][M]T` is.
                lv_set_pointee_array_shape(loc, p.param_pointee_array_shape)
                name_array_ptr_param_loc(loc, p)
                return 2
            let float_or_bool: bool = ipt == TypeKind.Bool or ipt == TypeKind.F32 or ipt == TypeKind.F64
            if is_borrow_scalar_kind(ipt) == 0 and ipt != TypeKind.Struct and float_or_bool == false
                return 0
            if ipt == TypeKind.Struct and p.param_type_name_len <= 0
                return 0
            rs_loc_new(loc, StrView { ptr: (p.name), len: (p.name_len) as i64 }, TypeKind.Ptr, StrView { ptr: (p.param_type_name), len: (p.param_type_name_len) as i64 }, ipt, 0, TypeKind.Void)
            lv_set_inner_ref(loc, p.param_inner_ref)
            return 2
        _ => pass
    if param_borrows_struct_ptr_ptr(p) == 1
        rs_loc_new(loc, StrView { ptr: (p.name), len: (p.name_len) as i64 }, TypeKind.PtrPtr, StrView { ptr: (p.param_type_name), len: (p.param_type_name_len) as i64 }, TypeKind.Ptr, 0, TypeKind.Void)
        if p.param_inner_pointee_type != (TypeKind.Void as i32)
            lv_set_inner_pointee_type(loc, p.param_inner_pointee_type)
        lv_set_inner_ref(loc, p.param_inner_ref)
        return 2
    let float_pt: bool = pt == TypeKind.F32 or pt == TypeKind.F64
    if is_borrow_scalar_kind(pt) == 0 and pt != TypeKind.Bool and float_pt == false
        return 0
    rs_loc_new(loc, StrView { ptr: (p.name), len: (p.name_len) as i64 }, pt, StrView { ptr: (null), len: (0) as i64 }, TypeKind.I64, 0, TypeKind.Void)
    if pt == TypeKind.Bool
        loc.is_bool = 1
    1

# mark_lent_param, on the image.
fn rv_mark_lent(p: *Param, loc: *LocalVar)
    if (p.is_borrow == 1 or p.is_self_borrow == 1) and lv_var_type(loc) == TypeKind.MutRef
        lv_set_holds_lent_ptr(loc, 1)
    if p.is_borrow != 1 or p.param_type != TypeKind.MutRef
        return
    let pt: TypeKind = p.param_pointee_type
    if pt != TypeKind.Struct and pt != TypeKind.Array and is_borrow_scalar_kind(pt) == 0
        return
    lv_set_is_lent(loc, 1)

fn rv_note_params(sm: *Sema, f: *FnDef)
    let ib: *ImplBlock = impl_of_method(sm.module, f)
    var p: *Param = f.params
    while p != null
        let v: *SemaVar = sema_find_local(sm, StrView { ptr: (p.name), len: (p.name_len) as i64 })
        if v != null
            let n: *RsNote = rs_note_new(sm, v)
            n.inner_ref = p.param_inner_ref
            n.caller_place = rv_caller_place(p)
            rv_param_loc(p, @n.loc, ib)
            # AGAST #2364: U of an `@*U` / `@&*U` param, on Sema's note.
            n.ptr_pointee = p.param_ref_ptr_pointee
            n.fn_sig = p.fn_sig   # set_local_fn_sig
            n.has_fn = 1
            n.has_loc = 1
        p = p.next

# The LocalVar emit_var_decl binds for a declared `let` / `var`: its slot as
# written (a `bool` held in an i64 slot), named as name_array_ptr_local names it.
fn rv_decl_loc(stmt: *Stmt, loc: *LocalVar)
    var t: TypeKind = stmt.var_type
    let declared_bool: i32 = (t == TypeKind.Bool) as i32
    if t == TypeKind.Bool
        t = TypeKind.I64
    let name: *u8 = stmt.var_type_name
    let len: i32 = stmt.var_type_name_len
    let pointer: i32 = (t == TypeKind.Ptr or t == TypeKind.PtrPtr or t == TypeKind.Ref or t == TypeKind.MutRef) as i32
    if t == TypeKind.Ptr and len > 0
        rs_loc_new(loc, StrView { ptr: (stmt.var_name), len: (stmt.var_name_len) as i64 }, t, StrView { ptr: (name), len: (len) as i64 }, TypeKind.Struct, 0, TypeKind.Void)
    else if (t == TypeKind.Ref or t == TypeKind.MutRef) and len > 0 and stmt.var_pointee_type != TypeKind.Array
        rs_loc_new(loc, StrView { ptr: (stmt.var_name), len: (stmt.var_name_len) as i64 }, t, StrView { ptr: (name), len: (len) as i64 }, stmt.var_pointee_type, 0, TypeKind.Void)
    else if t == TypeKind.PtrPtr and len > 0
        rs_loc_new(loc, StrView { ptr: (stmt.var_name), len: (stmt.var_name_len) as i64 }, t, StrView { ptr: (name), len: (len) as i64 }, stmt.var_pointee_type, 0, TypeKind.Void)
    else if pointer == 1
        rs_loc_new(loc, StrView { ptr: (stmt.var_name), len: (stmt.var_name_len) as i64 }, t, StrView { ptr: (null), len: (0) as i64 }, stmt.var_pointee_type, 0, TypeKind.Void)
    else
        match t
            TypeKind.Struct =>
                rs_loc_new(loc, StrView { ptr: (stmt.var_name), len: (stmt.var_name_len) as i64 }, t, StrView { ptr: (name), len: (len) as i64 }, TypeKind.I64, 0, TypeKind.Void)
            TypeKind.Array =>
                let el: TypeKind = stmt.var_array_elem_type
                let named_elem: i32 = (el == TypeKind.Struct or el == TypeKind.Ptr or el == TypeKind.PtrPtr or el == TypeKind.Ref or el == TypeKind.MutRef) as i32
                if named_elem == 1 and len > 0
                    rs_loc_new(loc, StrView { ptr: (stmt.var_name), len: (stmt.var_name_len) as i64 }, TypeKind.Array, StrView { ptr: (name), len: (len) as i64 }, TypeKind.I64, stmt.var_array_size, el)
                else
                    rs_loc_new(loc, StrView { ptr: (stmt.var_name), len: (stmt.var_name_len) as i64 }, TypeKind.Array, StrView { ptr: (null), len: (0) as i64 }, TypeKind.I64, stmt.var_array_size, el)
                lv_set_array_elem_pointee(loc, stmt.var_array_elem_pointee)
                lv_set_array_shape(loc, stmt.var_array_shape)
            _ =>
                rs_loc_new(loc, StrView { ptr: (stmt.var_name), len: (stmt.var_name_len) as i64 }, t, StrView { ptr: (null), len: (0) as i64 }, TypeKind.I64, 0, TypeKind.Void)
    if pointer == 1
        if stmt.var_inner_pointee_type != (TypeKind.Void as i32)
            lv_set_inner_pointee_type(loc, stmt.var_inner_pointee_type)
        lv_set_inner_ref(loc, stmt.var_inner_ref)
        rv_loc_pointee_array(loc, stmt.var_pointee_array_size, stmt.var_pointee_array_elem_type)
        lv_set_pointee_array_elem_pointee(loc, stmt.var_pointee_array_elem_pointee)
        if lv_pointee_type(loc) == TypeKind.Array
            lv_set_pointee_array_shape(loc, stmt.var_pointee_array_shape)
        name_array_ptr_local(loc, stmt, StrView { ptr: (name), len: (len) as i64 })
    loc.is_bool = declared_bool

# The LocalVar the emitter's inference gives an un-annotated `let x = init`,
# as far as Sema can tell it: the reference its view makes it (type_ref_view_let),
# else the type of `init`, else let_check's reading of the binding.  `v` was
# just bound.
fn rv_infer_loc(sm: *Sema, stmt: *Stmt, v: *SemaVar, loc: *LocalVar, n: *RsNote) -> i32
    let name: *u8 = stmt.var_name
    let len: i32 = stmt.var_name_len
    # bool_kind can't type the initialiser (BK_UNSURE): the emitter's local
    # says nothing then.
    if v.bk == 0
        rs_loc_new(loc, StrView { ptr: (name), len: (len) as i64 }, TypeKind.I64, StrView { ptr: (null), len: (0) as i64 }, TypeKind.I64, 0, TypeKind.Void)
        lv_set_bk_unsure(loc, 1)
        return 1
    if rv_infer_nd_addr(sm, stmt.var_init, loc) == 1 or rv_infer_base_ptr_array(sm, stmt.var_init, loc) == 1
        loc.name = name
        loc.name_len = len
        return 1
    if RV_DECL_KIND != TypeKind.Void
        rs_loc_new(loc, StrView { ptr: (name), len: (len) as i64 }, RV_DECL_KIND, StrView { ptr: (RV_DECL_REF.name), len: (RV_DECL_REF.name_len) as i64 }, RV_DECL_REF.pointee, 0, TypeKind.Void)
        n.ptr_pointee = RV_DECL_REF.ptr_pointee
        rv_loc_pointee_array(loc, RV_DECL_REF.ref_size, RV_DECL_REF.ref_elem)
        if lv_pointee_type(loc) == TypeKind.Array
            lv_set_pointee_array_shape(loc, RV_DECL_REF.ref_shape)
        return 1
    if RV_DECL_INIT_OK == 1
        let a: *RefTy = @RV_DECL_INIT
        if ref_is_pointer(a.kind) == 1
            rs_loc_new(loc, StrView { ptr: (name), len: (len) as i64 }, a.kind, StrView { ptr: (a.name), len: (a.name_len) as i64 }, a.pointee, 0, TypeKind.Void)
            n.ptr_pointee = a.ptr_pointee
            rv_loc_pointee_array(loc, a.ref_size, a.ref_elem)
            if lv_pointee_type(loc) == TypeKind.Array
                lv_set_pointee_array_shape(loc, a.ref_shape)
            return 1
        if a.kind == TypeKind.Array
            rs_loc_new(loc, StrView { ptr: (name), len: (len) as i64 }, TypeKind.Array, StrView { ptr: (a.name), len: (a.name_len) as i64 }, TypeKind.I64, a.array_len, a.pointee)
            lv_set_array_elem_pointee(loc, a.elem_pointee)
            lv_set_array_shape(loc, a.shape)
            return 1
        if a.kind != TypeKind.Unknown and a.kind != TypeKind.Void and a.kind != TypeKind.PtrPtr
            var k: TypeKind = a.kind
            if k == TypeKind.Bool or v.bk == 1   # BK_BOOL: an i64 slot
                k = TypeKind.I64
            rs_loc_new(loc, StrView { ptr: (name), len: (len) as i64 }, k, StrView { ptr: (a.name), len: (a.name_len) as i64 }, TypeKind.I64, 0, TypeKind.Void)
            loc.is_bool = (v.bk == 1) as i32
            return 1
    rs_default_loc(sm, v, loc)

# infer_array_ptr_let's `let q = h(p)`, `let q = h.r` and `let q = g`, of a
# `*[N]T` a call returns or a field or global holds (base_ptr_array, #2329):
# what it copies.  1 when `init` is one.
fn rv_infer_base_ptr_array(sm: *Sema, init: *Expr, loc: *LocalVar) -> i32
    if init == null
        return 0
    var pa: *Param = null
    match init.kind
        ExprKind.Member =>
            let f: *StructField = rs_field(sm, init)
            if f != null
                pa = f.ptr_array
        ExprKind.Ident =>
            if sema_find_local(sm, StrView { ptr: (init.ident_ptr), len: (init.ident_len) as i64 }) != null
                return 0
            let g: *GlobalVarDef = sbk_global(sm, StrView { ptr: (init.ident_ptr), len: (init.ident_len) as i64 })
            if g != null
                pa = g.ptr_array
        ExprKind.Call =>
            let fd: *FnDef = rs_call_fn(sm, init)
            if fd != null
                pa = fd.ret_ptr_array
        _ => pass
    if pa == null or pa.param_pointee_array_size <= 0
        return 0
    rs_loc_new(loc, StrView { ptr: (null), len: (0) as i64 }, pa.param_type, StrView { ptr: (null), len: (0) as i64 }, TypeKind.Array, 0, TypeKind.Void)
    lv_set_pointee_array_size(loc, pa.param_pointee_array_size)
    lv_set_pointee_array_elem_type(loc, pa.param_pointee_array_elem_type)
    1

# infer_array_ptr_let's `let q = @x[i]` of an N-D `x` (a local, global or
# field), with one index short of its rank a row `@[N]T` (#2555), fewer a plane
# `[M][N]..T` held as its flat `@[M*N..]T` (#2570).  1 when `init` is one.
fn rv_infer_nd_addr(sm: *Sema, init: *Expr, loc: *LocalVar) -> i32
    if init == null or init.kind != ExprKind.Unary or (init.op != OpKind.Addr and init.op != OpKind.AddrMut)
        return 0
    let oper: *Expr = init.operand
    if oper == null or oper.kind != ExprKind.Index
        return 0
    var depth: i32 = 0
    var base: *Expr = oper
    while base.kind == ExprKind.Index
        depth = depth + 1
        base = base.left
    var sh: *ArrayShape = null
    match base.kind
        ExprKind.Ident =>
            let arr: *LocalVar = rv_loc(sm, base)
            if arr != null and lv_var_type(arr) == TypeKind.Array
                sh = lv_array_shape(arr)
            else if sema_find_local(sm, StrView { ptr: (base.ident_ptr), len: (base.ident_len) as i64 }) == null
                let g: *GlobalVarDef = sbk_global(sm, StrView { ptr: (base.ident_ptr), len: (base.ident_len) as i64 })
                if g != null and g.var_type == TypeKind.Array
                    sh = g.array_shape
        ExprKind.Member =>
            let f: *StructField = rs_field(sm, base)
            if f != null and f.field_type == TypeKind.Array
                sh = f.array_shape
        _ => pass
    if sh == null or depth > sh.rank - 1
        return 0
    var kind: TypeKind = TypeKind.Ref
    if init.op == OpKind.AddrMut
        kind = TypeKind.MutRef
    rs_loc_new(loc, StrView { ptr: (null), len: (0) as i64 }, kind, StrView { ptr: (null), len: (0) as i64 }, TypeKind.Array, 0, TypeKind.Void)
    lv_set_pointee_array_elem_type(loc, sh.leaf_type)
    lv_set_pointee_array_elem_pointee(loc, sh.leaf_pointee)
    if depth == sh.rank - 1
        lv_set_pointee_array_size(loc, sh.dims[sh.rank - 1])
    else
        let plane: *ArrayShape = nd_shape_from(sh, depth)
        lv_set_pointee_array_size(loc, shape_leaf_count(plane))
        lv_set_pointee_array_shape(loc, plane)
    if sh.leaf_type == TypeKind.Struct
        lv_set_pointee_array_elem_name(loc, sh.leaf_name, sh.leaf_name_len)
    1

# The binding `stmt` just made, at the top of Sema's scope.
fn rv_note_decl(sm: *Sema, stmt: *Stmt)
    if sm.scope_top <= 0
        return
    let v: *SemaVar = @sm.scope[sm.scope_top - 1]
    if name_eq(StrView { ptr: (v.name), len: (v.name_len) as i64 }, StrView { ptr: (stmt.var_name), len: (stmt.var_name_len) as i64 }) == 0
        return
    let n: *RsNote = rs_note_new(sm, v)
    n.inner_ref = stmt.var_inner_ref
    n.ref_kind = RV_DECL_KIND
    n.ref_pointee = RV_DECL_REF.pointee
    n.ref_name = RV_DECL_REF.name
    n.ref_name_len = RV_DECL_REF.name_len
    if stmt.var_declared_type != TypeKind.Void
        rv_decl_loc(stmt, @n.loc)
        # AGAST #2364: U of a declared `@*U` / `@&*U`, on Sema's note.
        n.ptr_pointee = ref_decl_ptr_pointee(stmt)
        n.has_loc = 1
    else
        n.has_loc = rv_infer_loc(sm, stmt, v, @n.loc, n)
        # AGAST #4458: an un-annotated `let x = r.unwrap()` whose Option /
        # Result payload is a reference or pointer.  rv_infer_loc has no
        # unwrap rule and made a plain i64 image of it; let_check's
        # let_note_decl records the binding as `@T` / `@&T` / `*T` and the
        # emitter lowers it so.  Type the note the same way, so Sema's checks
        # and call_check's place image of `x` agree with the slot it gets.
        var uk: TypeKind = TypeKind.Void
        var un: *u8 = null
        var unl: i32 = 0
        var up: TypeKind = TypeKind.Void
        if let_unwrap_payload_pointer(sm, stmt.var_init, @uk, @un, @unl, @up) == 1
            n.ref_kind = uk
            n.ref_pointee = up
            n.ref_name = un
            n.ref_name_len = unl
            n.ptr_pointee = TypeKind.Void
            n.has_loc = 1
            rs_loc_new(@n.loc, StrView { ptr: (stmt.var_name), len: (stmt.var_name_len) as i64 }, uk, StrView { ptr: (un), len: (unl) as i64 }, up, 0, TypeKind.Void)
        # The `q#` view add_array_view gives what the inference made a `*[N]T`,
        # which SemaVar.index_elem, from what's written, can't know.
        let lo: *LocalVar = @n.loc
        if n.has_loc == 1 and lv_bk_unsure(lo) == 0 and lv_pointee_type(lo) == TypeKind.Array and lv_pointee_array_size(lo) > 0 and ref_is_pointer(lv_var_type(lo)) == 1
            var vn_len: i32 = 0
            let vn: *u8 = array_ptr_elem_name(lo, @vn_len)
            if sx_view_elem_ok(sm, lv_pointee_array_elem_type(lo), StrView { ptr: (vn), len: (vn_len) as i64 }) == 1
                n.infer_view = lv_pointee_array_elem_type(lo)
    n.fn_sig = RV_DECL_FN   # set_local_fn_sig
    n.has_fn = 1
    if RV_DECL_ROOT == null
        return
    # An un-annotated `let` holds the `@T`.  `let n: i64 = @c` is a pointer as an
    # integer: no reference, whatever the binding says.
    let declared: TypeKind = stmt.var_declared_type
    if declared == TypeKind.Void or declared == TypeKind.PtrPtr or ref_is_pointer(declared) == 1 or rv_decl_is_span(stmt) == 1
        n.root = RV_DECL_ROOT
        n.root_len = RV_DECL_ROOT_LEN
        n.root_loops = RV_LOOPS
        n.root_pointee = RV_DECL_TY.pointee
        n.root_name = RV_DECL_TY.name
        n.root_name_len = RV_DECL_TY.name_len

# The fn type the local `stmt` declares holds, as emit_var_decl's
# inferred_fn_sig: its own, or an un-annotated `let h = t.f` / `fs[1]`'s, or
# `let f = mb`'s mb.  Before the binding exists.
fn rv_decl_fn_sig(sm: *Sema, stmt: *Stmt) -> *FnDef
    if stmt.var_fn_sig != null or stmt.var_declared_type != TypeKind.Void
        return stmt.var_fn_sig
    let init: *Expr = stmt.var_init
    if init != null and (init.kind == ExprKind.Member or init.kind == ExprKind.Index)
        var t: SemaTy
        sema_expr_ty(sm, init, @t)
        return t.fn_sig
    if init == null or init.kind != ExprKind.Ident
        return null
    if sema_find_local(sm, StrView { ptr: (init.ident_ptr), len: (init.ident_len) as i64 }) != null or sbk_global(sm, StrView { ptr: (init.ident_ptr), len: (init.ident_len) as i64 }) != null
        return null
    let f: *FnDef = sema_find_fn(sm, StrView { ptr: (init.ident_ptr), len: (init.ident_len) as i64 })
    if f == null or f.type_params != null
        return null
    f

# A declaration's initialiser, before its binding exists: what root it refers
# to, its type, and whether the emitter types an un-annotated binding as a
# reference (emitter_stmt's let_ref_view / type_ref_view_let, AGAST #3079).
fn rv_before_decl(sm: *Sema, stmt: *Stmt)
    RV_DECL_ROOT = rv_referent(sm, stmt.var_init, @RV_DECL_ROOT_LEN)
    # LARB R57: a Span slot holds a view of the local Vec or String it slices.
    if RV_DECL_ROOT == null and rv_decl_is_span(stmt) == 1
        RV_DECL_ROOT = rv_span_view_root(sm, stmt.var_init, @RV_DECL_ROOT_LEN)
    if RV_DECL_ROOT != null and rv_referent_ty(sm, stmt.var_init, @RV_DECL_TY) == 0
        RV_DECL_TY.pointee = TypeKind.Void
    RV_DECL_KIND = TypeKind.Void
    RV_DECL_INIT_OK = 0
    RV_DECL_FN = rv_decl_fn_sig(sm, stmt)
    if stmt.var_init != null
        RV_DECL_INIT_OK = rv_ty(sm, stmt.var_init, @RV_DECL_INIT)
    if stmt.var_type != TypeKind.I64 or stmt.var_type_name_len != 0 or stmt.var_init == null
        return
    var env: RefEnv
    let view: i32 = ref_view_in(rv_env(sm, @env), stmt.var_init)
    if view == REF_VIEW_SHARED
        RV_DECL_KIND = TypeKind.Ref
    else if view == REF_VIEW_MUT
        RV_DECL_KIND = TypeKind.MutRef
    else
        return
    # What it points at, as the inference typed it before the view made it a
    # reference: `@q` of a `*C` is an `@*C`.
    if RV_DECL_INIT_OK == 0 or ref_is_pointer(RV_DECL_INIT.kind) == 0
        ref_set(@RV_DECL_REF, RV_DECL_KIND, TypeKind.Void, StrView { ptr: (null), len: (0) as i64 })
    else
        RV_DECL_REF = RV_DECL_INIT

# A match arm's payload binding, just bound: an `@T` or `@&T` variant field
# binds as one (lower_ref_fields made it a `*T` with a flag).  Only a user
# enum's tuple variant; anything else stays as Sema typed it.
pub fn ref_value_note_arm(sm: *Sema, arm: *MatchArm, scrut: *Expr)
    if scrut == null or arm.pattern_kind != PAT_VARIANT or arm.pattern_inner_kind != PAT_IDENT or sm.scope_top <= 0
        return
    let v: *SemaVar = @sm.scope[sm.scope_top - 1]
    if name_eq(StrView { ptr: (v.name), len: (v.name_len) as i64 }, StrView { ptr: (arm.pattern_inner_name), len: (arm.pattern_inner_name_len) as i64 }) == 0
        return
    sm.scope_top = sm.scope_top - 1   # the scrutinee is read outside the arm
    var t: SemaTy
    sema_expr_ty(sm, scrut, @t)
    sm.scope_top = sm.scope_top + 1
    if t.kind == TypeKind.Unknown or t.name == null or t.name_len <= 0 or user_enum_index(sm.pctx, StrView { ptr: (t.name), len: (t.name_len) as i64 }) < 0
        return
    let f: *StructField = user_enum_tuple_field(sm.pctx, StrView { ptr: (t.name), len: (t.name_len) as i64 }, arm_variant_sel(sm.pctx, StrView { ptr: (t.name), len: (t.name_len) as i64 }, arm))
    if f == null or f.field_shared_ref == 0 and f.field_mut_ref == 0
        return
    let n: *RsNote = rs_note_new(sm, v)
    n.ref_kind = TypeKind.Ref
    if f.field_mut_ref == 1
        n.ref_kind = TypeKind.MutRef
    n.ref_pointee = f.ptr_pointee
    if n.ref_pointee == TypeKind.Void and f.field_type_name_len > 0
        n.ref_pointee = TypeKind.Struct
    n.ref_name = f.field_type_name
    n.ref_name_len = f.field_type_name_len

# A match arm's payload binding, just bound (after ref_value_note_arm): the
# local emit_arm_payload_bind makes.  A scalar payload goes through
# bool_note_binding, which leaves one of no bool or integer kind bk_unsure, so
# ref_check's typing doesn't read it; a struct or array payload is read, and so
# is a pointer payload (`@C`, `@&C`, `*C`): it is a reference as ritz0 reads
# it, and the slot checks judge it (AGAST #4143).
pub fn ref_value_bind_arm(sm: *Sema, arm: *MatchArm)
    if arm.pattern_kind != PAT_VARIANT or arm.pattern_inner_kind != PAT_IDENT or sm.scope_top <= 0
        return
    let v: *SemaVar = @sm.scope[sm.scope_top - 1]
    if name_eq(StrView { ptr: (v.name), len: (v.name_len) as i64 }, StrView { ptr: (arm.pattern_inner_name), len: (arm.pattern_inner_name_len) as i64 }) == 0
        return
    var n: *RsNote = rs_note(sm, v)
    if n == null
        n = rs_note_new(sm, v)
    n.has_loc = rs_default_loc(sm, v, @n.loc)
    if n.has_loc == 0 or lv_var_type(@n.loc) == TypeKind.Struct or lv_var_type(@n.loc) == TypeKind.Array
        return
    if ref_is_pointer(lv_var_type(@n.loc)) == 1
        return
    # BK_BOOL, BK_INT; a float payload binds a float local, with no note.
    if v.bk != 1 and v.bk != 2 and v.bk != 4
        lv_set_bk_unsure(@n.loc, 1)

# --- The walk's hooks ----------------------------------------------------------------

# A fn begins, its params bound.
pub fn ref_value_begin_fn(sm: *Sema, f: *FnDef)
    RV_LAST_LINE = 0
    RV_LAST_COL = 0
    RV_LOOPS = 0
    RV_TAIL_COUNT = 0
    RV_ARG_EXPR = null
    RV_IN_ARG = 0
    RV_DECL_ROOT = null
    rs_notes_clear()
    rv_note_params(sm, f)
    if ref_of_fn(f, @RV_RET) == 0
        RV_RET.kind = TypeKind.Void
    # `-> *i32` and `-> **T` name nothing ref_of_fn can, and still leave as pointers.
    RV_RET.returned = 0
    if ref_is_pointer(f.return_type) == 1 or f.return_type == TypeKind.PtrPtr
        RV_RET.returned = 1
    # LARB R57: a `-> Span<T>` return leaves with a view the caller holds.
    if rv_is_span(@RV_RET) == 1
        RV_RET.returned = 1
    # AGAST #2329/#3999: a `-> *[N]T` return, as a param would carry it, so a
    # returned pointer value is judged against its N and T (LARB R71).
    RV_RET_ARRAY_OK = 0
    if f.ret_ptr_array != null and ref_of_param(f.ret_ptr_array, @RV_RET_ARRAY) == 1
        RV_RET_ARRAY_OK = 1
    if RV_RET.kind != TypeKind.Void or RV_RET.returned == 1
        rv_note_stmts(f.body, @RV_RET)

# What a write's place evaluates on the way: its base and its index.
fn rv_walk_target(sm: *Sema, stmt: *Stmt)
    let k: StmtKind = stmt.kind
    if k == StmtKind.MemberAssign or k == StmtKind.MemberIndexAssign or k == StmtKind.Assign and stmt.assign_target_len == 0
        rv_walk(sm, stmt.if_cond as *Expr)
    if k == StmtKind.IndexAssign or k == StmtKind.LocalFieldIndexAssign or k == StmtKind.MemberIndexAssign
        rv_walk(sm, stmt.while_cond)

# Statement `stmt`, before the statements nested in it: its own place and
# values (an `if` or loop's condition, a `for`'s range).
pub fn ref_value_check_stmt(sm: *Sema, stmt: *Stmt)
    let k: StmtKind = stmt.kind
    rv_check_temp_store(sm, stmt)
    rv_check_write(sm, stmt)
    rv_walk_target(sm, stmt)
    var env: RefEnv
    var slot: RefTy
    match k
        StmtKind.VarDecl =>
            if stmt.var_init != null and rv_decl_slot(stmt, @slot) == 1
                rv_into(sm, stmt.var_init, @slot)
            rv_walk(sm, stmt.var_init)
            rv_before_decl(sm, stmt)
        StmtKind.TupleDecl =>
            rv_walk(sm, stmt.var_init)
        StmtKind.Assign =>
            var known: i32 = 0
            if stmt.assign_target_len > 0
                known = rv_slot_of_name(sm, StrView { ptr: (stmt.assign_target), len: (stmt.assign_target_len) as i64 }, @slot)
            else
                known = rv_ty(sm, stmt.if_cond as *Expr, @slot)
            if known == 1
                rv_into(sm, stmt.assign_value, @slot)
            rv_walk(sm, stmt.assign_value)
            if stmt.assign_target_len > 0
                rv_forget_name(sm, StrView { ptr: (stmt.assign_target), len: (stmt.assign_target_len) as i64 })
        StmtKind.Return =>
            rv_into(sm, stmt.return_value, @RV_RET)
            rv_walk(sm, stmt.return_value)
        StmtKind.Expr =>
            ref_value_check_value(sm, stmt.expr)
        StmtKind.Match | StmtKind.If | StmtKind.Assert =>
            rv_walk(sm, stmt.if_cond as *Expr)
        StmtKind.While =>
            rv_walk(sm, stmt.while_cond)
            RV_LOOPS = RV_LOOPS + 1
        StmtKind.For =>
            rv_walk(sm, stmt.for_start)
            rv_walk(sm, stmt.for_end)
            RV_LOOPS = RV_LOOPS + 1
        StmtKind.Loop =>
            RV_LOOPS = RV_LOOPS + 1
        StmtKind.Asm =>
            # An asm block (§18.6, AGAST #3395) assigns its `out` / `inout` operands.
            var o: *AsmOperand = stmt.asm_block.operands
            while o != null
                if o.dir == ASM_OUT or o.dir == ASM_INOUT
                    rv_forget_name(sm, StrView { ptr: (o.name), len: (o.name_len) as i64 })
                o = o.next
        StmtKind.LocalFieldAssign =>
            var owner: RefTy
            if ref_of_ident_in(rv_env(sm, @env), StrView { ptr: (stmt.var_name), len: (stmt.var_name_len) as i64 }, @owner) == 1
                rv_into_field(sm, stmt, @owner)
            rv_walk(sm, stmt.assign_value)
        StmtKind.MemberAssign =>
            var base: RefTy
            if rv_ty(sm, stmt.if_cond, @base) == 1
                rv_into_field(sm, stmt, @base)
            rv_walk(sm, stmt.assign_value)
        StmtKind.IndexAssign =>
            var held: RefTy
            if ref_of_ident_in(rv_env(sm, @env), StrView { ptr: (stmt.assign_target), len: (stmt.assign_target_len) as i64 }, @held) == 1
                if held.kind == TypeKind.Array or ref_is_pointer(held.kind) == 1
                    var part: RefTy
                    rv_element(@held, @part)
                    rv_into(sm, stmt.assign_value, @part)
            rv_walk(sm, stmt.assign_value)
        StmtKind.LocalFieldIndexAssign | StmtKind.MemberIndexAssign =>
            rv_walk(sm, stmt.assign_value)
        _ => pass

# A tail or a match arm's value, its bindings in scope.
pub fn ref_value_check_value(sm: *Sema, e: *Expr)
    rv_landed(sm, e)
    rv_walk(sm, e)

# After statement `stmt` and what's nested in it: a declaration's binding exists
# now, and a loop is over.
pub fn ref_value_after(sm: *Sema, stmt: *Stmt)
    let k: StmtKind = stmt.kind
    if k == StmtKind.While or k == StmtKind.For or k == StmtKind.Loop
        RV_LOOPS = RV_LOOPS - 1
    if k == StmtKind.VarDecl
        rv_note_decl(sm, stmt)
    RV_DECL_ROOT = null
