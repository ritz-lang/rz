# diag.ritz - ritz1's located diagnostics (AGAST #3445, LARB review/5 N5)
#
# Every ritz1 error is one line on stderr:
#
#     <file>:<line>:<col>: error: <message>
#
# the shape ritz0 and the rest of the toolchain print.  Before #3445 ritz1
# had ~60 printers of its own (42 hand-rolled `error: ` prefixes, each with
# its own `if file != null ... "<input>"` fallback, and per-module helpers
# such as si_error_at, enum_error_at and own_eprint_loc), half of them
# printing `error: <file>:...` the other way round, and 56 emit_ir_error
# calls with no location at all.  The parser side (ast_helpers,
# struct_index, generic_infer, sema, call_check) goes through here; the
# emitter files and emit_ir_error followed in AGAST #3621.  The tools-unit lint
# tools/test_ritz1_diag_lint.py keeps a bare `error: ` prefix out of every
# file but diag (its allowlist emptied in #3621).
#
# The message text is the caller's and is frozen: the *_rules.py strings are
# shared with ritz0.  Only the location prefix is diag's.
#
# A message is one of:
#   diag_error       a StrView (a "..." literal)
#   diag_error_name  head, a (ptr, len) name, tail -- the common "`x` ..." shape
#   diag_error_buf   a String built with format_into (AGAST #1824):
#                        var m: String = string_new()
#                        format_into(@&m, "unhandled statement kind {k}")
#                        diag_error_buf(file, span, @m)
#                        string_drop(@&m)
#   diag_error_at    the prefix alone, for a message printed piecewise after it
#   diag_file_error_at  `<file>: error: `, for a file-wide error with no line
#
# None of these count the error: each pass keeps its own count (s.diag.error_count,
# g_si_errors, ...) and bumps it at the call.
#
# AGAST #4844: an error inside a generic's instance (cell_get$T, the
# Vec$T.get method) is located in the generic's file, which doesn't say
# which call in the user's code made the instance.  A pass that checks fn
# bodies says which fn it is in (diag_enter_fn: Sema's walk, the emitter);
# an error raised there is followed by one line per instantiation step,
# innermost first, down to the first non-generic body:
#
#     <gvec.ritz>:235:16: error: cannot move out of a reference
#     <main.ritz>:11:16: note: `Vec<T>.get` instantiated here (and 1 more)
#
# A message is printed piecewise after diag_error_at, so the notes wait for
# its end: diag_error* print them after their newline, and a message built
# by hand gets them at the next diag_error_at or diag_enter_fn.

import ritzlib.cstr
import ritzlib.sys
import ritzlib.io
import ritzlib.string
import ritzlib.strview

import ast

# AGAST #4319: the input file, for located diagnostics from modules that do
# not import the emitter.  The driver sets it once (main.ritz); emitter_core
# exposes the old emitter_set_source_file / emitter_source_file names as
# wrappers over it, so emitter call sites are unchanged.
var g_source_file: *u8 = null
# AGAST #4844: the fn the checking pass is in, and the one whose notes the
# error being printed still owes.
var g_diag_fn: *FnDef = null
var g_diag_pending: *FnDef = null
# The input's path for a note's site in one of its fns, set before Sema runs
# (g_source_file is set only for emission).
var g_note_file: StrView = StrView { ptr: (null), len: (0) as i64 }

pub fn diag_set_note_file(path: StrView)
    g_note_file = path

pub fn diag_set_source_file(path: *u8)
    g_source_file = path

pub fn diag_source_file() -> *u8
    g_source_file

# The file a fn's lines belong to: a specialised generic may come from an
# import, so its def_file wins; else the driver's input path.
pub fn diag_fn_source_file(f: *FnDef) -> *u8
    if f != null and f.def_file != null
        return f.def_file
    if g_source_file != null
        return g_source_file
    c"<input>"  # S-TEXT-1: fn returns *u8 — callers compare it by pointer
                # identity (variant_site_set/tt_site_once) and print it via
                # eprints_cstr (NUL-terminated); a true C-interop sink

# A span from a (line, col) pair, for callers that carry the two separately.
pub fn diag_span(line: i32, col: i32) -> SrcSpan
    SrcSpan { line: line, col: col }

# `<file>:<line>:<col>`, with `<input>` for a source that has no path.
pub fn diag_loc(file: *u8, span: SrcSpan)
    let f: StrView = diag_file_view(file)
    let line: i32 = span.line
    let col: i32 = span.col
    var m: String = string_new()
    format_into(@&m, "{f}:{line}:{col}")
    eprint_string(@m)

# The path a diagnostic names: `file`'s bytes, or `<input>` for a source that
# has no path.  `file` is the driver's argv path, so it arrives NUL-terminated.
fn diag_file_view(file: *u8) -> StrView
    if file == null
        return "<input>"
    strview_from_cstr(file)

# `<file>:<line>:<col>: error: ` -- the prefix of every ritz1 error.
pub fn diag_error_at(file: *u8, span: SrcSpan)
    diag_flush_notes()
    diag_loc(file, span)
    eprints(": error: ")
    if g_diag_fn != null and g_diag_fn.inst_site != null
        g_diag_pending = g_diag_fn

# AGAST #4844: the checking pass is now in `f`'s body (null: in none).  The
# last error's notes, if it owes any, go first.
pub fn diag_enter_fn(f: *FnDef)
    diag_flush_notes()
    g_diag_fn = f

# The notes the last error owes, if any: its message has ended.
pub fn diag_flush_notes()
    if g_diag_pending == null
        return
    let f: *FnDef = g_diag_pending
    g_diag_pending = null
    diag_inst_notes(f)

# One `<file>:<line>:<col>: note: ...` line per instantiation step from
# instance `f` out, innermost first, ending at the first non-generic body.
pub fn diag_inst_notes(f: *FnDef)
    var m: String = string_new()
    diag_inst_notes_into(@&m, f)
    eprint_string(@m)

# diag_inst_notes' lines, appended to `out`: own_check holds its errors in a
# buffer until the module's walk is done, and their notes go with them.
pub fn diag_inst_notes_into(out: @&String, f: *FnDef)
    var at: *FnDef = f
    var depth: i32 = 0
    while at != null and at.inst_site != null and depth < 64   # MAX_INSTANCE_DEPTH
        let site: *InstSite = at.inst_site
        var from: *FnDef = site.from
        if from == null and site.from_site != null
            from = site.from_site.inst
        if from == null or site.line <= 0
            return   # named by no body (a trait impl, a type): nothing to point at
        diag_inst_note(out, site, from)
        at = from
        depth += 1

# `<file>:<line>:<col>: note: `<instance>` instantiated here`, the site in
# `from`'s file, plus "(and N more)" when other places name it too.
fn diag_inst_note(out: @&String, site: *InstSite, from: *FnDef)
    var file: StrView = g_note_file
    if from.def_file != null or file.len == 0
        file = diag_file_view(diag_fn_source_file(from))
    let line: i32 = site.line
    let col: i32 = site.col
    let name: StrView = site.name
    format_into(out, "{file}:{line}:{col}: note: `{name}")
    diag_inst_args(out, site.args)
    if site.method.len > 0
        out.push('.')
        out.push_str(site.method)
    out.push_str("` instantiated here")
    if site.more > 0
        let more: i32 = site.more
        format_into(out, " (and {more} more)")
    out.push('\n')

# A mangled suffix as written: "$Line" is `<Line>`, "$K$V" is `<K, V>`.
fn diag_inst_args(out: @&String, args: StrView)
    if args.len < 2 or *args.ptr != '$'
        return
    out.push('<')
    var i: i64 = 1
    while i < args.len
        let c: u8 = *(args.ptr + i)
        if c == '$'
            out.push_str(", ")
        else
            out.push(c)
        i += 1
    out.push('>')

# `<file>: error: `, for an error about the file as a whole (a tally, say),
# which has no line or column to give (AGAST #3621).
pub fn diag_file_error_at(file: *u8)
    eprints(diag_file_view(file))
    eprints(": error: ")

# `<file>:<line>:<col>: error: <msg>`, one line.
pub fn diag_error(file: *u8, span: SrcSpan, msg: StrView)
    diag_error_at(file, span)
    eprints(msg)
    eprint_char('\n')
    diag_flush_notes()

# `<file>:<line>:<col>: error: <head><name><tail>`, one line: the common
# "`x` ..." shape, `name` a token or identifier from the source.
pub fn diag_error_name(file: *u8, span: SrcSpan, head: StrView, name: StrView, tail: StrView)
    diag_error_at(file, span)
    eprints(head)
    eprints(name)
    eprints(tail)
    eprint_char('\n')
    diag_flush_notes()

# The name a diagnostic shows for fn `f` (AGAST #4018).  main_abi_rename
# renames an adapted main `__ritz_main`, but the user wrote `main`, so every
# message that names the fn it is in says `main`.  ritz0's twin is
# main_abi.display_name.
pub fn fn_display_name(f: *FnDef) -> StrView
    let adapted: StrView = "__ritz_main"   # main_abi_rename's name
    var same: i32 = 0
    if f.name_len == 11
        same = 1
        var i: i32 = 0
        while i < 11
            if *(f.name + i) != *(adapted.ptr + i)
                same = 0
            i += 1
    if same == 1
        return "main"
    StrView { ptr: f.name, len: f.name_len as i64 }

# `<file>:<line>:<col>: error: <msg's bytes>`, one line; `msg` is typically
# built with format_into.
pub fn diag_error_buf(file: *u8, span: SrcSpan, msg: @String)
    diag_error_at(file, span)
    eprint_string(msg)
    eprint_char('\n')
    diag_flush_notes()

# `e` as written, for naming a lent argument: ritz0's _render_lent.  Shared by
# ref_check and struct_index (AGAST #2847).
pub fn diag_eprint_lent(e: *Expr)
    if e == null
        eprints("..")
        return
    let k: ExprKind = e.kind
    match k
        ExprKind.Ident =>
            sys_write(2, e.ident.ptr, e.ident.len)
        ExprKind.IntLit =>
            eprint_int(e.int_val)
        _ =>
            if k == ExprKind.Unary and (e.op == OpKind.Addr or e.op == OpKind.AddrMut)
                if e.op == OpKind.AddrMut
                    eprints("@&")
                else
                    eprint_char('@')
                diag_eprint_lent(e.operand)
            else
                match k
                    ExprKind.Call | ExprKind.Method =>
                        if k == ExprKind.Call
                            sys_write(2, e.func_name.ptr, e.func_name.len)
                        else
                            diag_eprint_lent(e.left)
                            eprint_char('.')
                            sys_write(2, e.ident.ptr, e.ident.len)
                        eprint_char('(')
                        var a: *Expr = e.args
                        while a != null
                            diag_eprint_lent(a)
                            if a.next != null
                                eprints(", ")
                            a = a.next
                        eprint_char(')')
                    ExprKind.Member =>
                        diag_eprint_lent(e.left)
                        eprint_char('.')
                        sys_write(2, e.ident.ptr, e.ident.len)
                    ExprKind.Index =>
                        diag_eprint_lent(e.left)
                        eprint_char('[')
                        diag_eprint_lent(e.right)
                        eprint_char(']')
                    _ =>
                        eprints("..")

# AGAST #4626: what a private fn's symbol hashes for its file `abs` (from
# emitter_core fn_def_file_abs): the path relative to the nearest directory
# above it that holds a `.git` (a checkout or a worktree), else `abs` itself.
# Two worktrees then spell one file's private fns alike, so the artifact
# store every worktree on a host shares can serve one's object to the other;
# with the absolute path a harness compiled in one declared `helper__<its
# hash>` and linked against an object that defined `helper__<the other's>`.
# As ritz0's symbol_file_key.  A pointer into `abs`.  Here, not in
# emitter_core, which the M1.3 large-file ratchet holds.
pub fn diag_symbol_file_key(abs: *u8) -> *u8
    var alen: i64 = 0
    while *(abs + alen) != 0
        alen += 1
    if alen + 6 > 4096
        return abs
    var probe: [4096]u8
    let p: *u8 = @probe[0]
    var i: i64 = 0
    while i < alen
        *(p + i) = *(abs + i)
        i += 1
    # Shortest dir last: writing "/.git" at k only clobbers bytes past the
    # next, shorter, candidate's prefix.
    var k: i64 = alen - 1
    let git_suffix: StrView = "/.git"
    while k >= 0
        if *(abs + k) == '/'
            var j: i64 = 0
            while j < 6   # "/.git" and its NUL
                *(p + k + j) = *(git_suffix.ptr + j)
                j += 1
            var st: Stat
            if sys_lstat2(p, @&st) == 0
                return abs + k + 1
        k -= 1
    abs
