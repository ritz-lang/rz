# ritz1/src/emitter_stmt.ritz - Statement Emission
#
# emit_var_decl / emit_assign / emit_return / emit_stmt.
# Split from emitter.ritz.

import ritzlib.sys
import ritzlib.io
import ritzlib.str
import ritzlib.gvec
import ritzlib.memory

import ast
import index_through
import ast_helpers
import tokens_gen
import emitter_core
import emitter_expr
import emitter_expr_arith    # deref_pointee_struct_name (AGAST #1505)
import emitter_match
import narrowing           # check_implicit_narrowing (AGAST #1364)
import let_check           # let_check_stmt / let_mark_decl (AGAST #2028)
import binder_check        # binder_mark_decl (AGAST #2407)
import emitter_expr_call   # method_callee_def (AGAST #1798)
import emitter_print       # emit_assert_stmt (AGAST #1869)
import enum_as_int        # enum_as_int_stmt (AGAST #2136)
import ownership          # move check + drops (AGAST #2158)
import ref_check          # ref_view (AGAST #2338)
import must_use           # must_use_check (AGAST #2137)
import bool_check   # AGAST #2342
import literal_slot # AGAST #2341
import ref_check    # ref_array_error (AGAST #2343)

# resolve_member_chain_field moved to emitter_core (AGAST #1660) so the
# binary-op emitter can type enum-valued member operands too.

# int_to_float_slot / expr_is_definitely_int moved to emitter_expr (AGAST
# #2065) so emit_field_elem_narrow can convert integer values too.

# AGAST #2321: `let p = @a`, `let p = @&a` and `let q = p` hold what an annotated
# local does: N and T, so `p[i]` is an element, and the kind, so it loads as one.
# Returns 1 when it typed the local.
# AGAST #2372: `let p = @q` with `q: *S` holds an `@*S`, so `p.f` reaches S.  It
# stayed an i64 with no struct name: "unhandled EXPR_MEMBER".
fn infer_ref_to_pointer_let(s: *EmitterState, stmt: *Stmt) -> i32
    let init: *Expr = stmt.var_init
    if stmt.var_type != TYPE_I64 or stmt.var_type_name_len != 0 or init == null
        return 0
    if init.kind != EXPR_UNARY or (init.op != OP_ADDR and init.op != OP_ADDR_MUT)
        return 0
    if init.operand == null or init.operand.kind != EXPR_IDENT
        return 0
    let src: *LocalVar = find_local_struct_name(s, init.operand.ident_ptr, init.operand.ident_len)
    if src == null or (src.var_type != TYPE_PTR and src.var_type != TYPE_PTR_PTR)
        return 0
    if src.var_type == TYPE_PTR and src.pointee_type == TYPE_ARRAY
        return infer_ref_to_array_pointer_let(stmt, src)
    if src.type_name_len > 0 and is_enum_type(src.type_name, src.type_name_len) == 1
        return infer_ref_to_enum_pointer_let(stmt, src)
    if find_struct(s, src.type_name, src.type_name_len) == null
        return infer_ref_to_scalar_pointer_let(stmt, src)
    stmt.var_type = TYPE_REF
    if init.op == OP_ADDR_MUT
        stmt.var_type = TYPE_MUT_REF
    stmt.var_type_name = src.type_name
    stmt.var_type_name_len = src.type_name_len
    stmt.var_pointee_type = src.var_type
    stmt.var_inner_pointee_type = src.inner_pointee_type
    1

# AGAST #2960: the struct a `ptr`-valued if / match arm points at, or null:
# `@&x` with x a struct (or `:&` struct) local, `@&a.b` a struct field, an
# `@&S` local, or a nested if / match all of whose value arms name one S.
fn ptr_arm_struct(s: *EmitterState, e: *Expr, out_len: *i32) -> *u8
    *out_len = 0
    if e == null
        return null
    if e.kind == EXPR_IF or e.kind == EXPR_MATCH
        return ptr_arms_struct(s, e.args as *MatchArm, out_len)
    if e.kind == EXPR_IDENT
        let rl: *LocalVar = find_local_struct_name(s, e.ident_ptr, e.ident_len)
        if rl == null or rl.var_type != TYPE_MUT_REF or rl.pointee_type != TYPE_STRUCT or rl.type_name_len == 0
            return null
        *out_len = rl.type_name_len
        return rl.type_name
    if e.kind != EXPR_UNARY or e.op != OP_ADDR_MUT or e.operand == null
        return null
    let o: *Expr = e.operand
    if o.kind == EXPR_IDENT
        let loc: *LocalVar = find_local_struct_name(s, o.ident_ptr, o.ident_len)
        if loc == null or loc.type_name_len == 0
            return null
        if loc.var_type != TYPE_STRUCT and lent_struct_local(s, o) == null
            return null
        *out_len = loc.type_name_len
        return loc.type_name
    if o.kind == EXPR_MEMBER
        let f: *StructField = resolve_member_chain_field(s, o)
        if f == null or f.field_type != TYPE_STRUCT or f.field_type_name_len == 0
            return null
        *out_len = f.field_type_name_len
        return f.field_type_name
    null

# AGAST #2960: the one struct every value arm of `arms` points at, or null.
fn ptr_arms_struct(s: *EmitterState, arms: *MatchArm, out_len: *i32) -> *u8
    var name: *u8 = null
    var len: i32 = 0
    var a: *MatchArm = arms
    while a != null
        if a.is_pass == 0 and a.body != null
            var alen: i32 = 0
            let an: *u8 = ptr_arm_struct(s, a.body, @alen)
            if an == null or (name != null and name_eq(name, len, an, alen) == 0)
                *out_len = 0
                return null
            name = an
            len = alen
        a = a.next
    *out_len = len
    name

# AGAST #2960: an un-annotated `let p = if … @&c else @&c` (or match) holds
# what `let p: @&C = …` does: an `@&C` slot, the `ptr` phi stored as is, so
# `p.x` reaches C.  Asked before the arms are emitted, in the let's scope, as
# arms_ptr_valued is.  It stayed an i64 with no name: `p.x = 3` was
# "unhandled EXPR_MEMBER".  Returns the struct's name, or null.
fn ptr_phi_let_struct(s: *EmitterState, init: *Expr, out_len: *i32) -> *u8
    *out_len = 0
    if arms_ptr_valued(s, init.args as *MatchArm) == 0
        return null
    ptr_arms_struct(s, init.args as *MatchArm, out_len)

# AGAST #2532: `let r = @q` with `q: *T` or `**T`, T a scalar, holds what
# `let r: **T` / `***T` does, as #2376 types `let r = @a[i]`.  It was an i64,
# so `**r` loaded and stored 8 bytes and `*r + 1` strode by one.
fn infer_ref_to_scalar_pointer_let(stmt: *Stmt, src: *LocalVar) -> i32
    var inner: i32 = src.pointee_type
    if src.var_type == TYPE_PTR_PTR
        inner = src.inner_pointee_type
    let leaf: i32 = inner % PTR_DEPTH_UNIT
    if src.type_name_len != 0 or leaf < TYPE_I32 or leaf > TYPE_F64 or leaf == TYPE_PTR or leaf == TYPE_PTR_PTR
        return 0
    if src.var_type == TYPE_PTR_PTR
        inner = inner + PTR_DEPTH_UNIT
    stmt.var_type = TYPE_PTR_PTR
    stmt.var_pointee_type = TYPE_PTR
    stmt.var_inner_pointee_type = inner
    1

# AGAST #2539: `let r = @q` with `q: *E` or `**E`, E an enum, holds what
# `let r: **E` / `***E` does: the name, so `**r` loads and stores an %E.  It
# was an i64: `**r = E.V` stored an i64 of a %E and clang refused it.
fn infer_ref_to_enum_pointer_let(stmt: *Stmt, src: *LocalVar) -> i32
    var inner: i32 = src.pointee_type
    if src.var_type == TYPE_PTR_PTR
        inner = src.inner_pointee_type + PTR_DEPTH_UNIT
    stmt.var_type = TYPE_PTR_PTR
    stmt.var_pointee_type = TYPE_PTR
    stmt.var_inner_pointee_type = inner
    stmt.var_type_name = src.type_name
    stmt.var_type_name_len = src.type_name_len
    1

# AGAST #2539: `let r = @q` with `q: *[N]T` holds what `let r: **[N]T` does: a
# `**` whose inner pointee is the array, with N and T, so `let p = *r` is a
# `*[N]T` again.  It was an i64: `p[1]` strode one byte, and a store crashed.
# Checked before the struct arm: a `*[N]S` names S, and isn't a `*S`.
fn infer_ref_to_array_pointer_let(stmt: *Stmt, src: *LocalVar) -> i32
    if src.pointee_array_size <= 0
        return 0
    stmt.var_type = TYPE_PTR_PTR
    stmt.var_pointee_type = TYPE_PTR
    stmt.var_inner_pointee_type = TYPE_ARRAY
    stmt.var_pointee_array_size = src.pointee_array_size
    stmt.var_pointee_array_elem_type = src.pointee_array_elem_type
    1

# AGAST #2539: the `**[N]T` local that `*e` reads a `*[N]T` out of, or null.
fn array_ptr_ptr_deref_base(s: *EmitterState, e: *Expr) -> *LocalVar
    if e == null or e.kind != EXPR_UNARY or e.op != OP_DEREF or e.operand == null or e.operand.kind != EXPR_IDENT
        return null
    let loc: *LocalVar = find_local_struct_name(s, e.operand.ident_ptr, e.operand.ident_len)
    if loc == null or loc.var_type != TYPE_PTR_PTR or loc.inner_pointee_type != TYPE_ARRAY or loc.pointee_array_size <= 0
        return null
    loc

# AGAST #2555: the shape of the N-D local, global or field that `e`, an index
# chain one short of its rank, takes a row of, or null.  `let q = @x[i]` with
# `x: [M][N]T` (or `@x[i][j]` of `[L][M][N]T`) holds an `@[N]T`, as the
# annotated `let q: @[N]T = @x[i]` does.  It recorded no N or T: `q + 1` strode
# a byte and `r[1]` loaded an i8, SILENT, and `q[1]` was "unlowerable".
fn nd_row_shape(s: *EmitterState, e: *Expr) -> *ArrayShape
    var depth: i32 = 0
    let sh: *ArrayShape = nd_index_shape(s, e, @depth)
    if sh == null or depth != sh.rank - 1
        return null
    sh

# AGAST #2558: refuse, located at the binding, an inferred `let q = @x[i]` whose
# index chain is two or more short of the N-D array's rank: a plane, an
# `@[M][N]T`.  ritz1 can't hold an N-D pointee (nd_array_reject, #1509), so q
# stayed an untyped i64: `q + 1` strode one byte (SILENT for `@`; an `@&` gave
# IR clang rejected, unlocated).  Returns 1 when it refused.
fn nd_plane_reject(s: *EmitterState, stmt: *Stmt, e: *Expr) -> i32
    var depth: i32 = 0
    let sh: *ArrayShape = nd_index_shape(s, e, @depth)
    if sh == null or depth > sh.rank - 2
        return 0
    emit_nd_error(s, stmt.span.line, stmt.span.col, c"a multi-dimensional array type is not supported as the pointee of an inferred binding in ritz1 (this `@` leaves two or more dimensions: index down to a row or an element, or annotate an element pointer, `let q: *T = @x[i][j][k]`)")
    1

fn infer_array_ptr_let(s: *EmitterState, stmt: *Stmt) -> i32
    if stmt.var_declared_type == TYPE_VOID and stmt.var_init != null
        # AGAST #2329: `let q = h(p)`, `let q = h.r` and `let q = g` hold what they
        # copy.  `-> @[N]S` named S, which made `q` a `*S`.
        let pa: *Param = base_ptr_array(s, stmt.var_init)
        if pa != null
            stmt.var_type = pa.param_type
            stmt.var_type_name = null
            stmt.var_type_name_len = 0
            stmt.var_pointee_type = TYPE_ARRAY
            stmt.var_pointee_array_size = pa.param_pointee_array_size
            stmt.var_pointee_array_elem_type = pa.param_pointee_array_elem_type
            return 1
    if stmt.var_type != TYPE_I64 or stmt.var_type_name_len != 0 or stmt.var_init == null
        return 0
    let init: *Expr = stmt.var_init
    var kind: i32 = TYPE_UNKNOWN
    var size: i32 = 0
    var elem: i32 = TYPE_VOID
    var src: *LocalVar = array_ptr_index_base(s, init)
    # AGAST #2330: `let q = p + k` walks rows, and is the same kind of pointer.
    if src == null and init.kind == EXPR_BINARY and (init.op == OP_ADD or init.op == OP_SUB)
        src = array_ptr_index_base(s, init.left)
    let pp: *LocalVar = array_ptr_ptr_deref_base(s, init)   # #2539: `let p = *r`
    if src != null
        kind = src.var_type
        size = src.pointee_array_size
        elem = src.pointee_array_elem_type
    else if pp != null
        kind = TYPE_PTR
        size = pp.pointee_array_size
        elem = pp.pointee_array_elem_type
    else if init.kind == EXPR_UNARY and (init.op == OP_ADDR or init.op == OP_ADDR_MUT) and init.operand != null
        let oper: *Expr = init.operand
        kind = TYPE_REF
        if init.op == OP_ADDR_MUT
            kind = TYPE_MUT_REF
        let row: *ArrayShape = nd_row_shape(s, oper)   # #2555: `@x[i]`
        if row != null
            size = row.dims[row.rank - 1]
            elem = row.leaf_type
            stmt.var_pointee_array_elem_pointee = row.leaf_pointee
        else if nd_plane_reject(s, stmt, oper) == 1   # #2558: a plane `@x[i]`
            return 0
        else if oper.kind == EXPR_MEMBER
            let fld: *StructField = resolve_member_chain_field(s, oper)
            if fld != null and fld.field_type == TYPE_ARRAY
                size = fld.array_size
                elem = fld.array_elem_type
        else if oper.kind == EXPR_IDENT
            let arr: *LocalVar = find_local_struct_name(s, oper.ident_ptr, oper.ident_len)
            if arr != null
                if arr.var_type == TYPE_ARRAY
                    size = arr.array_size
                    elem = arr.array_elem_type
            else
                let garr: *GlobalVarDef = global_array_named(s, oper)
                if garr != null
                    size = garr.array_size
                    elem = garr.array_elem_type
    if size <= 0
        return 0
    stmt.var_type = kind
    stmt.var_pointee_type = TYPE_ARRAY
    stmt.var_pointee_array_size = size
    stmt.var_pointee_array_elem_type = elem
    return 1

# AGAST #2571: the scalar element type of the local, global or field array that
# `e`, an index chain of exactly its rank, names an element of; TYPE_VOID for
# anything else (a row, a plane, a pointer or Vec index, a struct or pointer
# element: other arms type those).
fn full_scalar_elem_type(s: *EmitterState, e: *Expr) -> i32
    if e == null or e.kind != EXPR_INDEX or e.left == null
        return TYPE_VOID
    var leaf: i32 = TYPE_VOID
    var depth: i32 = 0
    let sh: *ArrayShape = nd_index_shape(s, e, @depth)
    if sh != null
        if depth == sh.rank
            leaf = sh.leaf_type
    else if e.left.kind == EXPR_IDENT
        let arr: *LocalVar = find_local_struct_name(s, e.left.ident_ptr, e.left.ident_len)
        if arr != null
            if arr.var_type == TYPE_ARRAY and arr.array_shape == null
                leaf = arr.array_elem_type
        else
            let garr: *GlobalVarDef = global_array_named(s, e.left)
            if garr != null and garr.array_shape == null
                leaf = garr.array_elem_type
    else if e.left.kind == EXPR_MEMBER
        let fld: *StructField = resolve_member_chain_field(s, e.left)
        if fld != null and fld.field_type == TYPE_ARRAY and fld.array_shape == null
            leaf = fld.array_elem_type
    if leaf < TYPE_I32 or leaf > TYPE_F64 or leaf == TYPE_PTR or leaf == TYPE_PTR_PTR
        return TYPE_VOID
    leaf

# AGAST #2571: `let q = @x[i]` and `let q = @&x[i]..`, a full element of an
# array, hold what `let q: *T = @x[i]` does, as ritz0 types them.  The slot
# stayed i64: `@&` stored its ptr there and clang rejected the IR, unlocated;
# `@` went through ptrtoint, then `*q` loaded and stored 8 bytes and `q + 1`
# strode one.  A scalar T is the pointee; an N-D struct or enum element
# (`x: [M][N]S`) is a `*S`, as the #175 arm in emit_var_decl types a 1-D one
# (that arm walks one index only).  Returns 1 when it typed the local.
fn infer_full_elem_ref_let(s: *EmitterState, stmt: *Stmt) -> i32
    let init: *Expr = stmt.var_init
    if stmt.var_type != TYPE_I64 or stmt.var_type_name_len != 0 or init == null
        return 0
    if init.kind != EXPR_UNARY or (init.op != OP_ADDR and init.op != OP_ADDR_MUT)
        return 0
    var depth: i32 = 0
    let sh: *ArrayShape = nd_index_shape(s, init.operand, @depth)
    if sh != null and depth == sh.rank and sh.leaf_type == TYPE_STRUCT and sh.leaf_name_len > 0
        stmt.var_type = TYPE_PTR
        stmt.var_type_name = sh.leaf_name
        stmt.var_type_name_len = sh.leaf_name_len
        return 1
    let leaf: i32 = full_scalar_elem_type(s, init.operand)
    if leaf == TYPE_VOID
        return 0
    stmt.var_type = TYPE_PTR
    stmt.var_pointee_type = leaf
    1

# AGAST #2400: `let a = @p.f` and `let a = @&p.f`, f a scalar field, hold what
# `let a: @T = @p.f` does: a `*T`, T the field's type, as #2571 types `@x[i]`.
# The slot stayed i64 with no pointee: `@&` stored its ptr there and clang
# rejected the IR; `@` went through ptrtoint, then `*a` loaded and stored 8
# bytes of an i32 and `a + 1` strode one.  Struct fields are the #175 arm's;
# pointer, array and enum fields aren't scalars here.  Returns 1 when it typed
# the local.
fn infer_field_ref_let(s: *EmitterState, stmt: *Stmt) -> i32
    let init: *Expr = stmt.var_init
    if stmt.var_type != TYPE_I64 or stmt.var_type_name_len != 0 or init == null
        return 0
    if init.kind != EXPR_UNARY or (init.op != OP_ADDR and init.op != OP_ADDR_MUT)
        return 0
    if init.operand == null or init.operand.kind != EXPR_MEMBER
        return 0
    let f: *StructField = resolve_member_chain_field(s, init.operand)
    if f == null or f.field_type_name_len != 0
        return 0
    let t: i32 = f.field_type
    if t < TYPE_I32 or t > TYPE_F64 or t == TYPE_PTR or t == TYPE_PTR_PTR
        return 0
    stmt.var_type = TYPE_PTR
    stmt.var_pointee_type = t
    1

# AGAST #2330: the struct an un-annotated `let p = @a`, `let q = p` or `let q = p + k`
# holds an array of, for add_array_view: infer_array_ptr_let records N and T but
# no name, since a name would register `p` as a `*S`.  null for scalars.
fn inferred_array_elem_name(s: *EmitterState, stmt: *Stmt, out_len: *i32) -> *u8
    *out_len = stmt.var_type_name_len
    if stmt.var_type_name_len > 0 or stmt.var_init == null
        return stmt.var_type_name
    let init: *Expr = stmt.var_init
    var src: *LocalVar = array_ptr_index_base(s, init)
    if src == null and init.kind == EXPR_BINARY and (init.op == OP_ADD or init.op == OP_SUB)
        src = array_ptr_index_base(s, init.left)
    if src != null
        return array_ptr_elem_name(src, out_len)
    let pp: *LocalVar = array_ptr_ptr_deref_base(s, init)   # #2543: `let p = *r`
    if pp != null
        return array_ptr_elem_name(pp, out_len)
    let pa: *Param = base_ptr_array(s, init)   # #2329
    if pa != null
        *out_len = pa.param_type_name_len
        return pa.param_type_name
    if init.kind != EXPR_UNARY or (init.op != OP_ADDR and init.op != OP_ADDR_MUT) or init.operand == null
        return null
    let oper: *Expr = init.operand
    let row: *ArrayShape = nd_row_shape(s, oper)   # #2555: `@x[i]`
    if row != null
        *out_len = row.leaf_name_len
        return row.leaf_name
    if oper.kind == EXPR_MEMBER
        let fld: *StructField = resolve_member_chain_field(s, oper)
        if fld != null and fld.field_type == TYPE_ARRAY
            *out_len = fld.array_elem_type_name_len
            return fld.array_elem_type_name
    else if oper.kind == EXPR_IDENT
        let arr: *LocalVar = find_local_struct_name(s, oper.ident_ptr, oper.ident_len)
        if arr != null
            if arr.var_type == TYPE_ARRAY
                *out_len = arr.type_name_len
                return arr.type_name
            # #2543: `let r = @q` with `q: *[N]S`, for name_array_ptr_local.
            if array_ptr_index_base(s, oper) != null
                return array_ptr_elem_name(arr, out_len)
        else
            let garr: *GlobalVarDef = global_array_named(s, oper)
            if garr != null
                *out_len = garr.array_elem_type_name_len
                return garr.array_elem_type_name
    return null

# AGAST #2543: a `*[N]S`, `@[N]S`, `@&[N]S` or `**[N]S` local records S in
# pointee_array_elem_name, as such a param does (#2548).  It recorded none, so
# `let p = q` and `let p = *r`, which take S from what they copy, had none for
# `p#`, and `p[i].f` was refused "unhandled EXPR_MEMBER".
fn name_array_ptr_local(loc: *LocalVar, stmt: *Stmt, name: *u8, len: i32)
    if loc.type_name_len > 0 or name == null or len <= 0
        return
    if stmt.var_pointee_array_size <= 0 or stmt.var_pointee_array_elem_type != TYPE_STRUCT
        return
    let t: i32 = loc.var_type
    let one: bool = (t == TYPE_PTR or t == TYPE_REF or t == TYPE_MUT_REF) and stmt.var_pointee_type == TYPE_ARRAY
    let two: bool = t == TYPE_PTR_PTR and stmt.var_inner_pointee_type == TYPE_ARRAY
    if one or two
        loc.pointee_array_elem_name = name
        loc.pointee_array_elem_name_len = len

# AGAST #2564: `let e = v[i]` and `let e = x.vf[i]`, on a Vec, Span or String whose
# element is a struct S held by value, is a copy of that S, as `let e: S = v[i]`.
# The slot stayed i64 with no name, so `e.f` was "unhandled EXPR_MEMBER".
# AGAST #2524: so is `p[i]` through a `*[N]S`, `@[N]S` or `@&[N]S` (the place
# `*(p# + i)`), as `let s: S = p[i]` already was (#2330).  Returns 1 when it
# typed the local.
fn infer_through_elem_let(s: *EmitterState, stmt: *Stmt) -> i32
    if stmt.var_type != TYPE_I64 or stmt.var_type_name_len != 0 or stmt.var_init == null
        return 0
    # `let n: i64 = p[i]` is i64 too; it stays a refused integer (#2330).
    if stmt.var_declared_type != TYPE_VOID
        return 0
    if index_through(s, stmt.var_init) == null
        return 0
    var name: *u8 = null
    var len: i32 = 0
    if index_through_value_struct(s, stmt.var_init, @name, @len) == 0
        return 0
    stmt.var_type = TYPE_STRUCT
    stmt.var_type_name = name
    stmt.var_type_name_len = len
    1

# AGAST #2592: `let r = ps[i]` with `ps: [N]S` (a local, global or field) is a
# copy of that S, as `let r: S = ps[i]`.  The slot stayed i64 with no name, so
# `r.x` was "unhandled EXPR_MEMBER", unlocated.  Returns 1 when it typed the
# local.
# AGAST #2993: `let n: i64 = ps[i]` is i64 too, so it was retyped as a %S local
# and compiled; ritz0 refuses it.  The %S load into the i64 slot then failed at
# clang, unlocated, so it is refused here, located, as #2330's through form is.
fn infer_struct_elem_let(s: *EmitterState, stmt: *Stmt) -> i32
    if stmt.var_type != TYPE_I64 or stmt.var_type_name_len != 0 or stmt.var_init == null
        return 0
    var name: *u8 = null
    var len: i32 = 0
    index_struct_value_name(s, stmt.var_init, @name, @len)
    if len == 0
        return 0
    if stmt.var_declared_type != TYPE_VOID
        emit_nd_error(s, stmt.var_init.span.line, stmt.var_init.span.col, c"a whole struct element is not a value here in ritz1 (copy it into a `let s: S`, or read its fields)")
        return 0
    stmt.var_type = TYPE_STRUCT
    stmt.var_type_name = name
    stmt.var_type_name_len = len
    1

# AGAST #2377: `let c = a[i][j]` with `a: [N]*S` is a copy of that S, as
# `let c: S = a[i][j]` and `let c = *a[i]` (#2542) are.  The slot stayed i64
# with no name, so `c.q` was "unhandled EXPR_MEMBER".  emit_expr loads the
# `%S` deref_pointee_struct_name names for `a[i]`.  `p[i]` with `p: *S` is
# left alone: emit_expr loads it as an i64 (AGAST #3052).
fn infer_ptr_index_let(s: *EmitterState, stmt: *Stmt) -> i32
    if stmt.var_type != TYPE_I64 or stmt.var_type_name_len != 0 or stmt.var_declared_type != TYPE_VOID
        return 0
    let e: *Expr = stmt.var_init
    if e == null or e.kind != EXPR_INDEX or e.left == null or e.right == null or e.right.kind == EXPR_RANGE
        return 0
    if e.left.kind != EXPR_INDEX
        return 0
    var name: *u8 = null
    var len: i32 = 0
    deref_pointee_struct_name(s, e.left, @name, @len)
    if name == null or len <= 0
        return 0
    stmt.var_type = TYPE_STRUCT
    stmt.var_type_name = name
    stmt.var_type_name_len = len
    1

# AGAST #2332: `let q = a[i]` and `let q = a[i] + k` with `a: [N]*T` hold what
# `let q: *T` does.  Returns 1 when it typed the local.
fn infer_array_elem_let(s: *EmitterState, stmt: *Stmt) -> i32
    if stmt.var_declared_type != TYPE_VOID or stmt.var_init == null
        return 0
    var name: *u8 = null
    var name_len: i32 = 0
    let pointee: i32 = array_elem_pointee(s, stmt.var_init, @name, @name_len)
    if pointee == TYPE_VOID
        return infer_elem_ptr_ptr_let(s, stmt)
    stmt.var_type = TYPE_PTR
    stmt.var_pointee_type = pointee
    stmt.var_type_name = name
    stmt.var_type_name_len = name_len
    return 1

# AGAST #2376: `let r = b[i]` and `let r = *b[i]` with `b: [N]**T`, and
# `let r = @a[i]` with `a: [N]*T`, hold what `let r: **T` / `let r: *T` do.
# They were i64s, so `**r` and `*r` loaded and stored 8 bytes.
fn infer_elem_ptr_ptr_let(s: *EmitterState, stmt: *Stmt) -> i32
    var base: *Expr = stmt.var_init
    while base != null and base.kind == EXPR_UNARY and base.op == OP_DEREF
        base = base.operand
    if elem_rooted(base) == 0
        return 0
    var inner: i32 = TYPE_VOID
    var name: *u8 = null
    var name_len: i32 = 0
    let levels: i32 = ptr_levels_of(s, stmt.var_init, @inner, @name, @name_len)
    if levels == 0 or inner == TYPE_VOID
        return 0
    stmt.var_type_name = name
    stmt.var_type_name_len = name_len
    if levels == 1
        stmt.var_type = TYPE_PTR
        stmt.var_pointee_type = inner
        return 1
    stmt.var_type = TYPE_PTR_PTR
    stmt.var_pointee_type = TYPE_PTR
    stmt.var_inner_pointee_type = inner + (levels - 2) * PTR_DEPTH_UNIT
    return 1

# AGAST #2791: `let p = f()` with `f() -> **U` (`vec_as_ptr<*U>`, or written)
# holds what `let p: **U` does, U a scalar or a struct, so `*(p + i)` strides
# by 8 and `**p` loads a U.  It stayed an i64: `p + i` was a raw byte add and
# `*(p + i)` silently loaded the wrong pointer.  Monomorph spells a pointer U
# `ptr_C` (`vec_as_ptr<**u8>` names "ptr_u8"): each `ptr_` is one more level,
# packed as `let p: ***u8` packs it.  An unknown U is a `*U`, as the `*T`
# record was before, so arithmetic on it is refused, not a byte add.
# Returns the local's var_type.
fn infer_ptr_ptr_call_let(s: *EmitterState, stmt: *Stmt, fd: *FnDef) -> i32
    var name: *u8 = fd.return_type_name
    var len: i32 = fd.return_type_name_len
    if name == null or len <= 0
        return TYPE_I64
    var extra: i32 = 0
    while len > 4 and memcmp(name, c"ptr_", 4) == 0
        name = name + 4
        len = len - 4
        extra = extra + 1
    var inner: i32 = primitive_type_from_name(name, len)
    if inner == 0   # primitive_type_from_name's miss value
        if find_struct(s, name, len) == null
            stmt.var_type = TYPE_PTR
            stmt.var_type_name = fd.return_type_name
            stmt.var_type_name_len = fd.return_type_name_len
            return TYPE_PTR
        inner = TYPE_STRUCT
        stmt.var_type_name = name
        stmt.var_type_name_len = len
    stmt.var_type = TYPE_PTR_PTR
    stmt.var_pointee_type = TYPE_PTR
    stmt.var_inner_pointee_type = inner + extra * PTR_DEPTH_UNIT
    TYPE_PTR_PTR

# AGAST #2335, #2338: 1 when an un-annotated `let` or `var` holds an `@T`:
# `let p = @x`, or a copy of one from a local, a field or a call.  Ask before the
# inference in emit_var_decl rewrites var_type, or `let p: *C = @c` looks like it.
fn let_holds_shared_ref(s: *EmitterState, stmt: *Stmt) -> i32
    if stmt.var_type != TYPE_I64 or stmt.var_type_name_len != 0 or stmt.var_init == null
        return 0
    (ref_view(s, stmt.var_init) == REF_VIEW_SHARED) as i32

# AGAST #2356: 1 for an unannotated `let x = init` whose init is a u64, which the
# parser's i64 default would make `x >> n` sign-fill.  A bare literal stays i64,
# as it does on ritz0, and a float expression is not an integer at all.
fn inferred_u64_init(s: *EmitterState, stmt: *Stmt) -> i32
    if stmt.var_declared_type != TYPE_VOID or stmt.var_init == null
        return 0
    if stmt.var_init.kind == EXPR_INT_LIT
        return 0
    let t: i32 = get_expr_type(s, stmt.var_init)
    if t == TYPE_F32 or t == TYPE_F64
        return 0
    var uns: i32 = 0
    if int_operand_shape(s, stmt.var_init, @uns) == 64
        return uns
    0

# 1 when `name` is an enum `ctor` builds: an Option for Some / None, a Result
# for Ok / Err.
fn ctor_family_is(ctor: *Expr, name: *u8, len: i32) -> i32
    if name == null or len < 7
        return 0
    if ctor.kind == EXPR_IDENT or name_eq(ctor.func_name, ctor.func_name_len, c"Some", 4) == 1 or name_eq(ctor.func_name, ctor.func_name_len, c"None", 4) == 1
        return name_eq(name, 7, c"Option$", 7)
    name_eq(name, 7, c"Result$", 7)

# AGAST #2430: an unannotated `let o = Some(5)` (or None, Ok, Err) is the enum
# it builds.  The local stayed an i64, the constructor had no enum to build and
# lowered to a zero, and `match o` read that.  The enum is the fn's return type
# when that is one of the constructor's family, as on ritz0 (`let o = None`
# then `o` in a `-> Option<i32>` fn); otherwise the one its payload names, as a
# scrutinee's (#2419).  1 when it typed the local; a payload nothing names is a
# located error, never the zero.
fn infer_ctor_let(s: *EmitterState, stmt: *Stmt) -> i32
    let init: *Expr = stmt.var_init
    if stmt.var_declared_type != TYPE_VOID or init == null
        return 0
    if is_tagged_ctor(s, init) == 0
        return 0
    if init.kind == EXPR_CALL
        var uc_name: *u8 = null
        var uc_len: i32 = 0
        user_variant_ctor_enum(init, @uc_name, @uc_len)
        if uc_name != null
            return 0   # a user enum's own variant (#1797)
    var name: *u8 = null
    var len: i32 = 0
    if ctor_family_is(init, s.ret_type_name, s.ret_type_name_len) == 1
        name = s.ret_type_name
        len = s.ret_type_name_len
    else
        ctor_scrutinee_enum(s, init, @name, @len)
    if name == null
        emit_ctor_type_error(s, init)
        return 0
    stmt.var_type = TYPE_STRUCT
    stmt.var_type_name = name
    stmt.var_type_name_len = len
    1

# 1 when `e` is a Some/None/Ok/Err the builtin Option / Result builds: not a
# user enum's own `Ok` / `Some` (#1797, #2453).
fn builtin_tagged_ctor(s: *EmitterState, e: *Expr) -> i32
    if is_tagged_ctor(s, e) == 0
        return 0
    if e.kind == EXPR_CALL
        var uc_name: *u8 = null
        var uc_len: i32 = 0
        user_variant_ctor_enum(e, @uc_name, @uc_len)
        if uc_name != null
            return 0
    1

# The arms an if / match expression `e` ends in, through nested ones (`else
# if`, a match arm that is one): the first constructor (*any), the first
# Some / Ok (*val) and the first Err (*err).  *mixed is the first that builds
# the other family from *any's, an Option among Results or the reverse.
fn arm_ctors(s: *EmitterState, e: *Expr, any: **Expr, val: **Expr, err: **Expr, mixed: **Expr)
    if e == null
        return
    if e.kind == EXPR_IF or e.kind == EXPR_MATCH
        var arm: *MatchArm = e.args as *MatchArm
        while arm != null
            if arm.is_pass == 0
                arm_ctors(s, arm.body, any, val, err, mixed)
            arm = arm.next
        return
    if builtin_tagged_ctor(s, e) == 0
        return
    if *any == null
        *any = e
    else if *mixed == null and ctor_family_is(e, c"Option$", 7) != ctor_family_is(*any, c"Option$", 7)
        *mixed = e
    if e.kind != EXPR_CALL
        return   # None
    if name_eq(e.func_name, e.func_name_len, c"Err", 3) == 1
        if *err == null
            *err = e
    else if *val == null
        *val = e

# A constructor's payload, spelled for its enum's name; i64 when there is
# none (None, or no arm of that variant).  0 when ritz1 can't name it.
fn arm_payload_spelling(s: *EmitterState, ctor: *Expr, out: **u8) -> i32
    if ctor == null or ctor.args == null
        *out = c"i64"
        return 3
    ctor_payload_spelling(s, ctor.args, out)

# AGAST #2454: an unannotated `let o = if c then Some(5) else None`, or a
# match expression whose arms build one, is the enum the arms build.  The
# arms had no enum, lowered to `add i64 0, 0`, and `match o` read that zero.
# As infer_ctor_let (#2430): the fn's return type when it is the arms'
# family, else the one their payloads name: an Option's T from its first
# Some, a Result's T from its first Ok and E from its first Err, i64 where no
# arm gives one.  Writes the name and returns 1 when it named one; 0 when no arm ends in a constructor.  Arms building both
# an Option and a Result, or a payload ritz1 can't name, are a located error:
# -1, and the caller emits nothing more for them.
fn infer_ctor_arms(s: *EmitterState, stmt: *Stmt, out_name: **u8, out_len: *i32) -> i32
    *out_name = null
    *out_len = 0
    let init: *Expr = stmt.var_init
    if stmt.var_declared_type != TYPE_VOID or init == null
        return 0
    if init.kind != EXPR_IF and init.kind != EXPR_MATCH
        return 0
    var any: *Expr = null
    var val: *Expr = null
    var err: *Expr = null
    var mixed: *Expr = null
    arm_ctors(s, init, @any, @val, @err, @mixed)
    if any == null
        return 0
    if mixed != null
        emit_ctor_type_error(s, mixed)
        return -1
    if ctor_family_is(any, s.ret_type_name, s.ret_type_name_len) == 1
        *out_name = s.ret_type_name
        *out_len = s.ret_type_name_len
        return 1
    var t: *u8 = null
    let t_len: i32 = arm_payload_spelling(s, val, @t)
    if t_len <= 0
        emit_ctor_type_error(s, val)
        return -1
    var len: i32 = 0
    var name: *u8 = null
    if ctor_family_is(any, c"Option$", 7) == 1
        name = ctor_join(c"Option$", 7, t, t_len, c"", 0, @len)
    else
        var e: *u8 = null
        let e_len: i32 = arm_payload_spelling(s, err, @e)
        if e_len <= 0
            emit_ctor_type_error(s, err)
            return -1
        let head: *u8 = ctor_join(c"Result$", 7, t, t_len, c"$", 1, @len)
        name = ctor_join(head, len, e, e_len, c"", 0, @len)
    if namelist_find(@s.late_enums, name, len) < 0
        namelist_push(@s.late_enums, name, len)
    *out_name = name
    *out_len = len
    1

# An i64 zero: a value for an init that was refused, so the let still binds.
fn emit_zero_i64(s: *EmitterState) -> i32
    let z: i32 = next_reg(s)
    emit_str(s, c"  ")
    emit_reg(s, z)
    emit_str(s, c" = add i64 0, 0\n")
    z

# AGAST #2454: `Some(5)` as a statement.  Its value is dropped, but with no
# enum it was still the `add i64 0, 0` fallback.  It builds the enum around
# it when that is its family (a tail in a `-> Option<T>` fn), else the one its
# payload names.  Emits it; returns the register.
fn emit_ctor_stmt(s: *EmitterState, e: *Expr) -> i32
    var name: *u8 = null
    var len: i32 = 0
    resolve_enum_ctx(s, @name, @len)
    if name != null and ctor_family_is(e, name, len) == 1
        return emit_expr(s, e)
    ctor_scrutinee_enum(s, e, @name, @len)
    if name == null
        return emit_expr(s, e)   # the located error
    emit_ctor_scrutinee(s, e, name, len)

# AGAST #2594: the struct payload `init` = `r.unwrap()` gives, `r` an
# Option<S> or Result<S, E> (try_emit_enum_unwrap loads it as a `%S`), or
# null/0.  `unwrap_or` is #2863.
fn unwrap_payload_struct_name(s: *EmitterState, init: *Expr, out_name: **u8, out_len: *i32)
    if init.kind != EXPR_METHOD or init.left == null or init.args != null
        return
    if name_eq(init.ident_ptr, init.ident_len, c"unwrap", 6) == 0
        return
    var enum_name: *u8 = null
    var enum_len: i32 = 0
    call_result_struct_name(s, init.left, @enum_name, @enum_len)
    if enum_len == 0
        resolve_expr_struct_name(s, init.left, @enum_name, @enum_len)
    if enum_len == 0
        return
    if starts_with(enum_name, enum_len, c"Option$", 7) == 0 and starts_with(enum_name, enum_len, c"Result$", 7) == 0
        return
    var pay_len: i32 = 0
    let pay: *u8 = tagged_enum_payload_named(s, enum_name, enum_len, @pay_len, 0)
    if pay != null and pay_len > 0
        *out_name = pay
        *out_len = pay_len

# AGAST #2784: the struct returned by the method call `init` on a call's
# result (`mk<T>(u, v).flip()`), or null/0: the callee's return names the
# receiver, the method's return the result.  A method receiver (`c.me().tp()`)
# is named by call_result_struct_name (#2594).
fn tuple_decl_method_struct_name(s: *EmitterState, init: *Expr, out_name: **u8, out_len: *i32)
    var recv: *u8 = null
    var recv_len: i32 = 0
    call_result_struct_name(s, init.left, @recv, @recv_len)
    if recv_len <= 0
        return
    let fd: *FnDef = method_callee_def(s, recv, recv_len, init.ident_ptr, init.ident_len)
    if fd == null or fd.return_type != TYPE_STRUCT or fd.return_type_name_len <= 0
        return
    *out_name = fd.return_type_name
    *out_len = fd.return_type_name_len

# AGAST #2574: the struct `let (a, b) = init` destructures, or null/0.  A call
# or method call (`mk(3)`, `c.tp(3)`, a static `C.sm(5)`) names it by its
# callee's return type; anything else (a struct local, a struct literal) by
# resolve_expr_struct_name.  Only a free fn's return was looked at before,
# so a method call bound nothing.
fn tuple_decl_struct_name(s: *EmitterState, init: *Expr, out_name: **u8, out_len: *i32)
    call_result_struct_name(s, init, out_name, out_len)
    if *out_len == 0
        resolve_expr_struct_name(s, init, out_name, out_len)
    # AGAST #2784: a method on a call's result (`mk<T>(u, v).flip()`).
    # call_result_struct_name only reads an identifier receiver.
    if *out_len == 0 and init.kind == EXPR_METHOD and init.left != null and init.left.kind == EXPR_CALL
        tuple_decl_method_struct_name(s, init, out_name, out_len)
    if *out_len == 0
        unwrap_payload_struct_name(s, init, out_name, out_len)
    # A struct field (`h.p`, `hs[0].p`, `mk().p`) names its own type.
    if *out_len == 0 and init.kind == EXPR_MEMBER
        let fld: *StructField = resolve_member_chain_field(s, init)
        if fld != null and fld.field_type == TYPE_STRUCT and fld.field_type_name_len > 0
            *out_name = fld.field_type_name
            *out_len = fld.field_type_name_len
    # AGAST #2592: an element of a `[N]S` local, global or field (`ps[1]`,
    # `h.ps[1]`, `gp[0]`), which emit_expr_index loads as a `%S`.
    if *out_len == 0 and init.kind == EXPR_INDEX
        index_struct_value_name(s, init, out_name, out_len)
    # `*q`, q a `*S` (as `(*q).f` resolves it).
    if *out_len == 0 and init.kind == EXPR_UNARY and init.op == OP_DEREF
        deref_member_base_struct_name(s, init.operand, out_name, out_len)
    # A struct global, when no local has the name.
    if *out_len == 0 and init.kind == EXPR_IDENT and find_local_struct_name(s, init.ident_ptr, init.ident_len) == null
        let g: *GlobalVarDef = find_global(s, init.ident_ptr, init.ident_len)
        if g != null and g.var_type == TYPE_STRUCT and g.type_name_len > 0
            *out_name = g.type_name
            *out_len = g.type_name_len

# AGAST #2574: 1 if a destructured field of this kind can be bound as a local:
# a scalar, bool, float, struct, plain pointer or (#2594) array.  `@` / `@&`
# fields and fn-typed fields are refused rather than guessed at (#2864).
fn tuple_field_bindable(fld: *StructField) -> i32
    if fld.field_mut_ref == 1 or fld.field_shared_ref == 1 or fld.fn_sig != null
        return 0
    let ft: i32 = fld.field_type
    if ft == TYPE_ARRAY and fld.array_size > 0
        return 1
    if ft == TYPE_I8 or ft == TYPE_U8 or ft == TYPE_I16 or ft == TYPE_U16
        return 1
    if ft == TYPE_I32 or ft == TYPE_U32 or ft == TYPE_I64 or ft == TYPE_U64
        return 1
    if ft == TYPE_F32 or ft == TYPE_F64 or ft == TYPE_BOOL
        return 1
    if ft == TYPE_STRUCT and fld.field_type_name_len > 0
        return 1
    if ft == TYPE_PTR or ft == TYPE_PTR_PTR
        return 1
    0

# AGAST #2594: bind the array field value `val` (`x: [N]T`) to `name`: a
# copy of the field in its own `[N x T]` slot, registered as the array local
# an annotated `var a: [N]T` is, so `a[i]` reads at T's width.
fn tuple_bind_array_field(s: *EmitterState, fld: *StructField, val: i32, name: *u8, name_len: i32)
    let slot: i32 = next_reg(s)
    emit_str(s, c"  ")
    emit_reg(s, slot)
    emit_str(s, c" = alloca ")
    emit_field_llvm_type(s, fld)
    emit_str(s, c"\n  store ")
    emit_field_llvm_type(s, fld)
    emit_str(s, c" ")
    emit_reg(s, val)
    emit_str(s, c", ptr ")
    emit_reg(s, slot)
    emit_str(s, c"\n")
    add_local_full(s, name, name_len, slot, TYPE_ARRAY, fld.array_elem_type_name, fld.array_elem_type_name_len, TYPE_I64, fld.array_size, fld.array_elem_type)
    let loc: *LocalVar = local_at(s, s.local_count - 1)
    loc.array_elem_pointee = fld.array_elem_pointee
    loc.array_shape = fld.array_shape

# AGAST #2574: bind field `idx` of the struct value `init_reg` to `name`, at
# the field's own type: the slot and local an annotated `let a: T = p.f`
# gives it.  A bool is held as i64 (the unified value model) and marked
# is_bool; a pointer as the i64 every pointer local holds, with its pointee.
# Before, every field went into an i64 slot and only i32 / u32 were widened,
# so an i16 / i8 / f32 field gave IR clang refused.
fn tuple_bind_field(s: *EmitterState, fld: *StructField, sname: *u8, slen: i32, init_reg: i32, idx: i32, name: *u8, name_len: i32)
    let ft: i32 = fld.field_type
    let val: i32 = next_reg(s)
    emit_str(s, c"  ")
    emit_reg(s, val)
    emit_str(s, c" = extractvalue %")
    emit_name(s, sname, slen)
    emit_str(s, c" ")
    emit_reg(s, init_reg)
    emit_str(s, c", ")
    emit_int(s, idx as i64)
    emit_str(s, c"\n")
    if ft == TYPE_ARRAY
        tuple_bind_array_field(s, fld, val, name, name_len)
        return
    var stored: i32 = val
    var slot_type: i32 = ft
    if ft == TYPE_BOOL
        stored = next_reg(s)
        emit_str(s, c"  ")
        emit_reg(s, stored)
        emit_str(s, c" = zext i1 ")
        emit_reg(s, val)
        emit_str(s, c" to i64\n")
        slot_type = TYPE_I64
    else if ft == TYPE_PTR or ft == TYPE_PTR_PTR
        stored = next_reg(s)
        emit_str(s, c"  ")
        emit_reg(s, stored)
        emit_str(s, c" = ptrtoint ptr ")
        emit_reg(s, val)
        emit_str(s, c" to i64\n")
    let slot: i32 = next_reg(s)
    emit_str(s, c"  ")
    emit_reg(s, slot)
    emit_str(s, c" = alloca ")
    if ft == TYPE_STRUCT
        emit_llvm_type_struct(s, TYPE_STRUCT, fld.field_type_name, fld.field_type_name_len)
    else
        emit_llvm_type(s, slot_type)
    emit_str(s, c"\n  store ")
    if ft == TYPE_STRUCT
        emit_llvm_type_struct(s, TYPE_STRUCT, fld.field_type_name, fld.field_type_name_len)
    else
        emit_llvm_type(s, slot_type)
    emit_str(s, c" ")
    emit_reg(s, stored)
    emit_str(s, c", ptr ")
    emit_reg(s, slot)
    emit_str(s, c"\n")
    if ft == TYPE_PTR or ft == TYPE_PTR_PTR
        add_local_full(s, name, name_len, slot, ft, fld.field_type_name, fld.field_type_name_len, fld.ptr_pointee, 0, 0)
        let ploc: *LocalVar = local_at(s, s.local_count - 1)
        ploc.inner_pointee_type = fld.inner_pointee_type
    else if ft == TYPE_STRUCT
        add_local_struct(s, name, name_len, slot, ft, fld.field_type_name, fld.field_type_name_len)
    else
        add_local(s, name, name_len, slot, slot_type)
        if ft == TYPE_BOOL
            let bloc: *LocalVar = local_at(s, s.local_count - 1)
            bloc.is_bool = 1

# AGAST #2574: after a refused destructure, bind both names to an i64 slot so
# each later use isn't a second, unlocated "unknown identifier" error.  The
# error count already stops any output being written.
fn tuple_decl_placeholders(s: *EmitterState, stmt: *Stmt)
    let a: i32 = next_reg(s)
    emit_str(s, c"  ")
    emit_reg(s, a)
    emit_str(s, c" = alloca i64\n")
    add_local(s, stmt.var_name, stmt.var_name_len, a, TYPE_I64)
    let b: i32 = next_reg(s)
    emit_str(s, c"  ")
    emit_reg(s, b)
    emit_str(s, c" = alloca i64\n")
    add_local(s, stmt.assign_target, stmt.assign_target_len, b, TYPE_I64)

# `let (x, y) = expr` (AGAST #2574): destructure a struct value into two
# locals, its fields 0 and 1, each at its field's type.  A struct ritz1 can't
# name, or a field it can't bind, is a located error at the `let`: before,
# nothing was bound and every use failed, unlocated, as an unknown name.
fn emit_tuple_decl(s: *EmitterState, stmt: *Stmt)
    var sname: *u8 = null
    var slen: i32 = 0
    var init_reg: i32 = 0
    let init: *Expr = stmt.var_init
    if init.kind == EXPR_MATCH or init.kind == EXPR_IF
        # AGAST #2594: a match / if block init.  Its arms' phi type is known
        # only once they are emitted, as for an untyped `let v = match`
        # (#1666): emit_match / the if publish it in last_match_agg_name.
        s.last_match_agg_name = null
        s.last_match_agg_name_len = 0
        s.last_match_float_ty = 0
        init_reg = emit_expr(s, init)
        if s.last_match_agg_name != null
            sname = s.last_match_agg_name
            slen = s.last_match_agg_name_len
    else
        tuple_decl_struct_name(s, init, @sname, @slen)
        # A copy of the struct it destructures: `let (a, b) = ps[1]` (#2996).
        init_reg = emit_struct_copy(s, init, TYPE_STRUCT)
    var st: *StructDef = null
    if slen > 0
        st = find_struct(s, sname, slen)
    if st == null
        emit_nd_error(s, stmt.span.line, stmt.span.col, c"ritz1 can't tell which struct this `let (a, b) = ...` destructures (destructure a call's result or a struct local, or bind the value with an annotated `let` first)")
        tuple_decl_placeholders(s, stmt)
        return
    let f0: *StructField = get_field_type(st, 0)
    let f1: *StructField = get_field_type(st, 1)
    if f0 == null or f1 == null
        emit_nd_error(s, stmt.span.line, stmt.span.col, c"`let (a, b) = ...` needs a struct with at least two fields to destructure")
        tuple_decl_placeholders(s, stmt)
        return
    if tuple_field_bindable(f0) == 0 or tuple_field_bindable(f1) == 0
        emit_nd_error(s, stmt.span.line, stmt.span.col, c"ritz1 can't destructure a field of this type (an array, `@` / `@&` or fn-typed field): read it as `v.f` instead")
        tuple_decl_placeholders(s, stmt)
        return
    tuple_bind_field(s, f0, sname, slen, init_reg, 0, stmt.var_name, stmt.var_name_len)
    tuple_bind_field(s, f1, sname, slen, init_reg, 1, stmt.assign_target, stmt.assign_target_len)

# AGAST #2575 / #2596: type an un-annotated let as the `*T` that
# ptr_root_pointee / ptr_arith_pointee resolved: `kind` is TYPE_STRUCT (with
# the struct's name) for a `*S`, the primitive kind for a scalar `*T`, 0 for
# neither.  Returns TYPE_PTR once the let is typed, else 0 (stmt untouched).
fn narrow_to_ptr(stmt: *Stmt, kind: i32, name: *u8, name_len: i32) -> i32
    if kind == 0
        return 0
    stmt.var_type = TYPE_PTR
    stmt.var_pointee_type = kind
    if kind == TYPE_STRUCT
        stmt.var_type_name = name
        stmt.var_type_name_len = name_len
    TYPE_PTR

# AGAST #2417: the signature of an un-annotated `let f = mb`, a bare fn
# name: mb's own.  Without it a call `f(..)` was the untyped `call i64` and
# ref_walk had no slots to judge its arguments by.  Null when a local or a
# global of that name shadows the fn (the ident is that value, as
# emit_ident resolves it), or when the fn is generic.
fn inferred_fn_sig(s: *EmitterState, stmt: *Stmt) -> *FnDef
    if stmt.var_fn_sig != null or stmt.var_declared_type != TYPE_VOID
        return stmt.var_fn_sig
    let init: *Expr = stmt.var_init
    if init == null or init.kind != EXPR_IDENT
        return null
    if find_local(s, init.ident_ptr, init.ident_len) >= 0 or find_global(s, init.ident_ptr, init.ident_len) != null
        return null
    let f: *FnDef = find_fn(s, init.ident_ptr, init.ident_len)
    if f == null or f.type_params != null
        return null
    f

fn emit_var_decl(s: *EmitterState, stmt: *Stmt)
    let shared_ref: i32 = let_holds_shared_ref(s, stmt)
    # Use the user's explicit type annotation. The parser defaults
    # missing annotations to TYPE_I64, so any TYPE_I32 we see here
    # came from an explicit `: i32` and must NOT be overridden —
    # otherwise `var best_type: i32 = -1` stores i32 into an i64 slot,
    # and callers reading i64 see garbage in the upper half.
    check_implicit_narrowing(s, stmt)   # AGAST #1364
    # AGAST #2356: as below, before `x` is in scope.
    let init_u64: i32 = inferred_u64_init(s, stmt)
    let fn_sig: *FnDef = inferred_fn_sig(s, stmt)   # AGAST #2417, before `f` is in scope
    # AGAST #2342: before `x` is in scope, as `let x: bool = x`.
    var init_kind: i32 = BK_UNSURE
    if stmt.var_init != null
        init_kind = bool_kind(s, stmt.var_init)
        if stmt.var_declared_type != TYPE_VOID
            bool_check_slot(s, stmt.var_init, stmt.var_declared_type, stmt.var_type_name, stmt.var_type_name_len)
            bool_check_array_lit(s, stmt.var_init, stmt.var_array_elem_type, stmt.var_type_name, stmt.var_type_name_len)
            literal_slot(s, stmt.var_init, stmt.var_declared_type, stmt.var_pointee_type)   # AGAST #2341
            if stmt.var_declared_type == TYPE_ARRAY
                literal_array(s, stmt.var_init, stmt.var_array_elem_type, stmt.var_array_elem_pointee)
    var var_type: i32 = stmt.var_type
    # AGAST #1521: remember a declared bool past the i64 promotion below.
    let declared_bool: i32 = (var_type == TYPE_BOOL) as i32

    # Bool slots use i64 storage in the unified value model.
    # Init expressions / loads / `if x` comparisons are all expressed in
    # i64 throughout the emitter — only function signatures and explicit
    # bool returns truncate to/zext from i1. Keeping `var x: bool` as an
    # i1 slot means the alloca is i1 but the init produces i64,
    # mismatching the `store`. Squeeze's inflate/deflate trip this with
    # `var found_uncompressed: bool = false`.  Promote the slot to i64
    # so all subsequent var operations agree.
    if var_type == TYPE_BOOL
        var_type = TYPE_I64
        stmt.var_type = TYPE_I64

    # AGAST #1666: untyped `let v = match ...`.  The merge phi's type is only
    # known once the arms are emitted (#1645: `%StrView`, `%Point`, or i64),
    # and the slot below is sized before the init is emitted.  So emit the
    # match first and take the slot type from emit_match's phi.  Without
    # this the slot stayed i64 and clang rejected `store i64 <%StrView phi>`.
    # Shadowing is unaffected: `v` is registered after its initializer.
    var pre_init_reg: i32 = 0
    var pre_emitted: i32 = 0
    if var_type == TYPE_I64 and stmt.var_type_name_len == 0 and stmt.var_init != null
        # EXPR_IF (#1613) publishes its phi type the same way.
        if stmt.var_init.kind == EXPR_MATCH or stmt.var_init.kind == EXPR_IF
            # Clear first so a stale type from an earlier match can't leak in.
            s.last_match_agg_name = null
            s.last_match_agg_name_len = 0
            s.last_match_float_ty = 0
            # AGAST #2454: arms ending in Some / None / Ok / Err build the
            # enum they name, not the no-enum zero.
            var arms_enum: *u8 = null
            var arms_enum_len: i32 = 0
            var ptr_phi_len: i32 = 0
            let ptr_phi_name: *u8 = ptr_phi_let_struct(s, stmt.var_init, @ptr_phi_len)   # AGAST #2960
            let arms: i32 = infer_ctor_arms(s, stmt, @arms_enum, @arms_enum_len)
            if arms == 1
                pre_init_reg = emit_ctor_scrutinee(s, stmt.var_init, arms_enum, arms_enum_len)
            else if arms == 0
                pre_init_reg = emit_expr(s, stmt.var_init)
            else
                pre_init_reg = emit_zero_i64(s)   # refused: its arms are not emitted
            pre_emitted = 1
            if s.last_match_agg_name != null and s.last_match_agg_name_len > 0
                var_type = TYPE_STRUCT
                stmt.var_type = TYPE_STRUCT
                stmt.var_type_name = s.last_match_agg_name
                stmt.var_type_name_len = s.last_match_agg_name_len
            else if s.last_match_float_ty != 0
                # AGAST #1946: float-valued arms, `let v = match o` with
                # `Some(x) => x` over Option<f64>: a `double` slot.
                var_type = s.last_match_float_ty
                stmt.var_type = var_type
            else if ptr_phi_name != null and arms == 0
                # AGAST #2960: a `ptr` phi of `@&C` arms is an `@&C` slot.
                var_type = TYPE_MUT_REF
                stmt.var_type = TYPE_MUT_REF
                stmt.var_type_name = ptr_phi_name
                stmt.var_type_name_len = ptr_phi_len
                stmt.var_pointee_type = TYPE_STRUCT

    if var_type == TYPE_I64 and stmt.var_type_name_len == 0 and pre_emitted == 0
        if infer_ctor_let(s, stmt) == 1
            var_type = TYPE_STRUCT

    # AGAST #2266: `var a = [t, u]` of struct T is `[2]T`, as annotated.  It
    # was an i64 slot, and its elements were stored as i64 (invalid IR).
    # AGAST #2976: so is `let a = [c; 3]`, `[3]C` (array_fill_struct_elem).
    # AGAST #3014: and a scalar element, at ritz0's type for the first one
    # (array_init_elem): `[5, 6, 7]` is `[3]i64`, `[x; 4]` with `x: u8` is
    # `[4]u8`.  A scalar kept the i64 slot, which held the address of
    # emit_expr's shadow `[N x i64]`, so `a[2]` silently read garbage.
    if var_type == TYPE_I64 and stmt.var_type_name_len == 0 and stmt.var_declared_type == TYPE_VOID and stmt.var_init != null and (stmt.var_init.kind == EXPR_ARRAY_LIT or stmt.var_init.kind == EXPR_ARRAY_FILL)
        var ael_name: *u8 = null
        var ael_len: i32 = 0
        var ael_ty: i32 = array_init_elem(s, stmt.var_init, @ael_name, @ael_len)
        # AGAST #3029: `[@x, @x]` is `[2]*T`, T recorded.
        var ael_pointee: i32 = TYPE_VOID
        if ael_ty == TYPE_VOID
            ael_pointee = array_init_ptr_pointee(s, stmt.var_init, @ael_name, @ael_len)
            if ael_pointee != TYPE_VOID
                ael_ty = TYPE_PTR
        var ael_n: i32 = 0
        if stmt.var_init.kind == EXPR_ARRAY_FILL
            ael_n = stmt.var_init.int_val as i32
        else
            var ael_it: *Expr = stmt.var_init.args
            while ael_it != null
                ael_n += 1
                ael_it = ael_it.next
        if ael_ty != TYPE_VOID and ael_n > 0
            var_type = TYPE_ARRAY
            stmt.var_type = TYPE_ARRAY
            stmt.var_array_size = ael_n
            stmt.var_array_elem_type = ael_ty
            stmt.var_array_elem_pointee = ael_pointee
            stmt.var_type_name = ael_name
            stmt.var_type_name_len = ael_len

    # Infer struct type for `var IDENT = expr` (no annotation).
    # The parser defaults missing annotations to TYPE_I64, which is
    # fine for numeric initializers but breaks when the initializer
    # returns a struct (e.g. `var v = vec_new<i32>()` → `%Vec$i32`).
    # When we see a plain TYPE_I64 with no type-name but a call-style
    # initializer whose resolved function returns a struct, narrow
    # var_type to the struct so the alloca/store widths match.
    if var_type == TYPE_I64 and stmt.var_type_name_len == 0 and stmt.var_init != null
        if stmt.var_init.kind == EXPR_CALL
            # AGAST #1797: `let b = Holds(20)` is the user enum it builds.
            var uc_name: *u8 = null
            var uc_len: i32 = 0
            user_variant_ctor_enum(stmt.var_init, @uc_name, @uc_len)
            var fn_def: *FnDef = null
            if uc_name != null
                var_type = TYPE_STRUCT
                stmt.var_type = TYPE_STRUCT
                stmt.var_type_name = uc_name
                stmt.var_type_name_len = uc_len
            else
                fn_def = find_call_fn(s, stmt.var_init)
            if fn_def != null and fn_def.return_type == TYPE_PTR_PTR
                var_type = infer_ptr_ptr_call_let(s, stmt, fn_def)
            else if fn_def != null and fn_def.return_type == TYPE_STRUCT
                if fn_def.return_type_name != null and fn_def.return_type_name_len > 0
                    var_type = TYPE_STRUCT
                    stmt.var_type = TYPE_STRUCT
                    stmt.var_type_name = fn_def.return_type_name
                    stmt.var_type_name_len = fn_def.return_type_name_len
            # AGAST #1980: `let p = vec_as_ptr<i32>(@v)` -- monomorph names a
            # specialised `-> *T`'s pointee "i32".  That is a pointee kind, not
            # a struct: register p like `let p: *i32` (element stride/load
            # width from var_pointee_type), not as a pointer to struct %i32.
            else if fn_def != null and fn_def.return_type == TYPE_PTR and primitive_type_from_name(fn_def.return_type_name, fn_def.return_type_name_len) != 0
                var_type = TYPE_PTR
                stmt.var_type = TYPE_PTR
                stmt.var_type_name = null
                stmt.var_type_name_len = 0
                stmt.var_pointee_type = primitive_type_from_name(fn_def.return_type_name, fn_def.return_type_name_len)
            else if fn_def != null and fn_def.return_type == TYPE_PTR and fn_def.return_type_name != null and fn_def.return_type_name_len > 0
                # `let cqe = uring_peek_cqe(...)` — fn returns `*IoUringCqe`.
                # Narrow the local to TYPE_PTR with the pointee struct name
                # so `cqe.user_data` resolves the struct field via the
                # ptr-to-struct member access path.  Matches the existing
                # TYPE_STRUCT branch above; extension covers async/tasks
                # `let cqe = uring_peek_cqe(...)`, which previously left the
                # local at TYPE_I64 and tripped "; ERROR: unhandled
                # EXPR_MEMBER".
                var_type = TYPE_PTR
                stmt.var_type = TYPE_PTR
                stmt.var_type_name = fn_def.return_type_name
                stmt.var_type_name_len = fn_def.return_type_name_len
            # Float-returning fn → narrow to TYPE_F32/F64 so the alloca
            # and downstream loads/stores are the right width (was
            # defaulting to i64 → `store i64 <float>` rejected by clang).
            else if fn_def != null and (fn_def.return_type == TYPE_F32 or fn_def.return_type == TYPE_F64)
                var_type = fn_def.return_type
                stmt.var_type = fn_def.return_type
            # AGAST #175: pointer-returning fn (`-> *Foo`) - narrow to TYPE_PTR
            # with the pointee struct name so `let x = peek_cqe(...)` registers
            # x as a struct-pointer binding and `x.field` resolves via
            # find_local_struct_name. Without this, var_type stays TYPE_I64,
            # the local has no type_name, and member access falls through to
            # "; ERROR: unhandled EXPR_MEMBER" with a stale `%.0`.
            else if fn_def != null and fn_def.return_type == TYPE_PTR
                if fn_def.return_type_name != null and fn_def.return_type_name_len > 0
                    var_type = TYPE_PTR
                    stmt.var_type = TYPE_PTR
                    stmt.var_type_name = fn_def.return_type_name
                    stmt.var_type_name_len = fn_def.return_type_name_len
            # AGAST #1453: reference-returning fn (`-> @L` / `-> @&L`).  A
            # reference is a pointer at the LLVM level, so register the local
            # exactly like #175's `-> *Foo` case: `let m = get(l); m.x` then
            # GEPs through the loaded pointer.  Without this the local stayed
            # TYPE_I64 — reads failed "unhandled EXPR_MEMBER" and a store
            # `m.x = v` was silently dropped (#1439).
            else if fn_def != null and (fn_def.return_type == TYPE_REF or fn_def.return_type == TYPE_MUT_REF)
                if ret_ref_scalar_pointee(fn_def) != TYPE_VOID
                    # AGAST #2308: `-> @&i8` keeps its width, as `-> *i8` does.
                    var_type = TYPE_PTR
                    stmt.var_type = TYPE_PTR
                    stmt.var_pointee_type = ret_ref_scalar_pointee(fn_def)
                else if fn_def.return_type_name != null and fn_def.return_type_name_len > 0
                    if find_struct(s, fn_def.return_type_name, fn_def.return_type_name_len) != null
                        var_type = TYPE_PTR
                        stmt.var_type = TYPE_PTR
                        stmt.var_type_name = fn_def.return_type_name
                        stmt.var_type_name_len = fn_def.return_type_name_len
        # task-101: builtin method return-type table. Method calls like
        # `s.as_bytes()` hit compiler intrinsics (try_emit_strview_as_bytes),
        # NOT a real fn_def, so the EXPR_CALL branch above can't find them
        # via find_fn. Without narrowing here, the alloca defaults to i64 →
        # `store i64 %span, ptr %slot` with %span typed %Span$u8 =>
        # LLVM type-mismatch. Hardcode known builtin return types so the
        # slot is sized/typed correctly and the local is registered as a
        # struct so later `.len()` / method dispatch can resolve the
        # receiver type.
        else if stmt.var_init.kind == EXPR_METHOD
            # AGAST #1370: `let y = x.ceil()` on an f32 is an f32 slot.
            let init_fmt: i32 = float_method_result_ty(s, stmt.var_init)
            # AGAST #1466: `let a = Opt.Holds(41)` is the enum it builds.
            var qv_name: *u8 = null
            var qv_len: i32 = 0
            qualified_variant_enum(s, stmt.var_init, @qv_name, @qv_len)
            if qv_name != null
                var_type = TYPE_STRUCT
                stmt.var_type = TYPE_STRUCT
                stmt.var_type_name = qv_name
                stmt.var_type_name_len = qv_len
            else if init_fmt != 0
                var_type = init_fmt
                stmt.var_type = init_fmt
            # StrView.as_bytes() -> %Span$u8
            else if name_eq(stmt.var_init.ident_ptr, stmt.var_init.ident_len, c"as_bytes", 8) == 1
                var_type = TYPE_STRUCT
                stmt.var_type = TYPE_STRUCT
                stmt.var_type_name = c"Span$u8"
                stmt.var_type_name_len = 7
            else
                # task-112 / AGAST #1798: a method returning a struct or a
                # float narrows the local to that type.  Resolve the callee
                # exactly as emit_expr_method dispatches it: a UFCS helper
                # (`a.slice(0, n)` and `a[:]` -> `vec_slice$i32` -> Vec$i32),
                # a user impl method (`a.clone_self()`, static `Vec2.new()`),
                # or a specialised generic impl method (`W$i32_dup`).  Only
                # the impl table was walked before #1798, so a UFCS call left
                # the local i64 and `s.push(5)` then failed "cannot determine
                # receiver type for method call".
                var recv_tn_len: i32 = 0
                let recv_tn: *u8 = method_recv_type_name(s, stmt.var_init, @recv_tn_len)
                var m: *FnDef = null
                if recv_tn != null and recv_tn_len > 0
                    m = method_callee_def(s, recv_tn, recv_tn_len, stmt.var_init.ident_ptr, stmt.var_init.ident_len)
                if m != null
                    if m.return_type == TYPE_STRUCT and m.return_type_name_len > 0
                        var_type = TYPE_STRUCT
                        stmt.var_type = TYPE_STRUCT
                        stmt.var_type_name = m.return_type_name
                        stmt.var_type_name_len = m.return_type_name_len
                    else if m.return_type == TYPE_F32 or m.return_type == TYPE_F64
                        # Float-returning method: narrow so alloca/store
                        # width match (was `alloca i64; store float`).
                        var_type = m.return_type
                        stmt.var_type = m.return_type
                    else if ret_ref_scalar_pointee(m) != TYPE_VOID
                        var_type = TYPE_PTR   # AGAST #2308, as for a call
                        stmt.var_type = TYPE_PTR
                        stmt.var_pointee_type = ret_ref_scalar_pointee(m)
        # AGAST #1681: `var parsed = p` where `p` is a struct-typed local —
        # a by-value struct param or a struct `let`.  Copy its struct type
        # so the slot is `alloca %S` (was `alloca i64` → `store i64 %<%S>`
        # rejected by clang) and the new local resolves `.field`.  Blocked
        # examples/tier2_stdlib/77_args (`run`'s `var parsed = p`).
        else if stmt.var_init.kind == EXPR_IDENT
            let src_loc: *LocalVar = find_local_struct_name(s, stmt.var_init.ident_ptr, stmt.var_init.ident_len)
            # AGAST #2279: `var d = c` with `c:& C` copies the referent, as
            # ritz0 does.  It took the reference below, so writes to `d` reached
            # the caller.  Annotate `@C` to keep the reference.  `a:& [N]T` is
            # an array local, so the array arm below copies it (#2290).
            if lent_local(s, stmt.var_init) != null and src_loc.var_type == TYPE_MUT_REF
                var_type = TYPE_STRUCT
                stmt.var_type = TYPE_STRUCT
                stmt.var_type_name = src_loc.type_name
                stmt.var_type_name_len = src_loc.type_name_len
            else if src_loc != null and src_loc.var_type == TYPE_STRUCT and src_loc.type_name_len > 0
                var_type = TYPE_STRUCT
                stmt.var_type = TYPE_STRUCT
                stmt.var_type_name = src_loc.type_name
                stmt.var_type_name_len = src_loc.type_name_len
            # AGAST #2169: `var b = a` with `a: [N]T` -- `b` is `[N]T` too, and
            # the init copies the whole array (it was an i64 slot holding
            # a's first 8 bytes).  A multi-dimensional `a` keeps its shape
            # (#1509), so the initializer check below fails it closed.
            else if src_loc != null and src_loc.var_type == TYPE_ARRAY
                var_type = TYPE_ARRAY
                stmt.var_type = TYPE_ARRAY
                stmt.var_array_size = src_loc.array_size
                stmt.var_array_elem_type = src_loc.array_elem_type
                stmt.var_array_shape = src_loc.array_shape
                stmt.var_type_name = src_loc.type_name
                stmt.var_type_name_len = src_loc.type_name_len
            # AGAST #2287: `var b = G` with `G: [N]T`, as for a local.
            else if src_loc == null and global_array_named(s, stmt.var_init) != null
                let src_g: *GlobalVarDef = global_array_named(s, stmt.var_init)
                var_type = TYPE_ARRAY
                stmt.var_type = TYPE_ARRAY
                stmt.var_array_size = src_g.array_size
                stmt.var_array_elem_type = src_g.array_elem_type
                stmt.var_array_shape = src_g.array_shape
                stmt.var_type_name = src_g.array_elem_type_name
                stmt.var_type_name_len = src_g.array_elem_type_name_len
            # AGAST #1754: `let q = s` with `s: @&S` / `@S` -- `q` takes `s`'s
            # reference type and pointee, so `q.a` resolves and the slot holds
            # the same `ptr` / i64 `s` loads as.  (Was i64 with no struct name:
            # "unhandled EXPR_MEMBER".)
            else if src_loc != null and (src_loc.var_type == TYPE_MUT_REF or src_loc.var_type == TYPE_REF) and src_loc.type_name_len > 0
                var_type = src_loc.var_type
                stmt.var_type = src_loc.var_type
                stmt.var_type_name = src_loc.type_name
                stmt.var_type_name_len = src_loc.type_name_len
                stmt.var_pointee_type = src_loc.pointee_type
                stmt.var_inner_pointee_type = src_loc.inner_pointee_type   # AGAST #2372: `s: @**S`
                # AGAST #2321: `s: @[N]S`, so `q[i]` is what `s[i]` is.
                stmt.var_pointee_array_size = src_loc.pointee_array_size
                stmt.var_pointee_array_elem_type = src_loc.pointee_array_elem_type
            # AGAST #1938: `let pp = q` with `q: **S` -- `pp` takes `q`'s
            # TYPE_PTR_PTR and struct name, so the #1933
            # registration below keeps S and `(**pp).f` resolves.  (Was i64
            # with no struct name: "unhandled EXPR_MEMBER".)
            else if src_loc != null and src_loc.var_type == TYPE_PTR_PTR and src_loc.type_name_len > 0
                var_type = TYPE_PTR_PTR
                stmt.var_type = TYPE_PTR_PTR
                stmt.var_type_name = src_loc.type_name
                stmt.var_type_name_len = src_loc.type_name_len
                # AGAST #1941: and q's inner pointee, so `*pp + 1` strides
                # sizeof(S) (ptr_levels_of reads it).
                stmt.var_inner_pointee_type = src_loc.inner_pointee_type
            # AGAST #2596: `let e = p` with `p: *S` / `*T` -- `e` is a `*S` /
            # `*T` too.  It was an i64 with no pointee: `e.b` "unhandled
            # EXPR_MEMBER", `@e.b` "cannot take address".
            else if src_loc != null and src_loc.var_type == TYPE_PTR
                var cp_name: *u8 = null
                var cp_len: i32 = 0
                let cp_kind: i32 = ptr_root_pointee(s, stmt.var_init, @cp_name, @cp_len)
                if narrow_to_ptr(stmt, cp_kind, cp_name, cp_len) != 0
                    var_type = TYPE_PTR
            # AGAST #1600: `let s = C`, a bare unit variant -- the slot is
            # `alloca %S` like the qualified `let s = S.C` below.
            else if src_loc == null
                var en_name: *u8 = null
                var en_len: i32 = 0
                unit_enum_expr_name(s, stmt.var_init, @en_name, @en_len)
                if en_len > 0
                    var_type = TYPE_STRUCT
                    stmt.var_type = TYPE_STRUCT
                    stmt.var_type_name = en_name
                    stmt.var_type_name_len = en_len
        # task-101: bare "..." literal lowers to a %Span$u8 aggregate
        # (see emit_expr EXPR_STRING_LIT). Without widening, `let s = "ABC"`
        # hits the same store-i64-of-%Span$u8 mismatch that as_bytes does.
        else if stmt.var_init.kind == EXPR_STRING_LIT
            var_type = TYPE_STRUCT
            stmt.var_type = TYPE_STRUCT
            stmt.var_type_name = c"Span$u8"
            stmt.var_type_name_len = 7
        # AGAST #2131: `let s = "..." as StrView`.  A struct-target cast
        # emits its operand's register unchanged, so the local takes the
        # operand's struct type (the `%Span$u8` of the bare-literal arm above).
        else if stmt.var_init.kind == EXPR_CAST and stmt.var_init.op == TYPE_STRUCT
            var cast_sn: *u8 = null
            var cast_sn_len: i32 = 0
            resolve_expr_struct_name(s, stmt.var_init, @cast_sn, @cast_sn_len)
            if cast_sn_len > 0
                var_type = TYPE_STRUCT
                stmt.var_type = TYPE_STRUCT
                stmt.var_type_name = cast_sn
                stmt.var_type_name_len = cast_sn_len
        # AGAST #1976: `let s = c"..."` is a `*u8`, exactly as if annotated.
        # Without this the local kept the parser default TYPE_I64 with no
        # pointee, so `*(s + 1)` loaded 8 bytes (`load i64`) and
        # `*(s + 1) == 45` compared "-b\0..." against 45.  Same shape as the
        # EXPR_CAST arm below gives `let p = raw as *u8`.
        else if stmt.var_init.kind == EXPR_CSTRING_LIT
            var_type = TYPE_PTR
            stmt.var_type = TYPE_PTR
            stmt.var_pointee_type = TYPE_U8
        # task-103: same widening for `let w = Wrap { ... }`. Without this,
        # var_type stays TYPE_I64 → alloca i64 (8 bytes) instead of %Wrap,
        # AND w isn't registered with add_local_struct, so later
        # `w.field` lookups via find_local_struct_name miss → emit_member_ptr
        # fails → "; ERROR: unhandled EXPR_MEMBER".
        else if stmt.var_init.kind == EXPR_STRUCT_LIT
            # AGAST #3005: `let t = (a, b)` names its tuple from its elements.
            tuple_lit_name(s, stmt.var_init, null, 0)
            if stmt.var_init.ident_ptr != null and stmt.var_init.ident_len > 0
                let lit_st: *StructDef = find_struct(s, stmt.var_init.ident_ptr, stmt.var_init.ident_len)
                if lit_st != null
                    var_type = TYPE_STRUCT
                    stmt.var_type = TYPE_STRUCT
                    stmt.var_type_name = stmt.var_init.ident_ptr
                    stmt.var_type_name_len = stmt.var_init.ident_len
        # Qualified enum variant: `let a = Shade.Light`.  EXPR_MEMBER on an
        # enum type produces a %Shade-typed register (alloca/store/load
        # pattern in emit_expr_member); the var-decl slot must therefore be
        # %Shade so the store width matches.  Without this narrowing, the
        # alloca defaulted to i64 → "store %Shade %.X, ptr <i64-slot>" was
        # rejected by clang.
        #
        # AGAST #1660: an enum-typed FIELD (`let k = e.kind`) loads the same
        # %Kind aggregate, so it narrows the same way.  The slot stayed i64
        # and argspec's `store i64 %<%ArgErrorKind>` was rejected by clang.
        else if stmt.var_init.kind == EXPR_MEMBER
            var en_name: *u8 = null
            var en_len: i32 = 0
            unit_enum_expr_name(s, stmt.var_init, @en_name, @en_len)
            if en_len > 0
                var_type = TYPE_STRUCT
                stmt.var_type = TYPE_STRUCT
                stmt.var_type_name = en_name
                stmt.var_type_name_len = en_len
            else
                # AGAST #2172: a struct-typed field -- `var u = o.i`,
                # `var w = mk().i`, `let a = d.o.i`, `let u = p.i` -- is a
                # `%In` slot, as ritz0 infers.  The slot stayed i64: `u.x`
                # then failed "unhandled EXPR_MEMBER", or the init emitted
                # `store i64 %<%In>`.  resolve_member_chain_field types the
                # chain for every root emit_member_ptr lowers (local,
                # global, call / method result, index, deref).
                let mf: *StructField = resolve_member_chain_field(s, stmt.var_init)
                if mf != null and mf.field_type == TYPE_STRUCT and mf.field_type_name_len > 0
                    if find_struct(s, mf.field_type_name, mf.field_type_name_len) != null
                        var_type = TYPE_STRUCT
                        stmt.var_type = TYPE_STRUCT
                        stmt.var_type_name = mf.field_type_name
                        stmt.var_type_name_len = mf.field_type_name_len
                # AGAST #2596: a `*T` field -- `let e = v.data` of a `Vec<E>`
                # -- is a `*T`, as if annotated (was i64: `e.b` "unhandled
                # EXPR_MEMBER").
                else if mf != null and mf.field_type == TYPE_PTR
                    var fp_name: *u8 = null
                    var fp_len: i32 = 0
                    let fp_kind: i32 = ptr_root_pointee(s, stmt.var_init, @fp_name, @fp_len)
                    if narrow_to_ptr(stmt, fp_kind, fp_name, fp_len) != 0
                        var_type = TYPE_PTR
        # try-expression: `let data = read_bytes()?`. The try-emit hands back
        # the unwrapped Ok payload, which is a struct (e.g., %Vec$u8) when
        # the Result's Ok variant carries a struct.  Narrow var_type to that
        # struct so the alloca matches the load width — without this, the
        # slot is i64-sized and the call's struct arg coerces from a
        # truncated 8-byte register.
        else if stmt.var_init.kind == EXPR_TRY
            var inner_call: *Expr = stmt.var_init.left
            if inner_call != null
                # Resolve inner Result/Option's payload type.  For inner
                # EXPR_CALL: lookup fn return-type-name.  For inner
                # EXPR_METHOD: not yet handled (different code path).
                var carrier_name: *u8 = null
                var carrier_name_len: i32 = 0
                if inner_call.kind == EXPR_CALL
                    let fdr: *FnDef = find_call_fn(s, inner_call)
                    if fdr != null and fdr.return_type == TYPE_STRUCT
                        carrier_name = fdr.return_type_name
                        carrier_name_len = fdr.return_type_name_len
                if carrier_name != null and carrier_name_len > 0
                    # The Ok payload's struct or user-enum type (AGAST
                    # #2105: an enum local is TYPE_STRUCT + its name, as
                    # for `let o = Holds(1)` above).
                    var pay_len: i32 = 0
                    let pay: *u8 = tagged_enum_payload_named(s, carrier_name, carrier_name_len, @pay_len, 1)
                    if pay != null
                        var_type = TYPE_STRUCT
                        stmt.var_type = TYPE_STRUCT
                        stmt.var_type_name = pay
                        stmt.var_type_name_len = pay_len
        # AGAST #1975: `let s = p[a..b]` over a bare local / param / global
        # `*T` (T primitive) is a `*T`, exactly as if annotated: the range
        # lowers to an element pointer (#110, strided by T since #1974).
        # Without this `s` kept the parser default TYPE_I64 with no pointee,
        # so `s[i]` strode and loaded by bytes.
        else if stmt.var_init.kind == EXPR_INDEX and stmt.var_init.right != null and stmt.var_init.right.kind == EXPR_RANGE and stmt.var_init.left.kind == EXPR_IDENT
            let rb: *Expr = stmt.var_init.left
            var rb_type: i32 = TYPE_UNKNOWN
            var rb_pointee: i32 = TYPE_UNKNOWN
            let rb_loc: *LocalVar = find_local_struct_name(s, rb.ident_ptr, rb.ident_len)
            if rb_loc != null
                rb_type = rb_loc.var_type
                rb_pointee = rb_loc.pointee_type
            else
                let rb_glob: *GlobalVarDef = find_global(s, rb.ident_ptr, rb.ident_len)
                if rb_glob != null
                    rb_type = rb_glob.var_type
                    rb_pointee = rb_glob.pointee_type
            if rb_type == TYPE_PTR and primitive_name_len(rb_pointee) > 0
                var_type = TYPE_PTR
                stmt.var_type = TYPE_PTR
                stmt.var_pointee_type = rb_pointee
        # AGAST #1453: `let p = raw as *P`.  The parser records the cast's
        # pointee on the EXPR_CAST node (int_val = pointee kind, ident_ptr =
        # struct name; see apply_cast_tail).  Narrow the local exactly as the
        # annotated `let p: *P = raw as *P` would be: TYPE_PTR plus the struct
        # name for `p.field`, or the primitive pointee kind so `*(q + i)` on
        # `raw as *i32` is scaled and loaded as i32.  Without this the local
        # stayed TYPE_I64: member reads failed "unhandled EXPR_MEMBER",
        # member stores were silently dropped, and arithmetic stepped by 1.
        else if stmt.var_init.kind == EXPR_CAST
            if stmt.var_init.op == TYPE_PTR and stmt.var_init.int_val != TYPE_VOID as i64
                let cast_pointee: i32 = stmt.var_init.int_val as i32
                if cast_pointee == TYPE_STRUCT
                    if stmt.var_init.ident_ptr != null and stmt.var_init.ident_len > 0
                        var_type = TYPE_PTR
                        stmt.var_type = TYPE_PTR
                        stmt.var_type_name = stmt.var_init.ident_ptr
                        stmt.var_type_name_len = stmt.var_init.ident_len
                        stmt.var_pointee_type = TYPE_STRUCT
                else
                    var_type = TYPE_PTR
                    stmt.var_type = TYPE_PTR
                    stmt.var_pointee_type = cast_pointee
        # AGAST #2575 / #2598: `let e = vec_as_ptr<E>(@v) + 1` is a `*E`, and
        # `let e = q + 1` (q: *i32) a `*i32`, as if annotated.
        else if stmt.var_init.kind == EXPR_BINARY
            var pa_name: *u8 = null
            var pa_len: i32 = 0
            let pa_kind: i32 = ptr_arith_pointee(s, stmt.var_init, @pa_name, @pa_len)
            if narrow_to_ptr(stmt, pa_kind, pa_name, pa_len) != 0
                var_type = TYPE_PTR
        # AGAST #175: address-of expression. `let task = @pool.tasks[i]` used
        # to keep var_type=TYPE_I64 with no type_name → the local was added as
        # a plain i64 binding, so later `task.field` calls find_local_struct_name
        # got null and emit_member_ptr fell through to "; ERROR: unhandled
        # EXPR_MEMBER" with a stale `%.0` reference (use of undefined value
        # in the icmp). Narrow var_type to TYPE_PTR + struct name when we can
        # statically resolve the pointee struct, so add_local_struct registers
        # the binding and `.field` access GEPs through the loaded pointer.
        # Same family of fixes as ritz-task-170 (chained EXPR_MEMBER addr-of).
        else if stmt.var_init.kind == EXPR_UNARY
            if stmt.var_init.op == OP_ADDR or stmt.var_init.op == OP_ADDR_MUT
                var addr_pointee: *u8 = null
                var addr_pointee_len: i32 = 0
                let addr_oper: *Expr = stmt.var_init.operand
                if addr_oper != null
                    # @ident: pointee = the local's struct type
                    if addr_oper.kind == EXPR_IDENT
                        let aloc: *LocalVar = find_local_struct_name(s, addr_oper.ident_ptr, addr_oper.ident_len)
                        if aloc != null
                            if (aloc.var_type == TYPE_STRUCT and aloc.type_name_len > 0) or lent_struct_local(s, addr_oper) != null
                                addr_pointee = aloc.type_name
                                addr_pointee_len = aloc.type_name_len
                    # @arr[i]  OR  @<chained-member>[i] — pointee = array element struct
                    else if addr_oper.kind == EXPR_INDEX
                        if addr_oper.left.kind == EXPR_IDENT
                            let aarr: *LocalVar = find_local_struct_name(s, addr_oper.left.ident_ptr, addr_oper.left.ident_len)
                            if aarr != null
                                if aarr.var_type == TYPE_ARRAY and aarr.array_elem_type == TYPE_STRUCT and aarr.type_name_len > 0
                                    addr_pointee = aarr.type_name
                                    addr_pointee_len = aarr.type_name_len
                        else if addr_oper.left.kind == EXPR_MEMBER
                            # Walk arbitrary-depth member chain (`srv.pool.tasks[i]`)
                            # and pick up the array element type from the leaf field.
                            let arr_field: *StructField = resolve_member_chain_field(s, addr_oper.left)
                            if arr_field != null
                                if arr_field.field_type == TYPE_ARRAY and arr_field.array_elem_type == TYPE_STRUCT and arr_field.array_elem_type_name_len > 0
                                    addr_pointee = arr_field.array_elem_type_name
                                    addr_pointee_len = arr_field.array_elem_type_name_len
                    # @<chained-member> — pointee = field's struct type
                    else if addr_oper.kind == EXPR_MEMBER
                        let mfield: *StructField = resolve_member_chain_field(s, addr_oper)
                        if mfield != null
                            if mfield.field_type == TYPE_STRUCT and mfield.field_type_name_len > 0
                                addr_pointee = mfield.field_type_name
                                addr_pointee_len = mfield.field_type_name_len
                if addr_pointee != null and addr_pointee_len > 0
                    var_type = TYPE_PTR
                    stmt.var_type = TYPE_PTR
                    stmt.var_type_name = addr_pointee
                    stmt.var_type_name_len = addr_pointee_len
            # AGAST #2542: `let v = *p` / `*(p + i)` / `**r` with a struct or
            # enum pointee is that aggregate, as if annotated.  The slot stayed
            # i64 with no name: `v.b` was refused "unlowerable" and `match v`
            # on an enum reported a false "unreachable arm".  The deref loads
            # `%<name>` exactly when deref_pointee_struct_name gives one, so
            # the slot takes the same name; a primitive pointee gives none.
            else if stmt.var_init.op == OP_DEREF and stmt.var_init.operand != null
                var dr_name: *u8 = null
                var dr_len: i32 = 0
                deref_pointee_struct_name(s, stmt.var_init.operand, @dr_name, @dr_len)
                if dr_name != null and dr_len > 0
                    var_type = TYPE_STRUCT
                    stmt.var_type = TYPE_STRUCT
                    stmt.var_type_name = dr_name
                    stmt.var_type_name_len = dr_len

    if infer_ref_to_pointer_let(s, stmt) == 1
        var_type = stmt.var_type
    if infer_array_ptr_let(s, stmt) == 1
        var_type = stmt.var_type
    if infer_array_elem_let(s, stmt) == 1
        var_type = stmt.var_type
    if infer_through_elem_let(s, stmt) == 1
        var_type = stmt.var_type
    if infer_struct_elem_let(s, stmt) == 1
        var_type = stmt.var_type
    if infer_ptr_index_let(s, stmt) == 1   # #2377: `a[i][j]`, a struct
        var_type = stmt.var_type
    if infer_full_elem_ref_let(s, stmt) == 1   # #2571: `@&x[i]`, an element
        var_type = stmt.var_type
    if infer_field_ref_let(s, stmt) == 1   # #2400: `@&p.f`, a scalar field
        var_type = stmt.var_type

    # `let task = @member.field[i]` — when the indexed field is an array
    # of struct, infer the local as `*ElementStruct` so subsequent
    # `task.state` member access resolves.  Without this, the local was
    # left as TYPE_I64 (the parser default) and member access failed
    # with "; ERROR: unhandled EXPR_MEMBER".  Surfaces in ritzlib's
    # async/tasks `run_tasks` (`let task = @pool.tasks[i]`).
    # Handles single-level (`pool.tasks[i]`) and one-level chained
    # (`srv.pool.tasks[i]`) member access — the latter occurs in
    # async/tasks's `task_server_poll_tasks(srv: *TaskServer)`.
    if var_type == TYPE_I64 and stmt.var_type_name_len == 0 and stmt.var_init != null
        if stmt.var_init.kind == EXPR_UNARY and stmt.var_init.op == OP_ADDR
            let inner_addr: *Expr = stmt.var_init.operand
            if inner_addr != null and inner_addr.kind == EXPR_INDEX
                let mb: *Expr = inner_addr.left
                if mb != null and mb.kind == EXPR_MEMBER
                    # Resolve the receiver's struct type.  Two shapes:
                    #   `pool.tasks[i]`     — mb.left = EXPR_IDENT (pool)
                    #   `srv.pool.tasks[i]` — mb.left = EXPR_MEMBER
                    var rcv_tn_a: *u8 = null
                    var rcv_tn_a_len: i32 = 0
                    if mb.left != null and mb.left.kind == EXPR_IDENT
                        let rloc: *LocalVar = find_local_struct_name(s, mb.left.ident_ptr, mb.left.ident_len)
                        if rloc != null and rloc.type_name_len > 0
                            rcv_tn_a = rloc.type_name
                            rcv_tn_a_len = rloc.type_name_len
                    else if mb.left != null and mb.left.kind == EXPR_MEMBER
                        # Walk one extra level: outer.middle.field[i]
                        let mb_outer: *Expr = mb.left  # outer.middle
                        if mb_outer.left != null and mb_outer.left.kind == EXPR_IDENT
                            let rloc2: *LocalVar = find_local_struct_name(s, mb_outer.left.ident_ptr, mb_outer.left.ident_len)
                            if rloc2 != null and rloc2.type_name_len > 0
                                # Resolve the inner field (`outer.middle`) to its struct
                                let outer_st: *StructDef = find_struct(s, rloc2.type_name, rloc2.type_name_len)
                                if outer_st != null
                                    let mid_idx: i32 = find_field_index(outer_st, mb_outer.ident_ptr, mb_outer.ident_len)
                                    if mid_idx >= 0
                                        let mid_field: *StructField = get_field_type(outer_st, mid_idx)
                                        if mid_field.field_type == TYPE_STRUCT and mid_field.field_type_name_len > 0
                                            rcv_tn_a = mid_field.field_type_name
                                            rcv_tn_a_len = mid_field.field_type_name_len
                    if rcv_tn_a != null
                        let rst_a: *StructDef = find_struct(s, rcv_tn_a, rcv_tn_a_len)
                        if rst_a != null
                            let fid_a: i32 = find_field_index(rst_a, mb.ident_ptr, mb.ident_len)
                            if fid_a >= 0
                                let fa: *StructField = get_field_type(rst_a, fid_a)
                                if fa.field_type == TYPE_ARRAY and fa.array_elem_type == TYPE_STRUCT and fa.array_elem_type_name_len > 0
                                    var_type = TYPE_PTR
                                    stmt.var_type = TYPE_PTR
                                    stmt.var_type_name = fa.array_elem_type_name
                                    stmt.var_type_name_len = fa.array_elem_type_name_len

    # AGAST #2047: a float-valued initializer no arm above typed -- a binary
    # (`x + 0.5`, binop_float_width #1965), a cast `n as f32`, a float field
    # `p.a`, a negation `-x`, `x.floor() + 0.5` -- is a float / double slot,
    # as ritz0 infers.  The slot stayed i64 and clang rejected
    # `store i64 <float>`.  A pre-emitted match / if already published its
    # phi type above, so it is not re-typed here.
    if var_type == TYPE_I64 and stmt.var_type_name_len == 0 and stmt.var_init != null and pre_emitted == 0
        let init_fty: i32 = get_expr_type(s, stmt.var_init)
        if init_fty == TYPE_F32 or init_fty == TYPE_F64
            var_type = init_fty
            stmt.var_type = init_fty

    let alloca_reg: i32 = next_reg(s)
    emit_str(s, c"  ")
    emit_reg(s, alloca_reg)
    emit_str(s, c" = alloca ")
    if var_type == TYPE_ARRAY and stmt.var_array_shape != null
        # AGAST #1509: `var g: [N][M]T` -> `alloca [N x [M x T]]` (it was
        # `[N x i64]`: the inner array lost, every access miscompiled).
        emit_array_shape_llvm(s, stmt.var_array_shape, 0)
    else if var_type == TYPE_ARRAY
        # Emit array type: [N x elem_type]
        emit_str(s, c"[")
        emit_int(s, stmt.var_array_size as i64)
        emit_str(s, c" x ")
        if stmt.var_array_elem_type == TYPE_STRUCT and stmt.var_type_name_len > 0
            emit_str(s, c"%")
            emit_name(s, stmt.var_type_name, stmt.var_type_name_len)
        else
            # The spelling every access over the local uses (#1564, #1966).
            emit_str(s, local_array_elem_llvm(stmt.var_array_elem_type))
        emit_str(s, c"]")
    else
        emit_llvm_type_struct(s, var_type, stmt.var_type_name, stmt.var_type_name_len)
    emit_str(s, c"\n")

    # AGAST #2330: `p#`, the `*T` view of a `*[N]T` local, before `p` itself.
    var view_name_len: i32 = 0
    let view_name: *u8 = inferred_array_elem_name(s, stmt, @view_name_len)
    add_array_view(s, stmt.var_name, stmt.var_name_len, alloca_reg, var_type, stmt.var_pointee_type, stmt.var_pointee_array_size, stmt.var_pointee_array_elem_type, view_name, view_name_len)
    # Track local variable type info for member access
    # For pointer-to-struct (*StructName), use add_local_struct to track struct name
    # References are treated as pointers at the LLVM level
    if var_type == TYPE_PTR and stmt.var_type_name_len > 0
        # Pointer to struct - track with struct name for ptr.field access.
        # AGAST #1451: record pointee_type = TYPE_STRUCT as well, exactly as
        # parameters of the same type are registered (emitter.ritz,
        # param_pointee_type).  This used add_local_struct, which hard-codes
        # pointee TYPE_I64, so `let base: *LB = ...; base + k` was scaled by
        # 8 instead of sizeof(LB) — a silent wrong address — while the same
        # arithmetic on a `base: *LB` parameter was correct.  Every path that
        # reaches here with a type name (annotated `*Struct`, or one of the
        # narrowings above) names the pointee struct.
        add_local_full(s, stmt.var_name, stmt.var_name_len, alloca_reg, var_type, stmt.var_type_name, stmt.var_type_name_len, TYPE_STRUCT, 0, 0)
    else if (var_type == TYPE_REF or var_type == TYPE_MUT_REF) and stmt.var_type_name_len > 0 and stmt.var_pointee_type != TYPE_ARRAY
        # AGAST #1754: `@S` / `@&S` local -- registered like a param of the
        # same type (struct name + pointee) so `q.a` resolves.  #2552: not an
        # `@[N]S` / `@&[N]S`, whose S made `p.b` an `@S` field read of element
        # 0; it binds as a `*[N]S` does, and name_array_ptr_local records S.
        add_local_full(s, stmt.var_name, stmt.var_name_len, alloca_reg, var_type, stmt.var_type_name, stmt.var_type_name_len, stmt.var_pointee_type, 0, 0)
        set_local_inner_pointee(s, stmt.var_name, stmt.var_name_len, stmt.var_inner_pointee_type)   # AGAST #2372: `@**S`
    else if var_type == TYPE_PTR_PTR and stmt.var_type_name_len > 0
        # AGAST #1933: `let pp: **S` -- keep the struct name, as a `**S`
        # param does, so emit_deref_operand_ptr resolves `(**pp).f`.  It
        # went through add_local_ptr, which drops the name, and both the
        # read and the store failed with "unhandled EXPR_MEMBER".
        add_local_full(s, stmt.var_name, stmt.var_name_len, alloca_reg, var_type, stmt.var_type_name, stmt.var_type_name_len, stmt.var_pointee_type, 0, 0)
        set_local_inner_pointee(s, stmt.var_name, stmt.var_name_len, stmt.var_inner_pointee_type)
    else if var_type == TYPE_PTR or var_type == TYPE_PTR_PTR or var_type == TYPE_REF or var_type == TYPE_MUT_REF
        add_local_ptr(s, stmt.var_name, stmt.var_name_len, alloca_reg, var_type, stmt.var_pointee_type)
        set_local_inner_pointee(s, stmt.var_name, stmt.var_name_len, stmt.var_inner_pointee_type)
    else if var_type == TYPE_STRUCT
        add_local_struct(s, stmt.var_name, stmt.var_name_len, alloca_reg, var_type, stmt.var_type_name, stmt.var_type_name_len)
    else if var_type == TYPE_ARRAY
        # For arrays of structs, also stash the element struct name in
        # type_name so emit_member_ptr can resolve `arr[i].field`.
        # AGAST #184: also stash the inner-pointee struct name for
        # `[N]*Foo` / `[N]**Foo` arrays — emit_member_ptr's PTR-element
        # branch loads the slot's *Foo and GEPs into Foo for the field.
        if stmt.var_array_elem_type == TYPE_STRUCT and stmt.var_type_name_len > 0
            add_local_full(s, stmt.var_name, stmt.var_name_len, alloca_reg, TYPE_ARRAY, stmt.var_type_name, stmt.var_type_name_len, TYPE_I64, stmt.var_array_size, stmt.var_array_elem_type)
        else if (stmt.var_array_elem_type == TYPE_PTR or stmt.var_array_elem_type == TYPE_PTR_PTR) and stmt.var_type_name_len > 0
            add_local_full(s, stmt.var_name, stmt.var_name_len, alloca_reg, TYPE_ARRAY, stmt.var_type_name, stmt.var_type_name_len, TYPE_I64, stmt.var_array_size, stmt.var_array_elem_type)
        else
            add_local_array(s, stmt.var_name, stmt.var_name_len, alloca_reg, stmt.var_array_size, stmt.var_array_elem_type)
        let arr_loc: *LocalVar = local_at(s, s.local_count - 1)
        arr_loc.array_elem_pointee = stmt.var_array_elem_pointee   # AGAST #2341
        arr_loc.array_rec = stmt.var_array   # AGAST #2995
        if stmt.var_array_shape != null and s.local_count > 0
            let nd_loc: *LocalVar = local_at(s, s.local_count - 1)
            nd_loc.array_shape = stmt.var_array_shape  # AGAST #1509
    else
        add_local(s, stmt.var_name, stmt.var_name_len, alloca_reg, var_type)
    set_local_fn_sig(s, stmt.var_name, stmt.var_name_len, fn_sig)  # AGAST #1671, #2417
    let declared: *LocalVar = find_local_struct_name(s, stmt.var_name, stmt.var_name_len)
    declared.holds_shared_ref = shared_ref
    if var_type == TYPE_PTR or var_type == TYPE_PTR_PTR or var_type == TYPE_REF or var_type == TYPE_MUT_REF
        set_local_pointee_array(s, stmt.var_name, stmt.var_name_len, stmt.var_pointee_array_size, stmt.var_pointee_array_elem_type)  # AGAST #1953, #2308, #2539 (`**[N]T`)
        set_local_pointee_elem(s, stmt.var_name, stmt.var_name_len, stmt.var_pointee_array_elem_pointee)
        name_array_ptr_local(declared, stmt, view_name, view_name_len)   # AGAST #2543
    # An unannotated local takes its initialiser's kind; var_type can't say.
    var inferred_bool: i32 = 0
    var inferred_unsure: i32 = 0
    if stmt.var_declared_type == TYPE_VOID and stmt.var_init != null
        inferred_bool = (init_kind == BK_BOOL) as i32
        inferred_unsure = (init_kind == BK_UNSURE) as i32
    if (declared_bool == 1 or inferred_bool == 1) and s.local_count > 0
        let bool_loc: *LocalVar = local_at(s, s.local_count - 1)
        bool_loc.is_bool = 1
    if inferred_unsure == 1 and s.local_count > 0
        let unsure_loc: *LocalVar = local_at(s, s.local_count - 1)
        unsure_loc.bk_unsure = 1
    if init_u64 == 1 and var_type == TYPE_I64
        declared.var_type = TYPE_U64

    if stmt.var_init != null and stmt.var_array_shape != null
        # AGAST #1509: no initializer form of a multi-dimensional array is
        # lowered (the 1-D literal / fill / copy paths would write it as a
        # flat [N x i64]).  Fail closed: the error count stops the driver
        # writing any output.
        emit_nd_error(s, stmt.span.line, stmt.span.col, c"an initializer on a multi-dimensional array is not supported in ritz1")
        return
    if stmt.var_init != null
        # Check for struct literal initializer
        if stmt.var_init.kind == EXPR_STRUCT_LIT
            # Struct literal: emit field-by-field initialization
            # e.ident_ptr/ident_len = struct type name
            # e.args = pointer to FieldInit list (recast)
            let e: *Expr = stmt.var_init
            let st: *StructDef = find_struct(s, e.ident_ptr, e.ident_len)
            if st != null
                # Iterate through field initializers
                var fi: *FieldInit = e.args as *FieldInit
                while fi != null
                    # Find field index in struct
                    var field_idx: i32 = find_field_index(st, fi.name, fi.name_len)
                    # `a: [v; N]` for an array field is written in place.
                    if field_idx >= 0
                        if emit_struct_lit_array_fill_field(s, st, field_idx, fi.value, alloca_reg) == 1
                            field_idx = -1  # done (AGAST #1605)
                    if field_idx >= 0
                        emit_struct_lit_field_store(s, st, field_idx, fi.value, alloca_reg)
                    fi = fi.next
            return  # Done with struct literal init

        # Array-fill init for typed [N]T slots: `let buf: [N]T = [v; N]`.
        # squeeze/cryptosec/valet rely on this for inflate/sbox tables.
        # Lowering strategy lives in emit_array_fill_into (emitter_expr).
        if var_type == TYPE_ARRAY and stmt.var_init.kind == EXPR_ARRAY_FILL
            emit_array_fill_into(s, alloca_reg, stmt.var_array_size, stmt.var_array_elem_type, stmt.var_type_name, stmt.var_type_name_len, stmt.var_init.left)
            return

        # Array-literal init for typed [N]T slots (ritz0 parity —
        # test_issue_span_slice_range and friends).  The generic fallthrough
        # below emits the literal into a shadow `[N x i64]` alloca and then
        # stores a single `i64 %ptrtoint` into the declared array slot,
        # which is wrong when the slot's element type isn't i64 (most cases).
        # Instead, iterate the literal's elements, evaluate each, and store
        # it into slot[i] at the declared element type — mirrors ritz0's
        # direct-element-store behaviour.
        if var_type == TYPE_ARRAY and stmt.var_init.kind == EXPR_ARRAY_LIT
            # `stmt.var_type_name` names the element struct of `[N]T`.
            emit_array_lit_into(s, alloca_reg, stmt.var_array_size, stmt.var_array_elem_type, stmt.var_type_name, stmt.var_type_name_len, stmt.var_init)
            return

        # AGAST #2035 / #2169: `let a: [N]T = x.f` / `= c` / `= *p` copy
        # the whole array.
        if var_type == TYPE_ARRAY
            emit_array_local_whole_assign(s, alloca_reg, stmt.var_array_size, stmt.var_array_elem_type, stmt.var_type_name, stmt.var_type_name_len, stmt.var_init)
            return

        # ritz-task-133: thread enum ctx so `let r: Result<_,_> = Ok(x)` in
        # a non-Result-returning fn still builds the right struct.  Save /
        # restore around the init expression so nested decls don't leak.
        let _saved_ctx: *u8 = s.ctx_enum_name
        let _saved_ctx_len: i32 = s.ctx_enum_name_len
        # AGAST #167: same shape, different ctx — when the binding's
        # declared type is a SIMD vector (`v4i32`, ...) the inline SIMD
        # intrinsic dispatch in emit_expr_call uses this to size the
        # `<N x iM>` load result.
        let _saved_simd: *u8 = s.ctx_simd_name
        let _saved_simd_len: i32 = s.ctx_simd_name_len
        if var_type == TYPE_STRUCT
            if stmt.var_type_name_len > 0
                if is_ctor_slot_enum(stmt.var_type_name, stmt.var_type_name_len) == 1
                    s.ctx_enum_name = stmt.var_type_name
                    s.ctx_enum_name_len = stmt.var_type_name_len
                if is_simd_vector_type_name(stmt.var_type_name, stmt.var_type_name_len) == 1
                    s.ctx_simd_name = stmt.var_type_name
                    s.ctx_simd_name_len = stmt.var_type_name_len
        var init_reg: i32 = pre_init_reg
        if pre_emitted == 0
            set_match_float_hint(s, stmt.var_init, var_type, stmt.var_type_name, stmt.var_type_name_len)
            init_reg = emit_expr_by_value(s, stmt.var_init, var_type, stmt.var_type_name, stmt.var_type_name_len)
            if var_type == TYPE_STRUCT
                init_reg = coerce_array_to_span(s, stmt.var_init, init_reg, stmt.var_type_name, stmt.var_type_name_len)   # AGAST #2502
        s.ctx_enum_name = _saved_ctx
        s.ctx_enum_name_len = _saved_ctx_len
        s.ctx_simd_name = _saved_simd
        s.ctx_simd_name_len = _saved_simd_len
        if var_type == TYPE_I32 or var_type == TYPE_U32
            let trunc: i32 = next_reg(s)
            emit_str(s, c"  ")
            emit_reg(s, trunc)
            emit_str(s, c" = trunc i64 ")
            emit_reg(s, init_reg)
            emit_str(s, c" to i32\n")
            emit_str(s, c"  store i32 ")
            emit_reg(s, trunc)
            emit_str(s, c", ptr ")
            emit_reg(s, alloca_reg)
            emit_str(s, c"\n")
        else if var_type == TYPE_U16 or var_type == TYPE_I16
            # Truncate i64 (unified value model) to i16 for the slot.
            let trunc: i32 = next_reg(s)
            emit_str(s, c"  ")
            emit_reg(s, trunc)
            emit_str(s, c" = trunc i64 ")
            emit_reg(s, init_reg)
            emit_str(s, c" to i16\n")
            emit_str(s, c"  store i16 ")
            emit_reg(s, trunc)
            emit_str(s, c", ptr ")
            emit_reg(s, alloca_reg)
            emit_str(s, c"\n")
        else if var_type == TYPE_U8 or var_type == TYPE_I8
            # Truncate i64 to i8 for byte types
            let trunc: i32 = next_reg(s)
            emit_str(s, c"  ")
            emit_reg(s, trunc)
            emit_str(s, c" = trunc i64 ")
            emit_reg(s, init_reg)
            emit_str(s, c" to i8\n")
            emit_str(s, c"  store i8 ")
            emit_reg(s, trunc)
            emit_str(s, c", ptr ")
            emit_reg(s, alloca_reg)
            emit_str(s, c"\n")
        else if var_type == TYPE_MUT_REF
            # AGAST #1754: an `@&T` slot holds the `ptr` it loads as (like an
            # `@&T` param); an i64 init (a `*T` value, a `-> @&T`
            # call result) gets an inttoptr.
            let init_pval: i32 = i64_value_to_ptr(s, stmt.var_init, init_reg)
            emit_str(s, c"  store ptr ")
            emit_reg(s, init_pval)
            emit_str(s, c", ptr ")
            emit_reg(s, alloca_reg)
            emit_str(s, c"\n")
        else if var_type == TYPE_PTR or var_type == TYPE_PTR_PTR or var_type == TYPE_REF
            # Store i64 directly (pointers are stored as i64).  AGAST #1652:
            # an `@&T` init (`let p: *S = s`) is a `ptr`; ptrtoint it first.
            let init_ival: i32 = ptr_slot_value(s, var_type, stmt.var_init, init_reg)
            emit_str(s, c"  store i64 ")
            emit_reg(s, init_ival)
            emit_str(s, c", ptr ")
            emit_reg(s, alloca_reg)
            emit_str(s, c"\n")
        else if var_type == TYPE_STRUCT
            # Store struct directly. emit_llvm_type_struct routes tagged-enum
            # Result$/Option$ to i64 so the store type matches the i64 value
            # produced by variant constructors (task-99 cluster #3).
            #
            # AGAST #168: Span$u8 ↔ StrView layout-equivalence coercion.
            # When the init expression's nominal struct type differs from the
            # slot's declared type but they share `{ ptr, i64 }` layout (e.g.
            # `let x: StrView = "..."` where bare strings lower to %Span$u8),
            # decompose-rebuild the aggregate so the store types agree.
            var stored_reg: i32 = init_reg
            var src_name: *u8 = null
            var src_len: i32 = 0
            resolve_expr_struct_name(s, stmt.var_init, @src_name, @src_len)
            if is_layout_equiv_pair(src_name, src_len, stmt.var_type_name, stmt.var_type_name_len) == 1
                stored_reg = rebuild_layout_equiv(s, init_reg, src_name, src_len, stmt.var_type_name, stmt.var_type_name_len)
            emit_str(s, c"  store ")
            emit_llvm_type_struct(s, TYPE_STRUCT, stmt.var_type_name, stmt.var_type_name_len)
            emit_str(s, c" ")
            emit_reg(s, stored_reg)
            emit_str(s, c", ptr ")
            emit_reg(s, alloca_reg)
            emit_str(s, c"\n")
        else if var_type == TYPE_F32
            # Float literal lowers as `fadd double 0.0, <lit>` (i.e. f64);
            # narrow to f32 via fptrunc when the binding is f32-typed.
            # The init reg is `double` — same alloca slot is `float`.
            var stored_reg: i32 = int_to_float_slot(s, init_reg, TYPE_F32, stmt.var_init)
            let init_ty: i32 = get_expr_type(s, stmt.var_init)
            if init_ty == TYPE_F64
                stored_reg = next_reg(s)
                emit_str(s, c"  ")
                emit_reg(s, stored_reg)
                emit_str(s, c" = fptrunc double ")
                emit_reg(s, init_reg)
                emit_str(s, c" to float\n")
            emit_str(s, c"  store float ")
            emit_reg(s, stored_reg)
            emit_str(s, c", ptr ")
            emit_reg(s, alloca_reg)
            emit_str(s, c"\n")
        else if var_type == TYPE_F64
            # f64 binding — float lit already at double; an integer init
            # is sitofp'd (#2062).
            let dval: i32 = int_to_float_slot(s, init_reg, TYPE_F64, stmt.var_init)
            emit_str(s, c"  store double ")
            emit_reg(s, dval)
            emit_str(s, c", ptr ")
            emit_reg(s, alloca_reg)
            emit_str(s, c"\n")
        else
            emit_str(s, c"  store ")
            emit_llvm_type(s, var_type)
            emit_str(s, c" ")
            emit_reg(s, init_reg)
            emit_str(s, c", ptr ")
            emit_reg(s, alloca_reg)
            emit_str(s, c"\n")

# AGAST #1509: store stmt.assign_value into the N-D element `dst` points
# at, at the leaf's width (as a 1-D local array element store does).  A row
# or a whole struct element is a located error.
fn emit_nd_elem_store(s: *EmitterState, stmt: *Stmt, dst: *NdIndexPtr)
    let sh: *ArrayShape = dst.shape
    if dst.depth < sh.rank or sh.leaf_type == TYPE_STRUCT
        emit_nd_error(s, stmt.span.line, stmt.span.col, c"assigning a row or a whole struct element of a multi-dimensional array is not supported in ritz1 (assign each element or field)")
        return
    let ty: *u8 = local_array_elem_llvm(sh.leaf_type)
    let val: i32 = emit_expr(s, stmt.assign_value)
    var store_val: i32 = val
    if array_elem_typed_scalar(sh.leaf_type) == 1
        store_val = emit_field_elem_narrow(s, val, sh.leaf_type, stmt.assign_value)
    else
        store_val = emit_array_elem_narrow(s, val, sh.leaf_type, ty)
    emit_str(s, c"  store ")
    emit_str(s, ty)
    emit_str(s, c" ")
    emit_reg(s, store_val)
    emit_str(s, c", ptr ")
    emit_reg(s, dst.reg)
    emit_str(s, c"\n")

# AGAST #2097: the ArrayShape of `var.field` for a STMT_LOCAL_FIELD_INDEX_ASSIGN
# `var.field[i] = v`, null when the field is not multi-dimensional.
fn local_field_nd_shape(s: *EmitterState, stmt: *Stmt) -> *ArrayShape
    var base: Expr
    base.kind = EXPR_IDENT
    base.ident_ptr = stmt.var_name
    base.ident_len = stmt.var_name_len
    var mem: Expr
    mem.kind = EXPR_MEMBER
    mem.left = @base
    mem.ident_ptr = stmt.assign_target
    mem.ident_len = stmt.assign_target_len
    return nd_array_member_shape(s, @mem)

# AGAST #2440: `p[i] = v` with `p` a local.  Returns 1 when it took `stmt`: it's
# `*(p.data + i) = v`, or refused.
fn emit_through_index_assign(s: *EmitterState, stmt: *Stmt) -> i32
    var root: Expr
    var target: Expr
    memset(@root as *u8, 0, sizeof(Expr))
    memset(@target as *u8, 0, sizeof(Expr))
    root.kind = EXPR_IDENT
    root.span = stmt.span
    root.ident_ptr = stmt.assign_target
    root.ident_len = stmt.assign_target_len
    target.kind = EXPR_INDEX
    target.span = stmt.span
    target.bracket = stmt.bracket   # AGAST #2886
    target.left = @root
    target.right = stmt.while_cond
    if index_refused(s, @target) == 1
        return 1
    let through: *LocalVar = index_through(s, @target)
    if through == null
        return 0
    if through_whole_array_refused(s, through, stmt.assign_value, stmt.span.line, stmt.span.col) == 1
        return 1
    var th: ThroughIndex
    index_through_fill(@target, through_spill(s, through), @th)
    var store: Stmt
    memset(@store as *u8, 0, sizeof(Stmt))
    store.kind = STMT_ASSIGN
    store.span = stmt.span
    store.if_cond = @th.deref
    store.assign_value = stmt.assign_value
    emit_assign(s, @store)
    1

# AGAST #2346: `r = v` where `r` is a `r:& T` param and T is a struct, an enum
# (tagged or not), StrView, f32 or f64.  ritz0 auto-dereferences the borrow, so
# the whole referent is overwritten.  These params stay TYPE_MUT_REF locals
# whose slot holds the caller's pointer (bind_scalar_borrow_param binds only
# integer and array pointees as the referent itself).  The generic arm stored
# the value as an i64 into that slot: a clang error for an aggregate or a
# float, and for `r = v` with `v:& C` too, a silent reseat of `r` onto `v`.
# Load the pointer and store the value at T.  `slot` is `r`'s slot register.
# Returns 1 when it emitted the store.
fn emit_lent_whole_store(s: *EmitterState, stmt: *Stmt, slot: i32) -> i32
    let loc: *LocalVar = find_local_struct_name(s, stmt.assign_target, stmt.assign_target_len)
    if loc == null or loc.var_type != TYPE_MUT_REF or loc.holds_lent_ptr == 0
        return 0
    let pt: i32 = loc.pointee_type
    if pt == TYPE_STRUCT and loc.type_name_len > 0
        # Evaluated before the pointer is loaded: the value may read `r`.
        let raw: i32 = emit_expr_into_slot(s, stmt.assign_value, TYPE_STRUCT, loc.type_name, loc.type_name_len)
        # A bare "..." is a %Span$u8; `r:& StrView` wants it as a %StrView.
        let val: i32 = coerce_struct_ret_value(s, stmt.assign_value, raw, loc.type_name, loc.type_name_len)
        let dst: i32 = emit_load_ptr(s, slot)
        emit_str(s, c"  store ")
        emit_llvm_type_struct(s, TYPE_STRUCT, loc.type_name, loc.type_name_len)
        emit_str(s, c" ")
        emit_reg(s, val)
        emit_str(s, c", ptr ")
        emit_reg(s, dst)
        emit_str(s, c"\n")
        return 1
    if pt == TYPE_F32 or pt == TYPE_F64
        let fval: i32 = emit_expr(s, stmt.assign_value)
        return emit_float_field_store(s, emit_load_ptr(s, slot), pt, fval, stmt.assign_value)
    0

fn emit_assign(s: *EmitterState, stmt: *Stmt)
    # Check for expression assignment: expr = value
    # When assign_target_len == 0, the target is in if_cond as an expression
    if stmt.assign_target_len == 0
        var target_expr: *Expr = stmt.if_cond as *Expr

        # AGAST #2332: `a[i][j] = v` with `a: [N]*T` is `*(a[i] + j) = v`.  The
        # generic path below stored through the VALUE of `a[i][j]`.
        var ei_sum: Expr
        var ei_deref: Expr
        if is_array_elem_index(s, target_expr) == 1
            elem_index_as_deref(target_expr, @ei_sum, @ei_deref)
            target_expr = @ei_deref

        # AGAST #2440: `(*p)[i] = v`, as `p[i] = v`.
        var th: ThroughIndex
        let through: *LocalVar = index_through(s, target_expr)
        if through != null
            if through_whole_array_refused(s, through, stmt.assign_value, stmt.span.line, stmt.span.col) == 1
                return
            index_through_fill(target_expr, through_spill(s, through), @th)
            target_expr = @th.deref

        # AGAST #2545: `(*r)[i] = v` with `r: **T` GEPs and stores T, as
        # `(*r)[i]` loads it (#2537's deref_index_elem).  It fell to the
        # generic path below, which stored through the VALUE `(*r)[i]` read,
        # as an i64: a segfault on i16, invalid IR on f64.
        let dix: i32 = deref_index_elem(s, target_expr)
        if dix != TYPE_VOID
            let dbase: i32 = emit_expr(s, target_expr.left)
            let dptr: i32 = next_reg(s)
            emit_str(s, c"  ")
            emit_reg(s, dptr)
            emit_str(s, c" = inttoptr i64 ")
            emit_reg(s, dbase)
            emit_str(s, c" to ptr\n")
            emit_ptr_elem_store(s, target_expr.right, stmt.assign_value, dptr, TYPE_PTR, dix)
            return

        # AGAST #1509: `g[i][j] = v` over a multi-dimensional array.  It fell
        # to the generic path below, which evaluated `g[i][j]` as a VALUE
        # (over a flattened [N x i64]) and stored through it.
        if target_expr.kind == EXPR_INDEX
            var nd_dst: NdIndexPtr
            if emit_nd_index_ptr(s, target_expr, @nd_dst) == 1
                emit_nd_elem_store(s, stmt, @nd_dst)
                return

        # Check if target is a member expression (struct field assignment)
        if target_expr.kind == EXPR_MEMBER
            var member_result: MemberPtrResult
            emit_member_ptr(s, target_expr, @member_result)
            if member_result.success == 1 and member_result.field.field_type == TYPE_ARRAY
                # AGAST #1934: whole-array store into an inline array field.
                # Must not reach the generic emit_expr + `store i64` below,
                # which stored the ADDRESS of emit_expr's shadow alloca.
                emit_array_field_whole_assign(s, member_result.reg, member_result.field, stmt.assign_value)
                return
            if member_result.success == 1
                let field: *StructField = member_result.field
                # AGAST #2142: `p.shape = Rect(..)` builds the field's enum.
                let val: i32 = emit_expr_into_field(s, stmt.assign_value, field)
                # AGAST #2048: f32 / f64 fields store float / double.
                if emit_float_field_store(s, member_result.reg, field.field_type, val, stmt.assign_value) == 1
                    return
                # Store value based on field type
                if field.field_type == TYPE_I32 or field.field_type == TYPE_U32
                    let trunc: i32 = next_reg(s)
                    emit_str(s, c"  ")
                    emit_reg(s, trunc)
                    emit_str(s, c" = trunc i64 ")
                    emit_reg(s, val)
                    emit_str(s, c" to i32\n")
                    emit_str(s, c"  store i32 ")
                    emit_reg(s, trunc)
                    emit_str(s, c", ptr ")
                    emit_reg(s, member_result.reg)
                    emit_str(s, c"\n")
                else if field.field_type == TYPE_I16 or field.field_type == TYPE_U16
                    # Narrow field — value reg is always i64 (unified value
                    # model in emit_expr); trunc before store.
                    let trunc: i32 = next_reg(s)
                    emit_str(s, c"  ")
                    emit_reg(s, trunc)
                    emit_str(s, c" = trunc i64 ")
                    emit_reg(s, val)
                    emit_str(s, c" to i16\n")
                    emit_str(s, c"  store i16 ")
                    emit_reg(s, trunc)
                    emit_str(s, c", ptr ")
                    emit_reg(s, member_result.reg)
                    emit_str(s, c"\n")
                else if field.field_type == TYPE_I8 or field.field_type == TYPE_U8
                    let trunc: i32 = next_reg(s)
                    emit_str(s, c"  ")
                    emit_reg(s, trunc)
                    emit_str(s, c" = trunc i64 ")
                    emit_reg(s, val)
                    emit_str(s, c" to i8\n")
                    emit_str(s, c"  store i8 ")
                    emit_reg(s, trunc)
                    emit_str(s, c", ptr ")
                    emit_reg(s, member_result.reg)
                    emit_str(s, c"\n")
                else if field.field_type == TYPE_BOOL
                    # AGAST #1439: global-struct field stores now route here
                    # (`flags.on = true`); without this arm a bool fell to
                    # the 8-byte `store i64` default and clobbered the next
                    # 7 bytes.  Mirrors STMT_LOCAL_FIELD_ASSIGN's i1 arm.
                    let trunc1: i32 = next_reg(s)
                    emit_str(s, c"  ")
                    emit_reg(s, trunc1)
                    emit_str(s, c" = trunc i64 ")
                    emit_reg(s, val)
                    emit_str(s, c" to i1\n")
                    emit_str(s, c"  store i1 ")
                    emit_reg(s, trunc1)
                    emit_str(s, c", ptr ")
                    emit_reg(s, member_result.reg)
                    emit_str(s, c"\n")
                else if field.field_type == TYPE_PTR or field.field_type == TYPE_PTR_PTR or field.field_type == TYPE_REF or field.field_type == TYPE_MUT_REF
                    # AGAST #1652: `h.p = s` with `s: @&S` is already a `ptr`.
                    # AGAST #2329: so is `h.r = @&a` into an `@&[N]T`, which
                    # lower_ref_fields leaves a reference, and which fell to a
                    # `store i64` of the `ptr`.
                    let ival: i32 = ptr_value_to_i64(s, stmt.assign_value, val)
                    let ptr_val: i32 = next_reg(s)
                    emit_str(s, c"  ")
                    emit_reg(s, ptr_val)
                    emit_str(s, c" = inttoptr i64 ")
                    emit_reg(s, ival)
                    emit_str(s, c" to ptr\n")
                    emit_str(s, c"  store ptr ")
                    emit_reg(s, ptr_val)
                    emit_str(s, c", ptr ")
                    emit_reg(s, member_result.reg)
                    emit_str(s, c"\n")
                else if field.field_type == TYPE_STRUCT and field.field_type_name_len > 0
                    # AGAST #188: struct-typed field assigned a struct value
                    # (e.g. `slot.value = *src` where `slot.value: Field` and
                    # `*src` is a `load %Field, ...`).  Without this branch the
                    # default fell through to `store i64 %val`, but %val is
                    # a `%FieldType` aggregate, hitting LLVM's
                    # `'%val' defined with type '%T' but expected 'i64'`.
                    # Route through emit_llvm_type_struct so primitive-aliased
                    # struct names (`u16`, etc.) and SIMD vectors lower right.
                    # `o.w.s = "ab"`: a %Span$u8 rebuilt as %StrView (#2412).
                    let agg: i32 = coerce_struct_ret_value(s, stmt.assign_value, val, field.field_type_name, field.field_type_name_len)
                    emit_str(s, c"  store ")
                    emit_llvm_type_struct(s, TYPE_STRUCT, field.field_type_name, field.field_type_name_len)
                    emit_str(s, c" ")
                    emit_reg(s, agg)
                    emit_str(s, c", ptr ")
                    emit_reg(s, member_result.reg)
                    emit_str(s, c"\n")
                else
                    # Default: store i64
                    emit_str(s, c"  store i64 ")
                    emit_reg(s, val)
                    emit_str(s, c", ptr ")
                    emit_reg(s, member_result.reg)
                    emit_str(s, c"\n")
                return
            # Fall through to emit error if member access failed
            emit_ir_error(s, c"unhandled EXPR_MEMBER in assignment")
            return

        # Check for array field element assignment: s.field[idx] = value
        if target_expr.kind == EXPR_INDEX
            if target_expr.left.kind == EXPR_MEMBER
                var member_result: MemberPtrResult
                emit_member_ptr(s, target_expr.left, @member_result)
                if member_result.success == 1
                    let field: *StructField = member_result.field
                    if field.field_type == TYPE_ARRAY
                        # Array field in struct - GEP to element, then store
                        let idx: i32 = emit_expr(s, target_expr.right)
                        let val: i32 = emit_expr_into_slot(s, stmt.assign_value, field.array_elem_type, field.array_elem_type_name, field.array_elem_type_name_len)   # AGAST #2454
                        emit_field_array_elem_store(s, member_result.reg, field, idx, val, stmt.assign_value)
                        return
                    # AGAST #1596: `x.f[i] = v` with `f: *T` / `**T` —
                    # store THROUGH the pointer held in the field.
                    if emit_ptr_field_index_store(s, member_result.reg, field, target_expr.right, stmt.assign_value) == 1
                        return
                # AGAST #1439: `x.f[i] = v` whose member did not resolve, or
                # whose field is neither an inline array nor a pointer with
                # an addressable pointee, must not fall through to the
                # generic deref store below: that path evaluates `x.f[i]`
                # as a VALUE and stores through it as an address (segfault
                # or a wild write).  Refuse rather than miscompile.
                emit_ir_error(s, c"unhandled indexed EXPR_MEMBER in assignment")
                return

        # Deref assignment: *(expr) = value.  As of AGAST #1304
        # stmt_assign_deref wraps the target in EXPR_UNARY/OP_DEREF, so
        # `target_expr` is that unary node and its `.operand` is the pointer
        # expression (e.g. `p` for `*p = 0`).  The wrapper matters: without
        # it a `*s.field = v` target arrived here as a bare EXPR_MEMBER and
        # was swallowed by the struct-field-assignment branch above, storing
        # into the pointer field instead of through it.  The EXPR_IDENT /
        # bare-expression arms below remain for stmt_assign_expr targets.
        # AGAST #2287: `*p = a` for `p: *[N]T` copies the whole array.  ritz1
        # knows N only for a local or param `p`, so any other target fails
        # closed: there is no length to check the value against.
        if target_expr.kind == EXPR_UNARY and target_expr.op == OP_DEREF
            if deref_value_refused(s, target_expr) == 1   # AGAST #2885: `*v = x`, v a value
                return
            # AGAST #2972: `*h = v` on an integer or `bool` borrow `h:& T` is
            # `h = v`, as ritz0 stores it: `h` is bound as the caller's T
            # (bind_scalar_borrow_param), so `*h` names it, not an address.
            # This stored through the referent's value as an i64.
            if lent_scalar_ident(s, target_expr.operand) != null
                let saved_name: *u8 = stmt.assign_target
                let saved_len: i32 = stmt.assign_target_len
                stmt.assign_target = target_expr.operand.ident_ptr
                stmt.assign_target_len = target_expr.operand.ident_len
                emit_assign(s, stmt)
                stmt.assign_target = saved_name
                stmt.assign_target_len = saved_len
                return
            # AGAST #2290: ritz0 reads `*a` of `a:& [N]T` but won't store through
            # it.  `a = v` is the spelling for that.
            if lent_array_ident(s, target_expr.operand) != null
                emit_nd_error(s, target_expr.span.line, target_expr.span.col, c"cannot store through `*a` of an `a:& [N]T` param (assign to `a`, it is the array)")
                return
            let arr_dst: *LocalVar = array_ptr_local(s, target_expr.operand)
            if arr_dst != null
                var dst_en_len: i32 = 0
                let dst_en: *u8 = array_ptr_elem_name(arr_dst, @dst_en_len)   # #2548
                emit_array_local_whole_assign(s, emit_load_ptr(s, arr_dst.reg), arr_dst.pointee_array_size, arr_dst.pointee_array_elem_type, dst_en, dst_en_len, stmt.assign_value)
                return
            if stmt.assign_value.kind == EXPR_ARRAY_LIT or stmt.assign_value.kind == EXPR_ARRAY_FILL
                emit_ir_error(s, c"whole-array store through this pointer is not supported by ritz1 (only a local or param `p: *[N]T`)")
                return
        # Determine the store type. For `*ptr = value` we want the POINTEE
        # type of `ptr` (the destination slot's type), not the value's type.
        # Otherwise storing an i64 RHS into an i32 slot writes 4 extra bytes.
        var value_type: i32 = TYPE_I64
        var struct_name: *u8 = null
        var struct_name_len: i32 = 0

        # Prefer the destination's pointee type when available
        if target_expr.kind == EXPR_IDENT
            let dst_loc: *LocalVar = find_local_struct_name(s, target_expr.ident_ptr, target_expr.ident_len)
            if dst_loc != null and dst_loc.pointee_type != TYPE_I64
                value_type = dst_loc.pointee_type
                if dst_loc.pointee_type == TYPE_STRUCT
                    struct_name = dst_loc.type_name
                    struct_name_len = dst_loc.type_name_len
        else if target_expr.kind == EXPR_UNARY and target_expr.op == OP_DEREF
            # AGAST #1304: this is now the ONLY shape stmt_assign_deref
            # produces.  Resolve the destination slot's width so `*p = v`
            # stores exactly as wide as `*p` reads — covering locals,
            # globals, `*(base + i)` and `*s.field` uniformly.  The old code
            # only understood a bare ident operand, so `*ring.sq_tail = ...`
            # (a *i32 field) fell back to `store i64` and scribbled 4 bytes
            # past the slot.  get_deref_store_type reports TYPE_VOID rather
            # than guessing when it cannot tell, so an unresolved pointee
            # still defers to the RHS's own type below.
            #
            # One exception: the destination width is used to TRUNCATE an
            # i64 RHS register.  A monomorph-substituted value is already
            # native-width — in `vec_push<u16>`, `*(v.data + v.len) = item`
            # loads `item: T` as `i16`, so `trunc i64 %item to i16` is
            # invalid IR.  Such a value's local carries var_type TYPE_STRUCT
            # with a primitive type_name ("u16"); leave value_type alone and
            # let the TYPE_STRUCT arm below store it at its own width via
            # emit_llvm_type_struct.
            var rhs_is_named_type: i32 = 0
            if stmt.assign_value.kind == EXPR_IDENT
                let rhs_loc: *LocalVar = find_local_struct_name(s, stmt.assign_value.ident_ptr, stmt.assign_value.ident_len)
                if rhs_loc != null and rhs_loc.var_type == TYPE_STRUCT
                    rhs_is_named_type = 1
            let dst_type: i32 = get_deref_store_type(s, target_expr.operand)
            if dst_type != TYPE_VOID and dst_type != TYPE_I64 and rhs_is_named_type == 0
                value_type = dst_type
            # get_deref_store_type reports TYPE_STRUCT but not which struct,
            # so recover the name from the operand for the aggregate store.
            # AGAST #1505: resolve it exactly as the `*p` load does, so
            # `*(h.items + j) = *other` stores the %S the RHS deref loaded
            # (pointer arithmetic, let-local `*S`, struct-pointer fields).
            var dst_sname: *u8 = null
            var dst_sname_len: i32 = 0
            deref_pointee_struct_name(s, target_expr.operand, @dst_sname, @dst_sname_len)
            if dst_sname_len > 0
                value_type = TYPE_STRUCT
                struct_name = dst_sname
                struct_name_len = dst_sname_len
            # Bare-ident fallback: a monomorphised `*T` param can record
            # pointee TYPE_STRUCT with a primitive name ("u16") that
            # find_struct rejects; emit_llvm_type_struct maps it to i16.
            else if target_expr.operand.kind == EXPR_IDENT
                let dst_loc2: *LocalVar = find_local_struct_name(s, target_expr.operand.ident_ptr, target_expr.operand.ident_len)
                if dst_loc2 != null and dst_loc2.pointee_type == TYPE_STRUCT
                    value_type = TYPE_STRUCT
                    struct_name = dst_loc2.type_name
                    struct_name_len = dst_loc2.type_name_len

        # Fall back to value's type if destination pointee was unknown (TYPE_I64 default)
        if value_type == TYPE_I64
            # Check if value is an identifier - look up its type
            if stmt.assign_value.kind == EXPR_IDENT
                let local: *LocalVar = find_local_struct_name(s, stmt.assign_value.ident_ptr, stmt.assign_value.ident_len)
                if local != null
                    value_type = local.var_type
                    if local.var_type == TYPE_STRUCT
                        struct_name = local.type_name
                        struct_name_len = local.type_name_len
            # Check if value is a function call - look up the function's return type
            else if stmt.assign_value.kind == EXPR_CALL
                let fn_def: *FnDef = find_fn(s, stmt.assign_value.func_name, stmt.assign_value.func_name_len)
                if fn_def != null
                    if fn_def.return_type == TYPE_STRUCT
                        value_type = TYPE_STRUCT
                        struct_name = fn_def.return_type_name
                        struct_name_len = fn_def.return_type_name_len
            # Check if value is a struct literal
            else if stmt.assign_value.kind == EXPR_STRUCT_LIT
                value_type = TYPE_STRUCT
                struct_name = stmt.assign_value.ident_ptr
                struct_name_len = stmt.assign_value.ident_len

        # AGAST #2142: `*p = Some(..)` builds the pointee's enum.  Only when
        # the destination struct is known; an unresolved one keeps the
        # plain lowering (and its return-type fallback).
        var val: i32 = 0
        if value_type == TYPE_STRUCT and struct_name_len > 0
            val = emit_expr_into_slot(s, stmt.assign_value, value_type, struct_name, struct_name_len)
        else
            val = emit_expr(s, stmt.assign_value)
        # For `*ptr = value`, the store address IS the pointer — NOT the
        # dereferenced value. `target_expr` here IS the pointer expression
        # (parser strips the leading `*`), so emit_expr produces the pointer
        # value directly. Legacy callers wrapping with EXPR_UNARY still work
        # via the else branch below.
        var addr: i32 = 0
        # Track whether `addr` is already ptr-typed (no inttoptr needed).
        # TYPE_MUT_REF locals load as `ptr` (emit_llvm_type maps it to "ptr"),
        # while TYPE_PTR/TYPE_REF still load as i64. Without this guard,
        # `*out = v` for `out: @&i64` emits `inttoptr i64 %p to ptr` where
        # %p is already `ptr` — LLVM rejects (AGAST #173).
        var addr_is_ptr: i32 = 0
        if target_expr.kind == EXPR_IDENT
            let opd_loc: *LocalVar = find_local_struct_name(s, target_expr.ident_ptr, target_expr.ident_len)
            if opd_loc != null and opd_loc.var_type == TYPE_MUT_REF
                addr_is_ptr = 1
            addr = emit_expr(s, target_expr)
        else if target_expr.kind == EXPR_UNARY and target_expr.op == OP_DEREF
            if target_expr.operand.kind == EXPR_IDENT
                let opd_loc2: *LocalVar = find_local_struct_name(s, target_expr.operand.ident_ptr, target_expr.operand.ident_len)
                if opd_loc2 != null and opd_loc2.var_type == TYPE_MUT_REF
                    addr_is_ptr = 1
            # `*@&x = v`: `@&` is a `ptr` where `@` is an i64 (AGAST #2338).
            if target_expr.operand.kind == EXPR_UNARY and target_expr.operand.op == OP_ADDR_MUT
                addr_is_ptr = 1
            addr = emit_expr(s, target_expr.operand)
        else
            addr = emit_expr(s, target_expr)
        # Convert i64 address to ptr (skip when source is already ptr)
        var ptr: i32 = 0
        if addr_is_ptr == 1
            ptr = addr
        else
            ptr = next_reg(s)
            emit_str(s, c"  ")
            emit_reg(s, ptr)
            emit_str(s, c" = inttoptr i64 ")
            emit_reg(s, addr)
            emit_str(s, c" to ptr\n")

        # Store based on value type
        if value_type == TYPE_STRUCT and struct_name_len > 0
            # Struct store - emit: store %StructName %val, ptr %ptr
            # Post-monomorph primitive-name guard (vec_push_u16_method
            # parity): when the struct name is actually a primitive from
            # generic substitution, route through emit_llvm_type_struct
            # so we emit `store i16 %val` instead of `store %u16 %val`.
            emit_str(s, c"  store ")
            emit_llvm_type_struct(s, TYPE_STRUCT, struct_name, struct_name_len)
            emit_str(s, c" ")
            emit_reg(s, val)
            emit_str(s, c", ptr ")
            emit_reg(s, ptr)
            emit_str(s, c"\n")
        else if value_type == TYPE_F32 or value_type == TYPE_F64
            # AGAST #2022: `*p = v` through a *f32 / *f64 stores `float` /
            # `double` (an f64 value into an f32 slot is fptrunc'd), as
            # `p[i] = v` does (#1973).  It fell to `store i64 %float`.
            # AGAST #2062: an integer value (`*p = 3`) is sitofp'd by
            # emit_field_elem_narrow (#2065).
            let fval: i32 = emit_field_elem_narrow(s, val, value_type, stmt.assign_value)
            emit_str(s, c"  store ")
            emit_str(s, local_array_elem_llvm(value_type))
            emit_str(s, c" ")
            emit_reg(s, fval)
            emit_str(s, c", ptr ")
            emit_reg(s, ptr)
            emit_str(s, c"\n")
        else if value_type == TYPE_BOOL
            # AGAST #2053: a `*bool` pointee is an `i1` (ritz0's layout, a
            # bool struct field).  The i64 default overwrote the 7 bytes
            # after it -- the neighbouring fields.
            let bval: i32 = emit_field_elem_narrow(s, val, TYPE_BOOL, stmt.assign_value)
            emit_str(s, c"  store i1 ")
            emit_reg(s, bval)
            emit_str(s, c", ptr ")
            emit_reg(s, ptr)
            emit_str(s, c"\n")
        else if value_type == TYPE_I32 or value_type == TYPE_U32
            # i32 store
            let trunc: i32 = next_reg(s)
            emit_str(s, c"  ")
            emit_reg(s, trunc)
            emit_str(s, c" = trunc i64 ")
            emit_reg(s, val)
            emit_str(s, c" to i32\n")
            emit_str(s, c"  store i32 ")
            emit_reg(s, trunc)
            emit_str(s, c", ptr ")
            emit_reg(s, ptr)
            emit_str(s, c"\n")
        else if value_type == TYPE_U16 or value_type == TYPE_I16
            # i16 store via deref — trunc i64 → i16
            let trunc: i32 = next_reg(s)
            emit_str(s, c"  ")
            emit_reg(s, trunc)
            emit_str(s, c" = trunc i64 ")
            emit_reg(s, val)
            emit_str(s, c" to i16\n")
            emit_str(s, c"  store i16 ")
            emit_reg(s, trunc)
            emit_str(s, c", ptr ")
            emit_reg(s, ptr)
            emit_str(s, c"\n")
        else if value_type == TYPE_U8 or value_type == TYPE_I8
            # Byte store
            let trunc: i32 = next_reg(s)
            emit_str(s, c"  ")
            emit_reg(s, trunc)
            emit_str(s, c" = trunc i64 ")
            emit_reg(s, val)
            emit_str(s, c" to i8\n")
            emit_str(s, c"  store i8 ")
            emit_reg(s, trunc)
            emit_str(s, c", ptr ")
            emit_reg(s, ptr)
            emit_str(s, c"\n")
        else if value_type == TYPE_PTR or value_type == TYPE_PTR_PTR
            # Pointer store.  AGAST #2308: `*p = @&d` is a `ptr` already.
            let ptr_val: i32 = i64_value_to_ptr(s, stmt.assign_value, val)
            emit_str(s, c"  store ptr ")
            emit_reg(s, ptr_val)
            emit_str(s, c", ptr ")
            emit_reg(s, ptr)
            emit_str(s, c"\n")
        else
            # Default: store i64 (for i64, u64, and unknown types)
            emit_str(s, c"  store i64 ")
            emit_reg(s, val)
            emit_str(s, c", ptr ")
            emit_reg(s, ptr)
            emit_str(s, c"\n")
        return

    # AGAST #1509: `g = v` onto a whole multi-dimensional array stored one
    # i64 into its first 8 bytes.  Not lowered: fail closed.
    if nd_array_name_shape(s, stmt.assign_target, stmt.assign_target_len) != null
        emit_nd_error(s, stmt.span.line, stmt.span.col, c"assigning a whole multi-dimensional array is not supported in ritz1 (assign each element)")
        return
    let loc: i32 = find_local(s, stmt.assign_target, stmt.assign_target_len)
    if loc >= 0
        let var_type: i32 = find_local_type(s, stmt.assign_target, stmt.assign_target_len)
        # AGAST #2346: `r = v` on a `r:& T` param writes the referent.
        if emit_lent_whole_store(s, stmt, loc) == 1
            return
        # Special handling for struct-typed assignments
        if var_type == TYPE_STRUCT
            # For struct literal assignment, use alloca + field init
            if stmt.assign_value.kind == EXPR_STRUCT_LIT
                emit_struct_lit_to_alloca(s, stmt.assign_value, loc)
                return
            # AGAST #167: thread SIMD ctx so the rhs intrinsic dispatch
            # (e.g. `wk = simd_loadu(@k[0])`) knows which `<N x iM>` to load.
            let _saved_simd_a: *u8 = s.ctx_simd_name
            let _saved_simd_a_len: i32 = s.ctx_simd_name_len
            let local: *LocalVar = find_local_struct_name(s, stmt.assign_target, stmt.assign_target_len)
            if local != null and is_simd_vector_type_name(local.type_name, local.type_name_len) == 1
                s.ctx_simd_name = local.type_name
                s.ctx_simd_name_len = local.type_name_len
            # For function call or other expression returning struct.
            # AGAST #2142: `held = Some(..)` builds the local's enum.
            var val: i32 = 0
            if local != null
                val = emit_expr_into_slot(s, stmt.assign_value, var_type, local.type_name, local.type_name_len)
            else
                val = emit_expr(s, stmt.assign_value)
            s.ctx_simd_name = _saved_simd_a
            s.ctx_simd_name_len = _saved_simd_a_len
            if local != null
                # AGAST #168: Span$u8 ↔ StrView layout coercion at assign sites
                # (e.g. `path = "..."` where path: StrView).  See emit_var_decl
                # for the same pattern.
                var stored_reg: i32 = val
                var src_name: *u8 = null
                var src_len: i32 = 0
                resolve_expr_struct_name(s, stmt.assign_value, @src_name, @src_len)
                if is_layout_equiv_pair(src_name, src_len, local.type_name, local.type_name_len) == 1
                    stored_reg = rebuild_layout_equiv(s, val, src_name, src_len, local.type_name, local.type_name_len)
                # AGAST #167: emit_llvm_type_struct routes `v4i32`/`v16i8`
                # etc. to `<N x iM>` so the store width matches the
                # inline-SIMD call's vector result; primitive type names
                # ("i32", "f32", …) lower to their LLVM scalar type for
                # the post-monomorph TYPE_STRUCT-with-primitive-name shape.
                emit_str(s, c"  store ")
                emit_llvm_type_struct(s, var_type, local.type_name, local.type_name_len)
                emit_str(s, c" ")
                emit_reg(s, stored_reg)
                emit_str(s, c", ptr ")
                emit_reg(s, loc)
                emit_str(s, c"\n")
            else
                emit_str(s, c"  store i64 ")
                emit_reg(s, val)
                emit_str(s, c", ptr ")
                emit_reg(s, loc)
                emit_str(s, c"\n")
            return
        # AGAST #2035 / #2169: `a = x.f` / `= [..]` / `= c` copy the whole
        # array into local `a`.
        if var_type == TYPE_ARRAY
            let aloc: *LocalVar = find_local_struct_name(s, stmt.assign_target, stmt.assign_target_len)
            if aloc != null and aloc.array_shape == null
                emit_array_local_whole_assign(s, loc, aloc.array_size, aloc.array_elem_type, aloc.type_name, aloc.type_name_len, stmt.assign_value)
                return
        # AGAST #1652: `p = s` (`s: @&S`) into a `*S` local.  `let` only;
        # see the #1755 note in emit_fn.
        # AGAST #2142: a non-enum local is no enum context for a ctor RHS.
        let assign_raw: i32 = emit_expr_into_slot(s, stmt.assign_value, var_type, null, 0)
        let val: i32 = ptr_slot_value(s, var_type, stmt.assign_value, assign_raw)
        if var_type == TYPE_I32 or var_type == TYPE_U32
            let trunc: i32 = next_reg(s)
            emit_str(s, c"  ")
            emit_reg(s, trunc)
            emit_str(s, c" = trunc i64 ")
            emit_reg(s, val)
            emit_str(s, c" to i32\n")
            emit_str(s, c"  store i32 ")
            emit_reg(s, trunc)
            emit_str(s, c", ptr ")
            emit_reg(s, loc)
            emit_str(s, c"\n")
        else if var_type == TYPE_PTR or var_type == TYPE_PTR_PTR or var_type == TYPE_REF or var_type == TYPE_MUT_REF
            # Store i64 directly (pointers are stored as i64).  AGAST #2337:
            # into a reference, `p = @&c` and `p = m` are a `ptr` already;
            # ptr_slot_value has done a `*T` local.
            var ival: i32 = val
            if var_type == TYPE_REF or var_type == TYPE_MUT_REF
                ival = ptr_value_to_i64(s, stmt.assign_value, val)
            emit_str(s, c"  store i64 ")
            emit_reg(s, ival)
            emit_str(s, c", ptr ")
            emit_reg(s, loc)
            emit_str(s, c"\n")
        else if var_type == TYPE_U16 or var_type == TYPE_I16
            # Truncate i64 (unified value model) back to i16 for the slot.
            let trunc: i32 = next_reg(s)
            emit_str(s, c"  ")
            emit_reg(s, trunc)
            emit_str(s, c" = trunc i64 ")
            emit_reg(s, val)
            emit_str(s, c" to i16\n")
            emit_str(s, c"  store i16 ")
            emit_reg(s, trunc)
            emit_str(s, c", ptr ")
            emit_reg(s, loc)
            emit_str(s, c"\n")
        else if var_type == TYPE_U8 or var_type == TYPE_I8
            # Truncate i64 to i8 for byte types
            let trunc: i32 = next_reg(s)
            emit_str(s, c"  ")
            emit_reg(s, trunc)
            emit_str(s, c" = trunc i64 ")
            emit_reg(s, val)
            emit_str(s, c" to i8\n")
            emit_str(s, c"  store i8 ")
            emit_reg(s, trunc)
            emit_str(s, c", ptr ")
            emit_reg(s, loc)
            emit_str(s, c"\n")
        else if var_type == TYPE_BOOL
            # AGAST #2994: only a `b:& bool` param is a TYPE_BOOL local
            # (bind_scalar_borrow_param): one byte, whatever place it borrows.
            let btrunc: i32 = next_reg(s)
            emit_str(s, c"  ")
            emit_reg(s, btrunc)
            emit_str(s, c" = trunc i64 ")
            emit_reg(s, val)
            emit_str(s, c" to i1\n  store i1 ")
            emit_reg(s, btrunc)
            emit_str(s, c", ptr ")
            emit_reg(s, loc)
            emit_str(s, c"\n")
        else
            # AGAST #2065: an f32 / f64 local narrows / converts its value
            # (`x = 3` sitofp's, an f64 into an f32 fptrunc's) as every
            # other float slot does; it stored the raw i64 register.
            var lval: i32 = val
            if var_type == TYPE_F32 or var_type == TYPE_F64
                lval = emit_field_elem_narrow(s, val, var_type, stmt.assign_value)
            emit_str(s, c"  store ")
            emit_llvm_type(s, var_type)
            emit_str(s, c" ")
            emit_reg(s, lval)
            emit_str(s, c", ptr ")
            emit_reg(s, loc)
            emit_str(s, c"\n")
    else
        # Check for global variable
        let glob: *GlobalVarDef = find_global(s, stmt.assign_target, stmt.assign_target_len)
        if glob != null
            # AGAST #2287: `G = a` copies the whole array into the global.
            if glob.var_type == TYPE_ARRAY
                emit_array_local_whole_assign(s, emit_global_array_ptr(s, glob), glob.array_size, glob.array_elem_type, glob.array_elem_type_name, glob.array_elem_type_name_len, stmt.assign_value)
                return
            # AGAST #181: struct-typed globals (`var g: Store`) need
            # `store %Store %val, ptr @g` not `store i64 %val` — the SSA
            # value here is a `%Store` aggregate, not an i64.  Route through
            # emit_llvm_type_struct so primitive-aliased struct names
            # (`u16`, `f32`, etc.) and SIMD vector types lower correctly.
            if glob.var_type == TYPE_STRUCT
                # AGAST #2454: `g = Some(5)` builds the global's enum.
                let val: i32 = emit_expr_into_slot(s, stmt.assign_value, TYPE_STRUCT, glob.type_name, glob.type_name_len)
                emit_str(s, c"  store ")
                emit_llvm_type_struct(s, TYPE_STRUCT, glob.type_name, glob.type_name_len)
                emit_str(s, c" ")
                emit_reg(s, val)
                emit_str(s, c", ptr @")
                emit_name(s, glob.name, glob.name_len)
                emit_str(s, c"\n")
                return
            let val: i32 = emit_expr(s, stmt.assign_value)
            if glob.var_type == TYPE_I32 or glob.var_type == TYPE_U32
                let trunc: i32 = next_reg(s)
                emit_str(s, c"  ")
                emit_reg(s, trunc)
                emit_str(s, c" = trunc i64 ")
                emit_reg(s, val)
                emit_str(s, c" to i32\n")
                emit_str(s, c"  store i32 ")
                emit_reg(s, trunc)
                emit_str(s, c", ptr @")
                emit_name(s, glob.name, glob.name_len)
                emit_str(s, c"\n")
            else if glob.var_type == TYPE_I16 or glob.var_type == TYPE_U16
                # i16 store via global — trunc i64 → i16 (unified value model).
                let trunc: i32 = next_reg(s)
                emit_str(s, c"  ")
                emit_reg(s, trunc)
                emit_str(s, c" = trunc i64 ")
                emit_reg(s, val)
                emit_str(s, c" to i16\n")
                emit_str(s, c"  store i16 ")
                emit_reg(s, trunc)
                emit_str(s, c", ptr @")
                emit_name(s, glob.name, glob.name_len)
                emit_str(s, c"\n")
            else if glob.var_type == TYPE_I8 or glob.var_type == TYPE_U8
                # i8 store via global — trunc i64 → i8.
                let trunc: i32 = next_reg(s)
                emit_str(s, c"  ")
                emit_reg(s, trunc)
                emit_str(s, c" = trunc i64 ")
                emit_reg(s, val)
                emit_str(s, c" to i8\n")
                emit_str(s, c"  store i8 ")
                emit_reg(s, trunc)
                emit_str(s, c", ptr @")
                emit_name(s, glob.name, glob.name_len)
                emit_str(s, c"\n")
            else if glob.var_type == TYPE_BOOL
                # AGAST #3001: a bool global is one i1 byte, as on ritz0; the
                # value is the i64 every bool lives in (#1646).
                let btrunc: i32 = next_reg(s)
                emit_str(s, c"  ")
                emit_reg(s, btrunc)
                emit_str(s, c" = trunc i64 ")
                emit_reg(s, val)
                emit_str(s, c" to i1\n")
                emit_str(s, c"  store i1 ")
                emit_reg(s, btrunc)
                emit_str(s, c", ptr @")
                emit_name(s, glob.name, glob.name_len)
                emit_str(s, c"\n")
            else
                # AGAST #2065: f32 / f64 global, as the local arm above.
                var gval: i32 = val
                if glob.var_type == TYPE_F32 or glob.var_type == TYPE_F64
                    gval = emit_field_elem_narrow(s, val, glob.var_type, stmt.assign_value)
                emit_str(s, c"  store ")
                emit_llvm_type(s, glob.var_type)
                emit_str(s, c" ")
                emit_reg(s, gval)
                emit_str(s, c", ptr @")
                emit_name(s, glob.name, glob.name_len)
                emit_str(s, c"\n")
        else
            emit_ir_error_begin(s, c"unknown variable '")
            emit_ir_error_end(s, stmt.assign_target, stmt.assign_target_len)

# AGAST #1946: when `e` is a match / if expression bound or returned at float
# type (`ty`, or a TYPE_STRUCT named "f32" / "f64"), tell it to merge at that
# type so its phi, every arm and the slot / `ret` agree.  emit_match and
# emit_if_expr consume the hint on entry.
fn set_match_float_hint(s: *EmitterState, e: *Expr, ty: i32, ty_name: *u8, ty_name_len: i32)
    s.match_float_hint = 0
    if e == null
        return
    if e.kind != EXPR_MATCH and e.kind != EXPR_IF
        return
    if ty == TYPE_F32 or ty == TYPE_F64
        s.match_float_hint = ty
    else if ty_name != null and ty_name_len == 3 and is_float_type(ty, ty_name, ty_name_len) == 1
        if *(ty_name + 1) == 51   # "f32"
            s.match_float_hint = TYPE_F32
        else
            s.match_float_hint = TYPE_F64

fn emit_return(s: *EmitterState, stmt: *Stmt, ret_type: i32)
    if stmt.return_value != null
        bool_check_slot(s, stmt.return_value, ret_type, s.ret_type_name, s.ret_type_name_len)
        literal_slot(s, stmt.return_value, ret_type, literal_ret_pointee(s.ret_type_name, s.ret_type_name_len))   # AGAST #2341
        if emit_lent_return(s, stmt.return_value, ret_type) == 1   # AGAST #2279
            return
        # Special handling for struct returns - need to load entire struct
        if ret_type == TYPE_STRUCT
            # Check if return value is a struct literal (e.g., return NFAFragment { start: s0, end: s0 })
            if stmt.return_value.kind == EXPR_STRUCT_LIT
                let alloca_reg: i32 = next_reg(s)
                emit_str(s, c"  ")
                emit_reg(s, alloca_reg)
                emit_str(s, c" = alloca %")
                emit_name(s, stmt.return_value.ident_ptr, stmt.return_value.ident_len)
                emit_str(s, c"\n")
                emit_struct_lit_to_alloca(s, stmt.return_value, alloca_reg)
                if s.ret_sret == 1
                    emit_sret_ret_from_ptr(s, alloca_reg)   # AGAST #1730
                    return
                let result: i32 = next_reg(s)
                emit_str(s, c"  ")
                emit_reg(s, result)
                emit_str(s, c" = load %")
                emit_name(s, stmt.return_value.ident_ptr, stmt.return_value.ident_len)
                emit_str(s, c", ptr ")
                emit_reg(s, alloca_reg)
                emit_str(s, c"\n")
                emit_str(s, c"  ret %")
                emit_name(s, stmt.return_value.ident_ptr, stmt.return_value.ident_len)
                emit_str(s, c" ")
                emit_reg(s, result)
                emit_str(s, c"\n")
                return
            # Check if return value is a local variable
            # Use emit_llvm_type_struct so tagged-enum types (Result$/Option$)
            # auto-route to `i64` instead of `%<name>` (task-99 cluster #3).
            if stmt.return_value.kind == EXPR_IDENT and struct_value_local(s, stmt.return_value) != null
                let loc: i32 = find_local(s, stmt.return_value.ident_ptr, stmt.return_value.ident_len)
                if loc >= 0 and s.ret_sret == 1
                    emit_sret_ret_from_ptr(s, loc)   # AGAST #1730
                    return
                if loc >= 0
                    # Load the entire struct from the local
                    let result: i32 = next_reg(s)
                    emit_str(s, c"  ")
                    emit_reg(s, result)
                    emit_str(s, c" = load ")
                    emit_llvm_type_struct(s, TYPE_STRUCT, s.ret_type_name, s.ret_type_name_len)
                    emit_str(s, c", ptr ")
                    emit_reg(s, loc)
                    emit_str(s, c"\n")
                    emit_str(s, c"  ret ")
                    emit_llvm_type_struct(s, TYPE_STRUCT, s.ret_type_name, s.ret_type_name_len)
                    emit_str(s, c" ")
                    emit_reg(s, result)
                    emit_str(s, c"\n")
                    return
            # AGAST #2330: `return p[i]`, a struct element of a pointer to an array,
            # is `return *(p# + i)`.
            var ret_val: *Expr = stmt.return_value
            var ret_th: ThroughIndex
            let ret_through: *LocalVar = index_through(s, ret_val)
            if ret_through != null and ret_through.array_view == 1
                index_through_fill(ret_val, through_spill(s, ret_through), @ret_th)
                ret_val = @ret_th.deref
            # Check if return value is a dereference (e.g., *ptr or *(ptr + offset))
            if ret_val.kind == EXPR_UNARY and ret_val.op == OP_DEREF
                # Calculate the pointer address, then load the struct from it
                let addr: i32 = emit_expr(s, ret_val.operand)
                let ptr: i32 = i64_value_to_ptr(s, ret_val.operand, addr)
                if s.ret_sret == 1
                    emit_sret_ret_from_ptr(s, ptr)   # AGAST #1730
                    return
                let result: i32 = next_reg(s)
                emit_str(s, c"  ")
                emit_reg(s, result)
                emit_str(s, c" = load ")
                emit_llvm_type_struct(s, TYPE_STRUCT, s.ret_type_name, s.ret_type_name_len)
                emit_str(s, c", ptr ")
                emit_reg(s, ptr)
                emit_str(s, c"\n")
                emit_str(s, c"  ret ")
                emit_llvm_type_struct(s, TYPE_STRUCT, s.ret_type_name, s.ret_type_name_len)
                emit_str(s, c" ")
                emit_reg(s, result)
                emit_str(s, c"\n")
                return
            # For other expressions, emit normally and return.  The value is a
            # copy into the return slot, so `return a[i]` on a `[N]S` is (#2996).
            let val: i32 = emit_struct_copy(s, stmt.return_value, TYPE_STRUCT)
            if s.ret_sret == 1
                emit_sret_ret_value(s, val)   # AGAST #1730
                return
            # AGAST #168: Span$u8 ↔ StrView layout coercion at return sites
            # (e.g. `return "..."` from a `-> StrView` fn).
            let ret_reg: i32 = coerce_struct_ret_value(s, stmt.return_value, val, s.ret_type_name, s.ret_type_name_len)
            emit_str(s, c"  ret ")
            emit_llvm_type_struct(s, TYPE_STRUCT, s.ret_type_name, s.ret_type_name_len)
            emit_str(s, c" ")
            emit_reg(s, ret_reg)
            emit_str(s, c"\n")
            return

        if struct_return_as_int_refused(s, stmt.return_value, ret_type) == 1   # AGAST #3008
            return
        set_match_float_hint(s, stmt.return_value, ret_type, s.ret_type_name, s.ret_type_name_len)
        let val: i32 = emit_expr(s, stmt.return_value)
        if ret_type == TYPE_I32 or ret_type == TYPE_U32
            let trunc: i32 = next_reg(s)
            emit_str(s, c"  ")
            emit_reg(s, trunc)
            emit_str(s, c" = trunc i64 ")
            emit_reg(s, val)
            emit_str(s, c" to i32\n")
            emit_str(s, c"  ret i32 ")
            emit_reg(s, trunc)
            emit_str(s, c"\n")
        else if ret_type == TYPE_U16 or ret_type == TYPE_I16
            # Truncate i64 to i16 for narrow return types (e.g. htons / ntohs).
            let trunc: i32 = next_reg(s)
            emit_str(s, c"  ")
            emit_reg(s, trunc)
            emit_str(s, c" = trunc i64 ")
            emit_reg(s, val)
            emit_str(s, c" to i16\n")
            emit_str(s, c"  ret i16 ")
            emit_reg(s, trunc)
            emit_str(s, c"\n")
        else if ret_type == TYPE_U8 or ret_type == TYPE_I8
            # Truncate i64 to i8 for byte return types
            let trunc: i32 = next_reg(s)
            emit_str(s, c"  ")
            emit_reg(s, trunc)
            emit_str(s, c" = trunc i64 ")
            emit_reg(s, val)
            emit_str(s, c" to i8\n")
            emit_str(s, c"  ret i8 ")
            emit_reg(s, trunc)
            emit_str(s, c"\n")
        else if ret_type == TYPE_PTR or ret_type == TYPE_PTR_PTR or ret_type == TYPE_REF
            # Pointers are represented as i64 internally, return as i64.
            # AGAST #1652: `return s` with `s: @&S` is a `ptr`.  #1754: so is
            # `-> @S`, which lowers to i64 too.
            let ret_ival: i32 = ptr_value_to_i64(s, stmt.return_value, val)
            emit_str(s, c"  ret i64 ")
            emit_reg(s, ret_ival)
            emit_str(s, c"\n")
        else if ret_type == TYPE_MUT_REF
            # AGAST #2391: `-> @&T` returns `ptr`.  An `@&T` local is one
            # already, but a `-> @&T` call result and `self: @&T` are i64 here,
            # so they get an inttoptr (as an `@&T` let's init does).
            let ret_pval: i32 = i64_value_to_ptr(s, stmt.return_value, val)
            emit_str(s, c"  ret ptr ")
            emit_reg(s, ret_pval)
            emit_str(s, c"\n")
        else if ret_type == TYPE_BOOL
            # Bool returns: emit_expr always produces i64 (icmp result is
            # zext-promoted to i64).  Truncate back to i1 for the return —
            # squeeze.bits.bits_at_end and friends declare `-> bool`.
            let bool_trunc: i32 = next_reg(s)
            emit_str(s, c"  ")
            emit_reg(s, bool_trunc)
            emit_str(s, c" = trunc i64 ")
            emit_reg(s, val)
            emit_str(s, c" to i1\n")
            emit_str(s, c"  ret i1 ")
            emit_reg(s, bool_trunc)
            emit_str(s, c"\n")
        else
            # AGAST #2074: `return 1.0` from an `-> f32` fn is fptrunc'd.
            let rval: i32 = float_ret_value(s, val, ret_type, stmt.return_value)
            emit_str(s, c"  ret ")
            emit_llvm_type(s, ret_type)
            emit_str(s, c" ")
            emit_reg(s, rval)
            emit_str(s, c"\n")
    else
        emit_str(s, c"  ret void\n")

# AGAST #2388: 1 for a struct the iterable form walks through its header: a
# Vec<T>, a Span<T> or a StrView.  ritz0 takes any struct opening with a pointer
# and an integer; these are the ones that mean it.
fn is_for_header_name(name: *u8, name_len: i32) -> i32
    if name == null
        return 0
    if name_len > 4 and memcmp(name, c"Vec$", 4) == 0
        return 1
    if name_len > 5 and memcmp(name, c"Span$", 5) == 0
        return 1
    name_eq(name, name_len, c"StrView", 7)

# find_struct, for a name that's a header.  Null for anything else, and for a
# header whose `data` and `len` aren't where the loop reads them.
fn for_header_struct(s: *EmitterState, name: *u8, name_len: i32) -> *StructDef
    if is_for_header_name(name, name_len) == 0
        return null
    let st: *StructDef = find_struct(s, name, name_len)
    if st == null or st.fields == null or st.fields.next == null
        return null
    let data: *StructField = st.fields
    if data.field_type != TYPE_PTR and data.field_type != TYPE_PTR_PTR
        return null
    if data.next.field_type != TYPE_I64
        return null
    st

# TYPE_U64 for `usize`, TYPE_I64 for `isize`, TYPE_VOID for any other name.
fn for_word_elem(name: *u8, name_len: i32) -> i32
    if name_eq(name, name_len, c"usize", 5) == 1
        return TYPE_U64
    if name_eq(name, name_len, c"isize", 5) == 1
        return TYPE_I64
    TYPE_VOID

# What a header's elements are, read off its `data` field as the monomorph left
# it: a struct T by name, a primitive T in array_elem_type, and `*T` as a `**`
# field.  1 if that names the element; a type this can't name is refused rather
# than walked at a guessed stride, which `Vec<S>` was at 8 bytes.
fn for_header_elem(s: *EmitterState, st: *StructDef, out: *ForElem) -> i32
    let data: *StructField = st.fields
    if data.field_type == TYPE_PTR
        if data.field_type_name_len > 0
            # AGAST #2411: `usize` / `isize` parse as a name; they're the
            # 64-bit integers they spell.
            let wide: i32 = for_word_elem(data.field_type_name, data.field_type_name_len)
            if wide != TYPE_VOID
                out.elem = wide
                return 1
            # AGAST #2411: a non-generic user enum is a `%C` the loop walks at
            # its layout (#1797), bound as a struct element is.
            if find_struct(s, data.field_type_name, data.field_type_name_len) == null and user_enum_index(data.field_type_name, data.field_type_name_len) < 0
                return 0
            out.elem = TYPE_STRUCT
            out.name = data.field_type_name
            out.name_len = data.field_type_name_len
            return 1
        if primitive_name_len(data.array_elem_type) == 0
            return 0
        out.elem = data.array_elem_type
        return 1
    # `Vec$ptr_Node` names Node, and `Vec$ptr_u8` nothing: its pointee is only
    # in the suffix.  `Vec$ptr_ptr_u8` names no struct there is, and is refused.
    out.elem = TYPE_PTR
    if data.field_type_name_len > 0
        if find_struct(s, data.field_type_name, data.field_type_name_len) == null
            return 0
        out.pointee = TYPE_STRUCT
        out.pointee_name = data.field_type_name
        out.pointee_name_len = data.field_type_name_len
        return 1
    var after: i32 = 0
    while after < st.name_len and *(st.name + after) != 36   # '$'
        after = after + 1
    after = after + 5   # `$ptr_`
    out.pointee = primitive_type_from_name(st.name + after, st.name_len - after)
    1

# The LLVM type of one element of a `for` iterable: `%S` for a struct element.
# emit_llvm_type spells that i64, which is neither its size nor its stride.
fn emit_for_elem_llvm(s: *EmitterState, elem: i32, name: *u8, name_len: i32)
    if elem == TYPE_STRUCT and name_len > 0
        emit_str(s, c"%")
        emit_name(s, name, name_len)
    else
        emit_llvm_type(s, elem)

# AGAST #2388: a slot for the header value `val`, which has no place of its own:
# a call's result, a literal or a const.  Nothing else can write to it.  The alloca
# is static, so hoist_entry_allocas takes it out of any enclosing loop.
fn emit_for_header_spill(s: *EmitterState, st: *StructDef, val: i32) -> i32
    let slot: i32 = next_reg(s)
    emit_str(s, c"  ")
    emit_reg(s, slot)
    emit_str(s, c" = alloca %")
    emit_name(s, st.name, st.name_len)
    emit_str(s, c"\n  store %")
    emit_name(s, st.name, st.name_len)
    emit_str(s, c" ")
    emit_reg(s, val)
    emit_str(s, c", ptr ")
    emit_reg(s, slot)
    emit_str(s, c"\n")
    slot

# The struct a call in iterable position returns by value.  `as_bytes` is only
# the builtin on a StrView: a user's method of that name is whatever it says.
fn for_call_struct_name(s: *EmitterState, e: *Expr, out_name: **u8, out_len: *i32)
    call_result_struct_name(s, e, out_name, out_len)
    if *out_len > 0 or e.kind != EXPR_METHOD or e.left == null or e.left.kind != EXPR_IDENT
        return
    if name_eq(e.ident_ptr, e.ident_len, c"as_bytes", 8) == 0
        return
    let loc: *LocalVar = find_local_struct_name(s, e.left.ident_ptr, e.left.ident_len)
    if loc != null and name_eq(loc.type_name, loc.type_name_len, c"StrView", 7) == 1
        *out_name = c"Span$u8"
        *out_len = 7

# A bare name holding a header, or a reference to one.  A local hides a global of
# its name.
fn emit_for_ident_header(s: *EmitterState, e: *Expr, out: **StructDef) -> i32
    let loc: *LocalVar = find_local_struct_name(s, e.ident_ptr, e.ident_len)
    if loc != null
        let st: *StructDef = for_header_struct(s, loc.type_name, loc.type_name_len)
        if st == null
            return 0
        if loc.var_type == TYPE_STRUCT
            *out = st
            return loc.reg
        if local_struct_levels(loc) == 1 and loc.pointee_type == TYPE_STRUCT
            *out = st
            return emit_load_ptr(s, loc.reg)
        return 0
    let glob: *GlobalVarDef = find_global(s, e.ident_ptr, e.ident_len)
    if glob != null
        if glob.var_type == TYPE_STRUCT
            let gst: *StructDef = for_header_struct(s, glob.type_name, glob.type_name_len)
            if gst != null
                *out = gst
                return emit_lvalue_ptr(s, e)
        else if glob.var_type == TYPE_PTR and glob.pointee_type == TYPE_STRUCT
            let pst: *StructDef = for_header_struct(s, glob.pointee_type_name, glob.pointee_type_name_len)
            if pst != null
                var unused: *StructDef = null
                var levels: i32 = 0
                *out = pst
                return emit_deref_operand_ptr(s, e, @unused, @levels)
        return 0
    let ce: *ConstEntry = find_const_entry(s, e.ident_ptr, e.ident_len)
    if ce != null and ce.const_type == TYPE_STRUCT
        let cst: *StructDef = for_header_struct(s, ce.type_name, ce.type_name_len)
        if cst != null
            *out = cst
            return emit_for_header_spill(s, cst, emit_expr(s, e))
    0

# `@v` / `@&v` / `@h.v`.  `@v` of a pointer or a reference isn't here: ritz0
# refuses `v: *Vec<T>` and `v: @Vec<T>`.  `mr` is `h.v`, which emit_for_iterable
# has already reached (AGAST #2533): reaching it again would emit it twice.
fn emit_for_addr_header(s: *EmitterState, e: *Expr, mr: *MemberPtrResult, out: **StructDef) -> i32
    let op: *Expr = e.operand
    if op == null
        return 0
    if op.kind == EXPR_IDENT
        # AGAST #2314: `v:& Vec<T>`'s slot holds the borrow's pointer, and `@v` is
        # that pointer (#2286), not the slot's address.
        let lent: *LocalVar = lent_struct_local(s, op)
        if lent != null
            let lst: *StructDef = for_header_struct(s, lent.type_name, lent.type_name_len)
            if lst == null
                return 0
            *out = lst
            return emit_load_ptr(s, lent.reg)
        let loc: *LocalVar = find_local_struct_name(s, op.ident_ptr, op.ident_len)
        if loc != null
            if loc.var_type != TYPE_STRUCT
                return 0
            let st: *StructDef = for_header_struct(s, loc.type_name, loc.type_name_len)
            if st != null
                *out = st
                return loc.reg
            return 0
        let glob: *GlobalVarDef = find_global(s, op.ident_ptr, op.ident_len)
        if glob != null and glob.var_type == TYPE_STRUCT
            let gst: *StructDef = for_header_struct(s, glob.type_name, glob.type_name_len)
            if gst != null
                *out = gst
                return emit_lvalue_ptr(s, op)
        return 0
    if op.kind == EXPR_MEMBER
        if mr.success == 1 and mr.field.field_type == TYPE_STRUCT
            let fst: *StructDef = for_header_struct(s, mr.field.field_type_name, mr.field.field_type_name_len)
            if fst != null
                *out = fst
                return mr.reg
    if op.kind == EXPR_INDEX
        return emit_for_element_header(s, op, out)   # AGAST #2410: `@vs[i]` is `vs[i]`
    0

# AGAST #2410: `*p`, with `p` a pointer to a header: the header it points at.
fn emit_for_deref_header(s: *EmitterState, op: *Expr, out: **StructDef) -> i32
    var dst: *StructDef = null
    var levels: i32 = 0
    let reg: i32 = emit_deref_operand_ptr(s, op, @dst, @levels)
    if dst == null or levels != 1
        return 0
    let st: *StructDef = for_header_struct(s, dst.name, dst.name_len)
    if st == null
        return 0
    *out = st
    reg

# AGAST #2426: `vv[i]`, a header that is an element of the Vec `vv` names, where
# it is in `vv`'s buffer: `&data[i]`, with `vv` and `i` evaluated once, before
# the loop.  `vv` is any place emit_for_header walks in place; a call's result
# isn't one.  0, emitting nothing, for anything else.
fn emit_for_vec_elem_header(s: *EmitterState, e: *Expr, out: **StructDef) -> i32
    let base: *Expr = e.left
    if base == null or e.right == null or e.right.kind == EXPR_RANGE
        return 0
    if base.kind == EXPR_CALL or base.kind == EXPR_METHOD or base.kind == EXPR_ARRAY_LIT or base.kind == EXPR_STRING_LIT
        return 0
    var b: RefTy
    var el: RefTy
    if ref_ty_of(s, base, @b) == 0 or ref_vec_elem(s, @b, @el) == 0 or el.kind != TYPE_STRUCT
        return 0
    let est: *StructDef = for_header_struct(s, el.name, el.name_len)
    if est == null
        return 0
    var mr: MemberPtrResult
    mr.reg = 0
    mr.field = null
    mr.success = 0
    if base.kind == EXPR_MEMBER
        emit_member_ptr(s, base, @mr)
    var vst: *StructDef = null
    let hdr: i32 = emit_for_header(s, base, @mr, @vst)
    if vst == null
        return 0
    let di: i32 = find_field_index(vst, c"data", 4)
    if di < 0
        return 0
    let dpp: i32 = next_reg(s)
    emit_str(s, c"  ")
    emit_reg(s, dpp)
    emit_str(s, c" = getelementptr %")
    emit_name(s, vst.name, vst.name_len)
    emit_str(s, c", ptr ")
    emit_reg(s, hdr)
    emit_str(s, c", i32 0, i32 ")
    emit_int(s, di as i64)
    emit_str(s, c"\n")
    let dp: i32 = emit_load_ptr(s, dpp)
    let idx: i32 = emit_expr(s, e.right)
    let ep: i32 = next_reg(s)
    emit_str(s, c"  ")
    emit_reg(s, ep)
    emit_str(s, c" = getelementptr %")
    emit_name(s, est.name, est.name_len)
    emit_str(s, c", ptr ")
    emit_reg(s, dp)
    emit_str(s, c", i64 ")
    emit_reg(s, idx)
    emit_str(s, c"\n")
    *out = est
    ep

# AGAST #2410: `vs[i]`, an element that is a header, at its own address.  The
# index is evaluated once, before the loop.
fn emit_for_element_header(s: *EmitterState, e: *Expr, out: **StructDef) -> i32
    var t: RefTy
    if ref_ty_of(s, e, @t) == 0
        return emit_for_vec_elem_header(s, e, out)   # AGAST #2426
    if t.kind != TYPE_STRUCT
        return 0
    let st: *StructDef = for_header_struct(s, t.name, t.name_len)
    if st == null
        return 0
    let reg: i32 = emit_lvalue_ptr(s, e)
    if reg < 0
        return 0
    *out = st
    reg

# AGAST #2388: a pointer to the header `iter` names, with its struct in *out, or
# 0 with *out null.  The loop walks that header in place, reading `len` and `data`
# on every pass, because it sees what the body writes (#2387).  That's also what
# makes a `push` that moves the buffer safe: nothing from before it is kept, and
# the binding is a copy of its element, taken before the body runs.
#
# `iter` is evaluated once.  `mr` is its field when it's an EXPR_MEMBER, or `@` /
# `@&` of one: reaching that again would run whatever it's reached through twice.
fn emit_for_header(s: *EmitterState, iter: *Expr, mr: *MemberPtrResult, out: **StructDef) -> i32
    if iter.kind == EXPR_IDENT
        return emit_for_ident_header(s, iter, out)
    if iter.kind == EXPR_MEMBER
        if mr.success != 1
            return 0
        let f: *StructField = mr.field
        let st: *StructDef = for_header_struct(s, f.field_type_name, f.field_type_name_len)
        if st == null
            return 0
        if f.field_type == TYPE_STRUCT
            *out = st
            return mr.reg
        if f.field_type == TYPE_PTR
            *out = st
            return emit_load_ptr(s, mr.reg)
        return 0
    if iter.kind == EXPR_UNARY and (iter.op == OP_ADDR or iter.op == OP_ADDR_MUT)
        return emit_for_addr_header(s, iter, mr, out)
    # AGAST #2410: `*p` and `vs[i]` are places: walked where they are.
    if iter.kind == EXPR_UNARY and iter.op == OP_DEREF
        return emit_for_deref_header(s, iter.operand, out)
    if iter.kind == EXPR_INDEX
        return emit_for_element_header(s, iter, out)
    var name: *u8 = null
    var name_len: i32 = 0
    if iter.kind == EXPR_CALL or iter.kind == EXPR_METHOD
        for_call_struct_name(s, iter, @name, @name_len)
    else if iter.kind == EXPR_STRING_LIT
        resolve_expr_struct_name(s, iter, @name, @name_len)
    let vst: *StructDef = for_header_struct(s, name, name_len)
    if vst == null
        return 0
    *out = vst
    emit_for_header_spill(s, vst, emit_expr(s, iter))

# AGAST #2410: the LLVM type of what the loop binds: an element, or a `[M x T]` row
# when `row` is M.
fn emit_for_slot_llvm(s: *EmitterState, elem: i32, name: *u8, name_len: i32, row: i32)
    if row > 0
        emit_str(s, c"[")
        emit_int(s, row as i64)
        emit_str(s, c" x ")
        emit_for_elem_llvm(s, elem, name, name_len)
        emit_str(s, c"]")
    else
        emit_for_elem_llvm(s, elem, name, name_len)

# AGAST #2410: the array a `*[N]T` / `@[N]T` / `@&[N]T` local points at, read once,
# with its N and T in the outs.  (`*[N][M]T` doesn't parse on ritz1.)
fn for_array_ptr(s: *EmitterState, loc: *LocalVar, elem: *i32, size: *i32, name: **u8, name_len: *i32, pointee: *i32, p_name: **u8, p_name_len: *i32) -> i32
    *elem = loc.pointee_array_elem_type
    *size = loc.pointee_array_size
    var en_len: i32 = 0
    let en: *u8 = array_ptr_elem_name(loc, @en_len)
    *name = en
    *name_len = en_len
    *pointee = elem_recorded_pointee(s, *elem, loc.pointee_array_elem_pointee, en, en_len, p_name, p_name_len)
    emit_load_ptr(s, loc.reg)

# AGAST #2410: the element type of the literal `e`, from its first element as
# ritz0 has it: a struct, a bool, a float or an integer.  TYPE_VOID for any other.
# AGAST #3014: a fill `[v; N]` too, from `v`.  emit_var_decl types an
# unannotated `let a = [5, 6, 7]` / `[5; 3]` with it.
fn array_init_elem(s: *EmitterState, e: *Expr, name: **u8, name_len: *i32) -> i32
    if e.kind == EXPR_ARRAY_FILL
        if array_fill_struct_elem(s, e, name, name_len) > 0
            return TYPE_STRUCT
        return scalar_elem_kind(s, e.left)
    if array_lit_struct_elem(s, e, name, name_len) > 0
        return TYPE_STRUCT
    scalar_elem_kind(s, e.args)

# AGAST #3029: T when the literal or fill `e` is of pointers, as ritz0 has it
# from its first element: `@x` / `@&x` with `x` a local integer, float or
# struct (its name in *name / *name_len).  TYPE_VOID for any other, which
# array_init_elem's caller leaves untyped.  emit_var_decl types an
# unannotated `let a = [@x, @x]` as `[2]*T` with it, T recorded so `*a[1]`
# loads T's width.
fn array_init_ptr_pointee(s: *EmitterState, e: *Expr, name: **u8, name_len: *i32) -> i32
    *name = null
    *name_len = 0
    var first: *Expr = e.args
    if e.kind == EXPR_ARRAY_FILL
        first = e.left
    if first == null or first.kind != EXPR_UNARY or (first.op != OP_ADDR and first.op != OP_ADDR_MUT)
        return TYPE_VOID
    let o: *Expr = first.operand
    if o == null or o.kind != EXPR_IDENT
        return TYPE_VOID
    let loc: *LocalVar = find_local_struct_name(s, o.ident_ptr, o.ident_len)
    if loc == null or loc.is_bool == 1 or loc.bk_unsure == 1
        return TYPE_VOID
    let t: i32 = loc.var_type
    if t == TYPE_STRUCT and loc.type_name_len > 0
        *name = loc.type_name
        *name_len = loc.type_name_len
        return TYPE_STRUCT
    if t == TYPE_I8 or t == TYPE_U8 or t == TYPE_I16 or t == TYPE_U16 or t == TYPE_I32 or t == TYPE_U32 or t == TYPE_I64 or t == TYPE_U64 or t == TYPE_F32 or t == TYPE_F64
        return t
    TYPE_VOID

# The scalar type ritz0 gives an array whose first element is `first`: an
# untyped int literal is i64, a typed value keeps its width.  TYPE_VOID for a
# pointer, a string or anything else not a bool, float or integer.
fn scalar_elem_kind(s: *EmitterState, first: *Expr) -> i32
    if first == null
        return TYPE_VOID
    let k: i32 = bool_kind(s, first)
    if k == BK_BOOL
        return TYPE_BOOL
    let t: i32 = get_expr_type(s, first)
    if k == BK_FLOAT
        if t == TYPE_F32
            return TYPE_F32
        return TYPE_F64
    if k == BK_INT
        if t == TYPE_I8 or t == TYPE_U8 or t == TYPE_I16 or t == TYPE_U16 or t == TYPE_I32 or t == TYPE_U32 or t == TYPE_U64
            return t
        return TYPE_I64
    TYPE_VOID

# AGAST #2410: the literal `e` in a slot of its own, a static alloca that
# hoist_entry_allocas takes out of any enclosing loop; 0 for a literal ritz1
# can't type.
fn emit_for_literal(s: *EmitterState, e: *Expr, elem: *i32, size: *i32, name: **u8, name_len: *i32) -> i32
    let t: i32 = array_init_elem(s, e, name, name_len)
    if t == TYPE_VOID
        return 0
    var n: i32 = 0
    var it: *Expr = e.args
    while it != null
        n = n + 1
        it = it.next
    let slot: i32 = next_reg(s)
    emit_str(s, c"  ")
    emit_reg(s, slot)
    emit_str(s, c" = alloca [")
    emit_int(s, n as i64)
    emit_str(s, c" x ")
    emit_for_elem_llvm(s, t, *name, *name_len)
    emit_str(s, c"]\n")
    emit_array_lit_into(s, slot, n, t, *name, *name_len, e)
    *elem = t
    *size = n
    slot

# AGAST #2533: whether the field `e` names is a field of a call's result, as in
# `mk().a` or `mk().p.a`.  ritz0 takes no address of one.  `mkp()[0].a` is a
# place, and ritz0 walks it: an index stops the search.
fn member_reached_through_call(e: *Expr) -> i32
    var base: *Expr = e
    while base != null and base.kind == EXPR_MEMBER
        base = base.left
    if base != null and (base.kind == EXPR_CALL or base.kind == EXPR_METHOD)
        return 1
    0

# AGAST #2426: `*x`, with `x` a call, a field or a global of type `*[N]T` (as
# base_ptr_array has them): the array it points at, evaluated once.  0, emitting
# nothing, for anything else.
fn emit_for_deref_array(s: *EmitterState, x: *Expr, elem: *i32, size: *i32, name: **u8, name_len: *i32, pointee: *i32, p_name: **u8, p_name_len: *i32) -> i32
    let pa: *Param = base_ptr_array(s, x)
    if pa == null or pa.param_pointee_array_shape != null
        return 0
    *elem = pa.param_pointee_array_elem_type
    *size = pa.param_pointee_array_size
    *name = pa.param_type_name
    *name_len = pa.param_type_name_len
    *pointee = elem_recorded_pointee(s, *elem, pa.param_pointee_array_elem_pointee, *name, *name_len, p_name, p_name_len)
    let val: i32 = emit_expr(s, x)
    let r: i32 = next_reg(s)
    emit_str(s, c"  ")
    emit_reg(s, r)
    emit_str(s, c" = inttoptr i64 ")
    emit_reg(s, val)
    emit_str(s, c" to ptr\n")
    r

# Lower `for x in iter { body }` (no `..`) — the iterable form.
# Supports the shapes ritz1 can express today:
#   • a local `[N]T` (TYPE_ARRAY), walked in place
#   • a module const or global `[N]T`, walked in place at its symbol
#   • an array field, walked in place at its address (AGAST #2387)
#   • what a `*[N]T` / `@[N]T` / `@&[N]T` local points at, as `p` or `*p`, and a
#     row `m[i]` of a `[N][M]T`, walked in place (AGAST #2410)
#   • `*x` for a call, field or global `x` of type `*[N]T`, a row `mkp().m[i]` of
#     what a `*S` call returns, a field `b.f` read through a Box, and a header
#     `vv[i]` in a Vec's buffer: places, walked in place (AGAST #2426)
#   • a literal, walked in a slot of its own: nothing else can reach it
#   • a `[N][M]T`, whose binding is each row, a copy as an element is
#   • a Vec, a Span or a StrView, through its header (emit_for_header)
# Anything else is a located error, as is an array of rank 3 or more.  AGAST
# #2375: it used to be a loop that never ran, with no diagnostic.
fn emit_for_iterable(s: *EmitterState, stmt: *Stmt, ret_type: i32)
    var iter_kind: i32 = 0         # 0=unsupported, 1=array in a reg, 2=header in a reg, 3=array at a symbol
    var elem_type: i32 = TYPE_I64
    var arr_size: i32 = 0
    var data_reg: i32 = 0
    var type_name: *u8 = null
    var type_name_len: i32 = 0
    # Const-array iter (kind=3): use global symbol `@<const_name>` as the
    # base pointer instead of an SSA reg.
    var const_name: *u8 = null
    var const_name_len: i32 = 0
    # AGAST #2332: what the binding points at, for an element of `[N]*T`.
    var bind_pointee: i32 = TYPE_VOID
    var bind_name: *u8 = null
    var bind_name_len: i32 = 0
    # AGAST #2375: the element's struct, for an element of `[N]S`.
    var elem_name: *u8 = null
    var elem_name_len: i32 = 0
    # AGAST #2410: what an N-D iterable is, and how many of its indices are
    # applied.  for_nd_rows turns it into the walk.
    var nd_shape: *ArrayShape = null
    var nd_depth: i32 = 0
    # M when the element is itself a `[M]T` row, which the binding holds.
    var row_size: i32 = 0

    var mr: MemberPtrResult
    mr.reg = 0
    mr.field = null
    mr.success = 0
    let iter: *Expr = stmt.for_start
    # AGAST #2314: `@a` / `@&a` walks the array `a` names, in place, as `a` does:
    # a local or by-value `[N]T`, `a:& [N]T` (whose slot is the array behind the
    # borrow) or a global.  A const isn't, as in ritz0.  AGAST #2533: and `@h.a`
    # walks the field `h.a`, as `h.a` does.
    var arr_ident: *Expr = iter
    var via_addr: i32 = 0
    if iter != null and iter.kind == EXPR_UNARY and (iter.op == OP_ADDR or iter.op == OP_ADDR_MUT) and iter.operand != null and (iter.operand.kind == EXPR_IDENT or iter.operand.kind == EXPR_MEMBER)
        arr_ident = iter.operand
        via_addr = 1
    if iter != null
        if arr_ident.kind == EXPR_IDENT
            let loc: *LocalVar = find_local_struct_name(s, arr_ident.ident_ptr, arr_ident.ident_len)
            if loc != null
                if loc.var_type == TYPE_ARRAY and loc.array_shape != null
                    # AGAST #1509: a multi-dimensional array yields rows.  It
                    # used to GEP the alloca as `[N x i64]` and load garbage.
                    nd_shape = loc.array_shape
                    iter_kind = 1
                    data_reg = loc.reg
                else if loc.var_type == TYPE_ARRAY
                    iter_kind = 1
                    elem_type = loc.array_elem_type
                    arr_size = loc.array_size
                    data_reg = loc.reg
                    elem_name = loc.type_name
                    elem_name_len = loc.type_name_len
                    bind_pointee = elem_recorded_pointee(s, elem_type, loc.array_elem_pointee, loc.type_name, loc.type_name_len, @bind_name, @bind_name_len)
                else if via_addr == 0 and array_ptr_named(s, arr_ident.ident_ptr, arr_ident.ident_len) != null
                    # AGAST #2410: `a: *[N]T` / `@[N]T` / `@&[N]T` walks the array
                    # it points at.
                    data_reg = for_array_ptr(s, loc, @elem_type, @arr_size, @elem_name, @elem_name_len, @bind_pointee, @bind_name, @bind_name_len)
                    iter_kind = 1
            else
                # Iter is not a local — try a module const array
                # (`const VALUES: [3]i32 = [2,3,5]`).  emit_const_array_entry
                # emits `@VALUES = internal constant [3 x i32] [...]`; we GEP
                # off the global symbol below.
                let centry: *ConstEntry = find_const_entry(s, arr_ident.ident_ptr, arr_ident.ident_len)
                if centry != null and centry.const_type == TYPE_ARRAY and via_addr == 0
                    iter_kind = 3
                    elem_type = centry.array_elem_type
                    arr_size = centry.array_size
                    const_name = centry.name as *u8
                    const_name_len = centry.name_len
                    elem_name = centry.array_elem_type_name
                    elem_name_len = centry.array_elem_type_name_len
                else
                    let glob: *GlobalVarDef = find_global(s, arr_ident.ident_ptr, arr_ident.ident_len)
                    if glob != null and glob.var_type == TYPE_ARRAY and glob.array_shape != null
                        nd_shape = glob.array_shape
                        iter_kind = 3
                        const_name = glob.name
                        const_name_len = glob.name_len
                    else if glob != null and glob.var_type == TYPE_ARRAY
                        iter_kind = 3
                        elem_type = glob.array_elem_type
                        arr_size = glob.array_size
                        const_name = glob.name
                        const_name_len = glob.name_len
                        elem_name = glob.array_elem_type_name
                        elem_name_len = glob.array_elem_type_name_len
                        bind_pointee = elem_recorded_pointee(s, elem_type, glob.array_elem_pointee, elem_name, elem_name_len, @bind_name, @bind_name_len)
        else if arr_ident.kind == EXPR_MEMBER
            # `@mk().a` has no address: ritz0 says "Cannot get address of: Call".
            # Refused before the member is reached, which would run the call.
            # AGAST #2426 / #3006: `b.f` reads through a Box; `@b.f` doesn't, as in ritz0.
            if via_addr == 0 or member_reached_through_call(arr_ident) == 0
                let box_read: i32 = s.box_read
                s.box_read = 1 - via_addr
                emit_member_ptr(s, arr_ident, @mr)
                s.box_read = box_read
            if mr.success == 1 and mr.field.field_type == TYPE_ARRAY
                let fld: *StructField = mr.field
                iter_kind = 1
                data_reg = mr.reg
                if fld.array_shape != null
                    nd_shape = fld.array_shape
                elem_type = fld.array_elem_type
                arr_size = fld.array_size
                data_reg = mr.reg
                elem_name = fld.array_elem_type_name
                elem_name_len = fld.array_elem_type_name_len
                bind_pointee = elem_recorded_pointee(s, elem_type, fld.array_elem_pointee, elem_name, elem_name_len, @bind_name, @bind_name_len)
        else if iter.kind == EXPR_UNARY and iter.op == OP_DEREF and iter.operand != null
            # AGAST #2410: `*p` is the array `p` points at, not a copy of it.
            var ap: *LocalVar = null
            if iter.operand.kind == EXPR_IDENT
                ap = array_ptr_named(s, iter.operand.ident_ptr, iter.operand.ident_len)
            if ap != null
                data_reg = for_array_ptr(s, ap, @elem_type, @arr_size, @elem_name, @elem_name_len, @bind_pointee, @bind_name, @bind_name_len)
                iter_kind = 1
            else
                # AGAST #2426: and `*mkp()`, `*h.p`, `*gp`, where they point.
                data_reg = emit_for_deref_array(s, iter.operand, @elem_type, @arr_size, @elem_name, @elem_name_len, @bind_pointee, @bind_name, @bind_name_len)
                if data_reg != 0
                    iter_kind = 1
        else if iter.kind == EXPR_INDEX
            # AGAST #2410: a row `m[i]` of a `[N][M]T`, where it is.
            # AGAST #2426 / #2517: `mkp().m[i]` too, a row of what a call points at.
            let sh: *ArrayShape = nd_index_shape(s, iter, @nd_depth)
            if sh != null and nd_depth < sh.rank and (iter.right == null or iter.right.kind != EXPR_RANGE)
                var ndp: NdIndexPtr
                if emit_nd_index_ptr(s, iter, @ndp) == 1
                    nd_shape = sh
                    iter_kind = 1
                    data_reg = ndp.reg
        else if iter.kind == EXPR_ARRAY_LIT
            # AGAST #2410: a literal is an rvalue: a slot of its own.
            data_reg = emit_for_literal(s, iter, @elem_type, @arr_size, @elem_name, @elem_name_len)
            if data_reg != 0
                iter_kind = 1

    if nd_shape != null
        # Rows of a `[N][M]T`, or the elements of a row: rank 3 and up isn't.
        let left: i32 = nd_shape.rank - nd_depth
        if left > 2
            emit_nd_error(s, iter.span.line, iter.span.col, c"iterating a multi-dimensional array is not supported in ritz1 (index it with nested ranges)")
            return
        arr_size = nd_shape.dims[nd_depth]
        if left == 2
            row_size = nd_shape.dims[nd_depth + 1]
        elem_type = nd_shape.leaf_type
        elem_name = nd_shape.leaf_name
        elem_name_len = nd_shape.leaf_name_len
        bind_pointee = elem_recorded_pointee(s, elem_type, nd_shape.leaf_pointee, elem_name, elem_name_len, @bind_name, @bind_name_len)

    if iter_kind == 0 and iter != null
        var hdr: *StructDef = null
        data_reg = emit_for_header(s, iter, @mr, @hdr)
        if hdr != null
            var fe: ForElem
            fe.elem = TYPE_VOID
            fe.name = null
            fe.name_len = 0
            fe.pointee = TYPE_VOID
            fe.pointee_name = null
            fe.pointee_name_len = 0
            if for_header_elem(s, hdr, @fe) == 0
                emit_nd_error(s, iter.span.line, iter.span.col, c"this `for` element type is not supported in ritz1 (index the Vec, or use a struct element)")
                return
            iter_kind = 2
            type_name = hdr.name
            type_name_len = hdr.name_len
            elem_type = fe.elem
            elem_name = fe.name
            elem_name_len = fe.name_len
            bind_pointee = fe.pointee
            bind_name = fe.pointee_name
            bind_name_len = fe.pointee_name_len

    if iter_kind == 0
        emit_nd_error(s, iter.span.line, iter.span.col, c"this `for` iterable is not supported in ritz1 (it takes an array, an array field, a Vec, a Span or a StrView)")
        return

    # Index storage (i64 counter).
    let idx_reg: i32 = next_reg(s)
    emit_str(s, c"  ")
    emit_reg(s, idx_reg)
    emit_str(s, c" = alloca i64\n")
    emit_str(s, c"  store i64 0, ptr ")
    emit_reg(s, idx_reg)
    emit_str(s, c"\n")

    # Loop variable — typed to elem_type so body reads get the right width.
    let var_reg: i32 = next_reg(s)
    emit_str(s, c"  ")
    emit_reg(s, var_reg)
    emit_str(s, c" = alloca ")
    # A bool local is an i64 slot, as emit_var_decl has it, and `elem_type` an
    # `i1` in the array.  The body reads the binding as any other bool local.
    if elem_type == TYPE_BOOL and row_size == 0
        emit_str(s, c"i64")
    else
        emit_for_slot_llvm(s, elem_type, elem_name, elem_name_len, row_size)
    emit_str(s, c"\n")

    if row_size > 0
        # AGAST #2410: a row is a `[M]T` local.
        add_local_full(s, stmt.for_var, stmt.for_var_len, var_reg, TYPE_ARRAY, elem_name, elem_name_len, TYPE_I64, row_size, elem_type)
        let row_loc: *LocalVar = local_at(s, s.local_count - 1)
        row_loc.array_elem_pointee = bind_pointee
    else if bind_pointee != TYPE_VOID
        add_local_full(s, stmt.for_var, stmt.for_var_len, var_reg, elem_type, bind_name, bind_name_len, bind_pointee, 0, 0)
    else if elem_type == TYPE_STRUCT and elem_name_len > 0
        add_local_struct(s, stmt.for_var, stmt.for_var_len, var_reg, elem_type, elem_name, elem_name_len)
    else if elem_type == TYPE_BOOL
        add_local(s, stmt.for_var, stmt.for_var_len, var_reg, TYPE_I64)
        let bool_loc: *LocalVar = local_at(s, s.local_count - 1)
        bool_loc.is_bool = 1
    else
        add_local(s, stmt.for_var, stmt.for_var_len, var_reg, elem_type)
    # ritz0 binds every element a `let` (#1755, AGAST #2389): a write would only
    # reach this copy of the element.  A range variable (emit_for) stays a `var`.
    let elem_loc: *LocalVar = local_at(s, s.local_count - 1)
    elem_loc.is_let = 1

    let cond_label: i32 = next_label(s)
    let body_label: i32 = next_label(s)
    let incr_label: i32 = next_label(s)
    let end_label: i32 = next_label(s)

    let old_break: i32 = s.break_label
    let old_continue: i32 = s.continue_label
    s.break_label = end_label
    s.continue_label = incr_label

    emit_str(s, c"  br label %")
    emit_label(s, cond_label)
    emit_str(s, c"\n")

    # cond: idx < len
    begin_block(s, cond_label)
    let idx_val: i32 = next_reg(s)
    emit_str(s, c"  ")
    emit_reg(s, idx_val)
    emit_str(s, c" = load i64, ptr ")
    emit_reg(s, idx_reg)
    emit_str(s, c"\n")

    var len_val: i32 = 0
    if iter_kind == 1 or iter_kind == 3
        len_val = next_reg(s)
        emit_str(s, c"  ")
        emit_reg(s, len_val)
        emit_str(s, c" = add i64 0, ")
        emit_int(s, arr_size as i64)
        emit_str(s, c"\n")
    else if iter_kind == 2
        let len_ptr: i32 = next_reg(s)
        emit_str(s, c"  ")
        emit_reg(s, len_ptr)
        emit_str(s, c" = getelementptr %")
        emit_name(s, type_name, type_name_len)
        emit_str(s, c", ptr ")
        emit_reg(s, data_reg)
        emit_str(s, c", i32 0, i32 1\n")
        len_val = next_reg(s)
        emit_str(s, c"  ")
        emit_reg(s, len_val)
        emit_str(s, c" = load i64, ptr ")
        emit_reg(s, len_ptr)
        emit_str(s, c"\n")

    let cmp_reg: i32 = next_reg(s)
    emit_str(s, c"  ")
    emit_reg(s, cmp_reg)
    emit_str(s, c" = icmp ult i64 ")
    emit_reg(s, idx_val)
    emit_str(s, c", ")
    emit_reg(s, len_val)
    emit_str(s, c"\n")
    emit_str(s, c"  br i1 ")
    emit_reg(s, cmp_reg)
    emit_str(s, c", label %")
    emit_label(s, body_label)
    emit_str(s, c", label %")
    emit_label(s, end_label)
    emit_str(s, c"\n")

    # body: load current element, store into loop var, then recurse body.
    begin_block(s, body_label)

    let idx_val2: i32 = next_reg(s)
    emit_str(s, c"  ")
    emit_reg(s, idx_val2)
    emit_str(s, c" = load i64, ptr ")
    emit_reg(s, idx_reg)
    emit_str(s, c"\n")

    let elem_ptr: i32 = next_reg(s)
    if iter_kind == 2
        # `data` is field 0 and `len` field 1, as for_header_struct checked.
        let data_ptr_ptr: i32 = next_reg(s)
        emit_str(s, c"  ")
        emit_reg(s, data_ptr_ptr)
        emit_str(s, c" = getelementptr %")
        emit_name(s, type_name, type_name_len)
        emit_str(s, c", ptr ")
        emit_reg(s, data_reg)
        emit_str(s, c", i32 0, i32 0\n")
        let data_ptr: i32 = next_reg(s)
        emit_str(s, c"  ")
        emit_reg(s, data_ptr)
        emit_str(s, c" = load ptr, ptr ")
        emit_reg(s, data_ptr_ptr)
        emit_str(s, c"\n  ")
        emit_reg(s, elem_ptr)
        emit_str(s, c" = getelementptr ")
        emit_for_elem_llvm(s, elem_type, elem_name, elem_name_len)
        emit_str(s, c", ptr ")
        emit_reg(s, data_ptr)
        emit_str(s, c", i64 ")
        emit_reg(s, idx_val2)
        emit_str(s, c"\n")
    else
        emit_str(s, c"  ")
        emit_reg(s, elem_ptr)
        emit_str(s, c" = getelementptr [")
        emit_int(s, arr_size as i64)
        emit_str(s, c" x ")
        emit_for_slot_llvm(s, elem_type, elem_name, elem_name_len, row_size)
        emit_str(s, c"], ptr ")
        # A local array or a field is an SSA reg; a const or global
        # array is its symbol.
        if iter_kind == 3
            emit_str(s, c"@")
            emit_name(s, const_name, const_name_len)
        else
            emit_reg(s, data_reg)
        emit_str(s, c", i64 0, i64 ")
        emit_reg(s, idx_val2)
        emit_str(s, c"\n")
    let elem_val: i32 = next_reg(s)
    emit_str(s, c"  ")
    emit_reg(s, elem_val)
    emit_str(s, c" = load ")
    emit_for_slot_llvm(s, elem_type, elem_name, elem_name_len, row_size)
    emit_str(s, c", ptr ")
    emit_reg(s, elem_ptr)
    emit_str(s, c"\n")
    if elem_type == TYPE_BOOL and row_size == 0
        let wide: i32 = next_reg(s)
        emit_str(s, c"  ")
        emit_reg(s, wide)
        emit_str(s, c" = zext i1 ")
        emit_reg(s, elem_val)
        emit_str(s, c" to i64\n  store i64 ")
        emit_reg(s, wide)
    else
        emit_str(s, c"  store ")
        emit_for_slot_llvm(s, elem_type, elem_name, elem_name_len, row_size)
        emit_str(s, c" ")
        emit_reg(s, elem_val)
    emit_str(s, c", ptr ")
    emit_reg(s, var_reg)
    emit_str(s, c"\n")

    # Body statements.
    let own_loop: i32 = own_loop_enter(s)   # AGAST #2158
    own_push_scope(s)
    var body_stmt: *Stmt = stmt.for_body
    while body_stmt != null
        emit_stmt(s, body_stmt, ret_type)
        body_stmt = body_stmt.next
    own_pop_scope(s)
    own_loop_exit(s, own_loop)

    emit_str(s, c"  br label %")
    emit_label(s, incr_label)
    emit_str(s, c"\n")

    # incr: idx = idx + 1
    begin_block(s, incr_label)
    let load2_reg: i32 = next_reg(s)
    emit_str(s, c"  ")
    emit_reg(s, load2_reg)
    emit_str(s, c" = load i64, ptr ")
    emit_reg(s, idx_reg)
    emit_str(s, c"\n")
    let incr_val: i32 = next_reg(s)
    emit_str(s, c"  ")
    emit_reg(s, incr_val)
    emit_str(s, c" = add i64 ")
    emit_reg(s, load2_reg)
    emit_str(s, c", 1\n")
    emit_str(s, c"  store i64 ")
    emit_reg(s, incr_val)
    emit_str(s, c", ptr ")
    emit_reg(s, idx_reg)
    emit_str(s, c"\n")
    emit_str(s, c"  br label %")
    emit_label(s, cond_label)
    emit_str(s, c"\n")

    # end
    begin_block(s, end_label)
    # AGAST #1329 — a loop contributes no value.  Without this, a trailing
    # expression in the body leaks its register into the exit block, where
    # the implicit return would use it without dominating it.
    clear_last_expr(s)

    s.break_label = old_break
    s.continue_label = old_continue

# AGAST #1332 — subscript STORE through a pointer base (`b[i] = v` where b
# is *T / **T).  The old STMT_INDEX_ASSIGN pointer arm hardcoded
# `getelementptr i64` + `store i64` for every non-** pointer, so a *i32/*u8
# base was written with an 8-byte stride AND an 8-byte width (7/8–8/8
# corruption in 92_subscript_store), and a GLOBAL base emitted no store at
# all — the whole arm was guarded by `find_local() >= 0` with no else, so
# `g[i] = v` was silently dropped.  This is the store-side companion of
# #1325/#1328, which fixed only the loads.
#
# `base_ptr` must already be a `ptr`-typed register; `pointee` may be
# TYPE_UNKNOWN (unresolvable base), which falls back to the legacy i64
# stride/width.  Index and value are emitted here to preserve the historical
# evaluation order (index before value, both after the base load).
fn emit_index_assign_ptr_store(s: *EmitterState, stmt: *Stmt, base_ptr: i32, base_type: i32, pointee: i32)
    emit_ptr_elem_store(s, stmt.while_cond, stmt.assign_value, base_ptr, base_type, pointee)

# The body of emit_index_assign_ptr_store, for any index / value pair.  AGAST
# #2545: `(*r)[i] = v` (an expression-target assign) stores through it too.
fn emit_ptr_elem_store(s: *EmitterState, idx_expr: *Expr, value: *Expr, base_ptr: i32, base_type: i32, pointee: i32)
    let idx_reg: i32 = emit_expr(s, idx_expr)
    let val_reg: i32 = emit_expr(s, value)
    let elem_ptr: i32 = next_reg(s)
    if base_type == TYPE_PTR_PTR
        # Pointer-to-pointer: element is a pointer.
        emit_str(s, c"  ")
        emit_reg(s, elem_ptr)
        emit_str(s, c" = getelementptr ptr, ptr ")
        emit_reg(s, base_ptr)
        emit_str(s, c", i64 ")
        emit_reg(s, idx_reg)
        emit_str(s, c"\n")
        let ptr_val: i32 = next_reg(s)
        emit_str(s, c"  ")
        emit_reg(s, ptr_val)
        emit_str(s, c" = inttoptr i64 ")
        emit_reg(s, val_reg)
        emit_str(s, c" to ptr\n")
        emit_str(s, c"  store ptr ")
        emit_reg(s, ptr_val)
        emit_str(s, c", ptr ")
        emit_reg(s, elem_ptr)
        emit_str(s, c"\n")
        return
    if base_type != TYPE_PTR_PTR and array_elem_typed_scalar(pointee) == 1
        # AGAST #1973: `p[i] = v` through a *f32 / *f64 GEPs and stores a
        # `float` / `double` (an f64 value into an f32 slot is fptrunc'd),
        # as a local float array element does (#1966).  It fell to the
        # i64 arm below: `getelementptr i64` + `store i64 %float`.  A
        # *bool strides and stores one `i1`, as every bool array element
        # is laid out (#2063); it stored an i64 8 bytes apart.
        let fty: *u8 = local_array_elem_llvm(pointee)
        let fval: i32 = emit_field_elem_narrow(s, val_reg, pointee, value)
        emit_str(s, c"  ")
        emit_reg(s, elem_ptr)
        emit_str(s, c" = getelementptr ")
        emit_str(s, fty)
        emit_str(s, c", ptr ")
        emit_reg(s, base_ptr)
        emit_str(s, c", i64 ")
        emit_reg(s, idx_reg)
        emit_str(s, c"\n")
        emit_str(s, c"  store ")
        emit_str(s, fty)
        emit_str(s, c" ")
        emit_reg(s, fval)
        emit_str(s, c", ptr ")
        emit_reg(s, elem_ptr)
        emit_str(s, c"\n")
        return
    # Element type from the pointee kind; unknown/i64/u64 → i64.
    var elem_ty: *u8 = c"i64"
    var narrow: i32 = 0
    if pointee == TYPE_U8 or pointee == TYPE_I8
        elem_ty = c"i8"
        narrow = 1
    else if pointee == TYPE_U16 or pointee == TYPE_I16
        elem_ty = c"i16"
        narrow = 1
    else if pointee == TYPE_U32 or pointee == TYPE_I32
        elem_ty = c"i32"
        narrow = 1
    emit_str(s, c"  ")
    emit_reg(s, elem_ptr)
    emit_str(s, c" = getelementptr ")
    emit_str(s, elem_ty)
    emit_str(s, c", ptr ")
    emit_reg(s, base_ptr)
    emit_str(s, c", i64 ")
    emit_reg(s, idx_reg)
    emit_str(s, c"\n")
    if narrow == 1
        let trunc: i32 = next_reg(s)
        emit_str(s, c"  ")
        emit_reg(s, trunc)
        emit_str(s, c" = trunc i64 ")
        emit_reg(s, val_reg)
        emit_str(s, c" to ")
        emit_str(s, elem_ty)
        emit_str(s, c"\n")
        emit_str(s, c"  store ")
        emit_str(s, elem_ty)
        emit_str(s, c" ")
        emit_reg(s, trunc)
        emit_str(s, c", ptr ")
        emit_reg(s, elem_ptr)
        emit_str(s, c"\n")
    else
        emit_str(s, c"  store i64 ")
        emit_reg(s, val_reg)
        emit_str(s, c", ptr ")
        emit_reg(s, elem_ptr)
        emit_str(s, c"\n")

# Emit the LLVM type `[N x T]` of inline array field `field`.
fn emit_array_field_llvm_type(s: *EmitterState, field: *StructField)
    emit_str(s, c"[")
    emit_int(s, field.array_size as i64)
    emit_str(s, c" x ")
    if field.array_elem_type == TYPE_STRUCT and field.array_elem_type_name_len > 0
        emit_str(s, c"%")
        emit_name(s, field.array_elem_type_name, field.array_elem_type_name_len)
    else
        emit_str(s, field_array_elem_llvm(field.array_elem_type))
    emit_str(s, c"]")

# Copy `[N x T]` (spelled for `field`) from `src_ptr` over `dst_ptr` as one
# aggregate load + store: every element is read before any is written.
fn emit_array_field_copy(s: *EmitterState, field: *StructField, src_ptr: i32, dst_ptr: i32)
    let agg: i32 = next_reg(s)
    emit_str(s, c"  ")
    emit_reg(s, agg)
    emit_str(s, c" = load ")
    emit_array_field_llvm_type(s, field)
    emit_str(s, c", ptr ")
    emit_reg(s, src_ptr)
    emit_str(s, c"\n  store ")
    emit_array_field_llvm_type(s, field)
    emit_str(s, c" ")
    emit_reg(s, agg)
    emit_str(s, c", ptr ")
    emit_reg(s, dst_ptr)
    emit_str(s, c"\n")

# AGAST #2343: an array store takes the same element type, by kind: `[N]u32` is
# not `[N]i32`.  ref_into has said so already for whatever it can name.
fn array_store_fits(s: *EmitterState, value: *Expr, a: i32, a_name: *u8, a_len: i32, b: i32, b_name: *u8, b_len: i32) -> i32
    if a == b and array_elem_types_match(a, a_name, a_len, b, b_name, b_len) == 1
        return 1
    ref_array_error(s, value)
    0

# 1 when two array element types name the same type (struct elements by name).
# Exactly the same type, through an address too: `[N]u32` doesn't fit a
# reference to `[N]i32`, though LLVM spells both `i32` (#2367).
fn array_elem_types_match(a: i32, a_name: *u8, a_len: i32, b: i32, b_name: *u8, b_len: i32) -> i32
    if a == TYPE_STRUCT or b == TYPE_STRUCT
        if a != b or a_len != b_len or a_len <= 0
            return 0
        return (memcmp(a_name, b_name, a_len as i64) == 0) as i32
    return (a == b) as i32

# AGAST #2287: the shape of a whole array an expression reads.
struct ArraySrc
    size: i32
    elem: i32
    name: *u8
    name_len: i32

fn array_src_set(out: *ArraySrc, size: i32, elem: i32, name: *u8, name_len: i32) -> i32
    out.size = size
    out.elem = elem
    out.name = name
    out.name_len = name_len
    1

# The `p: *[N]T` / `@[N]T` / `@&[N]T` local `e` names, or null.  `a:& [N]T` counts:
# as in ritz0, `*a` reads the array.
fn array_ptr_local(s: *EmitterState, e: *Expr) -> *LocalVar
    if e == null or e.kind != EXPR_IDENT
        return null
    let loc: *LocalVar = find_local_struct_name(s, e.ident_ptr, e.ident_len)
    if loc == null or loc.pointee_type != TYPE_ARRAY or loc.pointee_array_size <= 0
        return null
    if lent_array_ident(s, e) != null
        return loc
    return array_ptr_index_base(s, e)

# The address of the array behind array_ptr_local's `loc`.
fn emit_array_ptr_base(s: *EmitterState, loc: *LocalVar) -> i32
    if loc.var_type == TYPE_ARRAY
        return loc.reg
    return emit_load_ptr(s, loc.reg)

# Fill `out` when `value` reads a whole 1-D array out of a place that needs no
# code to find: a local or by-value param, `a:& [N]T`, a global, `*p`.  Returns
# 0 for anything else.  Emits nothing, so a check can ask before emitting.
fn array_place_shape(s: *EmitterState, value: *Expr, out: *ArraySrc) -> i32
    if value.kind == EXPR_IDENT
        let loc: *LocalVar = find_local_struct_name(s, value.ident_ptr, value.ident_len)
        if loc != null
            if loc.var_type == TYPE_ARRAY and loc.array_shape == null
                return array_src_set(out, loc.array_size, loc.array_elem_type, loc.type_name, loc.type_name_len)
            return 0
        let g: *GlobalVarDef = find_global(s, value.ident_ptr, value.ident_len)
        if g != null and g.var_type == TYPE_ARRAY and g.array_shape == null
            return array_src_set(out, g.array_size, g.array_elem_type, g.array_elem_type_name, g.array_elem_type_name_len)
        return 0
    if value.kind == EXPR_UNARY and value.op == OP_DEREF
        let ploc: *LocalVar = array_ptr_local(s, value.operand)
        if ploc != null
            var en_len: i32 = 0
            let en: *u8 = array_ptr_elem_name(ploc, @en_len)   # #2548
            return array_src_set(out, ploc.pointee_array_size, ploc.pointee_array_elem_type, en, en_len)
    0

# AGAST #2517: fill `out` when `value` is a 1-D row of an N-D array (nd_row_shape:
# `g[i]` of `[N][M]T`, `c[i][j]` of `[N][M][K]T`).  The base is any
# nd_index_shape knows: a local, a global, a field, or a field of a call's
# result, by value or through `*S`.  Emits nothing; emit_nd_index_ptr finds it.
fn nd_row_src(s: *EmitterState, value: *Expr, out: *ArraySrc) -> i32
    if value.kind != EXPR_INDEX or value.right == null or value.right.kind == EXPR_RANGE
        return 0
    let sh: *ArrayShape = nd_row_shape(s, value)
    if sh == null
        return 0
    array_src_set(out, sh.dims[sh.rank - 1], sh.leaf_type, sh.leaf_name, sh.leaf_name_len)

# The global `[N]T` that `e` names, or null.
fn global_array_named(s: *EmitterState, e: *Expr) -> *GlobalVarDef
    let g: *GlobalVarDef = find_global(s, e.ident_ptr, e.ident_len)
    if g == null or g.var_type != TYPE_ARRAY
        return null
    return g

# The address of global array `g`, in a register.
fn emit_global_array_ptr(s: *EmitterState, g: *GlobalVarDef) -> i32
    let ptr: i32 = next_reg(s)
    emit_str(s, c"  ")
    emit_reg(s, ptr)
    emit_str(s, c" = getelementptr i8, ptr @")
    emit_name(s, g.name, g.name_len)
    emit_str(s, c", i64 0\n")
    return ptr

# The address of the place array_place_shape recognised in `value`.
fn emit_array_place_ptr(s: *EmitterState, value: *Expr) -> i32
    if value.kind == EXPR_UNARY
        lent_array_local(s, value.operand)
        return emit_array_ptr_base(s, array_ptr_local(s, value.operand))
    let lent: *LocalVar = lent_array_local(s, value)
    if lent != null
        return lent.reg
    let loc: *LocalVar = find_local_struct_name(s, value.ident_ptr, value.ident_len)
    if loc != null
        return loc.reg
    return emit_global_array_ptr(s, find_global(s, value.ident_ptr, value.ident_len))

# AGAST #1935: `x.f = <array value>` where the right-hand side is not a
# literal.  Resolve the source array's storage and copy it over the field
# at `field_ptr`, after checking it has the field's length and element type
# (ritz0 rejects a mismatch).  Supported sources:
#   * a local `[N]T` array or by-value param (`w.vals = a`); its alloca is
#     `[N x T]` with the field's element spelling for every T (f32 / f64 since
#     #1966 / #1971, bool `i1` since #2063);
#   * a global `[N]T` array (#2287);
#   * another inline array field (`y.vals = x.vals`, `p.b = p.a`), whose
#     layout is the field's own;
#   * `*src` for a param or annotated local `src: *[N]T` (AGAST #1953), whose
#     N and T are recorded on the LocalVar (pointee_array_*).  A local,
#     field or global pointee shares the field's element layout (#1971,
#     #2063), so every element type copies.
# Returns 1 once handled (copied or diagnosed).  Anything else fails
# closed: emit_expr has no whole-array value, and the pre-#1934 generic
# path stored an ADDRESS into the field.
fn emit_array_field_copy_from(s: *EmitterState, field_ptr: i32, field: *StructField, value: *Expr)
    var src_ptr: i32 = -1
    var src_size: i32 = -1
    var src_et: i32 = TYPE_VOID
    var src_name: *u8 = null
    var src_name_len: i32 = 0
    var place: ArraySrc
    if array_place_shape(s, value, @place) == 1
        src_ptr = emit_array_place_ptr(s, value)
        src_size = place.size
        src_et = place.elem
        src_name = place.name
        src_name_len = place.name_len
    else if value.kind == EXPR_MEMBER
        var mr: MemberPtrResult
        emit_member_ptr(s, value, @mr)
        if mr.success == 1 and mr.field != null and mr.field.field_type == TYPE_ARRAY
            src_ptr = mr.reg
            src_size = mr.field.array_size
            src_et = mr.field.array_elem_type
            src_name = mr.field.array_elem_type_name
            src_name_len = mr.field.array_elem_type_name_len
    if src_ptr < 0
        emit_ir_error(s, c"whole-array assignment to a struct field from this value is not supported by ritz1 (only array literals, local arrays, array fields and `*p` for `p: *[N]T`)")
        return
    if src_size != field.array_size
        emit_ir_error(s, c"array length does not match the struct field's array length")
        return
    if array_store_fits(s, value, src_et, src_name, src_name_len, field.array_elem_type, field.array_elem_type_name, field.array_elem_type_name_len) == 0
        return
    emit_array_field_copy(s, field, src_ptr, field_ptr)

# AGAST #2035: the reverse of emit_array_field_copy_from.  A local `[N]T`
# array at `dst_ptr` (length `dst_size`, element `dst_et`, element struct name
# `dst_name`) is initialised or assigned from `value`, `let a: [N]T = x.f` /
# `a = p.f`.  When `value` is a member expression, copy the inline array field
# it names into the local, after checking that the length and element type
# match.  A local array uses the field's element spelling for every T
# (local_array_elem_llvm, f32 / f64 since #1966, bool since #2063), so the
# field's `[N x T]` copies as one aggregate.  The generic path loaded
# the field as `[N x T]` and emitted `store i64 <[N x T]>`, which clang rejects.
# Returns 1 once handled (copied or diagnosed) and 0 for a non-member value,
# which is left to the caller.  A member that is not a matching array field
# fails closed.
fn emit_array_local_copy_from_field(s: *EmitterState, dst_ptr: i32, dst_size: i32, dst_et: i32, dst_name: *u8, dst_name_len: i32, value: *Expr) -> i32
    if value == null or value.kind != EXPR_MEMBER
        return 0
    var mr: MemberPtrResult
    emit_member_ptr(s, value, @mr)
    if mr.success != 1 or mr.field == null or mr.field.field_type != TYPE_ARRAY
        emit_ir_error(s, c"whole-array read into a local array from this member is not supported by ritz1 (only an inline array field)")
        return 1
    let field: *StructField = mr.field
    if field.array_size != dst_size
        emit_ir_error(s, c"struct field's array length does not match the local array's length")
        return 1
    if array_store_fits(s, value, field.array_elem_type, field.array_elem_type_name, field.array_elem_type_name_len, dst_et, dst_name, dst_name_len) == 0
        return 1
    emit_array_field_copy(s, field, mr.reg, dst_ptr)
    1

# Copy a whole local `[N x T]` from `src_ptr` over `dst_ptr` as one aggregate
# load + store: every element is read before any is written.
fn emit_local_array_copy(s: *EmitterState, size: i32, et: i32, name: *u8, name_len: i32, src_ptr: i32, dst_ptr: i32)
    let agg: i32 = next_reg(s)
    emit_str(s, c"  ")
    emit_reg(s, agg)
    emit_str(s, c" = load ")
    emit_local_array_llvm_type(s, size, et, name, name_len)
    emit_str(s, c", ptr ")
    emit_reg(s, src_ptr)
    emit_str(s, c"\n  store ")
    emit_local_array_llvm_type(s, size, et, name, name_len)
    emit_str(s, c" ")
    emit_reg(s, agg)
    emit_str(s, c", ptr ")
    emit_reg(s, dst_ptr)
    emit_str(s, c"\n")

# AGAST #2169: a 1-D local `[N]T` array at `dst_ptr` (length `dst_size`,
# element `dst_et`, element struct `dst_name`) gets a whole-array value, as
# `let a: [N]T = v` or `a = v`.  The generic scalar path loaded / stored the
# value as ONE i64: `a = c` and `var d: [3]i64 = a` copied 8 bytes, and
# `a = [x, y]` stored the literal's address (or `store i64 <%T>`, which clang
# rejects).  Supported values, each checked for length and element type:
#   * `[a, b, ..]`: built in a temporary `[N x T]` then copied over, so
#     `a = [a[1], a[0]]` swaps (as for a field, #1934);
#   * `[v; N]`: written in place (v is evaluated once, before any store);
#   * another 1-D local array or by-value param (`a = c`);
#   * a 1-D global array (#2287);
#   * an inline array field (`a = x.f`, #2035);
#   * `*p` for `p: *[N]T`, `@[N]T` or `@&[N]T` (#1953, #2287).
# Anything else fails closed: emit_expr has no whole-array value.  `dst_ptr` may
# be any `[N x T]`: `*p = a`, `G = a` and a by-value argument come here too.
fn emit_array_local_whole_assign(s: *EmitterState, dst_ptr: i32, dst_size: i32, dst_et: i32, dst_name: *u8, dst_name_len: i32, value: *Expr)
    if value == null
        emit_ir_error(s, c"whole-array assignment has no value")
        return
    if emit_array_local_copy_from_field(s, dst_ptr, dst_size, dst_et, dst_name, dst_name_len, value) == 1
        return
    if value.kind == EXPR_ARRAY_FILL or value.kind == EXPR_ARRAY_LIT
        var n: i32 = 0
        if value.kind == EXPR_ARRAY_FILL
            n = value.int_val as i32
        else
            var it: *Expr = value.args
            while it != null
                n = n + 1
                it = it.next
        if n != dst_size
            emit_ir_error(s, c"array literal length does not match the local array's length")
            return
        if value.kind == EXPR_ARRAY_FILL
            emit_array_fill_into(s, dst_ptr, dst_size, dst_et, dst_name, dst_name_len, value.left)
            return
        let tmp: i32 = next_reg(s)
        emit_str(s, c"  ")
        emit_reg(s, tmp)
        emit_str(s, c" = alloca ")
        emit_local_array_llvm_type(s, dst_size, dst_et, dst_name, dst_name_len)
        emit_str(s, c"\n")
        emit_array_lit_into(s, tmp, dst_size, dst_et, dst_name, dst_name_len, value)
        emit_local_array_copy(s, dst_size, dst_et, dst_name, dst_name_len, tmp, dst_ptr)
        return
    var place: ArraySrc
    if nd_row_src(s, value, @place) == 1
        # AGAST #2517: a row `g[i]`, `x.m[i]`, `mk().m[i]` or `mkp().m[i]`.
        if place.size != dst_size
            emit_ir_error(s, c"array length does not match the local array's length")
            return
        if array_store_fits(s, value, place.elem, place.name, place.name_len, dst_et, dst_name, dst_name_len) == 0
            return
        var ndp: NdIndexPtr
        emit_nd_index_ptr(s, value, @ndp)
        emit_local_array_copy(s, dst_size, dst_et, dst_name, dst_name_len, ndp.reg, dst_ptr)
        return
    if array_place_shape(s, value, @place) == 0
        emit_ir_error(s, c"whole-array assignment to a local array from this value is not supported by ritz1 (only array literals, local arrays, array fields and `*p` for `p: *[N]T`)")
        return
    if place.size != dst_size
        emit_ir_error(s, c"array length does not match the local array's length")
        return
    if array_store_fits(s, value, place.elem, place.name, place.name_len, dst_et, dst_name, dst_name_len) == 0
        return
    emit_local_array_copy(s, dst_size, dst_et, dst_name, dst_name_len, emit_array_place_ptr(s, value), dst_ptr)

# AGAST #2048: `x.f = v` / `pp.f = v` / `o.p.f = v` where `f` is an f32 /
# f64 field at `field_ptr` and `val_reg` is emit_expr(value).  Stores
# `float` / `double` (an f64 value into an f32 field is fptrunc'd by
# emit_field_elem_narrow, as struct-literal init does) and returns 1; returns
# 0 for any other field type.  Both field-assign paths fell to `store i64`
# here, which clang rejects.
fn emit_float_field_store(s: *EmitterState, field_ptr: i32, field_ty: i32, val_reg: i32, value: *Expr) -> i32
    if field_ty != TYPE_F32 and field_ty != TYPE_F64
        return 0
    let fval: i32 = emit_field_elem_narrow(s, val_reg, field_ty, value)
    if field_ty == TYPE_F32
        emit_str(s, c"  store float ")
    else
        emit_str(s, c"  store double ")
    emit_reg(s, fval)
    emit_str(s, c", ptr ")
    emit_reg(s, field_ptr)
    emit_str(s, c"\n")
    1

# AGAST #1934: `x.f = [a, b, ..]` / `x.f = [v; N]` where `f` is an inline
# `[N]T` array field at `field_ptr`.  The elements are written at the field's
# declared element type, as a struct literal's array field is (#1605/#1608);
# bool / f32 / f64 elements as `i1` / `float` / `double` (#1935).
#
#   * `[v; N]` is written straight into the field: emit_array_fill_into
#     evaluates `v` once, before any store.
#   * `[a, b, ..]` is built in a temporary `[N x T]` and then copied over the
#     field, so every element is read before any is written
#     (`x.f = [x.f[1], x.f[0]]` swaps, as in ritz0).
#   * any other right-hand side is copied by emit_array_field_copy_from.
#
# A literal whose length differs from the field's fails closed (ritz0
# rejects it too).
fn emit_array_field_whole_assign(s: *EmitterState, field_ptr: i32, field: *StructField, value: *Expr)
    let et: i32 = field.array_elem_type
    if value == null
        emit_ir_error(s, c"whole-array assignment to a struct field has no value")
        return
    if value.kind != EXPR_ARRAY_LIT and value.kind != EXPR_ARRAY_FILL
        emit_array_field_copy_from(s, field_ptr, field, value)
        return
    var n: i32 = 0
    if value.kind == EXPR_ARRAY_FILL
        n = value.int_val as i32
    else
        var it: *Expr = value.args
        while it != null
            n = n + 1
            it = it.next
    if n != field.array_size
        emit_ir_error(s, c"array literal length does not match the struct field's array length")
        return
    if value.kind == EXPR_ARRAY_FILL
        emit_array_fill_into(s, field_ptr, field.array_size, et, field.array_elem_type_name, field.array_elem_type_name_len, value.left)
        return
    # Build in a temporary (a fixed-size alloca, hoisted to the entry block),
    # then copy the whole aggregate over the field.
    let tmp: i32 = next_reg(s)
    emit_str(s, c"  ")
    emit_reg(s, tmp)
    emit_str(s, c" = alloca ")
    emit_array_field_llvm_type(s, field)
    emit_str(s, c"\n")
    emit_array_lit_into(s, tmp, field.array_size, et, field.array_elem_type_name, field.array_elem_type_name_len, value)
    emit_array_field_copy(s, field, tmp, field_ptr)

# AGAST #1814: `x.f[i] = v` where `f` is an inline `[N]T` array field at
# `field_ptr`. GEP the element at the field's DECLARED element type
# (field_array_elem_llvm, ritz0's layout) and store `val` at that width.
# Shared by both member-index store paths, which used to carry their own
# i8/i32/i64/ptr ladders and stored u16/u32/bool elements as 8-byte i64.
fn emit_field_array_elem_store(s: *EmitterState, field_ptr: i32, field: *StructField, idx: i32, val: i32, val_expr: *Expr)
    let et: i32 = field.array_elem_type
    var is_struct: i32 = 0
    if et == TYPE_STRUCT and field.array_elem_type_name_len > 0
        is_struct = 1
    let elem_ptr: i32 = next_reg(s)
    emit_str(s, c"  ")
    emit_reg(s, elem_ptr)
    emit_str(s, c" = getelementptr [")
    emit_int(s, field.array_size as i64)
    emit_str(s, c" x ")
    if is_struct == 1
        # AGAST #188: struct-array LHS — `[N x %T]` so the GEP and the store
        # agree with the struct value being stored.
        emit_llvm_type_struct(s, TYPE_STRUCT, field.array_elem_type_name, field.array_elem_type_name_len)
    else
        emit_str(s, field_array_elem_llvm(et))
    emit_str(s, c"], ptr ")
    emit_reg(s, field_ptr)
    emit_str(s, c", i64 0, i64 ")
    emit_reg(s, idx)
    emit_str(s, c"\n")
    var sty: *u8 = c"i64"
    var sval: i32 = val
    if is_struct == 1
        # AGAST #188: `store %T %val` matches the `load %T` of the RHS.
        emit_str(s, c"  store ")
        emit_llvm_type_struct(s, TYPE_STRUCT, field.array_elem_type_name, field.array_elem_type_name_len)
        emit_str(s, c" ")
        emit_reg(s, val)
        emit_str(s, c", ptr ")
        emit_reg(s, elem_ptr)
        emit_str(s, c"\n")
        return
    if et == TYPE_F32 or et == TYPE_F64
        # AGAST #1954: `float` / `double` (field_array_elem_llvm), an f64
        # value into an f32 slot fptrunc'd, as #1973's `p[i] = v` does.
        # f32 failed closed; f64 stored `i64`, which only type-checked while
        # the `x.f[i]` read also bit-loaded an i64.
        sty = field_array_elem_llvm(et)
        sval = emit_field_elem_narrow(s, val, et, val_expr)
    else if et == TYPE_BOOL
        # An i1 register stores as-is; an i64 bool truncates.
        sty = c"i1"
        if bool_reg_is_i1(s, val_expr) == 0
            sval = next_reg(s)
            emit_str(s, c"  ")
            emit_reg(s, sval)
            emit_str(s, c" = trunc i64 ")
            emit_reg(s, val)
            emit_str(s, c" to i1\n")
    else
        # Integers / pointers at their own width (trunc / inttoptr); i64
        # elements store all 8 bytes.
        sty = array_elem_llvm(et)
        sval = emit_array_elem_narrow(s, val, et, sty)
    emit_str(s, c"  store ")
    emit_str(s, sty)
    emit_str(s, c" ")
    emit_reg(s, sval)
    emit_str(s, c", ptr ")
    emit_reg(s, elem_ptr)
    emit_str(s, c"\n")

# AGAST #1596: `x.f[i] = v` where `f` is a pointer field (`*T` / `**T`):
# load the pointer from the field slot `field_slot`, GEP by the pointee, and
# store `v` at the pointee's width. Returns 0 WITHOUT emitting anything when
# the pointee cannot be addressed at a known width (unrecorded)
# so the caller can fail closed.
fn emit_ptr_field_index_store(s: *EmitterState, field_slot: i32, field: *StructField, idx_expr: *Expr, val_expr: *Expr) -> i32
    let kind: i32 = ptr_field_elem_kind(field)
    if kind == TYPE_UNKNOWN
        return 0
    let idx: i32 = emit_expr(s, idx_expr)
    let val: i32 = emit_expr(s, val_expr)
    let elem_ptr: i32 = emit_ptr_field_elem_addr(s, field_slot, field, kind, idx)
    if kind == TYPE_STRUCT
        # Struct element: the value register is a `%T` aggregate (#188).
        emit_str(s, c"  store ")
        emit_llvm_type_struct(s, TYPE_STRUCT, field.field_type_name, field.field_type_name_len)
        emit_str(s, c" ")
        emit_reg(s, val)
    else if array_elem_typed_scalar(kind) == 1
        # AGAST #2053: `float` / `double` (ptr_field_elem_llvm); an f64
        # value into an f32 slot is fptrunc'd.  bool: `i1` (#2063).
        let typed: i32 = emit_field_elem_narrow(s, val, kind, val_expr)
        emit_str(s, c"  store ")
        emit_str(s, ptr_field_elem_llvm(kind))
        emit_str(s, c" ")
        emit_reg(s, typed)
    else
        # Narrow the i64 value to the element width (trunc / inttoptr).
        let elem_ty: *u8 = array_elem_llvm(kind)
        let narrow: i32 = emit_array_elem_narrow(s, val, kind, elem_ty)
        emit_str(s, c"  store ")
        emit_str(s, elem_ty)
        emit_str(s, c" ")
        emit_reg(s, narrow)
    emit_str(s, c", ptr ")
    emit_reg(s, elem_ptr)
    emit_str(s, c"\n")
    return 1

# AGAST #1439: `name.field = v` / `name.field[i] = v` that the fast
# STMT_LOCAL_FIELD_ASSIGN / STMT_LOCAL_FIELD_INDEX_ASSIGN lowering could not
# resolve (no such local or param, unknown struct, unknown field).  Those arms
# used to emit NOTHING — no store, no diagnostic, exit 0 — while a read of the
# same member failed closed.  Re-lower the statement as an expression
# assignment to the member `name.field` (wrapped in an index when
# `with_index` is 1), so emit_assign resolves it through emit_member_ptr like
# every other field store: a field of a GLOBAL struct gets a real GEP + store
# (`ops.n = 5`), and anything still unresolved hits emit_assign's
# emit_ir_error instead of vanishing.
fn emit_local_field_store_fallback(s: *EmitterState, stmt: *Stmt, with_index: i32)
    var fb_base: Expr
    fb_base.kind = EXPR_IDENT
    fb_base.span = stmt.span
    fb_base.ident_ptr = stmt.var_name
    fb_base.ident_len = stmt.var_name_len
    fb_base.next = null
    var fb_mem: Expr
    fb_mem.kind = EXPR_MEMBER
    fb_mem.span = stmt.span
    fb_mem.left = @fb_base
    fb_mem.ident_ptr = stmt.assign_target
    fb_mem.ident_len = stmt.assign_target_len
    fb_mem.next = null
    var fb_idx: Expr
    fb_idx.kind = EXPR_INDEX
    fb_idx.bracket.line = 0
    fb_idx.span = stmt.span
    fb_idx.left = @fb_mem
    fb_idx.right = stmt.while_cond
    fb_idx.next = null
    var fb_st: Stmt
    fb_st.kind = STMT_ASSIGN
    fb_st.span = stmt.span
    if with_index == 1
        fb_st.if_cond = @fb_idx
    else
        fb_st.if_cond = @fb_mem
    fb_st.assign_target = null
    fb_st.assign_target_len = 0
    fb_st.assign_value = stmt.assign_value
    fb_st.next = null
    emit_assign(s, @fb_st)

# AGAST #2559: the struct type of a statement-`if` arm's value, or null/0.
# The arm's last statement is its value: a trailing expression (a static
# call `B.new(..)` is typed by its callee), a `match` (emit_match published
# its phi type, #1666), or a nested statement `if` (an `else if` chain),
# which published its own.  Called right after the arm is emitted, so its
# `let`s are still in scope.
fn if_stmt_arm_agg(s: *EmitterState, list: *Stmt, out_name: **u8, out_len: *i32)
    *out_name = null
    *out_len = 0
    var last: *Stmt = list
    if last == null
        return
    while last.next != null
        last = last.next
    if last.kind == STMT_IF
        *out_name = s.last_if_stmt_agg_name
        *out_len = s.last_if_stmt_agg_name_len
        return
    if last.kind == STMT_MATCH
        *out_name = s.last_match_agg_name
        *out_len = s.last_match_agg_name_len
        return
    if last.kind != STMT_EXPR or last.expr == null
        return
    let e: *Expr = last.expr
    let lent: *LocalVar = lent_referent_local(s, e)
    if lent != null   # AGAST #2288: emit_if_stmt_arm read the referent
        *out_name = lent.type_name
        *out_len = lent.type_name_len
        return
    resolve_expr_struct_name(s, e, out_name, out_len)
    if *out_name == null
        call_result_struct_name(s, e, out_name, out_len)
    # AGAST #2950: `*r` with `r: @C` / `@&C` / `*C` loads the %C.
    if *out_name == null and e.kind == EXPR_UNARY and e.op == OP_DEREF
        deref_pointee_struct_name(s, e.operand, out_name, out_len)

# AGAST #2950: a statement-`if` arm's `@&x` value `reg` (a `ptr`) as the i64
# its phi holds, asked while the arm's `let`s are in scope.  The phi was i64
# over `ptr`s; a tail one in a `-> @&C` fn is converted back at the `ret`
# (emit_implicit_return_tail).
fn if_stmt_arm_ptr_settle(s: *EmitterState, list: *Stmt, reg: i32, agg: *u8) -> i32
    if reg <= 0 or agg != null
        return reg
    var last: *Stmt = list
    while last.next != null
        last = last.next
    if last.kind != STMT_EXPR or arm_value_is_ptr(s, last.expr) == 0
        return reg
    ptr_value_to_i64(s, last.expr, reg)

# A statement-`if` arm's statements.  AGAST #2288: a trailing `c` with
# `c:& C` is the arm's value, so it reads the referent, as in ritz0 (which
# reports a move-only C there).  It read as the pointer, so a tail `if` typed
# its phi i64 over `ptr`s.  if_stmt_arm_agg types it C.  It still goes through
# emit_stmt, whose checks refuse it in a `-> @&C` fn.
fn emit_if_stmt_arm(s: *EmitterState, list: *Stmt, ret_type: i32)
    let saved: *Stmt = s.if_arm_value
    var st: *Stmt = list
    while st != null
        if st.next == null and st.kind == STMT_EXPR
            s.if_arm_value = st
        emit_stmt(s, st, ret_type)
        s.if_arm_value = saved
        st = st.next

# AGAST #2563: the phi type a statement-`if` arm of struct type `agg` asks
# for.  The Span$u8 / StrView pair (layout-equal, #168) takes the fn's return
# type when that is one of the two, since a tail `if` feeds the implicit
# `ret`: a `"..."` arm is a %Span$u8 (#98) but a `-> StrView` fn returns
# %StrView.  Any other type is `agg` itself.
fn if_stmt_phi_type(s: *EmitterState, agg: *u8, agg_len: i32, ret_type: i32, out_name: **u8, out_len: *i32)
    *out_name = agg
    *out_len = agg_len
    if agg == null or agg_len <= 0 or ret_type != TYPE_STRUCT or s.ret_type_name_len <= 0
        return
    if is_layout_equiv_pair(agg, agg_len, s.ret_type_name, s.ret_type_name_len) == 1
        *out_name = s.ret_type_name
        *out_len = s.ret_type_name_len

# AGAST #2563: rebuild a statement-`if` arm's value `reg` of type `agg` as
# the phi's type when they are the Span$u8 / StrView pair, in the arm's own
# block before its `br` (as emit_match_arm_body does, #1662).
fn if_stmt_arm_settle(s: *EmitterState, reg: i32, agg: *u8, agg_len: i32, phi: *u8, phi_len: i32) -> i32
    if reg > 0 and is_layout_equiv_pair(agg, agg_len, phi, phi_len) == 1
        return rebuild_layout_equiv(s, reg, agg, agg_len, phi, phi_len)
    reg

# AGAST #2158: the move check and drop insertion (ownership.ritz) wrap every
# statement.  The check runs first, so a statement's moves clear their drop
# flags before it executes; `x = v` drops x's old value once v is stored.
#
# AGAST #2165: own_stmt_begin / own_stmt_end bracket it, so the temporaries
# it makes drop when it ends (an `if` / `while` condition's earlier, at
# own_cond_end).
fn emit_stmt(s: *EmitterState, stmt: *Stmt, ret_type: i32)
    let own_mark: i32 = own_stmt_begin(s)
    own_check_stmt(s, stmt)
    # AGAST #2173: and `x.f = v` drops x.f's old value.
    if stmt.kind == STMT_ASSIGN or stmt.kind == STMT_LOCAL_FIELD_ASSIGN
        var old: i32 = 0
        var old_flag: i32 = 0
        let ob: *OwnBinding = own_assign_begin(s, stmt, @old, @old_flag)
        emit_stmt_inner(s, stmt, ret_type)
        own_assign_end(s, ob, old, old_flag)
        own_stmt_end(s, own_mark)
        return
    emit_stmt_inner(s, stmt, ret_type)
    own_after_stmt(s, stmt)
    own_stmt_end(s, own_mark)

fn emit_stmt_inner(s: *EmitterState, stmt: *Stmt, ret_type: i32)
    # AGAST #2028: reject writes / `@&` into a `let` before emitting them.
    let_check_stmt(s, stmt)
    bool_check_stmt(s, stmt)   # AGAST #2342
    literal_stmt(s, stmt)      # AGAST #2341
    # AGAST #2136: an enum value where an integer is expected.
    enum_as_int_stmt(s, stmt, ret_type)
    # AGAST #2255: a procedure hands nothing back, so its `return g()` uses no
    # value.
    if stmt.kind == STMT_VAR_DECL
        s.value_source = stmt.var_init
    else if stmt.kind == STMT_RETURN and ret_type != TYPE_VOID
        s.value_source = stmt.return_value
    if stmt.kind == STMT_VAR_DECL
        let locals_before: i32 = s.local_count
        emit_var_decl(s, stmt)
        let_mark_decl(s, stmt, locals_before)
        binder_mark_decl(s, stmt, locals_before)   # AGAST #2407
        own_decl(s, stmt, locals_before)   # AGAST #2158
    else if stmt.kind == STMT_TUPLE_DECL
        emit_tuple_decl(s, stmt)   # AGAST #2574
    else if stmt.kind == STMT_DEFER
        own_defer(s, stmt, ret_type)   # AGAST #1625: runs at the block's exits
    else if stmt.kind == STMT_ASSIGN
        emit_assign(s, stmt)
    else if stmt.kind == STMT_RETURN
        # AGAST #2207: a `return` leaves the let initialiser it sits in, so the
        # let's enum context does not apply to it. With none set,
        # resolve_enum_ctx falls back to the fn's return type.
        let ret_ctx_name: *u8 = s.ctx_enum_name
        let ret_ctx_len: i32 = s.ctx_enum_name_len
        s.ctx_enum_name = null
        s.ctx_enum_name_len = 0
        emit_return(s, stmt, ret_type)
        s.ctx_enum_name = ret_ctx_name
        s.ctx_enum_name_len = ret_ctx_len
    else if stmt.kind == STMT_ASSERT
        # AGAST #1869: placement check, operand report, helper call site.
        emit_assert_stmt(s, stmt)
    else if stmt.kind == STMT_IF
        bool_check_cond(s, stmt.if_cond, c"if condition")
        let cond: i32 = emit_expr(s, stmt.if_cond)
        # If the condition register is already an i1, use it directly in the
        # br — otherwise coerce i64 -> i1 via `icmp ne ..., 0`.  Without the
        # check, `if boolvar` emits `icmp ne i64 %i1reg, 0`, which clang
        # rejects. (task-99 cluster #2)
        #
        # This used to ask `get_expr_type(...) != TYPE_BOOL`, whose comment
        # claimed "only direct bool identifiers hit this path".  They do not:
        # a bool-returning CALL also reports TYPE_BOOL while emit_expr zexts
        # its i1 to i64, so `if f()` wired an i64 into `br i1` and clang
        # rejected the module.  See bool_reg_is_i1 (AGAST #1367, #1646).
        var cond_i1: i32 = cond
        if bool_reg_is_i1(s, stmt.if_cond) == 0
            cond_i1 = next_reg(s)
            emit_str(s, c"  ")
            emit_reg(s, cond_i1)
            emit_str(s, c" = icmp ne i64 ")
            emit_reg(s, cond)
            emit_str(s, c", 0\n")

        let then_label: i32 = next_label(s)
        let else_label: i32 = next_label(s)
        let end_label: i32 = next_label(s)

        own_cond_end(s)   # AGAST #2165: the condition's temporaries
        emit_str(s, c"  br i1 ")
        emit_reg(s, cond_i1)
        emit_str(s, c", label %")
        emit_label(s, then_label)
        emit_str(s, c", label %")
        if stmt.if_else != null
            emit_label(s, else_label)
        else
            emit_label(s, end_label)
        emit_str(s, c"\n")

        # Save current last_expr_reg before entering branches.  The defining
        # label rides along so the restore path below puts back a coherent
        # (value, block) pair rather than re-dating the value to the merge
        # block. (ritz-task-1309)
        let saved_last: i32 = s.last_expr_reg
        let saved_last_label: i32 = s.last_expr_label
        let saved_last_model: i32 = s.last_expr_model

        begin_block(s, then_label)
        clear_last_expr(s)  # Reset before then branch
        # AGAST #2158: each arm is a block for drops; the move check
        # merges the arms' moved bindings (own_if_merge).
        let own_before: *i32 = own_snapshot(s)
        own_push_scope(s)
        emit_if_stmt_arm(s, stmt.if_then, ret_type)
        # AGAST #2559: the arm value's struct type, while its bindings resolve.
        var then_agg: *u8 = null
        var then_agg_len: i32 = 0
        if_stmt_arm_agg(s, stmt.if_then, @then_agg, @then_agg_len)
        let own_then_dead: i32 = own_pop_scope(s)
        let own_after_then: *i32 = own_snapshot(s)
        var own_else_dead: i32 = 0
        # ritz-task-1309 — `last_expr_here` (not `s.last_expr_reg`) so a value
        # produced in a block nested inside the then-arm, which the insertion
        # point has since left, is reported as "no value" instead of being
        # falsely attributed to `then_exit_label` below.
        var then_result: i32 = last_expr_here(s)  # Capture then branch result
        # AGAST #2563: a Span$u8 / StrView arm takes the phi's type here.
        var then_phi: *u8 = null
        var then_phi_len: i32 = 0
        if_stmt_phi_type(s, then_agg, then_agg_len, ret_type, @then_phi, @then_phi_len)
        if stmt.if_else != null
            then_result = if_stmt_arm_settle(s, then_result, then_agg, then_agg_len, then_phi, then_phi_len)
            then_result = if_stmt_arm_ptr_settle(s, stmt.if_then, then_result, then_agg)
        let then_exit_label: i32 = s.current_label  # Capture actual exit block
        emit_str(s, c"  br label %")
        emit_label(s, end_label)
        emit_str(s, c"\n")

        var else_result: i32 = 0
        var else_exit_label: i32 = else_label
        var else_agg: *u8 = null
        var else_agg_len: i32 = 0
        if stmt.if_else != null
            begin_block(s, else_label)
            clear_last_expr(s)  # Reset before else branch
            own_restore(s, own_before)
            own_push_scope(s)
            emit_if_stmt_arm(s, stmt.if_else, ret_type)
            if_stmt_arm_agg(s, stmt.if_else, @else_agg, @else_agg_len)
            own_else_dead = own_pop_scope(s)
            else_result = last_expr_here(s)  # Capture else branch result
            # AGAST #2563: the phi's type is the then-arm's when it has one.
            var else_phi: *u8 = null
            var else_phi_len: i32 = 0
            if_stmt_phi_type(s, else_agg, else_agg_len, ret_type, @else_phi, @else_phi_len)
            if then_phi != null and then_phi_len > 0
                else_phi = then_phi
                else_phi_len = then_phi_len
            else_result = if_stmt_arm_settle(s, else_result, else_agg, else_agg_len, else_phi, else_phi_len)
            else_result = if_stmt_arm_ptr_settle(s, stmt.if_else, else_result, else_agg)
            else_agg = else_phi
            else_agg_len = else_phi_len
            else_exit_label = s.current_label  # Capture actual exit block
            emit_str(s, c"  br label %")
            emit_label(s, end_label)
            emit_str(s, c"\n")

        begin_block(s, end_label)
        var own_has_else: i32 = 0
        if stmt.if_else != null
            own_has_else = 1
        own_if_merge(s, own_before, own_after_then, own_then_dead, own_has_else, own_else_dead)

        # If both branches produce values, emit a phi node.  When the
        # enclosing fn returns a tagged-enum struct, both branches hand us
        # `%Result$.../Option$...` struct values — the phi must match that
        # type or LLVM rejects the IR. (ritz-task-133)  Otherwise a struct
        # value in either arm types it (AGAST #2559): `if c / a / else / b`
        # over `%B` locals, params, literals and calls.
        var phi_agg: *u8 = null
        var phi_agg_len: i32 = 0
        if stmt.if_else != null and then_result > 0 and else_result > 0
            if ret_type == TYPE_STRUCT and s.ret_type_name_len > 0 and is_tagged_enum_type(s.ret_type_name, s.ret_type_name_len) == 1
                phi_agg = s.ret_type_name
                phi_agg_len = s.ret_type_name_len
            else if then_phi != null and then_phi_len > 0
                phi_agg = then_phi
                phi_agg_len = then_phi_len
            else if else_agg != null and else_agg_len > 0
                phi_agg = else_agg
                phi_agg_len = else_agg_len
        # AGAST #2559: publish it for an enclosing `if` ending in this one.
        s.last_if_stmt_agg_name = phi_agg
        s.last_if_stmt_agg_name_len = phi_agg_len
        if stmt.if_else != null and then_result > 0 and else_result > 0
            let phi_reg: i32 = next_reg(s)
            emit_str(s, c"  ")
            emit_reg(s, phi_reg)
            emit_str(s, c" = phi ")
            if phi_agg != null
                emit_llvm_type_struct(s, TYPE_STRUCT, phi_agg, phi_agg_len)
            else
                emit_str(s, c"i64")
            emit_str(s, c" [ ")
            emit_reg(s, then_result)
            emit_str(s, c", %")
            emit_label(s, then_exit_label)
            emit_str(s, c" ], [ ")
            emit_reg(s, else_result)
            emit_str(s, c", %")
            emit_label(s, else_exit_label)
            emit_str(s, c" ]\n")
            set_last_expr(s, phi_reg)
            if phi_agg == null
                set_last_expr_phi(s, phi_reg, 0)   # AGAST #2950: an i64
        else
            # ritz-task-1309 — no phi, so this `if` contributes no value that
            # is live in the merge block.
            #
            # There used to be a `then_result > 0` case here that propagated
            # the then-arm's value out of the merge block.  That was one of
            # the two confirmed leak paths: `then_result` is defined in the
            # then-arm's exit block, which is NOT the merge block and does not
            # dominate it (the else edge bypasses it).  An enclosing `if` then
            # picked it up as a phi incoming and named the merge block as its
            # predecessor — the exact `phi i64 [ %x, %L20 ]` shape this task
            # exists to kill.  An if-without-else genuinely has no value on
            # all paths, so there is nothing correct to propagate.
            #
            # Restore the pre-`if` value with its original defining label, so
            # the pair stays coherent: still usable by an implicit return that
            # it dominates, still correctly rejected as a phi incoming here.
            s.last_expr_reg = saved_last  # Restore if no result
            s.last_expr_label = saved_last_label
            s.last_expr_model = saved_last_model

    else if stmt.kind == STMT_WHILE
        let cond_label: i32 = next_label(s)
        let body_label: i32 = next_label(s)
        let end_label: i32 = next_label(s)

        let old_break: i32 = s.break_label
        let old_continue: i32 = s.continue_label
        s.break_label = end_label
        s.continue_label = cond_label

        emit_str(s, c"  br label %")
        emit_label(s, cond_label)
        emit_str(s, c"\n")

        begin_block(s, cond_label)
        bool_check_cond(s, stmt.while_cond, c"while condition")
        let cond: i32 = emit_expr(s, stmt.while_cond)
        # Same i1/i64 handling as STMT_IF — skip the icmp only when the
        # register genuinely is an i1.  `while f()` on a bool-returning f hit
        # the identical #1367 defect.
        var cond_i1: i32 = cond
        if bool_reg_is_i1(s, stmt.while_cond) == 0
            cond_i1 = next_reg(s)
            emit_str(s, c"  ")
            emit_reg(s, cond_i1)
            emit_str(s, c" = icmp ne i64 ")
            emit_reg(s, cond)
            emit_str(s, c", 0\n")
        own_cond_end(s)   # AGAST #2165: dropped on every evaluation
        emit_str(s, c"  br i1 ")
        emit_reg(s, cond_i1)
        emit_str(s, c", label %")
        emit_label(s, body_label)
        emit_str(s, c", label %")
        emit_label(s, end_label)
        emit_str(s, c"\n")

        begin_block(s, body_label)
        let own_loop: i32 = own_loop_enter(s)   # AGAST #2158
        own_push_scope(s)
        var body_stmt: *Stmt = stmt.while_body
        while body_stmt != null
            emit_stmt(s, body_stmt, ret_type)
            body_stmt = body_stmt.next
        own_pop_scope(s)
        own_loop_exit(s, own_loop)
        emit_str(s, c"  br label %")
        emit_label(s, cond_label)
        emit_str(s, c"\n")

        begin_block(s, end_label)
        # AGAST #1329 — a loop contributes no value; clear the tracked
        # expression so it cannot leak into the exit block (see STMT_WHILE
        # note; symmetric across while/loop/for).
        clear_last_expr(s)

        s.break_label = old_break
        s.continue_label = old_continue

    else if stmt.kind == STMT_LOOP
        # Infinite loop: loop { body }
        # Generates:
        #   br label %loop.body
        # loop.body:
        #   ... body ...
        #   br label %loop.body
        # loop.end:
        let body_label: i32 = next_label(s)
        let end_label: i32 = next_label(s)

        let old_break: i32 = s.break_label
        let old_continue: i32 = s.continue_label
        s.break_label = end_label
        s.continue_label = body_label

        emit_str(s, c"  br label %")
        emit_label(s, body_label)
        emit_str(s, c"\n")

        begin_block(s, body_label)
        let own_loop: i32 = own_loop_enter(s)   # AGAST #2158
        own_push_scope(s)
        var body_stmt: *Stmt = stmt.while_body
        while body_stmt != null
            emit_stmt(s, body_stmt, ret_type)
            body_stmt = body_stmt.next
        own_pop_scope(s)
        own_loop_exit(s, own_loop)
        emit_str(s, c"  br label %")
        emit_label(s, body_label)
        emit_str(s, c"\n")

        begin_block(s, end_label)
        # AGAST #1329 — a loop contributes no value; clear the tracked
        # expression so it cannot leak into the exit block (see STMT_WHILE
        # note; symmetric across while/loop/for).
        clear_last_expr(s)

        s.break_label = old_break
        s.continue_label = old_continue

    else if stmt.kind == STMT_FOR
        # For-loop. Two shapes:
        #   for i in start..end   — range; for_end != null
        #   for x in iterable     — array/Vec-ref; for_end == null
        if stmt.for_end == null
            emit_for_iterable(s, stmt, ret_type)
            return

        # For-loop (range): for i in start..end { body }
        # Desugar to:
        #   %i = alloca i64
        #   store i64 %start, ptr %i
        #   br label %for.cond
        # for.cond:
        #   %i.val = load i64, ptr %i
        #   %cmp = icmp slt i64 %i.val, %end
        #   br i1 %cmp, label %for.body, label %for.end
        # for.body:
        #   ... body ...
        #   %i.next = add i64 %i.val, 1
        #   store i64 %i.next, ptr %i
        #   br label %for.cond
        # for.end:

        let cond_label: i32 = next_label(s)
        let body_label: i32 = next_label(s)
        let incr_label: i32 = next_label(s)
        let end_label: i32 = next_label(s)

        let old_break: i32 = s.break_label
        let old_continue: i32 = s.continue_label
        s.break_label = end_label
        s.continue_label = incr_label

        # Allocate loop variable
        let var_reg: i32 = next_reg(s)
        emit_str(s, c"  ")
        emit_reg(s, var_reg)
        emit_str(s, c" = alloca i64\n")

        # Register the loop variable
        add_local(s, stmt.for_var, stmt.for_var_len, var_reg, TYPE_I64)

        # Emit start expression and store it
        let start_reg: i32 = emit_expr(s, stmt.for_start)
        emit_str(s, c"  store i64 ")
        emit_reg(s, start_reg)
        emit_str(s, c", ptr ")
        emit_reg(s, var_reg)
        emit_str(s, c"\n")

        # Branch to condition check
        emit_str(s, c"  br label %")
        emit_label(s, cond_label)
        emit_str(s, c"\n")

        # Condition block
        begin_block(s, cond_label)
        let load_reg: i32 = next_reg(s)
        emit_str(s, c"  ")
        emit_reg(s, load_reg)
        emit_str(s, c" = load i64, ptr ")
        emit_reg(s, var_reg)
        emit_str(s, c"\n")

        let end_reg: i32 = emit_expr(s, stmt.for_end)
        let cmp_reg: i32 = next_reg(s)
        emit_str(s, c"  ")
        emit_reg(s, cmp_reg)
        # `start..=end` (AGAST #1530) keeps iterating while i <= end.
        if stmt.for_inclusive != 0
            emit_str(s, c" = icmp sle i64 ")
        else
            emit_str(s, c" = icmp slt i64 ")
        emit_reg(s, load_reg)
        emit_str(s, c", ")
        emit_reg(s, end_reg)
        emit_str(s, c"\n")
        emit_str(s, c"  br i1 ")
        emit_reg(s, cmp_reg)
        emit_str(s, c", label %")
        emit_label(s, body_label)
        emit_str(s, c", label %")
        emit_label(s, end_label)
        emit_str(s, c"\n")

        # Body block
        begin_block(s, body_label)
        let own_loop: i32 = own_loop_enter(s)   # AGAST #2158
        own_push_scope(s)
        var body_stmt: *Stmt = stmt.for_body
        while body_stmt != null
            emit_stmt(s, body_stmt, ret_type)
            body_stmt = body_stmt.next
        own_pop_scope(s)
        own_loop_exit(s, own_loop)
        emit_str(s, c"  br label %")
        emit_label(s, incr_label)
        emit_str(s, c"\n")

        # Increment block
        begin_block(s, incr_label)
        let load2_reg: i32 = next_reg(s)
        emit_str(s, c"  ")
        emit_reg(s, load2_reg)
        emit_str(s, c" = load i64, ptr ")
        emit_reg(s, var_reg)
        emit_str(s, c"\n")
        let incr_reg: i32 = next_reg(s)
        emit_str(s, c"  ")
        emit_reg(s, incr_reg)
        emit_str(s, c" = add i64 ")
        emit_reg(s, load2_reg)
        emit_str(s, c", 1\n")
        emit_str(s, c"  store i64 ")
        emit_reg(s, incr_reg)
        emit_str(s, c", ptr ")
        emit_reg(s, var_reg)
        emit_str(s, c"\n")
        emit_str(s, c"  br label %")
        emit_label(s, cond_label)
        emit_str(s, c"\n")

        # End block
        begin_block(s, end_label)
        # AGAST #1329 — a loop contributes no value; clear the tracked
        # expression so it cannot leak into the exit block (see STMT_WHILE
        # note; symmetric across while/loop/for).
        clear_last_expr(s)

        s.break_label = old_break
        s.continue_label = old_continue

    else if stmt.kind == STMT_BREAK
        if s.break_label >= 0
            own_loop_jump(s, 0)   # AGAST #2158: drop the loop body's bindings
            emit_str(s, c"  br label %")
            emit_label(s, s.break_label)
            emit_str(s, c"\n")
            let dead_label: i32 = next_label(s)
            # `begin_block` makes the dead block the active insertion
            # point, so the enclosing IF/loop captures the right
            # `current_label` when building PHI predecessor labels.
            # Without this, then/else_exit labels point at the pre-break
            # block which isn't actually a CFG predecessor of the merge —
            # LLVM's "Remove unreachable blocks" pass then crashes when it
            # tries to remove the real (dead) predecessor from the PHI.
            # (ritz-task-195)
            begin_block(s, dead_label)
            clear_last_expr(s)

    else if stmt.kind == STMT_CONTINUE
        if s.continue_label >= 0
            own_loop_jump(s, 1)   # AGAST #2158
            emit_str(s, c"  br label %")
            emit_label(s, s.continue_label)
            emit_str(s, c"\n")
            let dead_label: i32 = next_label(s)
            # Same rationale as STMT_BREAK above. (ritz-task-195)
            begin_block(s, dead_label)
            clear_last_expr(s)

    else if stmt.kind == STMT_EXPR
        # Note: Implicit return only at function body level, not in nested blocks
        # The implicit_return flag would be passed from emit_fn for top-level statements
        # For now, we just emit the expression without implicit return in nested contexts
        if stmt.expr == null
            eprints_cstr(c"ERROR: STMT_EXPR with null expr field!\n")
        else
            # AGAST #2046: a match / if expression statement's value is
            # discarded, so a void-call arm is legal there.
            if stmt.expr.kind == EXPR_MATCH or stmt.expr.kind == EXPR_IF
                s.match_no_value = 1
            # AGAST #2137: only a block's last statement can be its value.
            if stmt.next != null
                must_use_check(s, stmt.expr)
            else
                own_check_lent_value_stmt(s, stmt.expr)   # AGAST #2949
            var expr_reg: i32 = 0
            let lent: *LocalVar = lent_referent_local(s, stmt.expr)
            if stmt == s.if_arm_value and lent != null
                # AGAST #2288: an if arm's value (emit_if_stmt_arm).
                expr_reg = emit_lent_referent(s, stmt.expr, lent.type_name, lent.type_name_len)
            else if builtin_tagged_ctor(s, stmt.expr) == 1
                expr_reg = emit_ctor_stmt(s, stmt.expr)   # AGAST #2454
            else
                expr_reg = emit_expr(s, stmt.expr)
            set_last_expr(s, expr_reg)  # Track for if/else phi nodes
    else if stmt.kind == STMT_MATCH
        # Statement-form match: `match scrut \n pattern => body ...`
        # The statement's result is tracked in last_expr_reg so an implicit
        # return picks up the phi value. See emitter_match.ritz.
        let arms: *MatchArm = stmt.if_then as *MatchArm
        s.match_no_value = 1   # AGAST #2046: void-call arms are legal here
        let match_reg: i32 = emit_match(s, stmt.if_cond, arms, stmt.span)
        set_last_expr(s, match_reg)
        # AGAST #2950: its phi is a `ptr` or an i64 (emit_match_phi_type).
        if match_reg > 0 and s.last_match_agg_name == null and s.last_match_float_ty == 0
            set_last_expr_phi(s, match_reg, arms_ptr_valued(s, arms))
    else if stmt.kind == STMT_LOCAL_FIELD_ASSIGN
        # local_var.field = value
        # stmt.var_name = variable name
        # stmt.assign_target = field name
        # stmt.assign_value = value expression
        var lfa_done: i32 = 0
        let loc: *LocalVar = find_local_struct_name(s, stmt.var_name, stmt.var_name_len)
        if loc != null
            let st: *StructDef = find_struct(s, loc.type_name, loc.type_name_len)
            if st != null
                let field_idx: i32 = find_field_index(st, stmt.assign_target, stmt.assign_target_len)
                if field_idx >= 0
                    let field: *StructField = get_field_type(st, field_idx)
                    lfa_done = 1
                    # Get the base pointer - differs for TYPE_PTR/TYPE_REF/TYPE_MUT_REF vs TYPE_STRUCT
                    var base_ptr_reg: i32 = loc.reg
                    let lfa_levels: i32 = local_struct_levels(loc)
                    if lfa_levels > 0
                        # Load the pointer value, then convert to ptr
                        let loaded: i32 = next_reg(s)
                        emit_str(s, c"  ")
                        emit_reg(s, loaded)
                        emit_str(s, c" = load i64, ptr ")
                        emit_reg(s, loc.reg)
                        emit_str(s, c"\n")
                        base_ptr_reg = next_reg(s)
                        emit_str(s, c"  ")
                        emit_reg(s, base_ptr_reg)
                        emit_str(s, c" = inttoptr i64 ")
                        emit_reg(s, loaded)
                        emit_str(s, c" to ptr\n")
                        base_ptr_reg = emit_load_levels(s, base_ptr_reg, lfa_levels - 1)   # AGAST #2372
                    # Get pointer to the field using GEP
                    let field_ptr: i32 = next_reg(s)
                    emit_str(s, c"  ")
                    emit_reg(s, field_ptr)
                    emit_str(s, c" = getelementptr %")
                    emit_name(s, st.name, st.name_len)
                    emit_str(s, c", ptr ")
                    emit_reg(s, base_ptr_reg)
                    emit_str(s, c", i32 0, i32 ")
                    emit_int(s, field_idx as i64)
                    emit_str(s, c"\n")
                    # AGAST #1934: `x.f = [..]` / `p.f = [v; N]` on an inline
                    # array field.  The generic store below would write the
                    # ADDRESS of emit_expr's shadow alloca into the field.
                    if field.field_type == TYPE_ARRAY
                        emit_array_field_whole_assign(s, field_ptr, field, stmt.assign_value)
                        return
                    # Emit the value.  AGAST #2142: `f.cmap = None` builds
                    # the field's enum.
                    let val_reg: i32 = emit_expr_into_field(s, stmt.assign_value, field)
                    # Store the value based on field type.
                    #
                    # AGAST #1303: narrow fields (u8/i8/u16/i16) used to fall
                    # through to the `store i64` default below.  Values are i64
                    # in the unified value model, so an 8-byte store into a
                    # 1- or 2-byte field silently clobbered every adjacent
                    # field.  `30_find`'s `opts.type_filter = 'f'` (u8) wiped
                    # the following `maxdepth: i32` from -1 to 0, so find
                    # printed the root and never descended — well-typed,
                    # compiled clean, exit 0, wrong behaviour.  Truncate to the
                    # field width before storing, as the other member-assign
                    # paths already do.
                    #
                    # AGAST #2048: f32 / f64 fields store float / double.
                    if emit_float_field_store(s, field_ptr, field.field_type, val_reg, stmt.assign_value) == 1
                        lfa_done = 1
                    else if field.field_type == TYPE_I32 or field.field_type == TYPE_U32
                        let trunc: i32 = next_reg(s)
                        emit_str(s, c"  ")
                        emit_reg(s, trunc)
                        emit_str(s, c" = trunc i64 ")
                        emit_reg(s, val_reg)
                        emit_str(s, c" to i32\n")
                        emit_str(s, c"  store i32 ")
                        emit_reg(s, trunc)
                        emit_str(s, c", ptr ")
                        emit_reg(s, field_ptr)
                        emit_str(s, c"\n")
                    else if field.field_type == TYPE_I16 or field.field_type == TYPE_U16
                        let trunc16: i32 = next_reg(s)
                        emit_str(s, c"  ")
                        emit_reg(s, trunc16)
                        emit_str(s, c" = trunc i64 ")
                        emit_reg(s, val_reg)
                        emit_str(s, c" to i16\n")
                        emit_str(s, c"  store i16 ")
                        emit_reg(s, trunc16)
                        emit_str(s, c", ptr ")
                        emit_reg(s, field_ptr)
                        emit_str(s, c"\n")
                    else if field.field_type == TYPE_I8 or field.field_type == TYPE_U8
                        let trunc8: i32 = next_reg(s)
                        emit_str(s, c"  ")
                        emit_reg(s, trunc8)
                        emit_str(s, c" = trunc i64 ")
                        emit_reg(s, val_reg)
                        emit_str(s, c" to i8\n")
                        emit_str(s, c"  store i8 ")
                        emit_reg(s, trunc8)
                        emit_str(s, c", ptr ")
                        emit_reg(s, field_ptr)
                        emit_str(s, c"\n")
                    else if field.field_type == TYPE_BOOL
                        let trunc1: i32 = next_reg(s)
                        emit_str(s, c"  ")
                        emit_reg(s, trunc1)
                        emit_str(s, c" = trunc i64 ")
                        emit_reg(s, val_reg)
                        emit_str(s, c" to i1\n")
                        emit_str(s, c"  store i1 ")
                        emit_reg(s, trunc1)
                        emit_str(s, c", ptr ")
                        emit_reg(s, field_ptr)
                        emit_str(s, c"\n")
                    else if field.field_type == TYPE_PTR or field.field_type == TYPE_PTR_PTR or field.field_type == TYPE_REF or field.field_type == TYPE_MUT_REF
                        # AGAST #1652: `h.p = s` with `s: @&S` is already a `ptr`,
                        # and so is `h.r = @&a` into an `@&[N]T` (#2329).
                        let ival: i32 = ptr_value_to_i64(s, stmt.assign_value, val_reg)
                        let ptr_val: i32 = next_reg(s)
                        emit_str(s, c"  ")
                        emit_reg(s, ptr_val)
                        emit_str(s, c" = inttoptr i64 ")
                        emit_reg(s, ival)
                        emit_str(s, c" to ptr\n")
                        emit_str(s, c"  store ptr ")
                        emit_reg(s, ptr_val)
                        emit_str(s, c", ptr ")
                        emit_reg(s, field_ptr)
                        emit_str(s, c"\n")
                    else if field.field_type == TYPE_STRUCT and field.field_type_name_len > 0
                        # Struct field - store as struct type.  A bare "..."
                        # is a %Span$u8: a StrView field needs it rebuilt as
                        # %StrView first, as a struct literal does (#2412).
                        let agg: i32 = coerce_struct_ret_value(s, stmt.assign_value, val_reg, field.field_type_name, field.field_type_name_len)
                        emit_str(s, c"  store %")
                        emit_name(s, field.field_type_name, field.field_type_name_len)
                        emit_str(s, c" ")
                        emit_reg(s, agg)
                        emit_str(s, c", ptr ")
                        emit_reg(s, field_ptr)
                        emit_str(s, c"\n")
                    else
                        emit_str(s, c"  store i64 ")
                        emit_reg(s, val_reg)
                        emit_str(s, c", ptr ")
                        emit_reg(s, field_ptr)
                        emit_str(s, c"\n")
        # AGAST #1439: unresolved here -> shared member-store path.
        if lfa_done == 0
            emit_local_field_store_fallback(s, stmt, 0)
    else if stmt.kind == STMT_LOCAL_FIELD_INDEX_ASSIGN and local_field_nd_shape(s, stmt) != null
        # AGAST #2097: `s.m[i] = v` with m an N-D field assigns a whole row
        # (`s.m[i][j] = v` is an expression assignment, see emit_assign).
        emit_nd_error(s, stmt.span.line, stmt.span.col, c"assigning a row or a whole struct element of a multi-dimensional array is not supported in ritz1 (assign each element or field)")
    else if stmt.kind == STMT_LOCAL_FIELD_INDEX_ASSIGN
        # local_var.field[index] = value
        # stmt.var_name = variable name
        # stmt.assign_target = field name
        # stmt.while_cond = index expression (reused)
        # stmt.assign_value = value expression
        var lfia_done: i32 = 0
        let loc: *LocalVar = find_local_struct_name(s, stmt.var_name, stmt.var_name_len)
        if loc != null
            let st: *StructDef = find_struct(s, loc.type_name, loc.type_name_len)
            if st != null
                let field_idx: i32 = find_field_index(st, stmt.assign_target, stmt.assign_target_len)
                # AGAST #1596: a pointer field is not an inline array — the
                # arm below GEP'd the field slot itself and wrote INTO the
                # struct. Leave lfia_done = 0 so the fallback lowers it via
                # emit_assign, which loads the pointer and indexes through it.
                var lfia_field_is_ptr: i32 = 0
                if field_idx >= 0
                    let pf: *StructField = get_field_type(st, field_idx)
                    if pf.field_type == TYPE_PTR or pf.field_type == TYPE_PTR_PTR
                        lfia_field_is_ptr = 1
                    # AGAST #2329: nor is an `@[N]T` / `@&[N]T` one, which
                    # lower_ref_fields leaves a reference.  `h.r[1] = 7` wrote
                    # into h.
                    if pf.ptr_array != null
                        lfia_field_is_ptr = 1
                    # AGAST #2564: nor is a Vec, Span or String held by value:
                    # emit_assign stores `t.v[i] = x` through its buffer, as
                    # index_through takes it.  `t.v[1] = 7` through a `t: @&T`
                    # wrote 7 into the Vec's len, SILENT, and a struct element
                    # was a `store i64` of a `%E` (invalid IR).
                    if pf.field_type == TYPE_STRUCT and name_is_indexable(pf.field_type_name, pf.field_type_name_len) == 1
                        lfia_field_is_ptr = 1
                if field_idx >= 0 and lfia_field_is_ptr == 0
                    let field: *StructField = get_field_type(st, field_idx)
                    lfia_done = 1
                    # Get the base pointer - differs for TYPE_PTR/TYPE_REF/TYPE_MUT_REF vs TYPE_STRUCT
                    var base_ptr_reg: i32 = loc.reg
                    let lfia_levels: i32 = local_struct_levels(loc)
                    if lfia_levels > 0
                        # Load the pointer value, then convert to ptr
                        let loaded: i32 = next_reg(s)
                        emit_str(s, c"  ")
                        emit_reg(s, loaded)
                        emit_str(s, c" = load i64, ptr ")
                        emit_reg(s, loc.reg)
                        emit_str(s, c"\n")
                        base_ptr_reg = next_reg(s)
                        emit_str(s, c"  ")
                        emit_reg(s, base_ptr_reg)
                        emit_str(s, c" = inttoptr i64 ")
                        emit_reg(s, loaded)
                        emit_str(s, c" to ptr\n")
                        base_ptr_reg = emit_load_levels(s, base_ptr_reg, lfia_levels - 1)   # AGAST #2372
                    # First GEP to get the field (array within struct)
                    let field_ptr: i32 = next_reg(s)
                    emit_str(s, c"  ")
                    emit_reg(s, field_ptr)
                    emit_str(s, c" = getelementptr %")
                    emit_name(s, st.name, st.name_len)
                    emit_str(s, c", ptr ")
                    emit_reg(s, base_ptr_reg)
                    emit_str(s, c", i32 0, i32 ")
                    emit_int(s, field_idx as i64)
                    emit_str(s, c"\n")
                    # Emit index expression
                    let idx_reg: i32 = emit_expr(s, stmt.while_cond)
                    # Emit value expression
                    let val_reg: i32 = emit_expr_into_slot(s, stmt.assign_value, field.array_elem_type, field.array_elem_type_name, field.array_elem_type_name_len)   # AGAST #2454
                    emit_field_array_elem_store(s, field_ptr, field, idx_reg, val_reg, stmt.assign_value)
        # AGAST #1439: unresolved here -> shared member-store path.
        if lfia_done == 0
            emit_local_field_store_fallback(s, stmt, 1)
    else if stmt.kind == STMT_INDEX_ASSIGN and emit_through_index_assign(s, stmt) == 1
        # AGAST #2440: `p[i] = v` through a reference or pointer.
        return
    else if stmt.kind == STMT_INDEX_ASSIGN and nd_array_name_shape(s, stmt.assign_target, stmt.assign_target_len) != null
        # AGAST #1509: `g[i] = v` with g multi-dimensional assigns a whole
        # row (`g[i][j] = v` is an expression assignment, see emit_assign).
        emit_nd_error(s, stmt.span.line, stmt.span.col, c"assigning a row or a whole struct element of a multi-dimensional array is not supported in ritz1 (assign each element or field)")
    else if stmt.kind == STMT_INDEX_ASSIGN and array_ptr_named(s, stmt.assign_target, stmt.assign_target_len) != null
        # AGAST #2321: refused, as ritz0 refuses a scalar here.  It stored an i64
        # at stride 8: past the element, and past the array at the top end.
        # ritz0 takes a whole `[N]T` at stride `[N]T`, against its own read, so
        # that isn't lowered either (#2330).
        emit_nd_error(s, stmt.span.line, stmt.span.col, c"`p[i] = v` through a pointer to an array is refused (`*p = a` stores the whole array)")
    else if stmt.kind == STMT_INDEX_ASSIGN
        # name[index] = value (array or pointer index assignment)
        # stmt.assign_target = base variable name (as *u8)
        # stmt.assign_target_len = name length
        # stmt.while_cond = index expression (reused field)
        # stmt.assign_value = value expression
        let base_reg: i32 = find_local(s, stmt.assign_target, stmt.assign_target_len)
        let base_type: i32 = find_local_type(s, stmt.assign_target, stmt.assign_target_len)
        let local: *LocalVar = find_local_struct_name(s, stmt.assign_target, stmt.assign_target_len)
        if base_reg >= 0
            if base_type == TYPE_ARRAY and local != null
                # Array local - use GEP [0, index] to get element
                let idx_reg: i32 = emit_expr(s, stmt.while_cond)
                let val_reg: i32 = emit_expr_into_slot(s, stmt.assign_value, local.array_elem_type, local.type_name, local.type_name_len)   # AGAST #2454
                let elem_ptr: i32 = next_reg(s)
                emit_str(s, c"  ")
                emit_reg(s, elem_ptr)
                emit_str(s, c" = getelementptr [")
                emit_int(s, local.array_size as i64)
                emit_str(s, c" x ")
                # AGAST #1564: every non-struct element uses the alloca's own
                # spelling (array_elem_llvm); u32/u16/i16 used to fall to i64.
                let elem_ty: *u8 = local_array_elem_llvm(local.array_elem_type)
                if local.array_elem_type == TYPE_STRUCT and local.type_name_len > 0
                    # AGAST #190: struct-array LHS — emit `[N x %T]` so the
                    # GEP and the store agree with the actual element layout.
                    # Mirrors #188's STMT_LOCAL_FIELD_INDEX_ASSIGN fix but on
                    # the simpler "local IS the array" path (no enclosing
                    # struct member).  Surfaces in nexus encode_page where
                    # `var fields: [2]DbField; fields[i] = db_field(...)`
                    # was emitting `[2 x i64]` GEP / `store i64 %DbField`.
                    emit_llvm_type_struct(s, TYPE_STRUCT, local.type_name, local.type_name_len)
                else
                    emit_str(s, elem_ty)
                emit_str(s, c"], ptr ")
                emit_reg(s, base_reg)
                emit_str(s, c", i64 0, i64 ")
                emit_reg(s, idx_reg)
                emit_str(s, c"\n")
                if local.array_elem_type == TYPE_STRUCT and local.type_name_len > 0
                    # AGAST #190: struct-array element store — `store %T %val`
                    # matches the value loaded/returned as the element struct
                    # type (e.g. `%DbField` from `call %DbField @db_field(..)`).
                    emit_str(s, c"  store ")
                    emit_llvm_type_struct(s, TYPE_STRUCT, local.type_name, local.type_name_len)
                    emit_str(s, c" ")
                    emit_reg(s, val_reg)
                else
                    # Store at the element width: narrow ints truncate, pointers
                    # convert back to ptr, i64 stores as-is; an f64 value into
                    # an f32 element is fptrunc'd (#1966).
                    var store_val: i32 = val_reg
                    if array_elem_typed_scalar(local.array_elem_type) == 1
                        store_val = emit_field_elem_narrow(s, val_reg, local.array_elem_type, stmt.assign_value)
                    else
                        store_val = emit_array_elem_narrow(s, val_reg, local.array_elem_type, elem_ty)
                    emit_str(s, c"  store ")
                    emit_str(s, elem_ty)
                    emit_str(s, c" ")
                    emit_reg(s, store_val)
                emit_str(s, c", ptr ")
                emit_reg(s, elem_ptr)
                emit_str(s, c"\n")
            else
                # Pointer local — load the i64 slot, convert to ptr, then
                # GEP + store at the POINTEE's width (AGAST #1332; this was
                # hardcoded `getelementptr i64` + `store i64` for every
                # non-** pointer, byte-smearing *i32/*u8 stores).
                let loaded_i64: i32 = next_reg(s)
                emit_str(s, c"  ")
                emit_reg(s, loaded_i64)
                emit_str(s, c" = load i64, ptr ")
                emit_reg(s, base_reg)
                emit_str(s, c"\n")
                let base_ptr: i32 = next_reg(s)
                emit_str(s, c"  ")
                emit_reg(s, base_ptr)
                emit_str(s, c" = inttoptr i64 ")
                emit_reg(s, loaded_i64)
                emit_str(s, c" to ptr\n")
                var pointee: i32 = TYPE_UNKNOWN
                if local != null
                    pointee = local.pointee_type
                emit_index_assign_ptr_store(s, stmt, base_ptr, base_type, pointee)
        else
            # AGAST #1332: GLOBAL pointer base.  Previously `base_reg >= 0`
            # had no else, so `g[i] = v` through a global *T / **T emitted
            # NO store at all — a silent drop that read back as malloc
            # garbage (7/8–8/8 mismatches in 92_subscript_store).
            let glob: *GlobalVarDef = find_global(s, stmt.assign_target, stmt.assign_target_len)
            if glob != null and glob.var_type == TYPE_ARRAY and glob.array_elem_type == TYPE_STRUCT and glob.array_elem_type_name_len > 0
                # AGAST #1553/#1555: a whole struct element (`g[i] = q`,
                # `g_slot[2] = *v`, `g[i] = g[j]`). The value is a %T struct
                # value, so GEP the `[N x %T]` global and `store %T` — the
                # global form of the local-array struct arm (#190) above.
                # Previously this fell to the pointer arm below: `load i64
                # @g` as a base address and `store i64 %T-value` (bad IR).
                let sidx: i32 = emit_expr(s, stmt.while_cond)
                let sval: i32 = emit_expr_into_slot(s, stmt.assign_value, TYPE_STRUCT, glob.array_elem_type_name, glob.array_elem_type_name_len)   # AGAST #2454
                let sptr: i32 = next_reg(s)
                emit_str(s, c"  ")
                emit_reg(s, sptr)
                emit_str(s, c" = getelementptr [")
                emit_int(s, glob.array_size as i64)
                emit_str(s, c" x ")
                emit_llvm_type_struct(s, TYPE_STRUCT, glob.array_elem_type_name, glob.array_elem_type_name_len)
                emit_str(s, c"], ptr @")
                emit_name(s, glob.name, glob.name_len)
                emit_str(s, c", i64 0, i64 ")
                emit_reg(s, sidx)
                emit_str(s, c"\n")
                emit_str(s, c"  store ")
                emit_llvm_type_struct(s, TYPE_STRUCT, glob.array_elem_type_name, glob.array_elem_type_name_len)
                emit_str(s, c" ")
                emit_reg(s, sval)
                emit_str(s, c", ptr ")
                emit_reg(s, sptr)
                emit_str(s, c"\n")
            else if glob != null and glob.var_type == TYPE_ARRAY and glob.array_elem_type != TYPE_STRUCT
                # AGAST #1504: a global `[N]T` array is the storage itself,
                # not a pointer slot. The pointer arm below loaded g[0] as a
                # base address and stored through it (segfault). GEP @g
                # directly, at the width the global is declared with.
                let gidx: i32 = emit_expr(s, stmt.while_cond)
                let gval: i32 = emit_expr(s, stmt.assign_value)
                let gty: *u8 = global_array_elem_llvm(glob)
                let gptr: i32 = next_reg(s)
                emit_str(s, c"  ")
                emit_reg(s, gptr)
                emit_str(s, c" = getelementptr [")
                emit_int(s, glob.array_size as i64)
                emit_str(s, c" x ")
                emit_str(s, gty)
                emit_str(s, c"], ptr @")
                emit_name(s, glob.name, glob.name_len)
                emit_str(s, c", i64 0, i64 ")
                emit_reg(s, gidx)
                emit_str(s, c"\n")
                # Values are carried as i64: narrow ints truncate, pointers
                # convert back to ptr, i64 stores as-is.
                let get: i32 = glob.array_elem_type
                var gstore: i32 = gval
                if get == TYPE_PTR or get == TYPE_PTR_PTR
                    gstore = next_reg(s)
                    emit_str(s, c"  ")
                    emit_reg(s, gstore)
                    emit_str(s, c" = inttoptr i64 ")
                    emit_reg(s, gval)
                    emit_str(s, c" to ptr\n")
                else if get == TYPE_U8 or get == TYPE_I8 or get == TYPE_U16 or get == TYPE_I16 or get == TYPE_U32 or get == TYPE_I32
                    gstore = next_reg(s)
                    emit_str(s, c"  ")
                    emit_reg(s, gstore)
                    emit_str(s, c" = trunc i64 ")
                    emit_reg(s, gval)
                    emit_str(s, c" to ")
                    emit_str(s, gty)
                    emit_str(s, c"\n")
                else if array_elem_typed_scalar(get) == 1
                    # AGAST #1970: a float / double slot; an f64 value into
                    # an f32 element is fptrunc'd, as for a local array.  A
                    # bool element is an `i1` (#2063).
                    gstore = emit_field_elem_narrow(s, gval, get, stmt.assign_value)
                emit_str(s, c"  store ")
                emit_str(s, gty)
                emit_str(s, c" ")
                emit_reg(s, gstore)
                emit_str(s, c", ptr ")
                emit_reg(s, gptr)
                emit_str(s, c"\n")
            else if glob != null
                # Globals of pointer type are stored as i64 (emit_llvm_type):
                # load the slot, convert to ptr, then share the pointee-width
                # store path with the local arm.
                let gloaded: i32 = next_reg(s)
                emit_str(s, c"  ")
                emit_reg(s, gloaded)
                emit_str(s, c" = load i64, ptr @")
                emit_name(s, glob.name, glob.name_len)
                emit_str(s, c"\n")
                let gbase_ptr: i32 = next_reg(s)
                emit_str(s, c"  ")
                emit_reg(s, gbase_ptr)
                emit_str(s, c" = inttoptr i64 ")
                emit_reg(s, gloaded)
                emit_str(s, c" to ptr\n")
                emit_index_assign_ptr_store(s, stmt, gbase_ptr, glob.var_type, glob.pointee_type)
    else if stmt.kind == STMT_MEMBER_ASSIGN
        # `(*X).field = value` (and the desugared `(*X).field op= value`):
        # stmt.if_cond = X, stmt.assign_target = field name,
        # stmt.assign_value = value expression.
        #
        # AGAST #1510: lower as an expression assignment to the member
        # `(*X).field`, so emit_assign resolves it through emit_member_ptr
        # like every other field store.  The old inline lowering only knew a
        # bare-identifier X; for `(**pp).n = v` or `(*(*b).ops).n = v` it
        # evaluated X and then emitted NO store and no error -- the write was
        # silently dropped.  An unresolvable X now fails loudly in
        # emit_assign ("unhandled EXPR_MEMBER in assignment").
        var mdr: Expr
        mdr.kind = EXPR_UNARY
        mdr.span = stmt.span
        mdr.op = OP_DEREF
        mdr.operand = stmt.if_cond
        mdr.next = null
        var mmem: Expr
        mmem.kind = EXPR_MEMBER
        mmem.span = stmt.span
        mmem.left = @mdr
        mmem.ident_ptr = stmt.assign_target
        mmem.ident_len = stmt.assign_target_len
        mmem.next = null
        var mst: Stmt
        mst.kind = STMT_ASSIGN
        mst.span = stmt.span
        mst.if_cond = @mmem
        mst.assign_target = null
        mst.assign_target_len = 0
        mst.assign_value = stmt.assign_value
        mst.next = null
        emit_assign(s, @mst)
    else if stmt.kind == STMT_MEMBER_INDEX_ASSIGN
        # `(*X).field[i] = value` (and the desugared `op=` form):
        # stmt.if_cond = X, stmt.assign_target = field name,
        # stmt.while_cond = index, stmt.assign_value = value.
        #
        # AGAST #1927: this kind had no arm, so it failed with "unhandled
        # statement kind 8" even outside a generic fn.  Lower it like
        # STMT_MEMBER_ASSIGN above, as an expression assignment to
        # `(*X).field[i]`; emit_assign resolves the element through
        # emit_member_ptr (inline array fields at their declared width,
        # pointer fields through the loaded pointer).
        var xdr: Expr
        xdr.kind = EXPR_UNARY
        xdr.span = stmt.span
        xdr.op = OP_DEREF
        xdr.operand = stmt.if_cond
        xdr.next = null
        var xmem: Expr
        xmem.kind = EXPR_MEMBER
        xmem.span = stmt.span
        xmem.left = @xdr
        xmem.ident_ptr = stmt.assign_target
        xmem.ident_len = stmt.assign_target_len
        xmem.next = null
        var xidx: Expr
        xidx.kind = EXPR_INDEX
        xidx.bracket.line = 0
        xidx.span = stmt.span
        xidx.left = @xmem
        xidx.right = stmt.while_cond
        xidx.next = null
        var xst: Stmt
        xst.kind = STMT_ASSIGN
        xst.span = stmt.span
        xst.if_cond = @xidx
        xst.assign_target = null
        xst.assign_target_len = 0
        xst.assign_value = stmt.assign_value
        xst.next = null
        emit_assign(s, @xst)
    else if stmt.kind == STMT_STRIPPED
        # G9b: only an imported, non-generic fn has this body, and those are
        # declared, never defined.  Reaching here means a body the importer
        # instantiates (generic) was stripped: refuse, don't emit `ret 0`.
        emit_ir_error(s, c"body stripped from an imported module interface (G9b)")
    else
        # AGAST #1813: this was an IR comment and exit 0,
        # so the statement silently vanished (the #1369 class).
        emit_ir_error_kind(s, c"unhandled statement kind ", stmt.kind)

# =============================================================================
# Function Emission
# =============================================================================

