import emitter_expr_access

# resolve_member_chain_field moved to emitter_core (AGAST #1660) so the
# binary-op emitter can type enum-valued member operands too.

# int_to_float_slot / expr_is_definitely_int moved to emitter_expr (AGAST
# #2065) so emit_field_elem_narrow can convert integer values too.

# AGAST #4407: the type an unannotated `let` / `var` takes, as the inference
# below works it out, held for the length of that declaration's lowering.
#
# These are the only type facts the emitter computes.  Each inference arm used
# to write its answer into the Stmt (`stmt.var_type = ...`, 267 writes) and the
# next arm read it back, so one node carried both the parser's facts and the
# emitter's.  Sema's checks and emit_tagged_enum_scan_stmts read the Stmt too,
# before lowering: they see the parser's values, and this struct keeps them
# that way.  The parser still writes these Stmt fields for an annotated decl
# (capture_var_type) and for monomorph / async_lower, so they stay on the node;
# nothing below writes them any more (tools/test_ritz1_stmt_writeback_freeze.py
# holds that line).
struct DeclTy
    var_type: TypeKind
    var_type_name: *u8
    var_type_name_len: i32
    var_array_size: i32
    var_array_elem_type: TypeKind
    var_array_elem_pointee: TypeKind
    var_array_shape: *ArrayShape
    var_array: *ArrayElem
    var_pointee_type: TypeKind
    var_inner_pointee_type: i32
    var_inner_ref: i32
    var_pointee_array_size: i32
    var_pointee_array_elem_type: TypeKind
    var_pointee_array_elem_pointee: TypeKind
    var_pointee_array_shape: *ArrayShape

# The parser's facts, where the inference starts.
fn decl_ty_from(stmt: *Stmt, dt: *DeclTy)
    dt.var_type = stmt.var_type
    dt.var_type_name = stmt.var_type_name
    dt.var_type_name_len = stmt.var_type_name_len
    dt.var_array_size = stmt.var_array_size
    dt.var_array_elem_type = stmt.var_array_elem_type
    dt.var_array_elem_pointee = stmt.var_array_elem_pointee
    dt.var_array_shape = stmt.var_array_shape
    dt.var_array = stmt.var_array
    dt.var_pointee_type = stmt.var_pointee_type
    dt.var_inner_pointee_type = stmt.var_inner_pointee_type
    dt.var_inner_ref = stmt.var_inner_ref
    dt.var_pointee_array_size = stmt.var_pointee_array_size
    dt.var_pointee_array_elem_type = stmt.var_pointee_array_elem_type
    dt.var_pointee_array_elem_pointee = stmt.var_pointee_array_elem_pointee
    dt.var_pointee_array_shape = stmt.var_pointee_array_shape

# AGAST #2321: `let p = @a`, `let p = @&a` and `let q = p` hold what an annotated
# local does: N and T, so `p[i]` is an element, and the kind, so it loads as one.
# Returns 1 when it typed the local.
# AGAST #2372: `let p = @q` with `q: *S` holds an `@*S`, so `p.f` reaches S.  It
# stayed an i64 with no struct name: "unhandled EXPR_MEMBER".
fn infer_ref_to_pointer_let(s: *EmitterState, stmt: *Stmt, dt: *DeclTy) -> i32
    let init: *Expr = stmt.var_init
    if dt.var_type != TypeKind.I64 or dt.var_type_name_len != 0 or init == null
        return 0
    if init.kind != ExprKind.Unary or (init.op != OpKind.Addr and init.op != OpKind.AddrMut)
        return 0
    if init.operand == null or init.operand.kind != ExprKind.Ident
        return 0
    let src: *LocalVar = find_local_struct_name(s, StrView { ptr: (init.operand.ident_ptr), len: (init.operand.ident_len) as i64 })
    if src != null and lv_pointee_array_shape(src) != null
        # AGAST #2570: `let rr = @q`, q a plane pointer.  A `**` keeps N and T
        # only, so `(*rr)[i]` would read a flat element where ritz0 reads a row.
        emit_nd_error(s, stmt.span.line, stmt.span.col, c"a multi-dimensional array type is not supported as the pointee of an inferred binding in ritz1 (this `@` takes the address of a pointer to a plane of an N-D array: index it, `q[i][j]`, or copy it, `let r = q`)")
        return 0
    if src == null or (lv_var_type(src) != TypeKind.Ptr and lv_var_type(src) != TypeKind.PtrPtr)
        return 0
    if lv_var_type(src) == TypeKind.Ptr and lv_pointee_type(src) == TypeKind.Array
        return infer_ref_to_array_pointer_let(dt, src)
    if lv_type_name_len(src) > 0 and is_enum_type(s.mono.pctx, StrView { ptr: (lv_type_name(src)), len: (lv_type_name_len(src)) as i64 }) == 1
        return infer_ref_to_enum_pointer_let(dt, src)
    if find_struct(s, StrView { ptr: (lv_type_name(src)), len: (lv_type_name_len(src)) as i64 }) == null
        return infer_ref_to_scalar_pointer_let(dt, src)
    dt.var_type = TypeKind.Ref
    if init.op == OpKind.AddrMut
        dt.var_type = TypeKind.MutRef
    dt.var_type_name = lv_type_name(src)
    dt.var_type_name_len = lv_type_name_len(src)
    dt.var_pointee_type = lv_var_type(src)
    dt.var_inner_pointee_type = lv_inner_pointee_type(src)
    dt.var_inner_ref = lv_inner_ref(src)   # AGAST #2399: `@q` of a `*@S`
    1

# AGAST #3114: `let w = *v` with `v` a `**S` local (typed, or a `Some(v)` over
# `Option<**S>`, #3047) holds the `*S`, as `let w: *S = *v` would.  It stayed an
# i64 with no struct name, so `w.b` was "unhandled EXPR_MEMBER".  Returns 1
# when it typed the local.
fn infer_ptr_ptr_deref_let(s: *EmitterState, stmt: *Stmt, dt: *DeclTy) -> i32
    let init: *Expr = stmt.var_init
    if stmt.var_declared_type != TypeKind.Void or dt.var_type != TypeKind.I64 or dt.var_type_name_len != 0 or init == null
        return 0
    if init.kind != ExprKind.Unary or init.op != OpKind.Deref
        return 0
    var st_len: i32 = 0
    let st_name: *u8 = ptr_ptr_local_struct(s, init.operand, @st_len)
    if st_name == null
        return 0
    dt.var_type = TypeKind.Ptr
    dt.var_type_name = st_name
    dt.var_type_name_len = st_len
    dt.var_pointee_type = TypeKind.Struct
    1

# AGAST #2960: the struct a `ptr`-valued if / match arm points at, or null:
# `@&x` with x a struct (or `:&` struct) local, `@&a.b` a struct field, an
# `@&S` local, or a nested if / match all of whose value arms name one S.
fn ptr_arm_struct(s: *EmitterState, e: *Expr, out_len: *i32) -> *u8
    *out_len = 0
    if e == null
        return null
    match e.kind
        ExprKind.If | ExprKind.Match =>
            return ptr_arms_struct(s, e.args as *MatchArm, out_len)
        ExprKind.Ident =>
            let rl: *LocalVar = find_local_struct_name(s, StrView { ptr: (e.ident_ptr), len: (e.ident_len) as i64 })
            if rl == null or lv_var_type(rl) != TypeKind.MutRef or lv_pointee_type(rl) != TypeKind.Struct or lv_type_name_len(rl) == 0
                return null
            *out_len = lv_type_name_len(rl)
            return lv_type_name(rl)
        _ => pass
    if e.kind != ExprKind.Unary or e.op != OpKind.AddrMut or e.operand == null
        return null
    let o: *Expr = e.operand
    match o.kind
        ExprKind.Ident =>
            let loc: *LocalVar = find_local_struct_name(s, StrView { ptr: (o.ident_ptr), len: (o.ident_len) as i64 })
            if loc == null or lv_type_name_len(loc) == 0
                return null
            if lv_var_type(loc) != TypeKind.Struct and lent_struct_local(s, o) == null
                return null
            *out_len = lv_type_name_len(loc)
            return lv_type_name(loc)
        ExprKind.Member =>
            let f: *StructField = resolve_member_chain_field(s, o)
            if f == null or f.field_type != TypeKind.Struct or f.field_type_name_len == 0
                return null
            *out_len = f.field_type_name_len
            return f.field_type_name
        _ => pass
    null

# AGAST #2960: the one struct every value arm of `arms` points at, or null.
fn ptr_arms_struct(s: *EmitterState, arms: *MatchArm, out_len: *i32) -> *u8
    var name: *u8 = null
    var len: i32 = 0
    var a: *MatchArm = arms
    while a != null
        if a.is_pass == 0 and a.body != null
            var alen: i32 = 0
            let an: *u8 = ptr_arm_struct(s, a.body, @alen)
            if an == null or (name != null and name_eq(StrView { ptr: (name), len: (len) as i64 }, StrView { ptr: (an), len: (alen) as i64 }) == 0)
                *out_len = 0
                return null
            name = an
            len = alen
        a = a.next
    *out_len = len
    name

# AGAST #2960: an un-annotated `let p = if … @&c else @&c` (or match) holds
# what `let p: @&C = …` does: an `@&C` slot, the `ptr` phi stored as is, so
# `p.x` reaches C.  Asked before the arms are emitted, in the let's scope, as
# arms_ptr_valued is.  It stayed an i64 with no name: `p.x = 3` was
# "unhandled EXPR_MEMBER".  Returns the struct's name, or null.
fn ptr_phi_let_struct(s: *EmitterState, init: *Expr, out_len: *i32) -> *u8
    *out_len = 0
    if arms_ptr_valued(s, init.args as *MatchArm) == 0
        return null
    ptr_arms_struct(s, init.args as *MatchArm, out_len)

# AGAST #2532: `let r = @q` with `q: *T` or `**T`, T a scalar, holds what
# `let r: **T` / `***T` does, as #2376 types `let r = @a[i]`.  It was an i64,
# so `**r` loaded and stored 8 bytes and `*r + 1` strode by one.
fn infer_ref_to_scalar_pointer_let(dt: *DeclTy, src: *LocalVar) -> i32
    var inner: i32 = (lv_pointee_type(src) as i32)
    if lv_var_type(src) == TypeKind.PtrPtr
        inner = lv_inner_pointee_type(src)
    let leaf: TypeKind = ptr_ptr_slot_inner(inner)
    if lv_type_name_len(src) != 0 or not type_is_scalar_leaf(leaf)
        return 0
    if lv_var_type(src) == TypeKind.PtrPtr
        inner = ptr_slot_deepen(inner, 1)
    dt.var_type = TypeKind.PtrPtr
    dt.var_pointee_type = TypeKind.Ptr
    dt.var_inner_pointee_type = inner
    1

# AGAST #2352: `let p = @n` / `@&n` with `n` a scalar local holds
# what `let p: @T` / `@&T` does.  It stayed an i64 holding the address, so
# `w(p)` into a `:& T` was "cannot borrow `let` binding `p`", `w(*p)` couldn't
# tell what `*p` was, and `v(p)` into a by-value T wasn't R1's error.  A `:&`
# scalar param is a plain T local that borrows its caller's place, so `@&r`
# of it is left alone, as is `@x` of anything already a pointer.
fn infer_ref_to_scalar_let(s: *EmitterState, stmt: *Stmt, dt: *DeclTy) -> i32
    let init: *Expr = stmt.var_init
    if dt.var_type != TypeKind.I64 or dt.var_type_name_len != 0 or stmt.var_declared_type != TypeKind.Void or init == null
        return 0
    if init.kind != ExprKind.Unary or (init.op != OpKind.Addr and init.op != OpKind.AddrMut) or init.operand == null
        return 0
    let o: *Expr = init.operand
    if o.kind != ExprKind.Ident
        return 0
    var pointee: TypeKind = TypeKind.Void
    let loc: *LocalVar = find_local_struct_name(s, StrView { ptr: (o.ident_ptr), len: (o.ident_len) as i64 })
    if loc != null
        if lv_is_lent(loc) != 0 or lv_type_name_len(loc) != 0 or scalar_pointee(lv_var_type(loc)) == 0
            return 0
        pointee = lv_var_type(loc)
    # AGAST #3129: `@g` of a scalar module-level global is the same `@T`.  It
    # stayed an i64: `*p = 1` through an `@` compiled, and through an `@&` of
    # an i32 / u8 it stored an i64 that clang refused.
    else
        let glob: *GlobalVarDef = find_global(s, StrView { ptr: (o.ident_ptr), len: (o.ident_len) as i64 })
        if glob == null or glob.type_name_len != 0 or scalar_pointee(glob.var_type) == 0
            return 0
        pointee = glob.var_type
    dt.var_type = TypeKind.Ref
    if init.op == OpKind.AddrMut
        dt.var_type = TypeKind.MutRef
    dt.var_pointee_type = pointee
    1

# 1 for the integer and float kinds an `@T` local can point at by value.
fn scalar_pointee(t: TypeKind) -> i32
    (ty_is_int(t) == 1 or t == TypeKind.F32 or t == TypeKind.F64) as i32

# AGAST #2539: `let r = @q` with `q: *E` or `**E`, E an enum, holds what
# `let r: **E` / `***E` does: the name, so `**r` loads and stores an %E.  It
# was an i64: `**r = E.V` stored an i64 of a %E and clang refused it.
fn infer_ref_to_enum_pointer_let(dt: *DeclTy, src: *LocalVar) -> i32
    var inner: i32 = (lv_pointee_type(src) as i32)
    if lv_var_type(src) == TypeKind.PtrPtr
        inner = ptr_slot_deepen(lv_inner_pointee_type(src), 1)
    dt.var_type = TypeKind.PtrPtr
    dt.var_pointee_type = TypeKind.Ptr
    dt.var_inner_pointee_type = inner
    dt.var_type_name = lv_type_name(src)
    dt.var_type_name_len = lv_type_name_len(src)
    1

# AGAST #2539: `let r = @q` with `q: *[N]T` holds what `let r: **[N]T` does: a
# `**` whose inner pointee is the array, with N and T, so `let p = *r` is a
# `*[N]T` again.  It was an i64: `p[1]` strode one byte, and a store crashed.
# Checked before the struct arm: a `*[N]S` names S, and isn't a `*S`.
fn infer_ref_to_array_pointer_let(dt: *DeclTy, src: *LocalVar) -> i32
    if lv_pointee_array_size(src) <= 0
        return 0
    dt.var_type = TypeKind.PtrPtr
    dt.var_pointee_type = TypeKind.Ptr
    dt.var_inner_pointee_type = (TypeKind.Array as i32)
    dt.var_pointee_array_size = lv_pointee_array_size(src)
    dt.var_pointee_array_elem_type = lv_pointee_array_elem_type(src)
    1

# AGAST #2539: the `**[N]T` local that `*e` reads a `*[N]T` out of, or null.
# AGAST #2331: or the `@*[N]T` or `@&*[N]T` local.
fn array_ptr_ptr_deref_base(s: *EmitterState, e: *Expr) -> *LocalVar
    if e == null or e.kind != ExprKind.Unary or e.op != OpKind.Deref or e.operand == null or e.operand.kind != ExprKind.Ident
        return null
    let loc: *LocalVar = find_local_struct_name(s, StrView { ptr: (e.operand.ident_ptr), len: (e.operand.ident_len) as i64 })
    if loc == null or lv_pointee_array_size(loc) <= 0
        return null
    if ref_to_ptr(loc) == 0 and (lv_var_type(loc) != TypeKind.PtrPtr or lv_inner_pointee_type(loc) != (TypeKind.Array as i32))
        return null
    loc

# AGAST #2555: the shape of the N-D local, global or field that `e`, an index
# chain one short of its rank, takes a row of, or null.  `let q = @x[i]` with
# `x: [M][N]T` (or `@x[i][j]` of `[L][M][N]T`) holds an `@[N]T`, as the
# annotated `let q: @[N]T = @x[i]` does.  It recorded no N or T: `q + 1` strode
# a byte and `r[1]` loaded an i8, SILENT, and `q[1]` was "unlowerable".
fn nd_row_shape(s: *EmitterState, e: *Expr) -> *ArrayShape
    var depth: i32 = 0
    let sh: *ArrayShape = nd_index_shape(s, e, @depth)
    if sh == null or depth != sh.rank - 1
        return null
    sh

fn infer_array_ptr_let(s: *EmitterState, stmt: *Stmt, dt: *DeclTy) -> i32
    if stmt.var_declared_type == TypeKind.Void and stmt.var_init != null
        # AGAST #2329: `let q = h(p)`, `let q = h.r` and `let q = g` hold what they
        # copy.  `-> @[N]S` named S, which made `q` a `*S`.
        let pa: *Param = base_ptr_array(s, stmt.var_init)
        if pa != null
            dt.var_type = pa.param_type
            dt.var_type_name = null
            dt.var_type_name_len = 0
            dt.var_pointee_type = TypeKind.Array
            dt.var_pointee_array_size = pa.param_pointee_array_size
            dt.var_pointee_array_elem_type = pa.param_pointee_array_elem_type
            # AGAST #3635: and a `*[N][M]T`'s shape, so `q[i][j]` indexes it.
            if pa.param_pointee_array_shape != null
                dt.var_pointee_array_elem_pointee = pa.param_pointee_array_elem_pointee
                dt.var_pointee_array_shape = pa.param_pointee_array_shape
            return 1
    if dt.var_type != TypeKind.I64 or dt.var_type_name_len != 0 or stmt.var_init == null
        return 0
    let init: *Expr = stmt.var_init
    dt.var_pointee_array_shape = null
    var kind: TypeKind = TypeKind.Unknown
    var size: i32 = 0
    var elem: TypeKind = TypeKind.Void
    var src: *LocalVar = array_ptr_index_base(s, init)
    # AGAST #2330: `let q = p + k` walks rows, and is the same kind of pointer.
    if src == null and init.kind == ExprKind.Binary and (init.op == OpKind.Add or init.op == OpKind.Sub)
        src = array_ptr_index_base(s, init.left)
    let pp: *LocalVar = array_ptr_ptr_deref_base(s, init)   # #2539: `let p = *r`
    if src != null
        kind = lv_var_type(src)
        size = lv_pointee_array_size(src)
        elem = lv_pointee_array_elem_type(src)
        dt.var_pointee_array_shape = lv_pointee_array_shape(src)   # #2570: a plane's copy
    else if pp != null
        kind = TypeKind.Ptr
        size = lv_pointee_array_size(pp)
        elem = lv_pointee_array_elem_type(pp)
    else if init.kind == ExprKind.Unary and (init.op == OpKind.Addr or init.op == OpKind.AddrMut) and init.operand != null
        let oper: *Expr = init.operand
        kind = TypeKind.Ref
        if init.op == OpKind.AddrMut
            kind = TypeKind.MutRef
        let row: *ArrayShape = nd_row_shape(s, oper)   # #2555: `@x[i]`
        if row != null
            size = row.dims[row.rank - 1]
            elem = row.leaf_type
            dt.var_pointee_array_elem_pointee = row.leaf_pointee
        else if nd_plane_shape(s, oper) != null
            # AGAST #2570: a plane `@x[i]`, `[M][N]..T` (#2558 refused it): the
            # flat `@[M*N..]T`, so `q + k` strides planes and `q as *T` is
            # element 0, keeping `[M][N]..T` for `q[i][j]`.
            let plane: *ArrayShape = nd_plane_shape(s, oper)
            size = shape_leaf_count(plane)
            elem = plane.leaf_type
            dt.var_pointee_array_elem_pointee = plane.leaf_pointee
            dt.var_pointee_array_shape = plane
        else
            match oper.kind
                ExprKind.Member =>
                    let fld: *StructField = resolve_member_chain_field(s, oper)
                    if fld != null and fld.field_type == TypeKind.Array
                        size = fld.array_size
                        elem = fld.array_elem_type
                ExprKind.Ident =>
                    let arr: *LocalVar = find_local_struct_name(s, StrView { ptr: (oper.ident_ptr), len: (oper.ident_len) as i64 })
                    if arr != null
                        if lv_var_type(arr) == TypeKind.Array
                            size = lv_array_size(arr)
                            elem = lv_array_elem_type(arr)
                    else
                        let garr: *GlobalVarDef = global_array_named(s, oper)
                        if garr != null
                            size = garr.array_size
                            elem = garr.array_elem_type
                _ => pass
    if size <= 0
        return 0
    dt.var_type = kind
    dt.var_pointee_type = TypeKind.Array
    dt.var_pointee_array_size = size
    dt.var_pointee_array_elem_type = elem
    return 1

# AGAST #2571: the scalar element type of the local, global or field array that
# `e`, an index chain of exactly its rank, names an element of; TypeKind.Void for
# anything else (a row, a plane, a pointer or Vec index, a struct or pointer
# element: other arms type those).
fn full_scalar_elem_type(s: *EmitterState, e: *Expr) -> TypeKind
    if e == null or e.kind != ExprKind.Index or e.left == null
        return TypeKind.Void
    var leaf: TypeKind = TypeKind.Void
    var depth: i32 = 0
    let sh: *ArrayShape = nd_index_shape(s, e, @depth)
    if sh != null
        if depth == sh.rank
            leaf = sh.leaf_type
    else
        match e.left.kind
            ExprKind.Ident =>
                let arr: *LocalVar = find_local_struct_name(s, StrView { ptr: (e.left.ident_ptr), len: (e.left.ident_len) as i64 })
                if arr != null
                    if lv_var_type(arr) == TypeKind.Array and lv_array_shape(arr) == null
                        leaf = lv_array_elem_type(arr)
                else
                    let garr: *GlobalVarDef = global_array_named(s, e.left)
                    if garr != null and garr.array_shape == null
                        leaf = garr.array_elem_type
            ExprKind.Member =>
                let fld: *StructField = resolve_member_chain_field(s, e.left)
                if fld != null and fld.field_type == TypeKind.Array and fld.array_shape == null
                    leaf = fld.array_elem_type
            _ => pass
    if not type_is_scalar_leaf(leaf)
        return TypeKind.Void
    leaf

# AGAST #2571: `let q = @x[i]` and `let q = @&x[i]..`, a full element of an
# array, hold what `let q: *T = @x[i]` does, as ritz0 types them.  The slot
# stayed i64: `@&` stored its ptr there and clang rejected the IR, unlocated;
# `@` went through ptrtoint, then `*q` loaded and stored 8 bytes and `q + 1`
# strode one.  A scalar T is the pointee; an N-D struct or enum element
# (`x: [M][N]S`) is a `*S`, as the #175 arm in emit_var_decl types a 1-D one
# (that arm walks one index only).  Returns 1 when it typed the local.
fn infer_full_elem_ref_let(s: *EmitterState, stmt: *Stmt, dt: *DeclTy) -> i32
    let init: *Expr = stmt.var_init
    if dt.var_type != TypeKind.I64 or dt.var_type_name_len != 0 or init == null
        return 0
    if init.kind != ExprKind.Unary or (init.op != OpKind.Addr and init.op != OpKind.AddrMut)
        return 0
    var depth: i32 = 0
    let sh: *ArrayShape = nd_index_shape(s, init.operand, @depth)
    if sh != null and depth == sh.rank and sh.leaf_type == TypeKind.Struct and sh.leaf_name_len > 0
        dt.var_type = TypeKind.Ptr
        dt.var_type_name = sh.leaf_name
        dt.var_type_name_len = sh.leaf_name_len
        return 1
    let leaf: TypeKind = full_scalar_elem_type(s, init.operand)
    if leaf == TypeKind.Void
        return 0
    dt.var_type = TypeKind.Ptr
    dt.var_pointee_type = leaf
    1

# AGAST #2400: `let a = @p.f` and `let a = @&p.f`, f a scalar field, hold what
# `let a: @T = @p.f` does: a `*T`, T the field's type, as #2571 types `@x[i]`.
# The slot stayed i64 with no pointee: `@&` stored its ptr there and clang
# rejected the IR; `@` went through ptrtoint, then `*a` loaded and stored 8
# bytes of an i32 and `a + 1` strode one.  Struct fields are the #175 arm's;
# pointer, array and enum fields aren't scalars here.  Returns 1 when it typed
# the local.
fn infer_field_ref_let(s: *EmitterState, stmt: *Stmt, dt: *DeclTy) -> i32
    let init: *Expr = stmt.var_init
    if dt.var_type != TypeKind.I64 or dt.var_type_name_len != 0 or init == null
        return 0
    if init.kind != ExprKind.Unary or (init.op != OpKind.Addr and init.op != OpKind.AddrMut)
        return 0
    if init.operand == null or init.operand.kind != ExprKind.Member
        return 0
    let f: *StructField = resolve_member_chain_field(s, init.operand)
    if f == null or f.field_type_name_len != 0
        return 0
    let t: TypeKind = f.field_type
    if not type_is_scalar_leaf(t)
        return 0
    dt.var_type = TypeKind.Ptr
    dt.var_pointee_type = t
    1

# AGAST #2330: the struct an un-annotated `let p = @a`, `let q = p` or `let q = p + k`
# holds an array of, for add_array_view: infer_array_ptr_let records N and T but
# no name, since a name would register `p` as a `*S`.  null for scalars.
fn inferred_array_elem_name(s: *EmitterState, stmt: *Stmt, dt: *DeclTy, out_len: *i32) -> *u8
    *out_len = dt.var_type_name_len
    if dt.var_type_name_len > 0 or stmt.var_init == null
        return dt.var_type_name
    let init: *Expr = stmt.var_init
    var src: *LocalVar = array_ptr_index_base(s, init)
    if src == null and init.kind == ExprKind.Binary and (init.op == OpKind.Add or init.op == OpKind.Sub)
        src = array_ptr_index_base(s, init.left)
    if src != null
        return array_ptr_elem_name(src, out_len)
    let pp: *LocalVar = array_ptr_ptr_deref_base(s, init)   # #2543: `let p = *r`
    if pp != null
        return array_ptr_elem_name(pp, out_len)
    let pa: *Param = base_ptr_array(s, init)   # #2329
    if pa != null
        *out_len = pa.param_type_name_len
        return pa.param_type_name
    if init.kind != ExprKind.Unary or (init.op != OpKind.Addr and init.op != OpKind.AddrMut) or init.operand == null
        return null
    let oper: *Expr = init.operand
    var row: *ArrayShape = nd_row_shape(s, oper)   # #2555: `@x[i]`
    if row == null
        row = nd_plane_shape(s, oper)   # #2570: a plane, `@x[i]` of `[L][M][N]S`
    if row != null
        *out_len = row.leaf_name_len
        return row.leaf_name
    match oper.kind
        ExprKind.Member =>
            let fld: *StructField = resolve_member_chain_field(s, oper)
            if fld != null and fld.field_type == TypeKind.Array
                *out_len = fld.array_elem_type_name_len
                return fld.array_elem_type_name
        ExprKind.Ident =>
            let arr: *LocalVar = find_local_struct_name(s, StrView { ptr: (oper.ident_ptr), len: (oper.ident_len) as i64 })
            if arr != null
                if lv_var_type(arr) == TypeKind.Array
                    *out_len = lv_type_name_len(arr)
                    return lv_type_name(arr)
                # #2543: `let r = @q` with `q: *[N]S`, for name_array_ptr_local.
                if array_ptr_index_base(s, oper) != null
                    return array_ptr_elem_name(arr, out_len)
            else
                let garr: *GlobalVarDef = global_array_named(s, oper)
                if garr != null
                    *out_len = garr.array_elem_type_name_len
                    return garr.array_elem_type_name
        _ => pass
    return null

# AGAST #2564: `let e = v[i]` and `let e = x.vf[i]`, on a Vec, Span or String whose
# element is a struct S held by value, is a copy of that S, as `let e: S = v[i]`.
# The slot stayed i64 with no name, so `e.f` was "unhandled EXPR_MEMBER".
# AGAST #2524: so is `p[i]` through a `*[N]S`, `@[N]S` or `@&[N]S` (the place
# `*(p# + i)`), as `let s: S = p[i]` already was (#2330).  Returns 1 when it
# typed the local.
fn infer_through_elem_let(s: *EmitterState, stmt: *Stmt, dt: *DeclTy) -> i32
    if dt.var_type != TypeKind.I64 or dt.var_type_name_len != 0 or stmt.var_init == null
        return 0
    # `let n: i64 = p[i]` is i64 too; it stays a refused integer (#2330).
    if stmt.var_declared_type != TypeKind.Void
        return 0
    if index_through(s, stmt.var_init) == null
        return 0
    var name: *u8 = null
    var len: i32 = 0
    if index_through_value_struct(s, stmt.var_init, @name, @len) == 0
        return 0
    dt.var_type = TypeKind.Struct
    dt.var_type_name = name
    dt.var_type_name_len = len
    1

# AGAST #3972: S when `@ie` / `@&ie` points at an S, for `ie` = `x[i]` the
# `[N]S` arms of the let inference don't take: an index through a Vec, Span or
# String (local or field: `@t.es[i]`), or an element of a `*S` local or field
# (`@s.rs[i]`).  `let e = @t.es[i]` stayed an i64 with no name, so `e.y_min`
# was "unhandled EXPR_MEMBER", unlocated (angelo's raster/fill.ritz).  Null
# when it is none of those.
fn addr_index_elem_struct(s: *EmitterState, ie: *Expr, out_len: *i32) -> *u8
    *out_len = 0
    var name: *u8 = null
    var len: i32 = 0
    if index_through(s, ie) != null
        if index_through_value_struct(s, ie, @name, @len) == 0
            return null
    else if ie.left.kind == ExprKind.Ident
        ptr_local_struct_index(s, ie, @name, @len)
    else if ie.left.kind == ExprKind.Member and ie.right != null and ie.right.kind != ExprKind.Range
        let f: *StructField = resolve_member_chain_field(s, ie.left)
        if ptr_field_struct_elem(s, f) == 1
            name = f.field_type_name
            len = f.field_type_name_len
    if name == null or len <= 0
        return null
    *out_len = len
    name

# AGAST #2592: `let r = ps[i]` with `ps: [N]S` (a local, global or field) is a
# copy of that S, as `let r: S = ps[i]`.  The slot stayed i64 with no name, so
# `r.x` was "unhandled EXPR_MEMBER", unlocated.  Returns 1 when it typed the
# local.
# AGAST #2993: `let n: i64 = ps[i]` is i64 too, so it was retyped as a %S local
# and compiled; ritz0 refuses it.  The %S load into the i64 slot then failed at
# clang, unlocated, so it is refused here, located, as #2330's through form is.
fn infer_struct_elem_let(s: *EmitterState, stmt: *Stmt, dt: *DeclTy) -> i32
    if dt.var_type != TypeKind.I64 or dt.var_type_name_len != 0 or stmt.var_init == null
        return 0
    var name: *u8 = null
    var len: i32 = 0
    index_struct_value_name(s, stmt.var_init, @name, @len)
    if len == 0
        return 0
    if stmt.var_declared_type != TypeKind.Void
        emit_nd_error(s, stmt.var_init.span.line, stmt.var_init.span.col, whole_struct_value_message())
        return 0
    dt.var_type = TypeKind.Struct
    dt.var_type_name = name
    dt.var_type_name_len = len
    1

# AGAST #2525, #3188: `let n: i32 = *q` with `q: *S` declares an integer and
# loads the `%S`.  ritz1 refused only `i64` (in the inference block above, which
# no other type reaches): `u8`, `i32` and the rest put the `%S` where clang
# wanted an integer, unlocated.  Refused at the init for every integer type.
# AGAST #3198: so is a struct local, param or call result (`l`, `mk()`,
# `l.dup()`), struct_value_name's other forms.  A narrow int was the same clang
# error; `let n: i64 = l` was worse, a silent copy of the struct into `n`.
fn struct_value_int_let_refused(s: *EmitterState, stmt: *Stmt)
    if ty_int_bits(stmt.var_declared_type) == 0
        return
    var name: *u8 = null
    var len: i32 = 0
    struct_value_name(s, stmt.var_init, @name, @len)
    if name != null
        emit_nd_error(s, stmt.var_init.span.line, stmt.var_init.span.col, whole_struct_value_message())

# AGAST #2377: `let c = a[i][j]` with `a: [N]*S` is a copy of that S, as
# `let c: S = a[i][j]` and `let c = *a[i]` (#2542) are.  The slot stayed i64
# with no name, so `c.q` was "unhandled EXPR_MEMBER".  emit_expr loads the
# `%S` deref_pointee_struct_name names for `a[i]`.
# AGAST #3052: so is `let c = p[i]` with `p: *S`, now that emit_expr loads it as
# `*(p + i)`.  `let n: i64 = p[i]` is an i64 and refused at the init, as #2525
# refuses `let n: i64 = *(p + i)`; ritz1 took it silently.
# AGAST #3053: so is `let n: i64 = a[i][j]` with `a: [N]*S`.  emit_expr put the
# `%S` load in the i64 slot: a clang error, unlocated.
fn infer_ptr_index_let(s: *EmitterState, stmt: *Stmt, dt: *DeclTy) -> i32
    # AGAST #3188: a declared `let n: <int> = p[i]` / `a[i][j]` is refused at the
    # load, as any integer slot is (whole_struct_elem_refused); only an untyped
    # let is a copy to type here.
    if dt.var_type != TypeKind.I64 or dt.var_type_name_len != 0 or stmt.var_declared_type != TypeKind.Void
        return 0
    let e: *Expr = stmt.var_init
    if e == null or e.kind != ExprKind.Index or e.left == null or e.right == null or e.right.kind == ExprKind.Range
        return 0
    var name: *u8 = null
    var len: i32 = 0
    match e.left.kind
        ExprKind.Ident =>
            ptr_local_struct_index(s, e, @name, @len)
        ExprKind.Index =>
            deref_pointee_struct_name(s, e.left, @name, @len)
        _ => pass
    if name == null or len <= 0
        return 0
    dt.var_type = TypeKind.Struct
    dt.var_type_name = name
    dt.var_type_name_len = len
    1

# AGAST #2332: `let q = a[i]` and `let q = a[i] + k` with `a: [N]*T` hold what
# `let q: *T` does.  Returns 1 when it typed the local.
# AGAST #2379: so does `let q = @a[i][j]` (or `@&`): `a[i][j]` is `*(a[i] + j)`,
# and its address is `a[i] + j`.  It stayed an i64: `*q` loaded 8 bytes.
fn infer_array_elem_let(s: *EmitterState, stmt: *Stmt, dt: *DeclTy) -> i32
    if stmt.var_declared_type != TypeKind.Void or stmt.var_init == null
        return 0
    var init: *Expr = stmt.var_init
    var ei_sum: Expr
    var ei_deref: Expr
    if init.kind == ExprKind.Unary and (init.op == OpKind.Addr or init.op == OpKind.AddrMut) and is_array_elem_index(s, init.operand) == 1
        elem_index_as_deref(s, init.operand, @ei_sum, @ei_deref)
        init = @ei_sum
    var name: *u8 = null
    var name_len: i32 = 0
    let pointee: TypeKind = array_elem_pointee(s, init, @name, @name_len)
    if pointee == TypeKind.Void
        return infer_elem_ptr_ptr_let(s, stmt, dt)
    dt.var_type = TypeKind.Ptr
    dt.var_pointee_type = pointee
    dt.var_type_name = name
    dt.var_type_name_len = name_len
    return 1

# AGAST #2376: `let r = b[i]` and `let r = *b[i]` with `b: [N]**T`, and
# `let r = @a[i]` with `a: [N]*T`, hold what `let r: **T` / `let r: *T` do.
# They were i64s, so `**r` and `*r` loaded and stored 8 bytes.
fn infer_elem_ptr_ptr_let(s: *EmitterState, stmt: *Stmt, dt: *DeclTy) -> i32
    var base: *Expr = stmt.var_init
    while base != null and base.kind == ExprKind.Unary and base.op == OpKind.Deref
        base = base.operand
    if elem_rooted(base) == 0
        return 0
    var inner: TypeKind = TypeKind.Void
    var name: *u8 = null
    var name_len: i32 = 0
    # AGAST #3058: `let c = b[i][j]` with `b: [N]**T` is `*(b[i] + j)`, a `*T`, as
    # `let c: *T = b[i][j]`.  ptr_levels_of reads whole elements only, so `c`
    # stayed an i64 with no pointee and `c[k].f` was "unhandled EXPR_MEMBER".
    var init: *Expr = stmt.var_init
    var ei_sum: Expr
    var ei_deref: Expr
    if is_ptr_ptr_elem_index(s, init) == 1
        elem_index_as_deref(s, init, @ei_sum, @ei_deref)
        init = @ei_deref
    let levels: i32 = ptr_levels_of(s, init, @inner, @name, @name_len)
    if levels == 0 or inner == TypeKind.Void
        return 0
    dt.var_type_name = name
    dt.var_type_name_len = name_len
    if levels == 1
        dt.var_type = TypeKind.Ptr
        dt.var_pointee_type = inner
        return 1
    dt.var_type = TypeKind.PtrPtr
    dt.var_pointee_type = TypeKind.Ptr
    dt.var_inner_pointee_type = ptr_slot_deepen((inner as i32), levels - 2)
    return 1

# AGAST #2791: `let p = f()` with `f() -> **U` (`vec_as_ptr<*U>`, or written)
# holds what `let p: **U` does, U a scalar or a struct, so `*(p + i)` strides
# by 8 and `**p` loads a U.  It stayed an i64: `p + i` was a raw byte add and
# `*(p + i)` silently loaded the wrong pointer.  Monomorph spells a pointer U
# `ptr_C` (`vec_as_ptr<**u8>` names "ptr_u8"): each `ptr_` is one more level,
# packed as `let p: ***u8` packs it.  An unknown U is a `*U`, as the `*T`
# record was before, so arithmetic on it is refused, not a byte add.
# Returns the local's var_type.
fn infer_ptr_ptr_call_let(s: *EmitterState, dt: *DeclTy, fd: *FnDef) -> TypeKind
    var name: *u8 = fd.return_type_name
    var len: i32 = fd.return_type_name_len
    if name == null or len <= 0
        return TypeKind.I64
    var extra: i32 = 0
    while len > 4 and memcmp(name, c"ptr_", 4) == 0
        name = name + 4
        len = len - 4
        extra = extra + 1
    var inner: TypeKind = primitive_type_from_name(StrView { ptr: (name), len: (len) as i64 })
    if inner == TypeKind.Void   # primitive_type_from_name's miss value
        if find_struct(s, StrView { ptr: (name), len: (len) as i64 }) == null
            dt.var_type = TypeKind.Ptr
            dt.var_type_name = fd.return_type_name
            dt.var_type_name_len = fd.return_type_name_len
            return TypeKind.Ptr
        inner = TypeKind.Struct
        dt.var_type_name = name
        dt.var_type_name_len = len
    dt.var_type = TypeKind.PtrPtr
    dt.var_pointee_type = TypeKind.Ptr
    dt.var_inner_pointee_type = ptr_slot_deepen((inner as i32), extra)
    TypeKind.PtrPtr

# AGAST #2335, #2338, #2445: what an un-annotated `let` or `var` holds, as far
# as a write through it goes: `let p = @x` an `@T`, `@&x` an `@&T`, or a copy of
# one from a local, a field or a call.  Ask before the inference in
# emit_var_decl rewrites the type in DeclTy, or `let p: *C = @c` looks like it.
fn let_ref_view(s: *EmitterState, stmt: *Stmt, dt: *DeclTy) -> i32
    if dt.var_type != TypeKind.I64 or dt.var_type_name_len != 0 or stmt.var_init == null
        return REF_VIEW_UNKNOWN
    ref_view(s, stmt.var_init)

# AGAST #3079: an un-annotated `let p = @c` / `@&c` (or a copy of one) that the
# inference typed a `*T` is an `@T` / `@&T`, as if annotated.  It was a `*T`
# that the side flags LocalVar.holds_shared_ref / holds_mut_ref (since removed)
# said otherwise of.  An annotated `let p: *C = @c` never gets here
# (let_ref_view is UNKNOWN for it).
# A `**T` one (`let r = @q`, q a `*T` of a scalar, an enum or an array) is an
# `@*T` / `@&*T`: the pointee stays the `*T`, so `**r` and `*r = d` keep working.
fn type_ref_view_let(dt: *DeclTy, view: i32) -> i32
    if dt.var_type != TypeKind.Ptr and dt.var_type != TypeKind.PtrPtr
        return 0
    if view != REF_VIEW_SHARED and view != REF_VIEW_MUT
        return 0
    if dt.var_type == TypeKind.Ptr and dt.var_type_name_len > 0 and dt.var_pointee_type != TypeKind.Array
        dt.var_pointee_type = TypeKind.Struct
    dt.var_type = TypeKind.Ref
    if view == REF_VIEW_MUT
        dt.var_type = TypeKind.MutRef
    1

# The integer type an unannotated `let x = init` takes from `init`, as ritz0
# types it; TypeKind.Void when it stays the parser's i64 default.  A bare literal
# stays i64, as it does on ritz0, and a float expression is not an integer at all.
# AGAST #2356: a u64, which the i64 default would make `x >> n` sign-fill.
# AGAST #2527: an i8 .. u32, `var n = m` with `m: u32`.  The local stayed an i64
# slot, so `@&n` into an `@&i32` couldn't be refused, and an `@&u32` of it read
# the low half of the i64.  `int_kind` is bool_kind's answer for `init`: only a
# known integer narrows (a bool is a u8 to int_operand_shape).
fn inferred_int_init(s: *EmitterState, stmt: *Stmt, int_kind: i32) -> TypeKind
    if stmt.var_declared_type != TypeKind.Void or stmt.var_init == null
        return TypeKind.Void
    if stmt.var_init.kind == ExprKind.IntLit
        return TypeKind.Void
    let t: TypeKind = expr_slot_ty(stmt.var_init)
    if t == TypeKind.F32 or t == TypeKind.F64
        return TypeKind.Void
    var uns: i32 = 0
    let bits: i32 = int_operand_shape(s, stmt.var_init, @uns)
    if bits == 64 and uns == 1
        return TypeKind.U64
    if int_kind != BK_INT
        return TypeKind.Void
    # int_operand_shape is ritz0's emitter's _int_shape: `m + 1` is a u32 there,
    # the literal being m's type (LARB R21, AGAST #3112), so `n` is a u32 slot.
    narrow_int_kind(bits, uns)

# The TYPE_* of an integer `bits` wide (8, 16 or 32), unsigned when `uns` is 1;
# TypeKind.Void for any other width.
pub fn narrow_int_kind(bits: i32, uns: i32) -> TypeKind
    if bits == 8
        if uns == 1
            return TypeKind.U8
        return TypeKind.I8
    if bits == 16
        if uns == 1
            return TypeKind.U16
        return TypeKind.I16
    if bits == 32
        if uns == 1
            return TypeKind.U32
        return TypeKind.I32
    TypeKind.Void

# 1 when `name` is an enum `ctor` builds: an Option for Some / None, a Result
# for Ok / Err.
pub fn ctor_family_is(ctor: *Expr, name_sv: StrView) -> i32
    var name: *u8 = name_sv.ptr
    var len: i32 = name_sv.len as i32
    if name == null or len < 7
        return 0
    if ctor.kind == ExprKind.Ident or name_eq(StrView { ptr: (ctor.func_name), len: (ctor.func_name_len) as i64 }, StrView { ptr: (c"Some"), len: (4) as i64 }) == 1 or name_eq(StrView { ptr: (ctor.func_name), len: (ctor.func_name_len) as i64 }, StrView { ptr: (c"None"), len: (4) as i64 }) == 1
        return name_eq(StrView { ptr: (name), len: (7) as i64 }, StrView { ptr: (c"Option$"), len: (7) as i64 })
    name_eq(StrView { ptr: (name), len: (7) as i64 }, StrView { ptr: (c"Result$"), len: (7) as i64 })

# AGAST #2430: an unannotated `let o = Some(5)` (or None, Ok, Err) is the enum
# it builds.  The local stayed an i64, the constructor had no enum to build and
# lowered to a zero, and `match o` read that.  The enum is the fn's return type
# when that is one of the constructor's family, as on ritz0 (`let o = None`
# then `o` in a `-> Option<i32>` fn); otherwise the one its payload names, as a
# scrutinee's (#2419).  1 when it typed the local; a payload nothing names is a
# located error, never the zero.
fn infer_ctor_let(s: *EmitterState, stmt: *Stmt, dt: *DeclTy) -> i32
    let init: *Expr = stmt.var_init
    if stmt.var_declared_type != TypeKind.Void or init == null
        return 0
    if is_tagged_ctor(s, init) == 0
        return 0
    if init.kind == ExprKind.Call
        var uc_name: *u8 = null
        var uc_len: i32 = 0
        user_variant_ctor_enum(s.mono.pctx, init, @uc_name, @uc_len)
        if uc_name != null
            return 0   # a user enum's own variant (#1797)
    var name: *u8 = null
    var len: i32 = 0
    if ctor_family_is(init, StrView { ptr: (s.ret_type_name), len: (s.ret_type_name_len) as i64 }) == 1
        name = s.ret_type_name
        len = s.ret_type_name_len
    else
        ctor_scrutinee_enum(s, init, @name, @len)
    if name == null
        emit_ctor_type_error(s, init)
        return 0
    dt.var_type = TypeKind.Struct
    dt.var_type_name = name
    dt.var_type_name_len = len
    1

# 1 when `e` is a Some/None/Ok/Err the builtin Option / Result builds: not a
# user enum's own `Ok` / `Some` (#1797, #2453).
pub fn builtin_tagged_ctor(s: *EmitterState, e: *Expr) -> i32
    if is_tagged_ctor(s, e) == 0
        return 0
    if e.kind == ExprKind.Call
        var uc_name: *u8 = null
        var uc_len: i32 = 0
        user_variant_ctor_enum(s.mono.pctx, e, @uc_name, @uc_len)
        if uc_name != null
            return 0
    1

# The arms an if / match expression `e` ends in, through nested ones (`else
# if`, a match arm that is one): the first constructor (*any), the first
# Some / Ok (*val) and the first Err (*err).  *mixed is the first that builds
# the other family from *any's, an Option among Results or the reverse.
fn arm_ctors(s: *EmitterState, e: *Expr, any: **Expr, val: **Expr, err: **Expr, mixed: **Expr)
    if e == null
        return
    if e.kind == ExprKind.If or e.kind == ExprKind.Match
        var arm: *MatchArm = e.args as *MatchArm
        while arm != null
            if arm.is_pass == 0
                arm_ctors(s, arm.body, any, val, err, mixed)
            arm = arm.next
        return
    if builtin_tagged_ctor(s, e) == 0
        return
    if *any == null
        *any = e
    else if *mixed == null and ctor_family_is(e, StrView { ptr: (c"Option$"), len: (7) as i64 }) != ctor_family_is(*any, StrView { ptr: (c"Option$"), len: (7) as i64 })
        *mixed = e
    if e.kind != ExprKind.Call
        return   # None
    if name_eq(StrView { ptr: (e.func_name), len: (e.func_name_len) as i64 }, StrView { ptr: (c"Err"), len: (3) as i64 }) == 1
        if *err == null
            *err = e
    else if *val == null
        *val = e

# A constructor's payload, spelled for its enum's name; i64 when there is
# none (None, or no arm of that variant).  0 when ritz1 can't name it.
fn arm_payload_spelling(s: *EmitterState, ctor: *Expr, out: **u8) -> i32
    if ctor == null or ctor.args == null
        *out = c"i64"
        return 3
    ctor_payload_spelling(s, ctor.args, out)

# AGAST #2454: an unannotated `let o = if c then Some(5) else None`, or a
# match expression whose arms build one, is the enum the arms build.  The
# arms had no enum, lowered to `add i64 0, 0`, and `match o` read that zero.
# As infer_ctor_let (#2430): the fn's return type when it is the arms'
# family, else the one their payloads name: an Option's T from its first
# Some, a Result's T from its first Ok and E from its first Err, i64 where no
# arm gives one.  Writes the name and returns 1 when it named one; 0 when no arm ends in a constructor.  Arms building both
# an Option and a Result, or a payload ritz1 can't name, are a located error:
# -1, and the caller emits nothing more for them.
fn infer_ctor_arms(s: *EmitterState, stmt: *Stmt, out_name: **u8, out_len: *i32) -> i32
    *out_name = null
    *out_len = 0
    let init: *Expr = stmt.var_init
    if stmt.var_declared_type != TypeKind.Void or init == null
        return 0
    if init.kind != ExprKind.If and init.kind != ExprKind.Match
        return 0
    var any: *Expr = null
    var val: *Expr = null
    var err: *Expr = null
    var mixed: *Expr = null
    arm_ctors(s, init, @any, @val, @err, @mixed)
    if any == null
        return 0
    if mixed != null
        emit_ctor_type_error(s, mixed)
        return -1
    if ctor_family_is(any, StrView { ptr: (s.ret_type_name), len: (s.ret_type_name_len) as i64 }) == 1
        *out_name = s.ret_type_name
        *out_len = s.ret_type_name_len
        return 1
    var t: *u8 = null
    let t_len: i32 = arm_payload_spelling(s, val, @t)
    if t_len <= 0
        emit_ctor_type_error(s, val)
        return -1
    var len: i32 = 0
    var name: *u8 = null
    if ctor_family_is(any, StrView { ptr: (c"Option$"), len: (7) as i64 }) == 1
        name = ctor_join(StrView { ptr: (c"Option$"), len: (7) as i64 }, StrView { ptr: (t), len: (t_len) as i64 }, StrView { ptr: (c""), len: (0) as i64 }, @len)
    else
        var e: *u8 = null
        let e_len: i32 = arm_payload_spelling(s, err, @e)
        if e_len <= 0
            emit_ctor_type_error(s, err)
            return -1
        let head: *u8 = ctor_join(StrView { ptr: (c"Result$"), len: (7) as i64 }, StrView { ptr: (t), len: (t_len) as i64 }, StrView { ptr: (c"$"), len: (1) as i64 }, @len)
        name = ctor_join(StrView { ptr: (head), len: (len) as i64 }, StrView { ptr: (e), len: (e_len) as i64 }, StrView { ptr: (c""), len: (0) as i64 }, @len)
    if namelist_find(@s.late_enums, StrView { ptr: (name), len: (len) as i64 }) < 0
        namelist_push(@s.late_enums, StrView { ptr: (name), len: (len) as i64 })
    *out_name = name
    *out_len = len
    1

# An i64 zero: a value for an init that was refused, so the let still binds.
fn emit_zero_i64(s: *EmitterState) -> i32
    let z: i32 = next_reg(s)
    emit_str(s, IR_INDENT)
    emit_reg(s, z)
    emit_str(s, IR_ADD_ZERO)
    z

# AGAST #2454: `Some(5)` as a statement.  Its value is dropped, but with no
# enum it was still the `add i64 0, 0` fallback.  It builds the enum around
# it when that is its family (a tail in a `-> Option<T>` fn), else the one its
# payload names.  Emits it; returns the register.
fn emit_ctor_stmt(s: *EmitterState, e: *Expr) -> i32
    var name: *u8 = null
    var len: i32 = 0
    resolve_enum_ctx(s, @name, @len)
    if name != null and ctor_family_is(e, StrView { ptr: (name), len: (len) as i64 }) == 1
        return emit_expr(s, e)
    ctor_scrutinee_enum(s, e, @name, @len)
    if name == null
        return emit_expr(s, e)   # the located error
    emit_ctor_scrutinee(s, e, StrView { ptr: (name), len: (len) as i64 })

# AGAST #2784: the struct returned by the method call `init` on a call's
# result (`mk<T>(u, v).flip()`), or null/0: the callee's return names the
# receiver, the method's return the result.  A method receiver (`c.me().tp()`)
# is named by call_result_struct_name (#2594).
fn tuple_decl_method_struct_name(s: *EmitterState, init: *Expr, out_name: **u8, out_len: *i32)
    var recv: *u8 = null
    var recv_len: i32 = 0
    call_result_struct_name(s, init.left, @recv, @recv_len)
    if recv_len <= 0
        return
    let fd: *FnDef = method_callee_def(s, StrView { ptr: (recv), len: (recv_len) as i64 }, StrView { ptr: (init.ident_ptr), len: (init.ident_len) as i64 })
    if fd == null or fd.return_type != TypeKind.Struct or fd.return_type_name_len <= 0
        return
    *out_name = fd.return_type_name
    *out_len = fd.return_type_name_len

# AGAST #2574: the struct `let (a, b) = init` destructures, or null/0.  A call
# or method call (`mk(3)`, `c.tp(3)`, a static `C.sm(5)`) names it by its
# callee's return type; anything else (a struct local, a struct literal) by
# resolve_expr_struct_name.  Only a free fn's return was looked at before,
# so a method call bound nothing.
pub fn tuple_decl_struct_name(s: *EmitterState, init: *Expr, out_name: **u8, out_len: *i32)
    call_result_struct_name(s, init, out_name, out_len)
    if *out_len == 0
        resolve_expr_struct_name(s, init, out_name, out_len)
    # AGAST #2784: a method on a call's result (`mk<T>(u, v).flip()`).
    # call_result_struct_name only reads an identifier receiver.
    if *out_len == 0 and init.kind == ExprKind.Method and init.left != null and init.left.kind == ExprKind.Call
        tuple_decl_method_struct_name(s, init, out_name, out_len)
    if *out_len == 0
        unwrap_payload_struct_name(s, init, out_name, out_len)
    # A struct field (`h.p`, `hs[0].p`, `mk().p`) names its own type.
    if *out_len == 0 and init.kind == ExprKind.Member
        let fld: *StructField = resolve_member_chain_field(s, init)
        if fld != null and fld.field_type == TypeKind.Struct and fld.field_type_name_len > 0
            *out_name = fld.field_type_name
            *out_len = fld.field_type_name_len
    # AGAST #2592: an element of a `[N]S` local, global or field (`ps[1]`,
    # `h.ps[1]`, `gp[0]`), which emit_expr_index loads as a `%S`.
    if *out_len == 0 and init.kind == ExprKind.Index
        index_struct_value_name(s, init, out_name, out_len)
    # `*q`, q a `*S` (as `(*q).f` resolves it).
    if *out_len == 0 and init.kind == ExprKind.Unary and init.op == OpKind.Deref
        deref_member_base_struct_name(s, init.operand, out_name, out_len)
    # A struct global, when no local has the name.
    if *out_len == 0 and init.kind == ExprKind.Ident and find_local_struct_name(s, StrView { ptr: (init.ident_ptr), len: (init.ident_len) as i64 }) == null
        let g: *GlobalVarDef = find_global(s, StrView { ptr: (init.ident_ptr), len: (init.ident_len) as i64 })
        if g != null and g.var_type == TypeKind.Struct and g.type_name_len > 0
            *out_name = g.type_name
            *out_len = g.type_name_len

# AGAST #2574: 1 if a destructured field of this kind can be bound as a local:
# a scalar, bool, float, struct, plain pointer or (#2594) array.  `@` / `@&`
# fields and fn-typed fields are refused rather than guessed at (#2864).
fn tuple_field_bindable(fld: *StructField) -> i32
    if fld.field_mut_ref == 1 or fld.field_shared_ref == 1 or fld.fn_sig != null
        return 0
    let ft: TypeKind = fld.field_type
    if ft == TypeKind.Array and fld.array_size > 0
        return 1
    if ty_int_in(ft, 8, 16) == 1
        return 1
    if ty_int_in(ft, 32, 64) == 1
        return 1
    if ft == TypeKind.F32 or ft == TypeKind.F64 or ft == TypeKind.Bool
        return 1
    if ft == TypeKind.Struct and fld.field_type_name_len > 0
        return 1
    if ft == TypeKind.Ptr or ft == TypeKind.PtrPtr
        return 1
    0

# AGAST #2594: bind the array field value `val` (`x: [N]T`) to `name`: a
# copy of the field in its own `[N x T]` slot, registered as the array local
# an annotated `var a: [N]T` is, so `a[i]` reads at T's width.
fn tuple_bind_array_field(s: *EmitterState, fld: *StructField, val: i32, name_sv: StrView)
    var name: *u8 = name_sv.ptr
    var name_len: i32 = name_sv.len as i32
    let slot: i32 = next_reg(s)
    entry_alloca_reg_begin(s, slot)
    emit_field_llvm_type(s, fld)
    emit_str(s, c"\n")
    entry_alloca_reg_end(s)
    emit_str(s, c"  store ")
    emit_field_llvm_type(s, fld)
    emit_str(s, IR_SP)
    emit_reg(s, val)
    emit_str(s, IR_PTR_SEP)
    emit_reg(s, slot)
    emit_str(s, IR_NL)
    add_local_full(s, StrView { ptr: (name), len: (name_len) as i64 }, slot, TypeKind.Array, StrView { ptr: (fld.array_elem_type_name), len: (fld.array_elem_type_name_len) as i64 }, TypeKind.I64, fld.array_size, fld.array_elem_type)
    let loc: *LocalVar = local_at(s, s.local_count - 1)
    lv_set_array_elem_pointee(loc, fld.array_elem_pointee)
    lv_set_array_shape(loc, fld.array_shape)

# AGAST #2574: bind field `idx` of the struct value `init_reg` to `name`, at
# the field's own type: the slot and local an annotated `let a: T = p.f`
# gives it.  A bool is held as i64 (the unified value model) and marked
# is_bool; a pointer as the i64 every pointer local holds, with its pointee.
# Before, every field went into an i64 slot and only i32 / u32 were widened,
# so an i16 / i8 / f32 field gave IR clang refused.
fn tuple_bind_field(s: *EmitterState, fld: *StructField, sname_sv: StrView, init_reg: i32, idx: i32, name_sv: StrView)
    var sname: *u8 = sname_sv.ptr
    var slen: i32 = sname_sv.len as i32
    var name: *u8 = name_sv.ptr
    var name_len: i32 = name_sv.len as i32
    let ft: TypeKind = fld.field_type
    let val: i32 = next_reg(s)
    emit_str(s, IR_INDENT)
    emit_reg(s, val)
    emit_str(s, c" = extractvalue %")
    emit_name(s, StrView { ptr: (sname), len: (slen) as i64 })
    emit_str(s, IR_SP)
    emit_reg(s, init_reg)
    emit_str(s, IR_COMMA)
    emit_int(s, idx as i64)
    emit_str(s, IR_NL)
    if ft == TypeKind.Array
        tuple_bind_array_field(s, fld, val, StrView { ptr: (name), len: (name_len) as i64 })
        return
    var stored: i32 = val
    var slot_type: TypeKind = ft
    match ft
        TypeKind.Bool =>
            stored = next_reg(s)
            emit_str(s, IR_INDENT)
            emit_reg(s, stored)
            emit_str(s, c" = zext i1 ")
            emit_reg(s, val)
            emit_str(s, IR_TO_I64)
            slot_type = TypeKind.I64
        TypeKind.Ptr | TypeKind.PtrPtr =>
            stored = next_reg(s)
            emit_str(s, IR_INDENT)
            emit_reg(s, stored)
            emit_str(s, c" = ptrtoint ptr ")
            emit_reg(s, val)
            emit_str(s, IR_TO_I64)
        _ => pass
    let slot: i32 = next_reg(s)
    entry_alloca_reg_begin(s, slot)
    if ft == TypeKind.Struct
        emit_llvm_type_struct(s, TypeKind.Struct, StrView { ptr: (fld.field_type_name), len: (fld.field_type_name_len) as i64 })
    else
        emit_str(s, ty_value_llvm(slot_type))
    emit_str(s, c"\n")
    entry_alloca_reg_end(s)
    emit_str(s, c"  store ")
    if ft == TypeKind.Struct
        emit_llvm_type_struct(s, TypeKind.Struct, StrView { ptr: (fld.field_type_name), len: (fld.field_type_name_len) as i64 })
    else
        emit_str(s, ty_value_llvm(slot_type))
    emit_str(s, IR_SP)
    emit_reg(s, stored)
    emit_str(s, IR_PTR_SEP)
    emit_reg(s, slot)
    emit_str(s, IR_NL)
    match ft
        TypeKind.Ptr | TypeKind.PtrPtr =>
            add_local_full(s, StrView { ptr: (name), len: (name_len) as i64 }, slot, ft, StrView { ptr: (fld.field_type_name), len: (fld.field_type_name_len) as i64 }, fld.ptr_pointee, 0, TypeKind.Void)
            let ploc: *LocalVar = local_at(s, s.local_count - 1)
            lv_set_inner_pointee_type(ploc, fld.inner_pointee_type)
        TypeKind.Struct =>
            add_local_struct(s, StrView { ptr: (name), len: (name_len) as i64 }, slot, ft, StrView { ptr: (fld.field_type_name), len: (fld.field_type_name_len) as i64 })
        _ =>
            add_local(s, StrView { ptr: (name), len: (name_len) as i64 }, slot, slot_type)
            if ft == TypeKind.Bool
                let bloc: *LocalVar = local_at(s, s.local_count - 1)
                bloc.is_bool = 1

# AGAST #2574: after a refused destructure, bind both names to an i64 slot so
# each later use isn't a second, unlocated "unknown identifier" error.  The
# error count already stops any output being written.
fn tuple_decl_placeholders(s: *EmitterState, stmt: *Stmt)
    let a: i32 = next_reg(s)
    entry_alloca_reg(s, a, c"i64", null)
    add_local(s, StrView { ptr: (stmt.var_name), len: (stmt.var_name_len) as i64 }, a, TypeKind.I64)
    let b: i32 = next_reg(s)
    entry_alloca_reg(s, b, c"i64", null)
    add_local(s, StrView { ptr: (stmt.assign_target), len: (stmt.assign_target_len) as i64 }, b, TypeKind.I64)
    var tn: *TupleName = stmt.tuple_more   # AGAST #109
    while tn != null
        let c: i32 = next_reg(s)
        entry_alloca_reg(s, c, c"i64", null)
        add_local(s, StrView { ptr: (tn.name), len: (tn.len) as i64 }, c, TypeKind.I64)
        tn = tn.next

# `let (x, y) = expr` (AGAST #2574): destructure a struct value into two
# locals, its fields 0 and 1, each at its field's type.  AGAST #109: and
# field i into the tail's name i, for `let (x, y, z, ..)`.  A struct ritz1 can't
# name, or a field it can't bind, is a located error at the `let`: before,
# nothing was bound and every use failed, unlocated, as an unknown name.
fn emit_tuple_decl(s: *EmitterState, stmt: *Stmt)
    var sname: *u8 = null
    var slen: i32 = 0
    var init_reg: i32 = 0
    let init: *Expr = stmt.var_init
    if init.kind == ExprKind.Match or init.kind == ExprKind.If
        # AGAST #2594: a match / if block init.  Its arms' phi type is known
        # only once they are emitted, as for an untyped `let v = match`
        # (#1666): emit_match / the if publish it in last_match_agg_name.
        s.last_match_agg_name = null
        s.last_match_agg_name_len = 0
        s.last_match_float_ty = TypeKind.Void
        init_reg = emit_expr(s, init)
        if s.last_match_agg_name != null
            sname = s.last_match_agg_name
            slen = s.last_match_agg_name_len
    else
        tuple_decl_struct_name(s, init, @sname, @slen)
        # A copy of the struct it destructures: `let (a, b) = ps[1]` (#2996).
        init_reg = emit_struct_copy(s, init, TypeKind.Struct)
    var st: *StructDef = null
    if slen > 0
        st = find_struct(s, StrView { ptr: (sname), len: (slen) as i64 })
    if st == null
        emit_nd_error(s, stmt.span.line, stmt.span.col, c"ritz1 can't tell which struct this `let (a, b) = ...` destructures (destructure a call's result or a struct local, or bind the value with an annotated `let` first)")
        tuple_decl_placeholders(s, stmt)
        return
    let names: i32 = tuple_decl_arity(stmt)
    var i: i32 = 0
    while i < names
        let f: *StructField = get_field_type(st, i)
        if f == null
            emit_nd_error(s, stmt.span.line, stmt.span.col, c"`let (a, b, ...) = ...` needs a struct with a field for each name to destructure")
            tuple_decl_placeholders(s, stmt)
            return
        if tuple_field_bindable(f) == 0
            emit_nd_error(s, stmt.span.line, stmt.span.col, c"ritz1 can't destructure a field of this type (an array, `@` / `@&` or fn-typed field): read it as `v.f` instead")
            tuple_decl_placeholders(s, stmt)
            return
        i = i + 1
    tuple_bind_field(s, get_field_type(st, 0), StrView { ptr: (sname), len: (slen) as i64 }, init_reg, 0, StrView { ptr: (stmt.var_name), len: (stmt.var_name_len) as i64 })
    tuple_bind_field(s, get_field_type(st, 1), StrView { ptr: (sname), len: (slen) as i64 }, init_reg, 1, StrView { ptr: (stmt.assign_target), len: (stmt.assign_target_len) as i64 })
    var tn: *TupleName = stmt.tuple_more
    i = 2
    while tn != null
        tuple_bind_field(s, get_field_type(st, i), StrView { ptr: (sname), len: (slen) as i64 }, init_reg, i, StrView { ptr: (tn.name), len: (tn.len) as i64 })
        tn = tn.next
        i = i + 1

# AGAST #2575 / #2596: type an un-annotated let as the `*T` that
# ptr_root_pointee / ptr_arith_pointee resolved: `kind` is TypeKind.Struct (with
# the struct's name) for a `*S`, the primitive kind for a scalar `*T`, 0 for
# neither.  Returns TypeKind.Ptr once the let is typed, else 0 (dt untouched).
fn narrow_to_ptr(dt: *DeclTy, kind: TypeKind, name_sv: StrView) -> TypeKind
    var name: *u8 = name_sv.ptr
    var name_len: i32 = name_sv.len as i32
    if kind == TypeKind.Void
        return TypeKind.Void
    dt.var_type = TypeKind.Ptr
    dt.var_pointee_type = kind
    if kind == TypeKind.Struct
        dt.var_type_name = name
        dt.var_type_name_len = name_len
    TypeKind.Ptr

# 1 when the inferred pointee array's element is a struct: ast_query's
# names_array_elem_struct, for a DeclTy instead of the Stmt.
fn decl_pointee_array_elem_struct(dt: *DeclTy) -> i32
    if dt.var_pointee_array_size <= 0
        return 0
    let elem: TypeKind = dt.var_pointee_array_elem_type
    (elem == TypeKind.Struct or (elem == TypeKind.Ptr and dt.var_pointee_array_elem_pointee == TypeKind.Struct)) as i32

# AGAST #4407: as ast_query.name_array_ptr_local, reading the type the
# inference worked out (DeclTy) rather than the Stmt it no longer writes.
# Sema's callers of the original still pass a Stmt holding the parser's facts.
fn decl_name_array_ptr_local(loc: *LocalVar, dt: *DeclTy, name_sv: StrView)
    var name: *u8 = name_sv.ptr
    var len: i32 = name_sv.len as i32
    let deep_ptr: bool = ref_to_ptr(loc) == 1 or lv_var_type(loc) == TypeKind.PtrPtr
    if lv_type_name_len(loc) > 0 and deep_ptr and decl_pointee_array_elem_struct(dt) == 1
        lv_set_pointee_array_elem_name(loc, lv_type_name(loc), lv_type_name_len(loc))
        lv_set_type_name(loc, null, 0)
        return
    if lv_type_name_len(loc) > 0 or name == null or len <= 0
        return
    if dt.var_pointee_array_size <= 0 or dt.var_pointee_array_elem_type != TypeKind.Struct
        return
    let t: TypeKind = lv_var_type(loc)
    let one: bool = (t == TypeKind.Ptr or t == TypeKind.Ref or t == TypeKind.MutRef) and dt.var_pointee_type == TypeKind.Array
    # AGAST #3079: an `@*[N]S` / `@&*[N]S` (`let r = @q`) is as deep as a `**[N]S`.
    let deep: bool = t == TypeKind.PtrPtr or ((t == TypeKind.Ref or t == TypeKind.MutRef) and dt.var_pointee_type == TypeKind.Ptr)
    let two: bool = deep and dt.var_inner_pointee_type == (TypeKind.Array as i32)
    if one or two
        lv_set_pointee_array_elem_name(loc, name, len)

# AGAST #2417: the signature of an un-annotated `let f = mb`, a bare fn
# name: mb's own.  Without it a call `f(..)` was the untyped `call i64` and
# ref_walk had no slots to judge its arguments by.  Null when a local or a
# global of that name shadows the fn (the ident is that value, as
# emit_ident resolves it), or when the fn is generic.
fn inferred_fn_sig(s: *EmitterState, stmt: *Stmt) -> *FnDef
    if stmt.var_fn_sig != null or stmt.var_declared_type != TypeKind.Void
        return stmt.var_fn_sig
    let init: *Expr = stmt.var_init
    # AGAST #3666: `let h = t.f` / `let h = t.fs[1]` / `let h = fs[1]` hold
    # that fn type's value, so `h(s)` calls typed.
    if init != null and (init.kind == ExprKind.Member or init.kind == ExprKind.Index)
        return value_fn_sig(s, init)
    if init == null or init.kind != ExprKind.Ident
        return null
    if find_local(s, StrView { ptr: (init.ident_ptr), len: (init.ident_len) as i64 }) >= 0 or find_global(s, StrView { ptr: (init.ident_ptr), len: (init.ident_len) as i64 }) != null
        return null
    let f: *FnDef = find_fn(s, StrView { ptr: (init.ident_ptr), len: (init.ident_len) as i64 })
    if f == null or f.type_params != null
        return null
    f

# AGAST #3234: an untyped `let q = mka()[1]` types `q` from the element of
# the spill emit_expr reads it from, so the spill is made first, as for
# `let a = mka()` then `let q = a[1]`.
fn emit_var_decl(s: *EmitterState, stmt: *Stmt)
    if stmt.var_init != null and stmt.var_declared_type == TypeKind.Void and stmt.var_type_name_len == 0
        let ca_root: *Expr = call_array_index_root(s, stmt.var_init)
        if ca_root != null
            let ca_call: *Expr = call_array_spill(s, ca_root)
            emit_var_decl_at(s, stmt)
            call_array_unspill(ca_root, ca_call)
            return
    emit_var_decl_at(s, stmt)

fn emit_var_decl_at(s: *EmitterState, stmt: *Stmt)
    # AGAST #4407: the inferred type, local to this declaration (see DeclTy).
    var dt: DeclTy
    decl_ty_from(stmt, @dt)
    let view: i32 = let_ref_view(s, stmt, @dt)   # AGAST #3079
    # Use the user's explicit type annotation. The parser defaults
    # missing annotations to TypeKind.I64, so any TypeKind.I32 we see here
    # came from an explicit `: i32` and must NOT be overridden —
    # otherwise `var best_type: i32 = -1` stores i32 into an i64 slot,
    # and callers reading i64 see garbage in the upper half.
    narrow_note_decl(s, stmt)   # the check is Sema's (AGAST #3505)
    let fn_sig: *FnDef = inferred_fn_sig(s, stmt)   # AGAST #2417, before `f` is in scope
    # AGAST #2342: before `x` is in scope, as `let x: bool = x`.
    var init_kind: i32 = BK_UNSURE
    if stmt.var_init != null
        init_kind = bool_kind(s, stmt.var_init)
    # AGAST #2356 / #2527: as below, before `x` is in scope.
    let init_int: TypeKind = inferred_int_init(s, stmt, init_kind)
    var var_type: TypeKind = dt.var_type
    # AGAST #1521: remember a declared bool past the i64 promotion below.
    let declared_bool: i32 = (var_type == TypeKind.Bool) as i32

    # Bool slots use i64 storage in the unified value model.
    # Init expressions / loads / `if x` comparisons are all expressed in
    # i64 throughout the emitter — only function signatures and explicit
    # bool returns truncate to/zext from i1. Keeping `var x: bool` as an
    # i1 slot means the alloca is i1 but the init produces i64,
    # mismatching the `store`. Squeeze's inflate/deflate trip this with
    # `var found_uncompressed: bool = false`.  Promote the slot to i64
    # so all subsequent var operations agree.
    if var_type == TypeKind.Bool
        var_type = TypeKind.I64
        dt.var_type = TypeKind.I64

    # AGAST #2302: untyped `let b = f()` of a `-> [N]T` is the `[N]T` local
    # `let b: [N]T = f()` declares, as in ritz0.
    if stmt.var_declared_type == TypeKind.Void and dt.var_type_name_len == 0 and stmt.var_init != null
        let lra: *Param = call_ret_array(s, stmt.var_init)
        if lra != null
            var_type = TypeKind.Array
            dt.var_type = TypeKind.Array
            dt.var_array_size = lra.param_array_size
            dt.var_array_elem_type = lra.param_array_elem_type
            dt.var_array_elem_pointee = lra.param_array_elem_pointee
            dt.var_array_shape = lra.param_array_shape   # AGAST #3634: `[N][M]T`
            dt.var_type_name = lra.param_type_name
            dt.var_type_name_len = lra.param_type_name_len
        # AGAST #3191: so is `let c = *p` of a `*[N]T` (local, field, global,
        # `p + k`): the `[N]T` local `let c: [N]T = *p` declares, copied.
        else if stmt.var_init.kind == ExprKind.Unary and stmt.var_init.op == OpKind.Deref
            var dsh: ArraySrc
            let dnd: *ArrayShape = deref_nd_shape(s, stmt.var_init.operand)
            if dnd != null and dnd.leaf_type == TypeKind.Struct and dnd.leaf_name_len > 0 and own_type_is_move_only(s, StrView { ptr: (dnd.leaf_name), len: (dnd.leaf_name_len) as i64 }) == 1
                # A move-only leaf isn't copied out from behind a pointer, as
                # ritz0 refuses it ("cannot move out of a reference").
                emit_nd_error(s, stmt.span.line, stmt.span.col, c"copying the multi-dimensional array a pointer points at (`let c = *p`) moves its move-only elements out from behind the pointer: index it, `p[i][j]`")
            else if dnd != null
                # AGAST #3635: the `[N][M]..T` local `let c: [N][M]T = *p`
                # declares, copied (emit_nd_array_init_copy), as a plane is
                # (#3350).  #2098 refused it: the #3191 copy was the flat one.
                var_type = TypeKind.Array
                dt.var_type = TypeKind.Array
                dt.var_array_size = dnd.dims[0]
                dt.var_array_elem_type = TypeKind.Array
                dt.var_array_elem_pointee = TypeKind.Void
                dt.var_array_shape = dnd
                dt.var_type_name = null
                dt.var_type_name_len = 0
            else if array_ptr_shape(s, stmt.var_init.operand, @dsh) == 1
                var_type = TypeKind.Array
                dt.var_type = TypeKind.Array
                dt.var_array_size = dsh.size
                dt.var_array_elem_type = dsh.elem
                dt.var_type_name = dsh.name
                dt.var_type_name_len = dsh.name_len
        # AGAST #2305: and `let r = if c then f() else g()`: an arm's array.
        # AGAST #3276: and `let r = match c` + arms of arrays.
        else
            match stmt.var_init.kind
                ExprKind.If | ExprKind.Match =>
                    var ish: ArraySrc
                    var ipt: TypeKind = dt.var_array_elem_pointee
                    if if_array_shape(s, stmt.var_init, @ish, @ipt) == 1
                        var_type = TypeKind.Array
                        dt.var_type = TypeKind.Array
                        dt.var_array_size = ish.size
                        dt.var_array_elem_type = ish.elem
                        dt.var_array_elem_pointee = ipt
                        dt.var_type_name = ish.name
                        dt.var_type_name_len = ish.name_len
                # AGAST #3017: and `let arr = h.a` of an `a: [N]T` field (any root
                # resolve_member_chain_field types, a Box's Deref included): the `[N]T`
                # local `let arr: [N]T = h.a` declares, copied.  The slot was i64, so
                # clang rejected `store i64 %<[N x T]>`.
                ExprKind.Member =>
                    let af: *StructField = resolve_member_chain_field(s, stmt.var_init)
                    if af != null and af.field_type == TypeKind.Array
                        var_type = TypeKind.Array
                        dt.var_type = TypeKind.Array
                        dt.var_array_size = af.array_size
                        dt.var_array_elem_type = af.array_elem_type
                        dt.var_array_elem_pointee = af.array_elem_pointee
                        dt.var_array_shape = af.array_shape
                        dt.var_type_name = af.array_elem_type_name
                        dt.var_type_name_len = af.array_elem_type_name_len
                # AGAST #3322: and `let r = g[i]`, a row of an `[N][M]T` (local,
                # global, field, plane pointer; the inner row of a deeper one): the
                # `[M]T` local `let r: [M]T = g[i]` declares, copied, as ritz0 binds
                # it.  The slot was i64 and the row the located "not a value" error.
                # A leaf naming no struct (#3141) keeps that error.
                # AGAST #3350: a row that is itself N-D, a plane (`g[1]` of
                # `[2][2][3]T`), is the `[2][3]T` local `let p: [2][3]T = g[1]`
                # declares; emit_nd_array_init_copy copies it.
                ExprKind.Index =>
                    var row_depth: i32 = 0
                    let row_sh: *ArrayShape = nd_index_shape(s, stmt.var_init, @row_depth)
                    if row_sh != null and row_depth == row_sh.rank - 1 and (row_sh.leaf_type != TypeKind.Struct or row_sh.leaf_name_len > 0)
                        var_type = TypeKind.Array
                        dt.var_type = TypeKind.Array
                        dt.var_array_size = row_sh.dims[row_sh.rank - 1]
                        dt.var_array_elem_type = row_sh.leaf_type
                        dt.var_array_elem_pointee = row_sh.leaf_pointee
                        dt.var_type_name = row_sh.leaf_name
                        dt.var_type_name_len = row_sh.leaf_name_len
                    else if row_sh != null and row_depth <= row_sh.rank - 2 and (row_sh.leaf_type != TypeKind.Struct or row_sh.leaf_name_len > 0)
                        let plane_sh: *ArrayShape = nd_plane_shape(s, stmt.var_init)
                        var_type = TypeKind.Array
                        dt.var_type = TypeKind.Array
                        dt.var_array_size = plane_sh.dims[0]
                        dt.var_array_elem_type = TypeKind.Array
                        dt.var_array_elem_pointee = TypeKind.Void
                        dt.var_array_shape = plane_sh
                        dt.var_type_name = null
                        dt.var_type_name_len = 0
                _ => pass

    # AGAST #1666: untyped `let v = match ...`.  The merge phi's type is only
    # known once the arms are emitted (#1645: `%StrView`, `%Point`, or i64),
    # and the slot below is sized before the init is emitted.  So emit the
    # match first and take the slot type from emit_match's phi.  Without
    # this the slot stayed i64 and clang rejected `store i64 <%StrView phi>`.
    # Shadowing is unaffected: `v` is registered after its initializer.
    var pre_init_reg: i32 = 0
    var pre_emitted: i32 = 0
    if var_type == TypeKind.I64 and dt.var_type_name_len == 0 and stmt.var_init != null
        # ExprKind.If (#1613) publishes its phi type the same way.
        if stmt.var_init.kind == ExprKind.Match or stmt.var_init.kind == ExprKind.If
            # Clear first so a stale type from an earlier match can't leak in.
            s.last_match_agg_name = null
            s.last_match_agg_name_len = 0
            s.last_match_float_ty = TypeKind.Void
            # AGAST #2454: arms ending in Some / None / Ok / Err build the
            # enum they name, not the no-enum zero.
            var arms_enum: *u8 = null
            var arms_enum_len: i32 = 0
            var ptr_phi_len: i32 = 0
            let ptr_phi_name: *u8 = ptr_phi_let_struct(s, stmt.var_init, @ptr_phi_len)   # AGAST #2960
            let arms: i32 = infer_ctor_arms(s, stmt, @arms_enum, @arms_enum_len)
            # AGAST #2296: an `i64` or untyped let is a slot with no struct
            # type, so no `Span.empty()` arm takes the fn's T.
            var pre_slot: SlotCtx
            enter_slot_ctx(s, @pre_slot, TypeKind.Void, StrView { ptr: (null), len: (0) as i64 })
            if arms == 1
                pre_init_reg = emit_ctor_scrutinee(s, stmt.var_init, StrView { ptr: (arms_enum), len: (arms_enum_len) as i64 })
            else if arms == 0
                pre_init_reg = emit_expr(s, stmt.var_init)
            else
                pre_init_reg = emit_zero_i64(s)   # refused: its arms are not emitted
            leave_slot_ctx(s, @pre_slot)
            pre_emitted = 1
            if s.last_match_agg_name != null and s.last_match_agg_name_len > 0
                var_type = TypeKind.Struct
                dt.var_type = TypeKind.Struct
                dt.var_type_name = s.last_match_agg_name
                dt.var_type_name_len = s.last_match_agg_name_len
            else if s.last_match_float_ty != TypeKind.Void
                # AGAST #1946: float-valued arms, `let v = match o` with
                # `Some(x) => x` over Option<f64>: a `double` slot.
                var_type = s.last_match_float_ty
                dt.var_type = var_type
            else if ptr_phi_name != null and arms == 0
                # AGAST #2960: a `ptr` phi of `@&C` arms is an `@&C` slot.
                var_type = TypeKind.MutRef
                dt.var_type = TypeKind.MutRef
                dt.var_type_name = ptr_phi_name
                dt.var_type_name_len = ptr_phi_len
                dt.var_pointee_type = TypeKind.Struct

    if var_type == TypeKind.I64 and dt.var_type_name_len == 0 and pre_emitted == 0
        if infer_ctor_let(s, stmt, @dt) == 1
            var_type = TypeKind.Struct

    # AGAST #2266: `var a = [t, u]` of struct T is `[2]T`, as annotated.  It
    # was an i64 slot, and its elements were stored as i64 (invalid IR).
    # AGAST #2976: so is `let a = [c; 3]`, `[3]C` (array_fill_struct_elem).
    # AGAST #3014: and a scalar element, at ritz0's type for the first one
    # (array_init_elem): `[5, 6, 7]` is `[3]i64`, `[x; 4]` with `x: u8` is
    # `[4]u8`.  A scalar kept the i64 slot, which held the address of
    # emit_expr's shadow `[N x i64]`, so `a[2]` silently read garbage.
    if var_type == TypeKind.I64 and dt.var_type_name_len == 0 and stmt.var_declared_type == TypeKind.Void and stmt.var_init != null and (stmt.var_init.kind == ExprKind.ArrayLit or stmt.var_init.kind == ExprKind.ArrayFill)
        var ael_name: *u8 = null
        var ael_len: i32 = 0
        var ael_ty: TypeKind = array_init_elem(s, stmt.var_init, @ael_name, @ael_len)
        # AGAST #3029: `[@x, @x]` is `[2]*T`, T recorded.
        var ael_pointee: TypeKind = TypeKind.Void
        if ael_ty == TypeKind.Void
            ael_pointee = array_init_ptr_pointee(s, stmt.var_init, @ael_name, @ael_len)
            if ael_pointee != TypeKind.Void
                ael_ty = TypeKind.Ptr
        # AGAST #4656: `[(t, 1)]` is `[1](T, i64)`, the tuple its first
        # element's elements name.
        if ael_ty == TypeKind.Void and stmt.var_init.kind == ExprKind.ArrayLit and tuple_lit_nameless(stmt.var_init.args) == 1
            if tuple_lit_name(s, stmt.var_init.args, StrView { ptr: (null), len: (0) as i64 }, @ael_name, @ael_len) == 1
                ael_ty = TypeKind.Struct
        var ael_n: i32 = 0
        if stmt.var_init.kind == ExprKind.ArrayFill
            ael_n = stmt.var_init.int_val as i32
        else
            var ael_it: *Expr = stmt.var_init.args
            while ael_it != null
                ael_n += 1
                ael_it = ael_it.next
        if ael_ty != TypeKind.Void and ael_n > 0
            var_type = TypeKind.Array
            dt.var_type = TypeKind.Array
            dt.var_array_size = ael_n
            dt.var_array_elem_type = ael_ty
            dt.var_array_elem_pointee = ael_pointee
            dt.var_type_name = ael_name
            dt.var_type_name_len = ael_len

    # Infer struct type for `var IDENT = expr` (no annotation).
    # The parser defaults missing annotations to TypeKind.I64, which is
    # fine for numeric initializers but breaks when the initializer
    # returns a struct (e.g. `var v = vec_new<i32>()` → `%Vec$i32`).
    # When we see a plain TypeKind.I64 with no type-name but a call-style
    # initializer whose resolved function returns a struct, narrow
    # var_type to the struct so the alloca/store widths match.
    if var_type == TypeKind.I64 and dt.var_type_name_len == 0 and stmt.var_init != null
        match stmt.var_init.kind
            ExprKind.Call =>
                # AGAST #1797: `let b = Holds(20)` is the user enum it builds.
                var uc_name: *u8 = null
                var uc_len: i32 = 0
                user_variant_ctor_enum(s.mono.pctx, stmt.var_init, @uc_name, @uc_len)
                var fn_def: *FnDef = null
                if uc_name != null
                    var_type = TypeKind.Struct
                    dt.var_type = TypeKind.Struct
                    dt.var_type_name = uc_name
                    dt.var_type_name_len = uc_len
                else
                    fn_def = find_call_fn(s, stmt.var_init)
                if fn_def != null and fn_def.return_type == TypeKind.PtrPtr
                    var_type = infer_ptr_ptr_call_let(s, @dt, fn_def)
                else if fn_def != null and fn_def.return_type == TypeKind.Struct
                    if fn_def.return_type_name != null and fn_def.return_type_name_len > 0
                        var_type = TypeKind.Struct
                        dt.var_type = TypeKind.Struct
                        dt.var_type_name = fn_def.return_type_name
                        dt.var_type_name_len = fn_def.return_type_name_len
                # AGAST #1980: `let p = vec_as_ptr<i32>(@v)` -- monomorph names a
                # specialised `-> *T`'s pointee "i32".  That is a pointee kind, not
                # a struct: register p like `let p: *i32` (element stride/load
                # width from var_pointee_type), not as a pointer to struct %i32.
                else if fn_def != null and fn_def.return_type == TypeKind.Ptr and primitive_type_from_name(StrView { ptr: (fn_def.return_type_name), len: (fn_def.return_type_name_len) as i64 }) != TypeKind.Void
                    var_type = TypeKind.Ptr
                    dt.var_type = TypeKind.Ptr
                    dt.var_type_name = null
                    dt.var_type_name_len = 0
                    dt.var_pointee_type = primitive_type_from_name(StrView { ptr: (fn_def.return_type_name), len: (fn_def.return_type_name_len) as i64 })
                else if fn_def != null and fn_def.return_type == TypeKind.Ptr and fn_def.return_type_name != null and fn_def.return_type_name_len > 0
                    # `let cqe = uring_peek_cqe(...)` — fn returns `*IoUringCqe`.
                    # Narrow the local to TypeKind.Ptr with the pointee struct name
                    # so `cqe.user_data` resolves the struct field via the
                    # ptr-to-struct member access path.  Matches the existing
                    # TypeKind.Struct branch above; extension covers async/tasks
                    # `let cqe = uring_peek_cqe(...)`, which previously left the
                    # local at TypeKind.I64 and tripped "; ERROR: unhandled
                    # ExprKind.Member".
                    var_type = TypeKind.Ptr
                    dt.var_type = TypeKind.Ptr
                    dt.var_type_name = fn_def.return_type_name
                    dt.var_type_name_len = fn_def.return_type_name_len
                # Float-returning fn → narrow to TypeKind.F32/F64 so the alloca
                # and downstream loads/stores are the right width (was
                # defaulting to i64 → `store i64 <float>` rejected by clang).
                else if fn_def != null and (fn_def.return_type == TypeKind.F32 or fn_def.return_type == TypeKind.F64)
                    var_type = fn_def.return_type
                    dt.var_type = fn_def.return_type
                # AGAST #175: pointer-returning fn (`-> *Foo`) - narrow to TypeKind.Ptr
                # with the pointee struct name so `let x = peek_cqe(...)` registers
                # x as a struct-pointer binding and `x.field` resolves via
                # find_local_struct_name. Without this, var_type stays TypeKind.I64,
                # the local has no type_name, and member access falls through to
                # "; ERROR: unhandled EXPR_MEMBER" with a stale `%.0`.
                else if fn_def != null and fn_def.return_type == TypeKind.Ptr
                    if fn_def.return_type_name != null and fn_def.return_type_name_len > 0
                        var_type = TypeKind.Ptr
                        dt.var_type = TypeKind.Ptr
                        dt.var_type_name = fn_def.return_type_name
                        dt.var_type_name_len = fn_def.return_type_name_len
                # AGAST #1453: reference-returning fn (`-> @L` / `-> @&L`).  A
                # reference is a pointer at the LLVM level, so register the local
                # exactly like #175's `-> *Foo` case: `let m = get(l); m.x` then
                # GEPs through the loaded pointer.  Without this the local stayed
                # TypeKind.I64 — reads failed "unhandled EXPR_MEMBER" and a store
                # `m.x = v` was silently dropped (#1439).
                else if fn_def != null and (fn_def.return_type == TypeKind.Ref or fn_def.return_type == TypeKind.MutRef)
                    if ret_ref_scalar_pointee(fn_def) != TypeKind.Void
                        # AGAST #2308: `-> @&i8` keeps its width, as `-> *i8` does.
                        var_type = TypeKind.Ptr
                        dt.var_type = TypeKind.Ptr
                        dt.var_pointee_type = ret_ref_scalar_pointee(fn_def)
                    else if fn_def.return_type_name != null and fn_def.return_type_name_len > 0
                        if find_struct(s, StrView { ptr: (fn_def.return_type_name), len: (fn_def.return_type_name_len) as i64 }) != null
                            var_type = TypeKind.Ptr
                            dt.var_type = TypeKind.Ptr
                            dt.var_type_name = fn_def.return_type_name
                            dt.var_type_name_len = fn_def.return_type_name_len
            # task-101: builtin method return-type table. Method calls like
            # `s.as_bytes()` hit compiler intrinsics (try_emit_strview_as_bytes),
            # NOT a real fn_def, so the ExprKind.Call branch above can't find them
            # via find_fn. Without narrowing here, the alloca defaults to i64 →
            # `store i64 %span, ptr %slot` with %span typed %Span$u8 =>
            # LLVM type-mismatch. Hardcode known builtin return types so the
            # slot is sized/typed correctly and the local is registered as a
            # struct so later `.len()` / method dispatch can resolve the
            # receiver type.
            ExprKind.Method =>
                # AGAST #1370: `let y = x.ceil()` on an f32 is an f32 slot.
                let init_fmt: TypeKind = float_method_result_ty(s, stmt.var_init)
                # AGAST #1466: `let a = Opt.Holds(41)` is the enum it builds.
                var qv_name: *u8 = null
                var qv_len: i32 = 0
                qualified_variant_enum(s, stmt.var_init, @qv_name, @qv_len)
                if qv_name != null
                    var_type = TypeKind.Struct
                    dt.var_type = TypeKind.Struct
                    dt.var_type_name = qv_name
                    dt.var_type_name_len = qv_len
                else if init_fmt != TypeKind.Void
                    var_type = init_fmt
                    dt.var_type = init_fmt
                # StrView.as_bytes() -> %Span$u8
                else if name_eq(StrView { ptr: (stmt.var_init.ident_ptr), len: (stmt.var_init.ident_len) as i64 }, StrView { ptr: (c"as_bytes"), len: (8) as i64 }) == 1
                    var_type = TypeKind.Struct
                    dt.var_type = TypeKind.Struct
                    dt.var_type_name = c"Span$u8"
                    dt.var_type_name_len = 7
                else
                    # task-112 / AGAST #1798: a method returning a struct or a
                    # float narrows the local to that type.  Resolve the callee
                    # exactly as emit_expr_method dispatches it: a UFCS helper
                    # (`a.slice(0, n)` and `a[:]` -> `vec_slice$i32` -> Vec$i32),
                    # a user impl method (`a.clone_self()`, static `Vec2.new()`),
                    # or a specialised generic impl method (`W$i32_dup`).  Only
                    # the impl table was walked before #1798, so a UFCS call left
                    # the local i64 and `s.push(5)` then failed "cannot determine
                    # receiver type for method call".
                    var recv_tn_len: i32 = 0
                    let recv_tn: *u8 = method_recv_type_name(s, stmt.var_init, @recv_tn_len)
                    var m: *FnDef = null
                    if recv_tn != null and recv_tn_len > 0
                        m = method_callee_def(s, StrView { ptr: (recv_tn), len: (recv_tn_len) as i64 }, StrView { ptr: (stmt.var_init.ident_ptr), len: (stmt.var_init.ident_len) as i64 })
                    if m != null
                        if m.return_type == TypeKind.Struct and m.return_type_name_len > 0
                            var_type = TypeKind.Struct
                            dt.var_type = TypeKind.Struct
                            dt.var_type_name = m.return_type_name
                            dt.var_type_name_len = m.return_type_name_len
                        else if m.return_type == TypeKind.F32 or m.return_type == TypeKind.F64
                            # Float-returning method: narrow so alloca/store
                            # width match (was `alloca i64; store float`).
                            var_type = m.return_type
                            dt.var_type = m.return_type
                        else if ret_ref_scalar_pointee(m) != TypeKind.Void
                            var_type = TypeKind.Ptr   # AGAST #2308, as for a call
                            dt.var_type = TypeKind.Ptr
                            dt.var_pointee_type = ret_ref_scalar_pointee(m)
                        else if m.return_type == TypeKind.Ptr and primitive_type_from_name(StrView { ptr: (m.return_type_name), len: (m.return_type_name_len) as i64 }) != TypeKind.Void
                            # AGAST #4537: `let p = v.as_ptr()` on a Vec<i32> is a
                            # `*i32`, as `let p = vec_as_ptr<i32>(@v)` was (#1980
                            # for a call).  The specialised method names the
                            # primitive pointee; left i64, `p + 1` stepped a byte.
                            var_type = TypeKind.Ptr
                            dt.var_type = TypeKind.Ptr
                            dt.var_type_name = null
                            dt.var_type_name_len = 0
                            dt.var_pointee_type = primitive_type_from_name(StrView { ptr: (m.return_type_name), len: (m.return_type_name_len) as i64 })
                        else if m.return_type == TypeKind.PtrPtr
                            # AGAST #4537: `let q = v.as_ptr()` on a Vec<*S> /
                            # Vec<*u8> / Vec<**u8> is the `**S` / `**u8` /
                            # `***u8` it is, as `let q = vec_as_ptr<..>(@v)`
                            # was (#2791).  Same decoder as the call arm, so a
                            # `ptr_` per level past two is read back too.
                            var_type = infer_ptr_ptr_call_let(s, @dt, m)
                        else if (m.return_type == TypeKind.Ptr or m.return_type == TypeKind.Ref or m.return_type == TypeKind.MutRef) and m.return_type_name_len > 0 and find_struct(s, StrView { ptr: (m.return_type_name), len: (m.return_type_name_len) as i64 }) != null
                            # AGAST #3620: `-> *S` / `-> @S` / `-> @&S` points
                            # at S, as a call's does (#175, #1453).  The local
                            # stayed i64, so prism's `let buf =
                            # self.get_draw_buffer_ref(); buf.set(..)` had no
                            # receiver type.
                            var_type = TypeKind.Ptr
                            dt.var_type = TypeKind.Ptr
                            dt.var_type_name = m.return_type_name
                            dt.var_type_name_len = m.return_type_name_len
                    else
                        # AGAST #2576: `let t = r.unwrap()`, r an Option<S> or a
                        # Result<S, E> (`mk().unwrap()`, angelo's ttf tests), is
                        # an `%S` slot, as ritz0 infers: the intrinsic
                        # (try_emit_enum_unwrap) has no FnDef to name it.  The
                        # slot stayed i64, so `t.f` was "unhandled EXPR_MEMBER"
                        # and, S a `Vec$E`, `t.len()` / `t[0]` had no receiver.
                        # AGAST #3620: or a user enum's `%E` (`match t` over it).
                        var up_name: *u8 = null
                        var up_len: i32 = 0
                        var up_kind: TypeKind = TypeKind.Void
                        var up_pname: *u8 = null
                        var up_plen: i32 = 0
                        var up_pointee: TypeKind = TypeKind.Void
                        unwrap_payload_struct_name(s, stmt.var_init, @up_name, @up_len)
                        if up_len > 0 and (find_struct(s, StrView { ptr: (up_name), len: (up_len) as i64 }) != null or user_enum_index(s.mono.pctx, StrView { ptr: (up_name), len: (up_len) as i64 }) >= 0)
                            var_type = TypeKind.Struct
                            dt.var_type = TypeKind.Struct
                            dt.var_type_name = up_name
                            dt.var_type_name_len = up_len
                        else if unwrap_payload_pointer_type(s, stmt.var_init, @up_kind, @up_pname, @up_plen, @up_pointee) == 1
                            # AGAST #4458: a `@T` / `@&T` / `*T` payload
                            # (`Option<@&Font>`, prism's text/font_manager) is the
                            # pointer local an annotated `let x: @&Font = ...`
                            # declares, so `x.f` and passing `x` to `:& T` work.
                            var_type = up_kind
                            dt.var_type = up_kind
                            dt.var_type_name = up_pname
                            dt.var_type_name_len = up_plen
                            dt.var_pointee_type = up_pointee
                        else
                            # AGAST #3161: a built-in `Span<T>.slice` (no FnDef) is
                            # the receiver's own Span$T.
                            var sl_name: *u8 = null
                            var sl_len: i32 = 0
                            span_builtin_slice_struct(s, stmt.var_init, @sl_name, @sl_len)
                            if sl_len > 0
                                var_type = TypeKind.Struct
                                dt.var_type = TypeKind.Struct
                                dt.var_type_name = sl_name
                                dt.var_type_name_len = sl_len
            # AGAST #1681: `var parsed = p` where `p` is a struct-typed local —
            # a by-value struct param or a struct `let`.  Copy its struct type
            # so the slot is `alloca %S` (was `alloca i64` → `store i64 %<%S>`
            # rejected by clang) and the new local resolves `.field`.  Blocked
            # examples/tier2_stdlib/77_args (`run`'s `var parsed = p`).
            ExprKind.Ident =>
                let src_loc: *LocalVar = find_local_struct_name(s, StrView { ptr: (stmt.var_init.ident_ptr), len: (stmt.var_init.ident_len) as i64 })
                # AGAST #2279: `var d = c` with `c:& C` copies the referent, as
                # ritz0 does.  It took the reference below, so writes to `d` reached
                # the caller.  Annotate `@C` to keep the reference.  `a:& [N]T` is
                # an array local, so the array arm below copies it (#2290).
                if lent_local(s, stmt.var_init) != null and lv_var_type(src_loc) == TypeKind.MutRef
                    var_type = TypeKind.Struct
                    dt.var_type = TypeKind.Struct
                    dt.var_type_name = lv_type_name(src_loc)
                    dt.var_type_name_len = lv_type_name_len(src_loc)
                else if src_loc != null and lv_var_type(src_loc) == TypeKind.Struct and lv_type_name_len(src_loc) > 0
                    var_type = TypeKind.Struct
                    dt.var_type = TypeKind.Struct
                    dt.var_type_name = lv_type_name(src_loc)
                    dt.var_type_name_len = lv_type_name_len(src_loc)
                # AGAST #2169: `var b = a` with `a: [N]T` -- `b` is `[N]T` too, and
                # the init copies the whole array (it was an i64 slot holding
                # a's first 8 bytes).  A multi-dimensional `a` keeps its shape
                # (#1509), so the initializer check below fails it closed.
                # AGAST #2322: only when `b` has no type of its own.  `var x: i64 = a`
                # became an array copy, ignoring the `i64`; ritz0 refuses it.
                else if src_loc != null and lv_var_type(src_loc) == TypeKind.Array and stmt.var_declared_type == TypeKind.Void
                    var_type = TypeKind.Array
                    dt.var_type = TypeKind.Array
                    dt.var_array_size = lv_array_size(src_loc)
                    dt.var_array_elem_type = lv_array_elem_type(src_loc)
                    dt.var_array_shape = lv_array_shape(src_loc)
                    dt.var_type_name = lv_type_name(src_loc)
                    dt.var_type_name_len = lv_type_name_len(src_loc)
                # AGAST #2287: `var b = G` with `G: [N]T`, as for a local.
                else if src_loc == null and global_array_named(s, stmt.var_init) != null and stmt.var_declared_type == TypeKind.Void
                    let src_g: *GlobalVarDef = global_array_named(s, stmt.var_init)
                    var_type = TypeKind.Array
                    dt.var_type = TypeKind.Array
                    dt.var_array_size = src_g.array_size
                    dt.var_array_elem_type = src_g.array_elem_type
                    dt.var_array_shape = src_g.array_shape
                    dt.var_type_name = src_g.array_elem_type_name
                    dt.var_type_name_len = src_g.array_elem_type_name_len
                # AGAST #3275: `var x = G` with `G: S`, a module-level struct or
                # enum -- `x` is an `S` too, as ritz0 types it.  The slot was i64,
                # so clang rejected `store i64 %<%S>`, `x.f` was "unhandled
                # ExprKind.Member" and `match x` refused a variant pattern.  Only when
                # `x` has no type of its own (as #2322 for arrays).
                else if src_loc == null and stmt.var_declared_type == TypeKind.Void and global_struct_named(s, stmt.var_init) != null
                    let src_sg: *GlobalVarDef = global_struct_named(s, stmt.var_init)
                    var_type = TypeKind.Struct
                    dt.var_type = TypeKind.Struct
                    dt.var_type_name = src_sg.type_name
                    dt.var_type_name_len = src_sg.type_name_len
                # LARB R60 / R48: `let q = C` with `const C: S = S {...}` -- the
                # slot is `alloca %S`, as for a struct global above, so `q.f`
                # resolves and the init copies the read-only data.
                else if src_loc == null and stmt.var_declared_type == TypeKind.Void and const_struct_named(s, stmt.var_init) != null
                    let src_sc: *ConstEntry = const_struct_named(s, stmt.var_init)
                    var_type = TypeKind.Struct
                    dt.var_type = TypeKind.Struct
                    dt.var_type_name = src_sc.type_name
                    dt.var_type_name_len = src_sc.type_name_len
                # AGAST #1754: `let q = s` with `s: @&S` / `@S` -- `q` takes `s`'s
                # reference type and pointee, so `q.a` resolves and the slot holds
                # the same `ptr` / i64 `s` loads as.  (Was i64 with no struct name:
                # "unhandled EXPR_MEMBER".)
                # AGAST #2352: and `p: @&i32` / `@i32`, a scalar pointee and no name.
                # AGAST #3079: and `p: @*i32` (`let p = @q`, q: *i32).
                else if src_loc != null and (lv_var_type(src_loc) == TypeKind.MutRef or lv_var_type(src_loc) == TypeKind.Ref) and (lv_type_name_len(src_loc) > 0 or scalar_pointee(lv_pointee_type(src_loc)) == 1 or lv_pointee_type(src_loc) == TypeKind.Ptr)
                    var_type = lv_var_type(src_loc)
                    dt.var_type = lv_var_type(src_loc)
                    dt.var_type_name = lv_type_name(src_loc)
                    dt.var_type_name_len = lv_type_name_len(src_loc)
                    dt.var_pointee_type = lv_pointee_type(src_loc)
                    dt.var_inner_pointee_type = lv_inner_pointee_type(src_loc)   # AGAST #2372: `s: @**S`
                    dt.var_inner_ref = lv_inner_ref(src_loc)   # AGAST #2399: `s: @@S`
                    # AGAST #2321: `s: @[N]S`, so `q[i]` is what `s[i]` is.
                    dt.var_pointee_array_size = lv_pointee_array_size(src_loc)
                    dt.var_pointee_array_elem_type = lv_pointee_array_elem_type(src_loc)
                # AGAST #1938: `let pp = q` with `q: **S` -- `pp` takes `q`'s
                # TypeKind.PtrPtr and struct name, so the #1933
                # registration below keeps S and `(**pp).f` resolves.  (Was i64
                # with no struct name: "unhandled EXPR_MEMBER".)
                else if src_loc != null and lv_var_type(src_loc) == TypeKind.PtrPtr and lv_type_name_len(src_loc) > 0
                    var_type = TypeKind.PtrPtr
                    dt.var_type = TypeKind.PtrPtr
                    dt.var_type_name = lv_type_name(src_loc)
                    dt.var_type_name_len = lv_type_name_len(src_loc)
                    # AGAST #1941: and q's inner pointee, so `*pp + 1` strides
                    # sizeof(S) (ptr_levels_of reads it).
                    dt.var_inner_pointee_type = lv_inner_pointee_type(src_loc)
                    dt.var_inner_ref = lv_inner_ref(src_loc)   # AGAST #2399: `q: *@S`
                # AGAST #2596: `let e = p` with `p: *S` / `*T` -- `e` is a `*S` /
                # `*T` too.  It was an i64 with no pointee: `e.b` "unhandled
                # ExprKind.Member", `@e.b` "cannot take address".
                else if src_loc != null and lv_var_type(src_loc) == TypeKind.Ptr
                    var cp_name: *u8 = null
                    var cp_len: i32 = 0
                    let cp_kind: TypeKind = ptr_root_pointee(s, stmt.var_init, @cp_name, @cp_len)
                    if narrow_to_ptr(@dt, cp_kind, StrView { ptr: (cp_name), len: (cp_len) as i64 }) != TypeKind.Void
                        var_type = TypeKind.Ptr
                # AGAST #1600: `let s = C`, a bare unit variant -- the slot is
                # `alloca %S` like the qualified `let s = S.C` below.
                else if src_loc == null
                    var en_name: *u8 = null
                    var en_len: i32 = 0
                    unit_enum_expr_name(s, stmt.var_init, @en_name, @en_len)
                    if en_len > 0
                        var_type = TypeKind.Struct
                        dt.var_type = TypeKind.Struct
                        dt.var_type_name = en_name
                        dt.var_type_name_len = en_len
            # task-101: bare "..." literal lowers to a %Span$u8 aggregate
            # (see emit_expr ExprKind.StringLit). Without widening, `let s = "ABC"`
            # hits the same store-i64-of-%Span$u8 mismatch that as_bytes does.
            ExprKind.StringLit =>
                var_type = TypeKind.Struct
                dt.var_type = TypeKind.Struct
                let lit_sv: StrView = strlit_struct(s)   # AGAST #4666
                dt.var_type_name = lit_sv.ptr
                dt.var_type_name_len = lit_sv.len as i32
            # AGAST #2131: `let s = "..." as StrView`.  A struct-target cast
            # emits its operand's register unchanged, so the local takes the
            # operand's struct type (the `%Span$u8` of the bare-literal arm above).
            _ =>
                if stmt.var_init.kind == ExprKind.Cast and stmt.var_init.type_kind == TypeKind.Struct
                    var cast_sn: *u8 = null
                    var cast_sn_len: i32 = 0
                    resolve_expr_struct_name(s, stmt.var_init, @cast_sn, @cast_sn_len)
                    if cast_sn_len > 0
                        var_type = TypeKind.Struct
                        dt.var_type = TypeKind.Struct
                        dt.var_type_name = cast_sn
                        dt.var_type_name_len = cast_sn_len
                # AGAST #1976: `let s = c"..."` is a `*u8`, exactly as if annotated.
                # Without this the local kept the parser default TypeKind.I64 with no
                # pointee, so `*(s + 1)` loaded 8 bytes (`load i64`) and
                # `*(s + 1) == 45` compared "-b\0..." against 45.  Same shape as the
                # ExprKind.Cast arm below gives `let p = raw as *u8`.
                else
                    match stmt.var_init.kind
                        ExprKind.CstringLit =>
                            var_type = TypeKind.Ptr
                            dt.var_type = TypeKind.Ptr
                            dt.var_pointee_type = TypeKind.U8
                        # task-103: same widening for `let w = Wrap { ... }`. Without this,
                        # var_type stays TypeKind.I64 → alloca i64 (8 bytes) instead of %Wrap,
                        # AND w isn't registered with add_local_struct, so later
                        # `w.field` lookups via find_local_struct_name miss → emit_member_ptr
                        # fails → "; ERROR: unhandled EXPR_MEMBER".
                        ExprKind.StructLit =>
                            # AGAST #3005: `let t = (a, b)` names its tuple from its elements.
                            # #4408: the name is returned, not written onto the literal.
                            var lit_name: *u8 = null
                            var lit_name_len: i32 = 0
                            tuple_lit_name(s, stmt.var_init, StrView { ptr: (null), len: (0) as i64 }, @lit_name, @lit_name_len)
                            if lit_name != null and lit_name_len > 0
                                let lit_st: *StructDef = find_struct(s, StrView { ptr: (lit_name), len: (lit_name_len) as i64 })
                                if lit_st != null
                                    var_type = TypeKind.Struct
                                    dt.var_type = TypeKind.Struct
                                    dt.var_type_name = lit_name
                                    dt.var_type_name_len = lit_name_len
                        # Qualified enum variant: `let a = Shade.Light`.  ExprKind.Member on an
                        # enum type produces a %Shade-typed register (alloca/store/load
                        # pattern in emit_expr_member); the var-decl slot must therefore be
                        # %Shade so the store width matches.  Without this narrowing, the
                        # alloca defaulted to i64 → "store %Shade %.X, ptr <i64-slot>" was
                        # rejected by clang.
                        #
                        # AGAST #1660: an enum-typed FIELD (`let k = e.kind`) loads the same
                        # %Kind aggregate, so it narrows the same way.  The slot stayed i64
                        # and argspec's `store i64 %<%ArgErrorKind>` was rejected by clang.
                        ExprKind.Member =>
                            var en_name: *u8 = null
                            var en_len: i32 = 0
                            unit_enum_expr_name(s, stmt.var_init, @en_name, @en_len)
                            if en_len > 0
                                var_type = TypeKind.Struct
                                dt.var_type = TypeKind.Struct
                                dt.var_type_name = en_name
                                dt.var_type_name_len = en_len
                            else
                                # AGAST #2172: a struct-typed field -- `var u = o.i`,
                                # `var w = mk().i`, `let a = d.o.i`, `let u = p.i` -- is a
                                # `%In` slot, as ritz0 infers.  The slot stayed i64: `u.x`
                                # then failed "unhandled EXPR_MEMBER", or the init emitted
                                # `store i64 %<%In>`.  resolve_member_chain_field types the
                                # chain for every root emit_member_ptr lowers (local,
                                # global, call / method result, index, deref).
                                let mf: *StructField = resolve_member_chain_field(s, stmt.var_init)
                                if mf != null and mf.field_type == TypeKind.Struct and mf.field_type_name_len > 0
                                    # AGAST #3620: an `Option<T>` / `Result<T, E>` field is
                                    # its `%Option$T` slot too (find_struct knows no tagged
                                    # enum), as the `?` arm reads one (#2267).  prism's
                                    # `let action = self.hotkey_triggered` stored i64.
                                    if find_struct(s, StrView { ptr: (mf.field_type_name), len: (mf.field_type_name_len) as i64 }) != null or is_tagged_enum_type(StrView { ptr: (mf.field_type_name), len: (mf.field_type_name_len) as i64 }) == 1
                                        var_type = TypeKind.Struct
                                        dt.var_type = TypeKind.Struct
                                        dt.var_type_name = mf.field_type_name
                                        dt.var_type_name_len = mf.field_type_name_len
                                # AGAST #2596: a `*T` field -- `let e = v.data` of a `Vec<E>`
                                # -- is a `*T`, as if annotated (was i64: `e.b` "unhandled
                                # ExprKind.Member").
                                else if mf != null and mf.field_type == TypeKind.Ptr
                                    var fp_name: *u8 = null
                                    var fp_len: i32 = 0
                                    let fp_kind: TypeKind = ptr_root_pointee(s, stmt.var_init, @fp_name, @fp_len)
                                    if narrow_to_ptr(@dt, fp_kind, StrView { ptr: (fp_name), len: (fp_len) as i64 }) != TypeKind.Void
                                        var_type = TypeKind.Ptr
                        # try-expression: `let data = read_bytes()?`. The try-emit hands back
                        # the unwrapped Ok payload, which is a struct (e.g., %Vec$u8) when
                        # the Result's Ok variant carries a struct.  Narrow var_type to that
                        # struct so the alloca matches the load width — without this, the
                        # slot is i64-sized and the call's struct arg coerces from a
                        # truncated 8-byte register.
                        ExprKind.Try =>
                            var inner_call: *Expr = stmt.var_init.left
                            if inner_call != null
                                # Resolve inner Result/Option's payload type from the
                                # callee's FnDef: a fn's return-type-name, or (AGAST #3238)
                                # a method's, `let p = r.mk()?`.
                                var carrier_name: *u8 = null
                                var carrier_name_len: i32 = 0
                                match inner_call.kind
                                    ExprKind.Call =>
                                        let fdr: *FnDef = find_call_fn(s, inner_call)
                                        if fdr != null and fdr.return_type == TypeKind.Struct
                                            carrier_name = fdr.return_type_name
                                            carrier_name_len = fdr.return_type_name_len
                                    ExprKind.Method =>
                                        try_method_carrier(s, inner_call, @carrier_name, @carrier_name_len)
                                    # AGAST #2267: a field, `let x = h.r?` of `r: Result<T, E>`,
                                    # from the field's declared type.  The slot stayed i64, so the
                                    # unwrapped `%T` was stored as `i64` (invalid IR).
                                    ExprKind.Member =>
                                        let cf: *StructField = resolve_member_chain_field(s, inner_call)
                                        if cf != null and cf.field_type == TypeKind.Struct and cf.field_type_name_len > 0
                                            if is_tagged_enum_type(StrView { ptr: (cf.field_type_name), len: (cf.field_type_name_len) as i64 }) == 1
                                                carrier_name = cf.field_type_name
                                                carrier_name_len = cf.field_type_name_len
                                    _ => pass
                                if carrier_name != null and carrier_name_len > 0
                                    # The Ok payload's struct or user-enum type (AGAST
                                    # #2105: an enum local is TypeKind.Struct + its name, as
                                    # for `let o = Holds(1)` above).
                                    var pay_len: i32 = 0
                                    let pay: *u8 = tagged_enum_payload_named(s, StrView { ptr: (carrier_name), len: (carrier_name_len) as i64 }, @pay_len, 1)
                                    if pay != null
                                        var_type = TypeKind.Struct
                                        dt.var_type = TypeKind.Struct
                                        dt.var_type_name = pay
                                        dt.var_type_name_len = pay_len
                        # AGAST #1453: `let p = raw as *P`.  The parser records the cast's
                        # pointee on the ExprKind.Cast node (cast_ptr_kind = pointee kind, ident_ptr =
                        # struct name; see apply_cast_tail).  Narrow the local exactly as the
                        # annotated `let p: *P = raw as *P` would be: TypeKind.Ptr plus the struct
                        # name for `p.field`, or the primitive pointee kind so `*(q + i)` on
                        # `raw as *i32` is scaled and loaded as i32.  Without this the local
                        # stayed TypeKind.I64: member reads failed "unhandled EXPR_MEMBER",
                        # member stores were silently dropped, and arithmetic stepped by 1.
                        ExprKind.Cast =>
                            if stmt.var_init.type_kind == TypeKind.Ptr and stmt.var_init.cast_ptr_kind != (TypeKind.Void as i32)
                                let cast_pointee: TypeKind = ptr_slot_flat(stmt.var_init.cast_ptr_kind)
                                if cast_pointee == TypeKind.Struct
                                    if stmt.var_init.ident_ptr != null and stmt.var_init.ident_len > 0
                                        var_type = TypeKind.Ptr
                                        dt.var_type = TypeKind.Ptr
                                        dt.var_type_name = stmt.var_init.ident_ptr
                                        dt.var_type_name_len = stmt.var_init.ident_len
                                        dt.var_pointee_type = TypeKind.Struct
                                else
                                    var_type = TypeKind.Ptr
                                    dt.var_type = TypeKind.Ptr
                                    dt.var_pointee_type = cast_pointee
                        # AGAST #2575 / #2598: `let e = vec_as_ptr<E>(@v) + 1` is a `*E`, and
                        # `let e = q + 1` (q: *i32) a `*i32`, as if annotated.
                        ExprKind.Binary =>
                            var pa_name: *u8 = null
                            var pa_len: i32 = 0
                            let pa_kind: TypeKind = ptr_arith_pointee(s, stmt.var_init, @pa_name, @pa_len)
                            if narrow_to_ptr(@dt, pa_kind, StrView { ptr: (pa_name), len: (pa_len) as i64 }) != TypeKind.Void
                                var_type = TypeKind.Ptr
                        # AGAST #175: address-of expression. `let task = @pool.tasks[i]` used
                        # to keep var_type=TypeKind.I64 with no type_name → the local was added as
                        # a plain i64 binding, so later `task.field` calls find_local_struct_name
                        # got null and emit_member_ptr fell through to "; ERROR: unhandled
                        # ExprKind.Member" with a stale `%.0` reference (use of undefined value
                        # in the icmp). Narrow var_type to TypeKind.Ptr + struct name when we can
                        # statically resolve the pointee struct, so add_local_struct registers
                        # the binding and `.field` access GEPs through the loaded pointer.
                        # Same family of fixes as ritz-task-170 (chained ExprKind.Member addr-of).
                        ExprKind.Unary =>
                            if stmt.var_init.op == OpKind.Addr or stmt.var_init.op == OpKind.AddrMut
                                var addr_pointee: *u8 = null
                                var addr_pointee_len: i32 = 0
                                let addr_oper: *Expr = stmt.var_init.operand
                                if addr_oper != null
                                    # @ident: pointee = the local's struct type
                                    match addr_oper.kind
                                        ExprKind.Ident =>
                                            let aloc: *LocalVar = find_local_struct_name(s, StrView { ptr: (addr_oper.ident_ptr), len: (addr_oper.ident_len) as i64 })
                                            if aloc != null
                                                if (lv_var_type(aloc) == TypeKind.Struct and lv_type_name_len(aloc) > 0) or lent_struct_local(s, addr_oper) != null
                                                    addr_pointee = lv_type_name(aloc)
                                                    addr_pointee_len = lv_type_name_len(aloc)
                                            # AGAST #3026: `@g` of a module-level struct global
                                            # is a `*G` too.  It stayed i64, so `p.ptr[0]` /
                                            # `p.ptr.k` was "unhandled EXPR_MEMBER".
                                            else
                                                let aglob: *GlobalVarDef = find_global(s, StrView { ptr: (addr_oper.ident_ptr), len: (addr_oper.ident_len) as i64 })
                                                if aglob != null and aglob.var_type == TypeKind.Struct and aglob.type_name_len > 0
                                                    addr_pointee = aglob.type_name
                                                    addr_pointee_len = aglob.type_name_len
                                        # @arr[i]  OR  @<chained-member>[i] — pointee = array element struct
                                        ExprKind.Index =>
                                            match addr_oper.left.kind
                                                ExprKind.Ident =>
                                                    let aarr: *LocalVar = find_local_struct_name(s, StrView { ptr: (addr_oper.left.ident_ptr), len: (addr_oper.left.ident_len) as i64 })
                                                    if aarr != null
                                                        if lv_var_type(aarr) == TypeKind.Array and lv_array_elem_type(aarr) == TypeKind.Struct and lv_type_name_len(aarr) > 0
                                                            addr_pointee = lv_type_name(aarr)
                                                            addr_pointee_len = lv_type_name_len(aarr)
                                                    # AGAST #3129: `@ga[i]` of a global struct array
                                                    # is a `*S` too, as #3026 does `@g`.  It stayed i64,
                                                    # so `p.x` was "unhandled EXPR_MEMBER".
                                                    else
                                                        let agarr: *GlobalVarDef = find_global(s, StrView { ptr: (addr_oper.left.ident_ptr), len: (addr_oper.left.ident_len) as i64 })
                                                        if agarr != null and agarr.var_type == TypeKind.Array and agarr.array_elem_type == TypeKind.Struct and agarr.array_elem_type_name_len > 0
                                                            addr_pointee = agarr.array_elem_type_name
                                                            addr_pointee_len = agarr.array_elem_type_name_len
                                                        # AGAST #3976: `@T[i]` of a const struct table
                                                        # (LARB R48) too.  It stayed i64, so `r.a`
                                                        # was "unhandled EXPR_MEMBER".
                                                        let actab: *ConstEntry = const_struct_table_named(s, addr_oper.left)
                                                        if actab != null
                                                            addr_pointee = actab.array_elem_type_name
                                                            addr_pointee_len = actab.array_elem_type_name_len
                                                ExprKind.Member =>
                                                    # Walk arbitrary-depth member chain (`srv.pool.tasks[i]`)
                                                    # and pick up the array element type from the leaf field.
                                                    let arr_field: *StructField = resolve_member_chain_field(s, addr_oper.left)
                                                    if arr_field != null
                                                        if arr_field.field_type == TypeKind.Array and arr_field.array_elem_type == TypeKind.Struct and arr_field.array_elem_type_name_len > 0
                                                            addr_pointee = arr_field.array_elem_type_name
                                                            addr_pointee_len = arr_field.array_elem_type_name_len
                                                _ => pass
                                            # AGAST #3972: and over a `*S` field, or through a Vec,
                                            # Span or String (`@t.es[i]`, angelo's `@edge_table.edges[k]`).
                                            if addr_pointee == null
                                                addr_pointee = addr_index_elem_struct(s, addr_oper, @addr_pointee_len)
                                        # @<chained-member> — pointee = field's struct type
                                        ExprKind.Member =>
                                            let mfield: *StructField = resolve_member_chain_field(s, addr_oper)
                                            if mfield != null
                                                if mfield.field_type == TypeKind.Struct and mfield.field_type_name_len > 0
                                                    addr_pointee = mfield.field_type_name
                                                    addr_pointee_len = mfield.field_type_name_len
                                        _ => pass
                                if addr_pointee != null and addr_pointee_len > 0
                                    var_type = TypeKind.Ptr
                                    dt.var_type = TypeKind.Ptr
                                    dt.var_type_name = addr_pointee
                                    dt.var_type_name_len = addr_pointee_len
                            # AGAST #2542: `let v = *p` / `*(p + i)` / `**r` with a struct or
                            # enum pointee is that aggregate, as if annotated.  The slot stayed
                            # i64 with no name: `v.b` was refused "unlowerable" and `match v`
                            # on an enum reported a false "unreachable arm".  The deref loads
                            # `%<name>` exactly when deref_pointee_struct_name gives one, so
                            # the slot takes the same name; a primitive pointee gives none.
                            # AGAST #2525: only when un-annotated.  `let n: i64 = *(q + 1)` is an
                            # i64, refused at the init as #2993 refuses `let n: i64 = ps[i]`;
                            # retyped, it compiled and failed later at `n`'s use.
                            else if stmt.var_init.op == OpKind.Deref and stmt.var_init.operand != null
                                var dr_name: *u8 = null
                                var dr_len: i32 = 0
                                deref_pointee_struct_name(s, stmt.var_init.operand, @dr_name, @dr_len)
                                if stmt.var_declared_type == TypeKind.Void and dr_name != null and dr_len > 0
                                    var_type = TypeKind.Struct
                                    dt.var_type = TypeKind.Struct
                                    dt.var_type_name = dr_name
                                    dt.var_type_name_len = dr_len
                        _ => pass

    struct_value_int_let_refused(s, stmt)   # #2525, #3188, #3198: `= *q`, `= l`, `= mk()`
    if infer_ref_to_pointer_let(s, stmt, @dt) == 1
        var_type = dt.var_type
    if infer_ref_to_scalar_let(s, stmt, @dt) == 1
        var_type = dt.var_type
    if infer_ptr_ptr_deref_let(s, stmt, @dt) == 1   # #3114: `*v`, v a `**S`
        var_type = dt.var_type
    if infer_array_ptr_let(s, stmt, @dt) == 1
        var_type = dt.var_type
    if infer_array_elem_let(s, stmt, @dt) == 1
        var_type = dt.var_type
    if infer_through_elem_let(s, stmt, @dt) == 1
        var_type = dt.var_type
    if infer_struct_elem_let(s, stmt, @dt) == 1
        var_type = dt.var_type
    if infer_ptr_index_let(s, stmt, @dt) == 1   # #2377: `a[i][j]`, a struct
        var_type = dt.var_type
    if infer_full_elem_ref_let(s, stmt, @dt) == 1   # #2571: `@&x[i]`, an element
        var_type = dt.var_type
    if infer_field_ref_let(s, stmt, @dt) == 1   # #2400: `@&p.f`, a scalar field
        var_type = dt.var_type

    # AGAST #4428: an array-element / element-address initialiser Sema typed
    # (sema_note_elem_init).  The arms above need a base their own views
    # record, which a `& [N]**T` borrow param is not, so `let r = b[i]` stayed
    # an i64 and `**r` stored through garbage.  Applied only when nothing
    # above typed the binding.
    if var_type == TypeKind.I64 and dt.var_type == TypeKind.I64 and dt.var_type_name_len == 0 and stmt.var_init != null and stmt.var_init.sema_levels > 0
        let lvls: i32 = stmt.var_init.sema_levels
        if lvls == 1
            var_type = TypeKind.Ptr
            dt.var_type = TypeKind.Ptr
            dt.var_pointee_type = ptr_slot_flat(stmt.var_init.sema_inner)
        else
            var_type = TypeKind.PtrPtr
            dt.var_type = TypeKind.PtrPtr
            dt.var_pointee_type = TypeKind.Ptr
            dt.var_inner_pointee_type = ptr_slot_deepen(stmt.var_init.sema_inner, lvls - 2)
        dt.var_type_name = stmt.var_init.sema_ptr_name
        dt.var_type_name_len = stmt.var_init.sema_ptr_name_len

    # `let task = @member.field[i]` — when the indexed field is an array
    # of struct, infer the local as `*ElementStruct` so subsequent
    # `task.state` member access resolves.  Without this, the local was
    # left as TypeKind.I64 (the parser default) and member access failed
    # with "; ERROR: unhandled EXPR_MEMBER".  Surfaces in ritzlib's
    # async/tasks `run_tasks` (`let task = @pool.tasks[i]`).
    # Handles single-level (`pool.tasks[i]`) and one-level chained
    # (`srv.pool.tasks[i]`) member access — the latter occurs in
    # async/tasks's `task_server_poll_tasks(srv: *TaskServer)`.
    if var_type == TypeKind.I64 and dt.var_type_name_len == 0 and stmt.var_init != null
        if stmt.var_init.kind == ExprKind.Unary and stmt.var_init.op == OpKind.Addr
            let inner_addr: *Expr = stmt.var_init.operand
            if inner_addr != null and inner_addr.kind == ExprKind.Index
                let mb: *Expr = inner_addr.left
                if mb != null and mb.kind == ExprKind.Member
                    # Resolve the receiver's struct type.  Two shapes:
                    #   `pool.tasks[i]`     — mb.left = ExprKind.Ident (pool)
                    #   `srv.pool.tasks[i]` — mb.left = ExprKind.Member
                    var rcv_tn_a: *u8 = null
                    var rcv_tn_a_len: i32 = 0
                    if mb.left != null and mb.left.kind == ExprKind.Ident
                        let rloc: *LocalVar = find_local_struct_name(s, StrView { ptr: (mb.left.ident_ptr), len: (mb.left.ident_len) as i64 })
                        if rloc != null and lv_type_name_len(rloc) > 0
                            rcv_tn_a = lv_type_name(rloc)
                            rcv_tn_a_len = lv_type_name_len(rloc)
                    else if mb.left != null and mb.left.kind == ExprKind.Member
                        # Walk one extra level: outer.middle.field[i]
                        let mb_outer: *Expr = mb.left  # outer.middle
                        if mb_outer.left != null and mb_outer.left.kind == ExprKind.Ident
                            let rloc2: *LocalVar = find_local_struct_name(s, StrView { ptr: (mb_outer.left.ident_ptr), len: (mb_outer.left.ident_len) as i64 })
                            if rloc2 != null and lv_type_name_len(rloc2) > 0
                                # Resolve the inner field (`outer.middle`) to its struct
                                let outer_st: *StructDef = find_struct(s, StrView { ptr: (lv_type_name(rloc2)), len: (lv_type_name_len(rloc2)) as i64 })
                                if outer_st != null
                                    let mid_idx: i32 = find_field_index(outer_st, StrView { ptr: (mb_outer.ident_ptr), len: (mb_outer.ident_len) as i64 })
                                    if mid_idx >= 0
                                        let mid_field: *StructField = get_field_type(outer_st, mid_idx)
                                        if mid_field.field_type == TypeKind.Struct and mid_field.field_type_name_len > 0
                                            rcv_tn_a = mid_field.field_type_name
                                            rcv_tn_a_len = mid_field.field_type_name_len
                    if rcv_tn_a != null
                        let rst_a: *StructDef = find_struct(s, StrView { ptr: (rcv_tn_a), len: (rcv_tn_a_len) as i64 })
                        if rst_a != null
                            let fid_a: i32 = find_field_index(rst_a, StrView { ptr: (mb.ident_ptr), len: (mb.ident_len) as i64 })
                            if fid_a >= 0
                                let fa: *StructField = get_field_type(rst_a, fid_a)
                                if fa.field_type == TypeKind.Array and fa.array_elem_type == TypeKind.Struct and fa.array_elem_type_name_len > 0
                                    var_type = TypeKind.Ptr
                                    dt.var_type = TypeKind.Ptr
                                    dt.var_type_name = fa.array_elem_type_name
                                    dt.var_type_name_len = fa.array_elem_type_name_len

    if type_ref_view_let(@dt, view) == 1   # AGAST #3079
        var_type = dt.var_type

    # AGAST #2047: a float-valued initializer no arm above typed -- a binary
    # (`x + 0.5`, binop_float_width #1965), a cast `n as f32`, a float field
    # `p.a`, a negation `-x`, `x.floor() + 0.5` -- is a float / double slot,
    # as ritz0 infers.  The slot stayed i64 and clang rejected
    # `store i64 <float>`.  A pre-emitted match / if already published its
    # phi type above, so it is not re-typed here.
    if var_type == TypeKind.I64 and dt.var_type_name_len == 0 and stmt.var_init != null and pre_emitted == 0
        let init_fty: TypeKind = expr_slot_ty(stmt.var_init)
        if init_fty == TypeKind.F32 or init_fty == TypeKind.F64
            var_type = init_fty
            dt.var_type = init_fty
        # AGAST #2527: an i8 .. u32 initialiser no arm above typed is a slot of
        # that type, as if annotated.  (A u64 keeps the i64 slot; see below.)
        else if init_int != TypeKind.Void and init_int != TypeKind.U64
            var_type = init_int
            dt.var_type = init_int

    let alloca_reg: i32 = next_reg(s)
    entry_alloca_reg_begin(s, alloca_reg)
    if var_type == TypeKind.Array and dt.var_array_shape != null
        # AGAST #1509: `var g: [N][M]T` -> `alloca [N x [M x T]]` (it was
        # `[N x i64]`: the inner array lost, every access miscompiled).
        emit_array_shape_llvm(s, dt.var_array_shape, 0)
    else if var_type == TypeKind.Array
        # Emit array type: [N x elem_type]
        emit_str(s, c"[")
        emit_int(s, dt.var_array_size as i64)
        emit_str(s, IR_X)
        if dt.var_array_elem_type == TypeKind.Struct and dt.var_type_name_len > 0
            emit_str(s, IR_PCT)
            emit_name(s, StrView { ptr: (dt.var_type_name), len: (dt.var_type_name_len) as i64 })
        else
            # The spelling every access over the local uses (#1564, #1966).
            emit_str(s, elem_mem_llvm(dt.var_array_elem_type))
        emit_str(s, c"]")
    else
        emit_llvm_type_struct(s, var_type, StrView { ptr: (dt.var_type_name), len: (dt.var_type_name_len) as i64 })
    emit_str(s, IR_NL)
    entry_alloca_reg_end(s)

    # AGAST #2330: `p#`, the `*T` view of a `*[N]T` local, before `p` itself.
    var view_name_len: i32 = 0
    let view_name: *u8 = inferred_array_elem_name(s, stmt, @dt, @view_name_len)
    add_array_view(s, StrView { ptr: (stmt.var_name), len: (stmt.var_name_len) as i64 }, alloca_reg, var_type, dt.var_pointee_type, dt.var_pointee_array_size, dt.var_pointee_array_elem_type, StrView { ptr: (view_name), len: (view_name_len) as i64 })
    # Track local variable type info for member access
    # For pointer-to-struct (*StructName), use add_local_struct to track struct name
    # References are treated as pointers at the LLVM level
    if var_type == TypeKind.Ptr and dt.var_type_name_len > 0 and dt.var_pointee_type != TypeKind.Array
        # Pointer to struct - track with struct name for ptr.field access.
        # AGAST #1451: record pointee_type = TypeKind.Struct as well, exactly as
        # parameters of the same type are registered (emitter.ritz,
        # param_pointee_type).  This used add_local_struct, which hard-codes
        # pointee TypeKind.I64, so `let base: *LB = ...; base + k` was scaled by
        # 8 instead of sizeof(LB) — a silent wrong address — while the same
        # arithmetic on a `base: *LB` parameter was correct.  Every path that
        # reaches here with a type name (annotated `*Struct`, or one of the
        # narrowings above) names the pointee struct.
        # AGAST #3986: not a `*[N]S`, whose S names the element: a generic's
        # `let p: *T` at T = `[N]S` (monomorph, #2832) bound as a `*S`, so
        # `*p = value` in ritzlib's `__heap_new<[2]P>` refused the array.  It
        # binds as a `*[N]T` does, and name_array_ptr_local records S.
        add_local_full(s, StrView { ptr: (stmt.var_name), len: (stmt.var_name_len) as i64 }, alloca_reg, var_type, StrView { ptr: (dt.var_type_name), len: (dt.var_type_name_len) as i64 }, TypeKind.Struct, 0, TypeKind.Void)
    else if (var_type == TypeKind.Ref or var_type == TypeKind.MutRef) and dt.var_type_name_len > 0 and dt.var_pointee_type != TypeKind.Array
        # AGAST #1754: `@S` / `@&S` local -- registered like a param of the
        # same type (struct name + pointee) so `q.a` resolves.  #2552: not an
        # `@[N]S` / `@&[N]S`, whose S made `p.b` an `@S` field read of element
        # 0; it binds as a `*[N]S` does, and name_array_ptr_local records S.
        add_local_full(s, StrView { ptr: (stmt.var_name), len: (stmt.var_name_len) as i64 }, alloca_reg, var_type, StrView { ptr: (dt.var_type_name), len: (dt.var_type_name_len) as i64 }, dt.var_pointee_type, 0, TypeKind.Void)
        set_local_inner_pointee(s, StrView { ptr: (stmt.var_name), len: (stmt.var_name_len) as i64 }, dt.var_inner_pointee_type)   # AGAST #2372: `@**S`
    else if var_type == TypeKind.PtrPtr and dt.var_type_name_len > 0
        # AGAST #1933: `let pp: **S` -- keep the struct name, as a `**S`
        # param does, so emit_deref_operand_ptr resolves `(**pp).f`.  It
        # went through add_local_ptr, which drops the name, and both the
        # read and the store failed with "unhandled EXPR_MEMBER".
        add_local_full(s, StrView { ptr: (stmt.var_name), len: (stmt.var_name_len) as i64 }, alloca_reg, var_type, StrView { ptr: (dt.var_type_name), len: (dt.var_type_name_len) as i64 }, dt.var_pointee_type, 0, TypeKind.Void)
        set_local_inner_pointee(s, StrView { ptr: (stmt.var_name), len: (stmt.var_name_len) as i64 }, dt.var_inner_pointee_type)
    else
        match var_type
            TypeKind.Ptr | TypeKind.PtrPtr | TypeKind.Ref | TypeKind.MutRef =>
                add_local_ptr(s, StrView { ptr: (stmt.var_name), len: (stmt.var_name_len) as i64 }, alloca_reg, var_type, dt.var_pointee_type)
                set_local_inner_pointee(s, StrView { ptr: (stmt.var_name), len: (stmt.var_name_len) as i64 }, dt.var_inner_pointee_type)
            TypeKind.Struct =>
                add_local_struct(s, StrView { ptr: (stmt.var_name), len: (stmt.var_name_len) as i64 }, alloca_reg, var_type, StrView { ptr: (dt.var_type_name), len: (dt.var_type_name_len) as i64 })
            TypeKind.Array =>
                # For arrays of structs, also stash the element struct name in
                # type_name so emit_member_ptr can resolve `arr[i].field`.
                # AGAST #184: also stash the inner-pointee struct name for
                # `[N]*Foo` / `[N]**Foo` arrays — emit_member_ptr's PTR-element
                # branch loads the slot's *Foo and GEPs into Foo for the field.
                if dt.var_array_elem_type == TypeKind.Struct and dt.var_type_name_len > 0
                    add_local_full(s, StrView { ptr: (stmt.var_name), len: (stmt.var_name_len) as i64 }, alloca_reg, TypeKind.Array, StrView { ptr: (dt.var_type_name), len: (dt.var_type_name_len) as i64 }, TypeKind.I64, dt.var_array_size, dt.var_array_elem_type)
                # AGAST #2369: and `[N]@Foo` / `[N]@&Foo`, for array_elem_referent.
                else if (dt.var_array_elem_type == TypeKind.Ptr or dt.var_array_elem_type == TypeKind.PtrPtr or dt.var_array_elem_type == TypeKind.Ref or dt.var_array_elem_type == TypeKind.MutRef) and dt.var_type_name_len > 0
                    add_local_full(s, StrView { ptr: (stmt.var_name), len: (stmt.var_name_len) as i64 }, alloca_reg, TypeKind.Array, StrView { ptr: (dt.var_type_name), len: (dt.var_type_name_len) as i64 }, TypeKind.I64, dt.var_array_size, dt.var_array_elem_type)
                else
                    add_local_array(s, StrView { ptr: (stmt.var_name), len: (stmt.var_name_len) as i64 }, alloca_reg, dt.var_array_size, dt.var_array_elem_type)
                let arr_loc: *LocalVar = local_at(s, s.local_count - 1)
                lv_set_array_elem_pointee(arr_loc, dt.var_array_elem_pointee)   # AGAST #2341
                lv_set_array_rec(arr_loc, dt.var_array)   # AGAST #2995
                if dt.var_array_shape != null and s.local_count > 0
                    let nd_loc: *LocalVar = local_at(s, s.local_count - 1)
                    lv_set_array_shape(nd_loc, dt.var_array_shape)   # AGAST #1509
            _ =>
                add_local(s, StrView { ptr: (stmt.var_name), len: (stmt.var_name_len) as i64 }, alloca_reg, var_type)
    set_local_fn_sig(s, StrView { ptr: (stmt.var_name), len: (stmt.var_name_len) as i64 }, fn_sig)  # AGAST #1671, #2417
    let declared: *LocalVar = find_local_struct_name(s, StrView { ptr: (stmt.var_name), len: (stmt.var_name_len) as i64 })
    if var_type == TypeKind.Ptr or var_type == TypeKind.PtrPtr or var_type == TypeKind.Ref or var_type == TypeKind.MutRef
        lv_set_inner_ref(declared, dt.var_inner_ref)   # AGAST #2399
        set_local_pointee_array(s, StrView { ptr: (stmt.var_name), len: (stmt.var_name_len) as i64 }, dt.var_pointee_array_size, dt.var_pointee_array_elem_type)  # AGAST #1953, #2308, #2539 (`**[N]T`)
        set_local_pointee_elem(s, StrView { ptr: (stmt.var_name), len: (stmt.var_name_len) as i64 }, dt.var_pointee_array_elem_pointee)
        if lv_pointee_type(declared) == TypeKind.Array
            lv_set_pointee_array_shape(declared, dt.var_pointee_array_shape)   # AGAST #2570
        else if var_type == TypeKind.PtrPtr and lv_pointee_type(declared) == TypeKind.Ptr
            lv_set_pointee_array_shape(declared, dt.var_pointee_array_shape)   # AGAST #3635: `**[N][M]T`
        else if (var_type == TypeKind.Ref or var_type == TypeKind.MutRef) and lv_pointee_type(declared) == TypeKind.Ptr
            lv_set_pointee_array_shape(declared, dt.var_pointee_array_shape)   # AGAST #4122: `@*[N][M]T`
        decl_name_array_ptr_local(declared, @dt, StrView { ptr: (view_name), len: (view_name_len) as i64 })   # AGAST #2543
    # An unannotated local takes its initialiser's kind; var_type can't say.
    var inferred_bool: i32 = 0
    var inferred_unsure: i32 = 0
    if stmt.var_declared_type == TypeKind.Void and stmt.var_init != null
        inferred_bool = (init_kind == BK_BOOL) as i32
        inferred_unsure = (init_kind == BK_UNSURE) as i32
    if (declared_bool == 1 or inferred_bool == 1) and s.local_count > 0
        let bool_loc: *LocalVar = local_at(s, s.local_count - 1)
        bool_loc.is_bool = 1
    if inferred_unsure == 1 and s.local_count > 0
        let unsure_loc: *LocalVar = local_at(s, s.local_count - 1)
        lv_set_bk_unsure(unsure_loc, 1)
    if init_int == TypeKind.U64 and var_type == TypeKind.I64
        lv_set_var_type(declared, TypeKind.U64)

    if stmt.var_init != null and dt.var_array_shape != null
        # AGAST #3299: a whole N-D place (`h.m`, `p.m`, a local or global
        # `[N][M]T`) is copied into the slot.  #2169's `var b = a` and
        # #3017's `let g = h.m` reach here typed N-D.
        if emit_nd_array_init_copy(s, alloca_reg, dt.var_array_shape, stmt.var_init) == 1
            return
        # AGAST #3377: a nested literal / fill, level by level.
        if stmt.var_init.kind == ExprKind.ArrayLit or stmt.var_init.kind == ExprKind.ArrayFill
            emit_nd_array_init_into(s, dt.var_array_shape, 0, alloca_reg, stmt.var_init)
            return
        # AGAST #1509: no other initializer form of a multi-dimensional array
        # is lowered.  Fail closed: the error count stops the driver writing
        # any output.
        emit_nd_error(s, stmt.span.line, stmt.span.col, c"an initializer on a multi-dimensional array is not supported in ritz1")
        return
    if stmt.var_init != null
        # Check for struct literal initializer
        if stmt.var_init.kind == ExprKind.StructLit
            # Struct literal: emit field-by-field initialization
            # e.ident_ptr/ident_len = the parse's struct type name; a nameless
            # tuple literal's is decided here and returned (#4408).
            # e.args = pointer to FieldInit list (recast)
            let e: *Expr = stmt.var_init
            var lit_name: *u8 = null
            var lit_name_len: i32 = 0
            tuple_lit_name(s, e, StrView { ptr: (null), len: (0) as i64 }, @lit_name, @lit_name_len)
            var st: *StructDef = null
            if lit_name != null
                st = find_struct(s, StrView { ptr: (lit_name), len: (lit_name_len) as i64 })
            if st != null
                # Iterate through field initializers
                var fi: *FieldInit = e.args as *FieldInit
                while fi != null
                    # Find field index in struct
                    var field_idx: i32 = find_field_index(st, StrView { ptr: (fi.name), len: (fi.name_len) as i64 })
                    # `a: [v; N]` for an array field is written in place.
                    if field_idx >= 0
                        if emit_struct_lit_array_fill_field(s, st, field_idx, fi.value, alloca_reg) == 1
                            field_idx = -1  # done (AGAST #1605)
                    if field_idx >= 0
                        emit_struct_lit_field_store(s, st, field_idx, fi.value, alloca_reg)
                    fi = fi.next
                emit_struct_lit_zero_omitted(s, st, e, alloca_reg)   # AGAST #1749
            return  # Done with struct literal init

        # Array-fill init for typed [N]T slots: `let buf: [N]T = [v; N]`.
        # squeeze/cryptosec/valet rely on this for inflate/sbox tables.
        # Lowering strategy lives in emit_array_fill_into (emitter_expr).
        if var_type == TypeKind.Array and stmt.var_init.kind == ExprKind.ArrayFill
            emit_array_fill_into(s, alloca_reg, dt.var_array_size, dt.var_array_elem_type, StrView { ptr: (dt.var_type_name), len: (dt.var_type_name_len) as i64 }, stmt.var_init.left)
            return

        # Array-literal init for typed [N]T slots (ritz0 parity —
        # test_issue_span_slice_range and friends).  The generic fallthrough
        # below emits the literal into a shadow `[N x i64]` alloca and then
        # stores a single `i64 %ptrtoint` into the declared array slot,
        # which is wrong when the slot's element type isn't i64 (most cases).
        # Instead, iterate the literal's elements, evaluate each, and store
        # it into slot[i] at the declared element type — mirrors ritz0's
        # direct-element-store behaviour.
        if var_type == TypeKind.Array and stmt.var_init.kind == ExprKind.ArrayLit
            # `dt.var_type_name` names the element struct of `[N]T`.
            emit_array_lit_into(s, alloca_reg, dt.var_array_size, dt.var_array_elem_type, StrView { ptr: (dt.var_type_name), len: (dt.var_type_name_len) as i64 }, stmt.var_init)
            return

        # AGAST #2035 / #2169: `let a: [N]T = x.f` / `= c` / `= *p` copy
        # the whole array.
        if var_type == TypeKind.Array
            emit_array_local_whole_assign(s, alloca_reg, dt.var_array_size, dt.var_array_elem_type, StrView { ptr: (dt.var_type_name), len: (dt.var_type_name_len) as i64 }, stmt.var_init)
            return

        # ritz-task-133: thread enum ctx so `let r: Result<_,_> = Ok(x)` in
        # a non-Result-returning fn still builds the right struct.  Save /
        # restore around the init expression so nested decls don't leak.
        let _saved_ctx: *u8 = s.ctx_enum_name
        let _saved_ctx_len: i32 = s.ctx_enum_name_len
        # AGAST #167: same shape, different ctx — when the binding's
        # declared type is a SIMD vector (`v4i32`, ...) the inline SIMD
        # intrinsic dispatch in emit_expr_call uses this to size the
        # `<N x iM>` load result.
        let _saved_simd: *u8 = s.ctx_simd_name
        let _saved_simd_len: i32 = s.ctx_simd_name_len
        if var_type == TypeKind.Struct
            if dt.var_type_name_len > 0
                if is_ctor_slot_enum(s.mono.pctx, StrView { ptr: (dt.var_type_name), len: (dt.var_type_name_len) as i64 }) == 1
                    s.ctx_enum_name = dt.var_type_name
                    s.ctx_enum_name_len = dt.var_type_name_len
                if is_simd_vector_type_name(StrView { ptr: (dt.var_type_name), len: (dt.var_type_name_len) as i64 }) == 1
                    s.ctx_simd_name = dt.var_type_name
                    s.ctx_simd_name_len = dt.var_type_name_len
        var init_reg: i32 = pre_init_reg
        if pre_emitted == 0
            # AGAST #2296: the annotation, if any, is the slot `Span.empty()`
            # takes its T from; an untyped let is a slot with no type.
            var saved_slot: SlotCtx
            if dt.var_type_name_len > 0 and dt.var_type_name != null
                enter_slot_ctx(s, @saved_slot, var_type, StrView { ptr: (dt.var_type_name), len: (dt.var_type_name_len) as i64 })
            else
                enter_slot_ctx(s, @saved_slot, TypeKind.Void, StrView { ptr: (null), len: (0) as i64 })
            set_match_float_hint(s, stmt.var_init, var_type, StrView { ptr: (dt.var_type_name), len: (dt.var_type_name_len) as i64 })
            init_reg = emit_expr_by_value(s, stmt.var_init, var_type, StrView { ptr: (dt.var_type_name), len: (dt.var_type_name_len) as i64 })
            if var_type == TypeKind.Struct
                init_reg = coerce_array_to_span(s, stmt.var_init, init_reg, StrView { ptr: (dt.var_type_name), len: (dt.var_type_name_len) as i64 })   # AGAST #2502
            leave_slot_ctx(s, @saved_slot)
        s.ctx_enum_name = _saved_ctx
        s.ctx_enum_name_len = _saved_ctx_len
        s.ctx_simd_name = _saved_simd
        s.ctx_simd_name_len = _saved_simd_len
        if ty_int_bits(var_type) == 32
            let trunc: i32 = ir_trunc_i64_i32(s.out, @s.reg_counter, init_reg)
            emit_store_typed(s, IR_TY_I32, trunc, alloca_reg)
        else if ty_int_bits(var_type) == 16
            # Truncate i64 (unified value model) to i16 for the slot.
            let trunc: i32 = ir_trunc_i64_i16(s.out, @s.reg_counter, init_reg)
            emit_store_typed(s, IR_TY_I16, trunc, alloca_reg)
        else if ty_int_bits(var_type) == 8
            # Truncate i64 to i8 for byte types
            let trunc: i32 = ir_trunc_i64_i8(s.out, @s.reg_counter, init_reg)
            emit_store_typed(s, IR_TY_I8, trunc, alloca_reg)
        else
            match var_type
                TypeKind.MutRef =>
                    # AGAST #1754: an `@&T` slot holds the `ptr` it loads as (like an
                    # `@&T` param); an i64 init (a `*T` value, a `-> @&T`
                    # call result) gets an inttoptr.
                    let init_pval: i32 = i64_value_to_ptr(s, stmt.var_init, init_reg)
                    emit_store_typed(s, IR_TY_PTR, init_pval, alloca_reg)
                TypeKind.Ptr | TypeKind.PtrPtr | TypeKind.Ref =>
                    # Store i64 directly (pointers are stored as i64).  AGAST #1652:
                    # an `@&T` init (`let p: *S = s`) is a `ptr`; ptrtoint it first.
                    let init_ival: i32 = ptr_slot_value(s, var_type, stmt.var_init, init_reg)
                    emit_store_typed(s, IR_TY_I64, init_ival, alloca_reg)
                TypeKind.Struct =>
                    # Store struct directly. emit_llvm_type_struct routes tagged-enum
                    # Result$/Option$ to i64 so the store type matches the i64 value
                    # produced by variant constructors (task-99 cluster #3).
                    #
                    # AGAST #168: Span$u8 ↔ StrView layout-equivalence coercion.
                    # When the init expression's nominal struct type differs from the
                    # slot's declared type but they share `{ ptr, i64 }` layout (e.g.
                    # `let x: StrView = "..."` where bare strings lower to %Span$u8),
                    # decompose-rebuild the aggregate so the store types agree.
                    var stored_reg: i32 = init_reg
                    var src_name: *u8 = null
                    var src_len: i32 = 0
                    resolve_expr_struct_name(s, stmt.var_init, @src_name, @src_len)
                    if is_layout_equiv_pair(StrView { ptr: (src_name), len: (src_len) as i64 }, StrView { ptr: (dt.var_type_name), len: (dt.var_type_name_len) as i64 }) == 1
                        stored_reg = rebuild_layout_equiv(s, init_reg, StrView { ptr: (src_name), len: (src_len) as i64 }, StrView { ptr: (dt.var_type_name), len: (dt.var_type_name_len) as i64 })
                    emit_struct_store_or_copy(s, TypeKind.Struct, StrView { ptr: (dt.var_type_name), len: (dt.var_type_name_len) as i64 }, stored_reg, alloca_reg)
                TypeKind.F32 =>
                    # Float literal lowers as `fadd double 0.0, <lit>` (i.e. f64);
                    # narrow to f32 via fptrunc when the binding is f32-typed.
                    # The init reg is `double` — same alloca slot is `float`.
                    var stored_reg: i32 = int_to_float_slot(s, init_reg, TypeKind.F32, stmt.var_init)
                    let init_ty: TypeKind = expr_slot_ty(stmt.var_init)
                    if init_ty == TypeKind.F64
                        stored_reg = next_reg(s)
                        emit_str(s, IR_INDENT)
                        emit_reg(s, stored_reg)
                        emit_str(s, c" = fptrunc double ")
                        emit_reg(s, init_reg)
                        emit_str(s, c" to float\n")
                    emit_str(s, c"  store float ")
                    emit_reg(s, stored_reg)
                    emit_str(s, IR_PTR_SEP)
                    emit_reg(s, alloca_reg)
                    emit_str(s, IR_NL)
                TypeKind.F64 =>
                    # f64 binding — float lit already at double; an integer init
                    # is sitofp'd (#2062), an f32 one fpext'd (#4028).
                    let dval: i32 = emit_field_elem_narrow(s, init_reg, TypeKind.F64, stmt.var_init)
                    emit_str(s, c"  store double ")
                    emit_reg(s, dval)
                    emit_str(s, IR_PTR_SEP)
                    emit_reg(s, alloca_reg)
                    emit_str(s, IR_NL)
                _ =>
                    emit_str(s, IR_STORE_IND)
                    emit_str(s, ty_value_llvm(var_type))
                    emit_str(s, IR_SP)
                    emit_reg(s, init_reg)
                    emit_str(s, IR_PTR_SEP)
                    emit_reg(s, alloca_reg)
                    emit_str(s, IR_NL)

# AGAST #4666: `m[i] = r`, a whole row (or plane) of an N-D array: `dst` is
# the sub-array the index chain stopped at, `dst.depth` short of the leaf.
# The value is copied over it as a whole-array store into a local of the
# sub-array's type would be: a row `[M]T` by emit_array_local_whole_assign
# (a `[M]T` local, global, field, `*p`, literal or fill) or as a row of
# another N-D array (`m[1] = n[0]`); a plane by emit_nd_plane_store.  A
# move-only leaf stays refused, as for a whole N-D array (#3634): the old
# elements would never drop and the source's would drop twice.
fn emit_nd_sub_store(s: *EmitterState, stmt: *Stmt, dst: *NdIndexPtr)
    let sh: *ArrayShape = dst.shape
    let v: *Expr = stmt.assign_value
    if sh.leaf_type == TypeKind.Struct and sh.leaf_name_len > 0 and own_type_is_move_only(s, StrView { ptr: (sh.leaf_name), len: (sh.leaf_name_len) as i64 }) == 1
        emit_nd_error_sv(s, stmt.span.line, stmt.span.col, "assigning a row of a multi-dimensional array of a move-only type is not supported in ritz1 (assign each element)")
        return
    if sh.rank - dst.depth >= 2
        emit_nd_plane_store(s, dst.reg, nd_shape_from(sh, dst.depth), v)
        return
    let m: i32 = sh.dims[sh.rank - 1]
    let leaf_sv: StrView = StrView { ptr: (sh.leaf_name), len: (sh.leaf_name_len) as i64 }
    # A row of another N-D array, `n[0]`: copied from the address its GEP gives.
    var vd: i32 = 0
    let vsh: *ArrayShape = nd_index_shape(s, v, @vd)
    if vsh != null and vd == vsh.rank - 1
        if vsh.dims[vsh.rank - 1] != m or vsh.leaf_pointee != sh.leaf_pointee or array_elem_types_match(vsh.leaf_type, StrView { ptr: (vsh.leaf_name), len: (vsh.leaf_name_len) as i64 }, sh.leaf_type, leaf_sv) == 0
            emit_ir_error_sv(s, v.span, "this row's type is not the multi-dimensional array's row type")
            return
        var src: NdIndexPtr
        emit_nd_index_ptr(s, v, @src)
        emit_local_array_copy(s, m, sh.leaf_type, leaf_sv, src.reg, dst.reg)
        return
    emit_array_local_whole_assign(s, dst.reg, m, sh.leaf_type, leaf_sv, v)

# AGAST #4666: `g[i] = v` / `h.m[i] = v` statements over an N-D array, as the
# index chain `place` (built by the caller) names: one index short of a 2-D
# array's leaf, so a row store.
fn emit_nd_stmt_row_store(s: *EmitterState, stmt: *Stmt, place: *Expr)
    var dst: NdIndexPtr
    if emit_nd_index_ptr(s, place, @dst) == 0
        emit_nd_error_sv(s, stmt.span.line, stmt.span.col, "assigning a row or a whole struct element of a multi-dimensional array is not supported in ritz1 (assign each element or field)")
        return
    emit_nd_elem_store(s, stmt, @dst)

# AGAST #1509: store stmt.assign_value into the N-D element `dst` points
# at, at the leaf's width (as a 1-D local array element store does).  A row
# or plane is copied over by emit_nd_sub_store (AGAST #4666).
#
# AGAST #2099: a whole struct element `g[i][j] = q` stores the `%P` at the
# element's address, as the 1-D `[N]P` element store does (#190), dropping
# the old element first (#3377).  A leaf naming no struct (a
# generic clone that kept `T`, #3141) stays the located error: `store %T`
# would be invalid IR.
fn emit_nd_elem_store(s: *EmitterState, stmt: *Stmt, dst: *NdIndexPtr)
    let sh: *ArrayShape = dst.shape
    var leaf_st: *StructDef = null
    if sh.leaf_type == TypeKind.Struct and sh.leaf_name_len > 0
        leaf_st = find_struct(s, StrView { ptr: (sh.leaf_name), len: (sh.leaf_name_len) as i64 })
    if dst.depth < sh.rank and (sh.leaf_type != TypeKind.Struct or leaf_st != null)
        emit_nd_sub_store(s, stmt, dst)   # AGAST #4666
        return
    if dst.depth < sh.rank or (sh.leaf_type == TypeKind.Struct and leaf_st == null)
        emit_nd_error(s, stmt.span.line, stmt.span.col, c"assigning a row or a whole struct element of a multi-dimensional array is not supported in ritz1 (assign each element or field)")
        return
    if sh.leaf_type == TypeKind.Struct
        let sval: i32 = emit_store_into_slot(s, stmt.assign_value, TypeKind.Struct, StrView { ptr: (sh.leaf_name), len: (sh.leaf_name_len) as i64 })   # AGAST #2454, #2390
        # AGAST #3377 (LARB R39): the old element drops after v, before the
        # store, when a binding owns the array (`g`, `h.m`).
        var arr: *Expr = stmt.if_cond as *Expr
        while arr != null and arr.kind == ExprKind.Index
            arr = arr.left
        own_drop_old_elem(s, arr, dst.reg, StrView { ptr: (sh.leaf_name), len: (sh.leaf_name_len) as i64 })
        emit_struct_store_or_copy(s, TypeKind.Struct, StrView { ptr: (sh.leaf_name), len: (sh.leaf_name_len) as i64 }, sval, dst.reg)
        return
    let ty: *u8 = elem_mem_llvm(sh.leaf_type)
    set_match_float_hint(s, stmt.assign_value, sh.leaf_type, StrView { ptr: (null), len: (0) as i64 })   # AGAST #4028
    let val: i32 = emit_expr(s, stmt.assign_value)
    var store_val: i32 = val
    if array_elem_typed_scalar(sh.leaf_type) == 1
        store_val = emit_field_elem_narrow(s, val, sh.leaf_type, stmt.assign_value)
    else
        store_val = emit_array_elem_narrow(s, val, sh.leaf_type, ty)
    emit_str(s, IR_STORE_IND)
    emit_str(s, ty)
    emit_str(s, IR_SP)
    emit_reg(s, store_val)
    emit_str(s, IR_PTR_SEP)
    emit_reg(s, dst.reg)
    emit_str(s, IR_NL)

# AGAST #2097: the ArrayShape of `var.field` for a StmtKind.LocalFieldIndexAssign
# `var.field[i] = v`, null when the field is not multi-dimensional.
fn local_field_nd_shape(s: *EmitterState, stmt: *Stmt) -> *ArrayShape
    var base: Expr
    base.kind = ExprKind.Ident
    base.ident_ptr = stmt.var_name
    base.ident_len = stmt.var_name_len
    var mem: Expr
    mem.kind = ExprKind.Member
    mem.left = @base
    mem.ident_ptr = stmt.assign_target
    mem.ident_len = stmt.assign_target_len
    return nd_array_member_shape(s, @mem)

# AGAST #2440: `p[i] = v` with `p` a local.  Returns 1 when it took `stmt`: it's
# `*(p.data + i) = v`, or refused.
fn emit_through_index_assign(s: *EmitterState, stmt: *Stmt) -> i32
    var root: Expr
    var target: Expr
    memset(@root as *u8, 0, sizeof(Expr))
    memset(@target as *u8, 0, sizeof(Expr))
    root.kind = ExprKind.Ident
    root.span = stmt.span
    root.ident_ptr = stmt.assign_target
    root.ident_len = stmt.assign_target_len
    target.kind = ExprKind.Index
    target.span = stmt.span
    target.bracket = stmt.bracket   # AGAST #2886
    target.left = @root
    target.right = stmt.while_cond
    if through_slice_refused(s, @target) == 1
        return 1
    let through: *LocalVar = index_through(s, @target)
    if through == null
        return 0
    var th: ThroughIndex
    index_through_fill(s, @target, through_spill(s, through), @th)
    var store: Stmt
    memset(@store as *u8, 0, sizeof(Stmt))
    store.kind = StmtKind.Assign
    store.span = stmt.span
    store.if_cond = @th.deref
    store.assign_value = stmt.assign_value
    emit_assign(s, @store)
    1

# AGAST #2346: `r = v` where `r` is a `r:& T` param and T is a struct, an enum
# (tagged or not), StrView, f32 or f64.  ritz0 auto-dereferences the borrow, so
# the whole referent is overwritten.  These params stay TypeKind.MutRef locals
# whose slot holds the caller's pointer (bind_scalar_borrow_param binds only
# integer and array pointees as the referent itself).  The generic arm stored
# the value as an i64 into that slot: a clang error for an aggregate or a
# float, and for `r = v` with `v:& C` too, a silent reseat of `r` onto `v`.
# Load the pointer and store the value at T.  `slot` is `r`'s slot register.
# Returns 1 when it emitted the store.
fn emit_lent_whole_store(s: *EmitterState, stmt: *Stmt, slot: i32) -> i32
    let loc: *LocalVar = find_local_struct_name(s, StrView { ptr: (stmt.assign_target), len: (stmt.assign_target_len) as i64 })
    if loc == null or lv_var_type(loc) != TypeKind.MutRef or lv_holds_lent_ptr(loc) == 0
        return 0
    let pt: TypeKind = lv_pointee_type(loc)
    if pt == TypeKind.Struct and lv_type_name_len(loc) > 0
        # Evaluated before the pointer is loaded: the value may read `r`.
        let raw: i32 = emit_expr_into_slot(s, stmt.assign_value, TypeKind.Struct, StrView { ptr: (lv_type_name(loc)), len: (lv_type_name_len(loc)) as i64 })
        # A bare "..." is a %Span$u8; `r:& StrView` wants it as a %StrView.
        let val: i32 = coerce_struct_ret_value(s, stmt.assign_value, raw, StrView { ptr: (lv_type_name(loc)), len: (lv_type_name_len(loc)) as i64 })
        let dst: i32 = emit_load_ptr(s, slot)
        # LARB R58 (§13.6): `h = v` on a `h:& T` borrow stores the caller's
        # T, so the old value drops after v, before the store.
        own_drop_old_ref_value(s, dst, StrView { ptr: (lv_type_name(loc)), len: (lv_type_name_len(loc)) as i64 })
        emit_struct_store_or_copy(s, TypeKind.Struct, StrView { ptr: (lv_type_name(loc)), len: (lv_type_name_len(loc)) as i64 }, val, dst)
        return 1
    if pt == TypeKind.F32 or pt == TypeKind.F64
        let fval: i32 = emit_expr(s, stmt.assign_value)
        return emit_float_field_store(s, emit_load_ptr(s, slot), pt, fval, stmt.assign_value)
    0

# AGAST #3097: 1 when `*ptr = v` stores through a pointer declared `*i64`: a
# local, global or struct field (as `p` or as the base of `*(p + i)`), or an
# inline `q as *i64`.  get_deref_store_type can't say so -- TypeKind.I64 doubles
# as "unknown" in the pointee tables -- and emit_assign then fell back to the
# RHS's own width: an i8 `x` in `*p = x` was `trunc ... to i8; store i8`,
# writing the low byte of the i64 only.  Each arm checks the declaration, so
# TypeKind.I64 here means `*i64`, never "unknown".
fn deref_store_into_declared_i64(s: *EmitterState, ptr_expr: *Expr) -> i32
    if inline_deref_scalar_pointee(s, ptr_expr) == TypeKind.I64
        return 1
    var base: *Expr = ptr_expr
    if base.kind == ExprKind.Binary
        base = find_base_expr(base)
    if base.kind == ExprKind.Member
        let fld: *StructField = member_field_def(s, base)
        if fld != null and fld.field_type == TypeKind.Ptr and fld.array_elem_type == TypeKind.I64
            return 1
        return 0
    if base.kind != ExprKind.Ident
        return 0
    let loc: *LocalVar = find_local_struct_name(s, StrView { ptr: (base.ident_ptr), len: (base.ident_len) as i64 })
    if loc != null
        if lv_var_type(loc) == TypeKind.Ptr and lv_pointee_type(loc) == TypeKind.I64
            return 1
        return 0
    let glob: *GlobalVarDef = find_global(s, StrView { ptr: (base.ident_ptr), len: (base.ident_len) as i64 })
    if glob != null and glob.var_type == TypeKind.Ptr and glob.pointee_type == TypeKind.I64
        return 1
    0

fn emit_assign(s: *EmitterState, stmt: *Stmt)
    # Check for expression assignment: expr = value
    # When assign_target_len == 0, the target is in if_cond as an expression
    if stmt.assign_target_len == 0
        var target_expr: *Expr = stmt.if_cond as *Expr
        # LARB R58 (§13.6): a store through an `@&T` / `:&` reference, or a
        # place reached through one, drops the old value.  `orig_target` is
        # the place as written; the rewrites below may restate it (e.g. an
        # index as a deref), and the reach must be read from the original.
        let orig_target: *Expr = target_expr
        let orig_reach: i32 = own_store_reach(s, orig_target)

        # AGAST #2332: `a[i][j] = v` with `a: [N]*T` is `*(a[i] + j) = v`.  The
        # generic path below stored through the VALUE of `a[i][j]`.
        var ei_sum: Expr
        var ei_deref: Expr
        # AGAST #3058: so is `b[i][j] = v` with `b: [N]**T`, a store to a `*T`.
        if is_array_elem_index(s, target_expr) == 1 or is_ptr_ptr_elem_index(s, target_expr) == 1
            elem_index_as_deref(s, target_expr, @ei_sum, @ei_deref)
            target_expr = @ei_deref

        # AGAST #2440: `(*p)[i] = v`, as `p[i] = v`.
        var th: ThroughIndex
        let through: *LocalVar = index_through(s, target_expr)
        if through != null
            index_through_fill(s, target_expr, through_spill(s, through), @th)
            target_expr = @th.deref

        # AGAST #2545: `(*r)[i] = v` with `r: **T` GEPs and stores T, as
        # `(*r)[i]` loads it (#2537's deref_index_elem).  It fell to the
        # generic path below, which stored through the VALUE `(*r)[i]` read,
        # as an i64: a segfault on i16, invalid IR on f64.
        #
        # AGAST #3122: with `r: **C` it stores a whole `C`, as `p[i] = v`
        # does through a `*C` (#2277's emit_ptr_struct_elem_store).
        let dix: TypeKind = deref_index_elem(s, target_expr)
        var dst_name: *u8 = null
        var dst_len: i32 = 0
        if dix == TypeKind.Void and target_expr.kind == ExprKind.Index
            deref_ptr_ptr_struct_name(s, target_expr.left, @dst_name, @dst_len)
        if dix != TypeKind.Void or dst_len > 0
            let dbase: i32 = emit_expr(s, target_expr.left)
            let dptr: i32 = ir_inttoptr_ptr(s.out, @s.reg_counter, dbase)
            if dst_len > 0
                emit_ptr_struct_elem_store(s, target_expr.right, stmt.assign_value, dptr, StrView { ptr: (dst_name), len: (dst_len) as i64 })
            else
                emit_ptr_elem_store(s, target_expr.right, stmt.assign_value, dptr, TypeKind.Ptr, dix)
            return

        # AGAST #3442: `f()[i] = v` with `f` returning `*T` stores through the
        # pointer `f()` returns, as `p[i] = v` does.  It fell to the generic
        # path below, which read `f()[i]` as a byte VALUE and stored through
        # it: a SIGSEGV.  Base, index, then value (LARB R61).
        if emit_call_base_index_store(s, target_expr, stmt.assign_value) == 1
            return
        # AGAST #3565: and `(e as *T)[i] = v`, `(q + k)[i] = v`, `(p)[i] = v`.
        if emit_ptr_base_index_store(s, target_expr, stmt.assign_value) == 1
            return

        # AGAST #1509: `g[i][j] = v` over a multi-dimensional array.  It fell
        # to the generic path below, which evaluated `g[i][j]` as a VALUE
        # (over a flattened [N x i64]) and stored through it.
        if target_expr.kind == ExprKind.Index
            var nd_dst: NdIndexPtr
            if emit_nd_index_ptr(s, target_expr, @nd_dst) == 1
                emit_nd_elem_store(s, stmt, @nd_dst)
                return

        # Check if target is a member expression (struct field assignment)
        if target_expr.kind == ExprKind.Member
            var member_result: MemberPtrResult
            emit_member_ptr(s, target_expr, @member_result)
            if member_result.success == 1 and member_result.field.field_type == TypeKind.Array
                # AGAST #1934: whole-array store into an inline array field.
                # Must not reach the generic emit_expr + `store i64` below,
                # which stored the ADDRESS of emit_expr's shadow alloca.
                emit_array_field_whole_assign(s, member_result.reg, member_result.field, stmt.assign_value)
                return
            if member_result.success == 1
                let field: *StructField = member_result.field
                # AGAST #2142: `p.shape = Rect(..)` builds the field's enum.
                let val: i32 = emit_expr_into_field(s, stmt.assign_value, field)
                # LARB R58 (§13.6): through a reference, `p.t = v` drops the
                # field's old value after v, before the store.
                if orig_reach == OWN_REACH_REF and orig_target.kind == ExprKind.Member
                    own_drop_old_ref_field(s, member_result.reg, field)
                # AGAST #2048: f32 / f64 fields store float / double.
                if emit_float_field_store(s, member_result.reg, field.field_type, val, stmt.assign_value) == 1
                    return
                # Store value based on field type
                if ty_int_bits(field.field_type) == 32
                    let trunc: i32 = ir_trunc_i64_i32(s.out, @s.reg_counter, val)
                    emit_store_typed(s, IR_TY_I32, trunc, member_result.reg)
                else if ty_int_bits(field.field_type) == 16
                    # Narrow field — value reg is always i64 (unified value
                    # model in emit_expr); trunc before store.
                    let trunc: i32 = ir_trunc_i64_i16(s.out, @s.reg_counter, val)
                    emit_store_typed(s, IR_TY_I16, trunc, member_result.reg)
                else if ty_int_bits(field.field_type) == 8
                    let trunc: i32 = ir_trunc_i64_i8(s.out, @s.reg_counter, val)
                    emit_store_typed(s, IR_TY_I8, trunc, member_result.reg)
                else
                    match field.field_type
                        TypeKind.Bool =>
                            # AGAST #1439: global-struct field stores now route here
                            # (`flags.on = true`); without this arm a bool fell to
                            # the 8-byte `store i64` default and clobbered the next
                            # 7 bytes.  Mirrors StmtKind.LocalFieldAssign's i1 arm.
                            let trunc1: i32 = ir_trunc_i64_i1(s.out, @s.reg_counter, val)
                            emit_store_typed(s, IR_TY_I1, trunc1, member_result.reg)
                        TypeKind.Ptr | TypeKind.PtrPtr | TypeKind.Ref | TypeKind.MutRef =>
                            # AGAST #1652: `h.p = s` with `s: @&S` is already a `ptr`.
                            # AGAST #2329: so is `h.r = @&a` into an `@&[N]T`, which
                            # lower_ref_fields leaves a reference, and which fell to a
                            # `store i64` of the `ptr`.
                            let ival: i32 = ptr_value_to_i64(s, stmt.assign_value, val)
                            let ptr_val: i32 = ir_inttoptr_ptr(s.out, @s.reg_counter, ival)
                            emit_store_typed(s, IR_TY_PTR, ptr_val, member_result.reg)
                        _ =>
                            if field.field_type == TypeKind.Struct and field.field_type_name_len > 0
                                # AGAST #188: struct-typed field assigned a struct value
                                # (e.g. `slot.value = *src` where `slot.value: Field` and
                                # `*src` is a `load %Field, ...`).  Without this branch the
                                # default fell through to `store i64 %val`, but %val is
                                # a `%FieldType` aggregate, hitting LLVM's
                                # `'%val' defined with type '%T' but expected 'i64'`.
                                # Route through emit_llvm_type_struct so primitive-aliased
                                # struct names (`u16`, etc.) and SIMD vectors lower right.
                                # `o.w.s = "ab"`: a %Span$u8 rebuilt as %StrView (#2412).
                                let agg: i32 = coerce_struct_ret_value(s, stmt.assign_value, val, StrView { ptr: (field.field_type_name), len: (field.field_type_name_len) as i64 })
                                emit_struct_store_or_copy(s, TypeKind.Struct, StrView { ptr: (field.field_type_name), len: (field.field_type_name_len) as i64 }, agg, member_result.reg)
                            else
                                # Default: store i64
                                emit_store_typed(s, IR_TY_I64, val, member_result.reg)
                return
            # Fall through to emit error if member access failed
            if primitive_member_refused(s, target_expr) == 1   # AGAST #4155
                return
            emit_ir_error(s, target_expr.span, c"unhandled EXPR_MEMBER in assignment")
            return

        # Check for array field element assignment: s.field[idx] = value
        if target_expr.kind == ExprKind.Index
            if target_expr.left.kind == ExprKind.Member
                var member_result: MemberPtrResult
                emit_member_ptr(s, target_expr.left, @member_result)
                if member_result.success == 1
                    let field: *StructField = member_result.field
                    if field.field_type == TypeKind.Array
                        # Array field in struct - GEP to element, then store
                        let idx: i32 = emit_expr(s, target_expr.right)
                        let val: i32 = emit_store_into_slot(s, stmt.assign_value, field.array_elem_type, StrView { ptr: (field.array_elem_type_name), len: (field.array_elem_type_name_len) as i64 })   # AGAST #2454, #2390
                        emit_field_array_elem_store(s, member_result.reg, field, idx, val, stmt.assign_value, target_expr.left)
                        return
                    # AGAST #1596: `x.f[i] = v` with `f: *T` / `**T` —
                    # store THROUGH the pointer held in the field.
                    if emit_ptr_field_index_store(s, member_result.reg, field, target_expr.right, stmt.assign_value) == 1
                        return
                # AGAST #1439: `x.f[i] = v` whose member did not resolve, or
                # whose field is neither an inline array nor a pointer with
                # an addressable pointee, must not fall through to the
                # generic deref store below: that path evaluates `x.f[i]`
                # as a VALUE and stores through it as an address (segfault
                # or a wild write).  Refuse rather than miscompile.
                emit_ir_error(s, target_expr.span, c"unhandled indexed EXPR_MEMBER in assignment")
                return

        # Deref assignment: *(expr) = value.  As of AGAST #1304
        # stmt_assign_deref wraps the target in ExprKind.Unary/OpKind.Deref, so
        # `target_expr` is that unary node and its `.operand` is the pointer
        # expression (e.g. `p` for `*p = 0`).  The wrapper matters: without
        # it a `*s.field = v` target arrived here as a bare ExprKind.Member and
        # was swallowed by the struct-field-assignment branch above, storing
        # into the pointer field instead of through it.  The ExprKind.Ident /
        # bare-expression arms below remain for stmt_assign_expr targets.
        # AGAST #2287: `*p = a` for `p: *[N]T` copies the whole array.  #2304:
        # `p` is any pointer array_ptr_shape knows N for (a local or param, a
        # field, a global, `p + k`); any other target fails closed: there is
        # no length to check the value against.
        if target_expr.kind == ExprKind.Unary and target_expr.op == OpKind.Deref
            # AGAST #2972: `*h = v` on an integer or `bool` borrow `h:& T` is
            # `h = v`, as ritz0 stores it: `h` is bound as the caller's T
            # (bind_scalar_borrow_param), so `*h` names it, not an address.
            # This stored through the referent's value as an i64.
            if lent_scalar_ident(s, target_expr.operand) != null
                let saved_name: *u8 = stmt.assign_target
                let saved_len: i32 = stmt.assign_target_len
                stmt.assign_target = target_expr.operand.ident_ptr
                stmt.assign_target_len = target_expr.operand.ident_len
                emit_assign(s, stmt)
                stmt.assign_target = saved_name
                stmt.assign_target_len = saved_len
                return
            # AGAST #2290: ritz0 reads `*a` of `a:& [N]T` but won't store through
            # it.  `a = v` is the spelling for that.
            if lent_array_ident(s, target_expr.operand) != null
                emit_nd_error(s, target_expr.span.line, target_expr.span.col, c"cannot store through `*a` of an `a:& [N]T` param (assign to `a`, it is the array)")
                return
            # AGAST #3642: `*q = v` through a plane pointer `q = @&x[i]` (#2570)
            # stores a whole `[M][N]..T`; array_ptr_shape sees only its flat
            # `[M*N..]T` and held a nested literal to M*N.
            let plane: *ArrayShape = plane_ptr_shape(s, target_expr.operand)
            if plane != null
                emit_nd_plane_store(s, emit_array_ptr_value(s, target_expr.operand), plane, stmt.assign_value)
                return
            var arr_dst: ArraySrc
            if array_ptr_shape(s, target_expr.operand, @arr_dst) == 1
                emit_array_local_whole_assign(s, emit_array_ptr_value(s, target_expr.operand), arr_dst.size, arr_dst.elem, StrView { ptr: (arr_dst.name), len: (arr_dst.name_len) as i64 }, stmt.assign_value)
                return
            if stmt.assign_value.kind == ExprKind.ArrayLit or stmt.assign_value.kind == ExprKind.ArrayFill
                emit_ir_error(s, stmt.span, c"whole-array store through this pointer is not supported by ritz1 (only a `*[N]T` local, param, field or global, or `p + k` over one)")
                return
        # Determine the store type. For `*ptr = value` we want the POINTEE
        # type of `ptr` (the destination slot's type), not the value's type.
        # Otherwise storing an i64 RHS into an i32 slot writes 4 extra bytes.
        var value_type: TypeKind = TypeKind.I64
        var struct_name: *u8 = null
        var struct_name_len: i32 = 0
        var dst_is_i64: i32 = 0   # AGAST #3097

        # Prefer the destination's pointee type when available
        if target_expr.kind == ExprKind.Ident
            let dst_loc: *LocalVar = find_local_struct_name(s, StrView { ptr: (target_expr.ident_ptr), len: (target_expr.ident_len) as i64 })
            if dst_loc != null and lv_pointee_type(dst_loc) != TypeKind.I64
                value_type = lv_pointee_type(dst_loc)
                if lv_pointee_type(dst_loc) == TypeKind.Struct
                    struct_name = lv_type_name(dst_loc)
                    struct_name_len = lv_type_name_len(dst_loc)
        else if target_expr.kind == ExprKind.Unary and target_expr.op == OpKind.Deref
            # AGAST #1304: this is now the ONLY shape stmt_assign_deref
            # produces.  Resolve the destination slot's width so `*p = v`
            # stores exactly as wide as `*p` reads — covering locals,
            # globals, `*(base + i)` and `*s.field` uniformly.  The old code
            # only understood a bare ident operand, so `*ring.sq_tail = ...`
            # (a *i32 field) fell back to `store i64` and scribbled 4 bytes
            # past the slot.  get_deref_store_type reports TypeKind.Void rather
            # than guessing when it cannot tell, so an unresolved pointee
            # still defers to the RHS's own type below.
            #
            # One exception: the destination width is used to TRUNCATE an
            # i64 RHS register.  A monomorph-substituted value is already
            # native-width — in `vec_push<u16>`, `*(v.data + v.len) = item`
            # loads `item: T` as `i16`, so `trunc i64 %item to i16` is
            # invalid IR.  Such a value's local carries var_type TypeKind.Struct
            # with a primitive type_name ("u16"); leave value_type alone and
            # let the TypeKind.Struct arm below store it at its own width via
            # emit_llvm_type_struct.
            var rhs_is_named_type: i32 = 0
            if stmt.assign_value.kind == ExprKind.Ident
                let rhs_loc: *LocalVar = find_local_struct_name(s, StrView { ptr: (stmt.assign_value.ident_ptr), len: (stmt.assign_value.ident_len) as i64 })
                if rhs_loc != null and lv_var_type(rhs_loc) == TypeKind.Struct
                    rhs_is_named_type = 1
            let dst_type: TypeKind = get_deref_store_type(s, target_expr.operand)
            if dst_type != TypeKind.Void and dst_type != TypeKind.I64 and rhs_is_named_type == 0
                value_type = dst_type
            # AGAST #3097: a known `*i64` slot stores all 8 bytes; the RHS's
            # i64 register is already sext/zext'd by its own signedness.
            if (dst_type == TypeKind.Void or dst_type == TypeKind.I64) and rhs_is_named_type == 0
                dst_is_i64 = deref_store_into_declared_i64(s, target_expr.operand)
            # get_deref_store_type reports TypeKind.Struct but not which struct,
            # so recover the name from the operand for the aggregate store.
            # AGAST #1505: resolve it exactly as the `*p` load does, so
            # `*(h.items + j) = *other` stores the %S the RHS deref loaded
            # (pointer arithmetic, let-local `*S`, struct-pointer fields).
            var dst_sname: *u8 = null
            var dst_sname_len: i32 = 0
            deref_pointee_struct_name(s, target_expr.operand, @dst_sname, @dst_sname_len)
            if dst_sname_len > 0
                value_type = TypeKind.Struct
                struct_name = dst_sname
                struct_name_len = dst_sname_len
            # Bare-ident fallback: a monomorphised `*T` param can record
            # pointee TypeKind.Struct with a primitive name ("u16") that
            # find_struct rejects; emit_llvm_type_struct maps it to i16.
            else if target_expr.operand.kind == ExprKind.Ident
                let dst_loc2: *LocalVar = find_local_struct_name(s, StrView { ptr: (target_expr.operand.ident_ptr), len: (target_expr.operand.ident_len) as i64 })
                if dst_loc2 != null and lv_pointee_type(dst_loc2) == TypeKind.Struct
                    value_type = TypeKind.Struct
                    struct_name = lv_type_name(dst_loc2)
                    struct_name_len = lv_type_name_len(dst_loc2)

        # Fall back to value's type if destination pointee was unknown (TypeKind.I64 default)
        if value_type == TypeKind.I64 and dst_is_i64 == 0
            # Check if value is an identifier - look up its type
            match stmt.assign_value.kind
                ExprKind.Ident =>
                    let local: *LocalVar = find_local_struct_name(s, StrView { ptr: (stmt.assign_value.ident_ptr), len: (stmt.assign_value.ident_len) as i64 })
                    if local != null
                        value_type = lv_var_type(local)
                        if lv_var_type(local) == TypeKind.Struct
                            struct_name = lv_type_name(local)
                            struct_name_len = lv_type_name_len(local)
                # Check if value is a function call - look up the function's return type
                ExprKind.Call =>
                    let fn_def: *FnDef = find_fn(s, StrView { ptr: (stmt.assign_value.func_name), len: (stmt.assign_value.func_name_len) as i64 })
                    if fn_def != null
                        if fn_def.return_type == TypeKind.Struct
                            value_type = TypeKind.Struct
                            struct_name = fn_def.return_type_name
                            struct_name_len = fn_def.return_type_name_len
                # Check if value is a struct literal
                ExprKind.StructLit =>
                    value_type = TypeKind.Struct
                    struct_name = stmt.assign_value.ident_ptr
                    struct_name_len = stmt.assign_value.ident_len
                _ => pass

        # LARB R61 (§13.6): the place, then the value.  `*f() = v` calls
        # `f` before it emits `v`, as `f()[i] = v` does (AGAST #1740).
        # For `*ptr = value`, the store address IS the pointer — NOT the
        # dereferenced value. `target_expr` here IS the pointer expression
        # (parser strips the leading `*`), so emit_expr produces the pointer
        # value directly. Legacy callers wrapping with ExprKind.Unary still work
        # via the else branch below.
        var addr: i32 = 0
        # Track whether `addr` is already ptr-typed (no inttoptr needed).
        # TypeKind.MutRef locals load as `ptr` (emit_llvm_type maps it to "ptr"),
        # while TypeKind.Ptr/TypeKind.Ref still load as i64. Without this guard,
        # `*out = v` for `out: @&i64` emits `inttoptr i64 %p to ptr` where
        # %p is already `ptr` — LLVM rejects (AGAST #173).
        var addr_is_ptr: bool = false
        if target_expr.kind == ExprKind.Ident
            let opd_loc: *LocalVar = find_local_struct_name(s, StrView { ptr: (target_expr.ident_ptr), len: (target_expr.ident_len) as i64 })
            if opd_loc != null and lv_var_type(opd_loc) == TypeKind.MutRef
                addr_is_ptr = true
            addr = emit_expr(s, target_expr)
        else if target_expr.kind == ExprKind.Unary and target_expr.op == OpKind.Deref
            if target_expr.operand.kind == ExprKind.Ident
                let opd_loc2: *LocalVar = find_local_struct_name(s, StrView { ptr: (target_expr.operand.ident_ptr), len: (target_expr.operand.ident_len) as i64 })
                if opd_loc2 != null and lv_var_type(opd_loc2) == TypeKind.MutRef
                    addr_is_ptr = true
            # `*@&x = v`: `@&` is a `ptr` where `@` is an i64 (AGAST #2338).
            if target_expr.operand.kind == ExprKind.Unary and target_expr.operand.op == OpKind.AddrMut
                addr_is_ptr = true
            addr = emit_expr(s, target_expr.operand)
        else
            addr = emit_expr(s, target_expr)
        # Convert i64 address to ptr (skip when source is already ptr)
        var ptr: i32 = 0
        if addr_is_ptr
            ptr = addr
        else
            ptr = next_reg(s)
            emit_str(s, IR_INDENT)
            emit_reg(s, ptr)
            emit_str(s, IR_INTTOPTR)
            emit_reg(s, addr)
            emit_str(s, c" to ptr\n")

        # AGAST #2142: `*p = Some(..)` builds the pointee's enum.  Only when
        # the destination struct is known; an unresolved one keeps the
        # plain lowering (and its return-type fallback).
        var val: i32 = 0
        if value_type == TypeKind.Struct and struct_name_len > 0
            val = emit_store_into_slot(s, stmt.assign_value, value_type, StrView { ptr: (struct_name), len: (struct_name_len) as i64 })   # AGAST #2390
        else
            val = emit_expr(s, stmt.assign_value)
        # LARB R58 (§13.6): `*p = v` through a reference drops the pointee's
        # old value after v, before the store.  Only a literal `*p` target --
        # not an index the rewrites restated as a deref -- and never through
        # a `*T`, whose pointee may be uninitialised.
        if orig_reach == OWN_REACH_REF and orig_target.kind == ExprKind.Unary and orig_target.op == OpKind.Deref
            if value_type == TypeKind.Struct and struct_name_len > 0
                own_drop_old_ref_value(s, ptr, StrView { ptr: (struct_name), len: (struct_name_len) as i64 })
        # Store based on value type
        if value_type == TypeKind.Struct and struct_name_len > 0
            # Struct store - emit: store %StructName %val, ptr %ptr
            # Post-monomorph primitive-name guard (vec_push_u16_method
            # parity): when the struct name is actually a primitive from
            # generic substitution, route through emit_llvm_type_struct
            # so we emit `store i16 %val` instead of `store %u16 %val`.
            emit_struct_store_or_copy(s, TypeKind.Struct, StrView { ptr: (struct_name), len: (struct_name_len) as i64 }, val, ptr)
        else
            match value_type
                TypeKind.F32 | TypeKind.F64 =>
                    # AGAST #2022: `*p = v` through a *f32 / *f64 stores `float` /
                    # `double` (an f64 value into an f32 slot is fptrunc'd), as
                    # `p[i] = v` does (#1973).  It fell to `store i64 %float`.
                    # AGAST #2062: an integer value (`*p = 3`) is sitofp'd by
                    # emit_field_elem_narrow (#2065).
                    let fval: i32 = emit_field_elem_narrow(s, val, value_type, stmt.assign_value)
                    emit_str(s, IR_STORE_IND)
                    emit_str(s, elem_mem_llvm(value_type))
                    emit_str(s, IR_SP)
                    emit_reg(s, fval)
                    emit_str(s, IR_PTR_SEP)
                    emit_reg(s, ptr)
                    emit_str(s, IR_NL)
                TypeKind.Bool =>
                    # AGAST #2053: a `*bool` pointee is an `i1` (ritz0's layout, a
                    # bool struct field).  The i64 default overwrote the 7 bytes
                    # after it -- the neighbouring fields.
                    let bval: i32 = emit_field_elem_narrow(s, val, TypeKind.Bool, stmt.assign_value)
                    emit_store_typed(s, IR_TY_I1, bval, ptr)
                _ =>
                    if ty_int_bits(value_type) == 32
                        # i32 store
                        let trunc: i32 = ir_trunc_i64_i32(s.out, @s.reg_counter, val)
                        emit_store_typed(s, IR_TY_I32, trunc, ptr)
                    else if ty_int_bits(value_type) == 16
                        # i16 store via deref — trunc i64 → i16
                        let trunc: i32 = ir_trunc_i64_i16(s.out, @s.reg_counter, val)
                        emit_store_typed(s, IR_TY_I16, trunc, ptr)
                    else if ty_int_bits(value_type) == 8
                        # Byte store
                        let trunc: i32 = ir_trunc_i64_i8(s.out, @s.reg_counter, val)
                        emit_store_typed(s, IR_TY_I8, trunc, ptr)
                    else if value_type == TypeKind.Ptr or value_type == TypeKind.PtrPtr
                        # Pointer store.  AGAST #2308: `*p = @&d` is a `ptr` already.
                        let ptr_val: i32 = i64_value_to_ptr(s, stmt.assign_value, val)
                        emit_store_typed(s, IR_TY_PTR, ptr_val, ptr)
                    else
                        # Default: store i64 (for i64, u64, and unknown types)
                        emit_store_typed(s, IR_TY_I64, val, ptr)
        return

    # AGAST #1509: `g = v` onto a whole multi-dimensional array stored one
    # i64 into its first 8 bytes.  AGAST #3634: a whole N-D value of the same
    # shape (a local, a global, a `:&` param on either side, a call) is copied
    # over it; anything else still fails closed.
    let whole_sh: *ArrayShape = nd_array_name_shape(s, StrView { ptr: (stmt.assign_target), len: (stmt.assign_target_len) as i64 })
    if whole_sh != null
        if emit_nd_whole_assign(s, stmt, whole_sh) == 1
            return
        emit_nd_error(s, stmt.span.line, stmt.span.col, c"assigning a whole multi-dimensional array is not supported in ritz1 (assign each element)")
        return
    let loc: i32 = find_local(s, StrView { ptr: (stmt.assign_target), len: (stmt.assign_target_len) as i64 })
    if loc >= 0
        let var_type: TypeKind = find_local_type(s, StrView { ptr: (stmt.assign_target), len: (stmt.assign_target_len) as i64 })
        # AGAST #2346: `r = v` on a `r:& T` param writes the referent.
        if emit_lent_whole_store(s, stmt, loc) == 1
            return
        # Special handling for struct-typed assignments
        if var_type == TypeKind.Struct
            # For struct literal assignment, use alloca + field init
            if stmt.assign_value.kind == ExprKind.StructLit
                emit_struct_lit_to_alloca(s, stmt.assign_value, loc)
                return
            # AGAST #167: thread SIMD ctx so the rhs intrinsic dispatch
            # (e.g. `wk = simd_loadu(@k[0])`) knows which `<N x iM>` to load.
            let _saved_simd_a: *u8 = s.ctx_simd_name
            let _saved_simd_a_len: i32 = s.ctx_simd_name_len
            let local: *LocalVar = find_local_struct_name(s, StrView { ptr: (stmt.assign_target), len: (stmt.assign_target_len) as i64 })
            if local != null and is_simd_vector_type_name(StrView { ptr: (lv_type_name(local)), len: (lv_type_name_len(local)) as i64 }) == 1
                s.ctx_simd_name = lv_type_name(local)
                s.ctx_simd_name_len = lv_type_name_len(local)
            # For function call or other expression returning struct.
            # AGAST #2142: `held = Some(..)` builds the local's enum.
            var val: i32 = 0
            if local != null
                val = emit_expr_into_slot(s, stmt.assign_value, var_type, StrView { ptr: (lv_type_name(local)), len: (lv_type_name_len(local)) as i64 })
            else
                val = emit_expr(s, stmt.assign_value)
            s.ctx_simd_name = _saved_simd_a
            s.ctx_simd_name_len = _saved_simd_a_len
            if local != null
                # AGAST #168: Span$u8 ↔ StrView layout coercion at assign sites
                # (e.g. `path = "..."` where path: StrView).  See emit_var_decl
                # for the same pattern.
                var stored_reg: i32 = val
                var src_name: *u8 = null
                var src_len: i32 = 0
                resolve_expr_struct_name(s, stmt.assign_value, @src_name, @src_len)
                if is_layout_equiv_pair(StrView { ptr: (src_name), len: (src_len) as i64 }, StrView { ptr: (lv_type_name(local)), len: (lv_type_name_len(local)) as i64 }) == 1
                    stored_reg = rebuild_layout_equiv(s, val, StrView { ptr: (src_name), len: (src_len) as i64 }, StrView { ptr: (lv_type_name(local)), len: (lv_type_name_len(local)) as i64 })
                # AGAST #167: emit_llvm_type_struct routes `v4i32`/`v16i8`
                # etc. to `<N x iM>` so the store width matches the
                # inline-SIMD call's vector result; primitive type names
                # ("i32", "f32", …) lower to their LLVM scalar type for
                # the post-monomorph TypeKind.Struct-with-primitive-name shape.
                emit_struct_store_or_copy(s, var_type, StrView { ptr: (lv_type_name(local)), len: (lv_type_name_len(local)) as i64 }, stored_reg, loc)
            else
                emit_store_typed(s, IR_TY_I64, val, loc)
            return
        # AGAST #2035 / #2169: `a = x.f` / `= [..]` / `= c` copy the whole
        # array into local `a`.
        if var_type == TypeKind.Array
            let aloc: *LocalVar = find_local_struct_name(s, StrView { ptr: (stmt.assign_target), len: (stmt.assign_target_len) as i64 })
            if aloc != null and lv_array_shape(aloc) == null
                emit_array_local_whole_assign(s, loc, lv_array_size(aloc), lv_array_elem_type(aloc), StrView { ptr: (lv_type_name(aloc)), len: (lv_type_name_len(aloc)) as i64 }, stmt.assign_value)
                return
        # AGAST #1652: `p = s` (`s: @&S`) into a `*S` local.  `let` only;
        # see the #1755 note in emit_fn.
        # AGAST #2142: a non-enum local is no enum context for a ctor RHS.
        let assign_raw: i32 = emit_expr_into_slot(s, stmt.assign_value, var_type, StrView { ptr: (null), len: (0) as i64 })
        let val: i32 = ptr_slot_value(s, var_type, stmt.assign_value, assign_raw)
        if ty_int_bits(var_type) == 32
            let trunc: i32 = ir_trunc_i64_i32(s.out, @s.reg_counter, val)
            emit_store_typed(s, IR_TY_I32, trunc, loc)
        else if var_type == TypeKind.Ptr or var_type == TypeKind.PtrPtr or var_type == TypeKind.Ref or var_type == TypeKind.MutRef
            # Store i64 directly (pointers are stored as i64).  AGAST #2337:
            # into a reference, `p = @&c` and `p = m` are a `ptr` already;
            # ptr_slot_value has done a `*T` local.
            var ival: i32 = val
            if var_type == TypeKind.Ref or var_type == TypeKind.MutRef
                ival = ptr_value_to_i64(s, stmt.assign_value, val)
            emit_store_typed(s, IR_TY_I64, ival, loc)
        else if ty_int_bits(var_type) == 16
            # Truncate i64 (unified value model) back to i16 for the slot.
            let trunc: i32 = ir_trunc_i64_i16(s.out, @s.reg_counter, val)
            emit_store_typed(s, IR_TY_I16, trunc, loc)
        else if ty_int_bits(var_type) == 8
            # Truncate i64 to i8 for byte types
            let trunc: i32 = ir_trunc_i64_i8(s.out, @s.reg_counter, val)
            emit_store_typed(s, IR_TY_I8, trunc, loc)
        else if var_type == TypeKind.Bool
            # AGAST #2994: only a `b:& bool` param is a TypeKind.Bool local
            # (bind_scalar_borrow_param): one byte, whatever place it borrows.
            let btrunc: i32 = next_reg(s)
            emit_str(s, IR_INDENT)
            emit_reg(s, btrunc)
            emit_str(s, IR_TRUNC)
            emit_reg(s, val)
            emit_str(s, c" to i1\n  store i1 ")
            emit_reg(s, btrunc)
            emit_str(s, IR_PTR_SEP)
            emit_reg(s, loc)
            emit_str(s, IR_NL)
        else
            # AGAST #2065: an f32 / f64 local narrows / converts its value
            # (`x = 3` sitofp's, an f64 into an f32 fptrunc's) as every
            # other float slot does; it stored the raw i64 register.
            var lval: i32 = val
            if var_type == TypeKind.F32 or var_type == TypeKind.F64
                lval = emit_field_elem_narrow(s, val, var_type, stmt.assign_value)
            emit_str(s, IR_STORE_IND)
            emit_str(s, ty_value_llvm(var_type))
            emit_str(s, IR_SP)
            emit_reg(s, lval)
            emit_str(s, IR_PTR_SEP)
            emit_reg(s, loc)
            emit_str(s, IR_NL)
    else
        # Check for global variable
        let glob: *GlobalVarDef = find_global(s, StrView { ptr: (stmt.assign_target), len: (stmt.assign_target_len) as i64 })
        if glob != null
            # AGAST #2287: `G = a` copies the whole array into the global.
            match glob.var_type
                TypeKind.Array =>
                    emit_array_local_whole_assign(s, emit_global_array_ptr(s, glob), glob.array_size, glob.array_elem_type, StrView { ptr: (glob.array_elem_type_name), len: (glob.array_elem_type_name_len) as i64 }, stmt.assign_value)
                    return
                # AGAST #181: struct-typed globals (`var g: Store`) need
                # `store %Store %val, ptr @g` not `store i64 %val` — the SSA
                # value here is a `%Store` aggregate, not an i64.  Route through
                # emit_llvm_type_struct so primitive-aliased struct names
                # (`u16`, `f32`, etc.) and SIMD vector types lower correctly.
                TypeKind.Struct =>
                    # AGAST #2454: `g = Some(5)` builds the global's enum.
                    let val: i32 = emit_expr_into_slot(s, stmt.assign_value, TypeKind.Struct, StrView { ptr: (glob.type_name), len: (glob.type_name_len) as i64 })
                    emit_struct_store_or_copy_named(s, TypeKind.Struct, StrView { ptr: (glob.type_name), len: (glob.type_name_len) as i64 }, val, glob.name, glob.name_len)
                    return
                _ => pass
            set_match_float_hint(s, stmt.assign_value, glob.var_type, StrView { ptr: (null), len: (0) as i64 })   # AGAST #4028
            let val: i32 = emit_expr(s, stmt.assign_value)
            if ty_int_bits(glob.var_type) == 32
                let trunc: i32 = ir_trunc_i64_i32(s.out, @s.reg_counter, val)
                emit_store_global(s, IR_TY_I32, trunc, StrView { ptr: (glob.name), len: (glob.name_len) as i64 })
            else if ty_int_bits(glob.var_type) == 16
                # i16 store via global — trunc i64 → i16 (unified value model).
                let trunc: i32 = ir_trunc_i64_i16(s.out, @s.reg_counter, val)
                emit_store_global(s, IR_TY_I16, trunc, StrView { ptr: (glob.name), len: (glob.name_len) as i64 })
            else if ty_int_bits(glob.var_type) == 8
                # i8 store via global — trunc i64 → i8.
                let trunc: i32 = ir_trunc_i64_i8(s.out, @s.reg_counter, val)
                emit_store_global(s, IR_TY_I8, trunc, StrView { ptr: (glob.name), len: (glob.name_len) as i64 })
            else if glob.var_type == TypeKind.Bool
                # AGAST #3001: a bool global is one i1 byte, as on ritz0; the
                # value is the i64 every bool lives in (#1646).
                let btrunc: i32 = ir_trunc_i64_i1(s.out, @s.reg_counter, val)
                emit_store_global(s, IR_TY_I1, btrunc, StrView { ptr: (glob.name), len: (glob.name_len) as i64 })
            else
                # AGAST #2065: f32 / f64 global, as the local arm above.
                # AGAST #2399: and a pointer global's value is an i64, as a
                # local's is: `G = @&q` stored the `ptr` `@&q` is as one.
                var gval: i32 = ptr_slot_value(s, glob.var_type, stmt.assign_value, val)
                if glob.var_type == TypeKind.F32 or glob.var_type == TypeKind.F64
                    gval = emit_field_elem_narrow(s, val, glob.var_type, stmt.assign_value)
                emit_str(s, IR_STORE_IND)
                emit_str(s, ty_value_llvm(glob.var_type))
                emit_str(s, IR_SP)
                emit_reg(s, gval)
                emit_str(s, c", ptr @")
                emit_name(s, StrView { ptr: (glob.name), len: (glob.name_len) as i64 })
                emit_str(s, IR_NL)
        else
            emit_ir_error_begin(s, stmt.span, c"unknown variable '")
            emit_ir_error_end(s, StrView { ptr: (stmt.assign_target), len: (stmt.assign_target_len) as i64 })

# AGAST #1946: when `e` is a match / if expression bound or returned at float
# type (`ty`, or a TypeKind.Struct named "f32" / "f64"), tell it to merge at that
# type so its phi, every arm and the slot / `ret` agree.  emit_match and
# emit_if_expr consume the hint on entry.
pub fn set_match_float_hint(s: *EmitterState, e: *Expr, ty: TypeKind, ty_name_sv: StrView)
    var ty_name: *u8 = ty_name_sv.ptr
    var ty_name_len: i32 = ty_name_sv.len as i32
    s.match_float_hint = TypeKind.Void
    if e == null
        return
    if e.kind != ExprKind.Match and e.kind != ExprKind.If
        return
    s.match_float_hint = slot_float_type(ty, StrView { ptr: (ty_name), len: (ty_name_len) as i64 })

# TypeKind.F32 / TypeKind.F64 when a slot of type (ty, ty_name) is a float, else 0.
pub fn slot_float_type(ty: TypeKind, ty_name_sv: StrView) -> TypeKind
    var ty_name: *u8 = ty_name_sv.ptr
    var ty_name_len: i32 = ty_name_sv.len as i32
    if ty == TypeKind.F32 or ty == TypeKind.F64
        return ty
    if ty_name != null and ty_name_len == 3 and is_float_type(ty, StrView { ptr: (ty_name), len: (ty_name_len) as i64 }) == 1
        if *(ty_name + 1) == '3'   # "f32"
            return TypeKind.F32
        return TypeKind.F64
    TypeKind.Void

# AGAST #3205: the fn's tail statement is a match and the fn returns a struct
# or enum (`ret_type`, named s.ret_type_name): if no arm yields a value (every
# arm `return`s), the match's phi is typed as that, which the implicit `ret`
# names, not i64.  emit_match_arms consumes the hint.
pub fn set_match_agg_hint(s: *EmitterState, ret_type: TypeKind)
    if ret_type != TypeKind.Struct
        return
    s.match_agg_hint = s.ret_type_name
    s.match_agg_hint_len = s.ret_type_name_len

fn emit_return(s: *EmitterState, stmt: *Stmt, ret_type: TypeKind)
    if stmt.return_value != null
        if emit_lent_return(s, stmt.return_value, ret_type) == 1   # AGAST #2279
            return
        if ret_type == TypeKind.Array and emit_array_return(s, stmt.return_value, ret_array_of(emitter_current_fn())) == 1
            return   # AGAST #2302
        # Special handling for struct returns - need to load entire struct
        if ret_type == TypeKind.Struct
            # Check if return value is a struct literal (e.g., return NFAFragment { start: s0, end: s0 })
            if stmt.return_value.kind == ExprKind.StructLit
                let alloca_reg: i32 = next_reg(s)
                entry_alloca_reg_begin_named(s, alloca_reg)
                emit_name(s, StrView { ptr: (stmt.return_value.ident_ptr), len: (stmt.return_value.ident_len) as i64 })
                emit_str(s, IR_NL)
                entry_alloca_reg_end(s)
                emit_struct_lit_to_alloca(s, stmt.return_value, alloca_reg)
                if s.ret_sret == 1
                    emit_sret_ret_from_ptr(s, alloca_reg)   # AGAST #1730
                    return
                let result: i32 = next_reg(s)
                emit_str(s, IR_INDENT)
                emit_reg(s, result)
                emit_str(s, IR_LOAD_NAMED)
                emit_name(s, StrView { ptr: (stmt.return_value.ident_ptr), len: (stmt.return_value.ident_len) as i64 })
                emit_str(s, IR_PTR_SEP)
                emit_reg(s, alloca_reg)
                emit_str(s, IR_NL)
                emit_str(s, c"  ret %")
                emit_name(s, StrView { ptr: (stmt.return_value.ident_ptr), len: (stmt.return_value.ident_len) as i64 })
                emit_str(s, IR_SP)
                emit_reg(s, result)
                emit_str(s, IR_NL)
                return
            # Check if return value is a local variable
            # Use emit_llvm_type_struct so tagged-enum types (Result$/Option$)
            # auto-route to `i64` instead of `%<name>` (task-99 cluster #3).
            if stmt.return_value.kind == ExprKind.Ident and struct_value_local(s, stmt.return_value) != null
                let loc: i32 = find_local(s, StrView { ptr: (stmt.return_value.ident_ptr), len: (stmt.return_value.ident_len) as i64 })
                if loc >= 0 and s.ret_sret == 1
                    emit_sret_ret_from_ptr(s, loc)   # AGAST #1730
                    return
                if loc >= 0
                    # Load the entire struct from the local
                    let result: i32 = next_reg(s)
                    emit_struct_load_or_defer(s, TypeKind.Struct, result, StrView { ptr: (s.ret_type_name), len: (s.ret_type_name_len) as i64 }, loc, null, 0)
                    emit_str(s, c"  ret ")
                    emit_llvm_type_struct(s, TypeKind.Struct, StrView { ptr: (s.ret_type_name), len: (s.ret_type_name_len) as i64 })
                    emit_str(s, IR_SP)
                    emit_reg(s, result)
                    emit_str(s, IR_NL)
                    return
            # AGAST #2330: `return p[i]`, a struct element of a pointer to an array,
            # is `return *(p# + i)`.
            var ret_val: *Expr = stmt.return_value
            var ret_th: ThroughIndex
            let ret_through: *LocalVar = index_through(s, ret_val)
            if ret_through != null and lv_is_array_view(ret_through) == 1
                index_through_fill(s, ret_val, through_spill(s, ret_through), @ret_th)
                ret_val = @ret_th.deref
            # Check if return value is a dereference (e.g., *ptr or *(ptr + offset))
            if ret_val.kind == ExprKind.Unary and ret_val.op == OpKind.Deref
                # AGAST #3038: `return *self` with a bare `self` (or any S by
                # value) has no pointer to follow: Sema refused it (index_refuse,
                # AGAST #3893), as this path read the S as one.
                # Calculate the pointer address, then load the struct from it
                let addr: i32 = emit_expr(s, ret_val.operand)
                let ptr: i32 = i64_value_to_ptr(s, ret_val.operand, addr)
                if s.ret_sret == 1
                    emit_sret_ret_from_ptr(s, ptr)   # AGAST #1730
                    return
                let result: i32 = next_reg(s)
                emit_struct_load_or_defer(s, TypeKind.Struct, result, StrView { ptr: (s.ret_type_name), len: (s.ret_type_name_len) as i64 }, ptr, null, 0)
                emit_str(s, c"  ret ")
                emit_llvm_type_struct(s, TypeKind.Struct, StrView { ptr: (s.ret_type_name), len: (s.ret_type_name_len) as i64 })
                emit_str(s, IR_SP)
                emit_reg(s, result)
                emit_str(s, IR_NL)
                return
            # For other expressions, emit normally and return.  The value is a
            # copy into the return slot, so `return a[i]` on a `[N]S` is (#2996).
            let val: i32 = emit_struct_copy(s, stmt.return_value, TypeKind.Struct)
            if s.ret_sret == 1
                emit_sret_ret_value(s, val)   # AGAST #1730
                return
            # AGAST #168: Span$u8 ↔ StrView layout coercion at return sites
            # (e.g. `return "..."` from a `-> StrView` fn).
            let ret_reg: i32 = coerce_struct_ret_value(s, stmt.return_value, val, StrView { ptr: (s.ret_type_name), len: (s.ret_type_name_len) as i64 })
            emit_str(s, c"  ret ")
            emit_llvm_type_struct(s, TypeKind.Struct, StrView { ptr: (s.ret_type_name), len: (s.ret_type_name_len) as i64 })
            emit_str(s, IR_SP)
            emit_reg(s, ret_reg)
            emit_str(s, IR_NL)
            return

        if struct_return_as_int_refused(s, stmt.return_value, ret_type) == 1   # AGAST #3008
            return
        set_match_float_hint(s, stmt.return_value, ret_type, StrView { ptr: (s.ret_type_name), len: (s.ret_type_name_len) as i64 })
        let val: i32 = emit_expr(s, stmt.return_value)
        if ty_int_bits(ret_type) == 32
            let trunc: i32 = ir_trunc_i64_i32(s.out, @s.reg_counter, val)
            emit_str(s, c"  ret i32 ")
            emit_reg(s, trunc)
            emit_str(s, IR_NL)
        else if ty_int_bits(ret_type) == 16
            # Truncate i64 to i16 for narrow return types (e.g. htons / ntohs).
            let trunc: i32 = ir_trunc_i64_i16(s.out, @s.reg_counter, val)
            emit_str(s, c"  ret i16 ")
            emit_reg(s, trunc)
            emit_str(s, IR_NL)
        else if ty_int_bits(ret_type) == 8
            # Truncate i64 to i8 for byte return types
            let trunc: i32 = ir_trunc_i64_i8(s.out, @s.reg_counter, val)
            emit_str(s, c"  ret i8 ")
            emit_reg(s, trunc)
            emit_str(s, IR_NL)
        else
            match ret_type
                TypeKind.Ptr | TypeKind.PtrPtr | TypeKind.Ref =>
                    # Pointers are represented as i64 internally, return as i64.
                    # AGAST #1652: `return s` with `s: @&S` is a `ptr`.  #1754: so is
                    # `-> @S`, which lowers to i64 too.
                    let ret_ival: i32 = ptr_value_to_i64(s, stmt.return_value, val)
                    emit_str(s, c"  ret i64 ")
                    emit_reg(s, ret_ival)
                    emit_str(s, IR_NL)
                TypeKind.MutRef =>
                    # AGAST #2391: `-> @&T` returns `ptr`.  An `@&T` local is one
                    # already, but a `-> @&T` call result and `self: @&T` are i64 here,
                    # so they get an inttoptr (as an `@&T` let's init does).
                    let ret_pval: i32 = i64_value_to_ptr(s, stmt.return_value, val)
                    emit_str(s, c"  ret ptr ")
                    emit_reg(s, ret_pval)
                    emit_str(s, IR_NL)
                TypeKind.Bool =>
                    # Bool returns: emit_expr always produces i64 (icmp result is
                    # zext-promoted to i64).  Truncate back to i1 for the return —
                    # squeeze.bits.bits_at_end and friends declare `-> bool`.
                    let bool_trunc: i32 = ir_trunc_i64_i1(s.out, @s.reg_counter, val)
                    emit_str(s, c"  ret i1 ")
                    emit_reg(s, bool_trunc)
                    emit_str(s, IR_NL)
                _ =>
                    # AGAST #2074: `return 1.0` from an `-> f32` fn is fptrunc'd.
                    let rval: i32 = float_ret_value(s, val, ret_type, stmt.return_value)
                    emit_str(s, c"  ret ")
                    emit_str(s, ty_value_llvm(ret_type))
                    emit_str(s, IR_SP)
                    emit_reg(s, rval)
                    emit_str(s, IR_NL)
    else
        emit_str(s, c"  ret void\n")

# AGAST #2388: 1 for a struct the iterable form walks through its header: a
# Vec<T>, a Span<T> or a StrView.  ritz0 takes any struct opening with a pointer
# and an integer; these are the ones that mean it.
fn is_for_header_name(name_sv: StrView) -> i32
    var name: *u8 = name_sv.ptr
    var name_len: i32 = name_sv.len as i32
    if name == null
        return 0
    if name_len > 4 and memcmp(name, c"Vec$", 4) == 0
        return 1
    if name_len > 5 and memcmp(name, c"Span$", 5) == 0
        return 1
    name_eq(StrView { ptr: (name), len: (name_len) as i64 }, StrView { ptr: (c"StrView"), len: (7) as i64 })

# find_struct, for a name that's a header.  Null for anything else, and for a
# header whose `data` and `len` aren't where the loop reads them.
fn for_header_struct(s: *EmitterState, name_sv: StrView) -> *StructDef
    var name: *u8 = name_sv.ptr
    var name_len: i32 = name_sv.len as i32
    if is_for_header_name(StrView { ptr: (name), len: (name_len) as i64 }) == 0
        return null
    let st: *StructDef = find_struct(s, StrView { ptr: (name), len: (name_len) as i64 })
    if st == null or st.fields == null or st.fields.next == null
        return null
    let data: *StructField = st.fields
    if data.field_type != TypeKind.Ptr and data.field_type != TypeKind.PtrPtr
        return null
    if data.next.field_type != TypeKind.I64
        return null
    st

# What a header's elements are, read off its `data` field as the monomorph left
# it: a struct T by name, a primitive T in array_elem_type, and `*T` as a `**`
# field.  1 if that names the element; a type this can't name is refused rather
# than walked at a guessed stride, which `Vec<S>` was at 8 bytes.
fn for_header_elem(s: *EmitterState, st: *StructDef, out: *ForElem) -> i32
    let data: *StructField = st.fields
    if data.field_type == TypeKind.Ptr
        if data.field_type_name_len > 0
            # AGAST #2411: a non-generic user enum is a `%C` the loop walks at
            # its layout (#1797), bound as a struct element is.  AGAST #3647:
            # and an Option / Result instance (`%Option$i64`), at the layout
            # tagged_enum_layout gives it, as ptr_pointee_size strides it (#1578).
            if find_struct(s, StrView { ptr: (data.field_type_name), len: (data.field_type_name_len) as i64 }) == null and user_enum_index(s.mono.pctx, StrView { ptr: (data.field_type_name), len: (data.field_type_name_len) as i64 }) < 0 and is_tagged_enum_type(StrView { ptr: (data.field_type_name), len: (data.field_type_name_len) as i64 }) == 0
                return 0
            out.elem = TypeKind.Struct
            out.name = data.field_type_name
            out.name_len = data.field_type_name_len
            return 1
        if primitive_name_len(data.array_elem_type) == 0
            return 0
        out.elem = data.array_elem_type
        return 1
    # `Vec$ptr_Node` names Node, and `Vec$ptr_u8` nothing: its pointee is only
    # in the suffix.  `Vec$ptr_ptr_u8` names no struct there is, and is refused.
    out.elem = TypeKind.Ptr
    if data.field_type_name_len > 0
        if find_struct(s, StrView { ptr: (data.field_type_name), len: (data.field_type_name_len) as i64 }) == null
            return 0
        out.pointee = TypeKind.Struct
        out.pointee_name = data.field_type_name
        out.pointee_name_len = data.field_type_name_len
        return 1
    var after: i32 = 0
    while after < st.name_len and *(st.name + after) != '$'   # '$'
        after = after + 1
    after = after + 5   # `$ptr_`
    out.pointee = primitive_type_from_name(StrView { ptr: (st.name + after), len: (st.name_len - after) as i64 })
    1

# The LLVM type of one element of a `for` iterable: `%S` for a struct element.
# emit_llvm_type spells that i64, which is neither its size nor its stride.
fn emit_for_elem_llvm(s: *EmitterState, elem: TypeKind, name_sv: StrView)
    var name: *u8 = name_sv.ptr
    var name_len: i32 = name_sv.len as i32
    if elem == TypeKind.Struct and name_len > 0
        emit_str(s, IR_PCT)
        emit_name(s, StrView { ptr: (name), len: (name_len) as i64 })
    else
        emit_str(s, ty_value_llvm(elem))

# AGAST #2388: a slot for the header value `val`, which has no place of its own:
# a call's result, a literal or a const.  Nothing else can write to it.  The alloca
# is static, so it is written into the fn's entry-block buffer, out of any enclosing loop.
fn emit_for_header_spill(s: *EmitterState, st: *StructDef, val: i32) -> i32
    let slot: i32 = next_reg(s)
    entry_alloca_reg_begin_named(s, slot)
    emit_name(s, StrView { ptr: (st.name), len: (st.name_len) as i64 })
    emit_str(s, c"\n")
    entry_alloca_reg_end(s)
    emit_struct_store_or_copy(s, TypeKind.Struct, StrView { ptr: (st.name), len: (st.name_len) as i64 }, val, slot)
    slot

# The struct a call in iterable position returns by value.  `as_bytes` is only
# the builtin on a StrView: a user's method of that name is whatever it says.
fn for_call_struct_name(s: *EmitterState, e: *Expr, out_name: **u8, out_len: *i32)
    call_result_struct_name(s, e, out_name, out_len)
    if *out_len > 0 or e.kind != ExprKind.Method or e.left == null or e.left.kind != ExprKind.Ident
        return
    if name_eq(StrView { ptr: (e.ident_ptr), len: (e.ident_len) as i64 }, StrView { ptr: (c"as_bytes"), len: (8) as i64 }) == 0
        return
    let loc: *LocalVar = find_local_struct_name(s, StrView { ptr: (e.left.ident_ptr), len: (e.left.ident_len) as i64 })
    if loc != null and name_eq(StrView { ptr: (lv_type_name(loc)), len: (lv_type_name_len(loc)) as i64 }, StrView { ptr: (c"StrView"), len: (7) as i64 }) == 1
        *out_name = c"Span$u8"
        *out_len = 7

# A bare name holding a header, or a reference to one.  A local hides a global of
# its name.
fn emit_for_ident_header(s: *EmitterState, e: *Expr, out: **StructDef) -> i32
    let loc: *LocalVar = find_local_struct_name(s, StrView { ptr: (e.ident_ptr), len: (e.ident_len) as i64 })
    if loc != null
        let st: *StructDef = for_header_struct(s, StrView { ptr: (lv_type_name(loc)), len: (lv_type_name_len(loc)) as i64 })
        if st == null
            return 0
        if lv_var_type(loc) == TypeKind.Struct
            *out = st
            return loc.reg
        if local_struct_levels(loc) == 1 and lv_pointee_type(loc) == TypeKind.Struct
            *out = st
            return emit_load_ptr(s, loc.reg)
        return 0
    let glob: *GlobalVarDef = find_global(s, StrView { ptr: (e.ident_ptr), len: (e.ident_len) as i64 })
    if glob != null
        if glob.var_type == TypeKind.Struct
            let gst: *StructDef = for_header_struct(s, StrView { ptr: (glob.type_name), len: (glob.type_name_len) as i64 })
            if gst != null
                *out = gst
                return emit_lvalue_ptr(s, e)
        else if glob.var_type == TypeKind.Ptr and glob.pointee_type == TypeKind.Struct
            let pst: *StructDef = for_header_struct(s, StrView { ptr: (glob.pointee_type_name), len: (glob.pointee_type_name_len) as i64 })
            if pst != null
                var unused: *StructDef = null
                var levels: i32 = 0
                *out = pst
                return emit_deref_operand_ptr(s, e, @unused, @levels)
        return 0
    let ce: *ConstEntry = find_const_entry(s, StrView { ptr: (e.ident_ptr), len: (e.ident_len) as i64 })
    if ce != null and ce.const_type == TypeKind.Struct
        let cst: *StructDef = for_header_struct(s, StrView { ptr: (ce.type_name), len: (ce.type_name_len) as i64 })
        if cst != null
            *out = cst
            return emit_for_header_spill(s, cst, emit_expr(s, e))
    0

# `@v` / `@&v` / `@h.v`.  `@v` of a pointer or a reference isn't here: ritz0
# refuses `v: *Vec<T>` and `v: @Vec<T>`.  `mr` is `h.v`, which emit_for_iterable
# has already reached (AGAST #2533): reaching it again would emit it twice.
fn emit_for_addr_header(s: *EmitterState, e: *Expr, mr: *MemberPtrResult, out: **StructDef) -> i32
    let op: *Expr = e.operand
    if op == null
        return 0
    if op.kind == ExprKind.Ident
        # AGAST #2314: `v:& Vec<T>`'s slot holds the borrow's pointer, and `@v` is
        # that pointer (#2286), not the slot's address.
        let lent: *LocalVar = lent_struct_local(s, op)
        if lent != null
            let lst: *StructDef = for_header_struct(s, StrView { ptr: (lv_type_name(lent)), len: (lv_type_name_len(lent)) as i64 })
            if lst == null
                return 0
            *out = lst
            return emit_load_ptr(s, lent.reg)
        let loc: *LocalVar = find_local_struct_name(s, StrView { ptr: (op.ident_ptr), len: (op.ident_len) as i64 })
        if loc != null
            if lv_var_type(loc) != TypeKind.Struct
                return 0
            let st: *StructDef = for_header_struct(s, StrView { ptr: (lv_type_name(loc)), len: (lv_type_name_len(loc)) as i64 })
            if st != null
                *out = st
                return loc.reg
            return 0
        let glob: *GlobalVarDef = find_global(s, StrView { ptr: (op.ident_ptr), len: (op.ident_len) as i64 })
        if glob != null and glob.var_type == TypeKind.Struct
            let gst: *StructDef = for_header_struct(s, StrView { ptr: (glob.type_name), len: (glob.type_name_len) as i64 })
            if gst != null
                *out = gst
                return emit_lvalue_ptr(s, op)
        return 0
    if op.kind == ExprKind.Member
        if mr.success == 1 and mr.field.field_type == TypeKind.Struct
            let fst: *StructDef = for_header_struct(s, StrView { ptr: (mr.field.field_type_name), len: (mr.field.field_type_name_len) as i64 })
            if fst != null
                *out = fst
                return mr.reg
    if op.kind == ExprKind.Index
        return emit_for_element_header(s, op, out)   # AGAST #2410: `@vs[i]` is `vs[i]`
    0

# AGAST #2410: `*p`, with `p` a pointer to a header: the header it points at.
fn emit_for_deref_header(s: *EmitterState, op: *Expr, out: **StructDef) -> i32
    var dst: *StructDef = null
    var levels: i32 = 0
    let reg: i32 = emit_deref_operand_ptr(s, op, @dst, @levels)
    if dst == null or levels != 1
        return 0
    let st: *StructDef = for_header_struct(s, StrView { ptr: (dst.name), len: (dst.name_len) as i64 })
    if st == null
        return 0
    *out = st
    reg

# AGAST #2426: `vv[i]`, a header that is an element of the Vec `vv` names, where
# it is in `vv`'s buffer: `&data[i]`, with `vv` and `i` evaluated once, before
# the loop.  `vv` is any place emit_for_header walks in place; a call's result
# isn't one.  0, emitting nothing, for anything else.
fn emit_for_vec_elem_header(s: *EmitterState, e: *Expr, out: **StructDef) -> i32
    let base: *Expr = e.left
    if base == null or e.right == null or e.right.kind == ExprKind.Range
        return 0
    if base.kind == ExprKind.Call or base.kind == ExprKind.Method or base.kind == ExprKind.ArrayLit or base.kind == ExprKind.StringLit
        return 0
    var b: RefTy
    var el: RefTy
    if ref_ty_of(s, base, @b) == 0 or ref_vec_elem(s, @b, @el) == 0 or el.kind != TypeKind.Struct
        return 0
    let est: *StructDef = for_header_struct(s, StrView { ptr: (el.name), len: (el.name_len) as i64 })
    if est == null
        return 0
    var mr: MemberPtrResult
    mr.reg = 0
    mr.field = null
    mr.success = 0
    if base.kind == ExprKind.Member
        emit_member_ptr(s, base, @mr)
    var vst: *StructDef = null
    let hdr: i32 = emit_for_header(s, base, @mr, @vst)
    if vst == null
        return 0
    let di: i32 = find_field_index(vst, StrView { ptr: (c"data"), len: (4) as i64 })
    if di < 0
        return 0
    let dpp: i32 = next_reg(s)
    emit_str(s, IR_INDENT)
    emit_reg(s, dpp)
    emit_str(s, IR_GEP_NAMED)
    emit_name(s, StrView { ptr: (vst.name), len: (vst.name_len) as i64 })
    emit_str(s, IR_PTR_SEP)
    emit_reg(s, hdr)
    emit_str(s, IR_I32_ZERO)
    emit_int(s, di as i64)
    emit_str(s, IR_NL)
    let dp: i32 = emit_load_ptr(s, dpp)
    let idx: i32 = emit_expr(s, e.right)
    let ep: i32 = next_reg(s)
    emit_str(s, IR_INDENT)
    emit_reg(s, ep)
    emit_str(s, IR_GEP_NAMED)
    emit_name(s, StrView { ptr: (est.name), len: (est.name_len) as i64 })
    emit_str(s, IR_PTR_SEP)
    emit_reg(s, dp)
    emit_str(s, IR_I64_SEP)
    emit_reg(s, idx)
    emit_str(s, IR_NL)
    *out = est
    ep

# AGAST #2410: `vs[i]`, an element that is a header, at its own address.  The
# index is evaluated once, before the loop.
fn emit_for_element_header(s: *EmitterState, e: *Expr, out: **StructDef) -> i32
    var t: RefTy
    if ref_ty_of(s, e, @t) == 0
        return emit_for_vec_elem_header(s, e, out)   # AGAST #2426
    if t.kind != TypeKind.Struct
        return 0
    let st: *StructDef = for_header_struct(s, StrView { ptr: (t.name), len: (t.name_len) as i64 })
    if st == null
        return 0
    let reg: i32 = emit_lvalue_ptr(s, e)
    if reg < 0
        return 0
    *out = st
    reg

# AGAST #2388: a pointer to the header `iter` names, with its struct in *out, or
# 0 with *out null.  The loop walks that header in place, reading `len` and `data`
# on every pass, because it sees what the body writes (#2387).  That's also what
# makes a `push` that moves the buffer safe: nothing from before it is kept, and
# the binding is a copy of its element, taken before the body runs.
#
# `iter` is evaluated once.  `mr` is its field when it's an ExprKind.Member, or `@` /
# `@&` of one: reaching that again would run whatever it's reached through twice.
fn emit_for_header(s: *EmitterState, iter: *Expr, mr: *MemberPtrResult, out: **StructDef) -> i32
    match iter.kind
        ExprKind.Ident =>
            return emit_for_ident_header(s, iter, out)
        ExprKind.Member =>
            if mr.success != 1
                return 0
            let f: *StructField = mr.field
            let st: *StructDef = for_header_struct(s, StrView { ptr: (f.field_type_name), len: (f.field_type_name_len) as i64 })
            if st == null
                return 0
            match f.field_type
                TypeKind.Struct =>
                    *out = st
                    return mr.reg
                TypeKind.Ptr =>
                    *out = st
                    return emit_load_ptr(s, mr.reg)
                _ => pass
            return 0
        _ => pass
    if iter.kind == ExprKind.Unary and (iter.op == OpKind.Addr or iter.op == OpKind.AddrMut)
        return emit_for_addr_header(s, iter, mr, out)
    # AGAST #2410: `*p` and `vs[i]` are places: walked where they are.
    if iter.kind == ExprKind.Unary and iter.op == OpKind.Deref
        return emit_for_deref_header(s, iter.operand, out)
    if iter.kind == ExprKind.Index
        return emit_for_element_header(s, iter, out)
    var name: *u8 = null
    var name_len: i32 = 0
    match iter.kind
        ExprKind.Call | ExprKind.Method =>
            for_call_struct_name(s, iter, @name, @name_len)
        ExprKind.StringLit =>
            resolve_expr_struct_name(s, iter, @name, @name_len)
        _ => pass
    let vst: *StructDef = for_header_struct(s, StrView { ptr: (name), len: (name_len) as i64 })
    if vst == null
        return 0
    *out = vst
    emit_for_header_spill(s, vst, emit_expr(s, iter))

# AGAST #2410: the LLVM type of what the loop binds: an element, or a `[M x T]` row
# when `row` is M.  AGAST #3379: or the plane `[M x [N x ..T]]` when `plane`
# is non-null, spelled as the `[M][N]..T` local's alloca is.
fn emit_for_slot_llvm(s: *EmitterState, elem: TypeKind, name_sv: StrView, row: i32, plane: *ArrayShape)
    var name: *u8 = name_sv.ptr
    var name_len: i32 = name_sv.len as i32
    if plane != null
        emit_array_shape_llvm(s, plane, 0)
    else if row > 0
        emit_str(s, c"[")
        emit_int(s, row as i64)
        emit_str(s, IR_X)
        emit_for_elem_llvm(s, elem, StrView { ptr: (name), len: (name_len) as i64 })
        emit_str(s, c"]")
    else
        emit_for_elem_llvm(s, elem, StrView { ptr: (name), len: (name_len) as i64 })

# AGAST #2410: the array a `*[N]T` / `@[N]T` / `@&[N]T` local points at, read once,
# with its N and T in the outs.  (`*[N][M]T` doesn't parse on ritz1.)
fn for_array_ptr(s: *EmitterState, loc: *LocalVar, elem: *TypeKind, size: *i32, name: **u8, name_len: *i32, pointee: *TypeKind, p_name: **u8, p_name_len: *i32) -> i32
    *elem = lv_pointee_array_elem_type(loc)
    *size = lv_pointee_array_size(loc)
    var en_len: i32 = 0
    let en: *u8 = array_ptr_elem_name(loc, @en_len)
    *name = en
    *name_len = en_len
    *pointee = elem_recorded_pointee(s, *elem, lv_pointee_array_elem_pointee(loc), StrView { ptr: (en), len: (en_len) as i64 }, p_name, p_name_len)
    emit_load_ptr(s, loc.reg)

# AGAST #2410: the element type of the literal `e`, from its first element as
# ritz0 has it: a struct, a bool, a float or an integer.  TypeKind.Void for any other.
# AGAST #3014: a fill `[v; N]` too, from `v`.  emit_var_decl types an
# unannotated `let a = [5, 6, 7]` / `[5; 3]` with it.
fn array_init_elem(s: *EmitterState, e: *Expr, name: **u8, name_len: *i32) -> TypeKind
    if e.kind == ExprKind.ArrayFill
        if array_fill_struct_elem(s, e, name, name_len) > 0
            return TypeKind.Struct
        return scalar_elem_kind(s, e.left)
    if array_lit_struct_elem(s, e, name, name_len) > 0
        return TypeKind.Struct
    scalar_elem_kind(s, e.args)

# AGAST #3029: T when the literal or fill `e` is of pointers, as ritz0 has it
# from its first element: `@x` / `@&x` with `x` a local integer, float or
# struct (its name in *name / *name_len).  TypeKind.Void for any other, which
# array_init_elem's caller leaves untyped.  emit_var_decl types an
# unannotated `let a = [@x, @x]` as `[2]*T` with it, T recorded so `*a[1]`
# loads T's width.
fn array_init_ptr_pointee(s: *EmitterState, e: *Expr, name: **u8, name_len: *i32) -> TypeKind
    *name = null
    *name_len = 0
    var first: *Expr = e.args
    if e.kind == ExprKind.ArrayFill
        first = e.left
    if first != null and first.kind == ExprKind.Ident
        return array_init_ref_pointee(s, first, name, name_len)   # AGAST #4656
    if first == null or first.kind != ExprKind.Unary or (first.op != OpKind.Addr and first.op != OpKind.AddrMut)
        return TypeKind.Void
    let o: *Expr = first.operand
    if o == null or o.kind != ExprKind.Ident
        return TypeKind.Void
    let loc: *LocalVar = find_local_struct_name(s, StrView { ptr: (o.ident_ptr), len: (o.ident_len) as i64 })
    if loc == null or loc.is_bool == 1 or lv_bk_unsure(loc) == 1
        return TypeKind.Void
    let t: TypeKind = lv_var_type(loc)
    if t == TypeKind.Struct and lv_type_name_len(loc) > 0
        *name = lv_type_name(loc)
        *name_len = lv_type_name_len(loc)
        return TypeKind.Struct
    if ty_is_int(t) == 1 or t == TypeKind.F32 or t == TypeKind.F64
        return t
    TypeKind.Void

# AGAST #4656: `[t, t]` with `t: @S` (or `@&S`) is `[2]*S`, as `[@x]` is.
fn array_init_ref_pointee(s: *EmitterState, first: *Expr, name: **u8, name_len: *i32) -> TypeKind
    let loc: *LocalVar = find_local_struct_name(s, StrView { ptr: (first.ident_ptr), len: (first.ident_len) as i64 })
    if loc == null or lv_type_name_len(loc) <= 0
        return TypeKind.Void
    let t: TypeKind = lv_var_type(loc)
    if t != TypeKind.Ref and t != TypeKind.MutRef
        return TypeKind.Void
    *name = lv_type_name(loc)
    *name_len = lv_type_name_len(loc)
    TypeKind.Struct

# The scalar type ritz0 gives an array whose first element is `first`: an
# untyped int literal is i64, a typed value keeps its width.  TypeKind.Void for a
# pointer, a string or anything else not a bool, float or integer.
fn scalar_elem_kind(s: *EmitterState, first: *Expr) -> TypeKind
    if first == null
        return TypeKind.Void
    let k: i32 = bool_kind(s, first)
    if k == BK_BOOL
        return TypeKind.Bool
    let t: TypeKind = expr_slot_ty(first)
    if k == BK_FLOAT
        if t == TypeKind.F32
            return TypeKind.F32
        return TypeKind.F64
    if k == BK_INT
        if ty_is_int(t) == 1
            return t
        return TypeKind.I64
    TypeKind.Void

# AGAST #2410: the literal `e` in a slot of its own, a static alloca written
# into the entry-block buffer, out of any enclosing loop; 0 for a literal ritz1
# can't type.
fn emit_for_literal(s: *EmitterState, e: *Expr, elem: *TypeKind, size: *i32, name: **u8, name_len: *i32) -> i32
    let t: TypeKind = array_init_elem(s, e, name, name_len)
    if t == TypeKind.Void
        return 0
    var n: i32 = 0
    var it: *Expr = e.args
    while it != null
        n = n + 1
        it = it.next
    let slot: i32 = next_reg(s)
    entry_alloca_reg_begin(s, slot)
    emit_str(s, c"[")
    emit_int(s, n as i64)
    emit_str(s, IR_X)
    emit_for_elem_llvm(s, t, StrView { ptr: (*name), len: (*name_len) as i64 })
    emit_str(s, c"]\n")
    entry_alloca_reg_end(s)
    emit_array_lit_into(s, slot, n, t, StrView { ptr: (*name), len: (*name_len) as i64 }, e)
    # AGAST #3297: the move check marked a literal of a Drop T a temporary
    # (nothing takes it: `x` is a copy), dropped per element after the loop.
    if t == TypeKind.Struct
        own_note_array_temp(s, e, slot)
    *elem = t
    *size = n
    slot

# AGAST #2533: whether the field `e` names is in a call's temporary, as `mk().a`
# and `mk().h.a` are with `h` by value.  ritz0 takes no address of one (#2518).
# AGAST #3207: a link through a pointer leaves the temporary, so `mk().p.a`
# with `p: *H` is the place `p` points at, as `mkp().a` is with `mkp() -> *H`.
# `mkp()[0].a` is a place too: an index stops the search.
fn member_in_call_temp(s: *EmitterState, e: *Expr) -> i32
    var m: *Expr = e
    while m != null and m.kind == ExprKind.Member and m.left != null
        let l: *Expr = m.left
        if l.kind == ExprKind.Call or l.kind == ExprKind.Method
            # By value only: a `*S` call's field is where the call points.
            if call_result_ptr_struct(s, l) != null
                return 0
            return 1
        if l.kind != ExprKind.Member
            return 0
        # `m` reaches into the field `l` names.  A by-value struct is part of
        # whatever holds `l`: look further.  A pointer leads elsewhere.  A link
        # that won't resolve stays refused, as every call's field was.
        let lf: *StructField = resolve_member_chain_field(s, l)
        if lf == null
            return 1
        if lf.field_type == TypeKind.Ptr or lf.field_type == TypeKind.Ref or lf.field_type == TypeKind.MutRef
            return 0
        m = l
    0

# AGAST #2426: `*x`, with `x` a call, a field or a global of type `*[N]T` (as
# base_ptr_array has them): the array it points at, evaluated once.  0, emitting
# nothing, for anything else.
fn emit_for_deref_array(s: *EmitterState, x: *Expr, elem: *TypeKind, size: *i32, name: **u8, name_len: *i32, pointee: *TypeKind, p_name: **u8, p_name_len: *i32) -> i32
    let pa: *Param = base_ptr_array(s, x)
    if pa == null or pa.param_pointee_array_shape != null
        return 0
    *elem = pa.param_pointee_array_elem_type
    *size = pa.param_pointee_array_size
    *name = pa.param_type_name
    *name_len = pa.param_type_name_len
    *pointee = elem_recorded_pointee(s, *elem, pa.param_pointee_array_elem_pointee, StrView { ptr: (*name), len: (*name_len) as i64 }, p_name, p_name_len)
    let val: i32 = emit_expr(s, x)
    let r: i32 = ir_inttoptr_ptr(s.out, @s.reg_counter, val)
    r

# Lower `for x in iter { body }` (no `..`) — the iterable form.
# Supports the shapes ritz1 can express today:
#   • a local `[N]T` (TypeKind.Array), walked in place
#   • a module const or global `[N]T`, walked in place at its symbol
#   • an array field, walked in place at its address (AGAST #2387)
#   • what a `*[N]T` / `@[N]T` / `@&[N]T` local points at, as `p` or `*p`, and a
#     row `m[i]` of a `[N][M]T`, walked in place (AGAST #2410)
#   • `*x` for a call, field or global `x` of type `*[N]T`, a row `mkp().m[i]` of
#     what a `*S` call returns, a field `b.f` read through a Box, and a header
#     `vv[i]` in a Vec's buffer: places, walked in place (AGAST #2426)
#   • a literal, or an `-> [N]T` call or method (AGAST #2997), walked in a
#     slot of its own: nothing else can reach it
#   • a `[N][M]T`, whose binding is each row, a copy as an element is
#   • a Vec, a Span or a StrView, through its header (emit_for_header)
# Anything else is a located error, as is an array of rank 3 or more.  AGAST
# #2375: it used to be a loop that never ran, with no diagnostic.
fn emit_for_iterable(s: *EmitterState, stmt: *Stmt, ret_type: TypeKind)
    var iter_kind: i32 = 0         # 0=unsupported, 1=array in a reg, 2=header in a reg, 3=array at a symbol
    var elem_type: TypeKind = TypeKind.I64
    var arr_size: i32 = 0
    var data_reg: i32 = 0
    var type_name: *u8 = null
    var type_name_len: i32 = 0
    # Const-array iter (kind=3): use global symbol `@<const_name>` as the
    # base pointer instead of an SSA reg.
    var const_name: *u8 = null
    var const_name_len: i32 = 0
    # AGAST #2332: what the binding points at, for an element of `[N]*T`.
    var bind_pointee: TypeKind = TypeKind.Void
    var bind_name: *u8 = null
    var bind_name_len: i32 = 0
    # AGAST #2375: the element's struct, for an element of `[N]S`.
    var elem_name: *u8 = null
    var elem_name_len: i32 = 0
    # AGAST #2410: what an N-D iterable is, and how many of its indices are
    # applied.  for_nd_rows turns it into the walk.
    var nd_shape: *ArrayShape = null
    var nd_depth: i32 = 0
    # M when the element is itself a `[M]T` row, which the binding holds.
    var row_size: i32 = 0
    # AGAST #3379: the `[M][N]..T` when the element is itself N-D, a plane.
    var plane: *ArrayShape = null

    var mr: MemberPtrResult
    mr.reg = 0
    mr.field = null
    mr.success = 0
    let iter: *Expr = stmt.for_start
    # AGAST #2314: `@a` / `@&a` walks the array `a` names, in place, as `a` does:
    # a local or by-value `[N]T`, `a:& [N]T` (whose slot is the array behind the
    # borrow) or a global.  `@K` of a const array walks its read-only data
    # (LARB R48, #3392); `@&K` doesn't.  AGAST #2533: and `@h.a`
    # walks the field `h.a`, as `h.a` does.
    var arr_ident: *Expr = iter
    var via_addr: i32 = 0
    if iter != null and iter.kind == ExprKind.Unary and (iter.op == OpKind.Addr or iter.op == OpKind.AddrMut) and iter.operand != null and (iter.operand.kind == ExprKind.Ident or iter.operand.kind == ExprKind.Member)
        arr_ident = iter.operand
        via_addr = 1
    if iter != null
        match arr_ident.kind
            ExprKind.Ident =>
                let loc: *LocalVar = find_local_struct_name(s, StrView { ptr: (arr_ident.ident_ptr), len: (arr_ident.ident_len) as i64 })
                if loc != null
                    if lv_var_type(loc) == TypeKind.Array and lv_array_shape(loc) != null
                        # AGAST #1509: a multi-dimensional array yields rows.  It
                        # used to GEP the alloca as `[N x i64]` and load garbage.
                        nd_shape = lv_array_shape(loc)
                        iter_kind = 1
                        data_reg = loc.reg
                    else if lv_var_type(loc) == TypeKind.Array
                        iter_kind = 1
                        elem_type = lv_array_elem_type(loc)
                        arr_size = lv_array_size(loc)
                        data_reg = loc.reg
                        elem_name = lv_type_name(loc)
                        elem_name_len = lv_type_name_len(loc)
                        bind_pointee = elem_recorded_pointee(s, elem_type, lv_array_elem_pointee(loc), StrView { ptr: (lv_type_name(loc)), len: (lv_type_name_len(loc)) as i64 }, @bind_name, @bind_name_len)
                    else if via_addr == 0 and array_ptr_named(s, StrView { ptr: (arr_ident.ident_ptr), len: (arr_ident.ident_len) as i64 }) != null
                        # AGAST #2410: `a: *[N]T` / `@[N]T` / `@&[N]T` walks the array
                        # it points at.
                        data_reg = for_array_ptr(s, loc, @elem_type, @arr_size, @elem_name, @elem_name_len, @bind_pointee, @bind_name, @bind_name_len)
                        iter_kind = 1
                else
                    # Iter is not a local — try a module const array
                    # (`const VALUES: [3]i32 = [2,3,5]`).  emit_const_array_entry
                    # emits `@VALUES = internal constant [3 x i32] [...]`; we GEP
                    # off the global symbol below.
                    let centry: *ConstEntry = find_const_entry(s, StrView { ptr: (arr_ident.ident_ptr), len: (arr_ident.ident_len) as i64 })
                    if centry != null and centry.const_type == TypeKind.Array and (via_addr == 0 or iter.op == OpKind.Addr)
                        iter_kind = 3
                        elem_type = centry.array_elem_type
                        arr_size = centry.array_size
                        const_name = centry.name as *u8
                        const_name_len = centry.name_len
                        elem_name = centry.array_elem_type_name
                        elem_name_len = centry.array_elem_type_name_len
                        # AGAST #1866: `for p in T` over a `[N]*u8` table binds a `*u8`.
                        bind_pointee = elem_recorded_pointee(s, elem_type, centry.array_elem_pointee, StrView { ptr: (elem_name), len: (elem_name_len) as i64 }, @bind_name, @bind_name_len)
                    else
                        let glob: *GlobalVarDef = find_global(s, StrView { ptr: (arr_ident.ident_ptr), len: (arr_ident.ident_len) as i64 })
                        if glob != null and glob.var_type == TypeKind.Array and glob.array_shape != null
                            nd_shape = glob.array_shape
                            iter_kind = 3
                            const_name = glob.name
                            const_name_len = glob.name_len
                        else if glob != null and glob.var_type == TypeKind.Array
                            iter_kind = 3
                            elem_type = glob.array_elem_type
                            arr_size = glob.array_size
                            const_name = glob.name
                            const_name_len = glob.name_len
                            elem_name = glob.array_elem_type_name
                            elem_name_len = glob.array_elem_type_name_len
                            bind_pointee = elem_recorded_pointee(s, elem_type, glob.array_elem_pointee, StrView { ptr: (elem_name), len: (elem_name_len) as i64 }, @bind_name, @bind_name_len)
            ExprKind.Member =>
                # `@mk().a` has no address: ritz0 says "Cannot get address of: Call".
                # Refused before the member is reached, which would run the call.
                # A field reached through `Deref` is `(*S_deref(@b)).f` by now
                # (deref_field.ritz, AGAST #3015): a place, walked in place.
                if via_addr == 0 or member_in_call_temp(s, arr_ident) == 0
                    emit_member_ptr(s, arr_ident, @mr)
                if mr.success == 1 and mr.field.field_type == TypeKind.Array
                    let fld: *StructField = mr.field
                    iter_kind = 1
                    data_reg = mr.reg
                    if fld.array_shape != null
                        nd_shape = fld.array_shape
                    elem_type = fld.array_elem_type
                    arr_size = fld.array_size
                    data_reg = mr.reg
                    elem_name = fld.array_elem_type_name
                    elem_name_len = fld.array_elem_type_name_len
                    bind_pointee = elem_recorded_pointee(s, elem_type, fld.array_elem_pointee, StrView { ptr: (elem_name), len: (elem_name_len) as i64 }, @bind_name, @bind_name_len)
            _ =>
                if iter.kind == ExprKind.Unary and iter.op == OpKind.Deref and iter.operand != null
                    # AGAST #2410: `*p` is the array `p` points at, not a copy of it.
                    var ap: *LocalVar = null
                    if iter.operand.kind == ExprKind.Ident
                        ap = array_ptr_named(s, StrView { ptr: (iter.operand.ident_ptr), len: (iter.operand.ident_len) as i64 })
                    if ap != null
                        data_reg = for_array_ptr(s, ap, @elem_type, @arr_size, @elem_name, @elem_name_len, @bind_pointee, @bind_name, @bind_name_len)
                        iter_kind = 1
                    else
                        # AGAST #2426: and `*mkp()`, `*h.p`, `*gp`, where they point.
                        data_reg = emit_for_deref_array(s, iter.operand, @elem_type, @arr_size, @elem_name, @elem_name_len, @bind_pointee, @bind_name, @bind_name_len)
                        if data_reg != 0
                            iter_kind = 1
                else
                    match iter.kind
                        ExprKind.Index =>
                            # AGAST #2410: a row `m[i]` of a `[N][M]T`, where it is.
                            # AGAST #2426 / #2517: `mkp().m[i]` too, a row of what a call points at.
                            let sh: *ArrayShape = nd_index_shape(s, iter, @nd_depth)
                            if sh != null and nd_depth < sh.rank and (iter.right == null or iter.right.kind != ExprKind.Range)
                                var ndp: NdIndexPtr
                                if emit_nd_index_ptr(s, iter, @ndp) == 1
                                    nd_shape = sh
                                    iter_kind = 1
                                    data_reg = ndp.reg
                        ExprKind.ArrayLit =>
                            # AGAST #2410: a literal is an rvalue: a slot of its own.
                            data_reg = emit_for_literal(s, iter, @elem_type, @arr_size, @elem_name, @elem_name_len)
                            if data_reg != 0
                                iter_kind = 1
                        _ =>
                            if call_ret_array(s, iter) != null
                                # AGAST #2997: an `-> [N]T` call or method is an rvalue too: its
                                # `[N x T]`, made once, in a slot of its own that nothing else sees.
                                let cra: *Param = call_ret_array(s, iter)
                                data_reg = emit_call_array_temp(s, iter, cra)
                                iter_kind = 1
                                elem_type = cra.param_array_elem_type
                                arr_size = cra.param_array_size
                                elem_name = cra.param_type_name
                                elem_name_len = cra.param_type_name_len
                                bind_pointee = elem_recorded_pointee(s, elem_type, cra.param_array_elem_pointee, StrView { ptr: (elem_name), len: (elem_name_len) as i64 }, @bind_name, @bind_name_len)

    if nd_shape != null
        # Rows of a `[N][M]T`, or the elements of a row.  AGAST #3379 (LARB
        # R40): rank 3 and up binds planes, each the `[M][N]..T` local that
        # `let p: [M][N]T = g[i]` declares (#3350), walked in turn.
        let left: i32 = nd_shape.rank - nd_depth
        arr_size = nd_shape.dims[nd_depth]
        if left == 2
            row_size = nd_shape.dims[nd_depth + 1]
        else if left > 2
            plane = nd_shape_from(nd_shape, nd_depth + 1)
        elem_type = nd_shape.leaf_type
        elem_name = nd_shape.leaf_name
        elem_name_len = nd_shape.leaf_name_len
        bind_pointee = elem_recorded_pointee(s, elem_type, nd_shape.leaf_pointee, StrView { ptr: (elem_name), len: (elem_name_len) as i64 }, @bind_name, @bind_name_len)

    if iter_kind == 0 and iter != null
        var hdr: *StructDef = null
        data_reg = emit_for_header(s, iter, @mr, @hdr)
        if hdr != null
            var fe: ForElem
            fe.elem = TypeKind.Void
            fe.name = null
            fe.name_len = 0
            fe.pointee = TypeKind.Void
            fe.pointee_name = null
            fe.pointee_name_len = 0
            if for_header_elem(s, hdr, @fe) == 0
                emit_nd_error(s, iter.span.line, iter.span.col, c"this `for` element type is not supported in ritz1 (index the Vec, or use a struct element)")
                return
            iter_kind = 2
            type_name = hdr.name
            type_name_len = hdr.name_len
            elem_type = fe.elem
            elem_name = fe.name
            elem_name_len = fe.name_len
            bind_pointee = fe.pointee
            bind_name = fe.pointee_name
            bind_name_len = fe.pointee_name_len

    if iter_kind == 0
        emit_nd_error(s, iter.span.line, iter.span.col, c"this `for` iterable is not supported in ritz1 (it takes an array, an array field, a Vec, a Span or a StrView)")
        return

    # Index storage (i64 counter).
    let idx_reg: i32 = next_reg(s)
    entry_alloca_reg(s, idx_reg, c"i64", null)
    emit_store_imm(s, IR_TY_I64, 0, idx_reg)

    # Loop variable — typed to elem_type so body reads get the right width.
    let var_reg: i32 = next_reg(s)
    entry_alloca_reg_begin(s, var_reg)
    # A bool local is an i64 slot, as emit_var_decl has it, and `elem_type` an
    # `i1` in the array.  The body reads the binding as any other bool local.
    # A bool row or plane (AGAST #3379) stays `i1`s, as a bool array local is.
    let bool_slot: i32 = (elem_type == TypeKind.Bool and row_size == 0 and plane == null) as i32
    if bool_slot == 1
        emit_str(s, c"i64")
    else
        emit_for_slot_llvm(s, elem_type, StrView { ptr: (elem_name), len: (elem_name_len) as i64 }, row_size, plane)
    emit_str(s, IR_NL)
    entry_alloca_reg_end(s)

    if plane != null
        # AGAST #3379: a plane is a `[M][N]..T` local, as emit_var_decl has it.
        add_local_array(s, StrView { ptr: (stmt.for_var), len: (stmt.for_var_len) as i64 }, var_reg, plane.dims[0], TypeKind.Array)
        let plane_loc: *LocalVar = local_at(s, s.local_count - 1)
        lv_set_array_shape(plane_loc, plane)
    else if row_size > 0
        # AGAST #2410: a row is a `[M]T` local.
        add_local_full(s, StrView { ptr: (stmt.for_var), len: (stmt.for_var_len) as i64 }, var_reg, TypeKind.Array, StrView { ptr: (elem_name), len: (elem_name_len) as i64 }, TypeKind.I64, row_size, elem_type)
        let row_loc: *LocalVar = local_at(s, s.local_count - 1)
        lv_set_array_elem_pointee(row_loc, bind_pointee)
    else if bind_pointee != TypeKind.Void
        add_local_full(s, StrView { ptr: (stmt.for_var), len: (stmt.for_var_len) as i64 }, var_reg, elem_type, StrView { ptr: (bind_name), len: (bind_name_len) as i64 }, bind_pointee, 0, TypeKind.Void)
    else if elem_type == TypeKind.Struct and elem_name_len > 0
        add_local_struct(s, StrView { ptr: (stmt.for_var), len: (stmt.for_var_len) as i64 }, var_reg, elem_type, StrView { ptr: (elem_name), len: (elem_name_len) as i64 })
    else if elem_type == TypeKind.Bool
        add_local(s, StrView { ptr: (stmt.for_var), len: (stmt.for_var_len) as i64 }, var_reg, TypeKind.I64)
        let bool_loc: *LocalVar = local_at(s, s.local_count - 1)
        bool_loc.is_bool = 1
    else
        add_local(s, StrView { ptr: (stmt.for_var), len: (stmt.for_var_len) as i64 }, var_reg, elem_type)
    # ritz0 binds every element a `let` (#1755, AGAST #2389): a write would only
    # reach this copy of the element.  A range variable (emit_for) stays a `var`.
    let elem_loc: *LocalVar = local_at(s, s.local_count - 1)
    elem_loc.is_let = 1

    let cond_label: i32 = next_label(s)
    let body_label: i32 = next_label(s)
    let incr_label: i32 = next_label(s)
    let end_label: i32 = next_label(s)

    let old_break: i32 = s.break_label
    let old_continue: i32 = s.continue_label
    s.break_label = end_label
    s.continue_label = incr_label

    emit_str(s, IR_BR)
    emit_label(s, cond_label)
    emit_str(s, IR_NL)

    # cond: idx < len
    begin_block(s, cond_label)
    let idx_val: i32 = next_reg(s)
    emit_load_into(s, IR_TY_I64, idx_val, idx_reg)

    var len_val: i32 = 0
    if iter_kind == 1 or iter_kind == 3
        len_val = next_reg(s)
        emit_str(s, IR_INDENT)
        emit_reg(s, len_val)
        emit_str(s, c" = add i64 0, ")
        emit_int(s, arr_size as i64)
        emit_str(s, IR_NL)
    else if iter_kind == 2
        let len_ptr: i32 = next_reg(s)
        emit_str(s, IR_INDENT)
        emit_reg(s, len_ptr)
        emit_str(s, IR_GEP_NAMED)
        emit_name(s, StrView { ptr: (type_name), len: (type_name_len) as i64 })
        emit_str(s, IR_PTR_SEP)
        emit_reg(s, data_reg)
        emit_str(s, c", i32 0, i32 1\n")
        len_val = next_reg(s)
        emit_load_into(s, IR_TY_I64, len_val, len_ptr)

    let cmp_reg: i32 = next_reg(s)
    emit_str(s, IR_INDENT)
    emit_reg(s, cmp_reg)
    emit_str(s, c" = icmp ult i64 ")
    emit_reg(s, idx_val)
    emit_str(s, IR_COMMA)
    emit_reg(s, len_val)
    emit_str(s, IR_NL)
    emit_str(s, c"  br i1 ")
    emit_reg(s, cmp_reg)
    emit_str(s, IR_LABEL_SEP)
    emit_label(s, body_label)
    emit_str(s, IR_LABEL_SEP)
    emit_label(s, end_label)
    emit_str(s, IR_NL)

    # body: load current element, store into loop var, then recurse body.
    begin_block(s, body_label)

    let idx_val2: i32 = next_reg(s)
    emit_load_into(s, IR_TY_I64, idx_val2, idx_reg)

    let elem_ptr: i32 = next_reg(s)
    if iter_kind == 2
        # `data` is field 0 and `len` field 1, as for_header_struct checked.
        let data_ptr_ptr: i32 = next_reg(s)
        emit_str(s, IR_INDENT)
        emit_reg(s, data_ptr_ptr)
        emit_str(s, IR_GEP_NAMED)
        emit_name(s, StrView { ptr: (type_name), len: (type_name_len) as i64 })
        emit_str(s, IR_PTR_SEP)
        emit_reg(s, data_reg)
        emit_str(s, c", i32 0, i32 0\n")
        let data_ptr: i32 = next_reg(s)
        emit_str(s, IR_INDENT)
        emit_reg(s, data_ptr)
        emit_str(s, IR_LOAD_PTR)
        emit_reg(s, data_ptr_ptr)
        emit_str(s, c"\n  ")
        emit_reg(s, elem_ptr)
        emit_str(s, c" = getelementptr ")
        emit_for_elem_llvm(s, elem_type, StrView { ptr: (elem_name), len: (elem_name_len) as i64 })
        emit_str(s, IR_PTR_SEP)
        emit_reg(s, data_ptr)
        emit_str(s, IR_I64_SEP)
        emit_reg(s, idx_val2)
        emit_str(s, IR_NL)
    else
        emit_str(s, IR_INDENT)
        emit_reg(s, elem_ptr)
        emit_str(s, IR_GEP_ARRAY)
        emit_int(s, arr_size as i64)
        emit_str(s, IR_X)
        emit_for_slot_llvm(s, elem_type, StrView { ptr: (elem_name), len: (elem_name_len) as i64 }, row_size, plane)
        emit_str(s, IR_RBRACK_PTR)
        # A local array or a field is an SSA reg; a const or global
        # array is its symbol.
        if iter_kind == 3
            emit_str(s, c"@")
            emit_name(s, StrView { ptr: (const_name), len: (const_name_len) as i64 })
        else
            emit_reg(s, data_reg)
        emit_str(s, IR_I64_ZERO)
        emit_reg(s, idx_val2)
        emit_str(s, IR_NL)
    let elem_val: i32 = next_reg(s)
    emit_str(s, IR_INDENT)
    emit_reg(s, elem_val)
    emit_str(s, IR_LOAD)
    emit_for_slot_llvm(s, elem_type, StrView { ptr: (elem_name), len: (elem_name_len) as i64 }, row_size, plane)
    emit_str(s, IR_PTR_SEP)
    emit_reg(s, elem_ptr)
    emit_str(s, IR_NL)
    if bool_slot == 1
        let wide: i32 = next_reg(s)
        emit_str(s, IR_INDENT)
        emit_reg(s, wide)
        emit_str(s, c" = zext i1 ")
        emit_reg(s, elem_val)
        emit_str(s, c" to i64\n  store i64 ")
        emit_reg(s, wide)
    else
        emit_str(s, IR_STORE_IND)
        emit_for_slot_llvm(s, elem_type, StrView { ptr: (elem_name), len: (elem_name_len) as i64 }, row_size, plane)
        emit_str(s, IR_SP)
        emit_reg(s, elem_val)
    emit_str(s, IR_PTR_SEP)
    emit_reg(s, var_reg)
    emit_str(s, IR_NL)

    # Body statements.
    let own_loop: i32 = own_loop_enter(s)   # AGAST #2158
    own_push_scope(s)
    emit_void_body(s, stmt.for_body, ret_type)
    own_pop_scope(s)
    own_loop_exit(s, own_loop)

    emit_str(s, IR_BR)
    emit_label(s, incr_label)
    emit_str(s, IR_NL)

    # incr: idx = idx + 1
    begin_block(s, incr_label)
    let load2_reg: i32 = next_reg(s)
    emit_load_into(s, IR_TY_I64, load2_reg, idx_reg)
    let incr_val: i32 = next_reg(s)
    emit_str(s, IR_INDENT)
    emit_reg(s, incr_val)
    emit_str(s, c" = add i64 ")
    emit_reg(s, load2_reg)
    emit_str(s, IR_COMMA_1)
    emit_store_typed(s, IR_TY_I64, incr_val, idx_reg)
    emit_str(s, IR_BR)
    emit_label(s, cond_label)
    emit_str(s, IR_NL)

    # end
    begin_block(s, end_label)
    # AGAST #1329 — a loop contributes no value.  Without this, a trailing
    # expression in the body leaks its register into the exit block, where
    # the implicit return would use it without dominating it.
    clear_last_expr(s)

    s.break_label = old_break
    s.continue_label = old_continue

# AGAST #1332 — subscript STORE through a pointer base (`b[i] = v` where b
# is *T / **T).  The old StmtKind.IndexAssign pointer arm hardcoded
# `getelementptr i64` + `store i64` for every non-** pointer, so a *i32/*u8
# base was written with an 8-byte stride AND an 8-byte width (7/8–8/8
# corruption in 92_subscript_store), and a GLOBAL base emitted no store at
# all — the whole arm was guarded by `find_local() >= 0` with no else, so
# `g[i] = v` was silently dropped.  This is the store-side companion of
# #1325/#1328, which fixed only the loads.
#
# `base_ptr` must already be a `ptr`-typed register; `pointee` may be
# TypeKind.Unknown (unresolvable base), which falls back to the legacy i64
# stride/width.  Index and value are emitted here to preserve the historical
# evaluation order (index before value, both after the base load).
#
# AGAST #2277: `st_name` names the pointee struct of a `*C` base (len 0 when
# there's none); the struct arm below strides and stores by it.
fn emit_index_assign_ptr_store(s: *EmitterState, stmt: *Stmt, base_ptr: i32, base_type: TypeKind, pointee: TypeKind, st_name_sv: StrView)
    var st_name: *u8 = st_name_sv.ptr
    var st_name_len: i32 = st_name_sv.len as i32
    # AGAST #4450: a user enum pointee too (`p[i] = E.X`, `p: *E`).
    if base_type != TypeKind.PtrPtr and pointee == TypeKind.Struct and is_elem_aggregate_name(s, StrView { ptr: (st_name), len: (st_name_len) as i64 }) == 1
        emit_ptr_struct_elem_store(s, stmt.while_cond, stmt.assign_value, base_ptr, StrView { ptr: (st_name), len: (st_name_len) as i64 })
        return
    emit_ptr_elem_store(s, stmt.while_cond, stmt.assign_value, base_ptr, base_type, pointee)

# AGAST #2277: `p[i] = v` with `p: *C` GEPs and stores a whole `C`.  It fell
# to the i64 arm of emit_ptr_elem_store (`getelementptr i64` + `store i64` of
# a `%C` register), which clang refused.  The value is read as a by-value `C`
# slot (#2250): a `c:& C` param copies its referent, and a move-only one is
# refused as a move out of a reference.
fn emit_ptr_struct_elem_store(s: *EmitterState, idx_expr: *Expr, value: *Expr, base_ptr: i32, st_name_sv: StrView)
    var st_name: *u8 = st_name_sv.ptr
    var st_name_len: i32 = st_name_sv.len as i32
    let idx_reg: i32 = emit_expr(s, idx_expr)
    let val_reg: i32 = emit_expr_by_value(s, value, TypeKind.Struct, StrView { ptr: (st_name), len: (st_name_len) as i64 })
    let elem_ptr: i32 = next_reg(s)
    emit_str(s, IR_INDENT)
    emit_reg(s, elem_ptr)
    emit_str(s, c" = getelementptr ")
    emit_llvm_type_struct(s, TypeKind.Struct, StrView { ptr: (st_name), len: (st_name_len) as i64 })
    emit_str(s, IR_PTR_SEP)
    emit_reg(s, base_ptr)
    emit_str(s, IR_I64_SEP)
    emit_reg(s, idx_reg)
    emit_str(s, IR_NL)
    emit_struct_store_or_copy(s, TypeKind.Struct, StrView { ptr: (st_name), len: (st_name_len) as i64 }, val_reg, elem_ptr)

# AGAST #3442: `f()[i] = v` where `f` returns a `*T` (ptr_root_pointee: a
# scalar T, or a struct named by the return type) or a `**T`.  Emits the call, then
# emit_ptr_*_elem_store's index and value, and returns 1; 0 (nothing
# emitted) for any other target.
#
# AGAST #3528: and `b.get()[i] = v`, a method returning `*T` / `**T`.  It fell
# to the same generic path and SIGSEGV'd.
fn emit_call_base_index_store(s: *EmitterState, target: *Expr, value: *Expr) -> i32
    if target.kind != ExprKind.Index or target.left == null
        return 0
    if target.left.kind != ExprKind.Call and target.left.kind != ExprKind.Method
        return 0
    if target.right == null or target.right.kind == ExprKind.Range
        return 0
    let fd: *FnDef = call_fn_def(s, target.left)
    var st_name: *u8 = null
    var st_len: i32 = 0
    let pointee: TypeKind = fn_ptr_return_pointee(s, fd, @st_name, @st_len)
    var base_type: TypeKind = TypeKind.Ptr
    if pointee == TypeKind.Void
        # A `**T` return: the element is a pointer.
        if fd == null or fd.return_type != TypeKind.PtrPtr
            return 0
        base_type = TypeKind.PtrPtr
    if pointee == TypeKind.Struct and is_elem_aggregate_name(s, StrView { ptr: (st_name), len: (st_len) as i64 }) == 0
        return 0   # AGAST #4450: a user enum pointee is stored whole too
    let bptr: i32 = emit_index_base_ptr(s, target.left)
    if pointee == TypeKind.Struct
        emit_ptr_struct_elem_store(s, target.right, value, bptr, StrView { ptr: (st_name), len: (st_len) as i64 })
    else
        emit_ptr_elem_store(s, target.right, value, bptr, base_type, pointee)
    return 1

# AGAST #3565: `(e as *T)[i] = v`, `(q + k)[i] = v` and `(p)[i] = v` store
# through the `*T` / `**T` the base names, as `p[i] = v` does.  They fell to
# emit_assign's generic path, which read `x[i]` as a VALUE and stored through
# it: a SIGSEGV.  Base, index, then value (LARB R61).  Returns 1 when it
# emitted the store, 0 (nothing emitted) for any other target.  Sema
# (index_store_check) has refused a scalar base, or a pointer or reference
# to a scalar, that this doesn't type.
fn emit_ptr_base_index_store(s: *EmitterState, target: *Expr, value: *Expr) -> i32
    if target.kind != ExprKind.Index or target.left == null
        return 0
    if target.right == null or target.right.kind == ExprKind.Range
        return 0
    let k: ExprKind = target.left.kind
    if k != ExprKind.Cast and k != ExprKind.Binary and k != ExprKind.Ident
        return 0
    var st_name: *u8 = null
    var st_len: i32 = 0
    var pp: i32 = 0
    let pointee: TypeKind = index_store_base_pointee(s, target.left, @st_name, @st_len, @pp)
    if pointee == TypeKind.Void
        return 0
    let bptr: i32 = emit_index_base_ptr(s, target.left)
    if pp == 1
        emit_ptr_elem_store(s, target.right, value, bptr, TypeKind.PtrPtr, TypeKind.Ptr)
    else if pointee == TypeKind.Struct
        emit_ptr_struct_elem_store(s, target.right, value, bptr, StrView { ptr: (st_name), len: (st_len) as i64 })
    else
        emit_ptr_elem_store(s, target.right, value, bptr, TypeKind.Ptr, pointee)
    return 1

# The body of emit_index_assign_ptr_store, for any index / value pair.  AGAST
# #2545: `(*r)[i] = v` (an expression-target assign) stores through it too.
fn emit_ptr_elem_store(s: *EmitterState, idx_expr: *Expr, value: *Expr, base_ptr: i32, base_type: TypeKind, pointee: TypeKind)
    let idx_reg: i32 = emit_expr(s, idx_expr)
    let val_reg: i32 = emit_expr(s, value)
    let elem_ptr: i32 = next_reg(s)
    if base_type == TypeKind.PtrPtr
        # Pointer-to-pointer: element is a pointer.
        emit_str(s, IR_INDENT)
        emit_reg(s, elem_ptr)
        emit_str(s, c" = getelementptr ptr, ptr ")
        emit_reg(s, base_ptr)
        emit_str(s, IR_I64_SEP)
        emit_reg(s, idx_reg)
        emit_str(s, IR_NL)
        var ptr_val: i32 = val_reg   # AGAST #3185: `q[i] = @&x`: a `ptr` already
        if expr_is_ptr_valued(s, value) == 0
            ptr_val = next_reg(s)
            emit_str(s, IR_INDENT)
            emit_reg(s, ptr_val)
            emit_str(s, IR_INTTOPTR)
            emit_reg(s, val_reg)
            emit_str(s, c" to ptr\n")
        emit_store_typed(s, IR_TY_PTR, ptr_val, elem_ptr)
        return
    if base_type != TypeKind.PtrPtr and array_elem_typed_scalar(pointee) == 1
        # AGAST #1973: `p[i] = v` through a *f32 / *f64 GEPs and stores a
        # `float` / `double` (an f64 value into an f32 slot is fptrunc'd),
        # as a local float array element does (#1966).  It fell to the
        # i64 arm below: `getelementptr i64` + `store i64 %float`.  A
        # *bool strides and stores one `i1`, as every bool array element
        # is laid out (#2063); it stored an i64 8 bytes apart.
        let fty: *u8 = elem_mem_llvm(pointee)
        let fval: i32 = emit_field_elem_narrow(s, val_reg, pointee, value)
        emit_str(s, IR_INDENT)
        emit_reg(s, elem_ptr)
        emit_str(s, c" = getelementptr ")
        emit_str(s, fty)
        emit_str(s, IR_PTR_SEP)
        emit_reg(s, base_ptr)
        emit_str(s, IR_I64_SEP)
        emit_reg(s, idx_reg)
        emit_str(s, IR_NL)
        emit_str(s, IR_STORE_IND)
        emit_str(s, fty)
        emit_str(s, IR_SP)
        emit_reg(s, fval)
        emit_str(s, IR_PTR_SEP)
        emit_reg(s, elem_ptr)
        emit_str(s, IR_NL)
        return
    # Element type from the pointee kind; unknown/i64/u64 → i64.
    var elem_ty: *u8 = c"i64"
    var narrow: i32 = 0
    if ty_int_bits(pointee) == 8
        elem_ty = c"i8"
        narrow = 1
    else if ty_int_bits(pointee) == 16
        elem_ty = c"i16"
        narrow = 1
    else if ty_int_bits(pointee) == 32
        elem_ty = c"i32"
        narrow = 1
    emit_str(s, IR_INDENT)
    emit_reg(s, elem_ptr)
    emit_str(s, c" = getelementptr ")
    emit_str(s, elem_ty)
    emit_str(s, IR_PTR_SEP)
    emit_reg(s, base_ptr)
    emit_str(s, IR_I64_SEP)
    emit_reg(s, idx_reg)
    emit_str(s, IR_NL)
    if narrow == 1
        let trunc: i32 = next_reg(s)
        emit_str(s, IR_INDENT)
        emit_reg(s, trunc)
        emit_str(s, IR_TRUNC)
        emit_reg(s, val_reg)
        emit_str(s, IR_TO_SP)
        emit_str(s, elem_ty)
        emit_str(s, IR_NL)
        emit_str(s, IR_STORE_IND)
        emit_str(s, elem_ty)
        emit_str(s, IR_SP)
        emit_reg(s, trunc)
        emit_str(s, IR_PTR_SEP)
        emit_reg(s, elem_ptr)
        emit_str(s, IR_NL)
    else
        emit_store_typed(s, IR_TY_I64, val_reg, elem_ptr)

# Emit the LLVM type `[N x T]` of inline array field `field`.
fn emit_array_field_llvm_type(s: *EmitterState, field: *StructField)
    emit_str(s, c"[")
    emit_int(s, field.array_size as i64)
    emit_str(s, IR_X)
    if field.array_elem_type == TypeKind.Struct and field.array_elem_type_name_len > 0
        emit_str(s, IR_PCT)
        emit_name(s, StrView { ptr: (field.array_elem_type_name), len: (field.array_elem_type_name_len) as i64 })
    else
        emit_str(s, elem_mem_llvm(field.array_elem_type))
    emit_str(s, c"]")

# Copy `[N x T]` (spelled for `field`) from `src_ptr` over `dst_ptr` as one
# aggregate load + store: every element is read before any is written.
# AGAST #1748: an array of SRET_MIN_BYTES or more is copied pointer-to-
# pointer, as emit_local_array_copy does (#2306): clang -O2 splits a large
# first-class `[N x T]` load/store into one scalar per element. The two
# arrays are distinct or the same, never partially overlapping.
fn emit_array_field_copy(s: *EmitterState, field: *StructField, src_ptr: i32, dst_ptr: i32)
    var align: i64 = 8
    if elem_size_align(s, field.array_elem_type, StrView { ptr: (field.array_elem_type_name), len: (field.array_elem_type_name_len) as i64 }, @align) * (field.array_size as i64) >= SRET_MIN_BYTES
        emit_str(s, c"  call void @__ritz_sret_copy(ptr ")
        emit_reg(s, dst_ptr)
        emit_str(s, IR_PTR_SEP)
        emit_reg(s, src_ptr)
        emit_str(s, c", i64 ptrtoint (ptr getelementptr (")
        emit_array_field_llvm_type(s, field)
        emit_str(s, c", ptr null, i32 1) to i64))\n")
        s.sret_helpers_used = 1
        return
    let agg: i32 = next_reg(s)
    emit_str(s, IR_INDENT)
    emit_reg(s, agg)
    emit_str(s, IR_LOAD)
    emit_array_field_llvm_type(s, field)
    emit_str(s, IR_PTR_SEP)
    emit_reg(s, src_ptr)
    emit_str(s, c"\n  store ")
    emit_array_field_llvm_type(s, field)
    emit_str(s, IR_SP)
    emit_reg(s, agg)
    emit_str(s, IR_PTR_SEP)
    emit_reg(s, dst_ptr)
    emit_str(s, IR_NL)

# AGAST #2343: an array store takes the same element type, by kind: `[N]u32` is
# not `[N]i32`.  ref_into has said so already for whatever it can name.
pub fn array_store_fits(s: *EmitterState, value: *Expr, a: TypeKind, a_name_sv: StrView, b: TypeKind, b_name_sv: StrView) -> i32
    var a_name: *u8 = a_name_sv.ptr
    var a_len: i32 = a_name_sv.len as i32
    var b_name: *u8 = b_name_sv.ptr
    var b_len: i32 = b_name_sv.len as i32
    if a == b and array_elem_types_match(a, StrView { ptr: (a_name), len: (a_len) as i64 }, b, StrView { ptr: (b_name), len: (b_len) as i64 }) == 1
        return 1
    ref_array_error(s, value)
    0

# AGAST #2287: the shape of a whole array an expression reads.
struct ArraySrc
    size: i32
    elem: TypeKind
    name: *u8
    name_len: i32

pub fn array_src_set(out: *ArraySrc, size: i32, elem: TypeKind, name_sv: StrView) -> i32
    var name: *u8 = name_sv.ptr
    var name_len: i32 = name_sv.len as i32
    out.size = size
    out.elem = elem
    out.name = name
    out.name_len = name_len
    1

# The `p: *[N]T` / `@[N]T` / `@&[N]T` local `e` names, or null.  `a:& [N]T` counts:
# as in ritz0, `*a` reads the array.
pub fn array_ptr_local(s: *EmitterState, e: *Expr) -> *LocalVar
    if e == null or e.kind != ExprKind.Ident
        return null
    let loc: *LocalVar = find_local_struct_name(s, StrView { ptr: (e.ident_ptr), len: (e.ident_len) as i64 })
    if loc == null or lv_pointee_type(loc) != TypeKind.Array or lv_pointee_array_size(loc) <= 0
        return null
    if lent_array_ident(s, e) != null
        return loc
    return array_ptr_index_base(s, e)

# The address of the array behind array_ptr_local's `loc`.
fn emit_array_ptr_base(s: *EmitterState, loc: *LocalVar) -> i32
    if lv_var_type(loc) == TypeKind.Array
        return loc.reg
    return emit_load_ptr(s, loc.reg)

# AGAST #2304: fill `out` with N and T when `*e` is a whole `[N]T` place: `e` an
# array_ptr_local, a `*[N]T` field or global that records them (base_ptr_array),
# or `x + k` / `x - k` over a `*[N]T` one, which steps whole rows (#2330).  N
# and T are the pointer's own, never the value's: with no N there is no
# length to check a store against.  Emits nothing.
pub fn array_ptr_shape(s: *EmitterState, e: *Expr, out: *ArraySrc) -> i32
    if e == null
        return 0
    let loc: *LocalVar = array_ptr_local(s, e)
    if loc != null
        var en_len: i32 = 0
        let en: *u8 = array_ptr_elem_name(loc, @en_len)   # #2548
        return array_src_set(out, lv_pointee_array_size(loc), lv_pointee_array_elem_type(loc), StrView { ptr: (en), len: (en_len) as i64 })
    if e.kind == ExprKind.Binary
        if e.op != OpKind.Add and e.op != OpKind.Sub
            return 0
        if array_ptr_steps(s, e.left) == 0 or is_ptr_distance(s, e) == 1
            return 0
        return array_ptr_shape(s, e.left, out)
    let pa: *Param = base_ptr_array(s, e)
    if pa == null
        return 0
    array_src_set(out, pa.param_pointee_array_size, pa.param_pointee_array_elem_type, StrView { ptr: (pa.param_type_name), len: (pa.param_type_name_len) as i64 })

# AGAST #2098: the `[N][M]..T` that `*e` is, the whole array behind a
# `*[N][M]..T` (a plane pointer, or a step `p + k` over one); null otherwise.
fn deref_nd_shape(s: *EmitterState, e: *Expr) -> *ArrayShape
    var b: *Expr = e
    while b != null and b.kind == ExprKind.Binary and (b.op == OpKind.Add or b.op == OpKind.Sub)
        b = b.left
    plane_ptr_shape(s, b)

# 1 when `*e` is a whole `[N]T` (array_ptr_shape), which isn't a value on its own.
pub fn deref_names_array(s: *EmitterState, e: *Expr) -> i32
    var sh: ArraySrc
    array_ptr_shape(s, e, @sh)

# 1 when `x + k` on `e` steps rows of a `*[N]T`: `e` is a `*[N]T` local or param,
# field or global, or such a step itself.  `@[N]T` and `a:& [N]T` aren't.
fn array_ptr_steps(s: *EmitterState, e: *Expr) -> i32
    if e.kind == ExprKind.Binary
        if (e.op == OpKind.Add or e.op == OpKind.Sub) and is_ptr_distance(s, e) == 0
            return array_ptr_steps(s, e.left)
        return 0
    let loc: *LocalVar = array_ptr_local(s, e)
    if loc != null
        if lv_var_type(loc) == TypeKind.Ptr
            return 1
        return 0
    if base_ptr_array_row_size(s, e) > 0
        return 1
    0

# The address of the array array_ptr_shape recognised behind `e`.
pub fn emit_array_ptr_value(s: *EmitterState, e: *Expr) -> i32
    let loc: *LocalVar = array_ptr_local(s, e)
    if loc != null
        return emit_array_ptr_base(s, loc)
    let val: i32 = emit_expr(s, e)
    let ptr: i32 = ir_inttoptr_ptr(s.out, @s.reg_counter, val)
    ptr

# Fill `out` when `value` reads a whole 1-D array out of a place that needs no
# code to find: a local or by-value param, `a:& [N]T`, a global, `*p`.  Returns
# 0 for anything else.  Emits nothing, so a check can ask before emitting.
pub fn array_place_shape(s: *EmitterState, value: *Expr, out: *ArraySrc) -> i32
    if value.kind == ExprKind.Ident
        let loc: *LocalVar = find_local_struct_name(s, StrView { ptr: (value.ident_ptr), len: (value.ident_len) as i64 })
        if loc != null
            if lv_var_type(loc) == TypeKind.Array and lv_array_shape(loc) == null
                return array_src_set(out, lv_array_size(loc), lv_array_elem_type(loc), StrView { ptr: (lv_type_name(loc)), len: (lv_type_name_len(loc)) as i64 })
            return 0
        let g: *GlobalVarDef = find_global(s, StrView { ptr: (value.ident_ptr), len: (value.ident_len) as i64 })
        if g != null and g.var_type == TypeKind.Array and g.array_shape == null
            return array_src_set(out, g.array_size, g.array_elem_type, StrView { ptr: (g.array_elem_type_name), len: (g.array_elem_type_name_len) as i64 })
        return 0
    if value.kind == ExprKind.Unary and value.op == OpKind.Deref
        # AGAST #2305: `*@a` / `*@&a` reads the array `a` is, as ritz0 has it.
        let inner: *Expr = addr_of_array_place(s, value.operand)
        if inner != null
            return array_place_shape(s, inner, out)
        return array_ptr_shape(s, value.operand, out)   # AGAST #2304
    0

# AGAST #2305: `x` when `e` is `@x` or `@&x` over a whole 1-D array place, so
# `*e` is that place; null otherwise.  Emits nothing.
fn addr_of_array_place(s: *EmitterState, e: *Expr) -> *Expr
    if e == null or e.kind != ExprKind.Unary or (e.op != OpKind.Addr and e.op != OpKind.AddrMut)
        return null
    let x: *Expr = e.operand
    if x == null or (x.kind != ExprKind.Ident and x.kind != ExprKind.Unary)
        return null
    var sh: ArraySrc
    if array_place_shape(s, x, @sh) == 0
        return null
    x

# AGAST #2517: fill `out` when `value` is a 1-D row of an N-D array (nd_row_shape:
# `g[i]` of `[N][M]T`, `c[i][j]` of `[N][M][K]T`).  The base is any
# nd_index_shape knows: a local, a global, a field, or a field of a call's
# result, by value or through `*S`.  Emits nothing; emit_nd_index_ptr finds it.
fn nd_row_src(s: *EmitterState, value: *Expr, out: *ArraySrc) -> i32
    if value.kind != ExprKind.Index or value.right == null or value.right.kind == ExprKind.Range
        return 0
    let sh: *ArrayShape = nd_row_shape(s, value)
    if sh == null
        return 0
    array_src_set(out, sh.dims[sh.rank - 1], sh.leaf_type, StrView { ptr: (sh.leaf_name), len: (sh.leaf_name_len) as i64 })

# The global `[N]T` that `e` names, or null.
fn global_array_named(s: *EmitterState, e: *Expr) -> *GlobalVarDef
    let g: *GlobalVarDef = find_global(s, StrView { ptr: (e.ident_ptr), len: (e.ident_len) as i64 })
    if g == null or g.var_type != TypeKind.Array
        return null
    return g

# AGAST #3275: the module-level global `e` names when it is a named aggregate
# (`var G: S`, a struct or an enum, `Option<T>` included), or null.
fn global_struct_named(s: *EmitterState, e: *Expr) -> *GlobalVarDef
    let g: *GlobalVarDef = find_global(s, StrView { ptr: (e.ident_ptr), len: (e.ident_len) as i64 })
    if g == null or g.var_type != TypeKind.Struct or g.type_name_len <= 0
        return null
    return g

# LARB R60 / R48: the module struct const `e` names when it is read-only data
# (`const C: S = S {...}`), or null.  A bare `C` is its `@S` value (the
# emitter loads `%S` from `@C`), so `let q = C` copies it as `let q: S = C`
# does.  A local or global of the name wins, as everywhere else.
fn const_struct_named(s: *EmitterState, e: *Expr) -> *ConstEntry
    if e == null or e.kind != ExprKind.Ident
        return null
    if find_local_struct_name(s, StrView { ptr: (e.ident_ptr), len: (e.ident_len) as i64 }) != null
        return null
    if find_global(s, StrView { ptr: (e.ident_ptr), len: (e.ident_len) as i64 }) != null
        return null
    let ce: *ConstEntry = find_const_entry(s, StrView { ptr: (e.ident_ptr), len: (e.ident_len) as i64 })
    if ce == null or ce.const_type != TypeKind.Struct or ce.type_name_len <= 0 or ce.value_expr == null
        return null
    return ce

# The address of global array `g`, in a register.
fn emit_global_array_ptr(s: *EmitterState, g: *GlobalVarDef) -> i32
    let ptr: i32 = next_reg(s)
    emit_str(s, IR_INDENT)
    emit_reg(s, ptr)
    emit_str(s, c" = getelementptr i8, ptr @")
    emit_name(s, StrView { ptr: (g.name), len: (g.name_len) as i64 })
    emit_str(s, c", i64 0\n")
    return ptr

# The address of the place array_place_shape recognised in `value`.
pub fn emit_array_place_ptr(s: *EmitterState, value: *Expr) -> i32
    if value.kind == ExprKind.Unary
        let inner: *Expr = addr_of_array_place(s, value.operand)
        if inner != null
            return emit_array_place_ptr(s, inner)   # AGAST #2305: `*@a`
        lent_array_local(s, value.operand)
        return emit_array_ptr_value(s, value.operand)   # AGAST #2304
    let lent: *LocalVar = lent_array_local(s, value)
    if lent != null
        return lent.reg
    let loc: *LocalVar = find_local_struct_name(s, StrView { ptr: (value.ident_ptr), len: (value.ident_len) as i64 })
    if loc != null
        return loc.reg
    return emit_global_array_ptr(s, find_global(s, StrView { ptr: (value.ident_ptr), len: (value.ident_len) as i64 }))

# AGAST #2302: store the `[N x T]` that call `value` returns (`ra` is its
# return as a param) at `dst_ptr`.  AGAST #3181: a large one's call value is
# the sret slot it wrote (emit_sret_array_call_slot), copied pointer-to-pointer.
fn emit_call_array_store(s: *EmitterState, value: *Expr, ra: *Param, dst_ptr: i32)
    let cv: i32 = emit_expr(s, value)
    if array_param_uses_byval(s, ra) == 1 and ra.param_array_shape != null
        emit_nd_plane_copy(s, ra.param_array_shape, 0, dst_ptr, cv)   # AGAST #3634
        return
    if array_param_uses_byval(s, ra) == 1
        emit_local_array_copy(s, ra.param_array_size, ra.param_array_elem_type, StrView { ptr: (ra.param_type_name), len: (ra.param_type_name_len) as i64 }, cv, dst_ptr)
        return
    emit_str(s, IR_STORE_IND)
    emit_array_value_llvm_type(s, ra)
    emit_str(s, IR_SP)
    emit_reg(s, cv)
    emit_str(s, IR_PTR_SEP)
    emit_reg(s, dst_ptr)
    emit_str(s, IR_NL)

# AGAST #2302: the `[N x T]` call `value` returns, in a fresh temporary whose
# address is returned.  AGAST #3258: a result the move check made a temporary
# (T needing a drop) is already in the slot own_note_temp queued its drop on,
# and that slot is the one read, as a struct temporary's (own_temp_slot_of).
pub fn emit_call_array_temp(s: *EmitterState, value: *Expr, ra: *Param) -> i32
    if own_temp_marked(s, value) == 1
        # 0 only when the call itself failed to emit, already an error.
        return own_temp_slot_of(s, emit_expr(s, value))
    let tmp: i32 = next_reg(s)
    entry_alloca_reg_begin(s, tmp)
    emit_array_value_llvm_type(s, ra)
    emit_str(s, c"  ; #2302 call result\n")
    entry_alloca_reg_end(s)
    emit_call_array_store(s, value, ra, tmp)
    tmp

# AGAST #1935: `x.f = <array value>` where the right-hand side is not a
# literal.  Resolve the source array's storage and copy it over the field
# at `field_ptr`, after checking it has the field's length and element type
# (ritz0 rejects a mismatch).  Supported sources:
#   * a local `[N]T` array or by-value param (`w.vals = a`); its alloca is
#     `[N x T]` with the field's element spelling for every T (f32 / f64 since
#     #1966 / #1971, bool `i1` since #2063);
#   * a global `[N]T` array (#2287);
#   * another inline array field (`y.vals = x.vals`, `p.b = p.a`), whose
#     layout is the field's own;
#   * `*src` for a param or annotated local `src: *[N]T` (AGAST #1953), whose
#     N and T are recorded on the LocalVar (pointee_array_*).  A local,
#     field or global pointee shares the field's element layout (#1971,
#     #2063), so every element type copies.
# Returns 1 once handled (copied or diagnosed).  Anything else fails
# closed: emit_expr has no whole-array value, and the pre-#1934 generic
# path stored an ADDRESS into the field.
fn emit_array_field_copy_from(s: *EmitterState, field_ptr: i32, field: *StructField, value: *Expr)
    var src_ptr: i32 = -1
    var src_size: i32 = -1
    var src_et: TypeKind = TypeKind.Void
    var src_name: *u8 = null
    var src_name_len: i32 = 0
    var place: ArraySrc
    if array_place_shape(s, value, @place) == 1
        src_ptr = emit_array_place_ptr(s, value)
        src_size = place.size
        src_et = place.elem
        src_name = place.name
        src_name_len = place.name_len
    else if value.kind == ExprKind.Member
        var mr: MemberPtrResult
        emit_member_ptr(s, value, @mr)
        if mr.success == 1 and mr.field != null and mr.field.field_type == TypeKind.Array
            src_ptr = mr.reg
            src_size = mr.field.array_size
            src_et = mr.field.array_elem_type
            src_name = mr.field.array_elem_type_name
            src_name_len = mr.field.array_elem_type_name_len
    else if call_ret_array(s, value) != null
        # AGAST #2302: a call's `[N x T]`, through a temporary.
        let cra: *Param = call_ret_array(s, value)
        src_ptr = emit_call_array_temp(s, value, cra)
        src_size = cra.param_array_size
        src_et = cra.param_array_elem_type
        src_name = cra.param_type_name
        src_name_len = cra.param_type_name_len
    if src_ptr < 0
        emit_ir_error(s, value.span, c"whole-array assignment to a struct field from this value is not supported by ritz1 (only array literals, local arrays, array fields and `*p` for `p: *[N]T`)")
        return
    if src_size != field.array_size
        emit_ir_error(s, value.span, c"array length does not match the struct field's array length")
        return
    if array_store_fits(s, value, src_et, StrView { ptr: (src_name), len: (src_name_len) as i64 }, field.array_elem_type, StrView { ptr: (field.array_elem_type_name), len: (field.array_elem_type_name_len) as i64 }) == 0
        return
    emit_array_field_copy(s, field, src_ptr, field_ptr)

# AGAST #2035: the reverse of emit_array_field_copy_from.  A local `[N]T`
# array at `dst_ptr` (length `dst_size`, element `dst_et`, element struct name
# `dst_name`) is initialised or assigned from `value`, `let a: [N]T = x.f` /
# `a = p.f`.  When `value` is a member expression, copy the inline array field
# it names into the local, after checking that the length and element type
# match.  A local array uses the field's element spelling for every T
# (local_array_elem_llvm, f32 / f64 since #1966, bool since #2063), so the
# field's `[N x T]` copies as one aggregate.  The generic path loaded
# the field as `[N x T]` and emitted `store i64 <[N x T]>`, which clang rejects.
# Returns 1 once handled (copied or diagnosed) and 0 for a non-member value,
# which is left to the caller.  A member that is not a matching array field
# fails closed.
fn emit_array_local_copy_from_field(s: *EmitterState, dst_ptr: i32, dst_size: i32, dst_et: TypeKind, dst_name_sv: StrView, value: *Expr) -> i32
    var dst_name: *u8 = dst_name_sv.ptr
    var dst_name_len: i32 = dst_name_sv.len as i32
    if value == null or value.kind != ExprKind.Member
        return 0
    var mr: MemberPtrResult
    emit_member_ptr(s, value, @mr)
    if mr.success != 1 or mr.field == null or mr.field.field_type != TypeKind.Array
        emit_ir_error(s, value.span, c"whole-array read into a local array from this member is not supported by ritz1 (only an inline array field)")
        return 1
    let field: *StructField = mr.field
    if field.array_size != dst_size
        emit_ir_error(s, value.span, c"struct field's array length does not match the local array's length")
        return 1
    if array_store_fits(s, value, field.array_elem_type, StrView { ptr: (field.array_elem_type_name), len: (field.array_elem_type_name_len) as i64 }, dst_et, StrView { ptr: (dst_name), len: (dst_name_len) as i64 }) == 0
        return 1
    emit_array_field_copy(s, field, mr.reg, dst_ptr)
    1

# 1 when two N-D shapes are the same type: rank, every dim and the leaf.
fn array_shapes_match(a: *ArrayShape, b: *ArrayShape) -> i32
    if a.rank != b.rank or a.leaf_pointee != b.leaf_pointee
        return 0
    var d: i32 = 0
    while d < a.rank
        if a.dims[d] != b.dims[d]
            return 0
        d = d + 1
    array_elem_types_match(a.leaf_type, StrView { ptr: (a.leaf_name), len: (a.leaf_name_len) as i64 }, b.leaf_type, StrView { ptr: (b.leaf_name), len: (b.leaf_name_len) as i64 })

# AGAST #3299: initialise the N-D slot at `dst_ptr` (shape `sh`) from `value`
# when it is a whole N-D place: a field (`h.m`, `p.m` through `p: *H`, a
# chain), or a local or global `[N][M]..T` (#2169's `var b = a`).  Copied as
# one aggregate, or pointer-to-pointer when large (as emit_local_array_copy),
# so the slot is a copy, never a view.  Returns 1 once handled (copied, or a
# shape mismatch diagnosed) and 0, having emitted nothing, for any other value.
# AGAST #3350: or a plane of a deeper one (`g[1]` of `[2][2][3]T`, any base
# emit_nd_index_ptr takes), copied from the address that GEP gives.
fn emit_nd_array_init_copy(s: *EmitterState, dst_ptr: i32, sh: *ArrayShape, value: *Expr) -> i32
    # AGAST #3634: a call's `-> [N][M]T`, stored straight into the slot.
    let cra: *Param = call_ret_array(s, value)
    if cra != null and cra.param_array_shape != null
        if array_shapes_match(cra.param_array_shape, sh) == 0
            emit_ir_error(s, value.span, c"multi-dimensional array initializer's shape does not match the local array's")
            return 1
        emit_call_array_store(s, value, cra, dst_ptr)
        return 1
    # AGAST #3635: `*p`, the whole array behind a `*[N][M]..T` (deref_nd_shape).
    var dsh: *ArrayShape = null
    if value.kind == ExprKind.Unary and value.op == OpKind.Deref and value.operand != null
        dsh = deref_nd_shape(s, value.operand)
    if dsh != null
        if array_shapes_match(dsh, sh) == 0
            emit_ir_error(s, value.span, c"multi-dimensional array initializer's shape does not match the local array's")
            return 1
        var from: i32 = 0
        if plane_ptr_shape(s, value.operand) != null
            from = emit_plane_ptr(s, value.operand)
        else
            from = emit_array_ptr_value(s, value.operand)   # `*(p + k)`
        emit_nd_plane_copy(s, sh, 0, dst_ptr, from)
        return 1
    var src_sh: *ArrayShape = nd_array_base_shape(s, value)
    if src_sh == null
        src_sh = nd_plane_shape(s, value)
    if src_sh == null
        return 0
    if array_shapes_match(src_sh, sh) == 0
        emit_ir_error(s, value.span, c"multi-dimensional array initializer's shape does not match the local array's")
        return 1
    var src_ptr: i32 = -1
    match value.kind
        ExprKind.Index =>
            var pp: NdIndexPtr
            emit_nd_index_ptr(s, value, @pp)
            src_ptr = pp.reg
        ExprKind.Member =>
            var mr: MemberPtrResult
            emit_member_ptr(s, value, @mr)
            if mr.success != 1
                emit_ir_error(s, value.span, c"whole-array read into a local array from this member is not supported by ritz1 (only an inline array field)")
                return 1
            src_ptr = mr.reg
        _ =>
            let loc: *LocalVar = find_local_struct_name(s, StrView { ptr: (value.ident_ptr), len: (value.ident_len) as i64 })
            if loc != null
                src_ptr = loc.reg
            else
                src_ptr = emit_global_array_ptr(s, find_global(s, StrView { ptr: (value.ident_ptr), len: (value.ident_len) as i64 }))
    emit_nd_plane_copy(s, sh, 0, dst_ptr, src_ptr)
    1

# AGAST #3634: `g = v` with `g` a whole N-D local, global or `:&` param of shape
# `sh`: `v`'s array copied over it, as emit_nd_array_init_copy initialises a
# slot (a `:&` param's local is the caller's array).  0, having emitted
# nothing, when `v` is no N-D value; a move-only leaf isn't copied either
# (the old elements would never drop, and `v`'s would drop twice).
fn emit_nd_whole_assign(s: *EmitterState, stmt: *Stmt, sh: *ArrayShape) -> i32
    if sh.leaf_type == TypeKind.Struct and sh.leaf_name_len > 0 and own_type_is_move_only(s, StrView { ptr: (sh.leaf_name), len: (sh.leaf_name_len) as i64 }) == 1
        return 0
    let v: *Expr = stmt.assign_value
    let cra: *Param = call_ret_array(s, v)
    if (cra == null or cra.param_array_shape == null) and nd_array_base_shape(s, v) == null and nd_plane_shape(s, v) == null
        # AGAST #3635: or `*p`, the whole array behind a `*[N][M]..T`.
        if v.kind != ExprKind.Unary or v.op != OpKind.Deref or v.operand == null or deref_nd_shape(s, v.operand) == null
            return 0
    var dst: i32 = 0
    let loc: *LocalVar = find_local_struct_name(s, StrView { ptr: (stmt.assign_target), len: (stmt.assign_target_len) as i64 })
    if loc != null
        dst = loc.reg
    else
        dst = emit_global_array_ptr(s, find_global(s, StrView { ptr: (stmt.assign_target), len: (stmt.assign_target_len) as i64 }))
    emit_nd_array_init_copy(s, dst, sh, v)

# AGAST #3634: the whole `[N][M]..T` value `value` (an N-D place or a call
# returning one, emit_nd_array_init_copy) copied into the fresh slot `dst_ptr`
# of shape `sh`, for a by-value param or a return.  AGAST #4178: or a nested
# literal or fill (`sz<[2][2]i64>([ [1, 2], [3, 4] ])`), written straight into
# the slot as a local's initialiser is (emit_nd_array_init_into checks every
# dimension's count).  Anything else is no value of that type: a located error.
pub fn emit_nd_array_value_into(s: *EmitterState, dst_ptr: i32, sh: *ArrayShape, value: *Expr)
    if emit_nd_array_init_copy(s, dst_ptr, sh, value) == 1
        return
    if value.kind == ExprKind.ArrayLit or value.kind == ExprKind.ArrayFill
        emit_nd_array_init_into(s, sh, 0, dst_ptr, value)
        return
    emit_nd_error(s, value.span.line, value.span.col, c"this value is not a multi-dimensional array of that shape")

# Copy the dimension-`from` plane of `sh` (the whole array at 0) from
# `src_ptr` over `dst_ptr`: one aggregate load + store, or pointer-to-pointer
# when large (as emit_local_array_copy).
fn emit_nd_plane_copy(s: *EmitterState, sh: *ArrayShape, from: i32, dst_ptr: i32, src_ptr: i32)
    var leaves: i64 = 1
    var d: i32 = from
    while d < sh.rank
        leaves = leaves * (sh.dims[d] as i64)
        d = d + 1
    var align: i64 = 8
    if elem_size_align(s, sh.leaf_type, StrView { ptr: (sh.leaf_name), len: (sh.leaf_name_len) as i64 }, @align) * leaves >= SRET_MIN_BYTES
        emit_str(s, c"  call void @__ritz_sret_copy(ptr ")
        emit_reg(s, dst_ptr)
        emit_str(s, IR_PTR_SEP)
        emit_reg(s, src_ptr)
        emit_str(s, c", i64 ptrtoint (ptr getelementptr (")
        emit_array_shape_llvm(s, sh, from)
        emit_str(s, c", ptr null, i32 1) to i64))\n")
        s.sret_helpers_used = 1
        return
    let agg: i32 = next_reg(s)
    emit_str(s, IR_INDENT)
    emit_reg(s, agg)
    emit_str(s, IR_LOAD)
    emit_array_shape_llvm(s, sh, from)
    emit_str(s, IR_PTR_SEP)
    emit_reg(s, src_ptr)
    emit_str(s, c"\n  store ")
    emit_array_shape_llvm(s, sh, from)
    emit_str(s, IR_SP)
    emit_reg(s, agg)
    emit_str(s, IR_PTR_SEP)
    emit_reg(s, dst_ptr)
    emit_str(s, IR_NL)

# The address of row `idx` of the dimension-`d` plane of `sh` at `ptr`.
fn emit_nd_row_gep(s: *EmitterState, sh: *ArrayShape, d: i32, ptr: i32, idx: i32) -> i32
    let r: i32 = next_reg(s)
    emit_str(s, IR_INDENT)
    emit_reg(s, r)
    emit_str(s, c" = getelementptr ")
    emit_array_shape_llvm(s, sh, d)
    emit_str(s, IR_PTR_SEP)
    emit_reg(s, ptr)
    emit_str(s, IR_I64_ZERO)
    emit_int(s, idx as i64)
    emit_str(s, IR_NL)
    r

# The number of elements an array literal `[a, b, ..]` lists.
fn array_lit_count(e: *Expr) -> i32
    var n: i32 = 0
    var it: *Expr = e.args
    while it != null
        n = n + 1
        it = it.next
    n

# AGAST #3642: `*q = value` for a plane pointer `q` (#2570) whose plane is
# `sh`, at `dst_ptr`.  A whole N-D place is copied as one aggregate
# (emit_nd_array_init_copy); a nested literal or fill is built in a temporary
# and copied over, so `*q = [ [q[1][0], ..], ..]` reads the old plane, as a
# 1-D `*p = [..]` does (emit_array_local_whole_assign).  A wrong length was
# refused, located, by R42 (ref_literal_length); emit_nd_array_init_into
# refuses it again rather than store a short row.
fn emit_nd_plane_store(s: *EmitterState, dst_ptr: i32, sh: *ArrayShape, value: *Expr)
    if emit_nd_array_init_copy(s, dst_ptr, sh, value) == 1
        return
    if value.kind != ExprKind.ArrayLit and value.kind != ExprKind.ArrayFill
        emit_nd_error(s, value.span.line, value.span.col, c"whole-plane store through a pointer to a plane of a multi-dimensional array is not supported by ritz1 from this value (only a nested literal or fill, or a whole N-D array or plane)")
        return
    let tmp: i32 = next_reg(s)
    entry_alloca_reg_begin(s, tmp)
    emit_array_shape_llvm(s, sh, 0)
    emit_str(s, IR_NL)
    entry_alloca_reg_end(s)
    if emit_nd_array_init_into(s, sh, 0, tmp, value) == 1
        emit_nd_plane_copy(s, sh, 0, dst_ptr, tmp)

# AGAST #3377 (LARB R39): write the initialiser `e` into the dimension-`d`
# plane of `sh` at `ptr`, the whole N-D local at d == 0.  Each level is a
# literal `[a, b, ..]` or a fill `[v; n]` with exactly that dimension's
# count: every element gets a value, which an array of a Drop type must have
# (§3.3).  The innermost rows are written as a 1-D local's are
# (emit_array_lit_into / emit_array_fill_into), after the leaf slot checks;
# an outer `[row; n]` writes
# row 0 and copies it into the rest, so a move-only leaf can fill only one
# row (as `[v; n]` itself, ref_check_fill).  Any other row (a named `[M]T`
# local, a call) is refused, located.  Returns 1 when it wrote `e`.
fn emit_nd_array_init_into(s: *EmitterState, sh: *ArrayShape, d: i32, ptr: i32, e: *Expr) -> i32
    var count: i32 = -1
    match e.kind
        ExprKind.ArrayLit =>
            count = array_lit_count(e)
        ExprKind.ArrayFill =>
            count = e.int_val as i32
        _ =>
            emit_nd_error(s, e.span.line, e.span.col, c"a row of a multi-dimensional array initializer must be `[a, b, ..]` or `[v; n]` in ritz1")
            return 0
    if count != sh.dims[d]
        emit_nd_error(s, e.span.line, e.span.col, c"multi-dimensional array initializer's shape does not match the local array's")
        return 0
    if d == sh.rank - 1
        # The leaf slot checks (`300` into a u8, a `"A"` into a `*u8`, #2357)
        # are Sema's: literal_slot.ritz's lit_nd_rows (#3510), bool_check (#3502).
        if e.kind == ExprKind.ArrayLit
            emit_array_lit_into(s, ptr, sh.dims[d], sh.leaf_type, StrView { ptr: (sh.leaf_name), len: (sh.leaf_name_len) as i64 }, e)
        else
            emit_array_fill_into(s, ptr, sh.dims[d], sh.leaf_type, StrView { ptr: (sh.leaf_name), len: (sh.leaf_name_len) as i64 }, e.left)
        return 1
    if e.kind == ExprKind.ArrayLit
        var idx: i32 = 0
        var it: *Expr = e.args
        while it != null
            let row: i32 = emit_nd_row_gep(s, sh, d, ptr, idx)
            if emit_nd_array_init_into(s, sh, d + 1, row, it) == 0
                return 0
            idx = idx + 1
            it = it.next
        return 1
    if count > 1 and sh.leaf_type == TypeKind.Struct and own_type_is_move_only(s, StrView { ptr: (sh.leaf_name), len: (sh.leaf_name_len) as i64 }) == 1
        emit_nd_error(s, e.span.line, e.span.col, c"`[v; n]` copies `v` into every element: a move-only value fills one, `[v; 1]`")
        return 0
    let row0: i32 = emit_nd_row_gep(s, sh, d, ptr, 0)
    if emit_nd_array_init_into(s, sh, d + 1, row0, e.left) == 0
        return 0
    var i: i32 = 1
    while i < count
        emit_nd_plane_copy(s, sh, d + 1, emit_nd_row_gep(s, sh, d, ptr, i), row0)
        i = i + 1
    1

# Copy a whole local `[N x T]` from `src_ptr` over `dst_ptr` as one aggregate
# load + store: every element is read before any is written.
pub fn emit_local_array_copy(s: *EmitterState, size: i32, et: TypeKind, name_sv: StrView, src_ptr: i32, dst_ptr: i32)
    var name: *u8 = name_sv.ptr
    var name_len: i32 = name_sv.len as i32
    # AGAST #2306: an array of at least SRET_MIN_BYTES is copied pointer-to-
    # pointer, as #1732 copies a large struct: clang -O2 splits a first-class
    # `[N x T]` load/store into one scalar per element and hangs at 64 KB.
    # The two arrays are distinct or the same, never partially overlapping.
    var align: i64 = 8
    if elem_size_align(s, et, StrView { ptr: (name), len: (name_len) as i64 }, @align) * (size as i64) >= SRET_MIN_BYTES
        emit_str(s, c"  call void @__ritz_sret_copy(ptr ")
        emit_reg(s, dst_ptr)
        emit_str(s, IR_PTR_SEP)
        emit_reg(s, src_ptr)
        emit_str(s, c", i64 ptrtoint (ptr getelementptr (")
        emit_local_array_llvm_type(s, size, et, StrView { ptr: (name), len: (name_len) as i64 })
        emit_str(s, c", ptr null, i32 1) to i64))\n")
        s.sret_helpers_used = 1
        return
    let agg: i32 = next_reg(s)
    emit_str(s, IR_INDENT)
    emit_reg(s, agg)
    emit_str(s, IR_LOAD)
    emit_local_array_llvm_type(s, size, et, StrView { ptr: (name), len: (name_len) as i64 })
    emit_str(s, IR_PTR_SEP)
    emit_reg(s, src_ptr)
    emit_str(s, c"\n  store ")
    emit_local_array_llvm_type(s, size, et, StrView { ptr: (name), len: (name_len) as i64 })
    emit_str(s, IR_SP)
    emit_reg(s, agg)
    emit_str(s, IR_PTR_SEP)
    emit_reg(s, dst_ptr)
    emit_str(s, IR_NL)

# AGAST #2169: a 1-D local `[N]T` array at `dst_ptr` (length `dst_size`,
# element `dst_et`, element struct `dst_name`) gets a whole-array value, as
# `let a: [N]T = v` or `a = v`.  The generic scalar path loaded / stored the
# value as ONE i64: `a = c` and `var d: [3]i64 = a` copied 8 bytes, and
# `a = [x, y]` stored the literal's address (or `store i64 <%T>`, which clang
# rejects).  Supported values, each checked for length and element type:
#   * `[a, b, ..]`: built in a temporary `[N x T]` then copied over, so
#     `a = [a[1], a[0]]` swaps (as for a field, #1934);
#   * `[v; N]`: written in place (v is evaluated once, before any store);
#   * another 1-D local array or by-value param (`a = c`);
#   * a 1-D global array (#2287);
#   * an inline array field (`a = x.f`, #2035);
#   * `*p` for `p: *[N]T`, `@[N]T` or `@&[N]T` (#1953, #2287).
# Anything else fails closed: emit_expr has no whole-array value.  `dst_ptr` may
# be any `[N x T]`: `*p = a`, `G = a` and a by-value argument come here too.
pub fn emit_array_local_whole_assign(s: *EmitterState, dst_ptr: i32, dst_size: i32, dst_et: TypeKind, dst_name_sv: StrView, value: *Expr)
    var dst_name: *u8 = dst_name_sv.ptr
    var dst_name_len: i32 = dst_name_sv.len as i32
    if value == null
        emit_ir_error(s, value.span, c"whole-array assignment has no value")
        return
    match value.kind
        ExprKind.If =>
            emit_array_if_into(s, dst_ptr, dst_size, dst_et, StrView { ptr: (dst_name), len: (dst_name_len) as i64 }, value)
            return
        ExprKind.Match =>
            emit_array_match_into(s, dst_ptr, dst_size, dst_et, StrView { ptr: (dst_name), len: (dst_name_len) as i64 }, value.left, value.args as *MatchArm, value.span)
            return
        _ => pass
    if emit_array_local_copy_from_field(s, dst_ptr, dst_size, dst_et, StrView { ptr: (dst_name), len: (dst_name_len) as i64 }, value) == 1
        return
    if value.kind == ExprKind.ArrayFill or value.kind == ExprKind.ArrayLit
        var n: i32 = 0
        if value.kind == ExprKind.ArrayFill
            n = value.int_val as i32
        else
            var it: *Expr = value.args
            while it != null
                n = n + 1
                it = it.next
        if n != dst_size
            emit_ir_error(s, value.span, c"array literal length does not match the local array's length")
            return
        if value.kind == ExprKind.ArrayFill
            emit_array_fill_into(s, dst_ptr, dst_size, dst_et, StrView { ptr: (dst_name), len: (dst_name_len) as i64 }, value.left)
            return
        let tmp: i32 = next_reg(s)
        entry_alloca_reg_begin(s, tmp)
        emit_local_array_llvm_type(s, dst_size, dst_et, StrView { ptr: (dst_name), len: (dst_name_len) as i64 })
        emit_str(s, IR_NL)
        entry_alloca_reg_end(s)
        emit_array_lit_into(s, tmp, dst_size, dst_et, StrView { ptr: (dst_name), len: (dst_name_len) as i64 }, value)
        emit_local_array_copy(s, dst_size, dst_et, StrView { ptr: (dst_name), len: (dst_name_len) as i64 }, tmp, dst_ptr)
        return
    # AGAST #2302: a call's `[N x T]` value is stored whole.
    let cra: *Param = call_ret_array(s, value)
    if cra != null
        if cra.param_array_size != dst_size
            emit_ir_error(s, value.span, c"array length does not match the local array's length")
            return
        if array_store_fits(s, value, cra.param_array_elem_type, StrView { ptr: (cra.param_type_name), len: (cra.param_type_name_len) as i64 }, dst_et, StrView { ptr: (dst_name), len: (dst_name_len) as i64 }) == 0
            return
        emit_call_array_store(s, value, cra, dst_ptr)
        return
    var place: ArraySrc
    if nd_row_src(s, value, @place) == 1
        # AGAST #2517: a row `g[i]`, `x.m[i]`, `mk().m[i]` or `mkp().m[i]`.
        if place.size != dst_size
            emit_ir_error(s, value.span, c"array length does not match the local array's length")
            return
        if array_store_fits(s, value, place.elem, StrView { ptr: (place.name), len: (place.name_len) as i64 }, dst_et, StrView { ptr: (dst_name), len: (dst_name_len) as i64 }) == 0
            return
        var ndp: NdIndexPtr
        emit_nd_index_ptr(s, value, @ndp)
        emit_local_array_copy(s, dst_size, dst_et, StrView { ptr: (dst_name), len: (dst_name_len) as i64 }, ndp.reg, dst_ptr)
        return
    if array_place_shape(s, value, @place) == 0
        emit_ir_error(s, value.span, c"whole-array assignment to a local array from this value is not supported by ritz1 (only array literals, local arrays, array fields and `*p` for `p: *[N]T`)")
        return
    if place.size != dst_size
        emit_ir_error(s, value.span, c"array length does not match the local array's length")
        return
    if array_store_fits(s, value, place.elem, StrView { ptr: (place.name), len: (place.name_len) as i64 }, dst_et, StrView { ptr: (dst_name), len: (dst_name_len) as i64 }) == 0
        return
    emit_local_array_copy(s, dst_size, dst_et, StrView { ptr: (dst_name), len: (dst_name_len) as i64 }, emit_array_place_ptr(s, value), dst_ptr)

# AGAST #2305: `if c then a else b` (or the block form) as a whole `[N]T` value.
# Each arm stores its own array at `dst_ptr`, held to N and T as any source is,
# so no `[N x T]` phi is needed.  Before this the arms' i64s met in a phi: 8
# bytes, or a type clang refused.  An arm that leaves (`return`) stores nothing.
fn emit_array_if_into(s: *EmitterState, dst_ptr: i32, dst_size: i32, dst_et: TypeKind, dst_name_sv: StrView, value: *Expr)
    var dst_name: *u8 = dst_name_sv.ptr
    var dst_name_len: i32 = dst_name_sv.len as i32
    let then_arm: *MatchArm = value.args as *MatchArm
    let else_arm: *MatchArm = then_arm.next
    # Sema refused a valueless arm (if_arm_value.ritz, AGAST #3512).
    let cond: i32 = emit_expr(s, value.left)
    let cond_i1: i32 = next_reg(s)
    emit_str(s, IR_INDENT)
    emit_reg(s, cond_i1)
    emit_str(s, c" = icmp ne i64 ")
    emit_reg(s, cond)
    emit_str(s, IR_COMMA_0)
    let then_label: i32 = next_label(s)
    let else_label: i32 = next_label(s)
    let end_label: i32 = next_label(s)
    emit_str(s, c"  br i1 ")
    emit_reg(s, cond_i1)
    emit_str(s, IR_LABEL_SEP)
    emit_label(s, then_label)
    emit_str(s, IR_LABEL_SEP)
    emit_label(s, else_label)
    emit_str(s, IR_NL)
    begin_block(s, then_label)
    emit_array_arm_into(s, dst_ptr, dst_size, dst_et, StrView { ptr: (dst_name), len: (dst_name_len) as i64 }, then_arm, end_label)
    begin_block(s, else_label)
    emit_array_arm_into(s, dst_ptr, dst_size, dst_et, StrView { ptr: (dst_name), len: (dst_name_len) as i64 }, else_arm, end_label)
    begin_block(s, end_label)

# AGAST #3276: a `match` of whole arrays (an ExprKind.Match value or a StmtKind.Match
# tail) stored at `dst_ptr`: emit_match's own dispatch, each arm storing its
# array there (emit_match_into).
pub fn emit_array_match_into(s: *EmitterState, dst_ptr: i32, dst_size: i32, dst_et: TypeKind, dst_name_sv: StrView, scrutinee: *Expr, arms: *MatchArm, span: SrcSpan)
    var dst_name: *u8 = dst_name_sv.ptr
    var dst_name_len: i32 = dst_name_sv.len as i32
    var into: ArrayInto
    into.ptr = dst_ptr
    into.size = dst_size
    into.et = dst_et
    into.name = dst_name
    into.name_len = dst_name_len
    emit_match_into(s, scrutinee, arms, span, @into)

# AGAST #2305: N and T of the whole `[N]T` an `if` value's first telling arm
# gives: a `-> [N]T` call (its element pointee to `*pointee`), a 1-D array
# place, an inline field, or a nested `if`.  1 if one does.  Each arm is still
# held to that shape when emit_array_if_into stores it.  Emits nothing.
# AGAST #3276: a `match` value's arms too (its `args` are MatchArms as an
# `if`'s are), and a nested `match`.  An arm reading its own pattern binding
# can't tell here (the binding isn't in scope); a later arm may.
fn if_array_shape(s: *EmitterState, e: *Expr, out: *ArraySrc, pointee: *TypeKind) -> i32
    var arm: *MatchArm = e.args as *MatchArm
    while arm != null
        let v: *Expr = arm.body
        if arm.is_pass == 0 and v != null
            if v.kind == ExprKind.If or v.kind == ExprKind.Match
                if if_array_shape(s, v, out, pointee) == 1
                    return 1
            else
                let cra: *Param = call_ret_array(s, v)
                if cra != null
                    *pointee = cra.param_array_elem_pointee
                    return array_src_set(out, cra.param_array_size, cra.param_array_elem_type, StrView { ptr: (cra.param_type_name), len: (cra.param_type_name_len) as i64 })
                if arm.body_stmts == null and arg_array_shape(s, v, out) == 1
                    return 1
        arm = arm.next
    0

# AGAST #2305: an `if` / `else` STATEMENT whose arms end in a whole `[N]T`, the
# tail of a `-> [N]T` fn: as emit_array_if_into, with each block's last
# statement its value.  A nested `if` / `else` there is a value too.
pub fn emit_array_stmt_if_into(s: *EmitterState, dst_ptr: i32, dst_size: i32, dst_et: TypeKind, dst_name_sv: StrView, st: *Stmt)
    var dst_name: *u8 = dst_name_sv.ptr
    var dst_name_len: i32 = dst_name_sv.len as i32
    let cond: i32 = emit_expr(s, st.if_cond)
    let cond_i1: i32 = next_reg(s)
    emit_str(s, IR_INDENT)
    emit_reg(s, cond_i1)
    emit_str(s, c" = icmp ne i64 ")
    emit_reg(s, cond)
    emit_str(s, IR_COMMA_0)
    let then_label: i32 = next_label(s)
    let else_label: i32 = next_label(s)
    let end_label: i32 = next_label(s)
    emit_str(s, c"  br i1 ")
    emit_reg(s, cond_i1)
    emit_str(s, IR_LABEL_SEP)
    emit_label(s, then_label)
    emit_str(s, IR_LABEL_SEP)
    emit_label(s, else_label)
    emit_str(s, IR_NL)
    begin_block(s, then_label)
    emit_array_block_into(s, dst_ptr, dst_size, dst_et, StrView { ptr: (dst_name), len: (dst_name_len) as i64 }, st.if_then, end_label)
    begin_block(s, else_label)
    emit_array_block_into(s, dst_ptr, dst_size, dst_et, StrView { ptr: (dst_name), len: (dst_name_len) as i64 }, st.if_else, end_label)
    begin_block(s, end_label)

# A block whose last statement is the array: an expression, an `if` / `else`,
# or a `match` (AGAST #3276).
# Any other last statement (a `return`) is emitted as it is.
fn emit_array_block_into(s: *EmitterState, dst_ptr: i32, dst_size: i32, dst_et: TypeKind, dst_name_sv: StrView, stmts: *Stmt, end_label: i32)
    var dst_name: *u8 = dst_name_sv.ptr
    var dst_name_len: i32 = dst_name_sv.len as i32
    var st: *Stmt = stmts
    while st != null
        if st.next == null and st.kind == StmtKind.Expr
            own_arm_moves(s, st.expr)   # the value moves
            emit_array_local_whole_assign(s, dst_ptr, dst_size, dst_et, StrView { ptr: (dst_name), len: (dst_name_len) as i64 }, st.expr)
        else if st.next == null and st.kind == StmtKind.If and st.if_else != null
            emit_array_stmt_if_into(s, dst_ptr, dst_size, dst_et, StrView { ptr: (dst_name), len: (dst_name_len) as i64 }, st)
        else if st.next == null and st.kind == StmtKind.Match
            emit_array_match_into(s, dst_ptr, dst_size, dst_et, StrView { ptr: (dst_name), len: (dst_name_len) as i64 }, st.if_cond, st.if_then as *MatchArm, st.span)   # AGAST #3276
        else
            emit_stmt(s, st, s.fn_ret_type)
            if st.kind == StmtKind.Return
                begin_block(s, next_label(s))
                clear_last_expr(s)
        st = st.next
    emit_str(s, IR_BR)
    emit_label(s, end_label)
    emit_str(s, IR_NL)

fn emit_array_arm_into(s: *EmitterState, dst_ptr: i32, dst_size: i32, dst_et: TypeKind, dst_name_sv: StrView, arm: *MatchArm, end_label: i32)
    var dst_name: *u8 = dst_name_sv.ptr
    var dst_name_len: i32 = dst_name_sv.len as i32
    emit_match_arm_stmts(s, arm.body_stmts)
    if arm.is_pass == 0 and arm.body != null
        own_arm_moves(s, arm.body)   # as emit_match_arm_body does
        emit_array_local_whole_assign(s, dst_ptr, dst_size, dst_et, StrView { ptr: (dst_name), len: (dst_name_len) as i64 }, arm.body)
    emit_str(s, IR_BR)
    emit_label(s, end_label)
    emit_str(s, IR_NL)

# AGAST #2048: `x.f = v` / `pp.f = v` / `o.p.f = v` where `f` is an f32 /
# f64 field at `field_ptr` and `val_reg` is emit_expr(value).  Stores
# `float` / `double` (an f64 value into an f32 field is fptrunc'd by
# emit_field_elem_narrow, as struct-literal init does) and returns 1; returns
# 0 for any other field type.  Both field-assign paths fell to `store i64`
# here, which clang rejects.
fn emit_float_field_store(s: *EmitterState, field_ptr: i32, field_ty: TypeKind, val_reg: i32, value: *Expr) -> i32
    if field_ty != TypeKind.F32 and field_ty != TypeKind.F64
        return 0
    let fval: i32 = emit_field_elem_narrow(s, val_reg, field_ty, value)
    if field_ty == TypeKind.F32
        emit_str(s, c"  store float ")
    else
        emit_str(s, c"  store double ")
    emit_reg(s, fval)
    emit_str(s, IR_PTR_SEP)
    emit_reg(s, field_ptr)
    emit_str(s, IR_NL)
    1

# AGAST #1934: `x.f = [a, b, ..]` / `x.f = [v; N]` where `f` is an inline
# `[N]T` array field at `field_ptr`.  The elements are written at the field's
# declared element type, as a struct literal's array field is (#1605/#1608);
# bool / f32 / f64 elements as `i1` / `float` / `double` (#1935).
#
#   * `[v; N]` is written straight into the field: emit_array_fill_into
#     evaluates `v` once, before any store.
#   * `[a, b, ..]` is built in a temporary `[N x T]` and then copied over the
#     field, so every element is read before any is written
#     (`x.f = [x.f[1], x.f[0]]` swaps, as in ritz0).
#   * any other right-hand side is copied by emit_array_field_copy_from.
#
# A literal whose length differs from the field's fails closed (ritz0
# rejects it too).
pub fn emit_array_field_whole_assign(s: *EmitterState, field_ptr: i32, field: *StructField, value: *Expr)
    let et: TypeKind = field.array_elem_type
    if value == null
        emit_ir_error(s, value.span, c"whole-array assignment to a struct field has no value")
        return
    if value.kind != ExprKind.ArrayLit and value.kind != ExprKind.ArrayFill
        emit_array_field_copy_from(s, field_ptr, field, value)
        return
    var n: i32 = 0
    if value.kind == ExprKind.ArrayFill
        n = value.int_val as i32
    else
        var it: *Expr = value.args
        while it != null
            n = n + 1
            it = it.next
    if n != field.array_size
        emit_ir_error(s, value.span, c"array literal length does not match the struct field's array length")
        return
    if value.kind == ExprKind.ArrayFill
        emit_array_fill_into(s, field_ptr, field.array_size, et, StrView { ptr: (field.array_elem_type_name), len: (field.array_elem_type_name_len) as i64 }, value.left)
        return
    # Build in a temporary (a fixed-size alloca, written into the entry-block
    # buffer), then copy the whole aggregate over the field.
    let tmp: i32 = next_reg(s)
    entry_alloca_reg_begin(s, tmp)
    emit_array_field_llvm_type(s, field)
    emit_str(s, IR_NL)
    entry_alloca_reg_end(s)
    emit_array_lit_into(s, tmp, field.array_size, et, StrView { ptr: (field.array_elem_type_name), len: (field.array_elem_type_name_len) as i64 }, value)
    emit_array_field_copy(s, field, tmp, field_ptr)

# AGAST #1814: `x.f[i] = v` where `f` is an inline `[N]T` array field at
# `field_ptr`. GEP the element at the field's DECLARED element type
# (field_array_elem_llvm, ritz0's layout) and store `val` at that width.
# Shared by both member-index store paths, which used to carry their own
# i8/i32/i64/ptr ladders and stored u16/u32/bool elements as 8-byte i64.
# `place` is the array field stored into (`h.a` of `h.a[i] = v`), whose old
# element is dropped when a binding owns it (own_drop_old_elem, AGAST #3377).
fn emit_field_array_elem_store(s: *EmitterState, field_ptr: i32, field: *StructField, idx: i32, val: i32, val_expr: *Expr, place: *Expr)
    let et: TypeKind = field.array_elem_type
    var is_struct: bool = false
    if et == TypeKind.Struct and field.array_elem_type_name_len > 0
        is_struct = true
    let elem_ptr: i32 = next_reg(s)
    emit_str(s, IR_INDENT)
    emit_reg(s, elem_ptr)
    emit_str(s, IR_GEP_ARRAY)
    emit_int(s, field.array_size as i64)
    emit_str(s, IR_X)
    if is_struct
        # AGAST #188: struct-array LHS — `[N x %T]` so the GEP and the store
        # agree with the struct value being stored.
        emit_llvm_type_struct(s, TypeKind.Struct, StrView { ptr: (field.array_elem_type_name), len: (field.array_elem_type_name_len) as i64 })
    else
        emit_str(s, elem_mem_llvm(et))
    emit_str(s, IR_RBRACK_PTR)
    emit_reg(s, field_ptr)
    emit_str(s, IR_I64_ZERO)
    emit_reg(s, idx)
    emit_str(s, IR_NL)
    var sty: *u8 = c"i64"
    var sval: i32 = val
    if is_struct
        own_drop_old_elem(s, place, elem_ptr, StrView { ptr: (field.array_elem_type_name), len: (field.array_elem_type_name_len) as i64 })
        # AGAST #188: `store %T %val` matches the `load %T` of the RHS.
        # AGAST #4461: an sret-sized struct copied from a held load becomes a
        # `@__ritz_sret_copy` call instead of a first-class store.
        emit_struct_store_or_copy(s, TypeKind.Struct, StrView { ptr: (field.array_elem_type_name), len: (field.array_elem_type_name_len) as i64 }, val, elem_ptr)
        return
    match et
        TypeKind.F32 | TypeKind.F64 =>
            # AGAST #1954: `float` / `double` (field_array_elem_llvm), an f64
            # value into an f32 slot fptrunc'd, as #1973's `p[i] = v` does.
            # f32 failed closed; f64 stored `i64`, which only type-checked while
            # the `x.f[i]` read also bit-loaded an i64.
            sty = elem_mem_llvm(et)
            sval = emit_field_elem_narrow(s, val, et, val_expr)
        TypeKind.Bool =>
            # A bool value is an i64 register (AGAST #1646): truncate it.
            sty = c"i1"
            sval = next_reg(s)
            emit_str(s, IR_INDENT)
            emit_reg(s, sval)
            emit_str(s, IR_TRUNC)
            emit_reg(s, val)
            emit_str(s, c" to i1\n")
        _ =>
            # Integers / pointers at their own width (trunc / inttoptr); i64
            # elements store all 8 bytes.
            sty = elem_mem_llvm(et)
            if (et == TypeKind.Ptr or et == TypeKind.PtrPtr) and expr_is_ptr_valued(s, val_expr) == 1
                sval = val   # AGAST #3170: `h.a[i] = @&x` into a `[N]*T` field: a `ptr` already
            else
                sval = emit_array_elem_narrow(s, val, et, sty)
    emit_str(s, IR_STORE_IND)
    emit_str(s, sty)
    emit_str(s, IR_SP)
    emit_reg(s, sval)
    emit_str(s, IR_PTR_SEP)
    emit_reg(s, elem_ptr)
    emit_str(s, IR_NL)

# AGAST #1596: `x.f[i] = v` where `f` is a pointer field (`*T` / `**T`):
# load the pointer from the field slot `field_slot`, GEP by the pointee, and
# store `v` at the pointee's width. Returns 0 WITHOUT emitting anything when
# the pointee cannot be addressed at a known width (unrecorded)
# so the caller can fail closed.
fn emit_ptr_field_index_store(s: *EmitterState, field_slot: i32, field: *StructField, idx_expr: *Expr, val_expr: *Expr) -> i32
    let kind: TypeKind = ptr_field_elem_kind(field)
    if kind == TypeKind.Unknown
        return 0
    let idx: i32 = emit_expr(s, idx_expr)
    let val: i32 = emit_expr(s, val_expr)
    let elem_ptr: i32 = emit_ptr_field_elem_addr(s, field_slot, field, kind, idx)
    if kind == TypeKind.Struct
        # Struct element: the value register is a `%T` aggregate (#188).
        # AGAST #4461: a copy of a held sret-sized load is the copy call.
        emit_struct_store_or_copy(s, TypeKind.Struct, StrView { ptr: (field.field_type_name), len: (field.field_type_name_len) as i64 }, val, elem_ptr)
        return 1
    else if array_elem_typed_scalar(kind) == 1
        # AGAST #2053: `float` / `double` (ptr_field_elem_llvm); an f64
        # value into an f32 slot is fptrunc'd.  bool: `i1` (#2063).
        let typed: i32 = emit_field_elem_narrow(s, val, kind, val_expr)
        emit_str(s, IR_STORE_IND)
        emit_str(s, elem_mem_llvm(kind))
        emit_str(s, IR_SP)
        emit_reg(s, typed)
    else
        # Narrow the i64 value to the element width (trunc / inttoptr).
        let elem_ty: *u8 = elem_mem_llvm(kind)
        var narrow: i32 = val   # AGAST #3170: `h.f[i] = @&x` into a `**T` field: a `ptr` already
        if (kind != TypeKind.Ptr and kind != TypeKind.PtrPtr) or expr_is_ptr_valued(s, val_expr) == 0
            narrow = emit_array_elem_narrow(s, val, kind, elem_ty)
        emit_str(s, IR_STORE_IND)
        emit_str(s, elem_ty)
        emit_str(s, IR_SP)
        emit_reg(s, narrow)
    emit_str(s, IR_PTR_SEP)
    emit_reg(s, elem_ptr)
    emit_str(s, IR_NL)
    return 1

# AGAST #1439: `name.field = v` / `name.field[i] = v` that the fast
# StmtKind.LocalFieldAssign / StmtKind.LocalFieldIndexAssign lowering could not
# resolve (no such local or param, unknown struct, unknown field).  Those arms
# used to emit NOTHING — no store, no diagnostic, exit 0 — while a read of the
# same member failed closed.  Re-lower the statement as an expression
# assignment to the member `name.field` (wrapped in an index when
# `with_index` is 1), so emit_assign resolves it through emit_member_ptr like
# every other field store: a field of a GLOBAL struct gets a real GEP + store
# (`ops.n = 5`), and anything still unresolved hits emit_assign's
# emit_ir_error instead of vanishing.
fn emit_local_field_store_fallback(s: *EmitterState, stmt: *Stmt, with_index: i32)
    var fb_base: Expr
    fb_base.kind = ExprKind.Ident
    fb_base.span = stmt.span
    fb_base.ident_ptr = stmt.var_name
    fb_base.ident_len = stmt.var_name_len
    fb_base.next = null
    var fb_mem: Expr
    fb_mem.kind = ExprKind.Member
    fb_mem.span = stmt.span
    fb_mem.left = @fb_base
    fb_mem.ident_ptr = stmt.assign_target
    fb_mem.ident_len = stmt.assign_target_len
    fb_mem.next = null
    var fb_idx: Expr
    fb_idx.kind = ExprKind.Index
    fb_idx.bracket.line = 0
    fb_idx.span = stmt.span
    fb_idx.left = @fb_mem
    fb_idx.right = stmt.while_cond
    fb_idx.next = null
    var fb_st: Stmt
    fb_st.kind = StmtKind.Assign
    fb_st.span = stmt.span
    if with_index == 1
        fb_st.if_cond = @fb_idx
    else
        fb_st.if_cond = @fb_mem
    fb_st.assign_target = null
    fb_st.assign_target_len = 0
    fb_st.assign_value = stmt.assign_value
    fb_st.next = null
    emit_assign(s, @fb_st)

# AGAST #2559: the struct type of a statement-`if` arm's value, or null/0.
# The arm's last statement is its value: a trailing expression (a static
# call `B.new(..)` is typed by its callee), a `match` (emit_match published
# its phi type, #1666), or a nested statement `if` (an `else if` chain),
# which published its own.  Called right after the arm is emitted, so its
# `let`s are still in scope.
fn if_stmt_arm_agg(s: *EmitterState, list: *Stmt, out_name: **u8, out_len: *i32)
    *out_name = null
    *out_len = 0
    var last: *Stmt = list
    if last == null
        return
    while last.next != null
        last = last.next
    match last.kind
        StmtKind.If =>
            *out_name = s.last_if_stmt_agg_name
            *out_len = s.last_if_stmt_agg_name_len
            return
        StmtKind.Match =>
            *out_name = s.last_match_agg_name
            *out_len = s.last_match_agg_name_len
            return
        _ => pass
    if last.kind != StmtKind.Expr or last.expr == null
        return
    let e: *Expr = last.expr
    let lent: *LocalVar = lent_referent_local(s, e)
    if lent != null   # AGAST #2288: emit_if_stmt_arm read the referent
        *out_name = lv_type_name(lent)
        *out_len = lv_type_name_len(lent)
        return
    resolve_expr_struct_name(s, e, out_name, out_len)
    if *out_name == null
        call_result_struct_name(s, e, out_name, out_len)
    if *out_name == null
        span_assoc_arm_type(s, e, out_name, out_len)   # AGAST #4194
    # AGAST #2950: `*r` with `r: @C` / `@&C` / `*C` loads the %C.
    if *out_name == null and e.kind == ExprKind.Unary and e.op == OpKind.Deref
        deref_pointee_struct_name(s, e.operand, out_name, out_len)

# AGAST #2950: a statement-`if` arm's `@&x` value `reg` (a `ptr`) as the i64
# its phi holds, asked while the arm's `let`s are in scope.  The phi was i64
# over `ptr`s; a tail one in a `-> @&C` fn is converted back at the `ret`
# (emit_implicit_return_tail).
fn if_stmt_arm_ptr_settle(s: *EmitterState, list: *Stmt, reg: i32, agg: *u8) -> i32
    if reg <= 0 or agg != null
        return reg
    var last: *Stmt = list
    while last.next != null
        last = last.next
    if last.kind != StmtKind.Expr or arm_value_is_ptr(s, last.expr) == 0
        return reg
    ptr_value_to_i64(s, last.expr, reg)

# A statement-`if` arm's statements.  AGAST #2288: a trailing `c` with
# `c:& C` is the arm's value, so it reads the referent, as in ritz0 (which
# reports a move-only C there).  It read as the pointer, so a tail `if` typed
# its phi i64 over `ptr`s.  if_stmt_arm_agg types it C.  It still goes through
# emit_stmt, whose checks refuse it in a `-> @&C` fn.
#
# AGAST #3323: a `return` leaves its block terminated by `ret`, so a fresh
# (unreachable) block is opened after it, as emit_match_arm_stmts does
# (#1454): the arm's `br` to the merge and its phi incoming then name a block
# that really branches there.
#
# AGAST #3749: an arm of a discarded `if` (`discarded` == 1) has no value
# either, so an `if` ending it is discarded too.
#
# AGAST #3421: the `if`'s float slot (`float_hint`, 0 if none) reaches an
# `if` / `match` ending the arm, as a match arm's does (#2092).
#
# AGAST #4590: `moves` == 1 when the `if`'s value is read (it has an `else`
# and is not discarded): the arm's trailing expression then moves out
# (own_mark_if_arm_moves), as a match arm's does.
fn emit_if_stmt_arm(s: *EmitterState, list: *Stmt, ret_type: TypeKind, discarded: i32, float_hint: TypeKind, moves: i32)
    let saved: *Stmt = s.if_arm_value
    let saved_moves: *Stmt = own_mark_if_arm_moves(null)
    var st: *Stmt = list
    while st != null
        if st.next == null and st.kind == StmtKind.Expr
            s.if_arm_value = st
            if moves == 1
                own_mark_if_arm_moves(st)
        if st.next == null and discarded == 1
            s.if_stmt_discarded = st
        if st.next == null and discarded == 0 and stmt_is_if_or_match(st) == 1
            s.match_float_hint = float_hint
        emit_stmt(s, st, ret_type)
        s.if_arm_value = saved
        own_mark_if_arm_moves(saved_moves)
        if st.kind == StmtKind.Return
            begin_block(s, next_label(s))
            clear_last_expr(s)
        st = st.next

# 1 if `st` is an `if` / `match`, as a statement or an expression statement.
fn stmt_is_if_or_match(st: *Stmt) -> i32
    if st.kind == StmtKind.If or st.kind == StmtKind.Match
        return 1
    if st.kind == StmtKind.Expr and st.expr != null and (st.expr.kind == ExprKind.If or st.expr.kind == ExprKind.Match)
        return 1
    0

# AGAST #3421: settle a statement-`if` arm's scalar value `reg` against the
# merge's float type `fr` in the arm's own block, before its `br`, as a match
# arm's is (LARB R43, §7.5: an integer arm converts in a float slot and is
# refused next to a float arm without one).  The arm's value is its last
# statement: an expression, or a nested `if` / `match` statement, whose phi
# type it published (last_match_float_ty).  Its phi was `i64` over doubles.
fn if_stmt_arm_float_settle(s: *EmitterState, list: *Stmt, reg: i32, agg: *u8, fr: *MatchResult) -> i32
    if reg <= 0 or agg != null
        return reg
    var last: *Stmt = list
    while last.next != null
        last = last.next
    if last.kind == StmtKind.Expr and last.expr != null
        return match_arm_float_settle(s, last.expr, reg, fr)
    if last.kind == StmtKind.If or last.kind == StmtKind.Match
        return float_arm_settle(s, s.last_match_float_ty, null, last.span, reg, fr)
    reg

# AGAST #3749: a body with no value (a loop's, an `unsafe` block's), whose
# last statement, if an `if`, is discarded: its arms get no phi.  That phi
# was typed from the fn's return type, `phi %Option$i64 [ i64 ... ]`.
fn emit_void_body(s: *EmitterState, list: *Stmt, ret_type: TypeKind)
    var st: *Stmt = list
    while st != null
        if st.next == null
            s.if_stmt_discarded = st
        emit_stmt(s, st, ret_type)
        st = st.next

# 1 if the statement `if` `stmt` has no value to give: a statement follows
# it, or its list's value is unread (s.if_stmt_discarded).  Consumes the mark.
fn if_stmt_is_discarded(s: *EmitterState, stmt: *Stmt) -> i32
    let marked: *Stmt = s.if_stmt_discarded
    s.if_stmt_discarded = null
    if stmt.next != null or stmt == marked
        return 1
    0

# AGAST #3323: an arm's phi incoming.  An arm that never reaches the merge (a
# `return`, a `while true` with no `break`) has no value, but the phi still
# names its block, so it gets IF_ARM_DIVERGES and the zero constant of the
# phi's type: `if c / return a / else / b` as a fn tail.  Its merge was
# `unreachable` with no phi, dropping the else value (a SIGSEGV).
const IF_ARM_DIVERGES: i32 = -1

fn if_stmt_arm_incoming(result: i32, list: *Stmt) -> i32
    if result > 0
        return result
    if tail_stmts_diverge(list) == 1
        return IF_ARM_DIVERGES
    0

fn emit_if_phi_incoming(s: *EmitterState, reg: i32, agg: *u8, float_ty: TypeKind)
    if reg != IF_ARM_DIVERGES
        emit_reg(s, reg)
    else if agg != null
        emit_str(s, c"zeroinitializer")
    else if float_ty != TypeKind.Void
        emit_str(s, c"0.0")   # AGAST #3421
    else
        emit_str(s, c"0")

# AGAST #2563: the phi type a statement-`if` arm of struct type `agg` asks
# for.  The Span$u8 / StrView pair (layout-equal, #168) takes the fn's return
# type when that is one of the two, since a tail `if` feeds the implicit
# `ret`: a `"..."` arm is a %Span$u8 (#98) but a `-> StrView` fn returns
# %StrView.  Any other type is `agg` itself.
fn if_stmt_phi_type(s: *EmitterState, agg_sv: StrView, ret_type: TypeKind, out_name: **u8, out_len: *i32)
    var agg: *u8 = agg_sv.ptr
    var agg_len: i32 = agg_sv.len as i32
    *out_name = agg
    *out_len = agg_len
    if agg == null or agg_len <= 0 or ret_type != TypeKind.Struct or s.ret_type_name_len <= 0
        return
    if is_layout_equiv_pair(StrView { ptr: (agg), len: (agg_len) as i64 }, StrView { ptr: (s.ret_type_name), len: (s.ret_type_name_len) as i64 }) == 1
        *out_name = s.ret_type_name
        *out_len = s.ret_type_name_len

# AGAST #2563: rebuild a statement-`if` arm's value `reg` of type `agg` as
# the phi's type when they are the Span$u8 / StrView pair, in the arm's own
# block before its `br` (as emit_match_arm_body does, #1662).
fn if_stmt_arm_settle(s: *EmitterState, reg: i32, agg_sv: StrView, phi_sv: StrView) -> i32
    var agg: *u8 = agg_sv.ptr
    var agg_len: i32 = agg_sv.len as i32
    var phi: *u8 = phi_sv.ptr
    var phi_len: i32 = phi_sv.len as i32
    if reg > 0 and is_layout_equiv_pair(StrView { ptr: (agg), len: (agg_len) as i64 }, StrView { ptr: (phi), len: (phi_len) as i64 }) == 1
        return rebuild_layout_equiv(s, reg, StrView { ptr: (agg), len: (agg_len) as i64 }, StrView { ptr: (phi), len: (phi_len) as i64 })
    reg

# AGAST #2158: drop insertion (ownership.ritz) wraps every statement.  Its
# moves clear their drop flags first, before it executes (the move check
# itself ran on Sema, own_check.ritz, AGAST #3507); `x = v` drops x's old
# value once v is stored.
#
# AGAST #2165: own_stmt_begin / own_stmt_end bracket it, so the temporaries
# it makes drop when it ends (an `if` / `while` condition's earlier, at
# own_cond_end).
pub fn emit_stmt(s: *EmitterState, stmt: *Stmt, ret_type: TypeKind)
    # AGAST #3739: a local's slot is located at its statement (frame_limit.ritz).
    if stmt.span.line == 0
        emit_stmt_body(s, stmt, ret_type)
        return
    let fm_line: i32 = s.fm_line
    let fm_col: i32 = s.fm_col
    frame_mark(s, stmt.span.line, stmt.span.col)
    emit_stmt_body(s, stmt, ret_type)
    frame_mark(s, fm_line, fm_col)

fn emit_stmt_body(s: *EmitterState, stmt: *Stmt, ret_type: TypeKind)
    let own_mark: i32 = own_stmt_begin(s)
    own_stmt_moves(s, stmt)
    let wanted_mark: i32 = s.wanted_count   # AGAST #2260
    want_stmt_values(s, stmt, ret_type)
    # AGAST #2173: and `x.f = v` drops x.f's old value.
    if stmt.kind == StmtKind.Assign or stmt.kind == StmtKind.LocalFieldAssign
        var old: i32 = 0
        var old_flag: i32 = 0
        let ob: *OwnBinding = own_assign_begin(s, stmt, @old, @old_flag)
        emit_stmt_inner(s, stmt, ret_type)
        s.wanted_count = wanted_mark
        own_assign_end(s, ob, old, old_flag)
        own_stmt_end(s, own_mark)
        return
    emit_stmt_inner(s, stmt, ret_type)
    s.wanted_count = wanted_mark
    own_after_stmt(s, stmt)
    own_stmt_end(s, own_mark)

# 1 if range `for j in a..b` is unsigned: a bound is a u64, by binary `<`'s
# rule (emit_expr_binary, #2361), so `for j in 0..big` with `big: u64 = 1 << 63`
# runs (#1636) and `-3..2` stays signed.  This one answer picks both the
# compare and j's type in the body (#3328).  ritz0's _for_range_unsigned.
fn for_range_unsigned(s: *EmitterState, stmt: *Stmt) -> i32
    var start_uns: i32 = 0
    var end_uns: i32 = 0
    let start_bits: i32 = int_operand_shape(s, stmt.for_start, @start_uns)
    let end_bits: i32 = int_operand_shape(s, stmt.for_end, @end_uns)
    if (start_bits == 64 and start_uns == 1) or (end_bits == 64 and end_uns == 1)
        return 1
    0

# AGAST #4080: the type for_range_type gives `for x in a..b`'s x, from the
# bounds as int_operand_shape reads them (a literal is told apart first).
fn for_range_var_type(s: *EmitterState, stmt: *Stmt) -> TypeKind
    var sv: i64 = 0
    var ev: i64 = 0
    let lit_s: i32 = lit_int_value(stmt.for_start, @sv)
    let lit_e: i32 = lit_int_value(stmt.for_end, @ev)
    var su: i32 = 0
    var eu: i32 = 0
    let sb: i32 = int_operand_shape(s, stmt.for_start, @su)
    let eb: i32 = int_operand_shape(s, stmt.for_end, @eu)
    for_range_type(int_kind_of(sb, su), lit_s, sv, int_kind_of(eb, eu), lit_e, ev)

# A range bound's i64 register at the loop variable's type `t`: truncated when
# `t` is narrower (ritz1 holds every integer in an i64), else as it is.
fn for_bound_at(s: *EmitterState, reg: i32, t: TypeKind) -> i32
    let bits: i32 = ty_int_bits(t)
    if bits == 0 or bits >= 64
        return reg
    let r: i32 = next_reg(s)
    emit_str(s, IR_INDENT)
    emit_reg(s, r)
    emit_str(s, IR_TRUNC)
    emit_reg(s, reg)
    emit_str(s, IR_TO_SP)
    emit_str(s, ty_mem_llvm(t))
    emit_str(s, IR_NL)
    r

# 1 when `e` is a StrView value that ritz1 lowers to a `%Span$u8`: a `"..."`,
# a `... as StrView` (whose register is its operand's, #2131), or a local
# marked str_view (#3564: `let b = a` copies what `a` is).
fn init_is_str_view(s: *EmitterState, e: *Expr) -> i32
    if e == null
        return 0
    if e.kind == ExprKind.StringLit
        return 1
    if e.kind == ExprKind.Cast and e.type_kind == TypeKind.Struct
        return name_eq(StrView { ptr: (e.ident_ptr), len: (e.ident_len) as i64 }, StrView { ptr: (c"StrView"), len: (7) as i64 })
    if e.kind == ExprKind.Ident
        let loc: *LocalVar = find_local_struct_name(s, StrView { ptr: (e.ident_ptr), len: (e.ident_len) as i64 })
        if loc != null and loc.str_view == 1
            return 1
    0

# After emit_var_decl: mark the binding it registered as a `let`, and (#3579)
# an unannotated one bound to a StrView value (init_is_str_view).  `before` is
# s.local_count before the decl, so a decl that registered nothing never marks
# an outer binding of the same name.  The `let` rule is Sema's (let_check.ritz,
# AGAST #3504); LocalVar.is_let is for the emitter's readers: asm operands,
# ref_check's `@x` of a `let` (let_addr_of_own), and str_view's.
fn mark_let_local(s: *EmitterState, stmt: *Stmt, before: i32)
    let idx: i32 = find_local_idx(s, StrView { ptr: (stmt.var_name), len: (stmt.var_name_len) as i64 })
    if idx < before
        return
    let loc: *LocalVar = local_at(s, idx)
    if stmt.var_declared_type == TypeKind.Void and init_is_str_view(s, stmt.var_init) == 1
        loc.str_view = 1
    if stmt.var_is_let == 1
        loc.is_let = 1

# 1 when `init` is a literal: a binding to one holds no fn.
fn binder_init_is_literal(init: *Expr) -> i32
    if init == null
        return 0
    let k: ExprKind = init.kind
    (k == ExprKind.IntLit or k == ExprKind.FloatLit or k == ExprKind.StringLit or k == ExprKind.CstringLit or k == ExprKind.CharLit or k == ExprKind.ArrayLit or k == ExprKind.ArrayFill or k == ExprKind.StructLit) as i32

# After emit_var_decl, as mark_let_local: mark the binding it registered when
# it certainly holds no fn value.  A written type says so unless it is a fn
# type (var_fn_sig) or a pointer; an unwritten one only for a literal.
# AGAST #4376: moved here from binder_check.ritz, which is Sema's and imports
# no emitter module; the rule it serves is the binder check's (#2407).
pub fn binder_mark_decl(s: *EmitterState, stmt: *Stmt, before: i32)
    let idx: i32 = find_local_idx(s, StrView { ptr: (stmt.var_name), len: (stmt.var_name_len) as i64 })
    if idx < before
        return
    var not_fn: i32 = 0
    if stmt.var_declared_type != TypeKind.Void
        not_fn = (stmt.var_fn_sig == null and stmt.var_declared_type != TypeKind.Ptr) as i32
    else
        not_fn = binder_init_is_literal(stmt.var_init)
    let loc: *LocalVar = local_at(s, idx)
    loc.not_fn = not_fn

fn emit_stmt_inner(s: *EmitterState, stmt: *Stmt, ret_type: TypeKind)
    match stmt.kind
        StmtKind.VarDecl =>
            let locals_before: i32 = s.local_count
            emit_var_decl(s, stmt)
            mark_let_local(s, stmt, locals_before)
            binder_mark_decl(s, stmt, locals_before)   # AGAST #2407
            own_decl(s, stmt, locals_before)   # AGAST #2158
        StmtKind.TupleDecl =>
            let tuple_before: i32 = s.local_count
            emit_tuple_decl(s, stmt)   # AGAST #2574
            own_tuple_decl(s, stmt, tuple_before)   # AGAST #3033
        StmtKind.Defer =>
            own_defer(s, stmt, ret_type)   # AGAST #1625: runs at the block's exits
        StmtKind.Unsafe =>
            # AGAST #2248: the body runs in place, as ritz0's _emit_unsafe_block.
            # No drop scope is opened there either, so its bindings and defers
            # belong to the enclosing block.  It is a statement, not a value.
            emit_void_body(s, stmt.while_body, ret_type)
            clear_last_expr(s)
        StmtKind.Assign =>
            emit_assign(s, stmt)
        StmtKind.Return =>
            # AGAST #2207: a `return` leaves the let initialiser it sits in, so the
            # let's enum context does not apply to it. With none set,
            # resolve_enum_ctx falls back to the fn's return type.
            let ret_ctx_name: *u8 = s.ctx_enum_name
            let ret_ctx_len: i32 = s.ctx_enum_name_len
            s.ctx_enum_name = null
            s.ctx_enum_name_len = 0
            # So does the slot's: a `return` lands in the fn's return type.
            let ret_slot_set: i32 = s.ctx_slot_set
            s.ctx_slot_set = 0
            emit_return(s, stmt, ret_type)
            s.ctx_enum_name = ret_ctx_name
            s.ctx_enum_name_len = ret_ctx_len
            s.ctx_slot_set = ret_slot_set
        StmtKind.Assert =>
            # AGAST #1869: placement check, operand report, helper call site.
            emit_assert_stmt(s, stmt)
        StmtKind.If =>
            let discarded: i32 = if_stmt_is_discarded(s, stmt)   # AGAST #3749
            # AGAST #4590: a value-giving `if` moves its arms' values out.
            var arm_moves: i32 = 0
            if discarded == 0 and stmt.if_else != null
                arm_moves = 1
            # AGAST #3421: the float slot the value lands in (a `-> f64` fn's
            # tail), taken before the condition so a match there can't see it.
            # The arms settle against it (if_stmt_arm_float_settle).
            var fr: MatchResult
            match_result_init(@fr, 1)
            fr.float_ty = take_match_float_hint(s)
            fr.hint_ty = fr.float_ty
            let cond: i32 = emit_expr(s, stmt.if_cond)
            # Every condition value, a bool included, is an i64 register
            # (AGAST #1646; a bool global's load too since #3001), so coerce
            # it to i1 via `icmp ne ..., 0` for the `br`.  Skipping that for a
            # TypeKind.Bool condition wired an i64 into `br i1` (`if f()`, #1367).
            let cond_i1: i32 = next_reg(s)
            emit_str(s, IR_INDENT)
            emit_reg(s, cond_i1)
            emit_str(s, c" = icmp ne i64 ")
            emit_reg(s, cond)
            emit_str(s, IR_COMMA_0)

            let then_label: i32 = next_label(s)
            let else_label: i32 = next_label(s)
            let end_label: i32 = next_label(s)

            own_cond_end(s)   # AGAST #2165: the condition's temporaries
            emit_str(s, c"  br i1 ")
            emit_reg(s, cond_i1)
            emit_str(s, IR_LABEL_SEP)
            emit_label(s, then_label)
            emit_str(s, IR_LABEL_SEP)
            if stmt.if_else != null
                emit_label(s, else_label)
            else
                emit_label(s, end_label)
            emit_str(s, IR_NL)

            # Save current last_expr_reg before entering branches.  The defining
            # label rides along so the restore path below puts back a coherent
            # (value, block) pair rather than re-dating the value to the merge
            # block. (ritz-task-1309)
            let saved_last: i32 = s.last_expr_reg
            let saved_last_label: i32 = s.last_expr_label
            let saved_last_model: i32 = s.last_expr_model

            begin_block(s, then_label)
            clear_last_expr(s)  # Reset before then branch
            # AGAST #2158: each arm is a block for drops.
            own_push_scope(s)
            emit_if_stmt_arm(s, stmt.if_then, ret_type, discarded, fr.hint_ty, arm_moves)
            # AGAST #2559: the arm value's struct type, while its bindings resolve.
            var then_agg: *u8 = null
            var then_agg_len: i32 = 0
            if_stmt_arm_agg(s, stmt.if_then, @then_agg, @then_agg_len)
            own_pop_scope(s)
            # ritz-task-1309 — `last_expr_here` (not `s.last_expr_reg`) so a value
            # produced in a block nested inside the then-arm, which the insertion
            # point has since left, is reported as "no value" instead of being
            # falsely attributed to `then_exit_label` below.
            var then_result: i32 = last_expr_here(s)  # Capture then branch result
            # AGAST #2563: a Span$u8 / StrView arm takes the phi's type here.
            var then_phi: *u8 = null
            var then_phi_len: i32 = 0
            if_stmt_phi_type(s, StrView { ptr: (then_agg), len: (then_agg_len) as i64 }, ret_type, @then_phi, @then_phi_len)
            if stmt.if_else != null
                then_result = if_stmt_arm_settle(s, then_result, StrView { ptr: (then_agg), len: (then_agg_len) as i64 }, StrView { ptr: (then_phi), len: (then_phi_len) as i64 })
                then_result = if_stmt_arm_ptr_settle(s, stmt.if_then, then_result, then_agg)
                if discarded == 0
                    then_result = if_stmt_arm_float_settle(s, stmt.if_then, then_result, then_phi, @fr)
            let then_exit_label: i32 = s.current_label  # Capture actual exit block
            emit_str(s, IR_BR)
            emit_label(s, end_label)
            emit_str(s, IR_NL)

            var else_result: i32 = 0
            var else_exit_label: i32 = else_label
            var else_agg: *u8 = null
            var else_agg_len: i32 = 0
            if stmt.if_else != null
                begin_block(s, else_label)
                clear_last_expr(s)  # Reset before else branch
                own_push_scope(s)
                emit_if_stmt_arm(s, stmt.if_else, ret_type, discarded, fr.hint_ty, arm_moves)
                if_stmt_arm_agg(s, stmt.if_else, @else_agg, @else_agg_len)
                own_pop_scope(s)
                else_result = last_expr_here(s)  # Capture else branch result
                # AGAST #2563: the phi's type is the then-arm's when it has one.
                var else_phi: *u8 = null
                var else_phi_len: i32 = 0
                if_stmt_phi_type(s, StrView { ptr: (else_agg), len: (else_agg_len) as i64 }, ret_type, @else_phi, @else_phi_len)
                if then_phi != null and then_phi_len > 0
                    else_phi = then_phi
                    else_phi_len = then_phi_len
                else_result = if_stmt_arm_settle(s, else_result, StrView { ptr: (else_agg), len: (else_agg_len) as i64 }, StrView { ptr: (else_phi), len: (else_phi_len) as i64 })
                else_result = if_stmt_arm_ptr_settle(s, stmt.if_else, else_result, else_agg)
                if discarded == 0
                    else_result = if_stmt_arm_float_settle(s, stmt.if_else, else_result, else_phi, @fr)
                else_agg = else_phi
                else_agg_len = else_phi_len
                else_exit_label = s.current_label  # Capture actual exit block
                emit_str(s, IR_BR)
                emit_label(s, end_label)
                emit_str(s, IR_NL)

            begin_block(s, end_label)

            # If both branches produce values, emit a phi node.  When the
            # enclosing fn returns a tagged-enum struct, both branches hand us
            # `%Result$.../Option$...` struct values — the phi must match that
            # type or LLVM rejects the IR. (ritz-task-133)  Otherwise a struct
            # value in either arm types it (AGAST #2559): `if c / a / else / b`
            # over `%B` locals, params, literals and calls.
            var phi_agg: *u8 = null
            var phi_agg_len: i32 = 0
            # AGAST #3323: one arm may diverge; the other is the if's value.
            if stmt.if_else != null
                then_result = if_stmt_arm_incoming(then_result, stmt.if_then)
                else_result = if_stmt_arm_incoming(else_result, stmt.if_else)
                if then_result == IF_ARM_DIVERGES and else_result == IF_ARM_DIVERGES
                    then_result = 0   # both leave: no value reaches the merge
                    else_result = 0
                if discarded == 1   # AGAST #3749: nobody reads the value
                    then_result = 0
                    else_result = 0
            if stmt.if_else != null and then_result != 0 and else_result != 0
                if ret_type == TypeKind.Struct and s.ret_type_name_len > 0 and is_tagged_enum_type(StrView { ptr: (s.ret_type_name), len: (s.ret_type_name_len) as i64 }) == 1
                    phi_agg = s.ret_type_name
                    phi_agg_len = s.ret_type_name_len
                else if then_phi != null and then_phi_len > 0
                    phi_agg = then_phi
                    phi_agg_len = then_phi_len
                else if else_agg != null and else_agg_len > 0
                    phi_agg = else_agg
                    phi_agg_len = else_agg_len
            # AGAST #2559: publish it for an enclosing `if` ending in this one.
            s.last_if_stmt_agg_name = phi_agg
            s.last_if_stmt_agg_name_len = phi_agg_len
            if stmt.if_else != null and then_result != 0 and else_result != 0
                let phi_reg: i32 = next_reg(s)
                emit_str(s, IR_INDENT)
                emit_reg(s, phi_reg)
                emit_str(s, c" = phi ")
                # AGAST #3421: a scalar phi is the arms' float when they have one.
                var phi_float: TypeKind = TypeKind.Void
                if phi_agg == null
                    phi_float = fr.float_ty
                if phi_agg != null
                    emit_llvm_type_struct(s, TypeKind.Struct, StrView { ptr: (phi_agg), len: (phi_agg_len) as i64 })
                else if phi_float != TypeKind.Void
                    emit_str(s, float_llvm_name(phi_float))
                else
                    emit_str(s, c"i64")
                emit_str(s, c" [ ")
                emit_if_phi_incoming(s, then_result, phi_agg, phi_float)
                emit_str(s, c", %")
                emit_label(s, then_exit_label)
                emit_str(s, c" ], [ ")
                emit_if_phi_incoming(s, else_result, phi_agg, phi_float)
                emit_str(s, c", %")
                emit_label(s, else_exit_label)
                emit_str(s, c" ]\n")
                set_last_expr(s, phi_reg)
                # Published for an enclosing `if` / `match` this one ends.
                s.last_match_float_ty = phi_float
                if phi_agg == null and phi_float == TypeKind.Void
                    set_last_expr_phi(s, phi_reg, 0)   # AGAST #2950: an i64
            else
                # ritz-task-1309 — no phi, so this `if` contributes no value that
                # is live in the merge block.
                #
                # There used to be a `then_result > 0` case here that propagated
                # the then-arm's value out of the merge block.  That was one of
                # the two confirmed leak paths: `then_result` is defined in the
                # then-arm's exit block, which is NOT the merge block and does not
                # dominate it (the else edge bypasses it).  An enclosing `if` then
                # picked it up as a phi incoming and named the merge block as its
                # predecessor — the exact `phi i64 [ %x, %L20 ]` shape this task
                # exists to kill.  An if-without-else genuinely has no value on
                # all paths, so there is nothing correct to propagate.
                #
                # Restore the pre-`if` value with its original defining label, so
                # the pair stays coherent: still usable by an implicit return that
                # it dominates, still correctly rejected as a phi incoming here.
                s.last_expr_reg = saved_last  # Restore if no result
                s.last_expr_label = saved_last_label
                s.last_expr_model = saved_last_model

        StmtKind.While =>
            let cond_label: i32 = next_label(s)
            let body_label: i32 = next_label(s)
            let end_label: i32 = next_label(s)

            let old_break: i32 = s.break_label
            let old_continue: i32 = s.continue_label
            s.break_label = end_label
            s.continue_label = cond_label

            emit_str(s, IR_BR)
            emit_label(s, cond_label)
            emit_str(s, IR_NL)

            begin_block(s, cond_label)
            let cond: i32 = emit_expr(s, stmt.while_cond)
            # Narrowed to i1 for the `br`, as StmtKind.If does (AGAST #1367).
            let cond_i1: i32 = next_reg(s)
            emit_str(s, IR_INDENT)
            emit_reg(s, cond_i1)
            emit_str(s, c" = icmp ne i64 ")
            emit_reg(s, cond)
            emit_str(s, IR_COMMA_0)
            own_cond_end(s)   # AGAST #2165: dropped on every evaluation
            emit_str(s, c"  br i1 ")
            emit_reg(s, cond_i1)
            emit_str(s, IR_LABEL_SEP)
            emit_label(s, body_label)
            emit_str(s, IR_LABEL_SEP)
            emit_label(s, end_label)
            emit_str(s, IR_NL)

            begin_block(s, body_label)
            let own_loop: i32 = own_loop_enter(s)   # AGAST #2158
            own_push_scope(s)
            emit_void_body(s, stmt.while_body, ret_type)
            own_pop_scope(s)
            own_loop_exit(s, own_loop)
            emit_str(s, IR_BR)
            emit_label(s, cond_label)
            emit_str(s, IR_NL)

            begin_block(s, end_label)
            # AGAST #1329 — a loop contributes no value; clear the tracked
            # expression so it cannot leak into the exit block (see StmtKind.While
            # note; symmetric across while/loop/for).
            clear_last_expr(s)

            s.break_label = old_break
            s.continue_label = old_continue

        StmtKind.Loop =>
            # Infinite loop: loop { body }
            # Generates:
            #   br label %loop.body
            # loop.body:
            #   ... body ...
            #   br label %loop.body
            # loop.end:
            let body_label: i32 = next_label(s)
            let end_label: i32 = next_label(s)

            let old_break: i32 = s.break_label
            let old_continue: i32 = s.continue_label
            s.break_label = end_label
            s.continue_label = body_label

            emit_str(s, IR_BR)
            emit_label(s, body_label)
            emit_str(s, IR_NL)

            begin_block(s, body_label)
            let own_loop: i32 = own_loop_enter(s)   # AGAST #2158
            own_push_scope(s)
            emit_void_body(s, stmt.while_body, ret_type)
            own_pop_scope(s)
            own_loop_exit(s, own_loop)
            emit_str(s, IR_BR)
            emit_label(s, body_label)
            emit_str(s, IR_NL)

            begin_block(s, end_label)
            # AGAST #1329 — a loop contributes no value; clear the tracked
            # expression so it cannot leak into the exit block (see StmtKind.While
            # note; symmetric across while/loop/for).
            clear_last_expr(s)

            s.break_label = old_break
            s.continue_label = old_continue

        StmtKind.For =>
            # For-loop. Two shapes:
            #   for i in start..end   — range; for_end != null
            #   for x in iterable     — array/Vec-ref; for_end == null
            if stmt.for_end == null
                emit_for_iterable(s, stmt, ret_type)
                return

            # For-loop (range): for i in start..end { body }
            # Desugar to:
            #   %i = alloca i64
            #   store i64 %start, ptr %i
            #   br label %for.cond
            # for.cond:
            #   %i.val = load i64, ptr %i
            #   %cmp = icmp slt i64 %i.val, %end
            #   br i1 %cmp, label %for.body, label %for.end
            # for.body:
            #   ... body ...
            #   %i.next = add i64 %i.val, 1
            #   store i64 %i.next, ptr %i
            #   br label %for.cond
            # for.end:

            let cond_label: i32 = next_label(s)
            let body_label: i32 = next_label(s)
            let incr_label: i32 = next_label(s)
            let end_label: i32 = next_label(s)

            let old_break: i32 = s.break_label
            let old_continue: i32 = s.continue_label
            s.break_label = end_label
            s.continue_label = incr_label

            # AGAST #1636 / #3328: the range compares unsigned when a bound is a
            # u64, and the loop variable is then a u64 in the body, so `j / 2`
            # with `j = 1 << 63` is a udiv.  Decided once, from the bounds as they
            # read before `j` is bound, so the compare and the type can't disagree.
            var range_uns: i32 = for_range_unsigned(s, stmt)
            var var_type: TypeKind = TypeKind.I64
            if range_uns == 1
                var_type = TypeKind.U64
            # AGAST #4080: a narrower range binds its own type (for_range_type),
            # in a slot of that width: `for i in 1..n` with `n: i32` is an i32, as
            # on ritz0.  The start is truncated into it, and the compare and the
            # increment are at that width, as ritz0's are.
            let narrow_ty: TypeKind = for_range_var_type(s, stmt)
            if ty_int_bits(narrow_ty) > 0 and ty_int_bits(narrow_ty) < 64
                var_type = narrow_ty
                range_uns = ty_is_unsigned(narrow_ty)
            let var_llvm: *u8 = ty_mem_llvm(var_type)

            # Allocate loop variable
            let var_reg: i32 = next_reg(s)
            entry_alloca_reg_begin(s, var_reg)
            emit_str(s, var_llvm)
            emit_str(s, IR_NL)
            entry_alloca_reg_end(s)

            # Register the loop variable
            add_local(s, StrView { ptr: (stmt.for_var), len: (stmt.for_var_len) as i64 }, var_reg, var_type)

            # Emit start expression and store it
            let start_reg: i32 = for_bound_at(s, emit_expr(s, stmt.for_start), var_type)
            emit_str(s, IR_STORE_IND)
            emit_str(s, var_llvm)
            emit_str(s, IR_SP)
            emit_reg(s, start_reg)
            emit_str(s, IR_PTR_SEP)
            emit_reg(s, var_reg)
            emit_str(s, IR_NL)

            # Branch to condition check
            emit_str(s, IR_BR)
            emit_label(s, cond_label)
            emit_str(s, IR_NL)

            # Condition block
            begin_block(s, cond_label)
            let load_reg: i32 = next_reg(s)
            emit_str(s, IR_INDENT)
            emit_reg(s, load_reg)
            emit_str(s, IR_LOAD)
            emit_str(s, var_llvm)
            emit_str(s, IR_PTR_SEP)
            emit_reg(s, var_reg)
            emit_str(s, IR_NL)

            let end_reg: i32 = for_bound_at(s, emit_expr(s, stmt.for_end), var_type)
            let cmp_reg: i32 = next_reg(s)
            emit_str(s, IR_INDENT)
            emit_reg(s, cmp_reg)
            # `start..=end` (AGAST #1530) keeps iterating while i <= end; signed
            # or not by range_uns.
            if stmt.for_inclusive != 0
                if range_uns == 1
                    emit_str(s, c" = icmp ule ")
                else
                    emit_str(s, c" = icmp sle ")
            else
                if range_uns == 1
                    emit_str(s, c" = icmp ult ")
                else
                    emit_str(s, c" = icmp slt ")
            emit_str(s, var_llvm)
            emit_str(s, IR_SP)
            emit_reg(s, load_reg)
            emit_str(s, IR_COMMA)
            emit_reg(s, end_reg)
            emit_str(s, IR_NL)
            emit_str(s, c"  br i1 ")
            emit_reg(s, cmp_reg)
            emit_str(s, IR_LABEL_SEP)
            emit_label(s, body_label)
            emit_str(s, IR_LABEL_SEP)
            emit_label(s, end_label)
            emit_str(s, IR_NL)

            # Body block
            begin_block(s, body_label)
            let own_loop: i32 = own_loop_enter(s)   # AGAST #2158
            own_push_scope(s)
            emit_void_body(s, stmt.for_body, ret_type)
            own_pop_scope(s)
            own_loop_exit(s, own_loop)
            emit_str(s, IR_BR)
            emit_label(s, incr_label)
            emit_str(s, IR_NL)

            # Increment block
            begin_block(s, incr_label)
            let load2_reg: i32 = next_reg(s)
            emit_str(s, IR_INDENT)
            emit_reg(s, load2_reg)
            emit_str(s, IR_LOAD)
            emit_str(s, var_llvm)
            emit_str(s, IR_PTR_SEP)
            emit_reg(s, var_reg)
            emit_str(s, IR_NL)
            let incr_reg: i32 = next_reg(s)
            emit_str(s, IR_INDENT)
            emit_reg(s, incr_reg)
            emit_str(s, c" = add ")
            emit_str(s, var_llvm)
            emit_str(s, IR_SP)
            emit_reg(s, load2_reg)
            emit_str(s, IR_COMMA_1)
            emit_str(s, IR_STORE_IND)
            emit_str(s, var_llvm)
            emit_str(s, IR_SP)
            emit_reg(s, incr_reg)
            emit_str(s, IR_PTR_SEP)
            emit_reg(s, var_reg)
            emit_str(s, IR_NL)
            emit_str(s, IR_BR)
            emit_label(s, cond_label)
            emit_str(s, IR_NL)

            # End block
            begin_block(s, end_label)
            # AGAST #1329 — a loop contributes no value; clear the tracked
            # expression so it cannot leak into the exit block (see StmtKind.While
            # note; symmetric across while/loop/for).
            clear_last_expr(s)

            s.break_label = old_break
            s.continue_label = old_continue

        StmtKind.Break =>
            if s.break_label >= 0
                own_loop_jump(s, 0)   # AGAST #2158: drop the loop body's bindings
                emit_str(s, IR_BR)
                emit_label(s, s.break_label)
                emit_str(s, IR_NL)
                let dead_label: i32 = next_label(s)
                # `begin_block` makes the dead block the active insertion
                # point, so the enclosing IF/loop captures the right
                # `current_label` when building PHI predecessor labels.
                # Without this, then/else_exit labels point at the pre-break
                # block which isn't actually a CFG predecessor of the merge —
                # LLVM's "Remove unreachable blocks" pass then crashes when it
                # tries to remove the real (dead) predecessor from the PHI.
                # (ritz-task-195)
                begin_block(s, dead_label)
                clear_last_expr(s)

        StmtKind.Continue =>
            if s.continue_label >= 0
                own_loop_jump(s, 1)   # AGAST #2158
                emit_str(s, IR_BR)
                emit_label(s, s.continue_label)
                emit_str(s, IR_NL)
                let dead_label: i32 = next_label(s)
                # Same rationale as StmtKind.Break above. (ritz-task-195)
                begin_block(s, dead_label)
                clear_last_expr(s)

        StmtKind.Expr =>
            # Note: Implicit return only at function body level, not in nested blocks
            # The implicit_return flag would be passed from emit_fn for top-level statements
            # For now, we just emit the expression without implicit return in nested contexts
            if stmt.expr == null
                eprints("ERROR: STMT_EXPR with null expr field!\n")
            else
                # AGAST #2046: a match / if expression statement's value is
                # discarded, so a void-call arm is legal there.
                if stmt.expr.kind == ExprKind.Match or stmt.expr.kind == ExprKind.If
                    s.match_no_value = 1
                # (must_use_check and discarded_array_check run on Sema,
                # sema_walk.ritz, AGAST #3462 / #3512.)
                var expr_reg: i32 = 0
                let lent: *LocalVar = lent_referent_local(s, stmt.expr)
                if stmt == s.if_arm_value and lent != null
                    # AGAST #2288: an if arm's value (emit_if_stmt_arm).
                    expr_reg = emit_lent_referent(s, stmt.expr, StrView { ptr: (lv_type_name(lent)), len: (lv_type_name_len(lent)) as i64 })
                else if builtin_tagged_ctor(s, stmt.expr) == 1
                    expr_reg = emit_ctor_stmt(s, stmt.expr)   # AGAST #2454
                else
                    expr_reg = emit_expr(s, stmt.expr)
                set_last_expr(s, expr_reg)  # Track for if/else phi nodes
        StmtKind.Match =>
            # Statement-form match: `match scrut \n pattern => body ...`
            # The statement's result is tracked in last_expr_reg so an implicit
            # return picks up the phi value. See emitter_match.ritz.
            let arms: *MatchArm = stmt.if_then as *MatchArm
            s.match_no_value = 1   # AGAST #2046: void-call arms are legal here
            # AGAST #3028: a block's last statement may be its value; any other
            # match statement's value is read by nothing.
            if stmt.next != null
                match_discard_next()
            let match_reg: i32 = emit_match(s, stmt.if_cond, arms, stmt.span)
            set_last_expr(s, match_reg)
            # AGAST #2950: its phi is a `ptr` or an i64 (emit_match_phi_type).
            if match_reg > 0 and s.last_match_agg_name == null and s.last_match_float_ty == TypeKind.Void
                set_last_expr_phi(s, match_reg, arms_ptr_valued(s, arms))
        StmtKind.LocalFieldAssign =>
            # local_var.field = value
            # stmt.var_name = variable name
            # stmt.assign_target = field name
            # stmt.assign_value = value expression
            var lfa_done: bool = false
            let loc: *LocalVar = find_local_struct_name(s, StrView { ptr: (stmt.var_name), len: (stmt.var_name_len) as i64 })
            if loc != null
                let st: *StructDef = find_struct(s, StrView { ptr: (lv_type_name(loc)), len: (lv_type_name_len(loc)) as i64 })
                if st != null
                    let field_idx: i32 = find_field_index(st, StrView { ptr: (stmt.assign_target), len: (stmt.assign_target_len) as i64 })
                    if field_idx >= 0
                        let field: *StructField = get_field_type(st, field_idx)
                        lfa_done = true
                        # Get the base pointer - differs for TypeKind.Ptr/TypeKind.Ref/TypeKind.MutRef vs TypeKind.Struct
                        var base_ptr_reg: i32 = loc.reg
                        let lfa_levels: i32 = local_struct_levels(loc)
                        if lfa_levels > 0
                            # Load the pointer value, then convert to ptr
                            let loaded: i32 = next_reg(s)
                            emit_load_into(s, IR_TY_I64, loaded, loc.reg)
                            base_ptr_reg = next_reg(s)
                            emit_str(s, IR_INDENT)
                            emit_reg(s, base_ptr_reg)
                            emit_str(s, IR_INTTOPTR)
                            emit_reg(s, loaded)
                            emit_str(s, c" to ptr\n")
                            base_ptr_reg = emit_load_levels(s, base_ptr_reg, lfa_levels - 1)   # AGAST #2372
                        # Get pointer to the field using GEP
                        let field_ptr: i32 = next_reg(s)
                        emit_str(s, IR_INDENT)
                        emit_reg(s, field_ptr)
                        emit_str(s, IR_GEP_NAMED)
                        emit_name(s, StrView { ptr: (st.name), len: (st.name_len) as i64 })
                        emit_str(s, IR_PTR_SEP)
                        emit_reg(s, base_ptr_reg)
                        emit_str(s, IR_I32_ZERO)
                        emit_int(s, field_idx as i64)
                        emit_str(s, IR_NL)
                        # AGAST #1934: `x.f = [..]` / `p.f = [v; N]` on an inline
                        # array field.  The generic store below would write the
                        # ADDRESS of emit_expr's shadow alloca into the field.
                        if field.field_type == TypeKind.Array
                            emit_array_field_whole_assign(s, field_ptr, field, stmt.assign_value)
                            return
                        # Emit the value.  AGAST #2142: `f.cmap = None` builds
                        # the field's enum.
                        let val_reg: i32 = emit_expr_into_field(s, stmt.assign_value, field)
                        # LARB R58 (§13.6): through a reference (`r.t = v` on a
                        # local `@&T`, `h.t = v` on a `:& T` param) the field's
                        # old value drops after v, before the store.
                        if own_local_reach(loc) == OWN_REACH_REF
                            own_drop_old_ref_field(s, field_ptr, field)
                        # Store the value based on field type.
                        #
                        # AGAST #1303: narrow fields (u8/i8/u16/i16) used to fall
                        # through to the `store i64` default below.  Values are i64
                        # in the unified value model, so an 8-byte store into a
                        # 1- or 2-byte field silently clobbered every adjacent
                        # field.  `30_find`'s `opts.type_filter = 'f'` (u8) wiped
                        # the following `maxdepth: i32` from -1 to 0, so find
                        # printed the root and never descended — well-typed,
                        # compiled clean, exit 0, wrong behaviour.  Truncate to the
                        # field width before storing, as the other member-assign
                        # paths already do.
                        #
                        # AGAST #2048: f32 / f64 fields store float / double.
                        if emit_float_field_store(s, field_ptr, field.field_type, val_reg, stmt.assign_value) == 1
                            lfa_done = true
                        else if ty_int_bits(field.field_type) == 32
                            let trunc: i32 = ir_trunc_i64_i32(s.out, @s.reg_counter, val_reg)
                            emit_store_typed(s, IR_TY_I32, trunc, field_ptr)
                        else if ty_int_bits(field.field_type) == 16
                            let trunc16: i32 = ir_trunc_i64_i16(s.out, @s.reg_counter, val_reg)
                            emit_store_typed(s, IR_TY_I16, trunc16, field_ptr)
                        else if ty_int_bits(field.field_type) == 8
                            let trunc8: i32 = ir_trunc_i64_i8(s.out, @s.reg_counter, val_reg)
                            emit_store_typed(s, IR_TY_I8, trunc8, field_ptr)
                        else
                            match field.field_type
                                TypeKind.Bool =>
                                    let trunc1: i32 = ir_trunc_i64_i1(s.out, @s.reg_counter, val_reg)
                                    emit_store_typed(s, IR_TY_I1, trunc1, field_ptr)
                                TypeKind.Ptr | TypeKind.PtrPtr | TypeKind.Ref | TypeKind.MutRef =>
                                    # AGAST #1652: `h.p = s` with `s: @&S` is already a `ptr`,
                                    # and so is `h.r = @&a` into an `@&[N]T` (#2329).
                                    let ival: i32 = ptr_value_to_i64(s, stmt.assign_value, val_reg)
                                    let ptr_val: i32 = ir_inttoptr_ptr(s.out, @s.reg_counter, ival)
                                    emit_store_typed(s, IR_TY_PTR, ptr_val, field_ptr)
                                _ =>
                                    if field.field_type == TypeKind.Struct and field.field_type_name_len > 0
                                        # Struct field - store as struct type.  A bare "..."
                                        # is a %Span$u8: a StrView field needs it rebuilt as
                                        # %StrView first, as a struct literal does (#2412).
                                        let agg: i32 = coerce_struct_ret_value(s, stmt.assign_value, val_reg, StrView { ptr: (field.field_type_name), len: (field.field_type_name_len) as i64 })
                                        emit_struct_store_or_copy(s, TypeKind.Struct, StrView { ptr: (field.field_type_name), len: (field.field_type_name_len) as i64 }, agg, field_ptr)
                                    else
                                        emit_store_typed(s, IR_TY_I64, val_reg, field_ptr)
            # AGAST #1439: unresolved here -> shared member-store path.
            if not lfa_done
                emit_local_field_store_fallback(s, stmt, 0)
        _ =>
            if stmt.kind == StmtKind.LocalFieldIndexAssign and local_field_nd_shape(s, stmt) != null
                # AGAST #2097: `s.m[i] = v` with m an N-D field assigns a whole row
                # (`s.m[i][j] = v` is an expression assignment, see emit_assign).
                # AGAST #4666: copied over it (emit_nd_sub_store).
                var rf_var: Expr = Expr { kind: ExprKind.Ident, span: stmt.span, ident_ptr: stmt.var_name, ident_len: stmt.var_name_len }
                var rf_field: Expr = Expr { kind: ExprKind.Member, span: stmt.span, left: @rf_var, ident_ptr: stmt.assign_target, ident_len: stmt.assign_target_len }
                var rf_place: Expr = Expr { kind: ExprKind.Index, span: stmt.span, left: @rf_field, right: stmt.while_cond }
                emit_nd_stmt_row_store(s, stmt, @rf_place)
            else if stmt.kind == StmtKind.LocalFieldIndexAssign
                # local_var.field[index] = value
                # stmt.var_name = variable name
                # stmt.assign_target = field name
                # stmt.while_cond = index expression (reused)
                # stmt.assign_value = value expression
                var lfia_done: i32 = 0
                let loc: *LocalVar = find_local_struct_name(s, StrView { ptr: (stmt.var_name), len: (stmt.var_name_len) as i64 })
                if loc != null
                    let st: *StructDef = find_struct(s, StrView { ptr: (lv_type_name(loc)), len: (lv_type_name_len(loc)) as i64 })
                    if st != null
                        let field_idx: i32 = find_field_index(st, StrView { ptr: (stmt.assign_target), len: (stmt.assign_target_len) as i64 })
                        # AGAST #1596: a pointer field is not an inline array — the
                        # arm below GEP'd the field slot itself and wrote INTO the
                        # struct. Leave lfia_done = 0 so the fallback lowers it via
                        # emit_assign, which loads the pointer and indexes through it.
                        var lfia_field_is_ptr: i32 = 0
                        if field_idx >= 0
                            let pf: *StructField = get_field_type(st, field_idx)
                            if pf.field_type == TypeKind.Ptr or pf.field_type == TypeKind.PtrPtr
                                lfia_field_is_ptr = 1
                            # AGAST #2329: nor is an `@[N]T` / `@&[N]T` one, which
                            # lower_ref_fields leaves a reference.  `h.r[1] = 7` wrote
                            # into h.
                            if pf.ptr_array != null
                                lfia_field_is_ptr = 1
                            # AGAST #2564: nor is a Vec, Span or String held by value:
                            # emit_assign stores `t.v[i] = x` through its buffer, as
                            # index_through takes it.  `t.v[1] = 7` through a `t: @&T`
                            # wrote 7 into the Vec's len, SILENT, and a struct element
                            # was a `store i64` of a `%E` (invalid IR).
                            if pf.field_type == TypeKind.Struct and name_is_indexable(StrView { ptr: (pf.field_type_name), len: (pf.field_type_name_len) as i64 }) == 1
                                lfia_field_is_ptr = 1
                        if field_idx >= 0 and lfia_field_is_ptr == 0
                            let field: *StructField = get_field_type(st, field_idx)
                            lfia_done = 1
                            # Get the base pointer - differs for TypeKind.Ptr/TypeKind.Ref/TypeKind.MutRef vs TypeKind.Struct
                            var base_ptr_reg: i32 = loc.reg
                            let lfia_levels: i32 = local_struct_levels(loc)
                            if lfia_levels > 0
                                # Load the pointer value, then convert to ptr
                                let loaded: i32 = next_reg(s)
                                emit_load_into(s, IR_TY_I64, loaded, loc.reg)
                                base_ptr_reg = next_reg(s)
                                emit_str(s, IR_INDENT)
                                emit_reg(s, base_ptr_reg)
                                emit_str(s, IR_INTTOPTR)
                                emit_reg(s, loaded)
                                emit_str(s, c" to ptr\n")
                                base_ptr_reg = emit_load_levels(s, base_ptr_reg, lfia_levels - 1)   # AGAST #2372
                            # First GEP to get the field (array within struct)
                            let field_ptr: i32 = next_reg(s)
                            emit_str(s, IR_INDENT)
                            emit_reg(s, field_ptr)
                            emit_str(s, IR_GEP_NAMED)
                            emit_name(s, StrView { ptr: (st.name), len: (st.name_len) as i64 })
                            emit_str(s, IR_PTR_SEP)
                            emit_reg(s, base_ptr_reg)
                            emit_str(s, IR_I32_ZERO)
                            emit_int(s, field_idx as i64)
                            emit_str(s, IR_NL)
                            # Emit index expression
                            let idx_reg: i32 = emit_expr(s, stmt.while_cond)
                            # Emit value expression
                            let val_reg: i32 = emit_store_into_slot(s, stmt.assign_value, field.array_elem_type, StrView { ptr: (field.array_elem_type_name), len: (field.array_elem_type_name_len) as i64 })   # AGAST #2454, #2390
                            var lfia_base: Expr
                            memset(@lfia_base as *u8, 0, sizeof(Expr))
                            lfia_base.kind = ExprKind.Ident
                            lfia_base.span = stmt.span
                            lfia_base.ident_ptr = stmt.var_name
                            lfia_base.ident_len = stmt.var_name_len
                            var lfia_place: Expr
                            memset(@lfia_place as *u8, 0, sizeof(Expr))
                            lfia_place.kind = ExprKind.Member
                            lfia_place.span = stmt.span
                            lfia_place.left = @lfia_base
                            lfia_place.ident_ptr = stmt.assign_target
                            lfia_place.ident_len = stmt.assign_target_len
                            emit_field_array_elem_store(s, field_ptr, field, idx_reg, val_reg, stmt.assign_value, @lfia_place)
                # AGAST #1439: unresolved here -> shared member-store path.
                if lfia_done == 0
                    emit_local_field_store_fallback(s, stmt, 1)
            else if stmt.kind == StmtKind.IndexAssign and emit_through_index_assign(s, stmt) == 1
                # AGAST #2440: `p[i] = v` through a reference or pointer.
                return
            else if stmt.kind == StmtKind.IndexAssign and nd_array_name_shape(s, StrView { ptr: (stmt.assign_target), len: (stmt.assign_target_len) as i64 }) != null
                # AGAST #1509: `g[i] = v` with g multi-dimensional assigns a whole
                # row (`g[i][j] = v` is an expression assignment, see emit_assign).
                # AGAST #4666: copied over it (emit_nd_sub_store).
                var rg_var: Expr = Expr { kind: ExprKind.Ident, span: stmt.span, ident_ptr: stmt.assign_target, ident_len: stmt.assign_target_len }
                var rg_place: Expr = Expr { kind: ExprKind.Index, span: stmt.span, left: @rg_var, right: stmt.while_cond }
                emit_nd_stmt_row_store(s, stmt, @rg_place)
            else if stmt.kind == StmtKind.IndexAssign and array_ptr_named(s, StrView { ptr: (stmt.assign_target), len: (stmt.assign_target_len) as i64 }) != null
                # AGAST #2321: refused, as ritz0 refuses a scalar here.  It stored an i64
                # at stride 8: past the element, and past the array at the top end.
                # ritz0 takes a whole `[N]T` at stride `[N]T`, against its own read, so
                # that isn't lowered either (#2330).
                emit_nd_error(s, stmt.span.line, stmt.span.col, c"`p[i] = v` through a pointer to an array is refused (`*p = a` stores the whole array)")
            else
                match stmt.kind
                    StmtKind.IndexAssign =>
                        # name[index] = value (array or pointer index assignment)
                        # stmt.assign_target = base variable name (as *u8)
                        # stmt.assign_target_len = name length
                        # stmt.while_cond = index expression (reused field)
                        # stmt.assign_value = value expression
                        let base_reg: i32 = find_local(s, StrView { ptr: (stmt.assign_target), len: (stmt.assign_target_len) as i64 })
                        let base_type: TypeKind = find_local_type(s, StrView { ptr: (stmt.assign_target), len: (stmt.assign_target_len) as i64 })
                        let local: *LocalVar = find_local_struct_name(s, StrView { ptr: (stmt.assign_target), len: (stmt.assign_target_len) as i64 })
                        if base_reg >= 0
                            if base_type == TypeKind.Array and local != null
                                # Array local - use GEP [0, index] to get element
                                let idx_reg: i32 = emit_expr(s, stmt.while_cond)
                                let val_reg: i32 = emit_store_into_slot(s, stmt.assign_value, lv_array_elem_type(local), StrView { ptr: (lv_type_name(local)), len: (lv_type_name_len(local)) as i64 })   # AGAST #2454, #2390
                                let elem_ptr: i32 = next_reg(s)
                                emit_str(s, IR_INDENT)
                                emit_reg(s, elem_ptr)
                                emit_str(s, IR_GEP_ARRAY)
                                emit_int(s, lv_array_size(local) as i64)
                                emit_str(s, IR_X)
                                # AGAST #1564: every non-struct element uses the alloca's own
                                # spelling (array_elem_llvm); u32/u16/i16 used to fall to i64.
                                let elem_ty: *u8 = elem_mem_llvm(lv_array_elem_type(local))
                                if lv_array_elem_type(local) == TypeKind.Struct and lv_type_name_len(local) > 0
                                    # AGAST #190: struct-array LHS — emit `[N x %T]` so the
                                    # GEP and the store agree with the actual element layout.
                                    # Mirrors #188's StmtKind.LocalFieldIndexAssign fix but on
                                    # the simpler "local IS the array" path (no enclosing
                                    # struct member).  Surfaces in nexus encode_page where
                                    # `var fields: [2]DbField; fields[i] = db_field(...)`
                                    # was emitting `[2 x i64]` GEP / `store i64 %DbField`.
                                    emit_llvm_type_struct(s, TypeKind.Struct, StrView { ptr: (lv_type_name(local)), len: (lv_type_name_len(local)) as i64 })
                                else
                                    emit_str(s, elem_ty)
                                emit_str(s, IR_RBRACK_PTR)
                                emit_reg(s, base_reg)
                                emit_str(s, IR_I64_ZERO)
                                emit_reg(s, idx_reg)
                                emit_str(s, IR_NL)
                                if lv_array_elem_type(local) == TypeKind.Struct and lv_type_name_len(local) > 0
                                    # AGAST #3377 (LARB R39): the old element drops first.
                                    var ia_place: Expr
                                    memset(@ia_place as *u8, 0, sizeof(Expr))
                                    ia_place.kind = ExprKind.Ident
                                    ia_place.span = stmt.span
                                    ia_place.ident_ptr = stmt.assign_target
                                    ia_place.ident_len = stmt.assign_target_len
                                    own_drop_old_elem(s, @ia_place, elem_ptr, StrView { ptr: (lv_type_name(local)), len: (lv_type_name_len(local)) as i64 })
                                    # AGAST #190: struct-array element store — `store %T %val`
                                    # matches the value loaded/returned as the element struct
                                    # type (e.g. `%DbField` from `call %DbField @db_field(..)`).
                                    emit_struct_store_or_copy(s, TypeKind.Struct, StrView { ptr: (lv_type_name(local)), len: (lv_type_name_len(local)) as i64 }, val_reg, elem_ptr)
                                else
                                    # Store at the element width: narrow ints truncate, pointers
                                    # convert back to ptr, i64 stores as-is; an f64 value into
                                    # an f32 element is fptrunc'd (#1966).
                                    var store_val: i32 = val_reg
                                    if array_elem_typed_scalar(lv_array_elem_type(local)) == 1
                                        store_val = emit_field_elem_narrow(s, val_reg, lv_array_elem_type(local), stmt.assign_value)
                                    else if lv_array_elem_type(local) == TypeKind.Ref or lv_array_elem_type(local) == TypeKind.MutRef
                                        store_val = ptr_value_to_i64(s, stmt.assign_value, val_reg)   # AGAST #2369: `a[i] = @&x`
                                    else if (lv_array_elem_type(local) == TypeKind.Ptr or lv_array_elem_type(local) == TypeKind.PtrPtr) and expr_is_ptr_valued(s, stmt.assign_value) == 1
                                        store_val = val_reg   # AGAST #3036: `a[i] = @&x` into `[N]*T`: a `ptr` already
                                    else
                                        store_val = emit_array_elem_narrow(s, val_reg, lv_array_elem_type(local), elem_ty)
                                    emit_str(s, IR_STORE_IND)
                                    emit_str(s, elem_ty)
                                    emit_str(s, IR_SP)
                                    emit_reg(s, store_val)
                                    emit_str(s, IR_PTR_SEP)
                                    emit_reg(s, elem_ptr)
                                    emit_str(s, IR_NL)
                            else
                                # Pointer local — load the i64 slot, convert to ptr, then
                                # GEP + store at the POINTEE's width (AGAST #1332; this was
                                # hardcoded `getelementptr i64` + `store i64` for every
                                # non-** pointer, byte-smearing *i32/*u8 stores).
                                let loaded_i64: i32 = next_reg(s)
                                emit_load_into(s, IR_TY_I64, loaded_i64, base_reg)
                                let base_ptr: i32 = ir_inttoptr_ptr(s.out, @s.reg_counter, loaded_i64)
                                var pointee: TypeKind = TypeKind.Unknown
                                var pst_name: *u8 = null
                                var pst_len: i32 = 0
                                if local != null
                                    pointee = lv_pointee_type(local)
                                    pst_name = lv_type_name(local)
                                    pst_len = lv_type_name_len(local)
                                emit_index_assign_ptr_store(s, stmt, base_ptr, base_type, pointee, StrView { ptr: (pst_name), len: (pst_len) as i64 })
                        else
                            # AGAST #1332: GLOBAL pointer base.  Previously `base_reg >= 0`
                            # had no else, so `g[i] = v` through a global *T / **T emitted
                            # NO store at all — a silent drop that read back as malloc
                            # garbage (7/8–8/8 mismatches in 92_subscript_store).
                            let glob: *GlobalVarDef = find_global(s, StrView { ptr: (stmt.assign_target), len: (stmt.assign_target_len) as i64 })
                            if glob != null and glob.var_type == TypeKind.Array and glob.array_elem_type == TypeKind.Struct and glob.array_elem_type_name_len > 0
                                # AGAST #1553/#1555: a whole struct element (`g[i] = q`,
                                # `g_slot[2] = *v`, `g[i] = g[j]`). The value is a %T struct
                                # value, so GEP the `[N x %T]` global and `store %T` — the
                                # global form of the local-array struct arm (#190) above.
                                # Previously this fell to the pointer arm below: `load i64
                                # @g` as a base address and `store i64 %T-value` (bad IR).
                                let sidx: i32 = emit_expr(s, stmt.while_cond)
                                let sval: i32 = emit_store_into_slot(s, stmt.assign_value, TypeKind.Struct, StrView { ptr: (glob.array_elem_type_name), len: (glob.array_elem_type_name_len) as i64 })   # AGAST #2454, #2390
                                let sptr: i32 = next_reg(s)
                                emit_str(s, IR_INDENT)
                                emit_reg(s, sptr)
                                emit_str(s, IR_GEP_ARRAY)
                                emit_int(s, glob.array_size as i64)
                                emit_str(s, IR_X)
                                emit_llvm_type_struct(s, TypeKind.Struct, StrView { ptr: (glob.array_elem_type_name), len: (glob.array_elem_type_name_len) as i64 })
                                emit_str(s, c"], ptr @")
                                emit_name(s, StrView { ptr: (glob.name), len: (glob.name_len) as i64 })
                                emit_str(s, IR_I64_ZERO)
                                emit_reg(s, sidx)
                                emit_str(s, IR_NL)
                                emit_struct_store_or_copy(s, TypeKind.Struct, StrView { ptr: (glob.array_elem_type_name), len: (glob.array_elem_type_name_len) as i64 }, sval, sptr)
                            else if glob != null and glob.var_type == TypeKind.Array and glob.array_elem_type != TypeKind.Struct
                                # AGAST #1504: a global `[N]T` array is the storage itself,
                                # not a pointer slot. The pointer arm below loaded g[0] as a
                                # base address and stored through it (segfault). GEP @g
                                # directly, at the width the global is declared with.
                                let gidx: i32 = emit_expr(s, stmt.while_cond)
                                set_match_float_hint(s, stmt.assign_value, glob.array_elem_type, StrView { ptr: (null), len: (0) as i64 })   # AGAST #4028
                                let gval: i32 = emit_expr(s, stmt.assign_value)
                                let gty: *u8 = elem_mem_llvm(glob.array_elem_type)
                                let gptr: i32 = next_reg(s)
                                emit_str(s, IR_INDENT)
                                emit_reg(s, gptr)
                                emit_str(s, IR_GEP_ARRAY)
                                emit_int(s, glob.array_size as i64)
                                emit_str(s, IR_X)
                                emit_str(s, gty)
                                emit_str(s, c"], ptr @")
                                emit_name(s, StrView { ptr: (glob.name), len: (glob.name_len) as i64 })
                                emit_str(s, IR_I64_ZERO)
                                emit_reg(s, gidx)
                                emit_str(s, IR_NL)
                                # Values are carried as i64: narrow ints truncate, pointers
                                # convert back to ptr, i64 stores as-is.
                                let get: TypeKind = glob.array_elem_type
                                var gstore: i32 = gval
                                if (get == TypeKind.Ptr or get == TypeKind.PtrPtr) and expr_is_ptr_valued(s, stmt.assign_value) == 1
                                    gstore = gval   # AGAST #3036: `g[i] = @&x` into `[N]*T`: a `ptr` already
                                else if get == TypeKind.Ptr or get == TypeKind.PtrPtr
                                    gstore = next_reg(s)
                                    emit_str(s, IR_INDENT)
                                    emit_reg(s, gstore)
                                    emit_str(s, IR_INTTOPTR)
                                    emit_reg(s, gval)
                                    emit_str(s, c" to ptr\n")
                                else if ty_int_in(get, 8, 32) == 1
                                    gstore = next_reg(s)
                                    emit_str(s, IR_INDENT)
                                    emit_reg(s, gstore)
                                    emit_str(s, IR_TRUNC)
                                    emit_reg(s, gval)
                                    emit_str(s, IR_TO_SP)
                                    emit_str(s, gty)
                                    emit_str(s, IR_NL)
                                else if array_elem_typed_scalar(get) == 1
                                    # AGAST #1970: a float / double slot; an f64 value into
                                    # an f32 element is fptrunc'd, as for a local array.  A
                                    # bool element is an `i1` (#2063).
                                    gstore = emit_field_elem_narrow(s, gval, get, stmt.assign_value)
                                emit_str(s, IR_STORE_IND)
                                emit_str(s, gty)
                                emit_str(s, IR_SP)
                                emit_reg(s, gstore)
                                emit_str(s, IR_PTR_SEP)
                                emit_reg(s, gptr)
                                emit_str(s, IR_NL)
                            else if glob != null
                                # Globals of pointer type are stored as i64 (emit_llvm_type):
                                # load the slot, convert to ptr, then share the pointee-width
                                # store path with the local arm.
                                let gloaded: i32 = next_reg(s)
                                emit_load_global(s, IR_TY_I64, gloaded, StrView { ptr: (glob.name), len: (glob.name_len) as i64 })
                                let gbase_ptr: i32 = ir_inttoptr_ptr(s.out, @s.reg_counter, gloaded)
                                emit_index_assign_ptr_store(s, stmt, gbase_ptr, glob.var_type, glob.pointee_type, StrView { ptr: (glob.pointee_type_name), len: (glob.pointee_type_name_len) as i64 })
                    StmtKind.MemberAssign =>
                        # `(*X).field = value` (and the desugared `(*X).field op= value`):
                        # stmt.if_cond = X, stmt.assign_target = field name,
                        # stmt.assign_value = value expression.
                        #
                        # AGAST #1510: lower as an expression assignment to the member
                        # `(*X).field`, so emit_assign resolves it through emit_member_ptr
                        # like every other field store.  The old inline lowering only knew a
                        # bare-identifier X; for `(**pp).n = v` or `(*(*b).ops).n = v` it
                        # evaluated X and then emitted NO store and no error -- the write was
                        # silently dropped.  An unresolvable X now fails loudly in
                        # emit_assign ("unhandled EXPR_MEMBER in assignment").
                        var mdr: Expr
                        mdr.kind = ExprKind.Unary
                        mdr.span = stmt.span
                        mdr.op = OpKind.Deref
                        mdr.operand = stmt.if_cond
                        mdr.next = null
                        var mmem: Expr
                        mmem.kind = ExprKind.Member
                        mmem.span = stmt.span
                        mmem.left = @mdr
                        mmem.ident_ptr = stmt.assign_target
                        mmem.ident_len = stmt.assign_target_len
                        mmem.next = null
                        var mst: Stmt
                        mst.kind = StmtKind.Assign
                        mst.span = stmt.span
                        mst.if_cond = @mmem
                        mst.assign_target = null
                        mst.assign_target_len = 0
                        mst.assign_value = stmt.assign_value
                        mst.next = null
                        emit_assign(s, @mst)
                    StmtKind.MemberIndexAssign =>
                        # `(*X).field[i] = value` (and the desugared `op=` form):
                        # stmt.if_cond = X, stmt.assign_target = field name,
                        # stmt.while_cond = index, stmt.assign_value = value.
                        #
                        # AGAST #1927: this kind had no arm, so it failed with "unhandled
                        # statement kind 8" even outside a generic fn.  Lower it like
                        # StmtKind.MemberAssign above, as an expression assignment to
                        # `(*X).field[i]`; emit_assign resolves the element through
                        # emit_member_ptr (inline array fields at their declared width,
                        # pointer fields through the loaded pointer).
                        var xdr: Expr
                        xdr.kind = ExprKind.Unary
                        xdr.span = stmt.span
                        xdr.op = OpKind.Deref
                        xdr.operand = stmt.if_cond
                        xdr.next = null
                        var xmem: Expr
                        xmem.kind = ExprKind.Member
                        xmem.span = stmt.span
                        xmem.left = @xdr
                        xmem.ident_ptr = stmt.assign_target
                        xmem.ident_len = stmt.assign_target_len
                        xmem.next = null
                        var xidx: Expr
                        xidx.kind = ExprKind.Index
                        xidx.bracket.line = 0
                        xidx.span = stmt.span
                        xidx.left = @xmem
                        xidx.right = stmt.while_cond
                        xidx.next = null
                        var xst: Stmt
                        xst.kind = StmtKind.Assign
                        xst.span = stmt.span
                        xst.if_cond = @xidx
                        xst.assign_target = null
                        xst.assign_target_len = 0
                        xst.assign_value = stmt.assign_value
                        xst.next = null
                        emit_assign(s, @xst)
                    StmtKind.Asm =>
                        emit_asm_block(s, stmt)   # LANGUAGE_SPEC §18.6 (AGAST #3395)
                    StmtKind.Stripped =>
                        # G9b: only an imported, non-generic fn has this body, and those are
                        # declared, never defined.  Reaching here means a body the importer
                        # instantiates (generic) was stripped: refuse, don't emit `ret 0`.
                        emit_ir_error(s, stmt.span, c"body stripped from an imported module interface (G9b)")
                    _ =>
                        # AGAST #1813: this was an IR comment and exit 0,
                        # so the statement silently vanished (the #1369 class).
                        emit_ir_error_kind(s, stmt.span, c"unhandled statement kind ", (stmt.kind as i32))

# =============================================================================
# Function Emission
# =============================================================================

