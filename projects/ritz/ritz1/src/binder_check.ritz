# binder_check.ritz - a local can't take a module value's name (AGAST #2407,
# LARB R12), nor a name already in scope in its fn (AGAST #2395)
#
# A local binding (`let`, `var`, a param, a `for` variable, a variant
# payload's name) that takes the name of a `const`, a global `var` or an enum
# variant, declared in the file or imported, is a located error at the name
# (LANGUAGE_SPEC §4.3).  With no local named like one, a bare read of the name
# has one meaning, and there is no lookup order to get wrong.
#
# A bare top-level arm name is a binding only where it isn't a test: against
# an enum it is that enum's variant, against an integer a const compares
# (§8.2).  Only the match lowering knows the scrutinee, so it judges those
# with binder_arm_refuse (emitter_match.ritz).  Every other binder is judged
# here, before monomorphisation, so a generic fn is judged whether or not
# anything instantiates it, and once.
#
# Nor can a binding reuse a name still in scope in its fn: an enclosing
# block's, the same block's, a param's, a `for` variable's or an arm's
# (LANGUAGE_SPEC §4.3, Aaron 2026-11-06 and 2026-11-08).  `_` binds nothing.
# A name whose binding has gone out of scope is free again.
#
# Fn names are free: a call says it wants a fn.  ritz0's twin is
# ritz0/binder_names.py; ritz0/test_local_takes_module_name.py and
# test_local_reuses_a_name.py hold the three compilers to one table, messages
# and positions included.

import ritzlib.cstr
import ritzlib.sys
import ritzlib.io
import ritzlib.hash
import ritzlib.hashmap
import ritzlib.memory

import ast
import ast_helpers
import ast_query     # name_eq (AGAST #4376: was resolved through emitter_core's
                     # pub import; binder_mark_decl moved to emitter_stmt)

const BINDER_NONE: i32 = 0
const BINDER_CONST: i32 = 1
const BINDER_GLOBAL: i32 = 2
const BINDER_VARIANT: i32 = 3

# fnv1a(name) -> a BINDER_* kind, a hint only: a hit is confirmed by
# binder_kind_exact, since the map is keyed by the hash alone.
var g_binder_map: *HashMapI64 = null
var g_binder_module: *Module = null

fn binder_is_builtin_variant(name_sv: StrView) -> i32
    var name: *u8 = name_sv.ptr
    var len: i32 = name_sv.len as i32
    if name_eq(StrView { ptr: (name), len: (len) as i64 }, StrView { ptr: (c"Some"), len: (4) as i64 }) == 1 or name_eq(StrView { ptr: (name), len: (len) as i64 }, StrView { ptr: (c"None"), len: (4) as i64 }) == 1
        return 1
    (name_eq(StrView { ptr: (name), len: (len) as i64 }, StrView { ptr: (c"Ok"), len: (2) as i64 }) == 1 or name_eq(StrView { ptr: (name), len: (len) as i64 }, StrView { ptr: (c"Err"), len: (3) as i64 }) == 1) as i32

fn binder_is_variant(ctx: *ParseCtx, name_sv: StrView) -> i32
    var name: *u8 = name_sv.ptr
    var len: i32 = name_sv.len as i32
    if binder_is_builtin_variant(StrView { ptr: (name), len: (len) as i64 }) == 1
        return 1
    var ei: i32 = 0
    while ei < enum_count(ctx)
        var vi: i32 = 0
        while vi < enum_variant_count(ctx, ei)
            var vlen: i32 = 0
            let vname: *u8 = enum_variant_name(ctx, ei, vi, @vlen)
            if name_eq(StrView { ptr: (vname), len: (vlen) as i64 }, StrView { ptr: (name), len: (len) as i64 }) == 1
                return 1
            vi = vi + 1
        ei = ei + 1
    0

# What `name` is, by the lists themselves: a const outranks a global, and both
# a variant.
fn binder_kind_exact(ctx: *ParseCtx, m: *Module, name_sv: StrView) -> i32
    var name: *u8 = name_sv.ptr
    var len: i32 = name_sv.len as i32
    var c: *ConstEntry = m.constants
    while c != null
        if name_eq(StrView { ptr: (c.name), len: (c.name_len) as i64 }, StrView { ptr: (name), len: (len) as i64 }) == 1
            return BINDER_CONST
        c = c.next
    var g: *GlobalVarDef = m.globals
    while g != null
        if name_eq(StrView { ptr: (g.name), len: (g.name_len) as i64 }, StrView { ptr: (name), len: (len) as i64 }) == 1
            return BINDER_GLOBAL
        g = g.next
    if binder_is_variant(ctx, StrView { ptr: (name), len: (len) as i64 }) == 1
        return BINDER_VARIANT
    BINDER_NONE

fn binder_map_note(name_sv: StrView, kind: i32)
    var name: *u8 = name_sv.ptr
    var len: i32 = name_sv.len as i32
    (*g_binder_map).insert(fnv1a_str(Span<u8> { ptr: (name), len: (len) as i64 }) as i64, kind as i64)

# The table every lookup reads: built once, from the merged module.
fn binder_build_map(ctx: *ParseCtx, m: *Module)
    g_binder_module = m
    g_binder_map = malloc(sizeof(HashMapI64)) as *HashMapI64
    *g_binder_map = hashmap_i64_with_cap(1024)
    binder_map_note(StrView { ptr: (c"Some"), len: (4) as i64 }, BINDER_VARIANT)
    binder_map_note(StrView { ptr: (c"None"), len: (4) as i64 }, BINDER_VARIANT)
    binder_map_note(StrView { ptr: (c"Ok"), len: (2) as i64 }, BINDER_VARIANT)
    binder_map_note(StrView { ptr: (c"Err"), len: (3) as i64 }, BINDER_VARIANT)
    var ei: i32 = 0
    while ei < enum_count(ctx)
        var vi: i32 = 0
        while vi < enum_variant_count(ctx, ei)
            var vlen: i32 = 0
            let vname: *u8 = enum_variant_name(ctx, ei, vi, @vlen)
            binder_map_note(StrView { ptr: (vname), len: (vlen) as i64 }, BINDER_VARIANT)
            vi = vi + 1
        ei = ei + 1
    var g: *GlobalVarDef = m.globals
    while g != null
        binder_map_note(StrView { ptr: (g.name), len: (g.name_len) as i64 }, BINDER_GLOBAL)
        g = g.next
    var c: *ConstEntry = m.constants
    while c != null
        binder_map_note(StrView { ptr: (c.name), len: (c.name_len) as i64 }, BINDER_CONST)
        c = c.next

# The BINDER_* kind of module value `name` names, BINDER_NONE for none.
pub fn binder_module_value_kind(ctx: *ParseCtx, name_sv: StrView) -> i32
    var name: *u8 = name_sv.ptr
    var len: i32 = name_sv.len as i32
    if g_binder_module == null or name == null or len <= 0
        return BINDER_NONE
    if (*g_binder_map).get(fnv1a_str(Span<u8> { ptr: (name), len: (len) as i64 }) as i64).unwrap_or(0) == 0
        return BINDER_NONE
    binder_kind_exact(ctx, g_binder_module, StrView { ptr: (name), len: (len) as i64 })

fn binder_kind_word(kind: i32) -> *u8
    if kind == BINDER_CONST
        return c"const"
    if kind == BINDER_GLOBAL
        return c"global"
    c"variant"

# `file:line:col: error: a local can't take the name of a <kind>: '<name>' —
# rename the local`, for a binder of kind `kind`.  Returns 1 (one error).
pub fn binder_report(file: *u8, line: i32, col: i32, name_sv: StrView, kind: i32) -> i32
    var name: *u8 = name_sv.ptr
    var len: i32 = name_sv.len as i32
    eprints_cstr(file)
    eprint_char(':')
    eprint_i64(line as i64)
    eprint_char(':')
    eprint_i64(col as i64)
    eprints(": error: a local can't take the name of a ")
    eprints_cstr(binder_kind_word(kind))
    eprints(": '")
    eprint_bytes(StrView { ptr: (name), len: (len) as i64 })
    eprints("' — rename the local\n")
    1

# --- A local can't reuse a name still in scope (AGAST #2395) ------------------
#
# The names in scope while one fn is walked, innermost last: a block, a `for`
# or an arm saves g_scope_top on entry and puts it back on exit.  A fn holding
# more than BINDER_SCOPE_CAP names in scope at once has the rest unjudged.
const BINDER_SCOPE_CAP: i32 = 8192
var g_scope_name: [8192]*u8
var g_scope_len: [8192]i32
var g_scope_line: [8192]i32
var g_scope_col: [8192]i32
var g_scope_top: i32 = 0

# The slot of the innermost name in scope that is `name`, -1 for none.
fn binder_scope_find(name_sv: StrView) -> i32
    var name: *u8 = name_sv.ptr
    var len: i32 = name_sv.len as i32
    var i: i32 = g_scope_top - 1
    while i >= 0
        if name_eq(StrView { ptr: (g_scope_name[i]), len: (g_scope_len[i]) as i64 }, StrView { ptr: (name), len: (len) as i64 }) == 1
            return i
        i = i - 1
    0 - 1

fn binder_is_wildcard(name_sv: StrView) -> i32
    var name: *u8 = name_sv.ptr
    var len: i32 = name_sv.len as i32
    (len == 1 and *name == '_') as i32

# `file:line:col: error: a local can't reuse a name bound earlier in its fn:
# '<name>' (at L:C) — rename the local`.  Returns 1 (one error).
fn binder_reuse_report(file: *u8, span: SrcSpan, name_sv: StrView, at_line: i32, at_col: i32) -> i32
    var name: *u8 = name_sv.ptr
    var len: i32 = name_sv.len as i32
    eprints_cstr(file)
    eprint_char(':')
    eprint_i64(span.line as i64)
    eprint_char(':')
    eprint_i64(span.col as i64)
    eprints(": error: a local can't reuse a name bound earlier in its fn: '")
    eprint_bytes(StrView { ptr: (name), len: (len) as i64 })
    eprints("' (at ")
    eprint_i64(at_line as i64)
    eprint_char(':')
    eprint_i64(at_col as i64)
    eprints(") — rename the local\n")
    1

# 1 when `name` takes a module value's name or one still in scope, after
# saying so.  `_` is never bound (binder_bind), so it passes.
fn binder_judge(ctx: *ParseCtx, file: *u8, span: SrcSpan, name_sv: StrView) -> i32
    var name: *u8 = name_sv.ptr
    var len: i32 = name_sv.len as i32
    if name == null or len <= 0
        return 0
    let kind: i32 = binder_module_value_kind(ctx, StrView { ptr: (name), len: (len) as i64 })
    if kind != BINDER_NONE
        return binder_report(file, span.line, span.col, StrView { ptr: (name), len: (len) as i64 }, kind)
    let at: i32 = binder_scope_find(StrView { ptr: (name), len: (len) as i64 })
    if at < 0
        return 0
    binder_reuse_report(file, span, StrView { ptr: (name), len: (len) as i64 }, g_scope_line[at], g_scope_col[at])

# Put `name` in scope.  A module value's name is never a local's.
fn binder_bind(ctx: *ParseCtx, span: SrcSpan, name_sv: StrView)
    var name: *u8 = name_sv.ptr
    var len: i32 = name_sv.len as i32
    if name == null or len <= 0 or binder_is_wildcard(StrView { ptr: (name), len: (len) as i64 }) == 1
        return
    if binder_module_value_kind(ctx, StrView { ptr: (name), len: (len) as i64 }) != BINDER_NONE or g_scope_top >= BINDER_SCOPE_CAP
        return
    g_scope_name[g_scope_top] = name
    g_scope_len[g_scope_top] = len
    g_scope_line[g_scope_top] = span.line
    g_scope_col[g_scope_top] = span.col
    g_scope_top = g_scope_top + 1

# AGAST #109: the names of tuple decl `s` after its second.  Each is judged
# as the first two are, and against the names before it in `s` (none is
# bound yet), as ritz0's binder_names does: `let (a, b, a)` reuses `a`.
fn binder_check_tail(ctx: *ParseCtx, file: *u8, s: *Stmt) -> i32
    var errors: i32 = 0
    var tn: *TupleName = s.tuple_more
    while tn != null
        let judged: i32 = binder_judge(ctx, file, tn.span, StrView { ptr: (tn.name), len: (tn.len) as i64 })
        errors = errors + judged
        if judged == 0 and binder_is_wildcard(StrView { ptr: (tn.name), len: (tn.len) as i64 }) == 0 and binder_module_value_kind(ctx, StrView { ptr: (tn.name), len: (tn.len) as i64 }) == BINDER_NONE
            var at: SrcSpan = s.name_span
            var hit: i32 = name_eq(StrView { ptr: (s.var_name), len: (s.var_name_len) as i64 }, StrView { ptr: (tn.name), len: (tn.len) as i64 })
            if hit == 0
                at = s.name2_span
                hit = name_eq(StrView { ptr: (s.assign_target), len: (s.assign_target_len) as i64 }, StrView { ptr: (tn.name), len: (tn.len) as i64 })
            var e: *TupleName = s.tuple_more
            while hit == 0 and e != tn
                at = e.span
                hit = name_eq(StrView { ptr: (e.name), len: (e.len) as i64 }, StrView { ptr: (tn.name), len: (tn.len) as i64 })
                e = e.next
            if hit == 1
                errors = errors + binder_reuse_report(file, tn.span, StrView { ptr: (tn.name), len: (tn.len) as i64 }, at.line, at.col)
        tn = tn.next
    errors

fn binder_judge_bind(ctx: *ParseCtx, file: *u8, span: SrcSpan, name_sv: StrView) -> i32
    var name: *u8 = name_sv.ptr
    var len: i32 = name_sv.len as i32
    let errors: i32 = binder_judge(ctx, file, span, StrView { ptr: (name), len: (len) as i64 })
    binder_bind(ctx, span, StrView { ptr: (name), len: (len) as i64 })
    errors

fn binder_check_arms(ctx: *ParseCtx, file: *u8, arms: *MatchArm) -> i32
    var errors: i32 = 0
    var arm: *MatchArm = arms
    while arm != null
        let mark: i32 = g_scope_top
        if arm.pattern_kind == PAT_VARIANT
            # AGAST #1295: each binding of `V(a, b, ..)` in turn.
            let nb: i32 = arm_bind_count(arm)
            for k in 0..nb
                arm_select_bind(arm, k)
                if arm.pattern_inner_kind == PAT_IDENT
                    errors = errors + binder_judge_bind(ctx, file, arm.pattern_inner_span, StrView { ptr: (arm.pattern_inner_name), len: (arm.pattern_inner_name_len) as i64 })
            arm_select_bind(arm, 0)
        # A bare top-level name naming a module value is the match lowering's
        # (binder_arm_refuse); any other binds.  A qualified `E.V` has no span.
        else if arm.pattern_kind == PAT_IDENT and arm.pattern_span.line > 0
            if binder_module_value_kind(ctx, StrView { ptr: (arm.pattern_name), len: (arm.pattern_name_len) as i64 }) == BINDER_NONE
                errors = errors + binder_judge_bind(ctx, file, arm.pattern_span, StrView { ptr: (arm.pattern_name), len: (arm.pattern_name_len) as i64 })
        errors = errors + binder_check_stmts(ctx, file, arm.body_stmts)
        errors = errors + binder_check_expr(ctx, file, arm.body)
        g_scope_top = mark
        arm = arm.next
    errors

# Only a match or an if/else expression holds statements, so only those are
# walked: no other expression binds, and parser_alloc does not zero the fields
# another kind leaves unset.
fn binder_check_expr(ctx: *ParseCtx, file: *u8, e: *Expr) -> i32
    if e == null
        return 0
    if e.kind == ExprKind.Match or e.kind == ExprKind.If
        return binder_check_arms(ctx, file, e.args as *MatchArm)
    0

# A block: what it binds goes out of scope at its end.  A `let`'s name is
# judged before its initialiser and bound after it, as ritz0 does.
fn binder_check_stmts(ctx: *ParseCtx, file: *u8, first: *Stmt) -> i32
    let mark: i32 = g_scope_top
    var errors: i32 = 0
    var s: *Stmt = first
    while s != null
        match s.kind
            StmtKind.VarDecl =>
                errors = errors + binder_judge(ctx, file, s.name_span, StrView { ptr: (s.var_name), len: (s.var_name_len) as i64 })
                errors = errors + binder_check_expr(ctx, file, s.var_init)
                binder_bind(ctx, s.name_span, StrView { ptr: (s.var_name), len: (s.var_name_len) as i64 })
            StmtKind.TupleDecl =>
                errors = errors + binder_judge(ctx, file, s.name_span, StrView { ptr: (s.var_name), len: (s.var_name_len) as i64 })
                # The second name against the first too: neither is bound yet.
                if binder_is_wildcard(StrView { ptr: (s.var_name), len: (s.var_name_len) as i64 }) == 0 and binder_module_value_kind(ctx, StrView { ptr: (s.var_name), len: (s.var_name_len) as i64 }) == BINDER_NONE and binder_module_value_kind(ctx, StrView { ptr: (s.assign_target), len: (s.assign_target_len) as i64 }) == BINDER_NONE and binder_scope_find(StrView { ptr: (s.assign_target), len: (s.assign_target_len) as i64 }) < 0 and name_eq(StrView { ptr: (s.var_name), len: (s.var_name_len) as i64 }, StrView { ptr: (s.assign_target), len: (s.assign_target_len) as i64 }) == 1
                    errors = errors + binder_reuse_report(file, s.name2_span, StrView { ptr: (s.assign_target), len: (s.assign_target_len) as i64 }, s.name_span.line, s.name_span.col)
                else
                    errors = errors + binder_judge(ctx, file, s.name2_span, StrView { ptr: (s.assign_target), len: (s.assign_target_len) as i64 })
                errors = errors + binder_check_tail(ctx, file, s)   # AGAST #109
                errors = errors + binder_check_expr(ctx, file, s.var_init)
                binder_bind(ctx, s.name_span, StrView { ptr: (s.var_name), len: (s.var_name_len) as i64 })
                binder_bind(ctx, s.name2_span, StrView { ptr: (s.assign_target), len: (s.assign_target_len) as i64 })
                var tn: *TupleName = s.tuple_more
                while tn != null
                    binder_bind(ctx, tn.span, StrView { ptr: (tn.name), len: (tn.len) as i64 })
                    tn = tn.next
            StmtKind.For =>
                let for_mark: i32 = g_scope_top
                errors = errors + binder_judge_bind(ctx, file, s.name_span, StrView { ptr: (s.for_var), len: (s.for_var_len) as i64 })
                errors = errors + binder_check_stmts(ctx, file, s.for_body)
                g_scope_top = for_mark
            StmtKind.If =>
                errors = errors + binder_check_expr(ctx, file, s.if_cond)
                errors = errors + binder_check_stmts(ctx, file, s.if_then)
                errors = errors + binder_check_stmts(ctx, file, s.if_else)
            StmtKind.While =>
                errors = errors + binder_check_expr(ctx, file, s.while_cond)
                errors = errors + binder_check_stmts(ctx, file, s.while_body)
            StmtKind.Loop | StmtKind.Defer | StmtKind.Unsafe =>
                errors = errors + binder_check_stmts(ctx, file, s.while_body)
            StmtKind.Asm =>
                pass   # binds nothing; its operands are uses (AGAST #3394)
            StmtKind.Match =>
                errors = errors + binder_check_arms(ctx, file, s.if_then as *MatchArm)
            StmtKind.Return =>
                errors = errors + binder_check_expr(ctx, file, s.return_value)
            StmtKind.Expr =>
                errors = errors + binder_check_expr(ctx, file, s.expr)
            StmtKind.Assign =>
                errors = errors + binder_check_expr(ctx, file, s.assign_value)
            _ => pass
        s = s.next
    g_scope_top = mark
    errors

fn binder_check_fn(ctx: *ParseCtx, path: *u8, f: *FnDef) -> i32
    var file: *u8 = path
    if f.def_file != null
        file = f.def_file
    g_scope_top = 0
    var errors: i32 = 0
    var p: *Param = f.params
    while p != null
        if p.name != null
            errors = errors + binder_judge_bind(ctx, file, p.name_span, StrView { ptr: (p.name), len: (p.name_len) as i64 })
        p = p.next
    errors = errors + binder_check_stmts(ctx, file, f.body)
    g_scope_top = 0
    errors

# 1 when this compile judges `f`'s binders: its own fns, and an imported
# generic template, whose body this compile instantiates.  An imported fn that
# isn't generic is judged by its own file's compile.  An imported one is
# located in its own file, so it needs that file's name.
pub fn binder_judges(f: *FnDef, generic_owner: i32) -> i32
    if f.is_local == 1
        return 1
    if f.body == null or f.def_file == null
        return 0
    (f.type_params != null or generic_owner == 1) as i32

# Every binder in the fns binder_judges picks, generic templates included.
# Runs before monomorphisation, so no clone is judged a second time.  Returns
# how many it refused; the caller stops on any.
pub fn binder_check_module(ctx: *ParseCtx, m: *Module, path: *u8) -> i32
    binder_build_map(ctx, m)
    var errors: i32 = 0
    var f: *FnDef = m.functions
    while f != null
        if binder_judges(f, 0) == 1
            errors = errors + binder_check_fn(ctx, path, f)
        f = f.next
    var ib: *ImplBlock = m.impls
    while ib != null
        let generic: i32 = (ib.type_params != null) as i32
        var method: *FnDef = ib.methods
        while method != null
            if binder_judges(method, generic) == 1
                errors = errors + binder_check_fn(ctx, path, method)
            method = method.next
        ib = ib.next
    errors

# --- A call of a local that holds no fn (AGAST #2407) -------------------------

# `file:line:col: error: 'k' is a local, not a fn: it can't be called`.
pub fn binder_call_refuse(file: *u8, line: i32, col: i32, name_sv: StrView)
    var name: *u8 = name_sv.ptr
    var len: i32 = name_sv.len as i32
    eprints_cstr(file)
    eprint_char(':')
    eprint_i64(line as i64)
    eprint_char(':')
    eprint_i64(col as i64)
    eprints(": error: '")
    eprint_bytes(StrView { ptr: (name), len: (len) as i64 })
    eprints("' is a local, not a fn: it can't be called\n")
