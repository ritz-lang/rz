# binder_check.ritz - a local can't take a module value's name (AGAST #2407,
# LARB R12), nor a name already in scope in its fn (AGAST #2395)
#
# A local binding (`let`, `var`, a param, a `for` variable, a variant
# payload's name) that takes the name of a `const`, a global `var` or an enum
# variant, declared in the file or imported, is a located error at the name
# (LANGUAGE_SPEC §4.3).  With no local named like one, a bare read of the name
# has one meaning, and there is no lookup order to get wrong.
#
# A bare top-level arm name is a binding only where it isn't a test: against
# an enum it is that enum's variant, against an integer a const compares
# (§8.2).  Only the match lowering knows the scrutinee, so it judges those
# with binder_arm_refuse (emitter_match.ritz).  Every other binder is judged
# here, before monomorphisation, so a generic fn is judged whether or not
# anything instantiates it, and once.
#
# Nor can a binding reuse a name still in scope in its fn: an enclosing
# block's, the same block's, a param's, a `for` variable's or an arm's
# (LANGUAGE_SPEC §4.3, Aaron 2026-11-06 and 2026-11-08).  `_` binds nothing.
# A name whose binding has gone out of scope is free again.
#
# Fn names are free: a call says it wants a fn.  ritz0's twin is
# ritz0/binder_names.py; ritz0/test_local_takes_module_name.py and
# test_local_reuses_a_name.py hold the three compilers to one table, messages
# and positions included.

import ritzlib.sys
import ritzlib.io
import ritzlib.hash
import ritzlib.hashmap

import ast
import ast_helpers
import emitter_core

const BINDER_NONE: i32 = 0
const BINDER_CONST: i32 = 1
const BINDER_GLOBAL: i32 = 2
const BINDER_VARIANT: i32 = 3

# fnv1a(name) -> a BINDER_* kind, a hint only: a hit is confirmed by
# binder_kind_exact, since the map is keyed by the hash alone.
var g_binder_map: HashMapI64
var g_binder_module: *Module = null

fn binder_is_builtin_variant(name: *u8, len: i32) -> i32
    if name_eq(name, len, c"Some", 4) == 1 or name_eq(name, len, c"None", 4) == 1
        return 1
    (name_eq(name, len, c"Ok", 2) == 1 or name_eq(name, len, c"Err", 3) == 1) as i32

fn binder_is_variant(name: *u8, len: i32) -> i32
    if binder_is_builtin_variant(name, len) == 1
        return 1
    var ei: i32 = 0
    while ei < enum_count()
        var vi: i32 = 0
        while vi < enum_variant_count(ei)
            var vlen: i32 = 0
            let vname: *u8 = enum_variant_name(ei, vi, @vlen)
            if name_eq(vname, vlen, name, len) == 1
                return 1
            vi = vi + 1
        ei = ei + 1
    0

# What `name` is, by the lists themselves: a const outranks a global, and both
# a variant.
fn binder_kind_exact(m: *Module, name: *u8, len: i32) -> i32
    var c: *ConstEntry = m.constants
    while c != null
        if name_eq(c.name, c.name_len, name, len) == 1
            return BINDER_CONST
        c = c.next
    var g: *GlobalVarDef = m.globals
    while g != null
        if name_eq(g.name, g.name_len, name, len) == 1
            return BINDER_GLOBAL
        g = g.next
    if binder_is_variant(name, len) == 1
        return BINDER_VARIANT
    BINDER_NONE

fn binder_map_note(name: *u8, len: i32, kind: i32)
    hashmap_i64_insert(@&g_binder_map, fnv1a_str(name, len) as i64, kind as i64)

# The table every lookup reads: built once, from the merged module.
fn binder_build_map(m: *Module)
    g_binder_module = m
    g_binder_map = hashmap_i64_with_cap(1024)
    binder_map_note(c"Some", 4, BINDER_VARIANT)
    binder_map_note(c"None", 4, BINDER_VARIANT)
    binder_map_note(c"Ok", 2, BINDER_VARIANT)
    binder_map_note(c"Err", 3, BINDER_VARIANT)
    var ei: i32 = 0
    while ei < enum_count()
        var vi: i32 = 0
        while vi < enum_variant_count(ei)
            var vlen: i32 = 0
            let vname: *u8 = enum_variant_name(ei, vi, @vlen)
            binder_map_note(vname, vlen, BINDER_VARIANT)
            vi = vi + 1
        ei = ei + 1
    var g: *GlobalVarDef = m.globals
    while g != null
        binder_map_note(g.name, g.name_len, BINDER_GLOBAL)
        g = g.next
    var c: *ConstEntry = m.constants
    while c != null
        binder_map_note(c.name, c.name_len, BINDER_CONST)
        c = c.next

# The BINDER_* kind of module value `name` names, BINDER_NONE for none.
pub fn binder_module_value_kind(name: *u8, len: i32) -> i32
    if g_binder_module == null or name == null or len <= 0
        return BINDER_NONE
    if hashmap_i64_get(@g_binder_map, fnv1a_str(name, len) as i64) == 0
        return BINDER_NONE
    binder_kind_exact(g_binder_module, name, len)

fn binder_kind_word(kind: i32) -> *u8
    if kind == BINDER_CONST
        return c"const"
    if kind == BINDER_GLOBAL
        return c"global"
    c"variant"

# `file:line:col: error: a local can't take the name of a <kind>: '<name>' —
# rename the local`, for a binder of kind `kind`.  Returns 1 (one error).
pub fn binder_report(file: *u8, line: i32, col: i32, name: *u8, len: i32, kind: i32) -> i32
    eprints_cstr(file)
    eprint_char(':')
    eprint_i64(line as i64)
    eprint_char(':')
    eprint_i64(col as i64)
    eprints_cstr(c": error: a local can't take the name of a ")
    eprints_cstr(binder_kind_word(kind))
    eprints_cstr(c": '")
    eprint_bytes(name, len)
    eprints_cstr(c"' — rename the local\n")
    1

# --- A local can't reuse a name still in scope (AGAST #2395) ------------------
#
# The names in scope while one fn is walked, innermost last: a block, a `for`
# or an arm saves g_scope_top on entry and puts it back on exit.  A fn holding
# more than BINDER_SCOPE_CAP names in scope at once has the rest unjudged.
const BINDER_SCOPE_CAP: i32 = 8192
var g_scope_name: [8192]*u8
var g_scope_len: [8192]i32
var g_scope_line: [8192]i32
var g_scope_col: [8192]i32
var g_scope_top: i32 = 0

# The slot of the innermost name in scope that is `name`, -1 for none.
fn binder_scope_find(name: *u8, len: i32) -> i32
    var i: i32 = g_scope_top - 1
    while i >= 0
        if name_eq(g_scope_name[i], g_scope_len[i], name, len) == 1
            return i
        i = i - 1
    0 - 1

fn binder_is_wildcard(name: *u8, len: i32) -> i32
    (len == 1 and *name == '_') as i32

# `file:line:col: error: a local can't reuse a name bound earlier in its fn:
# '<name>' (at L:C) — rename the local`.  Returns 1 (one error).
fn binder_reuse_report(file: *u8, span: SrcSpan, name: *u8, len: i32, at_line: i32, at_col: i32) -> i32
    eprints_cstr(file)
    eprint_char(':')
    eprint_i64(span.line as i64)
    eprint_char(':')
    eprint_i64(span.col as i64)
    eprints_cstr(c": error: a local can't reuse a name bound earlier in its fn: '")
    eprint_bytes(name, len)
    eprints_cstr(c"' (at ")
    eprint_i64(at_line as i64)
    eprint_char(':')
    eprint_i64(at_col as i64)
    eprints_cstr(c") — rename the local\n")
    1

# 1 when `name` takes a module value's name or one still in scope, after
# saying so.  `_` is never bound (binder_bind), so it passes.
fn binder_judge(file: *u8, span: SrcSpan, name: *u8, len: i32) -> i32
    if name == null or len <= 0
        return 0
    let kind: i32 = binder_module_value_kind(name, len)
    if kind != BINDER_NONE
        return binder_report(file, span.line, span.col, name, len, kind)
    let at: i32 = binder_scope_find(name, len)
    if at < 0
        return 0
    binder_reuse_report(file, span, name, len, g_scope_line[at], g_scope_col[at])

# Put `name` in scope.  A module value's name is never a local's.
fn binder_bind(span: SrcSpan, name: *u8, len: i32)
    if name == null or len <= 0 or binder_is_wildcard(name, len) == 1
        return
    if binder_module_value_kind(name, len) != BINDER_NONE or g_scope_top >= BINDER_SCOPE_CAP
        return
    g_scope_name[g_scope_top] = name
    g_scope_len[g_scope_top] = len
    g_scope_line[g_scope_top] = span.line
    g_scope_col[g_scope_top] = span.col
    g_scope_top = g_scope_top + 1

fn binder_judge_bind(file: *u8, span: SrcSpan, name: *u8, len: i32) -> i32
    let errors: i32 = binder_judge(file, span, name, len)
    binder_bind(span, name, len)
    errors

fn binder_check_arms(file: *u8, arms: *MatchArm) -> i32
    var errors: i32 = 0
    var arm: *MatchArm = arms
    while arm != null
        let mark: i32 = g_scope_top
        if arm.pattern_kind == PAT_VARIANT and arm.pattern_inner_kind == PAT_IDENT
            errors = errors + binder_judge_bind(file, arm.pattern_inner_span, arm.pattern_inner_name, arm.pattern_inner_name_len)
        # A bare top-level name naming a module value is the match lowering's
        # (binder_arm_refuse); any other binds.  A qualified `E.V` has no span.
        else if arm.pattern_kind == PAT_IDENT and arm.pattern_span.line > 0
            if binder_module_value_kind(arm.pattern_name, arm.pattern_name_len) == BINDER_NONE
                errors = errors + binder_judge_bind(file, arm.pattern_span, arm.pattern_name, arm.pattern_name_len)
        errors = errors + binder_check_stmts(file, arm.body_stmts)
        errors = errors + binder_check_expr(file, arm.body)
        g_scope_top = mark
        arm = arm.next
    errors

# Only a match or an if/else expression holds statements, so only those are
# walked: no other expression binds, and parser_alloc does not zero the fields
# another kind leaves unset.
fn binder_check_expr(file: *u8, e: *Expr) -> i32
    if e == null
        return 0
    if e.kind == EXPR_MATCH or e.kind == EXPR_IF
        return binder_check_arms(file, e.args as *MatchArm)
    0

# A block: what it binds goes out of scope at its end.  A `let`'s name is
# judged before its initialiser and bound after it, as ritz0 does.
fn binder_check_stmts(file: *u8, first: *Stmt) -> i32
    let mark: i32 = g_scope_top
    var errors: i32 = 0
    var s: *Stmt = first
    while s != null
        if s.kind == STMT_VAR_DECL
            errors = errors + binder_judge(file, s.name_span, s.var_name, s.var_name_len)
            errors = errors + binder_check_expr(file, s.var_init)
            binder_bind(s.name_span, s.var_name, s.var_name_len)
        else if s.kind == STMT_TUPLE_DECL
            errors = errors + binder_judge(file, s.name_span, s.var_name, s.var_name_len)
            # The second name against the first too: neither is bound yet.
            if binder_is_wildcard(s.var_name, s.var_name_len) == 0 and binder_module_value_kind(s.var_name, s.var_name_len) == BINDER_NONE and binder_module_value_kind(s.assign_target, s.assign_target_len) == BINDER_NONE and binder_scope_find(s.assign_target, s.assign_target_len) < 0 and name_eq(s.var_name, s.var_name_len, s.assign_target, s.assign_target_len) == 1
                errors = errors + binder_reuse_report(file, s.name2_span, s.assign_target, s.assign_target_len, s.name_span.line, s.name_span.col)
            else
                errors = errors + binder_judge(file, s.name2_span, s.assign_target, s.assign_target_len)
            errors = errors + binder_check_expr(file, s.var_init)
            binder_bind(s.name_span, s.var_name, s.var_name_len)
            binder_bind(s.name2_span, s.assign_target, s.assign_target_len)
        else if s.kind == STMT_FOR
            let for_mark: i32 = g_scope_top
            errors = errors + binder_judge_bind(file, s.name_span, s.for_var, s.for_var_len)
            errors = errors + binder_check_stmts(file, s.for_body)
            g_scope_top = for_mark
        else if s.kind == STMT_IF
            errors = errors + binder_check_expr(file, s.if_cond)
            errors = errors + binder_check_stmts(file, s.if_then)
            errors = errors + binder_check_stmts(file, s.if_else)
        else if s.kind == STMT_WHILE
            errors = errors + binder_check_expr(file, s.while_cond)
            errors = errors + binder_check_stmts(file, s.while_body)
        else if s.kind == STMT_LOOP
            errors = errors + binder_check_stmts(file, s.while_body)
        else if s.kind == STMT_MATCH
            errors = errors + binder_check_arms(file, s.if_then as *MatchArm)
        else if s.kind == STMT_RETURN
            errors = errors + binder_check_expr(file, s.return_value)
        else if s.kind == STMT_EXPR
            errors = errors + binder_check_expr(file, s.expr)
        else if s.kind == STMT_ASSIGN
            errors = errors + binder_check_expr(file, s.assign_value)
        s = s.next
    g_scope_top = mark
    errors

fn binder_check_fn(path: *u8, f: *FnDef) -> i32
    var file: *u8 = path
    if f.def_file != null
        file = f.def_file
    g_scope_top = 0
    var errors: i32 = 0
    var p: *Param = f.params
    while p != null
        if p.name != null
            errors = errors + binder_judge_bind(file, p.name_span, p.name, p.name_len)
        p = p.next
    errors = errors + binder_check_stmts(file, f.body)
    g_scope_top = 0
    errors

# 1 when this compile judges `f`'s binders: its own fns, and an imported
# generic template, whose body this compile instantiates.  An imported fn that
# isn't generic is judged by its own file's compile.  An imported one is
# located in its own file, so it needs that file's name.
fn binder_judges(f: *FnDef, generic_owner: i32) -> i32
    if f.is_local == 1
        return 1
    if f.body == null or f.def_file == null
        return 0
    (f.type_params != null or generic_owner == 1) as i32

# Every binder in the fns binder_judges picks, generic templates included.
# Runs before monomorphisation, so no clone is judged a second time.  Returns
# how many it refused; the caller stops on any.
pub fn binder_check_module(m: *Module, path: *u8) -> i32
    binder_build_map(m)
    var errors: i32 = 0
    var f: *FnDef = m.functions
    while f != null
        if binder_judges(f, 0) == 1
            errors = errors + binder_check_fn(path, f)
        f = f.next
    var ib: *ImplBlock = m.impls
    while ib != null
        let generic: i32 = (ib.type_params != null) as i32
        var method: *FnDef = ib.methods
        while method != null
            if binder_judges(method, generic) == 1
                errors = errors + binder_check_fn(path, method)
            method = method.next
        ib = ib.next
    errors

# --- A call of a local that holds no fn (AGAST #2407) -------------------------

# `file:line:col: error: 'k' is a local, not a fn: it can't be called`.
pub fn binder_call_refuse(file: *u8, line: i32, col: i32, name: *u8, len: i32)
    eprints_cstr(file)
    eprint_char(':')
    eprint_i64(line as i64)
    eprint_char(':')
    eprint_i64(col as i64)
    eprints_cstr(c": error: '")
    eprint_bytes(name, len)
    eprints_cstr(c"' is a local, not a fn: it can't be called\n")

# 1 when `init` is a literal: a binding to one holds no fn.
fn binder_init_is_literal(init: *Expr) -> i32
    if init == null
        return 0
    let k: i32 = init.kind
    (k == EXPR_INT_LIT or k == EXPR_FLOAT_LIT or k == EXPR_STRING_LIT or k == EXPR_CSTRING_LIT or k == EXPR_CHAR_LIT or k == EXPR_ARRAY_LIT or k == EXPR_ARRAY_FILL or k == EXPR_STRUCT_LIT) as i32

# After emit_var_decl, as let_mark_decl: mark the binding it registered when
# it certainly holds no fn value.  A written type says so unless it is a fn
# type (var_fn_sig) or a pointer; an unwritten one only for a literal.
pub fn binder_mark_decl(s: *EmitterState, stmt: *Stmt, before: i32)
    let idx: i32 = find_local_idx(s, stmt.var_name, stmt.var_name_len)
    if idx < before
        return
    var not_fn: i32 = 0
    if stmt.var_declared_type != TYPE_VOID
        not_fn = (stmt.var_fn_sig == null and stmt.var_declared_type != TYPE_PTR) as i32
    else
        not_fn = binder_init_is_literal(stmt.var_init)
    let loc: *LocalVar = local_at(s, idx)
    loc.not_fn = not_fn
