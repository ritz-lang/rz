# The `main` of every test binary (LANGUAGE_SPEC.md §17.1).
#
# A test binary is a test file compiled in test mode (which emits the
# `[[test]]` table and a `_start` that calls `main`) linked with this module
# and the runner. The harness links ritzunit's own modules as one object whose
# only global symbol is `main`, so the runner's internals cannot collide with
# names in the program under test.
#
# The table is declared here, not in the runner: no test imports this module,
# so the declaration never meets the test file's definition of the table in
# one compile, while a test can import the runner and hand it a table of its
# own.
import ritzunit.runner

# Defined by the test file's test-mode compile: stores the entry count and
# returns the first entry.
extern fn __ritz_test_table(count: *i64) -> *RitzTest

pub fn main(args: Span<StrView>) -> i32
    var count: i64 = 0
    let tests: *RitzTest = __ritz_test_table(@count)
    return ritzunit_main(args, tests, count)
