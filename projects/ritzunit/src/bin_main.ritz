# The `main` of every test binary (LANGUAGE_SPEC.md §17.1).
#
# A test binary is a test file compiled in test mode (which emits the
# `[[test]]` table and a `_start` that calls `main`) linked with this module
# and the runner. The harness links ritzunit's own modules as one object whose
# only global symbol is `main`, so the runner's internals cannot collide with
# names in the program under test.
import ritzunit.runner

fn main(argc: i32, argv: **u8) -> i32
    return ritzunit_main(argc, argv)
