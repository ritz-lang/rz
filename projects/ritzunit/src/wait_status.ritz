# ritzunit/wait_status.ritz - what a reaped test child's exit reports
#
# Split from runner.ritz so ritzunit's own tests can import it: the runner
# declares the compiler-emitted test table, which a test file defines.

import ritzlib.sys
import ritzlib.process { ProcessResult }

# ============================================================================
# Test results
# ============================================================================

const TEST_RESULT_PASS: i32 = 0      # Test passed (exit 0)
const TEST_RESULT_FAIL: i32 = 1      # Test failed (non-zero exit)
const TEST_RESULT_SIGNAL: i32 = 2    # Test killed by signal
const TEST_RESULT_TIMEOUT: i32 = 3   # Test timed out

struct TestRunResult
    status: i32          # TEST_RESULT_* constant
    exit_code: i32       # Exit code (if PASS/FAIL)
    signal: i32          # Signal number (if SIGNAL)

# What a reaped child's exit means. A child that neither exited nor was
# killed (ProcessResult's exit_code -1) failed.
pub fn result_from_process(pr: ProcessResult) -> TestRunResult
    if pr.signaled != 0
        return TestRunResult { status: TEST_RESULT_SIGNAL, exit_code: 0, signal: pr.signal }
    if pr.exit_code == 0
        return TestRunResult { status: TEST_RESULT_PASS, exit_code: 0, signal: 0 }
    TestRunResult { status: TEST_RESULT_FAIL, exit_code: pr.exit_code, signal: 0 }

# What a reaped pool child reports; `killed` is 1 if the runner SIGKILLed it
# for passing its deadline.
#
# The exit decides, not `killed` (AGAST #2070). The runner kills at the
# deadline right after a WNOHANG reap found nothing, so a child that crashed
# or exited in that window is already a zombie: the kill does nothing and its
# exit says what the test did. Only a SIGKILL death after our kill is a
# timeout.
pub fn result_from_reap(pr: ProcessResult, killed: i32) -> TestRunResult
    var r: TestRunResult = result_from_process(pr)
    if killed != 0 && r.status == TEST_RESULT_SIGNAL && r.signal == SIGKILL
        r.status = TEST_RESULT_TIMEOUT
        r.signal = 0
    r
