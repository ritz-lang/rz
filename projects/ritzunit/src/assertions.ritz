# ritzunit/src/assertions.ritz - String assertions for unit tests
#
# Each helper is a `[[test_helper]]` built on `assert` (LANGUAGE_SPEC §17.1,
# §19.2). On failure it prints both strings, then its `assert` fails the
# test (exit status 1). The diagnostic's first line is the CALLING TEST's
# file:line, and a final `in helper ...` line names the helper:
#
#   expected: "abd"
#   actual:   "abc"
#   test/test_x.ritz:12: assertion failed: assert_str_eq
#     in helper assert_str_eq_sv at assertions.ritz:NN
#
# Call them as plain statements. They return nothing, so there is no result
# to drop:
#
#   [[test]]
#   fn test_greeting() -> i32
#       assert_str_eq(greet(c"bob"), c"hello bob")
#       0
#
# Integers, bools and pointers need no helper (AGAST #2127). `assert a OP b`
# prints both operands (pointers in hex), so the old assert_eq_i32 /
# assert_lt_i32 / assert_true / assert_not_null family is now just:
#
#   assert n == 3           assert n < limit
#   assert ok               assert p != null
#
# The string checks stay because `assert` cannot print a string's contents.

import ritzlib.io
import ritzlib.strview

# ============================================================================
# StrView assertions
# ============================================================================

# Fail the test unless `actual` equals `expected`, byte for byte.
[[test_helper]]
pub fn assert_str_eq_sv(actual: StrView, expected: StrView)
    let ok: bool = strview_eq(actual, expected)
    if not ok
        show(c"expected: ", expected)
        show(c"actual:   ", actual)
    assert ok, "assert_str_eq"

# Fail the test unless `s` begins with `prefix`.
[[test_helper]]
pub fn assert_starts_with_sv(s: StrView, prefix: StrView)
    let ok: bool = strview_starts_with(s, prefix)
    if not ok
        show(c"string: ", s)
        show(c"prefix: ", prefix)
    assert ok, "assert_starts_with"

# Fail the test unless `needle` occurs in `haystack`.
[[test_helper]]
pub fn assert_contains_sv(haystack: StrView, needle: StrView)
    let ok: bool = strview_find(haystack, needle) >= 0
    if not ok
        show(c"haystack: ", haystack)
        show(c"needle:   ", needle)
    assert ok, "assert_contains"

# ============================================================================
# NUL-terminated (*u8) forms
# ============================================================================

[[test_helper]]
pub fn assert_str_eq(actual: *u8, expected: *u8)
    var a: StrView = strview_from_cstr(actual)
    var e: StrView = strview_from_cstr(expected)
    assert_str_eq_sv(a, e)

[[test_helper]]
pub fn assert_starts_with(s: *u8, prefix: *u8)
    var sv: StrView = strview_from_cstr(s)
    var pv: StrView = strview_from_cstr(prefix)
    assert_starts_with_sv(sv, pv)

[[test_helper]]
pub fn assert_contains(haystack: *u8, needle: *u8)
    var hv: StrView = strview_from_cstr(haystack)
    var nv: StrView = strview_from_cstr(needle)
    assert_contains_sv(hv, nv)

# ============================================================================
# Internal
# ============================================================================

# `  <label>"<s>"` on stderr, above the assert's own diagnostic. The label
# carries its colon and padding.
fn show(label: *u8, s: StrView)
    eprints("  ")
    eprints_cstr(label)
    eprints("\"")
    sys_write(2, s.ptr, s.len)
    eprints("\"\n")
