# ritzunit/src/json_reporter.ritz - JSON output for test results
#
# Outputs test results in JSON format for CI/CD integration.
# Format:
# {
#   "version": "0.1.0",
#   "summary": { "total": N, "passed": N, "failed": N, ... },
#   "tests": [
#     { "name": "test_foo", "status": "pass", "duration_ms": N },
#     { "name": "test_bar", "status": "fail", "duration_ms": N,
#       "exit_code": N, "output": "captured stdout+stderr" },
#     ...
#   ]
# }

import ritzlib.io
import ritzlib.sys
import ritzlib.gvec
import ritzlib.span
import ritzlib.strview
import ritzunit.reporter

# ============================================================================
# JSON Test Result Storage
# ============================================================================

# Status string getters
fn status_pass() -> StrView
    return "pass"

fn status_fail() -> StrView
    return "fail"

fn status_crash() -> StrView
    return "crash"

fn status_timeout() -> StrView
    return "timeout"

# Single test result for JSON array
struct JsonTestResult
    name: StrView
    status: StrView
    duration_ms: i64
    exit_code: i32
    signal: i32
    out_start: i64       # captured stdout+stderr of a test that did not
    out_len: i64         # pass: JsonReport.outputs[out_start, + out_len)

# The run's results, in report order: there is no cap on the number of
# tests. The report keeps its own copy of each output (the runner's capture
# buffer moves as it grows); the names must outlive the report's print.
pub struct JsonReport
    results: Vec<JsonTestResult>
    outputs: Vec<u8>

pub fn json_report_new() -> JsonReport
    JsonReport { results: vec_new<JsonTestResult>(), outputs: vec_new<u8>() }

# ============================================================================
# JSON Output Helpers
# ============================================================================

fn hex_digit(d: u8) -> u8
    if d < 10
        return '0' + d
    return 'a' + d - 10

# Print `s` as a JSON string literal. Every byte below 0x20 is escaped (JSON
# forbids them raw), as are `"` and `\`. Unescaped runs go to the report
# buffer whole, not byte by byte.
pub fn print_json_string_sv(s: StrView)
    out_str("\"")
    var run_start: i64 = 0
    for i in 0..s.len
        let c: u8 = s.get(i)
        if c < 32 || c == 34 || c == 92
            if i > run_start
                out_str(s.slice(run_start, i))
            run_start = i + 1
            if c == 34
                out_str("\\\"")
            else if c == 92
                out_str("\\\\")
            else if c == 10
                out_str("\\n")
            else if c == 9
                out_str("\\t")
            else if c == 13
                out_str("\\r")
            else
                var esc: [6]u8
                esc[0] = 92
                esc[1] = 'u'
                esc[2] = '0'
                esc[3] = '0'
                esc[4] = hex_digit(c >> 4)
                esc[5] = hex_digit(c & 15)
                let e: [u8] = @esc
                out_str(e.as_strview())
    if s.len > run_start
        out_str(s.skip(run_start))
    out_str("\"")

# ============================================================================
# Result Collection and JSON Output
# ============================================================================

impl JsonReport
    fn record(self: @&JsonReport, name: StrView, status: StrView, duration_ms: i64, exit_code: i32, signal: i32, output: StrView)
        let start: i64 = self.outputs.len()
        let kept: bool = self.outputs.push_view(output)
        let r = JsonTestResult { name: name, status: status, duration_ms: duration_ms, exit_code: exit_code, signal: signal, out_start: start, out_len: output.len }
        if not kept or not self.results.push(r)
            eprints("ritzunit: out of memory recording results\n")
            sys_exit(2)

    pub fn record_pass(self: @&JsonReport, name: StrView, duration_ms: i64)
        self.record(name, status_pass(), duration_ms, 0, 0, "")

    pub fn record_fail(self: @&JsonReport, name: StrView, duration_ms: i64, exit_code: i32, output: StrView)
        self.record(name, status_fail(), duration_ms, exit_code, 0, output)

    pub fn record_crash(self: @&JsonReport, name: StrView, duration_ms: i64, signal: i32, output: StrView)
        self.record(name, status_crash(), duration_ms, 0, signal, output)

    pub fn record_timeout(self: @&JsonReport, name: StrView, duration_ms: i64, output: StrView)
        self.record(name, status_timeout(), duration_ms, 0, 0, output)

    # Print full JSON report
    pub fn print(self: @JsonReport, total: i32, passed: i32, failed: i32, crashed: i32, timeout: i32, skipped: i32, duration_ms: i64)
        # `\{` / `\}` are literal braces everywhere. `{{` collapses to one brace
        # only inside print/eprint; here it would be two (#1374, #1913).
        out_str("\{\n")
        out_str("  \"version\": \"0.1.0\",\n")

        # Summary
        out_str("  \"summary\": \{\n")

        out_str("    \"total\": ")
        out_int(total as i64)

        out_str(",\n    \"passed\": ")
        out_int(passed as i64)

        out_str(",\n    \"failed\": ")
        out_int(failed as i64)

        out_str(",\n    \"crashed\": ")
        out_int(crashed as i64)

        out_str(",\n    \"timeout\": ")
        out_int(timeout as i64)

        out_str(",\n    \"skipped\": ")
        out_int(skipped as i64)

        out_str(",\n    \"duration_ms\": ")
        out_int(duration_ms)

        out_str("\n  \},\n")

        # Tests array
        out_str("  \"tests\": [\n")

        let count: i64 = self.results.len()
        for i in 0..count
            let r = @self.results[i]
            out_str("    \{\"name\": ")
            print_json_string_sv(r.name)
            out_str(", \"status\": ")
            print_json_string_sv(r.status)
            out_str(", \"duration_ms\": ")
            out_int(r.duration_ms)
            if r.exit_code != 0
                out_str(", \"exit_code\": ")
                out_int(r.exit_code as i64)
            if r.signal != 0
                out_str(", \"signal\": ")
                out_int(r.signal as i64)
            if r.out_len != 0
                let output: [u8] = self.outputs[r.out_start..r.out_start + r.out_len]
                out_str(", \"output\": ")
                print_json_string_sv(output.as_strview())
            out_str("\}")
            if i < count - 1
                out_str(",")
            out_str("\n")

        out_str("  ]\n")
        out_str("\}\n")
