# ritzunit/src/json_reporter.ritz - JSON output for test results
#
# Outputs test results in JSON format for CI/CD integration.
# Format:
# {
#   "version": "0.1.0",
#   "summary": { "total": N, "passed": N, "failed": N, ... },
#   "tests": [
#     { "name": "test_foo", "status": "pass", "duration_ms": N },
#     { "name": "test_bar", "status": "fail", "duration_ms": N,
#       "exit_code": N, "output": "captured stdout+stderr" },
#     ...
#   ]
# }

import ritzlib.io
import ritzlib.str
import ritzlib.memory
import ritzlib.sys
import ritzlib.strview

# ============================================================================
# JSON Test Result Storage
# ============================================================================

# Status string getters
fn status_pass() -> StrView
    return strview_from_cstr(c"pass")

fn status_fail() -> StrView
    return strview_from_cstr(c"fail")

fn status_crash() -> StrView
    return strview_from_cstr(c"crash")

fn status_timeout() -> StrView
    return strview_from_cstr(c"timeout")

fn status_skip() -> StrView
    return strview_from_cstr(c"skip")

# Single test result for JSON array
struct JsonTestResult
    name: StrView
    status: StrView
    duration_ms: i64
    exit_code: i32
    signal: i32
    output: StrView      # captured stdout+stderr of a test that did not pass

# Results, grown as needed: there is no cap on the number of tests.
var g_json_results: *JsonTestResult = 0 as *JsonTestResult
var g_json_result_count: i32 = 0
var g_json_result_cap: i32 = 0

# ============================================================================
# Result Collection
# ============================================================================

pub fn json_record_result(name: @StrView, status: @StrView, duration_ms: i64, exit_code: i32, signal: i32, output: @StrView)
    if g_json_result_count == g_json_result_cap
        var cap: i32 = g_json_result_cap * 2
        if cap == 0
            cap = 64
        let grown: *u8 = realloc(g_json_results as *u8, (cap as i64) * sizeof(JsonTestResult))
        if grown == null
            eprints("ritzunit: out of memory recording results\n")
            sys_exit(2)
        g_json_results = grown as *JsonTestResult
        g_json_result_cap = cap
    let r: *JsonTestResult = @g_json_results[g_json_result_count]
    r.name = *name
    r.status = *status
    r.duration_ms = duration_ms
    r.exit_code = exit_code
    r.signal = signal
    r.output = *output
    g_json_result_count += 1

pub fn json_record_pass(name: @StrView, duration_ms: i64)
    var st: StrView = status_pass()
    var none: StrView = strview_empty()
    json_record_result(name, @st, duration_ms, 0, 0, @none)

pub fn json_record_fail(name: @StrView, duration_ms: i64, exit_code: i32, output: @StrView)
    var st: StrView = status_fail()
    json_record_result(name, @st, duration_ms, exit_code, 0, output)

pub fn json_record_crash(name: @StrView, duration_ms: i64, signal: i32, output: @StrView)
    var st: StrView = status_crash()
    json_record_result(name, @st, duration_ms, 0, signal, output)

pub fn json_record_timeout(name: @StrView, duration_ms: i64, output: @StrView)
    var st: StrView = status_timeout()
    json_record_result(name, @st, duration_ms, 0, 0, output)

# ============================================================================
# JSON Output Helpers
# ============================================================================

fn hex_digit(d: u8) -> u8
    if d < 10
        return '0' + d
    return 'a' + d - 10

# Print `s` as a JSON string literal. Every byte below 0x20 is escaped (JSON
# forbids them raw), as are `"` and `\`. Unescaped runs are written with one
# write each, not one write per byte.
pub fn print_json_string_sv(s: @StrView)
    prints("\"")
    var run_start: i64 = 0
    for i in 0..s.len
        let c: u8 = strview_get(s, i)
        if c < 32 || c == 34 || c == 92
            if i > run_start
                sys_write(1, s.ptr + run_start, i - run_start)
            run_start = i + 1
            if c == 34
                prints("\\\"")
            else if c == 92
                prints("\\\\")
            else if c == 10
                prints("\\n")
            else if c == 9
                prints("\\t")
            else if c == 13
                prints("\\r")
            else
                var esc: [6]u8
                esc[0] = 92
                esc[1] = 'u'
                esc[2] = '0'
                esc[3] = '0'
                esc[4] = hex_digit(c >> 4)
                esc[5] = hex_digit(c & 15)
                sys_write(1, @esc[0], 6)
    if s.len > run_start
        sys_write(1, s.ptr + run_start, s.len - run_start)
    prints("\"")

# ============================================================================
# JSON Output
# ============================================================================

# Print full JSON report
pub fn json_print_report(total: i32, passed: i32, failed: i32, crashed: i32, timeout: i32, skipped: i32, duration_ms: i64)
    # `\{` / `\}` are literal braces under both compilers. `{{` is not:
    # ritz0 collapses it in every "..." literal, ritz1 only in print (#1374).
    prints("\{\n")
    prints("  \"version\": \"0.1.0\",\n")

    # Summary
    prints("  \"summary\": \{\n")

    prints("    \"total\": ")
    print_int(total as i64)

    prints(",\n    \"passed\": ")
    print_int(passed as i64)

    prints(",\n    \"failed\": ")
    print_int(failed as i64)

    prints(",\n    \"crashed\": ")
    print_int(crashed as i64)

    prints(",\n    \"timeout\": ")
    print_int(timeout as i64)

    prints(",\n    \"skipped\": ")
    print_int(skipped as i64)

    prints(",\n    \"duration_ms\": ")
    print_int(duration_ms)

    prints("\n  \},\n")

    # Tests array
    prints("  \"tests\": [\n")

    for i in 0..g_json_result_count
        let r: *JsonTestResult = @g_json_results[i]
        prints("    \{\"name\": ")
        print_json_string_sv(@r.name)
        prints(", \"status\": ")
        print_json_string_sv(@r.status)
        prints(", \"duration_ms\": ")
        print_int(r.duration_ms)
        if r.exit_code != 0
            prints(", \"exit_code\": ")
            print_int(r.exit_code as i64)
        if r.signal != 0
            prints(", \"signal\": ")
            print_int(r.signal as i64)
        if r.output.len != 0
            prints(", \"output\": ")
            print_json_string_sv(@r.output)
        prints("\}")
        if i < g_json_result_count - 1
            prints(",")
        prints("\n")

    prints("  ]\n")
    prints("\}\n")

# Reset collector for next run
pub fn json_reset()
    g_json_result_count = 0
