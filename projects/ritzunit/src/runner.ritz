# ritzunit/src/runner.ritz - The test runner linked into every test binary
#
# A test binary is a test file compiled in test mode, linked with this runner
# (LANGUAGE_SPEC.md §17.1). The compiler emits a table of the file's
# `[[test]]` functions; the runner is the binary's `main` (bin_main.ritz) and
# runs each entry of that table in a forked child.
#
#   * Discovery is the compiler's table, not a symbol-name convention: a
#     `[[test]] fn check_x` runs, a helper `fn test_x` does not.
#   * Each test runs in its own child. Its stdout and stderr go to a capture
#     file, so a test's output can neither interleave with nor corrupt the
#     report (--json stays parseable). Output of a test that did not pass is
#     shown under its result.
#   * The exit status is 0 iff every selected test passed, else 1. (It used
#     to be the failure count, which the kernel truncates mod 256.)
#
# CLI Options:
#   -v, --verbose    Show detailed output including test names as they run
#   -q, --quiet      Minimal output - only show failures and summary
#   -f, --filter     Filter tests by name substring
#   -l, --list       List tests without running them
#   -t, --timeout    Timeout per test in milliseconds (default: 5000)
#   --no-fork        Disable fork isolation (run tests in main process)
#   -h, --help       Show help message

import ritzlib.sys
import ritzlib.io
import ritzlib.memory
import ritzlib.args
import ritzlib.str
import ritzlib.strview

# ============================================================================
# The compiler-emitted test table (LANGUAGE_SPEC §17.1)
# ============================================================================

# One `[[test]]` function. `name` is NUL-terminated (`len` excludes the NUL).
struct RitzTest
    name: StrView
    run: fn() -> i32

# Defined by the test file's test-mode compile: stores the entry count and
# returns the first entry.
extern fn __ritz_test_table(count: *i64) -> *RitzTest

# ============================================================================
# Constants
# ============================================================================

const SEEK_SET: i32 = 0
const SEEK_END: i32 = 2

const SYS_MEMFD_CREATE: i64 = 319
const SYS_FTRUNCATE: i64 = 77
const MFD_CLOEXEC: i64 = 1

# Output kept per failing test: the last CAPTURE_KEEP bytes. A diagnostic is
# at the end of a test's output, and a runaway test must not exhaust memory.
const CAPTURE_KEEP: i64 = 65536

# ============================================================================
# Wait Status Macros (POSIX)
# ============================================================================

fn WIFEXITED(status: i32) -> i32
    return ((status & 127) == 0) as i32

fn WEXITSTATUS(status: i32) -> i32
    return (status >> 8) & 255

fn WIFSIGNALED(status: i32) -> i32
    let sig: i32 = status & 127
    return (sig != 0 && sig != 127) as i32

fn WTERMSIG(status: i32) -> i32
    return status & 127

# ============================================================================
# CLI Options (Global State)
# ============================================================================

var g_verbose: i32 = 0       # -v: show detailed output
var g_quiet: i32 = 0         # -q: minimal output
var g_list_only: i32 = 0     # -l: list tests without running
var g_filter: *u8 = 0 as *u8 # -f: filter pattern (null = no filter)
var g_timeout_ms: i64 = 5000 # -t: timeout per test in ms (default 5s)
var g_no_fork: i32 = 0       # --no-fork: disable fork isolation
var g_fail_fast: i32 = 0     # --fail-fast: stop on first failure
var g_shuffle: i32 = 0       # --shuffle: randomize test order
var g_seed: i64 = 0          # --seed: random seed (0 = auto from time)
var g_json: i32 = 0          # --json: output in JSON format
var g_junit: i32 = 0         # --junit: output in JUnit XML format
var g_color: i32 = 0         # 0=auto, 1=always, -1=never

# ============================================================================
# Timing
# ============================================================================

fn get_time_ms() -> i64
    var tv: Timeval
    sys_gettimeofday(@tv, null)
    return tv.tv_sec * 1000 + tv.tv_usec / 1000

fn get_time_us() -> i64
    var tv: Timeval
    sys_gettimeofday(@tv, null)
    return tv.tv_sec * 1000000 + tv.tv_usec

# ============================================================================
# Simple PRNG (Linear Congruential Generator), for --shuffle
# ============================================================================

var g_rng_state: i64 = 0

fn rng_seed(seed: i64)
    g_rng_state = seed
    if g_rng_state == 0
        g_rng_state = 1  # Avoid zero state

fn rng_next() -> i64
    # LCG parameters (same as MINSTD)
    g_rng_state = (g_rng_state * 48271) % 2147483647
    return g_rng_state

# Fisher-Yates shuffle of the run order
fn shuffle_order(order: *i64, count: i64)
    if count <= 1
        return
    for i in 0..(count - 1)
        let j: i64 = i + (rng_next() % (count - i))
        let tmp: i64 = order[i]
        order[i] = order[j]
        order[j] = tmp

# ============================================================================
# Test Execution
# ============================================================================

const TEST_RESULT_PASS: i32 = 0      # Test passed (exit 0)
const TEST_RESULT_FAIL: i32 = 1      # Test failed (non-zero exit)
const TEST_RESULT_SIGNAL: i32 = 2    # Test killed by signal
const TEST_RESULT_TIMEOUT: i32 = 3   # Test timed out

struct TestRunResult
    status: i32          # TEST_RESULT_* constant
    exit_code: i32       # Exit code (if PASS/FAIL)
    signal: i32          # Signal number (if SIGNAL)

# The exit status a test's result becomes in its child. Only the low 8 bits
# of an exit status survive, so a non-zero result whose low byte is zero (256)
# would read as a pass: report it as 1 instead.
pub fn test_exit_status(ret: i32) -> i32
    if ret != 0 && (ret & 255) == 0
        return 1
    return ret

# The capture file every child writes its stdout and stderr to. One memfd,
# emptied before each test; -1 if it could not be created (output then goes
# to the runner's own stdout/stderr, as before).
var g_capture_fd: i32 = -1

fn capture_open()
    let fd: i64 = syscall2(SYS_MEMFD_CREATE, c"ritzunit-capture" as i64, MFD_CLOEXEC)
    if fd >= 0
        g_capture_fd = fd as i32

fn capture_reset()
    if g_capture_fd < 0
        return
    syscall2(SYS_FTRUNCATE, g_capture_fd as i64, 0)
    sys_lseek(g_capture_fd, 0, SEEK_SET)

# The last CAPTURE_KEEP bytes the child wrote, in a fresh allocation.
fn capture_take() -> StrView
    var out: StrView = strview_empty()
    if g_capture_fd < 0
        return out
    let size: i64 = sys_lseek(g_capture_fd, 0, SEEK_END)
    if size <= 0
        return out
    var start: i64 = 0
    if size > CAPTURE_KEEP
        start = size - CAPTURE_KEEP
    let want: i64 = size - start
    let buf: *u8 = malloc(want + 1)
    if buf == null
        return out
    sys_lseek(g_capture_fd, start, SEEK_SET)
    var got: i64 = 0
    while got < want
        let n: i64 = sys_read(g_capture_fd, buf + got, want - got)
        if n <= 0
            break
        got += n
    buf[got] = 0
    out.ptr = buf
    out.len = got
    return out

# Run a test directly in the current process (no isolation).
fn run_test_direct(test: *RitzTest) -> i32
    let run: fn() -> i32 = test.run
    return run()

# Run one test in a forked child, which exits with the test's result.
# The parent waits with a timeout and interprets the status.
fn run_test_forked(test: *RitzTest, result: *TestRunResult) -> i32
    capture_reset()
    let pid: i32 = sys_fork()

    if pid < 0
        result.status = TEST_RESULT_FAIL
        result.exit_code = -1
        result.signal = 0
        return -1

    if pid == 0
        # === Child process ===
        if g_capture_fd >= 0
            sys_dup2(g_capture_fd, 1)
            sys_dup2(g_capture_fd, 2)
        let run: fn() -> i32 = test.run
        sys_exit(test_exit_status(run()))
        return 0

    # === Parent process ===
    let start_ms: i64 = get_time_ms()
    var status: i32 = 0

    loop
        let wait_result: i32 = sys_wait4(pid, @status, WNOHANG, null)

        if wait_result > 0
            if WIFEXITED(status) != 0
                let exit_code: i32 = WEXITSTATUS(status)
                if exit_code == 0
                    result.status = TEST_RESULT_PASS
                else
                    result.status = TEST_RESULT_FAIL
                result.exit_code = exit_code
                result.signal = 0
                return 0
            else if WIFSIGNALED(status) != 0
                result.status = TEST_RESULT_SIGNAL
                result.exit_code = 0
                result.signal = WTERMSIG(status)
                return 0

        if wait_result < 0
            result.status = TEST_RESULT_FAIL
            result.exit_code = -1
            result.signal = 0
            return -1

        let elapsed: i64 = get_time_ms() - start_ms
        if elapsed >= g_timeout_ms
            sys_kill(pid, SIGKILL)
            sys_wait4(pid, @status, 0, null)
            result.status = TEST_RESULT_TIMEOUT
            result.exit_code = 0
            result.signal = 0
            return 0

        # Sleep 1ms before polling again
        var req: [2]i64
        req[0] = 0
        req[1] = 1000000
        sys_nanosleep(@req[0], null)

    return 0

fn run_test_with_result(test: *RitzTest, result: *TestRunResult)
    if g_no_fork != 0
        let ret: i32 = test_exit_status(run_test_direct(test))
        if ret == 0
            result.status = TEST_RESULT_PASS
        else
            result.status = TEST_RESULT_FAIL
        result.exit_code = ret
        result.signal = 0
    else
        run_test_forked(test, result)

# ============================================================================
# Reporter Integration
# ============================================================================

import ritzunit.reporter
import ritzunit.types
import ritzunit.filter
import ritzunit.json_reporter
import ritzunit.junit_reporter

fn signal_name(sig: i32) -> StrView
    if sig == SIGSEGV
        return "SIGSEGV"
    if sig == SIGABRT
        return "SIGABRT"
    if sig == SIGFPE
        return "SIGFPE"
    if sig == SIGILL
        return "SIGILL"
    if sig == SIGBUS
        return "SIGBUS"
    if sig == SIGKILL
        return "SIGKILL"
    if sig == SIGTERM
        return "SIGTERM"
    if sig == SIGINT
        return "SIGINT"
    if sig == SIGTRAP
        return "SIGTRAP"
    if sig == SIGPIPE
        return "SIGPIPE"
    return "signal"

# A failed test's captured output, under its result line (human mode).
fn print_captured(output: @StrView)
    if output.len == 0
        return
    sys_write(1, output.ptr, output.len)
    if output.ptr[output.len - 1] != 10
        prints("\n")

# ============================================================================
# Main Test Runner
# ============================================================================

# Run every selected test in the table; 0 iff all of them passed, else 1.
pub fn run_tests() -> i32
    if g_quiet == 0 && g_json == 0
        print_banner()

    var count: i64 = 0
    let tests: *RitzTest = __ritz_test_table(@count)

    if count == 0
        if g_json != 0
            json_print_report(0, 0, 0, 0, 0, 0, 0)
        else
            prints("No tests found.\n")
        return 0

    var order: *i64 = malloc(count * 8) as *i64
    if order == null
        eprints("ritzunit: out of memory\n")
        return 1
    for i in 0..count
        order[i] = i

    if g_shuffle != 0
        var seed: i64 = g_seed
        if seed == 0
            seed = get_time_us()
        rng_seed(seed)
        shuffle_order(order, count)
        if g_verbose != 0
            print("Shuffled tests with seed: {seed}\n")

    if g_list_only != 0
        print("Discovered {count} test(s):\n")
        for i in 0..count
            let test: *RitzTest = @tests[order[i]]
            if matches_filter(test.name.ptr) != 0
                prints("  ")
                prints(test.name)
                prints("\n")
        return 0

    if g_quiet == 0
        print_suite_header(strview_from_cstr(c"tests"))

    if g_no_fork == 0
        capture_open()

    var summary: TestSummary = summary_new()
    var skipped_by_filter: i32 = 0
    let total_start: i64 = get_time_ms()

    for i in 0..count
        let test: *RitzTest = @tests[order[i]]
        var name: StrView = test.name

        if matches_filter(name.ptr) == 0
            skipped_by_filter += 1
            continue

        let start: i64 = get_time_ms()
        var result: TestRunResult
        run_test_with_result(test, @result)
        let elapsed: i64 = get_time_ms() - start

        var failed_this_test: i32 = 0
        if result.status == TEST_RESULT_PASS
            if g_json != 0
                json_record_pass(@name, elapsed)
            else if g_junit != 0
                junit_record_pass(@name, elapsed)
            else if g_quiet == 0
                print_test_pass(name, elapsed)
            summary_record(@summary, TEST_PASS, elapsed)
        else
            var output: StrView = capture_take()
            failed_this_test = 1
            if result.status == TEST_RESULT_SIGNAL
                var sig_name: StrView = signal_name(result.signal)
                if g_json != 0
                    json_record_crash(@name, elapsed, result.signal, @output)
                else if g_junit != 0
                    junit_record_crash(@name, elapsed, result.signal, @sig_name)
                else
                    print_test_crash(name, elapsed, result.signal, sig_name)
                    print_captured(@output)
                summary_record(@summary, TEST_CRASH, elapsed)
            else if result.status == TEST_RESULT_TIMEOUT
                if g_json != 0
                    json_record_timeout(@name, elapsed, @output)
                else if g_junit != 0
                    junit_record_timeout(@name, elapsed)
                else
                    print_test_timeout(name, g_timeout_ms)
                    print_captured(@output)
                summary_record(@summary, TEST_TIMEOUT, elapsed)
            else
                if g_json != 0
                    json_record_fail(@name, elapsed, result.exit_code, @output)
                else if g_junit != 0
                    junit_record_fail(@name, elapsed, result.exit_code)
                else
                    print_test_fail(name, elapsed, result.exit_code)
                    print_captured(@output)
                summary_record(@summary, TEST_FAIL, elapsed)

        if g_fail_fast != 0 && failed_this_test != 0
            break

    summary.duration_ms = get_time_ms() - total_start

    if g_json != 0
        json_print_report(summary.total, summary.passed, summary.failed, summary.crashed, summary.timeout, skipped_by_filter, summary.duration_ms)
    else if g_junit != 0
        # JUnit combines crashed and timeout as "errors"
        let errors: i32 = summary.crashed + summary.timeout
        junit_print_report(summary.total, summary.passed, summary.failed, errors, summary.duration_ms)
    else
        if g_quiet == 0
            print_suite_divider()
            print_suite_summary(summary.total, summary.passed, summary.failed, summary.crashed, summary.timeout, summary.duration_ms)
        print_grand_summary(summary.total, summary.passed, summary.failed, summary.crashed, summary.timeout, skipped_by_filter, summary.duration_ms)

    return run_exit_status(@summary)

# 0 iff nothing failed, crashed or timed out; else 1.
pub fn run_exit_status(summary: @TestSummary) -> i32
    if summary.failed + summary.crashed + summary.timeout > 0
        return 1
    return 0

# ============================================================================
# CLI Argument Parsing
# ============================================================================

fn parse_args(argc: i32, argv: **u8) -> i32
    var parser: ArgParser
    args_init(@parser, c"ritzunit", c"Unit test framework for Ritz")

    args_flag(@parser, 'v', c"verbose", c"Show detailed output")
    args_flag(@parser, 'q', c"quiet", c"Minimal output - only failures and summary")
    args_flag(@parser, 'l', c"list", c"List tests without running them")
    args_flag(@parser, 'h', c"help", c"Show this help message")
    args_option(@parser, 'f', c"filter", c"EXPR", c"Filter tests by EXPR (glob, @attr, bool)", null)
    args_option(@parser, 't', c"timeout", c"MS", c"Timeout per test in milliseconds", c"5000")
    args_flag(@parser, 0, c"no-fork", c"Disable fork isolation (run tests in main process)")
    args_flag(@parser, 'x', c"fail-fast", c"Stop on first test failure")
    args_flag(@parser, 's', c"shuffle", c"Randomize test execution order")
    args_option(@parser, 0, c"seed", c"N", c"Random seed for shuffling (0 = auto)", c"0")
    args_flag(@parser, 'j', c"json", c"Output results in JSON format")
    args_flag(@parser, 0, c"junit", c"Output results in JUnit XML format")
    args_flag(@parser, 0, c"color", c"Force colored output (even when not a TTY)")
    args_flag(@parser, 0, c"no-color", c"Disable colored output")

    if args_parse(@parser, argc, argv) != 0
        return -1

    if args_get_flag(@parser, 'h') != 0
        args_print_help(@parser)
        return 1  # Exit without error, but don't run tests

    g_verbose = args_get_flag(@parser, 'v')
    g_quiet = args_get_flag(@parser, 'q')
    g_list_only = args_get_flag(@parser, 'l')
    g_filter = args_get_str(@parser, 'f')
    g_timeout_ms = args_get_int(@parser, 't')
    g_no_fork = args_get_flag_long(@parser, c"no-fork")
    g_fail_fast = args_get_flag(@parser, 'x')
    g_shuffle = args_get_flag(@parser, 's')
    g_seed = args_get_int_long(@parser, c"seed")
    g_json = args_get_flag(@parser, 'j')
    g_junit = args_get_flag_long(@parser, c"junit")

    let force_color: i32 = args_get_flag_long(@parser, c"color")
    let no_color: i32 = args_get_flag_long(@parser, c"no-color")

    if force_color != 0 && no_color != 0
        eprints("ritzunit: --color and --no-color are mutually exclusive\n")
        return -1

    if force_color != 0
        g_color = 1
        set_color_mode(1)
    else if no_color != 0
        g_color = -1
        set_color_mode(-1)

    if g_verbose != 0 && g_quiet != 0
        eprints("ritzunit: --verbose and --quiet are mutually exclusive\n")
        return -1

    if g_json != 0 && g_junit != 0
        eprints("ritzunit: --json and --junit are mutually exclusive\n")
        return -1

    # JSON or JUnit implies quiet and no color
    if g_json != 0 || g_junit != 0
        g_quiet = 1
        set_color_mode(-1)

    return 0

fn matches_filter(name: *u8) -> i32
    return filter_match(g_filter, name)

# ============================================================================
# Entry Point
# ============================================================================

# The runner's entry point. bin_main.ritz's `main` calls it; it is not `main`
# itself so a test that imports this module does not define `main`.
pub fn ritzunit_main(argc: i32, argv: **u8) -> i32
    let parse_result: i32 = parse_args(argc, argv)
    if parse_result != 0
        if parse_result > 0
            return 0  # Help was shown, exit cleanly
        return 1  # Parse error

    return run_tests()
