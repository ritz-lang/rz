# ritzunit/src/runner.ritz - The test runner linked into every test binary
#
# A test binary is a test file compiled in test mode, linked with this runner
# (LANGUAGE_SPEC.md §17.1). The compiler emits a table of the file's
# `[[test]]` functions; the runner is the binary's `main` (bin_main.ritz) and
# runs each entry of that table in a forked child.
#
#   * Discovery is the compiler's table, not a symbol-name convention: a
#     `[[test]] fn check_x` runs, a helper `fn test_x` does not.
#   * Each test runs in its own child. Its stdout and stderr go to a capture
#     file, so a test's output can neither interleave with nor corrupt the
#     report (--json stays parseable). Output of a test that did not pass is
#     shown under its result.
#   * The exit status is 0 iff every selected test passed, else 1. (It used
#     to be the failure count, which the kernel truncates mod 256.)
#
# CLI Options:
#   -v, --verbose    Show detailed output including test names as they run
#   -q, --quiet      Minimal output - only show failures and summary
#   -f, --filter     Filter tests by name substring
#   -l, --list       List tests without running them
#   -t, --timeout    Timeout per test in milliseconds (default: 5000)
#   -j, --jobs N     Run up to N tests at once (default: 1); reported in order
#   --json           JSON report (no short form: -j is --jobs, as in make/rz)
#   --no-fork        Disable fork isolation (run tests in main process)
#   --core           Let a crashing test dump core (default: it cannot)
#   -h, --help       Show help message
#
# `--help` prints the full list; parse_args builds it with ritzlib.argspec.

import ritzlib.sys
import ritzlib.io
import ritzlib.memory
import ritzlib.option
import ritzlib.result
import ritzlib.span
import ritzlib.gvec
import ritzlib.argspec
import ritzlib.str
import ritzlib.strview
import ritzlib.os.env
import ritzunit.wait_status

# ============================================================================
# The compiler-emitted test table (LANGUAGE_SPEC §17.1)
# ============================================================================

# One `[[test]]` function. `name` is NUL-terminated (`len` excludes the NUL).
struct RitzTest
    name: StrView
    run: fn() -> i32

# The table itself, `__ritz_test_table`, is defined by the test file's
# test-mode compile. bin_main.ritz reads it and passes it in: a declaration
# here would collide with that definition in any test that imports the runner.

# ============================================================================
# Constants
# ============================================================================

const SEEK_SET: i32 = 0
const SEEK_END: i32 = 2

const MFD_CLOEXEC: i64 = 1

const PR_SET_DUMPABLE: i64 = 4
const RLIMIT_CORE: i64 = 4

# Output kept per failing test: the last CAPTURE_KEEP bytes. A diagnostic is
# at the end of a test's output, and a runaway test must not exhaust memory.
const CAPTURE_KEEP: i64 = 65536

# ============================================================================
# CLI Options
# ============================================================================

struct RunOptions
    verbose: i32         # -v: show detailed output
    quiet: i32           # -q: minimal output
    list_only: i32       # -l: list tests without running
    filter: *u8          # -f: filter pattern (null = no filter)
    timeout_ms: i64      # -t: timeout per test in ms
    no_fork: i32         # --no-fork: disable fork isolation
    fail_fast: i32       # --fail-fast: stop on first failure
    shuffle: i32         # --shuffle: randomize test order
    seed: i64            # --seed: random seed (0 = auto from time)
    json: i32            # --json: output in JSON format
    junit: i32           # --junit: output in JUnit XML format
    jobs: i64            # -j: tests run at once (forked children)
    core: i32            # --core: let a crashing test dump core

pub fn options_default() -> RunOptions
    var o: RunOptions
    o.verbose = 0
    o.quiet = 0
    o.list_only = 0
    o.filter = null
    o.timeout_ms = 5000
    o.no_fork = 0
    o.fail_fast = 0
    o.shuffle = 0
    o.seed = 0
    o.json = 0
    o.junit = 0
    o.jobs = 1
    o.core = 0
    o

# ============================================================================
# Timing
# ============================================================================

fn get_time_ms() -> i64
    var tv: Timeval
    sys_gettimeofday(@tv, null)
    return tv.tv_sec * 1000 + tv.tv_usec / 1000

fn get_time_us() -> i64
    var tv: Timeval
    sys_gettimeofday(@tv, null)
    return tv.tv_sec * 1000000 + tv.tv_usec

# ============================================================================
# Simple PRNG (Linear Congruential Generator), for --shuffle
# ============================================================================

const RNG_MODULUS: i64 = 2147483647     # MINSTD: 2^31 - 1, prime
const RNG_MULTIPLIER: i64 = 48271

var g_rng_state: i64 = 1

# Any i64 seed (a clock reading is ~1.8e15) maps into MINSTD's domain,
# 1..RNG_MODULUS-1. There the state stays (the modulus is prime, so 0 is
# never reached), positive (so rng_next() % n indexes in bounds) and below
# 2^31 (so `state * RNG_MULTIPLIER` < 2^47 never overflows).
fn rng_seed(seed: i64)
    var r: i64 = seed % (RNG_MODULUS - 1)    # -(M-2)..M-2; never traps
    if r < 0
        r = r + (RNG_MODULUS - 1)
    g_rng_state = r + 1

fn rng_next() -> i64
    # Lehmer LCG (MINSTD)
    g_rng_state = (g_rng_state * RNG_MULTIPLIER) % RNG_MODULUS
    return g_rng_state

# Fisher-Yates shuffle of the run order
fn shuffle_order(order: *i64, count: i64)
    if count <= 1
        return
    for i in 0..(count - 1)
        let j: i64 = i + (rng_next() % (count - i))
        let tmp: i64 = order[i]
        order[i] = order[j]
        order[j] = tmp

# ============================================================================
# Test Execution
# ============================================================================

# The exit status a test's result becomes in its child. Only the low 8 bits
# of an exit status survive, so a non-zero result whose low byte is zero (256)
# would read as a pass: report it as 1 instead.
pub fn test_exit_status(ret: i32) -> i32
    if ret != 0 && (ret & 255) == 0
        return 1
    return ret

# The capture file a child writes its stdout and stderr to: a memfd, one per
# pool slot, emptied before each test. -1 if it could not be created (output
# then goes to the runner's own stdout/stderr).
fn capture_open() -> i32
    let fd: i64 = syscall2(SYS_MEMFD_CREATE, c"ritzunit-capture" as i64, MFD_CLOEXEC)
    if fd < 0
        return -1
    return fd as i32

fn capture_reset(fd: i32)
    if fd < 0
        return
    syscall2(SYS_FTRUNCATE, fd as i64, 0)
    sys_lseek(fd, 0, SEEK_SET)

# The last CAPTURE_KEEP bytes a child wrote to `fd`, in a fresh allocation.
fn capture_take(fd: i32) -> StrView
    var out: StrView = strview_empty()
    if fd < 0
        return out
    let size: i64 = sys_lseek(fd, 0, SEEK_END)
    if size <= 0
        return out
    var start: i64 = 0
    if size > CAPTURE_KEEP
        start = size - CAPTURE_KEEP
    let want: i64 = size - start
    let buf: *u8 = malloc(want + 1)
    if buf == null
        return out
    sys_lseek(fd, start, SEEK_SET)
    var got: i64 = 0
    while got < want
        let n: i64 = sys_read(fd, buf + got, want - got)
        if n <= 0
            break
        got += n
    buf[got] = 0
    out.ptr = buf
    out.len = got
    return out

# A forked test child may not dump core (AGAST #2072). The kernel runs the
# core handler before the runner sees the crash; a piped core_pattern (apport,
# systemd-coredump) can outlast the test's deadline, and the runner's SIGKILL
# then turns the crash into a timeout. Not dumpable: no handler runs at all.
# RLIMIT_CORE 0 also stops a plain-file pattern should something make the
# process dumpable again (an exec, a setuid). --core keeps both as they were.
fn child_disable_core(opts: @RunOptions)
    if opts.core != 0
        return
    syscall2(SYS_PRCTL, PR_SET_DUMPABLE, 0)
    var zero: [2]i64
    zero[0] = 0
    zero[1] = 0
    syscall2(SYS_SETRLIMIT, RLIMIT_CORE, @zero[0] as i64)

# Run a test directly in the current process (no isolation).
fn run_test_direct(test: *RitzTest) -> i32
    let run: fn() -> i32 = test.run
    return run()

# ============================================================================
# The pool: up to opts.jobs forked children at once (-j N, AGAST #1909)
# ============================================================================
#
# The runner blocks SIGCHLD and sleeps in rt_sigtimedwait until a child exits
# or the earliest live deadline passes: no busy poll, and one long test cannot
# delay another's timeout. Every child gets its own capture memfd. Results are
# reported in run order (table order, or the --shuffle order), never finish
# order, so the report does not depend on scheduling; with --fail-fast it is
# exactly what -j 1 reports.

# One live child.
struct PoolSlot
    pid: i32             # 0: slot free
    pos: i64             # the test's index in the run list
    start_ms: i64
    deadline_ms: i64
    killed: i32          # 1 once SIGKILLed for passing its deadline
    capture_fd: i32

# One test's outcome, held until every test before it has been reported.
struct Outcome
    done: i32
    result: TestRunResult
    elapsed: i64
    output: StrView      # captured output, only for a test that did not pass

fn sigchld_mask() -> i64
    return (1 as i64) << ((SIGCHLD - 1) as i64)

fn outcome_fail_to_start(out: *Outcome)
    out.done = 1
    out.result.status = TEST_RESULT_FAIL
    out.result.exit_code = -1
    out.result.signal = 0
    out.elapsed = 0
    out.output = strview_empty()

# Fork the test at run-list position `pos` into `slot`. A failed fork records
# the test as failed at once.
fn pool_launch(opts: @RunOptions, slot: *PoolSlot, test: *RitzTest, pos: i64, out: *Outcome, old_mask: *i64) -> i32
    capture_reset(slot.capture_fd)
    # A child without a capture file writes to our stdout: the report so far
    # must be there first. With one, the report stays buffered.
    if slot.capture_fd < 0
        out_flush()
    let pid: i32 = sys_fork()
    if pid < 0
        outcome_fail_to_start(out)
        return 0

    if pid == 0
        # === Child: the test sees the signal mask the runner started with ===
        sys_rt_sigprocmask(SIG_SETMASK, old_mask, null, 8)
        # The report buffered so far is the runner's to write, not the test's.
        out_discard()
        child_disable_core(opts)
        if slot.capture_fd >= 0
            sys_dup2(slot.capture_fd, 1)
            sys_dup2(slot.capture_fd, 2)
        let run: fn() -> i32 = test.run
        sys_exit(test_exit_status(run()))
        return 0

    slot.pid = pid
    slot.pos = pos
    slot.start_ms = get_time_ms()
    slot.deadline_ms = slot.start_ms + opts.timeout_ms
    slot.killed = 0
    return 1

# Record a reaped child's outcome and free its slot.
fn pool_record(slot: *PoolSlot, status: i32, outcomes: *Outcome)
    let out: *Outcome = @outcomes[slot.pos]
    out.elapsed = get_time_ms() - slot.start_ms
    result_from_reap(status, slot.killed, @out.result)
    out.output = strview_empty()
    if out.result.status != TEST_RESULT_PASS
        out.output = capture_take(slot.capture_fd)
    out.done = 1
    slot.pid = 0

# Reap every child that has exited; the number reaped.
fn pool_reap(slots: *PoolSlot, nslots: i64, outcomes: *Outcome) -> i32
    var reaped: i32 = 0
    loop
        var status: i32 = 0
        let pid: i32 = sys_wait4(-1, @status, WNOHANG, null)
        if pid <= 0
            return reaped
        for i in 0..nslots
            let slot: *PoolSlot = @slots[i]
            if slot.pid == pid
                pool_record(slot, status, outcomes)
                reaped += 1
                break

# Block until at least one child is reaped. Children past their deadline are
# killed (and reaped once they are gone); the wait ends no later than the
# earliest deadline still pending.
fn pool_wait(slots: *PoolSlot, nslots: i64, outcomes: *Outcome)
    let mask: i64 = sigchld_mask()
    loop
        if pool_reap(slots, nslots, outcomes) > 0
            return
        let now: i64 = get_time_ms()
        var earliest: i64 = -1
        for i in 0..nslots
            let slot: *PoolSlot = @slots[i]
            if slot.pid != 0 && slot.killed == 0
                if slot.deadline_ms <= now
                    sys_kill(slot.pid, SIGKILL)
                    slot.killed = 1
                else if earliest < 0 || slot.deadline_ms < earliest
                    earliest = slot.deadline_ms
        # SIGCHLD is blocked, so a child that exited since pool_reap is a
        # pending signal and this returns at once.
        if earliest < 0
            syscall4(SYS_RT_SIGTIMEDWAIT, @mask as i64, 0, 0, 8)
        else
            var ts: [2]i64
            let wait_ms: i64 = earliest - now
            ts[0] = wait_ms / 1000
            ts[1] = (wait_ms % 1000) * 1000000
            syscall4(SYS_RT_SIGTIMEDWAIT, @mask as i64, 0, @ts[0] as i64, 8)

# Kill and reap every live child (--fail-fast stopped the run).
fn pool_abandon(slots: *PoolSlot, nslots: i64)
    for i in 0..nslots
        let slot: *PoolSlot = @slots[i]
        if slot.pid != 0
            sys_kill(slot.pid, SIGKILL)
            var status: i32 = 0
            sys_wait4(slot.pid, @status, 0, null)
            slot.pid = 0

# ============================================================================
# Reporter Integration
# ============================================================================

import ritzunit.reporter
import ritzunit.types
import ritzunit.filter
import ritzunit.json_reporter
import ritzunit.junit_reporter

fn signal_name(sig: i32) -> StrView
    if sig == SIGSEGV
        return "SIGSEGV"
    if sig == SIGABRT
        return "SIGABRT"
    if sig == SIGFPE
        return "SIGFPE"
    if sig == SIGILL
        return "SIGILL"
    if sig == SIGBUS
        return "SIGBUS"
    if sig == SIGKILL
        return "SIGKILL"
    if sig == SIGTERM
        return "SIGTERM"
    if sig == SIGINT
        return "SIGINT"
    if sig == SIGTRAP
        return "SIGTRAP"
    if sig == SIGPIPE
        return "SIGPIPE"
    return "signal"

# A failed test's captured output, under its result line (human mode).
fn print_captured(output: StrView)
    if output.len == 0
        return
    out_str(output)
    if output.ptr[output.len - 1] != 10
        out_str("\n")

# Report one test's outcome; 1 if it did not pass.
fn report_outcome(opts: @RunOptions, test: *RitzTest, out: *Outcome, summary: *TestSummary) -> i32
    var name: StrView = test.name
    let elapsed: i64 = out.elapsed
    if out.result.status == TEST_RESULT_PASS
        if opts.json != 0
            json_record_pass(name, elapsed)
        else if opts.junit != 0
            junit_record_pass(name, elapsed)
        else if opts.quiet == 0
            print_test_pass(name, elapsed)
        summary_record(summary, TEST_PASS, elapsed)
        return 0

    var output: StrView = out.output
    if out.result.status == TEST_RESULT_SIGNAL
        var sig_name: StrView = signal_name(out.result.signal)
        if opts.json != 0
            json_record_crash(name, elapsed, out.result.signal, output)
        else if opts.junit != 0
            junit_record_crash(name, elapsed, out.result.signal, sig_name)
        else
            print_test_crash(name, elapsed, out.result.signal, sig_name)
            print_captured(output)
        summary_record(summary, TEST_CRASH, elapsed)
    else if out.result.status == TEST_RESULT_TIMEOUT
        if opts.json != 0
            json_record_timeout(name, elapsed, output)
        else if opts.junit != 0
            junit_record_timeout(name, elapsed)
        else
            print_test_timeout(name, opts.timeout_ms)
            print_captured(output)
        summary_record(summary, TEST_TIMEOUT, elapsed)
    else
        if opts.json != 0
            json_record_fail(name, elapsed, out.result.exit_code, output)
        else if opts.junit != 0
            junit_record_fail(name, elapsed, out.result.exit_code)
        else
            print_test_fail(name, elapsed, out.result.exit_code)
            print_captured(output)
        summary_record(summary, TEST_FAIL, elapsed)
    return 1

# Run the run list in a pool of up to opts.jobs children, reporting in run order.
fn run_pool(opts: @RunOptions, tests: *RitzTest, run: *i64, nrun: i64, outcomes: *Outcome, summary: *TestSummary)
    var nslots: i64 = opts.jobs
    if nslots > nrun
        nslots = nrun
    if nslots <= 0
        return
    var slots: *PoolSlot = malloc(nslots * sizeof(PoolSlot)) as *PoolSlot
    if slots == null
        eprints("ritzunit: out of memory\n")
        return
    for i in 0..nslots
        slots[i].pid = 0
        slots[i].capture_fd = capture_open()

    var mask: i64 = sigchld_mask()
    var old_mask: i64 = 0
    sys_rt_sigprocmask(SIG_BLOCK, @mask, @old_mask, 8)

    var next: i64 = 0       # next position to launch
    var reported: i64 = 0   # next position to report
    var live: i64 = 0
    while reported < nrun
        # Fill free slots.
        for i in 0..nslots
            if next < nrun && slots[i].pid == 0
                if pool_launch(opts, @slots[i], @tests[run[next]], next, @outcomes[next], @old_mask) != 0
                    live += 1
                next += 1
        # Report whatever is finished, in order.
        var stop: i32 = 0
        while reported < next && outcomes[reported].done != 0
            let failed: i32 = report_outcome(opts, @tests[run[reported]], @outcomes[reported], summary)
            reported += 1
            if failed != 0 && opts.fail_fast != 0
                stop = 1
                break
        if stop != 0
            pool_abandon(slots, nslots)
            break
        if reported < nrun && live > 0
            pool_wait(slots, nslots, outcomes)
            live = 0
            for i in 0..nslots
                if slots[i].pid != 0
                    live += 1

    sys_rt_sigprocmask(SIG_SETMASK, @old_mask, null, 8)
    for i in 0..nslots
        if slots[i].capture_fd >= 0
            sys_close(slots[i].capture_fd)

# ============================================================================
# Main Test Runner
# ============================================================================

# Run every selected test of `tests` (`count` entries); 0 iff all of them
# passed, else 1. The report is flushed before this returns.
pub fn run_tests(opts: @RunOptions, tests: *RitzTest, count: i64) -> i32
    let status: i32 = run_selected(opts, tests, count)
    out_flush()
    return status

fn run_selected(opts: @RunOptions, tests: *RitzTest, count: i64) -> i32
    if opts.quiet == 0 && opts.json == 0
        print_banner()

    if count == 0
        if opts.json != 0
            json_print_report(0, 0, 0, 0, 0, 0, 0)
        else
            out_str("No tests found.\n")
        return 0

    var order: *i64 = malloc(count * 8) as *i64
    if order == null
        eprints("ritzunit: out of memory\n")
        return 1
    for i in 0..count
        order[i] = i

    if opts.shuffle != 0
        var seed: i64 = opts.seed
        if seed == 0
            seed = get_time_us()
        rng_seed(seed)
        shuffle_order(order, count)
        if opts.verbose != 0
            out_str("Shuffled tests with seed: ")
            out_int(seed)
            out_str("\n")

    if opts.list_only != 0
        out_str("Discovered ")
        out_int(count)
        out_str(" test(s):\n")
        for i in 0..count
            let test: *RitzTest = @tests[order[i]]
            if filter_match(opts.filter, test.name.ptr) != 0
                out_str("  ")
                out_str(test.name)
                out_str("\n")
        return 0

    if opts.quiet == 0
        print_suite_header(strview_from_cstr(c"tests"))

    # The run list: the selected tests, in run order.
    var run: *i64 = malloc(count * 8) as *i64
    var outcomes: *Outcome = malloc(count * sizeof(Outcome)) as *Outcome
    if run == null || outcomes == null
        eprints("ritzunit: out of memory\n")
        return 1
    var nrun: i64 = 0
    var skipped_by_filter: i32 = 0
    for i in 0..count
        if filter_match(opts.filter, tests[order[i]].name.ptr) == 0
            skipped_by_filter += 1
        else
            run[nrun] = order[i]
            outcomes[nrun].done = 0
            nrun += 1

    # Load ritzlib.os.env's cache here, in the runner, before any fork (AGAST
    # #3725). A child is not dumpable (child_disable_core), and the kernel
    # makes a non-dumpable process's /proc/self/* root-owned: its first
    # env_get would find /proc/self/environ unreadable and see no environment
    # at all. Forked children inherit this cache instead. When the test does
    # not import ritzlib.os.env, this is the runner's private copy: harmless.
    env_iter()

    var summary: TestSummary = summary_new()
    let total_start: i64 = get_time_ms()

    if opts.no_fork != 0
        for k in 0..nrun
            let out: *Outcome = @outcomes[k]
            # The test writes to our stdout: the report so far goes first.
            out_flush()
            let start: i64 = get_time_ms()
            let ret: i32 = test_exit_status(run_test_direct(@tests[run[k]]))
            out.elapsed = get_time_ms() - start
            out.result.exit_code = ret
            out.result.signal = 0
            out.result.status = TEST_RESULT_PASS
            if ret != 0
                out.result.status = TEST_RESULT_FAIL
            out.output = strview_empty()
            if report_outcome(opts, @tests[run[k]], out, @summary) != 0 && opts.fail_fast != 0
                break
    else
        run_pool(opts, tests, run, nrun, outcomes, @summary)

    summary.duration_ms = get_time_ms() - total_start

    if opts.json != 0
        json_print_report(summary.total, summary.passed, summary.failed, summary.crashed, summary.timeout, skipped_by_filter, summary.duration_ms)
    else if opts.junit != 0
        # JUnit combines crashed and timeout as "errors"
        let errors: i32 = summary.crashed + summary.timeout
        junit_print_report(summary.total, summary.passed, summary.failed, errors, summary.duration_ms)
    else
        if opts.quiet == 0
            print_suite_divider()
            print_suite_summary(summary.total, summary.passed, summary.failed, summary.crashed, summary.timeout, summary.duration_ms)
        print_grand_summary(summary.total, summary.passed, summary.failed, summary.crashed, summary.timeout, skipped_by_filter, summary.duration_ms)

    return run_exit_status(@summary)

# 0 iff nothing failed, crashed or timed out; else 1.
pub fn run_exit_status(summary: @TestSummary) -> i32
    if summary.failed + summary.crashed + summary.timeout > 0
        return 1
    return 0

# ============================================================================
# CLI Argument Parsing
# ============================================================================

# The command line ritzunit accepts. Order is the --help order.
fn runner_spec() -> ArgSpec
    var spec = argspec_new("ritzunit", "Unit test framework for Ritz")
    spec.switch('v', "verbose", "Show detailed output")
    spec.switch('q', "quiet", "Minimal output - only failures and summary")
    spec.switch('l', "list", "List tests without running them")
    spec.switch('h', "help", "Show this help message")
    spec.option('f', "filter", "EXPR", "Filter tests by EXPR (glob, @attr, bool)", None)
    spec.option('t', "timeout", "MS", "Timeout per test in milliseconds", Some("5000"))
    spec.switch(0, "no-fork", "Disable fork isolation (run tests in main process)")
    spec.switch(0, "core", "Let a crashing test dump core (default: it cannot)")
    spec.switch('x', "fail-fast", "Stop on first test failure")
    spec.switch('s', "shuffle", "Randomize test execution order")
    spec.option(0, "seed", "N", "Random seed for shuffling (0 = auto)", Some("0"))
    spec.option('j', "jobs", "N", "Run up to N tests at once, each in its own child", Some("1"))
    spec.switch(0, "json", "Output results in JSON format")
    spec.switch(0, "junit", "Output results in JUnit XML format")
    spec.switch(0, "color", "Force colored output (even when not a TTY)")
    spec.switch(0, "no-color", "Disable colored output")
    spec

# RunOptions keeps its flags as i32.
fn switch_flag(p: @ParsedArgs, name: StrView) -> i32
    if p.switch(name)
        return 1
    0

# A usage error, reported on stderr: parse_args' -1.
fn usage_error(spec: @ArgSpec, e: ArgError) -> i32
    spec.error_print(@e)
    -1

fn store_i64(out: *i64, n: i64) -> i32
    *out = n
    0

# Option `name`'s value (given or default) as an i64 into *out: 0, or -1 on a
# value that is not a number.
fn int_option(spec: @ArgSpec, p: @ParsedArgs, name: StrView, out: *i64) -> i32
    match p.int(name)
        Ok(n) => store_i64(out, n)
        Err(e) => usage_error(spec, e)

# The filter as RunOptions holds it: null when not given. A value is a view
# into argv (`-f EXPR`, or the tail of `--filter=EXPR`), so its bytes end at
# argv's own NUL and `.ptr` is a C string.
fn filter_cstr(v: Option<StrView>) -> *u8
    match v
        Some(s) => s.ptr
        None => null

# Fill `opts` from the command line: 0 to run, 1 if help was shown, -1 on a
# usage error (reported on stderr). ritzunit takes no positional arguments.
pub fn parse_args(all: Span<StrView>, opts: *RunOptions) -> i32
    var spec = runner_spec()
    let args = all.from(1)
    let status: i32 = match spec.parse(args)
        Ok(p) => options_from(@spec, p, opts)
        Err(e) => usage_error(@spec, e)
    spec.deinit()
    status

fn options_from(spec: @ArgSpec, p: ParsedArgs, opts: *RunOptions) -> i32
    var parsed = p
    let status = fill_options(spec, @parsed, opts)
    parsed.deinit()
    status

fn fill_options(spec: @ArgSpec, p: @ParsedArgs, opts: *RunOptions) -> i32
    if p.switch("help")
        spec.print_help()
        return 1  # Exit without error, but don't run tests

    opts.verbose = switch_flag(p, "verbose")
    opts.quiet = switch_flag(p, "quiet")
    opts.list_only = switch_flag(p, "list")
    opts.filter = filter_cstr(p.value("filter"))
    if int_option(spec, p, "timeout", @opts.timeout_ms) != 0
        return -1
    opts.no_fork = switch_flag(p, "no-fork")
    opts.core = switch_flag(p, "core")
    opts.fail_fast = switch_flag(p, "fail-fast")
    opts.shuffle = switch_flag(p, "shuffle")
    if int_option(spec, p, "seed", @opts.seed) != 0
        return -1
    opts.json = switch_flag(p, "json")
    if int_option(spec, p, "jobs", @opts.jobs) != 0
        return -1
    if opts.jobs < 1
        eprints("ritzunit: --jobs must be at least 1\n")
        return -1
    opts.junit = switch_flag(p, "junit")

    let force_color: i32 = switch_flag(p, "color")
    let no_color: i32 = switch_flag(p, "no-color")

    if force_color != 0 && no_color != 0
        eprints("ritzunit: --color and --no-color are mutually exclusive\n")
        return -1

    # Color is the reporter's state, not an option of the run.
    if force_color != 0
        set_color_mode(1)
    else if no_color != 0
        set_color_mode(-1)

    if opts.verbose != 0 && opts.quiet != 0
        eprints("ritzunit: --verbose and --quiet are mutually exclusive\n")
        return -1

    if opts.json != 0 && opts.junit != 0
        eprints("ritzunit: --json and --junit are mutually exclusive\n")
        return -1

    # JSON or JUnit implies quiet and no color
    if opts.json != 0 || opts.junit != 0
        opts.quiet = 1
        set_color_mode(-1)

    return 0

# ============================================================================
# Entry Point
# ============================================================================

# The runner's entry point: bin_main.ritz's `main` calls it with the
# compiler-emitted test table. It is not `main` itself so a test that imports
# this module does not define `main`.
pub fn ritzunit_main(all: Span<StrView>, tests: *RitzTest, count: i64) -> i32
    var opts: RunOptions = options_default()
    let parse_result: i32 = parse_args(all, @opts)
    if parse_result != 0
        if parse_result > 0
            return 0  # Help was shown, exit cleanly
        return 1  # Parse error

    return run_tests(@opts, tests, count)
