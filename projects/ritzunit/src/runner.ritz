# ritzunit/src/runner.ritz - The test runner linked into every test binary
#
# A test binary is a test file compiled in test mode, linked with this runner
# (LANGUAGE_SPEC.md §17.1). The compiler emits a table of the file's
# `[[test]]` functions; the runner is the binary's `main` (bin_main.ritz) and
# runs each entry of that table in a forked child.
#
#   * Discovery is the compiler's table, not a symbol-name convention: a
#     `[[test]] fn check_x` runs, a helper `fn test_x` does not.
#   * Each test runs in its own child. Its stdout and stderr go to a capture
#     file, so a test's output can neither interleave with nor corrupt the
#     report (--json stays parseable). Output of a test that did not pass is
#     shown under its result.
#   * The exit status is 0 iff every selected test passed, else 1. (It used
#     to be the failure count, which the kernel truncates mod 256.)
#
# CLI Options:
#   -v, --verbose    Show detailed output including test names as they run
#   -q, --quiet      Minimal output - only show failures and summary
#   -f, --filter     Filter tests by name substring
#   -l, --list       List tests without running them
#   -t, --timeout    Timeout per test in milliseconds (default: 5000)
#   -j, --jobs N     Run up to N tests at once (default: 1); reported in order
#   --json           JSON report (no short form: -j is --jobs, as in make/rz)
#   --no-fork        Disable fork isolation (run tests in main process)
#   -h, --help       Show help message

import ritzlib.sys
import ritzlib.io
import ritzlib.memory
import ritzlib.args
import ritzlib.str
import ritzlib.strview

# ============================================================================
# The compiler-emitted test table (LANGUAGE_SPEC §17.1)
# ============================================================================

# One `[[test]]` function. `name` is NUL-terminated (`len` excludes the NUL).
struct RitzTest
    name: StrView
    run: fn() -> i32

# Defined by the test file's test-mode compile: stores the entry count and
# returns the first entry.
extern fn __ritz_test_table(count: *i64) -> *RitzTest

# ============================================================================
# Constants
# ============================================================================

const SEEK_SET: i32 = 0
const SEEK_END: i32 = 2

const SYS_MEMFD_CREATE: i64 = 319
const SYS_FTRUNCATE: i64 = 77
const MFD_CLOEXEC: i64 = 1

# Output kept per failing test: the last CAPTURE_KEEP bytes. A diagnostic is
# at the end of a test's output, and a runaway test must not exhaust memory.
const CAPTURE_KEEP: i64 = 65536

# ============================================================================
# Wait Status Macros (POSIX)
# ============================================================================

fn WIFEXITED(status: i32) -> i32
    return ((status & 127) == 0) as i32

fn WEXITSTATUS(status: i32) -> i32
    return (status >> 8) & 255

fn WIFSIGNALED(status: i32) -> i32
    let sig: i32 = status & 127
    return (sig != 0 && sig != 127) as i32

fn WTERMSIG(status: i32) -> i32
    return status & 127

# ============================================================================
# CLI Options (Global State)
# ============================================================================

var g_verbose: i32 = 0       # -v: show detailed output
var g_quiet: i32 = 0         # -q: minimal output
var g_list_only: i32 = 0     # -l: list tests without running
var g_filter: *u8 = 0 as *u8 # -f: filter pattern (null = no filter)
var g_timeout_ms: i64 = 5000 # -t: timeout per test in ms (default 5s)
var g_no_fork: i32 = 0       # --no-fork: disable fork isolation
var g_fail_fast: i32 = 0     # --fail-fast: stop on first failure
var g_shuffle: i32 = 0       # --shuffle: randomize test order
var g_seed: i64 = 0          # --seed: random seed (0 = auto from time)
var g_json: i32 = 0          # --json: output in JSON format
var g_junit: i32 = 0         # --junit: output in JUnit XML format
var g_color: i32 = 0         # 0=auto, 1=always, -1=never
var g_jobs: i64 = 1          # -j: tests run at once (forked children)

# ============================================================================
# Timing
# ============================================================================

fn get_time_ms() -> i64
    var tv: Timeval
    sys_gettimeofday(@tv, null)
    return tv.tv_sec * 1000 + tv.tv_usec / 1000

fn get_time_us() -> i64
    var tv: Timeval
    sys_gettimeofday(@tv, null)
    return tv.tv_sec * 1000000 + tv.tv_usec

# ============================================================================
# Simple PRNG (Linear Congruential Generator), for --shuffle
# ============================================================================

var g_rng_state: i64 = 0

fn rng_seed(seed: i64)
    g_rng_state = seed
    if g_rng_state == 0
        g_rng_state = 1  # Avoid zero state

fn rng_next() -> i64
    # LCG parameters (same as MINSTD)
    g_rng_state = (g_rng_state * 48271) % 2147483647
    return g_rng_state

# Fisher-Yates shuffle of the run order
fn shuffle_order(order: *i64, count: i64)
    if count <= 1
        return
    for i in 0..(count - 1)
        let j: i64 = i + (rng_next() % (count - i))
        let tmp: i64 = order[i]
        order[i] = order[j]
        order[j] = tmp

# ============================================================================
# Test Execution
# ============================================================================

const TEST_RESULT_PASS: i32 = 0      # Test passed (exit 0)
const TEST_RESULT_FAIL: i32 = 1      # Test failed (non-zero exit)
const TEST_RESULT_SIGNAL: i32 = 2    # Test killed by signal
const TEST_RESULT_TIMEOUT: i32 = 3   # Test timed out

struct TestRunResult
    status: i32          # TEST_RESULT_* constant
    exit_code: i32       # Exit code (if PASS/FAIL)
    signal: i32          # Signal number (if SIGNAL)

# The exit status a test's result becomes in its child. Only the low 8 bits
# of an exit status survive, so a non-zero result whose low byte is zero (256)
# would read as a pass: report it as 1 instead.
pub fn test_exit_status(ret: i32) -> i32
    if ret != 0 && (ret & 255) == 0
        return 1
    return ret

# The capture file a child writes its stdout and stderr to: a memfd, one per
# pool slot, emptied before each test. -1 if it could not be created (output
# then goes to the runner's own stdout/stderr).
fn capture_open() -> i32
    let fd: i64 = syscall2(SYS_MEMFD_CREATE, c"ritzunit-capture" as i64, MFD_CLOEXEC)
    if fd < 0
        return -1
    return fd as i32

fn capture_reset(fd: i32)
    if fd < 0
        return
    syscall2(SYS_FTRUNCATE, fd as i64, 0)
    sys_lseek(fd, 0, SEEK_SET)

# The last CAPTURE_KEEP bytes a child wrote to `fd`, in a fresh allocation.
fn capture_take(fd: i32) -> StrView
    var out: StrView = strview_empty()
    if fd < 0
        return out
    let size: i64 = sys_lseek(fd, 0, SEEK_END)
    if size <= 0
        return out
    var start: i64 = 0
    if size > CAPTURE_KEEP
        start = size - CAPTURE_KEEP
    let want: i64 = size - start
    let buf: *u8 = malloc(want + 1)
    if buf == null
        return out
    sys_lseek(fd, start, SEEK_SET)
    var got: i64 = 0
    while got < want
        let n: i64 = sys_read(fd, buf + got, want - got)
        if n <= 0
            break
        got += n
    buf[got] = 0
    out.ptr = buf
    out.len = got
    return out

# Run a test directly in the current process (no isolation).
fn run_test_direct(test: *RitzTest) -> i32
    let run: fn() -> i32 = test.run
    return run()

# What a reaped child's wait status means.
fn result_from_status(status: i32, result: *TestRunResult)
    result.exit_code = 0
    result.signal = 0
    if WIFEXITED(status) != 0
        result.exit_code = WEXITSTATUS(status)
        if result.exit_code == 0
            result.status = TEST_RESULT_PASS
        else
            result.status = TEST_RESULT_FAIL
    else if WIFSIGNALED(status) != 0
        result.status = TEST_RESULT_SIGNAL
        result.signal = WTERMSIG(status)
    else
        result.status = TEST_RESULT_FAIL
        result.exit_code = -1

# ============================================================================
# The pool: up to g_jobs forked children at once (-j N, AGAST #1909)
# ============================================================================
#
# The runner blocks SIGCHLD and sleeps in rt_sigtimedwait until a child exits
# or the earliest live deadline passes: no busy poll, and one long test cannot
# delay another's timeout. Every child gets its own capture memfd. Results are
# reported in run order (table order, or the --shuffle order), never finish
# order, so the report does not depend on scheduling; with --fail-fast it is
# exactly what -j 1 reports.

const SYS_RT_SIGTIMEDWAIT: i64 = 128

# One live child.
struct PoolSlot
    pid: i32             # 0: slot free
    pos: i64             # the test's index in the run list
    start_ms: i64
    deadline_ms: i64
    killed: i32          # 1 once SIGKILLed for passing its deadline
    capture_fd: i32

# One test's outcome, held until every test before it has been reported.
struct Outcome
    done: i32
    result: TestRunResult
    elapsed: i64
    output: StrView      # captured output, only for a test that did not pass

fn sigchld_mask() -> i64
    return (1 as i64) << ((SIGCHLD - 1) as i64)

fn outcome_fail_to_start(out: *Outcome)
    out.done = 1
    out.result.status = TEST_RESULT_FAIL
    out.result.exit_code = -1
    out.result.signal = 0
    out.elapsed = 0
    out.output = strview_empty()

# Fork the test at run-list position `pos` into `slot`. A failed fork records
# the test as failed at once.
fn pool_launch(slot: *PoolSlot, test: *RitzTest, pos: i64, out: *Outcome, old_mask: *i64) -> i32
    capture_reset(slot.capture_fd)
    let pid: i32 = sys_fork()
    if pid < 0
        outcome_fail_to_start(out)
        return 0

    if pid == 0
        # === Child: the test sees the signal mask the runner started with ===
        sys_rt_sigprocmask(SIG_SETMASK, old_mask, null, 8)
        if slot.capture_fd >= 0
            sys_dup2(slot.capture_fd, 1)
            sys_dup2(slot.capture_fd, 2)
        let run: fn() -> i32 = test.run
        sys_exit(test_exit_status(run()))
        return 0

    slot.pid = pid
    slot.pos = pos
    slot.start_ms = get_time_ms()
    slot.deadline_ms = slot.start_ms + g_timeout_ms
    slot.killed = 0
    return 1

# Record a reaped child's outcome and free its slot.
fn pool_record(slot: *PoolSlot, status: i32, outcomes: *Outcome)
    let out: *Outcome = @outcomes[slot.pos]
    out.elapsed = get_time_ms() - slot.start_ms
    if slot.killed != 0
        out.result.status = TEST_RESULT_TIMEOUT
        out.result.exit_code = 0
        out.result.signal = 0
    else
        result_from_status(status, @out.result)
    out.output = strview_empty()
    if out.result.status != TEST_RESULT_PASS
        out.output = capture_take(slot.capture_fd)
    out.done = 1
    slot.pid = 0

# Reap every child that has exited; the number reaped.
fn pool_reap(slots: *PoolSlot, nslots: i64, outcomes: *Outcome) -> i32
    var reaped: i32 = 0
    loop
        var status: i32 = 0
        let pid: i32 = sys_wait4(-1, @status, WNOHANG, null)
        if pid <= 0
            return reaped
        for i in 0..nslots
            let slot: *PoolSlot = @slots[i]
            if slot.pid == pid
                pool_record(slot, status, outcomes)
                reaped += 1
                break
    return reaped

# Block until at least one child is reaped. Children past their deadline are
# killed (and reaped once they are gone); the wait ends no later than the
# earliest deadline still pending.
fn pool_wait(slots: *PoolSlot, nslots: i64, outcomes: *Outcome)
    let mask: i64 = sigchld_mask()
    loop
        if pool_reap(slots, nslots, outcomes) > 0
            return
        let now: i64 = get_time_ms()
        var earliest: i64 = -1
        for i in 0..nslots
            let slot: *PoolSlot = @slots[i]
            if slot.pid != 0 && slot.killed == 0
                if slot.deadline_ms <= now
                    sys_kill(slot.pid, SIGKILL)
                    slot.killed = 1
                else if earliest < 0 || slot.deadline_ms < earliest
                    earliest = slot.deadline_ms
        # SIGCHLD is blocked, so a child that exited since pool_reap is a
        # pending signal and this returns at once.
        if earliest < 0
            syscall4(SYS_RT_SIGTIMEDWAIT, @mask as i64, 0, 0, 8)
        else
            var ts: [2]i64
            let wait_ms: i64 = earliest - now
            ts[0] = wait_ms / 1000
            ts[1] = (wait_ms % 1000) * 1000000
            syscall4(SYS_RT_SIGTIMEDWAIT, @mask as i64, 0, @ts[0] as i64, 8)

# Kill and reap every live child (--fail-fast stopped the run).
fn pool_abandon(slots: *PoolSlot, nslots: i64)
    for i in 0..nslots
        let slot: *PoolSlot = @slots[i]
        if slot.pid != 0
            sys_kill(slot.pid, SIGKILL)
            var status: i32 = 0
            sys_wait4(slot.pid, @status, 0, null)
            slot.pid = 0

# ============================================================================
# Reporter Integration
# ============================================================================

import ritzunit.reporter
import ritzunit.types
import ritzunit.filter
import ritzunit.json_reporter
import ritzunit.junit_reporter

fn signal_name(sig: i32) -> StrView
    if sig == SIGSEGV
        return "SIGSEGV"
    if sig == SIGABRT
        return "SIGABRT"
    if sig == SIGFPE
        return "SIGFPE"
    if sig == SIGILL
        return "SIGILL"
    if sig == SIGBUS
        return "SIGBUS"
    if sig == SIGKILL
        return "SIGKILL"
    if sig == SIGTERM
        return "SIGTERM"
    if sig == SIGINT
        return "SIGINT"
    if sig == SIGTRAP
        return "SIGTRAP"
    if sig == SIGPIPE
        return "SIGPIPE"
    return "signal"

# A failed test's captured output, under its result line (human mode).
fn print_captured(output: @StrView)
    if output.len == 0
        return
    sys_write(1, output.ptr, output.len)
    if output.ptr[output.len - 1] != 10
        prints("\n")

# Report one test's outcome; 1 if it did not pass.
fn report_outcome(test: *RitzTest, out: *Outcome, summary: *TestSummary) -> i32
    var name: StrView = test.name
    let elapsed: i64 = out.elapsed
    if out.result.status == TEST_RESULT_PASS
        if g_json != 0
            json_record_pass(@name, elapsed)
        else if g_junit != 0
            junit_record_pass(@name, elapsed)
        else if g_quiet == 0
            print_test_pass(name, elapsed)
        summary_record(summary, TEST_PASS, elapsed)
        return 0

    var output: StrView = out.output
    if out.result.status == TEST_RESULT_SIGNAL
        var sig_name: StrView = signal_name(out.result.signal)
        if g_json != 0
            json_record_crash(@name, elapsed, out.result.signal, @output)
        else if g_junit != 0
            junit_record_crash(@name, elapsed, out.result.signal, @sig_name)
        else
            print_test_crash(name, elapsed, out.result.signal, sig_name)
            print_captured(@output)
        summary_record(summary, TEST_CRASH, elapsed)
    else if out.result.status == TEST_RESULT_TIMEOUT
        if g_json != 0
            json_record_timeout(@name, elapsed, @output)
        else if g_junit != 0
            junit_record_timeout(@name, elapsed)
        else
            print_test_timeout(name, g_timeout_ms)
            print_captured(@output)
        summary_record(summary, TEST_TIMEOUT, elapsed)
    else
        if g_json != 0
            json_record_fail(@name, elapsed, out.result.exit_code, @output)
        else if g_junit != 0
            junit_record_fail(@name, elapsed, out.result.exit_code)
        else
            print_test_fail(name, elapsed, out.result.exit_code)
            print_captured(@output)
        summary_record(summary, TEST_FAIL, elapsed)
    return 1

# Run the run list in a pool of up to g_jobs children, reporting in run order.
fn run_pool(tests: *RitzTest, run: *i64, nrun: i64, outcomes: *Outcome, summary: *TestSummary)
    var nslots: i64 = g_jobs
    if nslots > nrun
        nslots = nrun
    if nslots <= 0
        return
    var slots: *PoolSlot = malloc(nslots * sizeof(PoolSlot)) as *PoolSlot
    if slots == null
        eprints("ritzunit: out of memory\n")
        return
    for i in 0..nslots
        slots[i].pid = 0
        slots[i].capture_fd = capture_open()

    var mask: i64 = sigchld_mask()
    var old_mask: i64 = 0
    sys_rt_sigprocmask(SIG_BLOCK, @mask, @old_mask, 8)

    var next: i64 = 0       # next position to launch
    var reported: i64 = 0   # next position to report
    var live: i64 = 0
    while reported < nrun
        # Fill free slots.
        for i in 0..nslots
            if next < nrun && slots[i].pid == 0
                if pool_launch(@slots[i], @tests[run[next]], next, @outcomes[next], @old_mask) != 0
                    live += 1
                next += 1
        # Report whatever is finished, in order.
        var stop: i32 = 0
        while reported < next && outcomes[reported].done != 0
            let failed: i32 = report_outcome(@tests[run[reported]], @outcomes[reported], summary)
            reported += 1
            if failed != 0 && g_fail_fast != 0
                stop = 1
                break
        if stop != 0
            pool_abandon(slots, nslots)
            break
        if reported < nrun && live > 0
            pool_wait(slots, nslots, outcomes)
            live = 0
            for i in 0..nslots
                if slots[i].pid != 0
                    live += 1

    sys_rt_sigprocmask(SIG_SETMASK, @old_mask, null, 8)
    for i in 0..nslots
        if slots[i].capture_fd >= 0
            sys_close(slots[i].capture_fd)

# ============================================================================
# Main Test Runner
# ============================================================================

# Run every selected test in the table; 0 iff all of them passed, else 1.
pub fn run_tests() -> i32
    if g_quiet == 0 && g_json == 0
        print_banner()

    var count: i64 = 0
    let tests: *RitzTest = __ritz_test_table(@count)

    if count == 0
        if g_json != 0
            json_print_report(0, 0, 0, 0, 0, 0, 0)
        else
            prints("No tests found.\n")
        return 0

    var order: *i64 = malloc(count * 8) as *i64
    if order == null
        eprints("ritzunit: out of memory\n")
        return 1
    for i in 0..count
        order[i] = i

    if g_shuffle != 0
        var seed: i64 = g_seed
        if seed == 0
            seed = get_time_us()
        rng_seed(seed)
        shuffle_order(order, count)
        if g_verbose != 0
            print("Shuffled tests with seed: {seed}\n")

    if g_list_only != 0
        print("Discovered {count} test(s):\n")
        for i in 0..count
            let test: *RitzTest = @tests[order[i]]
            if matches_filter(test.name.ptr) != 0
                prints("  ")
                prints(test.name)
                prints("\n")
        return 0

    if g_quiet == 0
        print_suite_header(strview_from_cstr(c"tests"))

    # The run list: the selected tests, in run order.
    var run: *i64 = malloc(count * 8) as *i64
    var outcomes: *Outcome = malloc(count * sizeof(Outcome)) as *Outcome
    if run == null || outcomes == null
        eprints("ritzunit: out of memory\n")
        return 1
    var nrun: i64 = 0
    var skipped_by_filter: i32 = 0
    for i in 0..count
        if matches_filter(tests[order[i]].name.ptr) == 0
            skipped_by_filter += 1
        else
            run[nrun] = order[i]
            outcomes[nrun].done = 0
            nrun += 1

    var summary: TestSummary = summary_new()
    let total_start: i64 = get_time_ms()

    if g_no_fork != 0
        for k in 0..nrun
            let out: *Outcome = @outcomes[k]
            let start: i64 = get_time_ms()
            let ret: i32 = test_exit_status(run_test_direct(@tests[run[k]]))
            out.elapsed = get_time_ms() - start
            out.result.exit_code = ret
            out.result.signal = 0
            out.result.status = TEST_RESULT_PASS
            if ret != 0
                out.result.status = TEST_RESULT_FAIL
            out.output = strview_empty()
            if report_outcome(@tests[run[k]], out, @summary) != 0 && g_fail_fast != 0
                break
    else
        run_pool(tests, run, nrun, outcomes, @summary)

    summary.duration_ms = get_time_ms() - total_start

    if g_json != 0
        json_print_report(summary.total, summary.passed, summary.failed, summary.crashed, summary.timeout, skipped_by_filter, summary.duration_ms)
    else if g_junit != 0
        # JUnit combines crashed and timeout as "errors"
        let errors: i32 = summary.crashed + summary.timeout
        junit_print_report(summary.total, summary.passed, summary.failed, errors, summary.duration_ms)
    else
        if g_quiet == 0
            print_suite_divider()
            print_suite_summary(summary.total, summary.passed, summary.failed, summary.crashed, summary.timeout, summary.duration_ms)
        print_grand_summary(summary.total, summary.passed, summary.failed, summary.crashed, summary.timeout, skipped_by_filter, summary.duration_ms)

    return run_exit_status(@summary)

# 0 iff nothing failed, crashed or timed out; else 1.
pub fn run_exit_status(summary: @TestSummary) -> i32
    if summary.failed + summary.crashed + summary.timeout > 0
        return 1
    return 0

# ============================================================================
# CLI Argument Parsing
# ============================================================================

fn parse_args(argc: i32, argv: **u8) -> i32
    var parser: ArgParser
    args_init(@parser, c"ritzunit", c"Unit test framework for Ritz")

    args_flag(@parser, 'v', c"verbose", c"Show detailed output")
    args_flag(@parser, 'q', c"quiet", c"Minimal output - only failures and summary")
    args_flag(@parser, 'l', c"list", c"List tests without running them")
    args_flag(@parser, 'h', c"help", c"Show this help message")
    args_option(@parser, 'f', c"filter", c"EXPR", c"Filter tests by EXPR (glob, @attr, bool)", null)
    args_option(@parser, 't', c"timeout", c"MS", c"Timeout per test in milliseconds", c"5000")
    args_flag(@parser, 0, c"no-fork", c"Disable fork isolation (run tests in main process)")
    args_flag(@parser, 'x', c"fail-fast", c"Stop on first test failure")
    args_flag(@parser, 's', c"shuffle", c"Randomize test execution order")
    args_option(@parser, 0, c"seed", c"N", c"Random seed for shuffling (0 = auto)", c"0")
    args_option(@parser, 'j', c"jobs", c"N", c"Run up to N tests at once, each in its own child", c"1")
    args_flag(@parser, 0, c"json", c"Output results in JSON format")
    args_flag(@parser, 0, c"junit", c"Output results in JUnit XML format")
    args_flag(@parser, 0, c"color", c"Force colored output (even when not a TTY)")
    args_flag(@parser, 0, c"no-color", c"Disable colored output")

    if args_parse(@parser, argc, argv) != 0
        return -1

    if args_get_flag(@parser, 'h') != 0
        args_print_help(@parser)
        return 1  # Exit without error, but don't run tests

    g_verbose = args_get_flag(@parser, 'v')
    g_quiet = args_get_flag(@parser, 'q')
    g_list_only = args_get_flag(@parser, 'l')
    g_filter = args_get_str(@parser, 'f')
    g_timeout_ms = args_get_int(@parser, 't')
    g_no_fork = args_get_flag_long(@parser, c"no-fork")
    g_fail_fast = args_get_flag(@parser, 'x')
    g_shuffle = args_get_flag(@parser, 's')
    g_seed = args_get_int_long(@parser, c"seed")
    g_json = args_get_flag_long(@parser, c"json")
    g_jobs = args_get_int(@parser, 'j')
    if g_jobs < 1
        eprints("ritzunit: --jobs must be at least 1\n")
        return -1
    g_junit = args_get_flag_long(@parser, c"junit")

    let force_color: i32 = args_get_flag_long(@parser, c"color")
    let no_color: i32 = args_get_flag_long(@parser, c"no-color")

    if force_color != 0 && no_color != 0
        eprints("ritzunit: --color and --no-color are mutually exclusive\n")
        return -1

    if force_color != 0
        g_color = 1
        set_color_mode(1)
    else if no_color != 0
        g_color = -1
        set_color_mode(-1)

    if g_verbose != 0 && g_quiet != 0
        eprints("ritzunit: --verbose and --quiet are mutually exclusive\n")
        return -1

    if g_json != 0 && g_junit != 0
        eprints("ritzunit: --json and --junit are mutually exclusive\n")
        return -1

    # JSON or JUnit implies quiet and no color
    if g_json != 0 || g_junit != 0
        g_quiet = 1
        set_color_mode(-1)

    return 0

fn matches_filter(name: *u8) -> i32
    return filter_match(g_filter, name)

# ============================================================================
# Entry Point
# ============================================================================

# The runner's entry point. bin_main.ritz's `main` calls it; it is not `main`
# itself so a test that imports this module does not define `main`.
pub fn ritzunit_main(argc: i32, argv: **u8) -> i32
    let parse_result: i32 = parse_args(argc, argv)
    if parse_result != 0
        if parse_result > 0
            return 0  # Help was shown, exit cleanly
        return 1  # Parse error

    return run_tests()
