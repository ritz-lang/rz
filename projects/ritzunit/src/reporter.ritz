# ritzunit/src/reporter.ritz - Visual test output formatting
#
# Provides test output with:
# - One test per line with right-aligned status
# - Suite grouping with per-suite summaries
# - Grand total summary
# - ANSI colors when output is a TTY (auto-detected)
# - The report buffer every report is written through (out_*)

import ritzlib.fmt.digits
import ritzlib.str
import ritzlib.sys
import ritzlib.strview
import ritzlib.fd { fd_stdout }
import ritzlib.span { Span }

# ============================================================================
# Constants
# ============================================================================

const LINE_WIDTH: i32 = 70       # Total width of output line
const DOT_MIN: i32 = 3           # Minimum dots between name and status

# IOCTL for checking TTY (TIOCGWINSZ on Linux)
const TIOCGWINSZ: i64 = 0x5413

# File descriptors
const STDOUT_FD: i32 = 1

# ============================================================================
# The report buffer
# ============================================================================
#
# Every report (human, --json, --junit) is written here and reaches stdout in
# large writes, not one syscall per fragment (AGAST #1910). The runner flushes
# at the end of a run, and before anything else could write to stdout in
# between: a test run in the runner's own process (--no-fork), or a child
# whose output has no capture file.

const OUT_CAP: i64 = 8192

var g_out: [8192]u8
var g_out_len: i64 = 0

# Write everything buffered to stdout.
pub fn out_flush()
    fd_stdout().write_all(Span<u8> { ptr: @g_out[0], len: g_out_len })
    g_out_len = 0

# Drop everything buffered (a test starts from an empty buffer).
pub fn out_discard()
    g_out_len = 0

# What is buffered and not yet written.
pub fn out_pending() -> StrView
    var v: StrView
    v.ptr = @g_out[0]
    v.len = g_out_len
    v

pub fn out_write(p: *u8, n: i64)
    if g_out_len + n > OUT_CAP
        out_flush()
    if n >= OUT_CAP
        fd_stdout().write_all(Span<u8> { ptr: p, len: n })
        return
    memcpy(@g_out[g_out_len], p, n)
    g_out_len += n

pub fn out_str(s: StrView)
    out_write(s.ptr, s.len)

pub fn out_byte(c: u8)
    var b: [1]u8
    b[0] = c
    out_write(@b[0], 1)

pub fn out_int(n: i64)
    var buf: [20]u8
    let len: i64 = fmt_i64_into(@buf[0], n)
    out_write(@buf[0], len)

# ============================================================================
# Color Detection
# ============================================================================

# Check if a file descriptor is a TTY
fn isatty(fd: i32) -> i32
    var winsize: [4]i32  # struct winsize is 8 bytes
    let ret: i64 = syscall3(SYS_IOCTL, fd as i64, TIOCGWINSZ, @winsize as i64)
    return (ret >= 0) as i32

# Global color state (initialized once on first use)
var g_color_initialized: i32 = 0
var g_use_color: i32 = 0
var g_color_forced: i32 = 0  # 0=auto, 1=force on, -1=force off

# Force color mode (call before init)
pub fn set_color_mode(mode: i32)
    g_color_forced = mode
    g_color_initialized = 0  # Reset to re-init

fn init_color()
    if g_color_initialized != 0
        return
    g_color_initialized = 1

    if g_color_forced > 0
        g_use_color = 1
    else if g_color_forced < 0
        g_use_color = 0
    else
        g_use_color = isatty(STDOUT_FD)

# Check if we should use colors
fn use_color() -> i32
    init_color()
    return g_use_color

# ============================================================================
# ANSI Color Codes
# ============================================================================
fn color_reset()
    if use_color() == 0
        return
    out_str("\e[0m")

fn color_green()
    if use_color() == 0
        return
    out_str("\e[32m")

fn color_red()
    if use_color() == 0
        return
    out_str("\e[31m")

fn color_yellow()
    if use_color() == 0
        return
    out_str("\e[33m")

fn color_bold()
    if use_color() == 0
        return
    out_str("\e[1m")

fn color_dim()
    if use_color() == 0
        return
    out_str("\e[2m")

# ============================================================================
# Banner and Headers
# ============================================================================

# Print the ritzunit banner
pub fn print_banner()
    color_bold()
    out_str("======================================================================\n")
    out_str("  RITZUNIT v0.1.0 - Test Framework for Ritz\n")
    out_str("======================================================================")
    color_reset()
    out_str("\n\n")

# Print suite header (suite name)
pub fn print_suite_header(name: StrView)
    out_str(name)
    out_str("\n")

# Print suite footer/divider
pub fn print_suite_divider()
    out_str("  ----------------------------------------------------------------------\n")

# Print grand total divider
fn print_grand_divider()
    out_str("======================================================================\n")

# ============================================================================
# Right-Aligned Test Result Output
# ============================================================================

# Print dots to fill space between name and status
fn print_dots(count: i32)
    var i: i32 = 0
    while i < count
        out_str(".")
        i += 1

# ============================================================================
# Test Result Functions
# ============================================================================

# Print a passing test result
pub fn print_test_pass(name: StrView, duration_ms: i64)
    # Calculate length first
    let name_len: i64 = name.len

    # Print indent and test name
    out_str("  ")
    out_str(name)
    out_str(" ")
    let status_len: i64 = 2  # "OK"

    # Build status string with time: "OK (123ms)"
    var time_width: i32 = 7  # " (Xms)" minimum
    if duration_ms >= 10
        time_width = 8
    if duration_ms >= 100
        time_width = 9
    if duration_ms >= 1000
        time_width = 10
    if duration_ms >= 10000
        time_width = 11

    let total_status_width: i32 = status_len as i32 + time_width

    # Dots = LINE_WIDTH - indent(2) - name_len - space(1) - status_width
    var dots: i32 = LINE_WIDTH - 2 - name_len as i32 - 1 - total_status_width
    if dots < DOT_MIN
        dots = DOT_MIN

    color_dim()
    print_dots(dots)
    color_reset()

    # Print status (green) and time
    out_str(" ")
    color_green()
    out_str("OK")
    color_reset()
    out_str(" (")
    out_int(duration_ms)
    out_str("ms)\n")

# Print a failing test result
pub fn print_test_fail(name: StrView, duration_ms: i64, error_code: i32)
    # Calculate length first
    let name_len: i64 = name.len

    out_str("  ")
    out_str(name)
    out_str(" ")
    var dots: i32 = LINE_WIDTH - 2 - name_len as i32 - 1 - 20  # "FAIL [code=XX] (Xms)"
    if dots < DOT_MIN
        dots = DOT_MIN

    color_dim()
    print_dots(dots)
    color_reset()

    out_str(" ")
    color_red()
    color_bold()
    out_str("FAIL")
    color_reset()
    out_str(" [code=")
    out_int(error_code as i64)
    out_str("] (")
    out_int(duration_ms)
    out_str("ms)\n")

# Print a crashed test result
pub fn print_test_crash(name: StrView, duration_ms: i64, signal: i32, signal_name: StrView)
    # Calculate lengths first
    let name_len: i64 = name.len
    let sig_len: i64 = signal_name.len

    out_str("  ")
    out_str(name)
    out_str(" ")
    var dots: i32 = LINE_WIDTH - 2 - name_len as i32 - 1 - 10 - sig_len as i32  # "CRASH (SIG) (Xms)"
    if dots < DOT_MIN
        dots = DOT_MIN

    color_dim()
    print_dots(dots)
    color_reset()

    out_str(" ")
    color_red()
    color_bold()
    out_str("CRASH")
    color_reset()
    out_str(" (")
    out_str(signal_name)
    out_str(") (")
    out_int(duration_ms)
    out_str("ms)\n")

# Print a timed out test result
pub fn print_test_timeout(name: StrView, timeout_ms: i64)
    # Calculate length first
    let name_len: i64 = name.len

    out_str("  ")
    out_str(name)
    out_str(" ")
    var dots: i32 = LINE_WIDTH - 2 - name_len as i32 - 1 - 18  # "TIMEOUT (XXXXXms)"
    if dots < DOT_MIN
        dots = DOT_MIN

    color_dim()
    print_dots(dots)
    color_reset()

    out_str(" ")
    color_yellow()
    color_bold()
    out_str("TIMEOUT")
    color_reset()
    out_str(" (")
    out_int(timeout_ms)
    out_str("ms)\n")

# ============================================================================
# Suite Summary
# ============================================================================

# Print suite summary line
pub fn print_suite_summary(total: i32, passed: i32, failed: i32, crashed: i32, timeout: i32, duration_ms: i64)
    out_str("  ")
    out_int(total as i64)
    out_str(" tests: ")
    out_int(passed as i64)
    out_str(" passed")

    if failed > 0
        out_str(", ")
        out_int(failed as i64)
        out_str(" failed")

    if crashed > 0
        out_str(", ")
        out_int(crashed as i64)
        out_str(" crashed")

    if timeout > 0
        out_str(", ")
        out_int(timeout as i64)
        out_str(" timeout")

    # Right-align total time
    out_str(" (")
    out_int(duration_ms)
    out_str("ms)\n\n")

# ============================================================================
# Grand Total Summary
# ============================================================================

# Print the final grand total summary
pub fn print_grand_summary(total: i32, passed: i32, failed: i32, crashed: i32, timeout: i32, skipped: i32, duration_ms: i64)
    print_grand_divider()

    color_bold()
    out_str("TOTAL: ")
    color_reset()
    out_int(total as i64)
    out_str(" tests")

    out_str(" | ")
    color_green()
    out_int(passed as i64)
    out_str(" passed")
    color_reset()

    if failed > 0
        out_str(" | ")
        color_red()
        out_int(failed as i64)
        out_str(" failed")
        color_reset()

    if crashed > 0
        out_str(" | ")
        color_red()
        out_int(crashed as i64)
        out_str(" crashed")
        color_reset()

    if timeout > 0
        out_str(" | ")
        color_yellow()
        out_int(timeout as i64)
        out_str(" timeout")
        color_reset()

    if skipped > 0
        out_str(" | ")
        color_yellow()
        out_int(skipped as i64)
        out_str(" skipped")
        color_reset()

    out_str(" (")
    out_int(duration_ms)
    out_str("ms)\n")
    print_grand_divider()
