# test/test_assertions.ritz - Self-tests for ritzunit.assertions
#
# Exercises the real module (no local copies) on inputs where every check
# holds. A failing helper exits its test, so the failure paths (exit status,
# the calling test's line, both strings printed, junit's message) are pinned
# from outside by projects/ritz/ritz0/test_ritzunit_assertions.py.
#
# Integer, bool and pointer checks are plain `assert` (AGAST #2127).

import ritzlib.strview
import ritzunit.assertions

# ============================================================================
# assert_str_eq / assert_str_eq_sv
# ============================================================================

[[test]]
fn test_str_eq_holds() -> i32
    assert_str_eq(c"abc", c"abc")
    assert_str_eq(c"", c"")
    0

[[test]]
fn test_str_eq_sv_holds() -> i32
    var a: StrView = strview_from_cstr(c"same bytes")
    var b: StrView = strview_from_cstr(c"same bytes")
    assert_str_eq_sv(@a, @b)
    0

# ============================================================================
# assert_starts_with / assert_starts_with_sv
# ============================================================================

[[test]]
fn test_starts_with_holds() -> i32
    assert_starts_with(c"hello world", c"hello")
    assert_starts_with(c"hello", c"hello")
    assert_starts_with(c"hello", c"")
    0

[[test]]
fn test_starts_with_sv_holds() -> i32
    var s: StrView = strview_from_cstr(c"prefix-rest")
    var p: StrView = strview_from_cstr(c"prefix-")
    assert_starts_with_sv(@s, @p)
    0

# ============================================================================
# assert_contains / assert_contains_sv
# ============================================================================

[[test]]
fn test_contains_holds() -> i32
    assert_contains(c"hello world", c"o w")
    assert_contains(c"hello world", c"world")
    assert_contains(c"hello", c"hello")
    0

[[test]]
fn test_contains_sv_holds() -> i32
    var h: StrView = strview_from_cstr(c"needle in a haystack")
    var n: StrView = strview_from_cstr(c"in a")
    assert_contains_sv(@h, @n)
    0

# ============================================================================
# What replaced the integer / bool / null helpers
# ============================================================================

[[test]]
fn test_plain_assert_covers_scalars() -> i32
    let n: i32 = 42
    let big: i64 = 2147483648
    let ok: bool = n > 0
    let p: *u8 = c"x"
    assert n == 42
    assert n != 17
    assert n < 100
    assert n <= 42
    assert n > -1
    assert n >= 42
    assert big == 2147483648
    assert ok
    assert p != null
    0
