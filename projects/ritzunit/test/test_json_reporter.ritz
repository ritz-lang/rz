# test/test_json_reporter.ritz - the --json report the test harness parses
#
# projects/ritz/ritz0/test_runner.py passes or fails a test file on this
# report, and a failing test's captured output goes into it verbatim: a raw
# control byte there makes the whole report unparseable.
#
# A test child is forked from the runner and shares these modules with it, so
# it starts with the runner's records and buffered report: fresh() drops both.

import ritzlib.strview
import ritzunit.assertions
import ritzunit.reporter
import ritzunit.json_reporter

fn fresh()
    out_discard()
    json_reset()

[[test]]
fn plain_text_is_quoted() -> i32
    out_discard()
    print_json_string_sv("hello world")
    assert_str_eq_sv(out_pending(), "\"hello world\"")
    0

[[test]]
fn quote_and_backslash_are_escaped() -> i32
    out_discard()
    print_json_string_sv("a\"b\\c")
    assert_str_eq_sv(out_pending(), "\"a\\\"b\\\\c\"")
    0

[[test]]
fn newline_tab_and_cr_use_short_escapes() -> i32
    out_discard()
    print_json_string_sv("1\n2\t3\r")
    assert_str_eq_sv(out_pending(), "\"1\\n2\\t3\\r\"")
    0

[[test]]
fn other_control_bytes_are_u_escaped() -> i32
    out_discard()
    print_json_string_sv("\x01x\x1f\e")
    assert_str_eq_sv(out_pending(), "\"\\u0001x\\u001f\\u001b\"")
    0

[[test]]
fn the_empty_string_is_two_quotes() -> i32
    out_discard()
    print_json_string_sv("")
    assert_str_eq_sv(out_pending(), "\"\"")
    0

[[test]]
fn the_report_has_the_summary_and_every_result() -> i32
    fresh()
    json_record_pass("ok_test", 1)
    json_record_fail("bad_test", 2, 3, "line1\nline2")
    json_record_crash("crash_test", 4, 11, "")
    json_record_timeout("slow_test", 5, "")
    json_print_report(4, 1, 1, 1, 1, 2, 20)
    var r: StrView = out_pending()
    assert_starts_with_sv(r, "\{\n  \"version\": \"0.1.0\",\n")
    assert_contains_sv(r, "\"total\": 4,\n    \"passed\": 1,\n    \"failed\": 1,\n    \"crashed\": 1,\n    \"timeout\": 1,\n    \"skipped\": 2,\n    \"duration_ms\": 20\n")
    assert_contains_sv(r, "\{\"name\": \"ok_test\", \"status\": \"pass\", \"duration_ms\": 1\},\n")
    assert_contains_sv(r, "\{\"name\": \"bad_test\", \"status\": \"fail\", \"duration_ms\": 2, \"exit_code\": 3, \"output\": \"line1\\nline2\"\},\n")
    assert_contains_sv(r, "\{\"name\": \"crash_test\", \"status\": \"crash\", \"duration_ms\": 4, \"signal\": 11\},\n")
    # The last entry has no trailing comma.
    assert_contains_sv(r, "\{\"name\": \"slow_test\", \"status\": \"timeout\", \"duration_ms\": 5\}\n  ]\n\}\n")
    0

[[test]]
fn an_empty_run_is_still_a_report() -> i32
    fresh()
    json_print_report(0, 0, 0, 0, 0, 0, 0)
    assert_contains_sv(out_pending(), "\"tests\": [\n  ]\n\}\n")
    0
