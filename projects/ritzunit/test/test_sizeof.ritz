# test/test_sizeof.ritz - sizeof and field layout of a mixed-width struct
#
# ritzunit's inventory example stores fixed-size name buffers next to wider
# integer fields. These tests pin the C-compatible layout that code relies on:
# fields in declaration order, each aligned to its own size, and the struct
# padded to a multiple of its widest field.

import ritzlib.sys

struct Item
    name: [32]u8       # Fixed-size name buffer
    name_len: i64      # Actual name length
    quantity: i32      # Current quantity

[[test]]
fn test_sizeof_primitives() -> i32
    assert sizeof(u8) == 1
    assert sizeof(i32) == 4
    assert sizeof(i64) == 8
    0

[[test]]
fn test_sizeof_item_is_padded_to_i64_alignment() -> i32
    # 32 (name) + 8 (name_len) + 4 (quantity) = 44, padded up to 48.
    assert sizeof(Item) == 48
    0

[[test]]
fn test_item_field_offsets() -> i32
    var item: Item
    let base: i64 = @item as i64
    assert (@item.name[0] as i64) - base == 0
    assert (@item.name_len as i64) - base == 32
    assert (@item.quantity as i64) - base == 40
    0
