# test/test_filter.ritz - which test names a -f expression selects

import ritzlib.option
import ritzlib.strview
import ritzunit.filter

fn sel(pattern: StrView, name: StrView) -> i32
    filter_match_sv(pattern, name)

[[test]]
fn no_filter_selects_everything() -> i32
    assert filter_match(None, "anything") == 1
    assert sel("", "anything") == 1
    0

[[test]]
fn a_plain_pattern_is_a_substring() -> i32
    assert sel("add", "test_add_item") == 1
    assert sel("remove", "test_add_item") == 0
    assert filter_match(Some("add"), "test_add_item") == 1
    0

[[test]]
fn a_glob_matches_the_whole_name() -> i32
    assert sel("test_add*", "test_add_item") == 1
    assert sel("add*", "test_add_item") == 0
    assert sel("*_item", "test_add_item") == 1
    assert sel("test_?dd_item", "test_add_item") == 1
    assert sel("test_?dd", "test_add_item") == 0
    0

[[test]]
fn and_or_not_combine() -> i32
    assert sel("test_add* and not *slow*", "test_add_item") == 1
    assert sel("test_add* and not *slow*", "test_add_slow") == 0
    assert sel("alpha or beta", "check_beta") == 1
    assert sel("alpha or beta", "check_gamma") == 0
    assert sel("not alpha", "check_beta") == 1
    assert sel("not alpha", "check_alpha") == 0
    0

[[test]]
fn a_keyword_inside_a_word_is_not_an_operator() -> i32
    # "android" contains "and", "order" contains "or": substrings, not ops.
    assert sel("android", "test_android") == 1
    assert sel("order", "test_order") == 1
    0

[[test]]
fn attributes_go_by_the_name() -> i32
    assert sel("@slow", "test_slow_io") == 1
    assert sel("@slow", "test_io") == 0
    assert sel("@fast", "test_io") == 1
    assert sel("@fast", "test_slow_io") == 0
    assert sel("@ignore", "test_ignore_me") == 1
    assert sel("@skip", "test_ignore_me") == 1
    assert sel("@bogus", "test_bogus") == 0
    0

[[test]]
fn suite_syntax_matches_the_test_part() -> i32
    assert sel("inventory::add", "test_add_item") == 1
    assert sel("inventory::test_add*", "test_add_item") == 1
    assert sel("inventory::remove", "test_add_item") == 0
    0
