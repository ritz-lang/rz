# test/test_reap_result.ritz - what a reaped child's wait status reports
#
# AGAST #2070: the pool SIGKILLs a child at its deadline right after a
# WNOHANG reap found nothing. A child that crashed or exited in between is a
# zombie the kill cannot touch, and its status says what it did; the runner
# reported it as a timeout regardless (a SIGSEGV test read "timeout" on a
# loaded CI runner). Only a SIGKILL death after our kill is the timeout.

import ritzlib.sys
import ritzunit.wait_status

# Raw wait4 statuses: low 7 bits the terminating signal, else exit code << 8.
fn status_signaled(sig: i32) -> i32
    sig

fn status_exited(code: i32) -> i32
    code << 8

[[test]]
fn crash_before_the_kill_is_a_crash() -> i32
    var r: TestRunResult
    result_from_reap(status_signaled(SIGSEGV), 1, @r)
    assert r.status == TEST_RESULT_SIGNAL
    assert r.signal == SIGSEGV
    0

[[test]]
fn failing_exit_before_the_kill_is_a_failure() -> i32
    var r: TestRunResult
    result_from_reap(status_exited(3), 1, @r)
    assert r.status == TEST_RESULT_FAIL
    assert r.exit_code == 3
    0

[[test]]
fn passing_exit_before_the_kill_passes() -> i32
    var r: TestRunResult
    result_from_reap(status_exited(0), 1, @r)
    assert r.status == TEST_RESULT_PASS
    0

[[test]]
fn sigkill_after_the_kill_is_a_timeout() -> i32
    var r: TestRunResult
    result_from_reap(status_signaled(SIGKILL), 1, @r)
    assert r.status == TEST_RESULT_TIMEOUT
    assert r.signal == 0
    0

[[test]]
fn sigkill_without_our_kill_is_a_crash() -> i32
    var r: TestRunResult
    result_from_reap(status_signaled(SIGKILL), 0, @r)
    assert r.status == TEST_RESULT_SIGNAL
    assert r.signal == SIGKILL
    0
