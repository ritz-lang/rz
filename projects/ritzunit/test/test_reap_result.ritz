# test/test_reap_result.ritz - what a reaped child's wait status reports
#
# AGAST #2070: the pool SIGKILLs a child at its deadline right after a
# WNOHANG reap found nothing. A child that crashed or exited in between is a
# zombie the kill cannot touch, and its status says what it did; the runner
# reported it as a timeout regardless (a SIGSEGV test read "timeout" on a
# loaded CI runner). Only a SIGKILL death after our kill is the timeout.

import ritzlib.sys
import ritzlib.process { ProcessResult }
import ritzunit.wait_status

# How ritzlib.process reports a child killed by `sig`, or exiting with `code`.
fn status_signaled(sig: i32) -> ProcessResult
    ProcessResult { exit_code: 128 + sig, signaled: 1, signal: sig }

fn status_exited(code: i32) -> ProcessResult
    ProcessResult { exit_code: code, signaled: 0, signal: 0 }

[[test]]
fn crash_before_the_kill_is_a_crash() -> i32
    let r: TestRunResult = result_from_reap(status_signaled(SIGSEGV), 1)
    assert r.status == TEST_RESULT_SIGNAL
    assert r.signal == SIGSEGV
    0

[[test]]
fn failing_exit_before_the_kill_is_a_failure() -> i32
    let r: TestRunResult = result_from_reap(status_exited(3), 1)
    assert r.status == TEST_RESULT_FAIL
    assert r.exit_code == 3
    0

[[test]]
fn neither_exited_nor_killed_is_a_failure() -> i32
    # A stopped child: ritzlib.process reports exit_code -1, not signaled.
    let r: TestRunResult = result_from_process(ProcessResult { exit_code: -1, signaled: 0, signal: 0 })
    assert r.status == TEST_RESULT_FAIL
    assert r.exit_code == -1
    0

[[test]]
fn passing_exit_before_the_kill_passes() -> i32
    let r: TestRunResult = result_from_reap(status_exited(0), 1)
    assert r.status == TEST_RESULT_PASS
    0

[[test]]
fn sigkill_after_the_kill_is_a_timeout() -> i32
    let r: TestRunResult = result_from_reap(status_signaled(SIGKILL), 1)
    assert r.status == TEST_RESULT_TIMEOUT
    assert r.signal == 0
    0

[[test]]
fn sigkill_without_our_kill_is_a_crash() -> i32
    let r: TestRunResult = result_from_reap(status_signaled(SIGKILL), 0)
    assert r.status == TEST_RESULT_SIGNAL
    assert r.signal == SIGKILL
    0
