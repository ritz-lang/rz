# test/test_junit_reporter.ritz - the --junit XML report

import ritzlib.strview
import ritzunit.assertions
import ritzunit.reporter
import ritzunit.junit_reporter

# A test child shares these modules with the runner it was forked from.
fn fresh()
    out_discard()
    junit_reset()

[[test]]
fn a_pass_is_a_self_closing_testcase() -> i32
    fresh()
    junit_record_pass("ok_test", 1234)
    junit_print_report(1, 1, 0, 0, 1234)
    var r: StrView = out_pending()
    assert_starts_with_sv(r, "<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n")
    assert_contains_sv(r, "<testsuite name=\"ritzunit\" tests=\"1\" failures=\"0\" errors=\"0\" time=\"1.234\">\n")
    assert_contains_sv(r, "  <testcase name=\"ok_test\" time=\"1.234\"/>\n")
    assert_contains_sv(r, "</testsuite>\n")
    0

[[test]]
fn a_failure_carries_the_exit_code() -> i32
    fresh()
    junit_record_fail("bad_test", 5, 3)
    junit_print_report(1, 0, 1, 0, 5)
    assert_contains_sv(out_pending(), "  <testcase name=\"bad_test\" time=\"0.005\">\n    <failure message=\"exit code 3\">Test assertion failed</failure>\n  </testcase>\n")
    0

[[test]]
fn a_crash_and_a_timeout_are_errors() -> i32
    fresh()
    junit_record_crash("crash_test", 50, 11, "SIGSEGV")
    junit_record_timeout("slow_test", 0)
    junit_print_report(2, 0, 0, 2, 50)
    var r: StrView = out_pending()
    assert_contains_sv(r, "<error message=\"signal 11\">SIGSEGV</error>\n")
    assert_contains_sv(r, "<testcase name=\"slow_test\" time=\"0.000\">\n    <error message=\"timeout\">Test timed out</error>\n")
    0

[[test]]
fn markup_in_a_name_is_escaped() -> i32
    fresh()
    junit_record_pass("a<b>&\"c'", 0)
    junit_print_report(1, 1, 0, 0, 0)
    assert_contains_sv(out_pending(), "<testcase name=\"a&lt;b&gt;&amp;&quot;c&apos;\"")
    0
