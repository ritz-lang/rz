# inventory/src/lib.ritz - A simple item inventory system
#
# Demonstrates ritzunit testing with a practical example.
# Manages named items with quantities - perfect for games,
# warehouses, or any item tracking scenario.
#
# Names live in fixed-size buffers (MAX_NAME_LEN, truncated) rather than a
# nested Vec<u8> per item, so an Item is plain data and inventory_drop only
# frees the item vector. test/test_inventory.ritz imports this module; it
# used to carry its own copy of the whole implementation (AGAST #1873).

import ritzlib.gvec
import ritzlib.memory
import ritzlib.fmt.digits { fmt_i64_into }

# ============================================================================
# Item - A named item with a quantity
# ============================================================================
# Use fixed-size name buffer to avoid nested Vec complexity.

pub const MAX_NAME_LEN: i64 = 32

pub struct Item
    name: [32]u8       # Fixed-size name buffer
    name_len: i64      # Actual name length
    quantity: i32      # Current quantity

# ============================================================================
# Inventory - Collection of items
# ============================================================================

pub struct Inventory
    items: Vec<Item>   # Dynamic array of items

# ============================================================================
# Constructors
# ============================================================================

pub fn inventory_new() -> Inventory
    var inv: Inventory
    inv.items = vec_new<Item>()
    return inv

pub fn inventory_drop(inv:&Inventory)
    inv.items.deinit()

# ============================================================================
# String helpers
# ============================================================================

# Copy null-terminated string into fixed buffer, return length
fn copy_name(dst: *u8, src: *u8) -> i64
    var i: i64 = 0
    while *(src + i) != 0 && i < MAX_NAME_LEN - 1
        *(dst + i) = *(src + i)
        i += 1
    *(dst + i) = 0  # Null terminate
    return i

# Compare item name with null-terminated string
fn name_eq(item: *Item, name: *u8) -> i32
    var i: i64 = 0
    while i < item.name_len
        if *(name + i) == 0
            return 0  # name ended early
        if item.name[i] != *(name + i)
            return 0  # mismatch
        i += 1
    # Check name is also at end
    if *(name + i) == 0
        return 1
    return 0

# ============================================================================
# Core Operations
# ============================================================================

pub fn inventory_add(inv:&Inventory, name: *u8, qty: i32) -> i32
    # Search for existing item
    var i: i64 = 0
    while i < inv.items.len
        let item: *Item = inv.items.get_ptr(i)
        if name_eq(item, name) == 1
            item.quantity = item.quantity + qty
            return 0
        i += 1

    # Not found - create new item
    var new_item: Item
    new_item.name_len = copy_name(@new_item.name[0], name)
    new_item.quantity = qty

    inv.items.push(new_item)
    return 0

pub fn inventory_remove(inv:&Inventory, name: *u8, qty: i32) -> i32
    var i: i64 = 0
    while i < inv.items.len
        let item: *Item = inv.items.get_ptr(i)
        if name_eq(item, name) == 1
            if item.quantity < qty
                return -1  # Insufficient quantity
            item.quantity = item.quantity - qty
            return 0
        i += 1
    return -1  # Not found

pub fn inventory_count(inv:&Inventory, name: *u8) -> i32
    var i: i64 = 0
    while i < inv.items.len
        let item: *Item = inv.items.get_ptr(i)
        if name_eq(item, name) == 1
            return item.quantity
        i += 1
    return 0

pub fn inventory_has(inv:&Inventory, name: *u8) -> i32
    if inventory_count(inv, name) > 0
        return 1
    return 0

pub fn inventory_len(inv:&Inventory) -> i64
    return inv.items.len

pub fn inventory_clear(inv:&Inventory)
    inv.items.clear()

pub fn inventory_total_quantity(inv:&Inventory) -> i32
    var total: i32 = 0
    var i: i64 = 0
    while i < inv.items.len
        let item: *Item = inv.items.get_ptr(i)
        total = total + item.quantity
        i += 1
    return total

# ============================================================================
# JSON Serialization
# ============================================================================

# Helper to print a character
fn emit_char(buf: *Vec<u8>, c: u8)
    buf.push(c)

# Helper to print a string into buffer
fn emit_str(buf: *Vec<u8>, s: *u8)
    var i: i64 = 0
    while *(s + i) != 0
        buf.push(*(s + i))
        i += 1

# Helper to emit integer (digits from ritzlib.fmt; i32's minimum was "-")
fn emit_int(buf: *Vec<u8>, n: i32)
    var tmp: [20]u8
    let digits: StrView = fmt_i64_into(@tmp, n as i64)
    for i in 0..digits.len
        emit_char(buf, tmp[i])

# Serialize inventory to JSON string
# Format: {"items":[{"name":"sword","quantity":5},...],"count":N}
pub fn inventory_to_json(inv:&Inventory, buf: *Vec<u8>)
    emit_char(buf, 123)  # {
    emit_char(buf, 34)   # "
    emit_str(buf, c"items")
    emit_char(buf, 34)   # "
    emit_char(buf, 58)   # :
    emit_char(buf, 91)   # [

    var i: i64 = 0
    while i < inv.items.len
        if i > 0
            emit_char(buf, 44)  # ,
        let item: *Item = inv.items.get_ptr(i)

        emit_char(buf, 123)  # {
        emit_char(buf, 34)   # "
        emit_str(buf, c"name")
        emit_char(buf, 34)   # "
        emit_char(buf, 58)   # :
        emit_char(buf, 34)   # "
        # Emit name
        var j: i64 = 0
        while j < item.name_len
            emit_char(buf, item.name[j])
            j += 1
        emit_char(buf, 34)   # "
        emit_char(buf, 44)   # ,
        emit_char(buf, 34)   # "
        emit_str(buf, c"quantity")
        emit_char(buf, 34)   # "
        emit_char(buf, 58)   # :
        emit_int(buf, item.quantity)
        emit_char(buf, 125)  # }
        i += 1

    emit_char(buf, 93)   # ]
    emit_char(buf, 44)   # ,
    emit_char(buf, 34)   # "
    emit_str(buf, c"count")
    emit_char(buf, 34)   # "
    emit_char(buf, 58)   # :
    emit_int(buf, inv.items.len as i32)
    emit_char(buf, 125)  # }
    emit_char(buf, 0)    # null terminator
