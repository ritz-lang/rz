# Prism - PPM Image Writer
#
# Writes pixel buffers to PPM format for debugging.
# PPM is a simple ASCII/binary image format that most image viewers can open.
#
# Format: P6 (binary PPM)
# - Header: "P6\n{width} {height}\n255\n"
# - Data: RGB bytes (no alpha)

import ritzlib.gvec { Vec, vec_with_cap }
import ritzlib.strview { StrView }
import ritzlib.fmt.digits { fmt_u64_into }

# Write a pixel buffer (ARGB u32 format) to a PPM file
pub fn write_ppm(path: StrView, pixels: @Vec<u32>, width: u32, height: u32) -> bool
    # TODO: Write the bytes to `path` once prism has file I/O.
    # For now this only produces them.
    let bytes = generate_ppm_bytes(pixels, width, height)
    bytes.len() > 0

# Write from a MockBackend's front buffer
pub fn write_ppm_from_buffer(path: StrView, buffer: @Vec<u32>, width: u32, height: u32) -> bool
    write_ppm(path, buffer, width, height)

# Generate PPM bytes (for when we can write to files)
pub fn generate_ppm_bytes(pixels: @Vec<u32>, width: u32, height: u32) -> Vec<u8>
    let count = width as i64 * height as i64
    # Header is at most 2 + 10 + 1 + 10 + 5 bytes
    var result = vec_with_cap<u8>(28 + count * 3)

    # Header: "P6\n{width} {height}\n255\n"
    ppm_push_str(@&result, "P6\n")
    ppm_push_number(@&result, width)
    result.push(32)  # ' '
    ppm_push_number(@&result, height)
    ppm_push_str(@&result, "\n255\n")

    # RGB data
    var i: i64 = 0
    while i < count
        let argb = pixels[i]
        result.push(((argb >> 16) & 0xFF) as u8)  # R
        result.push(((argb >> 8) & 0xFF) as u8)   # G
        result.push((argb & 0xFF) as u8)          # B
        i += 1

    result

# Append the bytes of a string to a byte vec
fn ppm_push_str(vec: @&Vec<u8>, s: StrView)
    var i: i64 = 0
    while i < s.len()
        vec.push(s.get(i))
        i += 1

# Append n's decimal digits (from ritzlib.fmt, #1957)
pub fn ppm_push_number(vec: @&Vec<u8>, n: u32)
    var buf: [20]u8
    let len: i64 = fmt_u64_into(@buf[0], n as u64)
    var i: i64 = 0
    while i < len
        vec.push(buf[i])
        i += 1
