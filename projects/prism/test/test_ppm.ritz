# Prism - PPM Writer Tests

import ritzlib.gvec { Vec, vec_new }
import util.ppm { generate_ppm_bytes, write_ppm }

[[test]]
fn test_ppm_header_and_rgb() -> i32
    var pixels = vec_new<u32>()
    pixels.push(0xFF102030)
    pixels.push(0x00A0B0C0)  # Alpha is dropped

    let bytes = generate_ppm_bytes(@pixels, 2, 1)
    # "P6\n2 1\n255\n" is 11 bytes, then 2 pixels * 3 bytes
    assert bytes.len() == 17
    assert bytes[0] == 80   # 'P'
    assert bytes[1] == 54   # '6'
    assert bytes[3] == 50   # '2'
    assert bytes[4] == 32   # ' '
    assert bytes[5] == 49   # '1'
    assert bytes[11] == 0x10
    assert bytes[12] == 0x20
    assert bytes[13] == 0x30
    assert bytes[14] == 0xA0
    assert bytes[16] == 0xC0
    assert write_ppm("out.ppm", @pixels, 2, 1)
    0

[[test]]
fn test_ppm_multi_digit_dimensions() -> i32
    var pixels = vec_new<u32>()
    var i = 0
    while i < 120
        pixels.push(0)
        i += 1

    let bytes = generate_ppm_bytes(@pixels, 120, 1)
    # "P6\n120 1\n255\n" is 13 bytes
    assert bytes.len() == 13 + 360
    assert bytes[3] == 49   # '1'
    assert bytes[4] == 50   # '2'
    assert bytes[5] == 48   # '0'
    assert bytes[6] == 32   # ' '
    0
