# Prism Core Tests
#
# The core types as the rest of prism sees them: through the types.mod
# re-exports. test_rect.ritz and test_color.ritz cover the geometry and
# colour operations; this file covers constructors, conversions and ids
# they don't. These used to redefine Point/Size/Rect/Color locally and test
# the copies (AGAST #1873).

import types.mod { Point, Size, Rect, Color, WindowId, SurfaceId, FontId, ImageId, IdGenerator }

# ============================================================================
# Point / Size
# ============================================================================

[[test]]
fn test_point_zero() -> i32
    let p = Point.zero()
    assert p.x == 0 and p.y == 0
    0

[[test]]
fn test_size_new_and_zero() -> i32
    let s = Size.new(640, 480)
    assert s.width == 640 and s.height == 480
    assert s.area() == 307200
    let z = Size.zero()
    assert z.width == 0 and z.height == 0
    0

# ============================================================================
# Rect constructors and conversions
# ============================================================================

[[test]]
fn test_rect_zero_is_empty() -> i32
    let r = Rect.zero()
    assert r.is_empty()
    assert r.area() == 0
    0

[[test]]
fn test_rect_full_starts_at_origin() -> i32
    let r = Rect.full(1024, 768)
    assert r.x == 0 and r.y == 0
    assert r.width == 1024 and r.height == 768
    assert not r.is_empty()
    0

[[test]]
fn test_rect_from_point_size_round_trips() -> i32
    let r = Rect.from_point_size(Point.new(5, -7), Size.new(30, 40))
    let p = r.position()
    let s = r.size()
    assert p.x == 5 and p.y == -7
    assert s.width == 30 and s.height == 40
    0

[[test]]
fn test_rect_offset_keeps_size() -> i32
    let r = Rect.new(10, 10, 20, 30).offset(-15, 5)
    assert r.x == -5 and r.y == 15
    assert r.width == 20 and r.height == 30
    0

# ============================================================================
# Color via the re-export
# ============================================================================

[[test]]
fn test_color_argb_round_trip() -> i32
    let c = Color.rgba(0xAA, 0xBB, 0xCC, 0xDD)
    assert c.to_argb() == 0xDDAABBCC
    let d = Color.from_argb(0xDDAABBCC)
    assert d.r == 0xAA and d.g == 0xBB and d.b == 0xCC and d.a == 0xDD
    0

# ============================================================================
# Ids
# ============================================================================

[[test]]
fn test_ids_zero_is_invalid() -> i32
    assert not WindowId.invalid().is_valid()
    assert not SurfaceId.invalid().is_valid()
    assert not ImageId.invalid().is_valid()
    assert WindowId.new(3).is_valid()
    assert WindowId.new(3).raw() == 3
    assert FontId.default().raw() == 0
    0

[[test]]
fn test_id_generator_hands_out_distinct_valid_ids() -> i32
    var g = IdGenerator.new()
    let a = g.next_window_id()
    let b = g.next_window_id()
    assert a.is_valid() and b.is_valid()
    assert a.raw() != b.raw()
    assert g.next_surface_id().is_valid()
    assert g.next_image_id().is_valid()
    0
