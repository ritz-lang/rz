# test_damage.ritz - Tests for compositor damage tracking
#
# Tests DamageTracker and DamageRegion from compositor/damage.ritz, the
# module the compositor actually uses (compositor/mod.ritz re-exports it).
# These used to test a parallel src/damage.ritz with its own Rect and
# DamageRegion that nothing in production imported (AGAST #1873).

import types.rect { Rect }
import compositor.damage { DamageTracker, DamageRegion }

# ============================================================================
# DamageRegion
# ============================================================================

[[test]]
fn test_region_new_keeps_source() -> i32
    let r = DamageRegion.new(Rect.new(1, 2, 3, 4), 7)
    assert r.rect.x == 1 and r.rect.y == 2
    assert r.rect.width == 3 and r.rect.height == 4
    assert r.source_window == 7
    0

[[test]]
fn test_region_from_rect_is_compositor_damage() -> i32
    let r = DamageRegion.from_rect(Rect.new(0, 0, 5, 5))
    assert r.source_window == 0
    0

# ============================================================================
# DamageTracker: adding damage
# ============================================================================

[[test]]
fn test_new_tracker_has_no_damage() -> i32
    let t = DamageTracker.new(800, 600)
    assert not t.has_damage()
    assert t.region_count() == 0
    assert t.bounding_box().is_empty()
    0

[[test]]
fn test_add_damage_records_region() -> i32
    var t = DamageTracker.new(800, 600)
    t.add_damage(Rect.new(10, 20, 30, 40), 3)
    assert t.has_damage()
    assert t.region_count() == 1
    assert t.get_regions().len() == 1
    let r = t.get_regions()[0]
    assert r.rect.x == 10 and r.rect.y == 20
    assert r.rect.width == 30 and r.rect.height == 40
    assert r.source_window == 3
    assert t.total_damage_area == 1200
    0

[[test]]
fn test_add_damage_clips_to_screen() -> i32
    var t = DamageTracker.new(100, 100)
    t.add_damage(Rect.new(90, 90, 50, 50), 0)
    assert t.region_count() == 1
    let b = t.bounding_box()
    assert b.x == 90 and b.y == 90
    assert b.width == 10 and b.height == 10
    assert t.total_damage_area == 100
    0

[[test]]
fn test_offscreen_damage_is_dropped() -> i32
    var t = DamageTracker.new(100, 100)
    t.add_damage(Rect.new(200, 200, 10, 10), 0)
    assert not t.has_damage()
    assert t.total_damage_area == 0
    0

# ============================================================================
# DamageTracker: merging
# ============================================================================

[[test]]
fn test_overlapping_damage_merges() -> i32
    var t = DamageTracker.new(800, 600)
    t.add_damage(Rect.new(0, 0, 100, 100), 0)
    t.add_damage(Rect.new(50, 50, 100, 100), 0)
    assert t.region_count() == 1
    assert t.regions_merged == 1
    let b = t.get_regions()[0].rect
    assert b.x == 0 and b.y == 0
    assert b.width == 150 and b.height == 150
    0

[[test]]
fn test_adjacent_damage_merges() -> i32
    var t = DamageTracker.new(800, 600)
    t.add_damage(Rect.new(0, 0, 100, 100), 0)
    t.add_damage(Rect.new(100, 0, 100, 100), 0)
    assert t.region_count() == 1
    let b = t.get_regions()[0].rect
    assert b.width == 200 and b.height == 100
    0

[[test]]
fn test_distant_damage_stays_separate() -> i32
    var t = DamageTracker.new(800, 600)
    t.add_damage(Rect.new(0, 0, 10, 10), 0)
    t.add_damage(Rect.new(500, 500, 10, 10), 0)
    assert t.region_count() == 2
    assert t.regions_merged == 0
    let b = t.bounding_box()
    assert b.x == 0 and b.y == 0
    assert b.width == 510 and b.height == 510
    0

# ============================================================================
# DamageTracker: full damage, clear, stats
# ============================================================================

[[test]]
fn test_damage_all_is_full_damage() -> i32
    var t = DamageTracker.new(320, 200)
    t.add_damage(Rect.new(0, 0, 10, 10), 0)
    assert not t.is_full_damage()
    t.damage_all()
    assert t.region_count() == 1
    assert t.is_full_damage()
    assert t.total_damage_area == 64000
    0

[[test]]
fn test_clear_removes_damage() -> i32
    var t = DamageTracker.new(800, 600)
    t.add_damage(Rect.new(0, 0, 10, 10), 0)
    t.clear()
    assert not t.has_damage()
    assert t.total_damage_area == 0
    0

[[test]]
fn test_reset_stats_keeps_regions() -> i32
    var t = DamageTracker.new(800, 600)
    t.add_damage(Rect.new(0, 0, 100, 100), 0)
    t.add_damage(Rect.new(50, 50, 100, 100), 0)
    t.reset_stats()
    assert t.regions_merged == 0
    assert t.region_count() == 1
    0

# ============================================================================
# DamageTracker: occlusion
# ============================================================================

[[test]]
fn test_fully_occluded_region_is_removed() -> i32
    var t = DamageTracker.new(800, 600)
    t.add_damage(Rect.new(10, 10, 20, 20), 0)
    t.add_damage(Rect.new(500, 500, 20, 20), 0)
    t.subtract_occlusion(Rect.new(0, 0, 100, 100))
    assert t.region_count() == 1
    assert t.get_regions()[0].rect.x == 500
    0

[[test]]
fn test_partially_occluded_region_is_kept() -> i32
    var t = DamageTracker.new(800, 600)
    t.add_damage(Rect.new(10, 10, 100, 100), 0)
    t.subtract_occlusion(Rect.new(0, 0, 50, 50))
    assert t.region_count() == 1
    0
