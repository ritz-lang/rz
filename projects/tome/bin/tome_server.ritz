# bin/tome_server.ritz - Tome Server binary
#
# Usage:
#   ./tome-server                    # Single-process mode on port 6379
#   ./tome-server -w 4               # Multi-process with 4 workers
#   ./tome-server --port 7000 -w 8   # Port 7000 with 8 workers
#   ./tome-server --blocking         # WSL-compatible blocking mode
#   ./tome-server --password SECRET  # Require AUTH with password
#   ./tome-server -h                 # Show help

import ritzlib.sys
import ritzlib.fmt
import ritzlib.memory
import lib.server
import lib.blocking_server
import lib.master
import lib.resp


const DEFAULT_PORT: i32 = 6379
const DEFAULT_WORKERS: i32 = 0  # 0 = single-process mode


# Server mode flags
const MODE_ASYNC: i32 = 0       # io_uring async (default)
const MODE_BLOCKING: i32 = 1   # Traditional blocking I/O (WSL compatible)


fn print_help()
    print("Tome - In-memory key-value store\n")
    print("\n")
    print("Usage: tome-server [OPTIONS]\n")
    print("\n")
    print("Options:\n")
    print("  -p, --port PORT      Port to listen on (default: 6379)\n")
    print("  -w, --workers N      Number of worker processes (default: single-process)\n")
    print("  -b, --blocking       Use blocking I/O (WSL compatible, no io_uring)\n")
    print("  --password SECRET    Require AUTH with password\n")
    print("  -h, --help           Show this help message\n")
    print("\n")
    print("Examples:\n")
    print("  tome-server                    # Single-process mode (io_uring)\n")
    print("  tome-server -b                 # Blocking mode (WSL compatible)\n")
    print("  tome-server -w 4               # 4 worker processes\n")
    print("  tome-server -p 7000 -w 8       # Port 7000 with 8 workers\n")
    print("  tome-server --password mypass  # Require authentication\n")
    print("\n")
    print("Multi-process mode:\n")
    print("  - Each worker has its own data store (partitioned)\n")
    print("  - SO_REUSEPORT for kernel-level load balancing\n")
    print("  - Workers auto-restart on crash\n")
    print("  - Graceful shutdown with SIGTERM\n")
    print("\n")


fn print_banner(workers: i32)
    print("========================================\n")
    print("          Tome Server v0.2.0\n")
    print("   Redis-compatible in-memory store\n")
    if workers > 0
        print("        Multi-process mode\n")
    print("========================================\n")
    print("\n")


fn run_single_process(port: i32, password: *u8) -> i32
    print("Starting single-process server on port {port} (io_uring)...\n")

    # Set password if provided
    if password != null
        tome_server_set_password(password)
        print("Authentication enabled.\n")

    var server: TomeServer
    let init_ret: i32 = tome_server_init(@server, port)
    if init_ret < 0
        print("Error: failed to initialize server (code: {init_ret})\n")
        print("Hint: Try --blocking mode on WSL or older kernels.\n")
        return 1

    print("Server ready. Press Ctrl+C to stop.\n\n")

    let run_ret: i32 = tome_server_run(@server)
    if run_ret < 0
        print("Error: server error (code: {run_ret})\n")
        tome_server_destroy(@server)
        return 1

    print("Server stopped.\n")
    tome_server_destroy(@server)
    return 0


fn run_blocking_process(port: i32, password: *u8) -> i32
    print("Starting blocking server on port {port} (WSL compatible)...\n")

    # Set password if provided
    if password != null
        blocking_server_set_password(password)
        print("Authentication enabled.\n")

    var server: BlockingTomeServer
    let init_ret: i32 = blocking_server_init(@&server, port)
    if init_ret < 0
        print("Error: failed to initialize server (code: {init_ret})\n")
        return 1

    print("Server ready. Press Ctrl+C to stop.\n\n")
    print("Note: Blocking mode handles one client at a time.\n\n")

    let run_ret: i32 = blocking_server_run(@server)
    if run_ret < 0
        print("Error: server error (code: {run_ret})\n")
        blocking_server_destroy(@server)
        return 1

    print("Server stopped.\n")
    blocking_server_destroy(@server)
    return 0


fn run_multi_process(port: i32, workers: i32, password: *u8) -> i32
    print("Starting multi-process server on port {port} with {workers} workers...\n")

    # Note: Password is set per-worker after fork in master.ritz
    # TODO: Pass password to master_init for worker inheritance

    var master: MasterServer
    let init_ret: i32 = master_init(@master, port, workers)
    if init_ret < 0
        print("Error: failed to initialize master (code: {init_ret})\n")
        return 1

    # Spawn worker processes
    let spawn_ret: i32 = master_spawn_workers(@master)
    if spawn_ret < 0
        print("Error: failed to spawn workers (code: {spawn_ret})\n")
        master_destroy(@master)
        return 1

    # Run master monitoring loop
    let run_ret: i32 = master_run(@master)

    # Shutdown workers gracefully
    master_shutdown(@master)
    master_destroy(@master)

    print("Server stopped.\n")
    return run_ret


pub fn main(args: Span<StrView>) -> i32
    var port: i32 = DEFAULT_PORT
    var workers: i32 = DEFAULT_WORKERS
    var mode: i32 = MODE_ASYNC
    var password: *u8 = null

    # Parse command line arguments
    var i: i64 = 1  # Skip program name
    while i < args.len
        let arg: StrView = args[i]

        if arg.eq("-h") or arg.eq("--help")
            print_help()
            return 0

        if arg.eq("-p") or arg.eq("--port")
            if i + 1 >= args.len
                print("Error: --port requires a value\n")
                return 1
            i += 1
            let port_str: StrView = args[i]
            var port_val: i64 = 0
            if tome_parse_int_arg(port_str.as_ptr(), 1, 65535, @port_val) == 0
                print("Error: invalid port number\n")
                return 1
            port = port_val as i32

        else if arg.eq("-w") or arg.eq("--workers")
            if i + 1 >= args.len
                print("Error: --workers requires a value\n")
                return 1
            i += 1
            let workers_str: StrView = args[i]
            var workers_val: i64 = 0
            if tome_parse_int_arg(workers_str.as_ptr(), 0, 64, @workers_val) == 0
                print("Error: invalid worker count (must be 0-64)\n")
                return 1
            workers = workers_val as i32

        else if arg.eq("-b") or arg.eq("--blocking")
            mode = MODE_BLOCKING

        else if arg.eq("--password")
            if i + 1 >= args.len
                print("Error: --password requires a value\n")
                return 1
            i += 1
            password = args[i].as_ptr()

        i += 1

    # Print banner
    print_banner(workers)

    # Run in appropriate mode
    if mode == MODE_BLOCKING
        if workers > 0
            print("Warning: --blocking mode doesn't support workers, ignoring -w\n")
        return run_blocking_process(port, password)
    else if workers > 0
        return run_multi_process(port, workers, password)
    else
        return run_single_process(port, password)
