# bin/tome_cli.ritz - Tome CLI client binary
#
# Usage:
#   ./tome-cli                     # Connect to localhost:6379
#   ./tome-cli -h localhost -p 7000  # Connect to specific host/port
#   echo "PING" | ./tome-cli       # Pipe mode

import ritzlib.sys
import ritzlib.fd
import ritzlib.span
import ritzlib.result
import ritzlib.fmt
import ritzlib.str
import ritzlib.memory
import ritzlib.strview
import ritzlib.async_net
import lib.resp
import lib.client


const DEFAULT_PORT: i32 = 6379
const MAX_INPUT: i32 = 4096


fn print_help()
    print("Tome CLI - Command-line client for Tome server\n")
    print("\n")
    print("Usage: tome-cli [OPTIONS]\n")
    print("\n")
    print("Options:\n")
    print("  -h, --host HOST    Server host (default: 127.0.0.1)\n")
    print("  -p, --port PORT    Server port (default: 6379)\n")
    print("  -c CMD             Execute command and exit\n")
    print("  --help             Show this help message\n")
    print("\n")
    print("Commands are entered interactively or via stdin pipe.\n")
    print("Type 'quit' to exit.\n")
    print("\n")


# Read a line of input from stdin
# Returns length of line (excluding newline), or -1 on EOF
fn read_line(buf: *u8, max_len: i32) -> i32
    var i: i32 = 0
    while i < max_len - 1
        var ch: u8 = 0
        var ret: i64 = 0
        match fd_stdin().read(Span<u8> { ptr: @ch, len: 1 })
            Ok(n) => ret = n
            Err(_) => ret = -1
        if ret <= 0
            if i == 0
                return -1  # EOF with no input
            break
        if ch == 10  # newline
            break
        let ptr: *u8 = buf + i
        *ptr = ch
        i += 1

    # Null terminate
    let end: *u8 = buf + i
    *end = 0
    return i


# Check if input is a quit command
fn is_quit_cmd(line: StrView) -> bool
    return line.eq("quit") or line.eq("QUIT") or line.eq("exit") or line.eq("EXIT")


fn is_blank(c: u8) -> bool
    return c == 32 or c == 9  # space, tab


# Index of the first non-blank byte of `line` at or after `i`
fn skip_whitespace(line: StrView, i: i64) -> i64
    var j: i64 = i
    while j < line.len and is_blank(line.get(j))
        j += 1
    return j


# Split `line` into at most `max_tokens` tokens: runs of non-blank bytes,
# or a "quoted" span (without its quotes).  The tokens borrow `line`.
# Returns number of tokens parsed
fn tokenize(line: StrView, tokens: *StrView, max_tokens: i32) -> i32
    var count: i32 = 0
    var i: i64 = skip_whitespace(line, 0)

    while i < line.len and count < max_tokens
        var start: i64 = i
        if line.get(i) == 34  # Double quote
            # Quoted string, to the closing quote or the end
            start = i + 1
            i = start
            while i < line.len and line.get(i) != 34
                i += 1
            tokens[count] = line.slice(start, i)
            if i < line.len
                i += 1  # Skip closing quote
        else
            # Unquoted token
            while i < line.len and not is_blank(line.get(i))
                i += 1
            tokens[count] = line.slice(start, i)
        count += 1

        i = skip_whitespace(line, i)

    return count


# Send command and print response
fn execute_command(client: *TomeClient, tokens: *StrView, token_count: i32) -> i32
    if token_count == 0
        return 0

    var sent: i64 = 0

    if token_count == 1
        sent = client_send_cmd0(client, tokens[0])
    else if token_count == 2
        sent = client_send_cmd1(client, tokens[0], tokens[1])
    else if token_count == 3
        sent = client_send_cmd2(client, tokens[0], tokens[1], tokens[2])
    else if token_count == 4
        sent = client_send_cmd3(client, tokens[0], tokens[1], tokens[2], tokens[3])
    else
        print("(error) Too many arguments (max 4 supported)\n")
        return 0

    if sent < 0
        print("(error) Failed to send command\n")
        return -1

    # Receive response
    let recv_ret: i32 = client_recv(client)
    if recv_ret <= 0
        print("(error) Connection closed by server\n")
        return -1

    # Print formatted response
    client_print_response(client)
    return 0


fn print_prompt(host: StrView, port: i32)
    print("{host}:{port}> ")


fn is_tty() -> i32
    # Check if stdin is a TTY using isatty syscall
    # This is a simplification - just check if TERM env exists
    # For now, assume interactive if we can read from stdin
    return 1


pub fn main(args: Span<StrView>) -> i32
    var host: StrView = "127.0.0.1"
    var port: i32 = DEFAULT_PORT
    var single_cmd: StrView = ""
    var has_single_cmd: bool = false

    # Parse command line arguments
    var i: i64 = 1
    while i < args.len
        let arg: StrView = args[i]

        if arg.eq("--help")
            print_help()
            return 0

        if arg.eq("-h") or arg.eq("--host")
            if i + 1 >= args.len
                print("Error: --host requires a value\n")
                return 1
            i += 1
            host = args[i]

        else if arg.eq("-p") or arg.eq("--port")
            if i + 1 >= args.len
                print("Error: --port requires a value\n")
                return 1
            i += 1
            let port_str: StrView = args[i]
            var port_val: i64 = 0
            if tome_parse_int_arg(port_str, 1, 65535, @port_val) == 0
                print("Error: invalid port number\n")
                return 1
            port = port_val as i32

        else if arg.eq("-c")
            if i + 1 >= args.len
                print("Error: -c requires a command\n")
                return 1
            i += 1
            single_cmd = args[i]
            has_single_cmd = true

        i += 1

    # Parse host to IP
    let host_ip: i32 = client_parse_host(host)
    if host_ip == 0
        print("Error: invalid host address\n")
        return 1

    # Connect to server
    print("Connecting to {host}:{port}...\n")

    var client: TomeClient = client_new()
    let conn_ret: i32 = client_connect(@client, host_ip, port)
    if conn_ret < 0
        print("Error: could not connect to server (code: {conn_ret})\n")
        return 1

    # Input buffer and token array
    var input_buf: [4096]u8
    var tokens: [16]StrView

    # Single command mode (-c): the tokens borrow the argument itself
    if has_single_cmd
        let token_count: i32 = tokenize(single_cmd.take(4095), @tokens[0], 16)
        var rc: i32 = 0
        if token_count > 0
            if execute_command(@client, @tokens[0], token_count) < 0
                rc = 1
        client_disconnect(@client)
        return rc

    # Interactive mode
    print("Connected. Type 'quit' to exit.\n")
    print("\n")

    # REPL loop
    loop
        print_prompt(host, port)

        let line_len: i32 = read_line(@input_buf[0], MAX_INPUT)
        if line_len < 0
            # EOF
            print("\n")
            break

        if line_len == 0
            continue

        let line: StrView = strview_from_ptr(@input_buf[0], line_len as i64)

        # Check for quit
        if is_quit_cmd(line)
            break

        # Parse and execute command
        let token_count: i32 = tokenize(line, @tokens[0], 16)
        if token_count > 0
            let exec_ret: i32 = execute_command(@client, @tokens[0], token_count)
            if exec_ret < 0
                # Connection lost
                break

    # Disconnect
    client_disconnect(@client)
    print("Goodbye.\n")
    return 0
