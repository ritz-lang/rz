# test/test_store_list_set.ritz - Tome store list and set operations
#
# Split out of test_store.ritz: `ritz0 --test` recompiles the file once per
# test, so one 68-test file overran build.py's 180s per-file budget.

import ritzlib.sys
import ritzlib.io
import ritzlib.str
import ritzlib.strview
import ritzlib.timer
import lib.tome
import ritzlib.string
import ritzlib.gvec
import ritzlib.option

# ============================================================================
# Test: LPUSH and RPUSH
# ============================================================================

[[test]]
fn test_lpush_rpush() -> i32
    var store: Store = store_new()

    # LPUSH creates list and adds to head
    let len1: i64 = store_lpush(@store, "mylist", "a")
    if len1 != 1
        return 1

    # LPUSH again - adds to head
    let len2: i64 = store_lpush(@store, "mylist", "b")
    if len2 != 2
        return 1

    # RPUSH - adds to tail
    let len3: i64 = store_rpush(@store, "mylist", "c")
    if len3 != 3
        return 1

    # Order should be: b, a, c
    let v0: StrView = store_lindex(@store, "mylist", 0)
    let v1: StrView = store_lindex(@store, "mylist", 1)
    let v2: StrView = store_lindex(@store, "mylist", 2)

    if not v0.eq("b")
        return 1
    if not v1.eq("a")
        return 1
    if not v2.eq("c")
        return 1

    return 0

# ============================================================================
# Test: LPOP and RPOP
# ============================================================================

[[test]]
fn test_lpop_rpop() -> i32
    var store: Store = store_new()

    store_rpush(@store, "mylist", "a")
    store_rpush(@store, "mylist", "b")
    store_rpush(@store, "mylist", "c")
    # List: a, b, c

    # LPOP removes from head
    var val1: String = store_lpop(@store, "mylist")
    if not val1.eq("a")
        return 1

    # List: b, c
    var val2: String = store_rpop(@store, "mylist")
    if not val2.eq("c")
        return 1

    # List: b
    if store_llen(@store, "mylist") != 1
        return 1

    return 0

# ============================================================================
# Test: LLEN
# ============================================================================

[[test]]
fn test_llen() -> i32
    var store: Store = store_new()

    # Non-existent list has length 0
    if store_llen(@store, "nolist") != 0
        return 1

    store_rpush(@store, "mylist", "a")
    if store_llen(@store, "mylist") != 1
        return 1

    store_rpush(@store, "mylist", "b")
    store_rpush(@store, "mylist", "c")
    if store_llen(@store, "mylist") != 3
        return 1

    return 0

# ============================================================================
# Test: LINDEX with negative indices
# ============================================================================

[[test]]
fn test_lindex_negative() -> i32
    var store: Store = store_new()

    store_rpush(@store, "mylist", "a")
    store_rpush(@store, "mylist", "b")
    store_rpush(@store, "mylist", "c")
    # List: a, b, c (indices 0, 1, 2 or -3, -2, -1)

    # Positive indices
    let v0: StrView = store_lindex(@store, "mylist", 0)
    if not v0.eq("a")
        return 1

    # Negative indices
    let v_1: StrView = store_lindex(@store, "mylist", -1)
    if not v_1.eq("c")
        return 1

    let v_2: StrView = store_lindex(@store, "mylist", -2)
    if not v_2.eq("b")
        return 1

    # Out of bounds returns null
    let v_out: StrView = store_lindex(@store, "mylist", 10)
    if v_out.ptr != null
        return 1

    return 0

# ============================================================================
# Test: LRANGE
# ============================================================================

[[test]]
fn test_lrange() -> i32
    var store: Store = store_new()

    store_rpush(@store, "mylist", "a")
    store_rpush(@store, "mylist", "b")
    store_rpush(@store, "mylist", "c")
    store_rpush(@store, "mylist", "d")
    store_rpush(@store, "mylist", "e")
    # List: a, b, c, d, e

    # Full range
    let all: Vec<StrView> = store_lrange(@store, "mylist", 0, -1)
    if all.len() != 5
        return 1
    if not all.get(0).eq("a") || not all.get(4).eq("e")
        return 1

    # Partial range
    let partial: Vec<StrView> = store_lrange(@store, "mylist", 1, 3)
    if partial.len() != 3
        return 1
    if not partial.get(0).eq("b") || not partial.get(2).eq("d")
        return 1

    # Negative indices
    let tail: Vec<StrView> = store_lrange(@store, "mylist", -2, -1)
    if tail.len() != 2
        return 1
    if not tail.get(0).eq("d") || not tail.get(1).eq("e")
        return 1

    # Out of range: nothing
    let none: Vec<StrView> = store_lrange(@store, "mylist", 7, 9)
    if none.len() != 0
        return 1

    return 0

# ============================================================================
# Test: List type mismatch
# ============================================================================

[[test]]
fn test_list_type_mismatch() -> i32
    var store: Store = store_new()

    # Set a string key
    store_set(@store, "key", "value")

    # Try to use list operations on it
    let len: i64 = store_lpush(@store, "key", "item")
    if len != -1  # Should fail with -1
        return 1

    let llen: i64 = store_llen(@store, "key")
    if llen != -1  # Should fail with -1
        return 1

    return 0

# ============================================================================
# Test: Empty list operations
# ============================================================================

[[test]]
fn test_empty_list_ops() -> i32
    var store: Store = store_new()

    # Pop from non-existent list
    var val: String = store_lpop(@store, "nolist")
    if val.len() != 0  # Should be empty string
        return 1

    # Create list, pop everything
    store_rpush(@store, "mylist", "only")
    var popped: String = store_lpop(@store, "mylist")

    # Now empty - pop again
    var empty_pop: String = store_lpop(@store, "mylist")
    if empty_pop.len() != 0
        return 1

    # Length of empty list
    if store_llen(@store, "mylist") != 0
        return 1

    return 0

# ============================================================================
# Test: Delete list key
# ============================================================================

[[test]]
fn test_del_list() -> i32
    var store: Store = store_new()

    store_rpush(@store, "mylist", "a")
    store_rpush(@store, "mylist", "b")
    store_rpush(@store, "mylist", "c")

    # Delete should work
    let deleted: i32 = store_del(@store, "mylist")
    if deleted != 1
        return 1

    # List should be gone
    if store_llen(@store, "mylist") != 0
        return 1

    return 0

# ============================================================================
# Test: SADD and SISMEMBER
# ============================================================================

[[test]]
fn test_sadd_sismember() -> i32
    var store: Store = store_new()

    # SADD creates set and adds member
    let added1: i64 = store_sadd(@store, "myset", "a")
    if added1 != 1
        return 1

    # Adding same member again returns 0
    let added2: i64 = store_sadd(@store, "myset", "a")
    if added2 != 0
        return 1

    # Add more members
    store_sadd(@store, "myset", "b")
    store_sadd(@store, "myset", "c")

    # SISMEMBER checks membership
    if store_sismember(@store, "myset", "a") != 1
        return 1
    if store_sismember(@store, "myset", "b") != 1
        return 1
    if store_sismember(@store, "myset", "d") != 0  # Not a member
        return 1

    return 0

# ============================================================================
# Test: SREM
# ============================================================================

[[test]]
fn test_srem() -> i32
    var store: Store = store_new()

    store_sadd(@store, "myset", "a")
    store_sadd(@store, "myset", "b")
    store_sadd(@store, "myset", "c")

    # Remove a member
    let removed: i64 = store_srem(@store, "myset", "b")
    if removed != 1
        return 1

    # Verify it's gone
    if store_sismember(@store, "myset", "b") != 0
        return 1

    # Others still there
    if store_sismember(@store, "myset", "a") != 1
        return 1

    # Remove non-existent member
    let removed2: i64 = store_srem(@store, "myset", "x")
    if removed2 != 0
        return 1

    return 0

# ============================================================================
# Test: SCARD
# ============================================================================

[[test]]
fn test_scard() -> i32
    var store: Store = store_new()

    # Non-existent set has cardinality 0
    if store_scard(@store, "noset") != 0
        return 1

    store_sadd(@store, "myset", "a")
    if store_scard(@store, "myset") != 1
        return 1

    store_sadd(@store, "myset", "b")
    store_sadd(@store, "myset", "c")
    if store_scard(@store, "myset") != 3
        return 1

    # Duplicate doesn't increase cardinality
    store_sadd(@store, "myset", "a")
    if store_scard(@store, "myset") != 3
        return 1

    return 0

# ============================================================================
# Test: SMEMBERS
# ============================================================================

[[test]]
fn test_smembers() -> i32
    var store: Store = store_new()

    store_sadd(@store, "myset", "a")
    store_sadd(@store, "myset", "b")
    store_sadd(@store, "myset", "c")

    let members: Vec<StrView> = store_smembers(@store, "myset")
    let count: i64 = members.len()
    if count != 3
        return 1

    # Members are returned in no particular order

    var found_a: i32 = 0
    var found_b: i32 = 0
    var found_c: i32 = 0

    for i in 0..count
        let m: StrView = members.get(i)
        if m.eq("a")
            found_a = 1
        if m.eq("b")
            found_b = 1
        if m.eq("c")
            found_c = 1

    if found_a != 1 || found_b != 1 || found_c != 1
        return 1

    return 0

# ============================================================================
# Test: SUNION
# ============================================================================

[[test]]
fn test_sunion() -> i32
    var store: Store = store_new()

    store_sadd(@store, "set1", "a")
    store_sadd(@store, "set1", "b")
    store_sadd(@store, "set2", "b")
    store_sadd(@store, "set2", "c")

    let found: Option<Set> = store_sunion(@store, "set1", "set2")
    let result: Set = match found
        Some(r) => r
        None => return 1

    if set_len(@result) != 3  # {a, b, c}
        return 1

    # Verify all members present
    if set_contains(@result, "a") != 1
        return 1
    if set_contains(@result, "b") != 1
        return 1
    if set_contains(@result, "c") != 1
        return 1

    return 0

# ============================================================================
# Test: SINTER
# ============================================================================

[[test]]
fn test_sinter() -> i32
    var store: Store = store_new()

    store_sadd(@store, "set1", "a")
    store_sadd(@store, "set1", "b")
    store_sadd(@store, "set1", "c")
    store_sadd(@store, "set2", "b")
    store_sadd(@store, "set2", "c")
    store_sadd(@store, "set2", "d")

    let found: Option<Set> = store_sinter(@store, "set1", "set2")
    let result: Set = match found
        Some(r) => r
        None => return 1

    if set_len(@result) != 2  # {b, c}
        return 1

    # Verify members
    if set_contains(@result, "b") != 1
        return 1
    if set_contains(@result, "c") != 1
        return 1
    # 'a' should NOT be in intersection
    if set_contains(@result, "a") != 0
        return 1

    return 0

# ============================================================================
# Test: SDIFF
# ============================================================================

[[test]]
fn test_sdiff() -> i32
    var store: Store = store_new()

    store_sadd(@store, "set1", "a")
    store_sadd(@store, "set1", "b")
    store_sadd(@store, "set1", "c")
    store_sadd(@store, "set2", "b")
    store_sadd(@store, "set2", "d")

    let found: Option<Set> = store_sdiff(@store, "set1", "set2")
    let result: Set = match found
        Some(r) => r
        None => return 1

    if set_len(@result) != 2  # {a, c} - items in set1 but not set2
        return 1

    # Verify members
    if set_contains(@result, "a") != 1
        return 1
    if set_contains(@result, "c") != 1
        return 1
    # 'b' should NOT be in diff (it's in set2)
    if set_contains(@result, "b") != 0
        return 1

    return 0

# ============================================================================
# Test: Set type mismatch
# ============================================================================

[[test]]
fn test_set_type_mismatch() -> i32
    var store: Store = store_new()

    # Set a string key
    store_set(@store, "key", "value")

    # Try to use set operations on it
    let added: i64 = store_sadd(@store, "key", "member")
    if added != -1  # Should fail with -1
        return 1

    let card: i64 = store_scard(@store, "key")
    if card != -1  # Should fail with -1
        return 1

    return 0

# ============================================================================
# Test: Delete set key
# ============================================================================

[[test]]
fn test_del_set() -> i32
    var store: Store = store_new()

    store_sadd(@store, "myset", "a")
    store_sadd(@store, "myset", "b")
    store_sadd(@store, "myset", "c")

    # Delete should work
    let deleted: i32 = store_del(@store, "myset")
    if deleted != 1
        return 1

    # Set should be gone
    if store_scard(@store, "myset") != 0
        return 1

    return 0

# ============================================================================
# Test: the list's ring buffer wraps and grows
# ============================================================================
# Pushes at both ends grow the ring 8 -> 16 -> ... -> 128 with the head
# wrapped round; pops in between free slots that later pushes reuse.  The
# order holds throughout.

fn list_name(tag: u8, i: i64) -> String
    var name: String = string_from("x00")
    name.set_char(0, tag)
    name.set_char(1, (48 + i / 10) as u8)
    name.set_char(2, (48 + i % 10) as u8)
    return name

[[test]]
fn test_list_ring_wraps_and_grows() -> i32
    var store: Store = store_new()
    for i in 0..40
        let l: String = list_name(108, i)  # 'l'
        let r: String = list_name(114, i)  # 'r'
        store_lpush(@store, "q", l.as_view())
        store_rpush(@store, "q", r.as_view())
    # [l39 .. l00, r00 .. r39]
    if store_llen(@store, "q") != 80
        return 1
    if not store_lindex(@store, "q", 0).eq("l39") or not store_lindex(@store, "q", 39).eq("l00")
        return 2
    if not store_lindex(@store, "q", 40).eq("r00") or not store_lindex(@store, "q", -1).eq("r39")
        return 3

    let first: String = store_lpop(@store, "q")
    let last: String = store_rpop(@store, "q")
    if not first.eq("l39") or not last.eq("r39")
        return 4
    # Pop the left run away, then push it back: the head wraps past slot 0.
    for i in 0..39
        let v: String = store_lpop(@store, "q")
        if not v.eq_strview(list_name(108, 38 - i).as_view())
            return 5
    for i in 0..10
        let l: String = list_name(108, i)
        store_lpush(@store, "q", l.as_view())
    let all: Vec<StrView> = store_lrange(@store, "q", 0, -1)
    if all.len() != 49
        return 6
    if not all.get(0).eq("l09") or not all.get(9).eq("l00") or not all.get(10).eq("r00") or not all.get(48).eq("r38")
        return 7

    # Emptied to nothing, the list still takes pushes.
    while store_llen(@store, "q") > 0
        store_rpop(@store, "q")
    if store_rpush(@store, "q", "again") != 1 or not store_lindex(@store, "q", 0).eq("again")
        return 8
    return 0
