# test/test_store_zset_hash.ritz - Tome store sorted-set and hash operations
#
# Split out of test_store.ritz: `ritz0 --test` recompiles the file once per
# test, so one 68-test file overran build.py's 180s per-file budget.

import ritzlib.sys
import ritzlib.io
import ritzlib.str
import ritzlib.strview
import ritzlib.timer
import lib.tome
import ritzlib.gvec
import ritzlib.string

# ============================================================================
# Test: ZADD and ZSCORE
# ============================================================================

[[test]]
fn test_zadd_zscore() -> i32
    var store: Store = store_new()

    # ZADD creates sorted set and adds member with score
    let added1: i64 = store_zadd(@store, "myzset", 1, "one")
    if added1 != 1
        return 1

    # Adding same member again returns 0 (updated)
    let added2: i64 = store_zadd(@store, "myzset", 10, "one")
    if added2 != 0
        return 1

    # Add more members
    store_zadd(@store, "myzset", 2, "two")
    store_zadd(@store, "myzset", 3, "three")

    # ZSCORE gets score
    var score: f64 = 0.0
    let found: i32 = store_zscore(@store, "myzset", "one", @&score)
    if found != 1
        return 1
    if score != 10.0  # Updated score
        return 1

    # Non-existent member
    let found2: i32 = store_zscore(@store, "myzset", "four", @&score)
    if found2 != 0
        return 1

    return 0

# ============================================================================
# Test: ZREM
# ============================================================================

[[test]]
fn test_zrem() -> i32
    var store: Store = store_new()

    store_zadd(@store, "myzset", 1, "one")
    store_zadd(@store, "myzset", 2, "two")
    store_zadd(@store, "myzset", 3, "three")

    # Remove a member
    let removed: i64 = store_zrem(@store, "myzset", "two")
    if removed != 1
        return 1

    # Verify it's gone
    var score: f64 = 0.0
    if store_zscore(@store, "myzset", "two", @&score) != 0
        return 1

    # Others still there
    if store_zscore(@store, "myzset", "one", @&score) != 1
        return 1

    # Remove non-existent member
    let removed2: i64 = store_zrem(@store, "myzset", "four")
    if removed2 != 0
        return 1

    return 0

# ============================================================================
# Test: ZCARD
# ============================================================================

[[test]]
fn test_zcard() -> i32
    var store: Store = store_new()

    # Non-existent zset has cardinality 0
    if store_zcard(@store, "nozset") != 0
        return 1

    store_zadd(@store, "myzset", 1, "one")
    if store_zcard(@store, "myzset") != 1
        return 1

    store_zadd(@store, "myzset", 2, "two")
    store_zadd(@store, "myzset", 3, "three")
    if store_zcard(@store, "myzset") != 3
        return 1

    # Update doesn't increase cardinality
    store_zadd(@store, "myzset", 10, "one")
    if store_zcard(@store, "myzset") != 3
        return 1

    return 0

# ============================================================================
# Test: ZRANK and ZREVRANK
# ============================================================================

[[test]]
fn test_zrank() -> i32
    var store: Store = store_new()

    store_zadd(@store, "myzset", 1, "one")
    store_zadd(@store, "myzset", 2, "two")
    store_zadd(@store, "myzset", 3, "three")
    # Order: one(1), two(2), three(3)
    # Ranks: 0, 1, 2

    if store_zrank(@store, "myzset", "one") != 0
        return 1
    if store_zrank(@store, "myzset", "two") != 1
        return 1
    if store_zrank(@store, "myzset", "three") != 2
        return 1

    # ZREVRANK: highest score = 0
    if store_zrevrank(@store, "myzset", "three") != 0
        return 1
    if store_zrevrank(@store, "myzset", "two") != 1
        return 1
    if store_zrevrank(@store, "myzset", "one") != 2
        return 1

    # Non-existent member
    if store_zrank(@store, "myzset", "four") != -1
        return 1

    return 0

# ============================================================================
# Test: ZRANGE
# ============================================================================

[[test]]
fn test_zrange() -> i32
    var store: Store = store_new()

    store_zadd(@store, "myzset", 1, "one")
    store_zadd(@store, "myzset", 2, "two")
    store_zadd(@store, "myzset", 3, "three")
    store_zadd(@store, "myzset", 4, "four")
    store_zadd(@store, "myzset", 5, "five")
    # Order: one, two, three, four, five (by score)

    # Full range
    var count: i64 = 0
    let all: Vec<StrView> = store_zrange(@store, "myzset", 0, -1)
    count = all.len()
    if count != 5
        return 1
    if not all.get(0).eq("one") || not all.get(4).eq("five")
        return 1

    # Partial range
    let partial: Vec<StrView> = store_zrange(@store, "myzset", 1, 3)
    count = partial.len()
    if count != 3
        return 1
    if not partial.get(0).eq("two") || not partial.get(2).eq("four")
        return 1

    return 0

# ============================================================================
# Test: ZREVRANGE
# ============================================================================

[[test]]
fn test_zrevrange() -> i32
    var store: Store = store_new()

    store_zadd(@store, "myzset", 1, "one")
    store_zadd(@store, "myzset", 2, "two")
    store_zadd(@store, "myzset", 3, "three")
    # Forward order: one, two, three
    # Reverse order: three, two, one

    var count: i64 = 0
    let all: Vec<StrView> = store_zrevrange(@store, "myzset", 0, -1)
    count = all.len()
    if count != 3
        return 1

    # Should be reversed: three, two, one
    if not all.get(0).eq("three")
        return 1
    if not all.get(1).eq("two")
        return 1
    if not all.get(2).eq("one")
        return 1

    return 0

# ============================================================================
# Test: Sorted set type mismatch
# ============================================================================

[[test]]
fn test_zset_type_mismatch() -> i32
    var store: Store = store_new()

    # Set a string key
    store_set(@store, "key", "value")

    # Try to use zset operations on it
    let added: i64 = store_zadd(@store, "key", 1, "member")
    if added != -1  # Should fail with -1
        return 1

    let card: i64 = store_zcard(@store, "key")
    if card != -1  # Should fail with -1
        return 1

    return 0

# ============================================================================
# Test: Delete zset key
# ============================================================================

[[test]]
fn test_del_zset() -> i32
    var store: Store = store_new()

    store_zadd(@store, "myzset", 1, "one")
    store_zadd(@store, "myzset", 2, "two")
    store_zadd(@store, "myzset", 3, "three")

    # Delete should work
    let deleted: i32 = store_del(@store, "myzset")
    if deleted != 1
        return 1

    # Zset should be gone
    if store_zcard(@store, "myzset") != 0
        return 1

    return 0

# ============================================================================
# Test: Sorted set with same scores (lexicographic ordering)
# ============================================================================

[[test]]
fn test_zset_same_scores() -> i32
    var store: Store = store_new()

    # All same score - should be sorted lexicographically
    store_zadd(@store, "myzset", 1, "charlie")
    store_zadd(@store, "myzset", 1, "alpha")
    store_zadd(@store, "myzset", 1, "bravo")
    # Expected order: alpha, bravo, charlie (lexicographic)

    var count: i64 = 0
    let members: Vec<StrView> = store_zrange(@store, "myzset", 0, -1)
    count = members.len()
    if count != 3
        return 1

    if not members.get(0).eq("alpha")
        return 1
    if not members.get(1).eq("bravo")
        return 1
    if not members.get(2).eq("charlie")
        return 1

    return 0

# ============================================================================
# Test: fractional and infinite scores (AGAST #4268)
# ============================================================================

[[test]]
fn test_zset_double_scores() -> i32
    var store: Store = store_new()
    let inf: f64 = 1.0e308 * 10.0
    store_zadd(@store, "z", 0.5, "half")
    store_zadd(@store, "z", inf, "top")
    store_zadd(@store, "z", 0.25, "quarter")
    store_zadd(@store, "z", 0.0 - inf, "bottom")
    store_zadd(@store, "z", 0.375, "mid")
    # Order: bottom, quarter, mid, half, top.  An i64 store collapses
    # 0.25 / 0.375 / 0.5 to 0 and orders them by member.
    if store_zrank(@store, "z", "bottom") != 0
        return 1
    if store_zrank(@store, "z", "quarter") != 1
        return 2
    if store_zrank(@store, "z", "mid") != 2
        return 3
    if store_zrank(@store, "z", "half") != 3
        return 4
    if store_zrank(@store, "z", "top") != 4
        return 5
    var score: f64 = 0.0
    if store_zscore(@store, "z", "mid", @&score) != 1
        return 6
    if score != 0.375
        return 7
    # Moving a member to a fractional score re-sorts it.
    store_zadd(@store, "z", 0.3, "half")
    if store_zrank(@store, "z", "half") != 2
        return 8
    return 0

# ============================================================================
# Hash Tests
# ============================================================================

# Test: HSET and HGET basic operations
[[test]]
fn test_hset_hget() -> i32
    var store: Store = store_new()

    # Set a field in a new hash
    let res1: i32 = store_hset(@store, "myhash", "field1", "value1")
    if res1 != 1  # New field
        return 1

    # Get the field
    let val1: StrView = store_hget(@store, "myhash", "field1")
    if val1.ptr == null
        return 1
    if not val1.eq("value1")
        return 1

    # Update existing field
    let res2: i32 = store_hset(@store, "myhash", "field1", "newvalue")
    if res2 != 0  # Updated, not new
        return 1

    let val2: StrView = store_hget(@store, "myhash", "field1")
    if not val2.eq("newvalue")
        return 1

    # Get non-existent field
    let val3: StrView = store_hget(@store, "myhash", "nofield")
    if val3.ptr != null
        return 1

    # Get from non-existent key
    let val4: StrView = store_hget(@store, "nokey", "field1")
    if val4.ptr != null
        return 1

    return 0

# Test: HDEL field deletion
[[test]]
fn test_hdel() -> i32
    var store: Store = store_new()

    store_hset(@store, "myhash", "f1", "v1")
    store_hset(@store, "myhash", "f2", "v2")
    store_hset(@store, "myhash", "f3", "v3")

    # Delete existing field
    let del1: i32 = store_hdel(@store, "myhash", "f2")
    if del1 != 1
        return 1

    # Verify deleted
    if store_hget(@store, "myhash", "f2").ptr != null
        return 1

    # Other fields still exist
    if store_hget(@store, "myhash", "f1").ptr == null
        return 1
    if store_hget(@store, "myhash", "f3").ptr == null
        return 1

    # Delete non-existent field
    let del2: i32 = store_hdel(@store, "myhash", "nofield")
    if del2 != 0
        return 1

    # Delete from non-existent key
    let del3: i32 = store_hdel(@store, "nokey", "f1")
    if del3 != 0
        return 1

    return 0

# Test: HEXISTS and HLEN
[[test]]
fn test_hexists_hlen() -> i32
    var store: Store = store_new()

    store_hset(@store, "myhash", "f1", "v1")
    store_hset(@store, "myhash", "f2", "v2")

    # HEXISTS
    if store_hexists(@store, "myhash", "f1") != 1
        return 1
    if store_hexists(@store, "myhash", "nofield") != 0
        return 1
    if store_hexists(@store, "nokey", "f1") != 0
        return 1

    # HLEN
    let len1: i64 = store_hlen(@store, "myhash")
    if len1 != 2
        return 1

    store_hset(@store, "myhash", "f3", "v3")
    if store_hlen(@store, "myhash") != 3
        return 1

    # Non-existent key returns 0
    if store_hlen(@store, "nokey") != 0
        return 1

    return 0

# Test: HKEYS
[[test]]
fn test_hkeys() -> i32
    var store: Store = store_new()

    store_hset(@store, "myhash", "name", "John")
    store_hset(@store, "myhash", "age", "30")
    store_hset(@store, "myhash", "city", "NYC")

    var count: i64 = 0
    let keys: Vec<StrView> = store_hkeys(@store, "myhash")
    count = keys.len()
    if count != 3
        return 1

    # Check all keys present (order may vary due to hashing)
    var found_name: i32 = 0
    var found_age: i32 = 0
    var found_city: i32 = 0
    for i in 0..count
        let k: StrView = keys.get(i)
        if k.eq("name")
            found_name = 1
        if k.eq("age")
            found_age = 1
        if k.eq("city")
            found_city = 1


    if found_name != 1 || found_age != 1 || found_city != 1
        return 1

    return 0

# Test: HVALS
[[test]]
fn test_hvals() -> i32
    var store: Store = store_new()

    store_hset(@store, "myhash", "a", "1")
    store_hset(@store, "myhash", "b", "2")

    var count: i64 = 0
    let vals: Vec<StrView> = store_hvals(@store, "myhash")
    count = vals.len()
    if count != 2
        return 1

    # Check values present
    var found_1: i32 = 0
    var found_2: i32 = 0
    for i in 0..count
        let v: StrView = vals.get(i)
        if v.eq("1")
            found_1 = 1
        if v.eq("2")
            found_2 = 1


    if found_1 != 1 || found_2 != 1
        return 1

    return 0

# Test: HGETALL
[[test]]
fn test_hgetall() -> i32
    var store: Store = store_new()

    store_hset(@store, "myhash", "x", "10")
    store_hset(@store, "myhash", "y", "20")

    var count: i64 = 0
    let pairs: Vec<StrView> = store_hgetall(@store, "myhash")
    count = pairs.len()
    if count != 4  # 2 fields * 2 (field + value)
        return 1

    # Should have field-value pairs
    # pairs.get(0), pairs.get(1) = first field, first value
    # pairs.get(2), pairs.get(3) = second field, second value
    var found_x10: i32 = 0
    var found_y20: i32 = 0
    var i: i64 = 0
    while i < count
        let field: StrView = pairs.get(i)
        let val: StrView = pairs.get(i + 1)
        if field.eq("x") && val.eq("10")
            found_x10 = 1
        if field.eq("y") && val.eq("20")
            found_y20 = 1
        i += 2


    if found_x10 != 1 || found_y20 != 1
        return 1

    return 0

# Test: Hash type mismatch
[[test]]
fn test_hash_type_mismatch() -> i32
    var store: Store = store_new()

    # Set string key
    store_set(@store, "key", "value")

    # Hash ops on string should fail with -1
    let res: i32 = store_hset(@store, "key", "field", "val")
    if res != -1
        return 1

    if store_hexists(@store, "key", "field") != -1
        return 1

    if store_hlen(@store, "key") != -1
        return 1

    if store_hdel(@store, "key", "field") != -1
        return 1

    return 0

# Test: Delete hash key
[[test]]
fn test_del_hash() -> i32
    var store: Store = store_new()

    store_hset(@store, "myhash", "f1", "v1")
    store_hset(@store, "myhash", "f2", "v2")

    # Delete should work
    let deleted: i32 = store_del(@store, "myhash")
    if deleted != 1
        return 1

    # Hash should be gone
    if store_hlen(@store, "myhash") != 0
        return 1

    if store_hget(@store, "myhash", "f1").ptr != null
        return 1

    return 0

# ============================================================================
# Test: skip list nodes are reused after removal
# ============================================================================
# 100 members, every other one removed, then new members added into the
# freed node slots: the order by score, ranks and the index all hold.

fn zset_member(tag: u8, i: i64) -> String
    var name: String = string_from("m000")
    name.set_char(0, tag)
    name.set_char(1, (48 + i / 100) as u8)
    name.set_char(2, (48 + (i / 10) % 10) as u8)
    name.set_char(3, (48 + i % 10) as u8)
    return name

[[test]]
fn test_zset_node_reuse() -> i32
    var store: Store = store_new()
    for i in 0..100
        let m: String = zset_member(97, i)  # 'a'
        store_zadd(@store, "z", (i * 2) as f64, m.as_view())
    for i in 0..50
        let m: String = zset_member(97, i * 2 + 1)
        if store_zrem(@store, "z", m.as_view()) != 1
            return 1
    if store_zcard(@store, "z") != 50
        return 2
    # Odd scores slot in between the even ones that are left.
    for i in 0..50
        let m: String = zset_member(98, i)  # 'b'
        if store_zadd(@store, "z", (i * 4 + 1) as f64, m.as_view()) != 1
            return 3
    if store_zcard(@store, "z") != 100
        return 4
    let all: Vec<StrView> = store_zrange(@store, "z", 0, -1)
    if all.len() != 100
        return 5
    # a000 (0), b000 (1), a002 (4), b001 (5), ...
    for i in 0..50
        let a: String = zset_member(97, i * 2)
        let b: String = zset_member(98, i)
        if not all.get(i * 2).eq(a.as_view()) or not all.get(i * 2 + 1).eq(b.as_view())
            return 6
        if store_zrank(@store, "z", b.as_view()) != i * 2 + 1
            return 7
    # A removed member is gone from the index too.
    let gone: String = zset_member(97, 3)
    var score: f64 = 0.0
    if store_zscore(@store, "z", gone.as_view(), @&score) != 0
        return 8
    # Re-scoring moves a member and keeps one node for it.
    if store_zadd(@store, "z", 1000.0, "a000") != 0
        return 9
    let top: Vec<StrView> = store_zrevrange(@store, "z", 0, 0)
    if top.len() != 1 or not top.get(0).eq("a000") or store_zcard(@store, "z") != 100
        return 10
    return 0
