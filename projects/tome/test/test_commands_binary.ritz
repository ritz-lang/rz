# test/test_commands_binary.ritz - Command args reach the store whole
#
# AGAST #3069: every handler used to copy its args into [256]u8 keys and
# [8192]u8 values and re-measure them with strlen, so a longer key or value
# was silently truncated and an embedded NUL cut one short.  Redis stores
# both whole.  These tests build RESP frames byte by byte, so an arg can be
# any length and hold any byte.
#
# Kept out of test_commands.ritz: `ritz0 --test` recompiles a file once per
# test, and build.py gives each file a fixed budget.

import ritzlib.sys
import ritzlib.io
import ritzlib.string
import ritzlib.strview
import ritzlib.memory
import lib.tome
import lib.resp
import lib.commands


# ============================================================================
# RESP frame builder
# ============================================================================

const REQ_CAP: i64 = 65536
const KL: i64 = 300     # past the old 255-byte key copy
const VL: i64 = 10000   # past the old 8191-byte value copy

struct Req
    buf: String

fn req_new() -> Req
    return Req { buf: string_new() }

# `tag` then the decimal `n` then CRLF: "*3\r\n", "$300\r\n".
fn req_put_num(r: *Req, tag: u8, n: i64)
    (r.buf).push(tag)
    (r.buf).push_i64(n)
    (r.buf).push_str("\r\n")

fn req_bulk(r: *Req, v: StrView)
    req_put_num(r, 36, v.len)  # '$'
    (r.buf).push_str(v)
    (r.buf).push_str("\r\n")

# Start a fresh frame of `argc` args (the command name included).
fn req_cmd(r: *Req, argc: i64, name: StrView)
    (r.buf).clear()
    req_put_num(r, 42, argc)  # '*'
    req_bulk(r, name)

fn req1(r: *Req, name: StrView, a: StrView)
    req_cmd(r, 2, name)
    req_bulk(r, a)

fn req2(r: *Req, name: StrView, a: StrView, b: StrView)
    req_cmd(r, 3, name)
    req_bulk(r, a)
    req_bulk(r, b)

fn req3(r: *Req, name: StrView, a: StrView, b: StrView, c: StrView)
    req_cmd(r, 4, name)
    req_bulk(r, a)
    req_bulk(r, b)
    req_bulk(r, c)

# Run the frame in `r`; 0 when the reply is exactly `want`.
fn reply_is(store: *Store, r: *Req, want: StrView) -> i32
    var parser: RespParser
    resp_parser_init(@parser, (r.buf).as_view())
    if resp_parse(@parser) != RESP_OK
        return 1
    let out: *u8 = malloc(REQ_CAP)
    var ctx: CommandContext
    cmd_ctx_init(@ctx, store, out, REQ_CAP as i32)
    cmd_dispatch(@ctx, @parser.command)
    var rc: i32 = 0
    if not strview_from_ptr(out, ctx.resp_len as i64).eq(want)
        rc = 1
    free(out)
    return rc

# 0 when the reply is the bulk string `v`.
fn reply_is_bulk(store: *Store, r: *Req, v: StrView) -> i32
    var w: Req = req_new()
    req_bulk(@w, v)
    return reply_is(store, r, (w.buf).as_view())

# 0 when the reply is the bytes built in `w`.
fn reply_is_req(store: *Store, r: *Req, w: *Req) -> i32
    return reply_is(store, r, (w.buf).as_view())

# `n` bytes of `fill` ending in `last`: two of these that differ only in
# `last` share their first n-1 bytes, so a truncating copy merges them.
fn filled(n: i64, fill: u8, last: u8) -> String
    var s: String = string_with_cap(n)
    for i in 0..n - 1
        s.push(fill)
    s.push(last)
    return s


# The trap: a string key, with a TTL, named by the first 255 bytes that
# k1 and k2 share.  A handler that truncates k1 or k2 to the old [256]u8
# copy lands on it and answers for it instead (wrong type, a TTL, ...).
fn set_trap(store: *Store, r: *Req, k: StrView) -> i32
    req3(r, "SETEX", k.take(255), "100", "t")
    return reply_is(store, r, "+OK\r\n")


# ============================================================================
# Strings
# ============================================================================

[[test]]
fn test_set_get_long_key() -> i32
    var store: Store = store_new()
    var r: Req = req_new()
    let k1: String = filled(KL, 107, 97)  # "kkk...ka"
    let k2: String = filled(KL, 107, 98)  # "kkk...kb"
    req2(@r, "SET", k1.as_view(), "one")
    if reply_is(@store, @r, "+OK\r\n") != 0
        return 1
    req2(@r, "SET", k2.as_view(), "two")
    if reply_is(@store, @r, "+OK\r\n") != 0
        return 2
    req1(@r, "GET", k1.as_view())
    if reply_is(@store, @r, "$3\r\none\r\n") != 0
        return 3
    req1(@r, "GET", k2.as_view())
    if reply_is(@store, @r, "$3\r\ntwo\r\n") != 0
        return 4
    return 0


[[test]]
fn test_set_get_long_value() -> i32
    var store: Store = store_new()
    var r: Req = req_new()
    let v: String = filled(VL, 118, 90)  # "vvv...vZ"
    req2(@r, "SET", "k", v.as_view())
    if reply_is(@store, @r, "+OK\r\n") != 0
        return 1
    req1(@r, "GET", "k")
    if reply_is_bulk(@store, @r, v.as_view()) != 0
        return 2
    return 0


[[test]]
fn test_set_get_value_with_nul() -> i32
    var store: Store = store_new()
    var r: Req = req_new()
    req2(@r, "SET", "k", "a\0b")
    if reply_is(@store, @r, "+OK\r\n") != 0
        return 1
    req1(@r, "GET", "k")
    if reply_is_bulk(@store, @r, "a\0b") != 0
        return 2
    return 0


[[test]]
fn test_keys_with_nul_are_distinct() -> i32
    var store: Store = store_new()
    var r: Req = req_new()
    req2(@r, "SET", "k\0a", "one")
    if reply_is(@store, @r, "+OK\r\n") != 0
        return 1
    req2(@r, "SET", "k\0b", "two")
    if reply_is(@store, @r, "+OK\r\n") != 0
        return 2
    req1(@r, "GET", "k\0a")
    if reply_is(@store, @r, "$3\r\none\r\n") != 0
        return 3
    req1(@r, "GET", "k")
    if reply_is(@store, @r, "$-1\r\n") != 0
        return 4
    return 0


# ============================================================================
# Key commands: k1 holds a string, k2 (same first 299 bytes) is missing,
# and the trap holds their shared 255-byte prefix
# ============================================================================

[[test]]
fn test_key_commands_long_key() -> i32
    var store: Store = store_new()
    var r: Req = req_new()
    let k1: String = filled(KL, 107, 97)
    let k2: String = filled(KL, 107, 98)
    if set_trap(@store, @r, k1.as_view()) != 0
        return 99
    req2(@r, "SET", k1.as_view(), "x")
    if reply_is(@store, @r, "+OK\r\n") != 0
        return 1
    req1(@r, "EXISTS", k2.as_view())
    if reply_is(@store, @r, ":0\r\n") != 0
        return 2
    req1(@r, "TTL", k2.as_view())
    if reply_is(@store, @r, ":-2\r\n") != 0
        return 3
    req2(@r, "EXPIRE", k2.as_view(), "100")
    if reply_is(@store, @r, ":0\r\n") != 0
        return 4
    req1(@r, "PERSIST", k2.as_view())
    if reply_is(@store, @r, ":0\r\n") != 0
        return 5
    req1(@r, "DEL", k2.as_view())
    if reply_is(@store, @r, ":0\r\n") != 0
        return 6
    # INCR of the missing k2 counts from 0 (k1's "x" is no integer).
    req1(@r, "INCR", k2.as_view())
    if reply_is(@store, @r, ":1\r\n") != 0
        return 7
    req2(@r, "INCRBY", k2.as_view(), "4")
    if reply_is(@store, @r, ":5\r\n") != 0
        return 8
    req1(@r, "GET", k1.as_view())
    if reply_is(@store, @r, "$1\r\nx\r\n") != 0
        return 9
    req1(@r, "DEL", k2.as_view())
    if reply_is(@store, @r, ":1\r\n") != 0
        return 12
    req1(@r, "EXISTS", k1.as_view())
    if reply_is(@store, @r, ":1\r\n") != 0
        return 13
    # "1\0x" is not an integer: INCR reads all 3 bytes, not just "1".
    req2(@r, "SET", "n", "1\0x")
    if reply_is(@store, @r, "+OK\r\n") != 0
        return 10
    req1(@r, "INCR", "n")
    if reply_is(@store, @r, "-ERR value is not an integer or out of range\r\n") != 0
        return 11
    return 0


[[test]]
fn test_setex_long_key_and_value() -> i32
    var store: Store = store_new()
    var r: Req = req_new()
    let k1: String = filled(KL, 107, 97)
    let k2: String = filled(KL, 107, 98)
    let v: String = filled(VL, 118, 90)
    if set_trap(@store, @r, k1.as_view()) != 0
        return 99
    req3(@r, "SETEX", k1.as_view(), "100", v.as_view())
    if reply_is(@store, @r, "+OK\r\n") != 0
        return 1
    req1(@r, "GET", k1.as_view())
    if reply_is_bulk(@store, @r, v.as_view()) != 0
        return 2
    req1(@r, "GET", k2.as_view())
    if reply_is(@store, @r, "$-1\r\n") != 0
        return 3
    req3(@r, "SETEX", "b", "100", "a\0b")
    if reply_is(@store, @r, "+OK\r\n") != 0
        return 4
    req1(@r, "GET", "b")
    if reply_is_bulk(@store, @r, "a\0b") != 0
        return 5
    return 0


# ============================================================================
# Lists
# ============================================================================

[[test]]
fn test_list_commands_long_args() -> i32
    var store: Store = store_new()
    var r: Req = req_new()
    let k1: String = filled(KL, 107, 97)
    let k2: String = filled(KL, 107, 98)
    let v: String = filled(VL, 118, 90)
    let w: String = filled(VL, 119, 89)  # "www...wY"
    if set_trap(@store, @r, k1.as_view()) != 0
        return 99
    req2(@r, "LPUSH", k1.as_view(), v.as_view())
    if reply_is(@store, @r, ":1\r\n") != 0
        return 1
    req2(@r, "RPUSH", k1.as_view(), w.as_view())
    if reply_is(@store, @r, ":2\r\n") != 0
        return 2
    req1(@r, "LLEN", k2.as_view())
    if reply_is(@store, @r, ":0\r\n") != 0
        return 3
    req2(@r, "LINDEX", k1.as_view(), "1")
    if reply_is_bulk(@store, @r, w.as_view()) != 0
        return 4
    var want: Req = req_new()
    req_put_num(@want, 42, 2)
    req_bulk(@want, v.as_view())
    req_bulk(@want, w.as_view())
    req3(@r, "LRANGE", k1.as_view(), "0", "-1")
    if reply_is_req(@store, @r, @want) != 0
        return 5
    req1(@r, "LPOP", k2.as_view())
    if reply_is(@store, @r, "$-1\r\n") != 0
        return 6
    req1(@r, "RPOP", k2.as_view())
    if reply_is(@store, @r, "$-1\r\n") != 0
        return 7
    req1(@r, "LPOP", k1.as_view())
    if reply_is_bulk(@store, @r, v.as_view()) != 0
        return 8
    req1(@r, "RPOP", k1.as_view())
    if reply_is_bulk(@store, @r, w.as_view()) != 0
        return 9
    return 0


# ============================================================================
# Sets
# ============================================================================

[[test]]
fn test_set_commands_long_args() -> i32
    var store: Store = store_new()
    var r: Req = req_new()
    let k1: String = filled(KL, 107, 97)
    let k2: String = filled(KL, 107, 98)
    let m1: String = filled(VL, 109, 97)  # "mmm...ma"
    let m2: String = filled(VL, 109, 98)  # "mmm...mb"
    if set_trap(@store, @r, k1.as_view()) != 0
        return 99
    req2(@r, "SADD", k1.as_view(), m1.as_view())
    if reply_is(@store, @r, ":1\r\n") != 0
        return 1
    req2(@r, "SISMEMBER", k1.as_view(), m2.as_view())
    if reply_is(@store, @r, ":0\r\n") != 0
        return 2
    req2(@r, "SADD", k1.as_view(), m2.as_view())
    if reply_is(@store, @r, ":1\r\n") != 0
        return 3
    req1(@r, "SCARD", k1.as_view())
    if reply_is(@store, @r, ":2\r\n") != 0
        return 4
    req1(@r, "SCARD", k2.as_view())
    if reply_is(@store, @r, ":0\r\n") != 0
        return 5
    req2(@r, "SREM", k1.as_view(), m2.as_view())
    if reply_is(@store, @r, ":1\r\n") != 0
        return 7
    req2(@r, "SISMEMBER", k1.as_view(), m1.as_view())
    if reply_is(@store, @r, ":1\r\n") != 0
        return 8
    var want: Req = req_new()
    req_put_num(@want, 42, 1)
    req_bulk(@want, m1.as_view())
    req1(@r, "SMEMBERS", k1.as_view())
    if reply_is_req(@store, @r, @want) != 0
        return 6
    return 0


# ============================================================================
# Hashes
# ============================================================================

[[test]]
fn test_hash_commands_long_args() -> i32
    var store: Store = store_new()
    var r: Req = req_new()
    let k1: String = filled(KL, 107, 97)
    let k2: String = filled(KL, 107, 98)
    let f1: String = filled(KL, 102, 97)  # "fff...fa"
    let f2: String = filled(KL, 102, 98)  # "fff...fb"
    let v: String = filled(VL, 118, 90)
    if set_trap(@store, @r, k1.as_view()) != 0
        return 99
    req3(@r, "HSET", k1.as_view(), f1.as_view(), v.as_view())
    if reply_is(@store, @r, ":1\r\n") != 0
        return 1
    req2(@r, "HEXISTS", k1.as_view(), f2.as_view())
    if reply_is(@store, @r, ":0\r\n") != 0
        return 2
    req2(@r, "HGET", k1.as_view(), f1.as_view())
    if reply_is_bulk(@store, @r, v.as_view()) != 0
        return 3
    req3(@r, "HSET", k1.as_view(), f2.as_view(), "two")
    if reply_is(@store, @r, ":1\r\n") != 0
        return 4
    req2(@r, "HGET", k1.as_view(), f2.as_view())
    if reply_is(@store, @r, "$3\r\ntwo\r\n") != 0
        return 5
    req1(@r, "HLEN", k1.as_view())
    if reply_is(@store, @r, ":2\r\n") != 0
        return 6
    req1(@r, "HLEN", k2.as_view())
    if reply_is(@store, @r, ":0\r\n") != 0
        return 7
    req2(@r, "HDEL", k1.as_view(), f2.as_view())
    if reply_is(@store, @r, ":1\r\n") != 0
        return 11
    req2(@r, "HEXISTS", k1.as_view(), f1.as_view())
    if reply_is(@store, @r, ":1\r\n") != 0
        return 12
    # k1 is now {f1: v}.
    var want: Req = req_new()
    req_put_num(@want, 42, 1)
    req_bulk(@want, f1.as_view())
    req1(@r, "HKEYS", k1.as_view())
    if reply_is_req(@store, @r, @want) != 0
        return 8
    (want.buf).clear()
    req_put_num(@want, 42, 1)
    req_bulk(@want, v.as_view())
    req1(@r, "HVALS", k1.as_view())
    if reply_is_req(@store, @r, @want) != 0
        return 9
    (want.buf).clear()
    req_put_num(@want, 42, 2)
    req_bulk(@want, f1.as_view())
    req_bulk(@want, v.as_view())
    req1(@r, "HGETALL", k1.as_view())
    if reply_is_req(@store, @r, @want) != 0
        return 10
    return 0
