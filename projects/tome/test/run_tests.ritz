# test/run_tests.ritz - Basic store and authentication tests for Tome
#
# Store basics (string, list, set, hash) plus AUTH
# gating through the command layer (cmd_ctx_init_auth + cmd_dispatch).
#
# Deliberately does not import lib.server: `ritz0 --test` recompiles the file
# once per test and lib.server (io_uring, async runtime) makes each compile
# ~4x slower, pushing this file past build.py's 180s budget. The
# ConnectionState tests that need it live in test_server_auth.ritz.

import ritzlib.sys
import ritzlib.io
import ritzlib.option
import ritzlib.strview
import lib.tome
import lib.resp
import lib.commands
import ritzlib.string
import ritzlib.span


# Whether the `len`-byte reply at `buf` is exactly `want`.
fn written(buf: [u8], len: i32, want: StrView) -> bool
    return len >= 0 and buf.to(len as i64).as_strview().eq(want)

# ============================================================================
# Basic Store Tests (inline)
# ============================================================================

[[test]]
fn test_basic_set_get() -> i32
    var store: Store = store_new()
    store_set(@store, "hello", "world")
    match store_get(@store, "hello")
        Some(val) =>
            if not val.eq("world")
                return 2
        None => return 1
    return 0

[[test]]
fn test_basic_del() -> i32
    var store: Store = store_new()
    store_set(@store, "key", "value")
    if store_exists(@store, "key") != 1
        return 1
    let deleted: i32 = store_del(@store, "key")
    if deleted != 1
        return 2
    if store_exists(@store, "key") != 0
        return 3
    return 0

[[test]]
fn test_basic_list() -> i32
    var store: Store = store_new()
    store_lpush(@store, "mylist", "a")
    store_rpush(@store, "mylist", "b")
    store_lpush(@store, "mylist", "c")
    # List is now: c, a, b
    if store_llen(@store, "mylist") != 3
        return 1
    var first: String = store_lpop(@store, "mylist")
    if not first.eq("c")
        return 2
    return 0

[[test]]
fn test_basic_set() -> i32
    var store: Store = store_new()
    store_sadd(@store, "myset", "a")
    store_sadd(@store, "myset", "b")
    store_sadd(@store, "myset", "a")  # Duplicate
    if store_scard(@store, "myset") != 2
        return 1
    if store_sismember(@store, "myset", "a") != 1
        return 2
    if store_sismember(@store, "myset", "c") != 0
        return 3
    return 0

[[test]]
fn test_basic_hash() -> i32
    var store: Store = store_new()
    store_hset(@store, "myhash", "field1", "value1")
    store_hset(@store, "myhash", "field2", "value2")
    let val: StrView = store_hget(@store, "myhash", "field1")
    if val.ptr == null
        return 1
    if not val.eq("value1")
        return 2
    if store_hlen(@store, "myhash") != 2
        return 3
    return 0

# ============================================================================
# Authentication Tests (Phase 10)
# ============================================================================

[[test]]
fn test_no_password_allows_all() -> i32
    # When password is null, all commands should work
    var store: Store = store_new()
    var buf: [8192]u8

    var ctx: CommandContext
    cmd_ctx_init_auth(@ctx, @store, @buf, None, 0)

    # Parse and execute SET (which requires auth when password is set)
    var parser: RespParser
    resp_parser_init(@parser, "*3\r\n$3\r\nSET\r\n$3\r\nfoo\r\n$3\r\nbar\r\n")
    let parse_result: i32 = resp_parse(@parser)
    if parse_result != RESP_OK
        return 1

    cmd_dispatch(@ctx, @parser.command)
    # Should return OK (not NOAUTH error)
    if not written(@buf, ctx.resp_len, "+OK\r\n")
        return 2

    return 0

[[test]]
fn test_password_blocks_before_auth() -> i32
    var store: Store = store_new()
    var buf: [8192]u8

    # Password set, not authenticated
    var ctx: CommandContext
    cmd_ctx_init_auth(@ctx, @store, @buf, Some("secret123"), 0)

    # Parse and execute SET
    var parser: RespParser
    resp_parser_init(@parser, "*3\r\n$3\r\nSET\r\n$3\r\nfoo\r\n$3\r\nbar\r\n")
    let parse_result: i32 = resp_parse(@parser)
    if parse_result != RESP_OK
        return 1

    cmd_dispatch(@ctx, @parser.command)
    # Should return error (starts with -)
    if buf[0] != 45  # '-'
        return 2

    return 0

[[test]]
fn test_password_allows_after_auth() -> i32
    var store: Store = store_new()
    var buf: [8192]u8

    # Password set, IS authenticated
    var ctx: CommandContext
    cmd_ctx_init_auth(@ctx, @store, @buf, Some("secret123"), 1)

    # Parse and execute SET
    var parser: RespParser
    resp_parser_init(@parser, "*3\r\n$3\r\nSET\r\n$3\r\nfoo\r\n$3\r\nbar\r\n")
    let parse_result: i32 = resp_parse(@parser)
    if parse_result != RESP_OK
        return 1

    cmd_dispatch(@ctx, @parser.command)
    # Should return OK
    if not written(@buf, ctx.resp_len, "+OK\r\n")
        return 2

    return 0

[[test]]
fn test_auth_command_sets_flag() -> i32
    var store: Store = store_new()
    var buf: [8192]u8

    # Password set, not authenticated
    var ctx: CommandContext
    cmd_ctx_init_auth(@ctx, @store, @buf, Some("secret123"), 0)

    # Verify initially not authenticated
    if ctx.is_authenticated != 0
        return 1

    # Execute AUTH with correct password
    var parser: RespParser
    resp_parser_init(@parser, "*2\r\n$4\r\nAUTH\r\n$9\r\nsecret123\r\n")
    let parse_result: i32 = resp_parse(@parser)
    if parse_result != RESP_OK
        return 2

    cmd_dispatch(@ctx, @parser.command)
    # Should return OK
    if not written(@buf, ctx.resp_len, "+OK\r\n")
        return 3

    # Flag should now be set
    if ctx.is_authenticated != 1
        return 4

    return 0

[[test]]
fn test_auth_wrong_password() -> i32
    var store: Store = store_new()
    var buf: [8192]u8

    var ctx: CommandContext
    cmd_ctx_init_auth(@ctx, @store, @buf, Some("secret123"), 0)

    # Execute AUTH with wrong password
    var parser: RespParser
    resp_parser_init(@parser, "*2\r\n$4\r\nAUTH\r\n$5\r\nwrong\r\n")
    let parse_result: i32 = resp_parse(@parser)
    if parse_result != RESP_OK
        return 1

    cmd_dispatch(@ctx, @parser.command)
    # Should return error
    if buf[0] != 45  # '-'
        return 2

    # Should still be unauthenticated
    if ctx.is_authenticated != 0
        return 3

    return 0

[[test]]
fn test_ping_requires_auth_when_password_set() -> i32
    var store: Store = store_new()
    var buf: [8192]u8

    # Password set, NOT authenticated
    var ctx: CommandContext
    cmd_ctx_init_auth(@ctx, @store, @buf, Some("secret123"), 0)

    # PING is rejected before AUTH, as in Redis (AGAST #1686; agrees with
    # test_server_password_blocks_before_auth in test_server_auth.ritz)
    var parser: RespParser
    resp_parser_init(@parser, "*1\r\n$4\r\nPING\r\n")
    let parse_result: i32 = resp_parse(@parser)
    if parse_result != RESP_OK
        return 1

    cmd_dispatch(@ctx, @parser.command)
    # Should return NOAUTH, not PONG
    if not written(@buf, ctx.resp_len, "-NOAUTH Authentication required.\r\n")
        return 2

    return 0
