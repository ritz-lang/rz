# test/test_resp.ritz - Tests for RESP protocol parsing and encoding
#
# Tests the Redis Serialization Protocol implementation.

import ritzlib.sys
import ritzlib.io
import ritzlib.str
import ritzlib.memory
import lib.resp


# ============================================================================
# Parser Tests
# ============================================================================

[[test]]
fn test_parse_array_simple() -> i32
    # *2\r\n$3\r\nGET\r\n$3\r\nfoo\r\n
    let input: *u8 = c"*2\r\n$3\r\nGET\r\n$3\r\nfoo\r\n"
    let len: i64 = strlen(input)

    var p: RespParser
    resp_parser_init(@p, input, len)

    let result: i32 = resp_parse(@p)
    if result != RESP_OK
        return 1

    if p.command.argc != 2
        return 2

    # Check first arg c"GET"
    let arg0: *RespArg = @p.command.args[0]
    if arg0.len != 3
        return 3
    if resp_arg_eq_ci(arg0, c"GET") != 1
        return 4

    # Check second arg c"foo"
    let arg1: *RespArg = @p.command.args[1]
    if arg1.len != 3
        return 5
    if resp_arg_eq(arg1, c"foo") != 1
        return 6

    return 0


[[test]]
fn test_parse_array_set() -> i32
    # *3\r\n$3\r\nSET\r\n$5\r\nhello\r\n$5\r\nworld\r\n
    let input: *u8 = c"*3\r\n$3\r\nSET\r\n$5\r\nhello\r\n$5\r\nworld\r\n"
    let len: i64 = strlen(input)

    var p: RespParser
    resp_parser_init(@p, input, len)

    let result: i32 = resp_parse(@p)
    if result != RESP_OK
        return 1

    if p.command.argc != 3
        return 2

    if resp_arg_eq_ci(@p.command.args[0], c"SET") != 1
        return 3
    if resp_arg_eq(@p.command.args[1], c"hello") != 1
        return 4
    if resp_arg_eq(@p.command.args[2], c"world") != 1
        return 5

    return 0


[[test]]
fn test_parse_inline() -> i32
    # Inline command: c"PING\r\n"
    let input: *u8 = c"PING\r\n"
    let len: i64 = strlen(input)

    var p: RespParser
    resp_parser_init(@p, input, len)

    let result: i32 = resp_parse(@p)
    if result != RESP_OK
        return 1

    if p.command.argc != 1
        return 2

    if resp_arg_eq_ci(@p.command.args[0], c"PING") != 1
        return 3

    return 0


[[test]]
fn test_parse_inline_with_args() -> i32
    # Inline command: c"SET foo bar\r\n"
    let input: *u8 = c"SET foo bar\r\n"
    let len: i64 = strlen(input)

    var p: RespParser
    resp_parser_init(@p, input, len)

    let result: i32 = resp_parse(@p)
    if result != RESP_OK
        return 1

    if p.command.argc != 3
        return 2

    if resp_arg_eq_ci(@p.command.args[0], c"SET") != 1
        return 3
    if resp_arg_eq(@p.command.args[1], c"foo") != 1
        return 4
    if resp_arg_eq(@p.command.args[2], c"bar") != 1
        return 5

    return 0


[[test]]
fn test_parse_incomplete() -> i32
    # Incomplete array - missing second arg
    let input: *u8 = c"*2\r\n$3\r\nGET\r\n"
    let len: i64 = strlen(input)

    var p: RespParser
    resp_parser_init(@p, input, len)

    let result: i32 = resp_parse(@p)
    if result != RESP_INCOMPLETE
        return 1

    return 0


[[test]]
fn test_parse_incomplete_bulk() -> i32
    # Bulk string without enough data
    let input: *u8 = c"*1\r\n$5\r\nhe"
    let len: i64 = strlen(input)

    var p: RespParser
    resp_parser_init(@p, input, len)

    let result: i32 = resp_parse(@p)
    if result != RESP_INCOMPLETE
        return 1

    return 0


fn parse_cstr(input: *u8) -> i32
    var p: RespParser
    resp_parser_init(@p, input, strlen(input))
    return resp_parse(@p)


[[test]]
fn test_parse_bad_header_is_error_not_incomplete() -> i32
    # A malformed length can never be completed by more bytes (AGAST #2457).
    if parse_cstr(c"*1\r\n$x\r\n") != RESP_ERROR_PARSE
        return 1
    if parse_cstr(c"*z\r\n") != RESP_ERROR_PARSE
        return 2
    if parse_cstr(c"*1\rX") != RESP_ERROR_PARSE
        return 3
    if parse_cstr(c"*1\r\n$4") != RESP_INCOMPLETE
        return 4
    if parse_cstr(c"*1\r\n$4\r") != RESP_INCOMPLETE
        return 5
    if parse_cstr(c"*1\r\n$-") != RESP_INCOMPLETE
        return 6
    return 0


[[test]]
fn test_parse_empty_buffer() -> i32
    var p: RespParser
    resp_parser_init(@p, null, 0)

    let result: i32 = resp_parse(@p)
    if result != RESP_INCOMPLETE
        return 1

    return 0


# ============================================================================
# Encoder Tests
# ============================================================================

[[test]]
fn test_write_simple() -> i32
    var buf: [64]u8
    let len: i32 = resp_write_simple(@buf[0], c"OK")
    buf[len] = 0

    if strcmp(@buf[0], c"+OK\r\n") != 0
        return 1

    return 0


[[test]]
fn test_write_error() -> i32
    var buf: [64]u8
    let len: i32 = resp_write_error(@buf[0], c"ERR unknown command")
    buf[len] = 0

    if strcmp(@buf[0], c"-ERR unknown command\r\n") != 0
        return 1

    return 0


[[test]]
fn test_write_int() -> i32
    var buf: [64]u8
    let len: i32 = resp_write_i64(@buf[0], 42)
    buf[len] = 0

    if strcmp(@buf[0], c":42\r\n") != 0
        return 1

    return 0


[[test]]
fn test_write_int_negative() -> i32
    var buf: [64]u8
    let len: i32 = resp_write_i64(@buf[0], -17)
    buf[len] = 0

    if strcmp(@buf[0], c":-17\r\n") != 0
        return 1

    return 0


[[test]]
fn test_write_int_zero() -> i32
    var buf: [64]u8
    let len: i32 = resp_write_i64(@buf[0], 0)
    buf[len] = 0

    if strcmp(@buf[0], c":0\r\n") != 0
        return 1

    return 0


# AGAST #1932: `val = -n` wrapped for i64's minimum and the reply was ":-\r\n".
[[test]]
fn test_write_int_extremes() -> i32
    var buf: [64]u8
    let lo: i64 = -9223372036854775807 - 1
    var len: i32 = resp_write_i64(@buf[0], lo)
    buf[len] = 0
    if strcmp(@buf[0], c":-9223372036854775808\r\n") != 0
        return 1

    len = resp_write_i64(@buf[0], 9223372036854775807)
    buf[len] = 0
    if strcmp(@buf[0], c":9223372036854775807\r\n") != 0
        return 2

    return 0


# AGAST #1950: the array and bulk length headers share a digit writer that
# also did `val = -n`, so i64's minimum came out as "*-\r\n".
[[test]]
fn test_write_array_header_extremes() -> i32
    var buf: [64]u8
    let lo: i64 = -9223372036854775807 - 1
    var len: i32 = resp_write_array(@buf[0], lo)
    buf[len] = 0
    if strcmp(@buf[0], c"*-9223372036854775808\r\n") != 0
        return 1

    len = resp_write_array(@buf[0], 9223372036854775807)
    buf[len] = 0
    if strcmp(@buf[0], c"*9223372036854775807\r\n") != 0
        return 2

    len = resp_write_array(@buf[0], 0)
    buf[len] = 0
    if strcmp(@buf[0], c"*0\r\n") != 0
        return 3

    len = resp_write_bulk(@buf[0], c"", 0)
    buf[len] = 0
    if strcmp(@buf[0], c"$0\r\n\r\n") != 0
        return 4

    return 0


[[test]]
fn test_write_bulk() -> i32
    var buf: [64]u8
    let len: i32 = resp_write_bulk(@buf[0], c"hello", 5)
    buf[len] = 0

    if strcmp(@buf[0], c"$5\r\nhello\r\n") != 0
        return 1

    return 0


