# test/test_resp.ritz - Tests for RESP protocol parsing and encoding
#
# Tests the Redis Serialization Protocol implementation.

import ritzlib.sys
import ritzlib.io
import ritzlib.strview
import ritzlib.span
import lib.resp


# Whether the `len` bytes written at `buf` are exactly `want`.
fn written(buf: [u8], len: i32, want: StrView) -> bool
    return buf.to(len as i64).as_strview().eq(want)


# An argument over all of `text`.
fn resp_arg_of(text: StrView) -> RespArg
    return RespArg { text: text }


# ============================================================================
# Parser Tests
# ============================================================================

[[test]]
fn test_parse_array_simple() -> i32
    # *2\r\n$3\r\nGET\r\n$3\r\nfoo\r\n
    var p: RespParser
    resp_parser_init(@p, "*2\r\n$3\r\nGET\r\n$3\r\nfoo\r\n")

    let result: i32 = resp_parse(@p)
    if result != RESP_OK
        return 1

    if p.command.argc != 2
        return 2

    # Check first arg "GET"
    let arg0: *RespArg = @p.command.args[0]
    if arg0.text.len != 3
        return 3
    if resp_arg_eq_ci(arg0, "GET") != 1
        return 4

    # Check second arg "foo"
    let arg1: *RespArg = @p.command.args[1]
    if arg1.text.len != 3
        return 5
    if resp_arg_eq(arg1, "foo") != 1
        return 6

    return 0


[[test]]
fn test_parse_array_set() -> i32
    # *3\r\n$3\r\nSET\r\n$5\r\nhello\r\n$5\r\nworld\r\n
    var p: RespParser
    resp_parser_init(@p, "*3\r\n$3\r\nSET\r\n$5\r\nhello\r\n$5\r\nworld\r\n")

    let result: i32 = resp_parse(@p)
    if result != RESP_OK
        return 1

    if p.command.argc != 3
        return 2

    if resp_arg_eq_ci(@p.command.args[0], "SET") != 1
        return 3
    if resp_arg_eq(@p.command.args[1], "hello") != 1
        return 4
    if resp_arg_eq(@p.command.args[2], "world") != 1
        return 5

    return 0


[[test]]
fn test_parse_inline() -> i32
    # Inline command: "PING\r\n"
    var p: RespParser
    resp_parser_init(@p, "PING\r\n")

    let result: i32 = resp_parse(@p)
    if result != RESP_OK
        return 1

    if p.command.argc != 1
        return 2

    if resp_arg_eq_ci(@p.command.args[0], "PING") != 1
        return 3

    return 0


[[test]]
fn test_parse_inline_with_args() -> i32
    # Inline command: "SET foo bar\r\n"
    var p: RespParser
    resp_parser_init(@p, "SET foo bar\r\n")

    let result: i32 = resp_parse(@p)
    if result != RESP_OK
        return 1

    if p.command.argc != 3
        return 2

    if resp_arg_eq_ci(@p.command.args[0], "SET") != 1
        return 3
    if resp_arg_eq(@p.command.args[1], "foo") != 1
        return 4
    if resp_arg_eq(@p.command.args[2], "bar") != 1
        return 5

    return 0


[[test]]
fn test_parse_incomplete() -> i32
    # Incomplete array - missing second arg
    var p: RespParser
    resp_parser_init(@p, "*2\r\n$3\r\nGET\r\n")

    let result: i32 = resp_parse(@p)
    if result != RESP_INCOMPLETE
        return 1

    return 0


[[test]]
fn test_parse_incomplete_bulk() -> i32
    # Bulk string without enough data
    var p: RespParser
    resp_parser_init(@p, "*1\r\n$5\r\nhe")

    let result: i32 = resp_parse(@p)
    if result != RESP_INCOMPLETE
        return 1

    return 0


fn parse_text(input: StrView) -> i32
    var p: RespParser
    resp_parser_init(@p, input)
    return resp_parse(@p)


[[test]]
fn test_parse_bad_header_is_error_not_incomplete() -> i32
    # A malformed length can never be completed by more bytes (AGAST #2457).
    if parse_text("*1\r\n$x\r\n") != RESP_ERROR_PARSE
        return 1
    if parse_text("*z\r\n") != RESP_ERROR_PARSE
        return 2
    if parse_text("*1\rX") != RESP_ERROR_PARSE
        return 3
    if parse_text("*1\r\n$4") != RESP_INCOMPLETE
        return 4
    if parse_text("*1\r\n$4\r") != RESP_INCOMPLETE
        return 5
    if parse_text("*1\r\n$-") != RESP_INCOMPLETE
        return 6
    return 0


[[test]]
fn test_parse_empty_buffer() -> i32
    var p: RespParser
    resp_parser_init(@p, strview_empty())

    let result: i32 = resp_parse(@p)
    if result != RESP_INCOMPLETE
        return 1

    return 0


# ============================================================================
# Encoder Tests
# ============================================================================

[[test]]
fn test_write_simple() -> i32
    var buf: [64]u8
    let len: i32 = resp_write_simple(@buf, "OK")

    if not written(@buf, len, "+OK\r\n")
        return 1

    return 0


[[test]]
fn test_write_error() -> i32
    var buf: [64]u8
    let len: i32 = resp_write_error(@buf, "ERR unknown command")

    if not written(@buf, len, "-ERR unknown command\r\n")
        return 1

    return 0


[[test]]
fn test_write_int() -> i32
    var buf: [64]u8
    let len: i32 = resp_write_i64(@buf, 42)

    if not written(@buf, len, ":42\r\n")
        return 1

    return 0


[[test]]
fn test_write_int_negative() -> i32
    var buf: [64]u8
    let len: i32 = resp_write_i64(@buf, -17)

    if not written(@buf, len, ":-17\r\n")
        return 1

    return 0


[[test]]
fn test_write_int_zero() -> i32
    var buf: [64]u8
    let len: i32 = resp_write_i64(@buf, 0)

    if not written(@buf, len, ":0\r\n")
        return 1

    return 0


# AGAST #1932: `val = -n` wrapped for i64's minimum and the reply was ":-\r\n".
[[test]]
fn test_write_int_extremes() -> i32
    var buf: [64]u8
    let lo: i64 = -9223372036854775807 - 1
    var len: i32 = resp_write_i64(@buf, lo)
    if not written(@buf, len, ":-9223372036854775808\r\n")
        return 1

    len = resp_write_i64(@buf, 9223372036854775807)
    if not written(@buf, len, ":9223372036854775807\r\n")
        return 2

    return 0


# AGAST #1950: the array and bulk length headers share a digit writer that
# also did `val = -n`, so i64's minimum came out as "*-\r\n".
[[test]]
fn test_write_array_header_extremes() -> i32
    var buf: [64]u8
    let lo: i64 = -9223372036854775807 - 1
    var len: i32 = resp_write_array(@buf, lo)
    if not written(@buf, len, "*-9223372036854775808\r\n")
        return 1

    len = resp_write_array(@buf, 9223372036854775807)
    if not written(@buf, len, "*9223372036854775807\r\n")
        return 2

    len = resp_write_array(@buf, 0)
    if not written(@buf, len, "*0\r\n")
        return 3

    len = resp_write_bulk(@buf, "")
    if not written(@buf, len, "$0\r\n\r\n")
        return 4

    return 0


[[test]]
fn test_write_bulk() -> i32
    var buf: [64]u8
    let len: i32 = resp_write_bulk(@buf, "hello")

    if not written(@buf, len, "$5\r\nhello\r\n")
        return 1

    return 0


[[test]]
fn test_write_null() -> i32
    var buf: [64]u8
    let len: i32 = resp_write_null(@buf)

    if not written(@buf, len, "$-1\r\n")
        return 1

    return 0


[[test]]
fn test_write_array_header() -> i32
    var buf: [64]u8
    let len: i32 = resp_write_array(@buf, 3)

    if not written(@buf, len, "*3\r\n")
        return 1

    return 0


[[test]]
fn test_write_null_array() -> i32
    var buf: [64]u8
    let len: i32 = resp_write_null_array(@buf)

    if not written(@buf, len, "*-1\r\n")
        return 1

    return 0


# ============================================================================
# Argument Helper Tests
# ============================================================================

[[test]]
fn test_arg_eq_case_insensitive() -> i32
    var arg: RespArg = resp_arg_of("get")

    if resp_arg_eq_ci(@arg, "GET") != 1
        return 1
    if resp_arg_eq_ci(@arg, "Get") != 1
        return 2
    if resp_arg_eq_ci(@arg, "set") != 0
        return 3

    return 0


[[test]]
fn test_arg_to_int() -> i32
    var arg: RespArg
    var ok: i32 = 0

    arg = resp_arg_of("123")
    let val1: i64 = resp_arg_to_int(@arg, @ok)
    if ok != 1
        return 1
    if val1 != 123
        return 2

    arg = resp_arg_of("-456")
    let val2: i64 = resp_arg_to_int(@arg, @ok)
    if ok != 1
        return 3
    if val2 != -456
        return 4

    return 0


# resp_arg_to_int on `text`: its value when ok is 1, else `bad`.
fn arg_int_or(text: StrView, bad: i64) -> i64
    var arg: RespArg = resp_arg_of(text)
    var ok: i32 = 0
    let v: i64 = resp_arg_to_int(@arg, @ok)
    if ok != 1
        return bad
    return v


# Arguments parse through ritzlib's strview_parse_i64 (#1958): the whole i64
# range, and nothing outside it. The hand-written loop wrapped i64::MAX + 1
# to i64::MIN and accepted it.
[[test]]
fn test_arg_to_int_range() -> i32
    let min: i64 = -9223372036854775807 - 1
    let max: i64 = 9223372036854775807
    if arg_int_or("-9223372036854775808", 7) != min
        return 1
    if arg_int_or("9223372036854775807", 7) != max
        return 2
    if arg_int_or("0", 7) != 0
        return 3
    if arg_int_or("9223372036854775808", 7) != 7
        return 4
    if arg_int_or("-9223372036854775809", 7) != 7
        return 5
    if arg_int_or("18446744073709551621", 7) != 7  # 2^64 + 5
        return 6
    if arg_int_or("12x", 7) != 7
        return 7
    if arg_int_or("-", 7) != 7
        return 8
    # Redis takes no '+' sign; neither does tome.
    if arg_int_or("+5", 7) != 7
        return 9
    return 0


# resp_read_int over `text` from its start: the value, with *ok set as the
# parser sets it (1 read, 0 incomplete, -1 malformed).
fn read_int(text: StrView, ok: *i32) -> i64
    var p: RespParser
    resp_parser_init(@p, text)
    return resp_read_int(@p, ok)


# A RESP header integer (":n", "$n", "*n") covers i64 too. The old reader
# refused anything over 18 digits, so i64::MIN and i64::MAX were malformed.
[[test]]
fn test_read_int_range() -> i32
    var ok: i32 = 0
    let min: i64 = -9223372036854775807 - 1
    if read_int("-9223372036854775808\r\n", @ok) != min or ok != 1
        return 1
    if read_int("9223372036854775807\r\n", @ok) != 9223372036854775807 or ok != 1
        return 2
    if read_int("0\r\n", @ok) != 0 or ok != 1
        return 3
    if read_int("-1\r\n", @ok) != -1 or ok != 1
        return 4
    read_int("9223372036854775808\r\n", @ok)
    if ok != -1
        return 5
    read_int("12x\r\n", @ok)
    if ok != -1
        return 6
    read_int("+5\r\n", @ok)
    if ok != -1
        return 7
    read_int("-\r\n", @ok)
    if ok != -1
        return 8
    read_int("\r\n", @ok)
    if ok != -1
        return 9
    # Digits with no \r yet are incomplete, until they are too long to be
    # an i64: then it is malformed, not a wait for bytes that fix nothing.
    read_int("-92233720368547758", @ok)
    if ok != 0
        return 10
    read_int("123456789012345678901", @ok)
    if ok != -1
        return 11
    read_int("12\r", @ok)
    if ok != 0
        return 12
    # ... and a byte no integer holds is malformed before its \r arrives.
    read_int("12x", @ok)
    if ok != -1
        return 13
    return 0


# tome_parse_int_arg over `s` within [lo, hi]: the value, or `bad`.
fn int_arg_or(s: StrView, lo: i64, hi: i64, bad: i64) -> i64
    var v: i64 = 0
    if tome_parse_int_arg(s, lo, hi, @v) == 0
        return bad
    return v


# AGAST #4040: tome-server's and tome-cli's --port / --workers parsed into
# an i32 that wrapped silently, so "4294967297" (2^32 + 1) was port 1.
[[test]]
fn test_int_arg_range() -> i32
    let min: i64 = -9223372036854775807 - 1
    let max: i64 = 9223372036854775807
    if int_arg_or("-9223372036854775808", min, max, 7) != min
        return 1
    if int_arg_or("9223372036854775807", min, max, 7) != max
        return 2
    if int_arg_or("0", min, max, 7) != 0
        return 3
    if int_arg_or("9223372036854775808", min, max, 7) != 7
        return 4
    if int_arg_or("12x", min, max, 7) != 7
        return 5
    if int_arg_or("", min, max, 7) != 7
        return 6
    if int_arg_or("+5", min, max, 7) != 7
        return 7
    # The bins' ranges: a port is 1..65535, a worker count 0..64.
    if int_arg_or("6379", 1, 65535, 7) != 6379
        return 8
    if int_arg_or("4294967297", 1, 65535, 7) != 7  # 2^32 + 1
        return 9
    if int_arg_or("65536", 1, 65535, 7) != 7
        return 10
    if int_arg_or("0", 1, 65535, 7) != 7
        return 11
    if int_arg_or("-1", 0, 64, 7) != 7
        return 12
    if int_arg_or("64", 0, 64, 64) != 64
        return 13
    return 0
