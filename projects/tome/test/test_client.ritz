# test/test_client.ritz - Tests for tome.client helpers
#
# AGAST #2457: tome-cli handed tcp_connect 127.0.0.1 already in network
# byte order; tcp_connect byte-swaps again, so it dialled 1.0.0.127 and
# hung in connect().  client_parse_host returns host byte order.

import ritzlib.sys
import ritzlib.io
import ritzlib.str
import lib.client


[[test]]
fn test_client_parse_host_is_host_order() -> i32
    if client_parse_host(c"127.0.0.1") != 0x7F000001
        return 1
    if client_parse_host(c"localhost") != 0x7F000001
        return 2
    if client_parse_host(c"10.1.2.3") != 0x0A010203
        return 3
    if client_parse_host(c"256.0.0.1") != 0
        return 4
    if client_parse_host(c"1.2.3") != 0
        return 5
    if client_parse_host(c"example.com") != 0
        return 6
    return 0
