# test/test_client.ritz - Tests for tome.client helpers
#
# AGAST #2457: tome-cli handed tcp_connect 127.0.0.1 already in network
# byte order; tcp_connect byte-swaps again, so it dialled 1.0.0.127 and
# hung in connect().  client_parse_host returns host byte order.

import ritzlib.sys
import ritzlib.io
import ritzlib.str
import lib.client


[[test]]
fn test_client_parse_host_is_host_order() -> i32
    if client_parse_host(c"127.0.0.1") != 0x7F000001
        return 1
    if client_parse_host(c"localhost") != 0x7F000001
        return 2
    if client_parse_host(c"10.1.2.3") != 0x0A010203
        return 3
    if client_parse_host(c"256.0.0.1") != 0
        return 4
    if client_parse_host(c"1.2.3") != 0
        return 5
    if client_parse_host(c"example.com") != 0
        return 6
    return 0


# client_reply_int over all of `text`: the value, or `bad` if the reply
# printer would refuse it. A value it reads must end at the '\r'.
fn reply_int_or(text: *u8, bad: i64) -> i64
    var v: i64 = 0
    let n: i32 = strlen(text) as i32
    let end: i32 = client_reply_int(text, 0, n, @v)
    if end < 0
        return bad
    if *(text + end) != 13
        return bad - 1
    return v


# AGAST #4040: tome-cli's reply printer read an array count and a bulk
# length with no digit or overflow check: i64::MAX + 1 wrapped and "12x"
# read as 12 * 10 + 72. They go through resp_parse_i64 now.
[[test]]
fn test_client_reply_int_range() -> i32
    let min: i64 = -9223372036854775807 - 1
    let max: i64 = 9223372036854775807
    if reply_int_or(c"-9223372036854775808\r\n", 7) != min
        return 1
    if reply_int_or(c"9223372036854775807\r\n", 7) != max
        return 2
    if reply_int_or(c"0\r\n", 7) != 0
        return 3
    if reply_int_or(c"9223372036854775808\r\n", 7) != 7
        return 4
    if reply_int_or(c"18446744073709551621\r\n", 7) != 7  # 2^64 + 5
        return 5
    if reply_int_or(c"12x\r\n", 7) != 7
        return 6
    if reply_int_or(c"+5\r\n", 7) != 7
        return 7
    if reply_int_or(c"\r\n", 7) != 7
        return 8
    # No '\r' in the buffer: the header is incomplete, not a number.
    if reply_int_or(c"12", 7) != 7
        return 9
    return 0
