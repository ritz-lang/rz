# test/test_store.ritz - Tests for the Tome key-value store
#
# Tests basic operations: set, get, del, exists, TTL
#
# Lists/sets, sorted sets/hashes and pub/sub/memory live in
# test_store_list_set.ritz, test_store_zset_hash.ritz and
# test_store_pubsub_memory.ritz: `ritz0 --test` recompiles the file once
# per test, so one 68-test file overran build.py's 180s per-file budget.

import ritzlib.sys
import ritzlib.time { sleep_ms }
import ritzlib.io
import ritzlib.timer
import ritzlib.fmt.digits
import ritzlib.option
import ritzlib.string
import ritzlib.strview
import lib.tome

# Whether `key` holds the string value `want`.
fn holds(store: *Store, key: StrView, want: StrView) -> bool
    match store_get(store, key)
        Some(v) => v.eq(want)
        None => false

# ============================================================================
# Test: Basic set and get
# ============================================================================

[[test]]
fn test_set_get() -> i32
    var store: Store = store_new()

    # Set a value
    store_set(@store, "hello", "world")

    # Get it back
    if not holds(@store, "hello", "world")
        return 1

    return 0

# ============================================================================
# Test: Get returns null for missing key
# ============================================================================

[[test]]
fn test_get_missing() -> i32
    var store: Store = store_new()

    if store_get(@store, "nonexistent").is_some()
        return 1

    return 0

# ============================================================================
# Test: Exists
# ============================================================================

[[test]]
fn test_exists() -> i32
    var store: Store = store_new()

    # Key doesn't exist yet
    if store_exists(@store, "key") != 0
        return 1

    # Set it
    store_set(@store, "key", "value")

    # Now it exists
    if store_exists(@store, "key") != 1
        return 1

    return 0

# ============================================================================
# Test: Delete
# ============================================================================

[[test]]
fn test_del() -> i32
    var store: Store = store_new()

    # Set a value
    store_set(@store, "key", "value")

    # Verify it exists
    if store_exists(@store, "key") != 1
        return 1

    # Delete it
    let deleted: i32 = store_del(@store, "key")
    if deleted != 1
        return 1

    # Verify it's gone
    if store_exists(@store, "key") != 0
        return 1

    # Get should return null
    if store_get(@store, "key").is_some()
        return 1

    return 0

# ============================================================================
# Test: Delete non-existent key
# ============================================================================

[[test]]
fn test_del_missing() -> i32
    var store: Store = store_new()

    let deleted: i32 = store_del(@store, "nonexistent")
    if deleted != 0
        return 1

    return 0

# ============================================================================
# Test: Overwrite existing key
# ============================================================================

[[test]]
fn test_overwrite() -> i32
    var store: Store = store_new()

    # Set initial value
    store_set(@store, "key", "first")
    if not holds(@store, "key", "first")
        return 1

    # Overwrite
    store_set(@store, "key", "second")
    if not holds(@store, "key", "second")
        return 1

    # Length should still be 1
    if store_len(@store) != 1
        return 1

    return 0

# ============================================================================
# Test: Multiple keys
# ============================================================================

[[test]]
fn test_multiple_keys() -> i32
    var store: Store = store_new()

    store_set(@store, "a", "1")
    store_set(@store, "b", "2")
    store_set(@store, "c", "3")

    if store_len(@store) != 3
        return 1

    if not holds(@store, "a", "1")
        return 1
    if not holds(@store, "b", "2")
        return 1
    if not holds(@store, "c", "3")
        return 1

    return 0

# ============================================================================
# Test: Len and is_empty
# ============================================================================

[[test]]
fn test_len_empty() -> i32
    var store: Store = store_new()

    # Initially empty
    if store_len(@store) != 0
        return 1
    if store_is_empty(@store) != 1
        return 1

    # Add one
    store_set(@store, "key", "value")
    if store_len(@store) != 1
        return 1
    if store_is_empty(@store) != 0
        return 1

    # Delete it
    store_del(@store, "key")
    if store_len(@store) != 0
        return 1
    if store_is_empty(@store) != 1
        return 1

    return 0

# ============================================================================
# Test: Stress test - many keys trigger growth
# ============================================================================

[[test]]
fn test_growth() -> i32
    var store: Store = store_new()

    # Insert 20 keys to trigger growth (initial cap is 16, 75% threshold = 12)
    store_set(@store, "key_00", "v")
    store_set(@store, "key_01", "v")
    store_set(@store, "key_02", "v")
    store_set(@store, "key_03", "v")
    store_set(@store, "key_04", "v")
    store_set(@store, "key_05", "v")
    store_set(@store, "key_06", "v")
    store_set(@store, "key_07", "v")
    store_set(@store, "key_08", "v")
    store_set(@store, "key_09", "v")
    store_set(@store, "key_10", "v")
    store_set(@store, "key_11", "v")
    store_set(@store, "key_12", "v")
    store_set(@store, "key_13", "v")
    store_set(@store, "key_14", "v")
    store_set(@store, "key_15", "v")
    store_set(@store, "key_16", "v")
    store_set(@store, "key_17", "v")
    store_set(@store, "key_18", "v")
    store_set(@store, "key_19", "v")

    if store_len(@store) != 20
        return 1

    # Verify keys after multiple growths
    let v0: Option<StrView> = store_get(@store, "key_00")
    let v10: Option<StrView> = store_get(@store, "key_10")
    let v19: Option<StrView> = store_get(@store, "key_19")

    if v0.is_none() || v10.is_none() || v19.is_none()
        return 1

    return 0

# ============================================================================
# Test: SETEX - set with TTL
# ============================================================================

[[test]]
fn test_setex() -> i32
    var store: Store = store_new()

    # Set a key with 10 second TTL
    store_setex(@store, "key", "value", 10)

    # Verify it exists
    if not holds(@store, "key", "value")
        return 1

    # TTL should be positive (close to 10)
    let ttl: i64 = store_ttl(@store, "key")
    if ttl <= 0 || ttl > 10
        return 1

    return 0

# ============================================================================
# Test: TTL returns -1 for key without expiration
# ============================================================================

[[test]]
fn test_ttl_no_expire() -> i32
    var store: Store = store_new()

    # Set without TTL
    store_set(@store, "key", "value")

    # TTL should be -1 (no expiration)
    let ttl: i64 = store_ttl(@store, "key")
    if ttl != -1
        return 1

    return 0

# ============================================================================
# Test: TTL returns -2 for non-existent key
# ============================================================================

[[test]]
fn test_ttl_missing() -> i32
    var store: Store = store_new()

    let ttl: i64 = store_ttl(@store, "nonexistent")
    if ttl != -2
        return 1

    return 0

# ============================================================================
# Test: EXPIRE - set TTL on existing key
# ============================================================================

[[test]]
fn test_expire() -> i32
    var store: Store = store_new()

    # Set without TTL
    store_set(@store, "key", "value")
    if store_ttl(@store, "key") != -1
        return 1

    # Add expiration
    let result: i32 = store_expire(@store, "key", 60)
    if result != 1
        return 1

    # TTL should now be positive
    let ttl: i64 = store_ttl(@store, "key")
    if ttl <= 0 || ttl > 60
        return 1

    return 0

# ============================================================================
# Test: EXPIRE on non-existent key
# ============================================================================

[[test]]
fn test_expire_missing() -> i32
    var store: Store = store_new()

    let result: i32 = store_expire(@store, "nonexistent", 60)
    if result != 0
        return 1

    return 0

# ============================================================================
# Test: PERSIST - remove expiration
# ============================================================================

[[test]]
fn test_persist() -> i32
    var store: Store = store_new()

    # Set with TTL
    store_setex(@store, "key", "value", 60)
    if store_ttl(@store, "key") <= 0
        return 1

    # Remove TTL
    let result: i32 = store_persist(@store, "key")
    if result != 1
        return 1

    # TTL should now be -1
    if store_ttl(@store, "key") != -1
        return 1

    return 0

# ============================================================================
# Test: PERSIST on key without TTL
# ============================================================================

[[test]]
fn test_persist_no_ttl() -> i32
    var store: Store = store_new()

    store_set(@store, "key", "value")

    let result: i32 = store_persist(@store, "key")
    if result != 0
        return 1

    return 0

# ============================================================================
# Test: Lazy expiration - expired key returns null
# ============================================================================

[[test]]
fn test_lazy_expiration() -> i32
    var store: Store = store_new()

    # Set with 1 second TTL
    store_setex(@store, "key", "value", 1)

    # Should exist immediately
    if store_get(@store, "key").is_none()
        return 1

    # Sleep for 2 seconds
    sleep_ms(2000)

    # Now it should be expired
    if store_get(@store, "key").is_some()
        return 1

    # Key should no longer exist
    if store_exists(@store, "key") != 0
        return 1

    # TTL should be -2 (key gone)
    if store_ttl(@store, "key") != -2
        return 1

    return 0

# ============================================================================
# Test: Active expiration sweep
# ============================================================================

[[test]]
fn test_expire_sweep() -> i32
    var store: Store = store_new()

    # Set multiple keys with 1 second TTL
    store_setex(@store, "a", "1", 1)
    store_setex(@store, "b", "2", 1)
    store_setex(@store, "c", "3", 1)
    # This one doesn't expire
    store_set(@store, "d", "4")

    # Should have 4 keys
    if store_len(@store) != 4
        return 1

    # Sleep for 2 seconds
    sleep_ms(2000)

    # Run sweep
    let deleted: i64 = store_expire_sweep(@store)
    if deleted != 3
        return 1

    # Should have 1 key left
    if store_len(@store) != 1
        return 1

    # The non-expiring key should still exist
    if store_get(@store, "d").is_none()
        return 1

    return 0


# ============================================================================
# Test: a resize keeps keys holding a NUL (AGAST #3069)
# ============================================================================
# store_grow used to rehash each key by its C-string prefix, so "k\0a"
# moved to the slot of "k" and a lookup by the full key missed it.

[[test]]
fn test_grow_keeps_keys_with_nul() -> i32
    var store: Store = store_new()
    var key: String = string_from("k\0a")
    for i in 0..8
        key.set_char(2, (97 + i) as u8)
        store_set(@store, key.as_view(), key.as_view())

    # 120 more keys grow the table 16 -> 32 -> 64 -> 128 -> 256.
    var name: [8]u8
    for i in 0..120
        let n: i64 = fmt_i64_into(@name[0], i)
        store_set(@store, strview_from_ptr(@name[0], n), "x")

    for i in 0..8
        key.set_char(2, (97 + i) as u8)
        let sv: StrView = store_get_strview(@store, key.as_view())
        if sv.ptr == null
            return (1 + i) as i32
        if sv.len != 3
            return 20
    return 0
