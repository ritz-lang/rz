# test/test_score.ritz - sorted-set score parsing and formatting (AGAST #4268)
#
# Scores are f64, read the way Redis reads them (strtod over the whole
# argument, refusing NaN, overflow and underflow to zero) and written the way
# Redis 7.2+ writes them (fpconv_dtoa: the shortest digits that round-trip,
# laid out plain or in scientific notation, "inf" / "-inf").
#
# Each value is checked as IEEE-754 bits, so a parse that is one ulp off fails.

import ritzlib.str
import ritzlib.strview
import lib.score

fn sc_bits(x: f64) -> u64
    var v: f64 = x
    let p: *u64 = @v as *u64
    *p

fn sc_from_bits(b: u64) -> f64
    var v: u64 = b
    let p: *f64 = @v as *f64
    *p

# 0 when `text` parses to exactly `want` bits.
fn parses_to(text: *u8, want: u64) -> i32
    var out: f64 = 0.0
    if score_parse(text, strlen(text), @out) != 1
        return 1
    if sc_bits(out) != want
        return 2
    return 0

# 0 when `text` is refused.
fn refused(text: *u8) -> i32
    var out: f64 = 0.0
    if score_parse(text, strlen(text), @out) != 0
        return 1
    return 0

# 0 when the double with bits `b` formats as `want`.
fn formats_as(b: u64, want: *u8) -> i32
    var buf: [40]u8
    let n: i64 = score_format(sc_from_bits(b), @buf[0])
    if n != strlen(want)
        return 1
    if memcmp(@buf[0], want, n) != 0
        return 2
    return 0

# 0 when formatting bits `b` and parsing the text back gives `b` again.
fn round_trips(b: u64) -> i32
    var buf: [40]u8
    let n: i64 = score_format(sc_from_bits(b), @buf[0])
    var out: f64 = 0.0
    if score_parse(@buf[0], n, @out) != 1
        return 1
    if sc_bits(out) != b
        return 2
    return 0


[[test]]
fn test_score_parse_plain() -> i32
    if parses_to(c"0", 0) != 0
        return 1
    if parses_to(c"-0", 0x8000000000000000) != 0
        return 2
    if parses_to(c"1", 0x3FF0000000000000) != 0
        return 3
    if parses_to(c"1.5", 0x3FF8000000000000) != 0
        return 4
    if parses_to(c"-7", 0xC01C000000000000) != 0
        return 5
    if parses_to(c"+2", 0x4000000000000000) != 0
        return 6
    if parses_to(c"0.1", 0x3FB999999999999A) != 0
        return 7
    if parses_to(c".5", 0x3FE0000000000000) != 0
        return 8
    if parses_to(c"1.", 0x3FF0000000000000) != 0
        return 9
    if parses_to(c"1e3", 0x408F400000000000) != 0
        return 10
    if parses_to(c"25E-1", 0x4004000000000000) != 0
        return 11
    if parses_to(c"0e999", 0) != 0
        return 12
    if parses_to(c"000123.4500", 0x405EDCCCCCCCCCCD) != 0
        return 13
    return 0


[[test]]
fn test_score_parse_inf() -> i32
    if parses_to(c"inf", 0x7FF0000000000000) != 0
        return 1
    if parses_to(c"+inf", 0x7FF0000000000000) != 0
        return 2
    if parses_to(c"-inf", 0xFFF0000000000000) != 0
        return 3
    if parses_to(c"INF", 0x7FF0000000000000) != 0
        return 4
    if parses_to(c"-Infinity", 0xFFF0000000000000) != 0
        return 5
    return 0


# Correct rounding where a naive digit-by-digit parse goes wrong.
[[test]]
fn test_score_parse_rounding() -> i32
    # 2^53 + 1 is a tie: it rounds to the even 2^53.
    if parses_to(c"9007199254740993", 0x4340000000000000) != 0
        return 1
    # 2^53 + 3 ties up to 2^53 + 4.
    if parses_to(c"9007199254740995", 0x4340000000000002) != 0
        return 2
    # Just above the tie rounds up.
    if parses_to(c"9007199254740993.0000000000000000000000000000001", 0x4340000000000001) != 0
        return 3
    if parses_to(c"0.30000000000000004", 0x3FD3333333333334) != 0
        return 4
    if parses_to(c"2.2250738585072011e-308", 0x000FFFFFFFFFFFFF) != 0
        return 5
    if parses_to(c"2.2250738585072014e-308", 0x0010000000000000) != 0
        return 6
    if parses_to(c"1.7976931348623157e308", 0x7FEFFFFFFFFFFFFF) != 0
        return 7
    # Below the halfway point to 2^1024: still the largest double.
    if parses_to(c"1.7976931348623158e308", 0x7FEFFFFFFFFFFFFF) != 0
        return 8
    # The smallest subnormal, and something rounding up to it.
    if parses_to(c"4.9406564584124654e-324", 1) != 0
        return 9
    if parses_to(c"3e-324", 1) != 0
        return 10
    if parses_to(c"123456789012345678901234567890", 0x45F8EE90FF6C373E) != 0
        return 11
    if parses_to(c"1e23", 0x44B52D02C7E14AF6) != 0
        return 12
    return 0


# What Redis's string2d refuses: empty, surrounding space, trailing junk,
# NaN, and a value that overflows or underflows to zero.
[[test]]
fn test_score_parse_refused() -> i32
    if refused(c"") != 0
        return 1
    if refused(c" 1") != 0
        return 2
    if refused(c"1 ") != 0
        return 3
    if refused(c"x") != 0
        return 4
    if refused(c"1x") != 0
        return 5
    if refused(c"nan") != 0
        return 6
    if refused(c"-") != 0
        return 7
    if refused(c".") != 0
        return 8
    if refused(c"e5") != 0
        return 9
    if refused(c"1e") != 0
        return 10
    if refused(c"1e+") != 0
        return 11
    if refused(c"1e400") != 0
        return 12
    if refused(c"1.7976931348623159e308") != 0
        return 13
    if refused(c"1e-400") != 0
        return 14
    if refused(c"2e-324") != 0
        return 15
    if refused(c"in") != 0
        return 16
    if refused(c"infx") != 0
        return 17
    if refused(c"1..2") != 0
        return 18
    return 0


# fpconv_dtoa's layouts: plain integers up to ndigits + 7 places, a plain
# fraction while the exponent stays small, scientific otherwise.
[[test]]
fn test_score_format() -> i32
    if formats_as(0x0000000000000000, c"0") != 0
        return 1
    if formats_as(0x8000000000000000, c"-0") != 0
        return 2
    if formats_as(0x3FF8000000000000, c"1.5") != 0
        return 3
    if formats_as(0x3FB999999999999A, c"0.1") != 0
        return 4
    if formats_as(0xC01C000000000000, c"-7") != 0
        return 5
    if formats_as(0x3FD3333333333334, c"0.30000000000000004") != 0
        return 6
    if formats_as(0x416312D000000000, c"10000000") != 0      # 1e7
        return 7
    if formats_as(0x4197D78400000000, c"1e+8") != 0          # 1e8
        return 8
    if formats_as(0x419D6F3454000000, c"123456789") != 0
        return 9
    if formats_as(0x416775DC00000000, c"12300000") != 0      # 123e5
        return 10
    if formats_as(0x3F50624DD2F1A9FC, c"0.001") != 0
        return 11
    if formats_as(0x3EB0C6F7A0B5ED8D, c"0.000001") != 0      # 1e-6
        return 12
    if formats_as(0x3EB92A737110E454, c"1.5e-6") != 0
        return 13
    if formats_as(0x3E7AD7F29ABCAF48, c"1e-7") != 0
        return 14
    if formats_as(0x7E41EB2D66005835, c"1.5e+300") != 0
        return 15
    if formats_as(0x0000000000000001, c"5e-324") != 0
        return 16
    if formats_as(0x7FEFFFFFFFFFFFFF, c"1.7976931348623157e+308") != 0
        return 17
    if formats_as(0x4340000000000000, c"9007199254740992") != 0
        return 18
    if formats_as(0x7FF0000000000000, c"inf") != 0
        return 19
    if formats_as(0xFFF0000000000000, c"-inf") != 0
        return 20
    if formats_as(0x400921F9F01B866E, c"3.14159") != 0
        return 21
    if formats_as(0x44B52D02C7E14AF6, c"1e+23") != 0
        return 22
    if formats_as(0xC0934A456D5CFAAD, c"-1234.5678") != 0
        return 23
    return 0


# Formatting then parsing gives back the same double, across magnitudes,
# subnormals and both signs.
[[test]]
fn test_score_round_trip() -> i32
    var b: u64 = 0x0000000000000001
    var i: i32 = 0
    while i < 300
        # Walk the exponent range with a scrambled mantissa.
        let mant: u64 = (b * 0x9E3779B97F4A7C15) >> 12
        let exp: u64 = ((i as u64) * 7) % 2047
        let bits: u64 = (exp << 52) | mant
        if round_trips(bits) != 0
            return 1
        if round_trips(bits | 0x8000000000000000) != 0
            return 2
        b += 1
        i += 1
    if round_trips(0x000FFFFFFFFFFFFF) != 0
        return 3
    if round_trips(0x0010000000000000) != 0
        return 4
    if round_trips(0x7FEFFFFFFFFFFFFF) != 0
        return 5
    return 0


# ============================================================================
# Range bounds (AGAST #4311): Redis's zslParseRange reads them with raw
# strtod, which also takes "", leading space, hex floats, and gives ±inf on
# overflow and ±0 on underflow.  It stops at a NUL; only trailing junk and
# NaN are refused.
# ============================================================================

fn bound_is(text: *u8, len: i64, want: u64) -> i32
    var out: f64 = 1.0
    if score_parse_bound(text, len, @out) != 1
        return 1
    if sc_bits(out) != want
        return 2
    return 0

fn bound_refused(text: *u8) -> i32
    var out: f64 = 0.0
    if score_parse_bound(text, strlen(text), @out) != 0
        return 1
    return 0

fn bound_to(text: *u8, want: u64) -> i32
    return bound_is(text, strlen(text), want)


[[test]]
fn test_score_bound_lenient() -> i32
    if bound_to(c"", 0) != 0
        return 1
    if bound_to(c"1.5", 0x3FF8000000000000) != 0
        return 2
    if bound_to(c" \t\n\x0b\x0c\r2", 0x4000000000000000) != 0
        return 3
    if bound_to(c"1e400", 0x7FF0000000000000) != 0
        return 4
    if bound_to(c"-1e400", 0xFFF0000000000000) != 0
        return 5
    if bound_to(c"1.7976931348623159e308", 0x7FF0000000000000) != 0
        return 6
    if bound_to(c"1e-400", 0) != 0
        return 7
    if bound_to(c"-2e-324", 0x8000000000000000) != 0
        return 8
    # Hex floats: digits, a fraction, a binary exponent, any case.
    if bound_to(c"0x10", 0x4030000000000000) != 0
        return 9
    if bound_to(c"-0X1.8P1", 0xC008000000000000) != 0
        return 10
    if bound_to(c"0x.8", 0x3FE0000000000000) != 0
        return 11
    if bound_to(c"0x1p-1074", 0x0000000000000001) != 0
        return 12
    if bound_to(c"0x1p-1076", 0) != 0
        return 13
    if bound_to(c"0x1p1024", 0x7FF0000000000000) != 0
        return 14
    if bound_to(c"0x1fffffffffffff", 0x433FFFFFFFFFFFFF) != 0
        return 15
    # 2^53 + 1 rounds to even (2^53); a sticky bit past it rounds up.
    if bound_to(c"0x20000000000001", 0x4340000000000000) != 0
        return 16
    if bound_to(c"0x20000000000001000000000000000000001", 0x4880000000000001) != 0
        return 17
    if bound_to(c"0x1.fffffffffffff8p1023", 0x7FF0000000000000) != 0
        return 18
    if bound_to(c"0xffP-4", 0x402FE00000000000) != 0
        return 19
    # strtod stops at a NUL.
    if bound_is(c"3\0x", 3, 0x4008000000000000) != 0
        return 20
    if bound_to(c"inf", 0x7FF0000000000000) != 0
        return 21
    return 0


[[test]]
fn test_score_bound_refused() -> i32
    if bound_refused(c" ") != 0
        return 1
    if bound_refused(c"1 ") != 0
        return 2
    if bound_refused(c"nan") != 0
        return 3
    if bound_refused(c"-") != 0
        return 4
    if bound_refused(c"0x") != 0
        return 5
    if bound_refused(c"0xg") != 0
        return 6
    if bound_refused(c"0x1p") != 0
        return 7
    if bound_refused(c"1e") != 0
        return 8
    if bound_refused(c"x") != 0
        return 9
    if bound_refused(c"0x.") != 0
        return 10
    return 0
