# test/test_server_auth.ritz - Tests for server-level authentication
#
# Tests that authentication state is tracked per-connection and
# that requirepass configuration works correctly.

import ritzlib.sys
import ritzlib.io
import ritzlib.option
import ritzlib.string
import ritzlib.strview
import ritzlib.memory
import lib.tome
import lib.resp
import lib.commands
import lib.server


# Whether the `len`-byte reply at `buf` is exactly `want`.
fn written(buf: *u8, len: i32, want: StrView) -> bool
    return len >= 0 and strview_from_ptr(buf, len as i64).eq(want)


# ============================================================================
# Connection State Tests
# ============================================================================

[[test]]
fn test_conn_state_init() -> i32
    var state: ConnectionState
    conn_state_init(@state)

    # Should start unauthenticated
    if state.is_authenticated != 0
        return 1

    return 0


[[test]]
fn test_conn_state_authenticate() -> i32
    var state: ConnectionState
    conn_state_init(@state)

    # Mark as authenticated
    state.is_authenticated = 1

    if state.is_authenticated != 1
        return 1

    return 0


# ============================================================================
# Server Config Tests
# ============================================================================

[[test]]
fn test_server_no_password_allows_all() -> i32
    # When password is null, all commands should work
    var store: Store = store_new()
    var buf: [8192]u8

    var ctx: CommandContext
    cmd_ctx_init_auth(@ctx, @store, @buf[0], 8192, None, 0)

    # Parse and execute PING
    var parser: RespParser
    resp_parser_init(@parser, "*1\r\n$4\r\nPING\r\n")
    let parse_result: i32 = resp_parse(@parser)
    if parse_result != RESP_OK
        return 1

    cmd_dispatch(@ctx, @parser.command)
    # Should return PONG (not NOAUTH error)
    if not written(@buf[0], ctx.resp_len, "+PONG\r\n")
        return 2

    return 0


[[test]]
fn test_server_password_blocks_before_auth() -> i32
    var store: Store = store_new()
    var buf: [8192]u8

    # Password set, not authenticated
    var ctx: CommandContext
    cmd_ctx_init_auth(@ctx, @store, @buf[0], 8192, Some("secret123"), 0)

    # Parse and execute PING
    var parser: RespParser
    resp_parser_init(@parser, "*1\r\n$4\r\nPING\r\n")
    let parse_result: i32 = resp_parse(@parser)
    if parse_result != RESP_OK
        return 1

    cmd_dispatch(@ctx, @parser.command)
    # Should return error (starts with -)
    if buf[0] != 45  # '-'
        return 2

    return 0


[[test]]
fn test_server_password_allows_after_auth() -> i32
    var store: Store = store_new()
    var buf: [8192]u8

    # Password set, IS authenticated
    var ctx: CommandContext
    cmd_ctx_init_auth(@ctx, @store, @buf[0], 8192, Some("secret123"), 1)

    # Parse and execute PING
    var parser: RespParser
    resp_parser_init(@parser, "*1\r\n$4\r\nPING\r\n")
    let parse_result: i32 = resp_parse(@parser)
    if parse_result != RESP_OK
        return 1

    cmd_dispatch(@ctx, @parser.command)
    # Should return PONG
    if not written(@buf[0], ctx.resp_len, "+PONG\r\n")
        return 2

    return 0


# ============================================================================
# Auth Command Flow Tests
# ============================================================================

[[test]]
fn test_auth_sets_flag() -> i32
    var store: Store = store_new()
    var buf: [8192]u8

    # Password set, not authenticated
    var ctx: CommandContext
    cmd_ctx_init_auth(@ctx, @store, @buf[0], 8192, Some("secret123"), 0)

    # Verify initially not authenticated
    if ctx.is_authenticated != 0
        return 1

    # Execute AUTH with correct password
    var parser: RespParser
    resp_parser_init(@parser, "*2\r\n$4\r\nAUTH\r\n$9\r\nsecret123\r\n")
    let parse_result: i32 = resp_parse(@parser)
    if parse_result != RESP_OK
        return 2

    cmd_dispatch(@ctx, @parser.command)
    # Should return OK
    if not written(@buf[0], ctx.resp_len, "+OK\r\n")
        return 3

    # Flag should now be set
    if ctx.is_authenticated != 1
        return 4

    return 0



# ============================================================================
# AUTH compares the whole argument (AGAST #1863)
# ============================================================================
# AUTH used to copy the argument into a 256-byte NUL-terminated buffer and
# strcmp it: an embedded NUL or a suffix past byte 255 was ignored. It now
# compares (data, len) against the password in constant time.

fn auth_with(password: StrView, request: StrView) -> i32
    var store: Store = store_new()
    var buf: [8192]u8
    var ctx: CommandContext
    cmd_ctx_init_auth(@ctx, @store, @buf[0], 8192, Some(password), 0)
    var parser: RespParser
    resp_parser_init(@parser, request)
    if resp_parse(@parser) != RESP_OK
        return -1
    cmd_dispatch(@ctx, @parser.command)
    return ctx.is_authenticated

[[test]]
fn test_auth_rejects_embedded_nul_suffix() -> i32
    # "secret123\0x" must not authenticate as "secret123".
    if auth_with("secret123", "*2\r\n$4\r\nAUTH\r\n$11\r\nsecret123\0x\r\n") != 0
        return 1
    return 0

[[test]]
fn test_auth_rejects_wrong_password() -> i32
    if auth_with("secret123", "*2\r\n$4\r\nAUTH\r\n$9\r\nsecret124\r\n") != 0
        return 1
    return 0

[[test]]
fn test_auth_rejects_prefix() -> i32
    if auth_with("secret123", "*2\r\n$4\r\nAUTH\r\n$6\r\nsecret\r\n") != 0
        return 1
    return 0

[[test]]
fn test_auth_rejects_suffix_past_copy_buffer() -> i32
    # A 255-byte password followed by extra bytes: the old 256-byte copy
    # truncated the argument back to the password and accepted it.
    var pw: String = string_new()
    for i in 0..255
        pw.push(0x61)  # 'a'
    var req: String = string_from("*2\r\n$4\r\nAUTH\r\n$258\r\n")
    for i in 0..258
        req.push(0x61)
    req.push_str("\r\n")
    if auth_with(pw.as_view(), req.as_view()) != 0
        return 1
    return 0

[[test]]
fn test_auth_accepts_long_exact_password() -> i32
    var pw: String = string_new()
    for i in 0..255
        pw.push(0x61)  # 'a'
    var req: String = string_from("*2\r\n$4\r\nAUTH\r\n$255\r\n")
    for i in 0..255
        req.push(0x61)
    req.push_str("\r\n")
    if auth_with(pw.as_view(), req.as_view()) != 1
        return 1
    return 0

[[test]]
fn test_empty_password_is_required() -> i32
    # Some(""): AUTH is required, and only the empty argument satisfies it.
    if auth_with("", "*2\r\n$4\r\nAUTH\r\n$0\r\n\r\n") != 1
        return 1
    if auth_with("", "*2\r\n$4\r\nAUTH\r\n$1\r\nx\r\n") != 0
        return 2
    return 0
