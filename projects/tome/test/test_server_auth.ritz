# test/test_server_auth.ritz - Tests for server-level authentication
#
# Tests that authentication state is tracked per-connection and
# that requirepass configuration works correctly.

import ritzlib.sys
import ritzlib.io
import ritzlib.str
import ritzlib.memory
import lib.tome
import lib.resp
import lib.commands
import lib.server


# ============================================================================
# Connection State Tests
# ============================================================================

[[test]]
fn test_conn_state_init() -> i32
    var state: ConnectionState
    conn_state_init(@state)

    # Should start unauthenticated
    if state.is_authenticated != 0
        return 1

    return 0


[[test]]
fn test_conn_state_authenticate() -> i32
    var state: ConnectionState
    conn_state_init(@state)

    # Mark as authenticated
    state.is_authenticated = 1

    if state.is_authenticated != 1
        return 1

    return 0


# ============================================================================
# Server Config Tests
# ============================================================================

[[test]]
fn test_server_no_password_allows_all() -> i32
    # When password is null, all commands should work
    var store: Store = store_new()
    var buf: [8192]u8

    var ctx: CommandContext
    cmd_ctx_init_auth(@ctx, @store, @buf[0], 8192, null, 0)

    # Parse and execute PING
    var parser: RespParser
    resp_parser_init(@parser, c"*1\r\n$4\r\nPING\r\n", 14)
    let parse_result: i32 = resp_parse(@parser)
    if parse_result != RESP_OK
        return 1

    cmd_dispatch(@ctx, @parser.command)
    buf[ctx.resp_len] = 0

    # Should return PONG (not NOAUTH error)
    if strcmp(@buf[0], c"+PONG\r\n") != 0
        return 2

    return 0


[[test]]
fn test_server_password_blocks_before_auth() -> i32
    var store: Store = store_new()
    var buf: [8192]u8

    # Password set, not authenticated
    var ctx: CommandContext
    cmd_ctx_init_auth(@ctx, @store, @buf[0], 8192, c"secret123", 0)

    # Parse and execute PING
    var parser: RespParser
    resp_parser_init(@parser, c"*1\r\n$4\r\nPING\r\n", 14)
    let parse_result: i32 = resp_parse(@parser)
    if parse_result != RESP_OK
        return 1

    cmd_dispatch(@ctx, @parser.command)
    buf[ctx.resp_len] = 0

    # Should return error (starts with -)
    if buf[0] != 45  # '-'
        return 2

    return 0


[[test]]
fn test_server_password_allows_after_auth() -> i32
    var store: Store = store_new()
    var buf: [8192]u8

    # Password set, IS authenticated
    var ctx: CommandContext
    cmd_ctx_init_auth(@ctx, @store, @buf[0], 8192, c"secret123", 1)

    # Parse and execute PING
    var parser: RespParser
    resp_parser_init(@parser, c"*1\r\n$4\r\nPING\r\n", 14)
    let parse_result: i32 = resp_parse(@parser)
    if parse_result != RESP_OK
        return 1

    cmd_dispatch(@ctx, @parser.command)
    buf[ctx.resp_len] = 0

    # Should return PONG
    if strcmp(@buf[0], c"+PONG\r\n") != 0
        return 2

    return 0


# ============================================================================
# Auth Command Flow Tests
# ============================================================================

[[test]]
fn test_auth_sets_flag() -> i32
    var store: Store = store_new()
    var buf: [8192]u8

    # Password set, not authenticated
    var ctx: CommandContext
    cmd_ctx_init_auth(@ctx, @store, @buf[0], 8192, c"secret123", 0)

    # Verify initially not authenticated
    if ctx.is_authenticated != 0
        return 1

    # Execute AUTH with correct password
    var parser: RespParser
    resp_parser_init(@parser, c"*2\r\n$4\r\nAUTH\r\n$9\r\nsecret123\r\n", 32)
    let parse_result: i32 = resp_parse(@parser)
    if parse_result != RESP_OK
        return 2

    cmd_dispatch(@ctx, @parser.command)
    buf[ctx.resp_len] = 0

    # Should return OK
    if strcmp(@buf[0], c"+OK\r\n") != 0
        return 3

    # Flag should now be set
    if ctx.is_authenticated != 1
        return 4

    return 0



# ============================================================================
# AUTH compares the whole argument (AGAST #1863)
# ============================================================================
# AUTH used to copy the argument into a 256-byte NUL-terminated buffer and
# strcmp it: an embedded NUL or a suffix past byte 255 was ignored. It now
# compares (data, len) against the password in constant time.

fn auth_with(password: *u8, request: *u8, request_len: i64) -> i32
    var store: Store = store_new()
    var buf: [8192]u8
    var ctx: CommandContext
    cmd_ctx_init_auth(@ctx, @store, @buf[0], 8192, password, 0)
    var parser: RespParser
    resp_parser_init(@parser, request, request_len)
    if resp_parse(@parser) != RESP_OK
        return -1
    cmd_dispatch(@ctx, @parser.command)
    return ctx.is_authenticated

[[test]]
fn test_auth_rejects_embedded_nul_suffix() -> i32
    # "secret123\0x" must not authenticate as "secret123".
    if auth_with(c"secret123", c"*2\r\n$4\r\nAUTH\r\n$11\r\nsecret123\0x\r\n", 32) != 0
        return 1
    return 0

[[test]]
fn test_auth_rejects_wrong_password() -> i32
    if auth_with(c"secret123", c"*2\r\n$4\r\nAUTH\r\n$9\r\nsecret124\r\n", 29) != 0
        return 1
    return 0

[[test]]
fn test_auth_rejects_prefix() -> i32
    if auth_with(c"secret123", c"*2\r\n$4\r\nAUTH\r\n$6\r\nsecret\r\n", 26) != 0
        return 1
    return 0

[[test]]
fn test_auth_rejects_suffix_past_copy_buffer() -> i32
    # A 255-byte password followed by extra bytes: the old 256-byte copy
    # truncated the argument back to the password and accepted it.
    var pw: [256]u8
    for i in 0..255
        pw[i] = 0x61  # 'a'
    pw[255] = 0
    var req: [300]u8
    var p: i64 = 0
    let head: *u8 = c"*2\r\n$4\r\nAUTH\r\n$258\r\n"
    for i in 0..20
        req[p] = *(head + i)
        p += 1
    for i in 0..258
        req[p] = 0x61
        p += 1
    req[p] = 13
    req[p + 1] = 10
    p += 2
    if auth_with(@pw[0], @req[0], p) != 0
        return 1
    return 0

[[test]]
fn test_auth_accepts_long_exact_password() -> i32
    var pw: [256]u8
    for i in 0..255
        pw[i] = 0x61
    pw[255] = 0
    var req: [300]u8
    var p: i64 = 0
    let head: *u8 = c"*2\r\n$4\r\nAUTH\r\n$255\r\n"
    for i in 0..20
        req[p] = *(head + i)
        p += 1
    for i in 0..255
        req[p] = 0x61
        p += 1
    req[p] = 13
    req[p + 1] = 10
    p += 2
    if auth_with(@pw[0], @req[0], p) != 1
        return 1
    return 0
