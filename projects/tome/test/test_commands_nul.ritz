# test/test_commands_nul.ritz - Collection members, fields and values hold any byte
#
# AGAST #4210: after #3069 the args reach the store whole, but the Hash,
# Set and ZSet inner tables were keyed by C strings and the collection
# replies (HGET, LINDEX, LRANGE, SMEMBERS, HKEYS, HVALS, HGETALL) were
# measured with strlen, so an embedded NUL still cut a member, field or
# value short ("m\0a" and "m\0b" were one set member).  Redis is
# binary-safe here too.
#
# Kept apart from test_commands_binary.ritz: `ritz0 --test` recompiles a
# file once per test, and build.py gives each file a fixed budget.

import ritzlib.sys
import ritzlib.io
import ritzlib.string
import ritzlib.strview
import ritzlib.memory
import lib.tome
import lib.resp
import lib.commands


# ============================================================================
# RESP frame builder (as in test_commands_binary.ritz)
# ============================================================================

const REQ_CAP: i64 = 4096

struct Req
    buf: String

fn req_new() -> Req
    return Req { buf: string_new() }

# `tag` then the decimal `n` then CRLF: "*3\r\n", "$300\r\n".
fn req_put_num(r: *Req, tag: u8, n: i64)
    (r.buf).push(tag)
    (r.buf).push_i64(n)
    (r.buf).push_str("\r\n")

fn req_bulk(r: *Req, v: StrView)
    req_put_num(r, 36, v.len)  # '$'
    (r.buf).push_str(v)
    (r.buf).push_str("\r\n")

# Start a fresh frame of `argc` args (the command name included).
fn req_cmd(r: *Req, argc: i64, name: StrView)
    (r.buf).clear()
    req_put_num(r, 42, argc)  # '*'
    req_bulk(r, name)

fn req1(r: *Req, name: StrView, a: StrView)
    req_cmd(r, 2, name)
    req_bulk(r, a)

fn req2(r: *Req, name: StrView, a: StrView, b: StrView)
    req_cmd(r, 3, name)
    req_bulk(r, a)
    req_bulk(r, b)

fn req3(r: *Req, name: StrView, a: StrView, b: StrView, c: StrView)
    req_cmd(r, 4, name)
    req_bulk(r, a)
    req_bulk(r, b)
    req_bulk(r, c)

# Run the frame in `r`; 0 when the reply is exactly `want`.
fn reply_is(store: *Store, r: *Req, want: StrView) -> i32
    var parser: RespParser
    resp_parser_init(@parser, (r.buf).as_view())
    if resp_parse(@parser) != RESP_OK
        return 1
    let out: *u8 = malloc(REQ_CAP)
    var ctx: CommandContext
    cmd_ctx_init(@ctx, store, out, REQ_CAP as i32)
    cmd_dispatch(@ctx, @parser.command)
    var rc: i32 = 0
    if not strview_from_ptr(out, ctx.resp_len as i64).eq(want)
        rc = 1
    free(out)
    return rc

# 0 when the reply is the bulk string `v`.
fn reply_is_bulk(store: *Store, r: *Req, v: StrView) -> i32
    var w: Req = req_new()
    req_bulk(@w, v)
    return reply_is(store, r, (w.buf).as_view())

# 0 when the reply is the bytes built in `w`.
fn reply_is_req(store: *Store, r: *Req, w: *Req) -> i32
    return reply_is(store, r, (w.buf).as_view())


# ============================================================================
# Sets
# ============================================================================

[[test]]
fn test_set_members_with_nul() -> i32
    var store: Store = store_new()
    var r: Req = req_new()
    req2(@r, "SADD", "s", "m\0a")
    if reply_is(@store, @r, ":1\r\n") != 0
        return 1
    # "m\0b" is a different member, not a duplicate of "m".
    req2(@r, "SADD", "s", "m\0b")
    if reply_is(@store, @r, ":1\r\n") != 0
        return 2
    req1(@r, "SCARD", "s")
    if reply_is(@store, @r, ":2\r\n") != 0
        return 3
    req2(@r, "SISMEMBER", "s", "m")
    if reply_is(@store, @r, ":0\r\n") != 0
        return 4
    req2(@r, "SREM", "s", "m\0b")
    if reply_is(@store, @r, ":1\r\n") != 0
        return 5
    req2(@r, "SISMEMBER", "s", "m\0a")
    if reply_is(@store, @r, ":1\r\n") != 0
        return 6
    var want: Req = req_new()
    req_put_num(@want, 42, 1)
    req_bulk(@want, "m\0a")
    req1(@r, "SMEMBERS", "s")
    if reply_is_req(@store, @r, @want) != 0
        return 7
    return 0


[[test]]
fn test_set_algebra_with_nul() -> i32
    var store: Store = store_new()
    let k1: StrView = "a"
    let k2: StrView = "b"
    store_sadd(@store, k1, "m\0a")
    store_sadd(@store, k1, "m\0b")
    store_sadd(@store, k2, "m\0b")
    store_sadd(@store, k2, "m\0c")
    let u: *Set = store_sunion(@store, k1, k2)
    if set_len(u) != 3
        return 1
    let i: *Set = store_sinter(@store, k1, k2)
    if set_len(i) != 1
        return 2
    if set_contains(i, "m\0b") != 1
        return 3
    let d: *Set = store_sdiff(@store, k1, k2)
    if set_len(d) != 1
        return 4
    if set_contains(d, "m\0a") != 1
        return 5
    set_drop(u)
    set_drop(i)
    set_drop(d)
    return 0


# ============================================================================
# Hashes
# ============================================================================

[[test]]
fn test_hash_fields_values_with_nul() -> i32
    var store: Store = store_new()
    var r: Req = req_new()
    req3(@r, "HSET", "h", "f\0a", "v\0x")
    if reply_is(@store, @r, ":1\r\n") != 0
        return 1
    # "f\0b" is a different field, not an update of "f".
    req3(@r, "HSET", "h", "f\0b", "two")
    if reply_is(@store, @r, ":1\r\n") != 0
        return 2
    req2(@r, "HGET", "h", "f\0a")
    if reply_is_bulk(@store, @r, "v\0x") != 0
        return 3
    req2(@r, "HGET", "h", "f\0b")
    if reply_is(@store, @r, "$3\r\ntwo\r\n") != 0
        return 4
    req2(@r, "HEXISTS", "h", "f")
    if reply_is(@store, @r, ":0\r\n") != 0
        return 5
    req2(@r, "HGET", "h", "f")
    if reply_is(@store, @r, "$-1\r\n") != 0
        return 6
    req2(@r, "HDEL", "h", "f\0b")
    if reply_is(@store, @r, ":1\r\n") != 0
        return 7
    req2(@r, "HEXISTS", "h", "f\0a")
    if reply_is(@store, @r, ":1\r\n") != 0
        return 8
    # An empty value is a value, not a miss.
    req3(@r, "HSET", "e", "f", "")
    if reply_is(@store, @r, ":1\r\n") != 0
        return 13
    req2(@r, "HGET", "e", "f")
    if reply_is(@store, @r, "$0\r\n\r\n") != 0
        return 14
    # h is now {"f\0a": "v\0x"}.
    var want: Req = req_new()
    req_put_num(@want, 42, 1)
    req_bulk(@want, "f\0a")
    req1(@r, "HKEYS", "h")
    if reply_is_req(@store, @r, @want) != 0
        return 9
    (want.buf).clear()
    req_put_num(@want, 42, 1)
    req_bulk(@want, "v\0x")
    req1(@r, "HVALS", "h")
    if reply_is_req(@store, @r, @want) != 0
        return 10
    (want.buf).clear()
    req_put_num(@want, 42, 2)
    req_bulk(@want, "f\0a")
    req_bulk(@want, "v\0x")
    req1(@r, "HGETALL", "h")
    if reply_is_req(@store, @r, @want) != 0
        return 11
    return 0


[[test]]
fn test_hash_grows_with_nul_fields() -> i32
    # Past the initial capacity, so the table rehashes NUL-bearing fields.
    var store: Store = store_new()
    let k: StrView = "h"
    var f: String = string_from("f\0A")
    for i in 0..40
        f.set_char(2, (65 + i) as u8)
        if store_hset(@store, k, f.as_view(), f.as_view()) != 1
            return 1
    if store_hlen(@store, k) != 40
        return 2
    for i in 0..40
        f.set_char(2, (65 + i) as u8)
        let v: StrView = store_hget(@store, k, f.as_view())
        if v.ptr == null
            return 3
        if not v.eq(f.as_view())
            return 4
    return 0


# ============================================================================
# Lists
# ============================================================================

[[test]]
fn test_list_replies_with_nul() -> i32
    var store: Store = store_new()
    var r: Req = req_new()
    req2(@r, "RPUSH", "l", "a\0b")
    if reply_is(@store, @r, ":1\r\n") != 0
        return 1
    req2(@r, "RPUSH", "l", "c\0d")
    if reply_is(@store, @r, ":2\r\n") != 0
        return 2
    req2(@r, "LINDEX", "l", "1")
    if reply_is_bulk(@store, @r, "c\0d") != 0
        return 3
    var want: Req = req_new()
    req_put_num(@want, 42, 2)
    req_bulk(@want, "a\0b")
    req_bulk(@want, "c\0d")
    req3(@r, "LRANGE", "l", "0", "-1")
    if reply_is_req(@store, @r, @want) != 0
        return 4
    return 0


# ============================================================================
# Sorted sets (no ZSet dispatch yet, #3070: drive the store directly)
# ============================================================================

[[test]]
fn test_zset_members_with_nul() -> i32
    var store: Store = store_new()
    let k: StrView = "z"
    if store_zadd(@store, k, 2, "m\0b") != 1
        return 1
    if store_zadd(@store, k, 1, "m\0a") != 1
        return 2
    # Equal scores order by the whole member: "m\0a" < "m\0c".
    if store_zadd(@store, k, 1, "m\0c") != 1
        return 3
    if store_zcard(@store, k) != 3
        return 4
    var score: f64 = 0.0
    if store_zscore(@store, k, "m", @&score) != 0
        return 5
    if store_zscore(@store, k, "m\0b", @&score) != 1
        return 6
    if score != 2.0
        return 7
    if store_zrank(@store, k, "m\0c") != 1
        return 8
    var count: i64 = 0
    let all: *StrView = store_zrange(@store, k, 0, -1, @&count)
    if count != 3
        return 9
    if not (all[0]).eq("m\0a")
        return 10
    if not (all[1]).eq("m\0c")
        return 11
    if not (all[2]).eq("m\0b")
        return 12
    free(all as *u8)
    if store_zrem(@store, k, "m\0c") != 1
        return 13
    if store_zcard(@store, k) != 2
        return 14
    let rev: *StrView = store_zrevrange(@store, k, 0, 0, @&count)
    if count != 1
        return 15
    if not (rev[0]).eq("m\0b")
        return 16
    free(rev as *u8)
    return 0
