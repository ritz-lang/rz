# ============================================================================
# AUTH Command Tests
# ============================================================================

# Helper to execute a command with authentication context
fn exec_cmd_auth(store: *Store, input: *u8, resp_buf: *u8, password: *u8, is_authenticated: i32) -> i32
    let len: i64 = strlen(input)
    var parser: RespParser
    resp_parser_init(@parser, input, len)

    let parse_result: i32 = resp_parse(@parser)
    if parse_result != RESP_OK
        return -1

    var ctx: CommandContext
    cmd_ctx_init_auth(@ctx, store, resp_buf, 8192, password, is_authenticated)

    let result: i32 = cmd_dispatch(@ctx, @parser.command)
    return ctx.resp_len


[[test]]
fn test_auth_correct_password() -> i32
    # Test: AUTH with correct password returns OK
    var store: Store = store_new()
    var buf: [8192]u8

    # AUTH with correct password "secret123"
    let len: i32 = exec_cmd_auth(@store, c"*2\r\n$4\r\nAUTH\r\n$9\r\nsecret123\r\n", @buf[0], c"secret123", 0)
    if len <= 0
        return 1

    buf[len] = 0
    if strcmp(@buf[0], c"+OK\r\n") != 0
        return 2

    return 0


[[test]]
fn test_auth_wrong_password() -> i32
    # Test: AUTH with wrong password returns error
    var store: Store = store_new()
    var buf: [8192]u8

    # AUTH with wrong password
    let len: i32 = exec_cmd_auth(@store, c"*2\r\n$4\r\nAUTH\r\n$5\r\nwrong\r\n", @buf[0], c"secret123", 0)
    if len <= 0
        return 1

    buf[len] = 0
    # Should return error (starts with -)
    if buf[0] != 45  # '-'
        return 2

    return 0


[[test]]
fn test_auth_no_password_required() -> i32
    # Test: AUTH when no password is set returns error
    var store: Store = store_new()
    var buf: [8192]u8

    # AUTH when no password required (password is null)
    let len: i32 = exec_cmd_auth(@store, c"*2\r\n$4\r\nAUTH\r\n$3\r\nfoo\r\n", @buf[0], null, 0)
    if len <= 0
        return 1

    buf[len] = 0
    # Should return error (no password set)
    if buf[0] != 45  # '-'
        return 2

    return 0


[[test]]
fn test_noauth_blocks_commands() -> i32
    # Test: Commands blocked when authentication required but not done
    var store: Store = store_new()
    var buf: [8192]u8

    # SET when not authenticated (password required)
    let len: i32 = exec_cmd_auth(@store, c"*3\r\n$3\r\nSET\r\n$3\r\nfoo\r\n$3\r\nbar\r\n", @buf[0], c"secret123", 0)
    if len <= 0
        return 1

    buf[len] = 0
    # Should return NOAUTH error (starts with -)
    if buf[0] != 45  # '-'
        return 2

    return 0


[[test]]
fn test_auth_allows_commands() -> i32
    # Test: Commands allowed after authentication
    var store: Store = store_new()
    var buf: [8192]u8

    # SET when authenticated
    let len: i32 = exec_cmd_auth(@store, c"*3\r\n$3\r\nSET\r\n$3\r\nfoo\r\n$3\r\nbar\r\n", @buf[0], c"secret123", 1)
    if len <= 0
        return 1

    buf[len] = 0
    if strcmp(@buf[0], c"+OK\r\n") != 0
        return 2

    return 0


# ============================================================================
# INCR / DECR / INCRBY / DECRBY (AGAST #2457)
# ============================================================================

# Run `input` and compare the whole reply with `want`.  0 on match.
fn reply_is(store: *Store, input: *u8, want: *u8) -> i32
    var buf: [8192]u8
    let len: i32 = exec_cmd(store, input, @buf[0])
    if len <= 0
        return 1
    buf[len] = 0
    if strcmp(@buf[0], want) != 0
        return 1
    return 0


[[test]]
fn test_cmd_incr_decr_count() -> i32
    var store: Store = store_new()
    # A missing key counts from 0; the value is stored as its decimal string.
    if reply_is(@store, c"INCR n\r\n", c":1\r\n") != 0
        return 1
    if reply_is(@store, c"INCR n\r\n", c":2\r\n") != 0
        return 2
    if reply_is(@store, c"DECR n\r\n", c":1\r\n") != 0
        return 3
    if reply_is(@store, c"INCRBY n 10\r\n", c":11\r\n") != 0
        return 4
    if reply_is(@store, c"DECRBY n 20\r\n", c":-9\r\n") != 0
        return 5
    if reply_is(@store, c"GET n\r\n", c"$2\r\n-9\r\n") != 0
        return 6
    # A SET string that is an integer counts on from its value.
    if reply_is(@store, c"SET m -5\r\n", c"+OK\r\n") != 0
        return 7
    if reply_is(@store, c"INCR m\r\n", c":-4\r\n") != 0
        return 8
    return 0


[[test]]
fn test_cmd_incr_rejects() -> i32
    var store: Store = store_new()
    let not_int: *u8 = c"-ERR value is not an integer or out of range\r\n"
    store_set_cstr(@store, c"s", c"abc")
    if reply_is(@store, c"INCR s\r\n", not_int) != 0
        return 1
    store_set_cstr(@store, c"e", c"")
    if reply_is(@store, c"INCR e\r\n", not_int) != 0
        return 2
    # 2^63 does not fit an i64.
    store_set_cstr(@store, c"big", c"9223372036854775808")
    if reply_is(@store, c"INCR big\r\n", not_int) != 0
        return 3
    if reply_is(@store, c"INCRBY s2 x\r\n", not_int) != 0
        return 4
    store_set_cstr(@store, c"max", c"9223372036854775807")
    if reply_is(@store, c"INCR max\r\n", c"-ERR increment or decrement would overflow\r\n") != 0
        return 5
    store_set_cstr(@store, c"min", c"-9223372036854775808")
    if reply_is(@store, c"DECR min\r\n", c"-ERR increment or decrement would overflow\r\n") != 0
        return 6
    # A failed INCR leaves the value alone.
    if reply_is(@store, c"GET max\r\n", c"$19\r\n9223372036854775807\r\n") != 0
        return 7
    if reply_is(@store, c"LPUSH l a\r\n", c":1\r\n") != 0
        return 8
    if reply_is(@store, c"INCR l\r\n", c"-WRONGTYPE Operation against a key holding the wrong kind of value\r\n") != 0
        return 9
    if reply_is(@store, c"INCR\r\n", c"-ERR wrong number of arguments for 'incr' command\r\n") != 0
        return 10
    return 0


# ============================================================================
# Replies stay inside resp_cap (AGAST #3068)
# ============================================================================
# A 64-byte cap inside a 128-byte buffer: every byte past the cap is a
# canary that a reply overrunning resp_cap would clobber.

const SMALL_CAP: i32 = 64
const TOO_LARGE: *u8 = c"-ERR reply too large\r\n"

fn exec_capped(store: *Store, input: *u8, buf: *u8) -> i32
    memset(buf, 33, 128)  # '!'
    var parser: RespParser
    resp_parser_init(@parser, input, strlen(input))
    if resp_parse(@parser) != RESP_OK
        return 1
    var ctx: CommandContext
    cmd_ctx_init(@ctx, store, buf, SMALL_CAP)
    cmd_dispatch(@ctx, @parser.command)
    for i in SMALL_CAP..128
        if *(buf + i) != 33
            return 2  # wrote past resp_cap
    if ctx.resp_len != strlen(TOO_LARGE) as i32
        return 3
    if memcmp(buf, TOO_LARGE, strlen(TOO_LARGE)) != 0
        return 4
    return 0


[[test]]
fn test_cmd_collection_reply_respects_cap() -> i32
    var store: Store = store_new()
    var name: [4]u8
    name[0] = 109  # 'm'
    name[2] = 0
    for i in 0..20
        name[1] = (97 + i) as u8
        store_sadd_cstr(@store, c"s", @name[0])
        store_rpush_cstr(@store, c"l", @name[0])
        store_hset_cstr(@store, c"h", @name[0], @name[0])
    var buf: [128]u8
    if exec_capped(@store, c"SMEMBERS s\r\n", @buf[0]) != 0
        return 1
    if exec_capped(@store, c"LRANGE l 0 -1\r\n", @buf[0]) != 0
        return 2
    if exec_capped(@store, c"HKEYS h\r\n", @buf[0]) != 0
        return 3
    if exec_capped(@store, c"HVALS h\r\n", @buf[0]) != 0
        return 4
    if exec_capped(@store, c"HGETALL h\r\n", @buf[0]) != 0
        return 5
    return 0


[[test]]
fn test_cmd_bulk_reply_respects_cap() -> i32
    var store: Store = store_new()
    var buf: [128]u8
    let big: *u8 = c"ECHO aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\r\n"
    if exec_capped(@store, big, @buf[0]) != 0
        return 1
    # A reply that fits is untouched by the check.
    memset(@buf[0], 0, 128)
    var parser: RespParser
    resp_parser_init(@parser, c"ECHO hi\r\n", 9)
    resp_parse(@parser)
    var ctx: CommandContext
    cmd_ctx_init(@ctx, @store, @buf[0], SMALL_CAP)
    cmd_dispatch(@ctx, @parser.command)
    if strcmp(@buf[0], c"$2\r\nhi\r\n") != 0
        return 2
    return 0


# ============================================================================
# Sorted set commands (AGAST #3070)
# ============================================================================
# Replies follow Redis: integer replies for counts and ranks, a nil bulk for
# a missing ZSCORE / ZRANK / ZREVRANK, and arrays for ZRANGE / ZREVRANGE.

const WRONGTYPE_REPLY: *u8 = c"-WRONGTYPE Operation against a key holding the wrong kind of value\r\n"

# z = {a:1, b:2, c:3}
fn zset_fixture(store: *Store) -> i32
    return reply_is(store, c"ZADD z 1 a 2 b 3 c\r\n", c":3\r\n")


[[test]]
fn test_cmd_zadd() -> i32
    var store: Store = store_new()
    if zset_fixture(@store) != 0
        return 1
    # An update of an existing member is not counted; a new one is.
    if reply_is(@store, c"ZADD z 5 a 4 d\r\n", c":1\r\n") != 0
        return 2
    if reply_is(@store, c"ZSCORE z a\r\n", c"$1\r\n5\r\n") != 0
        return 3
    # A bad score rejects the whole command: nothing is added.
    if reply_is(@store, c"ZADD z 9 e x f\r\n", c"-ERR value is not a valid float\r\n") != 0
        return 4
    if reply_is(@store, c"ZCARD z\r\n", c":4\r\n") != 0
        return 5
    if reply_is(@store, c"ZADD z 1\r\n", c"-ERR wrong number of arguments for 'zadd' command\r\n") != 0
        return 6
    if reply_is(@store, c"ZADD z 1 a 2\r\n", c"-ERR syntax error\r\n") != 0
        return 7
    if reply_is(@store, c"zadd neg -7 m\r\n", c":1\r\n") != 0
        return 8
    return 0


[[test]]
fn test_cmd_zrem() -> i32
    var store: Store = store_new()
    if zset_fixture(@store) != 0
        return 1
    if reply_is(@store, c"ZREM z a x c\r\n", c":2\r\n") != 0
        return 2
    if reply_is(@store, c"ZREM nokey a\r\n", c":0\r\n") != 0
        return 3
    if reply_is(@store, c"ZRANGE z 0 -1\r\n", c"*1\r\n$1\r\nb\r\n") != 0
        return 4
    if reply_is(@store, c"ZREM z\r\n", c"-ERR wrong number of arguments for 'zrem' command\r\n") != 0
        return 5
    return 0


# Scores are doubles, as in Redis: fractions and ±inf are accepted, and
# replies use Redis's shortest round-trip form (AGAST #4268).
[[test]]
fn test_cmd_zadd_double_scores() -> i32
    var store: Store = store_new()
    if reply_is(@store, c"ZADD f 1.5 a -inf b +inf c 0.1 d 2.5e-7 e\r\n", c":5\r\n") != 0
        return 1
    if reply_is(@store, c"ZSCORE f a\r\n", c"$3\r\n1.5\r\n") != 0
        return 2
    if reply_is(@store, c"ZSCORE f b\r\n", c"$4\r\n-inf\r\n") != 0
        return 3
    if reply_is(@store, c"ZSCORE f c\r\n", c"$3\r\ninf\r\n") != 0
        return 4
    if reply_is(@store, c"ZSCORE f e\r\n", c"$6\r\n2.5e-7\r\n") != 0
        return 5
    let all: *u8 = c"*10\r\n$1\r\nb\r\n$4\r\n-inf\r\n$1\r\ne\r\n$6\r\n2.5e-7\r\n$1\r\nd\r\n$3\r\n0.1\r\n$1\r\na\r\n$3\r\n1.5\r\n$1\r\nc\r\n$3\r\ninf\r\n"
    if reply_is(@store, c"ZRANGE f 0 -1 WITHSCORES\r\n", all) != 0
        return 6
    # A tie on score orders by member; 1.5 and 1.50 are the same score.
    if reply_is(@store, c"ZADD f 1.50 a 1.5 0\r\n", c":1\r\n") != 0
        return 7
    if reply_is(@store, c"ZRANGE f 2 4\r\n", c"*3\r\n$1\r\nd\r\n$1\r\n0\r\n$1\r\na\r\n") != 0
        return 8
    # Two scores that differ only in the last bit order correctly.
    if reply_is(@store, c"ZADD f 0.30000000000000004 y 0.3 x\r\n", c":2\r\n") != 0
        return 9
    if reply_is(@store, c"ZREVRANGE f 2 4 WITHSCORES\r\n", c"*6\r\n$1\r\n0\r\n$3\r\n1.5\r\n$1\r\ny\r\n$19\r\n0.30000000000000004\r\n$1\r\nx\r\n$3\r\n0.3\r\n") != 0
        return 10
    if reply_is(@store, c"ZSCORE f y\r\n", c"$19\r\n0.30000000000000004\r\n") != 0
        return 11
    # A large integer score prints the way Redis 7.2 does.
    if reply_is(@store, c"ZADD g 100000000 m\r\n", c":1\r\n") != 0
        return 12
    if reply_is(@store, c"ZSCORE g m\r\n", c"$4\r\n1e+8\r\n") != 0
        return 13
    # NaN, overflow and underflow to zero are refused, leaving the set alone.
    if reply_is(@store, c"ZADD f nan n\r\n", c"-ERR value is not a valid float\r\n") != 0
        return 14
    if reply_is(@store, c"ZADD f 1 p 1e400 q\r\n", c"-ERR value is not a valid float\r\n") != 0
        return 15
    if reply_is(@store, c"ZADD f 1e-400 r\r\n", c"-ERR value is not a valid float\r\n") != 0
        return 16
    if reply_is(@store, c"ZADD f 1.5x s\r\n", c"-ERR value is not a valid float\r\n") != 0
        return 17
    if reply_is(@store, c"ZCARD f\r\n", c":8\r\n") != 0
        return 18
    return 0


