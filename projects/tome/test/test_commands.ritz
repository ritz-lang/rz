# test/test_commands.ritz - Tests for command dispatcher
#
# Tests that RESP commands correctly interact with the Store.

import ritzlib.sys
import ritzlib.io
import ritzlib.option
import ritzlib.str
import ritzlib.string
import ritzlib.strview
import ritzlib.memory
import lib.tome
import lib.resp
import lib.commands


# Whether the `len`-byte reply at `buf` is exactly `want`.
fn written(buf: *u8, len: i32, want: StrView) -> bool
    return len >= 0 and strview_from_ptr(buf, len as i64).eq(want)


# ============================================================================
# Helper to execute a command
# ============================================================================

fn exec_cmd(store: *Store, input: StrView, resp_buf: *u8) -> i32
    var parser: RespParser
    resp_parser_init(@parser, input)

    let parse_result: i32 = resp_parse(@parser)
    if parse_result != RESP_OK
        return -1

    var ctx: CommandContext
    cmd_ctx_init(@ctx, store, resp_buf, 8192)

    let result: i32 = cmd_dispatch(@ctx, @parser.command)
    return ctx.resp_len


# ============================================================================
# Tests
# ============================================================================

[[test]]
fn test_cmd_ping() -> i32
    var store: Store = store_new()
    var buf: [8192]u8

    let len: i32 = exec_cmd(@store, "*1\r\n$4\r\nPING\r\n", @buf[0])
    if len <= 0
        return 1

    if not written(@buf[0], len, "+PONG\r\n")
        return 2

    return 0


[[test]]
fn test_cmd_ping_with_message() -> i32
    var store: Store = store_new()
    var buf: [8192]u8

    let len: i32 = exec_cmd(@store, "*2\r\n$4\r\nPING\r\n$5\r\nhello\r\n", @buf[0])
    if len <= 0
        return 1

    if not written(@buf[0], len, "$5\r\nhello\r\n")
        return 2

    return 0


