    let len: i32 = exec_cmd(@store, "*2\r\n$3\r\nGET\r\n$7\r\nmissing\r\n", @buf[0])
    if len <= 0
        return 1

    if not written(@buf[0], len, "$-1\r\n")
        return 2

    return 0


[[test]]
fn test_cmd_del() -> i32
    var store: Store = store_new()
    var buf: [8192]u8

    # SET foo bar
    exec_cmd(@store, "*3\r\n$3\r\nSET\r\n$3\r\nfoo\r\n$3\r\nbar\r\n", @buf[0])

    # DEL foo
    let len: i32 = exec_cmd(@store, "*2\r\n$3\r\nDEL\r\n$3\r\nfoo\r\n", @buf[0])
    if len <= 0
        return 1
    if not written(@buf[0], len, ":1\r\n")
        return 2

    # GET foo should return null
    let len2: i32 = exec_cmd(@store, "*2\r\n$3\r\nGET\r\n$3\r\nfoo\r\n", @buf[0])
    if not written(@buf[0], len2, "$-1\r\n")
        return 3

    return 0


[[test]]
fn test_cmd_exists() -> i32
    var store: Store = store_new()
    var buf: [8192]u8

    # EXISTS foo (missing)
    let len1: i32 = exec_cmd(@store, "*2\r\n$6\r\nEXISTS\r\n$3\r\nfoo\r\n", @buf[0])
    if not written(@buf[0], len1, ":0\r\n")
        return 1

    # SET foo bar
    exec_cmd(@store, "*3\r\n$3\r\nSET\r\n$3\r\nfoo\r\n$3\r\nbar\r\n", @buf[0])

    # EXISTS foo (exists)
    let len2: i32 = exec_cmd(@store, "*2\r\n$6\r\nEXISTS\r\n$3\r\nfoo\r\n", @buf[0])
    if not written(@buf[0], len2, ":1\r\n")
        return 2

    return 0


[[test]]
fn test_cmd_dbsize() -> i32
    var store: Store = store_new()
    var buf: [8192]u8

    # DBSIZE (empty)
    let len1: i32 = exec_cmd(@store, "*1\r\n$6\r\nDBSIZE\r\n", @buf[0])
    if not written(@buf[0], len1, ":0\r\n")
        return 1

    # Add some keys
    exec_cmd(@store, "*3\r\n$3\r\nSET\r\n$1\r\na\r\n$1\r\n1\r\n", @buf[0])
    exec_cmd(@store, "*3\r\n$3\r\nSET\r\n$1\r\nb\r\n$1\r\n2\r\n", @buf[0])

    # DBSIZE
    let len2: i32 = exec_cmd(@store, "*1\r\n$6\r\nDBSIZE\r\n", @buf[0])
    if not written(@buf[0], len2, ":2\r\n")
        return 2

    return 0


[[test]]
fn test_cmd_flushdb() -> i32
    var store: Store = store_new()
    var buf: [8192]u8

    # Add some keys
    exec_cmd(@store, "*3\r\n$3\r\nSET\r\n$1\r\na\r\n$1\r\n1\r\n", @buf[0])
    exec_cmd(@store, "*3\r\n$3\r\nSET\r\n$1\r\nb\r\n$1\r\n2\r\n", @buf[0])

    # FLUSHDB
    let len1: i32 = exec_cmd(@store, "*1\r\n$7\r\nFLUSHDB\r\n", @buf[0])
    if not written(@buf[0], len1, "+OK\r\n")
        return 1

    # DBSIZE should be 0
    let len2: i32 = exec_cmd(@store, "*1\r\n$6\r\nDBSIZE\r\n", @buf[0])
    if not written(@buf[0], len2, ":0\r\n")
        return 2

    return 0


