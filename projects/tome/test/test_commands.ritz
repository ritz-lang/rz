# ============================================================================
# AUTH Command Tests
# ============================================================================

# Helper to execute a command with authentication context
fn exec_cmd_auth(store: *Store, input: StrView, resp_buf: *u8, password: Option<StrView>, is_authenticated: i32) -> i32
    var parser: RespParser
    resp_parser_init(@parser, input)

    let parse_result: i32 = resp_parse(@parser)
    if parse_result != RESP_OK
        return -1

    var ctx: CommandContext
    cmd_ctx_init_auth(@ctx, store, resp_buf, 8192, password, is_authenticated)

    let result: i32 = cmd_dispatch(@ctx, @parser.command)
    return ctx.resp_len


[[test]]
fn test_auth_correct_password() -> i32
    # Test: AUTH with correct password returns OK
    var store: Store = store_new()
    var buf: [8192]u8

    # AUTH with correct password "secret123"
    let len: i32 = exec_cmd_auth(@store, "*2\r\n$4\r\nAUTH\r\n$9\r\nsecret123\r\n", @buf[0], Some("secret123"), 0)
    if len <= 0
        return 1

    if not written(@buf[0], len, "+OK\r\n")
        return 2

    return 0


[[test]]
fn test_auth_wrong_password() -> i32
    # Test: AUTH with wrong password returns error
    var store: Store = store_new()
    var buf: [8192]u8

    # AUTH with wrong password
    let len: i32 = exec_cmd_auth(@store, "*2\r\n$4\r\nAUTH\r\n$5\r\nwrong\r\n", @buf[0], Some("secret123"), 0)
    if len <= 0
        return 1

    # Should return error (starts with -)
    if buf[0] != 45  # '-'
        return 2

    return 0


[[test]]
fn test_auth_no_password_required() -> i32
    # Test: AUTH when no password is set returns error
    var store: Store = store_new()
    var buf: [8192]u8

    # AUTH when no password required (password is null)
    let len: i32 = exec_cmd_auth(@store, "*2\r\n$4\r\nAUTH\r\n$3\r\nfoo\r\n", @buf[0], None, 0)
    if len <= 0
        return 1

    # Should return error (no password set)
    if buf[0] != 45  # '-'
        return 2

    return 0


[[test]]
fn test_noauth_blocks_commands() -> i32
    # Test: Commands blocked when authentication required but not done
    var store: Store = store_new()
    var buf: [8192]u8

    # SET when not authenticated (password required)
    let len: i32 = exec_cmd_auth(@store, "*3\r\n$3\r\nSET\r\n$3\r\nfoo\r\n$3\r\nbar\r\n", @buf[0], Some("secret123"), 0)
    if len <= 0
        return 1

    # Should return NOAUTH error (starts with -)
    if buf[0] != 45  # '-'
        return 2

    return 0


[[test]]
fn test_auth_allows_commands() -> i32
    # Test: Commands allowed after authentication
    var store: Store = store_new()
    var buf: [8192]u8

    # SET when authenticated
    let len: i32 = exec_cmd_auth(@store, "*3\r\n$3\r\nSET\r\n$3\r\nfoo\r\n$3\r\nbar\r\n", @buf[0], Some("secret123"), 1)
    if len <= 0
        return 1

    if not written(@buf[0], len, "+OK\r\n")
        return 2

    return 0


# ============================================================================
# INCR / DECR / INCRBY / DECRBY (AGAST #2457)
# ============================================================================

# Run `input` and compare the whole reply with `want`.  0 on match.
fn reply_is(store: *Store, input: StrView, want: StrView) -> i32
    var buf: [8192]u8
    let len: i32 = exec_cmd(store, input, @buf[0])
    if len <= 0
        return 1
    if not written(@buf[0], len, want)
        return 1
    return 0


[[test]]
fn test_cmd_incr_decr_count() -> i32
    var store: Store = store_new()
    # A missing key counts from 0; the value is stored as its decimal string.
    if reply_is(@store, "INCR n\r\n", ":1\r\n") != 0
        return 1
    if reply_is(@store, "INCR n\r\n", ":2\r\n") != 0
        return 2
    if reply_is(@store, "DECR n\r\n", ":1\r\n") != 0
        return 3
    if reply_is(@store, "INCRBY n 10\r\n", ":11\r\n") != 0
        return 4
    if reply_is(@store, "DECRBY n 20\r\n", ":-9\r\n") != 0
        return 5
    if reply_is(@store, "GET n\r\n", "$2\r\n-9\r\n") != 0
        return 6
    # A SET string that is an integer counts on from its value.
    if reply_is(@store, "SET m -5\r\n", "+OK\r\n") != 0
        return 7
    if reply_is(@store, "INCR m\r\n", ":-4\r\n") != 0
        return 8
    return 0


[[test]]
fn test_cmd_incr_rejects() -> i32
    var store: Store = store_new()
    let not_int: StrView = "-ERR value is not an integer or out of range\r\n"
    store_set(@store, "s", "abc")
    if reply_is(@store, "INCR s\r\n", not_int) != 0
        return 1
    store_set(@store, "e", "")
    if reply_is(@store, "INCR e\r\n", not_int) != 0
        return 2
    # 2^63 does not fit an i64.
    store_set(@store, "big", "9223372036854775808")
    if reply_is(@store, "INCR big\r\n", not_int) != 0
        return 3
    if reply_is(@store, "INCRBY s2 x\r\n", not_int) != 0
        return 4
    store_set(@store, "max", "9223372036854775807")
    if reply_is(@store, "INCR max\r\n", "-ERR increment or decrement would overflow\r\n") != 0
        return 5
    store_set(@store, "min", "-9223372036854775808")
    if reply_is(@store, "DECR min\r\n", "-ERR increment or decrement would overflow\r\n") != 0
        return 6
    # A failed INCR leaves the value alone.
    if reply_is(@store, "GET max\r\n", "$19\r\n9223372036854775807\r\n") != 0
        return 7
    if reply_is(@store, "LPUSH l a\r\n", ":1\r\n") != 0
        return 8
    if reply_is(@store, "INCR l\r\n", "-WRONGTYPE Operation against a key holding the wrong kind of value\r\n") != 0
        return 9
    if reply_is(@store, "INCR\r\n", "-ERR wrong number of arguments for 'incr' command\r\n") != 0
        return 10
    return 0


# ============================================================================
# Replies stay inside resp_cap (AGAST #3068)
# ============================================================================
# A 64-byte cap inside a 128-byte buffer: every byte past the cap is a
# canary that a reply overrunning resp_cap would clobber.

const SMALL_CAP: i32 = 64
const TOO_LARGE: StrView = "-ERR reply too large\r\n"

fn exec_capped(store: *Store, input: StrView, buf: *u8) -> i32
    memset(buf, 33, 128)  # '!'
    var parser: RespParser
    resp_parser_init(@parser, input)
    if resp_parse(@parser) != RESP_OK
        return 1
    var ctx: CommandContext
    cmd_ctx_init(@ctx, store, buf, SMALL_CAP)
    cmd_dispatch(@ctx, @parser.command)
    for i in SMALL_CAP..128
        if *(buf + i) != 33
            return 2  # wrote past resp_cap
    if not written(buf, ctx.resp_len, TOO_LARGE)
        return 3
    return 0


[[test]]
fn test_cmd_collection_reply_respects_cap() -> i32
    var store: Store = store_new()
    var name: String = string_from("ma")
    for i in 0..20
        name.set_char(1, (97 + i) as u8)
        store_sadd(@store, "s", name.as_view())
        store_rpush(@store, "l", name.as_view())
        store_hset(@store, "h", name.as_view(), name.as_view())
    var buf: [128]u8
    if exec_capped(@store, "SMEMBERS s\r\n", @buf[0]) != 0
        return 1
    if exec_capped(@store, "LRANGE l 0 -1\r\n", @buf[0]) != 0
        return 2
    if exec_capped(@store, "HKEYS h\r\n", @buf[0]) != 0
        return 3
    if exec_capped(@store, "HVALS h\r\n", @buf[0]) != 0
        return 4
    if exec_capped(@store, "HGETALL h\r\n", @buf[0]) != 0
        return 5
    return 0


[[test]]
fn test_cmd_bulk_reply_respects_cap() -> i32
    var store: Store = store_new()
    var buf: [128]u8
    let big: StrView = "ECHO aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\r\n"
    if exec_capped(@store, big, @buf[0]) != 0
        return 1
    # A reply that fits is untouched by the check.
    var parser: RespParser
    resp_parser_init(@parser, "ECHO hi\r\n")
    resp_parse(@parser)
    var ctx: CommandContext
    cmd_ctx_init(@ctx, @store, @buf[0], SMALL_CAP)
    cmd_dispatch(@ctx, @parser.command)
    if not written(@buf[0], ctx.resp_len, "$2\r\nhi\r\n")
        return 2
    return 0


# ============================================================================
# Sorted set commands (AGAST #3070)
# ============================================================================
# Replies follow Redis: integer replies for counts and ranks, a nil bulk for
# a missing ZSCORE / ZRANK / ZREVRANK, and arrays for ZRANGE / ZREVRANGE.

const WRONGTYPE_REPLY: StrView = "-WRONGTYPE Operation against a key holding the wrong kind of value\r\n"

# z = {a:1, b:2, c:3}
fn zset_fixture(store: *Store) -> i32
    return reply_is(store, "ZADD z 1 a 2 b 3 c\r\n", ":3\r\n")


[[test]]
fn test_cmd_zadd() -> i32
    var store: Store = store_new()
    if zset_fixture(@store) != 0
        return 1
    # An update of an existing member is not counted; a new one is.
    if reply_is(@store, "ZADD z 5 a 4 d\r\n", ":1\r\n") != 0
        return 2
    if reply_is(@store, "ZSCORE z a\r\n", "$1\r\n5\r\n") != 0
        return 3
    # A bad score rejects the whole command: nothing is added.
    if reply_is(@store, "ZADD z 9 e x f\r\n", "-ERR value is not a valid float\r\n") != 0
        return 4
    if reply_is(@store, "ZCARD z\r\n", ":4\r\n") != 0
        return 5
    if reply_is(@store, "ZADD z 1\r\n", "-ERR wrong number of arguments for 'zadd' command\r\n") != 0
        return 6
    if reply_is(@store, "ZADD z 1 a 2\r\n", "-ERR syntax error\r\n") != 0
        return 7
    if reply_is(@store, "zadd neg -7 m\r\n", ":1\r\n") != 0
        return 8
    return 0


[[test]]
fn test_cmd_zrem() -> i32
    var store: Store = store_new()
    if zset_fixture(@store) != 0
        return 1
    if reply_is(@store, "ZREM z a x c\r\n", ":2\r\n") != 0
        return 2
    if reply_is(@store, "ZREM nokey a\r\n", ":0\r\n") != 0
        return 3
    if reply_is(@store, "ZRANGE z 0 -1\r\n", "*1\r\n$1\r\nb\r\n") != 0
        return 4
    if reply_is(@store, "ZREM z\r\n", "-ERR wrong number of arguments for 'zrem' command\r\n") != 0
        return 5
    return 0


# Scores are doubles, as in Redis: fractions and ±inf are accepted, and
# replies use Redis's shortest round-trip form (AGAST #4268).
[[test]]
fn test_cmd_zadd_double_scores() -> i32
    var store: Store = store_new()
    if reply_is(@store, "ZADD f 1.5 a -inf b +inf c 0.1 d 2.5e-7 e\r\n", ":5\r\n") != 0
        return 1
    if reply_is(@store, "ZSCORE f a\r\n", "$3\r\n1.5\r\n") != 0
        return 2
    if reply_is(@store, "ZSCORE f b\r\n", "$4\r\n-inf\r\n") != 0
        return 3
    if reply_is(@store, "ZSCORE f c\r\n", "$3\r\ninf\r\n") != 0
        return 4
    if reply_is(@store, "ZSCORE f e\r\n", "$6\r\n2.5e-7\r\n") != 0
        return 5
    let all: StrView = "*10\r\n$1\r\nb\r\n$4\r\n-inf\r\n$1\r\ne\r\n$6\r\n2.5e-7\r\n$1\r\nd\r\n$3\r\n0.1\r\n$1\r\na\r\n$3\r\n1.5\r\n$1\r\nc\r\n$3\r\ninf\r\n"
    if reply_is(@store, "ZRANGE f 0 -1 WITHSCORES\r\n", all) != 0
        return 6
    # A tie on score orders by member; 1.5 and 1.50 are the same score.
    if reply_is(@store, "ZADD f 1.50 a 1.5 0\r\n", ":1\r\n") != 0
        return 7
    if reply_is(@store, "ZRANGE f 2 4\r\n", "*3\r\n$1\r\nd\r\n$1\r\n0\r\n$1\r\na\r\n") != 0
        return 8
    # Two scores that differ only in the last bit order correctly.
    if reply_is(@store, "ZADD f 0.30000000000000004 y 0.3 x\r\n", ":2\r\n") != 0
        return 9
    if reply_is(@store, "ZREVRANGE f 2 4 WITHSCORES\r\n", "*6\r\n$1\r\n0\r\n$3\r\n1.5\r\n$1\r\ny\r\n$19\r\n0.30000000000000004\r\n$1\r\nx\r\n$3\r\n0.3\r\n") != 0
        return 10
    if reply_is(@store, "ZSCORE f y\r\n", "$19\r\n0.30000000000000004\r\n") != 0
        return 11
    # A large integer score prints the way Redis 7.2 does.
    if reply_is(@store, "ZADD g 100000000 m\r\n", ":1\r\n") != 0
        return 12
    if reply_is(@store, "ZSCORE g m\r\n", "$4\r\n1e+8\r\n") != 0
        return 13
    # NaN, overflow and underflow to zero are refused, leaving the set alone.
    if reply_is(@store, "ZADD f nan n\r\n", "-ERR value is not a valid float\r\n") != 0
        return 14
    if reply_is(@store, "ZADD f 1 p 1e400 q\r\n", "-ERR value is not a valid float\r\n") != 0
        return 15
    if reply_is(@store, "ZADD f 1e-400 r\r\n", "-ERR value is not a valid float\r\n") != 0
        return 16
    if reply_is(@store, "ZADD f 1.5x s\r\n", "-ERR value is not a valid float\r\n") != 0
        return 17
    if reply_is(@store, "ZCARD f\r\n", ":8\r\n") != 0
        return 18
    return 0


