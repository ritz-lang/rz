    if reply_is(@store, c"ZREVRANGE z 0\r\n", c"-ERR wrong number of arguments for 'zrevrange' command\r\n") != 0
        return 5
    return 0


[[test]]
fn test_cmd_zset_wrongtype() -> i32
    var store: Store = store_new()
    if reply_is(@store, c"SET s v\r\n", c"+OK\r\n") != 0
        return 1
    if reply_is(@store, c"ZADD s 1 a\r\n", WRONGTYPE_REPLY) != 0
        return 2
    if reply_is(@store, c"ZREM s a\r\n", WRONGTYPE_REPLY) != 0
        return 3
    if reply_is(@store, c"ZSCORE s a\r\n", WRONGTYPE_REPLY) != 0
        return 4
    if reply_is(@store, c"ZRANK s a\r\n", WRONGTYPE_REPLY) != 0
        return 5
    if reply_is(@store, c"ZREVRANK s a\r\n", WRONGTYPE_REPLY) != 0
        return 6
    if reply_is(@store, c"ZCARD s\r\n", WRONGTYPE_REPLY) != 0
        return 7
    if reply_is(@store, c"ZRANGE s 0 -1\r\n", WRONGTYPE_REPLY) != 0
        return 8
    if reply_is(@store, c"ZREVRANGE s 0 -1\r\n", WRONGTYPE_REPLY) != 0
        return 9
    # The string is untouched.
    if reply_is(@store, c"GET s\r\n", c"$1\r\nv\r\n") != 0
        return 10
    return 0


[[test]]
fn test_cmd_zrange_reply_respects_cap() -> i32
    var store: Store = store_new()
    var name: [4]u8
    name[0] = 109  # 'm'
    name[2] = 0
    for i in 0..20
        name[1] = (97 + i) as u8
        store_zadd_cstr(@store, c"z", i as f64, @name[0])
    var buf: [128]u8
    if exec_capped(@store, c"ZRANGE z 0 -1\r\n", @buf[0]) != 0
        return 1
    if exec_capped(@store, c"ZREVRANGE z 0 -1 WITHSCORES\r\n", @buf[0]) != 0
        return 2
    return 0
