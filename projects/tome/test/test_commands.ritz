[[test]]
fn test_cmd_zrange() -> i32
    var store: Store = store_new()
    if zset_fixture(@store) != 0
        return 1
    if reply_is(@store, c"ZRANGE z 0 -1\r\n", c"*3\r\n$1\r\na\r\n$1\r\nb\r\n$1\r\nc\r\n") != 0
        return 2
    if reply_is(@store, c"ZRANGE z 1 1\r\n", c"*1\r\n$1\r\nb\r\n") != 0
        return 3
    if reply_is(@store, c"ZRANGE z 5 9\r\n", c"*0\r\n") != 0
        return 4
    if reply_is(@store, c"ZRANGE nokey 0 -1\r\n", c"*0\r\n") != 0
        return 5
    if reply_is(@store, c"ZRANGE z 0 1 withscores\r\n", c"*4\r\n$1\r\na\r\n$1\r\n1\r\n$1\r\nb\r\n$1\r\n2\r\n") != 0
        return 6
    if reply_is(@store, c"ZRANGE z x 1\r\n", c"-ERR value is not an integer or out of range\r\n") != 0
        return 7
    if reply_is(@store, c"ZRANGE z 0 1 BOGUS\r\n", c"-ERR syntax error\r\n") != 0
        return 8
    if reply_is(@store, c"ZRANGE z 0\r\n", c"-ERR wrong number of arguments for 'zrange' command\r\n") != 0
        return 9
    return 0


[[test]]
fn test_cmd_zrevrange() -> i32
    var store: Store = store_new()
    if zset_fixture(@store) != 0
