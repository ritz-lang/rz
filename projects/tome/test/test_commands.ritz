[[test]]
fn test_cmd_set_get() -> i32
    var store: Store = store_new()
    var buf: [8192]u8

    # SET foo bar
    let len1: i32 = exec_cmd(@store, "*3\r\n$3\r\nSET\r\n$3\r\nfoo\r\n$3\r\nbar\r\n", @buf[0])
    if len1 <= 0
        return 1
    if not written(@buf[0], len1, "+OK\r\n")
        return 2

    # GET foo
    let len2: i32 = exec_cmd(@store, "*2\r\n$3\r\nGET\r\n$3\r\nfoo\r\n", @buf[0])
    if len2 <= 0
        return 3
    if not written(@buf[0], len2, "$3\r\nbar\r\n")
        return 4

    return 0


