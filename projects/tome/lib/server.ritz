# lib/server.ritz - Tome Server integration with TaskServer
#
# Combines RESP protocol, command dispatcher, and TaskServer
# for high-performance async I/O using io_uring.
#
# Architecture:
#   - Single process, async event loop
#   - io_uring for non-blocking I/O
#   - Connection handlers as coroutines
#
# Usage:
#   var server: TomeServer
#   tome_server_init(@server, 6379)
#   tome_server_run(@server)

import ritzlib.memory
import ritzlib.str
import ritzlib.string
import ritzlib.strview
import ritzlib.sys
import ritzlib.io
import ritzlib.uring
import ritzlib.async_net
import ritzlib.async.tasks
import lib.tome
import lib.resp
import lib.commands
import lib.session


# ============================================================================
# Handler States
# ============================================================================

const STATE_INIT: i32 = 0   # spawn_task's handler_state: no I/O yet
const STATE_RECV: i32 = 1   # a recv into the session's input is in flight
const STATE_SEND: i32 = 2   # a send of the session's output is in flight


# ============================================================================
# Connection State
# ============================================================================
# Per-connection authentication state.  Kept for the ConnectionState tests
# in test_server_auth.ritz; the live auth flag is Session.is_authenticated.

pub struct ConnectionState
    is_authenticated: i32    # 1 if client has successfully AUTH'd


# Initialize connection state
pub fn conn_state_init(state: *ConnectionState)
    state.is_authenticated = 0


# What a connection task keeps in task.user_data.  spawn_task puts the
# TaskPool there, so the first poll moves it here before taking the slot.
struct TomeConn
    pool: *TaskPool
    session: *Session


# ============================================================================
# Global Configuration
# ============================================================================

var g_password: *u8       # Required password (null = no auth required)


# Set server password (call before accepting connections)
pub fn tome_server_set_password(password: *u8)
    g_password = password


# ============================================================================
# Global Store
# ============================================================================
# Single shared store for all connections.
# In a multi-process model, each worker would have its own store,
# or use shared memory (Phase 11).

var g_store: Store


# ============================================================================
# Connection Handler
# ============================================================================
# Called by TaskServer on a connection's first poll and on each of its I/O
# completions.  Returns -1 while the connection lives (an SQE is in flight)
# and 0 to finish it, after which TaskServer closes the fd.
#
# AGAST #2457: this handler used to return task_recv()'s result, 0 on
# success, so the task finished (and its socket closed, unread request and
# all: an RST) on the very first poll.  It also read the TASK_IO_FRESH
# sentinel as a 1 GiB recv, and kept its auth state in task.user_data,
# which spawn_task had already filled with the TaskPool.

fn conn_close(task: *Task, conn: *TomeConn) -> i32
    session_free(conn.session)
    free(conn as *u8)
    task.user_data = null
    return 0


# Run what the session holds, then submit the next I/O: replies first,
# then (when nothing is queued) the next recv.
fn conn_pump(task: *Task, conn: *TomeConn) -> i32
    let s: *Session = conn.session
    session_process(s)

    let pending: i64 = session_pending_len(s)
    if pending > 0
        task.handler_state = STATE_SEND
        if task_submit_send_buf(conn.pool, task, session_pending_ptr(s), pending as i32) < 0
            return conn_close(task, conn)
        return -1

    if session_should_close(s) != 0
        return conn_close(task, conn)

    task.handler_state = STATE_RECV
    if task_submit_recv_buf(conn.pool, task, session_recv_ptr(s), session_recv_room(s) as i32) < 0
        return conn_close(task, conn)
    return -1


fn handle_connection(task: *Task) -> i32
    if task.handler_state == STATE_INIT
        let conn: *TomeConn = malloc(sizeof(TomeConn)) as *TomeConn
        if conn == null
            return 0
        conn.pool = task.user_data as *TaskPool
        conn.session = session_new(@g_store, g_password)
        if conn.session == null
            free(conn as *u8)
            return 0
        task.user_data = conn as *u8
        return conn_pump(task, conn)

    let conn: *TomeConn = task.user_data as *TomeConn
    if task.handler_state == STATE_RECV
        if task.io_result <= 0
            return conn_close(task, conn)  # client closed, or recv failed
        session_received(conn.session, task.io_result as i64)
    else if task.handler_state == STATE_SEND
        if task.io_result <= 0
            return conn_close(task, conn)
        session_sent(conn.session, task.io_result as i64)
    else
        return conn_close(task, conn)
    return conn_pump(task, conn)


# ============================================================================
# Server Initialization
# ============================================================================

struct TomeServer
    task_server: TaskServer
    port: i32
    listen_fd: i32


# Create and configure a listening socket
fn server_create_listen_socket(port: i32) -> i32
    # Create TCP socket
    let fd: i32 = tcp_socket()
    if fd < 0
        return fd

    # Set socket options
    set_reuseaddr(fd)
    set_reuseport(fd)

    # Bind to all interfaces on the specified port
    let bind_ret: i32 = tcp_bind(fd, 0, port)
    if bind_ret < 0
        sys_close(fd)
        return bind_ret

    # Start listening with a backlog of 128
    let listen_ret: i32 = tcp_listen(fd, 128)
    if listen_ret < 0
        sys_close(fd)
        return listen_ret

    return fd


pub fn tome_server_init(srv: *TomeServer, port: i32) -> i32
    srv.port = port

    # Initialize global store
    g_store = store_new()

    # Create listening socket
    let listen_fd: i32 = server_create_listen_socket(port)
    if listen_fd < 0
        return listen_fd
    srv.listen_fd = listen_fd

    # Initialize task server
    let ret: i32 = task_server_init(@srv.task_server, listen_fd)
    if ret < 0
        sys_close(listen_fd)
        return ret

    # Set idle timeout (close connections idle for 60 seconds)
    task_server_set_idle_timeout(@srv.task_server, 60)

    return 0


# Initialize with an existing listen socket (for multi-process workers)
pub fn tome_server_init_with_fd(srv: *TomeServer, port: i32, listen_fd: i32) -> i32
    srv.port = port
    srv.listen_fd = listen_fd

    # Initialize global store (each worker has its own store)
    g_store = store_new()

    # Initialize task server with inherited listen fd
    let ret: i32 = task_server_init(@srv.task_server, listen_fd)
    if ret < 0
        return ret

    # Set idle timeout (close connections idle for 60 seconds)
    task_server_set_idle_timeout(@srv.task_server, 60)

    return 0


# Run the server (blocking)
pub fn tome_server_run(srv: *TomeServer) -> i32
    return task_server_run_multishot(@srv.task_server, handle_connection)


# Stop the server
pub fn tome_server_stop(srv: *TomeServer)
    task_server_stop(@srv.task_server)


# Cleanup
pub fn tome_server_destroy(srv: *TomeServer)
    task_server_destroy(@srv.task_server)
