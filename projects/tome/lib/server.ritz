# lib/server.ritz - Tome Server integration with TaskServer
#
# Combines RESP protocol, command dispatcher, and TaskServer
# for high-performance async I/O using io_uring.
#
# Architecture:
#   - Single process, async event loop
#   - io_uring for non-blocking I/O
#   - Connection handlers as coroutines
#
# Usage:
#   var server: TomeServer
#   tome_server_init(@&server, 6379)?
#   tome_server_run(@&server)?

import ritzlib.hashmap
import ritzlib.option
import ritzlib.result
import ritzlib.errno
import ritzlib.net
import ritzlib.str
import ritzlib.string
import ritzlib.strview
import ritzlib.sys
import ritzlib.fd
import ritzlib.io
import ritzlib.uring
import ritzlib.async_net
import ritzlib.async.tasks
import lib.pool
import lib.tome
import lib.resp
import lib.commands
import lib.session


# ============================================================================
# Handler States
# ============================================================================

const STATE_INIT: i32 = 0   # spawn_task's handler_state: no I/O yet
const STATE_RECV: i32 = 1   # a recv into the session's input is in flight
const STATE_SEND: i32 = 2   # a send of the session's output is in flight


# ============================================================================
# Connection State
# ============================================================================
# Per-connection authentication state.  Kept for the ConnectionState tests
# in test_server_auth.ritz; the live auth flag is Session.is_authenticated.

pub struct ConnectionState
    is_authenticated: i32    # 1 if client has successfully AUTH'd


# Initialize connection state
pub fn conn_state_init(state: *ConnectionState)
    state.is_authenticated = 0


# The live connections' sessions, by task id.  task.user_data stays the
# TaskPool spawn_task put there; a session is found by its task's id.
struct Conns
    sessions: Pool<Session>
    by_task: HashMapI64          # task.id -> slot in sessions


# ============================================================================
# Global Configuration
# ============================================================================

# The required password, if any.  A view plus a flag rather than an
# Option<StrView> global: a global cannot start as None (a generic variant
# is not a constant initialiser, §4.3).
var g_password: StrView
var g_password_required: bool     # false until tome_server_set_password


# Set server password (call before accepting connections)
pub fn tome_server_set_password(password: StrView)
    g_password = password
    g_password_required = true


# None when no AUTH is required.
fn server_password() -> Option<StrView>
    if g_password_required
        return Some(g_password)
    return None


# ============================================================================
# Global Store
# ============================================================================
# Single shared store for all connections, and their sessions.  Both are
# owned by tome_server_run, which runs the whole event loop: these point at
# its locals while it runs, and are null otherwise.
# In a multi-process model, each worker would have its own store,
# or use shared memory (Phase 11).

var g_store: *Store = null
var g_conns: *Conns = null


# ============================================================================
# Connection Handler
# ============================================================================
# Called by TaskServer on a connection's first poll and on each of its I/O
# completions.  Pending while the connection lives (an SQE is in flight);
# Done to finish it, after which TaskServer closes the fd.
#
# AGAST #2457: this handler used to return task_recv()'s result, 0 on
# success, so the task finished (and its socket closed, unread request and
# all: an RST) on the very first poll.  It also read the TASK_IO_FRESH
# sentinel as a 1 GiB recv, and kept its auth state in task.user_data,
# which spawn_task had already filled with the TaskPool.

# Drop the connection's session (in `slot`): the task is Done.
fn conn_close(task: @&Task, slot: i64) -> TaskStep
    g_conns.by_task.remove(task.id)
    g_conns.sessions.remove(slot, session_blank())
    TaskStep.Done


# Run what the session holds, then submit the next I/O: replies first,
# then (when nothing is queued) the next recv.
fn conn_pump(task: @&Task, slot: i64) -> TaskStep
    let s: @&Session = g_conns.sessions.at(slot)
    session_process(s)

    if session_pending_len(s) > 0
        task.handler_state = STATE_SEND
        if not task.send_buf(session_pending_buf(s))
            return conn_close(task, slot)
        return TaskStep.Pending

    if session_should_close(s) != 0
        return conn_close(task, slot)

    task.handler_state = STATE_RECV
    if not task.recv_buf(session_recv_buf(s))
        return conn_close(task, slot)
    TaskStep.Pending


fn handle_connection(task: @&Task) -> TaskStep
    if task.handler_state == STATE_INIT
        let fresh: i64 = g_conns.sessions.insert(session_new(g_store, server_password()))
        g_conns.by_task.insert(task.id, fresh)
        return conn_pump(task, fresh)

    let slot: i64 = match g_conns.by_task.get(task.id)
        Some(sl) => sl
        None => return TaskStep.Done  # no session: nothing to serve
    let s: @&Session = g_conns.sessions.at(slot)
    if task.handler_state == STATE_RECV
        if task.io_result <= 0
            return conn_close(task, slot)  # client closed, or recv failed
        session_received(s, task.io_result as i64)
    else if task.handler_state == STATE_SEND
        if task.io_result <= 0
            return conn_close(task, slot)
        session_sent(s, task.io_result as i64)
    else
        return conn_close(task, slot)
    conn_pump(task, slot)


# ============================================================================
# Server Initialization
# ============================================================================

struct TomeServer
    task_server: TaskServer
    port: i32
    listener: Socket


# Close `sock` after a failed setup step, passing that step's error on.
fn close_on_err(sock: @&Socket, e: Errno) -> Result<Socket, Errno>
    sock.close()
    Err(e)


# A TCP socket listening on all interfaces at `port`, or the errno of the
# step that failed (the socket is closed then).
fn server_create_listen_socket(port: i32) -> Result<Socket, Errno>
    var sock: Socket = socket_tcp()?
    sock.set_reuseaddr()
    sock.set_reuseport()

    match sock.bind("0.0.0.0", port)
        Ok(_) => pass
        Err(e) => return close_on_err(@&sock, e)
    match sock.listen(128)
        Ok(_) => pass
        Err(e) => return close_on_err(@&sock, e)
    Ok(sock)


# Serve a fresh listener on `port`: Ok(()), or the errno of the socket or
# ring setup that failed (the listener is closed then).
pub fn tome_server_init(srv: @&TomeServer, port: i32) -> Result<(), Errno>
    let listener: Socket = server_create_listen_socket(port)?
    match tome_server_init_with_socket(srv, port, listener)
        Ok(_) => Ok(())
        Err(e) => close_listener_on_err(srv, e)


# A failed init's listener is the server's to close: pass the error on.
fn close_listener_on_err(srv: @&TomeServer, e: Errno) -> Result<(), Errno>
    srv.listener.close()
    Err(e)


# Initialize with an existing listen socket (for multi-process workers).
# The caller keeps `listen_fd`.
pub fn tome_server_init_with_fd(srv: @&TomeServer, port: i32, listen_fd: i32) -> Result<(), Errno>
    tome_server_init_with_socket(srv, port, socket_from_raw(listen_fd))


fn tome_server_init_with_socket(srv: @&TomeServer, port: i32, listener: Socket) -> Result<(), Errno>
    srv.port = port
    srv.listener = listener
    srv.task_server.init(@srv.listener)?

    # Set idle timeout (close connections idle for 60 seconds)
    srv.task_server.set_idle_timeout(60)
    Ok(())


# Run the server (blocking).  The store and the sessions live here, for as
# long as the event loop does (each worker process has its own).
pub fn tome_server_run(srv: @&TomeServer) -> Result<(), Errno>
    var store: Store = store_new()
    var conns: Conns = Conns { sessions: pool_new<Session>(), by_task: hashmap_i64_new() }
    g_store = @&store
    g_conns = @&conns
    let ret: Result<(), Errno> = srv.task_server.run_multishot(handle_connection)
    g_conns = null
    g_store = null
    ret


# Stop the server
pub fn tome_server_stop(srv: @&TomeServer)
    srv.task_server.stop()


# Cleanup
pub fn tome_server_destroy(srv: @&TomeServer)
    srv.task_server.destroy()
