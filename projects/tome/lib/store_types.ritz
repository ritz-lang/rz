# lib/store_types.ritz - Tome value types
#
# Value-type tags and the List, Set, ZSet and Hash structures.  Each owns
# its memory through Vec, HashMap and Pool fields, so dropping one releases
# everything in it; the Store keeps each kind in a Pool of its own
# (store.ritz).  Kept apart from their operations so that the Store core
# can hold and drop any value without importing the typed modules.
#
# Each type has a *blank*: a value that owns nothing, what a free Pool slot
# holds (lib/pool.ritz).

import ritzlib.gvec
import ritzlib.hash
import ritzlib.hashmap
import ritzlib.string
import ritzlib.strview
import ritzlib.drop
import tome.pool

# ============================================================================
# Value Types
# ============================================================================
# Tome supports multiple value types, similar to Redis.

const VALUE_NONE: i32 = 0
const VALUE_STRING: i32 = 1
const VALUE_LIST: i32 = 2
const VALUE_SET: i32 = 3
const VALUE_ZSET: i32 = 4
const VALUE_HASH: i32 = 5

# Skip list constants for Sorted Set
const ZSET_MAX_LEVEL: i32 = 16

# A member -> slot index that owns nothing, for the blank Set / ZSet / Hash.
# A blank is only ever replaced, never used as a table, so it has no slots.
fn index_blank() -> HashMap<StrView, i64>
    HashMap<StrView, i64> { slots: vec_new<HashMapEntry<StrView, i64>>(), len: 0, tombstones: 0 }

# ============================================================================
# List Type - a ring buffer of Strings
# ============================================================================
# O(1) push and pop at both ends, O(1) index.  Every slot of `ring` holds a
# String; those outside the live run are empty, owning nothing.  The ring's
# length is 0 or a power of 2.

struct List
    ring: Vec<String>    # the slots: element k is at (head + k) & (len - 1)
    head: i64            # ring index of the first element
    len: i64             # Number of elements

# Vec drops only its buffer, so release each slot's String first.
impl Drop for List
    fn drop(self: @&List)
        for i in 0..self.ring.len()
            self.ring.replace(i, string_new())

pub fn list_new() -> List
    List { ring: vec_new<String>(), head: 0, len: 0 }

# ============================================================================
# Set Type
# ============================================================================
# An unordered collection of unique members, each any bytes (NUL included).
# The index's keys view the member Strings in `members`: a String's bytes
# don't move when the Pool's Vec does, so a key is good until its member is
# removed, and it leaves the index first.

struct Set
    members: Pool<String>
    index: HashMap<StrView, i64>  # member bytes -> slot in members

pub fn set_blank() -> Set
    Set { members: pool_new<String>(), index: index_blank() }

# ============================================================================
# Sorted Set Type - Skip List
# ============================================================================
# A sorted set associates a score (f64, as in Redis; never NaN) with each
# unique member.  Members are sorted by score, then bytewise for equal
# scores.  The skip list gives O(log n) insert and delete, the index O(1)
# member -> node lookup.  Nodes live in a Pool and link by slot.

const ZNIL: i64 = -1         # the end of a level
const ZHEAD: i64 = 0         # the header (sentinel) node's slot

# Skip list node: a member, its score and its successor on each level.
struct ZSetNode
    member: String           # The member value (owned; empty for the header)
    score: f64               # The score for sorting (lib/score.ritz parses it)
    forward: Vec<i64>        # the next node's slot on each level, or ZNIL

pub fn zset_node_blank() -> ZSetNode
    ZSetNode { member: string_new(), score: 0.0, forward: vec_new<i64>() }

struct ZSet
    nodes: Pool<ZSetNode>    # slot ZHEAD is the header, on every level
    level: i32               # Current max level of skip list
    len: i64                 # Number of elements
    index: HashMap<StrView, i64>  # member bytes -> node slot

pub fn zset_blank() -> ZSet
    ZSet { nodes: pool_new<ZSetNode>(), level: 1, len: 0, index: index_blank() }

# ============================================================================
# Hash Type - Field-Value Hash Map
# ============================================================================
# A map from fields to values, each any bytes.  The index's keys view the
# field Strings, as Set's do.

struct HashField
    field: String        # The field name (owned)
    value: String        # The field value (owned)

pub fn hash_field_blank() -> HashField
    HashField { field: string_new(), value: string_new() }

struct Hash
    fields: Pool<HashField>
    index: HashMap<StrView, i64>  # field bytes -> slot in fields

pub fn hash_blank() -> Hash
    Hash { fields: pool_new<HashField>(), index: index_blank() }
