# lib/pubsub.ritz - Tome publish/subscribe
#
# Channel and pattern subscriptions and message publishing.

import ritzlib.memory
import ritzlib.hash
import ritzlib.str
import ritzlib.string
import ritzlib.strview
import ritzlib.drop
import ritzlib.sys
import tome.store_types
import tome.store

# ============================================================================
# Pub/Sub System
# ============================================================================
# Pub/Sub allows publishing messages to channels and subscribing to receive them.
# Subscribers register callbacks that are invoked when messages arrive.
# Pattern subscriptions use glob-style matching (* = any characters).

# Callback type: fn(channel: StrView, message: StrView, context: *u8) -> i32
# Returns 0 to continue receiving, non-zero to auto-unsubscribe.
#
# Channels, patterns and messages are (ptr, len) views, not C strings: Redis
# PUBLISH is binary-safe, so "c\0a" and "c\0b" are different channels and a
# message with an embedded NUL reaches the callback whole (#4223).

# A single subscriber entry in a channel's subscriber list
struct Subscriber
    callback: fn(StrView, StrView, *u8) -> i32  # (channel, message, ctx)
    context: *u8                          # User-provided context
    next: *Subscriber                     # Next subscriber in list

# A channel entry in the channel hash table
struct ChannelEntry
    name: String                 # Channel name (owned)
    subscribers: *Subscriber     # Linked list of subscribers
    state: i32                   # 0=empty, 1=occupied, 2=tombstone

# A pattern subscription entry
struct PatternEntry
    pattern: String              # Glob pattern (owned)
    callback: fn(StrView, StrView, *u8) -> i32
    context: *u8
    next: *PatternEntry          # Next pattern in list

# The Pub/Sub registry
struct PubSub
    channels: *ChannelEntry      # Hash table of channels
    channel_cap: i64             # Capacity
    channel_len: i64             # Number of channels
    channel_tombstones: i64      # Number of tombstones
    patterns: *PatternEntry      # Linked list of pattern subscriptions
    pattern_count: i64           # Number of pattern subscriptions

# ============================================================================
# Pub/Sub Constructor and Destructor
# ============================================================================

pub fn pubsub_new() -> PubSub
    var ps: PubSub
    ps.channel_cap = 16
    ps.channel_len = 0
    ps.channel_tombstones = 0
    let size: i64 = ps.channel_cap * sizeof(ChannelEntry)
    ps.channels = malloc(size) as *ChannelEntry
    for i in 0..ps.channel_cap
        let entry: *ChannelEntry = ps.channels + i
        entry.state = 0
    ps.patterns = null
    ps.pattern_count = 0
    return ps

pub fn pubsub_drop(ps: @&PubSub)
    # Free all channels and their subscribers
    if ps.channels != null
        for i in 0..ps.channel_cap
            let entry: *ChannelEntry = ps.channels + i
            if entry.state == 1
                string_drop(@&entry.name)
                # Free subscriber list
                var sub: *Subscriber = entry.subscribers
                while sub != null
                    let next: *Subscriber = sub.next
                    free(sub as *u8)
                    sub = next
        free(ps.channels as *u8)
    ps.channels = null

    # Free all pattern subscriptions
    var pat: *PatternEntry = ps.patterns
    while pat != null
        let next: *PatternEntry = pat.next
        string_drop(@&pat.pattern)
        free(pat as *u8)
        pat = next
    ps.patterns = null

# ============================================================================
# Channel Operations
# ============================================================================

# Grow the channel hash table
fn pubsub_grow_channels(ps: @&PubSub)
    let old_channels: *ChannelEntry = ps.channels
    let old_cap: i64 = ps.channel_cap

    ps.channel_cap = old_cap * 2
    ps.channel_len = 0
    ps.channel_tombstones = 0
    let size: i64 = ps.channel_cap * sizeof(ChannelEntry)
    ps.channels = malloc(size) as *ChannelEntry
    for i in 0..ps.channel_cap
        let entry: *ChannelEntry = ps.channels + i
        entry.state = 0

    # Rehash existing entries
    for i in 0..old_cap
        let old: *ChannelEntry = old_channels + i
        if old.state == 1
            let h: u64 = string_hash(@old.name)
            let mask: i64 = ps.channel_cap - 1
            var idx: i64 = (h as i64) & mask
            var j: i64 = 0
            while j < ps.channel_cap
                let entry: *ChannelEntry = ps.channels + idx
                if entry.state == 0
                    entry.name = old.name
                    entry.subscribers = old.subscribers
                    entry.state = 1
                    ps.channel_len += 1
                    break
                idx = (idx + 1) & mask
                j += 1

    free(old_channels as *u8)

# Get or create a channel entry
fn pubsub_get_or_create_channel(ps: @&PubSub, channel: StrView) -> *ChannelEntry
    # Check load factor
    let load: i64 = (ps.channel_len + ps.channel_tombstones + 1) * 100 / ps.channel_cap
    if load > 75
        pubsub_grow_channels(ps)

    let h: u64 = hash_strview(channel)
    let mask: i64 = ps.channel_cap - 1
    var idx: i64 = (h as i64) & mask
    var first_tombstone: i64 = -1
    var i: i64 = 0

    while i < ps.channel_cap
        let entry: *ChannelEntry = ps.channels + idx

        if entry.state == 0  # Empty - insert here
            var insert_idx: i64 = idx
            if first_tombstone >= 0
                insert_idx = first_tombstone
                ps.channel_tombstones -= 1
            let target: *ChannelEntry = ps.channels + insert_idx
            target.name = string_from_strview(channel)
            target.subscribers = null
            target.state = 1
            ps.channel_len += 1
            return target

        if entry.state == 2  # Tombstone
            if first_tombstone < 0
                first_tombstone = idx

        if entry.state == 1  # Occupied
            if string_eq_strview(@entry.name, channel)
                return entry

        idx = (idx + 1) & mask
        i += 1

    return null

# Find a channel (don't create)
fn pubsub_find_channel(ps: @PubSub, channel: StrView) -> *ChannelEntry
    if ps.channel_len == 0
        return null

    let h: u64 = hash_strview(channel)
    let mask: i64 = ps.channel_cap - 1
    var idx: i64 = (h as i64) & mask
    var i: i64 = 0

    while i < ps.channel_cap
        let entry: *ChannelEntry = ps.channels + idx

        if entry.state == 0
            return null

        if entry.state == 1
            if string_eq_strview(@entry.name, channel)
                return entry

        idx = (idx + 1) & mask
        i += 1

    return null

# ============================================================================
# Subscribe Operations
# ============================================================================

# Subscribe to a channel with a callback
pub fn pubsub_subscribe(ps: @&PubSub, channel: StrView, callback: fn(StrView, StrView, *u8) -> i32, context: *u8) -> i32
    let entry: *ChannelEntry = pubsub_get_or_create_channel(ps, channel)
    if entry == null
        return -1

    # Check if already subscribed (same callback + context)
    var sub: *Subscriber = entry.subscribers
    while sub != null
        if sub.callback == callback && sub.context == context
            return 0  # Already subscribed
        sub = sub.next

    # Add new subscriber at head
    let new_sub: *Subscriber = malloc(sizeof(Subscriber)) as *Subscriber
    new_sub.callback = callback
    new_sub.context = context
    new_sub.next = entry.subscribers
    entry.subscribers = new_sub
    return 1

# Unsubscribe from a channel
pub fn pubsub_unsubscribe(ps: @&PubSub, channel: StrView, callback: fn(StrView, StrView, *u8) -> i32, context: *u8) -> i32
    let entry: *ChannelEntry = pubsub_find_channel(ps, channel)
    if entry == null
        return 0

    var prev: *Subscriber = null
    var sub: *Subscriber = entry.subscribers
    while sub != null
        if sub.callback == callback && sub.context == context
            # Remove from list
            if prev == null
                entry.subscribers = sub.next
            else
                prev.next = sub.next
            free(sub as *u8)
            return 1
        prev = sub
        sub = sub.next

    return 0

# ============================================================================
# Pattern Subscribe Operations
# ============================================================================

# Subscribe to a pattern (glob-style)
pub fn pubsub_psubscribe(ps: @&PubSub, pattern: StrView, callback: fn(StrView, StrView, *u8) -> i32, context: *u8) -> i32
    # Check if already subscribed
    var pat: *PatternEntry = ps.patterns
    while pat != null
        if string_eq_strview(@pat.pattern, pattern)
            if pat.callback == callback && pat.context == context
                return 0  # Already subscribed
        pat = pat.next

    # Add new pattern at head
    let new_pat: *PatternEntry = malloc(sizeof(PatternEntry)) as *PatternEntry
    new_pat.pattern = string_from_strview(pattern)
    new_pat.callback = callback
    new_pat.context = context
    new_pat.next = ps.patterns
    ps.patterns = new_pat
    ps.pattern_count += 1
    return 1

# Unsubscribe from a pattern
pub fn pubsub_punsubscribe(ps: @&PubSub, pattern: StrView, callback: fn(StrView, StrView, *u8) -> i32, context: *u8) -> i32
    var prev: *PatternEntry = null
    var pat: *PatternEntry = ps.patterns
    while pat != null
        if string_eq_strview(@pat.pattern, pattern)
            if pat.callback == callback && pat.context == context
                # Remove from list
                if prev == null
                    ps.patterns = pat.next
                else
                    prev.next = pat.next
                string_drop(@&pat.pattern)
                free(pat as *u8)
                ps.pattern_count -= 1
                return 1
        prev = pat
        pat = pat.next

    return 0

# ============================================================================
# Pattern Matching (glob-style)
# ============================================================================

# Match a channel name against a glob pattern, both (ptr, len): a NUL is an
# ordinary byte.  Supports: * (any run of bytes), ? (any single byte)
fn tome_glob_match(pattern: StrView, str: StrView) -> i32
    var p: i64 = 0
    var s: i64 = 0
    var star_p: i64 = -1    # Index after the last * in pattern
    var star_s: i64 = 0     # Index in str when we matched that *

    while s < str.len
        if p < pattern.len && *(pattern.ptr + p) == 42  # '*'
            # Skip consecutive stars
            while p < pattern.len && *(pattern.ptr + p) == 42
                p += 1
            if p == pattern.len
                return 1  # Trailing * matches everything
            star_p = p
            star_s = s
        else if p < pattern.len && (*(pattern.ptr + p) == 63 || *(pattern.ptr + p) == *(str.ptr + s))  # '?' or exact
            p += 1
            s += 1
        else if star_p >= 0
            # Backtrack: try matching * with one more byte
            p = star_p
            star_s += 1
            s = star_s
        else
            return 0  # No match

    # Skip trailing stars in pattern
    while p < pattern.len && *(pattern.ptr + p) == 42
        p += 1

    if p == pattern.len
        return 1
    return 0

# ============================================================================
# Publish Operation
# ============================================================================

# Publish a message to a channel
# Returns number of subscribers that received the message
pub fn pubsub_publish(ps: @&PubSub, channel: StrView, message: StrView) -> i64
    var count: i64 = 0

    # Direct channel subscribers
    let entry: *ChannelEntry = pubsub_find_channel(ps, channel)
    if entry != null
        var prev: *Subscriber = null
        var sub: *Subscriber = entry.subscribers
        while sub != null
            let cb: fn(StrView, StrView, *u8) -> i32 = sub.callback
            let result: i32 = cb(channel, message, sub.context)
            count += 1

            if result != 0
                # Subscriber wants to unsubscribe
                let next: *Subscriber = sub.next
                if prev == null
                    entry.subscribers = next
                else
                    prev.next = next
                free(sub as *u8)
                sub = next
            else
                prev = sub
                sub = sub.next

    # Pattern subscribers
    var prev_pat: *PatternEntry = null
    var pat: *PatternEntry = ps.patterns
    while pat != null
        if tome_glob_match(string_as_view(@pat.pattern), channel) == 1
            let pcb: fn(StrView, StrView, *u8) -> i32 = pat.callback
            let result: i32 = pcb(channel, message, pat.context)
            count += 1

            if result != 0
                # Subscriber wants to unsubscribe
                let next: *PatternEntry = pat.next
                if prev_pat == null
                    ps.patterns = next
                else
                    prev_pat.next = next
                string_drop(@&pat.pattern)
                free(pat as *u8)
                ps.pattern_count -= 1
                pat = next
            else
                prev_pat = pat
                pat = pat.next
        else
            prev_pat = pat
            pat = pat.next

    return count

# ============================================================================
# Pub/Sub Query Operations
# ============================================================================

# Get count of subscribers to a specific channel
pub fn pubsub_numsub(ps: @PubSub, channel: StrView) -> i64
    let entry: *ChannelEntry = pubsub_find_channel(ps, channel)
    if entry == null
        return 0

    var count: i64 = 0
    var sub: *Subscriber = entry.subscribers
    while sub != null
        count += 1
        sub = sub.next
    return count

# Get count of pattern subscriptions
pub fn pubsub_numpat(ps: @PubSub) -> i64
    return ps.pattern_count

# Get list of channels with subscribers: a malloc'd array of `*out_count`
# views borrowing the registry's names (lengths kept; free the array only).
pub fn pubsub_channels(ps: @PubSub, out_count: @&i64) -> *StrView
    *out_count = 0
    if ps.channel_len == 0
        return null

    # Count channels with actual subscribers
    var active: i64 = 0
    for i in 0..ps.channel_cap
        let entry: *ChannelEntry = ps.channels + i
        if entry.state == 1 && entry.subscribers != null
            active += 1

    if active == 0
        return null

    let arr: *StrView = malloc(active * sizeof(StrView)) as *StrView
    var j: i64 = 0
    for i in 0..ps.channel_cap
        let entry: *ChannelEntry = ps.channels + i
        if entry.state == 1 && entry.subscribers != null
            *(arr + j) = string_as_view(@entry.name)
            j += 1
            if j >= active
                break

    *out_count = j
    return arr
