# lib/pubsub.ritz - Tome publish/subscribe
#
# Channel and pattern subscriptions and message publishing.

import ritzlib.gvec
import ritzlib.hashmap
import ritzlib.option
import ritzlib.string
import ritzlib.strview
import tome.pool

# ============================================================================
# Pub/Sub System
# ============================================================================
# Pub/Sub allows publishing messages to channels and subscribing to receive them.
# Subscribers register callbacks that are invoked when messages arrive.
# Pattern subscriptions use glob-style matching (* = any characters).

# Callback type: fn(channel: StrView, message: StrView, context: *u8) -> i32
# Returns 0 to continue receiving, non-zero to auto-unsubscribe.
#
# Channels, patterns and messages are (ptr, len) views, not C strings: Redis
# PUBLISH is binary-safe, so "c\0a" and "c\0b" are different channels and a
# message with an embedded NUL reaches the callback whole (#4223).

# One subscriber of a channel
struct Subscriber
    callback: fn(StrView, StrView, *u8) -> i32  # (channel, message, ctx)
    context: *u8                          # User-provided context (opaque)

# A channel and its subscribers, oldest first
struct Channel
    name: String                 # Channel name (owned; the index's key views it)
    subscribers: Vec<Subscriber>

fn channel_blank() -> Channel
    Channel { name: string_new(), subscribers: vec_new<Subscriber>() }

# A pattern subscription
struct PatternEntry
    pattern: String              # Glob pattern (owned)
    callback: fn(StrView, StrView, *u8) -> i32
    context: *u8

fn pattern_blank() -> PatternEntry
    PatternEntry { pattern: string_new(), callback: null, context: null }

# The Pub/Sub registry.  Dropping it releases every channel and pattern.
struct PubSub
    channels: Pool<Channel>
    index: HashMap<StrView, i64>  # channel name -> slot in channels
    patterns: Pool<PatternEntry>

# ============================================================================
# Pub/Sub Constructor
# ============================================================================

pub fn pubsub_new() -> PubSub
    PubSub {
        channels: pool_new<Channel>(),
        index: hashmap_new<StrView, i64>(),
        patterns: pool_new<PatternEntry>()
    }

# ============================================================================
# Channel Operations
# ============================================================================

# The channel's slot, made (with no subscribers) if it is new.
fn pubsub_get_or_create_channel(ps: @&PubSub, channel: StrView) -> i64
    match ps.index.get(channel)
        Some(slot) => return slot
        None => pass
    let slot: i64 = ps.channels.insert(Channel { name: string_from_strview(channel), subscribers: vec_new<Subscriber>() })
    ps.index.insert((ps.channels.item(slot).name).as_view(), slot)
    return slot

# The index in subs of the subscriber (callback, context), or -1.
fn subscriber_find(subs: @Vec<Subscriber>, callback: fn(StrView, StrView, *u8) -> i32, context: *u8) -> i64
    for i in 0..subs.len()
        let sub: Subscriber = subs.get(i)
        if sub.callback == callback && sub.context == context
            return i
    return -1

# Remove subs[i], keeping the others in order.
fn subscriber_remove(subs: @&Vec<Subscriber>, i: i64)
    var j: i64 = i
    while j + 1 < subs.len()
        subs.set(j, subs.get(j + 1))
        j += 1
    subs.pop()

# ============================================================================
# Subscribe Operations
# ============================================================================

# Subscribe to a channel with a callback
pub fn pubsub_subscribe(ps: @&PubSub, channel: StrView, callback: fn(StrView, StrView, *u8) -> i32, context: *u8) -> i32
    let slot: i64 = pubsub_get_or_create_channel(ps, channel)
    let ch: @&Channel = ps.channels.at(slot)
    if subscriber_find(@ch.subscribers, callback, context) >= 0
        return 0  # Already subscribed
    ch.subscribers.push(Subscriber { callback: callback, context: context })
    return 1

# Unsubscribe from a channel
pub fn pubsub_unsubscribe(ps: @&PubSub, channel: StrView, callback: fn(StrView, StrView, *u8) -> i32, context: *u8) -> i32
    let slot: i64 = match ps.index.get(channel)
        Some(sl) => sl
        None => return 0
    let ch: @&Channel = ps.channels.at(slot)
    let i: i64 = subscriber_find(@ch.subscribers, callback, context)
    if i < 0
        return 0
    subscriber_remove(@&ch.subscribers, i)
    return 1

# ============================================================================
# Pattern Subscribe Operations
# ============================================================================

# The slot of the subscription (pattern, callback, context), or -1.
fn pubsub_find_pattern(ps: @PubSub, pattern: StrView, callback: fn(StrView, StrView, *u8) -> i32, context: *u8) -> i64
    for i in 0..ps.patterns.slots()
        if ps.patterns.is_live(i)
            let pat: @PatternEntry = ps.patterns.item(i)
            if (pat.pattern).eq_strview(pattern) && pat.callback == callback && pat.context == context
                return i
    return -1

# Subscribe to a pattern (glob-style)
pub fn pubsub_psubscribe(ps: @&PubSub, pattern: StrView, callback: fn(StrView, StrView, *u8) -> i32, context: *u8) -> i32
    if pubsub_find_pattern(ps, pattern, callback, context) >= 0
        return 0  # Already subscribed
    ps.patterns.insert(PatternEntry { pattern: string_from_strview(pattern), callback: callback, context: context })
    return 1

# Unsubscribe from a pattern
pub fn pubsub_punsubscribe(ps: @&PubSub, pattern: StrView, callback: fn(StrView, StrView, *u8) -> i32, context: *u8) -> i32
    let i: i64 = pubsub_find_pattern(ps, pattern, callback, context)
    if i < 0
        return 0
    ps.patterns.remove(i, pattern_blank())
    return 1

# ============================================================================
# Pattern Matching (glob-style)
# ============================================================================

# Match a channel name against a glob pattern, both (ptr, len): a NUL is an
# ordinary byte.  Supports: * (any run of bytes), ? (any single byte)
fn tome_glob_match(pattern: StrView, str: StrView) -> i32
    var p: i64 = 0
    var s: i64 = 0
    var star_p: i64 = -1    # Index after the last * in pattern
    var star_s: i64 = 0     # Index in str when we matched that *

    while s < str.len
        if p < pattern.len && *(pattern.ptr + p) == 42  # '*'
            # Skip consecutive stars
            while p < pattern.len && *(pattern.ptr + p) == 42
                p += 1
            if p == pattern.len
                return 1  # Trailing * matches everything
            star_p = p
            star_s = s
        else if p < pattern.len && (*(pattern.ptr + p) == 63 || *(pattern.ptr + p) == *(str.ptr + s))  # '?' or exact
            p += 1
            s += 1
        else if star_p >= 0
            # Backtrack: try matching * with one more byte
            p = star_p
            star_s += 1
            s = star_s
        else
            return 0  # No match

    # Skip trailing stars in pattern
    while p < pattern.len && *(pattern.ptr + p) == 42
        p += 1

    if p == pattern.len
        return 1
    return 0

# ============================================================================
# Publish Operation
# ============================================================================

# Publish a message to a channel
# Returns number of subscribers that received the message
pub fn pubsub_publish(ps: @&PubSub, channel: StrView, message: StrView) -> i64
    var count: i64 = 0

    # Direct channel subscribers, newest first
    match ps.index.get(channel)
        Some(slot) =>
            let subs: @&Vec<Subscriber> = @&ps.channels.at(slot).subscribers
            var i: i64 = subs.len() - 1
            while i >= 0
                let sub: Subscriber = subs.get(i)
                let cb: fn(StrView, StrView, *u8) -> i32 = sub.callback
                count += 1
                if cb(channel, message, sub.context) != 0
                    # Subscriber wants to unsubscribe
                    subscriber_remove(subs, i)
                i -= 1
        None => pass

    # Pattern subscribers
    for i in 0..ps.patterns.slots()
        if ps.patterns.is_live(i)
            let pat: @PatternEntry = ps.patterns.item(i)
            if tome_glob_match((pat.pattern).as_view(), channel) == 1
                let pcb: fn(StrView, StrView, *u8) -> i32 = pat.callback
                count += 1
                if pcb(channel, message, pat.context) != 0
                    # Subscriber wants to unsubscribe
                    ps.patterns.remove(i, pattern_blank())

    return count

# ============================================================================
# Pub/Sub Query Operations
# ============================================================================

# Get count of subscribers to a specific channel
pub fn pubsub_numsub(ps: @PubSub, channel: StrView) -> i64
    match ps.index.get(channel)
        Some(slot) =>
            let ch: @Channel = ps.channels.item(slot)
            return ch.subscribers.len()
        None => return 0

# Get count of pattern subscriptions
pub fn pubsub_numpat(ps: @PubSub) -> i64
    return ps.patterns.len()

# The channels with subscribers, borrowing the registry's names (lengths
# kept).
pub fn pubsub_channels(ps: @PubSub) -> Vec<StrView>
    var names: Vec<StrView> = vec_new<StrView>()
    for i in 0..ps.channels.slots()
        if ps.channels.is_live(i)
            let ch: @Channel = ps.channels.item(i)
            if ch.subscribers.len() > 0
                names.push((ch.name).as_view())
    return names
