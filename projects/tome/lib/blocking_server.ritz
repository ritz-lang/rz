# lib/blocking_server.ritz - Blocking TCP server for WSL/compatibility
#
# This server uses traditional blocking I/O instead of io_uring.
# It's slower but works on WSL and older Linux kernels.
#
# Architecture:
#   - Single-threaded, synchronous event loop
#   - Blocking accept/recv/send calls
#   - One client at a time (can be extended with fork or threads later)
#
# Usage:
#   var server: BlockingTomeServer
#   blocking_server_init(@&server, 6379)
#   blocking_server_run(@server)

import ritzlib.memory
import ritzlib.str
import ritzlib.string
import ritzlib.strview
import ritzlib.sys
import ritzlib.fd
import ritzlib.span
import ritzlib.result
import ritzlib.io
import ritzlib.fmt
import ritzlib.async_net
import ritzlib.net
import lib.tome
import lib.resp
import lib.commands
import lib.session


# ============================================================================
# Global Configuration (blocking server specific)
# ============================================================================
# Note: For authentication, use blocking_server_set_password() which stores
# the password in a module-local variable. This keeps blocking_server
# independent of the async server module.

var g_blk_password: *u8    # Required password (null = no auth required)
var g_blk_store: *Store = null     # Store for blocking server
var g_blk_running: i32     # Server running flag


# Set server password (call before accepting connections)
pub fn blocking_server_set_password(password: *u8)
    g_blk_password = password


# ============================================================================
# Client Handler
# ============================================================================
# Serves one client until it closes, through a Session (lib/session.ritz):
# every complete command a read delivers is answered, pipelined or not, and
# a command split across reads waits for its tail (AGAST #2457).
# Returns 0 on clean close, negative on error.



fn handle_client(client_fd: i32) -> i32
    let s: *Session = session_new(g_blk_store, g_blk_password)
    if s == null
        return -12  # ENOMEM

    # The connection is the caller's: it closes it after this returns.
    let conn: Fd = fd_borrow(client_fd)
    var ret: i64 = 0
    loop
        session_process(s)

        # Replies go out before the next read: when the output buffer
        # filled, unread commands are still waiting in the input.
        let pending: i64 = session_pending_len(s)
        if pending > 0
            # Fd.write retries EINTR itself.
            var sent: i64 = 0
            match conn.write(Span<u8> { ptr: session_pending_ptr(s), len: pending })
                Ok(n) => sent = n
                Err(e) =>
                    ret = -(e.code() as i64)
                    break
            session_sent(s, sent)
            continue

        if session_should_close(s) != 0
            break

        var n: i64 = 0
        match conn.read(Span<u8> { ptr: session_recv_ptr(s), len: session_recv_room(s) })
            Ok(got) => n = got
            Err(e) =>
                ret = -(e.code() as i64)
                break
        if n == 0
            break  # client closed
        session_received(s, n)

    session_free(s)
    return ret as i32


# ============================================================================
# Server
# ============================================================================

pub struct BlockingTomeServer
    listen_fd: i32
    port: i32


pub fn blocking_server_init(srv: @&BlockingTomeServer, port: i32) -> i32
    srv.port = port

    # Initialize store
    g_blk_store = malloc(sizeof(Store)) as *Store
    *g_blk_store = store_new()
    g_blk_running = 1

    # Create TCP socket
    var sock: Socket
    match socket_tcp()
        Ok(s) => sock = s
        Err(e) => return -e.code()

    # Set socket options
    sock.set_reuseaddr()
    sock.set_reuseport()

    # Bind
    var err: i32 = 0
    match sock.bind("0.0.0.0", port)
        Ok(_) => err = 0
        Err(e) => err = e.code()
    if err != 0
        sock.close()
        return -err

    # Listen
    match sock.listen(128)
        Ok(_) => err = 0
        Err(e) => err = e.code()
    if err != 0
        sock.close()
        return -err

    srv.listen_fd = sock.raw()
    return 0


pub fn blocking_server_run(srv: @BlockingTomeServer) -> i32
    var listen_sock: Socket = socket_from_raw(srv.listen_fd)

    while g_blk_running == 1
        # Accept connection (blocking)
        var client_fd: i32 = 0
        match listen_sock.accept()
            Ok(c) => client_fd = c.raw()
            Err(e) => client_fd = -e.code()
        if client_fd < 0
            # Accept error - continue unless fatal
            if client_fd == -4  # EINTR
                continue
            print("Accept error: {client_fd}\n")
            continue

        # Handle client (blocking - one at a time for now)
        handle_client(client_fd)

        # Close client connection
        var client: Fd = fd_adopt(client_fd)
        client.close()

    return 0


pub fn blocking_server_stop(srv: @BlockingTomeServer)
    g_blk_running = 0


pub fn blocking_server_destroy(srv: @BlockingTomeServer)
    var listener: Fd = fd_adopt(srv.listen_fd)
    listener.close()
