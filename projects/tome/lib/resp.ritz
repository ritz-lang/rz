# lib/resp.ritz - Redis Serialization Protocol (RESP) implementation
#
# RESP is the wire protocol used by Redis. This module implements:
#   - RESP2 parser for incoming commands
#   - RESP2 encoder for responses
#
# RESP Data Types:
#   +<string>\r\n           - Simple String
#   -<error>\r\n            - Error
#   :<integer>\r\n          - Integer
#   $<len>\r\n<data>\r\n    - Bulk String ($-1\r\n for null)
#   *<count>\r\n...         - Array (*-1\r\n for null, elements follow)
#
# Commands arrive as arrays of bulk strings:
#   *3\r\n$3\r\nSET\r\n$3\r\nfoo\r\n$3\r\nbar\r\n  -> ["SET", "foo", "bar"]

import ritzlib.fmt.digits
import ritzlib.span
import ritzlib.str
import ritzlib.string
import ritzlib.strview

# ============================================================================
# Constants
# ============================================================================

const RESP_SIMPLE_STRING: i32 = 43     # '+'
const RESP_ERROR: i32 = 45             # '-'
const RESP_INTEGER: i32 = 58           # ':'
const RESP_BULK_STRING: i32 = 36       # '$'
const RESP_ARRAY: i32 = 42             # '*'

# Parse result codes
const RESP_OK: i32 = 0                 # Complete message parsed
const RESP_INCOMPLETE: i32 = -1        # Need more data
const RESP_ERROR_PARSE: i32 = -2       # Invalid protocol

# Maximum argument count and size for safety
const RESP_MAX_ARGS: i32 = 128
const RESP_MAX_BULK_LEN: i64 = 536870912  # 512MB


# ============================================================================
# Parsed Command
# ============================================================================
# A command is an array of bulk strings (arguments).
# Each is a view of the parser's input, to avoid copying.

struct RespArg
    text: StrView       # The argument's bytes, borrowed from the input

struct RespCommand
    args: [128]RespArg  # Fixed-size array of arguments
    argc: i32           # Number of arguments


# ============================================================================
# RESP Parser
# ============================================================================
# Parser state for incremental parsing across recv() calls.

struct RespParser
    input: StrView      # Bytes being parsed (borrowed)
    pos: i64            # Current parse position
    command: RespCommand # Parsed command output


# Initialize parser over `input` (borrowed: args point into it)
pub fn resp_parser_init(p: *RespParser, input: StrView)
    p.input = input
    p.pos = 0
    p.command.argc = 0


# Reset parser for next command (same buffer)
pub fn resp_parser_reset(p: *RespParser)
    p.pos = 0
    p.command.argc = 0


# Check if there's at least n bytes available
fn resp_available(p: *RespParser, n: i64) -> i32
    if p.pos + n <= p.input.len
        return 1
    return 0


# Read a byte without advancing
fn resp_peek(p: *RespParser) -> i32
    if p.pos >= p.input.len
        return -1
    return p.input.get(p.pos) as i32


# Read a byte and advance
fn resp_read_byte(p: *RespParser) -> i32
    if p.pos >= p.input.len
        return -1
    let c: u8 = p.input.get(p.pos)
    p.pos += 1
    return c as i32


# Skip past \r\n, returns 0 on success, -1 if not found
fn resp_read_crlf(p: *RespParser) -> i32
    if resp_available(p, 2) == 0
        return -1
    let c1: u8 = p.input.get(p.pos)
    let c2: u8 = p.input.get(p.pos + 1)
    if c1 == 13 && c2 == 10  # \r\n
        p.pos += 2
        return 0
    return -1


# A RESP integer, the whole of `text`: '-' and digits only (Redis takes no
# '+'), within i64, read by StrView.parse_i64 (#1958).  Returns 1 and sets
# *out, or 0.
pub fn resp_parse_i64(text: StrView, out: *i64) -> i32
    if text.starts_with("+")
        return 0
    match text.parse_i64()
        Some(n) => resp_set_i64(out, n)
        None => 0

fn resp_set_i64(out: *i64, n: i64) -> i32
    *out = n
    return 1


# A command-line integer (tome-server's --port / --workers, tome-cli's
# --port): the whole of `s` as a RESP integer within [lo, hi].
# Returns 1 and sets *out, or 0.
pub fn tome_parse_int_arg(s: StrView, lo: i64, hi: i64, out: *i64) -> i32
    var n: i64 = 0
    if resp_parse_i64(s, @n) == 0 or n < lo or n > hi
        return 0
    return resp_set_i64(out, n)


# Read an integer from text up to \r\n
# Returns the integer value, advances past \r\n
# Sets *ok to 1 on success, 0 when the buffer ends first (incomplete), and
# -1 on a malformed header (a non-digit, no digits, outside i64, or \r
# without \n).  Telling the last two apart matters: "$x\r\n" used to read
# as incomplete, so a server waited forever for bytes that fixed nothing.
pub fn resp_read_int(p: *RespParser, ok: *i32) -> i64
    *ok = 0
    # Find the \r.  Past i64::MIN's 20 characters, or at a byte no integer
    # holds, it is malformed now rather than incomplete.
    let start: i64 = p.pos
    var end: i64 = start
    loop
        if end >= p.input.len
            return 0  # Incomplete
        let c: u8 = p.input.get(end)
        if c == 13  # \r
            break
        let sign: bool = end == start and c == 45  # leading '-'
        if end - start >= 20 or (not sign and (c < 48 or c > 57))
            *ok = -1
            return 0
        end += 1

    var val: i64 = 0
    if resp_parse_i64(p.input.slice(start, end), @val) == 0
        *ok = -1
        return 0  # No digits, a bare '-', or outside i64
    p.pos = end

    # Expect \r\n
    if resp_available(p, 2) == 0
        return 0  # Incomplete
    if resp_read_crlf(p) < 0
        *ok = -1
        return 0

    *ok = 1
    return val


# Parse a bulk string: $<len>\r\n<data>\r\n
# Returns RESP_OK, RESP_INCOMPLETE, or RESP_ERROR_PARSE
fn resp_parse_bulk(p: *RespParser, arg: *RespArg) -> i32
    let start_pos: i64 = p.pos

    # Skip the $ prefix
    let prefix: i32 = resp_read_byte(p)
    if prefix == -1
        # End of buffer - incomplete
        return RESP_INCOMPLETE
    if prefix != RESP_BULK_STRING
        p.pos = start_pos
        return RESP_ERROR_PARSE

    # Read length
    var ok: i32 = 0
    let len: i64 = resp_read_int(p, @ok)
    if ok != 1
        p.pos = start_pos
        if ok < 0
            return RESP_ERROR_PARSE
        return RESP_INCOMPLETE

    # Null bulk string
    if len == -1
        arg.text = strview_empty()
        return RESP_OK

    # Validate length
    if len < 0 || len > RESP_MAX_BULK_LEN
        return RESP_ERROR_PARSE

    # Check if we have enough data
    if resp_available(p, len + 2) == 0
        p.pos = start_pos
        return RESP_INCOMPLETE

    # Store pointer to data
    arg.text = p.input.slice(p.pos, p.pos + len)
    p.pos += len

    # Expect trailing \r\n
    if resp_read_crlf(p) < 0
        p.pos = start_pos
        return RESP_ERROR_PARSE

    return RESP_OK


# Parse an array: *<count>\r\n followed by bulk strings
# Returns RESP_OK, RESP_INCOMPLETE, or RESP_ERROR_PARSE
pub fn resp_parse(p: *RespParser) -> i32
    let start_pos: i64 = p.pos
    p.command.argc = 0

    # Check for empty buffer
    if p.input.len == 0
        return RESP_INCOMPLETE

    # Expect array prefix
    let prefix: i32 = resp_read_byte(p)
    if prefix != RESP_ARRAY
        # Could be inline command (space-separated)
        p.pos = start_pos
        return resp_parse_inline(p)

    # Read element count
    var ok: i32 = 0
    let count: i64 = resp_read_int(p, @ok)
    if ok != 1
        p.pos = start_pos
        if ok < 0
            return RESP_ERROR_PARSE
        return RESP_INCOMPLETE

    # Null array
    if count == -1
        return RESP_OK

    # Validate count
    if count < 0 || count > RESP_MAX_ARGS as i64
        return RESP_ERROR_PARSE

    # Parse each bulk string element
    for i in 0..count as i32
        let arg: *RespArg = @p.command.args[i]
        let result: i32 = resp_parse_bulk(p, arg)
        if result != RESP_OK
            p.pos = start_pos
            return result
        p.command.argc = i + 1

    return RESP_OK


# Parse inline command (space-separated, no RESP framing)
# Example: "GET foo\r\n" -> ["GET", "foo"]
fn resp_parse_inline(p: *RespParser) -> i32
    let start_pos: i64 = p.pos
    p.command.argc = 0

    # Find the \r\n at end of line
    var end: i64 = p.pos
    while end < p.input.len
        if p.input.get(end) == 13  # \r
            break
        end += 1

    # Check if we found \r\n
    if end >= p.input.len
        return RESP_INCOMPLETE
    if end + 1 >= p.input.len
        return RESP_INCOMPLETE
    if p.input.get(end + 1) != 10  # \n
        return RESP_ERROR_PARSE

    # Parse space-separated tokens
    var token_start: i64 = p.pos
    var in_token: i32 = 0
    var i: i64 = p.pos

    while i < end
        let c: u8 = p.input.get(i)

        if c == 32 || c == 9  # space or tab
            if in_token != 0
                # End of token
                if p.command.argc < RESP_MAX_ARGS
                    let arg: *RespArg = @p.command.args[p.command.argc]
                    arg.text = p.input.slice(token_start, i)
                    p.command.argc += 1
                in_token = 0
        else
            if in_token == 0
                # Start of token
                token_start = i
                in_token = 1
        i += 1

    # Handle last token
    if in_token != 0
        if p.command.argc < RESP_MAX_ARGS
            let arg: *RespArg = @p.command.args[p.command.argc]
            arg.text = p.input.slice(token_start, end)
            p.command.argc += 1

    # Skip past \r\n
    p.pos = end + 2

    return RESP_OK


# ============================================================================
# RESP Encoder
# ============================================================================
# Functions to write RESP-encoded responses into a buffer.

# Each writer puts its frame at the front of `buf` and returns the bytes
# written.  The caller sizes `buf` for the frame (commands.ritz checks each
# reply against its buffer before writing it).

# `text` at buf[at..], then CRLF; returns the position after them.
fn resp_put_line(buf: [u8], at: i64, text: StrView) -> i64
    let dst: [u8] = buf.from(at)
    let n: i64 = dst.copy_from(span_from_strview(text))
    buf[at + n] = 13  # '\r'
    buf[at + n + 1] = 10  # '\n'
    return at + n + 2

# n in decimal at buf[at..], then CRLF; returns the position after them.
fn resp_put_i64_line(buf: [u8], at: i64, n: i64) -> i64
    var tmp: [20]u8
    return resp_put_line(buf, at, fmt_i64_into(@tmp, n))

# Write a simple string: +<string>\r\n
# Returns bytes written
pub fn resp_write_simple(buf: [u8], s: StrView) -> i32
    buf[0] = 43  # '+'
    return resp_put_line(buf, 1, s) as i32


# Write an error: -<error>\r\n
pub fn resp_write_error(buf: [u8], s: StrView) -> i32
    buf[0] = 45  # '-'
    return resp_put_line(buf, 1, s) as i32


# Write an integer: :<integer>\r\n
# Digits come from ritzlib.fmt (AGAST #1932: the old `val = -n` loop wrote
# ":-\r\n" for i64's minimum). buf needs 23 bytes.
pub fn resp_write_i64(buf: [u8], n: i64) -> i32
    buf[0] = 58  # ':'
    return resp_put_i64_line(buf, 1, n) as i32


# Write a bulk string: $<len>\r\n<data>\r\n, every byte of `data`
pub fn resp_write_bulk(buf: [u8], data: StrView) -> i32
    buf[0] = 36  # '$'
    let pos: i64 = resp_put_i64_line(buf, 1, data.len)
    return resp_put_line(buf, pos, data) as i32


# Write null bulk string: $-1\r\n
pub fn resp_write_null(buf: [u8]) -> i32
    return resp_put_line(buf, 0, "$-1") as i32


# Write array header: *<count>\r\n
pub fn resp_write_array(buf: [u8], count: i64) -> i32
    buf[0] = 42  # '*'
    return resp_put_i64_line(buf, 1, count) as i32


# Write null array: *-1\r\n
pub fn resp_write_null_array(buf: [u8]) -> i32
    return resp_put_line(buf, 0, "*-1") as i32


# ============================================================================
# Argument helpers
# ============================================================================

# Compare an argument to a StrView (case-insensitive)
pub fn resp_arg_eq_ci(arg: *RespArg, s: StrView) -> i32
    if arg.text.len != s.len
        return 0

    for i in 0..s.len
        var a: u8 = arg.text.get(i)
        var b: u8 = s.get(i)
        # Convert to uppercase
        if a >= 97 && a <= 122
            a = a - 32
        if b >= 97 && b <= 122
            b = b - 32
        if a != b
            return 0
    return 1


# Compare an argument to a StrView (exact match)
pub fn resp_arg_eq(arg: *RespArg, s: StrView) -> i32
    if resp_arg_sv(arg).eq(s)
        return 1
    return 0


# View an argument in place: every byte of it, NULs included, and no
# length cap.  Borrows the parser's input, so it lives as long as that.
# Command handlers use this for keys/values (AGAST #3069).
pub fn resp_arg_sv(arg: *RespArg) -> StrView
    return arg.text


# Parse argument as integer (returns 0 on parse error, ok=1 on success)
pub fn resp_arg_to_int(arg: *RespArg, ok: *i32) -> i64
    var val: i64 = 0
    *ok = resp_parse_i64(resp_arg_sv(arg), @val)
    return val


