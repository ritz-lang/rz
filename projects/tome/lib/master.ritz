# lib/master.ritz - Multi-process master server
#
# Implements a master process that spawns and manages worker processes.
# Each worker runs its own io_uring event loop with SO_REUSEPORT for
# kernel-level load balancing.
#
# Architecture:
#   Master Process
#     - Spawns N worker processes (default: CPU count)
#     - Monitors workers via waitpid (WNOHANG)
#     - Restarts crashed workers
#     - Handles SIGTERM/SIGINT for graceful shutdown
#
#   Worker Processes
#     - Each has its own Store (partitioned data)
#     - Each has its own io_uring event loop
#     - SO_REUSEPORT allows kernel to load-balance connections

import ritzlib.sys
import ritzlib.fd
import ritzlib.process { fork, kill, wait_pid, try_wait_pid, process_id }
import ritzlib.time { sleep_ms }
import ritzlib.option
import ritzlib.result
import ritzlib.errno
import ritzlib.io
import ritzlib.fmt
import ritzlib.str
import ritzlib.async_net
import lib.server


# ============================================================================
# Constants
# ============================================================================

const MAX_WORKERS: i32 = 8
const MASTER_DEFAULT_WORKERS: i32 = 4

# Worker states
const WORKER_STOPPED: i32 = 0
const WORKER_RUNNING: i32 = 1
const WORKER_STOPPING: i32 = 2


# ============================================================================
# Global shutdown flag (set by signal handler)
# ============================================================================

var g_shutdown: i32 = 0
var g_master_pid: i32 = 0


# ============================================================================
# Worker tracking
# ============================================================================

struct WorkerInfo
    pid: i32           # Process ID (0 if not running)
    state: i32         # WORKER_* state
    restarts: i32      # Number of times restarted


struct MasterServer
    port: i32
    num_workers: i32
    workers: [8]WorkerInfo  # Fixed array of worker info
    listen_fd: i32           # Shared listening socket


# ============================================================================
# Signal handling
# ============================================================================

# Signal handler for SIGTERM/SIGINT - just sets flag
# Note: We can't use a complex signal handler in Ritz yet,
# so we use a polling approach with WNOHANG

pub fn master_check_signals() -> i32
    # In a real implementation, we'd install a signal handler
    # that sets g_shutdown = 1. For now, we rely on the master
    # polling for child exits and checking if it should stop.
    return g_shutdown


pub fn master_request_shutdown()
    g_shutdown = 1


# ============================================================================
# Worker process
# ============================================================================

# This runs in the worker process after fork
fn worker_main(port: i32, listen_fd: i32, worker_id: i32) -> i32
    let worker_pid: i64 = process_id() as i64
    print("Worker {worker_id} (PID {worker_pid}) starting...\n")

    # Each worker has its own server and store
    var server: TomeServer
    match tome_server_init_with_fd(@&server, port, listen_fd)
        Ok(_) => pass
        Err(e) => return worker_init_failed(worker_id, e)

    print("Worker {worker_id}: Ready\n")

    # Run event loop (blocks until shutdown/error)
    let ran: Result<(), Errno> = tome_server_run(@&server)
    tome_server_destroy(@&server)
    match ran
        Ok(_) => 0
        Err(_) => 1


# A worker whose server could not start: say why; its exit status is 1.
fn worker_init_failed(worker_id: i32, e: Errno) -> i32
    print("Worker {worker_id}: Failed to initialize ({e.name()})\n")
    1


# ============================================================================
# Master initialization
# ============================================================================

pub fn master_init(m: *MasterServer, port: i32, num_workers: i32) -> i32
    m.port = port

    # Clamp worker count
    if num_workers <= 0
        m.num_workers = MASTER_DEFAULT_WORKERS
    else if num_workers > MAX_WORKERS
        m.num_workers = MAX_WORKERS
    else
        m.num_workers = num_workers

    # Initialize worker slots
    var i: i32 = 0
    while i < MAX_WORKERS
        m.workers[i].pid = 0
        m.workers[i].state = WORKER_STOPPED
        m.workers[i].restarts = 0
        i += 1

    # Create shared listening socket with SO_REUSEPORT
    # All workers will inherit this fd after fork
    var sock: Socket
    match socket_tcp()
        Ok(s) => sock = s
        Err(e) => return -e.code()

    sock.set_reuseaddr()
    sock.set_reuseport()  # Critical for multi-process load balancing

    var err: i32 = 0
    match sock.bind("0.0.0.0", port)
        Ok(_) => err = 0
        Err(e) => err = e.code()
    if err != 0
        sock.close()
        return -err

    match sock.listen(128)
        Ok(_) => err = 0
        Err(e) => err = e.code()
    if err != 0
        sock.close()
        return -err

    m.listen_fd = sock.raw()
    g_master_pid = process_id()
    g_shutdown = 0

    return 0


# ============================================================================
# Worker spawning
# ============================================================================

fn spawn_worker(m: *MasterServer, worker_id: i32) -> i32
    # Copy values before fork (to avoid any potential pointer issues in child)
    let port: i32 = m.port
    let listen_fd: i32 = m.listen_fd

    var pid: i32 = 0
    match fork()
        Ok(fr) =>
            match fr
                Child =>
                    # Become a worker; never returns
                    sys_exit(worker_main(port, listen_fd, worker_id))
                Parent(child) => pid = child
        Err(e) =>
            print("Failed to fork worker {worker_id}\n")
            return -e.code()

    # Parent process - record worker info
    m.workers[worker_id].pid = pid
    m.workers[worker_id].state = WORKER_RUNNING
    return pid


pub fn master_spawn_workers(m: *MasterServer) -> i32
    print("Spawning {m.num_workers} workers...\n")

    var i: i32 = 0
    while i < m.num_workers
        let pid: i32 = spawn_worker(m, i)
        if pid < 0
            return pid
        i += 1

    return 0


# ============================================================================
# Worker monitoring
# ============================================================================

# How child `pid` exited, reaping it; None while it still runs (or if there
# is nothing to wait for).
fn reap_worker(pid: i32) -> Option<ProcessResult>
    match try_wait_pid(pid)
        Ok(o) => o
        Err(_) => None

# True once child `pid` has exited (reaping it).
fn worker_reaped(pid: i32) -> bool
    let r: Option<ProcessResult> = reap_worker(pid)
    option_is_some<ProcessResult>(@r)

# Log how worker `i` exited.
fn report_worker_exit(m: *MasterServer, i: i32, pr: @ProcessResult)
    print("Worker {i} (PID {m.workers[i].pid}) exited")
    if pr.signaled != 0
        print(" (signal {pr.signal})")
    else
        print(" (code {pr.exit_code})")
    print("\n")

# Check for exited workers and restart them
pub fn master_check_workers(m: *MasterServer) -> i32
    var restarted: i32 = 0

    # Check each worker slot
    var i: i32 = 0
    while i < m.num_workers
        if m.workers[i].state == WORKER_RUNNING
            # Check if this worker has exited (non-blocking)
            var exited: bool = false
            match reap_worker(m.workers[i].pid)
                Some(pr) =>
                    report_worker_exit(m, i, @pr)
                    exited = true
                None => pass

            if exited
                m.workers[i].state = WORKER_STOPPED
                m.workers[i].pid = 0

                # Restart unless we're shutting down
                if g_shutdown == 0
                    m.workers[i].restarts += 1
                    print("Restarting worker {i} (restart #{m.workers[i].restarts})...\n")

                    spawn_worker(m, i)
                    restarted += 1
        i += 1

    return restarted


# ============================================================================
# Graceful shutdown
# ============================================================================

pub fn master_shutdown(m: *MasterServer)
    prints("Shutting down workers...\n")
    g_shutdown = 1

    # Send SIGTERM to all workers
    var i: i32 = 0
    while i < m.num_workers
        if m.workers[i].state == WORKER_RUNNING
            kill(m.workers[i].pid, SIGTERM)
            m.workers[i].state = WORKER_STOPPING
        i += 1

    # Wait for all workers to exit (with timeout)
    var remaining: i32 = m.num_workers
    var attempts: i32 = 0
    let max_attempts: i32 = 50  # 5 seconds max

    while remaining > 0 && attempts < max_attempts
        remaining = 0
        i = 0
        while i < m.num_workers
            if m.workers[i].state != WORKER_STOPPED
                if worker_reaped(m.workers[i].pid)
                    m.workers[i].state = WORKER_STOPPED
                    m.workers[i].pid = 0
                else
                    remaining += 1
            i += 1

        if remaining > 0
            sleep_ms(100)
            attempts += 1

    # Force kill any remaining workers
    if remaining > 0
        print("Force killing {remaining} workers...\n")

        i = 0
        while i < m.num_workers
            if m.workers[i].state != WORKER_STOPPED
                kill(m.workers[i].pid, SIGKILL)
                # Reap the zombie
                wait_pid(m.workers[i].pid)
                m.workers[i].state = WORKER_STOPPED
                m.workers[i].pid = 0
            i += 1

    prints("All workers stopped.\n")


# ============================================================================
# Cleanup
# ============================================================================

pub fn master_destroy(m: *MasterServer)
    if m.listen_fd >= 0
        var listener: Fd = fd_adopt(m.listen_fd)
        listener.close()
        m.listen_fd = -1


# ============================================================================
# Main loop
# ============================================================================

pub fn master_run(m: *MasterServer) -> i32
    let master_pid: i64 = process_id() as i64
    print("Master process (PID {master_pid}) monitoring workers...\n")
    prints("Press Ctrl+C to stop.\n\n")

    # Monitor loop - check workers every 100ms
    while g_shutdown == 0
        master_check_workers(m)

        sleep_ms(100)

    return 0
