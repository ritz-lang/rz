# lib/commands.ritz - Command dispatcher for Tome
#
# Maps RESP commands to Store operations. Each command handler
# takes a parsed RespCommand and writes the response to a buffer.
#
# Supported commands:
#   String: GET, SET, SETEX, DEL, EXISTS, TTL, EXPIRE, PERSIST,
#           INCR, DECR, INCRBY, DECRBY
#   List:   LPUSH, RPUSH, LPOP, RPOP, LLEN, LINDEX, LRANGE
#   Set:    SADD, SREM, SISMEMBER, SCARD, SMEMBERS
#   Hash:   HSET, HGET, HDEL, HEXISTS, HLEN, HKEYS, HVALS, HGETALL
#   ZSet:   ZADD, ZREM, ZSCORE, ZRANK, ZREVRANK, ZCARD, ZRANGE, ZREVRANGE
#   Server: PING, ECHO, COMMAND, INFO, DBSIZE, FLUSHDB

import ritzlib.ct
import ritzlib.fmt
import ritzlib.memory
import ritzlib.str
import ritzlib.string
import ritzlib.strview
import lib.tome
import lib.resp


# ============================================================================
# Command result codes
# ============================================================================

const CMD_OK: i32 = 0           # Command executed successfully
const CMD_ERR_ARGC: i32 = -1    # Wrong number of arguments
const CMD_ERR_TYPE: i32 = -2    # Wrong type for operation
const CMD_ERR_SYNTAX: i32 = -3  # Syntax error
const CMD_ERR_UNKNOWN: i32 = -4 # Unknown command


# ============================================================================
# Command Context
# ============================================================================
# Holds the store and response buffer for command execution.

struct CommandContext
    store: *Store
    resp_buf: *u8       # Response output buffer
    resp_len: i32       # Length of response written
    resp_cap: i32       # Capacity of buffer
    password: *u8       # Required password (null = no auth required)
    is_authenticated: i32   # 1 if client is authenticated, 0 otherwise
    overflow: i32       # 1 if the reply did not fit resp_cap (see ctx_too_large)


# Initialize command context (no auth - backwards compatible)
pub fn cmd_ctx_init(ctx: *CommandContext, store: *Store, buf: *u8, cap: i32)
    ctx.store = store
    ctx.resp_buf = buf
    ctx.resp_len = 0
    ctx.resp_cap = cap
    ctx.password = null
    ctx.is_authenticated = 1  # No auth required = already authenticated
    ctx.overflow = 0


# Initialize command context with authentication
pub fn cmd_ctx_init_auth(ctx: *CommandContext, store: *Store, buf: *u8, cap: i32, password: *u8, is_authenticated: i32)
    ctx.store = store
    ctx.resp_buf = buf
    ctx.resp_len = 0
    ctx.resp_cap = cap
    ctx.password = password
    ctx.is_authenticated = is_authenticated
    ctx.overflow = 0


# Every reply goes through these helpers, and each one checks that the
# whole reply fits resp_cap before writing a byte of it (AGAST #3068: list
# replies such as SMEMBERS had no bound and ran off the end of the buffer).
# A reply that does not fit becomes ctx_too_large's error instead.

# Upper bound on a RESP frame with `len` payload bytes: a type byte, up to
# 20 length digits plus a sign, and two CRLFs.
const RESP_FRAME_OVERHEAD: i64 = 26

fn ctx_fits(ctx: *CommandContext, payload: i64) -> bool
    return payload + RESP_FRAME_OVERHEAD <= ctx.resp_cap as i64

# Answer "-ERR reply too large" and flag the overflow.  A session that has
# other replies queued uses the flag to retry the command once they are
# sent (session_process), so only replies bigger than the whole output
# buffer reach the client as this error.
fn ctx_too_large(ctx: *CommandContext)
    ctx.overflow = 1
    let err: StrView = "ERR reply too large"
    if ctx_fits(ctx, err.len)
        ctx.resp_len = resp_write_error_sv(ctx.resp_buf, err)
    else
        ctx.resp_len = 0

# Write response helpers (C-string versions - for FFI compatibility)
fn ctx_write_simple(ctx: *CommandContext, s: *u8)
    if not ctx_fits(ctx, strlen(s))
        ctx_too_large(ctx)
        return
    ctx.resp_len = resp_write_simple(ctx.resp_buf, s)

fn ctx_write_error(ctx: *CommandContext, s: *u8)
    if not ctx_fits(ctx, strlen(s))
        ctx_too_large(ctx)
        return
    ctx.resp_len = resp_write_error(ctx.resp_buf, s)

# Write response helpers (StrView versions - preferred)
fn ctx_write_simple_sv(ctx: *CommandContext, s: StrView)
    if not ctx_fits(ctx, s.len)
        ctx_too_large(ctx)
        return
    ctx.resp_len = resp_write_simple_sv(ctx.resp_buf, s)

fn ctx_write_error_sv(ctx: *CommandContext, s: StrView)
    if not ctx_fits(ctx, s.len)
        ctx_too_large(ctx)
        return
    ctx.resp_len = resp_write_error_sv(ctx.resp_buf, s)

fn ctx_write_int(ctx: *CommandContext, n: i64)
    if not ctx_fits(ctx, 0)
        ctx_too_large(ctx)
        return
    ctx.resp_len = resp_write_i64(ctx.resp_buf, n)

fn ctx_write_bulk(ctx: *CommandContext, data: *u8, len: i64)
    if not ctx_fits(ctx, len)
        ctx_too_large(ctx)
        return
    ctx.resp_len = resp_write_bulk(ctx.resp_buf, data, len)

fn ctx_write_null(ctx: *CommandContext)
    if not ctx_fits(ctx, 0)
        ctx_too_large(ctx)
        return
    ctx.resp_len = resp_write_null(ctx.resp_buf)

# Write an array of `count` bulk strings, each its view's whole (ptr, len),
# embedded NULs included (AGAST #4210), then free the `items` array (the
# bytes are borrowed).  The size of the whole reply is checked before
# anything is written.
fn ctx_write_bulk_array(ctx: *CommandContext, items: *StrView, count: i64)
    var need: i64 = RESP_FRAME_OVERHEAD
    for i in 0..count
        need += items[i].len + RESP_FRAME_OVERHEAD
    if need > ctx.resp_cap as i64
        ctx_too_large(ctx)
    else
        var pos: i32 = resp_write_array(ctx.resp_buf, count)
        for i in 0..count
            let v: StrView = items[i]
            pos += resp_write_bulk(ctx.resp_buf + pos, v.ptr, v.len)
        ctx.resp_len = pos
    if items != null
        free(items as *u8)


# ============================================================================
# Individual Command Handlers
# ============================================================================

# PING [message]
fn cmd_ping(ctx: *CommandContext, cmd: *RespCommand) -> i32
    if cmd.argc == 1
        let pong: StrView = "PONG"
        ctx_write_simple_sv(ctx, pong)
        return CMD_OK
    if cmd.argc == 2
        let arg: *RespArg = @cmd.args[1]
        ctx_write_bulk(ctx, arg.data, arg.len)
        return CMD_OK
    let err: StrView = "ERR wrong number of arguments for 'ping' command"
    ctx_write_error_sv(ctx, err)
    return CMD_ERR_ARGC


# ECHO message
fn cmd_echo(ctx: *CommandContext, cmd: *RespCommand) -> i32
    if cmd.argc != 2
        let err: StrView = "ERR wrong number of arguments for 'echo' command"
        ctx_write_error_sv(ctx, err)
        return CMD_ERR_ARGC
    let arg: *RespArg = @cmd.args[1]
    ctx_write_bulk(ctx, arg.data, arg.len)
    return CMD_OK


# GET key
fn cmd_get(ctx: *CommandContext, cmd: *RespCommand) -> i32
    if cmd.argc != 2
        let err: StrView = "ERR wrong number of arguments for 'get' command"
        ctx_write_error_sv(ctx, err)
        return CMD_ERR_ARGC

    var key_sv: StrView = resp_arg_sv(@cmd.args[1])

    # By (ptr, len): a value may hold NULs.  ptr is null only on a miss.
    let val: StrView = store_get_strview(ctx.store, key_sv)
    if val.ptr == null
        ctx_write_null(ctx)
    else
        ctx_write_bulk(ctx, val.ptr, val.len)
    return CMD_OK


# SET key value
fn cmd_set(ctx: *CommandContext, cmd: *RespCommand) -> i32
    if cmd.argc < 3
        let err: StrView = "ERR wrong number of arguments for 'set' command"
        ctx_write_error_sv(ctx, err)
        return CMD_ERR_ARGC

    var key_sv: StrView = resp_arg_sv(@cmd.args[1])
    var val_sv: StrView = resp_arg_sv(@cmd.args[2])

    store_set(ctx.store, key_sv, val_sv)
    let ok: StrView = "OK"
    ctx_write_simple_sv(ctx, ok)
    return CMD_OK


# INCR / DECR / INCRBY / DECRBY: add `delta` to the integer stored at
# args[1].  A missing key counts from 0; the TTL of an existing key stays.
fn incr_by(ctx: *CommandContext, cmd: *RespCommand, delta: i64) -> i32
    var key_sv: StrView = resp_arg_sv(@cmd.args[1])

    var cur: i64 = 0
    let val: StrView = store_get_strview(ctx.store, key_sv)
    if val.ptr == null
        # store_get_strview answers null for a missing key and a non-string alike.
        if store_exists(ctx.store, key_sv) == 1
            let wrongtype: StrView = "WRONGTYPE Operation against a key holding the wrong kind of value"
            ctx_write_error_sv(ctx, wrongtype)
            return CMD_ERR_TYPE
    else if resp_parse_i64(val.ptr, val.len, @cur) == 0
        let err: StrView = "ERR value is not an integer or out of range"
        ctx_write_error_sv(ctx, err)
        return CMD_ERR_SYNTAX

    let max: i64 = 9223372036854775807
    let min: i64 = -9223372036854775807 - 1
    if (delta > 0 and cur > max - delta) or (delta < 0 and cur < min - delta)
        let err: StrView = "ERR increment or decrement would overflow"
        ctx_write_error_sv(ctx, err)
        return CMD_ERR_SYNTAX
    let next: i64 = cur + delta

    var digits: [24]u8
    let n: i64 = fmt_i64_into(@digits[0], next)
    digits[n] = 0
    var next_sv: StrView = strview_from_cstr(@digits[0])
    store_set(ctx.store, key_sv, next_sv)
    ctx_write_int(ctx, next)
    return CMD_OK


# INCR key / DECR key
fn cmd_incr(ctx: *CommandContext, cmd: *RespCommand, delta: i64, name: *u8) -> i32
    if cmd.argc != 2
        var err: [96]u8
        argc_error(@err[0], name)
        ctx_write_error(ctx, @err[0])
        return CMD_ERR_ARGC
    return incr_by(ctx, cmd, delta)


# INCRBY key increment / DECRBY key decrement (sign is -1 for DECRBY)
fn cmd_incrby(ctx: *CommandContext, cmd: *RespCommand, sign: i64, name: *u8) -> i32
    if cmd.argc != 3
        var err: [96]u8
        argc_error(@err[0], name)
        ctx_write_error(ctx, @err[0])
        return CMD_ERR_ARGC
    var by: i64 = 0
    let arg: *RespArg = @cmd.args[2]
    if resp_parse_i64(arg.data, arg.len, @by) == 0
        let err: StrView = "ERR value is not an integer or out of range"
        ctx_write_error_sv(ctx, err)
        return CMD_ERR_SYNTAX
    if sign < 0
        let min: i64 = -9223372036854775807 - 1
        if by == min
            let err: StrView = "ERR decrement would overflow"
            ctx_write_error_sv(ctx, err)
            return CMD_ERR_SYNTAX
        by = -by
    return incr_by(ctx, cmd, by)


# Write "ERR wrong number of arguments for '<name>' command" (NUL-terminated)
# into buf (>= 96 bytes; names are short literals).  Returns its length.
fn argc_error(buf: *u8, name: *u8) -> i32
    let head: *u8 = c"ERR wrong number of arguments for '"
    let tail: *u8 = c"' command"
    var pos: i64 = 0
    let hl: i64 = strlen(head)
    memcpy(buf, head, hl)
    pos += hl
    let nl: i64 = strlen(name)
    memcpy(buf + pos, name, nl)
    pos += nl
    let tl: i64 = strlen(tail)
    memcpy(buf + pos, tail, tl)
    pos += tl
    *(buf + pos) = 0
    return pos as i32


# SETEX key seconds value
fn cmd_setex(ctx: *CommandContext, cmd: *RespCommand) -> i32
    if cmd.argc != 4
        let err: StrView = "ERR wrong number of arguments for 'setex' command"
        ctx_write_error_sv(ctx, err)
        return CMD_ERR_ARGC

    var key_sv: StrView = resp_arg_sv(@cmd.args[1])
    var val_sv: StrView = resp_arg_sv(@cmd.args[3])

    var ok: i32 = 0
    let ttl: i64 = resp_arg_to_int(@cmd.args[2], @ok)
    if ok == 0 || ttl <= 0
        let err: StrView = "ERR invalid expire time in 'setex' command"
        ctx_write_error_sv(ctx, err)
        return CMD_ERR_SYNTAX

    store_setex(ctx.store, key_sv, val_sv, ttl)
    let reply: StrView = "OK"
    ctx_write_simple_sv(ctx, reply)
    return CMD_OK


# DEL key [key ...]
fn cmd_del(ctx: *CommandContext, cmd: *RespCommand) -> i32
    if cmd.argc < 2
        let err: StrView = "ERR wrong number of arguments for 'del' command"
        ctx_write_error_sv(ctx, err)
        return CMD_ERR_ARGC

    var count: i64 = 0
    for i in 1..cmd.argc
        var key_sv: StrView = resp_arg_sv(@cmd.args[i])
        let deleted: i32 = store_del(ctx.store, key_sv)
        if deleted == 1
            count += 1

    ctx_write_int(ctx, count)
    return CMD_OK


# EXISTS key [key ...]
fn cmd_exists(ctx: *CommandContext, cmd: *RespCommand) -> i32
    if cmd.argc < 2
        let err: StrView = "ERR wrong number of arguments for 'exists' command"
        ctx_write_error_sv(ctx, err)
        return CMD_ERR_ARGC

    var count: i64 = 0
    for i in 1..cmd.argc
        var key_sv: StrView = resp_arg_sv(@cmd.args[i])
        if store_exists(ctx.store, key_sv) == 1
            count += 1

    ctx_write_int(ctx, count)
    return CMD_OK


# TTL key
fn cmd_ttl(ctx: *CommandContext, cmd: *RespCommand) -> i32
    if cmd.argc != 2
        let err: StrView = "ERR wrong number of arguments for 'ttl' command"
        ctx_write_error_sv(ctx, err)
        return CMD_ERR_ARGC

    var key_sv: StrView = resp_arg_sv(@cmd.args[1])

    let ttl: i64 = store_ttl(ctx.store, key_sv)
    ctx_write_int(ctx, ttl)
    return CMD_OK


# EXPIRE key seconds
fn cmd_expire(ctx: *CommandContext, cmd: *RespCommand) -> i32
    if cmd.argc != 3
        let err: StrView = "ERR wrong number of arguments for 'expire' command"
        ctx_write_error_sv(ctx, err)
        return CMD_ERR_ARGC

    var key_sv: StrView = resp_arg_sv(@cmd.args[1])

    var ok: i32 = 0
    let ttl: i64 = resp_arg_to_int(@cmd.args[2], @ok)
    if ok == 0 || ttl <= 0
        let err: StrView = "ERR invalid expire time in 'expire' command"
        ctx_write_error_sv(ctx, err)
        return CMD_ERR_SYNTAX

    let result: i32 = store_expire(ctx.store, key_sv, ttl)
    ctx_write_int(ctx, result as i64)
    return CMD_OK


# PERSIST key
fn cmd_persist(ctx: *CommandContext, cmd: *RespCommand) -> i32
    if cmd.argc != 2
        let err: StrView = "ERR wrong number of arguments for 'persist' command"
        ctx_write_error_sv(ctx, err)
        return CMD_ERR_ARGC

    var key_sv: StrView = resp_arg_sv(@cmd.args[1])

    let result: i32 = store_persist(ctx.store, key_sv)
    ctx_write_int(ctx, result as i64)
    return CMD_OK


# ============================================================================
# List Commands
# ============================================================================

# LPUSH key value [value ...]
fn cmd_lpush(ctx: *CommandContext, cmd: *RespCommand) -> i32
    if cmd.argc < 3
        let err: StrView = "ERR wrong number of arguments for 'lpush' command"
        ctx_write_error_sv(ctx, err)
        return CMD_ERR_ARGC

    var key_sv: StrView = resp_arg_sv(@cmd.args[1])

    var len: i64 = -1
    for i in 2..cmd.argc
        var val_sv: StrView = resp_arg_sv(@cmd.args[i])
        len = store_lpush(ctx.store, key_sv, val_sv)
        if len < 0
            let wrongtype: StrView = "WRONGTYPE Operation against a key holding the wrong kind of value"
            ctx_write_error_sv(ctx, wrongtype)
            return CMD_ERR_TYPE

    ctx_write_int(ctx, len)
    return CMD_OK


# RPUSH key value [value ...]
fn cmd_rpush(ctx: *CommandContext, cmd: *RespCommand) -> i32
    if cmd.argc < 3
        let err: StrView = "ERR wrong number of arguments for 'rpush' command"
        ctx_write_error_sv(ctx, err)
        return CMD_ERR_ARGC

    var key_sv: StrView = resp_arg_sv(@cmd.args[1])

    var len: i64 = -1
    for i in 2..cmd.argc
        var val_sv: StrView = resp_arg_sv(@cmd.args[i])
        len = store_rpush(ctx.store, key_sv, val_sv)
        if len < 0
            let wrongtype: StrView = "WRONGTYPE Operation against a key holding the wrong kind of value"
            ctx_write_error_sv(ctx, wrongtype)
            return CMD_ERR_TYPE

    ctx_write_int(ctx, len)
    return CMD_OK


# LPOP key
fn cmd_lpop(ctx: *CommandContext, cmd: *RespCommand) -> i32
    if cmd.argc != 2
        let err: StrView = "ERR wrong number of arguments for 'lpop' command"
        ctx_write_error_sv(ctx, err)
        return CMD_ERR_ARGC

    var key_sv: StrView = resp_arg_sv(@cmd.args[1])

    var result: String = store_lpop(ctx.store, key_sv)
    if string_len(@result) == 0
        ctx_write_null(ctx)
    else
        let vlen: i64 = string_len(@result)
        ctx_write_bulk(ctx, string_as_ptr(@&result), vlen)
    string_drop(@&result)
    return CMD_OK


# RPOP key
fn cmd_rpop(ctx: *CommandContext, cmd: *RespCommand) -> i32
    if cmd.argc != 2
        let err: StrView = "ERR wrong number of arguments for 'rpop' command"
        ctx_write_error_sv(ctx, err)
        return CMD_ERR_ARGC

    var key_sv: StrView = resp_arg_sv(@cmd.args[1])

    var result: String = store_rpop(ctx.store, key_sv)
    if string_len(@result) == 0
        ctx_write_null(ctx)
    else
        let vlen: i64 = string_len(@result)
        ctx_write_bulk(ctx, string_as_ptr(@&result), vlen)
    string_drop(@&result)
    return CMD_OK


# LLEN key
fn cmd_llen(ctx: *CommandContext, cmd: *RespCommand) -> i32
    if cmd.argc != 2
        let err: StrView = "ERR wrong number of arguments for 'llen' command"
        ctx_write_error_sv(ctx, err)
        return CMD_ERR_ARGC

    var key_sv: StrView = resp_arg_sv(@cmd.args[1])

    let len: i64 = store_llen(ctx.store, key_sv)
    if len < 0
        let wrongtype: StrView = "WRONGTYPE Operation against a key holding the wrong kind of value"
        ctx_write_error_sv(ctx, wrongtype)
        return CMD_ERR_TYPE

    ctx_write_int(ctx, len)
    return CMD_OK


# LINDEX key index
fn cmd_lindex(ctx: *CommandContext, cmd: *RespCommand) -> i32
    if cmd.argc != 3
        let err: StrView = "ERR wrong number of arguments for 'lindex' command"
        ctx_write_error_sv(ctx, err)
        return CMD_ERR_ARGC

    var key_sv: StrView = resp_arg_sv(@cmd.args[1])

    var ok: i32 = 0
    let idx: i64 = resp_arg_to_int(@cmd.args[2], @ok)
    if ok == 0
        let notint: StrView = "ERR value is not an integer or out of range"
        ctx_write_error_sv(ctx, notint)
        return CMD_ERR_SYNTAX

    let val: StrView = store_lindex(ctx.store, key_sv, idx)
    if val.ptr == null
        ctx_write_null(ctx)
    else
        ctx_write_bulk(ctx, val.ptr, val.len)
    return CMD_OK


# LRANGE key start stop
fn cmd_lrange(ctx: *CommandContext, cmd: *RespCommand) -> i32
    if cmd.argc != 4
        let err: StrView = "ERR wrong number of arguments for 'lrange' command"
        ctx_write_error_sv(ctx, err)
        return CMD_ERR_ARGC

    var key_sv: StrView = resp_arg_sv(@cmd.args[1])

    var ok: i32 = 0
    let start: i64 = resp_arg_to_int(@cmd.args[2], @ok)
    if ok == 0
        let notint: StrView = "ERR value is not an integer or out of range"
        ctx_write_error_sv(ctx, notint)
        return CMD_ERR_SYNTAX

    let stop: i64 = resp_arg_to_int(@cmd.args[3], @ok)
    if ok == 0
        let notint2: StrView = "ERR value is not an integer or out of range"
        ctx_write_error_sv(ctx, notint2)
        return CMD_ERR_SYNTAX

    var count: i64 = 0
    let results: *StrView = store_lrange(ctx.store, key_sv, start, stop, @&count)

    ctx_write_bulk_array(ctx, results, count)
    return CMD_OK


# ============================================================================
# Set Commands
# ============================================================================

# SADD key member [member ...]
fn cmd_sadd(ctx: *CommandContext, cmd: *RespCommand) -> i32
    if cmd.argc < 3
        let err: StrView = "ERR wrong number of arguments for 'sadd' command"
        ctx_write_error_sv(ctx, err)
        return CMD_ERR_ARGC

    var key_sv: StrView = resp_arg_sv(@cmd.args[1])

    var added: i64 = 0
    for i in 2..cmd.argc
        var member_sv: StrView = resp_arg_sv(@cmd.args[i])
        let ret: i64 = store_sadd(ctx.store, key_sv, member_sv)
        if ret < 0
            let wrongtype: StrView = "WRONGTYPE Operation against a key holding the wrong kind of value"
            ctx_write_error_sv(ctx, wrongtype)
            return CMD_ERR_TYPE
        added += ret

    ctx_write_int(ctx, added)
    return CMD_OK


# SREM key member [member ...]
fn cmd_srem(ctx: *CommandContext, cmd: *RespCommand) -> i32
    if cmd.argc < 3
        let err: StrView = "ERR wrong number of arguments for 'srem' command"
        ctx_write_error_sv(ctx, err)
        return CMD_ERR_ARGC

    var key_sv: StrView = resp_arg_sv(@cmd.args[1])

    var removed: i64 = 0
    for i in 2..cmd.argc
        var member_sv: StrView = resp_arg_sv(@cmd.args[i])
        let ret: i64 = store_srem(ctx.store, key_sv, member_sv)
        if ret < 0
            let wrongtype: StrView = "WRONGTYPE Operation against a key holding the wrong kind of value"
            ctx_write_error_sv(ctx, wrongtype)
            return CMD_ERR_TYPE
        removed += ret

    ctx_write_int(ctx, removed)
    return CMD_OK


# SISMEMBER key member
fn cmd_sismember(ctx: *CommandContext, cmd: *RespCommand) -> i32
    if cmd.argc != 3
        let err: StrView = "ERR wrong number of arguments for 'sismember' command"
        ctx_write_error_sv(ctx, err)
        return CMD_ERR_ARGC

    var key_sv: StrView = resp_arg_sv(@cmd.args[1])
    var member_sv: StrView = resp_arg_sv(@cmd.args[2])

    let result: i32 = store_sismember(ctx.store, key_sv, member_sv)
    if result < 0
        let wrongtype: StrView = "WRONGTYPE Operation against a key holding the wrong kind of value"
        ctx_write_error_sv(ctx, wrongtype)
        return CMD_ERR_TYPE

    ctx_write_int(ctx, result as i64)
    return CMD_OK


# SCARD key
fn cmd_scard(ctx: *CommandContext, cmd: *RespCommand) -> i32
    if cmd.argc != 2
        let err: StrView = "ERR wrong number of arguments for 'scard' command"
        ctx_write_error_sv(ctx, err)
        return CMD_ERR_ARGC

    var key_sv: StrView = resp_arg_sv(@cmd.args[1])

    let count: i64 = store_scard(ctx.store, key_sv)
    if count < 0
        let wrongtype: StrView = "WRONGTYPE Operation against a key holding the wrong kind of value"
        ctx_write_error_sv(ctx, wrongtype)
        return CMD_ERR_TYPE

    ctx_write_int(ctx, count)
    return CMD_OK


# SMEMBERS key
fn cmd_smembers(ctx: *CommandContext, cmd: *RespCommand) -> i32
    if cmd.argc != 2
        let err: StrView = "ERR wrong number of arguments for 'smembers' command"
        ctx_write_error_sv(ctx, err)
        return CMD_ERR_ARGC

    var key_sv: StrView = resp_arg_sv(@cmd.args[1])

    var count: i64 = 0
    let results: *StrView = store_smembers(ctx.store, key_sv, @&count)

    ctx_write_bulk_array(ctx, results, count)
    return CMD_OK


# ============================================================================
# Hash Commands
# ============================================================================

# HSET key field value [field value ...]
fn cmd_hset(ctx: *CommandContext, cmd: *RespCommand) -> i32
    if cmd.argc < 4 || (cmd.argc - 2) % 2 != 0
        let err: StrView = "ERR wrong number of arguments for 'hset' command"
        ctx_write_error_sv(ctx, err)
        return CMD_ERR_ARGC

    var key_sv: StrView = resp_arg_sv(@cmd.args[1])

    var added: i64 = 0
    var i: i32 = 2
    while i < cmd.argc
        var field_sv: StrView = resp_arg_sv(@cmd.args[i])
        var val_sv: StrView = resp_arg_sv(@cmd.args[i + 1])

        let ret: i32 = store_hset(ctx.store, key_sv, field_sv, val_sv)
        if ret < 0
            let wrongtype: StrView = "WRONGTYPE Operation against a key holding the wrong kind of value"
            ctx_write_error_sv(ctx, wrongtype)
            return CMD_ERR_TYPE
        added += ret as i64
        i += 2

    ctx_write_int(ctx, added)
    return CMD_OK


# HGET key field
fn cmd_hget(ctx: *CommandContext, cmd: *RespCommand) -> i32
    if cmd.argc != 3
        let err: StrView = "ERR wrong number of arguments for 'hget' command"
        ctx_write_error_sv(ctx, err)
        return CMD_ERR_ARGC

    var key_sv: StrView = resp_arg_sv(@cmd.args[1])
    var field_sv: StrView = resp_arg_sv(@cmd.args[2])

    let val: StrView = store_hget(ctx.store, key_sv, field_sv)
    if val.ptr == null
        ctx_write_null(ctx)
    else
        ctx_write_bulk(ctx, val.ptr, val.len)
    return CMD_OK


# HDEL key field [field ...]
fn cmd_hdel(ctx: *CommandContext, cmd: *RespCommand) -> i32
    if cmd.argc < 3
        let err: StrView = "ERR wrong number of arguments for 'hdel' command"
        ctx_write_error_sv(ctx, err)
        return CMD_ERR_ARGC

    var key_sv: StrView = resp_arg_sv(@cmd.args[1])

    var deleted: i64 = 0
    for i in 2..cmd.argc
        var field_sv: StrView = resp_arg_sv(@cmd.args[i])
        let ret: i32 = store_hdel(ctx.store, key_sv, field_sv)
        if ret < 0
            let wrongtype: StrView = "WRONGTYPE Operation against a key holding the wrong kind of value"
            ctx_write_error_sv(ctx, wrongtype)
            return CMD_ERR_TYPE
        deleted += ret as i64

    ctx_write_int(ctx, deleted)
    return CMD_OK


# HEXISTS key field
fn cmd_hexists(ctx: *CommandContext, cmd: *RespCommand) -> i32
    if cmd.argc != 3
        let err: StrView = "ERR wrong number of arguments for 'hexists' command"
        ctx_write_error_sv(ctx, err)
        return CMD_ERR_ARGC

    var key_sv: StrView = resp_arg_sv(@cmd.args[1])
    var field_sv: StrView = resp_arg_sv(@cmd.args[2])

    let result: i32 = store_hexists(ctx.store, key_sv, field_sv)
    if result < 0
        let wrongtype: StrView = "WRONGTYPE Operation against a key holding the wrong kind of value"
        ctx_write_error_sv(ctx, wrongtype)
        return CMD_ERR_TYPE

    ctx_write_int(ctx, result as i64)
    return CMD_OK


# HLEN key
fn cmd_hlen(ctx: *CommandContext, cmd: *RespCommand) -> i32
    if cmd.argc != 2
        let err: StrView = "ERR wrong number of arguments for 'hlen' command"
        ctx_write_error_sv(ctx, err)
        return CMD_ERR_ARGC

    var key_sv: StrView = resp_arg_sv(@cmd.args[1])

    let len: i64 = store_hlen(ctx.store, key_sv)
    if len < 0
        let wrongtype: StrView = "WRONGTYPE Operation against a key holding the wrong kind of value"
        ctx_write_error_sv(ctx, wrongtype)
        return CMD_ERR_TYPE

    ctx_write_int(ctx, len)
    return CMD_OK


# HKEYS key
fn cmd_hkeys(ctx: *CommandContext, cmd: *RespCommand) -> i32
    if cmd.argc != 2
        let err: StrView = "ERR wrong number of arguments for 'hkeys' command"
        ctx_write_error_sv(ctx, err)
        return CMD_ERR_ARGC

    var key_sv: StrView = resp_arg_sv(@cmd.args[1])

    var count: i64 = 0
    let results: *StrView = store_hkeys(ctx.store, key_sv, @&count)

    ctx_write_bulk_array(ctx, results, count)
    return CMD_OK


# HVALS key
fn cmd_hvals(ctx: *CommandContext, cmd: *RespCommand) -> i32
    if cmd.argc != 2
        let err: StrView = "ERR wrong number of arguments for 'hvals' command"
        ctx_write_error_sv(ctx, err)
        return CMD_ERR_ARGC

    var key_sv: StrView = resp_arg_sv(@cmd.args[1])

    var count: i64 = 0
    let results: *StrView = store_hvals(ctx.store, key_sv, @&count)

    ctx_write_bulk_array(ctx, results, count)
    return CMD_OK


# HGETALL key
fn cmd_hgetall(ctx: *CommandContext, cmd: *RespCommand) -> i32
    if cmd.argc != 2
        let err: StrView = "ERR wrong number of arguments for 'hgetall' command"
        ctx_write_error_sv(ctx, err)
        return CMD_ERR_ARGC

    var key_sv: StrView = resp_arg_sv(@cmd.args[1])

    var count: i64 = 0
    # store_hgetall returns interleaved key,val,key,val...
    let results: *StrView = store_hgetall(ctx.store, key_sv, @&count)

    ctx_write_bulk_array(ctx, results, count)
    return CMD_OK


# ============================================================================
# Sorted Set Commands (AGAST #3070)
# ============================================================================
# Replies follow Redis.  Scores are i64 in the store (store_zset.ritz), so a
# score must be an integer; anything else gets Redis's float error.

# If `key` holds a value that is not a sorted set, write the WRONGTYPE reply
# and answer true.  store_zcard is the type probe: it is -1 only then.
fn zset_wrongtype(ctx: *CommandContext, key: StrView) -> bool
    if store_zcard(ctx.store, key) < 0
        let wrongtype: StrView = "WRONGTYPE Operation against a key holding the wrong kind of value"
        ctx_write_error_sv(ctx, wrongtype)
        return true
    return false


# ZADD key score member [score member ...]
fn cmd_zadd(ctx: *CommandContext, cmd: *RespCommand) -> i32
    if cmd.argc < 4
        let err: StrView = "ERR wrong number of arguments for 'zadd' command"
        ctx_write_error_sv(ctx, err)
        return CMD_ERR_ARGC
    if (cmd.argc - 2) % 2 != 0
        let err: StrView = "ERR syntax error"
        ctx_write_error_sv(ctx, err)
        return CMD_ERR_SYNTAX

    # Every score is checked before anything is added, so a bad one leaves
    # the set as it was (as Redis does).
    var i: i32 = 2
    while i < cmd.argc
        var score: i64 = 0
        let arg: *RespArg = @cmd.args[i]
        if resp_parse_i64(arg.data, arg.len, @score) == 0
            let err: StrView = "ERR value is not a valid float"
            ctx_write_error_sv(ctx, err)
            return CMD_ERR_SYNTAX
        i += 2

    var key_sv: StrView = resp_arg_sv(@cmd.args[1])
    if zset_wrongtype(ctx, key_sv)
        return CMD_ERR_TYPE

    var added: i64 = 0
    i = 2
    while i < cmd.argc
        var score: i64 = 0
        let arg: *RespArg = @cmd.args[i]
        resp_parse_i64(arg.data, arg.len, @score)
        var member_sv: StrView = resp_arg_sv(@cmd.args[i + 1])
        added += store_zadd(ctx.store, key_sv, score, member_sv)
        i += 2

    ctx_write_int(ctx, added)
    return CMD_OK


# ZREM key member [member ...]
fn cmd_zrem(ctx: *CommandContext, cmd: *RespCommand) -> i32
    if cmd.argc < 3
        let err: StrView = "ERR wrong number of arguments for 'zrem' command"
        ctx_write_error_sv(ctx, err)
        return CMD_ERR_ARGC

    var key_sv: StrView = resp_arg_sv(@cmd.args[1])
    if zset_wrongtype(ctx, key_sv)
        return CMD_ERR_TYPE

    var removed: i64 = 0
    for i in 2..cmd.argc
        var member_sv: StrView = resp_arg_sv(@cmd.args[i])
        removed += store_zrem(ctx.store, key_sv, member_sv)

    ctx_write_int(ctx, removed)
    return CMD_OK


# ZSCORE key member: the score as a bulk string, nil if there is none.
fn cmd_zscore(ctx: *CommandContext, cmd: *RespCommand) -> i32
    if cmd.argc != 3
        let err: StrView = "ERR wrong number of arguments for 'zscore' command"
        ctx_write_error_sv(ctx, err)
        return CMD_ERR_ARGC

    var key_sv: StrView = resp_arg_sv(@cmd.args[1])
    if zset_wrongtype(ctx, key_sv)
        return CMD_ERR_TYPE

    var member_sv: StrView = resp_arg_sv(@cmd.args[2])
    var score: i64 = 0
    if store_zscore(ctx.store, key_sv, member_sv, @&score) == 0
        ctx_write_null(ctx)
        return CMD_OK

    var digits: [24]u8
    let n: i64 = fmt_i64_into(@digits[0], score)
    ctx_write_bulk(ctx, @digits[0], n)
    return CMD_OK


# ZRANK / ZREVRANK key member: the 0-based rank as an integer, nil if the
# member (or the key) is missing.
fn cmd_zrank(ctx: *CommandContext, cmd: *RespCommand, rev: bool, name: *u8) -> i32
    if cmd.argc != 3
        var err: [96]u8
        argc_error(@err[0], name)
        ctx_write_error(ctx, @err[0])
        return CMD_ERR_ARGC

    var key_sv: StrView = resp_arg_sv(@cmd.args[1])
    if zset_wrongtype(ctx, key_sv)
        return CMD_ERR_TYPE

    var member_sv: StrView = resp_arg_sv(@cmd.args[2])
    var rank: i64 = -1
    if rev
        rank = store_zrevrank(ctx.store, key_sv, member_sv)
    else
        rank = store_zrank(ctx.store, key_sv, member_sv)
    if rank < 0
        ctx_write_null(ctx)
    else
        ctx_write_int(ctx, rank)
    return CMD_OK


# ZCARD key
fn cmd_zcard(ctx: *CommandContext, cmd: *RespCommand) -> i32
    if cmd.argc != 2
        let err: StrView = "ERR wrong number of arguments for 'zcard' command"
        ctx_write_error_sv(ctx, err)
        return CMD_ERR_ARGC

    var key_sv: StrView = resp_arg_sv(@cmd.args[1])
    if zset_wrongtype(ctx, key_sv)
        return CMD_ERR_TYPE

    ctx_write_int(ctx, store_zcard(ctx.store, key_sv))
    return CMD_OK


# ZRANGE / ZREVRANGE key start stop [WITHSCORES]
# An array of members (ascending or descending score); with WITHSCORES each
# member is followed by its score as a bulk string.  The 6.2 ZRANGE options
# (BYSCORE, BYLEX, REV, LIMIT) are not supported: they are a syntax error.
fn cmd_zrange(ctx: *CommandContext, cmd: *RespCommand, rev: bool, name: *u8) -> i32
    if cmd.argc < 4
        var err: [96]u8
        argc_error(@err[0], name)
        ctx_write_error(ctx, @err[0])
        return CMD_ERR_ARGC

    var withscores: bool = false
    if cmd.argc == 5
        let opt: StrView = "WITHSCORES"
        withscores = resp_arg_eq_ci_sv(@cmd.args[4], opt) == 1
    if cmd.argc > 5 or (cmd.argc == 5 and not withscores)
        let err: StrView = "ERR syntax error"
        ctx_write_error_sv(ctx, err)
        return CMD_ERR_SYNTAX

    var ok: i32 = 0
    let start: i64 = resp_arg_to_int(@cmd.args[2], @ok)
    var ok2: i32 = 0
    let stop: i64 = resp_arg_to_int(@cmd.args[3], @ok2)
    if ok == 0 or ok2 == 0
        let notint: StrView = "ERR value is not an integer or out of range"
        ctx_write_error_sv(ctx, notint)
        return CMD_ERR_SYNTAX

    var key_sv: StrView = resp_arg_sv(@cmd.args[1])
    if zset_wrongtype(ctx, key_sv)
        return CMD_ERR_TYPE

    var count: i64 = 0
    var members: *StrView = null
    if rev
        members = store_zrevrange(ctx.store, key_sv, start, stop, @&count)
    else
        members = store_zrange(ctx.store, key_sv, start, stop, @&count)

    if not withscores
        ctx_write_bulk_array(ctx, members, count)
        return CMD_OK

    # Interleave member, score.  Each score's digits live in `digits` (24
    # bytes a score) until the reply is written.
    let items: *StrView = malloc(2 * count * sizeof(StrView) + 1) as *StrView
    let digits: *u8 = malloc(24 * count + 1)
    for i in 0..count
        var score: i64 = 0
        store_zscore(ctx.store, key_sv, members[i], @&score)
        let d: *u8 = digits + 24 * i
        let n: i64 = fmt_i64_into(d, score)
        items[2 * i] = members[i]
        items[2 * i + 1] = strview_from_ptr(d, n)
    ctx_write_bulk_array(ctx, items, 2 * count)  # frees items
    free(digits)
    if members != null
        free(members as *u8)
    return CMD_OK


# ============================================================================
# Server Commands
# ============================================================================

# COMMAND
fn cmd_command(ctx: *CommandContext, cmd: *RespCommand) -> i32
    # Return minimal info - list of supported commands
    let ok: StrView = "OK"
    ctx_write_simple_sv(ctx, ok)
    return CMD_OK


# INFO [section]
fn cmd_info(ctx: *CommandContext, cmd: *RespCommand) -> i32
    # Return minimal server info
    let info: StrView = "# Server\r\ntome_version:0.1.0\r\n"
    ctx_write_bulk(ctx, info.ptr, info.len)
    return CMD_OK


# DBSIZE
fn cmd_dbsize(ctx: *CommandContext, cmd: *RespCommand) -> i32
    let size: i64 = store_len(ctx.store)
    ctx_write_int(ctx, size)
    return CMD_OK


# FLUSHDB
fn cmd_flushdb(ctx: *CommandContext, cmd: *RespCommand) -> i32
    store_clear(ctx.store)
    let ok: StrView = "OK"
    ctx_write_simple_sv(ctx, ok)
    return CMD_OK


# AUTH password
# Authenticate client with password. Returns OK if successful.
fn cmd_auth(ctx: *CommandContext, cmd: *RespCommand) -> i32
    if cmd.argc != 2
        let err: StrView = "ERR wrong number of arguments for 'auth' command"
        ctx_write_error_sv(ctx, err)
        return CMD_ERR_ARGC

    # Check if password is required
    if ctx.password == null
        let err: StrView = "ERR Client sent AUTH, but no password is set"
        ctx_write_error_sv(ctx, err)
        return CMD_ERR_SYNTAX

    # Compare the whole argument (data, len) with the required password in
    # constant time (AGAST #1863). The old copy-then-strcmp leaked the match
    # length through timing and ignored anything after an embedded NUL or
    # past byte 255.
    let provided: *RespArg = @cmd.args[1]
    let given: StrView = strview_from_ptr(provided.data, provided.len)
    if ct_eq(given, strview_from_cstr(ctx.password))
        ctx.is_authenticated = 1
        let ok: StrView = "OK"
        ctx_write_simple_sv(ctx, ok)
        return CMD_OK
    else
        let err: StrView = "ERR invalid password"
        ctx_write_error_sv(ctx, err)
        return CMD_ERR_SYNTAX


# Check if client is authenticated (for use in dispatcher)
fn require_auth(ctx: *CommandContext) -> i32
    # No password required = always authenticated
    if ctx.password == null
        return 1
    # Check authentication state
    return ctx.is_authenticated


# ============================================================================
# Command Dispatcher
# ============================================================================

# Dispatch a parsed command to the appropriate handler
pub fn cmd_dispatch(ctx: *CommandContext, cmd: *RespCommand) -> i32
    if cmd.argc == 0
        let err: StrView = "ERR empty command"
        ctx_write_error_sv(ctx, err)
        return CMD_ERR_SYNTAX

    let c: *RespArg = @cmd.args[0]

    # AUTH command - always allowed (needed to authenticate)
    let cmd_auth_name: StrView = "AUTH"
    if resp_arg_eq_ci_sv(c, cmd_auth_name) == 1
        return cmd_auth(ctx, cmd)

    # Check authentication for all other commands. PING is NOT exempt: with
    # requirepass set, Redis answers an unauthenticated PING with NOAUTH
    # (only AUTH/HELLO/QUIT are no-auth), and so does tome (AGAST #1686).
    if require_auth(ctx) == 0
        let err: StrView = "NOAUTH Authentication required."
        ctx_write_error_sv(ctx, err)
        return CMD_ERR_SYNTAX

    # Server commands (require auth)
    let cmd_ping_name: StrView = "PING"
    if resp_arg_eq_ci_sv(c, cmd_ping_name) == 1
        return cmd_ping(ctx, cmd)
    let cmd_echo_name: StrView = "ECHO"
    if resp_arg_eq_ci_sv(c, cmd_echo_name) == 1
        return cmd_echo(ctx, cmd)
    let cmd_command_name: StrView = "COMMAND"
    if resp_arg_eq_ci_sv(c, cmd_command_name) == 1
        return cmd_command(ctx, cmd)
    let cmd_info_name: StrView = "INFO"
    if resp_arg_eq_ci_sv(c, cmd_info_name) == 1
        return cmd_info(ctx, cmd)
    let cmd_dbsize_name: StrView = "DBSIZE"
    if resp_arg_eq_ci_sv(c, cmd_dbsize_name) == 1
        return cmd_dbsize(ctx, cmd)
    let cmd_flushdb_name: StrView = "FLUSHDB"
    if resp_arg_eq_ci_sv(c, cmd_flushdb_name) == 1
        return cmd_flushdb(ctx, cmd)

    # String commands
    let cmd_get_name: StrView = "GET"
    if resp_arg_eq_ci_sv(c, cmd_get_name) == 1
        return cmd_get(ctx, cmd)
    let cmd_set_name: StrView = "SET"
    if resp_arg_eq_ci_sv(c, cmd_set_name) == 1
        return cmd_set(ctx, cmd)
    let cmd_incr_name: StrView = "INCR"
    if resp_arg_eq_ci_sv(c, cmd_incr_name) == 1
        return cmd_incr(ctx, cmd, 1, c"incr")
    let cmd_decr_name: StrView = "DECR"
    if resp_arg_eq_ci_sv(c, cmd_decr_name) == 1
        return cmd_incr(ctx, cmd, -1, c"decr")
    let cmd_incrby_name: StrView = "INCRBY"
    if resp_arg_eq_ci_sv(c, cmd_incrby_name) == 1
        return cmd_incrby(ctx, cmd, 1, c"incrby")
    let cmd_decrby_name: StrView = "DECRBY"
    if resp_arg_eq_ci_sv(c, cmd_decrby_name) == 1
        return cmd_incrby(ctx, cmd, -1, c"decrby")
    let cmd_setex_name: StrView = "SETEX"
    if resp_arg_eq_ci_sv(c, cmd_setex_name) == 1
        return cmd_setex(ctx, cmd)
    let cmd_del_name: StrView = "DEL"
    if resp_arg_eq_ci_sv(c, cmd_del_name) == 1
        return cmd_del(ctx, cmd)
    let cmd_exists_name: StrView = "EXISTS"
    if resp_arg_eq_ci_sv(c, cmd_exists_name) == 1
        return cmd_exists(ctx, cmd)
    let cmd_ttl_name: StrView = "TTL"
    if resp_arg_eq_ci_sv(c, cmd_ttl_name) == 1
        return cmd_ttl(ctx, cmd)
    let cmd_expire_name: StrView = "EXPIRE"
    if resp_arg_eq_ci_sv(c, cmd_expire_name) == 1
        return cmd_expire(ctx, cmd)
    let cmd_persist_name: StrView = "PERSIST"
    if resp_arg_eq_ci_sv(c, cmd_persist_name) == 1
        return cmd_persist(ctx, cmd)

    # List commands
    let cmd_lpush_name: StrView = "LPUSH"
    if resp_arg_eq_ci_sv(c, cmd_lpush_name) == 1
        return cmd_lpush(ctx, cmd)
    let cmd_rpush_name: StrView = "RPUSH"
    if resp_arg_eq_ci_sv(c, cmd_rpush_name) == 1
        return cmd_rpush(ctx, cmd)
    let cmd_lpop_name: StrView = "LPOP"
    if resp_arg_eq_ci_sv(c, cmd_lpop_name) == 1
        return cmd_lpop(ctx, cmd)
    let cmd_rpop_name: StrView = "RPOP"
    if resp_arg_eq_ci_sv(c, cmd_rpop_name) == 1
        return cmd_rpop(ctx, cmd)
    let cmd_llen_name: StrView = "LLEN"
    if resp_arg_eq_ci_sv(c, cmd_llen_name) == 1
        return cmd_llen(ctx, cmd)
    let cmd_lindex_name: StrView = "LINDEX"
    if resp_arg_eq_ci_sv(c, cmd_lindex_name) == 1
        return cmd_lindex(ctx, cmd)
    let cmd_lrange_name: StrView = "LRANGE"
    if resp_arg_eq_ci_sv(c, cmd_lrange_name) == 1
        return cmd_lrange(ctx, cmd)

    # Set commands
    let cmd_sadd_name: StrView = "SADD"
    if resp_arg_eq_ci_sv(c, cmd_sadd_name) == 1
        return cmd_sadd(ctx, cmd)
    let cmd_srem_name: StrView = "SREM"
    if resp_arg_eq_ci_sv(c, cmd_srem_name) == 1
        return cmd_srem(ctx, cmd)
    let cmd_sismember_name: StrView = "SISMEMBER"
    if resp_arg_eq_ci_sv(c, cmd_sismember_name) == 1
        return cmd_sismember(ctx, cmd)
    let cmd_scard_name: StrView = "SCARD"
    if resp_arg_eq_ci_sv(c, cmd_scard_name) == 1
        return cmd_scard(ctx, cmd)
    let cmd_smembers_name: StrView = "SMEMBERS"
    if resp_arg_eq_ci_sv(c, cmd_smembers_name) == 1
        return cmd_smembers(ctx, cmd)

    # Hash commands
    let cmd_hset_name: StrView = "HSET"
    if resp_arg_eq_ci_sv(c, cmd_hset_name) == 1
        return cmd_hset(ctx, cmd)
    let cmd_hget_name: StrView = "HGET"
    if resp_arg_eq_ci_sv(c, cmd_hget_name) == 1
        return cmd_hget(ctx, cmd)
    let cmd_hdel_name: StrView = "HDEL"
    if resp_arg_eq_ci_sv(c, cmd_hdel_name) == 1
        return cmd_hdel(ctx, cmd)
    let cmd_hexists_name: StrView = "HEXISTS"
    if resp_arg_eq_ci_sv(c, cmd_hexists_name) == 1
        return cmd_hexists(ctx, cmd)
    let cmd_hlen_name: StrView = "HLEN"
    if resp_arg_eq_ci_sv(c, cmd_hlen_name) == 1
        return cmd_hlen(ctx, cmd)
    let cmd_hkeys_name: StrView = "HKEYS"
    if resp_arg_eq_ci_sv(c, cmd_hkeys_name) == 1
        return cmd_hkeys(ctx, cmd)
    let cmd_hvals_name: StrView = "HVALS"
    if resp_arg_eq_ci_sv(c, cmd_hvals_name) == 1
        return cmd_hvals(ctx, cmd)
    let cmd_hgetall_name: StrView = "HGETALL"
    if resp_arg_eq_ci_sv(c, cmd_hgetall_name) == 1
        return cmd_hgetall(ctx, cmd)

    # Sorted set commands
    let cmd_zadd_name: StrView = "ZADD"
    if resp_arg_eq_ci_sv(c, cmd_zadd_name) == 1
        return cmd_zadd(ctx, cmd)
    let cmd_zrem_name: StrView = "ZREM"
    if resp_arg_eq_ci_sv(c, cmd_zrem_name) == 1
        return cmd_zrem(ctx, cmd)
    let cmd_zscore_name: StrView = "ZSCORE"
    if resp_arg_eq_ci_sv(c, cmd_zscore_name) == 1
        return cmd_zscore(ctx, cmd)
    let cmd_zrank_name: StrView = "ZRANK"
    if resp_arg_eq_ci_sv(c, cmd_zrank_name) == 1
        return cmd_zrank(ctx, cmd, false, c"zrank")
    let cmd_zrevrank_name: StrView = "ZREVRANK"
    if resp_arg_eq_ci_sv(c, cmd_zrevrank_name) == 1
        return cmd_zrank(ctx, cmd, true, c"zrevrank")
    let cmd_zcard_name: StrView = "ZCARD"
    if resp_arg_eq_ci_sv(c, cmd_zcard_name) == 1
        return cmd_zcard(ctx, cmd)
    let cmd_zrange_name: StrView = "ZRANGE"
    if resp_arg_eq_ci_sv(c, cmd_zrange_name) == 1
        return cmd_zrange(ctx, cmd, false, c"zrange")
    let cmd_zrevrange_name: StrView = "ZREVRANGE"
    if resp_arg_eq_ci_sv(c, cmd_zrevrange_name) == 1
        return cmd_zrange(ctx, cmd, true, c"zrevrange")

    # Unknown command
    let err: StrView = "ERR unknown command"
    ctx_write_error_sv(ctx, err)
    return CMD_ERR_UNKNOWN
