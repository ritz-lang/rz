# lib/score.ritz - sorted-set scores as text, the way Redis reads and writes them
#
# Scores are IEEE-754 doubles (AGAST #4268).  tome has no libc, so this is
# its strtod and its dtoa, both exact: they work on the decimal digits and the
# double's bits with a small bignum, not with float arithmetic.
#
# score_parse follows Redis's string2d (strtod over the whole argument):
#   [+-] digits [. digits] [e|E [+-] digits], or [+-] inf / infinity (any case)
# and refuses what Redis refuses: empty text, leading or trailing junk
# (whitespace included), NaN, a value that overflows to ±inf, and a nonzero
# value that underflows to 0.  Subnormals are accepted.  The result is
# correctly rounded (to nearest, ties to even).  Hex floats ("0x1p3"), which
# glibc's strtod also takes, are refused.
#
# score_format follows Redis 7.2+'s addReplyDouble: "inf" / "-inf", else
# fpconv_dtoa's layout of the shortest digits that read back as the same
# double ("1.5", "0.1", "1e+8", "2.5e-7", "-0").  The digits come from
# Burger & Dybvig's free-format algorithm, so they are always the shortest
# (and of those, the nearest); fpconv's Grisu2 very rarely emits one digit
# more.

import ritzlib.fmt

# Significant decimal digits kept by score_parse.  Deciding the rounding of
# any decimal needs at most 768 of them (a halfway point between two doubles
# has at most 767); later nonzero digits only set a sticky bit.
const SCORE_MAX_DIGITS: i64 = 800

# Bytes score_format may write: "-1.7976931348623157e+308" is 24.
pub const SCORE_FMT_MAX: i64 = 32

const F64_SIGN: u64 = 0x8000000000000000
const F64_INF: u64 = 0x7FF0000000000000
const F64_FRAC_MASK: u64 = 0x000FFFFFFFFFFFFF
const F64_HIDDEN: u64 = 0x0010000000000000

# ============================================================================
# Bignum: an unsigned integer in 32-bit limbs, least significant first.
# 128 limbs (4096 bits) covers the largest operand either direction needs:
# 10^(324 + SCORE_MAX_DIGITS) shifted by two bits when parsing.
# ============================================================================

const BIG_LIMBS: i32 = 128

struct Big
    n: i32              # limbs in use; 0 means the value 0
    d: [128]u32

fn big_set_u64(b: *Big, v: u64)
    b.d[0] = (v & 0xFFFFFFFF) as u32
    b.d[1] = (v >> 32) as u32
    b.n = 2
    big_trim(b)

fn big_trim(b: *Big)
    while b.n > 0 and b.d[b.n - 1] == 0
        b.n -= 1

fn big_copy(dst: *Big, src: *Big)
    dst.n = src.n
    var i: i32 = 0
    while i < src.n
        dst.d[i] = src.d[i]
        i += 1

fn big_is_zero(b: *Big) -> bool
    return b.n == 0

# b = b * m + add
fn big_mul_add_small(b: *Big, m: u32, add: u32)
    var carry: u64 = add as u64
    var i: i32 = 0
    while i < b.n
        let t: u64 = (b.d[i] as u64) * (m as u64) + carry
        b.d[i] = (t & 0xFFFFFFFF) as u32
        carry = t >> 32
        i += 1
    if carry != 0
        b.d[b.n] = carry as u32
        b.n += 1

# b = b * 10^k
fn big_mul_pow10(b: *Big, k: i64)
    var left: i64 = k
    while left >= 9
        big_mul_add_small(b, 1000000000, 0)
        left -= 9
    var m: u32 = 1
    while left > 0
        m = m * 10
        left -= 1
    if m != 1
        big_mul_add_small(b, m, 0)

# b = b << bits
fn big_shl(b: *Big, bits: i64)
    if b.n == 0 or bits == 0
        return
    let limbs: i32 = (bits / 32) as i32
    let sh: u64 = (bits % 32) as u64
    # Move limbs up, carrying `sh` bits between neighbours, top first.
    var i: i32 = b.n
    b.d[b.n + limbs] = 0
    while i > 0
        i -= 1
        let v: u64 = b.d[i] as u64
        if sh != 0
            b.d[i + limbs + 1] = b.d[i + limbs + 1] | ((v >> (32 - sh)) as u32)
        b.d[i + limbs] = ((v << sh) & 0xFFFFFFFF) as u32
    i = 0
    while i < limbs
        b.d[i] = 0
        i += 1
    b.n = b.n + limbs + 1
    big_trim(b)

# Number of significant bits (0 for zero).
fn big_bitlen(b: *Big) -> i64
    if b.n == 0
        return 0
    var top: u32 = b.d[b.n - 1]
    var bits: i64 = 0
    while top != 0
        bits += 1
        top = top >> 1
    return ((b.n - 1) as i64) * 32 + bits

# -1, 0 or 1 as a < b, a == b, a > b.
fn big_cmp(a: *Big, b: *Big) -> i32
    if a.n != b.n
        if a.n < b.n
            return -1
        return 1
    var i: i32 = a.n
    while i > 0
        i -= 1
        if a.d[i] != b.d[i]
            if a.d[i] < b.d[i]
                return -1
            return 1
    return 0

# a = a + b
fn big_add(a: *Big, b: *Big)
    var n: i32 = a.n
    if b.n > n
        n = b.n
    var carry: u64 = 0
    var i: i32 = 0
    while i < n
        var x: u64 = carry
        if i < a.n
            x += a.d[i] as u64
        if i < b.n
            x += b.d[i] as u64
        a.d[i] = (x & 0xFFFFFFFF) as u32
        carry = x >> 32
        i += 1
    a.n = n
    if carry != 0
        a.d[n] = carry as u32
        a.n = n + 1

# a = a - b, for a >= b.
fn big_sub(a: *Big, b: *Big)
    var borrow: u64 = 0
    var i: i32 = 0
    while i < a.n
        var sub: u64 = borrow
        if i < b.n
            sub += b.d[i] as u64
        let x: u64 = a.d[i] as u64
        if x >= sub
            a.d[i] = (x - sub) as u32
            borrow = 0
        else
            a.d[i] = (x + 0x100000000 - sub) as u32
            borrow = 1
        i += 1
    big_trim(a)

# Compare a + b with c.
fn big_sum_cmp(a: *Big, b: *Big, c: *Big) -> i32
    var t: Big
    big_copy(@t, a)
    big_add(@t, b)
    return big_cmp(@t, c)

# ============================================================================
# Parsing
# ============================================================================

fn score_is_digit(c: u8) -> bool
    return c >= 48 and c <= 57

# p[0..n] equals lowercase `word` ignoring ASCII case.
fn score_eq_ci(p: *u8, word: *u8, n: i64) -> bool
    var i: i64 = 0
    while i < n
        if (p[i] | 32) != word[i]
            return false
        i += 1
    return true

fn score_store_bits(out: *f64, bits: u64)
    let po: *u64 = out as *u64
    *po = bits

# Parse p[0..len] as a score into *out.  1 if it is one, 0 if Redis would
# reply "value is not a valid float" (*out is then untouched).
pub fn score_parse(p: *u8, len: i64, out: *f64) -> i32
    if len <= 0
        return 0
    var i: i64 = 0
    var sign: u64 = 0
    if p[0] == 43 or p[0] == 45            # '+' '-'
        if p[0] == 45
            sign = F64_SIGN
        i = 1

    # inf / infinity
    if i < len and (p[i] | 32) == 105      # 'i'
        let rest: i64 = len - i
        if (rest == 3 and score_eq_ci(p + i, c"inf", 3)) or (rest == 8 and score_eq_ci(p + i, c"infinity", 8))
            score_store_bits(out, sign | F64_INF)
            return 1
        return 0

    # Mantissa: the significant digits (leading zeros dropped) and the
    # power of ten that scales their integer.
    var digits: [800]u8
    var nd: i64 = 0
    var dexp: i64 = 0
    var sticky: bool = false
    var saw_digit: bool = false
    while i < len and score_is_digit(p[i])
        let d: u8 = p[i] - 48
        saw_digit = true
        if nd == 0 and d == 0
            i += 1
            continue
        if nd < SCORE_MAX_DIGITS
            digits[nd] = d
            nd += 1
        else
            dexp += 1
            if d != 0
                sticky = true
        i += 1
    if i < len and p[i] == 46               # '.'
        i += 1
        while i < len and score_is_digit(p[i])
            let d: u8 = p[i] - 48
            saw_digit = true
            if nd == 0 and d == 0
                dexp -= 1
            else if nd < SCORE_MAX_DIGITS
                digits[nd] = d
                nd += 1
                dexp -= 1
            else if d != 0
                sticky = true
            i += 1
    if not saw_digit
        return 0

    # Exponent.  Its magnitude is clamped: past 100000 the value has long
    # since overflowed or underflowed (or the mantissa is 0).
    if i < len and (p[i] | 32) == 101       # 'e'
        i += 1
        var eneg: bool = false
        if i < len and (p[i] == 43 or p[i] == 45)
            eneg = p[i] == 45
            i += 1
        if i >= len or not score_is_digit(p[i])
            return 0
        var ev: i64 = 0
        while i < len and score_is_digit(p[i])
            if ev < 100000
                ev = ev * 10 + ((p[i] - 48) as i64)
            i += 1
        if eneg
            dexp -= ev
        else
            dexp += ev
    if i != len
        return 0

    if nd == 0
        score_store_bits(out, sign)        # ±0
        return 1
    while nd > 1 and digits[nd - 1] == 0 and not sticky
        nd -= 1
        dexp += 1

    # value = D * 10^dexp with 10^(nd+dexp-1) <= value < 10^(nd+dexp).
    if nd + dexp > 309
        return 0                            # >= 1e309: overflow
    if nd + dexp <= -324
        return 0                            # < 1e-324: rounds to 0

    # value = N / M exactly.
    var num: Big
    var den: Big
    big_set_u64(@num, 0)
    var j: i64 = 0
    while j < nd
        big_mul_add_small(@num, 10, digits[j] as u32)
        j += 1
    big_set_u64(@den, 1)
    if dexp >= 0
        big_mul_pow10(@num, dexp)
    else
        big_mul_pow10(@den, 0 - dexp)

    # Scale so that den <= num < 2*den; then value is in [2^b, 2^(b+1)).
    var b: i64 = big_bitlen(@num) - big_bitlen(@den)
    if b >= 0
        big_shl(@den, b)
    else
        big_shl(@num, 0 - b)
    if big_cmp(@num, @den) < 0
        big_shl(@num, 1)
        b -= 1

    # 64 quotient bits by long division: value = q * 2^(b-63), plus a
    # remainder that only matters as nonzero (sticky).
    var q: u64 = 0
    var k: i32 = 0
    while k < 64
        q = q << 1
        if big_cmp(@num, @den) >= 0
            big_sub(@num, @den)
            q = q | 1
        big_shl(@num, 1)
        k += 1
    if not big_is_zero(@num)
        sticky = true

    var bits: u64 = 0
    if b >= -1022
        # Normal: keep 53 bits, round to nearest even on the other 11.
        var mant: u64 = q >> 11
        let rest: u64 = q & 0x7FF
        if rest > 0x400 or (rest == 0x400 and (sticky or (mant & 1) == 1))
            mant += 1
            if mant == 0x20000000000000     # carried to 2^53
                mant = mant >> 1
                b += 1
        if b > 1023
            return 0                        # rounded up to inf
        bits = (((b + 1023) as u64) << 52) | (mant & F64_FRAC_MASK)
    else
        # Subnormal: the exponent is pinned at -1022, so fewer bits remain.
        let shift: i64 = 11 + (-1022 - b)
        if shift > 64
            return 0                        # below half the least subnormal
        var mant: u64 = 0
        var low: bool = sticky
        if shift == 64
            low = low or (q << 1) != 0      # round bit is q's top bit (set)
        else
            mant = q >> (shift as u64)
            let one: u64 = 1
            let below: u64 = q & ((one << ((shift - 1) as u64)) - 1)
            low = low or below != 0
        var round: u64 = 1
        if shift < 64
            round = (q >> ((shift - 1) as u64)) & 1
        if round == 1 and (low or (mant & 1) == 1)
            mant += 1                       # may carry into the least normal
        if mant == 0
            return 0                        # underflowed to 0
        bits = mant
    score_store_bits(out, sign | bits)
    return 1

# ============================================================================
# Formatting
# ============================================================================

# floor(a / b) for b > 0.
fn score_floor_div(a: i64, b: i64) -> i64
    var q: i64 = a / b
    if a % b != 0 and a < 0
        q -= 1
    return q

# Write the shortest round-trip digits of the finite, nonzero double with
# mantissa `f` and exponent `e` (value f * 2^e) into `digits`.  Returns the
# digit count; *out_k is the power of ten with value ~= 0.d1d2... * 10^k.
fn score_shortest(f: u64, e: i64, unequal_gaps: bool, digits: *u8, out_k: *i64) -> i64
    let even: bool = (f & 1) == 0
    # value = r / s; the rounding interval reaches mm / s below it and mp / s
    # above (Burger & Dybvig, with all quantities doubled).
    var r: Big
    var s: Big
    var mp: Big
    var mm: Big
    if e >= 0
        if unequal_gaps
            big_set_u64(@r, f)
            big_shl(@r, e + 2)
            big_set_u64(@s, 4)
            big_set_u64(@mp, 1)
            big_shl(@mp, e + 1)
            big_set_u64(@mm, 1)
            big_shl(@mm, e)
        else
            big_set_u64(@r, f)
            big_shl(@r, e + 1)
            big_set_u64(@s, 2)
            big_set_u64(@mp, 1)
            big_shl(@mp, e)
            big_set_u64(@mm, 1)
            big_shl(@mm, e)
    else
        if unequal_gaps
            big_set_u64(@r, f << 2)
            big_set_u64(@s, 1)
            big_shl(@s, 2 - e)
            big_set_u64(@mp, 2)
            big_set_u64(@mm, 1)
        else
            big_set_u64(@r, f << 1)
            big_set_u64(@s, 1)
            big_shl(@s, 1 - e)
            big_set_u64(@mp, 1)
            big_set_u64(@mm, 1)

    # k from log10(2) ~= 78913 / 2^18 (a hair low), minus one so the
    # estimate never exceeds the answer; the loop below walks it up.
    var flen: i64 = 0
    var t: u64 = f
    while t != 0
        flen += 1
        t = t >> 1
    var k: i64 = score_floor_div((e + flen - 1) * 78913, 262144) - 1
    if k >= 0
        big_mul_pow10(@s, k)
    else
        big_mul_pow10(@r, 0 - k)
        big_mul_pow10(@mp, 0 - k)
        big_mul_pow10(@mm, 0 - k)
    # Smallest k with the top of the interval below 10^k.
    while true
        let c: i32 = big_sum_cmp(@r, @mp, @s)
        if c > 0 or (even and c == 0)
            big_mul_add_small(@s, 10, 0)
            k += 1
        else
            break

    var nd: i64 = 0
    while true
        big_mul_add_small(@r, 10, 0)
        big_mul_add_small(@mp, 10, 0)
        big_mul_add_small(@mm, 10, 0)
        var d: u8 = 0
        while big_cmp(@r, @s) >= 0
            big_sub(@r, @s)
            d += 1
        let lc: i32 = big_cmp(@r, @mm)
        let low_ok: bool = lc < 0 or (even and lc == 0)
        let hc: i32 = big_sum_cmp(@r, @mp, @s)
        let high_ok: bool = hc > 0 or (even and hc == 0)
        if not low_ok and not high_ok
            digits[nd] = d
            nd += 1
            continue
        if low_ok and high_ok
            # Both d and d+1 lie in the interval: take the nearer.
            var r2: Big
            big_copy(@r2, @r)
            big_shl(@r2, 1)
            if big_cmp(@r2, @s) >= 0
                d += 1
        else if high_ok
            d += 1
        digits[nd] = d
        nd += 1
        break
    *out_k = k
    return nd

fn score_put(buf: *u8, at: i64, c: u8) -> i64
    buf[at] = c
    return at + 1

# True if v is a NaN (all exponent bits set, a nonzero fraction).  Read from
# the bits so the answer does not hang on how a float compare is lowered.
pub fn score_is_nan(v: f64) -> bool
    var vv: f64 = v
    let bits: u64 = *(@vv as *u64)
    return ((bits >> 52) & 0x7FF) == 0x7FF and (bits & F64_FRAC_MASK) != 0

# Format v into buf (SCORE_FMT_MAX bytes, no NUL).  Returns the length.
pub fn score_format(v: f64, buf: *u8) -> i64
    var vv: f64 = v
    let bits: u64 = *(@vv as *u64)
    var at: i64 = 0
    if (bits & F64_SIGN) != 0
        at = score_put(buf, at, 45)         # '-'
    let expf: u64 = (bits >> 52) & 0x7FF
    let frac: u64 = bits & F64_FRAC_MASK
    if expf == 0x7FF
        if frac != 0
            # NaN never reaches the store (score_parse refuses it).
            buf[0] = 110
            buf[1] = 97
            buf[2] = 110
            return 3
        at = score_put(buf, at, 105)
        at = score_put(buf, at, 110)
        return score_put(buf, at, 102)      # "inf"
    if expf == 0 and frac == 0
        return score_put(buf, at, 48)       # "0" / "-0"

    var f: u64 = frac
    var e: i64 = -1074
    if expf != 0
        f = frac | F64_HIDDEN
        e = (expf as i64) - 1075
    # A power of two has a closer neighbour below, except at the bottom of
    # the normal range, where the subnormal below has the same spacing.
    let unequal: bool = frac == 0 and expf > 1

    var digits: [20]u8
    var k: i64 = 0
    let nd: i64 = score_shortest(f, e, unequal, @digits[0], @k)

    # fpconv_dtoa's emit_digits: value = digits * 10^K.
    let big_k: i64 = k - nd
    var exp: i64 = big_k + nd - 1
    if exp < 0
        exp = 0 - exp

    # Plain integer.
    if big_k >= 0 and exp < nd + 7
        var j: i64 = 0
        while j < nd
            at = score_put(buf, at, digits[j] + 48)
            j += 1
        j = 0
        while j < big_k
            at = score_put(buf, at, 48)
            j += 1
        return at

    # Plain decimal.
    if big_k < 0 and (big_k > -7 or exp < 4)
        let offset: i64 = nd + big_k
        if offset <= 0
            at = score_put(buf, at, 48)
            at = score_put(buf, at, 46)
            var z: i64 = 0
            while z < 0 - offset
                at = score_put(buf, at, 48)
                z += 1
            var j: i64 = 0
            while j < nd
                at = score_put(buf, at, digits[j] + 48)
                j += 1
            return at
        var j: i64 = 0
        while j < nd
            if j == offset
                at = score_put(buf, at, 46)
            at = score_put(buf, at, digits[j] + 48)
            j += 1
        return at

    # Scientific: d[.ddd]e(+|-)x
    at = score_put(buf, at, digits[0] + 48)
    if nd > 1
        at = score_put(buf, at, 46)
        var j: i64 = 1
        while j < nd
            at = score_put(buf, at, digits[j] + 48)
            j += 1
    at = score_put(buf, at, 101)
    if big_k + nd - 1 < 0
        at = score_put(buf, at, 45)
    else
        at = score_put(buf, at, 43)
    return at + fmt_i64_into(buf + at, exp)
