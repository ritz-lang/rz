# lib/store_set.ritz - Tome set values
#
# Set operations (Set is in store_types.ritz) and the store_s* commands on
# a Store.

import ritzlib.gvec
import ritzlib.hashmap
import ritzlib.option
import ritzlib.string
import ritzlib.strview
import tome.pool
import tome.store_types
import tome.store

# ============================================================================
# Set Operations
# ============================================================================
# Members are stored and compared as whole byte strings (hash and compare
# by (ptr, len)), so a member may hold any byte, NUL included (AGAST #4210).

# A new empty set.
pub fn set_new() -> Set
    Set { members: pool_new<String>(), index: hashmap_new<StrView, i64>() }

# Add a member to the set. Returns 1 if added, 0 if already present.
pub fn set_add(set: @&Set, value: StrView) -> i32
    if set.index.contains(value)
        return 0
    let slot: i64 = set.members.insert(string_from_strview(value))
    set.index.insert(set.members.item(slot).as_view(), slot)
    return 1

# Remove a member from the set. Returns 1 if removed, 0 if not found.
pub fn set_remove(set: @&Set, value: StrView) -> i32
    match set.index.get(value)
        Some(slot) =>
            # Out of the index first: its key views the member's bytes.
            set.index.remove(value)
            set.members.remove(slot, string_new())
            return 1
        None => return 0

# Check if a value is in the set. Returns 1 if present, 0 if not.
pub fn set_contains(set: @Set, value: StrView) -> i32
    if set.index.contains(value)
        return 1
    return 0

# Get the number of members in the set
pub fn set_len(set: @Set) -> i64
    return set.index.len()

# Every member of the set, borrowed, in no particular order.
pub fn set_members(set: @Set) -> Vec<StrView>
    var result: Vec<StrView> = vec_with_cap<StrView>(set.members.len())
    for i in 0..set.members.slots()
        if set.members.is_live(i)
            result.push(set.members.item(i).as_view())
    return result

# ============================================================================
# Store Set Operations
# ============================================================================

# Helper: Get or create set for key. None if key exists with wrong type.
fn store_get_or_create_set(s: *Store, key: StrView) -> Option<@&Set>
    match store_find_entry(s, key)
        Some(entry) =>
            if entry.value_type == VALUE_SET
                return Some(s.sets.at(entry.value_slot))
            return None  # Wrong type
        None => pass

    # Create new set
    let slot: i64 = s.sets.insert(set_new())
    let fresh: @&Entry = store_create_entry(s, key)
    fresh.value_slot = slot
    fresh.value_type = VALUE_SET

    # Track initial memory
    s.used_memory += entry_memory(s, fresh)

    return Some(s.sets.at(slot))

# Helper: Get existing set for key. None if not found, expired or wrong type.
fn store_get_set(s: *Store, key: StrView) -> Option<@&Set>
    match store_live_entry(s, key)
        Some(entry) =>
            if entry.value_type == VALUE_SET
                return Some(s.sets.at(entry.value_slot))
            return None  # Wrong type
        None => return None

# SADD: Add member(s) to set. Returns number of elements added.
# Creates set if key doesn't exist. Returns -1 if key exists with wrong type.
pub fn store_sadd(s: *Store, key: StrView, member: StrView) -> i64
    match store_get_or_create_set(s, key)
        Some(set) => return set_add(set, member) as i64
        None => return -1  # Key exists with wrong type

# SREM: Remove member(s) from set. Returns number of elements removed.
# Returns 0 if key doesn't exist. Returns -1 if key exists with wrong type.
pub fn store_srem(s: *Store, key: StrView, member: StrView) -> i64
    match store_live_entry(s, key)
        Some(entry) =>
            if entry.value_type != VALUE_SET
                return -1  # Wrong type
            return set_remove(s.sets.at(entry.value_slot), member) as i64
        None => return 0  # Key not found or expired

# SISMEMBER: Check if member is in set. Returns 1 if present, 0 if not.
# Returns 0 if key doesn't exist.
pub fn store_sismember(s: *Store, key: StrView, member: StrView) -> i32
    match store_get_set(s, key)
        Some(set) => return set_contains(set, member)
        None => return 0

# SCARD: Get cardinality (number of members) of set.
# Returns 0 if key doesn't exist. Returns -1 if key exists with wrong type.
pub fn store_scard(s: *Store, key: StrView) -> i64
    match store_live_entry(s, key)
        Some(entry) =>
            if entry.value_type == VALUE_SET
                return set_len(s.sets.item(entry.value_slot))
            return -1  # Wrong type
        None => return 0  # Key not found or expired

# SMEMBERS: Get all members of set as borrowed views (empty if the key is
# missing).
pub fn store_smembers(s: *Store, key: StrView) -> Vec<StrView>
    match store_get_set(s, key)
        Some(set) => return set_members(set)
        None => return vec_new<StrView>()

# Add every member of `from` to `into`.
fn set_add_all(into: @&Set, from: @Set)
    for i in 0..from.members.slots()
        if from.members.is_live(i)
            set_add(into, from.members.item(i).as_view())

# SUNION: the union of two sets as a new Set; None if neither exists.
pub fn store_sunion(s: *Store, key1: StrView, key2: StrView) -> Option<Set>
    let set1: Option<@&Set> = store_get_set(s, key1)
    let set2: Option<@&Set> = store_get_set(s, key2)
    if set1.is_none() and set2.is_none()
        return None

    var result: Set = set_new()
    match set1
        Some(a) => set_add_all(@&result, a)
        None => pass
    match set2
        Some(b) => set_add_all(@&result, b)
        None => pass
    return Some(result)

# SINTER: the intersection of two sets as a new Set; None if either is
# missing.
pub fn store_sinter(s: *Store, key1: StrView, key2: StrView) -> Option<Set>
    let set1: @&Set = match store_get_set(s, key1)
        Some(a) => a
        None => return None
    let set2: @&Set = match store_get_set(s, key2)
        Some(b) => b
        None => return None

    # Members of set1 that are also in set2
    var result: Set = set_new()
    for i in 0..set1.members.slots()
        if set1.members.is_live(i)
            let m: StrView = set1.members.item(i).as_view()
            if set_contains(set2, m) == 1
                set_add(@&result, m)
    return Some(result)

# SDIFF: set1 - set2 as a new Set; None if set1 is missing.
pub fn store_sdiff(s: *Store, key1: StrView, key2: StrView) -> Option<Set>
    let set1: @&Set = match store_get_set(s, key1)
        Some(a) => a
        None => return None
    let set2: Option<@&Set> = store_get_set(s, key2)

    # Members of set1 that are NOT in set2
    var result: Set = set_new()
    for i in 0..set1.members.slots()
        if set1.members.is_live(i)
            let m: StrView = set1.members.item(i).as_view()
            var in_set2: bool = false
            match set2
                Some(b) => in_set2 = set_contains(b, m) == 1
                None => pass
            if not in_set2
                set_add(@&result, m)
    return Some(result)
