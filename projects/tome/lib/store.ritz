# lib/store.ritz - Tome key-value store core
#
# The Store: a ritzlib HashMap<StrView, i64> (AGAST #4357) from each key to
# its Entry's slot in a Pool, plus memory accounting and eviction, string
# get/set/del, TTL and method syntax.

import ritzlib.gvec
import ritzlib.hash
import ritzlib.hashmap
import ritzlib.option
import ritzlib.span
import ritzlib.str
import ritzlib.string
import ritzlib.strview
import ritzlib.drop
import ritzlib.time { now }
import tome.pool
import tome.store_types

# ============================================================================
# Time utilities for TTL
# ============================================================================

# Get current time as Unix timestamp (seconds since epoch)
pub fn time_now_secs() -> i64
    return now().tv_sec

# ============================================================================
# Entry - A single key-value pair with metadata
# ============================================================================

# Kept in Store.entries, whose slot never changes while the entry lives.
# Store.map's keys are StrViews of the bytes `key` owns: the key is written
# once, at creation, and the String's buffer (which a move of the Entry
# doesn't move) is never reallocated while the entry is in the map.
struct Entry
    key: String          # The key (owned string; the map's key views it)
    value: String        # The value (owned string, for VALUE_STRING)
    value_slot: i64      # LIST, SET, ZSET, HASH: the value's slot in its Store pool
    value_type: i32      # Type tag (VALUE_NONE, VALUE_STRING, etc.)
    expires_at: i64      # Unix timestamp for expiration (0 = never)
    last_access: i64     # Unix timestamp of last access (for LRU)

fn entry_blank() -> Entry
    Entry { key: string_new(), value: string_new(), value_slot: -1, value_type: VALUE_NONE, expires_at: 0, last_access: 0 }

# ============================================================================
# Eviction Policies
# ============================================================================

const EVICT_NONE: i32 = 0        # No eviction, return error when full
const EVICT_LRU: i32 = 1         # Evict least recently used keys
const EVICT_RANDOM: i32 = 2      # Evict random keys
const EVICT_VOLATILE_LRU: i32 = 3   # Evict LRU among keys with TTL
const EVICT_VOLATILE_RANDOM: i32 = 4  # Evict random among keys with TTL
const EVICT_VOLATILE_TTL: i32 = 5    # Evict keys closest to expiration

# ============================================================================
# Store - The main key-value store
# ============================================================================
# The table (probing, growth, tombstones) is ritzlib's HashMap; the Store
# keeps only what is its own: the entries and complex values, eviction and
# the RNG.  The map's key view and the entry it names have the same
# lifetime (see Entry).  Everything is owned by a field, so dropping a
# Store releases every key and value.

struct Store
    map: HashMap<StrView, i64>  # key view -> slot in entries
    entries: Pool<Entry>
    lists: Pool<List>    # complex values, named by Entry.value_slot
    sets: Pool<Set>
    zsets: Pool<ZSet>
    hashes: Pool<Hash>
    used_memory: i64     # Total memory used by keys and values (bytes)
    maxmemory: i64       # Maximum memory limit (0 = unlimited)
    eviction_policy: i32 # Eviction policy when maxmemory reached
    rng_state: u64       # Random state for EVICT_RANDOM

# ============================================================================
# Constructor
# ============================================================================

pub fn store_new() -> Store
    return store_with_cap(16)

pub fn store_with_cap(cap: i64) -> Store
    var s: Store = Store {
        map: hashmap_with_cap<StrView, i64>(cap),
        entries: pool_new<Entry>(entry_blank),
        lists: pool_new<List>(list_new),
        sets: pool_new<Set>(set_blank),
        zsets: pool_new<ZSet>(zset_blank),
        hashes: pool_new<Hash>(hash_blank),
        used_memory: 0,
        maxmemory: 0,                # No limit by default
        eviction_policy: EVICT_NONE,
        rng_state: 12345             # Initial seed for random eviction
    }
    return s

# ============================================================================
# Memory Management
# ============================================================================

# Calculate memory used by a String
fn string_memory(s: @String) -> i64
    return s.len() + 1  # Length + null terminator

# Calculate memory used by an entry's value: an estimate of what its
# structures hold, plus the bytes of every String in them.
fn entry_value_memory(s: *Store, entry: *Entry) -> i64
    if entry.value_type == VALUE_STRING
        return string_memory(@entry.value)
    else if entry.value_type == VALUE_LIST
        let list: @List = s.lists.get(entry.value_slot)
        # List memory: struct + nodes + string data
        var mem: i64 = 24  # List struct
        mem += list.len * 40  # a slot per element
        for k in 0..list.len
            mem += list_elem(list, k).len + 1
        return mem
    else if entry.value_type == VALUE_SET
        let set: @Set = s.sets.get(entry.value_slot)
        # Set memory: struct + index table + string data
        var mem: i64 = 32  # Set struct
        mem += set.index.cap() * 24  # index slots
        for i in 0..set.members.slots()
            if set.members.is_live(i)
                mem += string_memory(set.members.get(i))
        return mem
    else if entry.value_type == VALUE_ZSET
        let zset: @ZSet = s.zsets.get(entry.value_slot)
        # ZSet memory: struct + skip list nodes + index + strings
        var mem: i64 = 48  # ZSet struct estimate
        mem += zset.index.cap() * 32  # index slots
        # Skip list nodes (estimate based on length)
        mem += zset.len * 64  # Average node size with forward links
        return mem
    else if entry.value_type == VALUE_HASH
        let h: @Hash = s.hashes.get(entry.value_slot)
        # Hash memory: struct + index table + string data
        var mem: i64 = 32  # Hash struct
        mem += h.index.cap() * 36  # index slots (field + value + state)
        for i in 0..h.fields.slots()
            if h.fields.is_live(i)
                let f: @HashField = h.fields.get(i)
                mem += string_memory(@f.field)
                mem += string_memory(@f.value)
        return mem
    return 0

# Calculate total memory used by an entry
pub fn entry_memory(s: *Store, entry: *Entry) -> i64
    var mem: i64 = string_memory(@entry.key)
    mem += entry_value_memory(s, entry)
    return mem

# Element k (in 0..len) of a list, borrowed.
pub fn list_elem(list: @List, k: i64) -> StrView
    let slots: [String] = span_from_vec<String>(@list.ring)
    let at: @String = @slots[(list.head + k) & (slots.len - 1)]
    return at.as_view()

# Simple LCG random number generator
fn store_random(s: *Store) -> u64
    s.rng_state = s.rng_state *% 6364136223846793005 +% 1442695040888963407
    return s.rng_state

# Set maximum memory limit
pub fn store_set_maxmemory(s: *Store, bytes: i64)
    s.maxmemory = bytes

# Set eviction policy
pub fn store_set_eviction_policy(s: *Store, policy: i32)
    s.eviction_policy = policy

# Get current memory usage
pub fn store_memory_usage(s: *Store) -> i64
    return s.used_memory

# Get maximum memory limit
pub fn store_get_maxmemory(s: *Store) -> i64
    return s.maxmemory

# ============================================================================
# Map access - the table is a HashMap<StrView, i64>
# ============================================================================
# Keys compare by value: a StrView hashes its bytes and compares (ptr, len),
# so a lookup from any buffer finds an entry stored from another one, and an
# embedded NUL is data, not a terminator.

# The occupied entry for key, or None.  Expiration is the caller's concern
# (some paths delete lazily, some just report a miss).  The borrow is good
# until the next entry is created.
pub fn store_find_entry(s: *Store, key: StrView) -> Option<@&Entry>
    match s.map.get(key)
        Some(slot) => Some(s.entries.at(slot))
        None => None

# A new entry for key, inserted into the map under its own key bytes.  The
# caller must have checked that key is absent; this would otherwise replace
# the stored slot and leak the old entry.
pub fn store_create_entry(s: *Store, key: StrView) -> @&Entry
    let slot: i64 = s.entries.insert(Entry {
        key: string_from_strview(key),
        value: string_new(),
        value_slot: -1,
        value_type: VALUE_NONE,
        expires_at: 0,
        last_access: time_now_secs()
    })
    let entry: @&Entry = s.entries.at(slot)
    s.map.insert((entry.key).as_view(), slot)
    return entry

# Drop the complex value an entry holds, if any.
fn store_drop_value(s: *Store, entry: *Entry)
    if entry.value_type == VALUE_LIST
        s.lists.remove(entry.value_slot)
    else if entry.value_type == VALUE_SET
        s.sets.remove(entry.value_slot)
    else if entry.value_type == VALUE_ZSET
        s.zsets.remove(entry.value_slot)
    else if entry.value_type == VALUE_HASH
        s.hashes.remove(entry.value_slot)

# Remove the entry in `slot` from the map, drop it and account for its
# memory.
fn store_erase_slot(s: *Store, slot: i64)
    let entry: @&Entry = s.entries.at(slot)
    let mem: i64 = entry_memory(s, entry)
    # Out of the map first: its key views the bytes the entry is about to free.
    s.map.remove((entry.key).as_view())
    store_drop_value(s, entry)
    s.entries.remove(slot)
    s.used_memory -= mem

# Remove entry (found by store_find_entry) from the store.
pub fn store_erase_entry(s: *Store, entry: *Entry)
    match s.map.get((entry.key).as_view())
        Some(slot) => store_erase_slot(s, slot)
        None => pass

# Remove key's entry, if any.  Returns 1 when there was one.
pub fn store_erase(s: *Store, key: StrView) -> i32
    match s.map.get(key)
        Some(slot) =>
            store_erase_slot(s, slot)
            return 1
        None => return 0

# The live entry for key, or None: an expired one counts as missing (it is
# not deleted here).
pub fn store_live_entry(s: *Store, key: StrView) -> Option<@&Entry>
    match store_find_entry(s, key)
        Some(entry) =>
            if entry.expires_at > 0 and time_now_secs() >= entry.expires_at
                return None
            return Some(entry)
        None => return None

# Sample random map slots for an eviction victim: up to `want` entries that
# pass the policy's filter (all entries, or only those with a TTL), in at
# most `tries` probes, keeping the best by the policy's measure.  The
# victim's entry slot, or None.
fn store_sample_victim(s: *Store, volatile: bool, by_ttl: bool, want: i32, tries: i32) -> Option<i64>
    let cap: i64 = s.map.cap()
    var best: i64 = -1
    var best_key: i64 = 9223372036854775807  # i64 max
    var samples: i32 = 0
    var attempts: i32 = 0
    while samples < want && attempts < tries
        attempts += 1
        let idx: i64 = (store_random(s) as i64) % cap
        if idx < 0 or s.map.slot_state(idx) != Slot.Full
            continue
        let slot: i64 = s.map.slot_value(idx)
        let entry: @Entry = s.entries.get(slot)
        if volatile and entry.expires_at <= 0
            continue
        var measure: i64 = entry.last_access
        if by_ttl
            measure = entry.expires_at
        if measure < best_key or best < 0
            best_key = measure
            best = slot
        samples += 1
    if best < 0
        return None
    return Some(best)

# Find a key to evict based on policy: its entry slot, or None.
fn store_find_evict_candidate(s: *Store) -> Option<i64>
    if s.eviction_policy == EVICT_NONE or s.map.len() == 0
        return None
    if s.eviction_policy == EVICT_RANDOM
        return store_sample_victim(s, false, false, 1, 20)
    if s.eviction_policy == EVICT_LRU
        return store_sample_victim(s, false, false, 5, 20)
    if s.eviction_policy == EVICT_VOLATILE_LRU
        return store_sample_victim(s, true, false, 5, 50)
    if s.eviction_policy == EVICT_VOLATILE_RANDOM
        return store_sample_victim(s, true, false, 1, 50)
    if s.eviction_policy == EVICT_VOLATILE_TTL
        return store_sample_victim(s, true, true, 5, 50)
    return None

# Evict keys until we're under maxmemory. Returns number of keys evicted.
fn store_evict_if_needed(s: *Store) -> i64
    if s.maxmemory <= 0
        return 0  # No limit

    var evicted: i64 = 0
    while s.used_memory > s.maxmemory
        match store_find_evict_candidate(s)
            Some(slot) =>
                store_erase_slot(s, slot)
                evicted += 1
            None => break  # Can't evict anything

    return evicted

# ============================================================================
# Core operations
# ============================================================================

# Set a key to a string value.
pub fn store_set(s: *Store, key: StrView, value: StrView)
    let now: i64 = time_now_secs()
    match store_find_entry(s, key)
        Some(entry) =>
            # Update existing: a value of another type goes first
            let old_mem: i64 = entry_value_memory(s, entry)
            store_drop_value(s, entry)
            entry.value = string_from_strview(value)
            entry.value_type = VALUE_STRING
            entry.last_access = now
            s.used_memory += entry_value_memory(s, entry) - old_mem
        None =>
            let fresh: @&Entry = store_create_entry(s, key)
            fresh.value = string_from_strview(value)
            fresh.value_type = VALUE_STRING
            fresh.last_access = now
            s.used_memory += entry_memory(s, fresh)

    # Evict if needed
    store_evict_if_needed(s)

# The string value at `key` as a borrowed view (every byte, NULs included),
# or None if the key is missing, expired or not a string.  The view is valid
# until the key is modified or deleted.  Expired keys are deleted on access.
pub fn store_get(s: *Store, key: StrView) -> Option<StrView>
    let v: StrView = store_get_strview(s, key)
    if v.ptr == null
        return None
    return Some(v)

# Like `store_get`, with a miss / expired / non-string value as an empty
# view whose ptr is null (a hit's ptr never is, even for "": a value's
# String always holds room for its NUL).
# Triggers lazy expiration like `store_get`.
pub fn store_get_strview(s: *Store, key: StrView) -> StrView
    let entry: @&Entry = match store_find_entry(s, key)
        Some(e) => e
        None => return strview_empty()
    let now: i64 = time_now_secs()

    if entry.expires_at > 0
        if now >= entry.expires_at
            store_erase_entry(s, entry)
            return strview_empty()

    # Update access time for LRU
    entry.last_access = now

    if entry.value_type == VALUE_STRING
        return (entry.value).as_view()
    return strview_empty()

# Check if a key exists (not expired).
# NOTE: This is a const operation - does not trigger lazy expiration.
# Use store_get() if you want expired keys to be cleaned up.
pub fn store_exists(s: *Store, key: StrView) -> i32
    match store_live_entry(s, key)
        Some(_) => return 1
        None => return 0

# Delete a key. Returns 1 if deleted, 0 if not found.
pub fn store_del(s: *Store, key: StrView) -> i32
    return store_erase(s, key)

# Get the number of keys in the store.
pub fn store_len(s: *Store) -> i64
    return s.map.len()

# Check if the store is empty.
pub fn store_is_empty(s: *Store) -> i32
    if s.map.len() == 0
        return 1
    return 0


# Clear all keys from the store.
pub fn store_clear(s: *Store)
    s.map.clear()
    s.entries.clear()
    s.lists.clear()
    s.sets.clear()
    s.zsets.clear()
    s.hashes.clear()
    s.used_memory = 0


# ============================================================================
# TTL Operations
# ============================================================================

# Set a key with an expiration time (in seconds from now).
# Similar to Redis SETEX.
pub fn store_setex(s: *Store, key: StrView, value: StrView, ttl_secs: i64)
    # First, do a normal set
    store_set(s, key, value)

    # Then find the entry and set expiration
    match store_find_entry(s, key)
        Some(entry) =>
            if ttl_secs > 0
                entry.expires_at = time_now_secs() + ttl_secs
            else
                entry.expires_at = 0  # No expiration
        None => pass  # Evicted at once (shouldn't happen after set)

# Set expiration on an existing key. Returns 1 if key exists, 0 otherwise.
# Similar to Redis EXPIRE.
pub fn store_expire(s: *Store, key: StrView, ttl_secs: i64) -> i32
    let entry: @&Entry = match store_find_entry(s, key)
        Some(e) => e
        None => return 0  # Key not found

    # Check if already expired
    if entry.expires_at > 0
        let now: i64 = time_now_secs()
        if now >= entry.expires_at
            # Lazy delete expired key
            store_erase_entry(s, entry)
            return 0

    if ttl_secs > 0
        entry.expires_at = time_now_secs() + ttl_secs
    else
        entry.expires_at = 0  # Remove expiration
    return 1

# Get the remaining TTL for a key in seconds.
# Returns: -2 if key doesn't exist, -1 if no expiration, >= 0 for TTL.
# Similar to Redis TTL.
pub fn store_ttl(s: *Store, key: StrView) -> i64
    let entry: @&Entry = match store_find_entry(s, key)
        Some(e) => e
        None => return -2  # Key does not exist

    if entry.expires_at == 0
        return -1  # Key exists but has no expiration

    let now: i64 = time_now_secs()
    if now >= entry.expires_at
        return -2  # Expired (treat as non-existent)

    return entry.expires_at - now

# Remove expiration from a key. Returns 1 if key exists and had TTL, 0 otherwise.
# Similar to Redis PERSIST.
pub fn store_persist(s: *Store, key: StrView) -> i32
    let entry: @&Entry = match store_find_entry(s, key)
        Some(e) => e
        None => return 0

    # Check if already expired
    if entry.expires_at > 0
        let now: i64 = time_now_secs()
        if now >= entry.expires_at
            return 0  # Already expired

        entry.expires_at = 0
        return 1
    return 0  # No TTL to remove

# Active expiration: scan and delete expired keys.
# Returns the number of keys deleted.
# Call this periodically (e.g., every 100ms) for background cleanup.
pub fn store_expire_sweep(s: *Store) -> i64
    var deleted: i64 = 0
    let now: i64 = time_now_secs()

    # A walk over the entries, not the map: erasing changes the map.
    for slot in 0..s.entries.slots()
        if s.entries.is_live(slot)
            let expires_at: i64 = s.entries.get(slot).expires_at
            if expires_at > 0 and now >= expires_at
                store_erase_slot(s, slot)
                deleted += 1

    return deleted

# ============================================================================
# Method syntax support
# ============================================================================

impl Store
    fn len(self: @Store) -> i64
        return self.map.len()

    fn is_empty(self: @Store) -> i32
        if self.map.len() == 0
            return 1
        return 0

    fn set(self: @&Store, key: StrView, value: StrView)
        store_set(self, key, value)

    fn get(self: @&Store, key: StrView) -> Option<StrView>
        return store_get(self, key)

    fn exists(self: @Store, key: StrView) -> i32
        return store_exists(self, key)

    fn del(self: @&Store, key: StrView) -> i32
        return store_del(self, key)

    fn setex(self: @&Store, key: StrView, value: StrView, ttl_secs: i64)
        store_setex(self, key, value, ttl_secs)

    fn expire(self: @&Store, key: StrView, ttl_secs: i64) -> i32
        return store_expire(self, key, ttl_secs)

    fn ttl(self: @Store, key: StrView) -> i64
        return store_ttl(self, key)

    fn persist(self: @&Store, key: StrView) -> i32
        return store_persist(self, key)

    fn expire_sweep(self: @&Store) -> i64
        return store_expire_sweep(self)
