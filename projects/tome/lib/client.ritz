# lib/client.ritz - Tome CLI client
#
# RESP client for connecting to a Tome server.
# Handles connection, command encoding, and response parsing.

import ritzlib.sys
import ritzlib.fd
import ritzlib.span
import ritzlib.result
import ritzlib.io
import ritzlib.fmt
import ritzlib.str
import ritzlib.memory
import ritzlib.strview
import ritzlib.async_net
# Use the fully-qualified `tome.resp` form so this module is consumable
# from outside the tome project (e.g. spire.repo.tome).  The relative
# `lib.resp` form only resolves within tome's own build root.
import tome.resp


# ============================================================================
# Client Connection
# ============================================================================

struct TomeClient
    fd: Fd              # The connection (closed: raw -1)
    connected: i32      # Connection status
    read_buf: [8192]u8  # Buffer for receiving responses
    read_len: i32       # Bytes in read buffer


# Initialize client (not connected yet)
pub fn client_new() -> TomeClient
    var c: TomeClient
    c.fd = fd_adopt(-1)
    c.connected = 0
    c.read_len = 0
    return c


# Parse "localhost" or a dotted-decimal IPv4 address.  Returns the address
# in HOST byte order (127.0.0.1 -> 0x7F000001), which is what
# client_connect takes: it formats it as a dotted quad for Socket.connect.  Returns 0
# on error.  (AGAST #2457: tome-cli returned network order here, so the
# double swap dialled 1.0.0.127 and hung in connect().)
pub fn client_parse_host(s: StrView) -> i32
    if s.eq("localhost")
        return 0x7F000001

    var ip: i32 = 0
    var octets: i32 = 0
    var current: i32 = 0
    var digits: i32 = 0
    var i: i64 = 0
    loop
        # The end of `s` closes the last octet, as '.' closes the others.
        let at_end: bool = i >= s.len
        var c: u8 = 0
        if not at_end
            c = *(s.ptr + i)
        if at_end || c == 46  # end or '.'
            if digits == 0 || octets >= 4
                return 0
            ip = (ip << 8) | current
            octets += 1
            current = 0
            digits = 0
            if at_end
                break
        else if c >= 48 && c <= 57
            current = current * 10 + (c - 48) as i32
            digits += 1
            if current > 255
                return 0
        else
            return 0
        i += 1

    if octets != 4
        return 0
    return ip


# Write the host-byte-order IPv4 address `ip` into `buf` (at least 16
# bytes) as a dotted quad, the form Socket.connect takes; returns its length.
pub fn client_format_host(ip: i32, buf: *u8) -> i64
    var n: i64 = 0
    var shift: i32 = 24
    while shift >= 0
        let octet: i32 = (ip >> shift) & 255
        if octet >= 100
            *(buf + n) = (48 + octet / 100) as u8
            n += 1
        if octet >= 10
            *(buf + n) = (48 + (octet / 10) % 10) as u8
            n += 1
        *(buf + n) = (48 + octet % 10) as u8
        n += 1
        if shift > 0
            *(buf + n) = 46
            n += 1
        shift -= 8
    return n


# Connect to a Tome server (host in host byte order: see client_parse_host)
# Returns 0 on success, negative error code on failure
pub fn client_connect(c: *TomeClient, host: i32, port: i32) -> i32
    # Create socket
    var sock: Socket
    match socket_tcp()
        Ok(s) => sock = s
        Err(e) => return -e.code()

    # Connect to server
    var addr: [16]u8
    let addr_len: i64 = client_format_host(host, @addr[0])
    var err: i32 = 0
    match sock.connect(strview_from_ptr(@addr[0], addr_len), port)
        Ok(_) => err = 0
        Err(e) => err = e.code()
    if err != 0
        sock.close()
        return -err

    c.fd = fd_adopt(sock.raw())
    c.connected = 1
    c.read_len = 0
    return 0


# Disconnect from server
pub fn client_disconnect(c: *TomeClient)
    c.fd.close()
    c.connected = 0


# Check if connected
pub fn client_is_connected(c: *TomeClient) -> i32
    return c.connected


# ============================================================================
# Command Sending
# ============================================================================

# Send a raw RESP-encoded command
# Returns bytes sent or negative error
pub fn client_send_raw(c: *TomeClient, data: *u8, len: i64) -> i64
    if c.connected == 0
        return -1
    # write(2), not send(2), for WSL compatibility
    match c.fd.write(Span<u8> { ptr: data, len: len })
        Ok(n) => n
        Err(e) => -(e.code() as i64)


# Send a simple command with no arguments (e.g., PING)
pub fn client_send_cmd0(c: *TomeClient, cmd: *u8) -> i64
    var buf: [256]u8
    var pos: i32 = 0

    # *1\r\n$<len>\r\n<cmd>\r\n
    pos += resp_write_array(@buf[0], 1)
    let cmd_len: i64 = strlen(cmd)
    pos += resp_write_bulk(@buf[0] + pos, cmd, cmd_len)

    return client_send_raw(c, @buf[0], pos as i64)


# Send a command with 1 argument (e.g., GET key)
pub fn client_send_cmd1(c: *TomeClient, cmd: *u8, arg1: *u8) -> i64
    var buf: [512]u8
    var pos: i32 = 0

    pos += resp_write_array(@buf[0], 2)
    let cmd_len: i64 = strlen(cmd)
    pos += resp_write_bulk(@buf[0] + pos, cmd, cmd_len)
    let arg1_len: i64 = strlen(arg1)
    pos += resp_write_bulk(@buf[0] + pos, arg1, arg1_len)

    return client_send_raw(c, @buf[0], pos as i64)


# Send a command with 2 arguments (e.g., SET key value)
pub fn client_send_cmd2(c: *TomeClient, cmd: *u8, arg1: *u8, arg2: *u8) -> i64
    var buf: [8192]u8
    var pos: i32 = 0

    pos += resp_write_array(@buf[0], 3)
    let cmd_len: i64 = strlen(cmd)
    pos += resp_write_bulk(@buf[0] + pos, cmd, cmd_len)
    let arg1_len: i64 = strlen(arg1)
    pos += resp_write_bulk(@buf[0] + pos, arg1, arg1_len)
    let arg2_len: i64 = strlen(arg2)
    pos += resp_write_bulk(@buf[0] + pos, arg2, arg2_len)

    return client_send_raw(c, @buf[0], pos as i64)


# Send a command with 3 arguments
pub fn client_send_cmd3(c: *TomeClient, cmd: *u8, arg1: *u8, arg2: *u8, arg3: *u8) -> i64
    var buf: [8192]u8
    var pos: i32 = 0

    pos += resp_write_array(@buf[0], 4)
    let cmd_len: i64 = strlen(cmd)
    pos += resp_write_bulk(@buf[0] + pos, cmd, cmd_len)
    let arg1_len: i64 = strlen(arg1)
    pos += resp_write_bulk(@buf[0] + pos, arg1, arg1_len)
    let arg2_len: i64 = strlen(arg2)
    pos += resp_write_bulk(@buf[0] + pos, arg2, arg2_len)
    let arg3_len: i64 = strlen(arg3)
    pos += resp_write_bulk(@buf[0] + pos, arg3, arg3_len)

    return client_send_raw(c, @buf[0], pos as i64)


# ============================================================================
# Response Receiving
# ============================================================================

# Receive response from server
# Returns bytes received or negative error
pub fn client_recv(c: *TomeClient) -> i32
    if c.connected == 0
        return -1

    # read(2), not recv(2), for WSL compatibility
    var ret: i64 = 0
    match c.fd.read(Span<u8> { ptr: @c.read_buf[0], len: 8192 })
        Ok(n) => ret = n
        Err(e) => ret = -(e.code() as i64)
    if ret <= 0
        c.connected = 0
        return ret as i32

    c.read_len = ret as i32
    return c.read_len


# Get pointer to read buffer
pub fn client_get_response(c: *TomeClient) -> *u8
    return @c.read_buf[0]


# Get length of response
pub fn client_get_response_len(c: *TomeClient) -> i32
    return c.read_len


# ============================================================================
# Response Printing
# ============================================================================

# A reply header's integer (an array count after '*', a bulk length after
# '$'): buf[start..] up to the '\r' before `end`, read by resp_parse_i64
# (AGAST #4040).  Sets *out and returns the index of that '\r', or -1 if
# there is none or the digits are not an i64.
pub fn client_reply_int(buf: *u8, start: i32, end: i32, out: *i64) -> i32
    var i: i32 = start
    while i < end and *(buf + i) != 13
        i += 1
    if i >= end
        return -1
    if resp_parse_i64(buf + start, (i - start) as i64, out) == 0
        return -1
    return i


# Print a RESP response in human-readable format
pub fn client_print_response(c: *TomeClient)
    if c.read_len <= 0
        prints("(empty response)\n")
        return

    let buf: *u8 = @c.read_buf[0]
    let first: u8 = *buf

    if first == 43  # '+' Simple string
        # Print without the + prefix and \r\n suffix
        var i: i32 = 1
        while i < c.read_len - 2
            let ch: *u8 = buf + i
            print_char(*ch)
            i += 1
        print_char(10)  # newline

    else if first == 45  # '-' Error
        prints("(error) ")
        var i: i32 = 1
        while i < c.read_len - 2
            let ch: *u8 = buf + i
            print_char(*ch)
            i += 1
        print_char(10)

    else if first == 58  # ':' Integer
        prints("(integer) ")
        var i: i32 = 1
        while i < c.read_len - 2
            let ch: *u8 = buf + i
            print_char(*ch)
            i += 1
        print_char(10)

    else if first == 36  # '$' Bulk string
        # Check for null: $-1\r\n
        let second: *u8 = buf + 1
        if *second == 45  # '-'
            prints("(nil)\n")
            return

        # Find the \r\n after length
        var len_end: i32 = 1
        while len_end < c.read_len
            let ch: *u8 = buf + len_end
            if *ch == 13  # \r
                break
            len_end += 1

        # Print the data (starts after \r\n)
        prints("\"")
        var i: i32 = len_end + 2  # Skip \r\n
        while i < c.read_len - 2  # Stop before trailing \r\n
            let ch: *u8 = buf + i
            print_char(*ch)
            i += 1
        prints("\"\n")

    else if first == 42  # '*' Array
        # Check for null array: *-1\r\n
        let second: *u8 = buf + 1
        if *second == 45
            prints("(empty array)\n")
            return

        # Parse array count
        var count: i64 = 0
        var i: i32 = client_reply_int(buf, 1, c.read_len, @count)
        if i < 0
            prints("(protocol error) bad array count\n")
            return

        # Simple array printing - show count
        print("(array with {count} elements)\n")

        # Parse and print each element
        i += 2  # Skip \r\n
        var elem: i64 = 0
        while elem < count && i < c.read_len
            let type_char: *u8 = buf + i

            if *type_char == 36  # Bulk string
                i += 1
                # Check null
                let next: *u8 = buf + i
                if *next == 45
                    let elem_n: i64 = elem + 1
                    print("{elem_n}) (nil)\n")
                    i += 4  # Skip -1\r\n
                    elem += 1
                    continue

                # Parse length
                var blen: i64 = 0
                i = client_reply_int(buf, i, c.read_len, @blen)
                if i < 0
                    prints("(protocol error) bad bulk length\n")
                    return
                i += 2  # Skip \r\n

                # Print element
                let elem_n: i64 = elem + 1
                print("{elem_n}) \"")
                var j: i64 = 0
                while j < blen && i < c.read_len
                    let ch: *u8 = buf + i
                    print_char(*ch)
                    i += 1
                    j += 1
                prints("\"\n")
                i += 2  # Skip trailing \r\n

            else if *type_char == 58  # Integer
                i += 1
                let elem_n: i64 = elem + 1
                print("{elem_n}) (integer) ")
                while i < c.read_len
                    let ch: *u8 = buf + i
                    if *ch == 13
                        break
                    print_char(*ch)
                    i += 1
                print_char(10)
                i += 2

            else
                # Unknown type, skip
                break

            elem += 1

    else
        # Unknown format, print raw
        prints("(raw) ")
        var i: i32 = 0
        while i < c.read_len
            let ch: *u8 = buf + i
            if *ch == 13
                prints("\\r")
            else if *ch == 10
                prints("\\n")
            else
                print_char(*ch)
            i += 1
        print_char(10)
