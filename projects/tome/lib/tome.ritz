# lib/tome.ritz - In-memory key-value store
#
# Core data structures and operations for Tome.
# Uses string keys and supports multiple value types.
#
# Usage:
#   var store: Store = store_new()
#   store_set(@store, "key", "value")
#   let val: Option<StrView> = store_get(@store, "key")
#   store_del(@store, "key")
#
# This module is the public face of the store: it re-exports the focused
# modules below, so `import lib.tome` / `import tome.tome` keeps working.
#   store_types.ritz  value tags; List/Set/ZSet/Hash structs and drops
#   store.ritz        Store table, memory/eviction, strings, TTL
#   store_list.ritz   list values
#   store_set.ritz    set values
#   store_zset.ritz   sorted set values
#   store_hash.ritz   hash values
#   pubsub.ritz       publish/subscribe

pub import tome.store_types
pub import tome.store
pub import tome.store_list
pub import tome.store_set
pub import tome.store_zset
pub import tome.store_hash
pub import tome.pubsub
