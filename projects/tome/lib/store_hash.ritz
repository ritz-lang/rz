# lib/store_hash.ritz - Tome hash values
#
# Field-value hash map operations and the store_h* commands on a Store.

import ritzlib.gvec
import ritzlib.hashmap
import ritzlib.option
import ritzlib.string
import ritzlib.strview
import tome.pool
import tome.store_types
import tome.store

# ============================================================================
# Hash Operations (internal functions)
# ============================================================================

# Fields and values are stored and compared as whole byte strings (hash
# and compare by (ptr, len)), so either may hold any byte, NUL included
# (AGAST #4210).

# A missing field: ptr is null.  A present one, even empty, has a non-null
# ptr (string_from_bytes always reserves room for the NUL).
fn hash_missing() -> StrView
    return StrView { ptr: null, len: 0 }

# A new empty hash.
fn hash_new() -> Hash
    Hash { fields: pool_new<HashField>(), index: hashmap_with_cap<StrView, i64>(8) }

# Set a field in the hash. Returns 1 if new field, 0 if updated existing.
fn hash_set(h: @&Hash, field: StrView, value: StrView) -> i32
    match h.index.get(field)
        Some(slot) =>
            # Update existing field: the old value drops here.
            h.fields.at(slot).value = string_from_strview(value)
            return 0
        None => pass
    let slot: i64 = h.fields.insert(HashField { field: string_from_strview(field), value: string_from_strview(value) })
    h.index.insert((h.fields.item(slot).field).as_view(), slot)
    return 1

# Get a field value from the hash, borrowed. ptr is null if not found.
fn hash_get(h: @Hash, field: StrView) -> StrView
    match h.index.get(field)
        Some(slot) => return (h.fields.item(slot).value).as_view()
        None => return hash_missing()

# Check if field exists in hash. Returns 1 if exists, 0 if not.
fn hash_exists(h: @Hash, field: StrView) -> i32
    if h.index.contains(field)
        return 1
    return 0

# Delete a field from the hash. Returns 1 if deleted, 0 if not found.
fn hash_del(h: @&Hash, field: StrView) -> i32
    match h.index.get(field)
        Some(slot) =>
            # Out of the index first: its key views the field's bytes.
            h.index.remove(field)
            h.fields.remove(slot, hash_field_blank())
            return 1
        None => return 0

# Get number of fields in hash
fn hash_len(h: @Hash) -> i64
    return h.index.len()

# Borrowed views of the fields (which=0), the values (which=1) or both
# interleaved [field, value, ...] (which=2).
fn hash_collect(h: @Hash, which: i32) -> Vec<StrView>
    var per: i64 = 1
    if which == 2
        per = 2
    var arr: Vec<StrView> = vec_with_cap<StrView>(h.fields.len() * per)
    for i in 0..h.fields.slots()
        if h.fields.is_live(i)
            let f: @HashField = h.fields.item(i)
            if which != 1
                arr.push((f.field).as_view())
            if which != 0
                arr.push((f.value).as_view())
    return arr

# ============================================================================
# Hash Store Operations
# ============================================================================

# Helper to get or create a hash for a key.  None if the key holds another
# type; an expired key is replaced.
fn store_get_or_create_hash(s: *Store, key: StrView) -> Option<@&Hash>
    match store_find_entry(s, key)
        Some(entry) =>
            if entry.expires_at > 0 and time_now_secs() >= entry.expires_at
                # Expired - clean up and treat as new
                store_erase_entry(s, entry)
            else if entry.value_type == VALUE_HASH
                return Some(s.hashes.at(entry.value_slot))
            else
                return None  # Wrong type
        None => pass

    # Key doesn't exist - create new hash
    let slot: i64 = s.hashes.insert(hash_new())
    let fresh: @&Entry = store_create_entry(s, key)
    fresh.value_slot = slot
    fresh.value_type = VALUE_HASH
    # Track initial memory
    s.used_memory += entry_memory(s, fresh)
    return Some(s.hashes.at(slot))

# Helper to get existing hash for a key: None if missing, expired or of
# another type.
fn store_get_hash(s: *Store, key: StrView) -> Option<@&Hash>
    match store_live_entry(s, key)
        Some(entry) =>
            if entry.value_type == VALUE_HASH
                return Some(s.hashes.at(entry.value_slot))
            return None
        None => return None

# HSET: Set field in hash. Returns 1 if new, 0 if updated, -1 if wrong type.
pub fn store_hset(s: *Store, key: StrView, field: StrView, value: StrView) -> i32
    match store_get_or_create_hash(s, key)
        Some(h) => return hash_set(h, field, value)
        None => return -1  # Wrong type

# HGET: Get field value, borrowed. ptr is null if not found or wrong type.
pub fn store_hget(s: *Store, key: StrView, field: StrView) -> StrView
    match store_get_hash(s, key)
        Some(h) => return hash_get(h, field)
        None => return hash_missing()

# HDEL: Delete field from hash. Returns 1 if deleted, 0 if not found, -1 if wrong type.
pub fn store_hdel(s: *Store, key: StrView, field: StrView) -> i32
    match store_live_entry(s, key)
        Some(entry) =>
            if entry.value_type != VALUE_HASH
                return -1
            return hash_del(s.hashes.at(entry.value_slot), field)
        None => return 0

# HEXISTS: Check if field exists. Returns 1 if exists, 0 if not, -1 if wrong type.
pub fn store_hexists(s: *Store, key: StrView, field: StrView) -> i32
    match store_live_entry(s, key)
        Some(entry) =>
            if entry.value_type != VALUE_HASH
                return -1
            return hash_exists(s.hashes.item(entry.value_slot), field)
        None => return 0

# HLEN: Get number of fields. Returns count, 0 if not found, -1 if wrong type.
pub fn store_hlen(s: *Store, key: StrView) -> i64
    match store_live_entry(s, key)
        Some(entry) =>
            if entry.value_type != VALUE_HASH
                return -1
            return hash_len(s.hashes.item(entry.value_slot))
        None => return 0

# The fields (which=0), values (1) or interleaved pairs (2) of key's hash,
# borrowed; empty if there is none.
fn store_hash_collect(s: *Store, key: StrView, which: i32) -> Vec<StrView>
    match store_get_hash(s, key)
        Some(h) => return hash_collect(h, which)
        None => return vec_new<StrView>()

# HKEYS: Get all field names as borrowed views.
pub fn store_hkeys(s: *Store, key: StrView) -> Vec<StrView>
    return store_hash_collect(s, key, 0)

# HVALS: Get all field values as borrowed views.
pub fn store_hvals(s: *Store, key: StrView) -> Vec<StrView>
    return store_hash_collect(s, key, 1)

# HGETALL: Get all field-value pairs, interleaved [field, value, ...].
pub fn store_hgetall(s: *Store, key: StrView) -> Vec<StrView>
    return store_hash_collect(s, key, 2)
