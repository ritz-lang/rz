# lib/store_zset.ritz - Tome sorted set values
#
# Skip list sorted set operations and the store_z* commands on a Store.

import ritzlib.gvec
import ritzlib.hashmap
import ritzlib.option
import ritzlib.string
import ritzlib.strview
import ritzlib.cmp  # zset_compare -> Ordering
import tome.pool
import tome.store_types
import tome.store

# ============================================================================
# Sorted Set Operations
# ============================================================================

# Simple pseudo-random number generator for skip list levels
var zset_rand_seed: u64 = 12345

fn zset_rand() -> u64
    # Linear congruential generator
    zset_rand_seed = zset_rand_seed *% 1103515245 +% 12345
    return zset_rand_seed

# Generate a random level for a new skip list node
fn zset_random_level() -> i32
    var level: i32 = 1
    # Probability P = 0.25 means we promote with 25% chance
    # We use (rand() & 0xFFFF) < (0xFFFF * 0.25)
    while (zset_rand() & 0xFFFF) < 16383 && level < ZSET_MAX_LEVEL
        level += 1
    return level

# Members are stored and compared as whole byte strings (hash and compare
# by (ptr, len)), so a member may hold any byte, NUL included (AGAST #4210).

# A skip list node on `level` levels, linked to nothing yet.
fn zset_create_node(level: i32, member: String, score: f64) -> ZSetNode
    var forward: Vec<i64> = vec_with_cap<i64>(level as i64)
    for i in 0..level
        forward.push(ZNIL)
    return ZSetNode { member: member, score: score, forward: forward }

# Create a new sorted set: just the header, on every level.
pub fn zset_new() -> ZSet
    var zset: ZSet = ZSet { nodes: pool_new<ZSetNode>(zset_node_blank), level: 1, len: 0, index: hashmap_new<StrView, i64>() }
    zset.nodes.insert(zset_create_node(ZSET_MAX_LEVEL, string_new(), 0.0))  # slot ZHEAD
    return zset

# Node n's successor on level lvl.
fn zset_next(zset: @ZSet, n: i64, lvl: i32) -> i64
    return zset.nodes.get(n).forward.get(lvl as i64)

fn zset_link(zset: @&ZSet, n: i64, lvl: i32, to: i64)
    zset.nodes.at(n).forward.set(lvl as i64, to)

# Compare (score, member) pairs for ordering
fn zset_compare(score_a: f64, member_a: StrView, score_b: f64, member_b: StrView) -> Ordering
    if score_a < score_b
        return Ordering.Less
    if score_a > score_b
        return Ordering.Greater
    # Scores equal - compare the whole members bytewise
    return member_a.cmp(member_b)

# Fill update[i] with the last node on level i that sorts before
# (score, member), for every level in use.
fn zset_find_preds(zset: @ZSet, score: f64, member: StrView, update: @&[16]i64)
    var x: i64 = ZHEAD
    var i: i32 = zset.level - 1
    while i >= 0
        loop
            let next: i64 = zset_next(zset, x, i)
            if next == ZNIL
                break
            let node: @ZSetNode = zset.nodes.get(next)
            if zset_compare(node.score, (node.member).as_view(), score, member).is_ge()
                break
            x = next
        update[i] = x
        i -= 1

# Add member with score to sorted set. Returns 1 if added, 0 if updated.
pub fn zset_add(zset: @&ZSet, member: StrView, score: f64) -> i32
    # Check if member already exists
    var existed: bool = false
    match zset.index.get(member)
        Some(n) =>
            if zset.nodes.get(n).score == score
                return 0  # No change
            # Need to remove and re-insert with new score
            zset_remove(zset, member)
            existed = true
        None => pass

    # Find insert position using skip list
    var update: [16]i64  # ZSET_MAX_LEVEL
    zset_find_preds(zset, score, member, @&update)

    # Update skip list level if needed
    let level: i32 = zset_random_level()
    if level > zset.level
        var j: i32 = zset.level
        while j < level
            update[j] = ZHEAD
            j += 1
        zset.level = level

    # Insert node at each level
    let node: i64 = zset.nodes.insert(zset_create_node(level, string_from_strview(member), score))
    var k: i32 = 0
    while k < level
        zset_link(zset, node, k, zset_next(zset, update[k], k))
        zset_link(zset, update[k], k, node)
        k += 1

    zset.len += 1
    zset.index.insert((zset.nodes.get(node).member).as_view(), node)

    if existed
        return 0  # Updated
    return 1  # Added

# Remove member from sorted set. Returns 1 if removed, 0 if not found.
pub fn zset_remove(zset: @&ZSet, member: StrView) -> i32
    let target: i64 = match zset.index.get(member)
        Some(n) => n
        None => return 0

    # Find position in skip list
    var update: [16]i64
    zset_find_preds(zset, zset.nodes.get(target).score, member, @&update)

    # Verify we found the right node
    let x: i64 = zset_next(zset, update[0], 0)
    if x != target
        return 0  # Not found (shouldn't happen if the index lookup succeeded)

    # Unlink it on each level it is on
    var k: i32 = 0
    while k < zset.level
        if zset_next(zset, update[k], k) == x
            zset_link(zset, update[k], k, zset_next(zset, x, k))
        k += 1

    # Update skip list level
    while zset.level > 1 && zset_next(zset, ZHEAD, zset.level - 1) == ZNIL
        zset.level -= 1

    # Out of the index first: its key views the node's member bytes.
    zset.index.remove(member)
    zset.nodes.remove(x)
    zset.len -= 1
    return 1

# Get score for member. Returns score via out param, returns 1 if found, 0 if not.
pub fn zset_score(zset: @ZSet, member: StrView, out_score: @&f64) -> i32
    match zset.index.get(member)
        Some(n) =>
            *out_score = zset.nodes.get(n).score
            return 1
        None => return 0

# Get rank of member (0-indexed, lowest score = 0). Returns -1 if not found.
pub fn zset_rank(zset: @ZSet, member: StrView) -> i64
    let target: i64 = match zset.index.get(member)
        Some(n) => n
        None => return -1

    # Count nodes before this one
    var rank: i64 = 0
    var x: i64 = zset_next(zset, ZHEAD, 0)
    while x != ZNIL
        if x == target
            return rank
        rank += 1
        x = zset_next(zset, x, 0)

    return -1  # Not found

# Get reverse rank (highest score = 0). Returns -1 if not found.
pub fn zset_revrank(zset: @ZSet, member: StrView) -> i64
    let rank: i64 = zset_rank(zset, member)
    if rank < 0
        return -1
    return zset.len - 1 - rank

# Get length
pub fn zset_len(zset: @ZSet) -> i64
    return zset.len

# The members ranked start..=stop (ascending), borrowed, after Redis's
# index normalising: negative counts from the end, then clamped.
fn zset_rank_range(zset: @ZSet, start: i64, stop: i64) -> Vec<StrView>
    var result: Vec<StrView> = vec_new<StrView>()
    var s_idx: i64 = start
    var e_idx: i64 = stop
    if s_idx < 0
        s_idx = zset.len + s_idx
    if e_idx < 0
        e_idx = zset.len + e_idx
    if s_idx < 0
        s_idx = 0
    if e_idx >= zset.len
        e_idx = zset.len - 1

    var x: i64 = zset_next(zset, ZHEAD, 0)
    var i: i64 = 0
    while x != ZNIL and i <= e_idx
        if i >= s_idx
            result.push((zset.nodes.get(x).member).as_view())
        x = zset_next(zset, x, 0)
        i += 1
    return result

# Reverse v in place.
fn views_reverse(v: @&Vec<StrView>)
    var i: i64 = 0
    var j: i64 = v.len() - 1
    while i < j
        v.swap(i, j)
        i += 1
        j -= 1

# Get range by rank [start, stop] (inclusive, 0-indexed) as borrowed
# member views.
pub fn zset_range(zset: @ZSet, start: i64, stop: i64) -> Vec<StrView>
    return zset_rank_range(zset, start, stop)

# Get reverse range by rank [start, stop] (highest scores first) as
# borrowed member views.
pub fn zset_revrange(zset: @ZSet, start: i64, stop: i64) -> Vec<StrView>
    # Reverse rank r is forward rank len - 1 - r, so the ranks
    # (len - 1 - stop)..=(len - 1 - start), read backwards.  Normalise first,
    # as the forward walk's own normalising would see the mirrored indices.
    var s_idx: i64 = start
    var e_idx: i64 = stop
    if s_idx < 0
        s_idx = zset.len + s_idx
    if e_idx < 0
        e_idx = zset.len + e_idx
    if s_idx < 0
        s_idx = 0
    if e_idx >= zset.len
        e_idx = zset.len - 1
    if s_idx > e_idx
        return vec_new<StrView>()
    var result: Vec<StrView> = zset_rank_range(zset, zset.len - 1 - e_idx, zset.len - 1 - s_idx)
    views_reverse(@&result)
    return result

# ============================================================================
# Store Sorted Set Operations
# ============================================================================

# Helper: Get or create zset for key. None if key exists with wrong type.
fn store_get_or_create_zset(s: *Store, key: StrView) -> Option<@&ZSet>
    match store_find_entry(s, key)
        Some(entry) =>
            if entry.value_type == VALUE_ZSET
                return Some(s.zsets.at(entry.value_slot))
            return None  # Wrong type
        None => pass

    # Create new zset
    let slot: i64 = s.zsets.insert(zset_new())
    let fresh: @&Entry = store_create_entry(s, key)
    fresh.value_slot = slot
    fresh.value_type = VALUE_ZSET
    s.used_memory += entry_memory(s, fresh)
    return Some(s.zsets.at(slot))

# Helper: Get existing zset for key. None if not found, expired or wrong type.
fn store_get_zset(s: *Store, key: StrView) -> Option<@&ZSet>
    match store_live_entry(s, key)
        Some(entry) =>
            if entry.value_type == VALUE_ZSET
                return Some(s.zsets.at(entry.value_slot))
            return None  # Wrong type
        None => return None

# ZADD: Add member with score. Returns 1 if added, 0 if updated.
# Creates zset if key doesn't exist. Returns -1 if key exists with wrong type.
pub fn store_zadd(s: *Store, key: StrView, score: f64, member: StrView) -> i64
    match store_get_or_create_zset(s, key)
        Some(zset) => return zset_add(zset, member, score) as i64
        None => return -1  # Key exists with wrong type

# ZREM: Remove member. Returns 1 if removed, 0 if not found.
# Returns -1 if key exists with wrong type.
pub fn store_zrem(s: *Store, key: StrView, member: StrView) -> i64
    match store_live_entry(s, key)
        Some(entry) =>
            if entry.value_type != VALUE_ZSET
                return -1  # Wrong type
            return zset_remove(s.zsets.at(entry.value_slot), member) as i64
        None => return 0

# ZSCORE: Get score for member. Returns 1 if found (score in out param), 0 if not.
pub fn store_zscore(s: *Store, key: StrView, member: StrView, out_score: @&f64) -> i32
    match store_get_zset(s, key)
        Some(zset) => return zset_score(zset, member, out_score)
        None => return 0

# ZRANK: Get rank of member (0-indexed). Returns -1 if not found.
# Returns -2 if key exists with wrong type.
pub fn store_zrank(s: *Store, key: StrView, member: StrView) -> i64
    match store_live_entry(s, key)
        Some(entry) =>
            if entry.value_type != VALUE_ZSET
                return -2  # Wrong type
            return zset_rank(s.zsets.get(entry.value_slot), member)
        None => return -1

# ZREVRANK: Get reverse rank (highest score = 0). Returns -1 if not found.
pub fn store_zrevrank(s: *Store, key: StrView, member: StrView) -> i64
    match store_get_zset(s, key)
        Some(zset) => return zset_revrank(zset, member)
        None => return -1

# ZCARD: Get cardinality. Returns 0 if key doesn't exist, -1 if wrong type.
pub fn store_zcard(s: *Store, key: StrView) -> i64
    match store_live_entry(s, key)
        Some(entry) =>
            if entry.value_type == VALUE_ZSET
                return s.zsets.get(entry.value_slot).len
            return -1  # Wrong type
        None => return 0

# ZRANGE: Get range by rank as borrowed views (empty if there is no zset).
pub fn store_zrange(s: *Store, key: StrView, start: i64, stop: i64) -> Vec<StrView>
    match store_get_zset(s, key)
        Some(zset) => return zset_range(zset, start, stop)
        None => return vec_new<StrView>()

# ZREVRANGE: Get reverse range by rank as borrowed views.
pub fn store_zrevrange(s: *Store, key: StrView, start: i64, stop: i64) -> Vec<StrView>
    match store_get_zset(s, key)
        Some(zset) => return zset_revrange(zset, start, stop)
        None => return vec_new<StrView>()

# ============================================================================
# Ranges by score and by member (AGAST #4284)
# ============================================================================
# A ZRangeSpec is Redis's zrangespec / zlexrangespec: the interval ZCOUNT,
# ZRANGE BYSCORE / BYLEX and Z[REV]RANGEBY{SCORE,LEX} select.

const ZRANGE_BY_SCORE: i32 = 1
const ZRANGE_BY_LEX: i32 = 2

# Kinds of lexicographic bound: "-" (below every member), "+" (above every
# member), or a value ("[v" inclusive, "(v" exclusive).
const ZLEX_NEG_INF: i32 = 0
const ZLEX_POS_INF: i32 = 1
const ZLEX_VALUE: i32 = 2

struct ZLexBound
    kind: i32
    excl: bool
    value: StrView           # borrowed; only for ZLEX_VALUE

struct ZRangeSpec
    by: i32                  # ZRANGE_BY_SCORE or ZRANGE_BY_LEX
    min: f64                 # score bounds (BY_SCORE)
    max: f64
    minex: bool              # true: the bound itself is excluded
    maxex: bool
    lmin: ZLexBound          # member bounds (BY_LEX)
    lmax: ZLexBound

# One member of a range reply: its bytes (borrowed from the set) and score.
struct ZItem
    member: StrView
    score: f64

fn zlex_gte_min(b: *ZLexBound, v: StrView) -> bool
    if b.kind == ZLEX_NEG_INF
        return true
    if b.kind == ZLEX_POS_INF
        return false
    let c: Ordering = v.cmp(b.value)
    if b.excl
        return c.is_gt()
    return c.is_ge()

fn zlex_lte_max(b: *ZLexBound, v: StrView) -> bool
    if b.kind == ZLEX_POS_INF
        return true
    if b.kind == ZLEX_NEG_INF
        return false
    let c: Ordering = v.cmp(b.value)
    if b.excl
        return c.is_lt()
    return c.is_le()

# True if (score, member) lies inside spec.  An empty interval (min > max,
# or min == max with an end excluded) holds nothing.  A lexicographic range
# compares members bytewise, as Redis does; like Redis it is meant for a set
# whose scores are all equal.
pub fn zrange_spec_contains(spec: *ZRangeSpec, score: f64, member: StrView) -> bool
    if spec.by == ZRANGE_BY_LEX
        return zlex_gte_min(@spec.lmin, member) and zlex_lte_max(@spec.lmax, member)
    if spec.minex
        if not (score > spec.min)
            return false
    else if not (score >= spec.min)
        return false
    if spec.maxex
        return score < spec.max
    return score <= spec.max

# Number of members of zset inside spec.
pub fn zset_count_spec(zset: @ZSet, spec: *ZRangeSpec) -> i64
    var n: i64 = 0
    var x: i64 = zset_next(zset, ZHEAD, 0)
    while x != ZNIL
        let node: @ZSetNode = zset.nodes.get(x)
        if zrange_spec_contains(spec, node.score, (node.member).as_view())
            n += 1
        x = zset_next(zset, x, 0)
    return n

# The members of zset inside spec, ascending (descending with `rev`), after
# skipping `offset` of them and keeping at most `limit` (negative: all).  A
# negative offset selects nothing, as in Redis.
pub fn zset_range_spec(zset: @ZSet, spec: *ZRangeSpec, rev: bool, offset: i64, limit: i64) -> Vec<ZItem>
    var items: Vec<ZItem> = vec_new<ZItem>()
    if offset < 0 or limit == 0
        return items
    let n: i64 = zset_count_spec(zset, spec)
    if offset >= n
        return items
    var take: i64 = n - offset
    if limit > 0 and limit < take
        take = limit

    # The reply is the matches first..first+take in ascending order, read
    # forwards, or (rev) the ones counted from the top, read backwards.
    var first: i64 = offset
    if rev
        first = n - offset - take
    var idx: i64 = 0
    var x: i64 = zset_next(zset, ZHEAD, 0)
    while x != ZNIL and idx < first + take
        let node: @ZSetNode = zset.nodes.get(x)
        let m: StrView = (node.member).as_view()
        if zrange_spec_contains(spec, node.score, m)
            if idx >= first
                items.push(ZItem { member: m, score: node.score })
            idx += 1
        x = zset_next(zset, x, 0)
    if rev
        var i: i64 = 0
        var j: i64 = items.len() - 1
        while i < j
            items.swap(i, j)
            i += 1
            j -= 1
    return items

# ZCOUNT: members of key's zset inside spec (0 if there is none).
pub fn store_zcount(s: *Store, key: StrView, spec: *ZRangeSpec) -> i64
    match store_get_zset(s, key)
        Some(zset) => return zset_count_spec(zset, spec)
        None => return 0

# ZRANGE BYSCORE / BYLEX: see zset_range_spec.  No items if there is no zset.
pub fn store_zrange_spec(s: *Store, key: StrView, spec: *ZRangeSpec, rev: bool, offset: i64, limit: i64) -> Vec<ZItem>
    match store_get_zset(s, key)
        Some(zset) => return zset_range_spec(zset, spec, rev, offset, limit)
        None => return vec_new<ZItem>()
