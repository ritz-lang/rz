# valet/src/main.ritz - Valet HTTP server with routing and config
#
# A high-performance async HTTP server written in Ritz.
#
# Usage:
#   ./valet [options]
#
# Options:
#   -c, --config FILE   Load configuration from JSON file
#   -p, --port PORT     Listen port (default: 8080, overrides config)
#   -w, --workers N     Number of worker processes (default: 1, overrides config)
#   -m, --multishot     Use multishot accept (kernel 5.19+)
#   -h, --help          Show this help message
#
# Config file: See valet.json for format

import ritzlib.sys
import ritzlib.fmt
import ritzlib.option
import ritzlib.result
import ritzlib.strview
import ritzlib.span { Span }
import ritzlib.string
import ritzlib.gvec
import ritzlib.argspec
import ritzlib.mapping
import ritzlib.async.tasks

import lib.valet
import lib.config
import lib.log
import lib.router
import lib.json_builder
import lib.proxy { proxy_response_bytes, proxy_copy_headers, PROXY_CONNECTION_EXTRA, proxy_yield_delay_us }
import lib.response {
    response_init,
    response_status,
    response_header,
    response_content_length,
    response_end_headers,
    response_body
}

# Zeus reverse-proxy support (--zeus-socket).  When valet is told to talk
# to a zeus daemon, it acts as a thin nginx-shaped front-end: receive HTTP,
# dispatch to a worker via the shared-memory ring, copy the response back.
import zeus.zeus_client {
    ZeusClient,
    ZeusClientConfig,
    zeus_client_config_default,
    zeus_client_init,
    zeus_client_destroy,
    zeus_client_connect,
    zeus_client_handshake,
    zeus_client_recv_worker,
    zeus_client_get_worker,
    zeus_client_select_worker,
    zeus_client_next_request_id,
    zeus_client_submit_request,
    zeus_client_poll_response,
    zeus_client_wait_response,
    zeus_client_peek_response,
    zeus_client_peek_response_slot,
    zeus_client_sweep_resp_ring,
    zeus_client_peek_request_slot,
    worker_handle_get_arena,
    worker_handle_get_slot_arena,
    WorkerHandle
}
import zeus.ring {
    RequestSlot,
    ResponseSlot,
    request_slot_init,
    response_slot_init,
    HTTP_METHOD_GET,
    HTTP_METHOD_POST,
    HTTP_METHOD_PUT,
    HTTP_METHOD_DELETE,
    HTTP_METHOD_HEAD,
    HTTP_METHOD_OPTIONS,
    HTTP_METHOD_PATCH,
    REQ_FLAG_COMPLETE
}
import zeus.arena {
    DataArena,
    data_arena_alloc,
    data_arena_ptr_to_offset,
    data_arena_offset_to_ptr,
    data_arena_bytes
}


# ============================================================================
# Middleware
# ============================================================================

# Logging middleware - logs every request
fn logging_middleware(path: *u8, path_len: i32) -> i32
    log_info("Request: ")
    # Print the request's path (at most 255 bytes of it), as the handler
    # context has it: the same bytes as path[0..path_len)
    let c: *HandlerContext = ctx()
    if c != null
        let shown: StrView = c.path.take(255)
        print("{shown}\n")
    return MW_CONTINUE  # Continue to next middleware/handler


# ============================================================================
# Route handlers
# ============================================================================

# Route parameter `idx` when it is shorter than `max` bytes, else None: the
# limit each handler's fixed copy buffer used to set, kept so an over-long
# parameter is still answered as a missing one.
fn param_shorter_than(idx: i32, max: i64) -> Option<StrView>
    match ctx_param(idx)
        Some(v) =>
            if v.len >= max
                return None
            Some(v)
        None => None


# GET / - Benchmark endpoint
fn handle_index(path: *u8, path_len: i32) -> i32
    return ctx_ok("Hello, World!")


# GET /hello - Greeting
fn handle_hello(path: *u8, path_len: i32) -> i32
    return ctx_ok("Hello from Valet!\n")


# GET /users/:id - User by ID
fn handle_user(path: *u8, path_len: i32) -> i32
    let id: StrView = match param_shorter_than(0, 64)
        Some(v) => v
        None => return ctx_text(400, "Missing user ID\n")

    # Build response: "User ID: <id>\n"
    var body: String = string_from("User ID: ")
    body.push_str(id)
    body.push('\n')
    return ctx_ok(body.as_view())


# GET /json - JSON response
fn handle_json(path: *u8, path_len: i32) -> i32
    # Build JSON using builder (much cleaner than character-by-character)
    var buf: [256]u8
    var jb: JsonBuilder
    json_init(@jb, @buf)
    json_object_start(@jb)
    json_key_str(@jb, "msg", "Hello Valet")
    json_key_int(@jb, "version", 1)
    json_key_bool(@jb, "active", 1)
    json_object_end(@jb)
    return ctx_json(200, json_bytes(@jb))


# GET /echo/:msg - Echo message back
fn handle_echo(path: *u8, path_len: i32) -> i32
    let msg: StrView = match param_shorter_than(0, 255)
        Some(v) => v
        None => return ctx_text(400, "Missing message\n")

    # Add newline
    var body: String = string_from(msg)
    body.push('\n')
    return ctx_ok(body.as_view())


# POST /echo - "<body length> <first ECHO_MAX bytes of the body>\n". Shows
# which bytes valet framed as the body: test/test_framing.sh (AGAST #1865).
const ECHO_MAX: i64 = 1000

fn handle_echo_body(path: *u8, path_len: i32) -> i32
    let c: *HandlerContext = ctx()
    if c == null
        return 1
    var out: String = string_new()
    out.push_i64(c.req.content_length)
    out.push(' ')
    let body: Span<u8> = ctx_body_bytes()
    out.push_span(body.to(ECHO_MAX))
    out.push('\n')
    return ctx_ok(out.as_view())


# POST /mirror - the request body, whole, as the response body, sent the
# way the zeus proxy sends: the handler yields (STATUS_PROXY_PENDING) and
# the continuation sizes a valet_response_buffer BEFORE copying the body
# into it.  A >8 KB request sits in a heap buffer that a >8 KB response
# buffer must not unmap (AGAST #3900, test/test_large_echo.sh).  The body
# view, per task slot, is the request's own bytes, still in place.
var g_mirror_body: [256]Span<u8>

fn handle_mirror(path: *u8, path_len: i32) -> i32
    let c: *HandlerContext = ctx()
    if c == null
        return 1
    let idx: i32 = valet_task_slot_idx(c.task)
    if idx < 0
        return ctx_text(503, "mirror: no task slot\n")
    g_mirror_body[idx] = ctx_body_bytes()
    if valet_proxy_arm_yield(c.task, 0) < 0
        return ctx_text(503, "mirror: failed to arm yield\n")
    return STATUS_PROXY_PENDING


fn handle_mirror_continuation(task: *Task) -> i32
    let idx: i32 = valet_task_slot_idx(task)
    if idx < 0
        return 1
    let body: Span<u8> = g_mirror_body[idx]
    let body_len: i64 = body.len
    var hdr: [256]u8
    var hres: Response
    response_init(@hres, @hdr[0], 256)
    response_status(@hres, 200)
    response_header(@hres, "Content-Type", "application/octet-stream")
    response_content_length(@hres, body_len)
    if valet_task_closing(task) != 0
        response_header(@hres, "Connection", "close")
    response_end_headers(@hres)
    let hdr_len: i64 = hres.len as i64

    # Size the reply first, as the zeus proxy does, then read the body.
    let out: Span<u8> = valet_response_buffer(task, hdr_len + body_len)
    if out.len == 0
        return 1
    let hdr_bytes: Span<u8> = @hdr
    out.copy_from(hdr_bytes.to(hdr_len))
    out.from(hdr_len).copy_from(body)
    return valet_task_send_response(task, out)


# GET /bytes/:n - n bytes of body (at most BYTES_MAX), a repeating
# "0123456789". A response size picked by the client: HTTPS tests use it to
# force short sends (AGAST #2197).
const BYTES_MAX: i32 = 3500

fn handle_bytes(path: *u8, path_len: i32) -> i32
    # Room for any i64 and then some: a longer count is "Missing" (AGAST #4037).
    let count: StrView = match param_shorter_than(0, 31)
        Some(v) => v
        None => return ctx_text(400, "Missing byte count\n")
    if count.is_empty()
        return ctx_text(400, "Missing byte count\n")
    # Digits only: parse_i64 would also take a sign.
    if count.get(0) < '0' || count.get(0) > '9'
        return ctx_text(400, "Bad byte count\n")
    var n: i32 = 0
    match count.parse_i64()
        Some(v) =>
            if v > BYTES_MAX as i64
                return ctx_text(400, "Bad byte count\n")
            n = v as i32
        None => return ctx_text(400, "Bad byte count\n")
    # "0123456789" repeated: a test pattern indexed by byte offset, not a
    # number in decimal, so not a ritzlib.fmt job.
    var body: String = string_with_cap(n as i64)
    for i in 0..n
        body.push('0' + (i % 10) as u8)
    return ctx_ok(body.as_view())


# GET /api/** - Catch-all API route
fn handle_api_catchall(path: *u8, path_len: i32) -> i32
    let rest: StrView = match param_shorter_than(0, 255)
        Some(v) => v
        None => ""

    # Build response: "API path: <remainder>\n" (or "/" if empty)
    var body: String = string_from("API path: ")
    if rest.is_empty()
        body.push('/')
    else
        body.push_str(rest)
    body.push('\n')
    return ctx_ok(body.as_view())


# ============================================================================
# Zeus reverse-proxy mode
# ============================================================================
#
# When --zeus-socket is given, valet stops being a stand-alone HTTP server
# and becomes the front-end of a `valet → zeus → app` pipeline:
#
#   browser ─HTTP/1.1─► valet ─shm-ring─► zeus worker (e.g. nexus)
#                          ▲                  │
#                          └────── shm ───────┘
#
# Today the dispatch is synchronous (busy-poll the response ring with a
# small sleep).  This holds up the connection while the worker runs.  It's
# enough to prove the architecture and run a real wiki end-to-end; an
# async dispatch using the existing futex slots is a follow-up.

# Module-level handles for the proxy.  Stored as i64 so we can guard with
# `== 0` ("not configured") without dragging null pointer initialisers
# into globals (Ritz doesn't allow null *T in `var`).
var g_zeus_client_ptr: i64 = 0
var g_zeus_attached: i32 = 0


fn get_zeus_client() -> *ZeusClient
    return g_zeus_client_ptr as *ZeusClient


# Map an HTTP method string from the request line to zeus's HTTP_METHOD_*
# code.  Returns 0 (unknown) if the method isn't one we proxy.
fn http_method_code(method: StrView) -> u8
    if method.eq("GET")
        return HTTP_METHOD_GET
    if method.eq("POST")
        return HTTP_METHOD_POST
    if method.eq("PUT")
        return HTTP_METHOD_PUT
    if method.eq("DELETE")
        return HTTP_METHOD_DELETE
    if method.eq("HEAD")
        return HTTP_METHOD_HEAD
    if method.eq("OPTIONS")
        return HTTP_METHOD_OPTIONS
    if method.eq("PATCH")
        return HTTP_METHOD_PATCH
    return 0


# Proxy a single request through the zeus shm ring.
#
# Catch-all handler registered for every method when --zeus-socket is set.
# Builds a RequestSlot, allocates the path bytes (and body bytes for POST/
# PUT/PATCH) in the worker's data arena, submits, and busy-polls the
# response ring for up to 5 seconds.  Forwards status + Content-Length +
# body bytes back to the HTTP client.
#
# Limitations (acknowledged, follow-ups tracked):
#   * Synchronous dispatch — the connection stalls while the worker runs.
#   * Content-Type is forwarded as text/html (workers like nexus produce a
#     full HTTP response in their headers blob, but we don't parse it back
#     yet).  This is enough for nexus today; mausoleum/static will need
#     proper header forwarding.
#   * No streaming, no chunked, no trailers.
fn handle_zeus_proxy(path: *u8, path_len: i32) -> i32
    g_proxy_total_entries = g_proxy_total_entries + 1
    let c: *HandlerContext = ctx()
    if c == null
        return -1

    let client: *ZeusClient = get_zeus_client()
    if client == null
        return ctx_text(503, "zeus client not configured\n")

    # Pick a worker
    let worker_idx: i32 = zeus_client_select_worker(client)
    if worker_idx < 0
        return ctx_text(503, "no zeus worker available\n")

    let handle: *WorkerHandle = zeus_client_get_worker(client, worker_idx)
    if handle == null
        return ctx_text(503, "zeus worker handle null\n")

    # Per-slot arena: peek the slot the next submit will write to and
    # allocate path / body bytes inside that slot's exclusive region.
    # In the single-threaded coroutine model this peek is sticky for
    # the duration of straight-line code up to submit_request — no
    # other task can interleave a submit between here and there.
    let claimed_slot: i64 = zeus_client_peek_request_slot(client, worker_idx)
    if claimed_slot < 0
        g_proxy_ring_full = g_proxy_ring_full + 1
        return ctx_text(503, "zeus request ring full\n")

    var arena: DataArena
    worker_handle_get_slot_arena(handle, claimed_slot, @arena)
    if arena.base == null
        return ctx_text(503, "zeus arena unavailable\n")

    # Allocate + copy path bytes
    let path_dst: *u8 = data_arena_alloc(@arena, path_len as i64)
    if path_dst == null
        g_proxy_arena_oversize = g_proxy_arena_oversize + 1
        return ctx_text(503, "zeus arena: out of space for path\n")
    let path_offset: i64 = data_arena_ptr_to_offset(@arena, path_dst)
    data_arena_bytes(@arena, path_offset, path_len as i64).copy_from(c.path.as_bytes())

    # Copy the body (if any) straight from the request buffer into the
    # slot arena.  The framework has already read the whole body, however
    # large (AGAST #2104); a short body here means the client lied about
    # Content-Length.
    var body_offset: i64 = 0
    var body_len: i32 = 0
    let want: i32 = c.req.content_length as i32
    if want > 0
        if c.req.headers_end < 0 or (c.req.headers_end + want) as i64 > c.raw.len
            return ctx_text(400, "incomplete request body\n")
        let body_dst: *u8 = data_arena_alloc(@arena, want as i64)
        if body_dst == null
            g_proxy_arena_oversize = g_proxy_arena_oversize + 1
            return ctx_text(413, "request body too large for zeus slot\n")
        body_offset = data_arena_ptr_to_offset(@arena, body_dst)
        let body_src: i64 = c.req.headers_end as i64
        data_arena_bytes(@arena, body_offset, want as i64).copy_from(c.raw[body_src..body_src + want as i64])
        body_len = want

    # Build + submit RequestSlot
    var req: RequestSlot
    request_slot_init(@req)
    req.id = zeus_client_next_request_id(client)
    req.method = http_method_code(c.req.method)
    if req.method == 0
        return ctx_text(405, "unsupported method\n")
    req.flags = REQ_FLAG_COMPLETE
    req.path_offset = path_offset as u32
    req.path_len = path_len as u16
    req.body_offset = body_offset as u32
    req.body_len = body_len as u32

    let submit_rc: i32 = zeus_client_submit_request(client, worker_idx, @req)
    if submit_rc != 0
        g_proxy_submit_fail = g_proxy_submit_fail + 1
        return ctx_text(503, "zeus submit failed\n")
    g_proxy_total_submits = g_proxy_total_submits + 1

    # Cooperative yield: stash per-task state, arm a NOP SQE, return
    # STATUS_PROXY_PENDING.  The framework re-enters via the registered
    # continuation when the CQE fires.  This decouples valet's task
    # loop from any one worker's response time — pipelined requests
    # actually overlap.
    let task: *Task = ctx_task()
    if task == null
        return ctx_text(503, "zeus: no task in ctx\n")

    let st: *ProxyState = valet_proxy_state(task)
    if st == null
        return ctx_text(503, "zeus: proxy state unavailable\n")

    st.in_use = 1
    st.worker_idx = worker_idx
    st.request_id = req.id
    st.claimed_slot = claimed_slot
    st.spin_count = 0
    st.deadline_sec = get_current_time() + PROXY_DEADLINE_SEC

    let arm_rc: i32 = valet_proxy_arm_yield(task, 0)
    if arm_rc < 0
        g_proxy_arm_fail = g_proxy_arm_fail + 1
        valet_proxy_state_clear(task)
        return ctx_text(503, "zeus: failed to arm yield\n")

    g_proxy_pending_returned = g_proxy_pending_returned + 1
    return STATUS_PROXY_PENDING


# Send a short plain-text error from the proxy continuation (status 5xx,
# Connection: close) and move to CONN_STATE_SEND.
fn proxy_send_error(task: *Task, status: i32, msg: StrView) -> i32
    var res: Response
    response_init(@res, @task.write_buf[0], 8192)
    response_status(@res, status)
    response_header(@res, "Content-Type", "text/plain")
    response_header(@res, "Connection", "close")
    response_content_length(@res, msg.len)
    response_end_headers(@res)
    response_body(@res, msg.as_bytes())
    let wb: Span<u8> = @task.write_buf
    return valet_task_send_response(task, wb.to(res.len as i64))


# Cooperative-yield deadline: how long to keep re-arming yields before
# giving up with 504.  Matches the legacy sync timeout.
const PROXY_DEADLINE_SEC: i64 = 5

# Atomic counters bumped only on specific error paths so we can see
# what's actually firing without per-request log spam (which itself
# tanks perf — we learned this the hard way at 67 r/s).
var g_proxy_ring_full: i64 = 0
var g_proxy_submit_fail: i64 = 0
var g_proxy_arm_fail: i64 = 0
var g_proxy_send_fail_continuation: i64 = 0
var g_proxy_state_lost: i64 = 0       # st == null or in_use == 0 in continuation
var g_proxy_handle_null: i64 = 0
var g_proxy_deadline_504: i64 = 0
var g_proxy_arena_oversize: i64 = 0
var g_proxy_bad_response: i64 = 0     # response out of slot bounds / unbufferable
var g_proxy_total_entries: i64 = 0     # handle_zeus_proxy entries
var g_proxy_total_submits: i64 = 0
var g_proxy_total_completions: i64 = 0
var g_proxy_total_continuations: i64 = 0
var g_proxy_pending_returned: i64 = 0  # times we returned STATUS_PROXY_PENDING

pub fn proxy_dump_counters()
    print("[counters] entries={g_proxy_total_entries}")
    print(" pending_ret={g_proxy_pending_returned}")
    print(" submits={g_proxy_total_submits}")
    print(" completions={g_proxy_total_completions}")
    print(" continuations={g_proxy_total_continuations}")
    print(" ring_full={g_proxy_ring_full}")
    print(" submit_fail={g_proxy_submit_fail}")
    print(" arm_fail={g_proxy_arm_fail}")
    print(" send_fail_cont={g_proxy_send_fail_continuation}")
    print(" state_lost={g_proxy_state_lost}")
    print(" handle_null={g_proxy_handle_null}")
    print(" deadline_504={g_proxy_deadline_504}")
    print(" arena_oversize={g_proxy_arena_oversize}")
    print(" bad_response={g_proxy_bad_response}\n")


# Continuation for the cooperative-yield proxy.  Invoked by valet's
# framework whenever a CQE wakes a CONN_STATE_PROXY_WAIT task.  Peeks
# the saved worker's response ring with peek-by-id (consumes only when
# the head matches our request_id, leaves other in-flight requests'
# heads alone for their owners to claim).  On hit, builds the HTTP
# reply into task.write_buf and transitions to CONN_STATE_SEND.  On
# miss, re-arms the yield until the deadline elapses.
fn handle_zeus_proxy_continuation(task: *Task) -> i32
    g_proxy_total_continuations = g_proxy_total_continuations + 1
    let st: *ProxyState = valet_proxy_state(task)
    if st == null or st.in_use == 0
        g_proxy_state_lost = g_proxy_state_lost + 1
        return 1

    let client: *ZeusClient = get_zeus_client()
    if client == null
        valet_proxy_state_clear(task)
        return 1

    # Inline spin: most responses are in the ring within tens of µs.
    # Spinning avoids the NOP-yield round-trip when the worker has
    # already produced our response.  N=128 catches the common fast
    # case without dominating CPU when we miss.
    #
    # Slot-direct peek bypasses the FIFO head-of-line stall: each task
    # checks its own claimed slot independently, so a stuck/dead head
    # belonging to another task can't block us.  After a successful
    # consume, sweep resp_read_idx forward past any contiguous already-
    # consumed slots so the worker reclaims ring space.
    var resp: ResponseSlot
    response_slot_init(@resp)
    var peek_rc: i32 = 0
    var spin_i: i32 = 0
    while spin_i < 128
        peek_rc = zeus_client_peek_response_slot(client, st.worker_idx, st.claimed_slot, st.request_id, @resp)
        if peek_rc != 0
            break
        spin_i = spin_i + 1

    if peek_rc == 1
        # Reclaim ring space for the worker.  Cheap O(consecutive zero
        # slots) walk; usually 1-3 slots per consume.
        zeus_client_sweep_resp_ring(client, st.worker_idx)
        let handle: *WorkerHandle = zeus_client_get_worker(client, st.worker_idx)
        if handle == null
            g_proxy_handle_null = g_proxy_handle_null + 1
            valet_proxy_state_clear(task)
            return 1

        # Per-slot arena view to resolve the response header + body offsets.
        var arena: DataArena
        worker_handle_get_slot_arena(handle, st.claimed_slot, @arena)
        valet_proxy_state_clear(task)

        # Pass the worker's pre-baked HTTP response prefix through verbatim.
        # The worker writes the full status line + header block (terminated
        # by \r\n\r\n) into its arena slice — see send_raw in
        # nexus/src/main.ritz.  Letting the worker own the prefix keeps
        # Location (302/303), Cache-Control, Set-Cookie etc. intact.
        #
        # The offsets/lengths come from another process: they are checked
        # against the slot's bounds before a byte is read, and the send
        # buffer is sized from them — task.write_buf when it fits, a heap
        # buffer otherwise (AGAST #2104; a fixed 8 KB buffer used to ship a
        # truncated 200 and hang the connection).
        let headers_len: i64 = resp.headers_len as i64
        let body_len: i64 = resp.body_len as i64
        let total: i64 = proxy_response_bytes(arena.offset, arena.size, resp.headers_offset as i64, headers_len, resp.body_offset as i64, body_len)
        if total < 0
            g_proxy_bad_response = g_proxy_bad_response + 1
            return proxy_send_error(task, 502, "zeus worker response out of bounds\n")

        # Defensive fallback: worker didn't populate headers (e.g. nexus's
        # bare 500 when its arena is full).  Build a minimal header block.
        var fallback: [256]u8
        var hdr_ptr: *u8 = data_arena_offset_to_ptr(@arena, resp.headers_offset as i64)
        var hdr_len: i64 = headers_len
        if headers_len == 0
            var hres: Response
            response_init(@hres, @fallback[0], 256)
            response_status(@hres, resp.status as i32)
            response_header(@hres, "Content-Type", "text/html; charset=utf-8")
            response_content_length(@hres, body_len)
            # No Connection header: proxy_copy_headers below appends
            # valet's own, "close" when valet_task_closing (AGAST #2117).
            response_end_headers(@hres)
            hdr_ptr = @fallback[0]
            hdr_len = hres.len as i64

        # The worker's Connection header is replaced by valet's: only valet
        # knows whether it keeps this connection (AGAST #2459).
        let cap: i64 = hdr_len + PROXY_CONNECTION_EXTRA + body_len
        let out: Span<u8> = valet_response_buffer(task, cap)
        if out.len == 0
            g_proxy_bad_response = g_proxy_bad_response + 1
            return proxy_send_error(task, 502, "zeus worker response too large\n")
        let out_hdr_len: i64 = proxy_copy_headers(out.ptr, hdr_len + PROXY_CONNECTION_EXTRA, hdr_ptr, hdr_len, valet_task_closing(task))
        if out_hdr_len < 0
            g_proxy_bad_response = g_proxy_bad_response + 1
            return proxy_send_error(task, 502, "zeus worker response headers malformed\n")
        if body_len > 0
            out.from(out_hdr_len).copy_from(data_arena_bytes(@arena, resp.body_offset as i64, body_len))
        let out_len: i64 = out_hdr_len + body_len

        let ret: i32 = valet_task_send_response(task, out.to(out_len))
        if ret > 0
            g_proxy_send_fail_continuation = g_proxy_send_fail_continuation + 1
            return 1
        g_proxy_total_completions = g_proxy_total_completions + 1
        return -1

    # Miss.  Deadline check.
    let now_sec: i64 = get_current_time()
    if now_sec >= st.deadline_sec
        g_proxy_deadline_504 = g_proxy_deadline_504 + 1
        valet_proxy_state_clear(task)
        return proxy_send_error(task, 504, "zeus worker timeout\n")

    # Re-arm the yield, backing off from NOPs to timers of up to 1 ms
    # (AGAST #183): NOP-only yields from many waiters starved the loop.
    st.spin_count = st.spin_count + 1
    let arm_rc: i32 = valet_proxy_arm_yield(task, proxy_yield_delay_us(st.spin_count))
    if arm_rc < 0
        g_proxy_arm_fail = g_proxy_arm_fail + 1
        valet_proxy_state_clear(task)
        return 1
    return -1


# Register the proxy handler under every method as a catch-all.
fn register_zeus_proxy(app: *Valet)
    valet_get(app, "/**", handle_zeus_proxy)
    valet_post(app, "/**", handle_zeus_proxy)
    valet_put(app, "/**", handle_zeus_proxy)
    valet_add_route(app, "DELETE", "/**", handle_zeus_proxy)
    valet_add_route(app, "HEAD", "/**", handle_zeus_proxy)
    valet_add_route(app, "OPTIONS", "/**", handle_zeus_proxy)
    valet_add_route(app, "PATCH", "/**", handle_zeus_proxy)


# ============================================================================
# Command line (ritzlib.argspec, AGAST #1495)
# ============================================================================

fn build_spec() -> ArgSpec
    var spec = argspec_new("valet", "A high-performance async HTTP server written in Ritz")
    spec.switch('h', "help", "Show this help message")
    spec.option('c', "config", "FILE", "Load configuration from JSON file", None)
    spec.option('p', "port", "PORT", "Listen port (overrides config)", None)
    spec.option('w', "workers", "N", "Number of worker processes (overrides config)", None)
    spec.switch('m', "multishot", "Use multishot accept (kernel 5.19+)")
    spec.option('z', "zeus-socket", "PATH", "Reverse-proxy mode: dispatch all requests to a zeus daemon at PATH", None)
    spec

# Report a usage error as "valet: <message>" on stderr; 1 is valet's exit
# status for it.
fn usage_error(spec: @ArgSpec, e: ArgError) -> i32
    spec.error_print(@e)
    1

fn store_i64(out: *i64, n: i64) -> i32
    *out = n
    0

# The integer given for option `name` into *out (left alone when the option
# is absent).  0 on success; 1, after reporting it, when the value is not a
# number -- the old ArgParser read that as a silent 0.
fn cli_int(spec: @ArgSpec, p: @ParsedArgs, name: StrView, out: *i64) -> i32
    if p.is_set(name) == false
        return 0
    match p.int(name)
        Ok(n) => store_i64(out, n)
        Err(e) => usage_error(spec, e)

# The path given for option `name`, or an empty view.  The view points into
# argv, so its .ptr is NUL-terminated (`--config=F` and `-cF` are suffixes of
# an argv entry) and can be handed to the *u8 APIs below.
fn cli_path(p: @ParsedArgs, name: StrView) -> StrView
    let v = p.value(name)
    option_unwrap_or<StrView>(@v, strview_empty())


# ============================================================================
# Main
# ============================================================================

pub fn main(args: Span<StrView>) -> i32
    # Parse arguments. args[0] is the program name.
    let spec = build_spec()
    let parsed = match spec.parse(args.from(1))
        Ok(p) => p
        Err(e) => return usage_error(@spec, e)

    if parsed.switch("help")
        spec.print_help()
        return 0

    var cli_port: i64 = 0
    var cli_workers: i64 = 0
    if cli_int(@spec, @parsed, "port", @cli_port) != 0
        return 1
    if cli_int(@spec, @parsed, "workers", @cli_workers) != 0
        return 1
    let cli_multishot: bool = parsed.switch("multishot")

    # Load configuration
    var cfg: ValetConfig
    config_default(@cfg)

    # Try to load config file
    let config_path: StrView = cli_path(@parsed, "config")
    if config_path.len > 0
        let ret: i32 = config_load(@cfg, config_path)
        if ret < 0
            eprint("valet: failed to load config file\n")
            return 1
        print("Loaded config from: {config_path}\n")
    else
        # Try default config file
        if config_load(@cfg, "valet.json") == 0
            print("Loaded config from: valet.json\n")

    # Command-line overrides
    if cli_port > 0
        cfg.port = cli_port as i32
    if cli_workers > 0
        cfg.workers = cli_workers as i32
    if cli_multishot
        cfg.multishot = 1

    # Validate
    if cfg.port <= 0 || cfg.port > 65535
        eprint("valet: invalid port number\n")
        return 1

    if cfg.workers < 0
        eprint("valet: invalid worker count\n")
        return 1

    # Setup signal handling
    config_setup_signals()

    # Print banner
    print("\n")
    print("Valet HTTP Server\n")
    print("=================\n")
    config_print(@cfg)
    print("\n")

    # Initialize Valet app
    var app: Valet
    valet_init(@app, cfg.port)
    valet_workers(@app, cfg.workers)
    valet_multishot(@app, cfg.multishot)
    valet_use_send_zc(@app, cfg.use_send_zc)
    valet_backlog(@app, cfg.backlog)
    valet_sndbuf(@app, cfg.sndbuf)
    valet_idle_timeout(@app, cfg.idle_timeout)
    valet_keepalive_requests(@app, cfg.keepalive_requests)
    valet_max_request_size(@app, cfg.max_request_size)
    valet_max_connections(@app, cfg.max_connections)

    # Configure static file serving if enabled in config
    if cfg.static_enabled != 0
        valet_static(@app, config_str(@cfg.static_prefix), config_str(@cfg.static_root))

    # Configure TLS if enabled
    if cfg.tls_enabled != 0
        let tls_ret: i32 = valet_tls_files(@app, config_str(@cfg.tls_cert), config_str(@cfg.tls_key))
        if tls_ret < 0
            eprint("valet: failed to load TLS certificates\n")
            return 1

    # Register middleware
    valet_use_named(@app, "logging", logging_middleware)

    # Reverse-proxy mode: --zeus-socket <path>.  When set, valet stops
    # serving its built-in routes and instead forwards every request to a
    # zeus daemon over the shm ring.  See handle_zeus_proxy above.
    let zeus_sock: StrView = cli_path(@parsed, "zeus-socket")
    if zeus_sock.len > 0
        print("Zeus reverse-proxy mode enabled\n")
        print("  zeus socket: {zeus_sock}\n")

        # Allocate the client on the heap so its address survives across
        # handler invocations (handlers reach it via g_zeus_client_ptr).
        var client: *ZeusClient = null
        match mmap_anon(4096)
            Ok(m) => client = m.ptr as *ZeusClient
            Err(_) =>
                eprint("valet: failed to allocate zeus client\n")
                return 1

        var zcfg: ZeusClientConfig
        zeus_client_config_default(@zcfg)

        let zinit: i32 = zeus_client_init(client, @zcfg)
        if zinit != 0
            eprint("valet: zeus_client_init failed\n")
            return 1

        let zconn: i32 = zeus_client_connect(client, zeus_sock.ptr)
        if zconn != 0
            eprint("valet: zeus_client_connect failed\n")
            return 1

        let zhs: i32 = zeus_client_handshake(client)
        if zhs < 0
            eprint("valet: zeus handshake failed\n")
            return 1

        print("  reported workers: {zhs}\n")

        var attached: i32 = 0
        while attached < zhs
            let widx: i32 = zeus_client_recv_worker(client)
            if widx < 0
                eprint("valet: failed to receive worker info\n")
                return 1
            attached += 1

        print("  attached workers: {attached}\n")

        g_zeus_client_ptr = client as i64
        g_zeus_attached = attached

        # Wire the framework continuation hook BEFORE registering routes
        # so dispatch is ready as soon as the first request lands.
        valet_set_proxy_continuation(handle_zeus_proxy_continuation)

        register_zeus_proxy(@app)
    else
        # Stand-alone mode: register the built-in routes
        valet_get(@app, "/", handle_index)
        valet_get(@app, "/hello", handle_hello)
        valet_get(@app, "/json", handle_json)
        valet_get(@app, "/users/:id", handle_user)
        valet_get(@app, "/echo/:msg", handle_echo)
        valet_get(@app, "/bytes/:n", handle_bytes)
        valet_post(@app, "/echo", handle_echo_body)
        valet_post(@app, "/mirror", handle_mirror)
        valet_set_proxy_continuation(handle_mirror_continuation)
        valet_get(@app, "/api/**", handle_api_catchall)  # Catch-all for /api/*

    # Run the server
    return valet_run(@app)
