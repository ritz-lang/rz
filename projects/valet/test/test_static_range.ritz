# test/test_static_range.ritz - Range parsing and its 416 (AGAST #1865)
#
# parse_range turned "bytes=100-" on a 20-byte file into start 100, end 19,
# and static_serve_file_full then sent 206 with Content-Length -80.  A range
# that starts at or past the end of the file is unsatisfiable: 416.

import ritzlib.sys
import ritzlib.option
import ritzlib.string
import ritzlib.strview

import ritzlib.fd
import ritzlib.span
import ritzlib.fs { unlink }
import ritzlib.process { process_id }

import lib.static

# /tmp/valet_<pid>_<name>.  The pid keeps concurrent test runs off each
# other's files (AGAST #4052); ritzunit forks each test, so each test gets
# its own.
fn pid_tmp_path(name: StrView) -> String
    var path: String = string_from("/tmp/valet_")
    path.push_i64(process_id() as i64)
    path.push('_')
    path.push_str(name)
    path

fn range_of(hdr: StrView, size: i64) -> RangeResult
    return parse_range(hdr, size)

# 0 when `hdr` on a `size`-byte file is RANGE_OK start..end.
fn expect_ok(hdr: StrView, size: i64, start: i64, end: i64) -> i32
    let r: RangeResult = range_of(hdr, size)
    if r.valid != RANGE_OK
        return 1
    if r.start != start or r.end != end
        return 2
    if r.end < r.start or r.end >= size
        return 3
    0

[[test]]
fn test_range_open_ended_past_end_is_unsatisfiable() -> i32
    if range_of("bytes=100-", 20).valid != RANGE_UNSATISFIABLE
        return 1
    if range_of("bytes=20-", 20).valid != RANGE_UNSATISFIABLE
        return 2
    0

[[test]]
fn test_range_closed_past_end_is_unsatisfiable() -> i32
    if range_of("bytes=20-25", 20).valid != RANGE_UNSATISFIABLE
        return 1
    0

[[test]]
fn test_range_empty_file_is_unsatisfiable() -> i32
    if range_of("bytes=0-", 0).valid != RANGE_UNSATISFIABLE
        return 1
    if range_of("bytes=-5", 0).valid != RANGE_UNSATISFIABLE
        return 2
    if range_of("bytes=-0", 20).valid != RANGE_UNSATISFIABLE
        return 3
    0

[[test]]
fn test_range_huge_numbers_do_not_wrap() -> i32
    # 20 digits overflow an i64: the old parser wrapped them negative.
    if range_of("bytes=99999999999999999999-", 20).valid != RANGE_UNSATISFIABLE
        return 1
    if expect_ok("bytes=-99999999999999999999", 20, 0, 19) != 0
        return 2
    if expect_ok("bytes=3-99999999999999999999", 20, 3, 19) != 0
        return 3
    0

# Positions parse through ritzlib's strview_parse_i64 (AGAST #4037): the
# whole i64 range is a position, one past it saturates, and a sign (which
# strview_parse_i64 would take) is not a digit.
[[test]]
fn test_range_i64_extremes() -> i32
    # i64::MAX and i64::MAX + 1 as a start: past any file.
    if range_of("bytes=9223372036854775807-", 20).valid != RANGE_UNSATISFIABLE
        return 1
    if range_of("bytes=9223372036854775808-", 20).valid != RANGE_UNSATISFIABLE
        return 2
    # ... as an end: clamped to the file.
    if expect_ok("bytes=0-9223372036854775807", 20, 0, 19) != 0
        return 3
    if expect_ok("bytes=0-9223372036854775808", 20, 0, 19) != 0
        return 4
    # ... as a suffix length: the whole file.
    if expect_ok("bytes=-9223372036854775807", 20, 0, 19) != 0
        return 5
    if expect_ok("bytes=-9223372036854775808", 20, 0, 19) != 0
        return 6
    # 0 as a start and an end.
    if expect_ok("bytes=0-0", 20, 0, 0) != 0
        return 7
    # i64::MIN is not a position: "-" introduces a suffix, and a second
    # "-" is not a digit.
    if range_of("bytes=--9223372036854775808", 20).valid != RANGE_IGNORE
        return 8
    if range_of("bytes=0--9223372036854775808", 20).valid != RANGE_IGNORE
        return 9
    0

[[test]]
fn test_range_signs_and_junk_are_ignored() -> i32
    if range_of("bytes=+5-", 20).valid != RANGE_IGNORE
        return 1
    if range_of("bytes=0-+5", 20).valid != RANGE_IGNORE
        return 2
    if range_of("bytes=-+5", 20).valid != RANGE_IGNORE
        return 3
    if range_of("bytes=0-4x", 20).valid != RANGE_IGNORE
        return 4
    if range_of("bytes=1x-4", 20).valid != RANGE_IGNORE
        return 5
    if range_of("bytes=-5x", 20).valid != RANGE_IGNORE
        return 6
    # An empty position (a NUL ends it) is not a number, not an overflow.
    if parse_range("bytes=-\0", 20).valid != RANGE_IGNORE
        return 7
    if parse_range("bytes=0-\0", 20).valid != RANGE_IGNORE
        return 8
    0

[[test]]
fn test_range_in_file() -> i32
    if expect_ok("bytes=0-4", 20, 0, 4) != 0
        return 1
    if expect_ok("bytes=15-", 20, 15, 19) != 0
        return 2
    if expect_ok("bytes=10-1000", 20, 10, 19) != 0
        return 3
    if expect_ok("bytes=-5", 20, 15, 19) != 0
        return 4
    if expect_ok("bytes=-500", 20, 0, 19) != 0
        return 5
    if expect_ok("bytes=19-19", 20, 19, 19) != 0
        return 6
    0

[[test]]
fn test_range_invalid_is_ignored() -> i32
    if range_of("bytes=5-2", 20).valid != RANGE_IGNORE
        return 1
    if range_of("bytes=a-", 20).valid != RANGE_IGNORE
        return 2
    if range_of("items=0-4", 20).valid != RANGE_IGNORE
        return 3
    if range_of("bytes=-", 20).valid != RANGE_IGNORE
        return 4
    if range_of("bytes=4", 20).valid != RANGE_IGNORE
        return 5
    0


# Drain `f` into out[0..cap); returns bytes read.
fn drain(f: @Fd, out: *u8, cap: i32) -> i32
    var total: i32 = 0
    while total < cap
        var n: i64 = 0
        match f.read(Span<u8> { ptr: out + total, len: (cap - total) as i64 })
            Ok(got) => n = got
            Err(_) => n = -1
        if n <= 0
            break
        total += n as i32
    total

fn starts_with(out: *u8, n: i32, want: StrView) -> i32
    if (n as i64) < want.len
        return 0
    var i: i64 = 0
    while i < want.len
        if *(out + i) != *(want.ptr + i)
            return 0
        i += 1
    1

# Serve a 20-byte file with `range` into a pipe; the response lands in out.
#
# The file is this process's own (AGAST #4052): a fixed /tmp path let two
# concurrent valet test runs (gate slots, compiler variants) truncate or
# unlink each other's file between the write and the serve.
fn serve_range(range: StrView, out: *u8, cap: i32) -> i32
    var tmp: String = pid_tmp_path("static_range.txt")
    var f: Fd = match fd_open(tmp.as_view(), O_WRONLY + O_CREAT + O_TRUNC, 420)    # 0644
        Ok(opened) => opened
        Err(_) => return -1
    f.write_str("0123456789ABCDEFGHIJ")
    f.close()
    var p: Pipe = match pipe()
        Ok(pp) => pp
        Err(_) => return -2
    static_serve_file_full(p.write.raw(), tmp.as_view(), Some(range), None, 0)
    p.write.close()
    let n: i32 = drain(@p.read, out, cap)
    p.read.close()
    unlink(tmp.as_view())
    n

[[test]]
fn test_serve_open_ended_past_end_sends_416() -> i32
    var buf: [1024]u8
    let n: i32 = serve_range("bytes=100-", @buf[0], 1024)
    if n <= 0
        return 90
    if starts_with(@buf[0], n, "HTTP/1.1 416 ") != 1
        return 1
    0

[[test]]
fn test_serve_in_file_range_sends_206() -> i32
    var buf: [1024]u8
    let n: i32 = serve_range("bytes=15-", @buf[0], 1024)
    if n <= 0
        return 90
    if starts_with(@buf[0], n, "HTTP/1.1 206 ") != 1
        return 1
    if buf[n - 1] != 'J' or buf[n - 5] != 'F'
        return 2
    0
