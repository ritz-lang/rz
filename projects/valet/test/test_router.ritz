# tests/test_router.ritz - Unit tests for router
#
# Tests the routing framework with various patterns using ritzunit.
# Each test function is marked with @test and returns 0 on pass, non-zero on fail.

import ritzlib.io
import ritzlib.option
import ritzlib.strview
import ritzlib.sys

import lib.router

# ============================================================================
# Test handlers (just return 200)
# ============================================================================

fn handler_index(path: *u8, path_len: i32) -> i32
    return 200

fn handler_users(path: *u8, path_len: i32) -> i32
    return 200

fn handler_static(path: *u8, path_len: i32) -> i32
    return 200

fn handler_user_by_id(path: *u8, path_len: i32) -> i32
    return 200

fn handler_post(path: *u8, path_len: i32) -> i32
    return 200

fn handler_catchall(path: *u8, path_len: i32) -> i32
    return 200

# ============================================================================
# Helper: Create a router with standard routes
# ============================================================================

fn setup_router(r: *Router)
    router_init(r)
    router_add(r, Some("GET"), "/", handler_index)
    router_add(r, Some("GET"), "/users", handler_users)
    router_add(r, Some("GET"), "/static/*", handler_static)
    router_add(r, Some("GET"), "/users/:id", handler_user_by_id)
    router_add(r, Some("GET"), "/users/:id/posts/:post_id", handler_post)
    router_add(r, None, "/any-method", handler_index)
    router_add(r, Some("GET"), "/api/**", handler_catchall)

# ============================================================================
# Exact Match Tests
# ============================================================================

[[test]]
fn test_router_exact_root_match() -> i32
    var r: Router
    setup_router(@r)
    var result: RouteMatch
    let matched: i32 = router_match(@r, "GET", "/", @result)
    if matched != 1
        return 1  # FAIL: root path should match
    return 0

[[test]]
fn test_router_exact_users_match() -> i32
    var r: Router
    setup_router(@r)
    var result: RouteMatch
    let matched: i32 = router_match(@r, "GET", "/users", @result)
    if matched != 1
        return 1  # FAIL: /users should match
    return 0

[[test]]
fn test_router_no_match_unknown_path() -> i32
    var r: Router
    setup_router(@r)
    var result: RouteMatch
    let matched: i32 = router_match(@r, "GET", "/notfound", @result)
    if matched != 0
        return 1  # FAIL: unknown path should not match
    return 0

[[test]]
fn test_router_no_match_wrong_method() -> i32
    var r: Router
    setup_router(@r)
    var result: RouteMatch
    let matched: i32 = router_match(@r, "POST", "/users", @result)
    if matched != 0
        return 1  # FAIL: POST /users should not match (only GET registered)
    return 0

# ============================================================================
# Prefix/Wildcard Match Tests
# ============================================================================

[[test]]
fn test_router_prefix_single_level() -> i32
    var r: Router
    setup_router(@r)
    var result: RouteMatch
    let matched: i32 = router_match(@r, "GET", "/static/foo.js", @result)
    if matched != 1
        return 1  # FAIL: /static/foo.js should match /static/*
    return 0

[[test]]
fn test_router_prefix_nested_path() -> i32
    var r: Router
    setup_router(@r)
    var result: RouteMatch
    let matched: i32 = router_match(@r, "GET", "/static/css/style.css", @result)
    if matched != 1
        return 1  # FAIL: /static/css/style.css should match /static/*
    return 0

[[test]]
fn test_router_prefix_no_trailing() -> i32
    var r: Router
    setup_router(@r)
    var result: RouteMatch
    let matched: i32 = router_match(@r, "GET", "/static", @result)
    if matched != 0
        return 1  # FAIL: /static without trailing content should not match /static/*
    return 0

