# ============================================================================
# Parameter Extraction Tests
# ============================================================================

# Parameter `idx` of `result` is there and is exactly `want`
fn param_is(result: *RouteMatch, idx: i32, want: StrView) -> bool
    match route_match_param(result, idx)
        Some(p) => p.eq(want)
        None => false

[[test]]
fn test_router_param_extraction_single() -> i32
    var r: Router
    setup_router(@r)
    var result: RouteMatch
    router_match(@r, "GET", "/users/42", @result)

    if route_match_param(@result, 0).is_none()
        return 1  # FAIL: should have param
    if not param_is(@result, 0, "42")
        return 2  # FAIL: param should be "42"
    return 0

[[test]]
fn test_router_param_extraction_multi() -> i32
    var r: Router
    setup_router(@r)
    var result: RouteMatch
    router_match(@r, "GET", "/users/alice/posts/999", @result)

    if not param_is(@result, 0, "alice")
        return 1  # FAIL: first param should be "alice"
    if not param_is(@result, 1, "999")
        return 2  # FAIL: second param should be "999"
    return 0

