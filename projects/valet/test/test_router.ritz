    var r: Router
    setup_router(@r)
    var result: RouteMatch
    let matched: i32 = router_match(@r, "GET", "/users/abc", @result)
    if matched != 1
        return 1  # FAIL: /users/abc should match /users/:id
    return 0

[[test]]
fn test_router_multi_param() -> i32
    var r: Router
    setup_router(@r)
    var result: RouteMatch
    let matched: i32 = router_match(@r, "GET", "/users/42/posts/100", @result)
