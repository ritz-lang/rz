# test/test_response_iov.ritz - the vectored-I/O responses, byte for byte
#
# AGAST #3913: the HTTP status lines and headers these are built from moved
# out of ritzlib/span.ritz into lib/response.ritz.  These pin the exact bytes
# each builder hands writev, so the move (or any later edit to a constant)
# cannot change a response.

import ritzlib.iovec
import ritzlib.strview

import lib.response

# 0 when the builder's iovecs, concatenated, are exactly `want`.
fn iov_differ(b: *IoVecBuilder, want: StrView) -> i32
    var flat: [256]u8
    var len: i64 = 0
    let v: *Iovec = iovec_ptr(b)
    var i: i32 = 0
    while i < iovec_count(b)
        let part: *Iovec = v + i
        var j: u64 = 0
        while j < part.len
            if len >= 256
                return 2
            flat[len] = *(part.base + j as i64)
            len += 1
            j += 1
        i += 1
    if len != want.len
        return 1
    var k: i64 = 0
    while k < len
        if flat[k] != *(want.ptr + k)
            return 1
        k += 1
    0

[[test]]
fn test_response_hello_keepalive_iov() -> i32
    var b: IoVecBuilder
    iovec_builder_init(@b)
    response_hello_keepalive_iov(@b)
    iov_differ(@b, "HTTP/1.1 200 OK\r\nContent-Length: 13\r\nConnection: keep-alive\r\n\r\nHello, World!")

[[test]]
fn test_response_hello_iov() -> i32
    var b: IoVecBuilder
    iovec_builder_init(@b)
    response_hello_iov(@b)
    iov_differ(@b, "HTTP/1.1 200 OK\r\nContent-Length: 13\r\nConnection: close\r\n\r\nHello, World!")

[[test]]
fn test_response_not_found_iov() -> i32
    var b: IoVecBuilder
    iovec_builder_init(@b)
    response_not_found_iov(@b)
    iov_differ(@b, "HTTP/1.1 404 Not Found\r\nContent-Type: text/plain\r\nContent-Length: 14\r\nConnection: close\r\n\r\n404 Not Found\n")

[[test]]
fn test_response_ok_keepalive_iov() -> i32
    var b: IoVecBuilder
    iovec_builder_init(@b)
    response_ok_keepalive_iov(@b, c"hi there", 8)
    iov_differ(@b, "HTTP/1.1 200 OK\r\nContent-Type: text/plain\r\nContent-Length: 8\r\nConnection: keep-alive\r\n\r\nhi there")

[[test]]
fn test_response_json_keepalive_iov() -> i32
    var b: IoVecBuilder
    iovec_builder_init(@b)
    response_json_keepalive_iov(@b, c"{}", 2)
    iov_differ(@b, "HTTP/1.1 200 OK\r\nContent-Type: application/json\r\nContent-Length: 2\r\nConnection: keep-alive\r\n\r\n{}")

[[test]]
fn test_response_json_iov() -> i32
    var b: IoVecBuilder
    iovec_builder_init(@b)
    response_json_iov(@b, c"[1]", 3)
    iov_differ(@b, "HTTP/1.1 200 OK\r\nContent-Type: application/json\r\nContent-Length: 3\r\nConnection: close\r\n\r\n[1]")
