# test/test_keepalive.ritz - persistent-connection decision (AGAST #2106)
#
# test_workers.sh / test_multishot.sh hung under `ab` at every concurrency
# level: ab speaks HTTP/1.0 without "Connection: keep-alive", so it reads
# each response until the server closes.  valet treated every request as
# HTTP/1.1-persistent (request_parse hard-coded keep_alive = 1), answered
# "Connection: keep-alive" and never closed, so ab waited forever.
#
# RFC 9112 9.3: HTTP/1.1 persists unless "Connection: close"; HTTP/1.0
# persists only with "Connection: keep-alive".

import ritzlib.sys
import ritzlib.str
import ritzlib.strview
import ritzlib.async_tasks

import lib.request
import lib.response
import lib.valet

fn parse_ka(raw: StrView) -> i32
    var req: Request
    request_init(@req)
    if request_parse(@req, raw.ptr, raw.len as i32) < 0
        return -1
    req.keep_alive

# ----------------------------------------------------------------------------
# request_parse: keep_alive from version + Connection header
# ----------------------------------------------------------------------------

[[test]]
fn test_http11_defaults_to_keep_alive() -> i32
    if parse_ka("GET / HTTP/1.1\r\nHost: x\r\n\r\n") != 1
        return 1
    0

[[test]]
fn test_http11_connection_close() -> i32
    if parse_ka("GET / HTTP/1.1\r\nHost: x\r\nConnection: close\r\n\r\n") != 0
        return 1
    if parse_ka("GET / HTTP/1.1\r\nconnection:CLOSE\r\n\r\n") != 0
        return 2
    0

# ApacheBench's exact request line and headers.
[[test]]
fn test_http10_defaults_to_close() -> i32
    if parse_ka("GET / HTTP/1.0\r\nHost: localhost:9101\r\nUser-Agent: ApacheBench/2.3\r\nAccept: */*\r\n\r\n") != 0
        return 1
    0

[[test]]
fn test_http10_connection_keep_alive() -> i32
    if parse_ka("GET / HTTP/1.0\r\nConnection: Keep-Alive\r\n\r\n") != 1
        return 1
    0

# A token list: "close" anywhere in it wins.
[[test]]
fn test_connection_token_list() -> i32
    if parse_ka("GET / HTTP/1.1\r\nConnection: Upgrade, close\r\n\r\n") != 0
        return 1
    if parse_ka("GET / HTTP/1.0\r\nConnection: TE, keep-alive\r\n\r\n") != 1
        return 2
    0

# Other headers that merely start with "Connection"/"C" don't count.
[[test]]
fn test_unrelated_headers_ignored() -> i32
    if parse_ka("GET / HTTP/1.1\r\nConnection-Foo: close\r\nCookie: close\r\n\r\n") != 1
        return 1
    if parse_ka("GET / HTTP/1.0\r\nX-Connection: keep-alive\r\n\r\n") != 0
        return 2
    0

# ----------------------------------------------------------------------------
# valet_keep_alive: per-request decision used by both connection handlers
# ----------------------------------------------------------------------------

[[test]]
fn test_valet_keep_alive_decision() -> i32
    var req: Request
    request_init(@req)
    req.keep_alive = 1
    if valet_keep_alive(@req, 1, 100) != 1
        return 1
    # keepalive_requests cap reached
    if valet_keep_alive(@req, 100, 100) != 0
        return 2
    # client asked to close
    req.keep_alive = 0
    if valet_keep_alive(@req, 1, 100) != 0
        return 3
    0

# ----------------------------------------------------------------------------
# ctx_* helpers advertise the decision in the Connection header
# ----------------------------------------------------------------------------

fn contains(hay: *u8, len: i32, needle: StrView) -> i32
    var i: i32 = 0
    while i + needle.len as i32 <= len
        var j: i64 = 0
        while j < needle.len and *(hay + i + j) == *(needle.ptr + j)
            j += 1
        if j == needle.len
            return 1
        i += 1
    0

fn ctx_ok_with(keep_alive: i32, out: *u8, cap: i32) -> i32
    var req: Request
    request_init(@req)
    req.keep_alive = keep_alive
    var res: Response
    response_init(@res, out, cap)
    var hc: HandlerContext
    hc.req = @req
    hc.res = @res
    hc.route_result = null
    hc.path = null
    hc.path_len = 0
    hc.raw_buf = null
    hc.raw_len = 0
    hc.task = null
    set_g_ctx(@hc)
    ctx_ok(c"hi")
    set_g_ctx(null)
    res.len

[[test]]
fn test_ctx_header_close_when_not_persistent() -> i32
    var buf: [512]u8
    let n: i32 = ctx_ok_with(0, @buf[0], 512)
    if contains(@buf[0], n, "Connection: close\r\n") != 1
        return 1
    if contains(@buf[0], n, "keep-alive") != 0
        return 2
    0

[[test]]
fn test_ctx_header_keep_alive_when_persistent() -> i32
    var buf: [512]u8
    let n: i32 = ctx_ok_with(1, @buf[0], 512)
    if contains(@buf[0], n, "Connection: keep-alive\r\n") != 1
        return 1
    0
