# tests/test_tls.ritz - TLS server tests

import ritzlib.sys
import ritzlib.io

import cryptosec.mem
import cryptosec.random
import cryptosec.ed25519
import lib.tls

# ============================================================================
# TLS Server Configuration Tests
# ============================================================================

[[test]]
fn test_tls_server_config_init() -> i32
    var cfg: TlsServerConfig
    tls_server_config_init(@cfg)

    # Only AES-128-GCM: the record layer implements no other suite (#1862).
    if cfg.num_cipher_suites != 1
        return 1
    if cfg.cipher_suites[0] != TLS_AES_128_GCM_SHA256
        return 2
    return 0

# ============================================================================
# TLS Server Initialization Tests
# ============================================================================

[[test]]
fn test_tls_server_init() -> i32
    var cfg: TlsServerConfig
    tls_server_config_init(@cfg)

    var server: TlsServer
    tls_server_init(@server, @cfg)

    # Check initial state
    let state: i32 = tls_server_state(@server)
    let connected: i32 = tls_server_is_connected(@server)
    let err: i32 = tls_server_error(@server)
    tls_server_free(@server)

    assert state == TLS_SERVER_STATE_INIT
    assert connected == 0
    assert err == TLS_ERR_NONE
    return 0

[[test]]
fn test_tls_server_generates_keypair() -> i32
    var cfg: TlsServerConfig
    tls_server_config_init(@cfg)

    var server: TlsServer
    tls_server_init(@server, @cfg)

    # X25519 public key should be non-zero
    var is_zero: i32 = 1
    for i in 0..32
        if server.x25519_public[i] != 0
            is_zero = 0
            break
    tls_server_free(@server)

    assert is_zero == 0
    return 0

# ============================================================================
# ClientHello Parsing Tests
# ============================================================================

# Minimal ClientHello for testing (TLS 1.3 with X25519)
fn build_test_client_hello(out: *u8) -> i64
    var pos: i64 = 0

    # TLS record header
    out[pos] = 22  # Handshake
    out[pos + 1] = 0x03
    out[pos + 2] = 0x01  # TLS 1.0 (legacy)
    # Length placeholder at [3,4]
    pos = 5

    # Handshake header
    out[pos] = 1  # ClientHello
    # Length placeholder at [pos+1..pos+3]
    let hs_start: i64 = pos
    pos = pos + 4

    # Legacy version
    out[pos] = 0x03
    out[pos + 1] = 0x03  # TLS 1.2
    pos = pos + 2

    # Random (32 bytes)
    for i in 0..32
        out[pos + i] = (i + 1) as u8
    pos = pos + 32

    # Session ID (empty for simplicity in test)
    out[pos] = 0
    pos = pos + 1

    # Cipher suites
    out[pos] = 0x00
    out[pos + 1] = 0x04  # 4 bytes = 2 suites
    out[pos + 2] = 0x13
    out[pos + 3] = 0x01  # TLS_AES_128_GCM_SHA256
    out[pos + 4] = 0x13
    out[pos + 5] = 0x03  # TLS_CHACHA20_POLY1305_SHA256
    pos = pos + 6

    # Compression methods
    out[pos] = 0x01  # 1 method
    out[pos + 1] = 0x00  # null
    pos = pos + 2

    # Extensions
    let ext_start: i64 = pos + 2
    var ext_pos: i64 = ext_start

    # supported_versions extension
    out[ext_pos] = 0x00
    out[ext_pos + 1] = 0x2b  # Type = 43
    out[ext_pos + 2] = 0x00
    out[ext_pos + 3] = 0x03  # Length = 3
    out[ext_pos + 4] = 0x02  # Versions length = 2
    out[ext_pos + 5] = 0x03
    out[ext_pos + 6] = 0x04  # TLS 1.3
    ext_pos = ext_pos + 7

    # key_share extension
    out[ext_pos] = 0x00
    out[ext_pos + 1] = 0x33  # Type = 51
    out[ext_pos + 2] = 0x00
    out[ext_pos + 3] = 0x26  # Length = 38
    out[ext_pos + 4] = 0x00
    out[ext_pos + 5] = 0x24  # Entries length = 36
    out[ext_pos + 6] = 0x00
    out[ext_pos + 7] = 0x1d  # X25519
    out[ext_pos + 8] = 0x00
    out[ext_pos + 9] = 0x20  # Key length = 32
    # Fake X25519 public key (32 bytes)
    for i in 0..32
        out[ext_pos + 10 + i] = (0x41 + i) as u8  # 'A', 'B', 'C', ...
    ext_pos = ext_pos + 42

    # signature_algorithms extension
    out[ext_pos] = 0x00
    out[ext_pos + 1] = 0x0d  # Type = 13
    out[ext_pos + 2] = 0x00
    out[ext_pos + 3] = 0x04  # Length = 4
    out[ext_pos + 4] = 0x00
    out[ext_pos + 5] = 0x02  # Algorithms length = 2
    out[ext_pos + 6] = 0x08
    out[ext_pos + 7] = 0x07  # Ed25519
    ext_pos = ext_pos + 8

    # Extensions length
    let ext_len: i64 = ext_pos - ext_start
    out[pos] = ((ext_len >> 8) & 0xff) as u8
    out[pos + 1] = (ext_len & 0xff) as u8
    pos = ext_pos

    # Handshake length
    let hs_len: i64 = pos - hs_start - 4
    out[hs_start + 1] = ((hs_len >> 16) & 0xff) as u8
    out[hs_start + 2] = ((hs_len >> 8) & 0xff) as u8
    out[hs_start + 3] = (hs_len & 0xff) as u8

    # Record length
    let record_len: i64 = pos - 5
    out[3] = ((record_len >> 8) & 0xff) as u8
    out[4] = (record_len & 0xff) as u8

    return pos

[[test]]
fn test_tls_server_needs_input_initially() -> i32
    var cfg: TlsServerConfig
    tls_server_config_init(@cfg)

    var server: TlsServer
    tls_server_init(@server, @cfg)

    # Process with no data
    var out: [4096]u8
    var out_len: i64 = 0
    let result: i32 = tls_server_process(@server, null, 0, @out[0], 4096, @out_len)
    tls_server_free(@server)

    assert result == TLS_RESULT_NEED_INPUT
    assert out_len == 0
    return 0

[[test]]
fn test_tls_server_partial_record() -> i32
    var cfg: TlsServerConfig
    tls_server_config_init(@cfg)

    var server: TlsServer
    tls_server_init(@server, @cfg)

    # Build partial ClientHello (just the first few bytes)
    var partial: [10]u8
    partial[0] = 22  # Handshake
    partial[1] = 0x03
    partial[2] = 0x01
    partial[3] = 0x00
    partial[4] = 0x50  # Claims 80 bytes

    var out: [4096]u8
    var out_len: i64 = 0
    let result: i32 = tls_server_process(@server, @partial[0], 5, @out[0], 4096, @out_len)
    tls_server_free(@server)

    # Should need more input
    assert result == TLS_RESULT_NEED_INPUT
    return 0

# ============================================================================
# Error Handling Tests
# ============================================================================

[[test]]
fn test_tls_server_rejects_non_handshake() -> i32
    var cfg: TlsServerConfig
    tls_server_config_init(@cfg)

    var server: TlsServer
    tls_server_init(@server, @cfg)

    # Send Application Data record type instead of Handshake
    var bad_record: [10]u8
    bad_record[0] = 23  # Application Data (wrong!)
    bad_record[1] = 0x03
    bad_record[2] = 0x01
    bad_record[3] = 0x00
    bad_record[4] = 0x01
    bad_record[5] = 0x00

    var out: [4096]u8
    var out_len: i64 = 0
    let result: i32 = tls_server_process(@server, @bad_record[0], 6, @out[0], 4096, @out_len)
    let err: i32 = tls_server_error(@server)
    tls_server_free(@server)

    assert result == TLS_RESULT_ERROR
    assert err == TLS_ERR_UNEXPECTED_MESSAGE
    return 0

# ============================================================================
# State Machine Tests
# ============================================================================

[[test]]
fn test_tls_server_state_transitions() -> i32
    var cfg: TlsServerConfig
    tls_server_config_init(@cfg)

    # We need a certificate for full handshake
    # For this test, just verify initial state
    var server: TlsServer
    tls_server_init(@server, @cfg)

    let state: i32 = tls_server_state(@server)
    let connected: i32 = tls_server_is_connected(@server)
    tls_server_free(@server)

    assert state == TLS_SERVER_STATE_INIT
    assert connected == 0
    return 0

# ============================================================================
# Wire-length bounds (#1861)
#
# The handshake header's 24-bit length is attacker-controlled. The server
# must reject a ClientHello whose claimed length overruns its record, rather
# than parsing and hashing bytes past it (up to 16 MiB past a 4 KiB buffer).
# ============================================================================

# Overwrite the ClientHello handshake length (bytes 6..8 of the record).
fn set_hs_length(rec: *u8, length: i64)
    rec[6] = ((length >> 16) & 0xff) as u8
    rec[7] = ((length >> 8) & 0xff) as u8
    rec[8] = (length & 0xff) as u8

# Checks are `assert` (#2127): a failing one exits the test with both
# operands printed, so it cannot be silently dropped (#1903).

# Feed `rec` to a fresh server; return the process result and the error code.
fn run_client_hello(rec: *u8, rec_len: i64, err: *i32) -> i32
    var cfg: TlsServerConfig
    tls_server_config_init(@cfg)
    var server: TlsServer
    tls_server_init(@server, @cfg)
    var out: [4096]u8
    var out_len: i64 = 0
    let result: i32 = tls_server_process(@server, rec, rec_len, @out[0], 4096, @out_len)
    *err = tls_server_error(@server)
    tls_server_free(@server)
    return result

[[test]]
fn test_tls_server_rejects_handshake_length_past_record() -> i32
    var rec: [512]u8
    let rec_len: i64 = build_test_client_hello(@rec[0])
    # Claim one byte more than the record carries after the 4-byte header.
    set_hs_length(@rec[0], rec_len - 9 + 1)
    var err: i32 = 0
    if run_client_hello(@rec[0], rec_len, @err) != TLS_RESULT_ERROR
        return 1
    if err != TLS_ERR_PARSE_ERROR
        return 2
    return 0

[[test]]
fn test_tls_server_rejects_max_handshake_length() -> i32
    var rec: [512]u8
    let rec_len: i64 = build_test_client_hello(@rec[0])
    set_hs_length(@rec[0], 0xffffff)
    var err: i32 = 0
    if run_client_hello(@rec[0], rec_len, @err) != TLS_RESULT_ERROR
        return 1
    if err != TLS_ERR_PARSE_ERROR
        return 2
    return 0

[[test]]
fn test_tls_server_accepts_exact_handshake_length() -> i32
    # Control: length == record body - 4 parses, so the bound is not off by
    # one. With no certificate configured the server then stops at building
    # its flight, i.e. strictly after the ClientHello was accepted.
    var rec: [512]u8
    let rec_len: i64 = build_test_client_hello(@rec[0])
    set_hs_length(@rec[0], rec_len - 9)
    var err: i32 = 0
    if run_client_hello(@rec[0], rec_len, @err) != TLS_RESULT_ERROR
        return 1
    if err != TLS_ERR_NO_CERTIFICATE
        return 2
    return 0

# ============================================================================
# Secrets and randomness (AGAST #1863)
# ============================================================================

fn fill_aa(p: *u8, n: i64)
    for i in 0..n
        *(p + i) = 0xAA

[[test]]
fn test_tls_server_init_fails_on_rng_failure() -> i32
    # No ephemeral key share may be derived from an unset private key.
    var cfg: TlsServerConfig
    tls_server_config_init(@cfg)
    var server: TlsServer
    fill_aa(@server.x25519_private[0], 32)
    random_test_force_failure(1)
    let result: i32 = tls_server_init(@server, @cfg)
    random_test_force_failure(0)
    if result != -1
        return 1
    if mem_is_zero(@server.x25519_private[0], 32) != 1
        return 2
    if tls_server_init(@server, @cfg) != 0
        return 3
    tls_server_free(@server)
    return 0

[[test]]
fn test_serialize_server_hello_fails_on_rng_failure() -> i32
    var cfg: TlsServerConfig
    tls_server_config_init(@cfg)
    var server: TlsServer
    if tls_server_init(@server, @cfg) != 0
        return 1
    var out: [256]u8
    random_test_force_failure(1)
    let n: i64 = serialize_server_hello(@server, @out[0], 256)
    random_test_force_failure(0)
    tls_server_free(@server)
    if n != -1
        return 2
    return 0

[[test]]
fn test_tls_server_free_zeroes_whole_key_schedule() -> i32
    # Was a hand-counted 296 bytes of the key schedule. sizeof(T) falls back
    # to 8 for a name it cannot resolve, so pin it above the old count.
    if sizeof(TLS13KeySchedule) <= 296
        return 9
    var cfg: TlsServerConfig
    tls_server_config_init(@cfg)
    var server: TlsServer
    if tls_server_init(@server, @cfg) != 0
        return 1
    fill_aa(@server.key_schedule as *u8, sizeof(TLS13KeySchedule))
    fill_aa(@server.shared_secret[0], 32)
    fill_aa(@server.x25519_private[0], 32)
    tls_server_free(@server)
    if mem_is_zero(@server.key_schedule as *u8, sizeof(TLS13KeySchedule)) != 1
        return 2
    if mem_is_zero(@server.shared_secret[0], 32) != 1
        return 3
    if mem_is_zero(@server.x25519_private[0], 32) != 1
        return 4
    return 0

[[test]]
fn test_parse_client_hello_zeroes_whole_struct() -> i32
    # Was a hand-counted 400 bytes of the parsed ClientHello.
    if sizeof(ParsedClientHello) <= 400
        return 9
    var ch: ParsedClientHello
    fill_aa(@ch as *u8, sizeof(ParsedClientHello))
    var data: [4]u8
    if parse_client_hello(@data[0], 0, @ch) != -1
        return 1
    if mem_is_zero(@ch as *u8, sizeof(ParsedClientHello)) != 1
        return 2
    return 0

[[test]]
fn test_tls_server_config_init_zeroes_whole_struct() -> i32
    # Was a hand-counted 200 bytes; key material lives in the config.
    if sizeof(TlsServerConfig) <= 200
        return 9
    var cfg: TlsServerConfig
    fill_aa(@cfg as *u8, sizeof(TlsServerConfig))
    tls_server_config_init(@cfg)
    # Everything but the cipher-suite fields the init sets must be zero.
    cfg.cipher_suites[0] = 0
    cfg.num_cipher_suites = 0
    if mem_is_zero(@cfg as *u8, sizeof(TlsServerConfig)) != 1
        return 1
    return 0

# ============================================================================
# Ed25519 PKCS#8 private keys (AGAST #2111)
# ============================================================================
# The loader handed the PKCS#8 header (30 2e 02 01 00 30 05 ...) to
# ed25519_keygen as the seed, so the server signed with a key unrelated to
# its certificate. Fixture: `openssl genpkey -algorithm ed25519`, test-only.

# Copy the fixture's 32-byte seed / public key to `out`.
fn ed_seed(out: *u8)
    var b: [32]u8 = [0x4a, 0x2f, 0xb2, 0x35, 0x0f, 0x23, 0xfb, 0xe5, 0xe3, 0x05, 0x54, 0x9a, 0xf2, 0xd2, 0x89, 0xae, 0x49, 0xdd, 0x20, 0x23, 0x0b, 0x3d, 0xc1, 0xe4, 0x40, 0x5f, 0x6f, 0xf8, 0x75, 0x3d, 0x11, 0xd5]
    mem_copy(out, @b[0], 32)

fn ed_pub(out: *u8)
    var b: [32]u8 = [0xf4, 0x37, 0x69, 0x98, 0x3e, 0x02, 0xc8, 0x65, 0xc1, 0xba, 0xf8, 0x28, 0x8e, 0xf4, 0x9b, 0x0f, 0xed, 0x44, 0x6a, 0x04, 0x3b, 0xfc, 0xb1, 0xbc, 0xd2, 0x03, 0x17, 0x54, 0x41, 0x0e, 0x60, 0xc4]
    mem_copy(out, @b[0], 32)

fn ed_key_pem() -> *u8
    return c"-----BEGIN PRIVATE KEY-----\nMC4CAQAwBQYDK2VwBCIEIEovsjUPI/vl4wVUmvLSia5J3SAjCz3B5EBfb/h1PRHV\n-----END PRIVATE KEY-----\n"

# An X25519 key: the same PKCS#8 shape, OID 1.3.101.110.
fn x25519_key_pem() -> *u8
    return c"-----BEGIN PRIVATE KEY-----\nMC4CAQAwBQYDK2VuBCIEIAifS7+ylYEtuQY+Wp/2pAt8FJmAdEAJt8e3kHvvtidW\n-----END PRIVATE KEY-----\n"

fn pem_len_2111(s: *u8) -> i64
    var n: i64 = 0
    while s[n] != 0
        n = n + 1
    return n

# The 48-byte RFC 8410 encoding of ed_seed(), with 3 spare bytes.
fn ed_der(out: *u8)
    var hdr: [16]u8 = [0x30, 0x2e, 0x02, 0x01, 0x00, 0x30, 0x05, 0x06, 0x03, 0x2b, 0x65, 0x70, 0x04, 0x22, 0x04, 0x20]
    mem_copy(out, @hdr[0], 16)
    ed_seed(out + 16)
    for i in 48..51
        *(out + i) = 0

# ed25519_seed_from_pkcs8 on `der` with byte `at` replaced by `v`.
fn seed_verdict(at: i64, v: u8, len: i64) -> i32
    var der: [51]u8
    ed_der(@der[0])
    if at >= 0
        der[at] = v
    var seed: [32]u8
    return ed25519_seed_from_pkcs8(@der[0], len, @seed[0])

[[test]]
fn test_ed25519_pkcs8_seed_is_the_inner_octet_string() -> i32
    var der: [51]u8
    ed_der(@der[0])
    var seed: [32]u8
    if ed25519_seed_from_pkcs8(@der[0], 48, @seed[0]) != 0
        return 1
    var want: [32]u8
    ed_seed(@want[0])
    if mem_eq(@seed[0], @want[0], 32) != 1
        return 2
    return 0

[[test]]
fn test_ed25519_pkcs8_rejects_other_algorithms() -> i32
    if seed_verdict(11, 0x6e, 48) != -1   # X25519, 1.3.101.110
        return 1
    if seed_verdict(9, 0x2a, 48) != -1    # OID arc 1.2 instead of 1.3
        return 2
    if seed_verdict(4, 0x02, 48) != -1    # version 2
        return 3
    return 0

[[test]]
fn test_ed25519_pkcs8_rejects_bad_lengths() -> i32
    if seed_verdict(-1, 0, 47) != -1      # truncated
        return 1
    if seed_verdict(-1, 0, 49) != -1      # trailing byte outside the SEQUENCE
        return 2
    if seed_verdict(15, 0x1f, 48) != -1   # 31-byte seed
        return 3
    if seed_verdict(13, 0x21, 48) != -1   # outer OCTET STRING too short
        return 4
    if seed_verdict(6, 0x07, 48) != -1    # AlgorithmIdentifier with parameters
        return 5
    if seed_verdict(1, 0x2f, 48) != -1    # SEQUENCE claims a byte it lacks
        return 6
    return 0

[[test]]
fn test_ed25519_pkcs8_accepts_trailing_public_key() -> i32
    # OneAsymmetricKey v2 (RFC 5958) may carry attributes / a public key
    # after the private key; they are inside the outer SEQUENCE.
    var der: [51]u8
    ed_der(@der[0])
    der[1] = 0x31
    der[4] = 0x01
    der[48] = 0x81
    der[49] = 0x01
    var seed: [32]u8
    if ed25519_seed_from_pkcs8(@der[0], 51, @seed[0]) != 0
        return 1
    var want: [32]u8
    ed_seed(@want[0])
    if mem_eq(@seed[0], @want[0], 32) != 1
        return 2
    return 0

[[test]]
fn test_load_ed25519_key_expands_the_real_seed() -> i32
    var cfg: TlsServerConfig
    tls_server_config_init(@cfg)
    let pem: *u8 = ed_key_pem()
    if tls_server_config_load_ed25519_key(@cfg, pem, pem_len_2111(pem)) != 0
        return 1
    if cfg.key_type != TLS_KEY_TYPE_ED25519
        return 2
    var want: [32]u8
    ed_seed(@want[0])
    if mem_eq(@cfg.ed25519_private[0], @want[0], 32) != 1
        return 3
    # The key the server signs with must match the certificate's public key.
    var derived_pub: [32]u8
    var scratch: [64]u8
    ed25519_keygen(@derived_pub[0], @scratch[0], @cfg.ed25519_private[0])
    ed_pub(@want[0])
    if mem_eq(@derived_pub[0], @want[0], 32) != 1
        return 4
    return 0

[[test]]
fn test_load_ed25519_key_rejects_x25519_key() -> i32
    var cfg: TlsServerConfig
    tls_server_config_init(@cfg)
    let pem: *u8 = x25519_key_pem()
    if tls_server_config_load_ed25519_key(@cfg, pem, pem_len_2111(pem)) != -1
        return 1
    return 0

# ============================================================================
# Small-order X25519 client share (RFC 7748 §6.1, AGAST #2580, GitHub #143)
#
# A small-order key share forces the all-zero shared secret. The server must
# abort with illegal_parameter before building its flight; the control
# (test_tls_server_accepts_exact_handshake_length) gets as far as the flight.
# ============================================================================

# Offset of the X25519 key in build_test_client_hello's record.
const CH_X25519_KEY_AT: i64 = 71

[[test_helper]]
fn run_x25519_share_2580(key: *u8) -> i32
    var rec: [512]u8
    let rec_len: i64 = build_test_client_hello(@rec[0])
    # Guard the offset: the builder's key starts 0x41, 0x42, ...
    assert rec[CH_X25519_KEY_AT] == 0x41
    assert rec[CH_X25519_KEY_AT + 31] == 0x60
    for i in 0..32
        rec[CH_X25519_KEY_AT + i] = key[i]
    var err: i32 = 0
    if run_client_hello(@rec[0], rec_len, @err) != TLS_RESULT_ERROR
        return 1
    if err != TLS_ERR_ILLEGAL_PARAMETER
        return 100 - err
    return 0

[[test]]
fn test_tls_server_refuses_zero_x25519_share() -> i32
    var key: [32]u8
    for i in 0..32
        key[i] = 0
    return run_x25519_share_2580(@key[0])

[[test]]
fn test_tls_server_refuses_x25519_share_one() -> i32
    var key: [32]u8
    for i in 0..32
        key[i] = 0
    key[0] = 1
    return run_x25519_share_2580(@key[0])
