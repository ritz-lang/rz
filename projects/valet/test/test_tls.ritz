# tests/test_tls.ritz - TLS server tests

import ritzlib.sys
import ritzlib.io
import ritzunit.assertions
import ritzunit.types

import cryptosec.mem
import cryptosec.random
import lib.tls

# ============================================================================
# TLS Server Configuration Tests
# ============================================================================

[[test]]
fn test_tls_server_config_init() -> i32
    var cfg: TlsServerConfig
    tls_server_config_init(@cfg)

    # Only AES-128-GCM: the record layer implements no other suite (#1862).
    if cfg.num_cipher_suites != 1
        return 1
    if cfg.cipher_suites[0] != TLS_AES_128_GCM_SHA256
        return 2
    return 0

# ============================================================================
# TLS Server Initialization Tests
# ============================================================================

[[test]]
fn test_tls_server_init()
    var cfg: TlsServerConfig
    tls_server_config_init(@cfg)

    var server: TlsServer
    tls_server_init(@server, @cfg)

    # Check initial state
    assert_eq_i32(tls_server_state(@server), TLS_SERVER_STATE_INIT)
    assert_eq_i32(tls_server_is_connected(@server), 0)
    assert_eq_i32(tls_server_error(@server), TLS_ERR_NONE)

    tls_server_free(@server)

[[test]]
fn test_tls_server_generates_keypair()
    var cfg: TlsServerConfig
    tls_server_config_init(@cfg)

    var server: TlsServer
    tls_server_init(@server, @cfg)

    # X25519 public key should be non-zero
    var is_zero: i32 = 1
    for i in 0..32
        if server.x25519_public[i] != 0
            is_zero = 0
            break

    assert_eq_i32(is_zero, 0)

    tls_server_free(@server)

# ============================================================================
# ClientHello Parsing Tests
# ============================================================================

# Minimal ClientHello for testing (TLS 1.3 with X25519)
fn build_test_client_hello(out: *u8) -> i64
    var pos: i64 = 0

    # TLS record header
    out[pos] = 22  # Handshake
    out[pos + 1] = 0x03
    out[pos + 2] = 0x01  # TLS 1.0 (legacy)
    # Length placeholder at [3,4]
    pos = 5

    # Handshake header
    out[pos] = 1  # ClientHello
    # Length placeholder at [pos+1..pos+3]
    let hs_start: i64 = pos
    pos = pos + 4

    # Legacy version
    out[pos] = 0x03
    out[pos + 1] = 0x03  # TLS 1.2
    pos = pos + 2

    # Random (32 bytes)
    for i in 0..32
        out[pos + i] = (i + 1) as u8
    pos = pos + 32

    # Session ID (empty for simplicity in test)
    out[pos] = 0
    pos = pos + 1

    # Cipher suites
    out[pos] = 0x00
    out[pos + 1] = 0x04  # 4 bytes = 2 suites
    out[pos + 2] = 0x13
    out[pos + 3] = 0x01  # TLS_AES_128_GCM_SHA256
    out[pos + 4] = 0x13
    out[pos + 5] = 0x03  # TLS_CHACHA20_POLY1305_SHA256
    pos = pos + 6

    # Compression methods
    out[pos] = 0x01  # 1 method
    out[pos + 1] = 0x00  # null
    pos = pos + 2

    # Extensions
    let ext_start: i64 = pos + 2
    var ext_pos: i64 = ext_start

    # supported_versions extension
    out[ext_pos] = 0x00
    out[ext_pos + 1] = 0x2b  # Type = 43
    out[ext_pos + 2] = 0x00
    out[ext_pos + 3] = 0x03  # Length = 3
    out[ext_pos + 4] = 0x02  # Versions length = 2
    out[ext_pos + 5] = 0x03
    out[ext_pos + 6] = 0x04  # TLS 1.3
    ext_pos = ext_pos + 7

    # key_share extension
    out[ext_pos] = 0x00
    out[ext_pos + 1] = 0x33  # Type = 51
    out[ext_pos + 2] = 0x00
    out[ext_pos + 3] = 0x26  # Length = 38
    out[ext_pos + 4] = 0x00
    out[ext_pos + 5] = 0x24  # Entries length = 36
    out[ext_pos + 6] = 0x00
    out[ext_pos + 7] = 0x1d  # X25519
    out[ext_pos + 8] = 0x00
    out[ext_pos + 9] = 0x20  # Key length = 32
    # Fake X25519 public key (32 bytes)
    for i in 0..32
        out[ext_pos + 10 + i] = (0x41 + i) as u8  # 'A', 'B', 'C', ...
    ext_pos = ext_pos + 42

    # signature_algorithms extension
    out[ext_pos] = 0x00
    out[ext_pos + 1] = 0x0d  # Type = 13
    out[ext_pos + 2] = 0x00
    out[ext_pos + 3] = 0x04  # Length = 4
    out[ext_pos + 4] = 0x00
    out[ext_pos + 5] = 0x02  # Algorithms length = 2
    out[ext_pos + 6] = 0x08
    out[ext_pos + 7] = 0x07  # Ed25519
    ext_pos = ext_pos + 8

    # Extensions length
    let ext_len: i64 = ext_pos - ext_start
    out[pos] = ((ext_len >> 8) & 0xff) as u8
    out[pos + 1] = (ext_len & 0xff) as u8
    pos = ext_pos

    # Handshake length
    let hs_len: i64 = pos - hs_start - 4
    out[hs_start + 1] = ((hs_len >> 16) & 0xff) as u8
    out[hs_start + 2] = ((hs_len >> 8) & 0xff) as u8
    out[hs_start + 3] = (hs_len & 0xff) as u8

    # Record length
    let record_len: i64 = pos - 5
    out[3] = ((record_len >> 8) & 0xff) as u8
    out[4] = (record_len & 0xff) as u8

    return pos

[[test]]
fn test_tls_server_needs_input_initially()
    var cfg: TlsServerConfig
    tls_server_config_init(@cfg)

    var server: TlsServer
    tls_server_init(@server, @cfg)

    # Process with no data
    var out: [4096]u8
    var out_len: i64 = 0
    let result: i32 = tls_server_process(@server, null, 0, @out[0], 4096, @out_len)

    assert_eq_i32(result, TLS_RESULT_NEED_INPUT)
    assert_eq_i64(out_len, 0)

    tls_server_free(@server)

[[test]]
fn test_tls_server_partial_record()
    var cfg: TlsServerConfig
    tls_server_config_init(@cfg)

    var server: TlsServer
    tls_server_init(@server, @cfg)

    # Build partial ClientHello (just the first few bytes)
    var partial: [10]u8
    partial[0] = 22  # Handshake
    partial[1] = 0x03
    partial[2] = 0x01
    partial[3] = 0x00
    partial[4] = 0x50  # Claims 80 bytes

    var out: [4096]u8
    var out_len: i64 = 0
    let result: i32 = tls_server_process(@server, @partial[0], 5, @out[0], 4096, @out_len)

    # Should need more input
    assert_eq_i32(result, TLS_RESULT_NEED_INPUT)

    tls_server_free(@server)

# ============================================================================
# Error Handling Tests
# ============================================================================

[[test]]
fn test_tls_server_rejects_non_handshake()
    var cfg: TlsServerConfig
    tls_server_config_init(@cfg)

    var server: TlsServer
    tls_server_init(@server, @cfg)

    # Send Application Data record type instead of Handshake
    var bad_record: [10]u8
    bad_record[0] = 23  # Application Data (wrong!)
    bad_record[1] = 0x03
    bad_record[2] = 0x01
    bad_record[3] = 0x00
    bad_record[4] = 0x01
    bad_record[5] = 0x00

    var out: [4096]u8
    var out_len: i64 = 0
    let result: i32 = tls_server_process(@server, @bad_record[0], 6, @out[0], 4096, @out_len)

    assert_eq_i32(result, TLS_RESULT_ERROR)
    assert_eq_i32(tls_server_error(@server), TLS_ERR_UNEXPECTED_MESSAGE)

    tls_server_free(@server)

# ============================================================================
# State Machine Tests
# ============================================================================

[[test]]
fn test_tls_server_state_transitions()
    var cfg: TlsServerConfig
    tls_server_config_init(@cfg)

    # We need a certificate for full handshake
    # For this test, just verify initial state
    var server: TlsServer
    tls_server_init(@server, @cfg)

    assert_eq_i32(tls_server_state(@server), TLS_SERVER_STATE_INIT)
    assert_eq_i32(tls_server_is_connected(@server), 0)

    tls_server_free(@server)

# ============================================================================
# Wire-length bounds (#1861)
#
# The handshake header's 24-bit length is attacker-controlled. The server
# must reject a ClientHello whose claimed length overruns its record, rather
# than parsing and hashing bytes past it (up to 16 MiB past a 4 KiB buffer).
# ============================================================================

# Overwrite the ClientHello handshake length (bytes 6..8 of the record).
fn set_hs_length(rec: *u8, length: i64)
    rec[6] = ((length >> 16) & 0xff) as u8
    rec[7] = ((length >> 8) & 0xff) as u8
    rec[8] = (length & 0xff) as u8

# These tests return their verdict: ritzunit's assert_* only print and return
# 1, so a discarded assert in a void test can never fail it.

# Feed `rec` to a fresh server; return the process result and the error code.
fn run_client_hello(rec: *u8, rec_len: i64, err: *i32) -> i32
    var cfg: TlsServerConfig
    tls_server_config_init(@cfg)
    var server: TlsServer
    tls_server_init(@server, @cfg)
    var out: [4096]u8
    var out_len: i64 = 0
    let result: i32 = tls_server_process(@server, rec, rec_len, @out[0], 4096, @out_len)
    *err = tls_server_error(@server)
    tls_server_free(@server)
    return result

[[test]]
fn test_tls_server_rejects_handshake_length_past_record() -> i32
    var rec: [512]u8
    let rec_len: i64 = build_test_client_hello(@rec[0])
    # Claim one byte more than the record carries after the 4-byte header.
    set_hs_length(@rec[0], rec_len - 9 + 1)
    var err: i32 = 0
    if run_client_hello(@rec[0], rec_len, @err) != TLS_RESULT_ERROR
        return 1
    if err != TLS_ERR_PARSE_ERROR
        return 2
    return 0

[[test]]
fn test_tls_server_rejects_max_handshake_length() -> i32
    var rec: [512]u8
    let rec_len: i64 = build_test_client_hello(@rec[0])
    set_hs_length(@rec[0], 0xffffff)
    var err: i32 = 0
    if run_client_hello(@rec[0], rec_len, @err) != TLS_RESULT_ERROR
        return 1
    if err != TLS_ERR_PARSE_ERROR
        return 2
    return 0

[[test]]
fn test_tls_server_accepts_exact_handshake_length() -> i32
    # Control: length == record body - 4 parses, so the bound is not off by
    # one. With no certificate configured the server then stops at building
    # its flight, i.e. strictly after the ClientHello was accepted.
    var rec: [512]u8
    let rec_len: i64 = build_test_client_hello(@rec[0])
    set_hs_length(@rec[0], rec_len - 9)
    var err: i32 = 0
    if run_client_hello(@rec[0], rec_len, @err) != TLS_RESULT_ERROR
        return 1
    if err != TLS_ERR_NO_CERTIFICATE
        return 2
    return 0

# ============================================================================
# Secrets and randomness (AGAST #1863)
# ============================================================================

fn fill_aa(p: *u8, n: i64)
    for i in 0..n
        *(p + i) = 0xAA

[[test]]
fn test_tls_server_init_fails_on_rng_failure() -> i32
    # No ephemeral key share may be derived from an unset private key.
    var cfg: TlsServerConfig
    tls_server_config_init(@cfg)
    var server: TlsServer
    fill_aa(@server.x25519_private[0], 32)
    random_test_force_failure(1)
    let result: i32 = tls_server_init(@server, @cfg)
    random_test_force_failure(0)
    if result != -1
        return 1
    if mem_is_zero(@server.x25519_private[0], 32) != 1
        return 2
    if tls_server_init(@server, @cfg) != 0
        return 3
    tls_server_free(@server)
    return 0

[[test]]
fn test_serialize_server_hello_fails_on_rng_failure() -> i32
    var cfg: TlsServerConfig
    tls_server_config_init(@cfg)
    var server: TlsServer
    if tls_server_init(@server, @cfg) != 0
        return 1
    var out: [256]u8
    random_test_force_failure(1)
    let n: i64 = serialize_server_hello(@server, @out[0], 256)
    random_test_force_failure(0)
    tls_server_free(@server)
    if n != -1
        return 2
    return 0

[[test]]
fn test_tls_server_free_zeroes_whole_key_schedule() -> i32
    # Was a hand-counted 296 bytes of the key schedule. sizeof(T) falls back
    # to 8 for a name it cannot resolve, so pin it above the old count.
    if sizeof(TLS13KeySchedule) <= 296
        return 9
    var cfg: TlsServerConfig
    tls_server_config_init(@cfg)
    var server: TlsServer
    if tls_server_init(@server, @cfg) != 0
        return 1
    fill_aa(@server.key_schedule as *u8, sizeof(TLS13KeySchedule))
    fill_aa(@server.shared_secret[0], 32)
    fill_aa(@server.x25519_private[0], 32)
    tls_server_free(@server)
    if mem_is_zero(@server.key_schedule as *u8, sizeof(TLS13KeySchedule)) != 1
        return 2
    if mem_is_zero(@server.shared_secret[0], 32) != 1
        return 3
    if mem_is_zero(@server.x25519_private[0], 32) != 1
        return 4
    return 0

[[test]]
fn test_parse_client_hello_zeroes_whole_struct() -> i32
    # Was a hand-counted 400 bytes of the parsed ClientHello.
    if sizeof(ParsedClientHello) <= 400
        return 9
    var ch: ParsedClientHello
    fill_aa(@ch as *u8, sizeof(ParsedClientHello))
    var data: [4]u8
    if parse_client_hello(@data[0], 0, @ch) != -1
        return 1
    if mem_is_zero(@ch as *u8, sizeof(ParsedClientHello)) != 1
        return 2
    return 0

[[test]]
fn test_tls_server_config_init_zeroes_whole_struct() -> i32
    # Was a hand-counted 200 bytes; key material lives in the config.
    if sizeof(TlsServerConfig) <= 200
        return 9
    var cfg: TlsServerConfig
    fill_aa(@cfg as *u8, sizeof(TlsServerConfig))
    tls_server_config_init(@cfg)
    # Everything but the cipher-suite fields the init sets must be zero.
    cfg.cipher_suites[0] = 0
    cfg.num_cipher_suites = 0
    if mem_is_zero(@cfg as *u8, sizeof(TlsServerConfig)) != 1
        return 1
    return 0
