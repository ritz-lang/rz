# test/test_proxy.ritz - zeus-proxy sizing helpers (AGAST #2104)
#
# A proxied response is copied out of the worker's per-slot arena.  The
# response slot's offsets come from another process, so valet must check
# them against the slot's bounds before touching the bytes, and must size
# its send buffer from them instead of assuming 8 KB.
#
# A request whose body did not arrive in the first recv must be read until
# it is whole; request_frame says how many bytes that is (AGAST #1865: with
# http's lib/h1_framing.ritz, an i64 Content-Length and chunked bodies).

import ritzlib.sys
import ritzlib.io
import ritzlib.str
import ritzlib.uring

import lib.request
import http.h1_framing
import lib.proxy


# ----------------------------------------------------------------------------
# proxy_response_bytes(slot_start, slot_end, h_off, h_len, b_off, b_len)
# ----------------------------------------------------------------------------

[[test]]
fn test_proxy_bytes_small_response() -> i32
    if proxy_response_bytes(4096, 8192, 4096, 100, 4200, 50) != 150
        return 1
    return 0

[[test]]
fn test_proxy_bytes_response_bigger_than_write_buf() -> i32
    # A max-size nexus page: 49 KB body in a 128 KiB slot.
    let total: i64 = proxy_response_bytes(0, 131072, 0, 200, 256, 49900)
    if total != 50100
        return 1
    return 0

[[test]]
fn test_proxy_bytes_empty_body_and_headers() -> i32
    # Bare 500 from nexus: no headers, no body; offsets are 0 and ignored.
    if proxy_response_bytes(65536, 131072, 0, 0, 0, 0) != 0
        return 1
    return 0

[[test]]
fn test_proxy_bytes_body_past_slot_end() -> i32
    if proxy_response_bytes(0, 4096, 0, 100, 128, 4000) != -1
        return 1
    return 0

[[test]]
fn test_proxy_bytes_body_before_slot_start() -> i32
    if proxy_response_bytes(8192, 16384, 8192, 10, 4096, 10) != -1
        return 1
    return 0

[[test]]
fn test_proxy_bytes_headers_past_slot_end() -> i32
    if proxy_response_bytes(0, 4096, 4000, 200, 0, 0) != -1
        return 1
    return 0

[[test]]
fn test_proxy_bytes_negative_length() -> i32
    if proxy_response_bytes(0, 4096, 0, -1, 0, 0) != -1
        return 1
    return 0


# ----------------------------------------------------------------------------
# request_frame(buf, len, max_body, *H1Frame)
# ----------------------------------------------------------------------------

fn frame_cstr(r: *u8) -> i64
    var f: H1Frame
    return request_frame(r, strlen(r) as i32, 0, @f)

[[test]]
fn test_frame_get_without_body() -> i32
    let r = c"GET / HTTP/1.1\r\nHost: x\r\n\r\n"
    if frame_cstr(r) != strlen(r)
        return 1
    return 0

[[test]]
fn test_frame_post_body_not_yet_received() -> i32
    # Headers are 46 bytes; Content-Length says 20000 more follow.
    let r = c"POST /wiki HTTP/1.1\r\nContent-Length: 20000\r\n\r\nslug="
    var f: H1Frame
    if request_frame(r, strlen(r) as i32, 0, @f) != H1F_INCOMPLETE
        return 1
    if f.total != 46 + 20000 or f.headers_end != 46
        return 2
    return 0

[[test]]
fn test_frame_headers_incomplete() -> i32
    if frame_cstr(c"POST /wiki HTTP/1.1\r\nContent-Len") != H1F_INCOMPLETE
        return 1
    return 0

[[test]]
fn test_frame_request_line_only_is_incomplete() -> i32
    # The first record or read of a split request (AGAST #2201).
    if frame_cstr(c"GET / HTTP/1.1\r\n") != H1F_INCOMPLETE
        return 1
    return 0

[[test]]
fn test_frame_malformed_is_not_incomplete() -> i32
    # No amount of further input completes this, so the caller must not
    # wait for more (AGAST #2201).
    if frame_cstr(c"GET / HTTP/1.1\rX\nHost: x\r\n\r\n") != H1F_BAD_REQUEST
        return 1
    return 0

[[test]]
fn test_frame_junk_line_is_malformed() -> i32
    # No space before the line break: not a request line (AGAST #2201).
    if frame_cstr(c"hello there\r\n\r\n") != H1F_BAD_REQUEST
        return 1
    if frame_cstr(c"GET /index.html\r\nHost: x\r\n\r\n") != H1F_BAD_REQUEST
        return 2
    return 0

[[test]]
fn test_frame_content_length_is_i64() -> i32
    # 3000000000 overflowed the old i32 parser; it is a length, still to come.
    let r = c"POST / HTTP/1.1\r\nContent-Length: 3000000000\r\n\r\n"
    var f: H1Frame
    if request_frame(r, strlen(r) as i32, 0, @f) != H1F_INCOMPLETE
        return 1
    if f.body_len != 3000000000
        return 2
    # Over the server's limit: 413, never a wrapped size.
    if request_frame(r, strlen(r) as i32, 1048576, @f) != H1F_TOO_LARGE
        return 3
    return 0

[[test]]
fn test_frame_cl_and_te_is_bad() -> i32
    if frame_cstr(c"POST / HTTP/1.1\r\nTransfer-Encoding: chunked\r\nContent-Length: 3\r\n\r\n0\r\n\r\n") != H1F_BAD_REQUEST
        return 1
    return 0

[[test]]
fn test_frame_duplicate_cl_is_bad() -> i32
    if frame_cstr(c"POST / HTTP/1.1\r\nContent-Length: 1\r\nContent-Length: 1\r\n\r\na") != H1F_BAD_REQUEST
        return 1
    return 0

[[test]]
fn test_frame_invalid_cl_is_bad() -> i32
    # Was "no body": the body was then read as the next request.
    if frame_cstr(c"POST / HTTP/1.1\r\nContent-Length: 1a\r\n\r\nGET / HTTP/1.1\r\n\r\n") != H1F_BAD_REQUEST
        return 1
    return 0

[[test]]
fn test_frame_unsupported_te_is_not_implemented() -> i32
    if frame_cstr(c"POST / HTTP/1.1\r\nTransfer-Encoding: deflate\r\n\r\n") != H1F_NOT_IMPLEMENTED
        return 1
    return 0

[[test]]
fn test_frame_pipelined_stops_at_first() -> i32
    let r = c"POST / HTTP/1.1\r\nTransfer-Encoding: chunked\r\n\r\n1\r\na\r\n0\r\n\r\nGET / HTTP/1.1\r\n\r\n"
    if frame_cstr(r) != strlen(r) - 18
        return 1
    return 0


# ----------------------------------------------------------------------------
# proxy_copy_headers(dst, cap, src, len, closing) - valet owns `Connection`
#
# The worker always writes "Connection: keep-alive", but valet closes the
# connection after keepalive_requests responses (and after a client's
# "Connection: close"). Passing the worker's header through promised reuse
# valet then refused: every 100th request through zeus was a client read
# error (~1% under wrk, AGAST #2459).
# ----------------------------------------------------------------------------

fn copied_is(dst: *u8, n: i64, want: *u8) -> i32
    if n != strlen(want)
        return 0
    for i in 0..n
        if *(dst + i) != *(want + i)
            return 0
    return 1

[[test]]
fn test_proxy_headers_last_response_says_close() -> i32
    let src: *u8 = c"HTTP/1.1 200 OK\r\nContent-Length: 2\r\nConnection: keep-alive\r\n\r\n"
    var dst: [256]u8
    let n: i64 = proxy_copy_headers(@dst[0], 256, src, strlen(src), 1)
    if copied_is(@dst[0], n, c"HTTP/1.1 200 OK\r\nContent-Length: 2\r\nConnection: close\r\n\r\n") == 0
        return 1
    return 0

[[test]]
fn test_proxy_headers_reused_connection_says_keep_alive() -> i32
    let src: *u8 = c"HTTP/1.1 303 See Other\r\nconnection: close\r\nLocation: /wiki/x\r\n\r\n"
    var dst: [256]u8
    let n: i64 = proxy_copy_headers(@dst[0], 256, src, strlen(src), 0)
    if copied_is(@dst[0], n, c"HTTP/1.1 303 See Other\r\nLocation: /wiki/x\r\nConnection: keep-alive\r\n\r\n") == 0
        return 1
    return 0

[[test]]
fn test_proxy_headers_without_connection_gain_one() -> i32
    let src: *u8 = c"HTTP/1.1 404 Not Found\r\nContent-Length: 0\r\n\r\n"
    var dst: [256]u8
    let n: i64 = proxy_copy_headers(@dst[0], 256, src, strlen(src), 1)
    if copied_is(@dst[0], n, c"HTTP/1.1 404 Not Found\r\nContent-Length: 0\r\nConnection: close\r\n\r\n") == 0
        return 1
    return 0

[[test]]
fn test_proxy_headers_keep_lookalike_names() -> i32
    # Only the Connection header itself is valet's.
    let src: *u8 = c"HTTP/1.1 200 OK\r\nX-Connection-Id: 7\r\n\r\n"
    var dst: [256]u8
    let n: i64 = proxy_copy_headers(@dst[0], 256, src, strlen(src), 0)
    if copied_is(@dst[0], n, c"HTTP/1.1 200 OK\r\nX-Connection-Id: 7\r\nConnection: keep-alive\r\n\r\n") == 0
        return 1
    return 0

[[test]]
fn test_proxy_headers_refuse_a_small_buffer() -> i32
    let src: *u8 = c"HTTP/1.1 200 OK\r\n\r\n"
    var dst: [32]u8
    if proxy_copy_headers(@dst[0], 20, src, strlen(src), 0) != -1
        return 1
    return 0

[[test]]
fn test_proxy_headers_extra_bound_covers_growth() -> i32
    # Replacing a short Connection line, or adding one, grows the block by at
    # most PROXY_CONNECTION_EXTRA bytes: callers size their buffer with it.
    let src: *u8 = c"HTTP/1.1 200 OK\r\n\r\n"
    var dst: [256]u8
    let n: i64 = proxy_copy_headers(@dst[0], 256, src, strlen(src), 0)
    if n < 0 or n > strlen(src) + PROXY_CONNECTION_EXTRA
        return 1
    return 0


# ----------------------------------------------------------------------------
# Yield backoff (AGAST #183)
#
# A PROXY_WAIT task that misses its response re-arms a yield.  A NOP yield
# completes at once, so N waiters made the event loop spin on N NOP CQEs
# per pass (~950 continuations a request at c=50) and the connection
# stalled.  The first few yields stay NOPs (most responses land within
# microseconds); later ones become IORING_OP_TIMEOUTs that double from
# PROXY_YIELD_MIN_US up to PROXY_YIELD_MAX_US.
# ----------------------------------------------------------------------------

[[test]]
fn test_yield_first_yields_are_nops() -> i32
    for n in 0..PROXY_YIELD_NOPS
        if proxy_yield_delay_us(n) != 0
            return 1
    return 0

[[test]]
fn test_yield_first_timer_is_min() -> i32
    if proxy_yield_delay_us(PROXY_YIELD_NOPS) != PROXY_YIELD_MIN_US
        return 1
    return 0

[[test]]
fn test_yield_timer_doubles() -> i32
    let a: i64 = proxy_yield_delay_us(PROXY_YIELD_NOPS)
    let b: i64 = proxy_yield_delay_us(PROXY_YIELD_NOPS + 1)
    let c: i64 = proxy_yield_delay_us(PROXY_YIELD_NOPS + 2)
    if b != a * 2 or c != a * 4
        return 1
    return 0

[[test]]
fn test_yield_timer_is_capped() -> i32
    if proxy_yield_delay_us(PROXY_YIELD_NOPS + 40) != PROXY_YIELD_MAX_US
        return 1
    # A huge yield count (a 5 s wait at the cap is ~5000 yields) must not
    # overflow the shift into a negative or zero delay.
    if proxy_yield_delay_us(1000000) != PROXY_YIELD_MAX_US
        return 2
    return 0

[[test]]
fn test_yield_timer_never_decreases() -> i32
    var prev: i64 = 0
    for n in 0..200
        let d: i64 = proxy_yield_delay_us(n as i32)
        if d < prev or d > PROXY_YIELD_MAX_US
            return 1
        prev = d
    return 0

[[test]]
fn test_yield_negative_count_is_nop() -> i32
    if proxy_yield_delay_us(-1) != 0
        return 1
    return 0

[[test]]
fn test_yield_timespec_split() -> i32
    var ts: KernelTimespec
    proxy_yield_timespec(@ts, 1500000)
    if ts.tv_sec != 1 or ts.tv_nsec != 500000000
        return 1
    proxy_yield_timespec(@ts, 16)
    if ts.tv_sec != 0 or ts.tv_nsec != 16000
        return 2
    return 0

[[test]]
fn test_yield_einval_disables_timer() -> i32
    # A kernel that rejects IORING_OP_TIMEOUT (WSL2 6.6) answers -EINVAL:
    # valet then yields with NOPs for the rest of its life.
    if proxy_yield_timer_rejected(-22) != 1
        return 1
    # -ETIME is a timer that fired; 0 is a NOP's CQE.
    if proxy_yield_timer_rejected(-62) != 0
        return 2
    if proxy_yield_timer_rejected(0) != 0
        return 3
    return 0

[[test]]
fn test_yield_nop_window_covers_a_fast_response() -> i32
    # A c=1 proxied GET takes ~45 µs, longer than a couple of NOP passes:
    # with only 2 NOPs it fell into a timer and lost ~25% of its rps
    # (16.6k vs 22k on toffee, AGAST #4297).  Keep the NOP window wide
    # enough that a fast response never waits on a timer.
    if PROXY_YIELD_NOPS < 32
        return 1
    if proxy_yield_delay_us(31) != 0
        return 2
    return 0
