# test/test_static_keepalive.ritz - static responses advertise valet's
# keep-alive decision (AGAST #2117, #3899)
#
# Since #2106 valet closes the connection after an HTTP/1.0 request without
# keep-alive, a "Connection: close" request, and the keepalive_requests-th
# request.  The ctx_* helpers say so (test_keepalive.ritz), but lib/static.ritz
# hand-built "Connection: keep-alive" into every file, directory, 304 and 404
# response, promising reuse valet then refused.
#
# Each test drives valet_try_static the way the connection handler does
# (parse, bump request_count, saturate it when valet_keep_alive says close)
# and reads the response back from a pipe.

import ritzlib.sys
import ritzlib.span
import ritzlib.string
import ritzlib.strview
import ritzlib.async.tasks
import ritzlib.fd
import ritzlib.fs { mkdir, unlink, rmdir }
import ritzlib.process { process_id }

import lib.request
import lib.static
import lib.valet

# /tmp/valet_<pid>_<name>.  The pid keeps concurrent test runs off each
# other's files (AGAST #4052); ritzunit forks each test, so each test gets
# its own.
fn pid_tmp_path(name: StrView) -> String
    var path: String = string_from("/tmp/valet_")
    path.push_i64(process_id() as i64)
    path.push('_')
    path.push_str(name)
    path

# This process's own fixture root, /tmp/valet_<pid>_static_ka (AGAST #4052).
# A fixed /tmp path let two concurrent valet test runs (gate slots, compiler
# variants) O_TRUNC each other's fixture between write and serve.
fn root_dir() -> String
    pid_tmp_path("static_ka")

# root_dir()/<name>
fn root_path(name: StrView) -> String
    var path: String = root_dir()
    path.push('/')
    path.push_str(name)
    path

fn contains(hay: *u8, len: i32, needle: StrView) -> i32
    var i: i32 = 0
    while i + needle.len as i32 <= len
        var j: i64 = 0
        while j < needle.len and *(hay + i + j) == *(needle.ptr + j)
            j += 1
        if j == needle.len
            return 1
        i += 1
    0

# Create the fixture tree: root_dir()/<name> holding "hello\n", and
# root_dir()/dir/ for the directory listing.  0 on success.
fn fixture(name: StrView) -> i32
    let root: String = root_dir()
    mkdir(root.as_view(), 493)                       # 0755; EEXIST is fine
    let dir: String = root_path("dir")
    mkdir(dir.as_view(), 493)
    let file: String = root_path(name)
    # mode 0644 = 420
    var f: Fd = match fd_open(file.as_view(), O_WRONLY + O_CREAT + O_TRUNC, 420)
        Ok(opened) => opened
        Err(_) => return 1
    var write_ok: bool = true
    match f.write_str("hello\n")
        Ok(_) => pass
        Err(_) => write_ok = false
    f.close()
    if not write_ok
        return 2
    0

# Undo fixture(name): remove the file, dir/ and the root.  Deferred by each
# test that builds a fixture, so a per-process root does not pile up in /tmp.
fn teardown(name: StrView)
    let file: String = root_path(name)
    unlink(file.as_view())
    let dir: String = root_path("dir")
    rmdir(dir.as_view())
    let root: String = root_dir()
    rmdir(root.as_view())

# Drain `f` into out[0..cap); returns bytes read.
fn drain(f: @Fd, out: *u8, cap: i32) -> i32
    var total: i32 = 0
    while total < cap
        var n: i64 = 0
        match f.read(Span<u8> { ptr: out + total, len: (cap - total) as i64 })
            Ok(got) => n = got
            Err(_) => n = -1
        if n <= 0
            break
        total += n as i32
    total

# Put `raw` in `task`'s read buffer, as a recv would.
fn task_load_request(task: @&Task, raw: StrView)
    let read_buf: Span<u8> = @task.read_buf
    task.read_len = read_buf.copy_from(raw.as_bytes()) as i32

# Serve `raw` as the `count`-th request on a connection through
# valet_try_static; the response lands in out[0..cap).  Returns its length,
# or negative on setup failure.
fn static_reply(raw: StrView, count: i32, out: *u8, cap: i32) -> i32
    var app: Valet
    valet_init(@app, 0)
    let root: String = root_dir()
    valet_static(@app, "/s/*", root.as_view())
    set_g_app(@app)

    var task: Task
    task_load_request(@&task, raw)

    # Parsed from `raw` itself, so `req` holds no view into the task that
    # valet_try_static borrows mutably.
    var req: Request
    request_init(@req)
    if request_parse(@req, raw.as_bytes()) < 0
        return -1

    # Exactly what valet's connection handler does before valet_try_static.
    task.request_count = count
    if valet_keep_alive(@req, task.request_count, app.keepalive_requests) == 0
        task.request_count = app.keepalive_requests

    var p: Pipe = match pipe()
        Ok(pp) => pp
        Err(_) => return -2
    task.fd = p.write.raw()
    let handled: bool = valet_try_static(@app, @&task, req.path)
    p.write.close()
    let n: i32 = drain(@p.read, out, cap)
    p.read.close()
    set_g_app(null)
    if not handled
        return -3
    n

# 0 when the response says close and never keep-alive; 1/2 otherwise.
fn says_close(out: *u8, n: i32) -> i32
    if contains(out, n, "Connection: close\r\n") != 1
        return 1
    if contains(out, n, "keep-alive") != 0
        return 2
    0

# ----------------------------------------------------------------------------
# Static file (static_serve_file_full)
# ----------------------------------------------------------------------------

[[test]]
fn test_static_file_http10_client_gets_close() -> i32
    defer teardown("a.txt")
    if fixture("a.txt") != 0
        return 90
    var buf: [2048]u8
    let n: i32 = static_reply("GET /s/a.txt HTTP/1.0\r\nHost: x\r\n\r\n", 1, @buf[0], 2048)
    if n <= 0
        return 91
    if contains(@buf[0], n, "200 OK") != 1
        return 92
    says_close(@buf[0], n)

[[test]]
fn test_static_file_connection_close_gets_close() -> i32
    defer teardown("b.txt")
    if fixture("b.txt") != 0
        return 90
    var buf: [2048]u8
    let n: i32 = static_reply("GET /s/b.txt HTTP/1.1\r\nHost: x\r\nConnection: close\r\n\r\n", 1, @buf[0], 2048)
    if n <= 0
        return 91
    says_close(@buf[0], n)

[[test]]
fn test_static_file_last_keepalive_request_gets_close() -> i32
    defer teardown("c.txt")
    if fixture("c.txt") != 0
        return 90
    var buf: [2048]u8
    # keepalive_requests defaults to 100: the 100th response is the last.
    let n: i32 = static_reply("GET /s/c.txt HTTP/1.1\r\nHost: x\r\n\r\n", 100, @buf[0], 2048)
    if n <= 0
        return 91
    says_close(@buf[0], n)

[[test]]
fn test_static_file_http11_keeps_alive() -> i32
    defer teardown("d.txt")
    if fixture("d.txt") != 0
        return 90
    var buf: [2048]u8
    let n: i32 = static_reply("GET /s/d.txt HTTP/1.1\r\nHost: x\r\n\r\n", 1, @buf[0], 2048)
    if n <= 0
        return 91
    if contains(@buf[0], n, "Connection: keep-alive\r\n") != 1
        return 1
    if contains(@buf[0], n, "close") != 0
        return 2
    # Body follows the headers intact.
    if contains(@buf[0], n, "\r\n\r\nhello\n") != 1
        return 3
    0

# ----------------------------------------------------------------------------
# 304, directory listing, 404
# ----------------------------------------------------------------------------

[[test]]
fn test_static_304_connection_close_gets_close() -> i32
    var buf: [512]u8
    var p: Pipe = match pipe()
        Ok(pp) => pp
        Err(_) => return 90
    static_send_304(p.write.raw(), "\"abc\"", 0)
    p.write.close()
    let n: i32 = drain(@p.read, @buf[0], 512)
    p.read.close()
    if contains(@buf[0], n, "304 Not Modified") != 1
        return 91
    says_close(@buf[0], n)

[[test]]
fn test_static_304_keeps_alive() -> i32
    var buf: [512]u8
    var p: Pipe = match pipe()
        Ok(pp) => pp
        Err(_) => return 90
    static_send_304(p.write.raw(), "\"abc\"", 1)
    p.write.close()
    let n: i32 = drain(@p.read, @buf[0], 512)
    p.read.close()
    if contains(@buf[0], n, "Connection: keep-alive\r\n\r\n") != 1
        return 1
    0

[[test]]
fn test_static_directory_http10_client_gets_close() -> i32
    defer teardown("dir/e.txt")
    if fixture("dir/e.txt") != 0
        return 90
    var buf: [8192]u8
    let n: i32 = static_reply("GET /s/dir HTTP/1.0\r\n\r\n", 1, @buf[0], 8192)
    if n <= 0
        return 91
    if contains(@buf[0], n, "Index of") != 1
        return 92
    says_close(@buf[0], n)

[[test]]
fn test_static_404_connection_close_gets_close() -> i32
    var buf: [512]u8
    let n: i32 = static_reply("GET /s/missing.txt HTTP/1.1\r\nConnection: close\r\n\r\n", 1, @buf[0], 512)
    if n <= 0
        return 91
    if contains(@buf[0], n, "404 Not Found") != 1
        return 92
    says_close(@buf[0], n)

# The 404 is exactly its headers and 14-byte body: nothing after "Found\n".
[[test]]
fn test_static_404_keeps_alive_and_ends_at_body() -> i32
    var buf: [512]u8
    let n: i32 = static_reply("GET /s/missing.txt HTTP/1.1\r\n\r\n", 1, @buf[0], 512)
    if n <= 0
        return 91
    if contains(@buf[0], n, "Connection: keep-alive\r\n") != 1
        return 1
    if contains(@buf[0], n, "\r\n\r\n404 Not Found\n") != 1
        return 2
    if buf[n - 1] != '\n' or buf[n - 2] != 'd'
        return 3
    0

# static_serve_file: the plain (no Range/ETag) variant.
[[test]]
fn test_static_serve_file_close_and_keep_alive() -> i32
    defer teardown("f.txt")
    if fixture("f.txt") != 0
        return 90
    let fpath: String = root_path("f.txt")
    var buf: [1024]u8
    var p: Pipe = match pipe()
        Ok(pp) => pp
        Err(_) => return 91
    static_serve_file(p.write.raw(), fpath.as_view(), 0)
    p.write.close()
    var n: i32 = drain(@p.read, @buf[0], 1024)
    p.read.close()
    if says_close(@buf[0], n) != 0
        return 1
    p = match pipe()
        Ok(pp) => pp
        Err(_) => return 92
    static_serve_file(p.write.raw(), fpath.as_view(), 1)
    p.write.close()
    n = drain(@p.read, @buf[0], 1024)
    p.read.close()
    if contains(@buf[0], n, "Connection: keep-alive\r\n\r\nhello\n") != 1
        return 2
    0

# ----------------------------------------------------------------------------
# 416 and 403 (AGAST #3899): they hard-coded "Connection: close" while valet
# kept the connection open after them.
# ----------------------------------------------------------------------------

[[test]]
fn test_static_416_keeps_alive() -> i32
    defer teardown("h.txt")
    if fixture("h.txt") != 0
        return 90
    var buf: [1024]u8
    let n: i32 = static_reply("GET /s/h.txt HTTP/1.1\r\nRange: bytes=100-\r\n\r\n", 1, @buf[0], 1024)
    if n <= 0
        return 91
    if contains(@buf[0], n, "416 Range Not Satisfiable") != 1
        return 92
    if contains(@buf[0], n, "Connection: keep-alive\r\n\r\nRange Not Satisfiable\n") != 1
        return 1
    if contains(@buf[0], n, "close") != 0
        return 2
    0

[[test]]
fn test_static_416_last_keepalive_request_gets_close() -> i32
    defer teardown("i.txt")
    if fixture("i.txt") != 0
        return 90
    var buf: [1024]u8
    let n: i32 = static_reply("GET /s/i.txt HTTP/1.1\r\nRange: bytes=100-\r\n\r\n", 100, @buf[0], 1024)
    if n <= 0
        return 91
    if contains(@buf[0], n, "416 Range Not Satisfiable") != 1
        return 92
    says_close(@buf[0], n)

[[test]]
fn test_static_403_keeps_alive() -> i32
    var buf: [512]u8
    let n: i32 = static_reply("GET /s/../etc/passwd HTTP/1.1\r\n\r\n", 1, @buf[0], 512)
    if n <= 0
        return 91
    if contains(@buf[0], n, "403 Forbidden") != 1
        return 92
    if contains(@buf[0], n, "Connection: keep-alive\r\n\r\n403 Forbidden\n") != 1
        return 1
    if contains(@buf[0], n, "close") != 0
        return 2
    0

[[test]]
fn test_static_403_connection_close_gets_close() -> i32
    var buf: [512]u8
    let n: i32 = static_reply("GET /s/../etc/passwd HTTP/1.1\r\nConnection: close\r\n\r\n", 1, @buf[0], 512)
    if n <= 0
        return 91
    if contains(@buf[0], n, "403 Forbidden") != 1
        return 92
    says_close(@buf[0], n)

[[test]]
fn test_static_403_last_keepalive_request_gets_close() -> i32
    var buf: [512]u8
    let n: i32 = static_reply("GET /s/../etc/passwd HTTP/1.1\r\n\r\n", 100, @buf[0], 512)
    if n <= 0
        return 91
    if contains(@buf[0], n, "403 Forbidden") != 1
        return 92
    says_close(@buf[0], n)

# A conditional GET that matches answers 304 through static_serve_file_full.
[[test]]
fn test_static_304_via_if_none_match_connection_close_gets_close() -> i32
    defer teardown("g.txt")
    if fixture("g.txt") != 0
        return 90
    var buf: [1024]u8
    let n: i32 = static_reply("GET /s/g.txt HTTP/1.1\r\nIf-None-Match: *\r\nConnection: close\r\n\r\n", 1, @buf[0], 1024)
    if n <= 0
        return 91
    if contains(@buf[0], n, "304 Not Modified") != 1
        return 92
    says_close(@buf[0], n)
