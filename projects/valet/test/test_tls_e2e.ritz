const CA_NOT_BEFORE: i64 = 1767225600   # 2026-01-01T00:00:00Z
const CA_NOT_AFTER: i64 = 4922899200    # 2126-01-01T00:00:00Z

# A store holding the one CA certificate `pem`. 0 on success.
fn store_with(store: *CaStore, pem: *u8) -> i32
    ca_store_init(store)
    if ca_store_add_cert_pem(store, pem, cstr_len_e2e(pem)) != 1
        return 1
    return 0

fn ca_client_setup(cfg: *TlsConfig, host: *u8, store: *CaStore, now: i64) -> i32
    tls_config_init(cfg)
    tls_config_set_hostname(cfg, host, cstr_len_e2e(host) as i32)
    tls_config_set_verify_time(cfg, now)
    return tls_config_set_ca_store(cfg, store)

# As client_verdict, trusting the CAs in `store` at time `now` (0 = clock).
fn ca_verdict(chain: *u8, host: *u8, ca_pem: *u8, now: i64) -> i32
    var der: [8192]u8
    var scfg: TlsServerConfig
    if server_setup(@scfg, @der[0], chain, key_ca_leaf()) != 0
        return 100
    var store: CaStore
    if store_with(@store, ca_pem) != 0
        ca_store_destroy(@store)
        return 101
    var ccfg: TlsConfig
    if ca_client_setup(@ccfg, host, @store, now) != 0
        ca_store_destroy(@store)
        return 102
    var server: TlsServer
    tls_server_init(@server, @scfg)
    var client: TlsClient
    tls_client_init(@client, @ccfg)
    let hs: i32 = handshake(@client, @server)
    var err: i32 = tls_client_error(@client)
    if hs == 0
        err = 0
    else if hs != 3
        err = 200 + hs
    else if tls_client_state(@client) != TLS_STATE_ERROR
        err = 300
    tls_client_free(@client)
    tls_server_free(@server)
    ca_store_destroy(@store)
    return err

[[test]]
fn test_e2e_ca_chain_handshake_and_data() -> i32
    # The acceptance case: no pin, the server's chain leads to a CA in the
    # store, so the client handshakes and exchanges data.
    var der: [8192]u8
    var scfg: TlsServerConfig
    if server_setup(@scfg, @der[0], chain_leaf_inter(), key_ca_leaf()) != 0
        return 1
    var store: CaStore
    if store_with(@store, ca_root()) != 0
        return 2
    var ccfg: TlsConfig
    if ca_client_setup(@ccfg, c"valet.test", @store, 0) != 0
        return 3
    if ccfg.pinned_cert_len != 0
        return 4
    var server: TlsServer
    tls_server_init(@server, @scfg)
    var client: TlsClient
    tls_client_init(@client, @ccfg)
    let hs: i32 = handshake(@client, @server)
    if hs != 0
        return 10 + hs
    if send_to_server(@client, @server, c"GET / HTTP/1.1\r\nHost: valet.test\r\n\r\n") != 0
        return 20
    if send_to_client(@server, @client, c"HTTP/1.1 200 OK\r\nContent-Length: 2\r\n\r\nhi") != 0
        return 21
    tls_client_free(@client)
    tls_server_free(@server)
    ca_store_destroy(@store)
    return 0

[[test]]
fn test_e2e_ca_refuses_chain_to_other_ca() -> i32
    if ca_verdict(chain_leaf_inter(), c"valet.test", ca_root(), 0) != 0
        return 1  # control
    # Same CA name, different key: the old name-only lookup trusted this.
    if ca_verdict(chain_leaf_inter(), c"valet.test", ca_impostor(), 0) != TLS_ERR_CERTIFICATE_INVALID
        return 2
    if ca_verdict(chain_leaf_inter(), c"valet.test", ca_root_ed25519(), 0) != TLS_ERR_CERTIFICATE_INVALID
        return 3
    return 0

[[test]]
fn test_e2e_ca_refuses_missing_intermediate() -> i32
    if ca_verdict(chain_leaf_only(), c"valet.test", ca_root(), 0) != TLS_ERR_CERTIFICATE_INVALID
        return 1
    return 0

[[test]]
fn test_e2e_ca_checks_san_hostname() -> i32
    # The leaf's CN is "Ritz Leaf": these match only through its SAN.
    if ca_verdict(chain_leaf_inter(), c"api.wild.test", ca_root(), 0) != 0
        return 1
    if ca_verdict(chain_leaf_inter(), c"evil.test", ca_root(), 0) != TLS_ERR_CERTIFICATE_INVALID
        return 2
    if ca_verdict(chain_leaf_inter(), c"Ritz Leaf", ca_root(), 0) != TLS_ERR_CERTIFICATE_INVALID
        return 3
    return 0

[[test]]
fn test_e2e_ca_checks_validity_dates() -> i32
    if ca_verdict(chain_leaf_inter(), c"valet.test", ca_root(), CA_NOT_BEFORE) != 0
        return 1
    if ca_verdict(chain_leaf_inter(), c"valet.test", ca_root(), CA_NOT_BEFORE - 1) != TLS_ERR_CERTIFICATE_INVALID
        return 2
    if ca_verdict(chain_leaf_inter(), c"valet.test", ca_root(), CA_NOT_AFTER + 1) != TLS_ERR_CERTIFICATE_INVALID
        return 3
    return 0

[[test]]
fn test_e2e_ca_ed25519_signed_chain() -> i32
    if ca_verdict(chain_leaf_ed25519(), c"valet.test", ca_root_ed25519(), 0) != 0
        return 1
    if ca_verdict(chain_leaf_ed25519(), c"valet.test", ca_root(), 0) != TLS_ERR_CERTIFICATE_INVALID
        return 2
    return 0

[[test]]
fn test_e2e_ca_large_certificate_flight() -> i32
    # Six certificates: one ~6.5 KB record, over the client's old 4096-byte
    # receive and decrypt buffers.
    var der: [8192]u8
    var scfg: TlsServerConfig
    if server_setup(@scfg, @der[0], chain_big(), key_ca_leaf()) != 0
        return 1
    if scfg.num_certs != 6 || scfg.cert_chain_len <= 4096
        return 2
    if ca_verdict(chain_big(), c"valet.test", ca_root(), 0) != 0
        return 3
    return 0

[[test]]
fn test_e2e_ca_multi_record_flight() -> i32
    # Re-send valet's encrypted flight as many small records, so messages
    # (the Certificate above all) are split across records, and feed it to
    # the client in uneven pieces.
    var der: [8192]u8
    var scfg: TlsServerConfig
    if server_setup(@scfg, @der[0], chain_leaf_inter(), key_ca_leaf()) != 0
        return 1
    var store: CaStore
    if store_with(@store, ca_root()) != 0
        return 2
    var ccfg: TlsConfig
    if ca_client_setup(@ccfg, c"valet.test", @store, 0) != 0
        return 3
    var server: TlsServer
    tls_server_init(@server, @scfg)
    var client: TlsClient
    tls_client_init(@client, @ccfg)

    var ch: [4096]u8
    let ch_len: i64 = tls_client_start(@client, @ch[0], 4096)
    var real: [16384]u8
    var real_len: i64 = 0
    if tls_server_process(@server, @ch[0], ch_len, @real[0], 16384, @real_len) != TLS_RESULT_HAVE_OUTPUT
        return 4
    let sh_rec: i64 = 5 + (((real[3] as i64) << 8) | (real[4] as i64))

    # Decrypt the server's one flight record with the server's keys ...
    var rs: TlsRecordState
    tls_record_state_init(@rs)
    tls_record_state_set_keys(@rs, @server.key_schedule.client_write_key[0], @server.key_schedule.client_write_iv[0], @server.key_schedule.server_write_key[0], @server.key_schedule.server_write_iv[0], 16)
    var flight: [16384]u8
    var inner: u8 = 0
    let flight_len: i32 = tls_record_state_server_decrypt(@rs, @real[sh_rec], (real_len - sh_rec) as i32, @flight[0], 16384, @inner)
    if flight_len <= 1000 || inner != 22
        return 5

    # ... and re-encrypt it 97 bytes per record.
    var ws: TlsRecordState
    tls_record_state_init(@ws)
    tls_record_state_set_keys(@ws, @server.key_schedule.client_write_key[0], @server.key_schedule.client_write_iv[0], @server.key_schedule.server_write_key[0], @server.key_schedule.server_write_iv[0], 16)
    var wire: [32768]u8
    mem_copy(@wire[0], @real[0], sh_rec)
    var wire_len: i64 = sh_rec
    var p: i64 = 0
    var records: i32 = 0
    while p < flight_len as i64
        var n: i64 = flight_len as i64 - p
        if n > 97
            n = 97
        let enc: i32 = tls_record_state_server_encrypt(@ws, @flight[p], n as i32, 22, @wire[wire_len], 1024)
        if enc <= 0
            return 6
        wire_len = wire_len + enc as i64
        p = p + n
        records += 1
    if records < 10
        return 7

    var c_out: [4096]u8
    var c_len: i64 = 0
    var off: i64 = 0
    var r: i32 = TLS_RESULT_NEED_INPUT
    while off < wire_len
        var piece: i64 = wire_len - off
        if piece > 333
            piece = 333
        r = tls_client_process(@client, @wire[off], piece, @c_out[0], 4096, @c_len)
        off = off + piece
        if r != TLS_RESULT_NEED_INPUT
            break
    if r != TLS_RESULT_HAVE_OUTPUT || off != wire_len
        return 100 + tls_client_error(@client)
    var s_out: [1024]u8
    var s_len: i64 = 0
    if tls_server_process(@server, @c_out[0], c_len, @s_out[0], 1024, @s_len) != TLS_RESULT_COMPLETE
        return 8
    if send_to_client(@server, @client, c"after a fragmented flight") != 0
        return 9
    tls_client_free(@client)
    tls_server_free(@server)
    ca_store_destroy(@store)
    return 0

[[test]]
fn test_e2e_client_rejects_data_after_server_finished() -> i32
    # The keys change after the server's Finished, so no handshake bytes may
    # follow it in the same record (RFC 8446 5.1).
    var der: [8192]u8
    var scfg: TlsServerConfig
    if server_setup(@scfg, @der[0], chain_leaf_inter(), key_ca_leaf()) != 0
        return 1
    var store: CaStore
    if store_with(@store, ca_root()) != 0
        return 2
    var ccfg: TlsConfig
    if ca_client_setup(@ccfg, c"valet.test", @store, 0) != 0
        return 3
    var server: TlsServer
    tls_server_init(@server, @scfg)
    var client: TlsClient
    tls_client_init(@client, @ccfg)

    var ch: [4096]u8
    let ch_len: i64 = tls_client_start(@client, @ch[0], 4096)
    var real: [16384]u8
    var real_len: i64 = 0
    if tls_server_process(@server, @ch[0], ch_len, @real[0], 16384, @real_len) != TLS_RESULT_HAVE_OUTPUT
        return 4
    let sh_rec: i64 = 5 + (((real[3] as i64) << 8) | (real[4] as i64))
    var rs: TlsRecordState
    tls_record_state_init(@rs)
    tls_record_state_set_keys(@rs, @server.key_schedule.client_write_key[0], @server.key_schedule.client_write_iv[0], @server.key_schedule.server_write_key[0], @server.key_schedule.server_write_iv[0], 16)
    var flight: [16384]u8
    var inner: u8 = 0
    let flight_len: i32 = tls_record_state_server_decrypt(@rs, @real[sh_rec], (real_len - sh_rec) as i32, @flight[0], 16384, @inner)
    if flight_len <= 0
        return 5
    # A trailing (empty) KeyUpdate header after Finished.
    flight[flight_len] = 24
    flight[flight_len + 1] = 0
    flight[flight_len + 2] = 0
    flight[flight_len + 3] = 0

    var ws: TlsRecordState
    tls_record_state_init(@ws)
    tls_record_state_set_keys(@ws, @server.key_schedule.client_write_key[0], @server.key_schedule.client_write_iv[0], @server.key_schedule.server_write_key[0], @server.key_schedule.server_write_iv[0], 16)
    let enc: i32 = tls_record_state_server_encrypt(@ws, @flight[0], flight_len + 4, 22, @real[sh_rec], 16384 - sh_rec as i32)
    if enc <= 0
        return 6
    var c_out: [4096]u8
    var c_len: i64 = 0
    if tls_client_process(@client, @real[0], sh_rec + enc as i64, @c_out[0], 4096, @c_len) != TLS_RESULT_ERROR
        return 7
    if tls_client_error(@client) != TLS_ERR_UNEXPECTED_MESSAGE || tls_client_is_connected(@client) != 0
        return 8
    ca_store_destroy(@store)
    return 0

# ============================================================================
# Middlebox-compat change_cipher_spec (AGAST #2116)
# ============================================================================
# Real servers send one dummy change_cipher_spec record (body 0x01) after
# the ServerHello (RFC 8446 D.4). Re-send valet's flight with one inserted.
# `split` > 0 also re-encrypts the flight `split` bytes per record and puts
# the CCS after its first record instead; handshake messages must not be
# interleaved with other record types (RFC 8446 5.1), so that one fails.
fn ccs_handshake_2116(client: *TlsClient, server: *TlsServer, split: i64) -> i32
    var ch: [4096]u8
    let ch_len: i64 = tls_client_start(client, @ch[0], 4096)
    var real: [16384]u8
    var real_len: i64 = 0
    if tls_server_process(server, @ch[0], ch_len, @real[0], 16384, @real_len) != TLS_RESULT_HAVE_OUTPUT
        return 1
    let sh_rec: i64 = 5 + (((real[3] as i64) << 8) | (real[4] as i64))

    var wire: [32768]u8
    mem_copy(@wire[0], @real[0], sh_rec as u64)
    var wire_len: i64 = sh_rec
    var ccs_at: i64 = sh_rec
    if split <= 0
        mem_copy(@wire[sh_rec + 6], @real[sh_rec], (real_len - sh_rec) as u64)
        wire_len = real_len + 6
    else
        var rs: TlsRecordState
        tls_record_state_init(@rs)
        tls_record_state_set_keys(@rs, @server.key_schedule.client_write_key[0], @server.key_schedule.client_write_iv[0], @server.key_schedule.server_write_key[0], @server.key_schedule.server_write_iv[0], 16)
        var flight: [16384]u8
        var inner: u8 = 0
        let flight_len: i32 = tls_record_state_server_decrypt(@rs, @real[sh_rec], (real_len - sh_rec) as i32, @flight[0], 16384, @inner)
        if flight_len <= split as i32 || inner != 22
            return 2
        var ws: TlsRecordState
        tls_record_state_init(@ws)
        tls_record_state_set_keys(@ws, @server.key_schedule.client_write_key[0], @server.key_schedule.client_write_iv[0], @server.key_schedule.server_write_key[0], @server.key_schedule.server_write_iv[0], 16)
        var p: i64 = 0
        while p < flight_len as i64
            var n: i64 = flight_len as i64 - p
            if n > split
                n = split
            if p > 0 && ccs_at == sh_rec
                ccs_at = wire_len
                wire_len = wire_len + 6
            let enc: i32 = tls_record_state_server_encrypt(@ws, @flight[p], n as i32, 22, @wire[wire_len], 1024)
            if enc <= 0
                return 3
            wire_len = wire_len + enc as i64
            p = p + n
    wire[ccs_at] = 20
    wire[ccs_at + 1] = 0x03
    wire[ccs_at + 2] = 0x03
    wire[ccs_at + 3] = 0x00
    wire[ccs_at + 4] = 0x01
    wire[ccs_at + 5] = 0x01

    var c_out: [4096]u8
    var c_len: i64 = 0
    let r: i32 = tls_client_process(client, @wire[0], wire_len, @c_out[0], 4096, @c_len)
    if r != TLS_RESULT_HAVE_OUTPUT
        return 100 + tls_client_error(client)
    var s_out: [1024]u8
    var s_len: i64 = 0
    if tls_server_process(server, @c_out[0], c_len, @s_out[0], 1024, @s_len) != TLS_RESULT_COMPLETE
        return 4
    return 0

[[test]]
fn test_e2e_client_ignores_middlebox_ccs() -> i32
    var der: [8192]u8
    var scfg: TlsServerConfig
    if server_setup(@scfg, @der[0], cert_valet(), key_valet()) != 0
        return 1
    var ccfg: TlsConfig
    if client_setup(@ccfg, c"valet.test", @scfg) != 0
        return 2
    var server: TlsServer
    tls_server_init(@server, @scfg)
    var client: TlsClient
    tls_client_init(@client, @ccfg)
    let r: i32 = ccs_handshake_2116(@client, @server, 0)
    if r != 0
        return 10 + r
    if send_to_server(@client, @server, c"through a middlebox") != 0
        return 3
    if send_to_client(@server, @client, c"and back") != 0
        return 4
    tls_client_free(@client)
    tls_server_free(@server)
    return 0

[[test]]
fn test_e2e_client_rejects_ccs_inside_handshake_message() -> i32
    var der: [8192]u8
    var scfg: TlsServerConfig
    if server_setup(@scfg, @der[0], cert_valet(), key_valet()) != 0
        return 1
    var ccfg: TlsConfig
    if client_setup(@ccfg, c"valet.test", @scfg) != 0
        return 2
    var server: TlsServer
    tls_server_init(@server, @scfg)
    var client: TlsClient
    tls_client_init(@client, @ccfg)
    # 3 bytes: the CCS lands inside the EncryptedExtensions header.
    if ccs_handshake_2116(@client, @server, 3) != 100 + TLS_ERR_UNEXPECTED_MESSAGE
        return 3
    if tls_client_is_connected(@client) != 0
        return 4
    tls_client_free(@client)
    tls_server_free(@server)
    return 0

[[test]]
fn test_e2e_client_takes_ccs_between_whole_messages() -> i32
    # Control for the test above: a CCS between records that end on a
    # message boundary is fine. EncryptedExtensions from valet is 6 bytes
    # (header + empty extensions list), so a 6-byte first record ends on it.
    var der: [8192]u8
    var scfg: TlsServerConfig
    if server_setup(@scfg, @der[0], cert_valet(), key_valet()) != 0
        return 1
    var ccfg: TlsConfig
    if client_setup(@ccfg, c"valet.test", @scfg) != 0
        return 2
    var server: TlsServer
    tls_server_init(@server, @scfg)
    var client: TlsClient
    tls_client_init(@client, @ccfg)
    let r: i32 = ccs_handshake_2116(@client, @server, 6)
    if r != 0
        return 10 + r
    tls_client_free(@client)
    tls_server_free(@server)
    return 0
