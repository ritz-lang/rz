# test/test_json_builder.ritz - JsonBuilder integer output
#
# AGAST #1932: json_write_int negated with `value = -value`, which wraps for
# i64's minimum, so the digit loop never ran and the builder emitted just
# "-". Integers now go through ritzlib.fmt's fmt_i64_into.

import ritzlib.str
import ritzlib.strview

import lib.json_builder

# 0 when the builder's bytes are exactly `want`.
fn jb_differs(jb: *JsonBuilder, want: StrView) -> i32
    if json_len(jb) as i64 != want.len
        return 1
    var i: i64 = 0
    while i < want.len
        if *(json_ptr(jb) + i) != *(want.ptr + i)
            return 1
        i += 1
    0

fn i64_min() -> i64
    -9223372036854775807 - 1

[[test]]
fn test_json_val_int_min() -> i32
    var buf: [64]u8
    var jb: JsonBuilder
    json_init(@jb, @buf[0], 64)
    json_val_int(@jb, i64_min())
    jb_differs(@jb, "-9223372036854775808")

[[test]]
fn test_json_key_int_extremes() -> i32
    var buf: [128]u8
    var jb: JsonBuilder
    json_init(@jb, @buf[0], 128)
    json_object_start(@jb)
    json_key_int(@jb, c"lo", i64_min())
    json_key_int(@jb, c"hi", 9223372036854775807)
    json_key_int(@jb, c"z", 0)
    json_key_int(@jb, c"n", -42)
    json_object_end(@jb)
    jb_differs(@jb, "{\"lo\":-9223372036854775808,\"hi\":9223372036854775807,\"z\":0,\"n\":-42}")

# A number that doesn't fit fails without writing a partial value.
[[test]]
fn test_json_val_int_overflow_writes_nothing() -> i32
    var buf: [8]u8
    var jb: JsonBuilder
    json_init(@jb, @buf[0], 4)
    if json_val_int(@jb, 123456) != -1
        return 1
    if json_len(@jb) != 0
        return 2
    0
