# valet/lib/static.ritz - Static file serving
#
# Provides static file serving with:
#   - MIME type detection based on file extension
#   - sendfile() zero-copy transfer
#   - Directory traversal protection
#   - Directory listing for directories
#   - 404 for missing files
#
# Usage:
#   valet_static(@app, "/static/*", "./public")
#   # Then requests to /static/css/style.css serve ./public/css/style.css

import ritzlib.sys
import ritzlib.io
import ritzlib.str
import ritzlib.fs
import ritzlib.memory
import ritzlib.fmt.digits
import ritzlib.option
import ritzlib.strview { StrView, strview_from_cstr, strview_from_ptr, strview_parse_i64 }

import lib.log

# ============================================================================
# MIME type detection
# ============================================================================

# Get MIME type from file extension
# Returns pointer to static string
pub fn mime_type_for_ext(ext: *u8, ext_len: i32) -> *u8
    # HTML
    if ext_len == 4 && strneq(ext, c"html", 4)
        return c"text/html"
    if ext_len == 3 && strneq(ext, c"htm", 3)
        return c"text/html"

    # CSS
    if ext_len == 3 && strneq(ext, c"css", 3)
        return c"text/css"

    # JavaScript
    if ext_len == 2 && strneq(ext, c"js", 2)
        return c"application/javascript"
    if ext_len == 3 && strneq(ext, c"mjs", 3)
        return c"application/javascript"

    # JSON
    if ext_len == 4 && strneq(ext, c"json", 4)
        return c"application/json"

    # Images
    if ext_len == 3 && strneq(ext, c"png", 3)
        return c"image/png"
    if ext_len == 3 && strneq(ext, c"jpg", 3)
        return c"image/jpeg"
    if ext_len == 4 && strneq(ext, c"jpeg", 4)
        return c"image/jpeg"
    if ext_len == 3 && strneq(ext, c"gif", 3)
        return c"image/gif"
    if ext_len == 3 && strneq(ext, c"svg", 3)
        return c"image/svg+xml"
    if ext_len == 3 && strneq(ext, c"ico", 3)
        return c"image/x-icon"
    if ext_len == 4 && strneq(ext, c"webp", 4)
        return c"image/webp"

    # Fonts
    if ext_len == 4 && strneq(ext, c"woff", 4)
        return c"font/woff"
    if ext_len == 5 && strneq(ext, c"woff2", 5)
        return c"font/woff2"
    if ext_len == 3 && strneq(ext, c"ttf", 3)
        return c"font/ttf"
    if ext_len == 3 && strneq(ext, c"otf", 3)
        return c"font/otf"
    if ext_len == 3 && strneq(ext, c"eot", 3)
        return c"application/vnd.ms-fontobject"

    # Documents
    if ext_len == 3 && strneq(ext, c"pdf", 3)
        return c"application/pdf"
    if ext_len == 3 && strneq(ext, c"txt", 3)
        return c"text/plain"
    if ext_len == 3 && strneq(ext, c"xml", 3)
        return c"application/xml"

    # Media
    if ext_len == 3 && strneq(ext, c"mp3", 3)
        return c"audio/mpeg"
    if ext_len == 3 && strneq(ext, c"mp4", 3)
        return c"video/mp4"
    if ext_len == 4 && strneq(ext, c"webm", 4)
        return c"video/webm"

    # Archives
    if ext_len == 3 && strneq(ext, c"zip", 3)
        return c"application/zip"
    if ext_len == 2 && strneq(ext, c"gz", 2)
        return c"application/gzip"
    if ext_len == 3 && strneq(ext, c"tar", 3)
        return c"application/x-tar"

    # Default
    return c"application/octet-stream"


# Get MIME type from filename by finding the extension
pub fn mime_type_for_file(filename: *u8, filename_len: i32) -> *u8
    # Find last dot
    var dot_pos: i32 = -1
    for i in 0..filename_len
        if *(filename + i) == '.'
            dot_pos = i

    if dot_pos < 0 || dot_pos >= filename_len - 1
        return c"application/octet-stream"

    let ext: *u8 = filename + dot_pos + 1
    let ext_len: i32 = filename_len - dot_pos - 1

    return mime_type_for_ext(ext, ext_len)


# ============================================================================
# Path security
# ============================================================================

# Check if path contains directory traversal attempt
# Returns 1 if path is safe, 0 if it contains ".."
#
# SECURITY: This function prevents directory traversal attacks by rejecting:
# - Paths containing ".." (parent directory references)
# - Paths containing null bytes (C string termination attacks)
# Always call this before using user-supplied paths with the filesystem.
pub fn path_is_safe(path: *u8, path_len: i32) -> i32
    # Look for ".." in path
    for i in 0..(path_len - 1)
        if *(path + i) == '.' && *(path + i + 1) == '.'
            return 0

    # Check for null bytes
    for i in 0..path_len
        if *(path + i) == 0
            return 0

    return 1


# ============================================================================
# Range request parsing
# ============================================================================

# Range request result
struct RangeResult
    valid: i32       # RANGE_IGNORE, RANGE_OK or RANGE_UNSATISFIABLE
    start: i64       # Start byte (inclusive)
    end: i64         # End byte (inclusive)

pub const RANGE_IGNORE: i32 = 0          # no usable Range: serve the whole file
pub const RANGE_OK: i32 = 1              # serve start..end (206)
pub const RANGE_UNSATISFIABLE: i32 = 2   # no byte of the file is in it (416)

# A position one past i64::MAX saturates to it: past the end of any file.
const RANGE_POS_MAX: i64 = 9223372036854775807


# Parse a decimal Range position from range_hdr[*pos .. stop), advancing
# *pos to `until` or `stop`.  Returns -1 for an empty field or one with a
# non-digit (a sign included: strview_parse_i64 takes one, a Range does
# not); a value past i64::MAX is RANGE_POS_MAX (AGAST #4037).
fn range_number(range_hdr: *u8, pos: *i32, stop: i32, until: u8) -> i64
    let begin: i32 = *pos
    while *pos < stop and *(range_hdr + *pos) != until
        let c: u8 = *(range_hdr + *pos)
        if c < '0' or c > '9'
            return -1
        *pos = *pos + 1
    if *pos == begin
        return -1
    let field: StrView = strview_from_ptr(range_hdr + begin, (*pos - begin) as i64)
    # Digits only, so None here is out of range.
    match strview_parse_i64(field)
        Some(v) => v
        None => RANGE_POS_MAX


# Parse Range header value: "bytes=start-end" or "bytes=start-" or "bytes=-suffix"
# Returns valid=RANGE_OK with start <= end inside the file, RANGE_IGNORE for
# a header to ignore, or RANGE_UNSATISFIABLE when the range starts at or
# past the end of the file: "bytes=100-" on a 20-byte file used to come out
# as start 100, end 19, and a negative Content-Length (AGAST #1865).
pub fn parse_range(range_hdr: *u8, range_len: i32, file_size: i64) -> RangeResult
    var result: RangeResult
    result.valid = 0
    result.start = 0
    result.end = file_size - 1

    # Check for "bytes=" prefix (6 chars)
    if range_len < 7
        return result
    if *(range_hdr + 0) != 'b' || *(range_hdr + 1) != 'y' || *(range_hdr + 2) != 't'
        return result
    if *(range_hdr + 3) != 'e' || *(range_hdr + 4) != 's' || *(range_hdr + 5) != '='
        return result

    let spec_start: i32 = 6
    var pos: i32 = spec_start

    # Check for suffix range: bytes=-500 (last 500 bytes)
    if *(range_hdr + pos) == '-'
        pos += 1
        if pos >= range_len
            return result
        let suffix_len: i64 = range_number(range_hdr, @pos, range_len, 0)
        if suffix_len < 0
            return result  # Invalid char
        if suffix_len == 0 or file_size == 0
            result.valid = RANGE_UNSATISFIABLE
            return result
        var take: i64 = suffix_len
        if take > file_size
            take = file_size
        result.start = file_size - take
        result.end = file_size - 1
        result.valid = RANGE_OK
        return result

    # Parse start
    if pos >= range_len or *(range_hdr + pos) == '-'
        return result
    let start: i64 = range_number(range_hdr, @pos, range_len, '-')
    if start < 0
        return result  # Invalid char

    if pos >= range_len or *(range_hdr + pos) != '-'
        return result  # No hyphen found
    pos += 1  # Skip hyphen

    var end: i64 = file_size - 1
    if pos < range_len
        end = range_number(range_hdr, @pos, range_len, 0)
        if end < 0
            return result  # Invalid char
        if start > end
            return result  # Not a valid range: ignored, per RFC 9110 14.2
    # Open-ended ("bytes=start-") or not, a range has to start in the file.
    if start >= file_size
        result.valid = RANGE_UNSATISFIABLE
        return result
    if end >= file_size
        end = file_size - 1

    result.start = start
    result.end = end
    result.valid = RANGE_OK
    return result


# ============================================================================
# ETag generation and validation
# ============================================================================

# Generate ETag from file stat info (inode-size-mtime format)
# Writes ETag to buf including quotes, returns length
pub fn generate_etag(buf: *u8, buf_size: i32, statbuf: *Stat) -> i32
    var pos: i32 = 0

    # Opening quote
    *(buf + pos) = '"'
    pos += 1

    # Format: inode-size-mtime_sec
    # inode (hex)
    pos += format_hex64(buf + pos, buf_size - pos, statbuf.st_ino)

    *(buf + pos) = '-'
    pos += 1

    # size (hex)
    pos += format_hex64(buf + pos, buf_size - pos, statbuf.st_size)

    *(buf + pos) = '-'
    pos += 1

    # mtime seconds (hex)
    pos += format_hex64(buf + pos, buf_size - pos, statbuf.st_mtime)

    # Closing quote
    *(buf + pos) = '"'
    pos += 1

    return pos


# Format int64 as hex into buffer, returns chars written
pub fn format_hex64(buf: *u8, buf_size: i32, value: i64) -> i32
    # A negative writes its two's-complement bits, as ritzlib's print_hex.
    var temp: [16]u8
    let digits: i32 = fmt_u64_hex_into(@temp[0], value as u64) as i32
    if digits > buf_size
        return 0

    for i in 0..digits
        *(buf + i) = temp[i]

    return digits


# Check if If-None-Match header matches ETag
# Returns 1 if match (should return 304), 0 otherwise
pub fn etag_matches(if_none_match: *u8, if_none_match_len: i32, etag: *u8, etag_len: i32) -> i32
    # Handle "*" wildcard
    if if_none_match_len == 1 && *if_none_match == '*'
        return 1

    # Simple substring search for the ETag in the If-None-Match value
    # (If-None-Match can contain multiple ETags separated by commas)
    if if_none_match_len < etag_len
        return 0

    var pos: i32 = 0
    while pos <= if_none_match_len - etag_len
        var found: i32 = 1
        for i in 0..etag_len
            if *(if_none_match + pos + i) != *(etag + i)
                found = 0
                break
        if found != 0
            return 1
        pos += 1

    return 0


# ============================================================================
# Static file serving
# ============================================================================

# Build full filesystem path from root and URL path
# Build filesystem path from root directory and URL path
# Returns length written to buf, or -1 on error
#
# SAFETY:
# - `root` must be a valid null-terminated string
# - `url_path` must point to at least `url_path_len` valid bytes
# - `buf` must have capacity of at least `buf_len` bytes
# - Result is null-terminated if successful
# - Does NOT validate for directory traversal - caller must use path_is_safe()
pub fn static_build_path(buf: *u8, buf_len: i32, root: *u8, url_path: *u8, url_path_len: i32) -> i32
    let root_len: i64 = strlen(root)
    var pos: i32 = 0

    # Copy root
    if root_len as i32 >= buf_len
        return -1

    for i in 0..root_len
        *(buf + pos) = *(root + i)
        pos += 1

    # Ensure there's a separator
    if pos > 0 && *(buf + pos - 1) != '/'
        if pos >= buf_len
            return -1
        *(buf + pos) = '/'
        pos += 1

    # Copy URL path (skip leading /)
    var skip: i32 = 0
    if url_path_len > 0 && *url_path == '/'
        skip = 1

    for i in skip..url_path_len
        if pos >= buf_len - 1
            return -1
        *(buf + pos) = *(url_path + i)
        pos += 1

    # Null terminate
    *(buf + pos) = 0
    return pos


# Write the Connection header line for valet's keep-alive decision into
# `buf` (needs 24 bytes); returns the bytes written.  `keep_alive` is 0 when
# valet closes the connection after this response (HTTP/1.0 without
# keep-alive, "Connection: close", or the keepalive_requests-th request),
# so the header never promises reuse valet won't honour (AGAST #2117).
pub fn static_connection_header(buf: *u8, keep_alive: i32) -> i32
    if keep_alive != 0
        memcpy(buf, c"Connection: keep-alive\r\n", 24)
        return 24
    memcpy(buf, c"Connection: close\r\n", 19)
    return 19


# Serve a static file
# fd: socket to write to
# path: full filesystem path to file
# keep_alive: 0 when valet closes the connection after this response
# Returns: bytes sent on success, negative on error
pub fn static_serve_file(fd: i32, path: *u8, keep_alive: i32) -> i64
    # Open the file
    let file_fd: i32 = sys_open(path, O_RDONLY)
    if file_fd < 0
        return -1  # File not found or permission denied

    # Get file size using fstat
    var statbuf: Stat
    if sys_fstat2(file_fd, @statbuf) != 0
        sys_close(file_fd)
        return -2

    let file_size: i64 = statbuf.st_size

    # Check if it's a regular file
    if (statbuf.st_mode & S_IFMT) != S_IFREG
        sys_close(file_fd)
        return -3  # Not a regular file

    # Get MIME type
    let path_len: i64 = strlen(path)
    let mime: *u8 = mime_type_for_file(path, path_len as i32)

    # Build HTTP response headers
    var headers: [512]u8
    var pos: i32 = 0

    # Status line: "HTTP/1.1 200 OK\r\n" (17 bytes)
    let status = c"HTTP/1.1 200 OK\r\n"
    for i in 0..17
        headers[pos] = *(status + i)
        pos += 1

    # Content-Type header: "Content-Type: " (14 bytes)
    let ct = c"Content-Type: "
    for i in 0..14
        headers[pos] = *(ct + i)
        pos += 1

    let mime_len: i64 = strlen(mime)
    for i in 0..mime_len
        headers[pos] = *(mime + i)
        pos += 1

    headers[pos] = '\r'
    pos += 1
    headers[pos] = '\n'
    pos += 1

    # Content-Length header: "Content-Length: " (16 bytes)
    let cl = c"Content-Length: "
    for i in 0..16
        headers[pos] = *(cl + i)
        pos += 1

    # Format file size
    pos += fmt_i64_into(@headers[pos], file_size) as i32

    headers[pos] = '\r'
    pos += 1
    headers[pos] = '\n'
    pos += 1

    pos += static_connection_header(@headers[pos], keep_alive)

    # End of headers
    headers[pos] = '\r'
    pos += 1
    headers[pos] = '\n'
    pos += 1

    # Send headers
    let header_sent: i64 = sys_write(fd, @headers[0], pos as i64)
    if header_sent < 0
        sys_close(file_fd)
        return header_sent

    # Send file content using sendfile (zero-copy)
    var offset: i64 = 0
    var remaining: i64 = file_size
    var total_sent: i64 = 0

    while remaining > 0
        let sent: i64 = sys_sendfile(fd, file_fd, @offset, remaining)
        if sent <= 0
            if sent < 0
                log_error(c"sendfile failed")
            break
        remaining -= sent
        total_sent += sent

    sys_close(file_fd)
    return header_sent + total_sent


# Helper to format an integer into a buffer, returns digits written
# (0, writing nothing, when it needs more than buf_size bytes)
pub fn format_int64(buf: *u8, buf_size: i32, value: i64) -> i32
    var temp: [20]u8
    let digits: i32 = fmt_i64_into(@temp[0], value) as i32
    if digits > buf_size
        return 0

    for i in 0..digits
        *(buf + i) = temp[i]

    return digits


# Serve a static file with Range and ETag support
# fd: socket to write to
# path: full filesystem path to file
# range_hdr: Range header value (can be null)
# range_len: Length of range header
# if_none_match: If-None-Match header value (can be null)
# if_none_match_len: Length of If-None-Match header
# keep_alive: 0 when valet closes the connection after this response
# Returns: bytes sent on success, negative on error
pub fn static_serve_file_full(fd: i32, path: *u8, range_hdr: *u8, range_len: i32, if_none_match: *u8, if_none_match_len: i32, keep_alive: i32) -> i64
    # Open the file
    let file_fd: i32 = sys_open(path, O_RDONLY)
    if file_fd < 0
        return -1  # File not found or permission denied

    # Get file size using fstat
    var statbuf: Stat
    if sys_fstat2(file_fd, @statbuf) != 0
        sys_close(file_fd)
        return -2

    let file_size: i64 = statbuf.st_size

    # Check if it's a regular file
    if (statbuf.st_mode & S_IFMT) != S_IFREG
        sys_close(file_fd)
        return -3  # Not a regular file

    # Generate ETag from file metadata
    var etag_buf: [64]u8
    let etag_len: i32 = generate_etag(@etag_buf[0], 64, @statbuf)

    # Check If-None-Match for conditional request
    if if_none_match != null && if_none_match_len > 0
        if etag_matches(if_none_match, if_none_match_len, @etag_buf[0], etag_len) != 0
            sys_close(file_fd)
            # Return 304 Not Modified
            return static_send_304(fd, @etag_buf[0], etag_len, keep_alive)

    # Parse range if provided
    var send_start: i64 = 0
    var send_end: i64 = file_size - 1
    var partial: i32 = 0

    if range_hdr != null && range_len > 0
        let range: RangeResult = parse_range(range_hdr, range_len, file_size)
        if range.valid == RANGE_UNSATISFIABLE
            sys_close(file_fd)
            return static_send_416(fd, file_size, keep_alive)
        if range.valid == RANGE_OK
            send_start = range.start
            send_end = range.end
            partial = 1

    let content_len: i64 = send_end - send_start + 1

    # Get MIME type
    let path_len: i64 = strlen(path)
    let mime: *u8 = mime_type_for_file(path, path_len as i32)

    # Build HTTP response headers
    var headers: [1024]u8
    var pos: i32 = 0

    # Status line
    if partial != 0
        # 206 Partial Content
        let status = c"HTTP/1.1 206 Partial Content\r\n"
        for i in 0..30
            headers[pos] = *(status + i)
            pos += 1
    else
        # 200 OK
        let status = c"HTTP/1.1 200 OK\r\n"
        for i in 0..17
            headers[pos] = *(status + i)
            pos += 1

    # Content-Type header
    let ct = c"Content-Type: "
    for i in 0..14
        headers[pos] = *(ct + i)
        pos += 1

    let mime_len: i64 = strlen(mime)
    for i in 0..mime_len
        headers[pos] = *(mime + i)
        pos += 1

    headers[pos] = '\r'
    pos += 1
    headers[pos] = '\n'
    pos += 1

    # Content-Length header
    let cl = c"Content-Length: "
    for i in 0..16
        headers[pos] = *(cl + i)
        pos += 1

    pos += format_int64(@headers[0] + pos, 32, content_len)

    headers[pos] = '\r'
    pos += 1
    headers[pos] = '\n'
    pos += 1

    # ETag header
    let etag_hdr = c"ETag: "
    for i in 0..6
        headers[pos] = *(etag_hdr + i)
        pos += 1
    for i in 0..etag_len
        headers[pos] = etag_buf[i]
        pos += 1
    headers[pos] = '\r'
    pos += 1
    headers[pos] = '\n'
    pos += 1

    # Content-Range header for partial content
    if partial != 0
        # "Content-Range: bytes start-end/total\r\n"
        let cr = c"Content-Range: bytes "
        for i in 0..21
            headers[pos] = *(cr + i)
            pos += 1

        pos += format_int64(@headers[0] + pos, 32, send_start)

        headers[pos] = '-'
        pos += 1

        pos += format_int64(@headers[0] + pos, 32, send_end)

        headers[pos] = '/'
        pos += 1

        pos += format_int64(@headers[0] + pos, 32, file_size)

        headers[pos] = '\r'
        pos += 1
        headers[pos] = '\n'
        pos += 1

    # Accept-Ranges header (always)
    let ar = c"Accept-Ranges: bytes\r\n"
    for i in 0..22
        headers[pos] = *(ar + i)
        pos += 1

    pos += static_connection_header(@headers[pos], keep_alive)

    # End of headers
    headers[pos] = '\r'
    pos += 1
    headers[pos] = '\n'
    pos += 1

    # Send headers
    let header_sent: i64 = sys_write(fd, @headers[0], pos as i64)
    if header_sent < 0
        sys_close(file_fd)
        return header_sent

    # Send file content using sendfile (zero-copy)
    var offset: i64 = send_start
    var remaining: i64 = content_len
    var total_sent: i64 = 0

    while remaining > 0
        let sent: i64 = sys_sendfile(fd, file_fd, @offset, remaining)
        if sent <= 0
            if sent < 0
                log_error(c"sendfile failed")
            break
        remaining -= sent
        total_sent += sent

    sys_close(file_fd)
    return header_sent + total_sent


# Send a 304 Not Modified response with ETag
pub fn static_send_304(fd: i32, etag: *u8, etag_len: i32, keep_alive: i32) -> i64
    var resp: [256]u8
    var pos: i32 = 0

    # Status line and headers
    let hdr = c"HTTP/1.1 304 Not Modified\r\nETag: "
    for i in 0..33
        resp[pos] = *(hdr + i)
        pos += 1

    # Copy ETag
    for i in 0..etag_len
        resp[pos] = *(etag + i)
        pos += 1

    # End the ETag line, then Connection and the blank line (304 has no body)
    resp[pos] = '\r'
    resp[pos + 1] = '\n'
    pos += 2
    pos += static_connection_header(@resp[pos], keep_alive)
    resp[pos] = '\r'
    resp[pos + 1] = '\n'
    pos += 2

    return sys_write(fd, @resp[0], pos as i64)


# Backward-compatible wrapper that calls full version
pub fn static_serve_file_range(fd: i32, path: *u8, range_hdr: *u8, range_len: i32, keep_alive: i32) -> i64
    return static_serve_file_full(fd, path, range_hdr, range_len, null, 0, keep_alive)


# Send a 416 Range Not Satisfiable response
# keep_alive: 0 when valet closes the connection after this response.  The
# 416 is fully framed (Content-Length) and the request was read whole, so the
# connection stays usable: it said "close" while valet kept it open (#3899).
pub fn static_send_416(fd: i32, file_size: i64, keep_alive: i32) -> i64
    var resp: [256]u8
    var pos: i32 = 0

    # Status and headers.  StrView literals carry their length: the
    # hand-counted 104 here dropped the "/" from "bytes */<size>" (#3693).
    let hdr = "HTTP/1.1 416 Range Not Satisfiable\r\nContent-Type: text/plain\r\nContent-Length: 22\r\nContent-Range: bytes */"
    memcpy(@resp[0], hdr.ptr, hdr.len)
    pos += hdr.len as i32

    pos += format_int64(@resp[0] + pos, 32, file_size)

    resp[pos] = '\r'
    resp[pos + 1] = '\n'
    pos += 2
    pos += static_connection_header(@resp[pos], keep_alive)
    let end = "\r\nRange Not Satisfiable\n"
    memcpy(@resp[pos], end.ptr, end.len)
    pos += end.len as i32

    return sys_write(fd, @resp[0], pos as i64)


# Send a 404 Not Found response
# keep_alive: 0 when valet closes the connection after this response
pub fn static_send_404(fd: i32, keep_alive: i32) -> i64
    var resp: [128]u8
    let head = c"HTTP/1.1 404 Not Found\r\nContent-Type: text/plain\r\nContent-Length: 14\r\n"
    memcpy(@resp[0], head, 70)
    var pos: i32 = 70
    pos += static_connection_header(@resp[pos], keep_alive)
    memcpy(@resp[pos], c"\r\n404 Not Found\n", 16)
    pos += 16
    return sys_write(fd, @resp[0], pos as i64)


# Send a 403 Forbidden response
# keep_alive: 0 when valet closes the connection after this response (#3899,
# as for the 416).  StrView literals carry their own length; a hand-counted
# 110 for the old 105-byte literal sent the NUL and .rodata after it (#3693).
pub fn static_send_403(fd: i32, keep_alive: i32) -> i64
    var resp: [128]u8
    let head = "HTTP/1.1 403 Forbidden\r\nContent-Type: text/plain\r\nContent-Length: 14\r\n"
    memcpy(@resp[0], head.ptr, head.len)
    var pos: i32 = head.len as i32
    pos += static_connection_header(@resp[pos], keep_alive)
    let end = "\r\n403 Forbidden\n"
    memcpy(@resp[pos], end.ptr, end.len)
    pos += end.len as i32
    return sys_write(fd, @resp[0], pos as i64)


# ============================================================================
# Directory listing
# ============================================================================

# Check if path is a directory
pub fn static_is_directory(path: *u8) -> i32
    var statbuf: Stat
    if sys_stat2(path, @statbuf) != 0
        return 0
    return ((statbuf.st_mode & S_IFMT) == S_IFDIR) as i32


# Serve a directory listing as HTML
# fd: socket to write to
# path: full filesystem path to directory
# url_path: URL path (for display and links)
# keep_alive: 0 when valet closes the connection after this response
# Returns: bytes sent on success, negative on error
pub fn static_serve_directory(fd: i32, path: *u8, url_path: *u8, url_path_len: i32, keep_alive: i32) -> i64
    # Open directory
    var dir: DirIter = match dir_open(strview_from_cstr(path))
        Ok(it) => it
        Err(_) => return -1

    # Buffer for building HTML response (max 64KB)
    let html_buf: *u8 = malloc(65536)
    if html_buf == null
        dir.close()
        return -2
    var html_pos: i64 = 0

    # Start HTML document
    let html_start = c"<!DOCTYPE html>\n<html>\n<head>\n<meta charset=\"utf-8\">\n<title>Index of "
    let start_len: i64 = 69
    memcpy(html_buf + html_pos, html_start, start_len)
    html_pos += start_len

    # Copy URL path for title
    for i in 0..url_path_len
        *(html_buf + html_pos) = *(url_path + i)
        html_pos += 1

    let html_head = c"</title>\n<style>body{font-family:monospace;margin:20px}a{text-decoration:none}a:hover{text-decoration:underline}li{margin:5px 0}</style>\n</head>\n<body>\n<h1>Index of "
    let head_len: i64 = 165
    memcpy(html_buf + html_pos, html_head, head_len)
    html_pos += head_len

    # Copy URL path for heading
    for i in 0..url_path_len
        *(html_buf + html_pos) = *(url_path + i)
        html_pos += 1

    let list_start = c"</h1>\n<ul>\n"
    memcpy(html_buf + html_pos, list_start, 11)
    html_pos += 11

    # Add parent directory link if not at root
    if url_path_len > 1
        let parent = c"<li><a href=\"..\">..</a> (parent directory)</li>\n"
        memcpy(html_buf + html_pos, parent, 48)
        html_pos += 48

    # Read and list directory entries
    while dir.next()
        let e: DirEntry = dir.entry()
        let name: *u8 = e.name.ptr
        let d_type: u8 = e.kind
        let name_len: i64 = strlen(name)

        # Skip . and ..
        if !(name_len == 1 && *name == '.') && !(name_len == 2 && *name == '.' && *(name + 1) == '.')
            # Check buffer space (need ~200 bytes per entry max)
            if html_pos + 200 + name_len * 2 > 65000
                break

            # <li><a href="
            let li_start = c"<li><a href=\""
            memcpy(html_buf + html_pos, li_start, 13)
            html_pos += 13

            # Copy filename (URL-safe chars only for now)
            for i in 0..name_len
                *(html_buf + html_pos) = *(name + i)
                html_pos += 1

            # Add trailing slash for directories
            if d_type == DT_DIR
                *(html_buf + html_pos) = '/'
                html_pos += 1

            # ">
            *(html_buf + html_pos) = '"'
            html_pos += 1
            *(html_buf + html_pos) = '>'
            html_pos += 1

            # Copy filename again for display
            for i in 0..name_len
                *(html_buf + html_pos) = *(name + i)
                html_pos += 1

            # Add / suffix for directories in display
            if d_type == DT_DIR
                *(html_buf + html_pos) = '/'
                html_pos += 1

            # </a></li>\n
            let li_end = c"</a></li>\n"
            memcpy(html_buf + html_pos, li_end, 10)
            html_pos += 10

    dir.close()

    # End HTML document (61 bytes including trailing newline)
    let html_end = c"</ul>\n<hr>\n<p><em>Valet HTTP Server</em></p>\n</body>\n</html>\n"
    let end_len: i64 = 61
    memcpy(html_buf + html_pos, html_end, end_len)
    html_pos += end_len

    # Build HTTP response headers
    var headers: [256]u8
    var hpos: i32 = 0

    # Status line
    let status = c"HTTP/1.1 200 OK\r\n"
    for i in 0..17
        headers[hpos] = *(status + i)
        hpos += 1

    # Content-Type
    let ct = c"Content-Type: text/html; charset=utf-8\r\n"
    for i in 0..40
        headers[hpos] = *(ct + i)
        hpos += 1

    # Content-Length
    let cl = c"Content-Length: "
    for i in 0..16
        headers[hpos] = *(cl + i)
        hpos += 1

    # Format content length
    hpos += fmt_i64_into(@headers[hpos], html_pos) as i32

    # CRLF after Content-Length
    headers[hpos] = '\r'
    hpos += 1
    headers[hpos] = '\n'
    hpos += 1

    hpos += static_connection_header(@headers[hpos], keep_alive)

    # End of headers
    headers[hpos] = '\r'
    hpos += 1
    headers[hpos] = '\n'
    hpos += 1

    # Send headers
    let header_sent: i64 = sys_write(fd, @headers[0], hpos as i64)
    if header_sent < 0
        free(html_buf)
        return header_sent

    # Send body
    let body_sent: i64 = sys_write(fd, html_buf, html_pos)
    free(html_buf)

    return header_sent + body_sent
