# valet/lib/static.ritz - Static file serving
#
# Provides static file serving with:
#   - MIME type detection based on file extension
#   - sendfile() zero-copy transfer
#   - Directory traversal protection
#   - Directory listing for directories
#   - 404 for missing files
#
# Usage:
#   valet_static(@app, "/static/*", "./public")
#   # Then requests to /static/css/style.css serve ./public/css/style.css

import ritzlib.sys
import ritzlib.io
import ritzlib.fs
import ritzlib.memory
import ritzlib.fmt.digits
import ritzlib.option
import ritzlib.fd
import ritzlib.span
import ritzlib.string
import ritzlib.strview { StrView, strview_from_ptr }

import lib.log

# ============================================================================
# MIME type detection
# ============================================================================

# Get MIME type from file extension
pub fn mime_type_for_ext(ext: StrView) -> StrView
    # HTML
    if ext.eq("html") || ext.eq("htm")
        return "text/html"

    # CSS
    if ext.eq("css")
        return "text/css"

    # JavaScript
    if ext.eq("js") || ext.eq("mjs")
        return "application/javascript"

    # JSON
    if ext.eq("json")
        return "application/json"

    # Images
    if ext.eq("png")
        return "image/png"
    if ext.eq("jpg") || ext.eq("jpeg")
        return "image/jpeg"
    if ext.eq("gif")
        return "image/gif"
    if ext.eq("svg")
        return "image/svg+xml"
    if ext.eq("ico")
        return "image/x-icon"
    if ext.eq("webp")
        return "image/webp"

    # Fonts
    if ext.eq("woff")
        return "font/woff"
    if ext.eq("woff2")
        return "font/woff2"
    if ext.eq("ttf")
        return "font/ttf"
    if ext.eq("otf")
        return "font/otf"
    if ext.eq("eot")
        return "application/vnd.ms-fontobject"

    # Documents
    if ext.eq("pdf")
        return "application/pdf"
    if ext.eq("txt")
        return "text/plain"
    if ext.eq("xml")
        return "application/xml"

    # Media
    if ext.eq("mp3")
        return "audio/mpeg"
    if ext.eq("mp4")
        return "video/mp4"
    if ext.eq("webm")
        return "video/webm"

    # Archives
    if ext.eq("zip")
        return "application/zip"
    if ext.eq("gz")
        return "application/gzip"
    if ext.eq("tar")
        return "application/x-tar"

    # Default
    return "application/octet-stream"


# Get MIME type from filename by finding the extension
pub fn mime_type_for_file(filename: StrView) -> StrView
    # Find last dot (rfind is len when there is none)
    let dot_pos: i64 = filename.rfind(".")
    if dot_pos >= filename.len - 1
        return "application/octet-stream"

    return mime_type_for_ext(filename.skip(dot_pos + 1))


# ============================================================================
# Path security
# ============================================================================

# Check if path contains directory traversal attempt
# Returns 1 if path is safe, 0 if it contains ".."
#
# SECURITY: This function prevents directory traversal attacks by rejecting:
# - Paths containing ".." (parent directory references)
# - Paths containing null bytes (C string termination attacks)
# Always call this before using user-supplied paths with the filesystem.
pub fn path_is_safe(path: StrView) -> i32
    # Look for ".." in path
    if path.contains("..")
        return 0

    # Check for null bytes
    if path.find_byte(0) < path.len
        return 0

    return 1


# ============================================================================
# Range request parsing
# ============================================================================

# Range request result
struct RangeResult
    valid: i32       # RANGE_IGNORE, RANGE_OK or RANGE_UNSATISFIABLE
    start: i64       # Start byte (inclusive)
    end: i64         # End byte (inclusive)

pub const RANGE_IGNORE: i32 = 0          # no usable Range: serve the whole file
pub const RANGE_OK: i32 = 1              # serve start..end (206)
pub const RANGE_UNSATISFIABLE: i32 = 2   # no byte of the file is in it (416)

# A position one past i64::MAX saturates to it: past the end of any file.
const RANGE_POS_MAX: i64 = 9223372036854775807


# Parse a decimal Range position from range_hdr[*pos ..), advancing *pos to
# `until` or the end.  Returns -1 for an empty field or one with a non-digit
# (a sign included: `field.parse_i64()` takes one, a Range does not); a
# value past i64::MAX is RANGE_POS_MAX (AGAST #4037).
fn range_number(range_hdr: StrView, pos: *i32, until: u8) -> i64
    let begin: i32 = *pos
    while (*pos as i64) < range_hdr.len and range_hdr.get(*pos as i64) != until
        let c: u8 = range_hdr.get(*pos as i64)
        if c < '0' or c > '9'
            return -1
        *pos = *pos + 1
    if *pos == begin
        return -1
    let field: StrView = range_hdr.slice(begin as i64, *pos as i64)
    # Digits only, so None here is out of range.
    match field.parse_i64()
        Some(v) => v
        None => RANGE_POS_MAX


# Parse Range header value: "bytes=start-end" or "bytes=start-" or "bytes=-suffix"
# Returns valid=RANGE_OK with start <= end inside the file, RANGE_IGNORE for
# a header to ignore, or RANGE_UNSATISFIABLE when the range starts at or
# past the end of the file: "bytes=100-" on a 20-byte file used to come out
# as start 100, end 19, and a negative Content-Length (AGAST #1865).
pub fn parse_range(range_hdr: StrView, file_size: i64) -> RangeResult
    var result: RangeResult
    result.valid = 0
    result.start = 0
    result.end = file_size - 1

    let range_len: i32 = range_hdr.len as i32

    # Check for "bytes=" prefix, and at least one byte after it
    if range_len < 7
        return result
    if not range_hdr.starts_with("bytes=")
        return result

    var pos: i32 = 6

    # Check for suffix range: bytes=-500 (last 500 bytes)
    if range_hdr.get(pos as i64) == '-'
        pos += 1
        if pos >= range_len
            return result
        let suffix_len: i64 = range_number(range_hdr, @pos, 0)
        if suffix_len < 0
            return result  # Invalid char
        if suffix_len == 0 or file_size == 0
            result.valid = RANGE_UNSATISFIABLE
            return result
        var take: i64 = suffix_len
        if take > file_size
            take = file_size
        result.start = file_size - take
        result.end = file_size - 1
        result.valid = RANGE_OK
        return result

    # Parse start
    if pos >= range_len or range_hdr.get(pos as i64) == '-'
        return result
    let start: i64 = range_number(range_hdr, @pos, '-')
    if start < 0
        return result  # Invalid char

    if pos >= range_len or range_hdr.get(pos as i64) != '-'
        return result  # No hyphen found
    pos += 1  # Skip hyphen

    var end: i64 = file_size - 1
    if pos < range_len
        end = range_number(range_hdr, @pos, 0)
        if end < 0
            return result  # Invalid char
        if start > end
            return result  # Not a valid range: ignored, per RFC 9110 14.2
    # Open-ended ("bytes=start-") or not, a range has to start in the file.
    if start >= file_size
        result.valid = RANGE_UNSATISFIABLE
        return result
    if end >= file_size
        end = file_size - 1

    result.start = start
    result.end = end
    result.valid = RANGE_OK
    return result


# ============================================================================
# ETag generation and validation
# ============================================================================

# Generate ETag from file stat info (inode-size-mtime format)
# Writes ETag to buf including quotes, returns length
pub fn generate_etag(buf: *u8, buf_size: i32, statbuf: *Stat) -> i32
    var pos: i32 = 0

    # Opening quote
    *(buf + pos) = '"'
    pos += 1

    # Format: inode-size-mtime_sec
    # inode (hex)
    pos += format_hex64(buf + pos, buf_size - pos, statbuf.st_ino)

    *(buf + pos) = '-'
    pos += 1

    # size (hex)
    pos += format_hex64(buf + pos, buf_size - pos, statbuf.st_size)

    *(buf + pos) = '-'
    pos += 1

    # mtime seconds (hex)
    pos += format_hex64(buf + pos, buf_size - pos, statbuf.st_mtime)

    # Closing quote
    *(buf + pos) = '"'
    pos += 1

    return pos


# Format int64 as hex into buffer, returns chars written
pub fn format_hex64(buf: *u8, buf_size: i32, value: i64) -> i32
    # A negative writes its two's-complement bits, as ritzlib's print_hex.
    var temp: [16]u8
    let hex: StrView = fmt_u64_hex_into(@temp, value as u64)
    let digits: i32 = hex.len as i32
    if digits > buf_size
        return 0

    for i in 0..digits
        *(buf + i) = temp[i]

    return digits


# Check if If-None-Match header matches ETag
# Returns 1 if match (should return 304), 0 otherwise
pub fn etag_matches(if_none_match: StrView, etag: StrView) -> i32
    # Handle "*" wildcard
    if if_none_match.eq("*")
        return 1

    # Simple substring search for the ETag in the If-None-Match value
    # (If-None-Match can contain multiple ETags separated by commas)
    return if_none_match.contains(etag) as i32


# ============================================================================
# Static file serving
# ============================================================================

# Build filesystem path from root directory and URL path into `out`.
# Returns a view of the path, NUL-terminated in `out` so its .ptr can go to
# a syscall, or None when it doesn't fit.
#
# SAFETY:
# - Does NOT validate for directory traversal - caller must use path_is_safe()
pub fn static_build_path(out: Span<u8>, root: StrView, url_path: StrView) -> Option<StrView>
    # Copy root
    if root.len >= out.len
        return None
    var pos: i64 = out.copy_from(root.as_bytes())

    # Ensure there's a separator
    if pos > 0 && out[pos - 1] != '/'
        out[pos] = '/'
        pos += 1

    # Copy URL path (skip leading /), leaving room for the NUL
    var rest: StrView = url_path
    if rest.starts_with("/")
        rest = rest.skip(1)
    if pos + rest.len >= out.len
        return None
    pos += out.from(pos).copy_from(rest.as_bytes())

    # Null terminate
    out[pos] = 0
    return Some(strview_from_ptr(out.ptr, pos))


# The Connection header line for valet's keep-alive decision.  `keep_alive`
# is 0 when valet closes the connection after this response (HTTP/1.0
# without keep-alive, "Connection: close", or the keepalive_requests-th
# request), so the header never promises reuse valet won't honour (AGAST
# #2117).
pub fn static_connection_header(keep_alive: i32) -> StrView
    if keep_alive != 0
        return "Connection: keep-alive\r\n"
    return "Connection: close\r\n"


# Copy `s` into out[pos..]; returns the position after it.
fn hdr_put(out: Span<u8>, pos: i32, s: StrView) -> i32
    return pos + out.from(pos as i64).copy_from(s.as_bytes()) as i32


# One write(2) of `len` bytes at `p` to the socket `sock` (borrowed, never
# closed here): the bytes written, or -errno, as callers expect.
fn static_sock_write(sock: i32, p: *u8, len: i64) -> i64
    let s: Fd = fd_borrow(sock)
    match s.write(Span<u8> { ptr: p, len: len })
        Ok(n) => return n
        Err(e) => return -(e.code() as i64)


# Serve a static file
# fd: socket to write to
# file: full filesystem path to file (NUL-terminated: static_build_path)
# keep_alive: 0 when valet closes the connection after this response
# Returns: bytes sent on success, negative on error
pub fn static_serve_file(fd: i32, file: StrView, keep_alive: i32) -> i64
    # Open the file
    var src: Fd = match fd_open(file, O_RDONLY, 0)
        Ok(f) => f
        Err(_) => return -1  # File not found or permission denied

    # Get file size using fstat
    var statbuf: Stat = match src.stat()
        Ok(st) => st
        Err(_) =>
            src.close()
            return -2

    let file_size: i64 = statbuf.st_size

    # Check if it's a regular file
    if (statbuf.st_mode & S_IFMT) != S_IFREG
        src.close()
        return -3  # Not a regular file

    # Build HTTP response headers
    var headers: [512]u8
    let out: Span<u8> = @headers
    var pos: i32 = 0

    pos = hdr_put(out, pos, "HTTP/1.1 200 OK\r\n")
    pos = hdr_put(out, pos, "Content-Type: ")
    pos = hdr_put(out, pos, mime_type_for_file(file))
    pos = hdr_put(out, pos, "\r\nContent-Length: ")

    var size_buf: [20]u8
    pos = hdr_put(out, pos, fmt_i64_into(@size_buf, file_size))

    pos = hdr_put(out, pos, "\r\n")
    pos = hdr_put(out, pos, static_connection_header(keep_alive))

    # End of headers
    pos = hdr_put(out, pos, "\r\n")

    # Send headers
    let header_sent: i64 = static_sock_write(fd, @headers[0], pos as i64)
    if header_sent < 0
        src.close()
        return header_sent

    # Send file content using sendfile (zero-copy)
    var offset: i64 = 0
    var remaining: i64 = file_size
    var total_sent: i64 = 0

    let sock: Fd = fd_borrow(fd)
    while remaining > 0
        let sent: i64 = match src.sendfile(@sock, offset, remaining)
            Ok(n) => n
            Err(_) =>
                log_error("sendfile failed")
                break
        if sent == 0
            break
        offset += sent
        remaining -= sent
        total_sent += sent

    src.close()
    return header_sent + total_sent


# Helper to format an integer into a buffer, returns digits written
# (0, writing nothing, when it needs more than buf_size bytes)
pub fn format_int64(buf: *u8, buf_size: i32, value: i64) -> i32
    var temp: [20]u8
    let digits: i32 = fmt_i64_into(@temp, value).len as i32
    if digits > buf_size
        return 0

    for i in 0..digits
        *(buf + i) = temp[i]

    return digits


# Serve a static file with Range and ETag support
# fd: socket to write to
# file: full filesystem path to file (NUL-terminated: static_build_path)
# range_hdr: Range header value, if the request has one
# if_none_match: If-None-Match header value, if the request has one
# keep_alive: 0 when valet closes the connection after this response
# Returns: bytes sent on success, negative on error
pub fn static_serve_file_full(fd: i32, file: StrView, range_hdr: Option<StrView>, if_none_match: Option<StrView>, keep_alive: i32) -> i64
    # Open the file
    var src: Fd = match fd_open(file, O_RDONLY, 0)
        Ok(f) => f
        Err(_) => return -1  # File not found or permission denied

    # Get file size using fstat
    var statbuf: Stat = match src.stat()
        Ok(st) => st
        Err(_) =>
            src.close()
            return -2

    let file_size: i64 = statbuf.st_size

    # Check if it's a regular file
    if (statbuf.st_mode & S_IFMT) != S_IFREG
        src.close()
        return -3  # Not a regular file

    # Generate ETag from file metadata
    var etag_buf: [64]u8
    let etag: StrView = strview_from_ptr(@etag_buf[0], generate_etag(@etag_buf[0], 64, @statbuf) as i64)

    # Check If-None-Match for conditional request (absent and empty alike
    # mean unconditional)
    let inm: StrView = match if_none_match
        Some(v) => v
        None => ""
    if inm.len > 0
        if etag_matches(inm, etag) != 0
            src.close()
            # Return 304 Not Modified
            return static_send_304(fd, etag, keep_alive)

    # Parse range if provided
    var send_start: i64 = 0
    var send_end: i64 = file_size - 1
    var partial: i32 = 0

    let range_text: StrView = match range_hdr
        Some(v) => v
        None => ""
    if range_text.len > 0
        let range: RangeResult = parse_range(range_text, file_size)
        if range.valid == RANGE_UNSATISFIABLE
            src.close()
            return static_send_416(fd, file_size, keep_alive)
        if range.valid == RANGE_OK
            send_start = range.start
            send_end = range.end
            partial = 1

    let content_len: i64 = send_end - send_start + 1

    # Build HTTP response headers
    var headers: [1024]u8
    let out: Span<u8> = @headers
    var pos: i32 = 0

    # Status line
    if partial != 0
        pos = hdr_put(out, pos, "HTTP/1.1 206 Partial Content\r\n")
    else
        pos = hdr_put(out, pos, "HTTP/1.1 200 OK\r\n")

    pos = hdr_put(out, pos, "Content-Type: ")
    pos = hdr_put(out, pos, mime_type_for_file(file))
    pos = hdr_put(out, pos, "\r\nContent-Length: ")
    pos += format_int64(@headers[pos], 32, content_len)
    pos = hdr_put(out, pos, "\r\nETag: ")
    pos = hdr_put(out, pos, etag)
    pos = hdr_put(out, pos, "\r\n")

    # Content-Range header for partial content
    if partial != 0
        # "Content-Range: bytes start-end/total\r\n"
        pos = hdr_put(out, pos, "Content-Range: bytes ")
        pos += format_int64(@headers[pos], 32, send_start)
        pos = hdr_put(out, pos, "-")
        pos += format_int64(@headers[pos], 32, send_end)
        pos = hdr_put(out, pos, "/")
        pos += format_int64(@headers[pos], 32, file_size)
        pos = hdr_put(out, pos, "\r\n")

    # Accept-Ranges header (always)
    pos = hdr_put(out, pos, "Accept-Ranges: bytes\r\n")
    pos = hdr_put(out, pos, static_connection_header(keep_alive))

    # End of headers
    pos = hdr_put(out, pos, "\r\n")

    # Send headers
    let header_sent: i64 = static_sock_write(fd, @headers[0], pos as i64)
    if header_sent < 0
        src.close()
        return header_sent

    # Send file content using sendfile (zero-copy)
    var offset: i64 = send_start
    var remaining: i64 = content_len
    var total_sent: i64 = 0

    let sock: Fd = fd_borrow(fd)
    while remaining > 0
        let sent: i64 = match src.sendfile(@sock, offset, remaining)
            Ok(n) => n
            Err(_) =>
                log_error("sendfile failed")
                break
        if sent == 0
            break
        offset += sent
        remaining -= sent
        total_sent += sent

    src.close()
    return header_sent + total_sent


# Send a 304 Not Modified response with ETag
pub fn static_send_304(fd: i32, etag: StrView, keep_alive: i32) -> i64
    var resp: [256]u8
    let out: Span<u8> = @resp
    var pos: i32 = 0

    # Status line and headers, then the ETag
    pos = hdr_put(out, pos, "HTTP/1.1 304 Not Modified\r\nETag: ")
    pos = hdr_put(out, pos, etag)

    # End the ETag line, then Connection and the blank line (304 has no body)
    pos = hdr_put(out, pos, "\r\n")
    pos = hdr_put(out, pos, static_connection_header(keep_alive))
    pos = hdr_put(out, pos, "\r\n")

    return static_sock_write(fd, @resp[0], pos as i64)


# Backward-compatible wrapper that calls full version
pub fn static_serve_file_range(fd: i32, file: StrView, range_hdr: Option<StrView>, keep_alive: i32) -> i64
    return static_serve_file_full(fd, file, range_hdr, None, keep_alive)


# Send a 416 Range Not Satisfiable response
# keep_alive: 0 when valet closes the connection after this response.  The
# 416 is fully framed (Content-Length) and the request was read whole, so the
# connection stays usable: it said "close" while valet kept it open (#3899).
pub fn static_send_416(fd: i32, file_size: i64, keep_alive: i32) -> i64
    var resp: [256]u8
    let out: Span<u8> = @resp
    var pos: i32 = 0

    # Status and headers.  StrView literals carry their length: the
    # hand-counted 104 here dropped the "/" from "bytes */<size>" (#3693).
    pos = hdr_put(out, pos, "HTTP/1.1 416 Range Not Satisfiable\r\nContent-Type: text/plain\r\nContent-Length: 22\r\nContent-Range: bytes */")
    pos += format_int64(@resp[pos], 32, file_size)
    pos = hdr_put(out, pos, "\r\n")
    pos = hdr_put(out, pos, static_connection_header(keep_alive))
    pos = hdr_put(out, pos, "\r\nRange Not Satisfiable\n")

    return static_sock_write(fd, @resp[0], pos as i64)


# Send a 404 Not Found response
# keep_alive: 0 when valet closes the connection after this response
pub fn static_send_404(fd: i32, keep_alive: i32) -> i64
    var resp: [128]u8
    let out: Span<u8> = @resp
    var pos: i32 = hdr_put(out, 0, "HTTP/1.1 404 Not Found\r\nContent-Type: text/plain\r\nContent-Length: 14\r\n")
    pos = hdr_put(out, pos, static_connection_header(keep_alive))
    pos = hdr_put(out, pos, "\r\n404 Not Found\n")
    return static_sock_write(fd, @resp[0], pos as i64)


# Send a 403 Forbidden response
# keep_alive: 0 when valet closes the connection after this response (#3899,
# as for the 416).  StrView literals carry their own length; a hand-counted
# 110 for the old 105-byte literal sent the NUL and .rodata after it (#3693).
pub fn static_send_403(fd: i32, keep_alive: i32) -> i64
    var resp: [128]u8
    let out: Span<u8> = @resp
    var pos: i32 = hdr_put(out, 0, "HTTP/1.1 403 Forbidden\r\nContent-Type: text/plain\r\nContent-Length: 14\r\n")
    pos = hdr_put(out, pos, static_connection_header(keep_alive))
    pos = hdr_put(out, pos, "\r\n403 Forbidden\n")
    return static_sock_write(fd, @resp[0], pos as i64)


# ============================================================================
# Directory listing
# ============================================================================

# Check if path is a directory
pub fn static_is_directory(dir: StrView) -> i32
    match stat(dir)
        Ok(st) => return ((st.st_mode & S_IFMT) == S_IFDIR) as i32
        Err(_) => return 0


# Serve a directory listing as HTML
# fd: socket to write to
# path: full filesystem path to directory
# url_path: URL path (for display and links)
# keep_alive: 0 when valet closes the connection after this response
# Returns: bytes sent on success, negative on error
pub fn static_serve_directory(fd: i32, path: StrView, url_path: StrView, keep_alive: i32) -> i64
    # Open directory
    var dir: DirIter = match dir_open(path)
        Ok(it) => it
        Err(_) => return -1

    # The HTML response (max 64KB)
    var html: String = string_with_cap(65536)

    # Start HTML document, the URL path as title and heading
    html.push_str("<!DOCTYPE html>\n<html>\n<head>\n<meta charset=\"utf-8\">\n<title>Index of ")
    html.push_str(url_path)
    html.push_str("</title>\n<style>body{font-family:monospace;margin:20px}a{text-decoration:none}a:hover{text-decoration:underline}li{margin:5px 0}</style>\n</head>\n<body>\n<h1>Index of ")
    html.push_str(url_path)
    html.push_str("</h1>\n<ul>\n")

    # Add parent directory link if not at root
    if url_path.len > 1
        html.push_str("<li><a href=\"..\">..</a> (parent directory)</li>\n")

    # Read and list directory entries
    while dir.next()
        let e: DirEntry = dir.entry()
        let name: StrView = e.name

        # Skip . and ..
        if !name.eq(".") && !name.eq("..")
            # Check buffer space (need ~200 bytes per entry max)
            if html.len() + 200 + name.len * 2 > 65000
                break

            # <li><a href="name[/]">name[/]</a></li> (URL-safe chars only for now)
            html.push_str("<li><a href=\"")
            html.push_str(name)
            if e.kind == DT_DIR
                html.push('/')
            html.push_str("\">")
            html.push_str(name)
            if e.kind == DT_DIR
                html.push('/')
            html.push_str("</a></li>\n")

    dir.close()

    # End HTML document
    html.push_str("</ul>\n<hr>\n<p><em>Valet HTTP Server</em></p>\n</body>\n</html>\n")
    let html_pos: i64 = html.len()

    # Build HTTP response headers
    var headers: [256]u8
    let out: Span<u8> = @headers
    var hpos: i32 = 0

    hpos = hdr_put(out, hpos, "HTTP/1.1 200 OK\r\n")
    hpos = hdr_put(out, hpos, "Content-Type: text/html; charset=utf-8\r\n")
    hpos = hdr_put(out, hpos, "Content-Length: ")
    var len_buf: [20]u8
    hpos = hdr_put(out, hpos, fmt_i64_into(@len_buf, html_pos))
    hpos = hdr_put(out, hpos, "\r\n")
    hpos = hdr_put(out, hpos, static_connection_header(keep_alive))

    # End of headers
    hpos = hdr_put(out, hpos, "\r\n")

    # Send headers
    let header_sent: i64 = static_sock_write(fd, @headers[0], hpos as i64)
    if header_sent < 0
        return header_sent

    # Send body
    let body_sent: i64 = static_sock_write(fd, html.as_ptr(), html_pos)

    return header_sent + body_sent
