# lib/compress.ritz - HTTP compression support
#
# Implements Content-Encoding compression for HTTP responses using Squeeze.
# Supports gzip compression with Accept-Encoding header parsing.
#
# Usage:
#   # In middleware or handler:
#   let encoding: i32 = accept_encoding_parse(header_value)
#   if encoding & ENCODING_GZIP != 0
#       # Client accepts gzip, compress response
#
# Integration with Valet:
#   valet_use_named(@app, "compression", compression_middleware)
#
import ritzlib.sys
import ritzlib.io
import ritzlib.gvec
import ritzlib.box
import ritzlib.option
import ritzlib.span
import ritzlib.strview

import squeeze.gzip             # Squeeze gzip compression (RFC 1952)
import squeeze.deflate          # Raw deflate compression (RFC 1951)
import squeeze.gzip_stream      # Streaming gzip for large responses
import squeeze.zlib_stream      # Streaming zlib for large responses


# ============================================================================
# Constants
# ============================================================================

# Encoding flags (can be combined)
pub const ENCODING_IDENTITY: i32 = 0x01
pub const ENCODING_GZIP: i32 = 0x02
pub const ENCODING_DEFLATE: i32 = 0x04

# Minimum response size for compression (bytes)
# Responses smaller than this aren't worth compressing
pub const COMPRESS_MIN_SIZE: i64 = 256

# Maximum input size for single-shot stack compression (64KB)
pub const COMPRESS_MAX_INPUT: i64 = 65536

# Maximum input size for heap-allocated compression (1MB)
# Beyond this, streaming (chunked) compression is needed
pub const COMPRESS_MAX_HEAP_INPUT: i64 = 1048576

# Compression buffer size (worst case: slightly larger than input)
pub const COMPRESS_BUFFER_SIZE: i64 = 70000

# Chunk size for streaming compression (256KB)
# Each chunk is compressed independently and sent via chunked transfer encoding
pub const COMPRESS_CHUNK_SIZE: i64 = 262144

# Compression return values
pub const COMPRESS_OK: i64 = 0              # Success (actual return is compressed size)
pub const COMPRESS_ERR_FAILED: i64 = -1     # Compression failed
pub const COMPRESS_ERR_TOO_LARGE: i64 = -2  # Input exceeds max size
pub const COMPRESS_ERR_NO_BENEFIT: i64 = 0  # Compression didn't help (returns 0)


# ============================================================================
# Accept-Encoding Parser
# ============================================================================

# Parse Accept-Encoding header value and return supported encodings as flags.
# Handles formats like:
#   - "gzip"
#   - "gzip, deflate"
#   - "gzip;q=1.0, deflate;q=0.5"
#   - "*"
#
# Returns a bitmask of ENCODING_* flags.
pub fn accept_encoding_parse(value: StrView) -> i32
    if value.len <= 0
        return ENCODING_IDENTITY

    var result: i32 = 0
    var pos: i64 = 0

    while pos < value.len
        # Skip leading whitespace and commas
        while pos < value.len
            let c: u8 = value.get(pos)
            if c != ' ' && c != '\t' && c != ','
                break
            pos = pos + 1

        if pos >= value.len
            break

        # Find end of encoding name (space, comma, semicolon, or end)
        let start: i64 = pos
        while pos < value.len
            let c: u8 = value.get(pos)
            if c == ' ' || c == '\t' || c == ',' || c == ';'
                break
            pos = pos + 1

        let name: StrView = value.slice(start, pos)

        # Check for known encodings
        if encoding_matches(name, "gzip") != 0
            result = result | ENCODING_GZIP
        else if encoding_matches(name, "deflate") != 0
            result = result | ENCODING_DEFLATE
        else if encoding_matches(name, "identity") != 0
            result = result | ENCODING_IDENTITY
        else if encoding_matches(name, "*") != 0
            # Wildcard - accept gzip and deflate
            result = result | ENCODING_GZIP | ENCODING_DEFLATE | ENCODING_IDENTITY

        # Skip quality value if present (;q=...)
        if pos < value.len && value.get(pos) == ';'
            while pos < value.len && value.get(pos) != ','
                pos = pos + 1

    # Default to identity if nothing specified
    if result == 0
        result = ENCODING_IDENTITY

    return result


fn ascii_lower(c: u8) -> u8
    if c >= 'A' && c <= 'Z'
        return c + 32
    return c


# Case-insensitive encoding name comparison
pub fn encoding_matches(a: StrView, b: StrView) -> i32
    if a.len != b.len
        return 0

    for i in 0..a.len
        if ascii_lower(a.get(i)) != ascii_lower(b.get(i))
            return 0

    return 1


# ============================================================================
# Compressed body
# ============================================================================

# A compressed body: the first `len` bytes of `data`, in `encoding`
# (ENCODING_GZIP or ENCODING_DEFLATE).  It owns `data`: dropping it frees it.
pub struct Compressed
    data: Vec<u8>
    len: i64
    encoding: i32

impl Compressed
    # The compressed bytes.
    pub fn bytes(self: @Compressed) -> Span<u8>
        return self.data[0..self.len]


# ============================================================================
# Compression Functions
# ============================================================================

# Select the best encoding from accepted encodings.
# Currently prefers gzip over deflate over identity.
pub fn encoding_select(accepted: i32) -> i32
    if (accepted & ENCODING_GZIP) != 0
        return ENCODING_GZIP
    if (accepted & ENCODING_DEFLATE) != 0
        return ENCODING_DEFLATE
    return ENCODING_IDENTITY


# Get Content-Encoding header value for an encoding (None for identity: no
# header needed)
pub fn encoding_header_value(encoding: i32) -> Option<StrView>
    if encoding == ENCODING_GZIP
        return Some("gzip")
    if encoding == ENCODING_DEFLATE
        return Some("deflate")
    return None


# Check if a MIME type should be compressed.
# Compress text-based types, don't compress already-compressed types.
pub fn should_compress_mime(mime_type: StrView) -> i32
    # Compressible types (text, JSON, XML, JavaScript, CSS)
    if mime_type.starts_with("text/")
        return 1
    if mime_type.starts_with("application/json")
        return 1
    if mime_type.starts_with("application/javascript")
        return 1
    if mime_type.starts_with("application/xml")
        return 1
    if mime_type.starts_with("application/xhtml")
        return 1
    if mime_type.starts_with("image/svg")
        return 1

    # Don't compress binary, images (except SVG), video, audio, archives
    return 0


# Compress data using gzip into `output`.
# Returns compressed length on success, negative error code on failure.
pub fn compress_gzip(input: Span<u8>, output: Span<u8>) -> i64
    return gzip_compress(input.ptr, input.len, output.ptr, output.len)


# Compress data using deflate (RFC 1951, raw deflate without gzip/zlib wrapper).
# Returns compressed length on success, negative error code on failure.
# Level: 0=stored, 1-3=fast, 4-6=default, 7-9=best compression.
pub fn compress_deflate_level(input: Span<u8>, output: Span<u8>, level: i32) -> i64
    return deflate(input.ptr, input.len, output.ptr, output.len, level)


# Compress data using deflate with default compression level (6).
pub fn compress_deflate(input: Span<u8>, output: Span<u8>) -> i64
    return deflate(input.ptr, input.len, output.ptr, output.len, 6)


# `data` compressed in the encoding picked from `accepted_encodings` into a
# buffer `slack` bytes bigger than it, when it is a compressible `mime_type`
# of COMPRESS_MIN_SIZE..max_input bytes and the result is under
# keep_percent% of it.  None means send `data` as it is: not accepted, not
# worth it, out of memory or a compression failure alike.
fn compress_owned(data: Span<u8>, accepted_encodings: i32, mime_type: StrView, max_input: i64, slack: i64, keep_percent: i64) -> Option<Compressed>
    let selected: i32 = encoding_select(accepted_encodings)
    if selected == ENCODING_IDENTITY
        return None  # client doesn't accept any
    if should_compress_mime(mime_type) == 0
        return None  # not a compressible type
    if data.len < COMPRESS_MIN_SIZE or data.len > max_input
        return None  # too small to benefit, or too big for one shot

    var out: Vec<u8> = vec_zeroed<u8>(data.len + slack)
    if out.len() == 0
        return None  # out of memory
    var n: i64 = 0
    if selected == ENCODING_GZIP
        n = compress_gzip(data, out[0..out.len()])
    else
        n = compress_deflate(data, out[0..out.len()])
    if n < 0 or n >= (data.len * keep_percent) / 100
        return None
    return Some(Compressed { data: out, len: n, encoding: selected })


# Compress `data` (up to COMPRESS_MAX_INPUT bytes) if beneficial: gzip if
# accepted, else deflate; a compressible MIME type; at least 10% smaller.
# None: send `data` uncompressed.
pub fn compress_if_beneficial(data: Span<u8>, accepted_encodings: i32, mime_type: StrView) -> Option<Compressed>
    # Gzip adds ~18 bytes of overhead; 100 is the margin.
    return compress_owned(data, accepted_encodings, mime_type, COMPRESS_MAX_INPUT, 100, 90)


# compress_if_beneficial for large data, up to COMPRESS_MAX_HEAP_INPUT
# (1MB), worth it at 5% smaller.
pub fn compress_large(data: Span<u8>, accepted_encodings: i32, mime_type: StrView) -> Option<Compressed>
    return compress_owned(data, accepted_encodings, mime_type, COMPRESS_MAX_HEAP_INPUT, 1024, 95)


# ============================================================================
# Streaming Compression (Chunked)
# ============================================================================

# Streaming compression state for very large responses (>1MB)
# Uses squeeze's streaming gzip/zlib API for true cross-chunk compression
# with persistent LZ77 sliding window state.
#
# New API uses squeeze's GzipWriter/ZlibWriter which maintain:
# - 32KB sliding window for back-references across chunks
# - Hash chains for match finding
# - Incremental CRC32/Adler-32 checksum
#
# It owns its writer and output buffer: dropping it frees them.
pub struct StreamCompressor
    encoding: i32              # Selected encoding (GZIP, DEFLATE, or IDENTITY)
    gzip: Box<GzipWriter>      # The writer when encoding is gzip, else empty
    zlib: Box<ZlibWriter>      # The writer when encoding is deflate, else empty
    out: Vec<u8>               # Output buffer for compressed data


# A streaming compressor for the encoding picked from `accepted_encodings`,
# or None if its buffers can't be allocated.  A GzipWriter or ZlibWriter is
# ~295KB (a 32KB window plus two 32K-entry i32 hash arrays), so it is built
# on the heap in place.
pub fn stream_compressor_new(accepted_encodings: i32) -> Option<StreamCompressor>
    var sc: StreamCompressor = StreamCompressor {
        encoding: encoding_select(accepted_encodings),
        gzip: box_empty<GzipWriter>(),
        zlib: box_empty<ZlibWriter>(),
        out: vec_zeroed<u8>(COMPRESS_CHUNK_SIZE + 4096)  # a chunk + overhead
    }
    if sc.out.len() == 0
        return None

    if sc.encoding == ENCODING_GZIP
        sc.gzip = box_zeroed<GzipWriter>()
        if not sc.gzip.valid() or gzip_writer_init(sc.gzip.as_ptr(), 6) != 0
            return None
    else if sc.encoding == ENCODING_DEFLATE
        sc.zlib = box_zeroed<ZlibWriter>()
        if not sc.zlib.valid() or zlib_writer_init(sc.zlib.as_ptr(), 6) != 0
            return None
    return Some(sc)


impl StreamCompressor
    # The output buffer each call below writes its bytes to the front of.
    pub fn output(self: @StreamCompressor) -> Span<u8>
        return self.out[0..self.out.len()]

    # Write data to the streaming compressor.
    # May or may not produce output depending on internal buffering.
    # Returns bytes written to output(), or negative on error.
    pub fn write(self: @&StreamCompressor, data: Span<u8>) -> i64
        let out: Span<u8> = self.output()
        if self.encoding == ENCODING_GZIP
            return gzip_writer_write(self.gzip.as_ptr(), data.ptr, data.len, out.ptr, out.len)
        if self.encoding == ENCODING_DEFLATE
            return zlib_writer_write(self.zlib.as_ptr(), data.ptr, data.len, out.ptr, out.len)
        return self.copy_identity(data)

    # Identity "compression": copy `data` to the output buffer.  Returns its
    # length, or -1 if it doesn't fit.
    fn copy_identity(self: @StreamCompressor, data: Span<u8>) -> i64
        let out: Span<u8> = self.output()
        if data.len > out.len
            return -1
        return out.copy_from(data)

    # Flush pending data from the compressor.
    # Forces output of any buffered data (useful for chunked transfer encoding).
    # Returns bytes written to output().
    pub fn flush(self: @&StreamCompressor) -> i64
        let out: Span<u8> = self.output()
        if self.encoding == ENCODING_GZIP
            return gzip_writer_flush(self.gzip.as_ptr(), out.ptr, out.len)
        if self.encoding == ENCODING_DEFLATE
            return zlib_writer_flush(self.zlib.as_ptr(), out.ptr, out.len)
        return 0  # Identity has no buffering

    # Finish compression and write trailer (checksum, size).
    # Must be called after all data has been written.
    # Returns bytes written to output(), or negative on error.
    pub fn finish(self: @&StreamCompressor) -> i64
        let out: Span<u8> = self.output()
        if self.encoding == ENCODING_GZIP
            return gzip_writer_finish(self.gzip.as_ptr(), out.ptr, out.len)
        if self.encoding == ENCODING_DEFLATE
            return zlib_writer_finish(self.zlib.as_ptr(), out.ptr, out.len)
        return 0  # Identity has no trailer

    # Legacy API: Compress a single chunk independently (deprecated).
    # For true streaming with cross-chunk compression, use write + flush +
    # finish.  Returns bytes written to output(), or negative on error.
    pub fn compress_chunk(self: @StreamCompressor, data: Span<u8>) -> i64
        if self.encoding == ENCODING_GZIP
            return compress_gzip(data, self.output())
        if self.encoding == ENCODING_DEFLATE
            return compress_deflate(data, self.output())
        return self.copy_identity(data)


# Check if response needs streaming compression
# Returns 1 if data is too large for single-shot compression
pub fn needs_streaming_compression(data_len: i64) -> i32
    if data_len > COMPRESS_MAX_HEAP_INPUT
        return 1
    return 0


# ============================================================================
# Compression Statistics (optional, for debugging/monitoring)
# ============================================================================

struct CompressionStats
    requests_total: i64         # Total requests seen
    requests_compressed: i64    # Requests that were compressed
    bytes_original: i64         # Total original bytes
    bytes_compressed: i64       # Total compressed bytes


# Global stats (single-threaded per worker)
var g_compress_stats: CompressionStats


pub fn compression_stats_reset()
    g_compress_stats.requests_total = 0
    g_compress_stats.requests_compressed = 0
    g_compress_stats.bytes_original = 0
    g_compress_stats.bytes_compressed = 0


pub fn compression_stats_record(original: i64, compressed: i64, was_compressed: i32)
    g_compress_stats.requests_total = g_compress_stats.requests_total + 1
    g_compress_stats.bytes_original = g_compress_stats.bytes_original + original

    if was_compressed != 0
        g_compress_stats.requests_compressed = g_compress_stats.requests_compressed + 1
        g_compress_stats.bytes_compressed = g_compress_stats.bytes_compressed + compressed
    else
        g_compress_stats.bytes_compressed = g_compress_stats.bytes_compressed + original


pub fn compression_stats_get() -> *CompressionStats
    return @g_compress_stats
