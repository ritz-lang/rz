# valet/lib/log.ritz - Error logging with timestamps
#
# Provides structured logging with:
#   - Timestamps (YYYY-MM-DD HH:MM:SS format)
#   - Log levels (DEBUG, INFO, WARN, ERROR)
#   - Thread-safe output to stderr
#
# Usage:
#   log_info("Server started on port 8080")
#   log_error("Failed to bind socket")
#   log_warn("Connection timeout")

import ritzlib.sys
import ritzlib.io
import ritzlib.span
import ritzlib.strview
import ritzlib.string
import ritzlib.fmt.digits
import ritzlib.fd
import ritzlib.span
import ritzlib.time

# ============================================================================
# Log levels
# ============================================================================

const LOG_DEBUG: i32 = 0
const LOG_INFO: i32 = 1
const LOG_WARN: i32 = 2
const LOG_ERROR: i32 = 3

# Current minimum log level (can be changed at runtime)
# Default is LOG_INFO (1)
var g_log_level: i32 = 1


# ============================================================================
# Log level control
# ============================================================================

pub fn log_set_level(level: i32)
    g_log_level = level


pub fn log_get_level() -> i32
    return g_log_level


# ============================================================================
# Timestamp formatting
# ============================================================================

# Format a timestamp into a buffer
# Returns number of bytes written
pub fn format_timestamp(buf: *u8, buf_len: i32) -> i32
    let tv: Timeval = now()

    # Convert Unix timestamp to broken-down time
    # This is a simplified conversion - doesn't handle leap seconds, etc.
    let secs: i64 = tv.tv_sec

    # Seconds since midnight
    let day_secs: i64 = secs % 86400
    let hours: i64 = day_secs / 3600
    let mins: i64 = (day_secs % 3600) / 60
    let seconds: i64 = day_secs % 60

    # Days since epoch (Jan 1, 1970)
    var days: i64 = secs / 86400

    # Calculate year, month, day
    # Start from 1970 and count forward
    var year: i64 = 1970
    while days >= 365
        let leap: i64 = is_leap_year(year)
        let year_days: i64 = 365 + leap
        if days < year_days
            break
        days -= year_days
        year += 1

    # Calculate month and day
    var month: i64 = 1
    while month <= 12
        let month_days: i64 = log_days_in_month(month, year)
        if days < month_days
            break
        days -= month_days
        month += 1

    let day: i64 = days + 1

    # Format: YYYY-MM-DD HH:MM:SS
    var pos: i32 = 0

    # Year
    pos += format_int(buf + pos, year, 4)
    *(buf + pos) = '-'
    pos += 1

    # Month
    pos += format_int(buf + pos, month, 2)
    *(buf + pos) = '-'
    pos += 1

    # Day
    pos += format_int(buf + pos, day, 2)
    *(buf + pos) = ' '
    pos += 1

    # Hour
    pos += format_int(buf + pos, hours, 2)
    *(buf + pos) = ':'
    pos += 1

    # Minute
    pos += format_int(buf + pos, mins, 2)
    *(buf + pos) = ':'
    pos += 1

    # Second
    pos += format_int(buf + pos, seconds, 2)

    return pos


pub fn is_leap_year(year: i64) -> i64
    if year % 400 == 0
        return 1
    if year % 100 == 0
        return 0
    if year % 4 == 0
        return 1
    return 0


pub fn log_days_in_month(month: i64, year: i64) -> i64
    if month == 2
        return 28 + is_leap_year(year)
    if month == 4 || month == 6 || month == 9 || month == 11
        return 30
    return 31


# Format an integer zero-padded to at least `width` characters, sign
# first ("-005" for -5 at width 4, as printf's %04d). buf needs
# max(width, 20) bytes. Returns the count written.
pub fn format_int(buf: *u8, val: i64, width: i32) -> i32
    var temp: [20]u8
    let len: i32 = fmt_i64_into(@temp[0], val) as i32

    var out_pos: i32 = 0
    var src: i32 = 0
    if val < 0
        *buf = '-'
        out_pos = 1
        src = 1

    # Leading zeros up to the width
    for i in 0..(width - len)
        *(buf + out_pos) = '0'
        out_pos += 1

    # Copy digits
    while src < len
        *(buf + out_pos) = temp[src]
        out_pos += 1
        src += 1

    return out_pos


# ============================================================================
# Core logging functions
# ============================================================================

# Copy `s` into out[pos..end), as much as fits; returns the position after it.
fn log_put(out: Span<u8>, pos: i32, end: i64, s: StrView) -> i32
    return pos + out.slice(pos as i64, end).copy_from(s.as_bytes()) as i32


pub fn log_write(level: i32, level_str: StrView, msg: StrView)
    if level < g_log_level
        return

    # Format: [YYYY-MM-DD HH:MM:SS] [LEVEL] message\n
    var buf: [512]u8
    var pos: i32 = 0

    # Opening bracket
    buf[pos] = '['
    pos += 1

    # Timestamp
    pos += format_timestamp(@buf[pos], 256)

    # Close timestamp, open level
    buf[pos] = ']'
    pos += 1
    buf[pos] = ' '
    pos += 1
    buf[pos] = '['
    pos += 1

    # Level string
    pos = log_put(@buf, pos, 512, level_str)

    # Close level
    buf[pos] = ']'
    pos += 1
    buf[pos] = ' '
    pos += 1

    # Message, cut to leave room for the newline
    pos = log_put(@buf, pos, 500, msg)

    # Newline
    buf[pos] = '\n'
    pos += 1

    # Write to stderr
    fd_stderr().write_all(Span<u8> { ptr: @buf[0], len: pos as i64 })


# ============================================================================
# Convenience logging functions
# ============================================================================

pub fn log_debug(msg: StrView)
    log_write(LOG_DEBUG, "DEBUG", msg)


pub fn log_info(msg: StrView)
    log_write(LOG_INFO, "INFO", msg)


pub fn log_warn(msg: StrView)
    log_write(LOG_WARN, "WARN", msg)


pub fn log_error(msg: StrView)
    log_write(LOG_ERROR, "ERROR", msg)


# ============================================================================
# Formatted logging (with single integer argument)
# ============================================================================

# Write `msg` then `val` in decimal into `out`, NUL-terminated. The message
# is cut short if it would leave no room for the number and the NUL.
# out.len must be at least 21. Returns the length, NUL excluded.
pub fn log_format_i(out: Span<u8>, msg: StrView, val: i64) -> i32
    var num: [20]u8
    let num_len: i64 = fmt_i64_into(@num[0], val)
    let digits: Span<u8> = @num

    let room: i64 = out.len - num_len - 1
    var pos: i64 = out.to(room).copy_from(msg.as_bytes())
    pos += out.from(pos).copy_from(digits.to(num_len))
    out[pos] = 0
    return pos as i32


# `msg` followed by `val` in decimal, as one line at `level`.
fn log_write_i(level: i32, level_str: StrView, msg: StrView, val: i64)
    var line: String = string_from(msg)
    line.push_i64(val)
    log_write(level, level_str, line.as_view())


pub fn log_error_i(msg: StrView, val: i64)
    log_write_i(LOG_ERROR, "ERROR", msg, val)


pub fn log_info_i(msg: StrView, val: i64)
    log_write_i(LOG_INFO, "INFO", msg, val)
