# valet/lib/request.ritz - HTTP request parsing
#
# Zero-copy HTTP/1.1 request parser.
# Parses directly from a u8 buffer without allocations.

import ritzlib.io
import ritzlib.str


# ============================================================================
# Error codes for request_parse()
# ============================================================================

# Return values from request_parse():
#   > 0: Success, returns number of bytes consumed (including headers + CRLF)
#   REQ_ERR_INCOMPLETE: Need more data (partial request)
#   REQ_ERR_MALFORMED: Invalid HTTP request format
#   REQ_ERR_TOO_LARGE: Request exceeds max_size limit
const REQ_ERR_INCOMPLETE: i32 = -1      # Incomplete request, need more data
const REQ_ERR_MALFORMED: i32 = -2       # Malformed HTTP request
const REQ_ERR_TOO_LARGE: i32 = -3       # Request exceeds size limit


# ============================================================================
# HTTP Request
# ============================================================================

struct Request
    # Request line components (pointers into raw buffer)
    method_ptr: *u8
    method_len: i32
    path_ptr: *u8
    path_len: i32
    version_ptr: *u8
    version_len: i32

    # Headers end position (for body access)
    headers_end: i32
    content_length: i32

    # Keep-alive flag
    keep_alive: i32


# Initialize a request struct
pub fn request_init(req: *Request)
    req.method_ptr = null
    req.method_len = 0
    req.path_ptr = null
    req.path_len = 0
    req.version_ptr = null
    req.version_len = 0
    req.headers_end = 0
    req.content_length = 0
    req.keep_alive = 0


# Parse HTTP request from buffer
# Returns bytes consumed on success, REQ_ERR_* on failure.
#
# SAFETY: This function performs raw pointer arithmetic on `buf`.
# - Caller must ensure `buf` points to a valid buffer of at least `len` bytes
# - Caller must ensure `len` accurately reflects the buffer size
# - The returned Request contains pointers into `buf` - caller must keep `buf`
#   alive and unmodified while using the Request
# - All pointer accesses are bounds-checked against `len` before dereferencing
pub fn request_parse(req: *Request, buf: *u8, len: i32) -> i32
    if len < 14  # Minimum: "GET / HTTP/1.0\r\n\r\n"
        return REQ_ERR_INCOMPLETE

    var pos: i32 = 0

    # Parse method
    # SAFETY: pos is bounds-checked against len in the while condition
    req.method_ptr = buf
    while pos < len
        if *(buf + pos) == ' '
            req.method_len = pos
            pos += 1
            break
        pos += 1

    if pos >= len
        return -1

    # Parse path
    req.path_ptr = buf + pos
    let path_start: i32 = pos
    while pos < len
        if *(buf + pos) == ' '
            req.path_len = pos - path_start
            pos += 1
            break
        pos += 1

    if pos >= len
        return -1

    # Parse version
    req.version_ptr = buf + pos
    let version_start: i32 = pos
    while pos < len
        if *(buf + pos) == '\r'
            req.version_len = pos - version_start
            break
        pos += 1

    if pos >= len
        return -1

    # Skip CRLF
    if pos + 1 >= len
        return -1
    if *(buf + pos) != '\r' || *(buf + pos + 1) != '\n'
        return -2  # Malformed
    pos += 2

    # Parse headers - look for end of headers, Content-Length and Connection.
    #
    # Persistence (RFC 9112 9.3): HTTP/1.1 persists unless the client sends
    # "Connection: close"; HTTP/1.0 persists only with "Connection:
    # keep-alive".  This used to be a flat `keep_alive = 1`, so HTTP/1.0
    # clients such as ApacheBench waited forever for a close (AGAST #2106).
    req.keep_alive = request_version_is_11(req)
    var conn_close: i32 = 0
    var conn_keep: i32 = 0

    while pos < len
        # Check for end of headers (empty line)
        if *(buf + pos) == '\r'
            if pos + 1 < len && *(buf + pos + 1) == '\n'
                req.headers_end = pos + 2
                if conn_close == 1
                    req.keep_alive = 0
                else if conn_keep == 1
                    req.keep_alive = 1
                return req.headers_end

        # Connection header: scan its comma-separated tokens.
        if header_name_is(buf, pos, len, c"connection", 10) == 1
            let tok: i32 = connection_tokens(buf, pos + 11, len)
            if (tok & CONN_TOKEN_CLOSE) != 0
                conn_close = 1
            if (tok & CONN_TOKEN_KEEP_ALIVE) != 0
                conn_keep = 1

        # Check for Content-Length header (case-insensitive check for first char)
        let line_start: i32 = pos
        let c: u8 = *(buf + pos)
        if (c == 'C' or c == 'c') and pos + 15 < len
            # Check "Content-Length:"
            var is_cl: i32 = 1
            let cl_name: *u8 = c"content-length"
            for i in 0..14
                let ch: u8 = *(buf + pos + i)
                var lower: u8 = ch
                if lower >= 'A' and lower <= 'Z'
                    lower = lower + 32
                if lower != *(cl_name + i)
                    is_cl = 0
                    break

            if is_cl == 1 and *(buf + pos + 14) == ':'
                # Skip ": " and parse number
                var vpos: i32 = pos + 15
                while vpos < len and *(buf + vpos) == ' '
                    vpos += 1

                # Parse integer.  A value that would overflow i32 is
                # recorded as -1 (invalid) rather than wrapping into a
                # plausible-looking size (AGAST #2104).
                var cl_val: i32 = 0
                while vpos < len
                    let d: u8 = *(buf + vpos)
                    if d >= '0' and d <= '9'
                        if cl_val >= 0
                            if cl_val > 214748363
                                cl_val = -1
                            else
                                cl_val = cl_val * 10 + (d - '0') as i32
                        vpos += 1
                    else
                        break
                req.content_length = cl_val

        # Skip to next line
        while pos < len
            if *(buf + pos) == '\r'
                if pos + 1 < len && *(buf + pos + 1) == '\n'
                    pos += 2
                    break
            pos += 1

    return -1  # Incomplete - didn't find end of headers


# 1 when the request line's version is exactly "HTTP/1.1".
fn request_version_is_11(req: *Request) -> i32
    if req.version_len != 8
        return 0
    let v: *u8 = c"HTTP/1.1"
    for i in 0..8
        if *(req.version_ptr + i) != *(v + i)
            return 0
    return 1


fn ascii_lower(ch: u8) -> u8
    if ch >= 'A' and ch <= 'Z'
        return ch + 32
    return ch


# 1 when the header line at `pos` is `name` (lowercase, `name_len` bytes)
# followed directly by ':' — case-insensitive, so "Connection-Foo:" and
# "X-Connection:" do not match "connection".
fn header_name_is(buf: *u8, pos: i32, len: i32, name: *u8, name_len: i32) -> i32
    if pos + name_len >= len
        return 0
    for i in 0..name_len
        if ascii_lower(*(buf + pos + i)) != *(name + i)
            return 0
    if *(buf + pos + name_len) != ':'
        return 0
    return 1


const CONN_TOKEN_CLOSE: i32 = 1
const CONN_TOKEN_KEEP_ALIVE: i32 = 2


# 1 when bytes [start, end) equal `word` (lowercase) case-insensitively.
fn token_eq(buf: *u8, start: i32, end: i32, word: *u8, word_len: i32) -> i32
    if end - start != word_len
        return 0
    for i in 0..word_len
        if ascii_lower(*(buf + start + i)) != *(word + i)
            return 0
    return 1


# Scan a Connection header value starting at `pos` up to CRLF; return a
# bitmask of CONN_TOKEN_* for the "close" / "keep-alive" tokens present.
fn connection_tokens(buf: *u8, pos: i32, len: i32) -> i32
    var mask: i32 = 0
    var p: i32 = pos
    while p < len and *(buf + p) != '\r'
        # Skip separators / optional whitespace
        while p < len and (*(buf + p) == ' ' or *(buf + p) == '\t' or *(buf + p) == ',')
            p += 1
        let start: i32 = p
        while p < len and *(buf + p) != ',' and *(buf + p) != '\r' and *(buf + p) != ' ' and *(buf + p) != '\t'
            p += 1
        if token_eq(buf, start, p, c"close", 5) == 1
            mask = mask | CONN_TOKEN_CLOSE
        if token_eq(buf, start, p, c"keep-alive", 10) == 1
            mask = mask | CONN_TOKEN_KEEP_ALIVE
    return mask


# Bytes a complete request occupies: headers_end + Content-Length.
#
# Returns -1 if the header block is not complete yet (or unparseable), and
# -2 if Content-Length is invalid (overflowed / negative).  Used to keep
# receiving a request whose body did not fit the first recv (AGAST #2104).
pub fn request_total_len(buf: *u8, len: i32) -> i64
    var req: Request
    request_init(@req)
    if request_parse(@req, buf, len) < 0
        return -1
    if req.content_length < 0
        return -2
    return req.headers_end as i64 + req.content_length as i64


# Check if method matches
pub fn request_is_get(req: *Request) -> i32
    if req.method_len != 3
        return 0
    if *(req.method_ptr) != 'G'
        return 0
    if *(req.method_ptr + 1) != 'E'
        return 0
    if *(req.method_ptr + 2) != 'T'
        return 0
    return 1


# Check if path matches (simple exact match)
pub fn request_path_eq(req: *Request, path: *u8) -> i32
    let path_len: i32 = strlen(path) as i32
    if req.path_len != path_len
        return 0

    for i in 0..path_len
        if *(req.path_ptr + i) != *(path + i)
            return 0

    return 1


# ============================================================================
# Request size validation
# ============================================================================

# Check if request buffer size is within limit
# Returns 0 if OK, -3 if too large
pub fn request_check_size(len: i32, max_size: i32) -> i32
    if max_size > 0 && len > max_size
        return -3  # Request too large
    return 0


# ============================================================================
# Header search
# ============================================================================

# Header search result
struct HeaderResult
    found: i32       # 1 if header found, 0 otherwise
    value_ptr: *u8   # Pointer to header value (after ": ")
    value_len: i32   # Length of header value (excluding CRLF)


# Find a header in the raw request buffer (case-insensitive)
# buf: raw HTTP request buffer
# buf_len: buffer length
# name: header name to search for (e.g., "Range")
# name_len: length of header name
pub fn request_find_header(buf: *u8, buf_len: i32, name: *u8, name_len: i32) -> HeaderResult
    var result: HeaderResult
    result.found = 0
    result.value_ptr = null
    result.value_len = 0

    # Find end of request line (first CRLF)
    var pos: i32 = 0
    while pos < buf_len - 1
        if *(buf + pos) == '\r' && *(buf + pos + 1) == '\n'
            pos += 2
            break
        pos += 1

    # Search headers
    while pos < buf_len - 1
        # Check for end of headers
        if *(buf + pos) == '\r' && *(buf + pos + 1) == '\n'
            return result  # Not found

        # Check if this header matches (case-insensitive)
        var is_match: i32 = 1
        if pos + name_len + 1 < buf_len
            for i in 0..name_len
                let c1: u8 = *(buf + pos + i)
                let c2: u8 = *(name + i)
                # Convert to lowercase for comparison
                var l1: u8 = c1
                var l2: u8 = c2
                if l1 >= 'A' && l1 <= 'Z'
                    l1 = l1 + 32
                if l2 >= 'A' && l2 <= 'Z'
                    l2 = l2 + 32
                if l1 != l2
                    is_match = 0
                    break

            # Check for ": " after header name
            if is_match == 1 && *(buf + pos + name_len) == ':'
                # Found header - skip ": " (colon and optional space)
                let value_start: i32 = pos + name_len + 1
                var vpos: i32 = value_start
                # Skip leading whitespace
                while vpos < buf_len && *(buf + vpos) == ' '
                    vpos += 1

                # Find end of header value (CRLF)
                let actual_start: i32 = vpos
                while vpos < buf_len - 1
                    if *(buf + vpos) == '\r' && *(buf + vpos + 1) == '\n'
                        result.found = 1
                        result.value_ptr = buf + actual_start
                        result.value_len = vpos - actual_start
                        return result
                    vpos += 1

        # Skip to next line
        while pos < buf_len - 1
            if *(buf + pos) == '\r' && *(buf + pos + 1) == '\n'
                pos += 2
                break
            pos += 1

    return result
