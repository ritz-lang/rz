# valet/lib/request.ritz - HTTP request parsing
#
# Zero-copy HTTP/1.1 request parser.
# Parses directly from a u8 buffer without allocations.

import ritzlib.io
import ritzlib.option
import ritzlib.span
import ritzlib.strview
import http.h1_framing


# ============================================================================
# Error codes for request_parse()
# ============================================================================

# Return values from request_parse():
#   > 0: Success, returns number of bytes consumed (including headers + CRLF)
#   REQ_ERR_INCOMPLETE: Need more data (partial request)
#   REQ_ERR_MALFORMED: Invalid HTTP request format
#   REQ_ERR_TOO_LARGE: Request exceeds max_size limit
const REQ_ERR_INCOMPLETE: i32 = -1      # Incomplete request, need more data
const REQ_ERR_MALFORMED: i32 = -2       # Malformed HTTP request
const REQ_ERR_TOO_LARGE: i32 = -3       # Request exceeds size limit


# ============================================================================
# HTTP Request
# ============================================================================

struct Request
    # Request line components (views into the raw buffer)
    method: StrView
    path: StrView
    version: StrView

    # Headers end position (for body access)
    headers_end: i32
    # Body length: 0 from request_parse; the connection handler sets it from
    # request_frame once the body is in hand (a chunked one decoded in place
    # behind the headers), so handlers read headers_end .. + content_length.
    content_length: i64

    # Keep-alive flag
    keep_alive: i32


# Initialize a request struct
pub fn request_init(req: *Request)
    req.method = strview_empty()
    req.path = strview_empty()
    req.version = strview_empty()
    req.headers_end = 0
    req.content_length = 0
    req.keep_alive = 0


# Parse the HTTP request at the front of `buf`.
# Returns bytes consumed on success, REQ_ERR_* on failure.
#
# The returned Request's views (method, path, version) point into `buf`:
# keep `buf` alive and unmodified while using the Request.
pub fn request_parse(req: *Request, buf: Span<u8>) -> i32
    let len: i32 = buf.len as i32
    if len < 14  # Minimum: "GET / HTTP/1.0\r\n\r\n"
        return REQ_ERR_INCOMPLETE

    var pos: i32 = 0

    # Parse method
    while pos < len
        if buf[pos] == ' '
            req.method = buf.slice(0, pos).as_strview()
            pos += 1
            break
        # A line break before the space: a junk line, not the start of a
        # request, so don't let a caller wait for more of it (AGAST #2201).
        if buf[pos] == '\r' || buf[pos] == '\n'
            return REQ_ERR_MALFORMED
        pos += 1

    if pos >= len
        return -1

    # Parse path
    let path_start: i32 = pos
    while pos < len
        if buf[pos] == ' '
            req.path = buf.slice(path_start, pos).as_strview()
            pos += 1
            break
        if buf[pos] == '\r' || buf[pos] == '\n'
            return REQ_ERR_MALFORMED
        pos += 1

    if pos >= len
        return -1

    # Parse version
    let version_start: i32 = pos
    while pos < len
        if buf[pos] == '\r'
            req.version = buf.slice(version_start, pos).as_strview()
            break
        pos += 1

    if pos >= len
        return -1

    # Skip CRLF
    if pos + 1 >= len
        return -1
    if buf[pos] != '\r' || buf[pos + 1] != '\n'
        return -2  # Malformed
    pos += 2

    # Parse headers - look for the end of headers and Connection.  Where the
    # body ends is request_frame's call (AGAST #1865).
    #
    # Persistence (RFC 9112 9.3): HTTP/1.1 persists unless the client sends
    # "Connection: close"; HTTP/1.0 persists only with "Connection:
    # keep-alive".  This used to be a flat `keep_alive = 1`, so HTTP/1.0
    # clients such as ApacheBench waited forever for a close (AGAST #2106).
    req.keep_alive = req.version.eq("HTTP/1.1") as i32
    var conn_close: i32 = 0
    var conn_keep: i32 = 0

    while pos < len
        # Check for end of headers (empty line)
        if buf[pos] == '\r'
            if pos + 1 < len && buf[pos + 1] == '\n'
                req.headers_end = pos + 2
                if conn_close == 1
                    req.keep_alive = 0
                else if conn_keep == 1
                    req.keep_alive = 1
                return req.headers_end

        # Connection header: scan its comma-separated tokens.
        if header_name_is(buf, pos, "connection") == 1
            let tok: i32 = connection_tokens(buf, pos + 11)
            if (tok & CONN_TOKEN_CLOSE) != 0
                conn_close = 1
            if (tok & CONN_TOKEN_KEEP_ALIVE) != 0
                conn_keep = 1

        # Skip to next line
        while pos < len
            if buf[pos] == '\r'
                if pos + 1 < len && buf[pos + 1] == '\n'
                    pos += 2
                    break
            pos += 1

    return -1  # Incomplete - didn't find end of headers


fn ascii_lower(ch: u8) -> u8
    if ch >= 'A' and ch <= 'Z'
        return ch + 32
    return ch


# 1 when the header line at `pos` is `name` (lowercase) followed directly
# by ':' — case-insensitive, so "Connection-Foo:" and "X-Connection:" do
# not match "connection".
fn header_name_is(buf: Span<u8>, pos: i32, name: StrView) -> i32
    let name_len: i32 = name.len as i32
    if (pos + name_len) as i64 >= buf.len
        return 0
    for i in 0..name_len
        if ascii_lower(buf[pos + i]) != name.get(i as i64)
            return 0
    if buf[pos + name_len] != ':'
        return 0
    return 1


const CONN_TOKEN_CLOSE: i32 = 1
const CONN_TOKEN_KEEP_ALIVE: i32 = 2


# 1 when bytes [start, end) equal `word` (lowercase) case-insensitively.
fn token_eq(buf: Span<u8>, start: i32, end: i32, word: StrView) -> i32
    if (end - start) as i64 != word.len
        return 0
    for i in 0..(end - start)
        if ascii_lower(buf[start + i]) != word.get(i as i64)
            return 0
    return 1


# Scan a Connection header value starting at `pos` up to CRLF; return a
# bitmask of CONN_TOKEN_* for the "close" / "keep-alive" tokens present.
fn connection_tokens(buf: Span<u8>, pos: i32) -> i32
    let len: i32 = buf.len as i32
    var mask: i32 = 0
    var p: i32 = pos
    while p < len and buf[p] != '\r'
        # Skip separators / optional whitespace
        while p < len and (buf[p] == ' ' or buf[p] == '\t' or buf[p] == ',')
            p += 1
        let start: i32 = p
        while p < len and buf[p] != ',' and buf[p] != '\r' and buf[p] != ' ' and buf[p] != '\t'
            p += 1
        if token_eq(buf, start, p, "close") == 1
            mask = mask | CONN_TOKEN_CLOSE
        if token_eq(buf, start, p, "keep-alive") == 1
            mask = mask | CONN_TOKEN_KEEP_ALIVE
    return mask


# Frame the request at the front of buf[0..len): where it ends, and what its
# body is.  The request line must parse (a junk line is H1F_BAD_REQUEST at
# once, not a wait for more: AGAST #2201); the rest is http's
# lib/h1_framing.ritz, shared with projects/http (AGAST #1865).
#
# Returns the bytes the request occupies once it is all in buf, or one of
#   H1F_INCOMPLETE       read more; f.headers_end is set once the header
#                        block is whole, and f.total once a Content-Length
#                        says how long the request is
#   H1F_BAD_REQUEST      answer 400 (malformed, CL+TE, duplicate/invalid CL)
#   H1F_NOT_IMPLEMENTED  answer 501 (Transfer-Encoding other than chunked)
#   H1F_TOO_LARGE        answer 413 (body over max_body; <= 0: no limit)
# Bytes behind the request belong to the next one.
pub fn request_frame(buf: Span<u8>, max_body: i64, f: *H1Frame) -> i64
    h1_frame_init(f)
    var req: Request
    request_init(@req)
    let parsed: i32 = request_parse(@req, buf)
    if parsed == REQ_ERR_INCOMPLETE
        return H1F_INCOMPLETE
    if parsed < 0
        return H1F_BAD_REQUEST
    return h1_frame_request(buf.ptr, buf.len, max_body, f)


# Check if method matches
pub fn request_is_get(req: *Request) -> i32
    return req.method.eq("GET") as i32


# Check if path matches (simple exact match)
pub fn request_path_eq(req: *Request, path: StrView) -> i32
    return req.path.eq(path) as i32


# ============================================================================
# Request size validation
# ============================================================================

# Check if request buffer size is within limit
# Returns 0 if OK, -3 if too large
pub fn request_check_size(len: i32, max_size: i32) -> i32
    if max_size > 0 && len > max_size
        return -3  # Request too large
    return 0


# ============================================================================
# Header search
# ============================================================================

# Find a header in the raw request buffer (case-insensitive)
# buf: raw HTTP request buffer
# name: header name to search for (e.g., "Range")
# Returns the value (after ": ", without the CRLF) as a view into `buf`, or
# None when the header isn't there.
pub fn request_find_header(buf: Span<u8>, name: StrView) -> Option<StrView>
    let buf_len: i32 = buf.len as i32
    let name_len: i32 = name.len as i32

    # Find end of request line (first CRLF)
    var pos: i32 = 0
    while pos < buf_len - 1
        if buf[pos] == '\r' && buf[pos + 1] == '\n'
            pos += 2
            break
        pos += 1

    # Search headers
    while pos < buf_len - 1
        # Check for end of headers
        if buf[pos] == '\r' && buf[pos + 1] == '\n'
            return None  # Not found

        # Check if this header matches (case-insensitive)
        var is_match: i32 = 1
        if pos + name_len + 1 < buf_len
            for i in 0..name_len
                if ascii_lower(buf[pos + i]) != ascii_lower(name.get(i as i64))
                    is_match = 0
                    break

            # Check for ": " after header name
            if is_match == 1 && buf[pos + name_len] == ':'
                # Found header - skip ": " (colon and optional space)
                let value_start: i32 = pos + name_len + 1
                var vpos: i32 = value_start
                # Skip leading whitespace
                while vpos < buf_len && buf[vpos] == ' '
                    vpos += 1

                # Find end of header value (CRLF)
                let actual_start: i32 = vpos
                while vpos < buf_len - 1
                    if buf[vpos] == '\r' && buf[vpos + 1] == '\n'
                        return Some(buf.slice(actual_start, vpos).as_strview())
                    vpos += 1

        # Skip to next line
        while pos < buf_len - 1
            if buf[pos] == '\r' && buf[pos + 1] == '\n'
                pos += 2
                break
            pos += 1

    return None
