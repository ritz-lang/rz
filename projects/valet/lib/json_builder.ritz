# valet/lib/json_builder.ritz - JSON response builder
#
# Provides a simple builder pattern for constructing JSON responses.
# Avoids the need to build JSON character-by-character.
#
# Usage:
#   var jb: JsonBuilder
#   json_init(@jb, @buf)
#   json_object_start(@jb)
#   json_key_str(@jb, "name", "valet")
#   json_key_int(@jb, "version", 1)
#   json_key_bool(@jb, "active", 1)
#   json_object_end(@jb)
#   let json = json_bytes(@jb)
#   # buf now contains: {"name":"valet","version":1,"active":true}
#
# Note: This is a low-level builder. It does NOT escape strings automatically
# due to Ritz string literal limitations. Use with care for user input.

import ritzlib.io
import ritzlib.span
import ritzlib.strview
import ritzlib.fmt.digits

# ============================================================================
# JsonBuilder struct
# ============================================================================

struct JsonBuilder
    out: Span<u8>     # Output buffer
    pos: i32          # Current write position
    need_comma: i32   # Whether next value needs comma prefix
    depth: i32        # Nesting depth (for validation)


# Initialize a JSON builder with a buffer
pub fn json_init(jb: *JsonBuilder, out: Span<u8>)
    jb.out = out
    jb.pos = 0
    jb.need_comma = 0
    jb.depth = 0


# Get the current length of the JSON string
pub fn json_len(jb: *JsonBuilder) -> i32
    return jb.pos


# Get a pointer to the JSON buffer
pub fn json_ptr(jb: *JsonBuilder) -> *u8
    return jb.out.ptr


# The JSON built so far
pub fn json_bytes(jb: *JsonBuilder) -> Span<u8>
    return jb.out.to(jb.pos as i64)


# ============================================================================
# Internal helpers
# ============================================================================

# Write a single character
pub fn json_write_char(jb: *JsonBuilder, c: u8) -> i32
    if jb.pos as i64 >= jb.out.len
        return -1
    jb.out[jb.pos] = c
    jb.pos += 1
    return 0


# Write text, as far as it fits
pub fn json_write_str(jb: *JsonBuilder, s: StrView) -> i32
    for i in 0..s.len
        if json_write_char(jb, s.get(i)) < 0
            return -1
    return 0


# Write an integer as decimal. Digits come from ritzlib.fmt (AGAST #1932:
# the old hand-rolled `value = -value` loop emitted just "-" for i64's
# minimum). All or nothing: a number that doesn't fit writes no bytes.
pub fn json_write_i64(jb: *JsonBuilder, value: i64) -> i32
    var digits: [20]u8
    let len: i64 = fmt_i64_into(@digits[0], value)
    if (jb.pos as i64) + len > jb.out.len
        return -1
    let written: Span<u8> = @digits
    jb.out.from(jb.pos as i64).copy_from(written.to(len))
    jb.pos += len as i32
    return 0


# Write a comma if needed
pub fn json_maybe_comma(jb: *JsonBuilder) -> i32
    if jb.need_comma != 0
        if json_write_char(jb, ',') < 0
            return -1
    jb.need_comma = 0
    return 0


# Write a quoted string (no escaping - use with care)
pub fn json_write_quoted(jb: *JsonBuilder, s: StrView) -> i32
    if json_write_char(jb, '"') < 0
        return -1
    if json_write_str(jb, s) < 0
        return -1
    if json_write_char(jb, '"') < 0
        return -1
    return 0


# ============================================================================
# Object building
# ============================================================================

# Start a JSON object: {
pub fn json_object_start(jb: *JsonBuilder) -> i32
    if json_maybe_comma(jb) < 0
        return -1
    if json_write_char(jb, '{') < 0
        return -1
    jb.depth += 1
    jb.need_comma = 0
    return 0


# End a JSON object: }
pub fn json_object_end(jb: *JsonBuilder) -> i32
    if json_write_char(jb, '}') < 0
        return -1
    jb.depth -= 1
    jb.need_comma = 1
    return 0


# Add a string key-value pair: "key":"value"
pub fn json_key_str(jb: *JsonBuilder, key: StrView, value: StrView) -> i32
    if json_maybe_comma(jb) < 0
        return -1
    if json_write_quoted(jb, key) < 0
        return -1
    if json_write_char(jb, ':') < 0
        return -1
    if json_write_quoted(jb, value) < 0
        return -1
    jb.need_comma = 1
    return 0


# Add an integer key-value pair: "key":123
pub fn json_key_int(jb: *JsonBuilder, key: StrView, value: i64) -> i32
    if json_maybe_comma(jb) < 0
        return -1
    if json_write_quoted(jb, key) < 0
        return -1
    if json_write_char(jb, ':') < 0
        return -1
    if json_write_i64(jb, value) < 0
        return -1
    jb.need_comma = 1
    return 0


# Add a boolean key-value pair: "key":true or "key":false
pub fn json_key_bool(jb: *JsonBuilder, key: StrView, value: i32) -> i32
    if json_maybe_comma(jb) < 0
        return -1
    if json_write_quoted(jb, key) < 0
        return -1
    if json_write_char(jb, ':') < 0
        return -1
    if value != 0
        if json_write_str(jb, "true") < 0
            return -1
    else
        if json_write_str(jb, "false") < 0
            return -1
    jb.need_comma = 1
    return 0


# Add a null key-value pair: "key":null
pub fn json_key_null(jb: *JsonBuilder, key: StrView) -> i32
    if json_maybe_comma(jb) < 0
        return -1
    if json_write_quoted(jb, key) < 0
        return -1
    if json_write_char(jb, ':') < 0
        return -1
    if json_write_str(jb, "null") < 0
        return -1
    jb.need_comma = 1
    return 0


# Start a nested object: "key":{
pub fn json_key_object(jb: *JsonBuilder, key: StrView) -> i32
    if json_maybe_comma(jb) < 0
        return -1
    if json_write_quoted(jb, key) < 0
        return -1
    if json_write_char(jb, ':') < 0
        return -1
    if json_write_char(jb, '{') < 0
        return -1
    jb.depth += 1
    jb.need_comma = 0
    return 0


# Start a nested array: "key":[
pub fn json_key_array(jb: *JsonBuilder, key: StrView) -> i32
    if json_maybe_comma(jb) < 0
        return -1
    if json_write_quoted(jb, key) < 0
        return -1
    if json_write_char(jb, ':') < 0
        return -1
    if json_write_char(jb, '[') < 0
        return -1
    jb.depth += 1
    jb.need_comma = 0
    return 0


# ============================================================================
# Array building
# ============================================================================

# Start a JSON array: [
pub fn json_array_start(jb: *JsonBuilder) -> i32
    if json_maybe_comma(jb) < 0
        return -1
    if json_write_char(jb, '[') < 0
        return -1
    jb.depth += 1
    jb.need_comma = 0
    return 0


# End a JSON array: ]
pub fn json_array_end(jb: *JsonBuilder) -> i32
    if json_write_char(jb, ']') < 0
        return -1
    jb.depth -= 1
    jb.need_comma = 1
    return 0


# Add a string to an array
pub fn json_val_str(jb: *JsonBuilder, value: StrView) -> i32
    if json_maybe_comma(jb) < 0
        return -1
    if json_write_quoted(jb, value) < 0
        return -1
    jb.need_comma = 1
    return 0


# Add an integer to an array
pub fn json_val_int(jb: *JsonBuilder, value: i64) -> i32
    if json_maybe_comma(jb) < 0
        return -1
    if json_write_i64(jb, value) < 0
        return -1
    jb.need_comma = 1
    return 0


# Add a boolean to an array
pub fn json_val_bool(jb: *JsonBuilder, value: i32) -> i32
    if json_maybe_comma(jb) < 0
        return -1
    if value != 0
        if json_write_str(jb, "true") < 0
            return -1
    else
        if json_write_str(jb, "false") < 0
            return -1
    jb.need_comma = 1
    return 0


# Add null to an array
pub fn json_val_null(jb: *JsonBuilder) -> i32
    if json_maybe_comma(jb) < 0
        return -1
    if json_write_str(jb, "null") < 0
        return -1
    jb.need_comma = 1
    return 0


# ============================================================================
# Raw JSON insertion
# ============================================================================

# Insert raw JSON (for pre-built fragments)
pub fn json_raw(jb: *JsonBuilder, raw: StrView) -> i32
    if json_maybe_comma(jb) < 0
        return -1
    if json_write_str(jb, raw) < 0
        return -1
    jb.need_comma = 1
    return 0
