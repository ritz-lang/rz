# valet/lib/config.ritz - Configuration file parsing
#
# Loads and parses JSON configuration files for Valet.
# Supports runtime reloading via SIGHUP signal.
#
# Signal handling: Uses a global flag set by signal handler.
# The main event loop should periodically check config_should_reload()
# and call config_reload() when true.
#
# Config file format (valet.json):
# {
#   "server": {
#     "port": 8080,
#     "workers": 4,
#     "multishot": true,
#     "backlog": 1024,
#     "sndbuf": 0
#   },
#   "limits": {
#     "max_connections": 10000,
#     "max_request_size": 1048576,
#     "keepalive_requests": 100,
#     "idle_timeout": 60
#   },
#   "static": {
#     "prefix": "/static/",
#     "root": "./public"
#   },
#   "tls": {
#     "enabled": false,
#     "cert": "/etc/valet/cert.pem",
#     "key": "/etc/valet/key.pem"
#   }
# }

import ritzlib.cstr
import ritzlib.sys
import ritzlib.io
import ritzlib.fmt
import ritzlib.memory
import ritzlib.option
import ritzlib.result
import ritzlib.process { signal_ignore }
import ritzlib.span
import ritzlib.strview
import ritzlib.json
import ritzlib.fd
import ritzlib.gvec

# ============================================================================
# Configuration struct
# ============================================================================

struct ValetConfig
    # Server settings
    port: i32
    workers: i32
    multishot: i32           # 0 or 1
    use_send_zc: i32         # 0 or 1 - zero-copy send (kernel 6.0+)
    backlog: i32
    sndbuf: i32              # SO_SNDBUF per connection (0 = kernel default)

    # Connection limits
    max_connections: i32
    max_request_size: i32
    keepalive_requests: i32
    idle_timeout: i32        # seconds

    # Static file serving
    static_enabled: i32      # 0 or 1
    static_prefix: [256]u8   # URL prefix (e.g., "/static/")
    static_root: [256]u8     # Filesystem path

    # TLS settings (for future use)
    tls_enabled: i32         # 0 or 1
    tls_cert: [256]u8        # Certificate path
    tls_key: [256]u8         # Private key path

    # Config file path (for reload)
    config_path: [256]u8


# ============================================================================
# Default configuration
# ============================================================================

pub fn config_default(cfg: *ValetConfig)
    # Server defaults
    cfg.port = 8080
    cfg.workers = 1
    cfg.multishot = 0
    cfg.use_send_zc = 0
    cfg.backlog = 1024
    cfg.sndbuf = 0

    # Limit defaults
    cfg.max_connections = 10000
    cfg.max_request_size = 1048576   # 1MB
    cfg.keepalive_requests = 100
    cfg.idle_timeout = 60

    # Static serving disabled by default
    cfg.static_enabled = 0
    cfg.static_prefix[0] = 0
    cfg.static_root[0] = 0

    # TLS disabled by default
    cfg.tls_enabled = 0
    cfg.tls_cert[0] = 0
    cfg.tls_key[0] = 0

    # No config file path
    cfg.config_path[0] = 0


# ============================================================================
# JSON parsing helpers
# ============================================================================

# Field `key` of `obj`, None if absent.  The config_get_* / copy helpers
# below check each value's kind themselves and fall back to the default, so a
# missing field and a wrong-kind one take the same path.
fn config_field(obj: @Json, key: StrView) -> Option<@Json>
    obj.get_field(key)


# Copy a JSON string value into a fixed-size buffer, cut to fit with its
# NUL.  Returns 1, or 0 (leaving `dst` alone) if the value isn't a string.
pub fn config_copy_string(dst: Span<u8>, json_val: Option<@Json>) -> i32
    match json_val
        Some(v) =>
            let r: @Json = v
            match r.get_string()
                Some(s) =>
                    let n: i64 = dst.to(dst.len - 1).copy_from(s.as_bytes())
                    dst[n] = 0
                    1
                None => 0
        None => 0


# The text in a NUL-terminated config buffer (static_prefix, tls_cert, ...)
pub fn config_str(buf: Span<u8>) -> StrView
    var n: i64 = 0
    while n < buf.len and buf[n] != 0
        n += 1
    return strview_from_ptr(buf.ptr, n)


# Get an integer from a JSON value with a default
pub fn config_get_int(json_val: Option<@Json>, default_val: i32) -> i32
    match json_val
        Some(v) =>
            let r: @Json = v
            match r.get_number()
                Some(n) => n as i32
                None => default_val
        None => default_val


# Get a boolean from a JSON value with a default
pub fn config_get_bool(json_val: Option<@Json>, default_val: i32) -> i32
    match json_val
        Some(v) =>
            let r: @Json = v
            match r.get_bool()
                Some(b) => b as i32
                None => default_val
        None => default_val


# ============================================================================
# Configuration parsing
# ============================================================================

# The section `sec` if it is an object; None if absent or of another kind.
fn config_section(sec: Option<@Json>) -> Option<@Json>
    match sec
        Some(v) =>
            if config_is_object(v)
                Some(v)
            else
                None
        None => None


fn config_is_object(v: @Json) -> bool
    match *v
        Object(_) => true
        _ => false


# Parse server section
pub fn config_parse_server(cfg: *ValetConfig, server: Option<@Json>)
    match config_section(server)
        Some(obj) =>
            cfg.port = config_get_int(config_field(obj, "port"), cfg.port)
            cfg.workers = config_get_int(config_field(obj, "workers"), cfg.workers)
            cfg.multishot = config_get_bool(config_field(obj, "multishot"), cfg.multishot)
            cfg.use_send_zc = config_get_bool(config_field(obj, "use_send_zc"), cfg.use_send_zc)
            cfg.backlog = config_get_int(config_field(obj, "backlog"), cfg.backlog)
            cfg.sndbuf = config_get_int(config_field(obj, "sndbuf"), cfg.sndbuf)
        None => pass


# Parse limits section
pub fn config_parse_limits(cfg: *ValetConfig, limits: Option<@Json>)
    match config_section(limits)
        Some(obj) =>
            cfg.max_connections = config_get_int(config_field(obj, "max_connections"), cfg.max_connections)
            cfg.max_request_size = config_get_int(config_field(obj, "max_request_size"), cfg.max_request_size)
            cfg.keepalive_requests = config_get_int(config_field(obj, "keepalive_requests"), cfg.keepalive_requests)
            cfg.idle_timeout = config_get_int(config_field(obj, "idle_timeout"), cfg.idle_timeout)
        None => pass


# Parse static section
pub fn config_parse_static(cfg: *ValetConfig, static_sec: Option<@Json>)
    match config_section(static_sec)
        Some(obj) =>
            if config_copy_string(@cfg.static_prefix, config_field(obj, "prefix")) != 0
                if config_copy_string(@cfg.static_root, config_field(obj, "root")) != 0
                    cfg.static_enabled = 1
        None => pass


# Parse TLS section
pub fn config_parse_tls(cfg: *ValetConfig, tls: Option<@Json>)
    match config_section(tls)
        Some(obj) =>
            cfg.tls_enabled = config_get_bool(config_field(obj, "enabled"), cfg.tls_enabled)
            if cfg.tls_enabled != 0
                config_copy_string(@cfg.tls_cert, config_field(obj, "cert"))
                config_copy_string(@cfg.tls_key, config_field(obj, "key"))
        None => pass


# ============================================================================
# Main config loading
# ============================================================================

# Parse a JSON string into config
# Returns 0 on success, negative on error
pub fn config_parse_json(cfg: *ValetConfig, json: StrView) -> i32
    match json_parse(json)
        Ok(root) => config_apply_root(cfg, @root)
        Err(err) => config_parse_error(err)


fn config_parse_error(err: JsonError) -> i32
    eprint("config: JSON parse error at position {err.pos}\n")
    return -1


# Apply a parsed document to `cfg`; it frees itself on return.  Returns 0, or
# -2 if the root is not an object.
fn config_apply_root(cfg: *ValetConfig, root: @Json) -> i32
    if not config_is_object(root)
        eprints("config: root must be an object\n")
        return -2

    # Parse each section
    config_parse_server(cfg, config_field(root, "server"))
    config_parse_limits(cfg, config_field(root, "limits"))
    config_parse_static(cfg, config_field(root, "static"))
    config_parse_tls(cfg, config_field(root, "tls"))
    return 0


# Load config from a file
# Returns 0 on success, negative on error
pub fn config_load(cfg: *ValetConfig, path: *u8) -> i32
    let shown: StrView = strview_from_cstr(path)

    # Open file
    var f: Fd = fd_adopt(-1)
    match fd_open(shown, O_RDONLY, 0)
        Ok(opened) => f = opened
        Err(_) =>
            eprint("config: cannot open {shown}\n")
            return -1

    # Get file size
    var size: i64 = 0
    match f.stat()
        Ok(st) => size = st.st_size
        Err(_) =>
            f.close()
            eprint("config: cannot stat {shown}\n")
            return -2

    if size > 65536
        f.close()
        eprints("config: file too large (max 64KB)\n")
        return -3

    # Scratch buffer, freed when `text` leaves scope
    var text: Vec<u8> = vec_with_cap<u8>(size + 1)
    let buf: *u8 = text.as_ptr()
    if buf == null
        f.close()
        eprints("config: out of memory\n")
        return -4

    # Read file contents
    var read_ok: bool = true
    match f.read_exact(Span<u8> { ptr: buf, len: size })
        Ok(_) => pass
        Err(_) => read_ok = false
    f.close()

    if not read_ok
        eprints("config: read error\n")
        return -5

    # Store config path for reload
    if shown.len < 256
        let stored: Span<u8> = @cfg.config_path
        stored.copy_from(shown.as_bytes())
        stored[shown.len] = 0

    # Parse JSON
    return config_parse_json(cfg, strview_from_ptr(buf, size))


# Reload configuration from stored path
# Returns 0 on success, negative on error
pub fn config_reload(cfg: *ValetConfig) -> i32
    if cfg.config_path[0] == 0
        eprints("config: no config file path stored\n")
        return -1

    # Create temporary config to parse into
    var new_cfg: ValetConfig
    config_default(@new_cfg)

    let ret: i32 = config_load(@new_cfg, @cfg.config_path[0])
    if ret < 0
        eprints("config: reload failed, keeping current config\n")
        return ret

    # Copy new values to existing config
    # Note: Some settings (port, workers) may require restart
    cfg.port = new_cfg.port
    cfg.workers = new_cfg.workers
    cfg.multishot = new_cfg.multishot
    cfg.use_send_zc = new_cfg.use_send_zc
    cfg.backlog = new_cfg.backlog
    cfg.sndbuf = new_cfg.sndbuf
    cfg.max_connections = new_cfg.max_connections
    cfg.max_request_size = new_cfg.max_request_size
    cfg.keepalive_requests = new_cfg.keepalive_requests
    cfg.idle_timeout = new_cfg.idle_timeout
    cfg.static_enabled = new_cfg.static_enabled
    cfg.static_prefix = new_cfg.static_prefix
    cfg.static_root = new_cfg.static_root
    cfg.tls_enabled = new_cfg.tls_enabled
    cfg.tls_cert = new_cfg.tls_cert
    cfg.tls_key = new_cfg.tls_key

    prints("config: reloaded successfully\n")
    return 0


# ============================================================================
# Debug output
# ============================================================================

pub fn config_print(cfg: *ValetConfig)
    print("Configuration:\n")
    print("  Server:\n")
    print("    port: {cfg.port}\n")
    print("    workers: {cfg.workers}\n")
    if cfg.multishot != 0
        print("    multishot: true\n")
    else
        print("    multishot: false\n")
    if cfg.use_send_zc != 0
        print("    use_send_zc: true\n")
    else
        print("    use_send_zc: false\n")
    print("    backlog: {cfg.backlog}\n")
    print("    sndbuf: {cfg.sndbuf}\n")

    print("  Limits:\n")
    print("    max_connections: {cfg.max_connections}\n")
    print("    max_request_size: {cfg.max_request_size}\n")
    print("    keepalive_requests: {cfg.keepalive_requests}\n")
    print("    idle_timeout: {cfg.idle_timeout}s\n")

    if cfg.static_enabled != 0
        let prefix: StrView = config_str(@cfg.static_prefix)
        let root: StrView = config_str(@cfg.static_root)
        print("  Static:\n")
        print("    prefix: {prefix}\n")
        print("    root: {root}\n")

    if cfg.tls_enabled != 0
        let cert: StrView = config_str(@cfg.tls_cert)
        let key: StrView = config_str(@cfg.tls_key)
        print("  TLS:\n")
        print("    cert: {cert}\n")
        print("    key: {key}\n")


# ============================================================================
# Signal handling for reload
# ============================================================================

# Global reload flag (set by signal handler, cleared after reload)
# Note: Using i32 instead of bool for atomic operations
var g_reload_flag: i32 = 0

# Global shutdown flag for graceful termination
var g_shutdown_flag: i32 = 0


# Check if reload has been requested
pub fn config_should_reload() -> i32
    return g_reload_flag


# Clear the reload flag (call after successful reload)
pub fn config_clear_reload_flag()
    g_reload_flag = 0


# Request a config reload (can be called from signal handler or elsewhere)
pub fn config_request_reload()
    g_reload_flag = 1


# Check if shutdown has been requested
pub fn config_should_shutdown() -> i32
    return g_shutdown_flag


# Request graceful shutdown
pub fn config_request_shutdown()
    g_shutdown_flag = 1


# Setup signal handlers for SIGHUP (reload) and SIGTERM/SIGINT (shutdown)
# Note: This uses a simple polling approach since Ritz doesn't have
# proper signal handler support with restorer yet.
#
# For now, we'll use signalfd or a self-pipe trick in the event loop,
# or the user can send SIGUSR1 which we can catch more easily.
#
# Returns 0 on success, negative on error
pub fn config_setup_signals() -> i32
    # Ignore SIGPIPE (common for network servers)
    let ret: i32 = match signal_ignore(SIGPIPE)
        Ok(_) => 0
        Err(e) => -e.code()
    if ret < 0
        return ret

    # For SIGHUP/SIGTERM, we'd need proper signal handler setup
    # which requires assembly for the restorer trampoline.
    # For now, document that users should use:
    #   kill -USR1 <pid>  to trigger reload check
    #   kill -TERM <pid>  for graceful shutdown

    return 0
