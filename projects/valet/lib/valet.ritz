# valet/lib/valet.ritz - High-level Valet HTTP server API
#
# This module provides the main Valet server abstraction with:
#   - Router-based request handling
#   - Static file serving
#   - Clean API for building web applications
#
# Usage:
#   var app: Valet
#   valet_init(@app, 8080)
#   valet_get(@app, "/", handle_index)
#   valet_get(@app, "/users/:id", handle_user)
#   valet_static(@app, "/static/*", "./static")
#   valet_run(@app)

import ritzlib.sys
import ritzlib.io
import ritzlib.fmt
import ritzlib.str { memcpy }
import ritzlib.option
import ritzlib.span
import ritzlib.strview { StrView, strview_empty, strview_from_cstr }
import ritzlib.uring
import ritzlib.async_net
import ritzlib.async.tasks
import ritzlib.fd
import ritzlib.span
import ritzlib.process { fork, ForkResult }
import ritzlib.mapping

import request
import response
import router
import config
import log
import static
import compress
import tls
import proxy { proxy_yield_timespec, proxy_yield_timer_rejected }
import http.h1_framing
import cryptosec.tls13_record


# ============================================================================
# Error codes
# ============================================================================

# General error codes (used across multiple functions)
const ERR_OK: i32 = 0                   # Success
const ERR_BUFFER_OVERFLOW: i32 = -1     # Buffer too small
const ERR_INVALID_INPUT: i32 = -2       # Invalid input parameters
const ERR_IO_FAILED: i32 = -3           # I/O operation failed
const ERR_ALLOC_FAILED: i32 = -4        # Memory allocation failed

# TLS error codes (valet_tls, valet_tls_files)
const ERR_TLS_CERT_LOAD: i32 = -1       # Failed to load certificate
const ERR_TLS_KEY_LOAD: i32 = -2        # Failed to load private key
const ERR_TLS_CERT_OPEN: i32 = -1       # Failed to open cert file
const ERR_TLS_CERT_READ: i32 = -2       # Failed to read cert file
const ERR_TLS_KEY_OPEN: i32 = -3        # Failed to open key file
const ERR_TLS_KEY_READ: i32 = -4        # Failed to read key file

# Compression error codes
const ERR_COMPRESS_FAILED: i32 = -1     # Compression failed
const ERR_STREAM_ALLOC: i32 = -2        # Stream buffer allocation failed


# ============================================================================
# Valet application state
# ============================================================================

struct Valet
    router: Router                  # Route definitions
    port: i32                       # Listen port
    workers: i32                    # Worker processes (0 = single)
    backlog: i32                    # Listen backlog
    sndbuf: i32                     # SO_SNDBUF per connection (0 = kernel default)
    multishot: i32                  # Use multishot accept
    static_root: Option<StrView>    # Static file root directory, if serving
    static_prefix: StrView          # Static URL prefix (e.g., "/static/"),
                                    # empty when not serving static files
    idle_timeout: i32               # Connection idle timeout (seconds, 0 = disabled)
    keepalive_requests: i32         # Max requests per keep-alive connection
    max_request_size: i32           # Max request size in bytes (0 = unlimited)
    max_connections: i32            # Max concurrent connections (0 = unlimited)
    use_send_zc: i32                # Use zero-copy send (requires kernel 6.0+)
    # TLS configuration
    tls_enabled: i32                # TLS mode (0 = HTTP, 1 = HTTPS)
    tls_config: TlsServerConfig     # TLS server configuration
    tls_cert_der: [8192]u8          # DER-encoded certificate buffer
    tls_cert_der_len: i64           # Length of certificate data


# Global app pointer for handler access (single-threaded per process)
# This is set before running the event loop
# Note: Use i64 and cast, since Ritz doesn't support null-initialized pointer globals
var g_app_ptr: i64 = 0

# Global context for current request (set before calling handler)
var g_ctx_ptr: i64 = 0

# Helper to get/set global pointers
pub fn get_g_app() -> *Valet
    return g_app_ptr as *Valet

pub fn set_g_app(app: *Valet)
    g_app_ptr = app as i64

pub fn get_g_ctx() -> *HandlerContext
    return g_ctx_ptr as *HandlerContext

pub fn set_g_ctx(ctx: *HandlerContext)
    g_ctx_ptr = ctx as i64


# Handler context - what route handlers receive
struct HandlerContext
    req: *Request                   # Parsed request
    res: *Response                  # Response builder
    route_result: *RouteMatch       # Route match with params
    path: StrView                   # Request path
    raw_buf: *u8                    # Raw request buffer (for header access)
    raw_len: i32                    # Length of raw request data
    task: *Task                     # Owning task (cooperative-yield proxy uses this
                                    # to arm yield SQEs and key the side-table)


# ============================================================================
# Initialization
# ============================================================================

pub fn valet_init(app: *Valet, port: i32)
    router_init(@app.router)
    app.port = port
    app.workers = 0
    app.backlog = 1024
    app.sndbuf = 0
    app.multishot = 0
    app.static_root = None
    app.static_prefix = strview_empty()
    app.idle_timeout = 0
    app.keepalive_requests = 100  # Default
    app.max_request_size = 0      # Unlimited by default
    app.max_connections = 0       # Unlimited by default
    app.use_send_zc = 0           # Disabled by default (needs kernel 6.0+)
    app.tls_enabled = 0           # HTTP by default
    tls_server_config_init(@app.tls_config)


pub fn valet_idle_timeout(app: *Valet, seconds: i32)
    app.idle_timeout = seconds


pub fn valet_max_request_size(app: *Valet, size: i32)
    app.max_request_size = size


pub fn valet_max_connections(app: *Valet, max_conns: i32)
    app.max_connections = max_conns


# Enable zero-copy send (requires kernel 6.0+)
# When enabled, uses IORING_OP_SEND_ZC to avoid kernel copy on response sends
pub fn valet_use_send_zc(app: *Valet, enabled: i32)
    app.use_send_zc = enabled


pub fn valet_workers(app: *Valet, n: i32)
    app.workers = n


# ============================================================================
# TLS Configuration
# ============================================================================

# Enable TLS and load certificate and key from PEM file contents
# Returns 0 on success, negative error code on failure
pub fn valet_tls(app: *Valet, cert_pem: *u8, cert_pem_len: i64, key_pem: *u8, key_pem_len: i64) -> i32
    # Load certificate
    let cert_ret: i32 = tls_server_config_load_cert(@app.tls_config, cert_pem, cert_pem_len, @app.tls_cert_der[0], 8192)
    if cert_ret < 0
        prints("Error: Failed to load TLS certificate\n")
        return -1

    # Try loading private key - first try ECDSA P-256, then Ed25519
    var key_ret: i32 = tls_server_config_load_ecdsa_p256_key(@app.tls_config, key_pem, key_pem_len)
    if key_ret == 0
        prints("Loaded ECDSA P-256 private key\n")
    else
        # Fall back to Ed25519
        key_ret = tls_server_config_load_ed25519_key(@app.tls_config, key_pem, key_pem_len)
        if key_ret == 0
            prints("Loaded Ed25519 private key\n")
        else
            prints("Error: Failed to load TLS private key (tried ECDSA P-256 and Ed25519)\n")
            return -2

    app.tls_enabled = 1
    return 0


# Load TLS certificate and key from file paths
# Returns 0 on success, negative error code on failure
pub fn valet_tls_files(app: *Valet, cert_path: *u8, key_path: *u8) -> i32
    # Read certificate file
    var cert_buf: [8192]u8
    var cert_file: Fd = match fd_open(strview_from_cstr(cert_path), O_RDONLY, 0)
        Ok(f) => f
        Err(_) =>
            let cert_shown: StrView = strview_from_cstr(cert_path)
            print("Error: Failed to open certificate file: {cert_shown}\n")
            return -1

    var cert_len: i64 = -1
    match cert_file.read(Span<u8> { ptr: @cert_buf[0], len: 8192 })
        Ok(n) => cert_len = n
        Err(_) => pass
    cert_file.close()
    if cert_len <= 0
        prints("Error: Failed to read certificate file\n")
        return -2

    # Read key file
    var key_buf: [4096]u8
    var key_file: Fd = match fd_open(strview_from_cstr(key_path), O_RDONLY, 0)
        Ok(f) => f
        Err(_) =>
            let key_shown: StrView = strview_from_cstr(key_path)
            print("Error: Failed to open key file: {key_shown}\n")
            return -3

    var key_len: i64 = -1
    match key_file.read(Span<u8> { ptr: @key_buf[0], len: 4096 })
        Ok(n) => key_len = n
        Err(_) => pass
    key_file.close()
    if key_len <= 0
        prints("Error: Failed to read key file\n")
        return -4

    return valet_tls(app, @cert_buf[0], cert_len, @key_buf[0], key_len)


pub fn valet_multishot(app: *Valet, enabled: i32)
    app.multishot = enabled


pub fn valet_backlog(app: *Valet, backlog: i32)
    app.backlog = backlog


# Send buffer size for every connection, in bytes (0 = the kernel default).
# Set on the listening socket, which accepted sockets inherit it from. A
# small one makes large responses go out in short sends (#2197's test).
pub fn valet_sndbuf(app: *Valet, bytes: i32)
    app.sndbuf = bytes


pub fn valet_keepalive_requests(app: *Valet, max_requests: i32)
    app.keepalive_requests = max_requests


# ============================================================================
# Route registration
# ============================================================================

# Internal wrapper to adapt RouteHandler to router's fn(*u8, i32) -> i32
# The actual handler lookup happens in the connection handler

pub fn valet_add_route(app: *Valet, method: StrView, pattern: StrView, handler: fn(*u8, i32) -> i32) -> i32
    return router_add(@app.router, Some(method), pattern, handler)


# Convenience methods for common HTTP methods
pub fn valet_get(app: *Valet, pattern: StrView, handler: fn(*u8, i32) -> i32) -> i32
    return router_add(@app.router, Some("GET"), pattern, handler)


pub fn valet_post(app: *Valet, pattern: StrView, handler: fn(*u8, i32) -> i32) -> i32
    return router_add(@app.router, Some("POST"), pattern, handler)


pub fn valet_put(app: *Valet, pattern: StrView, handler: fn(*u8, i32) -> i32) -> i32
    return router_add(@app.router, Some("PUT"), pattern, handler)


pub fn valet_delete(app: *Valet, pattern: StrView, handler: fn(*u8, i32) -> i32) -> i32
    return router_add(@app.router, Some("DELETE"), pattern, handler)


pub fn valet_any(app: *Valet, pattern: StrView, handler: fn(*u8, i32) -> i32) -> i32
    return router_add(@app.router, None, pattern, handler)


# Add middleware to the request pipeline
# Middleware runs before route handlers on every request
# Returns 0 on success, -1 if middleware array is full
pub fn valet_use(app: *Valet, handler: fn(*u8, i32) -> i32) -> i32
    return router_use(@app.router, handler)


# Add named middleware (for debugging)
pub fn valet_use_named(app: *Valet, name: StrView, handler: fn(*u8, i32) -> i32) -> i32
    return router_use_named(@app.router, name, handler)


# Add a before-handler interceptor to the most recently added route.
# Before interceptors run after global middleware but before the route handler.
# Useful for route-specific authentication, validation, etc.
# Example:
#   valet_get(@app, "/admin/*", handle_admin)
#   valet_before(@app, require_admin)  # Only runs for /admin/* routes
pub fn valet_before(app: *Valet, handler: fn(*u8, i32) -> i32) -> i32
    return router_route_before(@app.router, handler)


# Add an after-handler interceptor to the most recently added route.
# After interceptors run after the route handler completes.
# Useful for response transformation, cleanup, metrics, etc.
# Example:
#   valet_get(@app, "/api/*", handle_api)
#   valet_after(@app, add_cors_headers)  # Add CORS headers to API responses
pub fn valet_after(app: *Valet, handler: fn(*u8, i32) -> i32) -> i32
    return router_route_after(@app.router, handler)


# Configure static file serving.  Both views must outlive the app.
pub fn valet_static(app: *Valet, prefix: StrView, root: StrView)
    app.static_root = Some(root)

    # Remove trailing * from prefix for matching
    if prefix.ends_with("*")
        app.static_prefix = prefix.take(prefix.len - 1)
    else
        app.static_prefix = prefix


# ============================================================================
# Handler helpers - use these in route handlers
# ============================================================================

# Get current handler context (call from within a route handler)
pub fn ctx() -> *HandlerContext
    return get_g_ctx()


# Get the Task pointer for the current handler.  Only valid from inside
# a route handler.  Used by the cooperative-yield proxy to arm yield
# SQEs and key its per-task side-table (ProxyState).
pub fn ctx_task() -> *Task
    let c: *HandlerContext = get_g_ctx()
    if c == null
        return null
    return c.task


# Captured route parameter `idx` (a view into the request path), or None
# outside a handler or when there is no such parameter
pub fn ctx_param(idx: i32) -> Option<StrView>
    let c: *HandlerContext = get_g_ctx()
    if c == null or c.route_result == null
        return None
    return route_match_param(c.route_result, idx)


# The request body (for POST/PUT requests) as it sits in the raw request
# buffer: empty outside a handler or when there is none
pub fn ctx_body_bytes() -> Span<u8>
    let c: *HandlerContext = get_g_ctx()
    if c == null
        return span_empty<u8>()

    # Body starts after headers_end in the raw buffer (a chunked body was
    # decoded there, AGAST #1865).
    let body_start: i64 = c.req.headers_end as i64
    var body_len: i64 = c.req.content_length

    if body_start < 0 or body_len <= 0
        return span_empty<u8>()

    # Don't read past end of raw buffer
    if body_start + body_len > c.raw_len as i64
        body_len = c.raw_len as i64 - body_start
        if body_len < 0
            return span_empty<u8>()

    # Explicit <u8>: ritz1 can't infer T from a pointer-arithmetic argument.
    return span_from_ptr<u8>(c.raw_buf + body_start, body_len)


# Get request body (for POST/PUT requests)
# Copies as much of the body as fits into `out`
# Returns number of bytes copied, or -1 on error
pub fn ctx_body(out: Span<u8>) -> i32
    if get_g_ctx() == null
        return -1
    return out.copy_from(ctx_body_bytes()) as i32


# 1 when the connection should stay open after answering `req`, the
# `request_count`-th request on it: the client asked to persist (see
# request_parse) and the per-connection cap isn't reached (AGAST #2106).
pub fn valet_keep_alive(req: *Request, request_count: i32, max_requests: i32) -> i32
    if req.keep_alive == 0
        return 0
    if request_count >= max_requests
        return 0
    return 1


# 1 if valet closes `task`'s connection after the response it is sending
# now: the client asked to close, or it has had keepalive_requests responses.
# A proxied response's Connection header must say so (lib/proxy.ritz).
pub fn valet_task_closing(task: *Task) -> i32
    let app: *Valet = get_g_app()
    if task == null or app == null
        return 1
    if task.request_count >= app.keepalive_requests
        return 1
    return 0


# Connection header value for the response being built in `c`: "close"
# when valet will close after it, so the header never promises reuse the
# server won't honour.
fn ctx_connection_value(c: *HandlerContext) -> StrView
    if c.req != null and c.req.keep_alive == 0
        return "close"
    let app: *Valet = get_g_app()
    if c.task != null and app != null
        if c.task.request_count >= app.keepalive_requests
            return "close"
    return "keep-alive"


# A whole response: status, Content-Type, Content-Length, Connection, body.
fn ctx_send(c: *HandlerContext, status: i32, content_type: StrView, body: Span<u8>) -> i32
    response_status(c.res, status)
    response_header(c.res, "Content-Type", content_type)
    response_content_length(c.res, body.len)
    response_header(c.res, "Connection", ctx_connection_value(c))
    response_end_headers(c.res)
    response_body(c.res, body)
    return 0


# Send a plain text response
pub fn ctx_text(status: i32, body: StrView) -> i32
    let c: *HandlerContext = get_g_ctx()
    if c == null
        return -1
    return ctx_send(c, status, "text/plain", body.as_bytes())


# Send a JSON response
pub fn ctx_json(status: i32, json: Span<u8>) -> i32
    let c: *HandlerContext = get_g_ctx()
    if c == null
        return -1
    return ctx_send(c, status, "application/json", json)


# Send a 200 OK with text body
pub fn ctx_ok(body: StrView) -> i32
    return ctx_text(200, body)


# Send a 404 Not Found
pub fn ctx_not_found() -> i32
    return ctx_text(404, "404 Not Found\n")


# Send an HTML response
pub fn ctx_html(status: i32, body: StrView) -> i32
    let c: *HandlerContext = get_g_ctx()
    if c == null
        return -1
    return ctx_send(c, status, "text/html; charset=utf-8", body.as_bytes())


# Send a redirect response (302 Found)
pub fn ctx_redirect(location: StrView) -> i32
    let c: *HandlerContext = get_g_ctx()
    if c == null
        return -1
    response_status(c.res, 302)
    response_header(c.res, "Location", location)
    response_content_length(c.res, 0)
    response_header(c.res, "Connection", ctx_connection_value(c))
    response_end_headers(c.res)
    return 0


# Get a request header by name
# Searches case-insensitively. The value is a view into the raw request
# buffer (zero-copy); None if the request has no such header.
pub fn ctx_get_header(name: StrView) -> Option<StrView>
    let c: *HandlerContext = get_g_ctx()
    if c == null
        return None
    return request_find_header(c.raw_buf, c.raw_len, name)


# Get Accept-Encoding header and return encoding flags
# Returns bitmask of ENCODING_GZIP, ENCODING_DEFLATE, ENCODING_IDENTITY
pub fn ctx_accept_encoding() -> i32
    match ctx_get_header("Accept-Encoding")
        Some(value) => accept_encoding_parse(value)
        None => ENCODING_IDENTITY


# The Content-Encoding header of a compressed response (none for identity)
fn ctx_encoding_header(c: *HandlerContext, encoding: i32)
    match encoding_header_value(encoding)
        Some(value) => response_header(c.res, "Content-Encoding", value)
        None => pass


# ============================================================================
# Compression-aware response helpers
# ============================================================================

# Send `body` with automatic gzip or deflate compression if the client
# accepts it.  For small responses (<256 bytes), no compression is used.
# For larger responses, gzip or deflate compression is applied if beneficial.
fn ctx_send_compressed(status: i32, content_type: StrView, body: Span<u8>) -> i32
    let c: *HandlerContext = get_g_ctx()
    if c == null
        return -1

    let body_len: i64 = body.len

    # Check if we should try compression (gzip or deflate)
    let accepted: i32 = ctx_accept_encoding()
    let selected: i32 = encoding_select(accepted)
    if selected != ENCODING_IDENTITY && body_len >= COMPRESS_MIN_SIZE && body_len <= COMPRESS_MAX_INPUT
        var compress_buf: [70000]u8
        let compressed: Span<u8> = @compress_buf
        var compressed_len: i64 = 0

        if selected == ENCODING_GZIP
            compressed_len = compress_gzip(body, compressed)
        else if selected == ENCODING_DEFLATE
            compressed_len = compress_deflate(body, compressed)

        if compressed_len > 0 && compressed_len < body_len
            # Compression was beneficial
            response_status(c.res, status)
            response_header(c.res, "Content-Type", content_type)
            ctx_encoding_header(c, selected)
            response_content_length(c.res, compressed_len)
            response_header(c.res, "Connection", ctx_connection_value(c))
            response_header(c.res, "Vary", "Accept-Encoding")
            response_end_headers(c.res)
            response_body(c.res, compressed.to(compressed_len))
            return 0

    # Fall back to uncompressed
    return ctx_send(c, status, content_type, body)


# Send a text response with automatic gzip compression if client accepts it.
pub fn ctx_text_compressed(status: i32, body: StrView) -> i32
    return ctx_send_compressed(status, "text/plain", body.as_bytes())


# Send a JSON response with automatic gzip or deflate compression if client accepts it.
pub fn ctx_json_compressed(status: i32, json: Span<u8>) -> i32
    return ctx_send_compressed(status, "application/json", json)


# Send a large body (up to 1MB) with automatic compression.
# Uses heap allocation for compression buffer.
# content_type should be a static string like "text/html" or "application/json"
pub fn ctx_body_large_compressed(status: i32, body: Span<u8>, content_type: StrView) -> i32
    let c: *HandlerContext = get_g_ctx()
    if c == null
        return -1

    # Try compression
    let accepted: i32 = ctx_accept_encoding()
    var result: CompressResult
    let compressed: i32 = compress_large(body, accepted, content_type, @result)

    if compressed == 1
        # Send compressed response
        response_status(c.res, status)
        response_header(c.res, "Content-Type", content_type)
        ctx_encoding_header(c, result.encoding)
        response_content_length(c.res, result.len)
        response_header(c.res, "Connection", ctx_connection_value(c))
        response_header(c.res, "Vary", "Accept-Encoding")
        response_end_headers(c.res)
        response_append_bytes(c.res, result.data, result.len as i32)
        compress_result_free(@result)
        return 0

    # Send uncompressed
    return ctx_send(c, status, content_type, body)


# Send a very large body (>1MB) using chunked transfer encoding with streaming compression.
# Each chunk is compressed independently and sent immediately.
# This is the most memory-efficient way to send very large compressed responses.
#
# Note: This function sends data directly to the socket, bypassing the response buffer.
# It should only be used for responses that exceed COMPRESS_MAX_HEAP_INPUT (1MB).
pub fn ctx_body_streaming_compressed(status: i32, body: Span<u8>, content_type: StrView) -> i32
    let c: *HandlerContext = get_g_ctx()
    if c == null
        return -1

    # Initialize streaming compressor
    let accepted: i32 = ctx_accept_encoding()
    var sc: StreamCompressor
    if stream_compressor_init(@sc, accepted) != 0
        # Allocation failed - fall back to uncompressed chunked
        return ctx_body_chunked_uncompressed(status, body, content_type)

    # Send headers for chunked transfer
    response_status(c.res, status)
    response_header(c.res, "Content-Type", content_type)
    response_header(c.res, "Transfer-Encoding", "chunked")

    # Add Content-Encoding if compressing
    if sc.encoding != ENCODING_IDENTITY
        ctx_encoding_header(c, sc.encoding)

    response_header(c.res, "Connection", ctx_connection_value(c))
    response_header(c.res, "Vary", "Accept-Encoding")
    response_end_headers(c.res)

    # Send headers to socket
    # Note: We need the fd from the task - this is a limitation of the current design
    # For now, response_body handles this via the task pointer
    let headers_len: i32 = c.res.len
    response_body(c.res, span_empty<u8>())  # Flush headers only

    # Process body in chunks
    let body_len: i64 = body.len
    var offset: i64 = 0
    var chunk_header: [32]u8

    while offset < body_len
        var chunk_len: i64 = body_len - offset
        if chunk_len > COMPRESS_CHUNK_SIZE
            chunk_len = COMPRESS_CHUNK_SIZE

        # Compress chunk
        let compressed_len: i64 = stream_compress_chunk(@sc, body.slice(offset, offset + chunk_len))
        if compressed_len < 0
            # Compression failed - send uncompressed
            stream_compressor_free(@sc)
            return -2

        # Format chunk header: hex length + CRLF
        let header_len: i32 = format_chunk_header(@chunk_header[0], 32, compressed_len)

        # Send chunk header
        response_init(c.res, c.res.buf, c.res.cap)
        response_append_bytes(c.res, @chunk_header[0], header_len)
        response_body(c.res, span_empty<u8>())

        # Send chunk data
        response_init(c.res, c.res.buf, c.res.cap)
        response_append_bytes(c.res, sc.compress_buf, compressed_len as i32)
        response_append(c.res, "\r\n")
        response_body(c.res, span_empty<u8>())

        offset = offset + chunk_len

    # Send final chunk (0\r\n\r\n)
    response_init(c.res, c.res.buf, c.res.cap)
    response_append(c.res, "0\r\n\r\n")
    response_body(c.res, span_empty<u8>())

    stream_compressor_free(@sc)
    return 0


# Send chunked response without compression (fallback)
pub fn ctx_body_chunked_uncompressed(status: i32, body: Span<u8>, content_type: StrView) -> i32
    let c: *HandlerContext = get_g_ctx()
    if c == null
        return -1

    # Send headers
    response_status(c.res, status)
    response_header(c.res, "Content-Type", content_type)
    response_header(c.res, "Transfer-Encoding", "chunked")
    response_header(c.res, "Connection", ctx_connection_value(c))
    response_end_headers(c.res)
    response_body(c.res, span_empty<u8>())

    # Send in chunks
    let body_len: i64 = body.len
    var offset: i64 = 0
    var chunk_header: [32]u8

    while offset < body_len
        var chunk_len: i64 = body_len - offset
        if chunk_len > COMPRESS_CHUNK_SIZE
            chunk_len = COMPRESS_CHUNK_SIZE

        # Send chunk header
        let header_len: i32 = format_chunk_header(@chunk_header[0], 32, chunk_len)
        response_init(c.res, c.res.buf, c.res.cap)
        response_append_bytes(c.res, @chunk_header[0], header_len)
        response_body(c.res, span_empty<u8>())

        # Send chunk data
        response_init(c.res, c.res.buf, c.res.cap)
        response_body(c.res, body.slice(offset, offset + chunk_len))
        response_append(c.res, "\r\n")
        response_body(c.res, span_empty<u8>())

        offset = offset + chunk_len

    # Final chunk
    response_init(c.res, c.res.buf, c.res.cap)
    response_append(c.res, "0\r\n\r\n")
    response_body(c.res, span_empty<u8>())

    return 0


# Format chunk header as hex length + CRLF
pub fn format_chunk_header(buf: *u8, buf_len: i32, size: i64) -> i32
    if size == 0
        *(buf + 0) = '0'
        *(buf + 1) = '\r'
        *(buf + 2) = '\n'
        return 3

    var temp: [16]u8
    var temp_pos: i32 = 15
    var v: i64 = size
    let hex_chars: StrView = "0123456789abcdef"

    while v > 0
        temp[temp_pos] = hex_chars.get(v & 15)
        temp_pos = temp_pos - 1
        v = v >> 4

    let digits: i32 = 15 - temp_pos
    if digits + 2 > buf_len
        return 0

    for i in 0..digits
        *(buf + i) = temp[temp_pos + 1 + i]

    *(buf + digits) = '\r'
    *(buf + digits + 1) = '\n'

    return digits + 2


# ============================================================================
# Connection handler state machine
# ============================================================================

const CONN_STATE_RECV: i32 = 0
const CONN_STATE_PARSE: i32 = 1
const CONN_STATE_SEND: i32 = 2
const CONN_STATE_STATIC: i32 = 3  # Serving static file
const CONN_STATE_PROXY_WAIT: i32 = 4  # Cooperative-yield proxy: wakeup pending
const CONN_STATE_PIPELINE: i32 = 5  # A NOP's wakeup: frame bytes already in read_buf

# Size of Task.read_buf (ritzlib's TASK_BUFFER_SIZE): the most header bytes a
# plain request may arrive with, across however many reads (AGAST #2201).
const VALET_READ_BUF: i32 = 8192


# ============================================================================
# Cooperative-yield proxy support
# ============================================================================
#
# The valet `--zeus-socket` proxy used to block its task on a futex_wait
# while the zeus worker computed the response.  Single-threaded io_uring
# means a blocked task = no other connection makes progress.  Throughput
# was capped at one-roundtrip-at-a-time even with 100 concurrent
# connections.
#
# This framework wires a cooperative-yield model: the proxy handler
# submits the request to the shm ring, claims a per-task ProxyState
# slot, arms an io_uring NOP SQE (the yield primitive — see ritzlib's
# task_submit_nop), and returns STATUS_PROXY_PENDING.  The framework
# transitions the connection to CONN_STATE_PROXY_WAIT and the io_uring
# loop is free to dispatch other tasks.  When the NOP CQE fires, the
# framework re-enters via the registered continuation, which peeks the
# response ring (peek-by-id, see zeus_client_peek_response — only
# consumes when the head matches our request_id) and either builds the
# HTTP reply or re-arms the yield until the deadline elapses.
#
# Per-task state lives in a side-table keyed by task slot in the pool;
# the slot index is computed via valet_task_slot_idx (O(MAX_TASKS) but
# cheap — sub-microsecond).  Adding a slot-index field to ritzlib's
# Task would avoid the iteration but would touch every binary that
# uses the framework, which isn't worth the saving.

# Sentinel return code from a route handler meaning "I've armed an SQE
# and yielded — don't send any response yet, transition the connection
# to CONN_STATE_PROXY_WAIT and re-enter via the registered continuation
# when the next CQE wakes the task."  Outside any plausible HTTP-status
# space and the normal 0/-1 handler-return convention.
pub const STATUS_PROXY_PENDING: i32 = 0x70CEED


# Per-task proxy state, indexed by task slot in the pool.  Lives across
# yields (handler return ↔ CQE re-entry).
pub struct ProxyState
    in_use: i32              # 0 = free, 1 = a request is in flight
    worker_idx: i32          # which zeus worker we submitted to
    request_id: u64          # the response id we're waiting for
    claimed_slot: i64        # ring slot we claimed for path/body bytes
    deadline_sec: i64        # gettimeofday tv_sec at the give-up moment
    spin_count: i32          # yields so far; picks the backoff delay (#183)
    _pad: i32


# Per-task side-table.  256 slots = MAX_TASKS in ritzlib.
var g_proxies: [256]ProxyState


# Continuation hook — set once at startup by valet_set_proxy_continuation.
# Called when a CONN_STATE_PROXY_WAIT task wakes via a CQE.  Returns
# the same convention as a route handler:
#   0  — done, response sent (framework keeps connection alive)
#   -1 — still pending (continuation re-armed yield or submitted send)
#    1 — fatal error, close connection
var g_proxy_continuation_ptr: i64 = 0


pub fn valet_set_proxy_continuation(f: fn(*Task) -> i32)
    g_proxy_continuation_ptr = f as i64


fn get_proxy_continuation() -> fn(*Task) -> i32
    return g_proxy_continuation_ptr as fn(*Task) -> i32


# Find the slot index of a task within its pool.  O(1): tasks live in a
# fixed array, so the index is the byte offset over the element stride.
pub fn valet_task_slot_idx(task: *Task) -> i32
    let pool: *TaskPool = task.user_data as *TaskPool
    if pool == null
        return -1
    let base: i64 = @pool.tasks[0] as i64
    let stride: i64 = (@pool.tasks[1] as i64) - base
    let off: i64 = (task as i64) - base
    if stride <= 0 or off < 0 or off % stride != 0
        return -1
    let idx: i64 = off / stride
    if idx >= 256
        return -1
    return idx as i32


# Get the proxy state for a task.  Returns null if the slot can't be
# resolved (shouldn't happen for an active task).
pub fn valet_proxy_state(task: *Task) -> *ProxyState
    let idx: i32 = valet_task_slot_idx(task)
    if idx < 0
        return null
    return @g_proxies[idx]


# Clear the proxy state for a task.  Call from the continuation when
# the request is fully resolved or timed out so the slot can be reused
# on the next request (keep-alive).
pub fn valet_proxy_state_clear(task: *Task)
    let st: *ProxyState = valet_proxy_state(task)
    if st != null
        st.in_use = 0
        st.worker_idx = -1
        st.request_id = 0
        st.claimed_slot = 0
        st.deadline_sec = 0
        st.spin_count = 0


# Per-task timer for a TIMEOUT yield.  io_uring reads the timespec when it
# prepares the SQE, which may be after the handler returns, so it lives
# here (one per task slot) and not on the stack.
var g_proxy_yield_ts: [256]KernelTimespec

# 0 once the kernel has refused an IORING_OP_TIMEOUT (-EINVAL, as WSL2 6.6
# did): every later yield is a NOP.
var g_proxy_timer_ok: i32 = 1


# Yield the calling task: wake it after `micros` microseconds, or on the
# next event-loop pass when `micros` is 0 (AGAST #183).
#
# micros > 0 arms an IORING_OP_TIMEOUT.  The continuation picks `micros`
# from proxy_yield_delay_us (lib/proxy.ritz): the first yields of a wait
# are NOPs, later ones back off up to a 1 ms timer.  With NOPs only, N
# waiting tasks kept N CQEs in flight every loop pass and the event loop
# never slept; the proxy fell from 33k rps at c=20 to 0 at c=50.
#
# micros == 0, or a kernel that refused a timer, arms a NOP: it fires at
# once and re-dispatches us through valet_handle_connection's
# CONN_STATE_PROXY_WAIT branch, other tasks running in between.  That
# branch notices a refused timer (proxy_yield_timer_rejected) and turns
# timers off for good.  IORING_OP_FUTEX_WAIT would be better still, but
# is 6.7+.
#
# The continuation manages an overall deadline (g_proxies .deadline_sec),
# so a wait never yields forever.
pub fn valet_proxy_arm_yield(task: *Task, micros: i64) -> i32
    let pool: *TaskPool = task.user_data as *TaskPool
    if micros > 0 and g_proxy_timer_ok != 0
        let idx: i32 = valet_task_slot_idx(task)
        if idx >= 0
            let ts: *KernelTimespec = @g_proxy_yield_ts[idx]
            proxy_yield_timespec(ts, micros)
            if pool.submit_timeout(task, ts)
                return 0
            return -12
    if pool.submit_nop(task)
        return 0
    return -12


# ============================================================================
# Large request / response buffers (AGAST #2104)
# ============================================================================
#
# ritzlib's Task carries fixed 8 KB read_buf / write_buf.  A request whose
# body does not arrive in one 8 KB recv, or a response bigger than 8 KB
# (a proxied nexus page reaches ~50 KB), goes through a per-task heap
# buffer instead.  The buffer is mmap'd for the one request or response
# and unmapped as soon as it is done, so idle connections hold nothing.
#
# A slot has two: g_bigbufs for the request (RECV, then PARSED while the
# handler reads it) and g_sendbufs for the response (SEND).  One buffer for
# both meant a handler that asked for a >8 KB response buffer unmapped the
# >8 KB request it was still reading (AGAST #3900).
#
# g_bigbuf_active counts buffers with mode != BIGBUF_NONE, so the common
# small-request path skips the side-table lookup entirely.

const BIGBUF_NONE: i32 = 0
const BIGBUF_RECV: i32 = 1     # accumulating a request of `len` / `need` bytes
const BIGBUF_PARSED: i32 = 2   # request complete; handler is reading it
const BIGBUF_SEND: i32 = 3     # sending `len` bytes, `pos` already sent

# Hard ceiling on one buffered request or response, applied even when
# max_request_size is 0 (unlimited).
pub const VALET_MAX_BUFFERED: i64 = 16777216

pub struct BigBuf
    ptr: *u8
    cap: i64
    len: i64
    pos: i64
    need: i64
    mode: i32
    _pad: i32

var g_bigbufs: [256]BigBuf
var g_sendbufs: [256]BigBuf
var g_bigbuf_active: i32 = 0


# The task's request buffer (BIGBUF_RECV / BIGBUF_PARSED).
fn bigbuf_for(task: *Task) -> *BigBuf
    let idx: i32 = valet_task_slot_idx(task)
    if idx < 0
        return null
    return @g_bigbufs[idx]


# The task's response buffer (BIGBUF_SEND).
fn sendbuf_for(task: *Task) -> *BigBuf
    let idx: i32 = valet_task_slot_idx(task)
    if idx < 0
        return null
    return @g_sendbufs[idx]


# Release a task's buffer (if any) and unmap it.
fn bigbuf_release(b: *BigBuf)
    if b.mode != BIGBUF_NONE
        g_bigbuf_active = g_bigbuf_active - 1
    if b.ptr != null and b.cap > 0
        munmap(span_from_ptr<u8>(b.ptr, b.cap))
    b.ptr = null
    b.cap = 0
    b.len = 0
    b.pos = 0
    b.need = 0
    b.mode = BIGBUF_NONE


# Release both of a task's buffers.
fn bigbuf_release_task(task: *Task)
    if g_bigbuf_active == 0
        return
    let b: *BigBuf = bigbuf_for(task)
    if b != null
        bigbuf_release(b)
    let s: *BigBuf = sendbuf_for(task)
    if s != null
        bigbuf_release(s)


# Map a fresh `size`-byte buffer into `b` (bigbuf_for or sendbuf_for) in
# `mode`.  What `b` held before is released first; the other buffer of the
# slot is untouched.  Returns null on failure or if size is out of range.
fn bigbuf_acquire(b: *BigBuf, size: i64, mode: i32) -> *BigBuf
    if size <= 0 or size > VALET_MAX_BUFFERED
        return null
    if b == null
        return null
    bigbuf_release(b)
    let cap: i64 = ((size + 4095) / 4096) * 4096
    match mmap_anon(cap)
        Ok(m) => b.ptr = m.ptr
        Err(_) => return null
    b.cap = cap
    b.len = 0
    b.pos = 0
    b.need = size
    b.mode = mode
    g_bigbuf_active = g_bigbuf_active + 1
    return b


# Get a buffer to build a `len`-byte response in: task.write_buf when it
# fits, a heap buffer otherwise.  Returns null if `len` can't be buffered.
# Pass the result to valet_task_send_response.
pub fn valet_response_buffer(task: *Task, len: i64) -> *u8
    if len <= 8192
        return @task.write_buf[0]
    let b: *BigBuf = bigbuf_acquire(sendbuf_for(task), len, BIGBUF_SEND)
    if b == null
        return null
    return b.ptr


# Send `len` bytes built in a buffer from valet_response_buffer and move the
# connection to CONN_STATE_SEND.  Large sends are resumed across short
# writes in the SEND state.  Returns the handler convention (-1 pending,
# 1 close).
pub fn valet_task_send_response(task: *Task, buf: *u8, len: i64) -> i32
    task.handler_state = CONN_STATE_SEND
    if buf == @task.write_buf[0]
        task.write_len = len as i32
        task.write_pos = 0
        if valet_task_send(task, len as i32) < 0
            return 1
        return -1
    let b: *BigBuf = sendbuf_for(task)
    if b == null or b.mode != BIGBUF_SEND or b.ptr != buf
        return 1
    b.len = len
    b.pos = 0
    # Not a write_buf send: the SEND state's write_buf resume must not see
    # a reused task's stale write_pos/write_len (AGAST #3678).
    task.write_len = 0
    task.write_pos = 0
    if not task.send_buf(Span<u8> { ptr: (b.ptr), len: (len as i32) as i64 })
        bigbuf_release_task(task)
        return 1
    return -1


# Check if path matches static prefix and serve file if so
# Returns 1 if static file was handled (caller should transition to keep-alive or close)
# Returns 0 if not a static path (caller should try routing)
pub fn valet_try_static(app: *Valet, task: *Task, path: StrView) -> i32
    return valet_try_static_raw(app, task, path, @task.read_buf[0], task.read_len)


# valet_try_static for a request in raw[0..raw_len): its headers (Range,
# If-None-Match) are read there, not from task.read_buf, which can hold the
# next pipelined request instead (AGAST #1865).
pub fn valet_try_static_raw(app: *Valet, task: *Task, path: StrView, raw: *u8, raw_len: i32) -> i32
    # Check if static serving is enabled
    let root: StrView = match app.static_root
        Some(r) => r
        None => return 0
    if app.static_prefix.len == 0
        return 0

    # Check if path starts with static prefix
    if not path.starts_with(app.static_prefix)
        return 0

    # Path matches static prefix - extract relative path
    let rel_path: StrView = path.skip(app.static_prefix.len)

    # valet closes after this response once request_count reaches the cap
    # (the handler saturates it for HTTP/1.0 and "Connection: close"): the
    # Connection header must say so (AGAST #2117), the 403 included (#3899).
    let keep_alive: i32 = (task.request_count < app.keepalive_requests) as i32

    # Security check
    if path_is_safe(rel_path) == 0
        log_warn("Static file request blocked: path traversal attempt")
        static_send_403(task.fd, keep_alive)
        return 1

    # Build full filesystem path
    var full_path: [512]u8
    let file: StrView = match static_build_path(@full_path, root, rel_path)
        Some(f) => f
        None =>
            log_error("Static file path too long")
            static_send_404(task.fd, keep_alive)
            return 1

    # Check if path is a directory
    if static_is_directory(file) != 0
        # Serve directory listing
        let sent: i64 = static_serve_directory(task.fd, file, path, keep_alive)
        if sent < 0
            static_send_404(task.fd, keep_alive)
        return 1

    # Serve the file with the request's Range and If-None-Match (ETag
    # validation) headers, if it has them
    let range_hdr: Option<StrView> = request_find_header(raw, raw_len, "Range")
    let if_none_match: Option<StrView> = request_find_header(raw, raw_len, "If-None-Match")
    let sent: i64 = static_serve_file_full(task.fd, file, range_hdr, if_none_match, keep_alive)

    if sent < 0
        static_send_404(task.fd, keep_alive)

    return 1


# Helper to send response data - uses zero-copy if enabled
pub fn valet_task_send(task: *Task, len: i32) -> i32
    let app: *Valet = get_g_app()
    if app.use_send_zc != 0
        if task.send_zc(len)
            return 0
        return -12
    if task.send(len)
        return 0
    return -12


# Build a request-error response (Connection: close) in `res`: 413 Request
# Entity Too Large, or the 400 / 501 a framing error is answered with
# (AGAST #1865).  Any other code is answered as a 400.
fn valet_build_error(res: *Response, code: i32)
    var status: i32 = 400
    var body: StrView = "400 Bad Request\n"
    if code == 413
        status = 413
        body = "413 Request Entity Too Large\n"
    else if code == 501
        status = 501
        body = "501 Not Implemented\n"
    response_status(res, status)
    response_header(res, "Content-Type", "text/plain")
    response_header(res, "Connection", "close")
    response_content_length(res, body.len)
    response_end_headers(res)
    response_body(res, body.as_bytes())


# Body limit for request_frame: max_request_size, or the buffering ceiling
# when that is 0 (unlimited).
fn valet_body_limit(app: *Valet) -> i64
    if app.max_request_size > 0
        return app.max_request_size as i64
    return VALET_MAX_BUFFERED


# Helper to send 413 Request Entity Too Large
pub fn valet_send_413(task: *Task) -> i32
    return valet_send_error(task, 413)


# Send a request-error response (see valet_build_error) and close.
pub fn valet_send_error(task: *Task, code: i32) -> i32
    var res: Response
    response_init(@res, @task.write_buf[0], 8192)
    valet_build_error(@res, code)
    # It says "Connection: close": make the SEND state close (AGAST #2106's
    # saturated count), or a client waiting for EOF would wait forever.
    task.request_count = get_g_app().keepalive_requests
    task.write_len = res.len
    task.write_pos = 0
    task.handler_state = CONN_STATE_SEND
    let ret = valet_task_send(task, res.len)
    if ret < 0
        return 1
    return -1


# Bytes at the front of task.read_buf the request being handled occupies;
# 0 when it was read into a heap buffer.  Whatever follows them in read_buf
# is the next, pipelined, request (AGAST #1865).
var g_req_consumed: [256]i32

# What request_frame learned of the request being read, per slot, so each
# recv into a heap buffer resumes the framing instead of redoing it
# (h1_frame_continue): a big body of tiny chunks would cost quadratic time.
var g_frames: [256]H1Frame


fn valet_frame_slot(task: *Task) -> *H1Frame
    let idx: i32 = valet_task_slot_idx(task)
    if idx < 0
        return null
    return @g_frames[idx]


fn valet_set_consumed(task: *Task, n: i32)
    let idx: i32 = valet_task_slot_idx(task)
    if idx >= 0
        g_req_consumed[idx] = n


# Done with a request: drop its bytes and go on to the next one.  Bytes
# already behind it (pipelined) are framed on a NOP's wakeup — no recv
# would bring them, the client is waiting for answers — otherwise a recv is
# submitted.  Returns 0 or -errno, like task_reset_for_recv.
fn valet_next_request(task: *Task) -> i32
    var consumed: i32 = 0
    let idx: i32 = valet_task_slot_idx(task)
    if idx >= 0
        consumed = g_req_consumed[idx]
        g_req_consumed[idx] = 0
    if g_bigbuf_active > 0
        let b: *BigBuf = bigbuf_for(task)
        if b != null and b.mode == BIGBUF_PARSED
            bigbuf_release(b)
    let rest: i32 = task.read_len - consumed
    if rest <= 0
        if task.reset_for_recv()
            return 0
        return -12
    let read_buf: Span<u8> = @task.read_buf
    read_buf.copy_from(read_buf.slice(consumed as i64, (consumed + rest) as i64))
    task.read_len = rest
    task.write_len = 0
    task.write_pos = 0
    task.handler_state = CONN_STATE_PIPELINE
    if task.yield()
        return 0
    return -12


# The request isn't whole yet: receive more of it.  `big` is the heap buffer
# it is being read into, or null for task.read_buf; `f` is what
# request_frame knew.  Returns the handler convention.
fn valet_recv_more(task: *Task, app: *Valet, big: *BigBuf, f: *H1Frame) -> i32
    if big != null
        let room: i64 = big.cap - big.len
        if room <= 0
            log_warn("Request too large, closing connection")
            bigbuf_release(big)
            return valet_send_413(task)
        if not task.recv_buf(Span<u8> { ptr: (big.ptr + big.len), len: (room as i32) as i64 })
            bigbuf_release(big)
            return 1
        return -1

    if f.headers_end == 0
        # Headers split across reads: read the rest in behind them.
        if app.max_request_size > 0 && task.read_len > app.max_request_size
            log_warn("Request too large, closing connection")
            return valet_send_413(task)
        if task.read_len >= VALET_READ_BUF
            log_warn("Request headers exceed the read buffer")
            return valet_send_413(task)
        if not task.recv_buf(Span<u8> { ptr: (@task.read_buf[task.read_len]), len: (VALET_READ_BUF - task.read_len) as i64 })
            return 1
        return -1

    # The body is still on the wire.  A Content-Length says how big a buffer
    # it needs; a chunked body gets the most it may grow to.
    var want: i64 = f.total
    if want < 0
        want = valet_body_limit(app) + f.headers_end + 4096
        if want > VALET_MAX_BUFFERED
            want = VALET_MAX_BUFFERED
    else if app.max_request_size > 0 && want > app.max_request_size as i64
        log_warn("Request too large, closing connection")
        return valet_send_413(task)
    if (f.total >= 0 and want <= VALET_READ_BUF as i64) or (f.total < 0 and task.read_len < VALET_READ_BUF)
        if not task.recv_buf(Span<u8> { ptr: (@task.read_buf[task.read_len]), len: (VALET_READ_BUF - task.read_len) as i64 })
            return 1
        return -1
    let nb: *BigBuf = bigbuf_acquire(bigbuf_for(task), want, BIGBUF_RECV)
    if nb == null
        return valet_send_413(task)
    memcpy(nb.ptr, @task.read_buf[0], task.read_len as i64)
    nb.len = task.read_len as i64
    task.read_len = 0
    if not task.recv_buf(Span<u8> { ptr: (nb.ptr + nb.len), len: ((nb.cap - nb.len) as i32) as i64 })
        bigbuf_release(nb)
        return 1
    return -1


# The request valet_handle_connection is handling: task.read_buf, or a heap
# buffer when the request outgrew it (AGAST #2104).
struct ValetReqView
    buf: *u8
    len: i32
    body_len: i64
    close_after: i32


# A state helper's "not answered yet: go on to the next state".  Never a
# handler return code.
const VALET_CONN_NEXT: i32 = -1000


# Respond, or close if the keep-alive budget is spent.  Returns the handler
# convention.
fn valet_conn_next_or_close(task: *Task, app: *Valet) -> i32
    if task.request_count < app.keepalive_requests
        let ret = valet_next_request(task)
        if ret < 0
            var s: Socket = socket_from_raw(task.fd)
            s.shutdown(SHUT_WR)
            return 0
        return -1
    var s: Socket = socket_from_raw(task.fd)
    s.shutdown(SHUT_WR)
    return 0


# Send the response built in task.write_buf.  Returns the handler convention.
fn valet_conn_start_send(task: *Task, res: *Response) -> i32
    task.write_len = res.len
    task.write_pos = 0
    task.handler_state = CONN_STATE_SEND
    let ret = valet_task_send(task, res.len)
    if ret < 0
        return 1
    return -1


# A text/plain 500 that closes the connection.
fn valet_res_500_close(res: *Response, body: StrView)
    response_status(res, 500)
    response_header(res, "Content-Type", "text/plain")
    response_header(res, "Connection", "close")
    response_content_length(res, body.len)
    response_end_headers(res)
    response_body(res, body.as_bytes())


# Point the handler context at this request and make it current.
fn valet_ctx_enter(ctx: *HandlerContext, req: *Request, res: *Response, raw: *u8, raw_len: i32, task: *Task)
    ctx.req = req
    ctx.res = res
    ctx.route_result = null
    ctx.path = req.path
    ctx.raw_buf = raw
    ctx.raw_len = raw_len
    ctx.task = task
    set_g_ctx(ctx)


# A completion in the RECV state: submit the first recv of a fresh task, or
# end the connection on EOF / error.  VALET_CONN_NEXT when io_result is
# bytes received.
fn valet_conn_take_recv(task: *Task) -> i32
    if task.io_result == TASK_IO_FRESH
        # Fresh task — never submitted recv.  A previous connection in
        # this pool slot may have died mid-request; drop its buffer.
        bigbuf_release_task(task)
        valet_set_consumed(task, 0)
        let ret: bool = task.recv()
        if not ret
            return 1
        return -1

    if task.io_result <= 0
        # EOF (0) or error (<0) — connection done.
        bigbuf_release_task(task)
        return 0
    return VALET_CONN_NEXT


# The heap buffer a request is being received into, or null for
# task.read_buf.
fn valet_conn_recv_target(task: *Task) -> *BigBuf
    var big: *BigBuf = null
    if g_bigbuf_active > 0
        big = bigbuf_for(task)
        if big != null and big.mode != BIGBUF_RECV
            # A finished request's buffer (e.g. after a static
            # response) — done with it.
            if big.mode == BIGBUF_PARSED
                bigbuf_release(big)
            big = null
    return big


# A whole request of `total` bytes is in `big` (or read_buf): keep what
# follows it (a pipelined one) for valet_next_request, in read_buf.
fn valet_conn_keep_rest(task: *Task, big: *BigBuf, total: i64, v: *ValetReqView)
    if big != null
        big.mode = BIGBUF_PARSED
        let rest: i64 = big.len - total
        if rest > VALET_READ_BUF as i64
            # Too much to keep: answer this one and close.
            v.close_after = 1
            task.read_len = 0
        else
            memcpy(@task.read_buf[0], big.ptr + total, rest)
            task.read_len = rest as i32
        valet_set_consumed(task, 0)
    else
        valet_set_consumed(task, v.len)


# State: RECV - read until a whole request is buffered.  `added` bytes came
# in since the last look.  Fills `v` and moves to PARSE, returning
# VALET_CONN_NEXT, or returns the handler convention.
fn valet_conn_frame(task: *Task, v: *ValetReqView, added: i32) -> i32
    let app: *Valet = get_g_app()
    let big: *BigBuf = valet_conn_recv_target(task)

    # Append: read_len is 0 for a new request (spawn_task,
    # task_reset_for_recv), or what is already buffered of this one:
    # headers not all here yet (AGAST #2201), or a pipelined request
    # (AGAST #1865).
    var in_buf: *u8 = @task.read_buf[0]
    var in_len: i64 = 0
    if big != null
        big.len = big.len + added as i64
        in_buf = big.ptr
        in_len = big.len
    else
        task.read_len = task.read_len + added
        in_len = task.read_len as i64

    # Where does the request end?  http's lib/h1_framing.ritz decides,
    # for this server and projects/http alike (AGAST #1865).  Reading
    # into a heap buffer, it picks up where the last recv left it.
    var local_frame: H1Frame
    var f: *H1Frame = valet_frame_slot(task)
    if f == null
        f = @local_frame
        h1_frame_init(f)
    var total: i64 = 0
    if big != null
        total = h1_frame_continue(in_buf, in_len, valet_body_limit(app), f)
    else
        total = request_frame(in_buf, in_len as i32, valet_body_limit(app), f)
    if total == H1F_INCOMPLETE
        return valet_recv_more(task, app, big, f)
    if total < 0
        let code: i32 = h1_frame_status(total)
        if code == 413
            log_warn("Request too large, closing connection")
        else
            log_warn("Bad request framing, closing connection")
        bigbuf_release_task(task)
        return valet_send_error(task, code)
    if app.max_request_size > 0 && total > app.max_request_size as i64
        log_warn("Request too large, closing connection")
        bigbuf_release_task(task)
        return valet_send_413(task)

    # A chunked body is decoded in place, behind the headers, so a
    # handler reads it like a Content-Length one.
    v.body_len = h1_frame_dechunk(in_buf, f)
    v.buf = in_buf
    v.len = total as i32
    valet_conn_keep_rest(task, big, total, v)

    task.handler_state = CONN_STATE_PARSE
    return VALET_CONN_NEXT


# Run a matched route: before interceptors, the handler, after
# interceptors, building a 500 if the handler failed without answering.
# Clears the handler context.  Returns 1 when the handler went to the
# cooperative-yield proxy (state PROXY_WAIT, nothing to send yet), else 0.
fn valet_conn_run_route(task: *Task, req: *Request, res: *Response, rr: *RouteMatch) -> i32
    # Run per-route before interceptors
    let before_result: i32 = route_run_before(rr.route, req.path.ptr, req.path.len as i32)
    if before_result == MW_HANDLED
        # Before interceptor handled the request
        set_g_ctx(null)
        return 0
    if before_result == MW_ERROR
        # Before interceptor error - send 500
        set_g_ctx(null)
        valet_res_500_close(res, "Interceptor Error\n")
        return 0

    # Call the matched handler
    let h: fn(*u8, i32) -> i32 = rr.handler
    let status: i32 = h(req.path.ptr, req.path.len as i32)

    # Cooperative-yield proxy: handler armed a yield SQE and asked for
    # re-entry on CQE.  Don't send any response yet — transition to
    # CONN_STATE_PROXY_WAIT.  After-interceptors are deferred until the
    # continuation finalises the response (typical interceptors don't run
    # for the proxy path so this is academic in current usage).
    if status == STATUS_PROXY_PENDING
        set_g_ctx(null)
        task.handler_state = CONN_STATE_PROXY_WAIT
        return 1

    # Run per-route after interceptors (in reverse order)
    route_run_after(rr.route, req.path.ptr, req.path.len as i32)

    # Clear context
    set_g_ctx(null)

    # If handler returns non-zero and didn't write response, send 500
    if status != 0 && res.len == 0
        valet_res_500_close(res, "Internal Server Error\n")
    return 0


# Saturate the request count, so the SEND state closes after this response,
# when the connection won't be reused.
fn valet_conn_count_request(task: *Task, req: *Request, app: *Valet, close_after: i32)
    task.request_count += 1
    if close_after != 0
        task.request_count = app.keepalive_requests

    # Client won't reuse the connection (HTTP/1.0 without keep-alive,
    # or "Connection: close"): saturate the counter so every
    # `request_count < keepalive_requests` check below closes after
    # this response (AGAST #2106).
    if valet_keep_alive(req, task.request_count, app.keepalive_requests) == 0
        task.request_count = app.keepalive_requests


# State: PARSE - parse request, route, build response.  Returns the handler
# convention.
fn valet_conn_serve(task: *Task, v: *ValetReqView) -> i32
    var req: Request
    request_init(@req)

    let parsed = request_parse(@req, v.buf, v.len)
    if parsed < 0
        bigbuf_release_task(task)
        return 0
    req.content_length = v.body_len

    let app: *Valet = get_g_app()
    valet_conn_count_request(task, @req, app, v.close_after)

    # Check for static file request first (only for GET requests)
    if request_is_get(@req) != 0
        if valet_try_static_raw(app, task, req.path, v.buf, v.len) != 0
            # Static file was served - check keep-alive
            return valet_conn_next_or_close(task, app)

    var res: Response
    response_init(@res, @task.write_buf[0], 8192)

    # Set up handler context early for middleware access
    var handler_ctx: HandlerContext
    valet_ctx_enter(@handler_ctx, @req, @res, v.buf, v.len, task)

    # Run middleware pipeline
    let mw_result: i32 = router_run_middleware(@app.router, req.path.ptr, req.path.len as i32)
    if mw_result == MW_HANDLED
        # Middleware handled the request - send response if any
        set_g_ctx(null)
        if res.len > 0
            return valet_conn_start_send(task, @res)
        # Middleware handled but no response - keep-alive
        return valet_conn_next_or_close(task, app)
    if mw_result == MW_ERROR
        # Middleware error - send 500
        set_g_ctx(null)
        valet_res_500_close(@res, "Middleware Error\n")
        return valet_conn_start_send(task, @res)

    # Try to match route
    var route_result: RouteMatch
    let matched: i32 = router_match(@app.router, req.method, req.path, @route_result)

    if matched == 1
        # Update context with route result
        handler_ctx.route_result = @route_result
        if valet_conn_run_route(task, @req, @res, @route_result) != 0
            return -1
    else
        # No route matched - 404
        response_not_found(@res)

    return valet_conn_start_send(task, @res)


# State: PROXY_WAIT - cooperative-yield proxy continuation.
# Triggered by a NOP/timer/futex CQE for a task that earlier returned
# STATUS_PROXY_PENDING.  Dispatch to the registered continuation,
# which peeks the response ring (peek-by-id) and either builds the
# final reply (transition to CONN_STATE_SEND) or re-arms the yield.
fn valet_conn_proxy_wait(task: *Task) -> i32
    let cont: fn(*Task) -> i32 = get_proxy_continuation()
    if cont == null
        # Nothing registered — bail out cleanly rather than spin.
        return 1
    # A kernel that refuses IORING_OP_TIMEOUT answers our timer yield
    # with -EINVAL at once: yield with NOPs from now on (AGAST #183).
    if g_proxy_timer_ok != 0 and proxy_yield_timer_rejected(task.io_result) != 0
        g_proxy_timer_ok = 0
    return cont(task)


# A send finished in the SEND state, with a heap buffer active: go on with
# a large response, and drop a finished large request's buffer.
# VALET_CONN_NEXT when the large response (if any) is all out.
fn valet_conn_sent_big(task: *Task) -> i32
    let b: *BigBuf = sendbuf_for(task)
    if b != null and b.mode == BIGBUF_SEND
        if task.io_result == 0
            bigbuf_release_task(task)
            return 1
        b.pos = b.pos + task.io_result as i64
        if b.pos < b.len
            # Short send: resume from where the kernel stopped.
            if not task.send_buf(Span<u8> { ptr: (b.ptr + b.pos), len: ((b.len - b.pos) as i32) as i64 })
                bigbuf_release_task(task)
                return 1
            return -1
        bigbuf_release(b)
    let r: *BigBuf = bigbuf_for(task)
    if r != null and r.mode == BIGBUF_PARSED
        bigbuf_release(r)
    return VALET_CONN_NEXT


# State: SEND - wait for send completion.  Returns the handler convention.
fn valet_conn_sent(task: *Task) -> i32
    if task.io_result < 0
        bigbuf_release_task(task)
        return 1

    # Large response, and/or a finished large request's buffer?
    if g_bigbuf_active > 0
        let r: i32 = valet_conn_sent_big(task)
        if r != VALET_CONN_NEXT
            return r

    # A write_buf response: the rest of it is still in write_buf, from
    # write_pos on. Send it before keep-alive moves on to the next
    # request, or the client gets a truncated response followed by the
    # next one (AGAST #3678; the TLS SEND state's fix is #2197 item 5).
    if task.write_pos < task.write_len
        if task.io_result == 0
            return 1
        task.write_pos = task.write_pos + task.io_result
        if task.write_pos < task.write_len
            if not task.send_buf(Span<u8> { ptr: (@task.write_buf[task.write_pos]), len: (task.write_len - task.write_pos) as i64 })
                return 1
            return -1

    # Check keep-alive limit from app config
    return valet_conn_next_or_close(task, get_g_app())


pub fn valet_handle_connection(task: *Task) -> i32
    var view: ValetReqView
    view.buf = @task.read_buf[0]
    view.len = 0
    view.body_len = 0
    view.close_after = 0

    # Bytes received since the last look: a recv's result, or none when a
    # pipelined request was left in read_buf (valet_next_request).
    var added: i32 = 0
    if task.handler_state == CONN_STATE_PIPELINE
        task.handler_state = CONN_STATE_RECV
    else if task.handler_state == CONN_STATE_RECV
        let r: i32 = valet_conn_take_recv(task)
        if r != VALET_CONN_NEXT
            return r
        added = task.io_result

    if task.handler_state == CONN_STATE_RECV
        let r: i32 = valet_conn_frame(task, @view, added)
        if r != VALET_CONN_NEXT
            return r

    if task.handler_state == CONN_STATE_PARSE
        return valet_conn_serve(task, @view)

    if task.handler_state == CONN_STATE_PROXY_WAIT
        return valet_conn_proxy_wait(task)

    if task.handler_state == CONN_STATE_SEND
        return valet_conn_sent(task)

    return 0


# ============================================================================
# TLS Connection Handler
# ============================================================================

# TLS connection states
# Note: INIT must be 0 since spawn_task initializes handler_state to 0
const TLS_CONN_STATE_INIT: i32 = 0
const TLS_CONN_STATE_HANDSHAKE: i32 = 1
const TLS_CONN_STATE_RECV: i32 = 2
const TLS_CONN_STATE_PARSE: i32 = 3
const TLS_CONN_STATE_SEND: i32 = 4
const TLS_CONN_STATE_HANDSHAKE_SEND: i32 = 5
const TLS_CONN_STATE_CLOSE_SEND: i32 = 6

# Global TLS server instance per connection
# We allocate these on the heap since TlsServer is large (~35KB with work buffers)
# task.user_data points to the TlsTaskData structure
#
# Application data is buffered at both layers (AGAST #2201):
#   rx   ciphertext as received.  One recv can hold several records, or end
#        partway through one; whole records are decrypted out of the front
#        and a partial one waits here for the rest (#2197 items 1-3).
#   req  decrypted plaintext.  A request can span records (a client writes
#        its request line and headers separately, or a body follows its
#        headers), so it collects here until it is complete.  8 KiB, the
#        limit a single record's plaintext had before.  Bytes behind the
#        request (a pipelined next one) stay for the next round.
const TLS_REQ_CAP: i64 = 8192
const TLS_RX_CAP: i64 = 16645  # 5-byte header + 2^14 + 256: a maximal TLSCiphertext

struct TlsTaskData
    pool: *TaskPool             # Pointer to task pool (for I/O)
    req_len: i64                # Plaintext bytes in `req`
    rx_len: i64                 # Ciphertext bytes in `rx`
    req: [8192]u8               # TLS_REQ_CAP
    rx: [16645]u8               # TLS_RX_CAP
    tls: TlsServer              # TLS connection state (~35KB)

# Bytes mapped for one TlsTaskData, whole pages.
fn tls_task_data_size() -> i64
    return ((sizeof(TlsTaskData) as i64 + 4095) / 4096) * 4096

# Allocate TLS task data (zeroed: anonymous mmap)
pub fn tls_task_data_alloc() -> *TlsTaskData
    match mmap_anon(tls_task_data_size())
        Ok(m) => return m.ptr as *TlsTaskData
        Err(_) => return null

pub fn tls_task_data_free(data: *TlsTaskData)
    if data != null
        tls_server_free(@data.tls)
        munmap(span_from_ptr<u8>(data as *u8, tls_task_data_size()))

# TLS-specific I/O helpers that use the pool from TlsTaskData
pub fn tls_task_recv(task: *Task, tls_data: *TlsTaskData) -> i32
    if tls_data.pool.submit_recv(task)
        return 0
    return -12

pub fn tls_task_send(task: *Task, tls_data: *TlsTaskData, len: i32) -> i32
    if tls_data.pool.submit_send(task, len)
        return 0
    return -12

# Receive application data in behind the ciphertext already buffered.
fn tls_task_recv_app(task: *Task, tls_data: *TlsTaskData) -> i32
    let room: i64 = TLS_RX_CAP - tls_data.rx_len
    if tls_data.pool.submit_recv_buf(task, Span<u8> { ptr: (@tls_data.rx[tls_data.rx_len]), len: (room as i32) as i64 })
        return 0
    return -12

# Encrypt and send a 413, then close (the SEND state sees the saturated
# request count).  Returns the handler convention.
fn valet_tls_send_413(task: *Task, tls_data: *TlsTaskData) -> i32
    log_warn("TLS request too large, closing connection")
    return valet_tls_send_error(task, tls_data, 413)

# Encrypt and send a request-error response (valet_build_error), then close.
fn valet_tls_send_error(task: *Task, tls_data: *TlsTaskData, code: i32) -> i32
    tls_data.req_len = 0
    var http_res: [256]u8
    var res: Response
    response_init(@res, @http_res[0], 256)
    valet_build_error(@res, code)
    let encrypted_len: i64 = tls_server_write(@tls_data.tls, @http_res[0], res.len as i64, @task.write_buf[0], 8192)
    if encrypted_len <= 0
        tls_task_data_free(tls_data)
        task.user_data = null
        return 1
    task.request_count = get_g_app().keepalive_requests
    task.write_len = encrypted_len as i32
    task.handler_state = TLS_CONN_STATE_SEND
    if tls_task_send(task, tls_data, encrypted_len as i32) < 0
        tls_task_data_free(tls_data)
        task.user_data = null
        return 1
    return -1

# Serve from the connection's buffers: decrypt every whole record in `rx`
# into `req`, then answer the request if it is complete or receive more.
# Returns the handler convention.
fn tls_serve_buffered(task: *Task, tls_data: *TlsTaskData, app: *Valet) -> i32
    var plaintext: [8192]u8
    var off: i64 = 0
    while tls_data.rx_len - off >= 5
        let rec_len: i64 = 5 + (((tls_data.rx[off + 3] as i64) << 8) | (tls_data.rx[off + 4] as i64))
        if rec_len > TLS_RX_CAP
            log_warn("TLS record too large")
            tls_task_data_free(tls_data)
            task.user_data = null
            return 1
        if tls_data.rx_len - off < rec_len
            break  # partial record: the rest is still on the wire
        let plaintext_len: i64 = tls_server_read(@tls_data.tls, @tls_data.rx[off], rec_len, @plaintext[0], 8192)
        if plaintext_len == TLS_SERVER_READ_CLOSED
            # The client's close_notify: nothing after it counts (RFC 8446
            # 6.1). A complete request before it is still answered below.
            off = tls_data.rx_len
            break
        if plaintext_len == TLS_SERVER_READ_ALERT
            log_warn("TLS alert from client, closing connection")
            tls_task_data_free(tls_data)
            task.user_data = null
            return 1
        if plaintext_len < 0
            log_warn("TLS decrypt failed")
            tls_task_data_free(tls_data)
            task.user_data = null
            return 1
        off = off + rec_len
        if tls_data.req_len + plaintext_len > TLS_REQ_CAP
            return valet_tls_send_413(task, tls_data)
        let req_buf: Span<u8> = @tls_data.req
        let decrypted: Span<u8> = @plaintext
        req_buf.from(tls_data.req_len).copy_from(decrypted.to(plaintext_len))
        tls_data.req_len = tls_data.req_len + plaintext_len
    if off > 0
        let rx: Span<u8> = @tls_data.rx
        rx.copy_from(rx.slice(off, tls_data.rx_len))
        tls_data.rx_len = tls_data.rx_len - off

    let req_len: i64 = tls_data.req_len

    # Where does the request end?  http's lib/h1_framing.ritz decides, as
    # for plain HTTP (AGAST #1865).  Incomplete: wait for more records.
    var f: H1Frame
    let total: i64 = request_frame(@tls_data.req[0], req_len as i32, TLS_REQ_CAP, @f)
    if total == H1F_TOO_LARGE or f.total > TLS_REQ_CAP
        return valet_tls_send_413(task, tls_data)
    if total < 0 and total != H1F_INCOMPLETE
        log_warn("TLS: bad request framing, closing connection")
        return valet_tls_send_error(task, tls_data, h1_frame_status(total))
    if total == H1F_INCOMPLETE
        # The client closed (AGAST #2197 item 4): a normal hangup, and the
        # rest of a partial request is never coming.
        if tls_data.tls.peer_closed != 0
            tls_task_data_free(tls_data)
            task.user_data = null
            return 0
        if req_len >= TLS_REQ_CAP
            return valet_tls_send_413(task, tls_data)
        let ret = tls_task_recv_app(task, tls_data)
        if ret < 0
            tls_task_data_free(tls_data)
            task.user_data = null
            return 1
        return -1

    # Parse HTTP request from the accumulated plaintext
    var req: Request
    request_init(@req)

    let parsed = request_parse(@req, @tls_data.req[0], total as i32)
    if parsed < 0
        log_warn("TLS: malformed HTTP request, closing connection")
        tls_task_data_free(tls_data)
        task.user_data = null
        return 0
    # A chunked body is decoded in place behind the headers.
    req.content_length = h1_frame_dechunk(@tls_data.req[0], @f)

    task.request_count += 1
    # See valet_handle_connection: close after this response unless
    # the client asked to persist (AGAST #2106).
    if valet_keep_alive(@req, task.request_count, app.keepalive_requests) == 0
        task.request_count = app.keepalive_requests

    # Build response
    var http_res: [4096]u8
    var res: Response
    response_init(@res, @http_res[0], 4096)

    # Set up handler context
    var handler_ctx: HandlerContext
    valet_ctx_enter(@handler_ctx, @req, @res, @tls_data.req[0], total as i32, task)

    # Run middleware
    let mw_result: i32 = router_run_middleware(@app.router, req.path.ptr, req.path.len as i32)
    if mw_result != MW_CONTINUE
        set_g_ctx(null)
    else
        # Try to match route
        var route_result: RouteMatch
        let matched: i32 = router_match(@app.router, req.method, req.path, @route_result)

        if matched == 1
            handler_ctx.route_result = @route_result
            let h: fn(*u8, i32) -> i32 = route_result.handler
            let status: i32 = h(req.path.ptr, req.path.len as i32)
            set_g_ctx(null)
            if status != 0 && res.len == 0
                response_status(@res, 500)
                response_header(@res, "Content-Type", "text/plain")
                let body: StrView = "Internal Server Error\n"
                response_content_length(@res, body.len)
                response_end_headers(@res)
                response_body(@res, body.as_bytes())
        else
            set_g_ctx(null)
            response_not_found(@res)

    # The request is answered: drop it, keeping any pipelined bytes behind it.
    let rest: i64 = req_len - total
    let req_buf: Span<u8> = @tls_data.req
    req_buf.copy_from(req_buf.slice(total, req_len))
    tls_data.req_len = rest

    # Encrypt and send response
    let encrypted_len: i64 = tls_server_write(@tls_data.tls, @http_res[0], res.len as i64, @task.write_buf[0], 8192)
    if encrypted_len <= 0
        log_error("TLS encrypt failed")
        tls_task_data_free(tls_data)
        task.user_data = null
        return 1

    task.write_len = encrypted_len as i32
    task.handler_state = TLS_CONN_STATE_SEND
    let ret = tls_task_send(task, tls_data, encrypted_len as i32)
    if ret < 0
        tls_task_data_free(tls_data)
        task.user_data = null
        return 1
    return -1


# Free the connection's TLS state and return `code` (the handler convention).
fn valet_tls_drop(task: *Task, tls_data: *TlsTaskData, code: i32) -> i32
    tls_task_data_free(tls_data)
    task.user_data = null
    return code


# Submit a handshake recv.  Returns the handler convention.
fn valet_tls_recv_or_drop(task: *Task, tls_data: *TlsTaskData) -> i32
    let ret = tls_task_recv(task, tls_data)
    if ret < 0
        return valet_tls_drop(task, tls_data, 1)
    return -1


# Submit an application-data recv.  Returns the handler convention.
fn valet_tls_recv_app_or_drop(task: *Task, tls_data: *TlsTaskData) -> i32
    let ret = tls_task_recv_app(task, tls_data)
    if ret < 0
        return valet_tls_drop(task, tls_data, 1)
    return -1


# Send `len` bytes of write_buf.  Returns the handler convention.
fn valet_tls_send_or_drop(task: *Task, tls_data: *TlsTaskData, len: i32) -> i32
    let ret = tls_task_send(task, tls_data, len)
    if ret < 0
        return valet_tls_drop(task, tls_data, 1)
    return -1


# A send of write_buf completed: count it, and if it was short send the
# rest of write_buf, from write_pos on.  VALET_CONN_NEXT when it is all out.
fn valet_tls_resume_send(task: *Task, tls_data: *TlsTaskData) -> i32
    task.write_pos = task.write_pos + task.io_result
    if task.write_pos < task.write_len
        if not tls_data.pool.submit_send_buf(task, Span<u8> { ptr: (@task.write_buf[task.write_pos]), len: (task.write_len - task.write_pos) as i64 })
            return valet_tls_drop(task, tls_data, 1)
        return -1
    return VALET_CONN_NEXT


# On first call (handler_state == 0), allocate TLS state and move to
# HANDSHAKE.  Null on failure.
fn valet_tls_init(task: *Task, app: *Valet) -> *TlsTaskData
    prints("[TLS] Allocating TLS state...\n")
    let tls_data: *TlsTaskData = tls_task_data_alloc()
    if tls_data == null
        prints("[TLS] ERROR: Allocation failed!\n")
        return null  # Allocation failed
    prints("[TLS] Setting pool pointer...\n")
    tls_data.pool = get_tls_pool()
    prints("[TLS] Calling tls_server_init...\n")
    if tls_server_init(@tls_data.tls, @app.tls_config) != 0
        # RNG failure: no ephemeral key, so no handshake (AGAST #1863)
        prints("[TLS] ERROR: tls_server_init failed (RNG)\n")
        tls_task_data_free(tls_data)
        task.user_data = null
        return null
    prints("[TLS] tls_server_init done\n")
    task.user_data = tls_data as *u8
    task.handler_state = TLS_CONN_STATE_HANDSHAKE
    # task.io_result stays TASK_IO_FRESH: the HANDSHAKE state below reads
    # that sentinel as "submit the ClientHello recv" (AGAST #2190).
    prints("[TLS] TLS state allocated, starting handshake\n")
    return tls_data


# State: HANDSHAKE_SEND - a handshake flight finished sending. io_result
# counts bytes sent, not received, so it must never reach the HANDSHAKE
# state, which would read it as a recv length (AGAST #2190).
fn valet_tls_handshake_sent(task: *Task, tls_data: *TlsTaskData) -> i32
    if task.io_result <= 0
        prints("[TLS] ERROR: handshake send failed\n")
        return valet_tls_drop(task, tls_data, 1)
    # Short send: the rest of the flight is still in write_buf, from
    # write_pos on, as in the SEND state (AGAST #3677). A big cert chain
    # or a small SO_SNDBUF cuts it short; the client can't answer a
    # flight it hasn't all got, so finish it before waiting on a recv.
    let r: i32 = valet_tls_resume_send(task, tls_data)
    if r != VALET_CONN_NEXT
        return r
    task.handler_state = TLS_CONN_STATE_HANDSHAKE
    return valet_tls_recv_or_drop(task, tls_data)


# The handshake is complete: move to RECV.  The first request can share a
# read with the client's Finished: serve it now, as no later recv will
# return it.  VALET_CONN_NEXT (io_result = its length) when buffered.
fn valet_tls_handshake_done(task: *Task, tls_data: *TlsTaskData) -> i32
    task.handler_state = TLS_CONN_STATE_RECV
    let buffered: i64 = tls_server_take_buffered(@tls_data.tls, @tls_data.rx[0], TLS_RX_CAP)
    if buffered == 0
        return valet_tls_recv_app_or_drop(task, tls_data)
    task.io_result = buffered as i32
    return VALET_CONN_NEXT


# Feed a received handshake record (io_result > 0 bytes) to TLS.
# VALET_CONN_NEXT to go on to the next state.
fn valet_tls_feed(task: *Task, tls_data: *TlsTaskData) -> i32
    let nbytes: i64 = task.io_result as i64
    print("[TLS] Processing {nbytes} bytes of TLS data\n")
    var out: [8192]u8
    var out_len: i64 = 0
    let result: i32 = tls_server_process(@tls_data.tls, @task.read_buf[0], task.io_result as i64, @out[0], 8192, @out_len)

    print("[TLS] tls_server_process returned {result}, out_len={out_len}\n")

    if result == TLS_RESULT_ERROR
        let tls_error: i64 = tls_server_error(@tls_data.tls) as i64
        print("[TLS] ERROR: Handshake error, tls_error={tls_error}\n")
        log_error("TLS handshake error")
        return valet_tls_drop(task, tls_data, 1)

    if result == TLS_RESULT_HAVE_OUTPUT
        # Send handshake response
        var i: i64 = 0
        while i < out_len
            task.write_buf[i] = out[i]
            i = i + 1
        task.write_len = out_len as i32
        task.handler_state = TLS_CONN_STATE_HANDSHAKE_SEND
        return valet_tls_send_or_drop(task, tls_data, out_len as i32)

    if result == TLS_RESULT_NEED_INPUT
        return valet_tls_recv_or_drop(task, tls_data)

    if result == TLS_RESULT_COMPLETE
        return valet_tls_handshake_done(task, tls_data)
    return VALET_CONN_NEXT


# State: HANDSHAKE - TLS negotiation. Every completion here is a recv.
# VALET_CONN_NEXT to go on to the next state.
fn valet_tls_handshake(task: *Task, tls_data: *TlsTaskData) -> i32
    let io_result: i64 = task.io_result as i64
    let tls_state: i64 = tls_server_state(@tls_data.tls) as i64
    print("[TLS] In HANDSHAKE state, io_result={io_result}, tls_state={tls_state}\n")

    # Need to receive data?
    if task.io_result == TASK_IO_FRESH
        prints("[TLS] Submitting recv for ClientHello...\n")
        let ret = tls_task_recv(task, tls_data)
        if ret < 0
            prints("[TLS] ERROR: recv submit failed\n")
            return valet_tls_drop(task, tls_data, 1)
        return -1

    # EOF (0) or error (<0): the client left mid-handshake. Resubmitting
    # the recv here would complete at once, forever.
    if task.io_result <= 0
        return valet_tls_drop(task, tls_data, 0)

    # Feed received data to TLS
    return valet_tls_feed(task, tls_data)


# State: RECV - receive encrypted application data.  Returns the handler
# convention.
fn valet_tls_recv_state(task: *Task, tls_data: *TlsTaskData, app: *Valet) -> i32
    if task.io_result == TASK_IO_FRESH
        # Fresh task — never submitted recv. Submit the initial recv now.
        return valet_tls_recv_app_or_drop(task, tls_data)

    if task.io_result <= 0
        # EOF (0) or error (<0) — connection done.
        return valet_tls_drop(task, tls_data, 0)

    # The recv landed behind the buffered ciphertext.
    tls_data.rx_len = tls_data.rx_len + task.io_result as i64
    return tls_serve_buffered(task, tls_data, app)


# Close TLS connection: send close_notify, and shut down only once it is
# out. The send is only queued here; a shutdown now beats it to the wire
# and the client sees a truncated stream (AGAST #2196).
fn valet_tls_close(task: *Task, tls_data: *TlsTaskData) -> i32
    var close_buf: [128]u8
    let close_len: i64 = tls_server_close(@tls_data.tls, @close_buf[0], 128)
    if close_len > 0
        var i: i64 = 0
        while i < close_len
            task.write_buf[i] = close_buf[i]
            i = i + 1
        task.handler_state = TLS_CONN_STATE_CLOSE_SEND
        if tls_task_send(task, tls_data, close_len as i32) == 0
            return -1

    var s: Socket = socket_from_raw(task.fd)
    s.shutdown(SHUT_WR)
    return valet_tls_drop(task, tls_data, 0)


# State: SEND - wait for send completion.  Returns the handler convention.
fn valet_tls_sent(task: *Task, tls_data: *TlsTaskData, app: *Valet) -> i32
    if task.io_result <= 0
        return valet_tls_drop(task, tls_data, 1)

    # Short send: the rest of the record is still in write_buf, from
    # write_pos on. Send it before anything else: a record cut short and
    # followed by the next one is garbage to the client (AGAST #2197
    # item 5). Nothing touches write_buf until the whole record is out.
    let r: i32 = valet_tls_resume_send(task, tls_data)
    if r != VALET_CONN_NEXT
        return r

    # Keep-alive
    if task.request_count < app.keepalive_requests
        task.handler_state = TLS_CONN_STATE_RECV
        task.io_result = 0
        # A pipelined request may already be buffered: no recv would
        # bring it, as the client is waiting on us.
        if tls_data.req_len > 0 or tls_data.rx_len > 0
            return tls_serve_buffered(task, tls_data, app)
        return valet_tls_recv_app_or_drop(task, tls_data)

    return valet_tls_close(task, tls_data)


# State: CLOSE_SEND - the close_notify alert finished sending. Finish a
# short send, then shut down. A failed send leaves nothing to wait for.
fn valet_tls_close_sent(task: *Task, tls_data: *TlsTaskData) -> i32
    if task.io_result > 0
        task.write_pos = task.write_pos + task.io_result
        if task.write_pos < task.write_len
            if tls_data.pool.submit_send_buf(task, Span<u8> { ptr: (@task.write_buf[task.write_pos]), len: (task.write_len - task.write_pos) as i64 })
                return -1
    var s: Socket = socket_from_raw(task.fd)
    s.shutdown(SHUT_WR)
    return valet_tls_drop(task, tls_data, 0)


pub fn valet_handle_tls_connection(task: *Task) -> i32
    prints("[TLS] handle_tls_connection called\n")
    let app: *Valet = get_g_app()
    var tls_data: *TlsTaskData = null

    # On first call (handler_state == 0), allocate TLS state
    # Note: spawn_task sets handler_state=0 and user_data=pool pointer,
    # so we can't use user_data==null for first-call detection
    if task.handler_state == TLS_CONN_STATE_INIT
        tls_data = valet_tls_init(task, app)
        if tls_data == null
            return 1
    else
        tls_data = task.user_data as *TlsTaskData

    if task.handler_state == TLS_CONN_STATE_HANDSHAKE_SEND
        return valet_tls_handshake_sent(task, tls_data)

    if task.handler_state == TLS_CONN_STATE_HANDSHAKE
        let r: i32 = valet_tls_handshake(task, tls_data)
        if r != VALET_CONN_NEXT
            return r

    if task.handler_state == TLS_CONN_STATE_RECV
        return valet_tls_recv_state(task, tls_data, app)

    if task.handler_state == TLS_CONN_STATE_SEND
        return valet_tls_sent(task, tls_data, app)

    if task.handler_state == TLS_CONN_STATE_CLOSE_SEND
        return valet_tls_close_sent(task, tls_data)

    return valet_tls_drop(task, tls_data, 0)


# Global TLS task pool pointer (set during valet_run when TLS is enabled)
var g_tls_pool_ptr: i64 = 0

pub fn get_tls_pool() -> *TaskPool
    return g_tls_pool_ptr as *TaskPool

pub fn set_tls_pool(pool: *TaskPool)
    g_tls_pool_ptr = pool as i64


# ============================================================================
# Shutdown hook for event loop
# ============================================================================

# Shutdown hook - checks global shutdown flag
# Returns non-zero to trigger server shutdown
pub fn valet_check_shutdown() -> i32
    return config_should_shutdown()


# ============================================================================
# Server startup
# ============================================================================

# True in a newly forked child; false in the parent, or if fork failed.
fn valet_forked_child() -> bool
    match fork()
        Ok(fr) =>
            match fr
                Child => true
                Parent(_) => false
        Err(_) => false

# Fork `workers` - 1 children that all serve the same listen socket. A child
# returns at once (it must not fork workers of its own); the parent forks them
# all. A failed fork leaves one worker fewer, as before.
fn valet_fork_workers(workers: i32)
    for i in 1..workers
        if valet_forked_child()
            return

pub fn valet_run(app: *Valet) -> i32
    # Set global app pointer for handler access
    set_g_app(app)

    # Create server socket
    var server: Socket
    match socket_tcp()
        Ok(sk) => server = sk
        Err(_) =>
            prints("Failed to create socket\n")
            return 1

    server.set_reuseaddr()
    server.set_reuseport()
    if app.sndbuf > 0
        server.set_opt_int(SOL_SOCKET, SO_SNDBUF, app.sndbuf)

    var bound: bool = false
    match server.bind("0.0.0.0", app.port)
        Ok(_) => bound = true
        Err(_) => bound = false
    if not bound
        print("Failed to bind to port {app.port}\n")
        server.close()
        return 1

    var listening: bool = false
    match server.listen(app.backlog)
        Ok(_) => listening = true
        Err(_) => listening = false
    if not listening
        prints("Failed to listen\n")
        server.close()
        return 1

    # The task server and the shutdown path below hold the bare descriptor.
    var server_fd: i32 = server.raw()

    # Fork workers
    if app.workers > 1
        valet_fork_workers(app.workers)

    let listen_pid: i64 = sys_getpid() as i64
    if app.tls_enabled != 0
        print("Valet HTTPS listening on port {app.port} (pid {listen_pid})\n")
    else
        print("Valet listening on port {app.port} (pid {listen_pid})\n")

    # Print registered routes
    prints("Routes:\n")
    router_debug(@app.router)
    prints("\n")

    # Create task server on the heap (too large for stack - ~4.5MB!)
    var srv: *TaskServer = null
    match task_server_create(server_fd)
        Some(s) => srv = s
        None =>
            prints("Failed to create task server\n")
            server.close()
            return 1

    srv.pool.ring = @srv.ring

    # Set up shutdown hook to check global shutdown flag
    srv.set_shutdown_hook(valet_check_shutdown)

    # Set idle timeout if configured
    if app.idle_timeout > 0
        srv.set_idle_timeout(app.idle_timeout)

    # Set max connections limit if configured
    if app.max_connections > 0
        srv.set_max_connections(app.max_connections)

    # Run event loop - use TLS handler if enabled
    var ret: i32
    if app.tls_enabled != 0
        # Store pool reference for TLS handler
        set_tls_pool(@srv.pool)
        if app.multishot != 0
            ret = srv.run_multishot(valet_handle_tls_connection)
        else
            ret = srv.run(valet_handle_tls_connection)
    else
        if app.multishot != 0
            ret = srv.run_multishot(valet_handle_connection)
        else
            ret = srv.run(valet_handle_connection)

    prints("Server shutting down...\n")
    srv.free()
    server.close()
    return ret
