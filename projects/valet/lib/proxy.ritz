# lib/proxy.ritz - Sizing and yield-backoff helpers for the zeus reverse proxy
#
# A zeus worker hands its response back as (offset, length) pairs into the
# per-slot shm arena: one for the pre-baked header block, one for the body.
# Those numbers come from another process, so valet validates them against
# the slot's bounds before reading a byte, and sizes its send buffer from
# them rather than assuming the 8 KB task write_buf.

import ritzlib.uring
import ritzlib.strview


# Is [off, off+len) inside [slot_start, slot_end)?  An empty range is always
# acceptable (workers leave offset 0 on empty headers/body).
fn proxy_range_ok(slot_start: i64, slot_end: i64, off: i64, len: i64) -> i32
    if len < 0
        return 0
    if len == 0
        return 1
    if off < slot_start or off > slot_end
        return 0
    if len > slot_end - off
        return 0
    return 1


# Total bytes (headers + body) of a proxied response, or -1 if either range
# falls outside the slot.  Offsets are GLOBAL arena offsets; the slot owns
# [slot_start, slot_end).
pub fn proxy_response_bytes(slot_start: i64, slot_end: i64, headers_off: i64, headers_len: i64, body_off: i64, body_len: i64) -> i64
    if proxy_range_ok(slot_start, slot_end, headers_off, headers_len) == 0
        return -1
    if proxy_range_ok(slot_start, slot_end, body_off, body_len) == 0
        return -1
    return headers_len + body_len


# ----------------------------------------------------------------------------
# Connection header (AGAST #2459)
#
# valet, not the worker, decides whether a connection survives a response: it
# closes after keepalive_requests responses and after a client's "Connection:
# close". The worker's header block always says keep-alive, and passing that
# through promised reuse valet then refused (every 100th proxied request was a
# client read error). So the worker's Connection line is dropped and valet's
# own is written.
# ----------------------------------------------------------------------------

# Most a header block can grow by: a "Connection: keep-alive\r\n" line added.
pub const PROXY_CONNECTION_EXTRA: i64 = 24


fn proxy_lower(c: u8) -> u8
    if c >= 'A' and c <= 'Z'
        return c + 32
    return c


# Is the line at `p` (length `len`, no CRLF) a Connection header?
fn proxy_is_connection_line(p: *u8, len: i64) -> i32
    let name: StrView = "connection:"
    if len < name.len
        return 0
    for i in 0..name.len
        if proxy_lower(*(p + i)) != name.get(i)
            return 0
    return 1


fn proxy_put(dst: *u8, cap: i64, pos: i64, src: *u8, n: i64) -> i64
    if pos + n > cap
        return -1
    for i in 0..n
        *(dst + pos + i) = *(src + i)
    return pos + n


fn proxy_put_str(dst: *u8, cap: i64, pos: i64, s: StrView) -> i64
    return proxy_put(dst, cap, pos, s.ptr, s.len)


# Copy the worker's header block `src[0..len)` ("status\r\n" + header lines,
# ended by an empty line) into `dst`, dropping every Connection line and
# ending with valet's own: "close" if `closing`, else "keep-alive".
# Returns the bytes written, or -1 if `cap` is too small.
pub fn proxy_copy_headers(dst: *u8, cap: i64, src: *u8, len: i64, closing: bool) -> i64
    var pos: i64 = 0
    var start: i64 = 0
    var first: i32 = 1
    while start < len
        # One line: [start, end), CRLF (or a bare end of block) after it.
        var end: i64 = start
        while end < len and *(src + end) != 10
            end += 1
        var text_end: i64 = end
        if text_end > start and *(src + text_end - 1) == 13
            text_end -= 1
        let next: i64 = if end < len then end + 1 else end
        if text_end == start
            break                       # the empty line: end of headers
        if first == 1 or proxy_is_connection_line(src + start, text_end - start) == 0
            pos = proxy_put(dst, cap, pos, src + start, text_end - start)
            if pos < 0
                return -1
            pos = proxy_put_str(dst, cap, pos, "\r\n")
            if pos < 0
                return -1
        first = 0
        start = next

    if closing
        pos = proxy_put_str(dst, cap, pos, "Connection: close\r\n\r\n")
    else
        pos = proxy_put_str(dst, cap, pos, "Connection: keep-alive\r\n\r\n")
    return pos


# ----------------------------------------------------------------------------
# Yield backoff (AGAST #183)
#
# A proxied request waits in CONN_STATE_PROXY_WAIT, re-arming a yield after
# every miss until the worker's response lands.  A NOP yield completes at
# once: with N waiters every event-loop pass was N NOP CQEs and N
# continuations, a hot spin (~950 continuations a request at c=50) that
# collapsed the proxy from 33k rps at c=20 to 0 at c=50.
#
# So the first PROXY_YIELD_NOPS yields stay NOPs (the common response lands
# within tens of microseconds and should not pay a timer's granularity), and
# later ones are IORING_OP_TIMEOUTs of PROXY_YIELD_MIN_US, doubling per yield
# up to PROXY_YIELD_MAX_US.  A waiter at the cap costs ~1k wakeups a second
# instead of ~100k: a request parked on a stalled worker took valet from
# ~90-100% of a core to 1-4% (AGAST #4297).
#
# Tuned on toffee (AGAST #4297): 2 NOPs cost c=1 ~25% (a ~45 µs response
# fell into a timer); 32 NOPs match the NOP-only baseline at c=1 and c=100.
# A 250 µs cap bought no measurable throughput and tripled idle-wait CPU.
# ----------------------------------------------------------------------------

pub const PROXY_YIELD_NOPS: i32 = 32
pub const PROXY_YIELD_MIN_US: i64 = 16
pub const PROXY_YIELD_MAX_US: i64 = 1000

# The kernel's answer to an IORING_OP_TIMEOUT it does not support.
const PROXY_EINVAL: i32 = -22


# Microseconds the `n`th yield (0-based) of one wait should sleep; 0 = NOP.
pub fn proxy_yield_delay_us(n: i32) -> i64
    if n < PROXY_YIELD_NOPS
        return 0
    var d: i64 = PROXY_YIELD_MIN_US
    var k: i32 = n - PROXY_YIELD_NOPS
    # Double until the cap; the loop ends within log2(MAX/MIN) steps, so a
    # huge `n` can neither overflow nor take long.
    while k > 0 and d < PROXY_YIELD_MAX_US
        d = d * 2
        k = k - 1
    if d > PROXY_YIELD_MAX_US
        return PROXY_YIELD_MAX_US
    return d


# A relative timespec of `us` microseconds.
pub fn proxy_yield_timespec(ts: *KernelTimespec, us: i64)
    ts.tv_sec = us / 1000000
    ts.tv_nsec = (us % 1000000) * 1000


# 1 when a yield's CQE result says the kernel refused the timer (-EINVAL,
# as WSL2 6.6 did): yield with NOPs from then on.  A fired timer gives
# -ETIME and a NOP 0, neither of which is a refusal.
pub fn proxy_yield_timer_rejected(io_result: i32) -> i32
    if io_result == PROXY_EINVAL
        return 1
    return 0
