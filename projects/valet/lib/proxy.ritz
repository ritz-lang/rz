# lib/proxy.ritz - Sizing helpers for the zeus reverse proxy (AGAST #2104)
#
# A zeus worker hands its response back as (offset, length) pairs into the
# per-slot shm arena: one for the pre-baked header block, one for the body.
# Those numbers come from another process, so valet validates them against
# the slot's bounds before reading a byte, and sizes its send buffer from
# them rather than assuming the 8 KB task write_buf.


# Is [off, off+len) inside [slot_start, slot_end)?  An empty range is always
# acceptable (workers leave offset 0 on empty headers/body).
fn proxy_range_ok(slot_start: i64, slot_end: i64, off: i64, len: i64) -> i32
    if len < 0
        return 0
    if len == 0
        return 1
    if off < slot_start or off > slot_end
        return 0
    if len > slot_end - off
        return 0
    return 1


# Total bytes (headers + body) of a proxied response, or -1 if either range
# falls outside the slot.  Offsets are GLOBAL arena offsets; the slot owns
# [slot_start, slot_end).
pub fn proxy_response_bytes(slot_start: i64, slot_end: i64, headers_off: i64, headers_len: i64, body_off: i64, body_len: i64) -> i64
    if proxy_range_ok(slot_start, slot_end, headers_off, headers_len) == 0
        return -1
    if proxy_range_ok(slot_start, slot_end, body_off, body_len) == 0
        return -1
    return headers_len + body_len
