# valet/lib/pool.ritz - Memory pool for efficient buffer reuse
#
# Provides a pool of fixed-size memory blocks that can be allocated and
# released without an allocation each time. Useful for high-performance
# servers where connection buffers are frequently allocated and released.
#
# Design:
#   - Fixed-size blocks (configurable at creation)
#   - One owned buffer holds every block, back to back; it is never grown,
#     so a block keeps its address (it can be handed to the kernel) until
#     it is released or the pool is dropped
#   - A stack of free block indices: O(1) alloc and release
#   - Thread-unsafe (designed for single-threaded event loops)
#
# A block is a Span<u8> into the pool: it must not outlive the pool, and
# using it after release() is a use after free. release() refuses a span
# that isn't a block of this pool in use, so a double release is caught.
#
# Usage:
#   var pool: MemPool = match pool_new(64, 8192)  # 64 blocks of 8KB each
#       Ok(p) => p
#       Err(e) => ...
#   match pool.alloc()
#       Some(buf) =>
#           # use buf...
#           pool.release(buf)
#       None => ...                              # exhausted
#   # the pool's memory is freed when `pool` goes out of scope

import ritzlib.gvec
import ritzlib.option
import ritzlib.result
import ritzlib.span

# ============================================================================
# Memory Pool structure
# ============================================================================

# Maximum number of blocks in a pool
const POOL_MAX_BLOCKS: i32 = 4096

pub enum PoolError
    BadCount        # block_count is not in 1..=POOL_MAX_BLOCKS
    BadSize         # block_size is under 8 bytes
    NoMem           # the blocks couldn't be allocated


pub struct MemPool
    mem: Vec<u8>        # block_count * block_size bytes, never grown
    free: Vec<i32>      # indices of the free blocks; the next alloc is last
    in_use: Vec<u8>     # 1 per block handed out and not released
    block_size: i32     # Size of each block in bytes (8-byte aligned)
    block_count: i32    # Total number of blocks


# ============================================================================
# Pool creation
# ============================================================================

# A pool of `block_count` blocks of `block_size` bytes (rounded up to a
# multiple of 8), every one free.
pub fn pool_new(block_count: i32, block_size: i32) -> Result<MemPool, PoolError>
    if block_count <= 0 || block_count > POOL_MAX_BLOCKS
        return Err(PoolError.BadCount)
    if block_size < 8
        return Err(PoolError.BadSize)

    # Align block_size to 8 bytes for proper alignment
    let aligned_size: i32 = (block_size + 7) & -8

    var pool: MemPool = MemPool {
        mem: vec_zeroed<u8>((block_count as i64) * (aligned_size as i64)),
        free: vec_with_cap<i32>(block_count as i64),
        in_use: vec_zeroed<u8>(block_count as i64),
        block_size: aligned_size,
        block_count: block_count
    }
    if pool.mem.len() == 0 or pool.in_use.len() == 0 or pool.free.cap() < block_count as i64
        return Err(PoolError.NoMem)
    pool.reset()
    return Ok(pool)


impl MemPool
    # ========================================================================
    # Allocation and release
    # ========================================================================

    # A free block, or None if the pool is exhausted. O(1).
    pub fn alloc(self: @&MemPool) -> Option<Span<u8>>
        if self.free.is_empty()
            return None
        let idx: i32 = self.free.pop()
        self.in_use.set(idx as i64, 1)
        return Some(self.block(idx))

    # Give `block` (from alloc) back to the pool. O(1). False, changing
    # nothing, if it isn't a block of this pool in use.
    pub fn release(self: @&MemPool, block: Span<u8>) -> bool
        let idx: i32 = match self.index_of(block)
            Some(i) => i
            None => return false
        if self.in_use.get(idx as i64) == 0
            return false
        self.in_use.set(idx as i64, 0)
        self.free.push(idx)
        return true

    # Mark every block free again: useful for batch processing where you
    # want to reuse the pool. Blocks handed out before are invalid after.
    pub fn reset(self: @&MemPool)
        self.free.clear()
        var i: i32 = self.block_count - 1
        while i >= 0
            self.free.push(i)  # block 0 is handed out first
            i -= 1
        let flags: Span<u8> = self.in_use[0..self.in_use.len()]
        flags.zero()

    # ========================================================================
    # Pool statistics
    # ========================================================================

    # Number of free blocks remaining
    pub fn available(self: @MemPool) -> i32
        return self.free.len() as i32

    # Total number of blocks in pool
    pub fn capacity(self: @MemPool) -> i32
        return self.block_count

    # Number of allocated (in-use) blocks
    pub fn used(self: @MemPool) -> i32
        return self.block_count - self.available()

    # The block size (8-byte aligned)
    pub fn block_size(self: @MemPool) -> i32
        return self.block_size

    # Whether `block` is one of this pool's blocks, in use or not.
    pub fn contains(self: @MemPool, block: Span<u8>) -> bool
        return self.index_of(block).is_some()

    # ========================================================================
    # Blocks
    # ========================================================================

    # Block `idx` of the pool's memory.
    fn block(self: @MemPool, idx: i32) -> Span<u8>
        let start: i64 = (idx as i64) * (self.block_size as i64)
        return self.mem[start..start + self.block_size as i64]

    # The index of `block` when it is exactly one of the pool's blocks.
    fn index_of(self: @MemPool, block: Span<u8>) -> Option<i32>
        let offset: i64 = (block.ptr as i64) - (self.mem.as_ptr() as i64)
        if offset < 0 or offset >= self.mem.len() or block.len != self.block_size as i64
            return None
        if offset % (self.block_size as i64) != 0
            return None
        return Some((offset / (self.block_size as i64)) as i32)


# ============================================================================
# Connection buffer pool
# ============================================================================
#
# Convenience wrapper for connection-oriented servers.
# Pre-allocates read/write buffer pairs.

pub const CONN_READ_BUF_SIZE: i32 = 8192
pub const CONN_WRITE_BUF_SIZE: i32 = 8192
const CONN_TOTAL_BUF_SIZE: i32 = 16384  # CONN_READ_BUF_SIZE + CONN_WRITE_BUF_SIZE

# One connection's buffers: the two halves of one pool block.
pub struct ConnBuffers
    block: Span<u8>

impl ConnBuffers
    # The first CONN_READ_BUF_SIZE bytes of the block
    pub fn read_buf(self: @ConnBuffers) -> Span<u8>
        return self.block.to(CONN_READ_BUF_SIZE as i64)

    # The CONN_WRITE_BUF_SIZE bytes after read_buf
    pub fn write_buf(self: @ConnBuffers) -> Span<u8>
        return self.block.from(CONN_READ_BUF_SIZE as i64)


# Connection buffer pool - manages paired read/write buffers
pub struct ConnBufferPool
    pool: MemPool


# A connection buffer pool for up to `max_connections` connections
pub fn conn_pool_new(max_connections: i32) -> Result<ConnBufferPool, PoolError>
    match pool_new(max_connections, CONN_TOTAL_BUF_SIZE)
        Ok(p) => Ok(ConnBufferPool { pool: p })
        Err(e) => Err(e)


impl ConnBufferPool
    # Buffers for a new connection, or None when every slot is taken
    pub fn alloc(self: @&ConnBufferPool) -> Option<ConnBuffers>
        match self.pool.alloc()
            Some(block) => Some(ConnBuffers { block: block })
            None => None

    # Give a closed connection's buffers back.  False if they aren't this
    # pool's, in use.
    pub fn release(self: @&ConnBufferPool, bufs: ConnBuffers) -> bool
        return self.pool.release(bufs.block)

    # Number of available connection slots
    pub fn available(self: @ConnBufferPool) -> i32
        return self.pool.available()

    # Total connection capacity
    pub fn capacity(self: @ConnBufferPool) -> i32
        return self.pool.capacity()
