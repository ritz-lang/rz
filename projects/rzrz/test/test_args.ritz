# test_args.ritz - parse_args (src/args.ritz) on real argv vectors.
#
# Every test builds an argv, calls parse_args, and returns 1 on any
# mismatch. These used to assert constants against themselves and never
# call parse_args (AGAST #2790).

import ritzlib.cstr
import ritzlib.fmt
import ritzlib.span { Span, span_from_ptr }
import ritzlib.strview { StrView }
import src.args

fn fail(name: StrView) -> i32
    print("FAIL: {name}\n")
    1

# Whether a parsed positional (an argv pointer, NUL-terminated; null if
# absent) is set and reads `want`.
fn same(got: *u8, want: StrView) -> bool
    if got == null
        return false
    strview_from_cstr(got).eq(want)

# parse_args with argv = ["rzrz", a1, a2, ...]; a null ends the list.
fn parse5(a1: *u8, a2: *u8, a3: *u8, a4: *u8, a5: *u8) -> Args
    var raw: [5]*u8
    raw[0] = a1
    raw[1] = a2
    raw[2] = a3
    raw[3] = a4
    raw[4] = a5
    var argv: [6]StrView
    argv[0] = "rzrz"
    var n: i64 = 1
    var i: i32 = 0
    while i < 5 and raw[i] != null
        argv[n] = strview_from_cstr(raw[i])
        n += 1
        i += 1
    parse_args(span_from_ptr<StrView>(@argv[0], n))

fn command_of(a1: *u8) -> i32
    let args: Args = parse5(a1, null, null, null, null)
    args.command

[[test]]
fn test_parse_no_args() -> i32
    let args: Args = parse5(null, null, null, null, null)
    if args.command != CMD_HELP
        return fail("no args -> CMD_HELP")
    if args.project != null or args.all_projects != 0 or args.release_mode != 0
        return fail("no args -> empty Args")
    0

[[test]]
fn test_parse_each_command() -> i32
    if command_of(c"build") != CMD_BUILD
        return fail("build")
    if command_of(c"test") != CMD_TEST
        return fail("test")
    if command_of(c"run") != CMD_RUN
        return fail("run")
    if command_of(c"list") != CMD_LIST
        return fail("list")
    if command_of(c"clean") != CMD_CLEAN
        return fail("clean")
    if command_of(c"--help") != CMD_HELP or command_of(c"-h") != CMD_HELP
        return fail("--help/-h")
    if command_of(c"--version") != CMD_VERSION or command_of(c"-V") != CMD_VERSION
        return fail("--version/-V")
    0

[[test]]
fn test_parse_unknown_command() -> i32
    if command_of(c"bogus") != CMD_NONE
        return fail("unknown -> CMD_NONE")
    0

[[test]]
fn test_parse_project_and_flags() -> i32
    let args: Args = parse5(c"build", c"--release", c"sage", c"--all", null)
    if args.command != CMD_BUILD
        return fail("flags: command")
    if not same(args.project, "sage")
        return fail("flags: project")
    if args.all_projects != 1
        return fail("flags: --all")
    if args.release_mode != 1
        return fail("flags: --release")
    if args.rest_index != 0
        return fail("flags: no -- means rest_index 0")
    0

[[test]]
fn test_parse_no_flags() -> i32
    let args: Args = parse5(c"test", c"sage", null, null, null)
    if not same(args.project, "sage")
        return fail("no flags: project")
    if args.all_projects != 0 or args.release_mode != 0
        return fail("no flags: flags stay 0")
    0

[[test]]
fn test_parse_compare_is_unknown() -> i32
    # `./rz compare` was deleted as dead code (AGAST #1836), so rzrz no
    # longer forwards to it: `compare` is an unknown command.
    if command_of(c"compare") != CMD_NONE
        return fail("compare -> CMD_NONE")
    0

[[test]]
fn test_parse_double_dash_stops_parsing() -> i32
    # rzrz run p -- x --all : argv[3] is "--", the rest is the program's.
    let args: Args = parse5(c"run", c"p", c"--", c"x", c"--all")
    if not same(args.project, "p")
        return fail("--: project")
    if args.rest_index != 4
        return fail("--: rest_index is the index after --")
    if args.all_projects != 0
        return fail("--: --all after -- is not ours")
    if args.tier != null
        return fail("--: x after -- is not a tier")
    0
