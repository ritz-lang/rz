# rzrz - the Ritz workspace CLI, written in Ritz.
#
# Usage:
#     rzrz build [PROJECT]          Build a project (or all with --all)
#     rzrz test [PROJECT]           Test a project (or all with --all)
#     rzrz run PROJECT [-- ARGS]    Build and run a project
#     rzrz list                     List all projects in workspace
#     rzrz clean [PROJECT]          Remove a project's build/ (or all with --all)
#     rzrz compare [TIER]           ritz0 vs ritz1 dashboard over example TIER
#
# Everything except list/--help/--version delegates to `python3 ./rz <cmd>`
# in the current directory and exits with its status (AGAST #2790).

import ritzlib.sys
import ritzlib.io
import ritzlib.str
import ritzlib.fs
import ritzlib.string
import ritzlib.strview
import ritzlib.process
import ritzlib.gvec
import ritzlib.os.env
import src.args

# ============================================================================
# Commands
# ============================================================================

fn print_help()
    prints_cstr("rz - Unified workspace CLI for the Ritz ecosystem\n")
    prints_cstr("\n")
    prints_cstr("Usage:\n")
    prints_cstr("    rz build [PROJECT]          Build a project (or all with --all)\n")
    prints_cstr("    rz test [PROJECT]           Test a project (or all with --all)\n")
    prints_cstr("    rz run PROJECT [-- ARGS]    Build and run a project\n")
    prints_cstr("    rz list                     List all projects in workspace\n")
    prints_cstr("    rz clean [PROJECT]          Remove build artifacts (or all with --all)\n")
    prints_cstr("    rz compare [TIER]           Compare ritz0 vs ritz1 on example TIER\n")
    prints_cstr("\n")
    prints_cstr("Options:\n")
    prints_cstr("    --all                       Apply to all projects\n")
    prints_cstr("    --release                   Build with release profile\n")
    prints_cstr("    --help, -h                  Show this help message\n")
    prints_cstr("    --version, -V               Show version information\n")
    prints_cstr("\n")
    prints_cstr("build/test/run/clean/compare run `python3 ./rz` (build, test and\n")
    prints_cstr("run with --compiler ritz1) from the workspace root.\n")

fn print_version()
    prints_cstr("rz 0.1.0 (ritz1 bootstrap)\n")

fn cmd_list() -> i32
    # List all projects in the projects/ directory
    var dir: DirIter = dir_open("projects")

    if dir_valid(@dir) == 0
        eprints_cstr("Error: Could not open projects directory\n")
        return 1

    prints_cstr("Workspace: rz\n")
    prints_cstr("Projects:\n\n")

    var count: i32 = 0
    while dir_next(@dir) != 0
        let name: *u8 = dir_entry_name(@dir)

        # Skip . and ..
        if strcmp(name, c".") == 0 or strcmp(name, c"..") == 0
            continue

        # Skip if not a directory
        if dir_entry_is_dir(@dir) == 0
            continue

        # Check if ritz.toml exists in this subdirectory
        var proj: String = path_join("projects", strview_from_cstr(name))
        var toml: String = path_join(string_as_view(@proj), "ritz.toml")
        let has_toml: bool = path_exists(string_as_view(@toml))
        string_drop(@&proj)
        string_drop(@&toml)

        if has_toml
            prints_cstr("  ")
            prints_cstr(name)
            prints_cstr("\n")
            count += 1

    dir_close(@dir)

    prints_cstr("\n")
    print_int(count as i64)
    prints_cstr(" projects found\n")
    0

# `python3 ./rz <cmd>`: the start of every argv handed to delegate().
fn rz_argv(cmd: *u8) -> Vec<*u8>
    var v: Vec<*u8> = vec_new<*u8>()
    vec_push<*u8>(@&v, c"python3")
    vec_push<*u8>(@&v, c"./rz")
    vec_push<*u8>(@&v, cmd)
    v

# Run argv (from rz_argv) with OUR stdin/stdout/stderr, then drop it, and
# return the child's exit status (128+N if killed by signal N). Inherited
# stdio, not pipes: `run` may start an interactive program, and draining
# two pipes in turn can deadlock once the unread one fills.
#
# Callers build the whole argv, so nothing here indexes through
# `vec_as_ptr(...) + i`: ritz1 does not scale that (AGAST #2791).
fn delegate(argv: @&Vec<*u8>) -> i32
    vec_push<*u8>(argv, null)

    # Resolved before fork: both may allocate.
    let envp: **u8 = env_raw_envp()
    var path_buf: [4096]u8
    var cmd_path: *u8 = find_command_in_path(c"python3", @path_buf[0], 4096)
    if cmd_path == null
        cmd_path = c"python3"

    let pid: i32 = sys_fork()
    if pid < 0
        vec_drop<*u8>(argv)
        eprints_cstr("Error: Could not spawn python3 ./rz\n")
        return 1
    if pid == 0
        sys_execve(cmd_path, vec_as_ptr<*u8>(argv), envp)
        sys_exit(127)

    vec_drop<*u8>(argv)
    var status: i32 = 0
    if sys_wait4(pid, @status, 0, null) < 0
        eprints_cstr("Error: Could not wait for python3 ./rz\n")
        return 1
    let sig: i32 = status & 127
    if sig == 0
        return (status / 256) & 255
    128 + sig

# `--compiler ritz1`: rzrz is the third matrix column, so the compiles it
# drives MUST go through ritz1, not the default ritz0. See
# docs/STACK_MATRIX.md.
fn push_ritz1(v: @&Vec<*u8>)
    vec_push<*u8>(v, c"--compiler")
    vec_push<*u8>(v, c"ritz1")

fn need_project(args: Args, allow_all: i32) -> i32
    if args.project != null
        return 0
    if allow_all != 0 and args.all_projects != 0
        return 0
    if allow_all != 0
        eprints_cstr("Error: Specify a project or use --all\n")
    else
        eprints_cstr("Error: Specify a project\n")
    1

# `<cmd> <project>` or `<cmd> --all`, then `--compiler ritz1` if with_ritz1.
fn delegate_project(cmd: *u8, args: Args, with_ritz1: i32) -> i32
    if need_project(args, 1) != 0
        return 1
    var v: Vec<*u8> = rz_argv(cmd)
    if args.project != null
        vec_push<*u8>(@&v, args.project)
    else
        vec_push<*u8>(@&v, c"--all")
    if with_ritz1 != 0
        push_ritz1(@&v)
    delegate(@&v)

fn cmd_test(args: Args) -> i32
    delegate_project(c"test", args, 1)

fn cmd_clean(args: Args) -> i32
    # ./rz clean takes no --compiler.
    delegate_project(c"clean", args, 0)

fn cmd_run(args: Args, argc: i32, argv: **u8) -> i32
    if need_project(args, 0) != 0
        return 1
    var v: Vec<*u8> = rz_argv(c"run")
    vec_push<*u8>(@&v, args.project)
    push_ritz1(@&v)
    if args.release_mode != 0
        vec_push<*u8>(@&v, c"--release")
    if args.rest_index != 0
        vec_push<*u8>(@&v, c"--")
        var i: i32 = args.rest_index
        while i < argc
            vec_push<*u8>(@&v, argv[i])
            i += 1
    delegate(@&v)

fn cmd_compare(args: Args) -> i32
    # The first positional is the tier; ./rz defaults it to tier1.
    var v: Vec<*u8> = rz_argv(c"compare")
    if args.project != null
        vec_push<*u8>(@&v, args.project)
    delegate(@&v)

fn cmd_build(args: Args) -> i32
    if need_project(args, 1) != 0
        return 1

    if args.all_projects == 1
        # Build all projects
        var dir: DirIter = dir_open("projects")
        if dir_valid(@dir) == 0
            eprints_cstr("Error: Could not open projects directory\n")
            return 1

        var failed_count: i32 = 0
        var success_count: i32 = 0

        while dir_next(@dir) != 0
            let name: *u8 = dir_entry_name(@dir)

            # Skip . and ..
            if strcmp(name, c".") == 0 or strcmp(name, c"..") == 0
                continue

            # Skip if not a directory
            if dir_entry_is_dir(@dir) == 0
                continue

            # Check if ritz.toml exists
            var proj: String = path_join("projects", strview_from_cstr(name))
            var toml: String = path_join(string_as_view(@proj), "ritz.toml")
            let has_toml: bool = path_exists(string_as_view(@toml))
            string_drop(@&proj)
            string_drop(@&toml)

            if has_toml
                if build_project(name, args.release_mode) != 0
                    failed_count += 1
                else
                    success_count += 1

        dir_close(@dir)

        print_int(success_count as i64)
        prints_cstr(" projects built successfully")
        if failed_count > 0
            prints_cstr(", ")
            print_int(failed_count as i64)
            prints_cstr(" failed")
        prints_cstr("\n")

        if failed_count > 0
            return 1
        return 0

    # Build single project
    return build_project(args.project, args.release_mode)

# python3 ./rz build <project> --compiler ritz1 [--release]
fn build_project(name: *u8, release: i32) -> i32
    prints_cstr("Building: ")
    prints_cstr(name)
    prints_cstr("\n")

    var v: Vec<*u8> = rz_argv(c"build")
    vec_push<*u8>(@&v, name)
    push_ritz1(@&v)
    if release != 0
        vec_push<*u8>(@&v, c"--release")
    delegate(@&v)

# ============================================================================
# Main
# ============================================================================

fn main(argc: i32, argv: **u8) -> i32
    let args: Args = parse_args(argc, argv)

    if args.command == CMD_HELP
        print_help()
        return 0
    if args.command == CMD_VERSION
        print_version()
        return 0
    if args.command == CMD_LIST
        return cmd_list()
    if args.command == CMD_BUILD
        return cmd_build(args)
    if args.command == CMD_TEST
        return cmd_test(args)
    if args.command == CMD_RUN
        return cmd_run(args, argc, argv)
    if args.command == CMD_CLEAN
        return cmd_clean(args)
    if args.command == CMD_COMPARE
        return cmd_compare(args)

    # CMD_NONE: parse_args already named the unknown command.
    eprints_cstr("Run 'rzrz --help' for usage\n")
    2
