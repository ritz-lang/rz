# rzrz - the Ritz workspace CLI, written in Ritz.
#
# Usage:
#     rzrz build [PROJECT]          Build a project (or all with --all)
#     rzrz test [PROJECT]           Test a project (or all with --all)
#     rzrz run PROJECT [-- ARGS]    Build and run a project
#     rzrz list                     List all projects in workspace
#     rzrz clean [PROJECT]          Remove a project's build/ (or all with --all)
#
# Everything except list/--help/--version delegates to `python3 ./rz <cmd>`
# in the current directory and exits with its status (AGAST #2790).

import ritzlib.cstr
import ritzlib.sys
import ritzlib.fmt
import ritzlib.fs
import ritzlib.string
import ritzlib.strview
import ritzlib.span { Span }
import ritzlib.option
import ritzlib.process
import ritzlib.gvec
import src.args

# ============================================================================
# Commands
# ============================================================================

fn print_help()
    print("rz - Unified workspace CLI for the Ritz ecosystem\n")
    print("\n")
    print("Usage:\n")
    print("    rz build [PROJECT]          Build a project (or all with --all)\n")
    print("    rz test [PROJECT]           Test a project (or all with --all)\n")
    print("    rz run PROJECT [-- ARGS]    Build and run a project\n")
    print("    rz list                     List all projects in workspace\n")
    print("    rz clean [PROJECT]          Remove build artifacts (or all with --all)\n")
    print("\n")
    print("Options:\n")
    print("    --all                       Apply to all projects\n")
    print("    --release                   Build with release profile\n")
    print("    --help, -h                  Show this help message\n")
    print("    --version, -V               Show version information\n")
    print("\n")
    print("build/test/run/clean run `python3 ./rz` (build, test and\n")
    print("run with --compiler ritz1) from the workspace root.\n")

fn print_version()
    print("rz 0.1.0 (ritz1 bootstrap)\n")

fn cmd_list() -> i32
    # List all projects in the projects/ directory
    var dir: DirIter = match dir_open("projects")
        Ok(d) => d
        Err(_) =>
            eprint("Error: Could not open projects directory\n")
            return 1

    print("Workspace: rz\n")
    print("Projects:\n\n")

    var count: i32 = 0
    while dir.next()
        let entry: DirEntry = dir.entry()
        let name: StrView = entry.name

        # Skip . and ..
        if name.eq(".") or name.eq("..")
            continue

        # Skip if not a directory
        if not dir.entry_is_dir()
            continue

        # Check if ritz.toml exists in this subdirectory
        var proj: String = path_join("projects", name)
        var toml: String = path_join(proj.as_view(), "ritz.toml")
        let has_toml: bool = path_exists(toml.as_view())

        if has_toml
            print("  {name}\n")
            count += 1

    dir.close()

    print("\n{count} projects found\n")
    0

# `python3 ./rz <cmd>`: the start of every argv handed to delegate().
fn rz_argv(cmd: *u8) -> Vec<*u8>
    var v: Vec<*u8> = vec_new<*u8>()
    v.push(c"python3")
    v.push(c"./rz")
    v.push(cmd)
    v

# Run argv (from rz_argv) with OUR stdin/stdout/stderr, then drop it, and
# return the child's exit status (128+N if killed by signal N). Inherited
# stdio, not pipes: `run` may start an interactive program, and draining
# two pipes in turn can deadlock once the unread one fills.
#
# Callers build the whole argv, so nothing here indexes through
# `vec_as_ptr(...) + i`: ritz1 does not scale that (AGAST #2791).
fn delegate(argv: @&Vec<*u8>) -> i32
    var views: Vec<StrView> = vec_new<StrView>()
    for i in 0..argv.len
        views.push(strview_from_cstr(argv.get(i)))

    # Resolved before fork: all of it may allocate.  python3 is found through
    # $PATH (or the standard dirs without one); not found, execve fails and
    # the child exits 127.
    var cmd: String = string_new()
    match find_command("python3")
        Some(found) => cmd = found
        None => cmd.push_str("python3")
    var ex: Exec = match exec_prepare(cmd.as_view(), Span<StrView> { ptr: views.as_ptr(), len: views.len })
        Ok(e) => e
        Err(_) =>
            eprint("Error: Could not spawn python3 ./rz\n")
            return 1

    var pid: i32 = 0
    match fork()
        Ok(side) =>
            match side
                Child =>
                    # The arrays were built before fork: the child allocates
                    # nothing.
                    ex.run()
                    sys_exit(127)
                Parent(child) => pid = child
        Err(_) =>
            ex.free()
            eprint("Error: Could not spawn python3 ./rz\n")
            return 1
    ex.free()

    # exit_code is already 128+N for a child killed by signal N.
    match wait_pid(pid)
        Ok(r) => r.exit_code
        Err(_) =>
            eprint("Error: Could not wait for python3 ./rz\n")
            1

# `--compiler ritz1`: rzrz is the third matrix column, so the compiles it
# drives MUST go through ritz1, not the default ritz0. See
# docs/STACK_MATRIX.md.
fn push_ritz1(v: @&Vec<*u8>)
    v.push(c"--compiler")
    v.push(c"ritz1")

fn need_project(args: Args, allow_all: i32) -> i32
    if args.project != null
        return 0
    if allow_all != 0 and args.all_projects != 0
        return 0
    if allow_all != 0
        eprint("Error: Specify a project or use --all\n")
    else
        eprint("Error: Specify a project\n")
    1

# `<cmd> <project>` or `<cmd> --all`, then `--compiler ritz1` if with_ritz1.
fn delegate_project(cmd: *u8, args: Args, with_ritz1: i32) -> i32
    if need_project(args, 1) != 0
        return 1
    var v: Vec<*u8> = rz_argv(cmd)
    if args.project != null
        v.push(args.project)
    else
        v.push(c"--all")
    if with_ritz1 != 0
        push_ritz1(@&v)
    delegate(@&v)

fn cmd_test(args: Args) -> i32
    delegate_project(c"test", args, 1)

fn cmd_clean(args: Args) -> i32
    # ./rz clean takes no --compiler.
    delegate_project(c"clean", args, 0)

fn cmd_run(args: Args, all: Span<StrView>) -> i32
    if need_project(args, 0) != 0
        return 1
    var v: Vec<*u8> = rz_argv(c"run")
    v.push(args.project)
    push_ritz1(@&v)
    if args.release_mode != 0
        v.push(c"--release")
    if args.rest_index != 0
        v.push(c"--")
        var i: i64 = args.rest_index as i64
        while i < all.len
            v.push(all[i].as_ptr())
            i += 1
    delegate(@&v)

fn cmd_build(args: Args) -> i32
    if need_project(args, 1) != 0
        return 1

    if args.all_projects == 1
        # Build all projects
        var dir: DirIter = match dir_open("projects")
            Ok(d) => d
            Err(_) =>
                eprint("Error: Could not open projects directory\n")
                return 1

        var failed_count: i32 = 0
        var success_count: i32 = 0

        while dir.next()
            let entry: DirEntry = dir.entry()
            let name: StrView = entry.name

            # Skip . and ..
            if name.eq(".") or name.eq("..")
                continue

            # Skip if not a directory
            if not dir.entry_is_dir()
                continue

            # Check if ritz.toml exists
            var proj: String = path_join("projects", name)
            var toml: String = path_join(proj.as_view(), "ritz.toml")
            let has_toml: bool = path_exists(toml.as_view())

            if has_toml
                # A dirent name is NUL-terminated in the getdents buffer,
                # so its ptr goes into the execve argv as is.
                if build_project(name.as_ptr(), args.release_mode) != 0
                    failed_count += 1
                else
                    success_count += 1

        dir.close()

        if failed_count > 0
            print("{success_count} projects built successfully, {failed_count} failed\n")
        else
            print("{success_count} projects built successfully\n")

        if failed_count > 0
            return 1
        return 0

    # Build single project
    return build_project(args.project, args.release_mode)

# python3 ./rz build <project> --compiler ritz1 [--release]
fn build_project(name: *u8, release: i32) -> i32
    print("Building: {name}\n")

    var v: Vec<*u8> = rz_argv(c"build")
    v.push(name)
    push_ritz1(@&v)
    if release != 0
        v.push(c"--release")
    delegate(@&v)

# ============================================================================
# Main
# ============================================================================

pub fn main(args: Span<StrView>) -> i32
    let parsed: Args = parse_args(args)

    if parsed.command == CMD_HELP
        print_help()
        return 0
    if parsed.command == CMD_VERSION
        print_version()
        return 0
    if parsed.command == CMD_LIST
        return cmd_list()
    if parsed.command == CMD_BUILD
        return cmd_build(parsed)
    if parsed.command == CMD_TEST
        return cmd_test(parsed)
    if parsed.command == CMD_RUN
        return cmd_run(parsed, args)
    if parsed.command == CMD_CLEAN
        return cmd_clean(parsed)

    # CMD_NONE: parse_args already named the unknown command.
    eprint("Run 'rzrz --help' for usage\n")
    2
