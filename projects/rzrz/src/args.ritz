# args.ritz - rzrz command-line parsing.
#
# Kept apart from main.ritz so test/test_args.ritz can call parse_args
# directly (AGAST #2790).

import ritzlib.sys
import ritzlib.io
import ritzlib.str

# ============================================================================
# Command Enum
# ============================================================================

const CMD_NONE: i32 = 0
const CMD_BUILD: i32 = 1
const CMD_TEST: i32 = 2
const CMD_RUN: i32 = 3
const CMD_LIST: i32 = 4
const CMD_CLEAN: i32 = 5
const CMD_COMPARE: i32 = 6
const CMD_HELP: i32 = 7
const CMD_VERSION: i32 = 8

# ============================================================================
# Argument Parsing
# ============================================================================

struct Args
    command: i32
    project: *u8        # first positional (for `compare`, the tier)
    all_projects: i32
    release_mode: i32
    tier: *u8           # second positional
    rest_index: i32     # argv index just past a `--`; 0 if there was none

fn parse_args(argc: i32, argv: **u8) -> Args
    var args: Args
    args.command = CMD_HELP
    args.project = null
    args.all_projects = 0
    args.release_mode = 0
    args.tier = null
    args.rest_index = 0

    if argc < 2
        return args

    # Parse command
    let cmd: *u8 = argv[1]

    if strcmp(cmd, c"build") == 0
        args.command = CMD_BUILD
    else if strcmp(cmd, c"test") == 0
        args.command = CMD_TEST
    else if strcmp(cmd, c"run") == 0
        args.command = CMD_RUN
    else if strcmp(cmd, c"list") == 0
        args.command = CMD_LIST
    else if strcmp(cmd, c"clean") == 0
        args.command = CMD_CLEAN
    else if strcmp(cmd, c"compare") == 0
        args.command = CMD_COMPARE
    else if strcmp(cmd, c"--help") == 0 or strcmp(cmd, c"-h") == 0
        args.command = CMD_HELP
    else if strcmp(cmd, c"--version") == 0 or strcmp(cmd, c"-V") == 0
        args.command = CMD_VERSION
    else
        # Unknown command: an error, never help-and-exit-0 (#2460)
        eprints_cstr("Error: Unknown command '")
        eprints_cstr(cmd)
        eprints_cstr("'\n")
        args.command = CMD_NONE

    # Parse remaining arguments
    var i: i32 = 2
    while i < argc
        let arg: *u8 = argv[i]

        if strcmp(arg, c"--") == 0
            # Everything after `--` belongs to the program `run` starts.
            args.rest_index = i + 1
            return args
        else if strcmp(arg, c"--all") == 0
            args.all_projects = 1
        else if strcmp(arg, c"--release") == 0
            args.release_mode = 1
        else if *(arg + 0) != 45  # Not starting with '-'
            if args.project == null
                args.project = arg
            else if args.tier == null
                args.tier = arg

        i += 1

    args
