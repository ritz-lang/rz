# args.ritz - rzrz command-line parsing.
#
# Kept apart from main.ritz so test/test_args.ritz can call parse_args
# directly (AGAST #2790).

import ritzlib.fmt
import ritzlib.span { Span }
import ritzlib.strview { StrView }

# ============================================================================
# Command Enum
# ============================================================================

const CMD_NONE: i32 = 0
const CMD_BUILD: i32 = 1
const CMD_TEST: i32 = 2
const CMD_RUN: i32 = 3
const CMD_LIST: i32 = 4
const CMD_CLEAN: i32 = 5
# 6 was CMD_COMPARE: `./rz compare` was deleted as dead code (AGAST #1836).
const CMD_HELP: i32 = 7
const CMD_VERSION: i32 = 8

# ============================================================================
# Argument Parsing
# ============================================================================

struct Args
    command: i32
    project: *u8        # first positional
    all_projects: i32
    release_mode: i32
    tier: *u8           # second positional
    rest_index: i32     # argv index just past a `--`; 0 if there was none

# `all` includes the program name at [0]. Path options stay `*u8`: they are
# handed to execve, and an argv StrView is NUL-terminated.
pub fn parse_args(all: Span<StrView>) -> Args
    var args: Args
    args.command = CMD_HELP
    args.project = null
    args.all_projects = 0
    args.release_mode = 0
    args.tier = null
    args.rest_index = 0

    if all.len < 2
        return args

    # Parse command
    let cmd: StrView = all[1]

    if cmd.eq("build")
        args.command = CMD_BUILD
    else if cmd.eq("test")
        args.command = CMD_TEST
    else if cmd.eq("run")
        args.command = CMD_RUN
    else if cmd.eq("list")
        args.command = CMD_LIST
    else if cmd.eq("clean")
        args.command = CMD_CLEAN
    else if cmd.eq("--help") or cmd.eq("-h")
        args.command = CMD_HELP
    else if cmd.eq("--version") or cmd.eq("-V")
        args.command = CMD_VERSION
    else
        # Unknown command: an error, never help-and-exit-0 (#2460)
        eprint("Error: Unknown command '{cmd}'\n")
        args.command = CMD_NONE

    # Parse remaining arguments
    var i: i64 = 2
    while i < all.len
        let arg: StrView = all[i]

        if arg.eq("--")
            # Everything after `--` belongs to the program `run` starts.
            args.rest_index = (i + 1) as i32
            return args
        else if arg.eq("--all")
            args.all_projects = 1
        else if arg.eq("--release")
            args.release_mode = 1
        else if arg.len == 0 or arg.get(0) != 45  # Not starting with '-'
            if args.project == null
                args.project = arg.as_ptr()
            else if args.tier == null
                args.tier = arg.as_ptr()

        i += 1

    args
