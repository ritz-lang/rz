import lib.config { Config }

# HTTP method constants (mirror http.types)
const METHOD_GET: i32 = 1
const METHOD_POST: i32 = 2

## Request lifecycle state.
pub enum RequestState
    Pending
    Connecting
    Sending
    Receiving
    Complete
    Error

## An HTTP request.
pub struct Request
    id: u64
    method: i32
    url: String
    headers: Vec<Header>
    body: Vec<u8>
    state: RequestState

## Header name/value pair.
pub struct Header
    name: String
    value: String

## An HTTP response.
pub struct Response
    status: i32
    headers: Vec<Header>
    body: Vec<u8>

## Network manager for handling HTTP requests.
pub struct NetworkManager
    # Connection pool: one bucket per host, found by linear scan.
    # ritzlib has no generic HashMap (AGAST #1858), and a browser holds a
    # handful of hosts at once, so a Vec of buckets is enough.
    connections: Vec<HostPool>
    # Cookie jar: one bucket per domain, same shape as the pool.
    cookies: Vec<CookieJar>
    # Pending requests
    pending: Vec<Request>
    # Next request ID
    next_id: u64

# A pooled connection
struct Connection
    socket: Socket
    host: String
    port: i32
    is_tls: i32
    in_use: i32

# All pooled connections to one host
struct HostPool
    host: String
    conns: Vec<Connection>

# All cookies for one domain
struct CookieJar
    domain: String
    cookies: Vec<Cookie>

# A cookie
struct Cookie
    name: String
    value: String
    domain: String
    path: String
    expires: i64
    secure: i32
    http_only: i32

## Create network manager.
pub fn network_manager_new(config: Config) -> NetworkManager
    var nm: NetworkManager
    nm.connections = vec_new<HostPool>()
    nm.cookies = vec_new<CookieJar>()
    nm.pending = vec_new<Request>()
    nm.next_id = 1
    return nm

# ============================================================================
# Request API
# ============================================================================

## Create a GET request. Returns request ID.
pub fn network_get(nm:& NetworkManager, url: StrView) -> u64
    var req: Request
    req.id = nm.next_id
    nm.next_id += 1
    req.method = METHOD_GET
    req.url = string_from_strview(url)
    req.headers = vec_new<Header>()
    req.body = vec_new<u8>()
    req.state = Pending

    let req_id = req.id
    vec_push<Request>(@&nm.pending, req)
    return req_id

## Create a POST request. Returns request ID.
pub fn network_post(nm:& NetworkManager, url: StrView, body: Vec<u8>) -> u64
    var req: Request
    req.id = nm.next_id
    nm.next_id += 1
    req.method = METHOD_POST
    req.url = string_from_strview(url)
    req.headers = vec_new<Header>()
    req.body = body
    req.state = Pending

    let req_id = req.id
    vec_push<Request>(@&nm.pending, req)
    return req_id

