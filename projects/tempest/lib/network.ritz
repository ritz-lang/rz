# A Connection to `host`, or Err(errno) if its socket can't be created.
fn connect_to_host(host: String, port: i32, use_tls: i32) -> Result<Connection, Errno>
    let s = match socket_tcp()
        Ok(s) => s
        Err(e) => return Err(e)

    # TODO: Resolve hostname to IP
    # TODO: Connect socket
    # TODO: TLS handshake if use_tls

    Ok(Connection {
        socket: s,
        host: host,
        port: port,
        is_tls: use_tls,
        in_use: 1
    })

fn release_connection(nm:& NetworkManager, conn:& Connection)
    conn.in_use = 0
    # Return to pool for reuse

# ============================================================================
# Connection pool and cookie jar buckets
# ============================================================================

## Index of the pool bucket for `host`, or -1 if there is none.
fn find_host_pool(nm: @NetworkManager, host: StrView) -> i64
    var i: i64 = 0
    while i < vec_len<HostPool>(@nm.connections)
        let pool = vec_as_ptr<HostPool>(@nm.connections) + i
        if string_eq_strview(@pool.host, host)
            return i
        i += 1
    return -1

## Index of the cookie bucket for `domain`, or -1 if there is none.
fn find_cookie_jar(nm: @NetworkManager, domain: StrView) -> i64
    var i: i64 = 0
    while i < vec_len<CookieJar>(@nm.cookies)
        let jar = vec_as_ptr<CookieJar>(@nm.cookies) + i
        if string_eq_strview(@jar.domain, domain)
            return i
        i += 1
    return -1

## Number of hosts with a pool bucket.
pub fn network_host_count(nm: @NetworkManager) -> i64
    return vec_len<HostPool>(@nm.connections)

## Number of domains with a cookie bucket.
pub fn network_domain_count(nm: @NetworkManager) -> i64
    return vec_len<CookieJar>(@nm.cookies)

## Number of pooled connections to `host`.
pub fn network_pool_size(nm: @NetworkManager, host: StrView) -> i64
    let idx = find_host_pool(nm, host)
    if idx < 0
        return 0
    let pool = vec_as_ptr<HostPool>(@nm.connections) + idx
    return vec_len<Connection>(@pool.conns)

## Number of cookies stored for `domain`.
pub fn network_cookie_count(nm: @NetworkManager, domain: StrView) -> i64
    let idx = find_cookie_jar(nm, domain)
    if idx < 0
        return 0
    let jar = vec_as_ptr<CookieJar>(@nm.cookies) + idx
    return vec_len<Cookie>(@jar.cookies)

## Open a connection to `host` and add it to that host's pool bucket.
## Err(errno) if its socket can't be created (the bucket exists either way).
pub fn network_pool_add(nm:& NetworkManager, host: StrView, port: i32, use_tls: i32) -> Result<(), Errno>
    var idx = find_host_pool(@nm, host)
    if idx < 0
        var pool: HostPool
        pool.host = string_from_strview(host)
        pool.conns = vec_new<Connection>()
        vec_push<HostPool>(@&nm.connections, pool)
        idx = vec_len<HostPool>(@nm.connections) - 1
    let conn: Connection = connect_to_host(string_from_strview(host), port, use_tls)?
    let pool = vec_get_ptr<HostPool>(@&nm.connections, idx)
    vec_push<Connection>(@&pool.conns, conn)
    Ok(())

## Store a cookie in `domain`'s bucket.
pub fn network_set_cookie(nm:& NetworkManager, domain: StrView, name: StrView, value: StrView)
    var idx = find_cookie_jar(@nm, domain)
    if idx < 0
        var jar: CookieJar
        jar.domain = string_from_strview(domain)
        jar.cookies = vec_new<Cookie>()
        vec_push<CookieJar>(@&nm.cookies, jar)
        idx = vec_len<CookieJar>(@nm.cookies) - 1
    var c: Cookie
    c.name = string_from_strview(name)
    c.value = string_from_strview(value)
    c.domain = string_from_strview(domain)
    c.path = string_from("/")
    c.expires = 0
    c.secure = 0
    c.http_only = 0
    let jar = vec_get_ptr<CookieJar>(@&nm.cookies, idx)
    vec_push<Cookie>(@&jar.cookies, c)
