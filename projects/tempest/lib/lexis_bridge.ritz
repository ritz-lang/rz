# lib/lexis_bridge.ritz - Interface to Lexis HTML/CSS Parser
#
# Lexis parses HTML and CSS, emitting events that Tempest uses
# to construct the DOM tree. Lexis also handles CSS cascade
# to produce ComputedStyle values.
#
# Design: Streaming/incremental parsing. Lexis processes chunks
# of HTML as they arrive from the network.

import ritzlib.strview { StrView }
import ritzlib.gvec { Vec, vec_new }
import lib.document { NodeId }
import lexis.dom.tag { Tag }
import lexis.dom.attribute { Attribute }
import lexis.css.rule { Stylesheet }
import lib.iris_bridge { ComputedStyle }
import lexis.event { EventSink, ElementStartEvent, ElementEndEvent, TextEvent, CommentEvent, DoctypeEvent, ParseErrorEvent, ParseWarningEvent }
import lexis.lexis { html_parser_new, html_parser_run, css_parse }

# ============================================================================
# Parse Events - Lexis → Tempest
# ============================================================================

## Events emitted by Lexis during HTML parsing.
pub enum ParseEvent
    # Document structure
    DocumentStart
    DocumentEnd

    # Element events
    ElementStart
        tag: Tag
        attributes: Vec<Attribute>

    ElementEnd
        tag: Tag

    # Text content
    Text
        content: StrView

    # Comments (usually ignored)
    Comment
        content: StrView

    # DOCTYPE
    Doctype
        name: StrView
        public_id: StrView
        system_id: StrView

    # Errors
    ParseError
        message: StrView
        line: u32
        column: u32

# ElementStart's attributes are lexis's `Attribute` (name/value StrViews).

# ============================================================================
# CSS Events - Lexis → Tempest
# ============================================================================

## Style computation result for a node.
pub struct StyleResult
    node_id: NodeId
    style: ComputedStyle

# ============================================================================
# Lexis Parser Interface
# ============================================================================

## HTML parser state: the events lexis has emitted and not yet handed out.
## A FIFO from two stacks: the sink pushes onto `inbox` in parse order, and
## lexis_poll_event pops `outbox`, refilling it from `inbox` (which reverses
## it) when it runs dry. A ParseEvent owns a Vec, so it can only be moved
## out with pop; Vec.get would copy it.
pub struct LexisParser
    inbox: Vec<ParseEvent>
    outbox: Vec<ParseEvent>
    complete: i32           # 1 once a DocumentEnd has been queued
    # Error callback stream (for debug console)
    error_count: i32

## Create a new HTML parser.
pub fn lexis_parser_new() -> LexisParser
    var parser: LexisParser
    parser.inbox = vec_new<ParseEvent>()
    parser.outbox = vec_new<ParseEvent>()
    parser.complete = 0
    parser.error_count = 0
    return parser

## Lexis's event sink for one parse: queues each event on the LexisParser it
## borrows. Lexis's parser is generic over its sink (`HtmlParser<S:
## EventSink>`, LARB R55), so these calls resolve at compile time; there is
## no fn-pointer table and no `*u8` context to cast back (R80).
pub struct LexisSink
    parser:& LexisParser

impl EventSink for LexisSink
    fn on_document_start(self:&)
        self.parser.inbox.push(ParseEvent.DocumentStart)

    fn on_document_end(self:&)
        self.parser.inbox.push(ParseEvent.DocumentEnd)
        self.parser.complete = 1

    fn on_element_start(self:&, event: @ElementStartEvent)
        var attributes = vec_new<Attribute>()
        var i: u32 = 0
        while i < event.attr_count
            attributes.push(event.attrs[i])
            i = i + 1
        self.parser.inbox.push(ParseEvent.ElementStart(event.tag, attributes))

    fn on_element_end(self:&, event: @ElementEndEvent)
        self.parser.inbox.push(ParseEvent.ElementEnd(event.tag))

    fn on_text(self:&, event: @TextEvent)
        self.parser.inbox.push(ParseEvent.Text(event.content))

    fn on_comment(self:&, event: @CommentEvent)
        self.parser.inbox.push(ParseEvent.Comment(event.content))

    fn on_doctype(self:&, event: @DoctypeEvent)
        self.parser.inbox.push(ParseEvent.Doctype(event.name, event.public_id, event.system_id))

    fn on_error(self:&, event: @ParseErrorEvent)
        self.parser.error_count = self.parser.error_count + 1
        self.parser.inbox.push(ParseEvent.ParseError(event.message, event.line, event.col))

    fn on_warning(self:&, event: @ParseWarningEvent)
        pass

## Feed HTML data to parser. Lexis parses `data` and the events queue on
## `parser`. Returns number of events ready to poll.
pub fn lexis_feed(parser:& LexisParser, data: StrView) -> i32
    var hp = html_parser_new(data, LexisSink { parser: @&parser })
    html_parser_run(hp)
    (parser.inbox.len() + parser.outbox.len()) as i32

## Poll for next parse event.
pub fn lexis_poll_event(parser:& LexisParser) -> Option<ParseEvent>
    if parser.outbox.is_empty()
        while not parser.inbox.is_empty()
            parser.outbox.push(parser.inbox.pop())
    if parser.outbox.is_empty()
        return None
    Some(parser.outbox.pop())

## Check if parsing is complete.
pub fn lexis_is_complete(parser: @LexisParser) -> i32
    return parser.complete

## Get parse error count.
pub fn lexis_error_count(parser: @LexisParser) -> i32
    return parser.error_count

# ============================================================================
# CSS Stylesheet Interface
# ============================================================================

## Parse a CSS stylesheet (lexis's Stylesheet; free it with lexis's
## stylesheet_free).
pub fn lexis_parse_css(css: StrView) -> Stylesheet
    css_parse(css)

# ============================================================================
# Style Computation Interface
# ============================================================================

## CSS style computation engine.
pub struct StyleComputer
    # Stylesheets in cascade order
    stylesheets: Vec<Stylesheet>
    # User-agent stylesheet (built-in defaults)
    ua_stylesheet: Stylesheet

## Create style computer.
pub fn style_computer_new() -> StyleComputer
    var computer: StyleComputer
    computer.stylesheets = vec_new<Stylesheet>()
    # TODO: Load UA stylesheet
    return computer

## Add stylesheet to cascade.
pub fn style_add_stylesheet(computer:& StyleComputer, sheet: Stylesheet)
    computer.stylesheets.push(sheet)

## Compute style for a node.
## Takes node info + inherited style, returns computed style.
pub fn style_compute(computer: StyleComputer, tag: Tag, attributes: Vec<Attribute>, inherited: ComputedStyle) -> ComputedStyle
    var style: ComputedStyle
    # TODO: Call into Lexis style computation
    # - Apply UA stylesheet
    # - Apply author stylesheets
    # - Apply inline styles
    # - Resolve inheritance
    return style

