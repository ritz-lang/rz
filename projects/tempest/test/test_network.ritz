# test/test_network.ritz - Network manager tests
#
# AGAST #3609: lib/network.ritz used a generic HashMap that ritzlib does not
# have, so nothing that imports it compiled. The connection pool and cookie
# jar are now Vecs of per-host / per-domain buckets. These tests pin that
# bucket behaviour: one bucket per key, found again by key, kept apart from
# other keys.
#
# Written in RERITZ syntax.

import ritzlib.strview
import ritzlib.string
import lib.config
import lib.network

[[test]]
fn test_network_manager_new_is_empty() -> i32
    var nm = network_manager_new(config_default())
    if network_host_count(@nm) != 0
        return 1
    if network_domain_count(@nm) != 0
        return 2
    if network_pool_size(@nm, "example.com") != 0
        return 3
    if network_cookie_count(@nm, "example.com") != 0
        return 4
    0

[[test]]
fn test_pool_buckets_by_host() -> i32
    var nm = network_manager_new(config_default())
    network_pool_add(@&nm, "a.example", 443, 1)
    network_pool_add(@&nm, "b.example", 80, 0)
    network_pool_add(@&nm, "a.example", 443, 1)
    # Two hosts, not three: the second a.example joins the first bucket.
    if network_host_count(@nm) != 2
        return 1
    if network_pool_size(@nm, "a.example") != 2
        return 2
    if network_pool_size(@nm, "b.example") != 1
        return 3
    if network_pool_size(@nm, "c.example") != 0
        return 4
    0

[[test]]
fn test_cookie_jar_buckets_by_domain() -> i32
    var nm = network_manager_new(config_default())
    network_set_cookie(@&nm, "a.example", "sid", "1")
    network_set_cookie(@&nm, "a.example", "theme", "dark")
    network_set_cookie(@&nm, "b.example", "sid", "2")
    if network_domain_count(@nm) != 2
        return 1
    if network_cookie_count(@nm, "a.example") != 2
        return 2
    if network_cookie_count(@nm, "b.example") != 1
        return 3
    0
