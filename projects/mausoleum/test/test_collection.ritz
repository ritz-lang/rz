# ============================================================================
# Document Get Tests
# ============================================================================

[[test]]
fn test_collection_get() -> i32
    var pool_opt = buffer_pool_new(64)
    if option_is_none<*BufferPool>(@pool_opt) == 1
        return 10
    var pool: *BufferPool = option_unwrap_or<*BufferPool>(@pool_opt, null)
    var col: Collection
    collection_init(@col, pool, 1)

    # Insert a document with fields
    var doc: Document
    var id: DocumentId = doc_id_invalid()
    doc_init(@doc, @id)

    var f: Field = field_int(99)
    doc_set_field(@doc, "value", @f)

    var new_id: DocumentId
    collection_insert(@col, @doc, @new_id)

    # Retrieve it
    var retrieved: Document
    var retrieved_buf: [2048]u8
    var result: i32 = collection_get(@col, @new_id, @retrieved, @retrieved_buf[0], 2048)
    if result != ERR_OK
        return 1

    # Check the field is there
    var rf: Field
    if doc_get_field(@retrieved, "value", @rf) != ERR_OK
        return 2
    if field_as_int(@rf) != 99
        return 3
    0

[[test]]
fn test_collection_get_not_found() -> i32
    var pool_opt = buffer_pool_new(64)
    if option_is_none<*BufferPool>(@pool_opt) == 1
        return 10
    var pool: *BufferPool = option_unwrap_or<*BufferPool>(@pool_opt, null)
    var col: Collection
    collection_init(@col, pool, 1)

    var id: DocumentId = doc_id_new(1, 999)
    var doc: Document
    var doc_buf: [2048]u8
    var result: i32 = collection_get(@col, @id, @doc, @doc_buf[0], 2048)
    if result != ERR_NOT_FOUND
        return 1
    0

[[test]]
fn test_collection_get_multiple() -> i32
    var pool_opt = buffer_pool_new(64)
    if option_is_none<*BufferPool>(@pool_opt) == 1
        return 10
    var pool: *BufferPool = option_unwrap_or<*BufferPool>(@pool_opt, null)
    var col: Collection
    collection_init(@col, pool, 1)

    # Insert several documents
    var doc1: Document
    var doc2: Document
    var doc3: Document
    var tmp_id: DocumentId = doc_id_invalid()

    doc_init(@doc1, @tmp_id)
    var f1: Field = field_int(100)
    doc_set_field(@doc1, "n", @f1)

    doc_init(@doc2, @tmp_id)
    var f2: Field = field_int(200)
    doc_set_field(@doc2, "n", @f2)

    doc_init(@doc3, @tmp_id)
    var f3: Field = field_int(300)
    doc_set_field(@doc3, "n", @f3)

    var id1: DocumentId
    var id2: DocumentId
    var id3: DocumentId
    collection_insert(@col, @doc1, @id1)
    collection_insert(@col, @doc2, @id2)
    collection_insert(@col, @doc3, @id3)

    # Retrieve each and verify
    var r1: Document
    var r2: Document
    var r3: Document
    var r1_buf: [2048]u8
    collection_get(@col, @id1, @r1, @r1_buf[0], 2048)
    var r2_buf: [2048]u8
    collection_get(@col, @id2, @r2, @r2_buf[0], 2048)
    var r3_buf: [2048]u8
    collection_get(@col, @id3, @r3, @r3_buf[0], 2048)

    var rf1: Field
    var rf2: Field
    var rf3: Field
    doc_get_field(@r1, "n", @rf1)
    doc_get_field(@r2, "n", @rf2)
    doc_get_field(@r3, "n", @rf3)

    if field_as_int(@rf1) != 100
        return 1
    if field_as_int(@rf2) != 200
        return 2
    if field_as_int(@rf3) != 300
        return 3
    0

[[test]]
fn test_collection_get_null_collection() -> i32
    var id: DocumentId = doc_id_new(1, 1)
    var doc: Document
    var doc_buf: [2048]u8
    var result: i32 = collection_get(null, @id, @doc, @doc_buf[0], 2048)
    if result != ERR_INVALID
        return 1
    0

# ============================================================================
# Document Update Tests
# ============================================================================

[[test]]
fn test_collection_update() -> i32
    var pool_opt = buffer_pool_new(64)
    if option_is_none<*BufferPool>(@pool_opt) == 1
        return 10
    var pool: *BufferPool = option_unwrap_or<*BufferPool>(@pool_opt, null)
    var col: Collection
    collection_init(@col, pool, 1)

    # Insert
    var doc: Document
    var id: DocumentId = doc_id_invalid()
    doc_init(@doc, @id)
    var f: Field = field_int(10)
    doc_set_field(@doc, "x", @f)

    var new_id: DocumentId
    collection_insert(@col, @doc, @new_id)

    # Update
    var f2: Field = field_int(20)
    doc_set_field(@doc, "x", @f2)
    # doc.id was already set by collection_insert via out_id

    var result: i32 = collection_update(@col, @doc)
    if result != ERR_OK
        return 1

    # Verify update
    var retrieved: Document
    var retrieved_buf: [2048]u8
    collection_get(@col, @doc.id, @retrieved, @retrieved_buf[0], 2048)
    var rf: Field
    doc_get_field(@retrieved, "x", @rf)
    if field_as_int(@rf) != 20
        return 2
    0

[[test]]
fn test_collection_update_not_found() -> i32
    var pool_opt = buffer_pool_new(64)
    if option_is_none<*BufferPool>(@pool_opt) == 1
        return 10
    var pool: *BufferPool = option_unwrap_or<*BufferPool>(@pool_opt, null)
    var col: Collection
    collection_init(@col, pool, 1)

    var doc: Document
    var id: DocumentId = doc_id_new(1, 999)
    doc_init(@doc, @id)

    var result: i32 = collection_update(@col, @doc)
    if result != ERR_NOT_FOUND
        return 1
    0

