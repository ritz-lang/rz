# test/test_cliarg.ritz - range-checked integer arguments (AGAST #4039)
#
# main.ritz's parse_int and the tools' parse_int_arg accumulated digits into
# an i32 unchecked: "2147483648" wrapped to i32's minimum, and they skipped
# non-digits, so "12x" read as 12 and "abc" as 0.  They now go through
# cliarg_parse_i32, a range check over ritzlib's strview_parse_i64.

import ritzlib.strview

import lib.cliarg

[[test]]
fn test_parse_i64_in_takes_the_whole_i64_range() -> i32
    let min: i64 = -9223372036854775807 - 1
    var v: i64 = 7
    if cliarg_parse_i64_in("-9223372036854775808", min, 9223372036854775807, @v) != 1 or v != min
        return 1
    if cliarg_parse_i64_in("9223372036854775807", min, 9223372036854775807, @v) != 1 or v != 9223372036854775807
        return 2
    if cliarg_parse_i64_in("0", min, 9223372036854775807, @v) != 1 or v != 0
        return 3
    return 0

[[test]]
fn test_parse_i64_in_rejects_overflow_and_junk_and_keeps_out() -> i32
    let min: i64 = -9223372036854775807 - 1
    var v: i64 = 7
    if cliarg_parse_i64_in("9223372036854775808", min, 9223372036854775807, @v) != 0
        return 1
    if cliarg_parse_i64_in("-9223372036854775809", min, 9223372036854775807, @v) != 0
        return 2
    if cliarg_parse_i64_in("12x", min, 9223372036854775807, @v) != 0
        return 3
    if cliarg_parse_i64_in("", min, 9223372036854775807, @v) != 0
        return 4
    if v != 7
        return 5
    return 0

[[test]]
fn test_parse_i64_in_checks_both_bounds() -> i32
    var v: i64 = 7
    if cliarg_parse_i64_in("10", 0, 10, @v) != 1 or v != 10
        return 1
    if cliarg_parse_i64_in("0", 0, 10, @v) != 1 or v != 0
        return 2
    if cliarg_parse_i64_in("11", 0, 10, @v) != 0
        return 3
    if cliarg_parse_i64_in("-1", 0, 10, @v) != 0
        return 4
    if v != 0
        return 5
    return 0

[[test]]
fn test_parse_i32_extremes() -> i32
    var v: i32 = 7
    if cliarg_parse_i32(c"-2147483648", @v) != 1 or v != -2147483647 - 1
        return 1
    if cliarg_parse_i32(c"2147483647", @v) != 1 or v != 2147483647
        return 2
    if cliarg_parse_i32(c"0", @v) != 1 or v != 0
        return 3
    if cliarg_parse_i32(c"7777", @v) != 1 or v != 7777
        return 4
    return 0

[[test]]
fn test_parse_i32_rejects_what_the_old_loop_wrapped_or_skipped() -> i32
    var v: i32 = 7
    # The old loop: 2147483648 -> i32 min, i64 max -> -1, "12x" -> 12, "abc" -> 0.
    if cliarg_parse_i32(c"2147483648", @v) != 0
        return 1
    if cliarg_parse_i32(c"-2147483649", @v) != 0
        return 2
    if cliarg_parse_i32(c"9223372036854775807", @v) != 0
        return 3
    if cliarg_parse_i32(c"9223372036854775808", @v) != 0
        return 4
    if cliarg_parse_i32(c"12x", @v) != 0
        return 5
    if cliarg_parse_i32(c"abc", @v) != 0
        return 6
    if cliarg_parse_i32(c"", @v) != 0
        return 7
    if v != 7
        return 8
    return 0
