# test/test_integration.ritz - End-to-end client/server tests
#
# The only end-to-end coverage of lib.client against the real server binary.
# Each [[test]] fork+execs ./build/debug/mausoleum (CWD is the package dir;
# `rz test mausoleum` builds the binary before running tests) as
#
#   mausoleum serve --no-encryption --port <port>
#
# with an in-memory store (no --data-dir, so nothing touches disk), waits in
# a bounded retry loop until the server completes a real protocol handshake,
# runs its checks, then SIGKILLs and reaps the server on every path.
#
# The port is derived from the test process's pid; if the server exits
# early (e.g. the port is taken) the next port is tried. The child also sets
# PR_SET_PDEATHSIG so it cannot outlive a test process that dies abruptly.
#
# Exit codes: 90-93 = server could not be started / never became ready;
# anything else identifies the failing step inside the test.

import ritzlib.cstr
import ritzlib.fmt.digits { fmt_i64_into }
import ritzlib.sys
import ritzlib.fd
import ritzlib.process { fork, exec, kill, wait_pid, try_wait_pid, process_id }
import ritzlib.time { sleep_ms }
import ritzlib.span
import ritzlib.result
import ritzlib.option
import ritzlib.box
import ritzlib.strview
import ritzlib.fs { access }
import ritzlib.str
import ritzlib.memory
import ritzlib.gvec
import ritzlib.net

import lib.m7m_types
import lib.protocol
import lib.client
import lib.document
import lib.collection

# The first n bytes of buffer `b`.
fn head(b: [u8], n: i64) -> [u8]
    return b[0..n]

const PORT_BASE: i32 = 20000
const PORT_SPAN: i32 = 30000
const PORT_ATTEMPTS: i32 = 5
const READY_POLLS: i32 = 200        # x 50ms = 10s max wait per attempt
const OP_TIMEOUT_MS: i32 = 5000     # bound every request/response
const PR_SET_PDEATHSIG: i64 = 1
const SIG_KILL: i32 = 9
const WAIT_NOHANG: i32 = 1

fn server_bin() -> StrView
    return "./build/debug/mausoleum"

struct TestServer
    pid: i32
    port: i32
    mode: i32       # SERVE_*: which serve loop the server runs

# The four serve loops (src/main.ritz cmd_serve).
const SERVE_ASYNC: i32 = 0              # the default: --no-encryption
const SERVE_ASYNC_ENCRYPTED: i32 = 1
const SERVE_SERIAL: i32 = 2             # --serial --no-encryption
const SERVE_SERIAL_ENCRYPTED: i32 = 3

fn mode_encrypted(mode: i32) -> bool
    mode == SERVE_ASYNC_ENCRYPTED or mode == SERVE_SERIAL_ENCRYPTED

# client_connect, or client_connect_encrypted for an encrypted loop.
fn connect_mode(client: *Client, mode: i32, port: i32) -> i32
    if mode_encrypted(mode)
        return client_connect_encrypted(client, "127.0.0.1", port, "test")
    client_connect(client, "127.0.0.1", port, "test")

# ============================================================================
# Server lifecycle helpers
# ============================================================================

# Whether the built server binary is there and executable.
fn access_ok(bin: StrView) -> bool
    match access(bin, X_OK)
        Ok(_) => true
        Err(_) => false

# fork+exec the server on `port` with stdio on /dev/null. Returns child pid
# or < 0 on failure.
fn spawn_server(port: i32, mode: i32) -> i32
    var port_buf: [20]u8
    let port_str: StrView = fmt_i64_into(@port_buf, port as i64)

    # argv[1..]; exec makes argv[0] the binary's path.
    var args: [5]StrView
    var nargs: i64 = 0
    args[nargs] = "serve"
    nargs += 1
    if not mode_encrypted(mode)
        args[nargs] = "--no-encryption"
        nargs += 1
    if mode == SERVE_SERIAL or mode == SERVE_SERIAL_ENCRYPTED
        args[nargs] = "--serial"
        nargs += 1
    args[nargs] = "--port"
    args[nargs + 1] = port_str
    nargs += 2

    match fork()
        Ok(fr) =>
            match fr
                Parent(child) => return child
                Child => pass
        Err(e) => return -e.code()

    # Child: die with the test process, keep the harness's stdout clean.
    syscall2(SYS_PRCTL, PR_SET_PDEATHSIG, SIG_KILL as i64)
    match fd_open("/dev/null", O_RDWR, 0)
        Ok(f) =>
            var devnull: Fd = f
            devnull.dup_to(0)
            devnull.dup_to(1)
            devnull.dup_to(2)
            if devnull.raw() > 2
                devnull.close()
        Err(_) => pass
    let argv: [StrView] = @args
    exec(server_bin(), argv[0..nargs])
    sys_exit(127)
    return -1

fn server_kill(pid: i32)
    if pid <= 0
        return
    kill(pid, SIG_KILL)
    wait_pid(pid)

# 1 if the child has already exited (and was reaped), else 0.
fn server_exited(pid: i32) -> i32
    match try_wait_pid(pid)
        Ok(o) =>
            match o
                Some(_) => return 1
                None => return 0
        Err(_) => return 0

# Poll until the server answers a full CONNECT handshake.
# 0 = ready, 1 = server exited (try another port), 2 = timed out.
fn wait_ready(srv: *TestServer) -> i32
    var i: i32 = 0
    while i < READY_POLLS
        if server_exited(srv.pid) == 1
            srv.pid = 0
            return 1
        var probe_owner: Box<Client> = client_new()
        let probe: *Client = probe_owner.as_ptr()
        if probe != null
            let rc: i32 = connect_mode(probe, srv.mode, srv.port)
            if rc == 0
                client_disconnect(probe)
                client_free(probe)
                return 0
            client_free(probe)
        sleep_ms(50)
        i += 1
    return 2

# Start a server and wait until it is ready. 0 on success, 90-93 on failure.
# On failure no server process is left behind.
fn server_start(srv: *TestServer) -> i32
    server_start_mode(srv, SERVE_ASYNC)

fn server_start_mode(srv: *TestServer, mode: i32) -> i32
    srv.mode = mode
    srv.pid = 0
    srv.port = 0
    if not access_ok(server_bin())
        return 90   # binary not built
    let base: i32 = PORT_BASE + (process_id() % PORT_SPAN)
    var attempt: i32 = 0
    while attempt < PORT_ATTEMPTS
        srv.port = base + attempt * 7
        if srv.port >= 65000
            srv.port = srv.port - PORT_SPAN
        srv.pid = spawn_server(srv.port, srv.mode)
        if srv.pid < 0
            srv.pid = 0
            return 91   # fork failed
        let r: i32 = wait_ready(srv)
        if r == 0
            return 0
        if r == 2
            server_kill(srv.pid)
            srv.pid = 0
            return 92   # never became ready
        attempt += 1
    return 93   # server exited on every port tried

fn server_stop(srv: *TestServer)
    server_kill(srv.pid)
    srv.pid = 0

# Connect a fresh client with bounded request timeouts; null on failure.
# A client connected to `srv`; empty if it could not connect.
fn connect_client(srv: *TestServer) -> Box<Client>
    var owner: Box<Client> = client_new()
    let client: *Client = owner.as_ptr()
    if client == null
        return owner
    if connect_mode(client, srv.mode, srv.port) < 0
        client_free(client)
        return box_empty<Client>()
    client.sock.set_io_timeout(OP_TIMEOUT_MS)
    return owner

# Serialize a one-int-field document into buf. Returns size or < 0.
fn make_int_doc(name: StrView, value: i64, buf: [u8]) -> i64
    var doc: Document
    var tmp_id: DocumentId = doc_id_invalid()
    doc_init(@doc, @tmp_id)
    var val: Field = field_int(value)
    doc_set_field(@doc, name, @val)
    return doc_serialize(@doc, buf)

# ============================================================================
# Checks (run against a live server; the caller owns the server)
# ============================================================================

fn check_connect_disconnect(srv: *TestServer) -> i32
    var client_owner: Box<Client> = client_new()
    let client: *Client = client_owner.as_ptr()
    if client == null
        return 1
    # A failed attempt leaves its errno (#3881); the next connect clears it.
    if client_connect(client, "not-an-ip", srv.port, "test") != -4 or client_last_errno(client) == 0
        client_free(client)
        return 7
    if client_connect(client, "127.0.0.1", srv.port, "test") < 0
        client_free(client)
        return 2
    if client_last_errno(client) != 0
        client_free(client)
        return 8
    if client_is_connected(client) == 0
        client_free(client)
        return 3
    if client_session_id(client) == 0
        client_free(client)
        return 4
    if client_disconnect(client) < 0
        client_free(client)
        return 5
    if client_is_connected(client) != 0
        client_free(client)
        return 6
    client_free(client)
    return 0

fn check_ping(srv: *TestServer) -> i32
    var client_owner: Box<Client> = connect_client(srv)
    let client: *Client = client_owner.as_ptr()
    if client == null
        return 1
    if client_ping(client) < 0
        client_free(client)
        return 2
    # A second ping on the same session must also work.
    if client_ping(client) < 0
        client_free(client)
        return 3
    client_disconnect(client)
    client_free(client)
    return 0

fn check_insert_get(srv: *TestServer) -> i32
    var client_owner: Box<Client> = connect_client(srv)
    let client: *Client = client_owner.as_ptr()
    if client == null
        return 1

    var doc_buf: [2048]u8
    let doc_size: i64 = make_int_doc("value", 42, @doc_buf)
    if doc_size < 0
        client_free(client)
        return 2

    let doc_id: i64 = client_insert(client, head(@doc_buf, doc_size))
    if doc_id < 0
        client_free(client)
        return 3

    var out_data: [u8] = span_empty<u8>()
    if client_get(client, doc_id, @out_data) != 1
        client_free(client)
        return 4
    if out_data.len == 0
        client_free(client)
        return 5

    var retrieved: Document
    if doc_deserialize(out_data, @retrieved) != ERR_OK
        client_free(client)
        return 6

    var field: Field
    if doc_get_field(@retrieved, "value", @field) != ERR_OK
        client_free(client)
        return 7
    if field.int_val != 42
        client_free(client)
        return 8

    client_disconnect(client)
    client_free(client)
    return 0

fn check_delete(srv: *TestServer) -> i32
    var client_owner: Box<Client> = connect_client(srv)
    let client: *Client = client_owner.as_ptr()
    if client == null
        return 1

    var doc_buf: [2048]u8
    let doc_size: i64 = make_int_doc("delete_me", 123, @doc_buf)
    if doc_size < 0
        client_free(client)
        return 2

    let doc_id: i64 = client_insert(client, head(@doc_buf, doc_size))
    if doc_id < 0
        client_free(client)
        return 3

    # Present before the delete...
    var out_data: [u8] = span_empty<u8>()
    if client_get(client, doc_id, @out_data) != 1
        client_free(client)
        return 4

    if client_delete(client, doc_id) < 0
        client_free(client)
        return 5

    # ...and "not found" (0) after it.
    if client_get(client, doc_id, @out_data) != 0
        client_free(client)
        return 6

    client_disconnect(client)
    client_free(client)
    return 0

# ============================================================================
# Tests: each owns one server for its whole lifetime
# ============================================================================

[[test]]
fn test_connect_disconnect() -> i32
    var srv: TestServer
    let started: i32 = server_start(@srv)
    if started != 0
        return started
    let rc: i32 = check_connect_disconnect(@srv)
    server_stop(@srv)
    return rc

[[test]]
fn test_ping() -> i32
    var srv: TestServer
    let started: i32 = server_start(@srv)
    if started != 0
        return started
    let rc: i32 = check_ping(@srv)
    server_stop(@srv)
    return rc

[[test]]
fn test_insert_get() -> i32
    var srv: TestServer
    let started: i32 = server_start(@srv)
    if started != 0
        return started
    let rc: i32 = check_insert_get(@srv)
    server_stop(@srv)
    return rc

[[test]]
fn test_delete() -> i32
    var srv: TestServer
    let started: i32 = server_start(@srv)
    if started != 0
        return started
    let rc: i32 = check_delete(@srv)
    server_stop(@srv)
    return rc

# ============================================================================
# Document size limit, end to end (AGAST #2208)
# ============================================================================

# Serialize a document with one string field "c" whose serialization is
# exactly `size` bytes (69 bytes of header and field framing + payload).
fn make_sized_doc(size: i64, payload: [u8], buf: [u8]) -> i64
    let len: i64 = size - 69
    # A run that repeats every 23 bytes: a chunk out of place shows.
    var i: i64 = 0
    while i < len
        payload[i] = (97 + i % 23) as u8
        i += 1
    var doc: Document
    var tmp_id: DocumentId = doc_id_invalid()
    doc_init(@doc, @tmp_id)
    var f: Field = field_string(head(payload, len).as_strview())
    doc_set_field(@doc, "c", @f)
    return doc_serialize(@doc, buf)

struct ScanSeen
    docs: i32
    max_len: i32
    expect: [u8]        # Documents should be these bytes (empty: any)
    matched: i32        # Documents that were

fn scan_seen_init(seen: *ScanSeen, expect: [u8])
    seen.docs = 0
    seen.max_len = 0
    seen.expect = expect
    seen.matched = 0

fn scan_seen_step(doc_id: i64, data: [u8], user_data: *u8) -> i32
    let seen: *ScanSeen = user_data as *ScanSeen
    seen.docs += 1
    let len: i32 = data.len as i32
    if len > seen.max_len
        seen.max_len = len
    # Skip the serial version (4) and the id (8), which the server assigns.
    if seen.expect.len > 12 and data.len == seen.expect.len
        let got_tail: [u8] = data[12..data.len]
        let want_tail: [u8] = seen.expect[12..data.len]
        if got_tail.eq(@want_tail)
            seen.matched += 1
    return 0

# Several documents of exactly MAX_DOC_SIZE go in, come back whole by GET
# (only the id the server assigns differs) and all come back by SCAN, as does
# a zero-document batch for the still-empty collection first (AGAST #4201).
fn check_max_size_docs(srv: *TestServer) -> i32
    var client_owner: Box<Client> = connect_client(srv)
    let client: *Client = client_owner.as_ptr()
    if client == null
        return 1
    var seen: ScanSeen
    scan_seen_init(@seen, span_empty<u8>())
    if client_scan(client, scan_seen_step as *u8, @seen as *u8) < 0 or seen.docs != 0
        return 9
    var payload_vec: Vec<u8> = m7m_scratch(MAX_DOC_SIZE)
    let payload: [u8] = payload_vec[0..payload_vec.len()]
    var buf_vec: Vec<u8> = m7m_scratch(MAX_DOC_SIZE)
    let buf: [u8] = buf_vec[0..buf_vec.len()]
    let size: i64 = make_sized_doc(MAX_DOC_SIZE, payload, buf)
    if size != MAX_DOC_SIZE
        return 2
    var ids: [6]i64
    for i in 0..6
        ids[i] = client_insert(client, head(buf, size))
        if ids[i] < 0
            return 3
    for i in 0..6
        var out: [u8] = span_empty<u8>()
        if client_get(client, ids[i], @out) != 1
            return 4
        if out.len != size
            return 5
        # Skip the serial version (4) and the id (8).
        let got_tail: [u8] = out[12..size]
        let sent_tail: [u8] = buf[12..size]
        if not got_tail.eq(@sent_tail)
            return 6
    scan_seen_init(@seen, head(buf, size))
    if client_scan(client, scan_seen_step as *u8, @seen as *u8) < 0
        return 7
    if seen.docs != 6 or seen.matched != 6
        return 8
    client_disconnect(client)
    client_free(client)
    return 0

# One byte over is refused as DOCUMENT_TOO_LARGE before it is sent, and the
# session carries on; so is a document bigger than the client's buffers.
fn check_oversize_doc(srv: *TestServer, size: i64) -> i32
    var client_owner: Box<Client> = connect_client(srv)
    let client: *Client = client_owner.as_ptr()
    if client == null
        return 1
    var payload_vec: Vec<u8> = m7m_scratch(size + 64)
    let payload: [u8] = payload_vec[0..payload_vec.len()]
    var buf_vec: Vec<u8> = m7m_scratch(size + 64)
    let buf: [u8] = buf_vec[0..buf_vec.len()]
    if make_sized_doc(size, payload, buf) != size
        return 2
    if client_insert(client, head(buf, size)) != -4
        return 3
    if client_last_error(client) != PROTO_ERR_DOCUMENT_TOO_LARGE
        return 4
    if client_is_connected(client) == 0
        return 5
    if client_ping(client) < 0
        return 6
    var seen: ScanSeen
    scan_seen_init(@seen, span_empty<u8>())
    if client_scan(client, scan_seen_step as *u8, @seen as *u8) < 0
        return 7
    if seen.docs != 0
        return 8
    client_disconnect(client)
    client_free(client)
    return 0

fn max_size_docs_round_trip_on(mode: i32) -> i32
    var srv: TestServer
    let started: i32 = server_start_mode(@srv, mode)
    if started != 0
        return started
    let rc: i32 = check_max_size_docs(@srv)
    server_stop(@srv)
    return rc

# Every serve loop carries MAX_DOC_SIZE documents both ways (AGAST #3638):
# well past the async loops' 8 KiB task buffers and the serial loops' 4 KiB
# reads.
[[test]]
fn test_max_size_docs_round_trip() -> i32
    max_size_docs_round_trip_on(SERVE_ASYNC)

[[test]]
fn test_max_size_docs_round_trip_encrypted() -> i32
    max_size_docs_round_trip_on(SERVE_ASYNC_ENCRYPTED)

[[test]]
fn test_max_size_docs_round_trip_serial() -> i32
    max_size_docs_round_trip_on(SERVE_SERIAL)

[[test]]
fn test_max_size_docs_round_trip_serial_encrypted() -> i32
    max_size_docs_round_trip_on(SERVE_SERIAL_ENCRYPTED)

[[test]]
fn test_doc_one_byte_over_the_limit_is_refused() -> i32
    var srv: TestServer
    let started: i32 = server_start(@srv)
    if started != 0
        return started
    let rc: i32 = check_oversize_doc(@srv, MAX_DOC_SIZE + 1)
    server_stop(@srv)
    return rc

[[test]]
fn test_doc_over_the_client_buffer_is_refused() -> i32
    var srv: TestServer
    let started: i32 = server_start(@srv)
    if started != 0
        return started
    let rc: i32 = check_oversize_doc(@srv, 100000)
    server_stop(@srv)
    return rc

# ============================================================================
# Secondary field index (AGAST #3644)
# ============================================================================
#
# A FIND must answer from an index whose entries the server maintained on
# every INSERT and DELETE: all copies of a value come back, in id order, and
# a value held by no document is 0 — never the "no index" refusal.

fn make_string_doc(field: StrView, value: StrView, buf: [u8]) -> i64
    var doc: Document
    var tmp_id: DocumentId = doc_id_invalid()
    doc_init(@doc, @tmp_id)
    var f: Field = field_string(value)
    doc_set_field(@doc, field, @f)
    return doc_serialize(@doc, buf)

fn check_field_index(srv: *TestServer) -> i32
    var client_owner: Box<Client> = connect_client(srv)
    let client: *Client = client_owner.as_ptr()
    if client == null
        return 1

    if client_index_create(client, "slug") != 0
        client_free(client)
        return 2

    var buf: [1024]u8
    let d1: i64 = make_string_doc("slug", "twice", @buf)
    if d1 <= 0
        client_free(client)
        return 3
    let id1: i64 = client_insert(client, head(@buf, d1))
    if id1 < 0
        client_free(client)
        return 4
    let d2: i64 = make_string_doc("slug", "twice", @buf)
    let id2: i64 = client_insert(client, head(@buf, d2))
    if id2 < 0
        client_free(client)
        return 5
    let d3: i64 = make_string_doc("slug", "only", @buf)
    let id3: i64 = client_insert(client, head(@buf, d3))
    if id3 < 0
        client_free(client)
        return 6

    var ids: [8]i64
    let n: i32 = client_find(client, "slug", "twice", @ids[0], 8)
    if n != 2
        client_free(client)
        return 7
    if ids[0] != id1 or ids[1] != id2
        client_free(client)
        return 8
    if client_find(client, "slug", "only", @ids[0], 8) != 1
        client_free(client)
        return 9
    if client_find(client, "slug", "absent", @ids[0], 8) != 0
        client_free(client)
        return 10
    # No index on another field: the client is told to scan instead.
    if client_find(client, "title", "x", @ids[0], 8) >= 0
        client_free(client)
        return 11
    if client_last_error(client) != PROTO_ERR_NO_INDEX
        client_free(client)
        return 12

    # A delete removes exactly one copy from the index.
    if client_delete(client, id1) != 1
        client_free(client)
        return 13
    if client_find(client, "slug", "twice", @ids[0], 8) != 1
        client_free(client)
        return 14
    if ids[0] != id2
        client_free(client)
        return 15
    if client_delete(client, id2) != 1
        client_free(client)
        return 16
    if client_find(client, "slug", "twice", @ids[0], 8) != 0
        client_free(client)
        return 17

    client_disconnect(client)
    client_free(client)
    return 0

[[test]]
fn test_field_index_end_to_end() -> i32
    var srv: TestServer
    let started: i32 = server_start(@srv)
    if started != 0
        return started
    let rc: i32 = check_field_index(@srv)
    server_stop(@srv)
    return rc
