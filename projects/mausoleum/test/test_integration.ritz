# test/test_integration.ritz - End-to-end client/server tests
#
# The only end-to-end coverage of lib.client against the real server binary.
# Each [[test]] fork+execs ./build/debug/mausoleum (CWD is the package dir;
# `rz test mausoleum` builds the binary before running tests) as
#
#   mausoleum serve --no-encryption --port <port>
#
# with an in-memory store (no --data-dir, so nothing touches disk), waits in
# a bounded retry loop until the server completes a real protocol handshake,
# runs its checks, then SIGKILLs and reaps the server on every path.
#
# The port is derived from the test process's pid; if the server exits
# early (e.g. the port is taken) the next port is tried. The child also sets
# PR_SET_PDEATHSIG so it cannot outlive a test process that dies abruptly.
#
# Exit codes: 90-93 = server could not be started / never became ready;
# anything else identifies the failing step inside the test.

import ritzlib.sys
import ritzlib.str
import ritzlib.memory
import ritzlib.net

import lib.m7m_types
import lib.protocol
import lib.client
import lib.document
import lib.collection

const PORT_BASE: i32 = 20000
const PORT_SPAN: i32 = 30000
const PORT_ATTEMPTS: i32 = 5
const READY_POLLS: i32 = 200        # x 50ms = 10s max wait per attempt
const OP_TIMEOUT_MS: i32 = 5000     # bound every request/response
const SYS_PRCTL_NR: i64 = 157
const PR_SET_PDEATHSIG: i64 = 1
const SIG_KILL: i32 = 9
const WAIT_NOHANG: i32 = 1

fn server_bin() -> *u8
    return c"./build/debug/mausoleum"

struct TestServer
    pid: i32
    port: i32

# ============================================================================
# Server lifecycle helpers
# ============================================================================

fn sleep_ms(ms: i64)
    var ts: [2]i64
    ts[0] = ms / 1000
    ts[1] = (ms % 1000) * 1000000
    sys_nanosleep(@ts[0], null)

# Write the decimal form of n (n >= 0) into buf, NUL-terminated.
fn fmt_uint(buf: *u8, n: i32)
    var digits: [16]u8
    var len: i32 = 0
    var v: i32 = n
    if v == 0
        digits[0] = 48
        len = 1
    while v > 0
        digits[len] = ((v % 10) + 48) as u8
        v = v / 10
        len += 1
    var p: i64 = 0
    while len > 0
        len -= 1
        *(buf + p) = digits[len]
        p += 1
    *(buf + p) = 0

# fork+exec the server on `port` with stdio on /dev/null. Returns child pid
# or < 0 on failure.
fn spawn_server(port: i32) -> i32
    var port_str: [16]u8
    fmt_uint(@port_str[0], port)

    var argv: [6]*u8
    argv[0] = server_bin()
    argv[1] = c"serve"
    argv[2] = c"--no-encryption"
    argv[3] = c"--port"
    argv[4] = @port_str[0]
    argv[5] = null

    let pid: i32 = sys_fork()
    if pid != 0
        return pid

    # Child: die with the test process, keep the harness's stdout clean.
    syscall2(SYS_PRCTL_NR, PR_SET_PDEATHSIG, SIG_KILL as i64)
    let devnull: i32 = sys_open(c"/dev/null", 2)   # O_RDWR
    if devnull >= 0
        sys_dup2(devnull, 0)
        sys_dup2(devnull, 1)
        sys_dup2(devnull, 2)
        if devnull > 2
            sys_close(devnull)
    sys_execve(server_bin(), @argv[0], null)
    sys_exit(127)
    return -1

fn server_kill(pid: i32)
    if pid <= 0
        return
    sys_kill(pid, SIG_KILL)
    var status: i32 = 0
    sys_wait4(pid, @status, 0, null)

# 1 if the child has already exited (and was reaped), else 0.
fn server_exited(pid: i32) -> i32
    var status: i32 = 0
    if sys_wait4(pid, @status, WAIT_NOHANG, null) == pid
        return 1
    return 0

# Poll until the server answers a full CONNECT handshake.
# 0 = ready, 1 = server exited (try another port), 2 = timed out.
fn wait_ready(srv: *TestServer) -> i32
    var i: i32 = 0
    while i < READY_POLLS
        if server_exited(srv.pid) == 1
            srv.pid = 0
            return 1
        let probe: *Client = client_new()
        if probe != null
            let rc: i32 = client_connect(probe, c"127.0.0.1", srv.port, c"test", 4)
            if rc == 0
                client_disconnect(probe)
                client_free(probe)
                return 0
            client_free(probe)
        sleep_ms(50)
        i += 1
    return 2

# Start a server and wait until it is ready. 0 on success, 90-93 on failure.
# On failure no server process is left behind.
fn server_start(srv: *TestServer) -> i32
    srv.pid = 0
    srv.port = 0
    if sys_access(server_bin(), 1) != 0   # X_OK
        return 90   # binary not built
    let base: i32 = PORT_BASE + (sys_getpid() % PORT_SPAN)
    var attempt: i32 = 0
    while attempt < PORT_ATTEMPTS
        srv.port = base + attempt * 7
        if srv.port >= 65000
            srv.port = srv.port - PORT_SPAN
        srv.pid = spawn_server(srv.port)
        if srv.pid < 0
            srv.pid = 0
            return 91   # fork failed
        let r: i32 = wait_ready(srv)
        if r == 0
            return 0
        if r == 2
            server_kill(srv.pid)
            srv.pid = 0
            return 92   # never became ready
        attempt += 1
    return 93   # server exited on every port tried

fn server_stop(srv: *TestServer)
    server_kill(srv.pid)
    srv.pid = 0

# Connect a fresh client with bounded request timeouts; null on failure.
fn connect_client(srv: *TestServer) -> *Client
    let client: *Client = client_new()
    if client == null
        return null
    if client_connect(client, c"127.0.0.1", srv.port, c"test", 4) < 0
        client_free(client)
        return null
    socket_set_io_timeout(@client.sock, OP_TIMEOUT_MS)
    return client

# Serialize a one-int-field document into buf. Returns size or < 0.
fn make_int_doc(name: StrView, value: i64, buf: *u8, cap: i64) -> i64
    var doc: Document
    var tmp_id: DocumentId = doc_id_invalid()
    doc_init(@doc, @tmp_id)
    var val: Field = field_int(value)
    doc_set_field(@doc, name, @val)
    return doc_serialize(@doc, buf, cap)

# ============================================================================
# Checks (run against a live server; the caller owns the server)
# ============================================================================

fn check_connect_disconnect(srv: *TestServer) -> i32
    let client: *Client = client_new()
    if client == null
        return 1
    if client_connect(client, c"127.0.0.1", srv.port, c"test", 4) < 0
        client_free(client)
        return 2
    if client_is_connected(client) == 0
        client_free(client)
        return 3
    if client_session_id(client) == 0
        client_free(client)
        return 4
    if client_disconnect(client) < 0
        client_free(client)
        return 5
    if client_is_connected(client) != 0
        client_free(client)
        return 6
    client_free(client)
    return 0

fn check_ping(srv: *TestServer) -> i32
    let client: *Client = connect_client(srv)
    if client == null
        return 1
    if client_ping(client) < 0
        client_free(client)
        return 2
    # A second ping on the same session must also work.
    if client_ping(client) < 0
        client_free(client)
        return 3
    client_disconnect(client)
    client_free(client)
    return 0

fn check_insert_get(srv: *TestServer) -> i32
    let client: *Client = connect_client(srv)
    if client == null
        return 1

    var doc_buf: [2048]u8
    let doc_size: i64 = make_int_doc("value", 42, @doc_buf[0], 2048)
    if doc_size < 0
        client_free(client)
        return 2

    let doc_id: i64 = client_insert(client, @doc_buf[0], doc_size as i32)
    if doc_id < 0
        client_free(client)
        return 3

    var out_data: *u8 = null
    var out_len: i32 = 0
    if client_get(client, doc_id, @out_data, @out_len) != 1
        client_free(client)
        return 4
    if out_data == null or out_len == 0
        client_free(client)
        return 5

    var retrieved: Document
    if doc_deserialize(out_data, out_len as i64, @retrieved) != ERR_OK
        client_free(client)
        return 6

    var field: Field
    if doc_get_field(@retrieved, "value", @field) != ERR_OK
        client_free(client)
        return 7
    if field.int_val != 42
        client_free(client)
        return 8

    client_disconnect(client)
    client_free(client)
    return 0

fn check_delete(srv: *TestServer) -> i32
    let client: *Client = connect_client(srv)
    if client == null
        return 1

    var doc_buf: [2048]u8
    let doc_size: i64 = make_int_doc("delete_me", 123, @doc_buf[0], 2048)
    if doc_size < 0
        client_free(client)
        return 2

    let doc_id: i64 = client_insert(client, @doc_buf[0], doc_size as i32)
    if doc_id < 0
        client_free(client)
        return 3

    # Present before the delete...
    var out_data: *u8 = null
    var out_len: i32 = 0
    if client_get(client, doc_id, @out_data, @out_len) != 1
        client_free(client)
        return 4

    if client_delete(client, doc_id) < 0
        client_free(client)
        return 5

    # ...and "not found" (0) after it.
    out_data = null
    out_len = 0
    if client_get(client, doc_id, @out_data, @out_len) != 0
        client_free(client)
        return 6

    client_disconnect(client)
    client_free(client)
    return 0

# ============================================================================
# Tests: each owns one server for its whole lifetime
# ============================================================================

[[test]]
fn test_connect_disconnect() -> i32
    var srv: TestServer
    let started: i32 = server_start(@srv)
    if started != 0
        return started
    let rc: i32 = check_connect_disconnect(@srv)
    server_stop(@srv)
    return rc

[[test]]
fn test_ping() -> i32
    var srv: TestServer
    let started: i32 = server_start(@srv)
    if started != 0
        return started
    let rc: i32 = check_ping(@srv)
    server_stop(@srv)
    return rc

[[test]]
fn test_insert_get() -> i32
    var srv: TestServer
    let started: i32 = server_start(@srv)
    if started != 0
        return started
    let rc: i32 = check_insert_get(@srv)
    server_stop(@srv)
    return rc

[[test]]
fn test_delete() -> i32
    var srv: TestServer
    let started: i32 = server_start(@srv)
    if started != 0
        return started
    let rc: i32 = check_delete(@srv)
    server_stop(@srv)
    return rc
