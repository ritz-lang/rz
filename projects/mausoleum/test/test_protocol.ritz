[[test]]
fn test_flags() -> i32
    assert FLAG_NONE == 0
    assert FLAG_COMPRESSED == 1
    assert FLAG_MORE_DATA == 2
    assert FLAG_IN_TXN == 4
    0

[[test]]
fn test_msgreader_flags() -> i32
    var buf_v: MessageBuffer = msgbuf_new(1024)
    let buf: *MessageBuffer = @buf_v
    msgbuf_start(buf, MSG_INSERT, 1)
    buf.header.flags = FLAG_IN_TXN
    msgbuf_finish(buf)

    var reader: MessageReader
    msgreader_init(@reader, msgbuf_bytes(buf))
    assert msgreader_flags(@reader) == FLAG_IN_TXN

    msgbuf_free(buf)
    0

# ============================================================================
# Edge cases
# ============================================================================

[[test]]
fn test_empty_bytes() -> i32
    var buf_v: MessageBuffer = msgbuf_new(1024)
    let buf: *MessageBuffer = @buf_v
    msgbuf_start(buf, MSG_PING, 1)
    msgbuf_write_bytes(buf, "")
    msgbuf_finish(buf)

    var reader: MessageReader
    msgreader_init(@reader, msgbuf_bytes(buf))

    let data: Option<[u8]> = msgreader_read_bytes(@reader)
    assert data.is_some()
    assert data.unwrap_or(span_empty<u8>()).len == 0

    msgbuf_free(buf)
    0

[[test]]
fn test_multiple_writes() -> i32
    var buf_v: MessageBuffer = msgbuf_new(1024)
    let buf: *MessageBuffer = @buf_v
    msgbuf_start(buf, MSG_PING, 1)
    msgbuf_write_i32(buf, 111)
    msgbuf_write_i64(buf, 222)
    msgbuf_write_i32(buf, 333)
    msgbuf_finish(buf)

    var reader: MessageReader
    msgreader_init(@reader, msgbuf_bytes(buf))

    let v1: i32 = msgreader_read_i32(@reader)
    let v2: i64 = msgreader_read_i64(@reader)
    let v3: i32 = msgreader_read_i32(@reader)

    assert v1 == 111
    assert v2 == 222
    assert v3 == 333

    msgbuf_free(buf)
    0

[[test]]
fn test_null_buffer() -> i32
    # msgbuf_new with zero should still work: a buffer with no room
    var buf_v: MessageBuffer = msgbuf_new(0)
    let buf: *MessageBuffer = @buf_v
    assert msgbuf_capacity(buf) == 0
    assert msgbuf_write_i32(buf, 1) < 0
    # Don't crash on free
    msgbuf_free(buf)
    0

[[test]]
fn test_buffer_reuse() -> i32
    var buf_v: MessageBuffer = msgbuf_new(1024)
    let buf: *MessageBuffer = @buf_v

    # First message
    build_ping(buf, 1)
    var reader: MessageReader
    msgreader_init(@reader, msgbuf_bytes(buf))
    assert msgreader_msg_type(@reader) == MSG_PING
    assert msgreader_request_id(@reader) == 1

    # Reuse for second message
    build_get(buf, 2, 999)
    msgreader_init(@reader, msgbuf_bytes(buf))
    assert msgreader_msg_type(@reader) == MSG_GET
    assert msgreader_request_id(@reader) == 2

    msgbuf_free(buf)
    0

# build_insert used to ignore msgbuf_write_bytes failing and finish a message
# with no document in it (AGAST #2208): now it says so and leaves nothing.
[[test]]
fn test_build_insert_refuses_a_doc_bigger_than_the_buffer() -> i32
    var buf_v: MessageBuffer = msgbuf_new(64)
    let buf: *MessageBuffer = @buf_v
    var doc: [100]u8 = [7; 100]
    if build_insert(buf, 1, head(@doc, 100)) != -1
        return 1
    if msgbuf_len(buf) != 0
        return 2
    # Control: one that fits.
    if build_insert(buf, 2, head(@doc, 20)) < 0
        return 3
    msgbuf_free(buf)
    0

# ============================================================================
# Secondary field index messages (AGAST #3644)
# ============================================================================

[[test]]
fn test_index_message_types() -> i32
    assert MSG_INDEX_CREATE == 0x30
    assert MSG_INDEX_CREATED == 0xB0
    assert MSG_FIND == 0x32
    assert MSG_FIND_RESULT == 0xB2
    assert PROTO_ERR_NO_INDEX == 13
    0

[[test]]
fn test_build_index_create_round_trip() -> i32
    var storage: [256]u8
    var buf: MessageBuffer = msgbuf_empty()
    msgbuf_init(@buf, @storage)
    if build_index_create(@buf, 7, "slug", 0) < 0
        return 1

    var reader: MessageReader
    if msgreader_init(@reader, msgbuf_bytes(@buf)) != PROTO_OK
        return 2
    if msgreader_msg_type(@reader) != MSG_INDEX_CREATE
        return 3
    if msgreader_request_id(@reader) != 7
        return 4
    let field: [u8] = msgreader_read_bytes(@reader).unwrap_or(span_empty<u8>())
    if not field.as_strview().eq("slug")
        return 5
    if msgreader_read_i32(@reader) != 0
        return 6
    0

[[test]]
fn test_build_find_round_trip() -> i32
    var storage: [256]u8
    var buf: MessageBuffer = msgbuf_empty()
    msgbuf_init(@buf, @storage)
    if build_find(@buf, 9, "slug", "alpha") < 0
        return 1

    var reader: MessageReader
    if msgreader_init(@reader, msgbuf_bytes(@buf)) != PROTO_OK
        return 2
    if msgreader_msg_type(@reader) != MSG_FIND
        return 3
    if msgreader_request_id(@reader) != 9
        return 4
    let field: [u8] = msgreader_read_bytes(@reader).unwrap_or(span_empty<u8>())
    if not field.as_strview().eq("slug")
        return 5
    let value: [u8] = msgreader_read_bytes(@reader).unwrap_or(span_empty<u8>())
    if not value.as_strview().eq("alpha")
        return 6
    0

[[test]]
fn test_build_find_result_round_trip() -> i32
    var storage: [256]u8
    var buf: MessageBuffer = msgbuf_empty()
    msgbuf_init(@buf, @storage)
    var ids: [3]i64
    ids[0] = 11
    ids[1] = 22
    ids[2] = 33
    if build_find_result(@buf, 4, @ids[0], 3) < 0
        return 1

    var reader: MessageReader
    if msgreader_init(@reader, msgbuf_bytes(@buf)) != PROTO_OK
        return 2
    if msgreader_msg_type(@reader) != MSG_FIND_RESULT
        return 3
    if msgreader_read_i32(@reader) != 3
        return 4
    if msgreader_read_i64(@reader) != 11
        return 5
    if msgreader_read_i64(@reader) != 22
        return 6
    if msgreader_read_i64(@reader) != 33
        return 7
    0
