# test/test_wal.ritz - Tests for Write-Ahead Log
#
# Tests for WAL writer/reader operations

import ritzlib.sys
import ritzlib.strview
import ritzlib.fs { unlink }
import ritzlib.io
import ritzlib.str
import ritzlib.strview
import ritzlib.span
import ritzlib.memory
import ritzlib.string

import lib.m7m_types
import lib.page
import lib.wal

# ============================================================================
# Helper Functions
# ============================================================================

# Create a temporary test file path: "/tmp/m7m_test_wal_<pid>_<seq>_<suffix>".
# The pid separates concurrent test processes; the sequence separates two
# calls inside one process.  A fixed path let two runs share one WAL
# (AGAST #4466).
var g_test_path_seq: i64 = 0

fn get_test_path(suffix: i32) -> String
    let pid: i32 = sys_getpid()
    let seq: i64 = g_test_path_seq
    g_test_path_seq += 1
    var path: String = string_new()
    format_into(@&path, "/tmp/m7m_test_wal_{pid}_{seq}_{suffix}")
    return path

# "<path>.wal.000000" into buf (NUL-terminated).  Never a fixed offset: the
# base path length varies with pid and sequence (AGAST #4466).
fn build_wal_path(buf: Span<u8>, path: *u8)
    m7m_path_join(buf, strview_from_cstr(path), ".wal.000000")

# Remove every "<path>.wal.<segment>", not just segment 0: WAL segments left
# behind by a crashed run must not poison the next one (AGAST #4466).
fn cleanup_test_wal(path: *u8)
    var wal_path: [128]u8
    let base: StrView = strview_from_cstr(path)
    m7m_path_join(@wal_path, base, ".wal.")
    let n: i64 = base.len
    var seg: i32 = 0
    while seg < 64
        var div: i32 = 100000
        var i: i64 = 0
        while div > 0
            wal_path[n + 5 + i] = (48 + ((seg / div) % 10)) as u8
            div = div / 10
            i += 1
        wal_path[n + 11] = 0
        unlink(strview_from_cstr(@wal_path[0]))
        seg += 1

# ============================================================================
# WAL Writer Creation Tests
# ============================================================================

[[test]]
fn test_wal_writer_new() -> i32
    var path_str: String = get_test_path(0)
    let path: *u8 = path_str.as_ptr()
    var writer: *WalWriter = wal_writer_new(path)
    if writer == null
        return 1

    wal_writer_destroy(writer)
    0

[[test]]
fn test_wal_writer_new_null_path() -> i32
    var writer: *WalWriter = wal_writer_new(null)
    if writer != null
        return 1
    0

[[test]]
fn test_wal_writer_open() -> i32
    var path_str: String = get_test_path(1)
    let path: *u8 = path_str.as_ptr()
    var writer: *WalWriter = wal_writer_new(path)
    if writer == null
        return 1

    var err: i32 = wal_writer_open(writer)
    if err != ERR_OK
        wal_writer_destroy(writer)
        return 2

    wal_writer_destroy(writer)

    # Clean up WAL file
    cleanup_test_wal(path)
    0

# ============================================================================
# WAL Record Writing Tests
# ============================================================================

[[test]]
fn test_wal_write_begin() -> i32
    var path_str: String = get_test_path(2)
    let path: *u8 = path_str.as_ptr()
    var writer: *WalWriter = wal_writer_new(path)
    if writer == null
        return 1

    var err: i32 = wal_writer_open(writer)
    if err != ERR_OK
        wal_writer_destroy(writer)
        return 2

    var lsn: i64 = wal_write_begin(writer, 100)
    if lsn < 0
        wal_writer_destroy(writer)
        return 3

    # LSN should be 1 (first record)
    if lsn != 1
        wal_writer_destroy(writer)
        return 4

    wal_writer_destroy(writer)

    # Cleanup
    cleanup_test_wal(path)
    0

[[test]]
fn test_wal_write_commit() -> i32
    var path_str: String = get_test_path(3)
    let path: *u8 = path_str.as_ptr()
    var writer: *WalWriter = wal_writer_new(path)
    if writer == null
        return 1

    wal_writer_open(writer)

    var begin_lsn: i64 = wal_write_begin(writer, 200)
    var commit_lsn: i64 = wal_write_commit(writer, 200, begin_lsn)

    if commit_lsn != 2
        wal_writer_destroy(writer)
        return 2

    wal_writer_destroy(writer)

    # Cleanup
    cleanup_test_wal(path)
    0

[[test]]
fn test_wal_write_abort() -> i32
    var path_str: String = get_test_path(4)
    let path: *u8 = path_str.as_ptr()
    var writer: *WalWriter = wal_writer_new(path)
    wal_writer_open(writer)

    var begin_lsn: i64 = wal_write_begin(writer, 300)
    var abort_lsn: i64 = wal_write_abort(writer, 300, begin_lsn)

    if abort_lsn != 2
        wal_writer_destroy(writer)
        return 1

    wal_writer_destroy(writer)

    # Cleanup
    cleanup_test_wal(path)
    0

[[test]]
fn test_wal_write_insert() -> i32
    var path_str: String = get_test_path(5)
    let path: *u8 = path_str.as_ptr()
    var writer: *WalWriter = wal_writer_new(path)
    wal_writer_open(writer)

    var begin_lsn: i64 = wal_write_begin(writer, 400)

    var data: [16]u8
    data[0] = 1
    data[1] = 2
    data[2] = 3
    data[3] = 4

    var insert_lsn: i64 = wal_write_insert(writer, 400, begin_lsn, 0, 100, @data[0], 4)
    if insert_lsn != 2
        wal_writer_destroy(writer)
        return 1

    wal_writer_destroy(writer)

    # Cleanup
    cleanup_test_wal(path)
    0

[[test]]
fn test_wal_write_page() -> i32
    var path_str: String = get_test_path(6)
    let path: *u8 = path_str.as_ptr()
    var writer: *WalWriter = wal_writer_new(path)
    wal_writer_open(writer)

    var begin_lsn: i64 = wal_write_begin(writer, 500)

    var page: Page
    page_init_heap(@page, 42)
    page.data[0] = 99

    var page_lsn: i64 = wal_write_page(writer, 500, begin_lsn, 42, @page)
    if page_lsn != 2
        wal_writer_destroy(writer)
        return 1

    wal_writer_destroy(writer)

    # Cleanup
    cleanup_test_wal(path)
    0

[[test]]
fn test_wal_write_checkpoint() -> i32
    var path_str: String = get_test_path(7)
    let path: *u8 = path_str.as_ptr()
    var writer: *WalWriter = wal_writer_new(path)
    wal_writer_open(writer)

    var cp_lsn: i64 = wal_write_checkpoint(writer)
    if cp_lsn != 1
        wal_writer_destroy(writer)
        return 1

    wal_writer_destroy(writer)

    # Cleanup
    cleanup_test_wal(path)
    0

# ============================================================================
# WAL Reader Tests
# ============================================================================

[[test]]
fn test_wal_reader_new() -> i32
    var reader: *WalReader = wal_reader_new()
    if reader == null
        return 1

    wal_reader_destroy(reader)
    0

[[test]]
fn test_wal_write_then_read() -> i32
    # Write some records
    var path_str: String = get_test_path(8)
    let path: *u8 = path_str.as_ptr()
    var writer: *WalWriter = wal_writer_new(path)
    wal_writer_open(writer)

    wal_write_begin(writer, 600)
    wal_write_commit(writer, 600, 1)
    wal_write_checkpoint(writer)

    wal_writer_close(writer)
    wal_writer_destroy(writer)

    # Build WAL file path
    var wal_path: [64]u8
    build_wal_path(@wal_path, path)
    defer unlink(strview_from_cstr(@wal_path[0]))

    # Read them back
    var reader: *WalReader = wal_reader_new()
    var err: i32 = wal_reader_open(reader, @wal_path[0])
    if err != ERR_OK
        wal_reader_destroy(reader)
        return 1

    var header: WalRecordHeader

    # Read first record (BEGIN)
    err = wal_reader_next(reader, @header)
    if err != ERR_OK
        wal_reader_destroy(reader)
        return 2

    if header.rec_type != WAL_REC_BEGIN
        wal_reader_destroy(reader)
        return 3

    if header.txn_id != 600
        wal_reader_destroy(reader)
        return 4

    # Read second record (COMMIT)
    err = wal_reader_next(reader, @header)
    if err != ERR_OK
        wal_reader_destroy(reader)
        return 5

    if header.rec_type != WAL_REC_COMMIT
        wal_reader_destroy(reader)
        return 6

    # Read third record (CHECKPOINT)
    err = wal_reader_next(reader, @header)
    if err != ERR_OK
        wal_reader_destroy(reader)
        return 7

    if header.rec_type != WAL_REC_CHECKPOINT
        wal_reader_destroy(reader)
        return 8

    # Should be EOF now
    err = wal_reader_next(reader, @header)
    if err != -1  # -1 is EOF
        wal_reader_destroy(reader)
        return 9

    wal_reader_destroy(reader)
    0

# ============================================================================
# WAL Statistics Tests
# ============================================================================

[[test]]
fn test_wal_writer_lsn() -> i32
    var path_str: String = get_test_path(9)
    let path: *u8 = path_str.as_ptr()
    var writer: *WalWriter = wal_writer_new(path)
    wal_writer_open(writer)

    # Initial LSN should be 1
    if wal_writer_lsn(writer) != 1
        wal_writer_destroy(writer)
        return 1

    wal_write_begin(writer, 700)

    # After one write, LSN should be 2
    if wal_writer_lsn(writer) != 2
        wal_writer_destroy(writer)
        return 2

    wal_writer_destroy(writer)

    # Cleanup
    cleanup_test_wal(path)
    0

# ============================================================================
# Transaction Sequence Tests
# ============================================================================

[[test]]
fn test_wal_full_transaction() -> i32
    var path_str: String = get_test_path(10)
    let path: *u8 = path_str.as_ptr()
    var writer: *WalWriter = wal_writer_new(path)
    wal_writer_open(writer)

    # Simulate a complete transaction
    var txn_id: i64 = 1000

    # Begin
    var begin_lsn: i64 = wal_write_begin(writer, txn_id)
    if begin_lsn < 0
        wal_writer_destroy(writer)
        return 1

    # Multiple inserts
    var data: [32]u8
    for i in 0..5
        var lsn: i64 = wal_write_insert(writer, txn_id, begin_lsn, i as i64, i as i32, @data[0], 8)
        if lsn < 0
            wal_writer_destroy(writer)
            return 2

    # Commit
    var commit_lsn: i64 = wal_write_commit(writer, txn_id, begin_lsn)
    if commit_lsn < 0
        wal_writer_destroy(writer)
        return 3

    # Check final LSN (1 begin + 5 inserts + 1 commit = 7)
    if wal_writer_lsn(writer) != 8
        wal_writer_destroy(writer)
        return 4

    wal_writer_destroy(writer)

    # Cleanup
    cleanup_test_wal(path)
    0

# AGAST #4466: two calls must not share a base path, or concurrent runs share
# one WAL file.
[[test]]
fn test_wal_test_paths_are_unique() -> i32
    var a: String = get_test_path(0)
    var b: String = get_test_path(0)
    let same: bool = a.eq_string(@b)
    if same
        return 1
    return 0
