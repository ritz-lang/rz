# test/test_server_async.ritz - Encrypted handshake step of the async server
#
# #2772: x25519 refuses a small-order client key (all-zero shared secret,
# RFC 7748 §6.1).  The async server must close the session rather than
# derive session keys from an unwritten secret.

import ritzlib.sys

import lib.server_async
import ritzlib.memory
import ritzlib.option
import lib.m7m_types
import lib.protocol
import lib.buffer_pool
import lib.document
import lib.collection
import cryptosec.x25519
import cryptosec.random
import ritzlib.str
import ritzlib.uring
import ritzlib.async.tasks

fn sa_all_zero(p: *u8, n: i32) -> i32
    var i: i32 = 0
    while i < n
        if p[i] != 0
            return 0
        i += 1
    return 1

[[test]]
fn test_async_handshake_refuses_all_zero_client_key() -> i32
    let idx: i32 = 7
    m7sp_session_init_encrypted(idx)
    let s: *M7SPSession = m7sp_session_at(idx)
    assert s.in_use == 1

    var zero: [32]u8
    memzero(@zero[0], 32)
    assert m7sp_enc_accept_client_pubkey(idx, @zero[0]) < 0
    # Session closed: slot freed, no keys derived from the refused secret.
    assert s.in_use == 0
    assert sa_all_zero(@s.cipher_send_key[0], 32) == 1
    assert sa_all_zero(@s.cipher_recv_key[0], 32) == 1
    assert sa_all_zero(@s.cipher_private_key[0], 32) == 1
    0

# Control: a genuine client key derives keys and keeps the session open.
[[test]]
fn test_async_handshake_accepts_valid_client_key() -> i32
    let idx: i32 = 8
    m7sp_session_init_encrypted(idx)
    let s: *M7SPSession = m7sp_session_at(idx)

    var cli_priv: [32]u8
    var cli_pub: [32]u8
    getrandom(@cli_priv[0], 32, 0)
    x25519_clamp(@cli_priv[0])
    x25519_pubkey(@cli_pub[0], @cli_priv[0])

    assert m7sp_enc_accept_client_pubkey(idx, @cli_pub[0]) == 0
    assert s.in_use == 1
    assert sa_all_zero(@s.cipher_send_key[0], 32) == 0
    assert sa_all_zero(@s.cipher_recv_key[0], 32) == 0
    m7sp_session_destroy(idx)
    0

# ============================================================================
# Document size limit (AGAST #2208)
# ============================================================================
#
# The client refuses an oversize document before sending it; the server must
# refuse one from any other client the same way, as DOCUMENT_TOO_LARGE rather
# than an internal error, on INSERT and UPDATE alike.


fn sa_collection(col: *Collection) -> i32
    let pool_opt = buffer_pool_new(128)
    let pool: *BufferPool = option_unwrap_or<*BufferPool>(@pool_opt, null)
    if pool == null
        return -1
    return collection_init(col, pool, 1)

# Serialize a one-string-field document of exactly `size` bytes into buf;
# `id` (an existing document's, for UPDATE) or the invalid id.
fn sa_sized_doc(size: i64, id: i64, payload: *u8, buf: *u8, cap: i64) -> i64
    memset(payload, 122, size - 69)
    var doc: Document
    var doc_id: DocumentId = doc_id_invalid()
    doc_id.value = id
    doc_init(@doc, @doc_id)
    var f: Field = field_string(payload, size - 69)
    doc_set_field(@doc, "c", @f)
    return doc_serialize(@doc, buf, cap)

# Run one INSERT (update == 0) or UPDATE carrying `doc` through the handler;
# returns the response type, with the error code in *code for MSG_ERROR.
fn sa_write(col: *Collection, update: i32, doc: *u8, doc_len: i32, code: *i32) -> i32
    let req: *MessageBuffer = msgbuf_new(ASYNC_MAX_MSG)
    let resp: *MessageBuffer = msgbuf_new(ASYNC_MAX_MSG)
    var msg_type: i32 = MSG_INSERT
    if update != 0
        msg_type = MSG_UPDATE
    msgbuf_start(req, msg_type, 1)
    msgbuf_write_bytes(req, doc, doc_len)
    msgbuf_finish(req)
    var reader: MessageReader
    msgreader_init(@reader, msgbuf_data(req), msgbuf_len(req))
    if update != 0
        async_handle_update(@reader, resp, 1, col)
    else
        async_handle_insert(@reader, resp, 1, col)
    var out: MessageReader
    msgreader_init(@out, msgbuf_data(resp), msgbuf_len(resp))
    let t: i32 = msgreader_msg_type(@out)
    *code = 0
    if t == MSG_ERROR
        *code = msgreader_read_i32(@out)
    msgbuf_free(req)
    msgbuf_free(resp)
    return t

[[test]]
fn test_async_insert_takes_a_max_size_doc() -> i32
    var col: Collection
    assert sa_collection(@col) == ERR_OK
    let payload: *u8 = malloc(MAX_DOC_SIZE + 1)
    let buf: *u8 = malloc(MAX_DOC_SIZE + 1)
    let n: i64 = sa_sized_doc(MAX_DOC_SIZE, -1, payload, buf, MAX_DOC_SIZE + 1)
    assert n == MAX_DOC_SIZE
    var code: i32 = 0
    assert sa_write(@col, 0, buf, n as i32, @code) == MSG_INSERT_OK
    assert collection_count(@col) == 1
    0

[[test]]
fn test_async_insert_refuses_an_oversize_doc_as_too_large() -> i32
    var col: Collection
    assert sa_collection(@col) == ERR_OK
    let payload: *u8 = malloc(MAX_DOC_SIZE + 1)
    let buf: *u8 = malloc(MAX_DOC_SIZE + 1)
    let n: i64 = sa_sized_doc(MAX_DOC_SIZE + 1, -1, payload, buf, MAX_DOC_SIZE + 1)
    var code: i32 = 0
    assert sa_write(@col, 0, buf, n as i32, @code) == MSG_ERROR
    assert code == PROTO_ERR_DOCUMENT_TOO_LARGE
    assert collection_count(@col) == 0
    0

[[test]]
fn test_async_update_refuses_an_oversize_doc_as_too_large() -> i32
    var col: Collection
    assert sa_collection(@col) == ERR_OK
    let payload: *u8 = malloc(MAX_DOC_SIZE + 1)
    let buf: *u8 = malloc(MAX_DOC_SIZE + 1)
    var small: i64 = sa_sized_doc(100, -1, payload, buf, MAX_DOC_SIZE + 1)
    var id: DocumentId
    var doc: Document
    assert doc_deserialize(buf, small, @doc) == ERR_OK
    assert collection_insert(@col, @doc, @id) == ERR_OK

    let n: i64 = sa_sized_doc(MAX_DOC_SIZE + 1, id.value, payload, buf, MAX_DOC_SIZE + 1)
    var code: i32 = 0
    assert sa_write(@col, 1, buf, n as i32, @code) == MSG_ERROR
    assert code == PROTO_ERR_DOCUMENT_TOO_LARGE

    # Control: an update at the limit is fine.
    let ok: i64 = sa_sized_doc(MAX_DOC_SIZE, id.value, payload, buf, MAX_DOC_SIZE + 1)
    assert sa_write(@col, 1, buf, ok as i32, @code) == MSG_UPDATE_OK
    0


# The async loops build replies in [36864]u8 stack buffers sized by
# ASYNC_MAX_MSG (a literal: array sizes cannot name a constant), and that
# must hold the largest reply: a SCAN_RESULT or GET_OK of one MAX_DOC_SIZE
# document (16 header + 8 counts + 8 id + 4 length).  Its encrypted frame
# is 32 bytes more (AGAST #3638).
[[test]]
fn test_async_max_msg_holds_a_max_size_doc() -> i32
    assert ASYNC_MAX_MSG == 36864
    assert ASYNC_MAX_MSG as i64 >= MAX_DOC_SIZE + 16 + 8 + 8 + 4
    assert ASYNC_MAX_FRAME == ASYNC_MAX_MSG + 32
    0

# A GET of a document over the 8 KiB task buffer answers with all of it.
[[test]]
fn test_async_get_returns_a_max_size_doc() -> i32
    var col: Collection
    assert sa_collection(@col) == ERR_OK
    let payload: *u8 = malloc(MAX_DOC_SIZE)
    let buf: *u8 = malloc(MAX_DOC_SIZE)
    let n: i64 = sa_sized_doc(MAX_DOC_SIZE, -1, payload, buf, MAX_DOC_SIZE)
    var doc: Document
    assert doc_deserialize(buf, n, @doc) == ERR_OK
    var id: DocumentId
    assert collection_insert(@col, @doc, @id) == ERR_OK

    let req: *MessageBuffer = msgbuf_new(64)
    let resp: *MessageBuffer = msgbuf_new(ASYNC_MAX_MSG)
    msgbuf_start(req, MSG_GET, 1)
    msgbuf_write_i64(req, id.value)
    msgbuf_finish(req)
    var reader: MessageReader
    msgreader_init(@reader, msgbuf_data(req), msgbuf_len(req))
    async_handle_get(@reader, resp, 1, @col)
    var out: MessageReader
    msgreader_init(@out, msgbuf_data(resp), msgbuf_len(resp))
    assert msgreader_msg_type(@out) == MSG_GET_OK
    var len: i32 = 0
    let data: *u8 = msgreader_read_bytes(@out, @len)
    assert len as i64 == MAX_DOC_SIZE
    # The id was assigned on insert; everything after it is as sent.
    assert memcmp(data + 12, buf + 12, MAX_DOC_SIZE - 12) == 0
    0

# ============================================================================
# Short-send resubmission (AGAST #4204)
# ============================================================================
#
# An io_uring send may complete short; replies now reach 36 KiB, past what a
# socket buffer takes in one go.  m7sp_send_progress (#3638) must send the
# rest from where the short send stopped.  A real ring sends a 32 KiB reply
# over a socketpair whose first send is reported as 5000 bytes: the peer
# must read exactly bytes 5000.. of the reply, and nothing else.

const SA_REPLY_LEN: i32 = 32768
const SA_SHORT: i32 = 5000

# Read `want` bytes from fd into out, waiting at most 2 s for each part.
# Returns the bytes read (fewer than `want` if the data stopped coming).
fn sa_read_all(fd: i32, out: *u8, want: i32) -> i32
    var got: i32 = 0
    while got < want
        var pfd: PollFd
        pfd.fd = fd
        pfd.events = POLLIN
        pfd.revents = 0
        if sys_poll(@pfd, 1, 2000) <= 0
            return got
        let n: i64 = sys_read(fd, out + got as i64, (want - got) as i64)
        if n <= 0
            return got
        got += n as i32
    got

[[test]]
fn test_async_short_send_resubmits_the_rest() -> i32
    var sv: [2]i32
    # socketpair(AF_UNIX, SOCK_STREAM, 0, sv)
    assert syscall4(SYS_SOCKETPAIR, 1, 1, 0, @sv[0] as i64) == 0
    var ring: IoUring
    assert ring.init(8) == 0
    let pool: *TaskPool = malloc(sizeof(TaskPool) as i64) as *TaskPool
    pool.init(@ring)
    let task: *Task = @pool.tasks[0]
    task.id = 4204
    task.fd = sv[0]
    task.user_data = pool as *u8

    let reply: *u8 = malloc(SA_REPLY_LEN as i64)
    var i: i32 = 0
    while i < SA_REPLY_LEN
        reply[i] = ((i * 7 + i / 251) & 255) as u8
        i += 1
    let s: *M7SPSession = m7sp_session_at(9)
    s.send_ptr = reply as i64
    s.send_len = SA_REPLY_LEN
    s.send_pos = 0

    # The first send went out short: the rest is resubmitted.
    task.io_result = SA_SHORT
    assert m7sp_send_progress(task, s) == 1
    assert s.send_pos == SA_SHORT
    # The resubmit only queues its SQE; the run loop enters the ring.
    assert ring.submit() == 1

    let rest: i32 = SA_REPLY_LEN - SA_SHORT
    let got: *u8 = malloc(SA_REPLY_LEN as i64)
    assert sa_read_all(sv[1], got, rest) == rest
    assert memcmp(got, reply + SA_SHORT as i64, rest as i64) == 0

    let cqe: *IoUringCqe = match ring.wait_cqe()
        Some(c) => c
        None => return 1
    assert cqe.user_data == 4204
    assert cqe.res == rest
    ring.cqe_seen(cqe)

    # That completion finishes the reply; nothing more is sent.
    task.io_result = rest
    assert m7sp_send_progress(task, s) == 0
    assert ring.submit() == 0
    var pfd: PollFd
    pfd.fd = sv[1]
    pfd.events = POLLIN
    pfd.revents = 0
    assert sys_poll(@pfd, 1, 100) == 0

    # A failed or zero-byte send ends the session.
    task.io_result = 0
    assert m7sp_send_progress(task, s) == -1

    ring.destroy()
    sys_close(sv[0])
    sys_close(sv[1])
    free(got)
    free(reply)
    free(pool as *u8)
    0
