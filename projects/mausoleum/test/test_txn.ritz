# test/test_txn.ritz - Transaction Manager Tests
#
# Tests for MVCC transaction management: begin, commit, abort,
# conflict detection, and snapshot isolation.

import ritzlib.sys
import ritzlib.strview
import ritzlib.fs { unlink }
import ritzlib.str
import ritzlib.strview
import ritzlib.memory
import ritzlib.option
import ritzlib.string

import lib.m7m_types
import lib.page
import lib.buffer_pool
import lib.wal
import lib.txn

# ============================================================================
# Test Helpers
# ============================================================================

# Every invocation gets its own base path: "/tmp/m7m_txn_test_<pid>_
# <tag>_<seq>".  The pid separates concurrent test processes; the sequence
# separates two calls inside one process (AGAST #4466, same fixed-path bug as
# test_recovery.ritz).
var g_test_path_seq: i64 = 0

fn make_test_path(suffix: *u8) -> *u8
    var path: *u8 = malloc(128)
    if path == null
        return null
    let pid: i32 = sys_getpid()
    let seq: i64 = g_test_path_seq
    g_test_path_seq += 1
    var name: String = string_new()
    format_into(@&name, "/tmp/m7m_txn_test_{pid}_")
    name.push_cstr(suffix)
    format_into(@&name, "_{seq}")
    m7m_path_join(Span<u8> { ptr: path, len: 128 }, name.as_view(), "")
    return path

# Remove every "<base>.wal.<segment>", not just segment 0 (AGAST #4466).
fn cleanup_test_files(base_path: *u8)
    var path_buf: [256]u8
    let base: StrView = strview_from_cstr(base_path)
    m7m_path_join(@path_buf, base, ".wal.")
    let base_len: i64 = base.len
    var seg: i32 = 0
    while seg < 64
        var div: i32 = 100000
        var i: i64 = 0
        while div > 0
            path_buf[base_len + 5 + i] = (48 + ((seg / div) % 10)) as u8
            div = div / 10
            i += 1
        path_buf[base_len + 11] = 0
        unlink(strview_from_cstr(@path_buf[0]))
        seg += 1

# ============================================================================
# Transaction Manager Creation Tests
# ============================================================================

[[test]]
fn test_txn_mgr_new() -> i32
    let base_path: *u8 = make_test_path(c"new")
    let pool_opt = buffer_pool_new(16)
    if option_is_none<*BufferPool>(@pool_opt)
        return 99
    let pool: *BufferPool = option_unwrap_or<*BufferPool>(@pool_opt, null)

    let mgr: *TxnManager = txn_mgr_new(pool, base_path)
    if mgr == null
        return 1

    txn_mgr_destroy(mgr)
    buffer_pool_destroy(pool)
    cleanup_test_files(base_path)
    free(base_path)
    return 0

[[test]]
fn test_txn_mgr_new_null_pool() -> i32
    let base_path: *u8 = make_test_path(c"null_pool")

    let mgr: *TxnManager = txn_mgr_new(null, base_path)
    if mgr != null
        txn_mgr_destroy(mgr)
        return 1

    free(base_path)
    return 0

[[test]]
fn test_txn_mgr_new_null_path() -> i32
    let pool_opt = buffer_pool_new(16)
    if option_is_none<*BufferPool>(@pool_opt)
        return 99
    let pool: *BufferPool = option_unwrap_or<*BufferPool>(@pool_opt, null)

    let mgr: *TxnManager = txn_mgr_new(pool, null)
    if mgr != null
        txn_mgr_destroy(mgr)
        buffer_pool_destroy(pool)
        return 1

    buffer_pool_destroy(pool)
    return 0

# ============================================================================
# Transaction Lifecycle Tests
# ============================================================================

[[test]]
fn test_txn_begin() -> i32
    let base_path: *u8 = make_test_path(c"begin")
    let pool_opt = buffer_pool_new(16)
    if option_is_none<*BufferPool>(@pool_opt)
        return 99
    let pool: *BufferPool = option_unwrap_or<*BufferPool>(@pool_opt, null)
    let mgr: *TxnManager = txn_mgr_new(pool, base_path)

    let txn: *Txn = txn_begin(mgr)
    if txn == null
        txn_mgr_destroy(mgr)
        buffer_pool_destroy(pool)
        cleanup_test_files(base_path)
        free(base_path)
        return 1

    # Transaction should be active
    if txn_state(txn) != TXN_ACTIVE
        txn_abort(txn)
        txn_mgr_destroy(mgr)
        buffer_pool_destroy(pool)
        cleanup_test_files(base_path)
        free(base_path)
        return 2

    # Transaction should have valid ID
    if txn_id(txn) <= 0
        txn_abort(txn)
        txn_mgr_destroy(mgr)
        buffer_pool_destroy(pool)
        cleanup_test_files(base_path)
        free(base_path)
        return 3

    txn_abort(txn)
    txn_mgr_destroy(mgr)
    buffer_pool_destroy(pool)
    cleanup_test_files(base_path)
    free(base_path)
    return 0

[[test]]
fn test_txn_commit() -> i32
    let base_path: *u8 = make_test_path(c"commit")
    let pool_opt = buffer_pool_new(16)
    if option_is_none<*BufferPool>(@pool_opt)
        return 99
    let pool: *BufferPool = option_unwrap_or<*BufferPool>(@pool_opt, null)
    let mgr: *TxnManager = txn_mgr_new(pool, base_path)

    let txn: *Txn = txn_begin(mgr)
    if txn == null
        txn_mgr_destroy(mgr)
        buffer_pool_destroy(pool)
        cleanup_test_files(base_path)
        free(base_path)
        return 1

    let result: i32 = txn_commit(txn)
    if result != ERR_OK
        txn_mgr_destroy(mgr)
        buffer_pool_destroy(pool)
        cleanup_test_files(base_path)
        free(base_path)
        return 2

    # Transaction should be committed
    if txn_state(txn) != TXN_COMMITTED
        txn_mgr_destroy(mgr)
        buffer_pool_destroy(pool)
        cleanup_test_files(base_path)
        free(base_path)
        return 3

    txn_mgr_destroy(mgr)
    buffer_pool_destroy(pool)
    cleanup_test_files(base_path)
    free(base_path)
    return 0

