    if result != ERR_INVALID
        return 1
    return 0

[[test]]
fn test_txn_abort_null() -> i32
    let result: i32 = txn_abort(null)
    if result != ERR_INVALID
        return 1
    return 0

[[test]]
fn test_txn_state_null() -> i32
    let state: i32 = txn_state(null)
    if state != TXN_INVALID
        return 1
    return 0

[[test]]
fn test_txn_id_null() -> i32
    let id: i64 = txn_id(null)
    if id != 0
        return 1
    return 0

# AGAST #4466: two calls must not share a base path, or concurrent runs share
# one WAL.
[[test]]
fn test_txn_test_paths_are_unique() -> i32
    let a: *u8 = make_test_path(c"unique")
    let b: *u8 = make_test_path(c"unique")
    if a == null or b == null
        if a != null
            free(a)
        if b != null
            free(b)
        return 99
    let same: bool = strcmp(a, b) == 0
    cleanup_test_files(a)
    cleanup_test_files(b)
    free(a)
    free(b)
    if same
        return 1
    return 0
