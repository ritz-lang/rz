# test/test_multi_collection.ritz - CONNECT binds a session to its collection
#
# AGAST #3637: the server answered every CONNECT against one global
# collection, whatever name the client sent, so a SCAN by one client saw
# every other client's documents.  These tests run the real server binary
# (./build/debug/mausoleum serve --no-encryption --data-dir DIR, the default
# async loop) and talk to it with lib.client:
#
#   - clients CONNECTed to "a" and "b" each SCAN only their own documents,
#     and a second client on "a" sees the first one's;
#   - after a kill -9 and restart on the same DIR both collections are back.
#
# Readiness probes CONNECT with the empty name (the default collection), so
# they create nothing.  Exit codes 90-93: the server never became ready.

import ritzlib.fmt.digits { fmt_i64_into }
import ritzlib.sys
import ritzlib.fd
import ritzlib.process { fork, exec, kill, wait_pid, try_wait_pid }
import ritzlib.time { sleep_ms }
import ritzlib.span
import ritzlib.result
import ritzlib.option
import ritzlib.fs { remove_dir_all, access }
import ritzlib.str
import ritzlib.memory
import ritzlib.net
import ritzlib.strview
import ritzlib.string

import lib.m7m_types
import lib.protocol
import lib.client
import lib.document
import lib.collection

const PORT_BASE: i32 = 20000
const PORT_SPAN: i32 = 30000
const PORT_ATTEMPTS: i32 = 5
const READY_POLLS: i32 = 200        # x 50ms = 10s max wait per attempt
const OP_TIMEOUT_MS: i32 = 5000
const PR_SET_PDEATHSIG: i64 = 1
const SIG_KILL: i32 = 9
const WAIT_NOHANG: i32 = 1

fn server_bin() -> *u8
    return c"./build/debug/mausoleum"

struct TestServer
    pid: i32
    port: i32
    dir: *u8
    serial: i32     # 1: the --serial loop instead of the async one

# ============================================================================
# Helpers
# ============================================================================

# Remove the directory and everything in it (ritzlib.fs remove_dir_all).
fn rm_dir_flat(dir: *u8)
    remove_dir_all(strview_from_cstr(dir))

# Whether the built server binary is there and executable.
fn access_ok(bin: *u8) -> bool
    match access(strview_from_cstr(bin), X_OK)
        Ok(_) => true
        Err(_) => false

# fork+exec `mausoleum serve --no-encryption --port P --data-dir DIR
# [--serial]`.
fn spawn_server(port: i32, dir: *u8, serial: i32) -> i32
    var port_buf: [20]u8
    let port_str: StrView = fmt_i64_into(@port_buf, port as i64)

    # argv[1..]; exec makes argv[0] the binary's path.
    var args: [7]StrView
    args[0] = "serve"
    args[1] = "--no-encryption"
    args[2] = "--port"
    args[3] = port_str
    args[4] = "--data-dir"
    args[5] = strview_from_cstr(dir)
    var nargs: i64 = 6
    if serial != 0
        args[6] = "--serial"
        nargs = 7

    match fork()
        Ok(fr) =>
            match fr
                Parent(child) => return child
                Child => pass
        Err(e) => return -e.code()
    syscall2(SYS_PRCTL, PR_SET_PDEATHSIG, SIG_KILL as i64)
    match fd_open("/dev/null", O_RDWR, 0)
        Ok(f) =>
            var devnull: Fd = f
            devnull.dup_to(0)
            devnull.dup_to(1)
            devnull.dup_to(2)
            if devnull.raw() > 2
                devnull.close()
        Err(_) => pass
    exec(strview_from_cstr(server_bin()), span_from_ptr<StrView>(@args[0], nargs))
    sys_exit(127)
    return -1

fn server_kill(pid: i32)
    if pid <= 0
        return
    kill(pid, SIG_KILL)
    wait_pid(pid)

fn server_exited(pid: i32) -> i32
    match try_wait_pid(pid)
        Ok(o) =>
            match o
                Some(_) => return 1
                None => return 0
        Err(_) => return 0

# 0 = ready, 1 = exited, 2 = timed out.
fn wait_ready(srv: *TestServer) -> i32
    var i: i32 = 0
    while i < READY_POLLS
        if server_exited(srv.pid) == 1
            srv.pid = 0
            return 1
        let probe: *Client = client_new()
        if probe != null
            if client_connect(probe, "127.0.0.1", srv.port, "") == 0
                client_disconnect(probe)
                client_free(probe)
                return 0
            client_free(probe)
        sleep_ms(50)
        i += 1
    return 2

# Start the server on srv.dir.  `same_port` reuses srv.port (a restart).
fn server_start(srv: *TestServer, same_port: i32) -> i32
    if not access_ok(server_bin())
        return 90
    let base: i32 = PORT_BASE + ((sys_getpid() * 13 + 5) % PORT_SPAN)
    var attempt: i32 = 0
    while attempt < PORT_ATTEMPTS
        if same_port == 0
            srv.port = base + attempt * 7
            if srv.port >= 65000
                srv.port = srv.port - PORT_SPAN
        srv.pid = spawn_server(srv.port, srv.dir, srv.serial)
        if srv.pid < 0
            srv.pid = 0
            return 91
        let r: i32 = wait_ready(srv)
        if r == 0
            return 0
        if r == 2
            server_kill(srv.pid)
            srv.pid = 0
            return 92
        if same_port != 0
            sleep_ms(100)   # the old socket may still hold the port
        attempt += 1
    return 93

fn server_stop(srv: *TestServer)
    server_kill(srv.pid)
    srv.pid = 0

fn connect_to(srv: *TestServer, name: StrView) -> *Client
    let client: *Client = client_new()
    if client == null
        return null
    if client_connect(client, "127.0.0.1", srv.port, name) < 0
        client_free(client)
        return null
    client.sock.set_io_timeout(OP_TIMEOUT_MS)
    return client

fn close_client(client: *Client)
    if client == null
        return
    client_disconnect(client)
    client_free(client)

# Insert `count` documents {"tag": tag}.  0 = ok.
fn insert_tagged(client: *Client, count: i32, tag: i64) -> i32
    var buf: [256]u8
    var i: i32 = 0
    while i < count
        var doc: Document
        var tmp: DocumentId = doc_id_invalid()
        doc_init(@doc, @tmp)
        var f: Field = field_int(tag)
        doc_set_field(@doc, "tag", @f)
        let size: i64 = doc_serialize(@doc, @buf[0], 256)
        if size < 0
            return 1
        if client_insert(client, @buf[0], size as i32) < 0
            return 2
        i += 1
    return 0

# Insert one document {"slug": value}; its document id, or < 0.
fn insert_slugged(client: *Client, value: StrView) -> i64
    var buf: [256]u8
    var doc: Document
    var tmp: DocumentId = doc_id_invalid()
    doc_init(@doc, @tmp)
    var f: Field = field_string(value.ptr, value.len)
    doc_set_field(@doc, "slug", @f)
    let size: i64 = doc_serialize(@doc, @buf[0], 256)
    if size < 0
        return -1
    return client_insert(client, @buf[0], size as i32)

struct ScanTally
    tag: i64
    docs: i32
    foreign: i32

fn scan_tally_step(doc_id: i64, data: *u8, len: i32, user_data: *u8) -> i32
    let t: *ScanTally = user_data as *ScanTally
    t.docs += 1
    var doc: Document
    if doc_deserialize(data, len as i64, @doc) != ERR_OK
        t.foreign += 1
        return 0
    var f: Field
    if doc_get_field(@doc, "tag", @f) != ERR_OK or field_as_int(@f) != t.tag
        t.foreign += 1
    return 0

# SCAN through `client`: the document count, or -1 if any is not tagged
# `tag`, or < -1 if the scan failed.
fn scan_own(client: *Client, tag: i64) -> i32
    var t: ScanTally
    t.tag = tag
    t.docs = 0
    t.foreign = 0
    if client_scan(client, scan_tally_step as *u8, @t as *u8) < 0
        return -2
    if t.foreign != 0
        return -1
    return t.docs

fn make_dir_path(buf: [u8], tag: *u8)
    let pid: i32 = sys_getpid()
    var name: String = string_new()
    format_into(@&name, "/tmp/m7m_multicoll_{pid}_")
    name.push_cstr(tag)
    m7m_path_join(buf, name.as_view(), "")

# ============================================================================
# Checks
# ============================================================================

# Two clients, "a" and "b", both connected at once.
fn check_two_collections(srv: *TestServer) -> i32
    let a: *Client = connect_to(srv, "a")
    let b: *Client = connect_to(srv, "b")
    if a == null or b == null
        close_client(a)
        close_client(b)
        return 1
    var rc: i32 = 0
    if insert_tagged(a, 2, 100) != 0
        rc = 2
    else if insert_tagged(b, 3, 200) != 0
        rc = 3
    else if scan_own(a, 100) != 2
        rc = 4
    else if scan_own(b, 200) != 3
        rc = 5
    close_client(a)
    close_client(b)
    if rc != 0
        return rc
    # A later client on "a" is in the same collection as the first.
    let a2: *Client = connect_to(srv, "a")
    if a2 == null
        return 6
    if scan_own(a2, 100) != 2
        rc = 7
    close_client(a2)
    # The default collection got none of them.
    let d: *Client = connect_to(srv, "")
    if d == null
        return 8
    if rc == 0 and scan_own(d, 0) != 0
        rc = 9
    close_client(d)
    return rc

fn check_after_restart(srv: *TestServer) -> i32
    let a: *Client = connect_to(srv, "a")
    let b: *Client = connect_to(srv, "b")
    if a == null or b == null
        close_client(a)
        close_client(b)
        return 21
    var rc: i32 = 0
    if scan_own(a, 100) != 2
        rc = 22
    else if scan_own(b, 200) != 3
        rc = 23
    close_client(a)
    close_client(b)
    return rc

# ============================================================================
# Secondary field index on the --serial loop (AGAST #4417)
# ============================================================================
#
# #3644 taught the async loop INDEX_CREATE / FIND but left the serial loops
# answering PROTO_ERR_INVALID_MSG_TYPE, so a --serial client (Spire's scan
# fallback) never got an index.  The serial loop serves one connection at a
# time, so the creating client is closed before the finder dials: the index
# lives on the collection, and the second client must see the first one's
# documents.  It must also land on the collection CONNECT selected, not the
# default one.

fn check_serial_field_index(srv: *TestServer) -> i32
    let a: *Client = connect_to(srv, "a")
    if a == null
        return 1
    var rc: i32 = 0
    if client_index_create(a, c"slug", 4) != 0
        rc = 2
    var id1: i64 = -1
    var id2: i64 = -1
    if rc == 0
        id1 = insert_slugged(a, "twice")
        if id1 < 0
            rc = 3
    if rc == 0
        id2 = insert_slugged(a, "twice")
        if id2 < 0
            rc = 4
    if rc == 0 and insert_slugged(a, "only") < 0
        rc = 5
    close_client(a)
    if rc != 0
        return rc

    # A second client on "a", after the first closed: it must find the
    # documents under an index the first one created.
    let b: *Client = connect_to(srv, "a")
    if b == null
        return 6
    # Idempotent ensure, the shape a reconnecting client uses.
    if client_index_create(b, c"slug", 4) != 0
        rc = 7
    var ids: [8]i64
    if rc == 0
        let n: i32 = client_find(b, c"slug", 4, c"twice", 5, @ids[0], 8)
        if n != 2
            rc = 8
        else if ids[0] != id1 or ids[1] != id2
            rc = 9
    if rc == 0 and client_find(b, c"slug", 4, c"only", 4, @ids[0], 8) != 1
        rc = 10
    if rc == 0 and client_find(b, c"slug", 4, c"absent", 6, @ids[0], 8) != 0
        rc = 11
    # No index on another field: the client is told to scan instead.
    if rc == 0 and client_find(b, c"title", 5, c"x", 1, @ids[0], 8) >= 0
        rc = 12
    if rc == 0 and client_last_error(b) != PROTO_ERR_NO_INDEX
        rc = 13
    # A delete removes exactly one copy from the index.
    if rc == 0
        if client_delete(b, id1) != 1
            rc = 14
        else if client_find(b, c"slug", 4, c"twice", 5, @ids[0], 8) != 1
            rc = 15
        else if ids[0] != id2
            rc = 16
    close_client(b)
    if rc != 0
        return rc

    # The index landed on "a" — the collection CONNECT selected — so the
    # default collection has none and says so.
    let d: *Client = connect_to(srv, "")
    if d == null
        return 17
    if client_find(d, c"slug", 4, c"twice", 5, @ids[0], 8) >= 0
        rc = 18
    else if client_last_error(d) != PROTO_ERR_NO_INDEX
        rc = 19
    close_client(d)
    return rc

[[test]]
fn test_serial_loop_secondary_index() -> i32
    var dir: [96]u8
    make_dir_path(@dir, c"serial_index")
    rm_dir_flat(@dir[0])
    var srv: TestServer
    srv.pid = 0
    srv.port = 0
    srv.dir = @dir[0]
    srv.serial = 1
    let started: i32 = server_start(@srv, 0)
    if started != 0
        rm_dir_flat(@dir[0])
        return started
    let rc: i32 = check_serial_field_index(@srv)
    server_stop(@srv)
    rm_dir_flat(@dir[0])
    return rc

# ============================================================================
# Tests
# ============================================================================

[[test]]
fn test_connect_binds_each_client_to_its_collection() -> i32
    var dir: [96]u8
    make_dir_path(@dir, c"sep")
    rm_dir_flat(@dir[0])
    var srv: TestServer
    srv.pid = 0
    srv.port = 0
    srv.dir = @dir[0]
    srv.serial = 0
    let started: i32 = server_start(@srv, 0)
    if started != 0
        rm_dir_flat(@dir[0])
        return started
    let rc: i32 = check_two_collections(@srv)
    server_stop(@srv)
    rm_dir_flat(@dir[0])
    return rc

[[test]]
fn test_restart_keeps_both_collections() -> i32
    var dir: [96]u8
    make_dir_path(@dir, c"restart")
    rm_dir_flat(@dir[0])
    var srv: TestServer
    srv.pid = 0
    srv.port = 0
    srv.dir = @dir[0]
    srv.serial = 0
    var started: i32 = server_start(@srv, 0)
    if started != 0
        rm_dir_flat(@dir[0])
        return started
    var rc: i32 = check_two_collections(@srv)
    server_stop(@srv)   # kill -9
    if rc == 0
        started = server_start(@srv, 1)
        if started != 0
            rc = started
        else
            rc = check_after_restart(@srv)
            server_stop(@srv)
    rm_dir_flat(@dir[0])
    return rc

# The --serial loop serves one connection at a time, so its clients take
# turns; each still lands in its own collection.
fn check_two_collections_in_turn(srv: *TestServer) -> i32
    let a: *Client = connect_to(srv, "a")
    if a == null
        return 1
    var rc: i32 = 0
    if insert_tagged(a, 2, 100) != 0
        rc = 2
    close_client(a)
    if rc != 0
        return rc
    let b: *Client = connect_to(srv, "b")
    if b == null
        return 3
    if insert_tagged(b, 3, 200) != 0
        rc = 4
    else if scan_own(b, 200) != 3
        rc = 5
    close_client(b)
    if rc != 0
        return rc
    let a2: *Client = connect_to(srv, "a")
    if a2 == null
        return 6
    if scan_own(a2, 100) != 2
        rc = 7
    close_client(a2)
    return rc

[[test]]
fn test_serial_loop_binds_each_client_to_its_collection() -> i32
    var dir: [96]u8
    make_dir_path(@dir, c"serial")
    rm_dir_flat(@dir[0])
    var srv: TestServer
    srv.pid = 0
    srv.port = 0
    srv.dir = @dir[0]
    srv.serial = 1
    let started: i32 = server_start(@srv, 0)
    if started != 0
        rm_dir_flat(@dir[0])
        return started
    let rc: i32 = check_two_collections_in_turn(@srv)
    server_stop(@srv)
    rm_dir_flat(@dir[0])
    return rc
