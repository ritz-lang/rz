# test/test_multi_collection.ritz - CONNECT binds a session to its collection
#
# AGAST #3637: the server answered every CONNECT against one global
# collection, whatever name the client sent, so a SCAN by one client saw
# every other client's documents.  These tests run the real server binary
# (./build/debug/mausoleum serve --no-encryption --data-dir DIR, the default
# async loop) and talk to it with lib.client:
#
#   - clients CONNECTed to "a" and "b" each SCAN only their own documents,
#     and a second client on "a" sees the first one's;
#   - after a kill -9 and restart on the same DIR both collections are back.
#
# Readiness probes CONNECT with the empty name (the default collection), so
# they create nothing.  Exit codes 90-93: the server never became ready.

import ritzlib.sys
import ritzlib.str
import ritzlib.memory
import ritzlib.net

import lib.m7m_types
import lib.protocol
import lib.client
import lib.document
import lib.collection

const PORT_BASE: i32 = 20000
const PORT_SPAN: i32 = 30000
const PORT_ATTEMPTS: i32 = 5
const READY_POLLS: i32 = 200        # x 50ms = 10s max wait per attempt
const OP_TIMEOUT_MS: i32 = 5000
const SYS_PRCTL_NR: i64 = 157
const PR_SET_PDEATHSIG: i64 = 1
const SIG_KILL: i32 = 9
const WAIT_NOHANG: i32 = 1

fn server_bin() -> *u8
    return c"./build/debug/mausoleum"

struct TestServer
    pid: i32
    port: i32
    dir: *u8
    serial: i32     # 1: the --serial loop instead of the async one

# ============================================================================
# Helpers
# ============================================================================

fn sleep_ms(ms: i64)
    var ts: [2]i64
    ts[0] = ms / 1000
    ts[1] = (ms % 1000) * 1000000
    sys_nanosleep(@ts[0], null)

fn append_uint(buf: *u8, pos: i64, n: i32) -> i64
    var digits: [16]u8
    var len: i32 = 0
    var v: i32 = n
    if v == 0
        digits[0] = 48
        len = 1
    while v > 0
        digits[len] = ((v % 10) + 48) as u8
        v = v / 10
        len += 1
    var p: i64 = pos
    while len > 0
        len -= 1
        *(buf + p) = digits[len]
        p += 1
    return p

fn append_cstr(buf: *u8, pos: i64, s: *u8) -> i64
    var p: i64 = pos
    var i: i64 = 0
    while *(s + i) != 0
        *(buf + p) = *(s + i)
        p += 1
        i += 1
    return p

fn rm_dir_flat(dir: *u8)
    let fd: i32 = sys_open(dir, O_RDONLY + O_DIRECTORY)
    if fd >= 0
        var ents: [4096]u8
        var child: [512]u8
        loop
            let n: i64 = sys_getdents64(fd, @ents[0], 4096)
            if n <= 0
                break
            var off: i64 = 0
            while off < n
                let rec: *u8 = @ents[off]
                let reclen: i64 = (*(rec + 16) as i64) + ((*(rec + 17) as i64) << 8)
                let name: *u8 = rec + 19
                let is_dot: bool = *name == 46 and *(name + 1) == 0
                let is_dotdot: bool = *name == 46 and *(name + 1) == 46 and *(name + 2) == 0
                if not is_dot and not is_dotdot
                    var p: i64 = append_cstr(@child[0], 0, dir)
                    p = append_cstr(@child[0], p, c"/")
                    p = append_cstr(@child[0], p, name)
                    child[p] = 0
                    sys_unlink(@child[0])
                off += reclen
        sys_close(fd)
    sys_rmdir(dir)

# fork+exec `mausoleum serve --no-encryption --port P --data-dir DIR
# [--serial]`.
fn spawn_server(port: i32, dir: *u8, serial: i32) -> i32
    var port_str: [16]u8
    let end: i64 = append_uint(@port_str[0], 0, port)
    port_str[end] = 0

    var argv: [9]*u8
    argv[0] = server_bin()
    argv[1] = c"serve"
    argv[2] = c"--no-encryption"
    argv[3] = c"--port"
    argv[4] = @port_str[0]
    argv[5] = c"--data-dir"
    argv[6] = dir
    argv[7] = null
    argv[8] = null
    if serial != 0
        argv[7] = c"--serial"

    let pid: i32 = sys_fork()
    if pid != 0
        return pid
    syscall2(SYS_PRCTL_NR, PR_SET_PDEATHSIG, SIG_KILL as i64)
    let devnull: i32 = sys_open(c"/dev/null", 2)
    if devnull >= 0
        sys_dup2(devnull, 0)
        sys_dup2(devnull, 1)
        sys_dup2(devnull, 2)
        if devnull > 2
            sys_close(devnull)
    sys_execve(server_bin(), @argv[0], null)
    sys_exit(127)
    return -1

fn server_kill(pid: i32)
    if pid <= 0
        return
    sys_kill(pid, SIG_KILL)
    var status: i32 = 0
    sys_wait4(pid, @status, 0, null)

fn server_exited(pid: i32) -> i32
    var status: i32 = 0
    if sys_wait4(pid, @status, WAIT_NOHANG, null) == pid
        return 1
    return 0

# 0 = ready, 1 = exited, 2 = timed out.
fn wait_ready(srv: *TestServer) -> i32
    var i: i32 = 0
    while i < READY_POLLS
        if server_exited(srv.pid) == 1
            srv.pid = 0
            return 1
        let probe: *Client = client_new()
        if probe != null
            if client_connect(probe, c"127.0.0.1", srv.port, c"", 0) == 0
                client_disconnect(probe)
                client_free(probe)
                return 0
            client_free(probe)
        sleep_ms(50)
        i += 1
    return 2

# Start the server on srv.dir.  `same_port` reuses srv.port (a restart).
fn server_start(srv: *TestServer, same_port: i32) -> i32
    if sys_access(server_bin(), 1) != 0
        return 90
    let base: i32 = PORT_BASE + ((sys_getpid() * 13 + 5) % PORT_SPAN)
    var attempt: i32 = 0
    while attempt < PORT_ATTEMPTS
        if same_port == 0
            srv.port = base + attempt * 7
            if srv.port >= 65000
                srv.port = srv.port - PORT_SPAN
        srv.pid = spawn_server(srv.port, srv.dir, srv.serial)
        if srv.pid < 0
            srv.pid = 0
            return 91
        let r: i32 = wait_ready(srv)
        if r == 0
            return 0
        if r == 2
            server_kill(srv.pid)
            srv.pid = 0
            return 92
        if same_port != 0
            sleep_ms(100)   # the old socket may still hold the port
        attempt += 1
    return 93

fn server_stop(srv: *TestServer)
    server_kill(srv.pid)
    srv.pid = 0

fn connect_to(srv: *TestServer, name: *u8, len: i32) -> *Client
    let client: *Client = client_new()
    if client == null
        return null
    if client_connect(client, c"127.0.0.1", srv.port, name, len) < 0
        client_free(client)
        return null
    socket_set_io_timeout(@&client.sock, OP_TIMEOUT_MS)
    return client

fn close_client(client: *Client)
    if client == null
        return
    client_disconnect(client)
    client_free(client)

# Insert `count` documents {"tag": tag}.  0 = ok.
fn insert_tagged(client: *Client, count: i32, tag: i64) -> i32
    var buf: [256]u8
    var i: i32 = 0
    while i < count
        var doc: Document
        var tmp: DocumentId = doc_id_invalid()
        doc_init(@doc, @tmp)
        var f: Field = field_int(tag)
        doc_set_field(@doc, "tag", @f)
        let size: i64 = doc_serialize(@doc, @buf[0], 256)
        if size < 0
            return 1
        if client_insert(client, @buf[0], size as i32) < 0
            return 2
        i += 1
    return 0

struct ScanTally
    tag: i64
    docs: i32
    foreign: i32

fn scan_tally_step(doc_id: i64, data: *u8, len: i32, user_data: *u8) -> i32
    let t: *ScanTally = user_data as *ScanTally
    t.docs += 1
    var doc: Document
    if doc_deserialize(data, len as i64, @doc) != ERR_OK
        t.foreign += 1
        return 0
    var f: Field
    if doc_get_field(@doc, "tag", @f) != ERR_OK or field_as_int(@f) != t.tag
        t.foreign += 1
    return 0

# SCAN through `client`: the document count, or -1 if any is not tagged
# `tag`, or < -1 if the scan failed.
fn scan_own(client: *Client, tag: i64) -> i32
    var t: ScanTally
    t.tag = tag
    t.docs = 0
    t.foreign = 0
    if client_scan(client, scan_tally_step as *u8, @t as *u8) < 0
        return -2
    if t.foreign != 0
        return -1
    return t.docs

fn make_dir_path(buf: *u8, tag: *u8)
    var p: i64 = append_cstr(buf, 0, c"/tmp/m7m_multicoll_")
    p = append_uint(buf, p, sys_getpid())
    p = append_cstr(buf, p, c"_")
    p = append_cstr(buf, p, tag)
    *(buf + p) = 0

# ============================================================================
# Checks
# ============================================================================

# Two clients, "a" and "b", both connected at once.
fn check_two_collections(srv: *TestServer) -> i32
    let a: *Client = connect_to(srv, c"a", 1)
    let b: *Client = connect_to(srv, c"b", 1)
    if a == null or b == null
        close_client(a)
        close_client(b)
        return 1
    var rc: i32 = 0
    if insert_tagged(a, 2, 100) != 0
        rc = 2
    else if insert_tagged(b, 3, 200) != 0
        rc = 3
    else if scan_own(a, 100) != 2
        rc = 4
    else if scan_own(b, 200) != 3
        rc = 5
    close_client(a)
    close_client(b)
    if rc != 0
        return rc
    # A later client on "a" is in the same collection as the first.
    let a2: *Client = connect_to(srv, c"a", 1)
    if a2 == null
        return 6
    if scan_own(a2, 100) != 2
        rc = 7
    close_client(a2)
    # The default collection got none of them.
    let d: *Client = connect_to(srv, c"", 0)
    if d == null
        return 8
    if rc == 0 and scan_own(d, 0) != 0
        rc = 9
    close_client(d)
    return rc

fn check_after_restart(srv: *TestServer) -> i32
    let a: *Client = connect_to(srv, c"a", 1)
    let b: *Client = connect_to(srv, c"b", 1)
    if a == null or b == null
        close_client(a)
        close_client(b)
        return 21
    var rc: i32 = 0
    if scan_own(a, 100) != 2
        rc = 22
    else if scan_own(b, 200) != 3
        rc = 23
    close_client(a)
    close_client(b)
    return rc

# ============================================================================
# Tests
# ============================================================================

[[test]]
fn test_connect_binds_each_client_to_its_collection() -> i32
    var dir: [96]u8
    make_dir_path(@dir[0], c"sep")
    rm_dir_flat(@dir[0])
    var srv: TestServer
    srv.pid = 0
    srv.port = 0
    srv.dir = @dir[0]
    srv.serial = 0
    let started: i32 = server_start(@srv, 0)
    if started != 0
        rm_dir_flat(@dir[0])
        return started
    let rc: i32 = check_two_collections(@srv)
    server_stop(@srv)
    rm_dir_flat(@dir[0])
    return rc

[[test]]
fn test_restart_keeps_both_collections() -> i32
    var dir: [96]u8
    make_dir_path(@dir[0], c"restart")
    rm_dir_flat(@dir[0])
    var srv: TestServer
    srv.pid = 0
    srv.port = 0
    srv.dir = @dir[0]
    srv.serial = 0
    var started: i32 = server_start(@srv, 0)
    if started != 0
        rm_dir_flat(@dir[0])
        return started
    var rc: i32 = check_two_collections(@srv)
    server_stop(@srv)   # kill -9
    if rc == 0
        started = server_start(@srv, 1)
        if started != 0
            rc = started
        else
            rc = check_after_restart(@srv)
            server_stop(@srv)
    rm_dir_flat(@dir[0])
    return rc

# The --serial loop serves one connection at a time, so its clients take
# turns; each still lands in its own collection.
fn check_two_collections_in_turn(srv: *TestServer) -> i32
    let a: *Client = connect_to(srv, c"a", 1)
    if a == null
        return 1
    var rc: i32 = 0
    if insert_tagged(a, 2, 100) != 0
        rc = 2
    close_client(a)
    if rc != 0
        return rc
    let b: *Client = connect_to(srv, c"b", 1)
    if b == null
        return 3
    if insert_tagged(b, 3, 200) != 0
        rc = 4
    else if scan_own(b, 200) != 3
        rc = 5
    close_client(b)
    if rc != 0
        return rc
    let a2: *Client = connect_to(srv, c"a", 1)
    if a2 == null
        return 6
    if scan_own(a2, 100) != 2
        rc = 7
    close_client(a2)
    return rc

[[test]]
fn test_serial_loop_binds_each_client_to_its_collection() -> i32
    var dir: [96]u8
    make_dir_path(@dir[0], c"serial")
    rm_dir_flat(@dir[0])
    var srv: TestServer
    srv.pid = 0
    srv.port = 0
    srv.dir = @dir[0]
    srv.serial = 1
    let started: i32 = server_start(@srv, 0)
    if started != 0
        rm_dir_flat(@dir[0])
        return started
    let rc: i32 = check_two_collections_in_turn(@srv)
    server_stop(@srv)
    rm_dir_flat(@dir[0])
    return rc
