# test/test_buffer_pool.ritz - Tests for buffer pool manager
#
# Tests for buffer pool creation, page fetching, pinning, and eviction

import ritzlib.cstr
import ritzlib.sys
import ritzlib.process { process_id }
import ritzlib.result
import ritzlib.strview
import ritzlib.fs { unlink, stat }
import ritzlib.io
import ritzlib.str
import ritzlib.strview
import ritzlib.span
import ritzlib.memory
import ritzlib.option
import ritzlib.box
import ritzlib.string

import lib.m7m_types
import lib.page
import lib.buffer_pool

# ============================================================================
# Buffer Pool Creation Tests
# ============================================================================

[[test]]
fn test_buffer_pool_new() -> i32
    var pool_v: BufferPool = match buffer_pool_new(16)
        Some(v) => v
        None => return 1
    let pool: *BufferPool = @pool_v

    buffer_pool_destroy(pool)
    0

[[test]]
fn test_buffer_pool_default() -> i32
    var pool_v: BufferPool = match buffer_pool_default()
        Some(v) => v
        None => return 1
    let pool: *BufferPool = @pool_v

    buffer_pool_destroy(pool)
    0

[[test]]
fn test_buffer_pool_new_invalid() -> i32
    # Zero frames - should return None
    let pool1_opt = buffer_pool_new(0)
    if option_is_some<BufferPool>(@pool1_opt)
        return 1

    # Negative frames - should return None
    let pool2_opt = buffer_pool_new(-1)
    if option_is_some<BufferPool>(@pool2_opt)
        return 2

    0

# ============================================================================
# Page Allocation Tests (in-memory only, no file)
# ============================================================================

[[test]]
fn test_buffer_pool_alloc_single() -> i32
    var pool_v: BufferPool = match buffer_pool_new(8)
        Some(v) => v
        None => return 1
    let pool: *BufferPool = @pool_v

    let page_opt = buffer_pool_alloc(pool, PAGE_MAGIC_HEAP)
    if option_is_none<*Page>(@page_opt)
        buffer_pool_destroy(pool)
        return 2
    let page: *Page = option_unwrap_or<*Page>(@page_opt, null)

    # Check page is initialized
    if page_type(page) != PAGE_MAGIC_HEAP
        buffer_pool_destroy(pool)
        return 3

    # Get page ID
    var page_id: i64 = buffer_pool_page_id(pool, page)
    if page_id != 0
        buffer_pool_destroy(pool)
        return 4

    buffer_pool_unpin(pool, page_id, 0)
    buffer_pool_destroy(pool)
    0

[[test]]
fn test_buffer_pool_alloc_multiple() -> i32
    var pool_v: BufferPool = match buffer_pool_new(8)
        Some(v) => v
        None => return 1
    let pool: *BufferPool = @pool_v

    let page1_opt = buffer_pool_alloc(pool, PAGE_MAGIC_HEAP)
    let page2_opt = buffer_pool_alloc(pool, PAGE_MAGIC_BTREE)
    let page3_opt = buffer_pool_alloc(pool, PAGE_MAGIC_META)

    if option_is_none<*Page>(@page1_opt) or option_is_none<*Page>(@page2_opt) or option_is_none<*Page>(@page3_opt)
        buffer_pool_destroy(pool)
        return 2

    let page1: *Page = option_unwrap_or<*Page>(@page1_opt, null)
    let page2: *Page = option_unwrap_or<*Page>(@page2_opt, null)
    let page3: *Page = option_unwrap_or<*Page>(@page3_opt, null)

    var id1: i64 = buffer_pool_page_id(pool, page1)
    var id2: i64 = buffer_pool_page_id(pool, page2)
    var id3: i64 = buffer_pool_page_id(pool, page3)

    # Page IDs should be sequential
    if id1 != 0 or id2 != 1 or id3 != 2
        buffer_pool_destroy(pool)
        return 3

    buffer_pool_unpin(pool, id1, 0)
    buffer_pool_unpin(pool, id2, 0)
    buffer_pool_unpin(pool, id3, 0)
    buffer_pool_destroy(pool)
    0

[[test]]
fn test_buffer_pool_alloc_fills_pool() -> i32
    var pool_v: BufferPool = match buffer_pool_new(4)
        Some(v) => v
        None => return 1
    let pool: *BufferPool = @pool_v

    # Allocate 4 pages (fills the pool)
    for i in 0..4
        let page_opt = buffer_pool_alloc(pool, PAGE_MAGIC_HEAP)
        if option_is_none<*Page>(@page_opt)
            buffer_pool_destroy(pool)
            return 2

    # All pages are pinned, so 5th allocation should fail
    let page5_opt = buffer_pool_alloc(pool, PAGE_MAGIC_HEAP)
    if option_is_some<*Page>(@page5_opt)
        buffer_pool_destroy(pool)
        return 3

    buffer_pool_destroy(pool)
    0

[[test]]
fn test_buffer_pool_unpin_allows_eviction() -> i32
    var pool_v: BufferPool = match buffer_pool_new(4)
        Some(v) => v
        None => return 1
    let pool: *BufferPool = @pool_v

    # Allocate 4 pages
    var page_ids: [4]i64
    for i in 0..4
        let page_opt = buffer_pool_alloc(pool, PAGE_MAGIC_HEAP)
        if option_is_none<*Page>(@page_opt)
            buffer_pool_destroy(pool)
            return 2
        let page: *Page = option_unwrap_or<*Page>(@page_opt, null)
        page_ids[i] = buffer_pool_page_id(pool, page)

    # Unpin one page
    buffer_pool_unpin(pool, page_ids[0], 0)

    # Now we can allocate another (evicts the unpinned page)
    let page5_opt = buffer_pool_alloc(pool, PAGE_MAGIC_HEAP)
    if option_is_none<*Page>(@page5_opt)
        buffer_pool_destroy(pool)
        return 3

    buffer_pool_destroy(pool)
    0

# ============================================================================
# Statistics Tests
# ============================================================================

[[test]]
fn test_buffer_pool_stats_initial() -> i32
    var pool_v: BufferPool = match buffer_pool_new(8)
        Some(v) => v
        None => return 1
    let pool: *BufferPool = @pool_v

    if buffer_pool_hit_count(pool) != 0
        buffer_pool_destroy(pool)
        return 2

    if buffer_pool_miss_count(pool) != 0
        buffer_pool_destroy(pool)
        return 3

    if buffer_pool_eviction_count(pool) != 0
        buffer_pool_destroy(pool)
        return 4

    buffer_pool_destroy(pool)
    0

[[test]]
fn test_buffer_pool_eviction_stats() -> i32
    var pool_v: BufferPool = match buffer_pool_new(2)
        Some(v) => v
        None => return 1
    let pool: *BufferPool = @pool_v

    # Allocate 2 pages
    let page1_opt = buffer_pool_alloc(pool, PAGE_MAGIC_HEAP)
    let page2_opt = buffer_pool_alloc(pool, PAGE_MAGIC_HEAP)
    let page1: *Page = option_unwrap_or<*Page>(@page1_opt, null)
    let page2: *Page = option_unwrap_or<*Page>(@page2_opt, null)
    var id1: i64 = buffer_pool_page_id(pool, page1)
    var id2: i64 = buffer_pool_page_id(pool, page2)

    # Unpin both
    buffer_pool_unpin(pool, id1, 0)
    buffer_pool_unpin(pool, id2, 0)

    # Allocate a third - should evict one
    let page3_opt = buffer_pool_alloc(pool, PAGE_MAGIC_HEAP)
    if option_is_none<*Page>(@page3_opt)
        buffer_pool_destroy(pool)
        return 2

    # Check eviction happened
    if buffer_pool_eviction_count(pool) != 1
        buffer_pool_destroy(pool)
        return 3

    buffer_pool_destroy(pool)
    0

# ============================================================================
# Dirty Page Tests
# ============================================================================

[[test]]
fn test_buffer_pool_dirty_tracking() -> i32
    var pool_v: BufferPool = match buffer_pool_new(4)
        Some(v) => v
        None => return 1
    let pool: *BufferPool = @pool_v

    let page_opt = buffer_pool_alloc(pool, PAGE_MAGIC_HEAP)
    let page: *Page = option_unwrap_or<*Page>(@page_opt, null)
    var page_id: i64 = buffer_pool_page_id(pool, page)

    # Modify the page
    page.data[0] = 42

    # Unpin as dirty
    buffer_pool_unpin(pool, page_id, 1)

    # Fetch again - should get same page with our data
    let page2_opt = buffer_pool_fetch(pool, page_id)
    if option_is_none<*Page>(@page2_opt)
        buffer_pool_destroy(pool)
        return 2
    let page2: *Page = option_unwrap_or<*Page>(@page2_opt, null)

    if page2.data[0] != 42
        buffer_pool_destroy(pool)
        return 3

    buffer_pool_unpin(pool, page_id, 0)
    buffer_pool_destroy(pool)
    0

# ============================================================================
# Fetch Tests (in-memory)
# ============================================================================

[[test]]
fn test_buffer_pool_fetch_allocated() -> i32
    var pool_v: BufferPool = match buffer_pool_new(4)
        Some(v) => v
        None => return 1
    let pool: *BufferPool = @pool_v

    let page_opt = buffer_pool_alloc(pool, PAGE_MAGIC_HEAP)
    let page: *Page = option_unwrap_or<*Page>(@page_opt, null)
    var page_id: i64 = buffer_pool_page_id(pool, page)
    page.data[0] = 99

    # Unpin
    buffer_pool_unpin(pool, page_id, 1)

    # Fetch the same page
    let fetched_opt = buffer_pool_fetch(pool, page_id)
    if option_is_none<*Page>(@fetched_opt)
        buffer_pool_destroy(pool)
        return 2
    let fetched: *Page = option_unwrap_or<*Page>(@fetched_opt, null)

    # Should have our data
    if fetched.data[0] != 99
        buffer_pool_destroy(pool)
        return 3

    # Check cache hit
    if buffer_pool_hit_count(pool) != 1
        buffer_pool_destroy(pool)
        return 4

    buffer_pool_unpin(pool, page_id, 0)
    buffer_pool_destroy(pool)
    0

[[test]]
fn test_buffer_pool_fetch_null_pool() -> i32
    let page_opt = buffer_pool_fetch(null, 0)
    if option_is_some<*Page>(@page_opt)
        return 1
    0

[[test]]
fn test_buffer_pool_fetch_negative_id() -> i32
    var pool_v: BufferPool = match buffer_pool_new(4)
        Some(v) => v
        None => return 1
    let pool: *BufferPool = @pool_v

    let page_opt = buffer_pool_fetch(pool, -1)
    if option_is_some<*Page>(@page_opt)
        buffer_pool_destroy(pool)
        return 2

    buffer_pool_destroy(pool)
    0

# ============================================================================
# LRU Eviction Order Tests
# ============================================================================

[[test]]
fn test_buffer_pool_lru_eviction_order() -> i32
    var pool_v: BufferPool = match buffer_pool_new(2)
        Some(v) => v
        None => return 1
    let pool: *BufferPool = @pool_v

    # Allocate page 0
    let page0_opt = buffer_pool_alloc(pool, PAGE_MAGIC_HEAP)
    let page0: *Page = option_unwrap_or<*Page>(@page0_opt, null)
    var id0: i64 = buffer_pool_page_id(pool, page0)
    page0.data[0] = 10
    buffer_pool_unpin(pool, id0, 1)

    # Allocate page 1
    let page1_opt = buffer_pool_alloc(pool, PAGE_MAGIC_HEAP)
    let page1: *Page = option_unwrap_or<*Page>(@page1_opt, null)
    var id1: i64 = buffer_pool_page_id(pool, page1)
    page1.data[0] = 20
    buffer_pool_unpin(pool, id1, 1)

    # Re-fetch page 0 (makes it most recently used)
    let refetched0_opt = buffer_pool_fetch(pool, id0)
    let refetched0: *Page = option_unwrap_or<*Page>(@refetched0_opt, null)
    buffer_pool_unpin(pool, id0, 0)

    # Now allocate page 2 - should evict page 1 (LRU)
    let page2_opt = buffer_pool_alloc(pool, PAGE_MAGIC_HEAP)
    if option_is_none<*Page>(@page2_opt)
        buffer_pool_destroy(pool)
        return 2

    # Page 0 should still be in cache (was MRU)
    let check0_opt = buffer_pool_fetch(pool, id0)
    if option_is_none<*Page>(@check0_opt)
        buffer_pool_destroy(pool)
        return 3
    let check0: *Page = option_unwrap_or<*Page>(@check0_opt, null)

    if check0.data[0] != 10
        buffer_pool_destroy(pool)
        return 4

    buffer_pool_destroy(pool)
    0

# ============================================================================
# Pin Count Tests
# ============================================================================

[[test]]
fn test_buffer_pool_multiple_pins() -> i32
    var pool_v: BufferPool = match buffer_pool_new(2)
        Some(v) => v
        None => return 1
    let pool: *BufferPool = @pool_v

    # Allocate a page
    let page_opt = buffer_pool_alloc(pool, PAGE_MAGIC_HEAP)
    let page: *Page = option_unwrap_or<*Page>(@page_opt, null)
    var page_id: i64 = buffer_pool_page_id(pool, page)

    # Fetch it again (should increase pin count)
    let page2_opt = buffer_pool_fetch(pool, page_id)
    let page2: *Page = option_unwrap_or<*Page>(@page2_opt, null)

    # Both should point to the same page
    if page != page2
        buffer_pool_destroy(pool)
        return 2

    # Unpin once
    buffer_pool_unpin(pool, page_id, 0)

    # Allocate another page - first page still pinned, so use other frame
    let page3_opt = buffer_pool_alloc(pool, PAGE_MAGIC_HEAP)
    let page3: *Page = option_unwrap_or<*Page>(@page3_opt, null)
    var id3: i64 = buffer_pool_page_id(pool, page3)
    buffer_pool_unpin(pool, id3, 0)

    # Try to allocate third - both frames occupied, one pinned
    # Unpin the first completely
    buffer_pool_unpin(pool, page_id, 0)

    # Now allocation should work
    let page4_opt = buffer_pool_alloc(pool, PAGE_MAGIC_HEAP)
    if option_is_none<*Page>(@page4_opt)
        buffer_pool_destroy(pool)
        return 3

    buffer_pool_destroy(pool)
    0

# ============================================================================
# Page-id hash (#2362): fmix64 is murmur3's finaliser on unsigned 64-bit
# values, so every `>> 33` must be a logical shift. Reference values are from
# a u64 fmix64; the old i64 version sign-filled and gave e.g. 0x0 for -1.
# ============================================================================

[[test]]
fn test_fmix64_known_values() -> i32
    # Top bit set: an arithmetic shift would fill the top 33 bits with ones
    if fmix64(0x8000000000000001) != 0x6dd39475fbd3dc62
        return 1
    if fmix64(0xffffffffffffffff) != 0x64b5720b4b825f21
        return 2
    # Small ids go negative after the first multiply, so they catch it too
    if fmix64(1) != 0xb456bcfc34c2cb2c
        return 3
    if fmix64(0) != 0
        return 4
    0

# ============================================================================
# Page free list (AGAST #3638): overflow chains give pages back when a large
# document is rewritten or deleted, and the next allocation reuses them.
# ============================================================================

fn bp_new(frames: i32) -> Box<BufferPool>
    # Empty if out of memory
    match buffer_pool_new(frames)
        Some(p) => return box_new<BufferPool>(p)
        None => return box_empty<BufferPool>()

# Allocate one page of `page_type`, unpinned; its id, or -1.
fn bp_alloc_id(pool: *BufferPool, page_type: i32) -> i64
    let page_opt = buffer_pool_alloc(pool, page_type)
    if option_is_none<*Page>(@page_opt)
        return -1
    let page: *Page = option_unwrap_or<*Page>(@page_opt, null)
    let id: i64 = buffer_pool_page_id(pool, page)
    buffer_pool_unpin(pool, id, 1)
    id

[[test]]
fn test_buffer_pool_freed_page_is_reused() -> i32
    var pool_owner: Box<BufferPool> = bp_new(8)
    let pool: *BufferPool = pool_owner.as_ptr()
    if pool == null
        return 90
    let a: i64 = bp_alloc_id(pool, PAGE_MAGIC_OVERFLOW)
    let b: i64 = bp_alloc_id(pool, PAGE_MAGIC_OVERFLOW)
    let c: i64 = bp_alloc_id(pool, PAGE_MAGIC_OVERFLOW)
    if a != 0 or b != 1 or c != 2
        return 1
    if buffer_pool_free_page(pool, b) != ERR_OK
        return 2
    if buffer_pool_free_page_count(pool) != 1
        return 3
    # The freed page is blanked: nothing of its old contents is left to read.
    let freed_opt = buffer_pool_fetch(pool, b)
    let freed: *Page = option_unwrap_or<*Page>(@freed_opt, null)
    if freed == null or page_type(freed) != PAGE_MAGIC_FREE
        return 4
    buffer_pool_unpin(pool, b, 0)

    # The next allocation takes it back, initialized as asked; then the file
    # grows again.
    let page_opt = buffer_pool_alloc(pool, PAGE_MAGIC_BTREE)
    let page: *Page = option_unwrap_or<*Page>(@page_opt, null)
    if page == null or buffer_pool_page_id(pool, page) != b
        return 5
    if page_type(page) != PAGE_MAGIC_BTREE or page.header.page_id != b
        return 6
    buffer_pool_unpin(pool, b, 1)
    if buffer_pool_free_page_count(pool) != 0
        return 7
    if bp_alloc_id(pool, PAGE_MAGIC_HEAP) != 3
        return 8
    buffer_pool_destroy(pool)
    0

[[test]]
fn test_buffer_pool_free_page_refuses_bad_ids() -> i32
    var pool_owner: Box<BufferPool> = bp_new(8)
    let pool: *BufferPool = pool_owner.as_ptr()
    if pool == null
        return 90
    bp_alloc_id(pool, PAGE_MAGIC_OVERFLOW)
    # Never allocated, negative, or already free: refused, not listed twice.
    if buffer_pool_free_page(pool, 5) != ERR_INVALID
        return 1
    if buffer_pool_free_page(pool, -1) != ERR_INVALID
        return 2
    if buffer_pool_free_page(pool, 0) != ERR_OK
        return 3
    if buffer_pool_free_page(pool, 0) != ERR_INVALID
        return 4
    if buffer_pool_free_page_count(pool) != 1
        return 5
    # Still pinned by someone: refused, so it is never handed out in use.
    let pinned: i64 = bp_alloc_id(pool, PAGE_MAGIC_OVERFLOW)
    let held_opt = buffer_pool_fetch(pool, pinned)
    if buffer_pool_free_page(pool, pinned) != ERR_BUSY
        return 6
    buffer_pool_unpin(pool, pinned, 0)
    if buffer_pool_free_page(pool, pinned) != ERR_OK
        return 7
    buffer_pool_destroy(pool)
    0

# A freed page of a data file is still free when the file is opened again:
# buffer_pool_reclaim_free_pages finds it (and any page never written) so
# the space is not lost to a restart.
[[test]]
fn test_buffer_pool_reclaims_free_pages_of_a_file() -> i32
    let pid: i32 = process_id()
    var path: String = string_new()
    format_into(@&path, "/tmp/mausoleum_bp_free_{pid}")
    unlink(path.as_view())
    var pool_owner: Box<BufferPool> = bp_new(8)
    var pool: *BufferPool = pool_owner.as_ptr()
    if pool == null or buffer_pool_open(pool, path.as_view()) != ERR_OK
        return 90
    for i in 0..4
        bp_alloc_id(pool, PAGE_MAGIC_OVERFLOW)
    if buffer_pool_free_page(pool, 2) != ERR_OK
        return 1
    buffer_pool_destroy(pool)

    pool_owner = bp_new(8)

    pool = pool_owner.as_ptr()
    if pool == null or buffer_pool_open(pool, path.as_view()) != ERR_OK
        return 91
    if buffer_pool_free_page_count(pool) != 0
        return 2
    if buffer_pool_reclaim_free_pages(pool) != ERR_OK
        return 3
    if buffer_pool_free_page_count(pool) != 1
        return 4
    if bp_alloc_id(pool, PAGE_MAGIC_HEAP) != 2
        return 5
    if bp_alloc_id(pool, PAGE_MAGIC_HEAP) != 4
        return 6
    buffer_pool_destroy(pool)
    unlink(path.as_view())
    0

# ============================================================================
# No-steal (AGAST #4205): with buffer_pool_set_no_steal on, a page dirtied
# since the last buffer_pool_mark_logged (the WAL commit) is never evicted,
# so nothing uncommitted reaches the data file.
# ============================================================================

# A fresh /tmp path for this test run (any old file there is removed).
fn bp_tmp_path(tag: StrView) -> String
    let pid: i32 = process_id()
    var name: String = string_new()
    format_into(@&name, "/tmp/mausoleum_bp_{tag}_{pid}")
    unlink(name.as_view())
    return name

fn bp_file_size(path: StrView) -> i64
    match stat(path)
        Ok(st) => st.st_size
        Err(_) => -1

# Fetch page `id` and unpin it clean; 1 if it could be fetched.
fn bp_touch(pool: *BufferPool, id: i64) -> i32
    let page_opt = buffer_pool_fetch(pool, id)
    if option_is_none<*Page>(@page_opt)
        return 0
    buffer_pool_unpin(pool, id, 0)
    1

[[test]]
fn test_buffer_pool_no_steal_keeps_unlogged_pages() -> i32
    let path: String = bp_tmp_path("nosteal")
    var pool_owner: Box<BufferPool> = bp_new(4)
    let pool: *BufferPool = pool_owner.as_ptr()
    if pool == null or buffer_pool_open(pool, path.as_view()) != ERR_OK
        return 90
    buffer_pool_set_no_steal(pool, 1)
    # Page 0, dirty and not yet logged, survives a churn through the pool.
    if bp_alloc_id(pool, PAGE_MAGIC_OVERFLOW) != 0
        return 1
    for i in 0..8
        if bp_touch(pool, 10 + i as i64) == 0
            return 2
    if bp_file_size(path.as_view()) != 0
        return 3
    # So does page 0 re-dirtied by an unpin after it was logged.
    buffer_pool_mark_logged(pool)
    let page_opt = buffer_pool_fetch(pool, 0)
    if option_is_none<*Page>(@page_opt)
        return 4
    buffer_pool_unpin(pool, 0, 1)
    for i in 0..8
        if bp_touch(pool, 20 + i as i64) == 0
            return 5
    if bp_file_size(path.as_view()) != 0
        return 6
    # Every frame dirty and unlogged: a miss finds no frame instead of
    # writing one out.
    for i in 0..3
        if bp_alloc_id(pool, PAGE_MAGIC_OVERFLOW) < 0
            return 7
    if bp_touch(pool, 30) != 0
        return 8
    if bp_file_size(path.as_view()) != 0
        return 9
    # Once logged, they may be evicted (written back) again.
    buffer_pool_mark_logged(pool)
    if bp_touch(pool, 30) == 0
        return 10
    if bp_file_size(path.as_view()) != PAGE_SIZE
        return 11
    buffer_pool_destroy(pool)
    unlink(path.as_view())
    0

# A freshly allocated page is unlogged even if its caller unpins it clean;
# a page written out by a flush is clean and may be evicted again.
[[test]]
fn test_buffer_pool_no_steal_alloc_and_flush() -> i32
    let path: String = bp_tmp_path("nosteal2")
    var pool_owner: Box<BufferPool> = bp_new(4)
    let pool: *BufferPool = pool_owner.as_ptr()
    if pool == null or buffer_pool_open(pool, path.as_view()) != ERR_OK
        return 90
    buffer_pool_set_no_steal(pool, 1)
    let page_opt = buffer_pool_alloc(pool, PAGE_MAGIC_OVERFLOW)
    if option_is_none<*Page>(@page_opt)
        return 1
    buffer_pool_unpin(pool, 0, 0)
    for i in 0..8
        if bp_touch(pool, 10 + i as i64) == 0
            return 2
    if bp_file_size(path.as_view()) != 0
        return 3
    # Fill the pool with unlogged pages, then flush them: no longer pinned
    # down, so a miss finds a frame.
    for i in 0..3
        if bp_alloc_id(pool, PAGE_MAGIC_OVERFLOW) < 0
            return 4
    if bp_touch(pool, 30) != 0
        return 5
    if buffer_pool_flush_all(pool) != ERR_OK
        return 6
    if bp_touch(pool, 30) == 0
        return 7
    buffer_pool_destroy(pool)
    unlink(path.as_view())
    0

# Without no-steal (a pool with no WAL behind it) dirty pages are written
# back on eviction as before.
[[test]]
fn test_buffer_pool_steal_writes_back_dirty_victims() -> i32
    let path: String = bp_tmp_path("steal")
    var pool_owner: Box<BufferPool> = bp_new(4)
    let pool: *BufferPool = pool_owner.as_ptr()
    if pool == null or buffer_pool_open(pool, path.as_view()) != ERR_OK
        return 90
    if bp_alloc_id(pool, PAGE_MAGIC_OVERFLOW) != 0
        return 1
    for i in 0..8
        if bp_touch(pool, 10 + i as i64) == 0
            return 2
    if bp_file_size(path.as_view()) != PAGE_SIZE
        return 3
    buffer_pool_destroy(pool)
