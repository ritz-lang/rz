# test/test_shell.ritz - `mausoleum shell` input handling (AGAST #2458)
#
# The shell read stdin with one read() per "line": piped input such as
# "ping\nquit\n" arrived in one read and was answered "Unknown command".
# LineReader must split it, and put's key=value parser must build the
# document the server stores.

import ritzlib.sys
import ritzlib.result
import ritzlib.fd
import ritzlib.str
import ritzlib.strview
import ritzlib.option

import lib.m7m_types
import lib.document
import lib.collection
import lib.client
import lib.shell

# A pipe whose read end holds `data` and whose write end is closed; a
# closed Fd if pipe(2) fails (its reads then fail, ending the reader).
fn pipe_with(data: StrView) -> Fd
    match pipe()
        Ok(pp) =>
            var p: Pipe = pp
            p.write.write_str(data)
            p.write.close()
            return p.read
        Err(_) => return fd_adopt(-1)

# The reader's next line (cut at max bytes) is `want`.
fn next_is(r: *LineReader, max: i64, want: StrView) -> bool
    let line: Option<StrView> = line_reader_next(r, max)
    if option_is_none<StrView>(@line)
        return false
    return option_unwrap_or<StrView>(@line, strview_empty()).eq(want)

fn at_end(r: *LineReader) -> bool
    let line: Option<StrView> = line_reader_next(r, 63)
    return option_is_none<StrView>(@line)

[[test]]
fn test_line_reader_splits_one_read_into_lines() -> i32
    var fd: Fd = pipe_with("ping\nquit\n")
    var r: LineReader
    line_reader_init(@r, fd)
    var rc: i32 = 0
    if not next_is(@r, 63, "ping")
        rc = 1
    else if not next_is(@r, 63, "quit")
        rc = 2
    else if not at_end(@r)
        rc = 3
    fd.close()
    return rc

[[test]]
fn test_line_reader_crlf_blank_and_unterminated_last_line() -> i32
    var fd: Fd = pipe_with("get 1\r\n\nlist")
    var r: LineReader
    line_reader_init(@r, fd)
    var rc: i32 = 0
    if not next_is(@r, 63, "get 1")
        rc = 1
    else if not next_is(@r, 63, "")
        rc = 2
    else if not next_is(@r, 63, "list")
        rc = 3
    else if not at_end(@r)
        rc = 4
    fd.close()
    return rc

[[test]]
fn test_line_reader_cuts_long_line_and_keeps_going() -> i32
    var fd: Fd = pipe_with("abcdefghij\nok\n")
    var r: LineReader
    line_reader_init(@r, fd)
    var rc: i32 = 0
    if not next_is(@r, 7, "abcdefg")
        rc = 1
    else if not next_is(@r, 7, "ok")
        rc = 2
    fd.close()
    return rc

[[test]]
fn test_build_doc_strings_quotes_and_ints() -> i32
    var doc: Document
    if shell_build_doc("put slug=home title=\"Hello world\" n=42 neg=-3", 3, @doc) != 4
        return 1
    var f: Field
    if doc_get_field(@doc, "slug", @f) != ERR_OK or field_type(@f) != FIELD_STRING
        return 2
    if not field_string_view(@f).eq("home")
        return 3
    if doc_get_field(@doc, "title", @f) != ERR_OK or field_string_len(@f) != 11
        return 4
    if not field_string_view(@f).eq("Hello world")
        return 5
    if doc_get_field(@doc, "n", @f) != ERR_OK or field_type(@f) != FIELD_INT or field_as_int(@f) != 42
        return 6
    if doc_get_field(@doc, "neg", @f) != ERR_OK or field_as_int(@f) != -3
        return 7
    # A quoted number stays a string.
    if shell_build_doc("put v=\"42\"", 3, @doc) != 1
        return 8
    if doc_get_field(@doc, "v", @f) != ERR_OK or field_type(@f) != FIELD_STRING
        return 9
    return 0

[[test]]
fn test_build_doc_rejects_bad_input() -> i32
    var doc: Document
    if shell_build_doc("put", 3, @doc) != SHELL_PUT_NO_FIELDS
        return 1
    if shell_build_doc("put justtext", 3, @doc) != SHELL_PUT_NOT_KEY_VALUE
        return 2
    if shell_build_doc("put =v", 3, @doc) != SHELL_PUT_BAD_KEY
        return 3
    return 0

[[test]]
fn test_parse_id() -> i32
    var v: i64 = 0
    if shell_parse_id("4294967297", @v) != 1 or v != 4294967297
        return 1
    if shell_parse_id("12x", @v) != 0
        return 2
    if shell_parse_id("", @v) != 0
        return 3
    if shell_parse_id("-1", @v) != 0
        return 4
    return 0

# AGAST #4039: ids parse through strview_parse_i64, so the whole non-negative
# i64 range is accepted (the old 18-digit cap refused i64's maximum) and one
# past it is refused rather than wrapped.
[[test]]
fn test_parse_id_extremes() -> i32
    var v: i64 = 7
    if shell_parse_id("9223372036854775807", @v) != 1 or v != 9223372036854775807
        return 1
    if shell_parse_id("0", @v) != 1 or v != 0
        return 2
    v = 7
    if shell_parse_id("9223372036854775808", @v) != 0
        return 3
    if shell_parse_id("99999999999999999999", @v) != 0
        return 4
    if shell_parse_id("-9223372036854775808", @v) != 0
        return 5
    if shell_parse_id("+1", @v) != 0
        return 6
    if v != 7
        return 7
    return 0

# put's integer values: i64's minimum and maximum are ints; one past either
# end, a '+' sign or trailing junk keeps the token a string.
[[test]]
fn test_build_doc_int_extremes() -> i32
    let line: StrView = "put a=-9223372036854775808 b=9223372036854775807 z=0 c=9223372036854775808 d=-9223372036854775809 e=1x f=+5"
    var doc: Document
    if shell_build_doc(line, 3, @doc) != 7
        return 1
    var f: Field
    if doc_get_field(@doc, "a", @f) != ERR_OK or field_type(@f) != FIELD_INT or field_as_int(@f) != -9223372036854775807 - 1
        return 2
    if doc_get_field(@doc, "b", @f) != ERR_OK or field_type(@f) != FIELD_INT or field_as_int(@f) != 9223372036854775807
        return 3
    if doc_get_field(@doc, "z", @f) != ERR_OK or field_type(@f) != FIELD_INT or field_as_int(@f) != 0
        return 4
    if doc_get_field(@doc, "c", @f) != ERR_OK or field_type(@f) != FIELD_STRING or field_string_len(@f) != 19
        return 5
    if doc_get_field(@doc, "d", @f) != ERR_OK or field_type(@f) != FIELD_STRING or field_string_len(@f) != 20
        return 6
    if doc_get_field(@doc, "e", @f) != ERR_OK or field_type(@f) != FIELD_STRING
        return 7
    if doc_get_field(@doc, "f", @f) != ERR_OK or field_type(@f) != FIELD_STRING
        return 8
    return 0
