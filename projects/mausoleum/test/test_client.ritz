# test/test_client.ritz - Tests for client module

import ritzlib.memory
import ritzlib.str

import lib.protocol
import lib.client
import lib.collection { MAX_DOC_SIZE }

# ============================================================================
# Client creation tests
# ============================================================================

[[test]]
fn test_client_new() -> i32
    var client: *Client = client_new()
    assert client != null
    assert client_is_connected(client) == 0
    assert client_session_id(client) == 0
    assert client_has_txn(client) == 0

    client_free(client)
    0

[[test]]
fn test_client_free_null() -> i32
    # Should not crash on null
    client_free(null)
    0

[[test]]
fn test_client_is_connected_null() -> i32
    assert client_is_connected(null) == 0
    0

[[test]]
fn test_client_session_id_null() -> i32
    assert client_session_id(null) == 0
    0

[[test]]
fn test_client_last_error_null() -> i32
    assert client_last_error(null) == PROTO_ERR_INTERNAL
    0

[[test]]
fn test_client_has_txn_null() -> i32
    assert client_has_txn(null) == 0
    0

# ============================================================================
# Disconnected client operation tests
# ============================================================================

[[test]]
fn test_client_ping_not_connected() -> i32
    var client: *Client = client_new()
    let result: i32 = client_ping(client)
    assert result < 0  # Should fail when not connected

    client_free(client)
    0

[[test]]
fn test_client_insert_not_connected() -> i32
    var client: *Client = client_new()
    var data: [8]u8
    memset(@data[0], 0, 8)

    let result: i64 = client_insert(client, @data[0], 8)
    assert result < 0  # Should fail when not connected

    client_free(client)
    0

[[test]]
fn test_client_get_not_connected() -> i32
    var client: *Client = client_new()
    var data: *u8 = null
    var len: i32 = 0

    let result: i32 = client_get(client, 1, @data, @len)
    assert result < 0  # Should fail when not connected

    client_free(client)
    0

[[test]]
fn test_client_delete_not_connected() -> i32
    var client: *Client = client_new()
    let result: i32 = client_delete(client, 1)
    assert result < 0  # Should fail when not connected

    client_free(client)
    0

[[test]]
fn test_client_begin_txn_not_connected() -> i32
    var client: *Client = client_new()
    let result: i64 = client_begin_txn(client)
    assert result < 0  # Should fail when not connected

    client_free(client)
    0

[[test]]
fn test_client_commit_txn_not_connected() -> i32
    var client: *Client = client_new()
    let result: i32 = client_commit_txn(client)
    assert result < 0  # Should fail when not connected

    client_free(client)
    0

[[test]]
fn test_client_abort_txn_not_connected() -> i32
    var client: *Client = client_new()
    let result: i32 = client_abort_txn(client)
    assert result < 0  # Should fail when not connected

    client_free(client)
    0

[[test]]
fn test_client_disconnect_not_connected() -> i32
    var client: *Client = client_new()
    let result: i32 = client_disconnect(client)
    assert result == 0  # Should be no-op

    client_free(client)
    0

# ============================================================================
# Client constant tests
# ============================================================================

[[test]]
fn test_client_buffer_size() -> i32
    assert CLIENT_BUFFER_SIZE == 65536
    0

# ============================================================================
# Null parameter tests
# ============================================================================

[[test]]
fn test_client_connect_null() -> i32
    let result: i32 = client_connect(null, "127.0.0.1", 9999, "test")
    assert result == -1
    0

# #3881: a failed connect keeps the errno from socket_connect_timeout in
# client_last_errno, alongside last_error = PROTO_ERR_DISCONNECTED.
const TEST_EINVAL: i32 = 22
const TEST_ECONNREFUSED: i32 = 111

[[test]]
fn test_client_last_errno_null() -> i32
    assert client_last_errno(null) == 0
    0

[[test]]
fn test_client_connect_bad_host_keeps_einval() -> i32
    var client: *Client = client_new()
    assert client != null
    assert client_last_errno(client) == 0
    # Not a dotted quad: socket_connect_timeout rejects it with EINVAL.
    assert client_connect(client, "not-an-ip", 9999, "test") == -4
    assert client_last_error(client) == PROTO_ERR_DISCONNECTED
    assert client_last_errno(client) == TEST_EINVAL
    assert client_connect_encrypted(client, "not-an-ip", 9999, "test") == -4
    assert client_last_errno(client) == TEST_EINVAL
    client_free(client)
    0

[[test]]
fn test_client_connect_refused_keeps_econnrefused() -> i32
    var client: *Client = client_new()
    assert client != null
    # Nothing listens on 127.0.0.1:1, so the kernel answers with RST.
    assert client_connect(client, "127.0.0.1", 1, "test") == -4
    assert client_last_errno(client) == TEST_ECONNREFUSED
    assert client_connect_encrypted(client, "127.0.0.1", 1, "test") == -4
    assert client_last_errno(client) == TEST_ECONNREFUSED
    client_free(client)
    0

[[test]]
fn test_client_disconnect_null() -> i32
    let result: i32 = client_disconnect(null)
    assert result == -1
    0

[[test]]
fn test_client_ping_null() -> i32
    let result: i32 = client_ping(null)
    assert result == -1
    0

[[test]]
fn test_client_insert_null() -> i32
    var data: [8]u8
    let result: i64 = client_insert(null, @data[0], 8)
    assert result == -1
    0

[[test]]
fn test_client_get_null() -> i32
    var data: *u8 = null
    var len: i32 = 0
    let result: i32 = client_get(null, 1, @data, @len)
    assert result == -1
    0

[[test]]
fn test_client_delete_null() -> i32
    let result: i32 = client_delete(null, 1)
    assert result == -1
    0

[[test]]
fn test_client_begin_txn_null() -> i32
    let result: i64 = client_begin_txn(null)
    assert result == -1
    0

[[test]]
fn test_client_commit_txn_null() -> i32
    let result: i32 = client_commit_txn(null)
    assert result == -1
    0

[[test]]
fn test_client_abort_txn_null() -> i32
    let result: i32 = client_abort_txn(null)
    assert result == -1
    0

# A document over MAX_DOC_SIZE is refused before anything is sent: the
# session stays up (AGAST #2208). The socket is fd -1, so had the client
# tried to send, it would have failed as a disconnect (-2) and dropped it.
[[test]]
fn test_client_insert_refuses_an_oversize_doc_before_sending() -> i32
    let client: *Client = client_new()
    client.connected = 1
    let doc: *u8 = malloc(MAX_DOC_SIZE + 1)
    memset(doc, 0, MAX_DOC_SIZE + 1)
    if client_insert(client, doc, (MAX_DOC_SIZE + 1) as i32) != -4
        return 1
    if client_last_error(client) != PROTO_ERR_DOCUMENT_TOO_LARGE
        return 2
    if client_is_connected(client) != 1
        return 3
    client.connected = 0
    client_free(client)
    0
