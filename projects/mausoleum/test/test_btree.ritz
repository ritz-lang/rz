# ============================================================================
# Large entries (AGAST #2208)
# ============================================================================
#
# A leaf used to split by count without compacting, and leaf_insert_entry
# wrote wherever the data area ended: two ~2 KB entries could not share a
# 4 KB leaf, so the entry inserted after a split overran the slot directory.

# Pseudo-random (but distinct) 12-byte key for i: insertion order is not
# key order, as with mausoleum's little-endian document ids.
fn scrambled_key(i: i32, buf: *u8) -> i32
    make_key((i * 7919) % 100003, buf)

# Room for every leaf these tests make: the pool has no file to evict to.
fn big_test_pool() -> *BufferPool
    let pool_opt = buffer_pool_new(512)
    return option_unwrap_or<*BufferPool>(@pool_opt, null)

fn fill_value(buf: *u8, len: i32, fill: i32)
    memset(buf, fill as u8, len as i64)

# 0 if `key` holds `len` bytes of `fill`.
fn value_is(tree: *BTree, key: *u8, key_len: i32, len: i32, fill: i32) -> i32
    var got: [4096]u8
    var got_len: i32 = 0
    if btree_get(tree, key, key_len, @got[0], @got_len) != ERR_OK
        return 1
    if got_len != len
        return 2
    for i in 0..len
        if got[i] as i32 != fill
            return 3
    0

[[test]]
fn test_btree_max_value_len_is_half_a_leaf() -> i32
    # Two max-size entries (data + slot) must fit one node's data area.
    let max: i32 = btree_max_value_len(12)
    if max <= 0
        return 1
    if 2 * (4 + 12 + max + 4) > PAGE_DATA_SIZE as i32 - 16
        return 2
    # ...and one more byte would not.
    if 2 * (4 + 12 + max + 1 + 4) <= PAGE_DATA_SIZE as i32 - 16
        return 3
    # A longer key leaves less room for the value.
    if btree_max_value_len(1024) != max - (1024 - 12)
        return 4
    0

[[test]]
fn test_btree_put_refuses_an_entry_over_half_a_leaf() -> i32
    var pool: *BufferPool = big_test_pool()
    var tree_opt = btree_create(pool)
    var tree: *BTree = option_unwrap_or<*BTree>(@tree_opt, null)
    if tree == null
        return 10
    var key: [1024]u8
    var val: [4096]u8
    let key_len: i32 = make_key(1, @key[0])
    let max: i32 = btree_max_value_len(key_len)
    if btree_put(tree, @key[0], key_len, @val[0], max + 1) != ERR_INVALID
        return 1
    if btree_put(tree, @key[0], key_len, @val[0], max) != ERR_OK
        return 2
    # The same value under the longest key is over the limit.
    let whole_key: Span<u8> = @key
    whole_key.fill(120)
    if btree_put(tree, @key[0], 1024, @val[0], max) != ERR_INVALID
        return 3
    if btree_count(tree) != 1
        return 4
    btree_destroy(tree)
    buffer_pool_destroy(pool)
    0

[[test]]
fn test_btree_max_size_values_survive_splits() -> i32
    var pool: *BufferPool = big_test_pool()
    var tree_opt = btree_create(pool)
    var tree: *BTree = option_unwrap_or<*BTree>(@tree_opt, null)
    if tree == null
        return 10
    var key: [16]u8
    var val: [4096]u8
    let max: i32 = btree_max_value_len(12)
    for i in 0..60 as i32
        let kl: i32 = scrambled_key(i, @key[0])
        fill_value(@val[0], max, 65 + i % 26)
        if btree_put(tree, @key[0], kl, @val[0], max) != ERR_OK
            return 1
    if btree_count(tree) != 60
        return 2
    for i in 0..60 as i32
        let kl: i32 = scrambled_key(i, @key[0])
        if value_is(tree, @key[0], kl, max, 65 + i % 26) != 0
            return 100 + i
    btree_destroy(tree)
    buffer_pool_destroy(pool)
    0

# Overwriting a key must reuse its space, not leak a page's worth per update.
[[test]]
fn test_btree_repeated_updates_of_large_values() -> i32
    var pool: *BufferPool = big_test_pool()
    var tree_opt = btree_create(pool)
    var tree: *BTree = option_unwrap_or<*BTree>(@tree_opt, null)
    if tree == null
        return 10
    var key: [16]u8
    var val: [4096]u8
    let max: i32 = btree_max_value_len(12)
    # A few small neighbours share the leaf.
    for i in 0..5 as i32
        let kl: i32 = make_key(i, @key[0])
        fill_value(@val[0], 20, 48 + i)
        btree_put(tree, @key[0], kl, @val[0], 20)
    # Alternate two keys, so the entry replaced is not always the newest
    # (lowest) one, whose space would come back without a compaction.
    for round in 0..200
        let r: i32 = round as i32
        let which: i32 = 1 + 2 * (r % 2)
        let kw: i32 = make_key(which, @key[0])
        let len: i32 = max - (r % 3) * 300
        fill_value(@val[0], len, 97 + r % 26)
        if btree_put(tree, @key[0], kw, @val[0], len) != ERR_OK
            return 1
        if value_is(tree, @key[0], kw, len, 97 + r % 26) != 0
            return 2
    if btree_count(tree) != 5
        return 3
    for i in 0..5 as i32
        if i != 1 and i != 3
            let nk: i32 = make_key(i, @key[0])
            if value_is(tree, @key[0], nk, 20, 48 + i) != 0
                return 20 + i
    btree_destroy(tree)
    buffer_pool_destroy(pool)
    0

# A leaf packed with small entries, then large ones landing among them:
# a split by count would leave the large entry's half over-full.
[[test]]
fn test_btree_large_values_among_many_small_ones() -> i32
    var pool: *BufferPool = big_test_pool()
    var tree_opt = btree_create(pool)
    var tree: *BTree = option_unwrap_or<*BTree>(@tree_opt, null)
    if tree == null
        return 10
    var key: [16]u8
    var val: [4096]u8
    let max: i32 = btree_max_value_len(12)
    for i in 0..300 as i32
        let kl: i32 = make_key(i * 10, @key[0])
        fill_value(@val[0], 8, 48 + i % 10)  # a fill byte per i, not decimal formatting (#1957)
        if btree_put(tree, @key[0], kl, @val[0], 8) != ERR_OK
            return 1
    for i in 0..30 as i32
        let kl: i32 = make_key(i * 100 + 5, @key[0])
        fill_value(@val[0], max, 65 + i % 26)
        if btree_put(tree, @key[0], kl, @val[0], max) != ERR_OK
            return 2
    if btree_count(tree) != 330
        return 3
    for i in 0..300 as i32
        let kl: i32 = make_key(i * 10, @key[0])
        if value_is(tree, @key[0], kl, 8, 48 + i % 10) != 0  # the same fill byte
            return 4
    for i in 0..30 as i32
        let kl: i32 = make_key(i * 100 + 5, @key[0])
        if value_is(tree, @key[0], kl, max, 65 + i % 26) != 0
            return 5
    btree_destroy(tree)
    buffer_pool_destroy(pool)
    0

# ============================================================================
# Long keys in internal nodes (AGAST #3640)
# ============================================================================
#
# split_internal split by count and never compacted, and internal_insert_entry
# wrote wherever the data area ended: with keys near BTREE_MAX_KEY_SIZE an
# internal node could be left with too little room, and the next separator
# overran its slot directory.

# Key `n` (make_key's 12 bytes, so keys order by n), padded with 'x' to
# `len` bytes.
fn long_key(n: i32, len: i32, buf: *u8) -> i32
    make_key(n, buf)
    if len > 12
        memset(buf + 12, 120, (len - 12) as i64)
    return len

# The n make_key wrote into the first 12 bytes of `key`.
fn key_number(key: *u8) -> i32
    var n: i32 = 0
    for j in 4..12
        n = n * 10 + (key[j] - 48) as i32
    return n

# 0 if a full scan visits exactly `expect` keys in strictly increasing order.
fn scan_is_ordered(tree: *BTree, expect: i64) -> i32
    var iter_opt = btree_scan(tree, null, 0, null, 0)
    if option_is_none<*BTreeIter>(@iter_opt)
        return 1
    var iter: *BTreeIter = option_unwrap_or<*BTreeIter>(@iter_opt, null)
    var seen: i64 = 0
    var prev: i32 = -1
    var rc: i32 = 0
    while btree_iter_valid(iter) != 0 and rc == 0
        var key: [1024]u8
        var key_len: i32 = 0
        btree_iter_key(iter, @key[0], @key_len)
        let n: i32 = key_number(@key[0])
        if key_len < 12 or n <= prev
            rc = 2
        prev = n
        seen += 1
        btree_iter_next(iter)
    btree_iter_destroy(iter)
    if rc != 0
        return rc
    if seen != expect
        return 3
    0

# Mixed key lengths up to the maximum, inserted in scrambled order: enough
# separators to split internal nodes several times over.
[[test]]
fn test_btree_long_keys_split_internal_nodes() -> i32
    var pool: *BufferPool = big_test_pool()
    var tree_opt = btree_create(pool)
    var tree: *BTree = option_unwrap_or<*BTree>(@tree_opt, null)
    if tree == null
        return 10
    var key: [1024]u8
    var val: [16]u8
    for ii in 0..400
        let i: i32 = ii as i32
        let n: i32 = (i * 7919) % 100003
        let kl: i32 = long_key(n, 1024 - (i % 4) * 300, @key[0])
        fill_value(@val[0], 8, 65 + i % 26)
        if btree_put(tree, @key[0], kl, @val[0], 8) != ERR_OK
            return 1
    if btree_count(tree) != 400
        return 2
    # Internal nodes split, and so did their parents.
    if btree_height(tree) < 4
        return 3
    for ii in 0..400
        let i: i32 = ii as i32
        let n: i32 = (i * 7919) % 100003
        let kl: i32 = long_key(n, 1024 - (i % 4) * 300, @key[0])
        if value_is(tree, @key[0], kl, 8, 65 + i % 26) != 0
            return 100 + i
    let s: i32 = scan_is_ordered(tree, 400)
    if s != 0
        return 20 + s
    btree_destroy(tree)
    buffer_pool_destroy(pool)
    0

# Internal nodes packed with short separators (one leaf per one or two
# max-size values), then maximum-size keys landing among them: each node
# near full must take one more 1034-byte entry.
[[test]]
fn test_btree_max_size_keys_into_full_internal_nodes() -> i32
    var pool: *BufferPool = big_test_pool()
    var tree_opt = btree_create(pool)
    var tree: *BTree = option_unwrap_or<*BTree>(@tree_opt, null)
    if tree == null
        return 10
    var key: [1024]u8
    var val: [4096]u8
    let max: i32 = btree_max_value_len(12)
    for ii in 0..300
        let i: i32 = ii as i32
        let kl: i32 = make_key(((i * 7919) % 300) * 10, @key[0])
        fill_value(@val[0], max, 48 + i % 10)  # a fill byte per i, not decimal formatting (#1957)
        if btree_put(tree, @key[0], kl, @val[0], max) != ERR_OK
            return 1
    for ii in 0..60
        let i: i32 = ii as i32
        let kl: i32 = long_key(((i * 37) % 60) * 50 + 5, 1024, @key[0])
        fill_value(@val[0], 8, 65 + i % 26)
        if btree_put(tree, @key[0], kl, @val[0], 8) != ERR_OK
            return 2
    if btree_count(tree) != 360
        return 3
    for ii in 0..300
        let i: i32 = ii as i32
        let kl: i32 = make_key(((i * 7919) % 300) * 10, @key[0])
        if value_is(tree, @key[0], kl, max, 48 + i % 10) != 0  # the same fill byte
            return 4
    for ii in 0..60
        let i: i32 = ii as i32
        let kl: i32 = long_key(((i * 37) % 60) * 50 + 5, 1024, @key[0])
        if value_is(tree, @key[0], kl, 8, 65 + i % 26) != 0
            return 5
    let s: i32 = scan_is_ordered(tree, 360)
    if s != 0
        return 20 + s
    btree_destroy(tree)
    buffer_pool_destroy(pool)
    0

# ============================================================================
# Empty leaves in scans (AGAST #3687)
# ============================================================================
#
# Deletes never merge or unlink leaves, so a leaf can sit in the chain with
# no keys. A scan that started on one, or stepped onto one, stopped there and
# hid every key in the leaves after it.
#
# Every value here is btree_max_value_len(12) bytes, a 2008-byte entry with
# its slot, and a leaf has 4080 bytes past its header: at most 2 entries per
# leaf. So deleting 4 consecutive keys empties at least one whole leaf, and 6
# empty at least two in a row.

const EMPTY_LEAF_KEYS: i32 = 20

# A tree of keys 0..n-1 with max-size values, then keys [del_lo, del_hi)
# deleted. Null if any step fails.
fn tree_with_hole(pool: *BufferPool, n: i32, del_lo: i32, del_hi: i32) -> *BTree
    var tree_opt = btree_create(pool)
    var tree: *BTree = option_unwrap_or<*BTree>(@tree_opt, null)
    if tree == null
        return null
    var key: [16]u8
    var val: [4096]u8
    let max: i32 = btree_max_value_len(12)
    for i in 0..n
        let kl: i32 = make_key(i, @key[0])
        fill_value(@val[0], max, 65 + i % 26)
        if btree_put(tree, @key[0], kl, @val[0], max) != ERR_OK
            return null
    var d: i32 = del_lo
    while d < del_hi
        let kl: i32 = make_key(d, @key[0])
        if btree_delete(tree, @key[0], kl) != ERR_OK
            return null
        d += 1
    return tree

# 0 if a scan from key `start` (-1: from the beginning) visits exactly the
# keys of 0..n-1 that are >= start and outside [del_lo, del_hi), in order.
fn scan_skips_hole(tree: *BTree, start: i32, n: i32, del_lo: i32, del_hi: i32) -> i32
    var skey: [16]u8
    var iter_opt = btree_scan(tree, null, 0, null, 0)
    if start >= 0
        let sl: i32 = make_key(start, @skey[0])
        iter_opt = btree_scan(tree, @skey[0], sl, null, 0)
    if option_is_none<*BTreeIter>(@iter_opt)
        return 1
    var iter: *BTreeIter = option_unwrap_or<*BTreeIter>(@iter_opt, null)
    # The next key the scan should produce.
    var want: i32 = 0
    if start > 0
        want = start
    var rc: i32 = 0
    while rc == 0
        while want >= del_lo and want < del_hi
            want += 1
        if btree_iter_valid(iter) == 0
            if want < n
                rc = 2  # stopped early: `want` and later keys hidden
            break
        if want >= n
            rc = 3  # a key past the last one
            break
        var key: [16]u8
        var key_len: i32 = 0
        btree_iter_key(iter, @key[0], @key_len)
        if key_len != 12 or key_number(@key[0]) != want
            rc = 4
            break
        want += 1
        btree_iter_next(iter)
    btree_iter_destroy(iter)
    rc

[[test]]
fn test_btree_scan_skips_an_empty_leaf_in_the_middle() -> i32
    var pool: *BufferPool = big_test_pool()
    let tree: *BTree = tree_with_hole(pool, EMPTY_LEAF_KEYS, 8, 12)
    if tree == null
        return 10
    let rc: i32 = scan_skips_hole(tree, -1, EMPTY_LEAF_KEYS, 8, 12)
    btree_destroy(tree)
    buffer_pool_destroy(pool)
    rc

[[test]]
fn test_btree_scan_skips_an_empty_first_leaf() -> i32
    var pool: *BufferPool = big_test_pool()
    let tree: *BTree = tree_with_hole(pool, EMPTY_LEAF_KEYS, 0, 2)
    if tree == null
        return 10
    let rc: i32 = scan_skips_hole(tree, -1, EMPTY_LEAF_KEYS, 0, 2)
    btree_destroy(tree)
    buffer_pool_destroy(pool)
    rc

# Deleting the last keys must still end the scan cleanly, with nothing extra.
[[test]]
fn test_btree_scan_ends_at_an_empty_last_leaf() -> i32
    var pool: *BufferPool = big_test_pool()
    let n: i32 = EMPTY_LEAF_KEYS
    let tree: *BTree = tree_with_hole(pool, n, n - 2, n)
    if tree == null
        return 10
    let rc: i32 = scan_skips_hole(tree, -1, n, n - 2, n)
    btree_destroy(tree)
    buffer_pool_destroy(pool)
    rc

[[test]]
fn test_btree_scan_skips_two_empty_leaves_in_a_row() -> i32
    var pool: *BufferPool = big_test_pool()
    let tree: *BTree = tree_with_hole(pool, EMPTY_LEAF_KEYS, 6, 12)
    if tree == null
        return 10
    let rc: i32 = scan_skips_hole(tree, -1, EMPTY_LEAF_KEYS, 6, 12)
    btree_destroy(tree)
    buffer_pool_destroy(pool)
    rc

# Every start key inside or just before the hole, deleted or not: the scan
# begins on the first remaining key at or after it.
[[test]]
fn test_btree_scan_from_a_key_in_an_emptied_leaf() -> i32
    var pool: *BufferPool = big_test_pool()
    let tree: *BTree = tree_with_hole(pool, EMPTY_LEAF_KEYS, 6, 12)
    if tree == null
        return 10
    var rc: i32 = 0
    for s in (4 as i32)..(13 as i32)
        if rc == 0
            let r: i32 = scan_skips_hole(tree, s, EMPTY_LEAF_KEYS, 6, 12)
            if r != 0
                rc = 10 * s + r
    btree_destroy(tree)
    buffer_pool_destroy(pool)
    rc

# No deletes: a start key absent from the tree, after the last key of its
# leaf, must begin the scan in the next leaf.
[[test]]
fn test_btree_scan_from_an_absent_key_past_its_leaf() -> i32
    var pool: *BufferPool = big_test_pool()
    var tree_opt = btree_create(pool)
    var tree: *BTree = option_unwrap_or<*BTree>(@tree_opt, null)
    if tree == null
        return 10
    var key: [16]u8
    var val: [4096]u8
    let max: i32 = btree_max_value_len(12)
    # Even keys 0, 2, .., 38.
    for i in 0..EMPTY_LEAF_KEYS
        let kl: i32 = make_key(2 * i, @key[0])
        fill_value(@val[0], max, 65)
        if btree_put(tree, @key[0], kl, @val[0], max) != ERR_OK
            return 11
    var rc: i32 = 0
    for j in 0..EMPTY_LEAF_KEYS
        if rc == 0
            # Scan from odd key 2j+1: expect even keys 2j+2 .. 38.
            let sl: i32 = make_key(2 * j + 1, @key[0])
            var iter_opt = btree_scan(tree, @key[0], sl, null, 0)
            var iter: *BTreeIter = option_unwrap_or<*BTreeIter>(@iter_opt, null)
            if iter == null
                return 12
            var seen: i32 = 0
            while btree_iter_valid(iter) != 0
                seen += 1
                btree_iter_next(iter)
            btree_iter_destroy(iter)
            if seen != EMPTY_LEAF_KEYS - 1 - j
                rc = 100 + j
    btree_destroy(tree)
    buffer_pool_destroy(pool)
    rc
