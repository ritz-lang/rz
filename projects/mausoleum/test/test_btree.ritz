[[test]]
fn test_btree_get_after_delete() -> i32
    var pool: *BufferPool = create_test_pool()
    var tree_opt = btree_create(pool)
    if option_is_none<*BTree>(@tree_opt)
        buffer_pool_destroy(pool)
        return 10
    var tree: *BTree = option_unwrap_or<*BTree>(@tree_opt, null)

    var key: [16]u8
    var val: [16]u8
    let key_len: i32 = make_key(42, @key[0])
    let val_len: i32 = make_value(42, @val[0])

    btree_put(tree, @key[0], key_len, @val[0], val_len)
    btree_delete(tree, @key[0], key_len)

    # Get should now return NOT_FOUND
    var result: [16]u8
    var result_len: i32 = 0
    let err: i32 = btree_get(tree, @key[0], key_len, @result[0], @result_len)
    if err != ERR_NOT_FOUND
        btree_destroy(tree)
        buffer_pool_destroy(pool)
        return 1

    btree_destroy(tree)
    buffer_pool_destroy(pool)
    0

# ============================================================================
# Sad Path: Invalid Input
# ============================================================================

[[test]]
fn test_btree_create_null_pool() -> i32
    var tree_opt = btree_create(null)
    if not option_is_none<*BTree>(@tree_opt)
        return 1
    0

[[test]]
fn test_btree_put_null_tree() -> i32
    var key: [16]u8
    var val: [16]u8
    let err: i32 = btree_put(null, @key[0], 12, @val[0], 12)
    if err != ERR_INVALID
        return 1
    0

[[test]]
fn test_btree_put_null_key() -> i32
    var pool: *BufferPool = create_test_pool()
    var tree_opt = btree_create(pool)
    if option_is_none<*BTree>(@tree_opt)
        buffer_pool_destroy(pool)
        return 10
    var tree: *BTree = option_unwrap_or<*BTree>(@tree_opt, null)

    var val: [16]u8
    let err: i32 = btree_put(tree, null, 12, @val[0], 12)

    if err != ERR_INVALID
        btree_destroy(tree)
        buffer_pool_destroy(pool)
        return 1

    btree_destroy(tree)
    buffer_pool_destroy(pool)
    0

