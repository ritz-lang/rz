# test/test_recovery.ritz - Recovery Manager Tests
#
# Tests for crash recovery using WAL replay.

import ritzlib.sys
import ritzlib.result
import ritzlib.fd
import ritzlib.strview
import ritzlib.fs { unlink }
import ritzlib.str
import ritzlib.strview
import ritzlib.memory
import ritzlib.option
import ritzlib.fmt.digits { fmt_i64_into }

import lib.m7m_types
import lib.page
import lib.buffer_pool
import lib.wal
import lib.recovery

# ============================================================================
# Test Helpers
# ============================================================================

# Every invocation gets its own base path: "/tmp/m7m_recovery_test_<pid>_
# <tag>_<seq>".  The pid separates concurrent test processes (a gate checkout
# and another room's `rz test mausoleum`, AGAST #4466); the sequence separates
# two calls inside one process.  Never a fixed path: one run's checkpoint
# truncates the WAL another run is still reading.
var g_test_path_seq: i64 = 0

fn append_cstr(buf: *u8, pos: i64, s: *u8) -> i64
    var i: i64 = 0
    while *(s + i) != 0
        *(buf + pos + i) = *(s + i)
        i += 1
    return pos + i

fn make_test_path(suffix: *u8) -> *u8
    var path: *u8 = malloc(128)
    if path == null
        return null
    var pos: i64 = append_cstr(path, 0, c"/tmp/m7m_recovery_test_")
    pos += fmt_i64_into(path + pos, sys_getpid() as i64)
    pos = append_cstr(path, pos, c"_")
    pos = append_cstr(path, pos, suffix)
    pos = append_cstr(path, pos, c"_")
    pos += fmt_i64_into(path + pos, g_test_path_seq)
    g_test_path_seq += 1
    *(path + pos) = 0
    return path

# Remove every "<base>.wal.<segment>", not just segment 0: WAL segments left
# behind by a crashed run must not poison the next one (AGAST #4466).  Each
# segment is 16MB (WAL_FILE_SIZE), so 64 covers 1GB of scrap.
fn cleanup_test_files(base_path: *u8)
    var path_buf: [256]u8
    let base: StrView = strview_from_cstr(base_path)
    m7m_path_join(@path_buf, base, ".wal.")
    let base_len: i64 = base.len
    var seg: i32 = 0
    while seg < 64
        var div: i32 = 100000
        var i: i64 = 0
        while div > 0
            path_buf[base_len + 5 + i] = (48 + ((seg / div) % 10)) as u8
            div = div / 10
            i += 1
        path_buf[base_len + 11] = 0
        unlink(strview_from_cstr(@path_buf[0]))
        seg += 1

# ============================================================================
# Recovery Manager Creation Tests
# ============================================================================

[[test]]
fn test_recovery_mgr_new() -> i32
    let base_path: *u8 = make_test_path(c"new")
    let pool_opt = buffer_pool_new(16)
    if option_is_none<*BufferPool>(@pool_opt)
        return 99
    let pool: *BufferPool = option_unwrap_or<*BufferPool>(@pool_opt, null)

    let mgr: *RecoveryManager = recovery_mgr_new(pool, base_path)
    if mgr == null
        return 1

    recovery_mgr_destroy(mgr)
    buffer_pool_destroy(pool)
    cleanup_test_files(base_path)
    free(base_path)
    return 0

[[test]]
fn test_recovery_mgr_new_null_pool() -> i32
    let base_path: *u8 = make_test_path(c"null_pool")

    let mgr: *RecoveryManager = recovery_mgr_new(null, base_path)
    if mgr != null
        recovery_mgr_destroy(mgr)
        return 1

    free(base_path)
    return 0

[[test]]
fn test_recovery_mgr_new_null_path() -> i32
    let pool_opt = buffer_pool_new(16)
    if option_is_none<*BufferPool>(@pool_opt)
        return 99
    let pool: *BufferPool = option_unwrap_or<*BufferPool>(@pool_opt, null)

    let mgr: *RecoveryManager = recovery_mgr_new(pool, null)
    if mgr != null
        recovery_mgr_destroy(mgr)
        buffer_pool_destroy(pool)
        return 1

    buffer_pool_destroy(pool)
    return 0

# ============================================================================
# WAL Replay Tests - Empty WAL
# ============================================================================

[[test]]
fn test_recovery_empty_wal() -> i32
    let base_path: *u8 = make_test_path(c"empty")
    let pool_opt = buffer_pool_new(16)
    if option_is_none<*BufferPool>(@pool_opt)
        return 99
    let pool: *BufferPool = option_unwrap_or<*BufferPool>(@pool_opt, null)
    let mgr: *RecoveryManager = recovery_mgr_new(pool, base_path)

    # Recover from empty WAL (no file exists)
    let result: i32 = recovery_recover(mgr)
    if result != ERR_OK
        recovery_mgr_destroy(mgr)
        buffer_pool_destroy(pool)
        free(base_path)
        return 1

    recovery_mgr_destroy(mgr)
    buffer_pool_destroy(pool)
    free(base_path)
    return 0

# ============================================================================
# WAL Replay Tests - Committed Transaction
# ============================================================================

[[test]]
fn test_recovery_single_committed_txn() -> i32
    let base_path: *u8 = make_test_path(c"committed")
    let pool_opt = buffer_pool_new(16)
    if option_is_none<*BufferPool>(@pool_opt)
        return 99
    let pool: *BufferPool = option_unwrap_or<*BufferPool>(@pool_opt, null)

    # Phase 1: Write a committed transaction to WAL
    let writer: *WalWriter = wal_writer_new(base_path)
    wal_writer_open(writer)

    let txn_id: i64 = 1
    let lsn1: i64 = wal_write_begin(writer, txn_id)

    # Write page data
    var page_id_tmp: PageId = page_id_new(0, 1)
    let page_id: i64 = page_id_tmp.value
    var test_data: [16]u8
    test_data[0] = 0x42
    test_data[1] = 0x43
    let lsn2: i64 = wal_write_insert(writer, txn_id, lsn1, page_id, 0, @test_data[0], 16)

    let lsn3: i64 = wal_write_commit(writer, txn_id, lsn2)
    wal_writer_destroy(writer)

    # Phase 2: Recover - committed txn should be replayed
    let mgr: *RecoveryManager = recovery_mgr_new(pool, base_path)
    let result: i32 = recovery_recover(mgr)
    if result != ERR_OK
        recovery_mgr_destroy(mgr)
        buffer_pool_destroy(pool)
        cleanup_test_files(base_path)
        free(base_path)
        return 1

    # Verify recovery replayed the committed transaction
    let stats: *RecoveryStats = recovery_stats(mgr)
    if stats.txns_committed < 1
        recovery_mgr_destroy(mgr)
        buffer_pool_destroy(pool)
        cleanup_test_files(base_path)
        free(base_path)
        return 2
    if stats.txns_aborted != 0
        recovery_mgr_destroy(mgr)
        buffer_pool_destroy(pool)
        cleanup_test_files(base_path)
        free(base_path)
        return 3

    recovery_mgr_destroy(mgr)
    buffer_pool_destroy(pool)
    cleanup_test_files(base_path)
    free(base_path)
    return 0

# ============================================================================
# WAL Replay Tests - Aborted Transaction
# ============================================================================

[[test]]
fn test_recovery_single_aborted_txn() -> i32
    let base_path: *u8 = make_test_path(c"aborted")
    let pool_opt = buffer_pool_new(16)
    if option_is_none<*BufferPool>(@pool_opt)
        return 99
    let pool: *BufferPool = option_unwrap_or<*BufferPool>(@pool_opt, null)

    # Phase 1: Write an aborted transaction to WAL
    let writer: *WalWriter = wal_writer_new(base_path)
    wal_writer_open(writer)

    let txn_id: i64 = 1
    let lsn1: i64 = wal_write_begin(writer, txn_id)

    var page_id_tmp: PageId = page_id_new(0, 1)
    let page_id: i64 = page_id_tmp.value
    var test_data: [16]u8
    test_data[0] = 0x99
    let lsn2: i64 = wal_write_insert(writer, txn_id, lsn1, page_id, 0, @test_data[0], 16)

    # Explicitly abort
    let lsn3: i64 = wal_write_abort(writer, txn_id, lsn2)
    wal_writer_destroy(writer)

    # Phase 2: Recover - aborted txn should NOT be replayed
    let mgr: *RecoveryManager = recovery_mgr_new(pool, base_path)
    let result: i32 = recovery_recover(mgr)
    if result != ERR_OK
        recovery_mgr_destroy(mgr)
        buffer_pool_destroy(pool)
        cleanup_test_files(base_path)
        free(base_path)
        return 1

    let stats: *RecoveryStats = recovery_stats(mgr)
    if stats.txns_committed != 0
        recovery_mgr_destroy(mgr)
        buffer_pool_destroy(pool)
        cleanup_test_files(base_path)
        free(base_path)
        return 2
    if stats.txns_aborted < 1
        recovery_mgr_destroy(mgr)
        buffer_pool_destroy(pool)
        cleanup_test_files(base_path)
        free(base_path)
        return 3

    recovery_mgr_destroy(mgr)
    buffer_pool_destroy(pool)
    cleanup_test_files(base_path)
    free(base_path)
    return 0

# ============================================================================
# WAL Replay Tests - Uncommitted Transaction (crash simulation)
# ============================================================================

[[test]]
fn test_recovery_uncommitted_txn() -> i32
    let base_path: *u8 = make_test_path(c"uncommitted")
    let pool_opt = buffer_pool_new(16)
    if option_is_none<*BufferPool>(@pool_opt)
        return 99
    let pool: *BufferPool = option_unwrap_or<*BufferPool>(@pool_opt, null)

    # Phase 1: Write a transaction WITHOUT commit (simulates crash)
    let writer: *WalWriter = wal_writer_new(base_path)
    wal_writer_open(writer)

    let txn_id: i64 = 1
    let lsn1: i64 = wal_write_begin(writer, txn_id)

    var page_id_tmp: PageId = page_id_new(0, 1)
    let page_id: i64 = page_id_tmp.value
    var test_data: [16]u8
    test_data[0] = 0xAA
    let lsn2: i64 = wal_write_insert(writer, txn_id, lsn1, page_id, 0, @test_data[0], 16)

    # NO COMMIT - simulates crash
    wal_writer_flush(writer)
    wal_writer_destroy(writer)

    # Phase 2: Recover - uncommitted txn should be rolled back
    let mgr: *RecoveryManager = recovery_mgr_new(pool, base_path)
    let result: i32 = recovery_recover(mgr)
    if result != ERR_OK
        recovery_mgr_destroy(mgr)
        buffer_pool_destroy(pool)
        cleanup_test_files(base_path)
        free(base_path)
        return 1

    let stats: *RecoveryStats = recovery_stats(mgr)
    if stats.txns_committed != 0
        recovery_mgr_destroy(mgr)
        buffer_pool_destroy(pool)
        cleanup_test_files(base_path)
        free(base_path)
        return 2
    if stats.txns_aborted < 1
        recovery_mgr_destroy(mgr)
        buffer_pool_destroy(pool)
        cleanup_test_files(base_path)
        free(base_path)
        return 3

    recovery_mgr_destroy(mgr)
    buffer_pool_destroy(pool)
    cleanup_test_files(base_path)
    free(base_path)
    return 0

