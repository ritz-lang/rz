# Checkpoint Tests
# ============================================================================

[[test]]
fn test_recovery_checkpoint_basic() -> i32
    let base_path: *u8 = make_test_path(c"checkpoint")
    let pool_opt = buffer_pool_new(16)
    if option_is_none<*BufferPool>(@pool_opt)
        return 99
    let pool: *BufferPool = option_unwrap_or<*BufferPool>(@pool_opt, null)
    let mgr: *RecoveryManager = recovery_mgr_new(pool, base_path)

    # Take a checkpoint
    let result: i32 = recovery_checkpoint(mgr)
    if result != ERR_OK
        recovery_mgr_destroy(mgr)
        buffer_pool_destroy(pool)
        cleanup_test_files(base_path)
        free(base_path)
        return 1

    recovery_mgr_destroy(mgr)
    buffer_pool_destroy(pool)
    cleanup_test_files(base_path)
    free(base_path)
    return 0

[[test]]
fn test_recovery_after_checkpoint() -> i32
    let base_path: *u8 = make_test_path(c"after_ckpt")
    let pool_opt = buffer_pool_new(16)
    if option_is_none<*BufferPool>(@pool_opt)
        return 99
    let pool: *BufferPool = option_unwrap_or<*BufferPool>(@pool_opt, null)

    # Phase 1: Write some transactions, then checkpoint
    let writer: *WalWriter = wal_writer_new(base_path)
    wal_writer_open(writer)

    # Committed txn before checkpoint
    let txn1: i64 = 1
    var lsn: i64 = wal_write_begin(writer, txn1)
    lsn = wal_write_commit(writer, txn1, lsn)

    # Checkpoint
    wal_write_checkpoint(writer)

    # Committed txn after checkpoint
    let txn2: i64 = 2
    lsn = wal_write_begin(writer, txn2)
    var page_id_tmp: PageId = page_id_new(0, 1)
    let page_id: i64 = page_id_tmp.value
    var data: [8]u8
    data[0] = 0xBB
    lsn = wal_write_insert(writer, txn2, lsn, page_id, 0, @data[0], 8)
    lsn = wal_write_commit(writer, txn2, lsn)

    wal_writer_destroy(writer)

    # Phase 2: Recover
    let mgr: *RecoveryManager = recovery_mgr_new(pool, base_path)
    let result: i32 = recovery_recover(mgr)
    if result != ERR_OK
        recovery_mgr_destroy(mgr)
        buffer_pool_destroy(pool)
        cleanup_test_files(base_path)
        free(base_path)
        return 1

    # Both committed txns should be counted (even pre-checkpoint)
    let stats: *RecoveryStats = recovery_stats(mgr)
    if stats.txns_committed < 2
        recovery_mgr_destroy(mgr)
        buffer_pool_destroy(pool)
        cleanup_test_files(base_path)
        free(base_path)
        return 2

    recovery_mgr_destroy(mgr)
    buffer_pool_destroy(pool)
    cleanup_test_files(base_path)
    free(base_path)
    return 0

# ============================================================================
# Multiple Transactions
# ============================================================================

[[test]]
fn test_recovery_multiple_committed() -> i32
    let base_path: *u8 = make_test_path(c"multi_commit")
    let pool_opt = buffer_pool_new(16)
    if option_is_none<*BufferPool>(@pool_opt)
        return 99
    let pool: *BufferPool = option_unwrap_or<*BufferPool>(@pool_opt, null)

    let writer: *WalWriter = wal_writer_new(base_path)
    wal_writer_open(writer)

    # Write 5 committed transactions
    var i: i64 = 0
    while i < 5
        let txn_id: i64 = i + 1
        var lsn: i64 = wal_write_begin(writer, txn_id)
        lsn = wal_write_commit(writer, txn_id, lsn)
        i += 1

    wal_writer_destroy(writer)

    let mgr: *RecoveryManager = recovery_mgr_new(pool, base_path)
    let result: i32 = recovery_recover(mgr)
    if result != ERR_OK
        recovery_mgr_destroy(mgr)
        buffer_pool_destroy(pool)
        cleanup_test_files(base_path)
        free(base_path)
        return 1

    let stats: *RecoveryStats = recovery_stats(mgr)
    if stats.txns_committed != 5
        recovery_mgr_destroy(mgr)
        buffer_pool_destroy(pool)
        cleanup_test_files(base_path)
        free(base_path)
        return 2

    recovery_mgr_destroy(mgr)
    buffer_pool_destroy(pool)
    cleanup_test_files(base_path)
    free(base_path)
    return 0

[[test]]
fn test_recovery_mixed_txns() -> i32
    let base_path: *u8 = make_test_path(c"mixed")
    let pool_opt = buffer_pool_new(16)
    if option_is_none<*BufferPool>(@pool_opt)
        return 99
    let pool: *BufferPool = option_unwrap_or<*BufferPool>(@pool_opt, null)

    let writer: *WalWriter = wal_writer_new(base_path)
    wal_writer_open(writer)

    # Txn 1: committed
    var lsn: i64 = wal_write_begin(writer, 1)
    lsn = wal_write_commit(writer, 1, lsn)

    # Txn 2: aborted
    lsn = wal_write_begin(writer, 2)
    lsn = wal_write_abort(writer, 2, lsn)

    # Txn 3: committed
    lsn = wal_write_begin(writer, 3)
    lsn = wal_write_commit(writer, 3, lsn)

    # Txn 4: uncommitted (crash)
    lsn = wal_write_begin(writer, 4)

    wal_writer_flush(writer)
    wal_writer_destroy(writer)

    let mgr: *RecoveryManager = recovery_mgr_new(pool, base_path)
    let result: i32 = recovery_recover(mgr)
    if result != ERR_OK
        recovery_mgr_destroy(mgr)
        buffer_pool_destroy(pool)
        cleanup_test_files(base_path)
        free(base_path)
        return 1

    let stats: *RecoveryStats = recovery_stats(mgr)
    if stats.txns_committed != 2
        recovery_mgr_destroy(mgr)
        buffer_pool_destroy(pool)
        cleanup_test_files(base_path)
        free(base_path)
        return 2
    if stats.txns_aborted != 2
        recovery_mgr_destroy(mgr)
        buffer_pool_destroy(pool)
        cleanup_test_files(base_path)
        free(base_path)
        return 3

    recovery_mgr_destroy(mgr)
    buffer_pool_destroy(pool)
    cleanup_test_files(base_path)
    free(base_path)
    return 0

# ============================================================================
# Page Recovery Tests
# ============================================================================

[[test]]
fn test_recovery_page_write_replay() -> i32
    let base_path: *u8 = make_test_path(c"page_write")
    let pool_opt = buffer_pool_new(16)
    if option_is_none<*BufferPool>(@pool_opt)
        return 99
    let pool: *BufferPool = option_unwrap_or<*BufferPool>(@pool_opt, null)

    # Create a page with known content
    var test_page: Page
    var pid: PageId = page_id_new(0, 1)
    page_init_heap(@test_page, pid.value)
    let data: *u8 = page_data(@test_page)
    data[0] = 0xDE
    data[1] = 0xAD
    data[2] = 0xBE
    data[3] = 0xEF

    # Write full page image to WAL in committed transaction
    let writer: *WalWriter = wal_writer_new(base_path)
    wal_writer_open(writer)

    let txn_id: i64 = 1
    var lsn: i64 = wal_write_begin(writer, txn_id)
    lsn = wal_write_page(writer, txn_id, lsn, pid.value, @test_page)
    lsn = wal_write_commit(writer, txn_id, lsn)

    wal_writer_destroy(writer)

    # Recover
    let mgr: *RecoveryManager = recovery_mgr_new(pool, base_path)
    let result: i32 = recovery_recover(mgr)
    if result != ERR_OK
        recovery_mgr_destroy(mgr)
        buffer_pool_destroy(pool)
        cleanup_test_files(base_path)
        free(base_path)
        return 1

    let stats: *RecoveryStats = recovery_stats(mgr)
    if stats.pages_recovered < 1
        recovery_mgr_destroy(mgr)
        buffer_pool_destroy(pool)
        cleanup_test_files(base_path)
        free(base_path)
        return 2

    recovery_mgr_destroy(mgr)
    buffer_pool_destroy(pool)
    cleanup_test_files(base_path)
    free(base_path)
    return 0

# A replayed page image lands on the page it was logged for (AGAST #2458:
# redo used to copy every image into a freshly allocated page instead), and
# the pool never hands that page id out again.
[[test]]
fn test_recovery_page_write_replays_onto_its_own_page() -> i32
    let base_path: *u8 = make_test_path(c"own_page")
    let pool_opt = buffer_pool_new(16)
    if option_is_none<*BufferPool>(@pool_opt)
        return 99
    let pool: *BufferPool = option_unwrap_or<*BufferPool>(@pool_opt, null)

    var img: Page
    page_init_heap(@img, 3)
    let data: *u8 = page_data(@img)
    data[0] = 0xCA
    data[1] = 0xFE

    let writer: *WalWriter = wal_writer_new(base_path)
    wal_writer_open(writer)
    var lsn: i64 = wal_write_begin(writer, 7)
    lsn = wal_write_page(writer, 7, lsn, 3, @img)
    lsn = wal_write_commit(writer, 7, lsn)
    wal_writer_destroy(writer)

    let mgr: *RecoveryManager = recovery_mgr_new(pool, base_path)
    var rc: i32 = 0
    if recovery_recover(mgr) != ERR_OK
        rc = 1
    else
        let got_opt = buffer_pool_fetch(pool, 3)
        if option_is_none<*Page>(@got_opt)
            rc = 2
        else
            let got: *Page = option_unwrap_or<*Page>(@got_opt, null)
            let gd: *u8 = page_data(got)
            if gd[0] != 0xCA or gd[1] != 0xFE
                rc = 3
            buffer_pool_unpin(pool, 3, 0)
        if rc == 0
            # The next fresh page must not collide with the replayed one.
            let fresh_opt = buffer_pool_alloc(pool, PAGE_MAGIC_HEAP)
            if option_is_none<*Page>(@fresh_opt)
                rc = 4
            else
                let fresh: *Page = option_unwrap_or<*Page>(@fresh_opt, null)
                if buffer_pool_page_id(pool, fresh) <= 3
                    rc = 5

    recovery_mgr_destroy(mgr)
    buffer_pool_destroy(pool)
    cleanup_test_files(base_path)
    free(base_path)
    return rc

# A WAL cut off mid-record (a crash during the append) is read up to the
# last whole record: the committed transaction before it is still redone.
# (wal_reader_next reports a short header as ERR_IO, which is -1, the same
# value as its EOF; this pins that a torn tail ends the log, not recovery.)
[[test]]
fn test_recovery_torn_tail_keeps_committed_prefix() -> i32
    let base_path: *u8 = make_test_path(c"torn_tail")
    let pool_opt = buffer_pool_new(16)
    if option_is_none<*BufferPool>(@pool_opt)
        return 99
    let pool: *BufferPool = option_unwrap_or<*BufferPool>(@pool_opt, null)

    var img: Page
    page_init_heap(@img, 2)
    let data: *u8 = page_data(@img)
    data[0] = 0x42

    let writer: *WalWriter = wal_writer_new(base_path)
    wal_writer_open(writer)
    var lsn: i64 = wal_write_begin(writer, 1)
    lsn = wal_write_page(writer, 1, lsn, 2, @img)
    lsn = wal_write_commit(writer, 1, lsn)
    wal_writer_destroy(writer)

    # Append half a record header.
    var path_buf: [256]u8
    m7m_path_join(@path_buf, strview_from_cstr(base_path), ".wal.000000")
    var junk: [16]u8 = [0x5A; 16]
    match fd_open(strview_from_cstr(@path_buf[0]), O_WRONLY | O_APPEND, 420)
        Ok(f) =>
            var wal: Fd = f
            wal.write_all(Span<u8> { ptr: @junk[0], len: 16 })
            wal.close()
        Err(_) => return 90

    let mgr: *RecoveryManager = recovery_mgr_new(pool, base_path)
    var rc: i32 = 0
    if recovery_recover(mgr) != ERR_OK
        rc = 1
    else
        let st: *RecoveryStats = recovery_stats(mgr)
        if st.pages_recovered != 1
            rc = 2
    recovery_mgr_destroy(mgr)
    buffer_pool_destroy(pool)
    cleanup_test_files(base_path)
    free(base_path)
    return rc

# ============================================================================
# Transaction Table Capacity (AGAST #3683)
# ============================================================================

# Usable bytes behind a ritzlib malloc pointer, read from the allocator's
# 16-byte block header: a negative value is a large (mmap) block of -value
# bytes; 0..7 is a size-class bin of 32 << class bytes plus 16.
fn malloc_usable_bytes(p: *u8) -> i64
    let hdr: *i64 = (p as i64 - 16) as *i64
    let v: i64 = *hdr
    if v < 0
        return (0 - v) - 16
    return (16 << v) as i64

# The table was malloc(MAX_ACTIVE_TXNS * 24) for a 32-byte TxnEntry, so it
# held 192 entries while upsert_txn admits 256. Entries 193..256 wrote past
# the allocation: the page rounding hid 193..255, and entry 256 spilled 16
# bytes off the mapping, which did not fault when the next page was mapped.
# Recovery alone stays green on the bug, so check the capacity directly, then
# recover a WAL of 256 committed transactions and read the last entry.
[[test]]
fn test_recovery_txn_table_holds_max_active_txns() -> i32
    let base_path: *u8 = make_test_path(c"max_txns")
    let pool_opt = buffer_pool_new(16)
    if option_is_none<*BufferPool>(@pool_opt)
        return 99
    let pool: *BufferPool = option_unwrap_or<*BufferPool>(@pool_opt, null)

    let writer: *WalWriter = wal_writer_new(base_path)
    wal_writer_open(writer)
    var i: i64 = 0
    while i < MAX_ACTIVE_TXNS
        let txn_id: i64 = i + 1
        var lsn: i64 = wal_write_begin(writer, txn_id)
        lsn = wal_write_commit(writer, txn_id, lsn)
        i += 1
    wal_writer_destroy(writer)

    let mgr: *RecoveryManager = recovery_mgr_new(pool, base_path)
    var rc: i32 = 0
    if mgr == null
        rc = 1
    else if malloc_usable_bytes(mgr.txn_table as *u8) < MAX_ACTIVE_TXNS * sizeof(TxnEntry)
        rc = 2
    else if recovery_recover(mgr) != ERR_OK
        rc = 3
    else if recovery_stats(mgr).txns_committed != MAX_ACTIVE_TXNS
        rc = 4
    else if mgr.txn_count != MAX_ACTIVE_TXNS
        rc = 5
    else
        let last: *TxnEntry = mgr.txn_table + (MAX_ACTIVE_TXNS - 1)
        if last.txn_id != MAX_ACTIVE_TXNS or last.state != TXN_STATE_COMMITTED
            rc = 6

    if mgr != null
        recovery_mgr_destroy(mgr)
    buffer_pool_destroy(pool)
    cleanup_test_files(base_path)
    free(base_path)
    return rc

# ============================================================================
# Error Handling Tests
# ============================================================================

[[test]]
fn test_recovery_corrupted_wal() -> i32
    let base_path: *u8 = make_test_path(c"corrupt")
    let pool_opt = buffer_pool_new(16)
    if option_is_none<*BufferPool>(@pool_opt)
        return 99
    let pool: *BufferPool = option_unwrap_or<*BufferPool>(@pool_opt, null)

    # Write garbage to WAL file
    var path_buf: [256]u8
    m7m_path_join(@path_buf, strview_from_cstr(base_path), ".wal.000000")

    var garbage: [64]u8
    garbage[0] = 0xFF
    garbage[1] = 0xFE
    garbage[2] = 0xFD
    match fd_open(strview_from_cstr(@path_buf[0]), O_RDWR | O_CREAT | O_TRUNC, 420)
        Ok(f) =>
            var wal: Fd = f
            wal.write_all(Span<u8> { ptr: @garbage[0], len: 64 })
            wal.close()
        Err(_) => return 90

    # Recovery should handle corruption gracefully
    let mgr: *RecoveryManager = recovery_mgr_new(pool, base_path)
    let result: i32 = recovery_recover(mgr)
    # Should return error for corrupted WAL
    if result == ERR_OK
        recovery_mgr_destroy(mgr)
        buffer_pool_destroy(pool)
        cleanup_test_files(base_path)
        free(base_path)
        return 1

    recovery_mgr_destroy(mgr)
    buffer_pool_destroy(pool)
    cleanup_test_files(base_path)
    free(base_path)
    return 0

[[test]]
fn test_recovery_null_manager() -> i32
    let result: i32 = recovery_recover(null)
    if result != ERR_INVALID
        return 1
    return 0

[[test]]
fn test_recovery_checkpoint_null() -> i32
    let result: i32 = recovery_checkpoint(null)
    if result != ERR_INVALID
        return 1
    return 0

# AGAST #4466: a fixed "/tmp/m7m_recovery_test_<tag>" base path let two
# concurrent `rz test mausoleum` runs share one WAL, so one run's checkpoint
# truncated records the other was still counting (test_recovery_after_checkpoint
# failed with txns_committed < 2).  Every invocation must hand out its own
# base path, even within one process.
[[test]]
fn test_recovery_test_paths_are_unique() -> i32
    let a: *u8 = make_test_path(c"unique")
    let b: *u8 = make_test_path(c"unique")
    if a == null or b == null
        if a != null
            free(a)
        if b != null
            free(b)
        return 99
    let same: bool = strcmp(a, b) == 0
    cleanup_test_files(a)
    cleanup_test_files(b)
    free(a)
    free(b)
    if same
        return 1
    return 0
