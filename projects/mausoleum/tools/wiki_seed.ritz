# tools/wiki_seed.ritz - Seed wiki pages into Mausoleum
#
# Seeds initial wiki content into the mausoleum database.
#
# Usage:
#   wiki-seed [--host HOST] [--port PORT] [--seed] [--verify] [--no-encryption]
#
# Speaks the encrypted protocol by default, like `mausoleum serve`.

import ritzlib.sys
import ritzlib.io
import ritzlib.fmt
import ritzlib.span { Span }
import ritzlib.strview
import ritzlib.memory

import lib.m7m_types
import lib.protocol
import lib.client
import lib.document
import lib.collection
import lib.cliarg

# ============================================================================
# Constants
# ============================================================================

const DEFAULT_PORT: i32 = 7777
# nexus's collection (src/repos/wiki_page_repo.ritz).  This seeded
# "wiki_pages" until #3637, which reached nexus only because the server put
# every name in one collection.
const COLLECTION_NAME: StrView = "nexus_pages"

# ============================================================================
# Helpers
# ============================================================================

fn print_i32(n: i32)
    print_i64(n as i64)

fn print_error(msg: StrView)
    prints("ERROR: ")
    prints(msg)
    prints("\n")

fn print_ok(msg: StrView)
    prints("  [OK] ")
    prints(msg)
    prints("\n")

# An integer flag's value refused by cliarg_parse_i32 (#4039): the old
# parse_int_arg skipped non-digits and wrapped past i32.
fn bad_int_arg(flag: StrView, value: StrView) -> i32
    print("ERROR: invalid {flag} value: {value}\n")
    return 1

# ============================================================================
# Wiki Page Document Creation
# ============================================================================

fn create_wiki_page_doc(slug: StrView, title: StrView, content: StrView, buf: *u8, buf_len: i64) -> i64
    var doc: Document
    var tmp_id: DocumentId = doc_id_invalid()
    doc_init(@doc, @tmp_id)

    var slug_field: Field = field_string(slug.ptr, slug.len)
    doc_set_field(@doc, "slug", @slug_field)

    var title_field: Field = field_string(title.ptr, title.len)
    doc_set_field(@doc, "title", @title_field)

    var content_field: Field = field_string(content.ptr, content.len)
    doc_set_field(@doc, "content", @content_field)

    var version_field: Field = field_int(1)
    doc_set_field(@doc, "version", @version_field)

    return doc_serialize(@doc, buf, buf_len)

fn insert_page(client: *Client, slug: StrView, title: StrView, content: StrView) -> i64
    var buf: [8192]u8
    let doc_size: i64 = create_wiki_page_doc(slug, title, content, @buf[0], 8192)
    if doc_size < 0
        return -1
    return client_insert(client, @buf[0], doc_size as i32)

# ============================================================================
# Seed Pages
# ============================================================================

fn seed_wiki_pages(client: *Client) -> i32
    prints("\nSeeding wiki pages...\n")
    var doc_id: i64 = 0

    # Page 1: Welcome
    doc_id = insert_page(client, "welcome", "Welcome to Nexus", "# Welcome to Nexus\n\nNexus is the **Ritz Knowledge Base** - a wiki built entirely in Ritz.\n\n## What is Ritz?\n\nRitz is a systems programming language with no libc dependency.\n\n## Getting Started\n\nCheck out [Getting Started](/wiki/getting-started) to learn more.")
    if doc_id < 0
        print_error("Failed to insert welcome page")
        return 1
    prints("  [OK] welcome (id=")
    print_i64(doc_id)
    prints(")\n")

    # Page 2: Getting Started
    doc_id = insert_page(client, "getting-started", "Getting Started", "# Getting Started\n\n## Viewing Pages\n\nNavigate to `/wiki/<slug>` to view any page.\n\n## Creating Pages\n\nClick **New Page** and enter a slug, title, and content.\n\n## Editing Pages\n\nClick **Edit** on any page to modify it.")
    if doc_id < 0
        print_error("Failed to insert getting-started page")
        return 1
    prints("  [OK] getting-started (id=")
    print_i64(doc_id)
    prints(")\n")

    # Page 3: Ritz Language
    doc_id = insert_page(client, "ritz", "The Ritz Language", "# The Ritz Programming Language\n\nRitz is a modern systems programming language.\n\n## Features\n\n- No libc dependency\n- Ownership and borrowing\n- Modern syntax\n- Fast compilation\n\n## Learn More\n\n- [Syntax Guide](/wiki/ritz/syntax)\n- [Standard Library](/wiki/ritz/stdlib)")
    if doc_id < 0
        print_error("Failed to insert ritz page")
        return 1
    prints("  [OK] ritz (id=")
    print_i64(doc_id)
    prints(")\n")

    # Page 4: Ritz Syntax
    doc_id = insert_page(client, "ritz/syntax", "Ritz Syntax Guide", "# Ritz Syntax Guide\n\n## Variables\n\n```ritz\nlet x: i32 = 42    # immutable\nvar y: i32 = 0     # mutable\n```\n\n## Functions\n\n```ritz\nfn add(a: i32, b: i32) -> i32\n    a + b\n```\n\n## Ownership\n\n- `data: T` - const borrow\n- `data:& T` - mutable borrow\n- `data:= T` - move ownership")
    if doc_id < 0
        print_error("Failed to insert syntax page")
        return 1
    prints("  [OK] ritz/syntax (id=")
    print_i64(doc_id)
    prints(")\n")

    # Page 5: Mausoleum
    doc_id = insert_page(client, "mausoleum", "Mausoleum Database", "# Mausoleum\n\n*Where data is entombed forever.*\n\nMausoleum is a document database for Ritz.\n\n## Features\n\n- Document storage\n- B-tree indexing\n- MVCC versioning\n- Graph relationships\n\n## Operations\n\n- INSERT - Add documents\n- GET - Retrieve by ID\n- UPDATE - Modify documents\n- DELETE - Remove documents")
    if doc_id < 0
        print_error("Failed to insert mausoleum page")
        return 1
    prints("  [OK] mausoleum (id=")
    print_i64(doc_id)
    prints(")\n")

    prints("\nSeeding complete! Created 5 wiki pages.\n")
    return 0

# ============================================================================
# Verify Pages
# ============================================================================

# What verify_wiki_pages looks for: the page with slug "welcome".
struct WelcomeHunt
    found: i32
    doc_id: i64
    len: i32

fn welcome_hunt_step(doc_id: i64, data: *u8, len: i32, user: *u8) -> i32
    let hunt: *WelcomeHunt = user as *WelcomeHunt
    var doc: Document
    if doc_deserialize(data, len as i64, @doc) != ERR_OK
        return 0
    var slug: Field
    if doc_get_field(@doc, "slug", @slug) != ERR_OK or slug.ftype != FIELD_STRING
        return 0
    if not field_string_view(@slug).eq("welcome")
        return 0
    hunt.found = 1
    hunt.doc_id = doc_id
    hunt.len = len
    return 1   # stop the scan

# The seeded welcome page is in the collection, found by its slug.  (This
# used to GET id 4294967297, the first document of collection 1, which only
# held while every CONNECT name shared one collection; AGAST #3637.)
fn verify_wiki_pages(client: *Client) -> i32
    prints("\nVerifying wiki pages...\n")

    var hunt: WelcomeHunt
    hunt.found = 0
    hunt.doc_id = 0
    hunt.len = 0
    let scanned: i32 = client_scan(client, welcome_hunt_step as *u8, @hunt as *u8)
    if scanned < 0
        prints("  [FAIL] Error scanning the collection: ")
        print_i32(scanned)
        prints("\n")
        return 1
    if hunt.found == 0
        prints("  [FAIL] Page welcome not found\n")
        return 1

    prints("  [OK] Page welcome found (id=")
    print_i64(hunt.doc_id)
    prints(", ")
    print_i32(hunt.len)
    prints(" bytes)\n")
    prints("\nVerification complete!\n")
    return 0

# ============================================================================
# Main Entry Point
# ============================================================================

pub fn main(args: Span<StrView>) -> i32
    prints("Wiki Page Seeder\n")
    prints("================\n\n")

    var host: StrView = "127.0.0.1"
    var port: i32 = DEFAULT_PORT
    var do_seed: i32 = 0
    var do_verify: i32 = 0
    var no_encryption: i32 = 0

    var i: i64 = 1
    while i < args.len
        let arg: StrView = args[i]

        if arg.eq("--host") or arg.eq("-h")
            if i + 1 < args.len
                host = args[i + 1]
                i += 2
            else
                print_error("--host requires an argument")
                return 1
        else if arg.eq("--port") or arg.eq("-p")
            if i + 1 < args.len
                let value: StrView = args[i + 1]
                if cliarg_parse_i32(value, @port) == 0
                    return bad_int_arg("--port", value)
                i += 2
            else
                print_error("--port requires an argument")
                return 1
        else if arg.eq("--seed") or arg.eq("-s")
            do_seed = 1
            i += 1
        else if arg.eq("--verify") or arg.eq("-v")
            do_verify = 1
            i += 1
        else if arg.eq("--no-encryption")
            no_encryption = 1
            i += 1
        else if arg.eq("--encrypted")
            no_encryption = 0
            i += 1
        else if arg.eq("--help")
            prints("Usage: wiki-seed [OPTIONS]\n\n")
            prints("Options:\n")
            prints("  --host, -h HOST    Mausoleum host (default: 127.0.0.1)\n")
            prints("  --port, -p PORT    Mausoleum port (default: 7777)\n")
            prints("  --seed, -s         Seed initial wiki pages\n")
            prints("  --verify, -v       Verify pages exist\n")
            prints("  --no-encryption    Speak plain M7SP (for `mausoleum serve --no-encryption`)\n")
            prints("  --encrypted        Speak encrypted M7SP (the default, like the server)\n")
            prints("  --help             Show this help\n")
            prints("\nExits non-zero if it cannot connect, a write fails or --verify misses.\n")
            return 0
        else
            print("Unknown argument: {arg}\n")
            return 1

    print("Connecting to mausoleum at {host}:{port}")
    if no_encryption != 0
        prints(" (plain)...\n")
    else
        prints(" (encrypted)...\n")

    var client: *Client = client_new()
    if client == null
        print_error("Failed to create client")
        return 1

    var connect_result: i32 = 0
    if no_encryption != 0
        connect_result = client_connect(client, host, port, COLLECTION_NAME)
    else
        connect_result = client_connect_encrypted(client, host, port, COLLECTION_NAME)
    if connect_result < 0
        print_error("Failed to connect to mausoleum")
        prints("  Error code: ")
        print_i32(connect_result)
        if client_last_errno(client) != 0
            prints(" (errno ")
            print_i32(client_last_errno(client))
            prints(")")
        prints("\n")
        if no_encryption != 0
            prints("  Is mausoleum running with --no-encryption on that port?\n")
        else
            prints("  Is mausoleum running (encrypted) on that port? For a\n")
            prints("  --no-encryption server pass --no-encryption here too.\n")
        client_free(client)
        return 1

    print_ok("Connected to mausoleum")

    if do_seed != 0
        let seed_result: i32 = seed_wiki_pages(client)
        if seed_result != 0
            client_disconnect(client)
            client_free(client)
            return seed_result

    if do_verify != 0
        let verify_result: i32 = verify_wiki_pages(client)
        if verify_result != 0
            client_disconnect(client)
            client_free(client)
            return verify_result

    if do_seed == 0 and do_verify == 0
        prints("\nNo action specified. Use --seed to seed or --verify to check.\n")

    client_disconnect(client)
    client_free(client)

    prints("\nDone!\n")
    return 0
