# lib/cliarg.ritz - range-checked integer parsing (AGAST #4039)
#
# A thin range check over ritzlib's strview_parse_i64, which takes an
# optional sign then digits only and refuses anything outside i64.  The
# hand-rolled loops this replaces (main.ritz parse_int, the tools'
# parse_int_arg) skipped non-digits and wrapped silently on overflow.

import ritzlib.strview
import ritzlib.option

# s as a decimal integer in [lo, hi].  Returns 1 and sets *out, or returns
# 0 and leaves *out alone.
pub fn cliarg_parse_i64_in(s: StrView, lo: i64, hi: i64, out: *i64) -> i32
    match s.parse_i64()
        Some(n) => cliarg_set_in(n, lo, hi, out)
        None => 0

fn cliarg_set_in(n: i64, lo: i64, hi: i64, out: *i64) -> i32
    if n < lo or n > hi
        return 0
    *out = n
    return 1

# An argument (argv) as an i32.  1 = ok, 0 = not an integer
# or outside i32; *out is untouched on failure.
pub fn cliarg_parse_i32(s: StrView, out: *i32) -> i32
    var v: i64 = 0
    if cliarg_parse_i64_in(s, -2147483648, 2147483647, @v) == 0
        return 0
    *out = v as i32
    return 1
