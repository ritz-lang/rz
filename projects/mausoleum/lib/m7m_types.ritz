# lib/types.ritz - Core type definitions for Mausoleum
#
# Fundamental types used throughout the database engine:
# - Page identifiers and offsets
# - Result types for error handling
# - Common constants

import ritzlib.sys
import ritzlib.time { now }
import ritzlib.str
import ritzlib.strview
import ritzlib.span
import ritzlib.string
import ritzlib.result
import ritzlib.option

# ============================================================================
# Page Constants
# ============================================================================

# Page size: 4KB default (matches OS page size for mmap efficiency)
const PAGE_SIZE: i64 = 4096

# Maximum pages per file (4KB pages * 2^32 = 16TB max file size)
const MAX_PAGES: i64 = 4294967296

# Invalid page ID sentinel
const INVALID_PAGE_ID: i64 = -1

# ============================================================================
# Page Types
# ============================================================================

# PageId: Unique identifier for a page within a database file
# Layout: file_id (high 32 bits) | page_num (low 32 bits)
struct PageId
    value: i64

pub fn page_id_new(file_id: i32, page_num: i32) -> PageId
    var id: PageId
    id.value = ((file_id as i64) << 32) | (page_num as i64 & 0xFFFFFFFF)
    return id

pub fn page_id_file(id: *PageId) -> i32
    return (id.value >> 32) as i32

pub fn page_id_num(id: *PageId) -> i32
    return (id.value & 0xFFFFFFFF) as i32

pub fn page_id_is_valid(id: *PageId) -> i32
    if id.value == INVALID_PAGE_ID
        return 0
    return 1

pub fn page_id_invalid() -> PageId
    var id: PageId
    id.value = INVALID_PAGE_ID
    return id

pub fn page_id_eq(a: *PageId, b: *PageId) -> i32
    if a.value == b.value
        return 1
    return 0

# ============================================================================
# CollectionMeta - where a collection's B-tree lives, and its counters
# ============================================================================
# Everything needed to reopen a collection on a data directory: persisted in
# meta.m7m and logged to the WAL with every committed write (AGAST #2458).
# root_page_id == INVALID_PAGE_ID means "no collection recorded yet".

struct CollectionMeta
    root_page_id: i64
    tree_height: i64
    tree_count: i64
    tree_node_count: i64
    next_sequence: i64
    doc_count: i64

pub fn collection_meta_clear(meta: *CollectionMeta)
    meta.root_page_id = INVALID_PAGE_ID
    meta.tree_height = 0
    meta.tree_count = 0
    meta.tree_node_count = 0
    meta.next_sequence = 0
    meta.doc_count = 0

pub fn collection_meta_eq(a: *CollectionMeta, b: *CollectionMeta) -> bool
    return a.root_page_id == b.root_page_id and a.tree_height == b.tree_height and a.tree_count == b.tree_count and a.tree_node_count == b.tree_node_count and a.next_sequence == b.next_sequence and a.doc_count == b.doc_count

# ============================================================================
# Named collections (AGAST #3637)
# ============================================================================
# A data directory holds up to MAX_COLLECTIONS collections, each found by the
# name a client CONNECTs with.  The one a store written before #3637 held is
# DEFAULT_COLLECTION_ID, named "default"; CONNECT with an empty name gets it.
# A collection's id is the high half of every DocumentId in it.

pub const MAX_COLLECTIONS: i32 = 64
pub const MAX_COLLECTION_NAME: i32 = 63
pub const DEFAULT_COLLECTION_ID: i32 = 1
pub const DEFAULT_COLLECTION_NAME: StrView = "default"

# One collection's entry in meta.m7m (v2) and in a WAL META record: its id,
# its name and where its tree is.  128 bytes; name is NUL-padded.
struct NamedCollectionMeta
    id: i64
    name_len: i64
    name: [64]u8
    meta: CollectionMeta

# Fill *e as collection `id` called name[0..len) with no tree yet.
pub fn named_collection_meta_init(e: *NamedCollectionMeta, id: i32, name: *u8, len: i32)
    e.id = id as i64
    e.name_len = len as i64
    var i: i32 = 0
    while i < 64
        if i < len
            e.name[i] = *(name + i)
        else
            e.name[i] = 0
        i += 1
    collection_meta_clear(@e.meta)

# 1 if *e is called name[0..len).
pub fn named_collection_meta_is(e: *NamedCollectionMeta, name: *u8, len: i32) -> i32
    if e.name_len != len as i64
        return 0
    var i: i32 = 0
    while i < len
        if e.name[i] != *(name + i)
            return 0
        i += 1
    return 1

# ============================================================================
# Error Codes
# ============================================================================

const ERR_OK: i32 = 0
const ERR_IO: i32 = -1
const ERR_CORRUPT: i32 = -2
const ERR_FULL: i32 = -3
const ERR_NOT_FOUND: i32 = -4
const ERR_EXISTS: i32 = -5
const ERR_INVALID: i32 = -6
const ERR_NO_MEMORY: i32 = -7
const ERR_BUSY: i32 = -8
const ERR_LOCKED: i32 = -9
const ERR_CHECKSUM: i32 = -10
const ERR_VERSION: i32 = -11
const ERR_READONLY: i32 = -12

# ============================================================================
# Result Type - Now using ritzlib.result.Result<T, E>
# ============================================================================

# Type alias for i64 result with i32 error code
# Use: Result<i64, i32> directly, or these helper functions

# Create success result
pub fn m7m_ok(value: i64) -> Result<i64, i32>
    return Ok(value)

# Create error result
pub fn m7m_err(error: i32) -> Result<i64, i32>
    return Err(error)

# ============================================================================
# ByteSpan - A view into a byte buffer (ptr + len)
#
# Renamed from `Span` to avoid colliding with `ritzlib.span.Span<T>` when
# mausoleum's lib is pulled into another project as a dependency. Keep the
# function-name prefix `span_*` for source-level continuity; only the struct
# (and the `*Span` types in signatures) changed.
# ============================================================================

struct ByteSpan
    ptr: *u8
    len: i64

pub fn m7m_span_new(ptr: *u8, len: i64) -> ByteSpan
    var s: ByteSpan
    s.ptr = ptr
    s.len = len
    return s

pub fn m7m_span_empty() -> ByteSpan
    var s: ByteSpan
    s.ptr = null
    s.len = 0
    return s

pub fn m7m_span_eq(a: *ByteSpan, b: *ByteSpan) -> i32
    if a.len != b.len
        return 0
    if a.len == 0
        return 1
    return (memcmp(a.ptr, b.ptr, a.len) == 0) as i32

pub fn m7m_span_copy_to(src: *ByteSpan, dst: *u8)
    if src.len > 0
        memcpy(dst, src.ptr, src.len)

# ============================================================================
# Fixed name buffers
#
# Index, field, link and filter names live in fixed `[N]u8` buffers, NUL-
# terminated so a buffer with room to spare reads back as its stored text.
# Pass one as `@x.name` (a whole array fits a Span<u8> slot).
# ============================================================================

# The text in a fixed name buffer: its bytes up to the first NUL.
pub fn m7m_name_view(buf: Span<u8>) -> StrView
    var n: i64 = 0
    while n < buf.len and buf[n] != 0
        n = n + 1
    return strview_from_ptr(buf.ptr, n)

# Store `name` in a fixed name buffer, NUL-terminated. False, and the buffer
# untouched, when the name and its NUL don't fit.
pub fn m7m_name_store(buf: Span<u8>, name: StrView) -> bool
    return m7m_name_store_bytes(buf, name.as_bytes())

# m7m_name_store for a name read as raw bytes (a serialized document).
pub fn m7m_name_store_bytes(buf: Span<u8>, name: Span<u8>) -> bool
    if name.len >= buf.len
        return false
    buf.copy_from(name)
    buf[name.len] = 0
    return true

# ============================================================================
# Paths
# ============================================================================

# An owned copy of C string `path` (a caller's file name); its as_ptr() is
# NUL-terminated, so it goes straight to a syscall.  None if out of memory.
pub fn m7m_path_copy(path: *u8) -> Option<String>
    let view: StrView = strview_from_cstr(path)
    let copy: String = string_from(view)
    if copy.len() != view.len
        return None
    return Some(copy)

# base + suffix into buf, NUL-terminated for the syscalls; the joined length.
# buf must hold both and the NUL.
pub fn m7m_path_join(buf: Span<u8>, base: StrView, suffix: StrView) -> i64
    buf.copy_from(base.as_bytes())
    buf.from(base.len).copy_from(suffix.as_bytes())
    buf[base.len + suffix.len] = 0
    return base.len + suffix.len

# ============================================================================
# M7mTimestamp - Nanosecond precision timestamp
#
# m7m-prefixed because struct names share one namespace: spire.model's
# Timestamp is compiled alongside this one via spire.repo.mausoleum (#3590).
# ============================================================================

struct M7mTimestamp
    nanos: i64  # Nanoseconds since Unix epoch

pub fn m7m_timestamp_now() -> M7mTimestamp
    var ts: M7mTimestamp
    let tv: Timeval = now()
    ts.nanos = tv.tv_sec * 1000000000 + tv.tv_usec * 1000
    return ts

pub fn m7m_timestamp_zero() -> M7mTimestamp
    var ts: M7mTimestamp
    ts.nanos = 0
    return ts

# ============================================================================
# LSN - Log Sequence Number for WAL
# ============================================================================

struct LSN
    value: i64

pub fn lsn_zero() -> LSN
    var lsn: LSN
    lsn.value = 0
    return lsn

pub fn lsn_new(value: i64) -> LSN
    var lsn: LSN
    lsn.value = value
    return lsn

pub fn lsn_next(lsn: *LSN) -> LSN
    var next: LSN
    next.value = lsn.value + 1
    return next

pub fn lsn_cmp(a: *LSN, b: *LSN) -> i32
    if a.value < b.value
        return -1
    if a.value > b.value
        return 1
    return 0

# ============================================================================
# Transaction ID
# ============================================================================

struct TxnId
    value: i64

pub fn txn_id_new(value: i64) -> TxnId
    var id: TxnId
    id.value = value
    return id

pub fn txn_id_invalid() -> TxnId
    var id: TxnId
    id.value = -1
    return id

pub fn txn_id_is_valid(id: *TxnId) -> i32
    if id.value >= 0
        return 1
    return 0
