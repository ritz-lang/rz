# lib/recovery.ritz - Recovery Manager
#
# Implements crash recovery using Write-Ahead Logging (WAL).
#
# Recovery Strategy (simplified ARIES):
# 1. Analysis Pass: Scan WAL to identify active transactions
# 2. Redo Pass: Replay all changes from committed transactions
# 3. Undo Pass: Roll back uncommitted transactions
#
# Key invariants:
# - Only committed transactions' changes are visible after recovery
# - Uncommitted transactions are rolled back (their changes discarded)
# - Checkpoints mark known-good states (optimization for recovery start point)

import ritzlib.sys
import ritzlib.str
import ritzlib.strview
import ritzlib.box
import ritzlib.span
import ritzlib.gvec
import ritzlib.string
import ritzlib.option

import mausoleum.m7m_types
import mausoleum.page
import mausoleum.buffer_pool
import mausoleum.wal

# ============================================================================
# Constants
# ============================================================================

const MAX_ACTIVE_TXNS: i64 = 256    # Max concurrent transactions during recovery

# Transaction states during recovery
const TXN_STATE_ACTIVE: u8 = 1      # Transaction started, not yet committed/aborted
const TXN_STATE_COMMITTED: u8 = 2   # Transaction committed
const TXN_STATE_ABORTED: u8 = 3     # Transaction aborted

# ============================================================================
# Recovery Statistics
# ============================================================================

struct RecoveryStats
    records_scanned: i64        # Total WAL records scanned
    txns_committed: i64         # Transactions that were committed
    txns_aborted: i64           # Transactions that were aborted/rolled back
    pages_recovered: i64        # Pages that were recovered
    checkpoint_lsn: i64         # LSN of last checkpoint found
    recovery_lsn: i64           # LSN where recovery started

# ============================================================================
# Active Transaction Entry (for tracking during recovery)
# ============================================================================

struct TxnEntry
    txn_id: i64
    state: u8
    first_lsn: i64              # LSN of BEGIN record
    last_lsn: i64               # LSN of last record for this txn

# ============================================================================
# Recovery Manager
# ============================================================================

struct RecoveryManager
    pool: *BufferPool           # Buffer pool for page recovery
    wal_writer: Box<WalWriter>  # WAL writer (for checkpoints; empty until one)
    wal_path: String              # Base path for WAL files

    # Active transaction table
    txn_table: Vec<TxnEntry>    # MAX_ACTIVE_TXNS slots; txn_count in use
    txn_count: i64              # Number of entries in txn_table

    # Recovery stats
    stats: RecoveryStats

    # The last committed WAL_REC_META of each collection seen by redo:
    # meta_count entries of a MAX_COLLECTIONS table (AGAST #3637).
    metas: Vec<NamedCollectionMeta>   # MAX_COLLECTIONS slots; meta_count in use
    meta_count: i32

# ============================================================================
# Recovery Manager Creation/Destruction
# ============================================================================

# A manager is a value its owner holds and lends as `@mgr`.
pub fn recovery_mgr_new(pool: *BufferPool, wal_path: StrView) -> Option<RecoveryManager>
    if pool == null or wal_path.len == 0
        return None

    # Allocate transaction table. Size by sizeof: a literal 24 undersized the
    # 32-byte TxnEntry and overflowed past 192 transactions (AGAST #3683).
    var txn_table: Vec<TxnEntry> = vec_with_cap<TxnEntry>(MAX_ACTIVE_TXNS)
    var metas: Vec<NamedCollectionMeta> = vec_with_cap<NamedCollectionMeta>(MAX_COLLECTIONS as i64)
    if txn_table.cap() < MAX_ACTIVE_TXNS or metas.cap() < MAX_COLLECTIONS as i64
        return None

    let stats: RecoveryStats = RecoveryStats { records_scanned: 0, txns_committed: 0, txns_aborted: 0, pages_recovered: 0, checkpoint_lsn: 0, recovery_lsn: 0 }
    let mgr: RecoveryManager = RecoveryManager {
        pool: pool,
        wal_writer: box_empty<WalWriter>(),
        wal_path: string_from(wal_path),
        txn_table: txn_table,
        txn_count: 0,
        stats: stats,
        metas: metas,
        meta_count: 0
    }
    return Some(mgr)

pub fn recovery_mgr_destroy(mgr: *RecoveryManager)
    if mgr == null
        return

    if mgr.wal_writer.valid()
        wal_writer_destroy(mgr.wal_writer.as_ptr())
        mgr.wal_writer.drop()
    mgr.txn_table.deinit()
    mgr.metas.deinit()
    mgr.wal_path.deinit()

# ============================================================================
# Transaction Table Operations
# ============================================================================

# Find transaction entry by ID (returns null if not found)
fn find_txn(mgr: *RecoveryManager, txn_id: i64) -> *TxnEntry
    var i: i64 = 0
    while i < mgr.txn_count
        let entry: *TxnEntry = mgr.txn_table.get_ptr(i)
        if entry.txn_id == txn_id
            return entry
        i += 1
    return null

# Add or update transaction entry
fn upsert_txn(mgr: *RecoveryManager, txn_id: i64, state: u8, lsn: i64) -> *TxnEntry
    # Try to find existing
    let existing: *TxnEntry = find_txn(mgr, txn_id)
    if existing != null
        existing.state = state
        existing.last_lsn = lsn
        return existing

    # Add new entry
    if mgr.txn_count >= MAX_ACTIVE_TXNS
        return null  # Table full

    let entry: *TxnEntry = mgr.txn_table.get_ptr(mgr.txn_count)
    entry.txn_id = txn_id
    entry.state = state
    entry.first_lsn = lsn
    entry.last_lsn = lsn
    mgr.txn_count += 1
    return entry

# ============================================================================
# Recovery - Main Entry Point
# ============================================================================

pub fn recovery_recover(mgr: *RecoveryManager) -> i32
    if mgr == null
        return ERR_INVALID

    # Reset stats
    mgr.stats.records_scanned = 0
    mgr.stats.txns_committed = 0
    mgr.stats.txns_aborted = 0
    mgr.stats.pages_recovered = 0
    mgr.txn_count = 0
    mgr.meta_count = 0

    # Try to open WAL file
    let path: String = m7m_path_join(mgr.wal_path.as_view(), ".wal.000000")
    var reader_v: WalReader = wal_reader_new()
    let reader: *WalReader = @reader_v

    let open_result: i32 = wal_reader_open(reader, path.as_view())
    if open_result != ERR_OK
        # No WAL file = nothing to recover
        wal_reader_destroy(reader)
        return ERR_OK

    # Phase 1: Analysis - scan WAL and build transaction table
    let analysis_result: i32 = recovery_analysis_pass(mgr, reader)
    if analysis_result != ERR_OK
        wal_reader_destroy(reader)
        return analysis_result

    # Seek back to beginning for redo pass
    wal_reader_close(reader)
    wal_reader_open(reader, path.as_view())

    # Phase 2: Redo - replay committed transaction changes
    let redo_result: i32 = recovery_redo_pass(mgr, reader)
    if redo_result != ERR_OK
        wal_reader_destroy(reader)
        return redo_result

    # Phase 3: Mark uncommitted transactions as aborted
    var i: i64 = 0
    while i < mgr.txn_count
        let entry: *TxnEntry = mgr.txn_table.get_ptr(i)
        if entry.state == TXN_STATE_ACTIVE
            entry.state = TXN_STATE_ABORTED
            mgr.stats.txns_aborted += 1
        i += 1

    wal_reader_destroy(reader)
    return ERR_OK

# ============================================================================
# Analysis Pass
# ============================================================================

fn recovery_analysis_pass(mgr: *RecoveryManager, reader: *WalReader) -> i32
    var header: WalRecordHeader

    # Scan all records
    var result: i32 = wal_reader_next(reader, @header)
    while result == ERR_OK
        mgr.stats.records_scanned += 1

        if header.rec_type == WAL_REC_BEGIN
            # Start tracking this transaction
            upsert_txn(mgr, header.txn_id, TXN_STATE_ACTIVE, header.lsn)

        else if header.rec_type == WAL_REC_COMMIT
            # Mark transaction as committed
            let entry: *TxnEntry = find_txn(mgr, header.txn_id)
            if entry != null
                entry.state = TXN_STATE_COMMITTED
                entry.last_lsn = header.lsn
                mgr.stats.txns_committed += 1

        else if header.rec_type == WAL_REC_ABORT
            # Mark transaction as aborted
            let entry: *TxnEntry = find_txn(mgr, header.txn_id)
            if entry != null
                entry.state = TXN_STATE_ABORTED
                entry.last_lsn = header.lsn
                mgr.stats.txns_aborted += 1

        else if header.rec_type == WAL_REC_CHECKPOINT
            mgr.stats.checkpoint_lsn = header.lsn

        else if header.rec_type == WAL_REC_INSERT or header.rec_type == WAL_REC_UPDATE or header.rec_type == WAL_REC_PAGE_WRITE or header.rec_type == WAL_REC_META
            # Update last LSN for this transaction
            let entry: *TxnEntry = find_txn(mgr, header.txn_id)
            if entry != null
                entry.last_lsn = header.lsn

        # Skip payload if any
        wal_reader_skip_payload(reader, @header)

        result = wal_reader_next(reader, @header)

    # EOF (-1) is normal, other errors are failures
    if result != -1
        return result

    return ERR_OK

# ============================================================================
# Redo Pass
# ============================================================================

fn recovery_redo_pass(mgr: *RecoveryManager, reader: *WalReader) -> i32
    var header: WalRecordHeader

    var result: i32 = wal_reader_next(reader, @header)
    while result == ERR_OK
        # Only redo changes from committed transactions
        let entry: *TxnEntry = find_txn(mgr, header.txn_id)
        let is_committed: bool = entry != null and entry.state == TXN_STATE_COMMITTED

        if header.rec_type == WAL_REC_PAGE_WRITE and is_committed
            # Read page write payload
            var payload: WalPageWritePayload
            if wal_reader_read_payload(reader, Span<u8> { ptr: @payload as *u8, len: 8 }) != ERR_OK
                return ERR_IO

            # Read full page
            var page_data: [4096]u8
            if wal_reader_read_payload(reader, @page_data) != ERR_OK
                return ERR_IO

            # Apply page to buffer pool
            let apply_result: i32 = recovery_apply_page(mgr, payload.page_id, @page_data)
            if apply_result == ERR_OK
                mgr.stats.pages_recovered += 1

        else if header.rec_type == WAL_REC_INSERT and is_committed
            # Read insert payload
            var payload: WalInsertPayload
            if wal_reader_read_payload(reader, Span<u8> { ptr: @payload as *u8, len: 16 }) != ERR_OK
                return ERR_IO

            # Read insert data
            if payload.data_len > 0
                var data_buf: [4096]u8
                let data_len: i64 = payload.data_len as i64
                if data_len > 4096
                    return ERR_INVALID
                let data: [u8] = @data_buf
                if wal_reader_read_payload(reader, data[0..data_len]) != ERR_OK
                    return ERR_IO

                # Apply insert to page
                let apply_result: i32 = recovery_apply_insert(mgr, payload.page_id, payload.offset, data[0..data_len])
                if apply_result == ERR_OK
                    mgr.stats.pages_recovered += 1

        else if header.rec_type == WAL_REC_META and is_committed
            # A NamedCollectionMeta, or (written before #3637) a bare
            # CollectionMeta, which is the default collection's.
            var rec_meta: NamedCollectionMeta
            let payload_len: i64 = (header.len as i64) - WAL_HEADER_SIZE
            if payload_len == sizeof(NamedCollectionMeta)
                if wal_reader_read_payload(reader, Span<u8> { ptr: @rec_meta as *u8, len: payload_len }) != ERR_OK
                    return ERR_IO
                if rec_meta.id <= 0 or rec_meta.name_len <= 0 or rec_meta.name_len > MAX_COLLECTION_NAME as i64
                    return ERR_CORRUPT
            else if payload_len == sizeof(CollectionMeta)
                named_collection_meta_init(@rec_meta, DEFAULT_COLLECTION_ID, DEFAULT_COLLECTION_NAME.ptr, DEFAULT_COLLECTION_NAME.len as i32)
                if wal_reader_read_payload(reader, Span<u8> { ptr: @rec_meta.meta as *u8, len: payload_len }) != ERR_OK
                    return ERR_IO
            else
                return ERR_CORRUPT
            # Records are in commit order: the last one of each id wins.
            if recovery_put_meta(mgr, @rec_meta) != ERR_OK
                return ERR_CORRUPT

        else
            # Skip payload for non-redo records or uncommitted transactions
            wal_reader_skip_payload(reader, @header)

        result = wal_reader_next(reader, @header)

    if result != -1
        return result

    return ERR_OK

# ============================================================================
# Page Recovery Helpers
# ============================================================================

# Put a logged full-page image back as page `rec_page_id`.  (It used to be
# copied into a freshly allocated page, which left the real page stale and
# appended a stray copy: AGAST #2458.)
fn recovery_apply_page(mgr: *RecoveryManager, rec_page_id: i64, image: [u8]) -> i32
    return buffer_pool_put_page(mgr.pool, rec_page_id, image)

fn recovery_apply_insert(mgr: *RecoveryManager, rec_page_id: i64, offset: i32, data: [u8]) -> i32
    # For inserts, we need to fetch/create the page and apply the data
    # This is a simplified implementation - real DBs would handle this more carefully

    let page_opt: Option<*Page> = buffer_pool_fetch(mgr.pool, rec_page_id)
    if option_is_none<*Page>(@page_opt)
        return ERR_NO_MEMORY
    let page: *Page = option_unwrap_or<*Page>(@page_opt, null)
    let alloc_page_id: i64 = rec_page_id
    buffer_pool_reserve_page_id(mgr.pool, rec_page_id)

    # Apply insert data to page
    let pg_data: [u8] = @page.data
    let off: i64 = offset as i64
    let len: i64 = data.len

    if off >= 0 and off + len <= PAGE_DATA_SIZE
        let dst: [u8] = pg_data[off..off + len]
        dst.copy_from(data)
        page_set_dirty(page)

    # Unpin page (dirty=1 since we modified it)
    buffer_pool_unpin(mgr.pool, alloc_page_id, 1)
    return ERR_OK

# ============================================================================
# Checkpoint
# ============================================================================

pub fn recovery_checkpoint(mgr: *RecoveryManager) -> i32
    if mgr == null
        return ERR_INVALID

    # Create WAL writer if needed
    if not mgr.wal_writer.valid()
        var writer: WalWriter = match wal_writer_new(mgr.wal_path.as_view())
            Some(w) => w
            None => return ERR_NO_MEMORY
        let open_result: i32 = wal_writer_open(@writer)
        if open_result != ERR_OK
            return open_result
        mgr.wal_writer = box_new<WalWriter>(writer)

    # Flush all dirty pages in buffer pool
    # (In a real implementation, this would iterate dirty pages)

    # Write checkpoint record to WAL
    let lsn: i64 = wal_write_checkpoint(mgr.wal_writer.as_ptr())
    if lsn < 0
        return ERR_IO

    mgr.stats.checkpoint_lsn = lsn
    return ERR_OK

# ============================================================================
# Stats Access
# ============================================================================

# Record `entry` as the latest meta of its collection id.
fn recovery_put_meta(mgr: *RecoveryManager, entry: *NamedCollectionMeta) -> i32
    var i: i32 = 0
    while i < mgr.meta_count
        let cur: *NamedCollectionMeta = mgr.metas.get_ptr(i as i64)
        if cur.id == entry.id
            *cur = *entry
            return ERR_OK
        i += 1
    if mgr.meta_count >= MAX_COLLECTIONS
        return ERR_FULL
    *mgr.metas.get_ptr(mgr.meta_count as i64) = *entry
    mgr.meta_count += 1
    return ERR_OK

# How many collections redo found a committed meta record for.
pub fn recovery_collection_meta_count(mgr: *RecoveryManager) -> i32
    if mgr == null
        return 0
    return mgr.meta_count

# The i-th of those (0 <= i < recovery_collection_meta_count) into *out:
# the last committed meta logged for that collection.  1 = filled, else 0.
pub fn recovery_collection_meta_at(mgr: *RecoveryManager, i: i32, out: *NamedCollectionMeta) -> i32
    if mgr == null or out == null or i < 0 or i >= mgr.meta_count
        return 0
    *out = *mgr.metas.get_ptr(i as i64)
    return 1

pub fn recovery_stats(mgr: *RecoveryManager) -> *RecoveryStats
    if mgr == null
        return null
    return @mgr.stats
