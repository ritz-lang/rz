# lib/buffer_pool.ritz - Buffer Pool Manager
#
# The buffer pool is a fixed-size in-memory cache of disk pages.
# It provides page-level access with the following features:
# - LRU eviction policy
# - Pin counting for concurrent access
# - Dirty page tracking
# - Background flushing support
#
# Design:
# - Fixed number of frame slots (configurable at creation)
# - Hash table for page_id -> frame lookup
# - LRU list for eviction candidates (unpinned pages)
# - Pages are read from disk on cache miss
# - Dirty pages are written back on eviction or explicit flush
# - No-steal (AGAST #4205, buffer_pool_set_no_steal): the WAL is redo-only,
#   so a page changed since the last WAL commit must not reach the data file.
#   Such a page ("unlogged") is never an eviction victim; once
#   buffer_pool_mark_logged says the WAL holds it, it may be written back.

import ritzlib.sys
import ritzlib.str
import ritzlib.memory
import ritzlib.option

import mausoleum.m7m_types
import mausoleum.page

# ============================================================================
# Buffer Pool Constants
# ============================================================================

const DEFAULT_POOL_SIZE: i32 = 64      # Default number of frames
const HASH_BUCKETS: i32 = 128          # Hash table bucket count

# ============================================================================
# Frame - A slot in the buffer pool holding one page
# ============================================================================

struct Frame
    page: Page                  # The actual page data
    page_id: i64                # Page ID (-1 if unused)
    pin_count: i32              # Number of active references
    dirty: i32                  # Has page been modified?
    unlogged: i32               # Dirtied since the last buffer_pool_mark_logged
    lru_prev: i32               # Previous frame in LRU list (-1 if none)
    lru_next: i32               # Next frame in LRU list (-1 if none)
    hash_next: i32              # Next frame in hash bucket chain (-1 if none)

# ============================================================================
# Buffer Pool Structure
# ============================================================================

struct BufferPool
    frames: *Frame              # Array of frames
    num_frames: i32             # Total number of frames
    hash_table: *i32            # Hash table: bucket -> first frame index
    lru_head: i32               # Most recently used unpinned frame
    lru_tail: i32               # Least recently used unpinned frame
    free_list: i32              # Head of free frame list
    file_fd: i32                # File descriptor for I/O
    next_page_id: i64           # Next page ID to allocate
    stats_hits: i64             # Cache hit count
    stats_misses: i64           # Cache miss count
    stats_evictions: i64        # Eviction count
    # Free pages (AGAST #3638): ids buffer_pool_alloc hands out again before
    # it grows the file.  Every page on it has magic PAGE_MAGIC_FREE.
    free_ids: *i64
    free_count: i64
    free_cap: i64
    no_steal: i32               # Never evict an unlogged page (AGAST #4205)

# ============================================================================
# Buffer Pool Creation/Destruction
# ============================================================================

# Create a new buffer pool with the given number of frames
pub fn buffer_pool_new(num_frames: i32) -> Option<*BufferPool>
    if num_frames <= 0
        return None

    # Allocate pool structure
    let pool: *BufferPool = malloc(sizeof(BufferPool)) as *BufferPool
    if pool == null
        return None

    # Allocate frames array
    let frame_size: i64 = sizeof(Frame)
    let frames: *Frame = malloc(frame_size * num_frames as i64) as *Frame
    if frames == null
        free(pool as *u8)
        return None

    # Allocate hash table
    let hash_table: *i32 = malloc(sizeof(i32) * HASH_BUCKETS as i64) as *i32
    if hash_table == null
        free(frames as *u8)
        free(pool as *u8)
        return None

    # Initialize hash table to -1 (empty)
    for i in 0..HASH_BUCKETS
        *(hash_table + i) = -1

    # Initialize frames and build free list
    for i in 0..num_frames
        let frame: *Frame = (frames as i64 + (i as i64 * frame_size)) as *Frame
        frame.page_id = INVALID_PAGE_ID
        frame.pin_count = 0
        frame.dirty = 0
        frame.unlogged = 0
        frame.lru_prev = -1
        frame.lru_next = -1
        frame.hash_next = -1

        # Link into free list (use lru_next for free list chain)
        if i < num_frames - 1
            frame.lru_next = i + 1
        else
            frame.lru_next = -1

    # Initialize pool
    pool.frames = frames
    pool.num_frames = num_frames
    pool.hash_table = hash_table
    pool.lru_head = -1
    pool.lru_tail = -1
    pool.free_list = 0  # First frame is head of free list
    pool.file_fd = -1
    pool.next_page_id = 0
    pool.stats_hits = 0
    pool.stats_misses = 0
    pool.stats_evictions = 0
    pool.free_ids = null
    pool.free_count = 0
    pool.free_cap = 0
    pool.no_steal = 0

    return Some(pool)

# Create a buffer pool with default size
pub fn buffer_pool_default() -> Option<*BufferPool>
    return buffer_pool_new(DEFAULT_POOL_SIZE)

# Destroy a buffer pool
pub fn buffer_pool_destroy(pool: *BufferPool)
    if pool == null
        return

    # Flush all dirty pages first
    buffer_pool_flush_all(pool)

    # Close file if open
    if pool.file_fd >= 0
        sys_close(pool.file_fd)

    # Free memory
    if pool.hash_table != null
        free(pool.hash_table as *u8)
    if pool.frames != null
        free(pool.frames as *u8)
    if pool.free_ids != null
        free(pool.free_ids as *u8)
    free(pool as *u8)

# ============================================================================
# Internal Helpers
# ============================================================================

# Get frame by index
fn get_frame(pool: *BufferPool, idx: i32) -> *Frame
    if idx < 0 or idx >= pool.num_frames
        return null
    let frame_size: i64 = sizeof(Frame)
    return (pool.frames as i64 + (idx as i64 * frame_size)) as *Frame

# murmur3's 64-bit finaliser. It is defined on unsigned values: `h` must be a
# u64 so each `>> 33` is a logical shift (on an i64 it sign-fills; #2362).
pub fn fmix64(k: u64) -> u64
    var h: u64 = k
    h = h ^ (h >> 33)
    h = h * 0xff51afd7ed558ccd
    h = h ^ (h >> 33)
    h = h * 0xc4ceb9fe1a85ec53
    h = h ^ (h >> 33)
    return h

# Hash function for page ID
fn hash_page_id(page_id: i64) -> i32
    let h: u64 = fmix64(page_id as u64)
    return (h as i32 & 0x7FFFFFFF) % HASH_BUCKETS

# Find frame index for a page ID (returns -1 if not found)
fn find_frame(pool: *BufferPool, page_id: i64) -> i32
    let bucket: i32 = hash_page_id(page_id)
    var idx: i32 = *(pool.hash_table + bucket)

    while idx >= 0
        let frame: *Frame = get_frame(pool, idx)
        if frame.page_id == page_id
            return idx
        idx = frame.hash_next

    return -1

# Add frame to hash table
fn hash_insert(pool: *BufferPool, frame_idx: i32, page_id: i64)
    let bucket: i32 = hash_page_id(page_id)
    let frame: *Frame = get_frame(pool, frame_idx)

    frame.hash_next = *(pool.hash_table + bucket)
    *(pool.hash_table + bucket) = frame_idx

# Remove frame from hash table
fn hash_remove(pool: *BufferPool, frame_idx: i32, page_id: i64)
    let bucket: i32 = hash_page_id(page_id)
    var prev_idx: i32 = -1
    var idx: i32 = *(pool.hash_table + bucket)

    while idx >= 0
        let frame: *Frame = get_frame(pool, idx)
        if idx == frame_idx
            if prev_idx < 0
                # Head of chain
                *(pool.hash_table + bucket) = frame.hash_next
            else
                let prev_frame: *Frame = get_frame(pool, prev_idx)
                prev_frame.hash_next = frame.hash_next
            frame.hash_next = -1
            return
        prev_idx = idx
        idx = frame.hash_next

# Add frame to LRU list (most recently used position)
fn lru_add(pool: *BufferPool, frame_idx: i32)
    let frame: *Frame = get_frame(pool, frame_idx)

    frame.lru_prev = -1
    frame.lru_next = pool.lru_head

    if pool.lru_head >= 0
        let head: *Frame = get_frame(pool, pool.lru_head)
        head.lru_prev = frame_idx

    pool.lru_head = frame_idx

    if pool.lru_tail < 0
        pool.lru_tail = frame_idx

# Remove frame from LRU list
fn lru_remove(pool: *BufferPool, frame_idx: i32)
    let frame: *Frame = get_frame(pool, frame_idx)

    if frame.lru_prev >= 0
        let prev: *Frame = get_frame(pool, frame.lru_prev)
        prev.lru_next = frame.lru_next
    else
        pool.lru_head = frame.lru_next

    if frame.lru_next >= 0
        let next: *Frame = get_frame(pool, frame.lru_next)
        next.lru_prev = frame.lru_prev
    else
        pool.lru_tail = frame.lru_prev

    frame.lru_prev = -1
    frame.lru_next = -1

# Get a free frame (from free list or by eviction)
fn get_free_frame(pool: *BufferPool) -> i32
    # Try free list first
    if pool.free_list >= 0
        let frame_idx: i32 = pool.free_list
        let frame: *Frame = get_frame(pool, frame_idx)
        pool.free_list = frame.lru_next  # Using lru_next for free list chain
        frame.lru_next = -1
        return frame_idx

    # Evict from LRU tail (least recently used unpinned page)
    var victim_idx: i32 = pool.lru_tail
    while victim_idx >= 0
        let victim: *Frame = get_frame(pool, victim_idx)
        # Under no-steal a page the WAL does not hold yet stays (#4205).
        if victim.pin_count == 0 and (pool.no_steal == 0 or victim.unlogged == 0)
            # Found eviction candidate
            lru_remove(pool, victim_idx)
            hash_remove(pool, victim_idx, victim.page_id)

            # Flush if dirty
            if victim.dirty != 0
                buffer_pool_flush_frame(pool, victim_idx)

            pool.stats_evictions += 1
            return victim_idx

        victim_idx = victim.lru_prev

    # No evictable frames (all pinned, or unlogged under no-steal)
    return -1

# ============================================================================
# File I/O Operations
# ============================================================================

# Open database file
pub fn buffer_pool_open(pool: *BufferPool, path: *u8) -> i32
    if pool == null
        return ERR_INVALID

    # Open file (create if not exists)
    let fd: i32 = sys_open3(path, O_RDWR | O_CREAT, 420)  # 0644
    if fd < 0
        return ERR_IO

    pool.file_fd = fd

    # Get file size to determine next_page_id
    var stat_buf: Stat
    if sys_fstat2(fd, @stat_buf) == 0
        pool.next_page_id = stat_buf.st_size / PAGE_SIZE

    return ERR_OK

# Close database file
pub fn buffer_pool_close(pool: *BufferPool) -> i32
    if pool == null
        return ERR_INVALID

    # Flush all dirty pages
    buffer_pool_flush_all(pool)

    # Close file
    if pool.file_fd >= 0
        sys_close(pool.file_fd)
        pool.file_fd = -1

    return ERR_OK

# Read a page from disk into a frame
fn read_page(pool: *BufferPool, frame: *Frame, page_id: i64) -> i32
    if pool.file_fd < 0
        return ERR_IO

    let offset: i64 = page_id * PAGE_SIZE
    let result: i64 = sys_lseek(pool.file_fd, offset, 0)  # SEEK_SET = 0
    if result < 0
        return ERR_IO

    let bytes_read: i64 = sys_read(pool.file_fd, @frame.page as *u8, PAGE_SIZE)
    if bytes_read < PAGE_SIZE
        # New page - initialize it
        page_init(@frame.page, PAGE_MAGIC_FREE, page_id)
        page_update_checksum(@frame.page)

    return ERR_OK

# Write a page from a frame to disk
fn write_page(pool: *BufferPool, frame: *Frame) -> i32
    if pool.file_fd < 0
        return ERR_IO

    let offset: i64 = frame.page_id * PAGE_SIZE
    let result: i64 = sys_lseek(pool.file_fd, offset, 0)
    if result < 0
        return ERR_IO

    let bytes_written: i64 = sys_write(pool.file_fd, @frame.page as *u8, PAGE_SIZE)
    if bytes_written != PAGE_SIZE
        return ERR_IO

    return ERR_OK

# ============================================================================
# Public Page Access API
# ============================================================================

# Fetch a page (returns pinned page, None on error)
pub fn buffer_pool_fetch(pool: *BufferPool, page_id: i64) -> Option<*Page>
    if pool == null or page_id < 0
        return None

    # Check if page is already in cache
    var frame_idx: i32 = find_frame(pool, page_id)
    if frame_idx >= 0
        let frame: *Frame = get_frame(pool, frame_idx)

        # Remove from LRU if unpinned (it's being used now)
        if frame.pin_count == 0
            lru_remove(pool, frame_idx)

        frame.pin_count += 1
        pool.stats_hits += 1
        return Some(@frame.page)

    # Cache miss - need to load from disk
    pool.stats_misses += 1

    # Get a free frame
    frame_idx = get_free_frame(pool)
    if frame_idx < 0
        return None  # Buffer pool full, all pages pinned

    let frame: *Frame = get_frame(pool, frame_idx)

    # Read page from disk
    let err: i32 = read_page(pool, frame, page_id)
    if err != ERR_OK
        # Put frame back on free list
        frame.lru_next = pool.free_list
        pool.free_list = frame_idx
        return None

    # Set up frame
    frame.page_id = page_id
    frame.pin_count = 1
    frame.dirty = 0
    frame.unlogged = 0

    # Add to hash table
    hash_insert(pool, frame_idx, page_id)

    return Some(@frame.page)

# Unpin a page (call when done with page)
pub fn buffer_pool_unpin(pool: *BufferPool, page_id: i64, dirty: i32)
    if pool == null
        return

    let frame_idx: i32 = find_frame(pool, page_id)
    if frame_idx < 0
        return

    let frame: *Frame = get_frame(pool, frame_idx)

    if dirty != 0
        frame.dirty = 1
        frame.unlogged = 1

    if frame.pin_count > 0
        frame.pin_count -= 1

        # Add to LRU list when fully unpinned
        if frame.pin_count == 0
            lru_add(pool, frame_idx)

# Allocate a page of `page_type` (returned pinned and dirty): a freed one
# if there is any (see buffer_pool_free_page), else a new one at the end of
# the file.
pub fn buffer_pool_alloc(pool: *BufferPool, page_type: i32) -> Option<*Page>
    if pool == null
        return None

    if pool.free_count > 0
        return alloc_free_page(pool, page_type)

    let page_id: i64 = pool.next_page_id
    pool.next_page_id += 1

    # Get a free frame
    let frame_idx: i32 = get_free_frame(pool)
    if frame_idx < 0
        return None

    let frame: *Frame = get_frame(pool, frame_idx)

    # Initialize the page
    page_init(@frame.page, page_type, page_id)
    frame.page_id = page_id
    frame.pin_count = 1
    frame.dirty = 1  # New page needs to be written
    frame.unlogged = 1

    # Add to hash table
    hash_insert(pool, frame_idx, page_id)

    return Some(@frame.page)

# Hand out the most recently freed page as a new page of `page_type`.  Its
# old contents are not read: they are overwritten whole.
fn alloc_free_page(pool: *BufferPool, page_type: i32) -> Option<*Page>
    let page_id: i64 = *(pool.free_ids + (pool.free_count - 1))
    var frame_idx: i32 = find_frame(pool, page_id)
    if frame_idx >= 0
        let cached: *Frame = get_frame(pool, frame_idx)
        if cached.pin_count != 0
            return None  # Freed while still in use: a caller bug, refuse.
        lru_remove(pool, frame_idx)
    else
        frame_idx = get_free_frame(pool)
        if frame_idx < 0
            return None
        hash_insert(pool, frame_idx, page_id)

    pool.free_count -= 1
    let frame: *Frame = get_frame(pool, frame_idx)
    page_init(@frame.page, page_type, page_id)
    frame.page_id = page_id
    frame.pin_count = 1
    frame.dirty = 1
    frame.unlogged = 1
    return Some(@frame.page)

# Put `page_id` on the free list.
fn free_list_push(pool: *BufferPool, page_id: i64) -> i32
    if pool.free_count == pool.free_cap
        var cap: i64 = pool.free_cap * 2
        if cap < 64
            cap = 64
        let grown: *u8 = realloc(pool.free_ids as *u8, cap * 8)
        if grown == null
            return ERR_NO_MEMORY
        pool.free_ids = grown as *i64
        pool.free_cap = cap
    *(pool.free_ids + pool.free_count) = page_id
    pool.free_count += 1
    return ERR_OK

# Give page `page_id` back (AGAST #3638): it is blanked to a
# PAGE_MAGIC_FREE page, written out like any other change, and the next
# buffer_pool_alloc hands it out again.  ERR_INVALID for a page that was
# never allocated or is free already, ERR_BUSY for one still pinned.
pub fn buffer_pool_free_page(pool: *BufferPool, page_id: i64) -> i32
    if pool == null or page_id < 0 or page_id >= pool.next_page_id
        return ERR_INVALID
    let page_opt = buffer_pool_fetch(pool, page_id)
    if option_is_none<*Page>(@page_opt)
        return ERR_IO
    let page: *Page = option_unwrap_or<*Page>(@page_opt, null)
    if page.header.magic == PAGE_MAGIC_FREE
        buffer_pool_unpin(pool, page_id, 0)
        return ERR_INVALID
    # Our fetch is one pin; any other is a user who would see it reused.
    if get_frame(pool, find_frame(pool, page_id)).pin_count > 1
        buffer_pool_unpin(pool, page_id, 0)
        return ERR_BUSY
    let pushed: i32 = free_list_push(pool, page_id)
    if pushed != ERR_OK
        buffer_pool_unpin(pool, page_id, 0)
        return pushed
    page_init(page, PAGE_MAGIC_FREE, page_id)
    buffer_pool_unpin(pool, page_id, 1)
    return ERR_OK

# Pages the file holds or will (one past the highest page id handed out).
pub fn buffer_pool_page_count(pool: *BufferPool) -> i64
    if pool == null
        return 0
    return pool.next_page_id

# Pages on the free list.
pub fn buffer_pool_free_page_count(pool: *BufferPool) -> i64
    if pool == null
        return 0
    return pool.free_count

# Rebuild the free list from the pages themselves: every page below
# next_page_id whose magic is PAGE_MAGIC_FREE (freed, or never written) is
# free.  The free list is not stored anywhere else, so storage_open calls
# this once recovery has brought the pages up to date.  Reads each page's
# header (or its cached copy): one pass over the data file.
pub fn buffer_pool_reclaim_free_pages(pool: *BufferPool) -> i32
    if pool == null
        return ERR_INVALID
    pool.free_count = 0
    var page_id: i64 = 0
    while page_id < pool.next_page_id
        var magic: i32 = PAGE_MAGIC_FREE
        let frame_idx: i32 = find_frame(pool, page_id)
        if frame_idx >= 0
            magic = get_frame(pool, frame_idx).page.header.magic
        else if pool.file_fd >= 0
            if sys_lseek(pool.file_fd, page_id * PAGE_SIZE, 0) < 0
                return ERR_IO
            # A short read is past the end of the file: never written.
            if sys_read(pool.file_fd, @magic as *u8, 4) != 4
                magic = PAGE_MAGIC_FREE
        else
            magic = 0 - 1   # In-memory pool, page evicted: unknown, keep it.
        if magic == PAGE_MAGIC_FREE
            let pushed: i32 = free_list_push(pool, page_id)
            if pushed != ERR_OK
                return pushed
        page_id += 1
    return ERR_OK

# Get page ID for a page pointer
pub fn buffer_pool_page_id(pool: *BufferPool, page: *Page) -> i64
    if pool == null or page == null
        return INVALID_PAGE_ID

    # Search all frames for this page
    let frame_size: i64 = sizeof(Frame)
    for i in 0..pool.num_frames
        let frame: *Frame = (pool.frames as i64 + (i as i64 * frame_size)) as *Frame
        if @frame.page == page
            return frame.page_id

    return INVALID_PAGE_ID

# Never hand out `page_id` (or anything below it) from buffer_pool_alloc.
# Recovery calls this for every page it replays: a page that reached the
# WAL but not the data file lies past the file's end, where next_page_id
# (derived from the file size) would otherwise allocate it a second time.
pub fn buffer_pool_reserve_page_id(pool: *BufferPool, page_id: i64)
    if pool == null or page_id < 0
        return
    if page_id >= pool.next_page_id
        pool.next_page_id = page_id + 1

# Install a full page image as page `page_id`, dirty, without reading the
# old contents from disk (WAL redo: the image replaces them wholesale).
pub fn buffer_pool_put_page(pool: *BufferPool, page_id: i64, image: *u8) -> i32
    if pool == null or image == null or page_id < 0
        return ERR_INVALID

    var frame_idx: i32 = find_frame(pool, page_id)
    if frame_idx >= 0
        let frame: *Frame = get_frame(pool, frame_idx)
        memcpy(@frame.page as *u8, image, PAGE_SIZE)
        frame.dirty = 1
        frame.unlogged = 0   # The image came from the WAL.
        buffer_pool_reserve_page_id(pool, page_id)
        return ERR_OK

    frame_idx = get_free_frame(pool)
    if frame_idx < 0
        return ERR_NO_MEMORY
    let frame: *Frame = get_frame(pool, frame_idx)
    memcpy(@frame.page as *u8, image, PAGE_SIZE)
    frame.page_id = page_id
    frame.pin_count = 0
    frame.dirty = 1
    frame.unlogged = 0   # The image came from the WAL.
    hash_insert(pool, frame_idx, page_id)
    lru_add(pool, frame_idx)
    buffer_pool_reserve_page_id(pool, page_id)
    return ERR_OK

# Turn no-steal on (1) or off (0).  Storage turns it on: with it a page
# changed since the last buffer_pool_mark_logged is never evicted, so a
# miss with every unpinned frame in that state fails (None / ERR_NO_MEMORY)
# instead of writing an uncommitted page to the data file (AGAST #4205).
pub fn buffer_pool_set_no_steal(pool: *BufferPool, on: i32)
    if pool != null
        pool.no_steal = on

# Every dirty page is now in a committed WAL transaction: each may be
# evicted (written back) again.  storage_wal_commit calls this.
pub fn buffer_pool_mark_logged(pool: *BufferPool)
    if pool == null
        return
    for i in 0..pool.num_frames
        get_frame(pool, i).unlogged = 0

# Number of frames (for iterating with buffer_pool_dirty_page).
pub fn buffer_pool_num_frames(pool: *BufferPool) -> i32
    if pool == null
        return 0
    return pool.num_frames

# Number of dirty pages currently held.
pub fn buffer_pool_dirty_count(pool: *BufferPool) -> i32
    if pool == null
        return 0
    var n: i32 = 0
    for i in 0..pool.num_frames
        let frame: *Frame = get_frame(pool, i)
        if frame.dirty != 0 and frame.page_id != INVALID_PAGE_ID
            n += 1
    return n

# The page in frame `idx` if it is dirty (its id in *out_page_id), else null.
pub fn buffer_pool_dirty_page(pool: *BufferPool, idx: i32, out_page_id: *i64) -> *Page
    if pool == null or idx < 0 or idx >= pool.num_frames
        return null
    let frame: *Frame = get_frame(pool, idx)
    if frame.dirty == 0 or frame.page_id == INVALID_PAGE_ID
        return null
    *out_page_id = frame.page_id
    return @frame.page

# ============================================================================
# Flushing Operations
# ============================================================================

# Flush a specific frame to disk
pub fn buffer_pool_flush_frame(pool: *BufferPool, frame_idx: i32) -> i32
    if pool == null or frame_idx < 0 or frame_idx >= pool.num_frames
        return ERR_INVALID

    let frame: *Frame = get_frame(pool, frame_idx)
    if frame.page_id == INVALID_PAGE_ID
        return ERR_OK  # Nothing to flush

    if frame.dirty == 0
        return ERR_OK  # Already clean

    # Update checksum before writing
    page_update_checksum(@frame.page)

    let err: i32 = write_page(pool, frame)
    if err == ERR_OK
        frame.dirty = 0
        frame.unlogged = 0

    return err

# Flush a page by page ID
pub fn buffer_pool_flush(pool: *BufferPool, page_id: i64) -> i32
    if pool == null
        return ERR_INVALID

    let frame_idx: i32 = find_frame(pool, page_id)
    if frame_idx < 0
        return ERR_NOT_FOUND

    return buffer_pool_flush_frame(pool, frame_idx)

# Flush all dirty pages
pub fn buffer_pool_flush_all(pool: *BufferPool) -> i32
    if pool == null
        return ERR_INVALID

    var err: i32 = ERR_OK
    let frame_size: i64 = sizeof(Frame)

    for i in 0..pool.num_frames
        let frame: *Frame = (pool.frames as i64 + (i as i64 * frame_size)) as *Frame
        if frame.dirty != 0
            let result: i32 = buffer_pool_flush_frame(pool, i)
            if result != ERR_OK
                err = result

    return err

# ============================================================================
# Statistics
# ============================================================================

pub fn buffer_pool_hit_count(pool: *BufferPool) -> i64
    if pool == null
        return 0
    return pool.stats_hits

pub fn buffer_pool_miss_count(pool: *BufferPool) -> i64
    if pool == null
        return 0
    return pool.stats_misses

pub fn buffer_pool_eviction_count(pool: *BufferPool) -> i64
    if pool == null
        return 0
    return pool.stats_evictions

pub fn buffer_pool_hit_rate(pool: *BufferPool) -> i64
    if pool == null
        return 0
    let total: i64 = pool.stats_hits + pool.stats_misses
    if total == 0
        return 0
    # Return as percentage * 100 (e.g., 9500 = 95.00%)
    return (pool.stats_hits * 10000) / total
