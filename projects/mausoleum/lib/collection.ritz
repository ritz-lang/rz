# lib/collection.ritz - Document Collection storage
#
# A Collection stores documents using a B-tree index.
# Documents are serialized to byte buffers for storage.

import ritzlib.sys
import ritzlib.str
import ritzlib.option

import ritzlib.memory

import mausoleum.m7m_types
import mausoleum.page
import mausoleum.buffer_pool
import mausoleum.btree
import mausoleum.storage
import mausoleum.document
import mausoleum.field_index {
    FieldIndexSet,
    field_index_new,
    field_index_destroy,
    field_index_create,
    field_index_has,
    field_index_count,
    field_index_insert_doc,
    field_index_delete_doc,
    field_index_drop_all,
    field_index_find_string
}

# ============================================================================
# Constants
# ============================================================================

# Max serialized document size (AGAST #3638).  Every layer above takes its
# limit from this one: the server's buffers, the client's pre-send check,
# and nexus's page-size cap.  32 KiB holds the largest wiki page with room
# to spare, and a SCAN batch or wire message of one such document stays
# well inside the 64 KiB encrypted-channel frame.
pub const MAX_DOC_SIZE: i64 = 32768

# The longest document stored inline as its B-tree value: the longest value
# under an 8-byte document-id key, btree_max_value_len(8) (AGAST #2208).
# A longer one goes to a chain of overflow pages and its B-tree value is an
# overflow stub (see "Overflow chains" below).  A raw B-tree value is read
# into a [2048]u8 buffer here, so this must stay at most 2048 (a test pins it).
pub const MAX_INLINE_DOC_SIZE: i64 = 1992

# Serialization format version
const DOC_SERIAL_VERSION: i32 = 1

# ============================================================================
# Collection - Storage for documents
# ============================================================================

struct Collection
    pool: *BufferPool
    tree: *BTree
    collection_id: i32
    next_sequence: i32
    doc_count: i64
    # Secondary indexes on document fields, maintained by the operations
    # below (AGAST #3644).  Their pages live in a private pool, so they are
    # never written to the data directory: an index is derived state, built
    # from the collection when it is created.
    indexes: *FieldIndexSet

pub fn collection_init(col: *Collection, pool: *BufferPool, collection_id: i32) -> i32
    if pool == null
        return ERR_INVALID

    col.pool = pool
    col.collection_id = collection_id
    col.next_sequence = 1
    col.doc_count = 0
    col.indexes = field_index_new(0)

    # Initialize the B-tree
    let tree_opt = btree_create(pool)
    if option_is_none<*BTree>(@tree_opt)
        return ERR_NO_MEMORY
    col.tree = option_unwrap_or<*BTree>(@tree_opt, null)
    return ERR_OK

# Reattach to a collection a previous run wrote (meta from meta.m7m / WAL).
pub fn collection_open(col: *Collection, pool: *BufferPool, collection_id: i32, meta: *CollectionMeta) -> i32
    if pool == null or meta == null
        return ERR_INVALID

    let tree_opt = btree_open(pool, meta.root_page_id, meta.tree_height as i32, meta.tree_count, meta.tree_node_count)
    if option_is_none<*BTree>(@tree_opt)
        return ERR_CORRUPT
    col.tree = option_unwrap_or<*BTree>(@tree_opt, null)
    col.pool = pool
    col.collection_id = collection_id
    col.next_sequence = meta.next_sequence as i32
    col.doc_count = meta.doc_count
    # Indexes are in-memory state: a reopened collection starts with none
    # and a client re-creates the ones it needs (AGAST #3644).
    col.indexes = field_index_new(0)
    return ERR_OK

# Snapshot what collection_open needs into *out.
pub fn collection_meta(col: *Collection, out: *CollectionMeta)
    collection_meta_clear(out)
    if col == null or col.tree == null
        return
    out.root_page_id = btree_root_page_id(col.tree)
    out.tree_height = btree_height(col.tree) as i64
    out.tree_count = btree_count(col.tree)
    out.tree_node_count = btree_node_count(col.tree)
    out.next_sequence = col.next_sequence as i64
    out.doc_count = col.doc_count

# Open collection `collection_id` on a data directory: its recorded tree if
# it has one, else a new tree that is committed straight away so even an
# empty collection remembers its root.  ERR_NOT_FOUND if the directory has
# no collection with that id (see collection_open_named).
pub fn collection_open_storage(col: *Collection, storage: *Storage, collection_id: i32) -> i32
    if storage == null
        return ERR_INVALID
    let pool: *BufferPool = storage_pool(storage)
    var meta: CollectionMeta
    let found: i32 = storage_collection_meta_of(storage, collection_id, @meta)
    if found < 0
        return ERR_NOT_FOUND
    if found == 1
        return collection_open(col, pool, collection_id, @meta)

    let init_result: i32 = collection_init(col, pool, collection_id)
    if init_result != ERR_OK
        return init_result
    return collection_commit(col, storage)

# Open the collection called name[0..len) on a data directory, creating it
# if there is none (AGAST #3637).  Errors: ERR_INVALID for a bad name,
# ERR_FULL once the directory holds MAX_COLLECTIONS.
pub fn collection_open_named(col: *Collection, storage: *Storage, name: *u8, len: i32) -> i32
    if storage == null
        return ERR_INVALID
    var id: i32 = storage_collection_find(storage, name, len)
    if id == 0
        id = storage_collection_create(storage, name, len)
        if id < 0
            return id
    return collection_open_storage(col, storage, id)

# Make every change to the collection durable (WAL, data file, meta file).
# The server calls this after each INSERT / UPDATE / DELETE.
pub fn collection_commit(col: *Collection, storage: *Storage) -> i32
    if col == null or storage == null
        return ERR_INVALID
    var meta: CollectionMeta
    collection_meta(col, @meta)
    let set_result: i32 = storage_set_collection_meta_of(storage, col.collection_id, @meta)
    if set_result != ERR_OK
        return set_result
    return storage_flush(storage)

# Destroy a collection (frees the B-tree, not the buffer pool)
pub fn collection_destroy(col: *Collection)
    if col == null
        return
    if col.tree != null
        btree_destroy(col.tree)
        col.tree = null
    field_index_destroy(col.indexes)
    col.indexes = null

# ============================================================================
# Document Serialization
# ============================================================================

# Serialize a document to a byte buffer
# Format:
#   version: i32
#   id: i64
#   parent_id: i64
#   version: i64
#   created_at: i64
#   updated_at: i64
#   field_count: i32
#   for each field:
#     key_len: i32
#     key: [key_len]u8
#     ftype: i32
#     value data (type-dependent)
#   link_count: i32
#   for each link:
#     label_len: i32
#     label: [label_len]u8
#     target: i64
pub fn doc_serialize(doc: *Document, buf: *u8, buf_len: i64) -> i64
    var pos: i64 = 0

    # Version
    if pos + 4 > buf_len
        return -1
    var version_ptr: *i32 = (buf + pos) as *i32
    *version_ptr = DOC_SERIAL_VERSION
    pos = pos + 4

    # ID
    if pos + 8 > buf_len
        return -1
    var id_ptr: *i64 = (buf + pos) as *i64
    *id_ptr = doc.id.value
    pos = pos + 8

    # Parent ID
    if pos + 8 > buf_len
        return -1
    var parent_ptr: *i64 = (buf + pos) as *i64
    *parent_ptr = doc.parent_id.value
    pos = pos + 8

    # Document version
    if pos + 8 > buf_len
        return -1
    var ver_ptr: *i64 = (buf + pos) as *i64
    *ver_ptr = doc.version
    pos = pos + 8

    # Created at
    if pos + 8 > buf_len
        return -1
    var created_ptr: *i64 = (buf + pos) as *i64
    *created_ptr = doc.created_at.nanos
    pos = pos + 8

    # Updated at
    if pos + 8 > buf_len
        return -1
    var updated_ptr: *i64 = (buf + pos) as *i64
    *updated_ptr = doc.updated_at.nanos
    pos = pos + 8

    # Field count
    if pos + 4 > buf_len
        return -1
    var fc_ptr: *i32 = (buf + pos) as *i32
    *fc_ptr = doc.field_count
    pos = pos + 4

    # Fields
    var i: i32 = 0
    while i < doc.field_count
        var entry: *FieldEntry = @doc.fields[i]
        var key_len: i64 = strlen(@entry.key[0])

        # Key length
        if pos + 4 > buf_len
            return -1
        var kl_ptr: *i32 = (buf + pos) as *i32
        *kl_ptr = key_len as i32
        pos = pos + 4

        # Key
        if pos + key_len > buf_len
            return -1
        memcpy(buf + pos, @entry.key[0], key_len)
        pos = pos + key_len

        # Field type
        if pos + 4 > buf_len
            return -1
        var ft_ptr: *i32 = (buf + pos) as *i32
        *ft_ptr = entry.value.ftype
        pos = pos + 4

        # Field value (depends on type)
        if entry.value.ftype == FIELD_NULL
            # No data needed
            var dummy: i32 = 0
        else if entry.value.ftype == FIELD_INT or entry.value.ftype == FIELD_BOOL or entry.value.ftype == FIELD_FLOAT
            if pos + 8 > buf_len
                return -1
            var val_ptr: *i64 = (buf + pos) as *i64
            *val_ptr = entry.value.int_val
            pos = pos + 8
        else if entry.value.ftype == FIELD_STRING or entry.value.ftype == FIELD_BYTES
            # Length + data
            if pos + 8 > buf_len
                return -1
            var len_ptr: *i64 = (buf + pos) as *i64
            *len_ptr = entry.value.len_val
            pos = pos + 8

            if pos + entry.value.len_val > buf_len
                return -1
            if entry.value.len_val > 0
                memcpy(buf + pos, entry.value.ptr_val, entry.value.len_val)
            pos = pos + entry.value.len_val
        else if entry.value.ftype == FIELD_DOCREF
            if pos + 8 > buf_len
                return -1
            var ref_ptr: *i64 = (buf + pos) as *i64
            *ref_ptr = entry.value.ref_val
            pos = pos + 8

        i = i + 1

    # Link count
    if pos + 4 > buf_len
        return -1
    var lc_ptr: *i32 = (buf + pos) as *i32
    *lc_ptr = doc.link_count
    pos = pos + 4

    # Links
    i = 0
    while i < doc.link_count
        var link: *Link = @doc.links[i]
        var label_len: i64 = strlen(@link.label[0])

        # Label length
        if pos + 4 > buf_len
            return -1
        var ll_ptr: *i32 = (buf + pos) as *i32
        *ll_ptr = label_len as i32
        pos = pos + 4

        # Label
        if pos + label_len > buf_len
            return -1
        memcpy(buf + pos, @link.label[0], label_len)
        pos = pos + label_len

        # Target ID
        if pos + 8 > buf_len
            return -1
        var target_ptr: *i64 = (buf + pos) as *i64
        *target_ptr = link.target.value
        pos = pos + 8

        i = i + 1

    return pos

# Deserialize a document from a byte buffer
pub fn doc_deserialize(buf: *u8, buf_len: i64, doc: *Document) -> i32
    var pos: i64 = 0

    # Version check
    if pos + 4 > buf_len
        return ERR_CORRUPT
    var version: i32 = *((buf + pos) as *i32)
    if version != DOC_SERIAL_VERSION
        return ERR_VERSION
    pos = pos + 4

    # ID
    if pos + 8 > buf_len
        return ERR_CORRUPT
    doc.id.value = *((buf + pos) as *i64)
    pos = pos + 8

    # Parent ID
    if pos + 8 > buf_len
        return ERR_CORRUPT
    doc.parent_id.value = *((buf + pos) as *i64)
    pos = pos + 8

    # Document version
    if pos + 8 > buf_len
        return ERR_CORRUPT
    doc.version = *((buf + pos) as *i64)
    pos = pos + 8

    # Created at
    if pos + 8 > buf_len
        return ERR_CORRUPT
    doc.created_at.nanos = *((buf + pos) as *i64)
    pos = pos + 8

    # Updated at
    if pos + 8 > buf_len
        return ERR_CORRUPT
    doc.updated_at.nanos = *((buf + pos) as *i64)
    pos = pos + 8

    # Field count
    if pos + 4 > buf_len
        return ERR_CORRUPT
    doc.field_count = *((buf + pos) as *i32)
    pos = pos + 4

    # Fields
    var i: i32 = 0
    while i < doc.field_count
        var entry: *FieldEntry = @doc.fields[i]

        # Key length
        if pos + 4 > buf_len
            return ERR_CORRUPT
        var key_len: i32 = *((buf + pos) as *i32)
        pos = pos + 4

        # Key
        if pos + key_len as i64 > buf_len
            return ERR_CORRUPT
        memcpy(@entry.key[0], buf + pos, key_len as i64)
        entry.key[key_len] = 0  # Null terminate
        pos = pos + key_len as i64

        # Field type
        if pos + 4 > buf_len
            return ERR_CORRUPT
        entry.value.ftype = *((buf + pos) as *i32)
        pos = pos + 4

        # Field value
        if entry.value.ftype == FIELD_NULL
            entry.value.int_val = 0
            entry.value.ptr_val = null
            entry.value.len_val = 0
            entry.value.ref_val = 0
        else if entry.value.ftype == FIELD_INT or entry.value.ftype == FIELD_BOOL or entry.value.ftype == FIELD_FLOAT
            if pos + 8 > buf_len
                return ERR_CORRUPT
            entry.value.int_val = *((buf + pos) as *i64)
            pos = pos + 8
        else if entry.value.ftype == FIELD_STRING or entry.value.ftype == FIELD_BYTES
            if pos + 8 > buf_len
                return ERR_CORRUPT
            entry.value.len_val = *((buf + pos) as *i64)
            pos = pos + 8

            # Note: We point into the buffer - caller must ensure buffer lifetime
            # For full implementation, we'd copy to owned memory
            if entry.value.len_val > 0
                if pos + entry.value.len_val > buf_len
                    return ERR_CORRUPT
                entry.value.ptr_val = buf + pos
                pos = pos + entry.value.len_val
            else
                entry.value.ptr_val = null
        else if entry.value.ftype == FIELD_DOCREF
            if pos + 8 > buf_len
                return ERR_CORRUPT
            entry.value.ref_val = *((buf + pos) as *i64)
            pos = pos + 8

        i = i + 1

    # Link count
    if pos + 4 > buf_len
        return ERR_CORRUPT
    doc.link_count = *((buf + pos) as *i32)
    pos = pos + 4

    # Links
    i = 0
    while i < doc.link_count
        var link: *Link = @doc.links[i]

        # Label length
        if pos + 4 > buf_len
            return ERR_CORRUPT
        var label_len: i32 = *((buf + pos) as *i32)
        pos = pos + 4

        # Label
        if pos + label_len as i64 > buf_len
            return ERR_CORRUPT
        memcpy(@link.label[0], buf + pos, label_len as i64)
        link.label[label_len] = 0  # Null terminate
        pos = pos + label_len as i64

        # Target ID
        if pos + 8 > buf_len
            return ERR_CORRUPT
        link.target.value = *((buf + pos) as *i64)
        pos = pos + 8

        i = i + 1

    return ERR_OK

# ============================================================================
# Overflow chains (AGAST #3638)
# ============================================================================
#
# A document longer than MAX_INLINE_DOC_SIZE is stored whole in a chain of
# PAGE_MAGIC_OVERFLOW pages, and its B-tree value is a 20-byte stub:
#   tag: i32 (OVERFLOW_STUB_TAG)  total_len: i64  first_page: i64
# A serialized document starts with DOC_SERIAL_VERSION instead, so the two
# never mix up.  Each overflow page holds up to PAGE_DATA_SIZE bytes in its
# data area; its header's free_start is how many, next_page the next page
# (INVALID_PAGE_ID on the last).  A rewrite or delete gives the pages back
# to the buffer pool's free list.

const OVERFLOW_STUB_TAG: i32 = 0x4F564552   # "OVER", as PAGE_MAGIC_OVERFLOW
const OVERFLOW_STUB_LEN: i64 = 20

# 1 and the chain's length and first page if `raw` is an overflow stub.
fn overflow_stub_decode(raw: *u8, raw_len: i64, out_total: *i64, out_first: *i64) -> i32
    if raw_len != OVERFLOW_STUB_LEN
        return 0
    if *(raw as *i32) != OVERFLOW_STUB_TAG
        return 0
    *out_total = *((raw + 4) as *i64)
    *out_first = *((raw + 12) as *i64)
    return 1

fn overflow_stub_encode(stub: *u8, total: i64, first: i64)
    *(stub as *i32) = OVERFLOW_STUB_TAG
    *((stub + 4) as *i64) = total
    *((stub + 12) as *i64) = first

# Give back every page of the chain starting at `first`.  Stops at the
# first page that is not an overflow page (nothing to free past a break).
fn overflow_free(pool: *BufferPool, first: i64)
    var page_id: i64 = first
    var left: i64 = MAX_DOC_SIZE / PAGE_DATA_SIZE + 1   # Bounds a looped chain.
    while page_id != INVALID_PAGE_ID and left > 0
        let page_opt = buffer_pool_fetch(pool, page_id)
        if option_is_none<*Page>(@page_opt)
            return
        let page: *Page = option_unwrap_or<*Page>(@page_opt, null)
        let is_overflow: bool = page.header.magic == PAGE_MAGIC_OVERFLOW
        let next: i64 = page.header.next_page
        buffer_pool_unpin(pool, page_id, 0)
        if not is_overflow
            return
        buffer_pool_free_page(pool, page_id)
        page_id = next
        left -= 1

# Write data[0..len) to a new chain; its first page in *out_first.  On
# failure no page stays allocated.
fn overflow_write(pool: *BufferPool, data: *u8, len: i64, out_first: *i64) -> i32
    var first: i64 = INVALID_PAGE_ID
    var prev: *Page = null
    var prev_id: i64 = INVALID_PAGE_ID
    var pos: i64 = 0
    while pos < len
        let page_opt = buffer_pool_alloc(pool, PAGE_MAGIC_OVERFLOW)
        if option_is_none<*Page>(@page_opt)
            if prev != null
                buffer_pool_unpin(pool, prev_id, 1)
            if first != INVALID_PAGE_ID
                overflow_free(pool, first)
            return ERR_NO_MEMORY
        let page: *Page = option_unwrap_or<*Page>(@page_opt, null)
        let page_id: i64 = buffer_pool_page_id(pool, page)
        var chunk: i64 = len - pos
        if chunk > PAGE_DATA_SIZE
            chunk = PAGE_DATA_SIZE
        memcpy(page_data(page), data + pos, chunk)
        page.header.free_start = chunk as i32
        page.header.prev_page = prev_id
        if prev != null
            prev.header.next_page = page_id
            buffer_pool_unpin(pool, prev_id, 1)
        else
            first = page_id
        prev = page
        prev_id = page_id
        pos += chunk
    if prev != null
        buffer_pool_unpin(pool, prev_id, 1)
    *out_first = first
    return ERR_OK

# Read the `total`-byte chain starting at `first` into buf (cap >= total).
# ERR_CORRUPT if the chain is not exactly `total` bytes of overflow pages.
fn overflow_read(pool: *BufferPool, first: i64, total: i64, buf: *u8) -> i32
    var page_id: i64 = first
    var pos: i64 = 0
    while pos < total
        if page_id == INVALID_PAGE_ID
            return ERR_CORRUPT
        let page_opt = buffer_pool_fetch(pool, page_id)
        if option_is_none<*Page>(@page_opt)
            return ERR_IO
        let page: *Page = option_unwrap_or<*Page>(@page_opt, null)
        let chunk: i64 = page.header.free_start as i64
        if page.header.magic != PAGE_MAGIC_OVERFLOW or chunk <= 0 or chunk > PAGE_DATA_SIZE or pos + chunk > total
            buffer_pool_unpin(pool, page_id, 0)
            return ERR_CORRUPT
        memcpy(buf + pos, page_data(page), chunk)
        let next: i64 = page.header.next_page
        buffer_pool_unpin(pool, page_id, 0)
        pos += chunk
        page_id = next
    if page_id != INVALID_PAGE_ID
        return ERR_CORRUPT
    return ERR_OK

# The document a B-tree value `raw` stands for, copied into buf: `raw`
# itself, or the chain its stub points at.  ERR_FULL (with the length it
# needs in *out_len) if it is longer than `cap`.
fn value_resolve(col: *Collection, raw: *u8, raw_len: i64, buf: *u8, cap: i64, out_len: *i64) -> i32
    var total: i64 = 0
    var first: i64 = INVALID_PAGE_ID
    if overflow_stub_decode(raw, raw_len, @total, @first) == 1
        *out_len = total
        if total > cap
            return ERR_FULL
        return overflow_read(col.pool, first, total, buf)
    *out_len = raw_len
    if raw_len > cap
        return ERR_FULL
    if raw_len > 0
        memcpy(buf, raw, raw_len)
    return ERR_OK

# The B-tree value for document bytes data[0..len): data itself if it fits
# inline, else a stub (written into `stub`) for a new chain holding them.
# *out_val / *out_len say which; *out_first is the chain or INVALID_PAGE_ID.
fn value_store(col: *Collection, data: *u8, len: i64, stub: *u8, out_val: **u8, out_len: *i64, out_first: *i64) -> i32
    *out_first = INVALID_PAGE_ID
    if len <= MAX_INLINE_DOC_SIZE
        *out_val = data
        *out_len = len
        return ERR_OK
    var first: i64 = INVALID_PAGE_ID
    let rc: i32 = overflow_write(col.pool, data, len, @first)
    if rc != ERR_OK
        return rc
    overflow_stub_encode(stub, len, first)
    *out_val = stub
    *out_len = OVERFLOW_STUB_LEN
    *out_first = first
    return ERR_OK

# The overflow chain document `key` points at now, or INVALID_PAGE_ID (no
# such document, or stored inline).
fn current_chain(col: *Collection, key: *u8) -> i64
    var raw: [2048]u8
    var raw_len: i32 = 0
    if btree_get(col.tree, key, 8, @raw[0], @raw_len) != ERR_OK
        return INVALID_PAGE_ID
    var total: i64 = 0
    var first: i64 = INVALID_PAGE_ID
    if overflow_stub_decode(@raw[0], raw_len as i64, @total, @first) == 1
        return first
    return INVALID_PAGE_ID

# Serialize `doc` and store it under `key`: inline, or in a new chain (the
# old chain, if any, is freed once the new value is in).
fn store_doc(col: *Collection, key: *u8, doc: *Document) -> i32
    let buf: *u8 = malloc(MAX_DOC_SIZE)
    if buf == null
        return ERR_NO_MEMORY
    let size: i64 = doc_serialize(doc, buf, MAX_DOC_SIZE)
    if size < 0
        free(buf)
        return ERR_FULL

    let old_chain: i64 = current_chain(col, key)
    var stub: [20]u8
    var val: *u8 = null
    var val_len: i64 = 0
    var chain: i64 = INVALID_PAGE_ID
    var rc: i32 = value_store(col, buf, size, @stub[0], @val, @val_len, @chain)
    if rc == ERR_OK
        rc = btree_put(col.tree, key, 8, val, val_len as i32)
        if rc != ERR_OK and chain != INVALID_PAGE_ID
            overflow_free(col.pool, chain)
    free(buf)
    if rc == ERR_OK and old_chain != INVALID_PAGE_ID
        overflow_free(col.pool, old_chain)
    return rc

# ============================================================================
# Collection Operations
# ============================================================================

pub fn collection_insert(col: *Collection, doc: *Document, out_id: *DocumentId) -> i32
    if col == null or doc == null
        return ERR_INVALID

    # Assign new ID
    doc.id = doc_id_new(col.collection_id, col.next_sequence)
    col.next_sequence = col.next_sequence + 1

    # Build key from document ID (8 bytes)
    var key: [8]u8
    var key_ptr: *i64 = @key[0] as *i64
    *key_ptr = doc.id.value

    var result: i32 = store_doc(col, @key[0], doc)
    if result != ERR_OK
        return result

    # Keep every secondary index in step.  If one can't be maintained the
    # index is dropped instead of failing the write: the document is the
    # source of truth, and a lookup with no index falls back to a scan.
    let index_rc: i32 = field_index_insert_doc(col.indexes, doc)
    if index_rc != ERR_OK
        field_index_drop_all(col.indexes)

    col.doc_count = col.doc_count + 1
    *out_id = doc.id
    return ERR_OK

# Document `id`, deserialized into `out_doc`. Its stored bytes are copied
# into the caller's `buf` (see collection_get_raw), and `out_doc`'s
# FIELD_STRING and FIELD_BYTES values point into it: `out_doc` is only
# valid while `buf` is. Two documents alive at once need two buffers.
pub fn collection_get(col: *Collection, id: *DocumentId, out_doc: *Document, buf: *u8, cap: i64) -> i32
    if out_doc == null
        return ERR_INVALID
    var val_len: i64 = 0
    let result: i32 = collection_get_raw(col, id, buf, cap, @val_len)
    if result != ERR_OK
        return result
    return doc_deserialize(buf, val_len, out_doc)

# The stored (serialized) bytes of document `id`, copied into `buf`.
# The server answers GET with these as they are, with no deserialize and
# re-serialize round trip.  A buffer of MAX_DOC_SIZE holds any document;
# for a shorter `cap` that the document does not fit, ERR_FULL with the
# length it needs in *out_len.
pub fn collection_get_raw(col: *Collection, id: *DocumentId, buf: *u8, cap: i64, out_len: *i64) -> i32
    if col == null or id == null or buf == null or out_len == null
        return ERR_INVALID
    var key: [8]u8
    var key_ptr: *i64 = @key[0] as *i64
    *key_ptr = id.value
    var raw: [2048]u8
    var raw_len: i32 = 0
    let result: i32 = btree_get(col.tree, @key[0], 8, @raw[0], @raw_len)
    if result != ERR_OK
        return result
    return value_resolve(col, @raw[0], raw_len as i64, buf, cap, out_len)

# The document a scan's iterator is on (see collection_scan), copied into
# `buf` like collection_get_raw: btree_iter_value gives only its B-tree
# value, which for a large document is an overflow stub.
pub fn collection_iter_value(col: *Collection, iter: *BTreeIter, buf: *u8, cap: i64, out_len: *i64) -> i32
    if col == null or iter == null or buf == null or out_len == null
        return ERR_INVALID
    var raw: [2048]u8
    var raw_len: i32 = 0
    btree_iter_value(iter, @raw[0], @raw_len)
    if raw_len <= 0
        return ERR_IO   # Unreadable leaf (no stored document is empty).
    return value_resolve(col, @raw[0], raw_len as i64, buf, cap, out_len)

pub fn collection_update(col: *Collection, doc: *Document) -> i32
    if col == null or doc == null
        return ERR_INVALID

    # Check document exists
    var key: [8]u8
    var key_ptr: *i64 = @key[0] as *i64
    *key_ptr = doc.id.value

    var tmp_buf: [2048]u8
    var tmp_len: i32 = 0
    var result: i32 = btree_get(col.tree, @key[0], 8, @tmp_buf[0], @tmp_len)
    if result != ERR_OK
        return ERR_NOT_FOUND

    # Move the index entries from the old version to the new one (AGAST
    # #3644).  The old document is read first because the store overwrites
    # it; if the store then fails the old entries are put back.
    var indexed: bool = col.indexes != null and field_index_count(col.indexes) > 0
    var old_doc: Document
    var have_old: bool = false
    var old_buf: *u8 = null
    if indexed
        old_buf = malloc(MAX_DOC_SIZE)
        if old_buf != null
            var old_len: i64 = 0
            if collection_get_raw(col, @doc.id, old_buf, MAX_DOC_SIZE, @old_len) == ERR_OK
                if doc_deserialize(old_buf, old_len, @old_doc) == ERR_OK
                    have_old = true
        if have_old
            if field_index_delete_doc(col.indexes, @old_doc) != ERR_OK
                field_index_drop_all(col.indexes)
                indexed = false
        else
            # Can't read the old entries; don't leave a half-updated index.
            field_index_drop_all(col.indexes)
            indexed = false

    let store_rc: i32 = store_doc(col, @key[0], doc)
    if store_rc != ERR_OK
        if indexed and have_old
            field_index_insert_doc(col.indexes, @old_doc)   # put them back
        if old_buf != null
            free(old_buf)
        return store_rc

    if indexed
        if field_index_insert_doc(col.indexes, doc) != ERR_OK
            field_index_drop_all(col.indexes)
    if old_buf != null
        free(old_buf)
    return ERR_OK

pub fn collection_delete(col: *Collection, id: *DocumentId) -> i32
    if col == null or id == null
        return ERR_INVALID

    # Build key from document ID
    var key: [8]u8
    var key_ptr: *i64 = @key[0] as *i64
    *key_ptr = id.value

    # Remove the document's index entries while it can still be read
    # (AGAST #3644).  If they can't be kept exact, drop the index: a
    # lookup then falls back to a scan.
    if col.indexes != null and field_index_count(col.indexes) > 0
        var dbuf: *u8 = malloc(MAX_DOC_SIZE)
        if dbuf != null
            var dlen: i64 = 0
            if collection_get_raw(col, id, dbuf, MAX_DOC_SIZE, @dlen) == ERR_OK
                var old_doc: Document
                if doc_deserialize(dbuf, dlen, @old_doc) == ERR_OK
                    if field_index_delete_doc(col.indexes, @old_doc) != ERR_OK
                        field_index_drop_all(col.indexes)
            free(dbuf)

    # Delete from B-tree, then give back its overflow chain if it had one.
    let chain: i64 = current_chain(col, @key[0])
    var result: i32 = btree_delete(col.tree, @key[0], 8)
    if result == ERR_OK
        col.doc_count = col.doc_count - 1
        if chain != INVALID_PAGE_ID
            overflow_free(col.pool, chain)
    return result

pub fn collection_count(col: *Collection) -> i64
    if col == null
        return 0
    return col.doc_count

# ============================================================================
# Secondary field indexes (AGAST #3644)
# ============================================================================

# Index `field` on this collection, building entries for the documents
# already stored.  Idempotent: an existing index is left alone, so a client
# can ensure it after every connect.  ERR_INVALID for a bad field name,
# ERR_FULL past the index limit, < 0 on failure.
pub fn collection_index_create(col: *Collection, field: *u8, field_len: i32) -> i32
    if col == null
        return ERR_INVALID
    let existed: i32 = field_index_has(col.indexes, field, field_len)
    let create_rc: i32 = field_index_create(col.indexes, field, field_len)
    if create_rc != ERR_OK
        return create_rc
    if existed == 1
        return ERR_OK

    # A new index starts empty: build it from the documents already here.
    let iter_opt = collection_scan(col)
    if option_is_none<*BTreeIter>(@iter_opt)
        field_index_drop_all(col.indexes)
        return ERR_NO_MEMORY
    let iter: *BTreeIter = option_unwrap_or<*BTreeIter>(@iter_opt, null)
    let buf: *u8 = malloc(MAX_DOC_SIZE)
    if buf == null
        btree_iter_destroy(iter)
        field_index_drop_all(col.indexes)
        return ERR_NO_MEMORY

    var build_rc: i32 = ERR_OK
    while btree_iter_valid(iter) != 0
        var dlen: i64 = 0
        if collection_iter_value(col, iter, buf, MAX_DOC_SIZE, @dlen) == ERR_OK
            var doc: Document
            if doc_deserialize(buf, dlen, @doc) == ERR_OK
                build_rc = field_index_insert_doc(col.indexes, @doc)
                if build_rc != ERR_OK
                    break
        btree_iter_next(iter)
    btree_iter_destroy(iter)
    free(buf)

    if build_rc != ERR_OK
        field_index_drop_all(col.indexes)
        return build_rc
    return ERR_OK


# Drop every index on this collection: a lookup then falls back to a scan
# rather than answer from an index known to be incomplete.
pub fn collection_index_drop_all(col: *Collection)
    if col == null
        return
    field_index_drop_all(col.indexes)


pub fn collection_index_count(col: *Collection) -> i32
    if col == null
        return 0
    return field_index_count(col.indexes)


# Every document holding `value` in string field `field`, up to `max`, in
# ascending document id order.  Count, 0 for none, ERR_NOT_FOUND when the
# field has no index, or < 0 on failure.
pub fn collection_index_find_string(col: *Collection, field: *u8, field_len: i32, value: *u8, value_len: i32, out: *i64, max: i32) -> i32
    if col == null
        return ERR_INVALID
    return field_index_find_string(col.indexes, field, field_len, value, value_len, out, max)

# Getter for root page ID (from the B-tree)
pub fn collection_root_page_id(col: *Collection) -> i64
    if col == null or col.tree == null
        return INVALID_PAGE_ID
    return btree_root_page_id(col.tree)

# Getter for next document sequence number
pub fn collection_next_sequence(col: *Collection) -> i64
    if col == null
        return 0
    return col.next_sequence as i64

# Getter for document count
pub fn collection_doc_count(col: *Collection) -> i64
    if col == null
        return 0
    return col.doc_count


# Open a forward iterator over every document in the collection.
#
# Walks the underlying B-tree's leaves in DocumentId key order.  Read each
# document with collection_iter_value (not btree_iter_value, which gives a
# large document's overflow stub), then `doc_deserialize` it.  Advance and
# finish with the `btree_iter_*` API exported from `mausoleum.btree`.
#
# Returns None on null collection / null tree / OOM.
pub fn collection_scan(col: *Collection) -> Option<*BTreeIter>
    if col == null or col.tree == null
        return None
    return btree_scan(col.tree, null, 0, null, 0)
