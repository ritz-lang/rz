# lib/storage.ritz - Storage Engine
#
# The Storage Engine provides durable, crash-safe storage for Mausoleum.
# It coordinates:
# - Buffer pool for page caching
# - WAL for durability
# - Recovery for crash safety
#
# Storage Layout:
#   <db_path>/
#     data.m7m     - Main data file (pages)
#     wal.000000   - WAL segment files
#     meta.m7m     - Metadata (checkpoint info, config)
#
# Usage:
#   let storage_opt = storage_open("/path/to/db")
#   if option_is_none<*Storage>(@storage_opt)
#       print("Failed to open storage\n")
#       return 1
#   let storage: *Storage = option_unwrap_or<*Storage>(@storage_opt, null)
#
#   # Use the storage...
#   storage_close(storage)

import ritzlib.cstr
import ritzlib.sys
import ritzlib.fd
import ritzlib.fs
import ritzlib.str
import ritzlib.strview
import ritzlib.string
import ritzlib.span
import ritzlib.box
import ritzlib.gvec
import ritzlib.option

import mausoleum.m7m_types
import mausoleum.page
import mausoleum.buffer_pool
import mausoleum.wal
import mausoleum.recovery

# ============================================================================
# Constants
# ============================================================================

const STORAGE_MAGIC: i32 = 0x4D374D53    # "M7MS" - Mausoleum Storage
# v1: one collection (a 48-byte header, or that plus one CollectionMeta).
# v2: a table of named collections (AGAST #3637).  v1 files are read as a
# table holding only the default collection and rewritten as v2.
const STORAGE_VERSION: i32 = 2
const STORAGE_VERSION_V1: i32 = 1

const DATA_FILE_NAME: StrView = "/data.m7m"
const WAL_FILE_NAME: StrView = "/wal"
const META_FILE_NAME: StrView = "/meta.m7m"

const DEFAULT_BUFFER_SIZE: i32 = 256    # 256 pages = 1MB cache

# The v1 header (magic..last_open); a v1 file's CollectionMeta follows it.
const STORAGE_META_V1_HEADER: i64 = 48

# A checkpoint cuts the WAL back once it grows past this (every committed
# write is also in data.m7m by then, so the records are only crash insurance
# for the write in flight).
const WAL_CHECKPOINT_BYTES: i64 = 4194304   # 4 MiB

# ============================================================================
# Storage Metadata
# ============================================================================
# Stored in meta.m7m file for persistence across restarts.  v2 layout:
#   StorageMeta, then coll_count NamedCollectionMeta entries (the first is
#   always the default collection).

struct StorageMeta
    magic: i32
    version: i32
    checkpoint_lsn: i64     # Last checkpoint LSN
    next_page_id: i64       # Next page ID to allocate
    next_txn_id: i64        # Next transaction ID
    created_at: i64         # Creation timestamp (nanos)
    last_open: i64          # Last open timestamp (nanos)
    coll_count: i64         # Entries in the collection table (v2)

# ============================================================================
# Storage Engine Structure
# ============================================================================

struct Storage
    pool: BufferPool
    wal_writer: Box<WalWriter>              # empty if the WAL couldn't be made
    recovery_mgr: Box<RecoveryManager>      # empty if none was made

    base_path: String
    base_path_len: i32

    meta: StorageMeta
    meta_fd: Fd             # meta.m7m (closed: raw -1)

    # The collection table: meta.coll_count entries of MAX_COLLECTIONS, and
    # per entry 1 if it changed since the last commit (AGAST #3637).
    colls: Vec<NamedCollectionMeta>   # MAX_COLLECTIONS slots
    coll_dirty: Vec<u8>               # MAX_COLLECTIONS flags

    current_txn: i64        # Current active transaction ID (0 = none)
    meta_dirty: i32         # Some collection's meta changed since the last commit
    current_lsn: i64        # Current LSN for the active transaction

    is_open: i32

# ============================================================================
# Metadata Operations
# ============================================================================

fn meta_init(meta: *StorageMeta, colls: *NamedCollectionMeta)
    meta.magic = STORAGE_MAGIC
    meta.version = STORAGE_VERSION
    meta.checkpoint_lsn = 0
    meta.next_page_id = 0
    meta.next_txn_id = 1
    let now: M7mTimestamp = m7m_timestamp_now()
    meta.created_at = now.nanos
    meta.last_open = now.nanos
    meta_only_default(meta, colls)

# A table holding just the default collection, with no tree yet.
fn meta_only_default(meta: *StorageMeta, colls: *NamedCollectionMeta)
    meta.coll_count = 1
    named_collection_meta_init(colls, DEFAULT_COLLECTION_ID, DEFAULT_COLLECTION_NAME.ptr, DEFAULT_COLLECTION_NAME.len as i32)

# Read meta.m7m into *meta and the collection table `colls` (room for
# MAX_COLLECTIONS).  A v1 file comes back as a v2 table holding only the
# default collection, its tree (if the file recorded one) included.
fn meta_read(fd: @Fd, meta: *StorageMeta, colls: *NamedCollectionMeta) -> i32
    match fd.seek(0, SEEK_SET)
        Ok(_) => pass
        Err(_) => return ERR_IO

    # A v1 file is shorter than StorageMeta: one read, whatever it gives.
    var bytes_read: i64 = 0
    match fd.read(Span<u8> { ptr: meta as *u8, len: sizeof(StorageMeta) })
        Ok(n) => bytes_read = n
        Err(_) => return ERR_IO
    if bytes_read < STORAGE_META_V1_HEADER
        return ERR_CORRUPT
    if meta.magic != STORAGE_MAGIC
        return ERR_CORRUPT

    if meta.version == STORAGE_VERSION_V1
        meta_only_default(meta, colls)
        match fd.seek(STORAGE_META_V1_HEADER, SEEK_SET)
            Ok(_) => pass
            Err(_) => return ERR_IO
        var n: i64 = 0
        match fd.read(Span<u8> { ptr: @colls.meta as *u8, len: sizeof(CollectionMeta) })
            Ok(got) => n = got
            Err(_) => return ERR_IO
        if n == 0
            # Written before collections were persisted: no tree recorded.
            collection_meta_clear(@colls.meta)
        else if n != sizeof(CollectionMeta)
            return ERR_CORRUPT
        meta.version = STORAGE_VERSION
        return ERR_OK

    if meta.version != STORAGE_VERSION
        return ERR_VERSION
    if bytes_read != sizeof(StorageMeta)
        return ERR_CORRUPT
    if meta.coll_count < 1 or meta.coll_count > MAX_COLLECTIONS as i64
        return ERR_CORRUPT
    let table_len: i64 = meta.coll_count * sizeof(NamedCollectionMeta)
    match fd.read_exact(Span<u8> { ptr: colls as *u8, len: table_len })
        Ok(_) => pass
        Err(_) => return ERR_CORRUPT
    if colls.id != DEFAULT_COLLECTION_ID as i64
        return ERR_CORRUPT
    return ERR_OK

fn meta_write(fd: @Fd, meta: *StorageMeta, colls: *NamedCollectionMeta) -> i32
    match fd.seek(0, SEEK_SET)
        Ok(_) => pass
        Err(_) => return ERR_IO

    match fd.write_all(Span<u8> { ptr: meta as *u8, len: sizeof(StorageMeta) })
        Ok(_) => pass
        Err(_) => return ERR_IO
    let table_len: i64 = meta.coll_count * sizeof(NamedCollectionMeta)
    match fd.write_all(Span<u8> { ptr: colls as *u8, len: table_len })
        Ok(_) => pass
        Err(_) => return ERR_IO

    # NOTE: Would call fsync here for durability, but syscall not yet in ritzlib
    # TODO: Add sys_fsync to ritzlib.sys
    return ERR_OK

fn storage_meta_write(storage: *Storage) -> i32
    return meta_write(@storage.meta_fd, @storage.meta, storage.colls.as_ptr())

# Every collection's meta is now on disk: nothing is dirty.
fn storage_meta_clean(storage: *Storage)
    storage.meta_dirty = 0
    span_from_vec<u8>(@storage.coll_dirty).zero()

# The table entry of collection `id`, or null.
fn storage_entry(storage: *Storage, id: i32) -> *NamedCollectionMeta
    var i: i64 = 0
    while i < storage.meta.coll_count
        let e: *NamedCollectionMeta = storage.colls.as_ptr() + i
        if e.id == id as i64
            return e
        i += 1
    return null

fn storage_entry_index(storage: *Storage, id: i32) -> i64
    var i: i64 = 0
    while i < storage.meta.coll_count
        let e: *NamedCollectionMeta = storage.colls.as_ptr() + i
        if e.id == id as i64
            return i
        i += 1
    return -1

# Take a collection's meta as recovered from the WAL: update its entry, or
# add it (a collection created after the last meta.m7m write).
fn storage_apply_recovered(storage: *Storage, rec: *NamedCollectionMeta) -> i32
    let e: *NamedCollectionMeta = storage_entry(storage, rec.id as i32)
    if e != null
        e.meta = rec.meta
        return ERR_OK
    if storage.meta.coll_count >= MAX_COLLECTIONS as i64
        return ERR_FULL
    *(storage.colls.as_ptr() + storage.meta.coll_count) = *rec
    storage.meta.coll_count += 1
    return ERR_OK

# ============================================================================
# Storage Creation/Opening
# ============================================================================

# Open or create a storage directory. The Storage is boxed: its parts point
# at each other (the recovery manager at the pool), so it must not move.
pub fn storage_open(base: StrView) -> Option<Box<Storage>>
    let path_len: i64 = base.len
    if path_len <= 0 or path_len > 200
        return None

    # The collection table (AGAST #3637): MAX_COLLECTIONS entries, and a
    # dirty flag for each.
    var colls: Vec<NamedCollectionMeta> = vec_with_cap<NamedCollectionMeta>(MAX_COLLECTIONS as i64)
    var coll_dirty: Vec<u8> = vec_with_cap<u8>(MAX_COLLECTIONS as i64)
    if colls.cap() < MAX_COLLECTIONS as i64 or coll_dirty.cap() < MAX_COLLECTIONS as i64
        return None
    for i in 0..MAX_COLLECTIONS
        coll_dirty.push(0)

    var pool: BufferPool = match buffer_pool_new(DEFAULT_BUFFER_SIZE)
        Some(p) => p
        None => return None

    # Every part with drop glue is set here; meta is read or made below.
    var st: Storage
    st.pool = pool
    st.wal_writer = box_empty<WalWriter>()
    st.recovery_mgr = box_empty<RecoveryManager>()
    st.base_path = string_from(base)
    st.base_path_len = path_len as i32
    st.meta_fd = fd_adopt(-1)
    st.colls = colls
    st.coll_dirty = coll_dirty
    st.current_txn = 0
    st.meta_dirty = 0
    st.current_lsn = 0
    st.is_open = 0
    var owner: Box<Storage> = box_new<Storage>(st)
    if not owner.valid()
        return None
    let storage: *Storage = owner.as_ptr()

    # Create the directory; it may already exist (Err(Exist) is fine).
    mkdir(base, 493)  # 0755

    # Build paths
    let data_path: String = m7m_path_join(base, DATA_FILE_NAME)
    let wal_path: String = m7m_path_join(base, WAL_FILE_NAME)
    let meta_path: String = m7m_path_join(base, META_FILE_NAME)

    # Open or create meta file
    var is_new: i32 = 0
    let meta_view: StrView = meta_path.as_view()
    var meta_fd: Fd = fd_adopt(-1)
    match fd_open(meta_view, O_RDWR, 0)
        Ok(f) => meta_fd = f
        Err(_) =>
            # Create new meta file
            match fd_open(meta_view, O_RDWR | O_CREAT, 420)
                Ok(f) => meta_fd = f
                Err(_) => return None
            is_new = 1

    storage.meta_fd = meta_fd

    # Read or initialize metadata
    if is_new != 0
        meta_init(@storage.meta, storage.colls.as_ptr())
        if storage_meta_write(storage) != ERR_OK
            return None
    else
        if meta_read(@storage.meta_fd, @storage.meta, storage.colls.as_ptr()) != ERR_OK
            return None

    # The WAL is redo-only: no page may reach data.m7m before the WAL
    # commit that holds it (AGAST #4205).
    buffer_pool_set_no_steal(@storage.pool, 1)

    # Open data file
    if buffer_pool_open(@storage.pool, data_path.as_view()) != ERR_OK
        return None

    # Recovery first: redo every committed WAL transaction onto its pages
    # and take each collection's meta from the last one that logged it.  A
    # WAL that cannot be read is not discarded: refuse to open instead.
    match recovery_mgr_new(@storage.pool, wal_path.as_view())
        Some(m) => storage.recovery_mgr = box_new<RecoveryManager>(m)
        None => pass
    let rmgr: *RecoveryManager = storage.recovery_mgr.as_ptr()
    if is_new == 0 and rmgr != null
        var rc: i32 = recovery_recover(rmgr)
        let n: i32 = recovery_collection_meta_count(rmgr)
        var i: i32 = 0
        while rc == ERR_OK and i < n
            var recovered: NamedCollectionMeta
            recovery_collection_meta_at(rmgr, i, @recovered)
            rc = storage_apply_recovered(storage, @recovered)
            i += 1
        if rc != ERR_OK
            return None

    # Create WAL writer
    match wal_writer_new(wal_path.as_view())
        Some(w) => storage.wal_writer = box_new<WalWriter>(w)
        None => pass
    if storage.wal_writer.valid()
        wal_writer_open(storage.wal_writer.as_ptr())

    # Update last open time
    let now: M7mTimestamp = m7m_timestamp_now()
    storage.meta.last_open = now.nanos
    storage.is_open = 1

    # Write what recovery redid to data.m7m / meta.m7m, then cut the WAL.
    storage_checkpoint(storage)

    # The free pages (AGAST #3638) are the PAGE_MAGIC_FREE ones, now that
    # data.m7m holds every committed page: list them for reuse.
    buffer_pool_reclaim_free_pages(@storage.pool)
    return Some(owner)

# Close storage
pub fn storage_close(storage: *Storage) -> i32
    if storage == null
        return ERR_INVALID

    if storage.is_open == 0
        return ERR_OK

    # Flush all pending data
    storage_flush(storage)

    # Write final checkpoint
    storage_checkpoint(storage)

    # Close WAL
    if storage.wal_writer.valid()
        wal_writer_destroy(storage.wal_writer.as_ptr())
        storage.wal_writer.drop()

    # Close buffer pool
    buffer_pool_destroy(@storage.pool)

    # Close recovery manager
    if storage.recovery_mgr.valid()
        recovery_mgr_destroy(storage.recovery_mgr.as_ptr())
        storage.recovery_mgr.drop()

    # Write final metadata
    if storage.meta_fd.valid()
        storage_meta_write(storage)
        storage.meta_fd.close()

    # Free base path
    storage.base_path.deinit()

    storage.is_open = 0
    return ERR_OK

# Close storage if it is open and release its tables. Its owner still drops
# the (now empty) Box.
pub fn storage_destroy(storage: *Storage)
    if storage == null
        return

    if storage.is_open != 0
        storage_close(storage)

    storage.colls.deinit()
    storage.coll_dirty.deinit()

# ============================================================================
# Buffer Pool Access
# ============================================================================

pub fn storage_pool(storage: *Storage) -> *BufferPool
    if storage == null
        return null
    return @storage.pool

pub fn storage_wal(storage: *Storage) -> *WalWriter
    if storage == null
        return null
    return storage.wal_writer.as_ptr()

# ============================================================================
# Transaction Operations
# ============================================================================

# Begin a new transaction
pub fn storage_begin_txn(storage: *Storage) -> i64
    if storage == null or storage.is_open == 0
        return -1

    if storage.current_txn != 0
        return -1  # Transaction already active

    let txn_id: i64 = storage.meta.next_txn_id
    storage.meta.next_txn_id += 1
    storage.current_txn = txn_id

    # Write BEGIN to WAL
    if storage.wal_writer.valid()
        storage.current_lsn = wal_write_begin(storage.wal_writer.as_ptr(), txn_id)

    return txn_id

# Commit the current transaction
pub fn storage_commit_txn(storage: *Storage) -> i32
    if storage == null or storage.is_open == 0
        return ERR_INVALID

    if storage.current_txn == 0
        return ERR_INVALID  # No active transaction

    # Write COMMIT to WAL
    if storage.wal_writer.valid()
        wal_write_commit(storage.wal_writer.as_ptr(), storage.current_txn, storage.current_lsn)

    storage.current_txn = 0
    storage.current_lsn = 0
    return ERR_OK

# Abort the current transaction
pub fn storage_abort_txn(storage: *Storage) -> i32
    if storage == null or storage.is_open == 0
        return ERR_INVALID

    if storage.current_txn == 0
        return ERR_INVALID  # No active transaction

    # Write ABORT to WAL
    if storage.wal_writer.valid()
        wal_write_abort(storage.wal_writer.as_ptr(), storage.current_txn, storage.current_lsn)

    storage.current_txn = 0
    storage.current_lsn = 0
    return ERR_OK

# ============================================================================
# Page Operations (with WAL logging)
# ============================================================================

# Allocate a new page
pub fn storage_alloc_page(storage: *Storage, page_type: i32) -> Option<*Page>
    if storage == null or storage.is_open == 0
        return None

    let page_opt: Option<*Page> = buffer_pool_alloc(@storage.pool, page_type)
    if option_is_none<*Page>(@page_opt)
        return None

    let page: *Page = option_unwrap_or<*Page>(@page_opt, null)

    # Log full page image to WAL for new pages
    if storage.wal_writer.valid() and storage.current_txn != 0
        let page_id: i64 = buffer_pool_page_id(@storage.pool, page)
        storage.current_lsn = wal_write_page(storage.wal_writer.as_ptr(), storage.current_txn, storage.current_lsn, page_id, page)

    # Update next_page_id in metadata
    let page_id: i64 = buffer_pool_page_id(@storage.pool, page)
    if page_id >= storage.meta.next_page_id
        storage.meta.next_page_id = page_id + 1

    return Some(page)

# Fetch an existing page
pub fn storage_fetch_page(storage: *Storage, page_id: i64) -> Option<*Page>
    if storage == null or storage.is_open == 0
        return None

    return buffer_pool_fetch(@storage.pool, page_id)

# Mark a page as modified and log to WAL
pub fn storage_mark_dirty(storage: *Storage, page: *Page)
    if storage == null or page == null or storage.is_open == 0
        return

    let page_id: i64 = buffer_pool_page_id(@storage.pool, page)

    # Log page modification to WAL
    if storage.wal_writer.valid() and storage.current_txn != 0
        storage.current_lsn = wal_write_page(storage.wal_writer.as_ptr(), storage.current_txn, storage.current_lsn, page_id, page)

# Unpin a page
pub fn storage_unpin_page(storage: *Storage, page_id: i64, dirty: i32)
    if storage == null or storage.is_open == 0
        return

    buffer_pool_unpin(@storage.pool, page_id, dirty)

# ============================================================================
# Durability Operations
# ============================================================================

# Log every dirty page and (if it changed) the collection meta to the WAL as
# one committed transaction, and write it out.  Nothing reaches data.m7m.
# This is the durability point of a write: once it returns ERR_OK a crash
# at any later moment is redone on the next storage_open.
pub fn storage_wal_commit(storage: *Storage) -> i32
    if storage == null or storage.is_open == 0
        return ERR_INVALID
    let w: *WalWriter = storage.wal_writer.as_ptr()
    if w == null
        return ERR_OK
    if buffer_pool_dirty_count(@storage.pool) == 0 and storage.meta_dirty == 0
        return wal_writer_flush(w)

    let txn_id: i64 = storage.meta.next_txn_id
    storage.meta.next_txn_id += 1

    var lsn: i64 = wal_write_begin(w, txn_id)
    if lsn < 0
        return ERR_IO
    let frames: i32 = buffer_pool_num_frames(@storage.pool)
    var i: i32 = 0
    while i < frames
        var page_id: i64 = INVALID_PAGE_ID
        let page: *Page = buffer_pool_dirty_page(@storage.pool, i, @page_id)
        if page != null
            lsn = wal_write_page(w, txn_id, lsn, page_id, page)
            if lsn < 0
                return ERR_IO
        i += 1
    # One META record per collection that changed (AGAST #3637).
    var c: i64 = 0
    while c < storage.meta.coll_count
        if *(storage.coll_dirty.as_ptr() + c) != 0
            lsn = wal_write_named_meta(w, txn_id, lsn, storage.colls.as_ptr() + c)
            if lsn < 0
                return ERR_IO
        c += 1
    # COMMIT flushes the WAL buffer.
    if wal_write_commit(w, txn_id, lsn) < 0
        return ERR_IO
    # Committed: the dirty pages may be written back from now on.
    buffer_pool_mark_logged(@storage.pool)
    return ERR_OK

# Commit everything written so far: WAL first (write-ahead), then the dirty
# pages to data.m7m, then meta.m7m.  The server calls this after every
# INSERT / UPDATE / DELETE.
pub fn storage_flush(storage: *Storage) -> i32
    if storage == null or storage.is_open == 0
        return ERR_INVALID

    let wal_result: i32 = storage_wal_commit(storage)
    if wal_result != ERR_OK
        return wal_result

    let pool_result: i32 = buffer_pool_flush_all(@storage.pool)
    if pool_result != ERR_OK
        return pool_result

    let meta_result: i32 = storage_meta_write(storage)
    if meta_result != ERR_OK
        return meta_result
    storage_meta_clean(storage)

    # Everything logged so far is now in data.m7m; keep the WAL bounded.
    if storage.wal_writer.valid() and wal_writer_size(storage.wal_writer.as_ptr()) > WAL_CHECKPOINT_BYTES
        return storage_checkpoint(storage)
    return ERR_OK

# Create a checkpoint (flushes everything and updates metadata)
pub fn storage_checkpoint(storage: *Storage) -> i32
    if storage == null or storage.is_open == 0
        return ERR_INVALID

    # Write all dirty pages and the meta file directly: a checkpoint makes
    # the WAL redundant, so there is no point logging them first.
    let flush_result: i32 = buffer_pool_flush_all(@storage.pool)
    if flush_result != ERR_OK
        return flush_result
    let meta_result: i32 = storage_meta_write(storage)
    if meta_result != ERR_OK
        return meta_result
    storage_meta_clean(storage)

    # Data and meta are on disk: drop the redo records, mark the checkpoint.
    if storage.wal_writer.valid()
        wal_writer_truncate(storage.wal_writer.as_ptr())
        let lsn: i64 = wal_write_checkpoint(storage.wal_writer.as_ptr())
        if lsn > 0
            storage.meta.checkpoint_lsn = lsn

    # Update and persist metadata
    return storage_meta_write(storage)

# ============================================================================
# Statistics
# ============================================================================

pub fn storage_page_count(storage: *Storage) -> i64
    if storage == null
        return 0
    return storage.meta.next_page_id

pub fn storage_checkpoint_lsn(storage: *Storage) -> i64
    if storage == null
        return 0
    return storage.meta.checkpoint_lsn

pub fn storage_is_open(storage: *Storage) -> i32
    if storage == null
        return 0
    return storage.is_open

# Bytes currently in the WAL segment (including buffered ones).
pub fn storage_wal_size(storage: *Storage) -> i64
    if storage == null
        return 0
    return wal_writer_size(storage.wal_writer.as_ptr())

# ============================================================================
# Collection Metadata Persistence
# ============================================================================
# Where each collection's B-tree root is and its counters (#2458), in a
# table of named collections (#3637).  Collection DEFAULT_COLLECTION_ID,
# "default", is always there; it is the one a pre-#3637 store held.

# The id of the collection called name[0..len), or 0 if there is none.
pub fn storage_collection_find(storage: *Storage, name: *u8, len: i32) -> i32
    if storage == null or name == null or len <= 0
        return 0
    var i: i64 = 0
    while i < storage.meta.coll_count
        let e: *NamedCollectionMeta = storage.colls.as_ptr() + i
        if named_collection_meta_is(e, name, len) == 1
            return e.id as i32
        i += 1
    return 0

# Add a collection called name[0..len), with no tree yet; the next
# storage_flush persists it.  Returns its id (> 0), or ERR_INVALID (bad
# name: empty or over MAX_COLLECTION_NAME), ERR_EXISTS or ERR_FULL.
pub fn storage_collection_create(storage: *Storage, name: *u8, len: i32) -> i32
    if storage == null or name == null or len <= 0 or len > MAX_COLLECTION_NAME
        return ERR_INVALID
    if storage_collection_find(storage, name, len) != 0
        return ERR_EXISTS
    let count: i64 = storage.meta.coll_count
    if count >= MAX_COLLECTIONS as i64
        return ERR_FULL
    # Ids are never reused: one past the highest.
    var max_id: i64 = 0
    var i: i64 = 0
    while i < count
        let e: *NamedCollectionMeta = storage.colls.as_ptr() + i
        if e.id > max_id
            max_id = e.id
        i += 1
    let id: i32 = (max_id + 1) as i32
    named_collection_meta_init(storage.colls.as_ptr() + count, id, name, len)
    storage.meta.coll_count = count + 1
    *(storage.coll_dirty.as_ptr() + count) = 1
    storage.meta_dirty = 1
    return id

# How many collections the table holds (the default one included).
pub fn storage_collection_count(storage: *Storage) -> i32
    if storage == null
        return 0
    return storage.meta.coll_count as i32

# Record collection `id`'s meta; the next storage_flush logs and persists
# it.  ERR_NOT_FOUND if there is no such collection.
pub fn storage_set_collection_meta_of(storage: *Storage, id: i32, meta: *CollectionMeta) -> i32
    if storage == null or meta == null
        return ERR_INVALID
    let idx: i64 = storage_entry_index(storage, id)
    if idx < 0
        return ERR_NOT_FOUND
    let e: *NamedCollectionMeta = storage.colls.as_ptr() + idx
    if not collection_meta_eq(@e.meta, meta)
        e.meta = *meta
        *(storage.coll_dirty.as_ptr() + idx) = 1
        storage.meta_dirty = 1
    return ERR_OK

# Fill *out with collection `id`'s recorded meta.  Returns 1 if it has a
# tree, 0 if it has none yet, -1 if there is no such collection.
pub fn storage_collection_meta_of(storage: *Storage, id: i32, out: *CollectionMeta) -> i32
    if storage == null or out == null
        return -1
    collection_meta_clear(out)
    let e: *NamedCollectionMeta = storage_entry(storage, id)
    if e == null
        return -1
    *out = e.meta
    if out.root_page_id == INVALID_PAGE_ID
        return 0
    return 1

# The default collection's meta (what these did before #3637).
pub fn storage_set_collection_meta(storage: *Storage, meta: *CollectionMeta)
    storage_set_collection_meta_of(storage, DEFAULT_COLLECTION_ID, meta)

pub fn storage_collection_meta(storage: *Storage, out: *CollectionMeta) -> i32
    if storage_collection_meta_of(storage, DEFAULT_COLLECTION_ID, out) == 1
        return 1
    return 0
