# lib/registry.ritz - The server's open collections, by name (AGAST #3637)
#
# CONNECT carries a collection name; the server binds the session to the
# collection of that name through this registry, so clients on different
# names never see each other's documents.
#
#   - The empty name and "default" are the default collection, the one the
#     server was started with (on a data directory: DEFAULT_COLLECTION_ID,
#     which holds a pre-#3637 store's documents).
#   - An unknown name is created, not refused: every client so far CONNECTs
#     with the name it means to use and none relies on refusal, and the
#     serve command has no other way to make a collection.  On a data
#     directory it is persisted (collection_open_named), so a restart finds it.
#   - A name longer than MAX_COLLECTION_NAME, or a new one once
#     MAX_COLLECTIONS are open, is refused (registry_bind returns null).
#
# Collections the registry opened are closed by registry_destroy and freed when
# the registry drops; the default
# one belongs to the caller.

import ritzlib.sys
import ritzlib.str
import ritzlib.strview
import ritzlib.box
import ritzlib.gvec

import mausoleum.m7m_types
import mausoleum.buffer_pool
import mausoleum.storage
import mausoleum.collection

struct RegistryEntry
    name_len: i32
    name: [64]u8
    col: *Collection
    owned: Box<Collection>  # the collection the registry opened (empty: the default)

pub struct CollectionRegistry
    pool: *BufferPool
    storage: *Storage       # null in --in-memory mode
    entries: Vec<RegistryEntry>   # up to MAX_COLLECTIONS, the default first
    count: i32

fn entry_at(reg: *CollectionRegistry, i: i32) -> *RegistryEntry
    return reg.entries.get_ptr(i as i64)

fn entry_is(e: *RegistryEntry, name: *u8, len: i32) -> i32
    if e.name_len != len
        return 0
    var i: i32 = 0
    while i < len
        if e.name[i] != *(name + i)
            return 0
        i += 1
    return 1

# An entry for name[0..len) and `col`, owning `owned` (empty: not owned).
fn entry_new(name: *u8, len: i32, col: *Collection, owned: Box<Collection>) -> RegistryEntry
    var e: RegistryEntry = RegistryEntry { name_len: len, name: [0; 64], col: col, owned: owned }
    var i: i32 = 0
    while i < len and i < 64
        e.name[i] = *(name + i)
        i += 1
    return e

# A registry whose first entry is `default_col`, which the caller owns. The
# registry is a value: dropping it closes and frees the collections it opened.
pub fn registry_new(pool: *BufferPool, storage: *Storage, default_col: *Collection) -> CollectionRegistry
    var entries: Vec<RegistryEntry> = vec_with_cap<RegistryEntry>(MAX_COLLECTIONS as i64)
    var count: i32 = 0
    if pool != null and default_col != null
        if entries.push(entry_new(DEFAULT_COLLECTION_NAME.ptr, DEFAULT_COLLECTION_NAME.len as i32, default_col, box_empty<Collection>()))
            count = 1
    return CollectionRegistry { pool: pool, storage: storage, entries: entries, count: count }

pub fn registry_default(reg: *CollectionRegistry) -> *Collection
    if reg == null or reg.count < 1
        return null
    return entry_at(reg, 0).col

pub fn registry_count(reg: *CollectionRegistry) -> i32
    if reg == null
        return 0
    return reg.count

pub fn registry_bind(reg: *CollectionRegistry, name: *u8, len: i32) -> *Collection
    if reg == null or len < 0 or len > MAX_COLLECTION_NAME
        return null
    if len == 0 or name == null
        return registry_default(reg)

    var i: i32 = 0
    while i < reg.count
        let e: *RegistryEntry = entry_at(reg, i)
        if entry_is(e, name, len) == 1
            return e.col
        i += 1
    if reg.count >= MAX_COLLECTIONS
        return null

    var owned: Box<Collection> = box_new<Collection>(collection_empty())
    let col: *Collection = owned.as_ptr()
    if col == null
        return null
    var rc: i32 = ERR_OK
    if reg.storage != null
        rc = collection_open_named(col, reg.storage, name, len)
    else
        # In memory: ids follow the default collection's.
        rc = collection_init(col, reg.pool, DEFAULT_COLLECTION_ID + reg.count)
    if rc != ERR_OK
        return null
    if not reg.entries.push(entry_new(name, len, col, owned))
        return null
    reg.count += 1
    return col

# Close every collection the registry opened (their memory goes when the
# registry drops).
pub fn registry_destroy(reg: *CollectionRegistry)
    if reg == null
        return
    var i: i32 = 0
    while i < reg.count
        let e: *RegistryEntry = entry_at(reg, i)
        if e.owned.valid()
            collection_destroy(e.col)
        i += 1
