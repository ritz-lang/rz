# lib/client.ritz - Mausoleum database client
#
# Client library for connecting to a mausoleum server.
# Provides a simple synchronous API for database operations.

import ritzlib.sys
import ritzlib.str
import ritzlib.memory
import ritzlib.net

import mausoleum.protocol
import mausoleum.encrypted_channel { EncryptedChannel }
import mausoleum.encrypted_channel { channel_init_client, channel_handshake_client }
import mausoleum.encrypted_channel { channel_send, channel_recv, channel_free }

# ============================================================================
# Client Constants
# ============================================================================

const CLIENT_BUFFER_SIZE: i32 = 65536  # 64 KB buffer

# ============================================================================
# Client structure
# ============================================================================

struct Client
    sock: Socket              # TCP socket (used directly only when encrypted == 0;
                              # in encrypted mode the channel owns its own copy of
                              # the same fd, see client_connect_encrypted)
    connected: i32            # Connection state (1 = connected)
    session_id: i64           # Server-assigned session ID
    next_request_id: i32      # Next request ID
    send_buf: *MessageBuffer  # Send buffer
    recv_buf: *u8             # Receive buffer
    recv_len: i32             # Bytes in receive buffer (plaintext path only)
    last_error: i32           # Last error code
    txn_active: i32           # Transaction active flag

    # Encryption state.  When `encrypted == 1`, send_message/recv_message
    # route through `channel` (X25519 + ChaCha20-Poly1305 framing).  In
    # plaintext mode the EncryptedChannel struct exists in memory but is
    # never touched.  `client_connect_encrypted` sets the flag and
    # initializes the channel; `client_connect` (plaintext) leaves them
    # untouched.
    encrypted: i32
    channel: EncryptedChannel

# ============================================================================
# Internal helpers
# ============================================================================

# Read a little-endian i32 from buffer
fn read_i32(buf: *u8) -> i32
    let b0: i32 = (*buf) as i32
    let b1: i32 = (*(buf + 1)) as i32
    let b2: i32 = (*(buf + 2)) as i32
    let b3: i32 = (*(buf + 3)) as i32
    return b0 | (b1 << 8) | (b2 << 16) | (b3 << 24)

# Read a little-endian i64 from buffer
fn read_i64(buf: *u8) -> i64
    let lo: i64 = read_i32(buf) as i64 & 0xFFFFFFFF
    let hi: i64 = read_i32(buf + 4) as i64 & 0xFFFFFFFF
    return lo | (hi << 32)

# ============================================================================
# Client API
# ============================================================================

# Create a new client
pub fn client_new() -> *Client
    var client: *Client = malloc(sizeof(Client)) as *Client
    if client == null
        return null

    client.sock.fd = -1
    client.sock.family = AF_INET
    client.sock.socktype = SOCK_STREAM
    client.connected = 0
    client.session_id = 0
    client.next_request_id = 1
    client.send_buf = msgbuf_new(CLIENT_BUFFER_SIZE)
    if client.send_buf == null
        free(client as *u8)
        return null
    client.recv_buf = malloc(CLIENT_BUFFER_SIZE as i64) as *u8
    if client.recv_buf == null
        msgbuf_free(client.send_buf)
        free(client as *u8)
        return null
    client.recv_len = 0
    client.last_error = PROTO_OK
    client.txn_active = 0

    # Encryption defaults to off.  client_connect leaves it that way;
    # client_connect_encrypted flips the flag after a successful X25519
    # handshake.  We DON'T zero the EncryptedChannel here — channel_init_*
    # populates every field on entry, so the previous bytes don't matter.
    client.encrypted = 0

    return client

# Free client resources.  client_disconnect already tears down the
# encrypted channel + socket on its way out (so a connected client gets
# clean shutdown).  This function additionally handles two edge cases:
# (1) caller created a client but never connected — channel is still
# uninitialized, nothing to free; (2) caller called client_connect_
# encrypted but the handshake failed mid-way — the channel may be
# partially initialized (recv_buf allocated, keys generated) without
# `connected` ever flipping to 1, so we need to release the channel's
# heap allocation.  In that path channel_init_client always cleared
# client.sock.fd to -1 on failure so socket_close is a no-op.
pub fn client_free(client: *Client)
    if client == null
        return

    if client.connected != 0
        client_disconnect(client)
    else if client.encrypted != 0
        # Failed handshake left a half-initialized channel — free it so
        # the recv buffer doesn't leak.
        channel_free(@client.channel)
        client.encrypted = 0

    if client.send_buf != null
        msgbuf_free(client.send_buf)
    if client.recv_buf != null
        free(client.recv_buf)

    free(client as *u8)

# ============================================================================
# Connection management
# ============================================================================

# Default connect timeout in milliseconds.  Anything larger than this is
# almost certainly a network problem and the caller would rather fail fast
# than block.  Tuned for "nexus startup probes mausoleum at 127.0.0.1" —
# that should resolve in a few ms; if it doesn't, mausoleum is broken.
const DEFAULT_CONNECT_TIMEOUT_MS: i32 = 5000

# Connect to a server (with a 5-second connect timeout)
pub fn client_connect(client: *Client, host: *u8, port: i32, collection: *u8, collection_len: i32) -> i32
    if client == null
        return -1
    if client.connected != 0
        return -2  # Already connected

    # Create socket
    client.sock = socket_tcp()
    if client.sock.fd < 0
        client.last_error = PROTO_ERR_DISCONNECTED
        return -3

    # Set TCP_NODELAY
    socket_set_nodelay(@client.sock)

    # Connect to server with a bounded timeout.  Falls into one of:
    #   0 = success
    #  -2 = timeout
    #  -3 = ECONNREFUSED / unreachable / RST
    #  -1 = syscall error
    let result: i32 = socket_connect_timeout(@client.sock, host, port, DEFAULT_CONNECT_TIMEOUT_MS)
    if result < 0
        socket_close(@client.sock)
        client.sock.fd = -1
        client.last_error = PROTO_ERR_DISCONNECTED
        return -4

    # The connect itself succeeded but a misbehaving peer (e.g. a process
    # that accepts but never responds) would still cause the *protocol*
    # handshake below to block forever in recv_message.  Bound recv/send
    # via SO_RCVTIMEO / SO_SNDTIMEO too so the whole client_connect call
    # is wall-clock-bounded.
    socket_set_io_timeout(@client.sock, DEFAULT_CONNECT_TIMEOUT_MS)

    # Send CONNECT message
    let req_id: i32 = client.next_request_id
    client.next_request_id += 1
    build_connect(client.send_buf, req_id, collection, collection_len)

    let send_result: i32 = send_message(client)
    if send_result < 0
        socket_close(@client.sock)
        client.sock.fd = -1
        client.last_error = PROTO_ERR_DISCONNECTED
        return -5

    # Receive response
    var reader: MessageReader
    let recv_result: i32 = recv_message(client, @reader)
    if recv_result < 0
        socket_close(@client.sock)
        client.sock.fd = -1
        client.last_error = PROTO_ERR_DISCONNECTED
        return -6

    # Check response
    let msg_type: i32 = msgreader_msg_type(@reader)
    if msg_type == MSG_ERROR
        let error_code: i32 = msgreader_read_i32(@reader)
        client.last_error = error_code
        socket_close(@client.sock)
        client.sock.fd = -1
        return -7

    if msg_type != MSG_CONNECTED
        client.last_error = PROTO_ERR_PROTOCOL
        socket_close(@client.sock)
        client.sock.fd = -1
        return -8

    client.session_id = msgreader_read_i64(@reader)
    client.connected = 1
    client.last_error = PROTO_OK
    # Handshake done — clear the recv/send timeouts so subsequent
    # operations (which may legitimately be long-running, e.g. big
    # scans) aren't constrained to the connect timeout.
    socket_set_io_timeout(@client.sock, 0)
    return 0

# Connect to an encrypted server.  Mirrors client_connect except for the
# X25519 + ChaCha20-Poly1305 handshake before the protocol-level CONNECT.
#
# Wire-level sequence on a successful encrypted connect:
#
#   1. TCP SYN/SYN-ACK/ACK                          (socket_connect_timeout)
#   2. Client → Server: 32-byte X25519 public key   (channel_handshake_client)
#   3. Server → Client: 32-byte X25519 public key   (channel_handshake_client)
#   4. Both derive HKDF(send/recv) keys             (derive_keys, internal)
#   5. Client → Server: encrypted CONNECT(collection)
#   6. Server → Client: encrypted CONNECTED(session_id)
#
# Steps 5/6 use channel_send / channel_recv (which add the [4 BE len][12
# nonce][ct][16 tag] framing), but build_connect / msgreader_init operate
# on the plaintext payload — exactly the same shape the plain client uses.
# So the protocol layer is identical; only the framing differs.
pub fn client_connect_encrypted(client: *Client, host: *u8, port: i32, collection: *u8, collection_len: i32) -> i32
    if client == null
        return -1
    if client.connected != 0
        return -2  # Already connected

    # Create socket
    client.sock = socket_tcp()
    if client.sock.fd < 0
        client.last_error = PROTO_ERR_DISCONNECTED
        return -3

    socket_set_nodelay(@client.sock)

    let result: i32 = socket_connect_timeout(@client.sock, host, port, DEFAULT_CONNECT_TIMEOUT_MS)
    if result < 0
        socket_close(@client.sock)
        client.sock.fd = -1
        client.last_error = PROTO_ERR_DISCONNECTED
        return -4

    socket_set_io_timeout(@client.sock, DEFAULT_CONNECT_TIMEOUT_MS)

    # Initialize the encrypted channel.  channel_init_client allocates a
    # 64K recv buffer and generates an ephemeral X25519 keypair.  We pass
    # the socket by value — the channel makes its own copy of the fd, but
    # we keep `client.sock` as the canonical record and only ever close
    # the fd once (in client_free / client_disconnect).
    if channel_init_client(@client.channel, client.sock) < 0
        socket_close(@client.sock)
        client.sock.fd = -1
        client.last_error = PROTO_ERR_DISCONNECTED
        return -5

    # Perform handshake: send our pubkey, receive server's, derive keys.
    if channel_handshake_client(@client.channel) < 0
        # channel_free closes the socket — we set client.sock.fd = -1 to
        # avoid a double-close in client_free.
        channel_free(@client.channel)
        client.sock.fd = -1
        client.last_error = PROTO_ERR_DISCONNECTED
        return -6

    # Mark encrypted BEFORE the CONNECT roundtrip so send_message /
    # recv_message route through the channel.
    client.encrypted = 1

    # Send protocol-level CONNECT (encrypted via channel_send)
    let req_id: i32 = client.next_request_id
    client.next_request_id += 1
    build_connect(client.send_buf, req_id, collection, collection_len)

    if send_message(client) < 0
        client.encrypted = 0
        channel_free(@client.channel)
        client.sock.fd = -1
        client.last_error = PROTO_ERR_DISCONNECTED
        return -7

    # Receive CONNECTED (or ERROR) — encrypted, so recv_message reads one
    # full plaintext message from channel_recv and hands it to msgreader.
    var reader: MessageReader
    if recv_message(client, @reader) < 0
        client.encrypted = 0
        channel_free(@client.channel)
        client.sock.fd = -1
        client.last_error = PROTO_ERR_DISCONNECTED
        return -8

    let msg_type: i32 = msgreader_msg_type(@reader)
    if msg_type == MSG_ERROR
        let error_code: i32 = msgreader_read_i32(@reader)
        client.last_error = error_code
        client.encrypted = 0
        channel_free(@client.channel)
        client.sock.fd = -1
        return -9

    if msg_type != MSG_CONNECTED
        client.last_error = PROTO_ERR_PROTOCOL
        client.encrypted = 0
        channel_free(@client.channel)
        client.sock.fd = -1
        return -10

    client.session_id = msgreader_read_i64(@reader)
    client.connected = 1
    client.last_error = PROTO_OK
    # Drop the connect-bound IO timeout for steady-state ops.  Note that
    # socket_set_io_timeout works on the original fd; the channel's
    # internal `ch.sock` shares it, so this lifts the timeout for both.
    socket_set_io_timeout(@client.sock, 0)
    return 0

# Disconnect from server
pub fn client_disconnect(client: *Client) -> i32
    if client == null
        return -1
    if client.connected == 0
        return 0  # Already disconnected

    # Send DISCONNECT message (best effort).  In encrypted mode this
    # routes through channel_send so the server sees a properly-framed
    # encrypted DISCONNECT rather than plaintext bytes that would look
    # like garbage and trigger a protocol-error close.
    let req_id: i32 = client.next_request_id
    client.next_request_id += 1
    msgbuf_start(client.send_buf, MSG_DISCONNECT, req_id)
    msgbuf_finish(client.send_buf)
    send_message(client)

    # Tear down channel + socket.  In encrypted mode, channel_free zeroes
    # the keys and closes the (channel-owned) socket; we then mark
    # client.sock.fd = -1 to keep client_free from trying to close it
    # again.  In plaintext mode we close client.sock directly.
    if client.encrypted != 0
        channel_free(@client.channel)
        client.sock.fd = -1
        client.encrypted = 0
    else
        socket_close(@client.sock)
        client.sock.fd = -1

    client.connected = 0
    client.session_id = 0
    client.txn_active = 0

    return 0

# Check if connected
pub fn client_is_connected(client: *Client) -> i32
    if client == null
        return 0
    return client.connected

# Get session ID
pub fn client_session_id(client: *Client) -> i64
    if client == null
        return 0
    return client.session_id

# Get last error code
pub fn client_last_error(client: *Client) -> i32
    if client == null
        return PROTO_ERR_INTERNAL
    return client.last_error

# ============================================================================
# Internal helpers
# ============================================================================

# Send the message in send_buf.  Routes through the encrypted channel
# when client.encrypted == 1; otherwise raw socket_send loop.
fn send_message(client: *Client) -> i32
    let len: i32 = msgbuf_len(client.send_buf)
    var data: *u8 = msgbuf_data(client.send_buf)

    if client.encrypted != 0
        # channel_send handles framing ([4 BE len][12 nonce][ct][16 tag])
        # and the actual socket_send loop internally; returns the number
        # of plaintext bytes sent on success or a negative CHANNEL_ERR_*.
        let n: i32 = channel_send(@client.channel, data, len)
        if n != len
            return -1
        return 0

    var sent: i32 = 0
    while sent < len
        let n: i64 = socket_send(@client.sock, data + sent, (len - sent) as i64)
        if n <= 0
            return -1
        sent += n as i32

    return 0

# Receive a complete message into reader.  In encrypted mode, channel_recv
# returns one decrypted protocol message in a single call (it reads its
# own length prefix + nonce + ct + tag from the wire, decrypts, and
# delivers the plaintext payload).  Plaintext mode keeps the original
# two-step header-then-body recv with leftover-byte buffering for stream
# decoupling.
fn recv_message(client: *Client, reader: *MessageReader) -> i32
    if client.encrypted != 0
        # One encrypted frame == exactly one protocol message — channel_send
        # always emits a single frame per send_message call, so we never
        # get partial-message stitching here.  The plaintext (decrypted)
        # bytes land in client.recv_buf and are then handed to msgreader.
        let n: i32 = channel_recv(@client.channel, client.recv_buf, CLIENT_BUFFER_SIZE)
        if n <= 0
            return -1
        if n < PROTO_HEADER_SIZE or n > PROTO_MAX_MESSAGE_SIZE
            return -2

        # Sanity-check that the header's encoded message length matches
        # the frame plaintext length.  Catches a misframed peer / bug
        # at the wire layer rather than letting it propagate as a
        # parser failure further in.
        var ptr: *u8 = client.recv_buf
        var msg_len: i32 = (*(ptr + 4) as i32) << 24
        msg_len = msg_len | ((*(ptr + 5) as i32) << 16)
        msg_len = msg_len | ((*(ptr + 6) as i32) << 8)
        msg_len = msg_len | (*(ptr + 7) as i32)
        if msg_len != n
            return -3

        let result: i32 = msgreader_init(reader, client.recv_buf, n)
        if result != PROTO_OK
            return -4

        # Encrypted frames do not produce leftover bytes; no buffer shift.
        client.recv_len = 0
        return 0

    # First receive the header
    while client.recv_len < PROTO_HEADER_SIZE
        let remain: i64 = (CLIENT_BUFFER_SIZE - client.recv_len) as i64
        let n: i64 = socket_recv(@client.sock, client.recv_buf + client.recv_len, remain)
        if n <= 0
            return -1
        client.recv_len += n as i32

    # Parse message length from header
    var ptr: *u8 = client.recv_buf
    var msg_len: i32 = (*(ptr + 4) as i32) << 24
    msg_len = msg_len | ((*(ptr + 5) as i32) << 16)
    msg_len = msg_len | ((*(ptr + 6) as i32) << 8)
    msg_len = msg_len | (*(ptr + 7) as i32)

    if msg_len < PROTO_HEADER_SIZE or msg_len > PROTO_MAX_MESSAGE_SIZE
        return -2

    # Receive rest of message
    while client.recv_len < msg_len
        let remain2: i64 = (CLIENT_BUFFER_SIZE - client.recv_len) as i64
        let n: i64 = socket_recv(@client.sock, client.recv_buf + client.recv_len, remain2)
        if n <= 0
            return -3
        client.recv_len += n as i32

    # Parse message
    let result: i32 = msgreader_init(reader, client.recv_buf, msg_len)
    if result != PROTO_OK
        return -4

    # Shift any remaining data
    let remaining: i32 = client.recv_len - msg_len
    if remaining > 0
        var i: i32 = 0
        while i < remaining
            *(client.recv_buf + i) = *(client.recv_buf + msg_len + i)
            i += 1
    client.recv_len = remaining

    return 0

# ============================================================================
# CRUD operations
# ============================================================================

# Ping the server
pub fn client_ping(client: *Client) -> i32
    if client == null or client.connected == 0
        return -1

    let req_id: i32 = client.next_request_id
    client.next_request_id += 1
    build_ping(client.send_buf, req_id)

    if send_message(client) < 0
        client.connected = 0
        client.last_error = PROTO_ERR_DISCONNECTED
        return -2

    var reader: MessageReader
    if recv_message(client, @reader) < 0
        client.connected = 0
        client.last_error = PROTO_ERR_DISCONNECTED
        return -3

    let msg_type: i32 = msgreader_msg_type(@reader)
    if msg_type != MSG_PONG
        client.last_error = PROTO_ERR_PROTOCOL
        return -4

    client.last_error = PROTO_OK
    return 0

# Insert a document (returns document ID, or < 0 on error)
pub fn client_insert(client: *Client, doc_data: *u8, doc_len: i32) -> i64
    if client == null or client.connected == 0
        return -1

    let req_id: i32 = client.next_request_id
    client.next_request_id += 1
    build_insert(client.send_buf, req_id, doc_data, doc_len)

    if send_message(client) < 0
        client.connected = 0
        client.last_error = PROTO_ERR_DISCONNECTED
        return -2

    var reader: MessageReader
    if recv_message(client, @reader) < 0
        client.connected = 0
        client.last_error = PROTO_ERR_DISCONNECTED
        return -3

    let msg_type: i32 = msgreader_msg_type(@reader)
    if msg_type == MSG_ERROR
        client.last_error = msgreader_read_i32(@reader)
        return -4

    if msg_type != MSG_INSERT_OK
        client.last_error = PROTO_ERR_PROTOCOL
        return -5

    client.last_error = PROTO_OK
    return msgreader_read_i64(@reader)

# Get a document by ID (returns 1 if found, 0 if not found, < 0 on error)
# doc_data and doc_len are output parameters
pub fn client_get(client: *Client, doc_id: i64, doc_data: **u8, doc_len: *i32) -> i32
    if client == null or client.connected == 0
        return -1

    let req_id: i32 = client.next_request_id
    client.next_request_id += 1
    build_get(client.send_buf, req_id, doc_id)

    if send_message(client) < 0
        client.connected = 0
        client.last_error = PROTO_ERR_DISCONNECTED
        return -2

    var reader: MessageReader
    if recv_message(client, @reader) < 0
        client.connected = 0
        client.last_error = PROTO_ERR_DISCONNECTED
        return -3

    let msg_type: i32 = msgreader_msg_type(@reader)
    if msg_type == MSG_ERROR
        let error_code: i32 = msgreader_read_i32(@reader)
        client.last_error = error_code
        if error_code == PROTO_ERR_NOT_FOUND
            return 0  # Not found
        return -4

    if msg_type != MSG_GET_OK
        client.last_error = PROTO_ERR_PROTOCOL
        return -5

    # Read document data
    var len: i32 = 0
    var data: *u8 = msgreader_read_bytes(@reader, @len)
    *doc_data = data
    *doc_len = len

    client.last_error = PROTO_OK
    return 1

# Delete a document by ID (returns 1 if deleted, 0 if not found, < 0 on error)
pub fn client_delete(client: *Client, doc_id: i64) -> i32
    if client == null or client.connected == 0
        return -1

    let req_id: i32 = client.next_request_id
    client.next_request_id += 1
    build_delete(client.send_buf, req_id, doc_id)

    if send_message(client) < 0
        client.connected = 0
        client.last_error = PROTO_ERR_DISCONNECTED
        return -2

    var reader: MessageReader
    if recv_message(client, @reader) < 0
        client.connected = 0
        client.last_error = PROTO_ERR_DISCONNECTED
        return -3

    let msg_type: i32 = msgreader_msg_type(@reader)
    if msg_type == MSG_ERROR
        let error_code: i32 = msgreader_read_i32(@reader)
        client.last_error = error_code
        if error_code == PROTO_ERR_NOT_FOUND
            return 0  # Not found
        return -4

    if msg_type != MSG_DELETE_OK
        client.last_error = PROTO_ERR_PROTOCOL
        return -5

    client.last_error = PROTO_OK
    return 1

# ============================================================================
# Transaction operations
# ============================================================================

# Begin a transaction
pub fn client_begin_txn(client: *Client) -> i64
    if client == null or client.connected == 0
        return -1

    if client.txn_active != 0
        client.last_error = PROTO_ERR_TXN_CONFLICT
        return -2  # Already in transaction

    let req_id: i32 = client.next_request_id
    client.next_request_id += 1
    build_txn_begin(client.send_buf, req_id)

    if send_message(client) < 0
        client.connected = 0
        client.last_error = PROTO_ERR_DISCONNECTED
        return -3

    var reader: MessageReader
    if recv_message(client, @reader) < 0
        client.connected = 0
        client.last_error = PROTO_ERR_DISCONNECTED
        return -4

    let msg_type: i32 = msgreader_msg_type(@reader)
    if msg_type == MSG_ERROR
        client.last_error = msgreader_read_i32(@reader)
        return -5

    if msg_type != MSG_TXN_BEGUN
        client.last_error = PROTO_ERR_PROTOCOL
        return -6

    client.txn_active = 1
    client.last_error = PROTO_OK
    return msgreader_read_i64(@reader)

# Commit the current transaction
pub fn client_commit_txn(client: *Client) -> i32
    if client == null or client.connected == 0
        return -1

    if client.txn_active == 0
        client.last_error = PROTO_ERR_TXN_NOT_ACTIVE
        return -2

    let req_id: i32 = client.next_request_id
    client.next_request_id += 1
    build_txn_commit(client.send_buf, req_id)

    if send_message(client) < 0
        client.connected = 0
        client.last_error = PROTO_ERR_DISCONNECTED
        return -3

    var reader: MessageReader
    if recv_message(client, @reader) < 0
        client.connected = 0
        client.last_error = PROTO_ERR_DISCONNECTED
        return -4

    let msg_type: i32 = msgreader_msg_type(@reader)
    if msg_type == MSG_ERROR
        client.last_error = msgreader_read_i32(@reader)
        return -5

    if msg_type != MSG_TXN_COMMITTED
        client.last_error = PROTO_ERR_PROTOCOL
        return -6

    client.txn_active = 0
    client.last_error = PROTO_OK
    return 0

# Abort the current transaction
pub fn client_abort_txn(client: *Client) -> i32
    if client == null or client.connected == 0
        return -1

    if client.txn_active == 0
        client.last_error = PROTO_ERR_TXN_NOT_ACTIVE
        return -2

    let req_id: i32 = client.next_request_id
    client.next_request_id += 1
    build_txn_abort(client.send_buf, req_id)

    if send_message(client) < 0
        client.connected = 0
        client.last_error = PROTO_ERR_DISCONNECTED
        return -3

    var reader: MessageReader
    if recv_message(client, @reader) < 0
        client.connected = 0
        client.last_error = PROTO_ERR_DISCONNECTED
        return -4

    let msg_type: i32 = msgreader_msg_type(@reader)
    if msg_type == MSG_ERROR
        client.last_error = msgreader_read_i32(@reader)
        return -5

    if msg_type != MSG_TXN_ABORTED
        client.last_error = PROTO_ERR_PROTOCOL
        return -6

    client.txn_active = 0
    client.last_error = PROTO_OK
    return 0

# Check if a transaction is active
pub fn client_has_txn(client: *Client) -> i32
    if client == null
        return 0
    return client.txn_active

# ============================================================================
# Scan API
# ============================================================================

# Scan all documents with a callback
# callback signature: fn(doc_id: i64, data: *u8, len: i32, user_data: *u8) -> i32
#   Return 0 to continue, non-zero to stop
# Returns number of documents scanned, or < 0 on error
pub fn client_scan(client: *Client, callback: *u8, user_data: *u8) -> i32
    if client == null or client.connected == 0
        return -1

    let req_id: i32 = client.next_request_id
    client.next_request_id = client.next_request_id + 1

    # Build scan request (0 = no limit)
    build_scan(client.send_buf, req_id, 0)

    if send_message(client) < 0
        client.connected = 0
        client.last_error = PROTO_ERR_DISCONNECTED
        return -2

    # Process responses - loop until SCAN_END or error
    var count: i32 = 0
    var done: i32 = 0

    while done == 0
        var reader: MessageReader
        if recv_message(client, @reader) < 0
            client.connected = 0
            client.last_error = PROTO_ERR_DISCONNECTED
            return -3

        let msg_type: i32 = msgreader_msg_type(@reader)

        if msg_type == MSG_ERROR
            let error_code: i32 = msgreader_read_i32(@reader)
            client.last_error = error_code
            return -4

        if msg_type == MSG_SCAN_END
            # Scan completed — server always sends this as the final
            # message of a scan, even after a SCAN_RESULT with has_more=0.
            # We MUST drain it from the stream or it'll show up as the
            # response to the next request.
            done = 1
        else if msg_type == MSG_SCAN_RESULT
            # Process batch of documents
            # Format: [4 bytes] doc_count, [4 bytes] has_more
            # For each doc: [8 bytes] doc_id, [4 bytes] len, [len bytes] data
            let doc_count: i32 = msgreader_read_i32(@reader)
            let has_more: i32 = msgreader_read_i32(@reader)

            var user_stopped: i32 = 0
            for i in 0..doc_count
                let doc_id: i64 = msgreader_read_i64(@reader)
                var data_len: i32 = 0
                let data: *u8 = msgreader_read_bytes(@reader, @data_len)

                # Call user callback.  IMPORTANT: cast to `fn(...)` (the
                # function-value type), NOT `*fn(...)` (pointer-to-fn).
                # The previous code cast `*u8` → `*fn(...)` then did `(*cb)(...)`,
                # which the emitter compiles as "load a function pointer FROM the
                # 8 bytes at the function's entry point and call THAT."  For tiny
                # callbacks the loaded bytes occasionally formed a value that
                # didn't crash on call (the test for phase 4 was nexus-driven
                # and happened to land in a survivable spot), but with longer
                # batches the loaded address is consistently bad and segfaults.
                let cb: fn(i64, *u8, i32, *u8) -> i32 = callback as fn(i64, *u8, i32, *u8) -> i32
                let result: i32 = cb(doc_id, data, data_len, user_data)
                count = count + 1

                if result != 0
                    # User requested stop — but we still have to drain
                    # SCAN_END from the stream below before returning.
                    user_stopped = 1
                    break

            # Don't terminate the loop on has_more=0 alone.  The server
            # always emits a trailing SCAN_END, and short-circuiting here
            # leaves it in the socket's recv buffer where it gets mis-
            # parsed as the response to the *next* request.  Keep
            # looping until we see SCAN_END explicitly.
        else
            client.last_error = PROTO_ERR_PROTOCOL
            return -5

    client.last_error = PROTO_OK
    return count
