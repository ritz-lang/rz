# lib/session_kdf.ritz - mausoleum-v1 session-key derivation
#
# The one KDF both ends of an encrypted mausoleum connection run:
#   OKM = HKDF-SHA256(salt="", IKM=x25519 shared secret, info="mausoleum-v1")
# The first 32 bytes are the server's send key (the client's recv key), the
# second 32 the server's recv key (the client's send key).
#
# Used by encrypted_channel.ritz (derive_keys) and server_async.ritz
# (cipher_derive_session_keys), so the two cannot drift apart.

import cryptosec.crypto_error
import cryptosec.hkdf
import ritzlib.memory { secure_zero }

# Bytes of OKM a session needs: send key + recv key.
pub const SESSION_KDF_OKM_LEN: u64 = 64

# Derive okm_len bytes of session keying material from a 32-byte shared
# secret into okm.
#
# Returns 0, or -1 when hkdf_expand refuses okm_len (#2763): okm is then
# left untouched, and the caller must not use it.
pub fn session_kdf_derive(shared: *u8, okm: *u8, okm_len: u64) -> i32
    var prk: [32]u8
    var salt: [1]u8
    salt[0] = 0
    hkdf_extract(@salt[0], 0, shared, 32, @prk[0])

    var info: [12]u8
    info[0] = 109   # 'm'
    info[1] = 97    # 'a'
    info[2] = 117   # 'u'
    info[3] = 115   # 's'
    info[4] = 111   # 'o'
    info[5] = 108   # 'l'
    info[6] = 101   # 'e'
    info[7] = 117   # 'u'
    info[8] = 109   # 'm'
    info[9] = 45    # '-'
    info[10] = 118  # 'v'
    info[11] = 49   # '1'

    var rc: i32 = 0
    match hkdf_expand(@prk[0], @info[0], 12, okm, okm_len)
        Ok(_) => pass
        Err(_) =>
            rc = -1

    secure_zero(@prk[0], 32)
    return rc
