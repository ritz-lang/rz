# Harland Init Process
#
# First userspace process (PID 1).
# Runs explicit test cases and reports pass/fail, then triggers ACPI shutdown.
#
# This is a test harness - when the kernel is decoupled from the distribution,
# this will move to the test suite rather than being the actual init process.
# Runtime _start calls main() and then sys_exit(return_value).

import libharland { print_str, print_int }
import ritzlib.str { strlen }
import ritzlib.fmt { fmt_i64_into }
import ritzlib.sys { sys_getpid, sys_yield, sys_spawn, sys_spawn_args, sys_wait, sys_read, sys_mmap, sys_munmap, PROT_READ, PROT_WRITE, MAP_PRIVATE, MAP_ANONYMOUS, sys_input_poll, sys_input_read, sys_open, sys_close, O_RDONLY }

# ============================================================================
# Test Infrastructure
# ============================================================================

var g_passed: i32 = 0
var g_failed: i32 = 0

# Run a test binary and check its exit code
fn run_test(path: *u8, name: *u8, expected: i32) -> i32
    print_str(c"[test] ")
    print_str(name)
    print_str(c" ... ")

    let pid: i64 = sys_spawn(path)
    if pid <= 0
        print_str(c"FAIL (spawn error)\n")
        g_failed = g_failed + 1
        return 1

    let exit_code: i64 = sys_wait(pid as i32)
    let actual: i32 = exit_code as i32

    if actual == expected
        print_str(c"PASS (exit=")
        print_int(actual)
        print_str(c")\n")
        g_passed = g_passed + 1
        return 0
    else
        print_str(c"FAIL (expected ")
        print_int(expected)
        print_str(c", got ")
        print_int(actual)
        print_str(c")\n")
        g_failed = g_failed + 1
        return 1

# Run a test binary with arguments
fn run_test_args(path: *u8, name: *u8, argv: **u8, argc: i32, expected: i32) -> i32
    print_str(c"[test] ")
    print_str(name)
    print_str(c" ... ")

    let pid: i64 = sys_spawn_args(path, argv, argc)
    if pid <= 0
        print_str(c"FAIL (spawn error)\n")
        g_failed = g_failed + 1
        return 1

    let exit_code: i64 = sys_wait(pid as i32)
    let actual: i32 = exit_code as i32

    if actual == expected
        print_str(c"PASS (exit=")
        print_int(actual)
        print_str(c")\n")
        g_passed = g_passed + 1
        return 0
    else
        print_str(c"FAIL (expected ")
        print_int(expected)
        print_str(c", got ")
        print_int(actual)
        print_str(c")\n")
        g_failed = g_failed + 1
        return 1

# fd isolation (AGAST #2753). init is the parent: a spawned process can't
# spawn yet (the blocking spawn keeps one saved parent frame), so this runs
# in init rather than as its own /bin test. init holds /etc/motd as fd 3;
# the child (/bin/fd_isolation_child) must get its own fd 3 and leaves it
# open. Back here, fd 3 must still read /etc/motd and the next open must be
# 4, and a second run of the child must get fd 3 again: the child's fd did
# not outlive it. Returns 0 on PASS, else a step number.
fn fd_isolation_steps() -> i32
    let fd: i32 = sys_open(c"/etc/motd", O_RDONLY)
    if fd != 3
        if fd >= 0
            sys_close(fd)
        print_str(c"(parent open: fd ")
        print_int(fd as i64)
        print_str(c") ")
        return 1
    let child: i64 = spawn_and_wait(c"/bin/fd_isolation_child")
    var buf: [8]u8
    let n: i64 = sys_read(fd, @buf[0], 7)
    let next: i32 = sys_open(c"/etc/motd", O_RDONLY)
    # The same child again: its fd 3 must be free, not still held by the
    # first one (children all run as pid 2).
    let again: i64 = spawn_and_wait(c"/bin/fd_isolation_child")
    sys_close(fd)
    if next >= 0
        sys_close(next)
    if child != 0
        print_str(c"(child exit ")
        print_int(child)
        print_str(c") ")
        return 2
    # /etc/motd starts "Welcome"
    if n != 7 or buf[0] != 87 or buf[6] != 101
        print_str(c"(parent fd 3 lost /etc/motd) ")
        return 3
    if next != 4
        print_str(c"(parent next open: fd ")
        print_int(next as i64)
        print_str(c") ")
        return 4
    if again != 0
        print_str(c"(second child exit ")
        print_int(again)
        print_str(c") ")
        return 5
    return 0

# Spawn path and return its exit code, or -1000 if it didn't spawn.
fn spawn_and_wait(path: *u8) -> i64
    let pid: i64 = sys_spawn(path)
    if pid <= 0
        return -1000
    return sys_wait(pid as i32)

# mmap isolation (AGAST #3530). init maps MMAP_PAGES pages at a
# kernel-chosen address A and fills them; /bin/mmap_child (argv[1] = A) must
# get A from its own first mmap, see zeroed pages there, overwrite them and
# map a > 2 MiB region. Back here, init's pages at A must still hold init's
# pattern: same user VA, different processes, no aliasing. Returns 0 on
# PASS, else a step number (the child's exit code shows as 10 + code).
const MMAP_PAGES: i64 = 4

fn mmap_word(addr: i64) -> *u64
    return addr as *u64

# Decimal of v into buf (>= 21 bytes), NUL-terminated; returns buf.
fn fmt_dec(v: i64, buf: *u8) -> *u8
    let n: i64 = fmt_i64_into(buf, v)
    *(buf + n) = 0
    return buf

fn mmap_isolation_steps() -> i32
    let p: *u8 = sys_mmap(0, MMAP_PAGES * 4096, PROT_READ | PROT_WRITE, MAP_PRIVATE | MAP_ANONYMOUS)
    let a: i64 = p as i64
    if a <= 0
        print_str(c"(init mmap returned ")
        print_int(a)
        print_str(c") ")
        return 1
    var pg: i64 = 0
    while pg < MMAP_PAGES
        *mmap_word(a + pg * 4096) = 0x1717171700000000 as u64 + pg as u64
        *mmap_word(a + pg * 4096 + 4088) = 0x7171717100000000 as u64 + pg as u64
        pg = pg + 1

    var addr_buf: [24]u8
    var argv: [2]*u8
    argv[0] = c"mmap_child"
    argv[1] = fmt_dec(a, @addr_buf[0])
    let pid: i64 = sys_spawn_args(c"/bin/mmap_child", @argv[0], 2)
    if pid <= 0
        sys_munmap(p, MMAP_PAGES * 4096)
        return 2
    let child: i64 = sys_wait(pid as i32)

    pg = 0
    var intact: bool = true
    while pg < MMAP_PAGES
        if *mmap_word(a + pg * 4096) != 0x1717171700000000 as u64 + pg as u64
            intact = false
        if *mmap_word(a + pg * 4096 + 4088) != 0x7171717100000000 as u64 + pg as u64
            intact = false
        pg = pg + 1
    let unmapped: i32 = sys_munmap(p, MMAP_PAGES * 4096)
    if child != 0
        print_str(c"(child exit ")
        print_int(child)
        print_str(c") ")
        return 10 + child as i32
    if not intact
        print_str(c"(init's pages changed while the child ran) ")
        return 3
    if unmapped != 0
        return 4
    return 0

fn run_mmap_isolation_test() -> i32
    print_str(c"[test] mmap_isolation ... ")
    let step: i32 = mmap_isolation_steps()
    if step == 0
        print_str(c"PASS\n")
        g_passed = g_passed + 1
        return 0
    print_str(c"FAIL (step ")
    print_int(step as i64)
    print_str(c")\n")
    g_failed = g_failed + 1
    return 1

# A failed spawn leaves init's pid alone (AGAST #2762). /etc/motd exists
# but isn't an ELF, so both spawns get past the file lookup and fail in
# elf_load: the path that once left getpid returning the half-made child's
# pid (2). A missing path fails before the pid is touched, so it can't show
# this. Returns 0 on PASS, else a step number.
fn spawn_fail_pid_steps() -> i32
    let before: i32 = sys_getpid()
    if before != 1
        print_str(c"(pid before: ")
        print_int(before as i64)
        print_str(c") ")
        return 1
    let rc: i64 = sys_spawn(c"/etc/motd")
    let after: i32 = sys_getpid()
    if rc >= 0
        print_str(c"(spawn of a non-ELF returned ")
        print_int(rc)
        print_str(c") ")
        return 2
    if after != 1
        print_str(c"(pid after failed spawn: ")
        print_int(after as i64)
        print_str(c") ")
        return 3
    var argv: [2]*u8
    argv[0] = c"motd"
    argv[1] = c"x"
    let rc_args: i64 = sys_spawn_args(c"/etc/motd", @argv[0], 2)
    let after_args: i32 = sys_getpid()
    if rc_args >= 0
        print_str(c"(spawn_args of a non-ELF returned ")
        print_int(rc_args)
        print_str(c") ")
        return 4
    if after_args != 1
        print_str(c"(pid after failed spawn_args: ")
        print_int(after_args as i64)
        print_str(c") ")
        return 5
    return 0

fn run_spawn_fail_pid_test() -> i32
    print_str(c"[test] spawn_fail_pid ... ")
    let step: i32 = spawn_fail_pid_steps()
    if step == 0
        print_str(c"PASS\n")
        g_passed = g_passed + 1
        return 0
    print_str(c"FAIL (step ")
    print_int(step as i64)
    print_str(c")\n")
    g_failed = g_failed + 1
    return 1

fn run_fd_isolation_test() -> i32
    print_str(c"[test] fd_isolation ... ")
    let step: i32 = fd_isolation_steps()
    if step == 0
        print_str(c"PASS\n")
        g_passed = g_passed + 1
        return 0
    print_str(c"FAIL (step ")
    print_int(step as i64)
    print_str(c")\n")
    g_failed = g_failed + 1
    return 1

# ============================================================================
# Syscall Tests
# ============================================================================

fn test_getpid() -> i32
    print_str(c"[init] Testing sys_getpid()... ")
    let pid: i32 = sys_getpid()
    if pid == 1
        print_str(c"PASS (pid=1)\n")
        return 0
    else
        print_str(c"FAIL (expected 1, got ")
        print_int(pid)
        print_str(c")\n")
        return 1

fn test_write() -> i32
    print_str(c"[init] Testing sys_write()... PASS\n")
    return 0

fn test_yield() -> i32
    print_str(c"[init] Testing sys_yield()... ")
    sys_yield()
    print_str(c"PASS\n")
    return 0

# ============================================================================
# Tier 1 Test Suite
# ============================================================================
#
# These are explicit test cases. Each test specifies:
#   - Binary path
#   - Test name (for display)
#   - Expected exit code
#
# To add a new test, just add another run_test() call.

# Read one key event from the virtio-input device (AGAST #3438).
#
# Not counted in the suite: a boot without a keyboard, or with one nobody
# types on, skips. tools/test_tier1_boot.sh attaches virtio-keyboard-pci,
# injects `sendkey a` through the QEMU monitor as soon as the kernel logs
# "[OK] VirtIO input device", and asserts both the kernel's
# "[virtio-input] event" line and this test's "key event" line.
const INPUT_ERRNO_NODEV: i32 = -19
const EV_KEY: u16 = 1
# Poll rounds (input_read + yield) before giving up on a key. The key is
# normally queued long before the suite gets here.
const INPUT_WAIT_ROUNDS: i32 = 200000

fn run_input_check()
    print_str(c"[test] input ... ")
    var ev: [8]u8
    var round: i32 = 0
    while round < INPUT_WAIT_ROUNDS
        let rc: i32 = sys_input_read(@ev[0])
        if rc == INPUT_ERRNO_NODEV
            print_str(c"skipped (no input device)\n")
            return
        if rc == 0
            let ev_type: u16 = (ev[0] as u16) | ((ev[1] as u16) << 8)
            let code: u16 = (ev[2] as u16) | ((ev[3] as u16) << 8)
            if ev_type == EV_KEY
                print_str(c"key event code=")
                print_int(code as i64)
                print_str(c" value=")
                print_int(ev[4] as i64)
                print_str(c"\n")
                return
            continue
        sys_yield()
        round = round + 1
    print_str(c"skipped (no key event)\n")

fn run_tier1_tests() -> i32
    print_str(c"\n")
    print_str(c"========================================\n")
    print_str(c"  Running Tier 1 Test Suite\n")
    print_str(c"========================================\n")

    # Reset counters
    g_passed = 0
    g_failed = 0

    # First, while init is still pid 1 with no child waiting to be reaped.
    run_spawn_fail_pid_test()

    # Basic tests - no arguments needed
    run_test(c"/bin/hello",       c"hello",       0)
    run_test(c"/bin/true",        c"true",        0)
    run_test(c"/bin/false",       c"false",       1)
    run_test(c"/bin/exitcode",    c"exitcode",   42)
    run_test(c"/bin/hello_tier1", c"hello_tier1", 0)
    run_test(c"/bin/seq10",       c"seq10",       0)
    run_test(c"/bin/cat_motd",    c"cat_motd",    0)
    run_test(c"/bin/hello_gfx",   c"hello_gfx",   0)
    run_test(c"/bin/cwd_test",    c"cwd_test",    0)
    run_test(c"/bin/fd_table_test",  c"fd_table_test",  0)
    run_test(c"/bin/pid_child_test", c"pid_child_test", 0)
    run_fd_isolation_test()
    run_mmap_isolation_test()
    # malloc/Vec/String with RAM exhausted: null and -1, never a write through
    # a failed mmap's -errno or null (AGAST #3551).
    run_test(c"/bin/malloc_fail_child", c"malloc_fail", 0)
    # Syscalls deep enough to have overrun the old 4 KiB syscall stack,
    # growing the kernel heap under a child CR3 (AGAST #2761).
    run_test(c"/bin/heap_grow_child", c"heap_grow", 0)
    # readdir of a 64-entry dir and 100 opens: frames that overran the old
    # syscall stack, now with a guard page under it (AGAST #1877).
    run_test(c"/bin/readdir64_child", c"readdir64", 0)

    # A ring-3 page fault kills only the child: exit 128 + 14 (#2755).
    run_test(c"/bin/fault_child",  c"fault_child",  142)

    # Test rzsh --help (non-interactive)
    var rzsh_argv: [2]*u8
    rzsh_argv[0] = c"rzsh"
    rzsh_argv[1] = c"--help"
    run_test_args(c"/bin/rzsh", c"rzsh --help", @rzsh_argv[0], 2, 0)

    # rzsh parses, sets and expands variables (AGAST #3459): its token and
    # variable tables are Vecs, so this is rzsh's first user mmap; the line
    # is #3530's repro, which once panicked the kernel. Exit 7 only if $N
    # expanded.
    var rzsh_c_argv: [3]*u8
    rzsh_c_argv[0] = c"rzsh"
    rzsh_c_argv[1] = c"-c"
    rzsh_c_argv[2] = c"X=hello ; echo $X world ; N=7 ; exit $N"
    run_test_args(c"/bin/rzsh", c"rzsh -c vars", @rzsh_c_argv[0], 3, 7)

    # A `pub fn main(args: Span<StrView>, env: Span<StrView>)` (AGAST
    # #4019): the adapter's Linux-shaped mmap builds the views on Harland,
    # and _start calls main 16-aligned. Each failure has its own exit code.
    var span_argv: [3]*u8
    span_argv[0] = c"span_args"
    span_argv[1] = c"alpha"
    span_argv[2] = c"beta-gamma"
    run_test_args(c"/bin/span_args", c"span_args", @span_argv[0], 3, 0)

    run_input_check()

    # Print summary
    print_str(c"\n")
    print_str(c"----------------------------------------\n")
    print_str(c"  Results: ")
    print_int(g_passed)
    print_str(c" passed, ")
    print_int(g_failed)
    print_str(c" failed\n")
    print_str(c"----------------------------------------\n")

    return g_failed

# ============================================================================
# Main entry point
# ============================================================================

pub fn main() -> i32
    print_str(c"\n")
    print_str(c"========================================\n")
    print_str(c"  Harland Init Process (PID 1)\n")
    print_str(c"========================================\n")
    print_str(c"\n")
    print_str(c"Running syscall tests...\n")
    print_str(c"\n")

    var failed: i32 = 0

    # Run basic syscall tests
    failed = failed + test_write()
    failed = failed + test_getpid()
    failed = failed + test_yield()

    # Run tier 1 test suite
    let tier1_failed: i32 = run_tier1_tests()
    failed = failed + tier1_failed

    print_str(c"\n")

    if failed == 0
        print_str(c"========================================\n")
        print_str(c"  ALL TESTS PASSED\n")
        print_str(c"========================================\n")
        print_str(c"\n")
        # init's exit is the power-off: the kernel's exit path flushes init's
        # fds and powers off through ACPI, with either status (#2755).
        return 0
    else
        print_str(c"========================================\n")
        print_str(c"  TESTS FAILED: ")
        print_int(failed)
        print_str(c"\n")
        print_str(c"========================================\n")
        return 1
