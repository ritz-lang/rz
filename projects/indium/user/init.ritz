# Harland Init Process
#
# First userspace process (PID 1).
# Runs explicit test cases and reports pass/fail, then triggers ACPI shutdown.
#
# This is a test harness - when the kernel is decoupled from the distribution,
# this will move to the test suite rather than being the actual init process.
# Runtime _start calls main() and then sys_exit(return_value).

import ritzlib.fmt.digits { fmt_i64_into }
import ritzlib.sys { sys_getpid, sys_yield, sys_spawn, sys_spawn_args, sys_spawn_bg, sys_wait, sys_read, sys_write, sys_mmap, sys_munmap, PROT_READ, PROT_WRITE, MAP_PRIVATE, MAP_ANONYMOUS, sys_input_poll, sys_input_read, sys_open, sys_close, O_RDONLY, O_WRONLY, O_CREAT, O_TRUNC, sys_getcwd, sys_sync }
import ritzlib.string { String, string_new }
import ritzlib.gvec { Vec, vec_new }
import ritzlib.span { Span, span_from_ptr }
import net_attach { net_service_up }

# ============================================================================
# Test Infrastructure
# ============================================================================

var g_passed: i32 = 0
var g_failed: i32 = 0

# Run a test binary and check its exit code. `path` is a StrView (AGAST
# #4694): sys_spawn's *u8 slot is a C-interop boundary, not something a
# caller should hand-NUL-terminate, so the owned, NUL-terminated String is
# built right here instead (S-TEXT-1), not in a fixed-size stack buffer a
# longer literal could overflow. The spawn+wait itself delegates to
# spawn_and_wait (AGAST #4830) rather than repeating it.
fn run_test(path: StrView, name: StrView, expected: i32) -> i32
    print("[test] {name} ... ")

    var path_s: String = String.from(path)
    let exit_code: i64 = spawn_and_wait(path_s.as_ptr())
    if exit_code == SPAWN_FAILED
        print("FAIL (spawn error)\n")
        g_failed = g_failed + 1
        return 1
    let actual: i32 = exit_code as i32

    if actual == expected
        print("PASS (exit={actual})\n")
        g_passed = g_passed + 1
        return 0
    else
        print("FAIL (expected {expected}, got {actual})\n")
        g_failed = g_failed + 1
        return 1

# Run a test binary with arguments. `path`/`args` are StrViews (AGAST #4694);
# sys_spawn_args' *u8/**u8 slots are the C-interop boundary, so the owned,
# NUL-terminated path and argv are built right here (S-TEXT-1). `args`'
# entries are concatenated into one owned `buf` (rzsh's envp_build pattern):
# `buf` can reallocate as entries are appended, so the `ptrs` pointers into
# it are taken only once `buf` is complete.
fn run_test_args(path: StrView, name: StrView, args: Span<StrView>, expected: i32) -> i32
    print("[test] {name} ... ")

    var path_s: String = String.from(path)
    var buf: String = string_new()
    var starts: Vec<i64> = vec_new<i64>()
    var i: i64 = 0
    while i < args.len
        starts.push(buf.len())
        buf.push_str(args.get(i))
        buf.push(0)
        i += 1
    var ptrs: Vec<*u8> = vec_new<*u8>()
    let base: *u8 = buf.as_ptr()
    var k: i64 = 0
    while k < starts.len
        ptrs.push(base + starts.get(k))
        k += 1

    let pid: i64 = sys_spawn_args(path_s.as_ptr(), ptrs.as_ptr(), args.len as i32)
    if pid <= 0
        print("FAIL (spawn error)\n")
        g_failed = g_failed + 1
        return 1

    let exit_code: i64 = sys_wait(pid as i32)
    let actual: i32 = exit_code as i32

    if actual == expected
        print("PASS (exit={actual})\n")
        g_passed = g_passed + 1
        return 0
    else
        print("FAIL (expected {expected}, got {actual})\n")
        g_failed = g_failed + 1
        return 1

# fd isolation (AGAST #2753). init is the parent, so this runs in init
# rather than as its own /bin test. init holds /etc/motd as fd 3;
# the child (/bin/fd_isolation_child) must get its own fd 3 and leaves it
# open. Back here, fd 3 must still read /etc/motd and the next open must be
# 4, and a second run of the child must get fd 3 again: the child's fd did
# not outlive it. Returns 0 on PASS, else a step number.
fn fd_isolation_steps() -> i32
    let fd: i32 = sys_open(c"/etc/motd", O_RDONLY)
    if fd != 3
        if fd >= 0
            sys_close(fd)
        print("(parent open: fd {fd}) ")
        return 1
    let child: i64 = spawn_and_wait(c"/bin/fd_isolation_child")
    var buf: [8]u8
    let n: i64 = sys_read(fd, @buf[0], 7)
    let next: i32 = sys_open(c"/etc/motd", O_RDONLY)
    # The same child again: its fd 3 must be free, not still held by the
    # first one.
    let again: i64 = spawn_and_wait(c"/bin/fd_isolation_child")
    sys_close(fd)
    if next >= 0
        sys_close(next)
    if child != 0
        print("(child exit {child}) ")
        return 2
    # /etc/motd starts "Welcome"
    if n != 7 or buf[0] != 87 or buf[6] != 101
        print("(parent fd 3 lost /etc/motd) ")
        return 3
    if next != 4
        print("(parent next open: fd {next}) ")
        return 4
    if again != 0
        print("(second child exit {again}) ")
        return 5
    return 0

# Nested spawn (AGAST #1882): init -> rzsh -> script -> command. rzsh
# changes directory, then runs a script (`rzsh -c`) that runs /bin/exitcode
# and exits with its status; rzsh exits with the script's. 42 back here
# means each level resumed after its child exited and read the child's real
# status: with one saved parent frame, the script's spawn overwrote rzsh's.
# Then init's cwd must still be "/" (a child's cd is its own) and the child
# is reaped exactly once. Returns 0 on PASS, else a step number.
fn nested_spawn_steps() -> i32
    var argv: [3]*u8
    argv[0] = c"rzsh"
    argv[1] = c"-c"
    argv[2] = c"cd /etc ; rzsh -c 'exitcode ; exit $?' ; exit $?"
    let pid: i64 = sys_spawn_args(c"/bin/rzsh", @argv[0], 3)
    if pid <= 0
        print("(spawn returned {pid}) ")
        return 1
    let code: i64 = sys_wait(pid as i32)
    if code != 42
        print("(exit {code}, want 42) ")
        return 2
    let again: i64 = sys_wait(pid as i32)
    if again >= 0
        print("(second wait returned {again}) ")
        return 3
    var cwd: [64]u8
    let n: i64 = sys_getcwd(@cwd[0], 64)
    if n != 1 or cwd[0] != 47
        print("(init's cwd moved: ")
        if n > 0
            let got: *u8 = @cwd[0]
            print("{got}")
        print(") ")
        return 4
    return 0

fn run_nested_spawn_test() -> i32
    print("[test] nested spawn init->rzsh->script->exitcode ... ")
    let step: i32 = nested_spawn_steps()
    if step == 0
        print("PASS\n")
        g_passed = g_passed + 1
        return 0
    print("FAIL (step {step})\n")
    g_failed = g_failed + 1
    return 1

# spawn_and_wait's result when path did not spawn.
const SPAWN_FAILED: i64 = -1000

# Spawn path and return its exit code, or SPAWN_FAILED if it didn't spawn.
fn spawn_and_wait(path: *u8) -> i64
    let pid: i64 = sys_spawn(path)
    if pid <= 0
        return SPAWN_FAILED
    return sys_wait(pid as i32)

# mmap isolation (AGAST #3530). init maps MMAP_PAGES pages at a
# kernel-chosen address A and fills them; /bin/mmap_child (argv[1] = A) must
# get A from its own first mmap, see zeroed pages there, overwrite them and
# map a > 2 MiB region. Back here, init's pages at A must still hold init's
# pattern: same user VA, different processes, no aliasing. Returns 0 on
# PASS, else a step number (the child's exit code shows as 10 + code).
const MMAP_PAGES: i64 = 4

fn mmap_word(addr: i64) -> *u64
    return addr as *u64

fn mmap_isolation_steps() -> i32
    let p: *u8 = sys_mmap(0, MMAP_PAGES * 4096, PROT_READ | PROT_WRITE, MAP_PRIVATE | MAP_ANONYMOUS)
    let a: i64 = p as i64
    if a <= 0
        print("(init mmap returned {a}) ")
        return 1
    var pg: i64 = 0
    while pg < MMAP_PAGES
        *mmap_word(a + pg * 4096) = 0x1717171700000000 as u64 + pg as u64
        *mmap_word(a + pg * 4096 + 4088) = 0x7171717100000000 as u64 + pg as u64
        pg = pg + 1

    # A in decimal, NUL-terminated for the child's argv.
    var addr_buf: [21]u8
    let addr: StrView = fmt_i64_into(@addr_buf, a)
    addr_buf[addr.len] = 0
    var argv: [2]*u8
    argv[0] = c"mmap_child"
    argv[1] = addr.ptr
    let pid: i64 = sys_spawn_args(c"/bin/mmap_child", @argv[0], 2)
    if pid <= 0
        sys_munmap(p, MMAP_PAGES * 4096)
        return 2
    let child: i64 = sys_wait(pid as i32)

    pg = 0
    var intact: bool = true
    while pg < MMAP_PAGES
        if *mmap_word(a + pg * 4096) != 0x1717171700000000 as u64 + pg as u64
            intact = false
        if *mmap_word(a + pg * 4096 + 4088) != 0x7171717100000000 as u64 + pg as u64
            intact = false
        pg = pg + 1
    let unmapped: i32 = sys_munmap(p, MMAP_PAGES * 4096)
    if child != 0
        print("(child exit {child}) ")
        return 10 + child as i32
    if not intact
        print("(init's pages changed while the child ran) ")
        return 3
    if unmapped != 0
        return 4
    return 0

fn run_mmap_isolation_test() -> i32
    print("[test] mmap_isolation ... ")
    let step: i32 = mmap_isolation_steps()
    if step == 0
        print("PASS\n")
        g_passed = g_passed + 1
        return 0
    print("FAIL (step {step})\n")
    g_failed = g_failed + 1
    return 1

# A failed spawn leaves init's pid alone (AGAST #2762). /etc/motd exists
# but isn't an ELF, so both spawns get past the file lookup and fail in
# elf_load: the path that once left getpid returning the half-made child's
# pid (2). A missing path fails before the pid is touched, so it can't show
# this. Returns 0 on PASS, else a step number.
fn spawn_fail_pid_steps() -> i32
    let before: i32 = sys_getpid()
    if before != 1
        print("(pid before: {before}) ")
        return 1
    let rc: i64 = sys_spawn(c"/etc/motd")
    let after: i32 = sys_getpid()
    if rc >= 0
        print("(spawn of a non-ELF returned {rc}) ")
        return 2
    if after != 1
        print("(pid after failed spawn: {after}) ")
        return 3
    var argv: [2]*u8
    argv[0] = c"motd"
    argv[1] = c"x"
    let rc_args: i64 = sys_spawn_args(c"/etc/motd", @argv[0], 2)
    let after_args: i32 = sys_getpid()
    if rc_args >= 0
        print("(spawn_args of a non-ELF returned {rc_args}) ")
        return 4
    if after_args != 1
        print("(pid after failed spawn_args: {after_args}) ")
        return 5
    return 0

fn run_spawn_fail_pid_test() -> i32
    print("[test] spawn_fail_pid ... ")
    let step: i32 = spawn_fail_pid_steps()
    if step == 0
        print("PASS\n")
        g_passed = g_passed + 1
        return 0
    print("FAIL (step {step})\n")
    g_failed = g_failed + 1
    return 1

# Preemption (AGAST #3629). init spawn_bg's two /bin/busy children, which
# compute without a syscall between progress lines, then waits for both. The
# kernel must run them side by side: spawn_bg returns at once, wait sleeps
# until each exits, and only the timer can take the CPU from a busy child.
# Here both must start and exit 0; tools/test_tier1_boot.sh checks from the
# serial log that their "[busy A]" / "[busy B]" lines interleave, which they
# can't if the first one runs to its end before the second starts.
# Returns 0 on PASS, else a step number.
fn preempt_steps() -> i32
    var argv_a: [2]*u8
    argv_a[0] = c"busy"
    argv_a[1] = c"A"
    var argv_b: [2]*u8
    argv_b[0] = c"busy"
    argv_b[1] = c"B"
    let a: i64 = sys_spawn_bg(c"/bin/busy", @argv_a[0], 2)
    if a <= 0
        print("(spawn_bg A returned {a}) ")
        return 1
    let b: i64 = sys_spawn_bg(c"/bin/busy", @argv_b[0], 2)
    if b <= 0 or b == a
        print("(spawn_bg B returned {b}) ")
        sys_wait(a as i32)
        return 2
    # init still runs while both children do: getpid answers at once.
    if sys_getpid() != 1
        return 3
    let code_a: i64 = sys_wait(a as i32)
    let code_b: i64 = sys_wait(b as i32)
    if code_a != 0 or code_b != 0
        print("(exit codes {code_a}, {code_b}) ")
        return 4
    # each is reaped exactly once
    if sys_wait(a as i32) >= 0 or sys_wait(b as i32) >= 0
        return 5
    return 0

fn run_preempt_test() -> i32
    print("[test] preempt (two busy children) ...\n")
    let step: i32 = preempt_steps()
    print("[test] preempt ... ")
    if step == 0
        print("PASS\n")
        g_passed = g_passed + 1
        return 0
    print("FAIL (step {step})\n")
    g_failed = g_failed + 1
    return 1

# Persistent /var (AGAST #4321). The kernel counts each boot in /var/boots
# before init starts and saves the /var subtree to the storage disk, so boot
# 1 writes and reads back /var/x while a later boot must find what the boot
# before saved. tools/test_tier1_boot.sh boots the same disk twice.
fn read_small(path: *u8, buf: *u8, cap: i64) -> i64
    let fd: i32 = sys_open(path, O_RDONLY)
    if fd < 0
        return fd as i64
    let n: i64 = sys_read(fd, buf, cap)
    sys_close(fd)
    n

# The boot number the kernel wrote, or -1 when there is no storage disk.
fn boot_count() -> i32
    var buf: [16]u8
    let n: i64 = read_small(c"/var/boots", @buf[0], 15)
    if n <= 0
        return -1
    var v: i32 = 0
    var i: i64 = 0
    while i < n and buf[i] >= 48 and buf[i] <= 57
        v = v * 10 + (buf[i] - 48) as i32
        i = i + 1
    if i == 0
        return -1
    v

# Does `path` hold exactly want_len bytes equal to `want`?
fn file_is(path: *u8, want: *u8, want_len: i64) -> bool
    var buf: [32]u8
    let n: i64 = read_small(path, @buf[0], want_len + 1)
    if n != want_len
        return false
    var i: i64 = 0
    while i < want_len
        if buf[i] != *(want + i)
            return false
        i = i + 1
    true

fn run_persist_test() -> i32
    print("[test] persist ... ")
    let boot: i32 = boot_count()
    if boot < 0
        # No kernel boot counter: this boot has no storage disk.
        print("SKIPPED (no persistent storage)\n")
        return 0
    if boot == 1
        let fd: i32 = sys_open(c"/var/x", O_WRONLY | O_CREAT | O_TRUNC)
        if fd < 0
            print("FAIL (open /var/x: {fd})\n")
            g_failed = g_failed + 1
            return 1
        let n: i64 = sys_write(fd, c"harland-persist", 15)
        let c: i32 = sys_close(fd)
        # Ask for the save now: save-on-close is debounced (#4321) and this
        # test wants the bytes on the disk before the machine can go down.
        let synced: i32 = sys_sync()
        if n != 15 or c != 0 or synced != 0
            print("FAIL (write {n}, close {c}, sync {synced})\n")
            g_failed = g_failed + 1
            return 2
        if not file_is(c"/var/x", c"harland-persist", 15)
            print("FAIL (/var/x did not read back)\n")
            g_failed = g_failed + 1
            return 3
        print("PASS (boot 1 wrote /var/x)\n")
        g_passed = g_passed + 1
        return 0
    # Boot 2 of the same disk: /var/x is what boot 1 saved.
    if not file_is(c"/var/x", c"harland-persist", 15)
        print("FAIL (/var/x lost across the reboot)\n")
        g_failed = g_failed + 1
        return 4
    print("PASS (boot {boot} read /var/x)\n")
    g_passed = g_passed + 1
    0

fn run_fd_isolation_test() -> i32
    print("[test] fd_isolation ... ")
    let step: i32 = fd_isolation_steps()
    if step == 0
        print("PASS\n")
        g_passed = g_passed + 1
        return 0
    print("FAIL (step {step})\n")
    g_failed = g_failed + 1
    return 1

# ============================================================================
# Syscall Tests
# ============================================================================

fn test_getpid() -> i32
    print("[init] Testing sys_getpid()... ")
    let pid: i32 = sys_getpid()
    if pid == 1
        print("PASS (pid=1)\n")
        return 0
    else
        print("FAIL (expected 1, got {pid})\n")
        return 1

fn test_write() -> i32
    print("[init] Testing sys_write()... PASS\n")
    return 0

fn test_yield() -> i32
    print("[init] Testing sys_yield()... ")
    # Nothing else runs yet: yield comes straight back to init.
    sys_yield()
    print("PASS\n")
    return 0

# ============================================================================
# Tier 1 Test Suite
# ============================================================================
#
# These are explicit test cases. Each test specifies:
#   - Binary path
#   - Test name (for display)
#   - Expected exit code
#
# To add a new test, just add another run_test() call.

# Read one key event from the virtio-input device (AGAST #3438).
#
# Not counted in the suite: a boot without a keyboard, or with one nobody
# types on, skips. tools/test_tier1_boot.sh attaches virtio-keyboard-pci,
# injects `sendkey a` through the QEMU monitor as soon as the kernel logs
# "[OK] VirtIO input device", and asserts both the kernel's
# "[virtio-input] event" line and this test's "key event" line.
const INPUT_ERRNO_NODEV: i32 = -19
const EV_KEY: u16 = 1
# Poll rounds (input_read + yield) before giving up on a key. The key is
# normally queued long before the suite gets here.
const INPUT_WAIT_ROUNDS: i32 = 200000

fn run_input_check()
    print("[test] input ... ")
    var ev: [8]u8
    var round: i32 = 0
    while round < INPUT_WAIT_ROUNDS
        let rc: i32 = sys_input_read(@ev[0])
        if rc == INPUT_ERRNO_NODEV
            print("skipped (no input device)\n")
            return
        if rc == 0
            let ev_type: u16 = (ev[0] as u16) | ((ev[1] as u16) << 8)
            let code: u16 = (ev[2] as u16) | ((ev[3] as u16) << 8)
            if ev_type == EV_KEY
                let value: u8 = ev[4]
                print("key event code={code} value={value}\n")
                return
            continue
        sys_yield()
        round = round + 1
    print("skipped (no key event)\n")

fn run_tier1_tests() -> i32
    print("\n========================================\n  Running Tier 1 Test Suite\n========================================\n")

    # Reset counters
    g_passed = 0
    g_failed = 0

    # First, while init is still pid 1 with no child waiting to be reaped.
    run_spawn_fail_pid_test()

    # Before any run_test/run_test_args call (AGAST #4694): each now builds
    # its owned, NUL-terminated path/argv through String/Vec, so the first
    # one refills init's allocator bins via mmap. mmap_isolation_steps reads
    # its own first kernel-chosen mmap as "init's first ever" (the address a
    # freshly spawned child's first mmap must also land at); run it before
    # that allocator mmap claims the slot instead, or the comparison is
    # against a heap-growth mapping, not USER_MMAP_START.
    run_mmap_isolation_test()

    # Basic tests - no arguments needed
    run_test("/bin/hello",       "hello",       0)
    run_test("/bin/true",        "true",        0)
    run_test("/bin/false",       "false",       1)
    run_test("/bin/exitcode",    "exitcode",   42)
    run_test("/bin/hello_tier1", "hello_tier1", 0)
    run_test("/bin/seq10",       "seq10",       0)
    run_test("/bin/cat_motd",    "cat_motd",    0)
    run_test("/bin/hello_gfx",   "hello_gfx",   0)
    run_test("/bin/cwd_test",    "cwd_test",    0)
    run_test("/bin/fd_table_test",  "fd_table_test",  0)
    # An open read fd keeps its bytes across a rewrite of the path
    # (AGAST #4322): goliath GC must not free a held blob under the reader.
    run_test("/bin/fd_hold_test",   "fd_hold_test",   0)
    # ritzlib.fs write_file on Harland, and a write fd that writes nothing:
    # an empty write commits an empty file, an O_WRONLY open with no write
    # and no O_TRUNC leaves the file, and a child killed between its O_TRUNC
    # open and its write leaves the old bytes (AGAST #4830). On /tmp and /var.
    run_test("/bin/write_empty_test", "write_empty_test", 0)
    # stat/fstat's size, mtime and mode, and open(O_CREAT)'s mode, through
    # ritzlib's portable stat and Fd.stat (AGAST #4832). On /tmp and /var.
    run_test("/bin/stat_test", "stat_test", 0)
    run_test("/bin/pid_child_test", "pid_child_test", 0)
    run_fd_isolation_test()
    # malloc/Vec/String with RAM exhausted: null and -1, never a write through
    # a failed mmap's -errno or null (AGAST #3551).
    run_test("/bin/malloc_fail_child", "malloc_fail", 0)
    # Syscalls deep enough to have overrun the old 4 KiB syscall stack,
    # growing the kernel heap under a child CR3 (AGAST #2761).
    run_test("/bin/heap_grow_child", "heap_grow", 0)
    # readdir of a 64-entry dir and 100 opens: frames that overran the old
    # syscall stack, now with a guard page under it (AGAST #1877).
    run_test("/bin/readdir64_child", "readdir64", 0)

    # A child without the POWER capability cannot power off, and without the
    # display capability cannot map the framebuffer (AGAST #1888).
    run_test("/bin/cap_child",   "cap_child",    0)

    # A child that revokes its inherited channel capability is refused IPC,
    # and one that revokes its namespace capability is refused filesystem
    # access (AGAST #4472).
    run_test("/bin/cap_ipc_child", "cap_ipc_child", 0)
    run_test("/bin/cap_fs_child",  "cap_fs_child",  0)

    # Without a CAP_TYPE_IRQ handle, DrvIrqWait (220) is refused with
    # Errno.Perm and writes nothing back (AGAST #4719).
    run_test("/bin/drv_refuse_test", "drv_refuse_test", 0)

    # ritzlib.timedread on the console (AGAST #4829): with nothing typed, a
    # timed wait on fd 0 ends at its timeout instead of blocking.
    run_test("/bin/timed_read_test", "timed_read_test", 0)

    # A ring-3 page fault kills only the child: exit 128 + 14 (#2755).
    run_test("/bin/fault_child",  "fault_child",  142)

    # Test rzsh --help (non-interactive)
    var rzsh_argv: [2]StrView
    rzsh_argv[0] = "rzsh"
    rzsh_argv[1] = "--help"
    run_test_args("/bin/rzsh", "rzsh --help", span_from_ptr<StrView>(@rzsh_argv[0], 2), 0)

    # rzsh parses, sets and expands variables (AGAST #3459): its token and
    # variable tables are Vecs, so this is rzsh's first user mmap; the line
    # is #3530's repro, which once panicked the kernel. Exit 7 only if $N
    # expanded.
    var rzsh_c_argv: [3]StrView
    rzsh_c_argv[0] = "rzsh"
    rzsh_c_argv[1] = "-c"
    rzsh_c_argv[2] = "X=hello ; echo $X world ; N=7 ; exit $N"
    run_test_args("/bin/rzsh", "rzsh -c vars", span_from_ptr<StrView>(@rzsh_c_argv[0], 3), 7)

    # A `pub fn main(args: Span<StrView>, env: Span<StrView>)` (AGAST
    # #4019): the adapter's Linux-shaped mmap builds the views on Harland,
    # and _start calls main 16-aligned. Each failure has its own exit code.
    var span_argv: [3]StrView
    span_argv[0] = "span_args"
    span_argv[1] = "alpha"
    span_argv[2] = "beta-gamma"
    run_test_args("/bin/span_args", "span_args", span_from_ptr<StrView>(@span_argv[0], 3), 0)

    # The ring-3 net tools (AGAST #4751, harland docs/RING2_NET.md "Ring-3
    # tools"). No ring-2 service runs on a Tier-1 boot, so NetAttach answers
    # Errno.NoDev and each tool exits 19 (-NoDev) before it publishes a
    # request; tools/test_tier1_boot.sh checks all three lines (net_nodev).
    # A translating boot has handed the frame seat to /bin/netd by now
    # (AGAST #4744): there the tools reach a live service, and their
    # acceptance against it is test_msix_boot.sh's (AGAST #4752), not this
    # NoDev check's.
    var ping_argv: [2]StrView
    ping_argv[0] = "ping"
    ping_argv[1] = "10.0.2.2"
    var send_argv: [4]StrView
    send_argv[0] = "udp-send"
    send_argv[1] = "10.0.2.2"
    send_argv[2] = "7777"
    send_argv[3] = "hello"
    var recv_argv: [2]StrView
    recv_argv[0] = "udp-recv"
    recv_argv[1] = "7777"
    if net_service_up()
        print("[test] net tools nodev: skipped, a ring-2 network service is up\n")
    else
        run_test_args("/bin/ping", "ping nodev", span_from_ptr<StrView>(@ping_argv[0], 2), 19)
        run_test_args("/bin/udp-send", "udp-send nodev", span_from_ptr<StrView>(@send_argv[0], 4), 19)
        run_test_args("/bin/udp-recv", "udp-recv nodev", span_from_ptr<StrView>(@recv_argv[0], 2), 19)
    # A malformed address or port is a usage error (exit 2), refused
    # before any net call: an octet above 255, three octets, port 65536.
    ping_argv[1] = "10.0.2.256"
    run_test_args("/bin/ping", "ping bad address", span_from_ptr<StrView>(@ping_argv[0], 2), 2)
    send_argv[1] = "10.0.2"
    run_test_args("/bin/udp-send", "udp-send bad address", span_from_ptr<StrView>(@send_argv[0], 4), 2)
    recv_argv[1] = "65536"
    run_test_args("/bin/udp-recv", "udp-recv bad port", span_from_ptr<StrView>(@recv_argv[0], 2), 2)

    # Three levels below init, each resuming after its child (AGAST #1882).
    run_nested_spawn_test()

    # Two children computing side by side, preempted by the timer (#3629).
    run_preempt_test()

    # What boot 1 writes under /var, boot 2 of the same disk reads (#4321).
    run_persist_test()

    run_input_check()

    # Print summary
    print("\n----------------------------------------\n  Results: {g_passed} passed, {g_failed} failed\n----------------------------------------\n")

    return g_failed

# ============================================================================
# Main entry point
# ============================================================================

pub fn main() -> i32
    print("\n========================================\n  Harland Init Process (PID 1)\n========================================\n\nRunning syscall tests...\n\n")

    var failed: i32 = 0

    # Run basic syscall tests
    failed = failed + test_write()
    failed = failed + test_getpid()
    failed = failed + test_yield()

    # Run tier 1 test suite
    let tier1_failed: i32 = run_tier1_tests()
    failed = failed + tier1_failed

    print("\n")

    if failed == 0
        print("========================================\n  ALL TESTS PASSED\n========================================\n\n")
        # init's exit is the power-off: the kernel's exit path flushes init's
        # fds and powers off through ACPI, with either status (#2755).
        return 0
    else
        print("========================================\n  TESTS FAILED: {failed}\n========================================\n")
        return 1
