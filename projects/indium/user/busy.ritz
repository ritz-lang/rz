# busy: a process that computes without yielding (AGAST #3629)
#
# Usage: busy TAG
# Spins BUSY_STEPS times through BUSY_SPIN iterations of a loop that makes no
# syscall, printing "[busy TAG] n/BUSY_STEPS" after each, then exits 0. init's
# Tier-1 `preempt` test spawn_bg's two of them side by side: only the
# kernel's timer can take the CPU from either mid-loop, so their progress
# lines interleave only with preemption. tools/test_tier1_boot.sh checks
# that they do. Each line is one write, so lines never mix.

import ritzlib.sys { sys_write, STDOUT }
import ritzlib.fmt.digits { fmt_i64_into }

# Long enough under QEMU TCG (tens of ms a step) that a step spans several
# 10 ms ticks; short enough that the pair finishes in a few seconds.
const BUSY_STEPS: i64 = 8
const BUSY_SPIN: u64 = 0x100000

var g_counter: u64 = 0
var g_line: [64]u8

fn put(pos: i64, s: StrView) -> i64
    var n: i64 = pos
    var i: i64 = 0
    while i < s.len and n < 48
        g_line[n] = s.ptr[i]
        n = n + 1
        i = i + 1
    n

# One write per line (not an interpolated print, which writes each part):
# the two busy processes' lines must never mix.
fn report(tag: StrView, step: i64)
    var n: i64 = put(0, "[busy ")
    n = put(n, tag)
    n = put(n, "] ")
    var digits: [20]u8
    n = put(n, fmt_i64_into(@digits, step))
    n = put(n, "/")
    n = put(n, fmt_i64_into(@digits, BUSY_STEPS))
    g_line[n] = 10
    sys_write(STDOUT, @g_line[0], n + 1)

pub fn main(args: Span<StrView>) -> i32
    var tag: StrView = "?"
    if args.len > 1
        tag = args[1]
    var step: i64 = 1
    while step <= BUSY_STEPS
        var i: u64 = 0
        while i < BUSY_SPIN
            # The asm keeps the optimiser from folding the loop away.
            asm x86_64:
                pause
            g_counter = g_counter + 1
            i = i + 1
        report(tag, step)
        step = step + 1
    return 0
