# args_test - Test program that receives and prints command-line arguments
#
# Usage: args_test [arg1] [arg2] ...
# Prints each argument to verify argv passing works.

pub fn main(args: Span<StrView>) -> i32
    let n: i64 = args.len
    print("args_test: received {n} arguments:\n")

    var i: i64 = 0
    while i < n
        let arg: StrView = args[i]
        print("  argv[{i}] = {arg}\n")
        i = i + 1

    print("\nargs_test: exiting with code 0\n")
    0
