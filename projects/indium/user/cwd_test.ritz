# CWD Test - Tests getcwd and chdir syscalls
#
# Tests:
# 1. getcwd returns "/" for initial process
# 2. chdir to /bin succeeds
# 3. getcwd returns "/bin" after chdir
# 4. chdir to nonexistent path fails
#
# Returns 0 on success, 1 on failure.

import ritzlib.sys { sys_getcwd, sys_chdir }
import ritzlib.strview { StrView, strview_from_ptr }

# Whether getcwd reads `want`; prints PASS or FAIL.
fn cwd_is(want: StrView) -> bool
    var buf: [256]u8
    let len: i64 = sys_getcwd(@buf[0], 256)
    if len < 0
        print("FAIL (error)\n")
        return false
    let got: StrView = strview_from_ptr(@buf[0], len)
    if not got.eq(want)
        print("FAIL (expected {want}, got: {got})\n")
        return false
    print("PASS (cwd={want})\n")
    true

pub fn main() -> i32
    var failed: i32 = 0

    # Test 1: getcwd returns "/" initially
    print("[cwd_test] getcwd initial... ")
    if not cwd_is("/")
        failed = 1

    # Test 2: chdir to /bin
    print("[cwd_test] chdir /bin... ")
    let result2: i32 = sys_chdir(c"/bin")
    if result2 == 0
        print("PASS\n")
    else
        print("FAIL\n")
        failed = 1

    # Test 3: getcwd returns "/bin"
    print("[cwd_test] getcwd after chdir... ")
    if not cwd_is("/bin")
        failed = 1

    # Test 4: chdir to nonexistent path should fail
    print("[cwd_test] chdir /nonexistent... ")
    let result4: i32 = sys_chdir(c"/nonexistent")
    if result4 < 0
        print("PASS (correctly failed)\n")
    else
        print("FAIL (should have failed)\n")
        failed = 1

    # Test 5: chdir back to root
    print("[cwd_test] chdir /... ")
    let result5: i32 = sys_chdir(c"/")
    if result5 == 0
        print("PASS\n")
    else
        print("FAIL\n")
        failed = 1

    # Test 6: verify back at root
    print("[cwd_test] getcwd final... ")
    if not cwd_is("/")
        failed = 1

    return failed
