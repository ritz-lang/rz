# cap_fs_child: the filesystem syscalls reject a process without a
# namespace capability (AGAST #4472, the #1888 cap_child pattern).
#
# A spawned process inherits its parent's ambient capabilities: DISPLAY,
# CHANNEL and NAMESPACE, in that order (cap_inherit_ambient). This child
# revokes the inherited NAMESPACE capability, so SYS_OPEN must answer
# -EPERM even for a path (/etc/motd) that exists and that this same process
# could open a moment earlier.
#
# Before #4472 open resolved and returned a descriptor for any caller.
# Exit 0 only if the revocation and the refusal both succeed.

import ritzlib.sys { syscall1, sys_open, O_RDONLY }

const NR_CAP_REVOKE: i64 = 41
const DENIED: i32 = -1

# The child's inherited handles, in cap_inherit_ambient's insertion order:
# DISPLAY (index 0, generation 1), CHANNEL (index 1, generation 2),
# NAMESPACE (index 2, generation 3).
const INHERITED_NAMESPACE_HANDLE: i64 = (3 << 32) | 2

pub fn main() -> i32
    print("[cap_fs_child] revoking the inherited namespace capability\n")
    let revoked: i64 = syscall1(NR_CAP_REVOKE, INHERITED_NAMESPACE_HANDLE)
    print("[cap_fs_child] cap_revoke -> {revoked}\n")
    if revoked != 0
        print("[cap_fs_child] FAIL: could not revoke the namespace capability\n")
        return 1

    let fd: i32 = sys_open(c"/etc/motd", O_RDONLY)
    print("[cap_fs_child] open(/etc/motd) -> {fd}\n")
    if fd != DENIED
        print("[cap_fs_child] FAIL: open was not denied\n")
        return 2

    print("[cap_fs_child] PASS: open denied without a namespace capability\n")
    return 0
