# Count lines, words, and bytes in a file.
import ritzlib.span { Span, span_from_ptr }
import ritzlib.strview { StrView }
import ritzlib.sys { sys_close, O_RDONLY }
import tool_io { open_path, read_bytes }

pub fn main(args: Span<StrView>) -> i32
    if args.len < 2
        eprint("Usage: wc <filename>\n")
        return 1

    let path: StrView = args.get(1)
    let fd: i32 = open_path(path, O_RDONLY)
    if fd < 0
        eprint("wc: cannot open file\n")
        return 1
    defer sys_close(fd)

    var lines: i64 = 0
    var words: i64 = 0
    var length: i64 = 0
    var in_word: bool = false
    var bytes: [4096]u8
    let buffer: Span<u8> = span_from_ptr<u8>(@bytes[0], 4096)

    loop
        let count: i64 = read_bytes(fd, buffer)
        if count < 0
            eprint("wc: read error\n")
            return 1
        if count == 0
            break
        length += count
        for index in 0..count
            let byte: u8 = buffer.get(index)
            if byte == '\n'
                lines += 1
            let whitespace: bool = byte == ' ' or (byte >= 9 and byte <= 13)
            if not whitespace and not in_word
                words += 1
            in_word = not whitespace

    print("{lines} {words} {length} {path}\n")
    0
