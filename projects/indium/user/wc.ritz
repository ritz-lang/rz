# wc: Count lines, words, and characters in a file
#
# Usage: wc <filename>
# Prints: lines words chars filename
# Tests: sys_open, sys_read, sys_close, argument passing
#
# Exit code: 0 on success, 1 on error

import ritzlib.sys { sys_read, sys_open, sys_close, O_RDONLY }

pub fn main(args: Span<StrView>) -> i32
    if args.len < 2
        print("Usage: wc <filename>\n")
        return 1

    # argv strings are NUL-terminated, so the view's ptr opens as a path.
    let filename: StrView = args[1]
    let fd: i32 = sys_open(filename.ptr, O_RDONLY)
    if fd < 0
        print("wc: cannot open file\n")
        return 1

    var lines: i32 = 0
    var words: i32 = 0
    var chars: i32 = 0
    var in_word: bool = false
    var buf: [256]u8

    var n: i64 = sys_read(fd, @buf[0], 256)
    while n > 0
        var i: i64 = 0
        while i < n
            let c: u8 = buf[i]
            chars = chars + 1

            if c == 10  # newline
                lines = lines + 1
                in_word = false
            else if c == 32 or c == 9  # space or tab
                in_word = false
            else
                if not in_word
                    words = words + 1
                    in_word = true
            i = i + 1
        n = sys_read(fd, @buf[0], 256)

    sys_close(fd)
    print("{lines} {words} {chars} {filename}\n")
    0
