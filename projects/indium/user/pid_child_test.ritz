# pid_child_test: a spawned child does not see init's pid (AGAST #2753, from
# origin/harland-main 242fdc09). A regression test: sys_getpid_handler
# already returns the running process's pid (g_child_pid), so this passed
# before the per-process fd tables too.

import libharland { print_str, print_int }
import ritzlib.sys { sys_getpid }

pub fn main() -> i32
    let pid: i32 = sys_getpid()
    if pid == 1
        print_str(c"[pid_child_test] FAIL: child saw pid=1\n")
        return 1
    print_str(c"[pid_child_test] PASS: pid=")
    print_int(pid as i64)
    print_str(c"\n")
    return 0
