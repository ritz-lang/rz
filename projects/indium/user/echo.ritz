# echo: Print command-line arguments
#
# Usage: echo [args...]
# Prints all arguments separated by spaces, followed by a newline.
# Tests: sys_write, argument passing
#
# Exit code: 0 (always succeeds)
# Runtime _start calls main() and then sys_exit(return_value).

pub fn main(args: Span<StrView>) -> i32
    # Skip args[0] (program name)
    var i: i64 = 1
    while i < args.len
        let arg: StrView = args[i]
        # Print space before all but first arg
        if i > 1
            print(" ")
        print("{arg}")
        i = i + 1

    # Print trailing newline
    print("\n")
    0
