# Reporting for indium's ring-3 net tools (AGAST #4751)
#
# A tool that fails prints which call failed and its RING2_NET.md errno
# name, and exits with the errno's magnitude: NoDev is exit 19, Io 5,
# Exist 17. init's Tier-1 suite checks for 19 on a boot with no network
# service. The attach prologue and argument parsing are net_attach.ritz.

import ritzlib.strview { StrView, strview_from_ptr }
import libnet.client { ERRNO_IO, ERRNO_BADF, ERRNO_EXIST, ERRNO_NODEV, ERRNO_INVAL, ERRNO_NFILE, ERRNO_NOSYS }
import libnet.ring { AppBytes }

# The errno's RING2_NET.md name, for the tools' error lines.
pub fn errno_name(errno: i32) -> StrView
    if errno == ERRNO_NODEV
        return "Errno.NoDev (no network service)"
    if errno == ERRNO_IO
        return "Errno.Io"
    if errno == ERRNO_EXIST
        return "Errno.Exist (port in use)"
    if errno == ERRNO_BADF
        return "Errno.BadF"
    if errno == ERRNO_INVAL
        return "Errno.Inval"
    if errno == ERRNO_NFILE
        return "Errno.NFile"
    if errno == ERRNO_NOSYS
        return "Errno.NoSys"
    "an unexpected errno"

# Report `errno` from `call` on stderr and return the tool's exit status:
# the errno's magnitude (NoDev -> 19).
pub fn fail(tool: StrView, call: StrView, errno: i32) -> i32
    let name: StrView = errno_name(errno)
    eprint("{tool}: {call}: {name} ({errno})\n")
    -errno

# Print `n` bytes of a received payload as text (no newline).
pub fn print_payload(bytes: @AppBytes, n: u32)
    let text: StrView = strview_from_ptr(@bytes[0] as *u8, n as i64)
    print("{text}")
