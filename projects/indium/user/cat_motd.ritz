import ritzlib.span { Span, span_from_ptr }
import ritzlib.sys { O_RDONLY, STDOUT, sys_close }
import tool_io { open_path, read_bytes, write_bytes }

pub fn main() -> i32
    let fd: i32 = open_path("/etc/motd", O_RDONLY)
    if fd < 0
        return 1
    defer sys_close(fd)

    var bytes: [256]u8
    let buffer: Span<u8> = span_from_ptr<u8>(@bytes[0], 256)
    var had_content: bool = false
    loop
        let count: i64 = read_bytes(fd, buffer)
        if count < 0
            return 1
        if count == 0
            break
        if not write_bytes(STDOUT, buffer.slice(0, count))
            return 1
        had_content = true

    if had_content
        return 0
    1
