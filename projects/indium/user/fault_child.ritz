# fault_child: a user-mode fault kills this process, not the kernel (AGAST
# #2755, from origin/harland-main 0eda5329).
#
# Reads address 0. Page 0 is never mapped for user code, so the CPU raises a
# page fault (vector 14) from ring 3. The kernel must terminate only this
# process, with exit status 128 + vector (142), and resume init. Before
# #2755 every exception halted the kernel with KERNEL PANIC.
#
# The load is inline asm so no compiler can fold or drop the null read.


pub fn main() -> i32
    print("[fault_child] reading address 0\n")
    asm x86_64:
        xorq %rax, %rax
        movq (%rax), %rax
    # Reached only if the read did not fault.
    print("[fault_child] FAIL: read of address 0 did not fault\n")
    return 1
