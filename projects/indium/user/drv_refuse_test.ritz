# drv_refuse_test: DrvIrqWait (220) refuses a process with no IRQ capability
# (AGAST #4719, harland docs/RING1_DRIVER.md §4), and so do DrvMmioMap (221)
# and DrvDmaAlloc (222) without an MMIO or IRQ one (#4720, #4721, §5), and
# DrvDmaFree (223) without an IRQ one (#4725).
#
# The handle is the right to park on a device's interrupt. A process spawned
# by sys_spawn inherits only its parent's ambient capabilities (DISPLAY,
# CHANNEL, NAMESPACE: cap_inherit_ambient) and never a CAP_TYPE_IRQ one: the
# kernel grants that to the process it spawned for the device, and CapGrant
# refuses to pass it on. So every ring-3 process gets Errno.Perm, both for a
# handle it does not hold and for one it holds that is not an IRQ handle.
# The request is valid in both calls, so only the authority check can
# refuse them, and a refusal consumes nothing: out_count and the out slot
# keep the values this program put there.
#
# Exit 0 only if both calls are refused with Errno.Perm (-1) and neither
# wrote the request; each failure has its own code.

import ritzlib.strview { StrView }
import ritzlib.sys { syscall1, syscall2, syscall3 }
import driver_abi.wait { WaitRequest, WaitEvent, WaitSource }
import driver_abi.dma { DmaAlloc }

# The kernel's Syscall.DrvIrqWait. ritzlib.sys wraps no driver syscall (its
# SYS_DRV_IRQ_WAIT, which ritz0/test_harland_syscall_dispatch.py diffs
# against the enum, is private), so the number is named here as
# cap_ipc_child names the IPC ones.
const NR_DRV_IRQ_WAIT: i64 = 220
const NR_DRV_MMIO_MAP: i64 = 221
const NR_DRV_DMA_ALLOC: i64 = 222
const NR_DRV_DMA_FREE: i64 = 223
# The first address of every driver's DMA window (harland mm/vmm.ritz
# DRV_DMA_BASE): a run DrvDmaAlloc would have put there.
const DRV_DMA_BASE: i64 = 0x7E0000000000
const PERM: i64 = -1

# No handle at all: index 0, generation 0 never names a live entry.
const NO_HANDLE: i64 = 0
# The first inherited handle, DISPLAY (index 0, generation 1): held, but
# not CAP_TYPE_IRQ (cap_ipc_child names the same insertion order).
const DISPLAY_HANDLE: i64 = 1 << 32

# What the kernel must leave in place on a refusal.
const UNTOUCHED_COUNT: u32 = 0x5A
const UNTOUCHED_HANDLE: u64 = 0xEEEEEEEEEEEEEEEE

# A one-slot request: no shm sources, out_cap 1.
fn refused_untouched(name: StrView, handle: i64) -> bool
    var event: WaitEvent
    event.handle = UNTOUCHED_HANDLE
    event.bits = 0
    event._pad = 0
    var req: WaitRequest
    req.sources = 0 as *WaitSource
    req.source_count = 0
    req.out_cap = 1
    req.out = @event
    req.deadline = 0
    req.out_count = UNTOUCHED_COUNT
    req._pad = 0
    let r: i64 = syscall2(NR_DRV_IRQ_WAIT, handle, @req as i64)
    print("[drv_refuse_test] drv_irq_wait({name}) -> {r}\n")
    if r != PERM
        print("[drv_refuse_test] FAIL: {name} was not refused with Errno.Perm\n")
        return false
    if req.out_count != UNTOUCHED_COUNT or event.handle != UNTOUCHED_HANDLE
        print("[drv_refuse_test] FAIL: the refusal of {name} wrote the request\n")
        return false
    true

# DrvMmioMap with `handle`: refused with Errno.Perm. A refusal maps nothing,
# which ring 3 can't see; the drv-mmio-map boot test checks that.
fn mmio_refused(name: StrView, handle: i64) -> bool
    let r: i64 = syscall1(NR_DRV_MMIO_MAP, handle)
    print("[drv_refuse_test] drv_mmio_map({name}) -> {r}\n")
    if r != PERM
        print("[drv_refuse_test] FAIL: drv_mmio_map({name}) was not refused with Errno.Perm\n")
        return false
    true

# DrvDmaAlloc of one page with `handle`: refused with Errno.Perm, the
# DmaAlloc left as it was.
fn dma_refused(name: StrView, handle: i64) -> bool
    var out: DmaAlloc
    out.iova = UNTOUCHED_HANDLE
    out.size = UNTOUCHED_HANDLE
    let r: i64 = syscall3(NR_DRV_DMA_ALLOC, handle, 4096, @out as i64)
    print("[drv_refuse_test] drv_dma_alloc({name}) -> {r}\n")
    if r != PERM
        print("[drv_refuse_test] FAIL: drv_dma_alloc({name}) was not refused with Errno.Perm\n")
        return false
    if out.iova != UNTOUCHED_HANDLE or out.size != UNTOUCHED_HANDLE
        print("[drv_refuse_test] FAIL: the refusal of drv_dma_alloc({name}) wrote the DmaAlloc\n")
        return false
    true

# DrvDmaFree of one page at the DMA window's base with `handle`: refused
# with Errno.Perm before the run table is looked at.
fn dma_free_refused(name: StrView, handle: i64) -> bool
    let r: i64 = syscall3(NR_DRV_DMA_FREE, handle, DRV_DMA_BASE, 4096)
    print("[drv_refuse_test] drv_dma_free({name}) -> {r}\n")
    if r != PERM
        print("[drv_refuse_test] FAIL: drv_dma_free({name}) was not refused with Errno.Perm\n")
        return false
    true

pub fn main() -> i32
    if not refused_untouched("no handle", NO_HANDLE)
        return 1
    if not refused_untouched("the display handle", DISPLAY_HANDLE)
        return 2
    if not mmio_refused("no handle", NO_HANDLE)
        return 3
    if not mmio_refused("the display handle", DISPLAY_HANDLE)
        return 4
    if not dma_refused("no handle", NO_HANDLE)
        return 5
    if not dma_refused("the display handle", DISPLAY_HANDLE)
        return 6
    if not dma_free_refused("no handle", NO_HANDLE)
        return 7
    if not dma_free_refused("the display handle", DISPLAY_HANDLE)
        return 8
    print("[drv_refuse_test] PASS: DrvIrqWait, DrvMmioMap, DrvDmaAlloc and DrvDmaFree refused without a device capability\n")
    return 0
