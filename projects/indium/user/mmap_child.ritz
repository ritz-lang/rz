# mmap_child: the child half of init's mmap test (AGAST #3530).
#
# init mmaps PAGES pages (kernel-chosen address), fills them, and spawns this
# with that address as argv[1] in decimal. Each process has its own mmap
# region and cursor, so:
#   1. this process's first kernel-chosen mmap of PAGES pages lands at the
#      same address init got (exit 2 otherwise), and
#   2. the pages there are this process's own: zero-filled, not init's
#      pattern (exit 3). Writing them must not change init's (init checks
#      that after this exits).
#   3. a larger mapping spanning several page tables (BIG_PAGES, > 2 MiB)
#      maps, and every page holds what was written to it (exit 4..6).
#   4. munmap of both succeeds (exit 7).
# Exit 0 = PASS; 1 = bad argv.

import libharland { print_str, print_int, sys_mmap, sys_munmap, PROT_READ, PROT_WRITE, MAP_PRIVATE, MAP_ANONYMOUS }

const PAGE: i64 = 4096
const PAGES: i64 = 4
# 3 MiB: crosses at least one 2 MiB page-table boundary.
const BIG_PAGES: i64 = 768

fn fail(step: i32, msg: *u8) -> i32
    print_str(c"[mmap_child] FAIL: ")
    print_str(msg)
    print_str(c"\n")
    return step

fn parse_dec(s: *u8) -> i64
    var v: i64 = 0
    var i: i64 = 0
    while *(s + i) >= 48 and *(s + i) <= 57
        v = v * 10 + (*(s + i) - 48) as i64
        i = i + 1
    return v

# mmap n anonymous RW pages at a kernel-chosen address; 0 on failure.
fn map_pages(n: i64) -> i64
    let p: *u8 = sys_mmap(0, n * PAGE, PROT_READ | PROT_WRITE, MAP_PRIVATE | MAP_ANONYMOUS)
    let a: i64 = p as i64
    if a <= 0
        return 0
    return a

fn word(addr: i64) -> *u64
    return addr as *u64

pub fn main(argc: i32, argv: **u8) -> i32
    if argc < 2
        return fail(1, c"usage: mmap_child <parent mmap address>")
    let parent_addr: i64 = parse_dec(*(argv + 1))

    # 1. Same first address as the parent: the cursor is per process.
    let a: i64 = map_pages(PAGES)
    if a == 0
        return fail(2, c"mmap failed")
    if a != parent_addr
        print_str(c"[mmap_child] first mmap at ")
        print_int(a)
        print_str(c", parent's at ")
        print_int(parent_addr)
        print_str(c"\n")
        return fail(2, c"mmap cursor is not per process")

    # 2. Own, zeroed pages at the parent's address; overwrite them.
    var pg: i64 = 0
    while pg < PAGES
        let base: i64 = a + pg * PAGE
        if *word(base) != 0 or *word(base + PAGE - 8) != 0
            return fail(3, c"fresh page is not zero (aliases the parent's?)")
        *word(base) = 0xC0C0C0C000000000 as u64 + pg as u64
        *word(base + PAGE - 8) = 0xC1C1C1C100000000 as u64 + pg as u64
        pg = pg + 1

    # 3. A mapping spanning several page tables.
    let b: i64 = map_pages(BIG_PAGES)
    if b == 0
        return fail(4, c"big mmap failed")
    if b < a + PAGES * PAGE
        return fail(5, c"big mmap overlaps the first one")
    pg = 0
    while pg < BIG_PAGES
        let base: i64 = b + pg * PAGE
        *word(base) = 0x5A5A000000000000 as u64 + pg as u64
        *word(base + 2048) = 0xA5A5000000000000 as u64 + pg as u64
        pg = pg + 1
    pg = 0
    while pg < BIG_PAGES
        let base: i64 = b + pg * PAGE
        if *word(base) != 0x5A5A000000000000 as u64 + pg as u64 or *word(base + 2048) != 0xA5A5000000000000 as u64 + pg as u64
            print_str(c"[mmap_child] big mapping: bad page ")
            print_int(pg)
            print_str(c"\n")
            return fail(6, c"big mapping lost a write")
        pg = pg + 1
    pg = 0
    while pg < PAGES
        if *word(a + pg * PAGE) != 0xC0C0C0C000000000 as u64 + pg as u64
            return fail(6, c"first mapping changed by the big one")
        pg = pg + 1

    # 4. Unmap both.
    if sys_munmap(b as *u8, BIG_PAGES * PAGE) != 0 or sys_munmap(a as *u8, PAGES * PAGE) != 0
        return fail(7, c"munmap failed")

    print_str(c"[mmap_child] PASS: own region at the parent's address, ")
    print_int(BIG_PAGES)
    print_str(c"-page mapping ok\n")
    return 0
