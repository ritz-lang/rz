# Report userspace ICMP availability.
import ritzlib.io { prints, eprints }
import ritzlib.span { Span }
import ritzlib.strview { StrView }

pub fn main(args: Span<StrView>) -> i32
    let usage: StrView = "Usage: ping <host>\n"
    if args.len != 2
        eprints(usage)
        return 2

    let host: StrView = args.get(1)
    if host.eq("--help") or host.eq("-h")
        prints(usage)
        return 0
    if host.is_empty() or host.starts_with("-")
        eprints(usage)
        return 2

    eprints("ping: ICMP is unavailable from Harland userspace\n")
    1
