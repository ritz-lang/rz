# ping - Network connectivity test utility
#
# Usage: ping <host>
# Sends ICMP echo requests to the specified host.
#
# Note: This is a stub implementation for harland userspace testing.
# Real networking will be added when harland gets network stack support.

import ritzlib.sys { sys_yield }

# Simple delay loop (no real timekeeping yet)
fn delay() -> i32
    var i: i32 = 0
    while i < 1000000
        sys_yield()
        i = i + 1
    return 0

pub fn main(args: Span<StrView>) -> i32
    if args.len < 2
        print("Usage: ping <host>\n")
        return 1

    let host: StrView = args[1]
    print("PING {host} - harland network stack (stub)\n\n")

    # Simulate some ping responses
    var seq: i32 = 1
    while seq <= 4
        let ms: i32 = seq * 10  # Fake latency
        print("64 bytes from {host}: icmp_seq={seq} ttl=64 time={ms} ms\n")
        delay()
        seq = seq + 1

    print("\n--- {host} ping statistics ---\n")
    print("4 packets transmitted, 4 received, 0% packet loss\n")
    print("rtt min/avg/max = 10/25/40 ms\n")
    0
