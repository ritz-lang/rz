# Report userspace ICMP availability.
import ritzlib.sys { sys_write, STDOUT, STDERR }
import ritzlib.str { strcmp, strlen }

fn usage(fd: i32) -> i32
    let message: *u8 = c"Usage: ping <host>\n"
    sys_write(fd, message, strlen(message))
    0

pub fn main(argc: i32, argv: **u8) -> i32
    if argc != 2
        usage(STDERR)
        return 2

    let arg: *u8 = *(argv + 1)
    if strcmp(arg, c"--help") == 0 or strcmp(arg, c"-h") == 0
        return usage(STDOUT)
    if *arg == 0 or *arg == 45
        usage(STDERR)
        return 2

    let message: *u8 = c"ping: ICMP is unavailable from Harland userspace\n"
    sys_write(STDERR, message, strlen(message))
    1
