# cat - Concatenate and display files
#
# Usage: cat [file...]
#
# Reads files sequentially and writes them to stdout.
# If no files specified, reads from stdin.

import ritzlib.sys {
    sys_read, sys_write, sys_exit, sys_open, sys_close,
    O_RDONLY, STDIN, STDOUT, STDERR
}
import ritzlib.strview { StrView }

# Print error message
fn print_error(msg: StrView)
    sys_write(STDERR, msg.ptr, msg.len)

fn print_error_path(prefix: StrView, path: StrView, suffix: StrView)
    print_error(prefix)
    print_error(path)
    print_error(suffix)

# Cat a single file to stdout. `path` is an argv view: argv strings are
# NUL-terminated, so its ptr opens as a path.
fn cat_file(path: StrView) -> i32
    let fd: i32 = sys_open(path.ptr, O_RDONLY)
    if fd < 0
        print_error_path("cat: ", path, ": No such file or directory\n")
        return 1

    var buf: [4096]u8
    var status: i32 = 0

    var reading: bool = true
    while reading
        let n: i64 = sys_read(fd, @buf[0], 4096)
        if n > 0
            sys_write(STDOUT, @buf[0], n)
        else if n == 0
            reading = false
        else
            print_error_path("cat: ", path, ": read error\n")
            status = 1
            reading = false

    sys_close(fd)
    return status

# Cat stdin to stdout
fn cat_stdin() -> i32
    var buf: [4096]u8

    var reading: bool = true
    while reading
        let n: i64 = sys_read(STDIN, @buf[0], 4096)
        if n > 0
            sys_write(STDOUT, @buf[0], n)
        else if n == 0
            reading = false
        else
            print_error("cat: stdin: read error\n")
            return 1

    return 0

# Main entry point.
pub fn main(args: Span<StrView>) -> i32
    # If no files specified, read from stdin
    if args.len <= 1
        return cat_stdin()

    var status: i32 = 0
    var i: i64 = 1

    while i < args.len
        let path: StrView = args[i]

        # "-" means stdin
        if path.eq("-")
            let result: i32 = cat_stdin()
            if result != 0
                status = result
        else
            let result: i32 = cat_file(path)
            if result != 0
                status = result

        i = i + 1

    return status
