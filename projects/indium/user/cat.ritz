# Concatenate files, using stdin for an operand of "-" or an empty operand list.
import ritzlib.errno { errno_from_raw, errno_write }
import ritzlib.io { eprints }
import ritzlib.span { Span, span_from_ptr }
import ritzlib.strview { StrView }
import ritzlib.sys { sys_close, O_RDONLY, STDIN, STDOUT, STDERR }
import tool_io { open_path, read_bytes, write_bytes }

fn cat_stream(fd: i32, label: StrView) -> i32
    var bytes: [4096]u8
    let buffer: Span<u8> = span_from_ptr<u8>(@bytes[0], 4096)
    loop
        let count: i64 = read_bytes(fd, buffer)
        if count == 0
            return 0
        if count < 0
            eprints("cat: ")
            eprints(label)
            eprints(": read error\n")
            return 1
        if not write_bytes(STDOUT, buffer.slice(0, count))
            eprints("cat: write error\n")
            return 1

fn cat_file(path: StrView) -> i32
    let fd: i32 = open_path(path, O_RDONLY)
    if fd < 0
        eprints("cat: ")
        eprints(path)
        eprints(": ")
        errno_write(STDERR, errno_from_raw(fd))
        eprints("\n")
        return 1
    defer sys_close(fd)
    cat_stream(fd, path)

pub fn main(args: Span<StrView>) -> i32
    if args.len <= 1
        return cat_stream(STDIN, "stdin")

    var status: i32 = 0
    for index in 1..args.len
        let path: StrView = args.get(index)
        var result: i32
        if path.eq("-")
            result = cat_stream(STDIN, "stdin")
        else
            result = cat_file(path)
        if result != 0
            status = result
    status
