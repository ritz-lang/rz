# mmap_test.ritz - Test sys_mmap syscall
#
# This simple test allocates memory using mmap, writes to it,
# reads it back, and then unmaps it.

import ritzlib.sys { sys_exit, sys_mmap, sys_munmap, PROT_READ, PROT_WRITE, MAP_PRIVATE, MAP_ANONYMOUS }

fn main() -> i32
    print("mmap test: allocating 4KB...\n")

    # Allocate one page (4KB) of anonymous memory
    let prot: i32 = PROT_READ | PROT_WRITE
    let flags: i32 = MAP_PRIVATE | MAP_ANONYMOUS
    let ptr: *u8 = sys_mmap(0, 4096, prot, flags)

    # harland's mmap fails with -errno (e.g. -12) cast to *u8, not null
    # (AGAST #3551), so a failure is <= 0, not just == 0.
    if (ptr as i64) <= 0
        let rc: i64 = ptr as i64
        print("FAIL: mmap returned {rc}\n")
        sys_exit(1)
        return 1

    # Check that the pointer is in the expected range (above USER_MMAP_START = 0x10000000)
    if (ptr as i64) < 0x10000000
        print("FAIL: mmap returned unexpected address\n")
        sys_exit(2)
        return 2

    # Decimal until interpolation prints `{addr:x}` (AGAST #202).
    let addr: i64 = ptr as i64
    print("mmap returned: {addr}\n")

    # Write a pattern to the allocated memory
    print("Writing pattern...\n")
    var i: i32 = 0
    while i < 256
        *(ptr + i) = (i % 256) as u8
        i = i + 1

    # Read back and verify
    print("Verifying pattern...\n")
    i = 0
    while i < 256
        let expected: u8 = (i % 256) as u8
        let actual: u8 = *(ptr + i)
        if actual != expected
            print("FAIL: mismatch at offset {i}\n")
            sys_exit(3)
            return 3
        i = i + 1

    print("Pattern verified!\n")

    # Unmap the memory
    print("Unmapping...\n")
    let result: i32 = sys_munmap(ptr, 4096)
    if result != 0
        print("FAIL: munmap returned {result}\n")
        sys_exit(4)
        return 4

    print("PASS: mmap test succeeded!\n")
    sys_exit(0)
    return 0
