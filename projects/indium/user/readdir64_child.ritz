# readdir64_child: the syscalls whose frames overran harland's old 4 KiB
# syscall stack, from a child process (AGAST #1877).
#
# readdir of a 64-entry directory: the kernel used to list it into a
# [64]KDirEntry (~21 KiB) on the syscall stack; now the entries are on the
# heap. Then 100 opens of one file: on the 4 KiB stack (#2761) the open path
# clobbered g_child_pid, so init's wait for this child answered ECHILD.
# Both run on a stack with an unmapped guard page below it, so any overflow
# left is a #PF that panics the boot instead of silent corruption.
#
# Steps: mkdir /rd64 (in /, the one directory every image has); create
# /rd64/f00 .. /rd64/f63; readdir /rd64 must name exactly those 64; open and
# close /rd64/f00 100 times, each as fd 3. Exit 0 = PASS: init's run_test
# then also proves wait still found this child.

import libharland { print_str, print_int }
import ritzlib.sys { syscall2, sys_readdir, sys_open, sys_close, O_RDONLY, O_WRONLY, O_CREAT, O_TRUNC, SYS_MKDIR }

const ENTRIES: i32 = 64
const OPENS: i32 = 100

fn fail(step: i32, msg: *u8, value: i64) -> i32
    print_str(c"[readdir64_child] FAIL: ")
    print_str(msg)
    print_int(value)
    print_str(c"\n")
    return step

# "/rd64/fNN" into path (10 bytes with the NUL).
fn entry_path(path: *u8, n: i32)
    let prefix: *u8 = c"/rd64/f"
    var i: i64 = 0
    while i < 7
        *(path + i) = *(prefix + i)
        i = i + 1
    *(path + 7) = (0x30 + n / 10) as u8
    *(path + 8) = (0x30 + n % 10) as u8
    *(path + 9) = 0

pub fn main() -> i32
    # 1. The directory.
    let mk: i64 = syscall2(SYS_MKDIR, c"/rd64" as i64, 5)
    if mk != 0
        return fail(1, c"mkdir /rd64 returned ", mk)

    # 2. 64 files in it.
    var path: [10]u8
    var n: i32 = 0
    while n < ENTRIES
        entry_path(@path[0], n)
        let fd: i32 = sys_open(@path[0], O_WRONLY | O_CREAT | O_TRUNC)
        if fd != 3
            return fail(2, c"create expected fd 3, got ", fd as i64)
        let c: i32 = sys_close(fd)
        if c != 0
            return fail(3, c"close after create returned ", c as i64)
        n = n + 1

    # 3. readdir names all 64: "fNN\0" each, every NN once.
    var buf: [1024]u8
    let got: i64 = sys_readdir(c"/rd64", @buf[0], 1024)
    if got != (ENTRIES * 4) as i64
        return fail(4, c"readdir /rd64 returned bytes: ", got)
    var seen: [64]u8
    n = 0
    while n < ENTRIES
        seen[n] = 0
        n = n + 1
    var off: i64 = 0
    while off < got
        if buf[off] != 0x66 or buf[off + 3] != 0
            return fail(5, c"unexpected name at offset ", off)
        let idx: i32 = ((buf[off + 1] - 0x30) as i32) * 10 + ((buf[off + 2] - 0x30) as i32)
        if idx < 0 or idx >= ENTRIES or seen[idx] != 0
            return fail(6, c"bad or repeated entry index ", idx as i64)
        seen[idx] = 1
        off = off + 4

    # 4. 100 opens of one file.
    entry_path(@path[0], 0)
    n = 0
    while n < OPENS
        let fd: i32 = sys_open(@path[0], O_RDONLY)
        if fd != 3
            return fail(7, c"open expected fd 3, got ", fd as i64)
        let c: i32 = sys_close(fd)
        if c != 0
            return fail(8, c"close returned ", c as i64)
        n = n + 1

    print_str(c"[readdir64_child] PASS: readdir of 64 entries, 100 opens\n")
    return 0
