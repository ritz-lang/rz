import ritzlib.errno { errno_from_raw, errno_write }
import ritzlib.str { strcmp, strlen }
import ritzlib.sys { STDOUT, STDERR, SYS_MKDIR, sys_write, syscall2 }

fn usage(fd: i32)
    let text: *u8 = c"Usage: mkdir <directory>...\n"
    sys_write(fd, text, strlen(text))

pub fn main(argc: i32, argv: **u8) -> i32
    if argc == 2 and strcmp(*(argv + 1), c"--help") == 0
        usage(STDOUT)
        return 0

    var first: i32 = 1
    if argc > 1 and strcmp(*(argv + 1), c"--") == 0
        first = 2
    else if argc > 1 and **(argv + 1) == '-'
        usage(STDERR)
        return 2

    if argc <= first
        usage(STDERR)
        return 2

    var status: i32 = 0
    for i in first..argc
        let path: *u8 = *(argv + i)
        let len: i64 = strlen(path)
        let result: i64 = syscall2(SYS_MKDIR, path as i64, len)
        if result < 0
            sys_write(STDERR, c"mkdir: ", 7)
            sys_write(STDERR, path, len)
            sys_write(STDERR, c": ", 2)
            errno_write(STDERR, errno_from_raw(result as i32))
            sys_write(STDERR, c"\n", 1)
            status = 1
    status
