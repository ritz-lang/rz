import ritzlib.errno { errno_from_raw, errno_write }
import ritzlib.span { Span }
import ritzlib.strview { StrView }
import ritzlib.sys { STDERR }
import tool_io { make_directory }

pub fn main(args: Span<StrView>) -> i32
    let usage: StrView = "Usage: mkdir <directory>...\n"
    if args.len == 2 and args.get(1).eq("--help")
        print("{usage}")
        return 0

    var first: i64 = 1
    if args.len > 1 and args.get(1).eq("--")
        first = 2
    else if args.len > 1 and args.get(1).starts_with("-")
        eprint("{usage}")
        return 2

    if args.len <= first
        eprint("{usage}")
        return 2

    var status: i32 = 0
    for index in first..args.len
        let path: StrView = args.get(index)
        let result: i64 = make_directory(path)
        if result < 0
            eprint("mkdir: {path}: ")
            errno_write(STDERR, errno_from_raw(result as i32))
            eprint("\n")
            status = 1
    status
