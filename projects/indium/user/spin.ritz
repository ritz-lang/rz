# spin: a program that never ends by itself (AGAST #4254)
#
# Prints one line, then computes forever in ring 3 without a syscall. The
# serial session boot test runs it from rzsh and types Ctrl-C: the kernel
# must kill it from COM1's interrupt (it never enters the kernel on its own)
# and rzsh must prompt again, with $? = 130.

import libharland { print_str }

var g_spin_count: u64 = 0

pub fn main() -> i32
    print_str(c"spin: running, Ctrl-C stops me\n")
    # 2^64 iterations: forever, as far as the test is concerned.
    g_spin_count = 1
    # The asm keeps the optimiser from folding the loop away.
    while g_spin_count != 0
        asm x86_64:
            pause
        g_spin_count = g_spin_count + 1
    return 0
