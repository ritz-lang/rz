# fd_isolation_child: the child half of init's fd isolation test (AGAST #2753).
#
# init holds /etc/motd open as fd 3 and spawns this. Each process has its own
# fd table, so this open of /etc/hostname must also get fd 3 and read
# /etc/hostname's bytes. The fd is left open on purpose: exit must release
# it, so init's next open gets 4 and the next run of this child gets fd 3
# again. Exit 0 = PASS.

import libharland { print_str, print_int }
import ritzlib.sys { sys_read, sys_open, O_RDONLY }

pub fn main() -> i32
    let fd: i32 = sys_open(c"/etc/hostname", O_RDONLY)
    if fd != 3
        print_str(c"[fd_isolation_child] FAIL: open expected fd 3, got ")
        print_int(fd as i64)
        print_str(c"\n")
        return 1
    var buf: [8]u8
    let n: i64 = sys_read(fd, @buf[0], 7)
    # /etc/hostname is "harland\n"
    if n != 7 or buf[0] != 104 or buf[6] != 100
        print_str(c"[fd_isolation_child] FAIL: fd 3 did not read /etc/hostname\n")
        return 2
    print_str(c"[fd_isolation_child] PASS: own fd 3, left open\n")
    return 0
