# portable_getpid.ritz - Cross-platform PID test
#
# This program demonstrates the cross-platform syscall abstraction
# including the Harland-specific sys_getpid() syscall.
#
# Build for Harland: ritz0.py --target-os harland portable_getpid.ritz
# (`rz build indium` builds it with target_os = "harland").

# ============================================================================
# Syscalls
# ============================================================================
# Numbers and wrappers come from ritzlib.sys, whose harland block is diffed
# against the kernel's `enum Syscall` (AGAST #2122). A private table here once
# sent sys_yield as Spawn (21) and sys_getpid as Wait (22) (AGAST #2133).

import ritzlib.sys { sys_write, sys_exit, sys_yield, sys_getpid }

# ============================================================================
# Helper to print a single digit
# ============================================================================

fn print_digit(n: i32)
    var digit: u8 = (n + 0x30) as u8
    sys_write(1, @digit as *u8, 1)

# ============================================================================
# Main entry point
# ============================================================================

pub fn main() -> i32
    # FIRST: Make a simple syscall to verify the SYSCALL mechanism works
    # Don't do any I/O directly - that causes #GP in Ring 3
    # Just do sys_getpid() which is the simplest syscall
    let pid: i32 = sys_getpid()

    # Print message
    let msg1: *u8 = c"Hello from PID "
    sys_write(1, msg1, 15)

    # Print PID (single digit for now since we know it's 1)
    print_digit(pid)

    let msg2: *u8 = c"!\n"
    sys_write(1, msg2, 2)

    # Test yield
    let msg3: *u8 = c"Calling sys_yield()...\n"
    sys_write(1, msg3, 23)
    sys_yield()

    let msg4: *u8 = c"Back from yield!\n"
    sys_write(1, msg4, 17)

    # Exit cleanly
    sys_exit(0)
    return 0
