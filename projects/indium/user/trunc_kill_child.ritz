# trunc_kill_child: killed between an O_TRUNC open and the write (#4830).
#
# Usage: trunc_kill_child PATH
# Opens PATH with O_WRONLY | O_TRUNC, as an editor's save does, then reads
# address 0 before writing anything. The kernel kills it for the ring-3 page
# fault (exit 128 + 14 = 142, as for fault_child) and closes its fds through
# fs_process_end. write_empty_test spawns it and checks PATH still holds its
# old bytes: a save that dies before its write leaves the old file, never an
# empty one. Exit 1 if PATH is missing or the open fails, so the parent sees
# a child that never reached the kill.
#
# The load is inline asm so no compiler can fold or drop the null read.

import ritzlib.span { Span }
import ritzlib.strview { StrView }
import ritzlib.sys { O_WRONLY, O_TRUNC }
import tool_io { open_path }

pub fn main(args: Span<StrView>) -> i32
    if args.len < 2
        print("[trunc_kill_child] FAIL: no path\n")
        return 1
    let fd: i32 = open_path(args[1], O_WRONLY | O_TRUNC)
    if fd < 0
        print("[trunc_kill_child] FAIL: open returned {fd}\n")
        return 1
    asm x86_64:
        xorq %rax, %rax
        movq (%rax), %rax
    # Reached only if the read did not fault.
    print("[trunc_kill_child] FAIL: read of address 0 did not fault\n")
    return 1
