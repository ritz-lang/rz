# Native views at the command boundary, raw buffers at the Harland syscall ABI.
import ritzlib.span { Span }
import ritzlib.string { String }
import ritzlib.strview { StrView }
import ritzlib.sys { SYS_MKDIR, syscall2, sys_open, sys_read, sys_write }
import ritzlib.errno { Errno }
import ritzlib.path { path_absolute }

# The kernel takes absolute paths only (AGAST #4776): each path is resolved
# against the cwd here, `.` and `..` included, before the syscall.

# open(2) on the resolved path `filename`; -errno on failure.
fn open_resolved(filename: @&String, flags: i32) -> i32
    let raw: *u8 = filename.as_ptr()
    if raw == null
        # ritz1 cannot call a method on a qualified variant literal
        # (`Errno.NoMem.code()`), so the variant is bound to a local first.
        let no_mem: Errno = Errno.NoMem
        return -no_mem.code()
    sys_open(raw, flags)

pub fn open_path(path: StrView, flags: i32) -> i32
    match path_absolute(path)
        Ok(filename) => open_resolved(@&filename, flags)
        Err(e) => -e.code()

pub fn make_directory(path: StrView) -> i64
    match path_absolute(path)
        Ok(absolute) => syscall2(SYS_MKDIR, absolute.as_view().ptr as i64, absolute.len())
        Err(e) => -(e.code() as i64)

pub fn read_bytes(fd: i32, buffer: Span<u8>) -> i64
    sys_read(fd, buffer.ptr, buffer.len)

pub fn write_bytes(fd: i32, data: Span<u8>) -> bool
    var remaining: Span<u8> = data
    while not remaining.is_empty()
        let count: i64 = sys_write(fd, remaining.ptr, remaining.len)
        if count <= 0
            return false
        remaining = remaining.slice(count, remaining.len)
    true
