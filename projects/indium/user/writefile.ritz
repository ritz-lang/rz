# Write a line from the shell and flush Goliath storage.
import ritzlib.sys { sys_open, sys_write, sys_close, sys_sync, O_WRONLY, O_CREAT, O_TRUNC }
import ritzlib.str { strlen }
import libharland { print_str }

pub fn main(argc: i32, argv: **u8) -> i32
    if argc != 3
        print_str(c"Usage: writefile <path> <text>\n")
        return 2

    let path: *u8 = *(argv + 1)
    let content: *u8 = *(argv + 2)
    let fd: i32 = sys_open(path, O_WRONLY | O_CREAT | O_TRUNC)
    if fd < 0
        print_str(c"writefile: could not open file\n")
        return 1

    let size: i64 = strlen(content)
    let written: i64 = sys_write(fd, content, size)
    var newline_written: i64 = 0
    if written == size
        newline_written = sys_write(fd, c"\n", 1)
    let closed: i32 = sys_close(fd)
    if written != size or newline_written != 1 or closed < 0
        print_str(c"writefile: could not write file\n")
        return 1

    if sys_sync() < 0
        print_str(c"writefile: could not sync Goliath storage\n")
        return 1
    0
