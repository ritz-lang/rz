# Write a line from the shell and flush Goliath storage.
import ritzlib.span { Span, span_from_strview }
import ritzlib.strview { StrView }
import ritzlib.sys { sys_close, sys_sync, O_WRONLY, O_CREAT, O_TRUNC }
import tool_io { open_path, write_bytes }

pub fn main(args: Span<StrView>) -> i32
    if args.len != 3
        eprint("Usage: writefile <path> <text>\n")
        return 2

    let fd: i32 = open_path(args.get(1), O_WRONLY | O_CREAT | O_TRUNC)
    if fd < 0
        eprint("writefile: could not open file\n")
        return 1

    let written: bool = write_bytes(fd, span_from_strview(args.get(2))) and
        write_bytes(fd, span_from_strview("\n"))
    let closed: i32 = sys_close(fd)
    if not written or closed < 0
        eprint("writefile: could not write file\n")
        return 1

    if sys_sync() < 0
        eprint("writefile: could not sync Goliath storage\n")
        return 1
    0
