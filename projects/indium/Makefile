# Indium Distribution Makefile
# Builds userspace, kernel, and creates bootable images

# ============================================================================
# Configuration
# ============================================================================

# Paths
HARLAND_DIR = ../harland
BUILD_DIR = build
KERNEL_ELF = $(HARLAND_DIR)/build/debug/harland.elf
BOOTLOADER = $(HARLAND_DIR)/build/debug/BOOTX64.EFI
ISO_FILE = $(BUILD_DIR)/indium.iso
UEFI_DISK = $(BUILD_DIR)/uefi-boot.img
SHELL_DISK = $(BUILD_DIR)/uefi-shell.img
SHELL_TAR = $(BUILD_DIR)/shell-initramfs.tar
SHELL_STORAGE ?= $(BUILD_DIR)/shell-storage.qcow2

# QEMU
QEMU = qemu-system-x86_64
# Haswell CPU needed for BMI1 instructions (bextr) generated by LLVM
QEMU_CPU = -cpu Haswell-v1

# Find OVMF firmware
OVMF_CODE := $(shell for p in /usr/share/OVMF/OVMF_CODE_4M.fd /usr/share/OVMF/OVMF_CODE.fd /usr/share/edk2/x64/OVMF_CODE.4m.fd; do [ -f "$$p" ] && echo "$$p" && break; done)

# Packages in the initramfs: initramfs.pkgs, the one list, staged by
# tools/stage_initramfs.sh for this Makefile, tools/mkiso.sh and harland's
# boot scripts alike (AGAST #2759, #4834). Their ELFs are staged in
# INITRAMFS_BIN, not indium's own build/debug, which lacked prism's hello_gfx.
INITRAMFS_BIN = $(BUILD_DIR)/initramfs-bin

# Headless runs: make run-uefi QEMU_DISPLAY="-display none"
QEMU_DISPLAY ?=

# VirtIO disks
INITRAMFS = $(BUILD_DIR)/initramfs.qcow2
STORAGE = $(BUILD_DIR)/storage.qcow2

# ============================================================================
# Phony targets
# ============================================================================

.PHONY: all clean kernel userspace initramfs-bin iso run run-iso run-uefi shell shell-image debug test test-uefi test-uefi-gui ec2-disk ec2-boot help

all: iso

# ============================================================================
# Build targets
# ============================================================================

# Build the Harland kernel (delegates to harland project)
kernel:
	@echo "=== Building Harland Kernel ==="
	$(MAKE) -C $(HARLAND_DIR) kernel

# Build userspace programs
userspace:
	@echo "=== Building Indium Userspace ==="
	../../rz build indium

# Build bootable ISO with kernel and userspace
iso: kernel
	@echo "=== Creating Indium ISO ==="
	@mkdir -p $(BUILD_DIR)
	./tools/mkiso.sh

# Create UEFI boot disk (uses mtools, no root required)
$(UEFI_DISK): BOOT_TAR = $(BUILD_DIR)/initramfs.tar
$(SHELL_DISK): BOOT_TAR = $(SHELL_TAR)
$(UEFI_DISK) $(SHELL_DISK): kernel
	@echo "=== Creating UEFI Boot Disk ==="
	@mkdir -p $(BUILD_DIR)
	@# 64MB FAT32 image: BOOTX64.EFI, harland/kernel.elf, startup.nsh and
	@# harland/initramfs.tar, which BOOTX64.EFI hands the kernel in BootInfo
	@# (AGAST #4253), so the disk boots with no virtio-blk initramfs disk.
	@# tools/mkuefi.py logs and time-limits each step and never runs dd,
	@# which hung here (AGAST #2748).
	@echo '@echo -off' > $@.startup.nsh
	@echo 'FS0:\EFI\BOOT\BOOTX64.EFI' >> $@.startup.nsh
	python3 ./tools/mkuefi.py $@ $(BOOTLOADER) $(KERNEL_ELF) $@.startup.nsh $(BOOT_TAR)

$(UEFI_DISK): $(BUILD_DIR)/initramfs.tar
$(SHELL_DISK): $(SHELL_TAR)

# Create EC2-compatible UEFI boot disk with GPT partition table
# EC2 requires a proper GPT with EFI System Partition for UEFI boot
# Layout: one partition, the ESP (FAT32, sector 2048 to the end, ~127MB):
#   /EFI/BOOT/BOOTX64.EFI, /harland/kernel.elf, /harland/initramfs.tar,
#   /startup.nsh
# Nitro has NVMe, no virtio-blk, so the kernel can't read a raw TAR disk:
# BOOTX64.EFI reads harland/initramfs.tar with the UEFI file protocol and
# passes it in BootInfo (AGAST #4253). The raw-TAR partition 2 is gone.
EC2_DISK = $(BUILD_DIR)/ec2-boot.img
EC2_INITRAMFS = $(BUILD_DIR)/ec2-initramfs.tar
#
# The EC2 initramfs runs init_interactive, as `make shell` does: the instance
# boots to an rzsh prompt on the serial console instead of running init's
# test suite and powering off (AGAST #1849).
#
# tools/mkec2disk.py builds the disk without root: no sudo, losetup, sgdisk
# or mkfs.vfat, none of which a task room has (AGAST #1849).
#
# EC2_NET_RESPONDER=1 also writes the \harland\net-responder marker: the
# acceptance boot (AGAST #1851) then keeps polling for a peer instance's ping.
# The stamp file makes toggling the flag rebuild the image; a plain
# `make ec2-disk` never waits for a peer that is not there.
EC2_NET_RESPONDER ?= 0
EC2_RESPONDER_STAMP = $(BUILD_DIR)/.ec2-net-responder-$(EC2_NET_RESPONDER)
EC2_DISK_ARGS = $(if $(filter 1,$(EC2_NET_RESPONDER)),--net-responder,)
ec2-disk: $(EC2_DISK)

$(EC2_INITRAMFS): initramfs-bin
	python3 $(HARLAND_DIR)/tools/mkinitramfs.py --bin-dir $(INITRAMFS_BIN) \
		--init init_interactive --output $@

$(EC2_RESPONDER_STAMP):
	@mkdir -p $(BUILD_DIR)
	@rm -f $(BUILD_DIR)/.ec2-net-responder-*
	@touch $@

$(EC2_DISK): kernel $(EC2_INITRAMFS) $(EC2_RESPONDER_STAMP)
	@echo "=== Creating EC2 Boot Disk (GPT + ESP) ==="
	@mkdir -p $(BUILD_DIR)
	python3 ./tools/mkec2disk.py $@ $(BOOTLOADER) $(KERNEL_ELF) $(EC2_INITRAMFS) $(EC2_DISK_ARGS)

# One guarded boot on a real Nitro t3.micro: build, snapshot, apply, poll the
# serial console for rzsh, save the log to boot-logs/, destroy everything.
# Needs the DEFAULT AWS profile on account 412381736149. Never from CI.
# EC2_BOOT_ARGS=--dry-run touches no AWS.
ec2-boot:
	./iac/run.sh $(EC2_BOOT_ARGS)

# ============================================================================
# Run targets
# ============================================================================

# Build every package in initramfs.pkgs and stage its ELFs in INITRAMFS_BIN,
# each with the compiler its entry names (Buddhafinger: the builder image's
# ritz1_selfhosted). A package that builds no ELF is an error, not a
# silently thinner initramfs.
initramfs-bin:
	bash ./tools/stage_initramfs.sh $(INITRAMFS_BIN)

# Create initramfs TAR from the staged packages
$(BUILD_DIR)/initramfs.tar: initramfs-bin
	@echo "=== Creating Initramfs TAR ==="
	python3 $(HARLAND_DIR)/tools/mkinitramfs.py \
		--bin-dir $(INITRAMFS_BIN) \
		--output $(BUILD_DIR)/initramfs.tar

# Create QCOW2 initramfs disk for QEMU
$(INITRAMFS): $(BUILD_DIR)/initramfs.tar
	@echo "=== Creating Initramfs QCOW2 ==="
	python3 $(HARLAND_DIR)/tools/mkinitramfs.py \
		--bin-dir $(INITRAMFS_BIN) \
		--output $(INITRAMFS)

$(STORAGE) $(SHELL_STORAGE):
	@mkdir -p "$(@D)"
	qemu-img create -f qcow2 "$@" 512M

# Default run: BIOS/ISO (most reliable)
run: run-iso

# Run with ISO (BIOS/Multiboot2 boot) - most reliable
run-iso: iso $(INITRAMFS) $(STORAGE)
	$(QEMU) $(QEMU_CPU) \
		-cdrom $(ISO_FILE) \
		-device virtio-blk-pci,drive=initramfs \
		-drive file=$(INITRAMFS),format=qcow2,if=none,id=initramfs \
		-device virtio-blk-pci,drive=storage \
		-drive file=$(STORAGE),format=qcow2,if=none,id=storage \
		-device virtio-net-pci,netdev=net0 \
		-netdev user,id=net0 \
		-device virtio-keyboard-pci \
		-device virtio-mouse-pci \
		-m 4G \
		-smp 4 \
		-serial mon:stdio \
		-no-reboot

# Run with UEFI (uses mtools-based disk image)
run-uefi: $(UEFI_DISK) $(INITRAMFS) $(STORAGE)
	@if [ -z "$(OVMF_CODE)" ]; then echo "ERROR: OVMF not found. Install ovmf package."; exit 1; fi
	$(QEMU) $(QEMU_CPU) \
		-drive if=pflash,format=raw,readonly=on,file=$(OVMF_CODE) \
		-drive format=raw,file=$(UEFI_DISK) \
		-device virtio-blk-pci,drive=initramfs \
		-drive file=$(INITRAMFS),format=qcow2,if=none,id=initramfs \
		-device virtio-blk-pci,drive=storage \
		-drive file=$(STORAGE),format=qcow2,if=none,id=storage \
		-device virtio-net-pci,netdev=net0 \
		-netdev user,id=net0 \
		-device virtio-keyboard-pci \
		-device virtio-mouse-pci \
		-m 256M \
		-smp 4 \
		-serial mon:stdio $(QEMU_DISPLAY) \
		-no-reboot

# Build a UEFI disk with init_interactive as /bin/init. The loader reads
# the initramfs from the boot disk and passes it to Harland in BootInfo.
$(SHELL_TAR): initramfs-bin
	python3 $(HARLAND_DIR)/tools/mkinitramfs.py --bin-dir $(INITRAMFS_BIN) \
		--init init_interactive --output $@

shell-image: $(SHELL_DISK) $(SHELL_STORAGE)

# Harland uses the second VirtIO block device for Goliath. Attach the boot
# disk first, so the shell only needs one other disk for persistent /var.
shell: QEMU_DISPLAY = -display none
shell: shell-image
	@if [ -z "$(OVMF_CODE)" ]; then echo "ERROR: OVMF not found. Install ovmf package."; exit 1; fi
	@echo "=== Booting to rzsh on this terminal (Ctrl-A x quits QEMU) ==="
	$(QEMU) $(QEMU_CPU) -smp 4 -m 2G \
		-drive if=pflash,format=raw,readonly=on,file=$(OVMF_CODE) \
		-drive file=$(SHELL_DISK),format=raw,if=none,id=boot \
		-device virtio-blk-pci,drive=boot,bootindex=1 \
		-drive file="$(SHELL_STORAGE)",format=qcow2,if=none,id=storage \
		-device virtio-blk-pci,drive=storage \
		-device virtio-net-pci,netdev=net0 \
		-netdev user,id=net0 \
		-serial mon:stdio $(QEMU_DISPLAY) \
		-no-reboot

# Run with GDB server for debugging (BIOS mode)
debug: iso $(INITRAMFS) $(STORAGE)
	$(QEMU) $(QEMU_CPU) \
		-cdrom $(ISO_FILE) \
		-device virtio-blk-pci,drive=initramfs \
		-drive file=$(INITRAMFS),format=qcow2,if=none,id=initramfs \
		-device virtio-blk-pci,drive=storage \
		-drive file=$(STORAGE),format=qcow2,if=none,id=storage \
		-device virtio-net-pci,netdev=net0 \
		-netdev user,id=net0 \
		-m 4G \
		-smp 4 \
		-serial mon:stdio \
		-no-reboot \
		-d int,cpu_reset \
		-S -s

# Debug with UEFI
debug-uefi: $(UEFI_DISK) $(INITRAMFS) $(STORAGE)
	@if [ -z "$(OVMF_CODE)" ]; then echo "ERROR: OVMF not found. Install ovmf package."; exit 1; fi
	$(QEMU) $(QEMU_CPU) \
		-drive if=pflash,format=raw,readonly=on,file=$(OVMF_CODE) \
		-drive format=raw,file=$(UEFI_DISK) \
		-device virtio-blk-pci,drive=initramfs \
		-drive file=$(INITRAMFS),format=qcow2,if=none,id=initramfs \
		-device virtio-blk-pci,drive=storage \
		-drive file=$(STORAGE),format=qcow2,if=none,id=storage \
		-device virtio-net-pci,netdev=net0 \
		-netdev user,id=net0 \
		-m 256M \
		-smp 4 \
		-serial mon:stdio \
		-no-reboot \
		-d int,cpu_reset \
		-S -s

# ============================================================================
# Test targets
# ============================================================================

# Test kernel boot (delegates to harland's test)
test: kernel
	$(MAKE) -C $(HARLAND_DIR) test-boot

# Test UEFI boot (delegates to harland's test)
test-uefi: kernel
	$(MAKE) -C $(HARLAND_DIR) test-uefi-boot

# Test UEFI boot with GUI display (shows framebuffer)
test-uefi-gui: kernel
	$(MAKE) -C $(HARLAND_DIR) test-uefi-gui

# ============================================================================
# Clean
# ============================================================================

clean:
	rm -rf $(BUILD_DIR)
	../../rz clean indium

# ============================================================================
# Help
# ============================================================================

help:
	@echo "Indium Distribution Build System"
	@echo ""
	@echo "Build Targets:"
	@echo "  all         - Build ISO (default)"
	@echo "  kernel      - Build Harland kernel"
	@echo "  userspace   - Build indium's own userspace programs"
	@echo "  initramfs-bin - Build and stage every package in initramfs.pkgs"
	@echo "  iso         - Create bootable ISO with GRUB"
	@echo "  shell-image - Build the UEFI shell image and create its Goliath disk"
	@echo "  ec2-disk    - Create EC2-compatible UEFI disk (GPT + ESP), rootless"
	@echo "  ec2-boot    - Boot it once on a t3.micro, save the serial log (iac/run.sh)"
	@echo ""
	@echo "Run Targets:"
	@echo "  run         - Boot in QEMU (BIOS/GRUB mode, default)"
	@echo "  run-iso     - Boot in QEMU (BIOS/GRUB mode)"
	@echo "  run-uefi    - Boot in QEMU (UEFI mode); headless: QEMU_DISPLAY=\"-display none\""
	@echo "  shell       - Boot to an rzsh prompt on this terminal (serial; Ctrl-A x quits)"
	@echo "  debug       - Boot with GDB server on :1234 (BIOS)"
	@echo "  debug-uefi  - Boot with GDB server on :1234 (UEFI)"
	@echo ""
	@echo "Test Targets:"
	@echo "  test        - Run kernel boot test (BIOS)"
	@echo "  test-uefi   - Run kernel boot test (UEFI, headless)"
	@echo "  test-uefi-gui - Test UEFI with display (see framebuffer)"
	@echo ""
	@echo "Other:"
	@echo "  clean       - Remove build artifacts"
	@echo "  help        - Show this help"
