#!/usr/bin/env python3
"""
rz - Unified workspace CLI for the Ritz ecosystem

Usage:
    rz build [PROJECT]     Build a project (or all with --all)
    rz test [PROJECT]      Run tests for a project (or all with --all)
    rz run PROJECT         Build and run a project
    rz list                List all projects in workspace
    rz clean [PROJECT]     Clean build artifacts
    rz cache [gc|path]     Shared artifact store

Compiler Selection:
    --compiler ritz0       Use Python bootstrap compiler (default)
    --compiler ritz1       Use self-hosted Ritz compiler

Examples:
    rz build tome                Build the tome project
    rz test --all                Run all tests
    rz run nexus                 Build and run nexus
    rz build --compiler ritz1    Build with self-hosted compiler
"""

import argparse
import json
import os
import subprocess
import sys
from pathlib import Path

# Workspace root is where this script lives
WORKSPACE_ROOT = Path(__file__).parent.resolve()
PROJECTS_DIR = WORKSPACE_ROOT / "projects"
RITZ_BUILD = WORKSPACE_ROOT / "projects" / "ritz" / "build.py"

# The dependency resolver build.py uses (AGAST #1835). Standard library only,
# so importing it does not load the compiler.
sys.path.insert(0, str(RITZ_BUILD.parent))
# known_failures: the one known-failures schema and outcome rule, shared with
# the matrix, regression.sh, example_tests and check_doc_examples (AGAST #1834).
sys.path.insert(0, str(RITZ_BUILD.parent / "tools"))
import known_failures

# manifest: the ritz.toml / rz.toml schema every manifest is loaded through
# (AGAST #1837).
import bounded_run  # noqa: E402
import manifest
from resolve import dependency_package_dirs  # noqa: E402

# Global compiler selection (can be overridden per command)
COMPILER = "ritz0"  # default


def load_workspace_config():
    """Load rz.toml workspace configuration."""
    config_path = WORKSPACE_ROOT / "rz.toml"
    if not config_path.exists():
        print(f"Error: {config_path} not found", file=sys.stderr)
        sys.exit(1)

    return manifest.load(config_path)


def discover_projects():
    """Every package named by rz.toml [workspace].members, as a project id.

    A project id is the package directory relative to projects/, so
    top-level projects keep their bare names ("ritz", "lexis"), which is
    what a `build` known-failures entry and `rz build <name>` key on. A nested
    member reads "ritz/ritzlib/tests", and a member outside projects/ reads
    "../bench/...". Every caller joins the id onto PROJECTS_DIR, so all three
    resolve the same way.

    This function used to walk projects/*/ by hand and never read
    `members` (AGAST #1345). The declared list was decorative, so
    ritzlib's own suite (projects/ritz/ritzlib/tests) and both bench
    members were in no gate while rz.toml claimed otherwise.

    A member pattern that matches no package is an error, not a skip. A
    named thing that has vanished from disk must not quietly disable its
    own coverage. The regression matrix's RITZLIB_MODULES follows the same
    rule.

    Patterns are pathlib globs, so `projects/**` reaches packages at any
    depth (AGAST #1383). With a one-level `projects/*`, a nested package
    nobody remembered to list was in no gate, and nothing said so:
    ritzunit/inventory went from compile-failed to 24 passing unobserved.
    Anything a `**` walk must NOT sweep goes in [workspace.exclude], each
    entry naming the gate that does cover it (see workspace_exclusions).
    """
    config = load_workspace_config()
    patterns = config.get("workspace", {}).get("members")
    if not patterns:
        sys.exit("rz.toml: [workspace].members is missing or empty")
    exclusions = workspace_exclusions(config)
    excluded_dirs = [(WORKSPACE_ROOT / e).resolve() for e in exclusions]

    projects = set()
    used = set()
    for pattern in patterns:
        # Glob for the manifest, not the directory: `projects/**` would
        # otherwise yield every directory in the tree only to discard most.
        matches = sorted(m.parent.resolve()
                         for m in WORKSPACE_ROOT.glob(f"{pattern}/ritz.toml")
                         if m.is_file())
        if not matches:
            sys.exit(f"rz.toml: workspace member {pattern!r} matches no "
                     f"package (no directory with a ritz.toml)")
        for pkg in matches:
            hits = {e for e, d in zip(exclusions, excluded_dirs)
                    if pkg == d or d in pkg.parents}
            if hits:
                used |= hits
                continue
            projects.add(os.path.relpath(pkg, PROJECTS_DIR.resolve()))

    # A stale exclusion is a rotted allowlist: once its package moves, it
    # keeps "excusing" nothing while looking like a decision.
    stale = [e for e in exclusions if e not in used]
    if stale:
        sys.exit(f"rz.toml: [workspace.exclude] entries match no package "
                 f"that `members` would sweep: {', '.join(stale)}")
    return sorted(projects)


def workspace_exclusions(config=None):
    """rz.toml [workspace.exclude] as a validated {path: reason} dict.

    Each key is a workspace-relative directory. It removes that directory
    and everything below it from discovery, matched by path component, so
    excluding `a/ex` leaves `a/examples` alone. Each value says which gate
    covers the excluded packages instead. An empty reason is an error,
    because an exclusion with no stated cover is just a package hidden
    from every gate.
    """
    if config is None:
        config = load_workspace_config()
    table = config.get("workspace", {}).get("exclude", {})
    if not isinstance(table, dict):
        sys.exit("rz.toml: [workspace.exclude] must be a table of "
                 "path = \"reason\"")
    out = {}
    for path, reason in table.items():
        if not isinstance(reason, str) or not reason.strip():
            sys.exit(f"rz.toml: [workspace.exclude] {path!r} needs a reason "
                     f"naming the gate that covers it")
        out[path.rstrip("/")] = reason
    return out


def resolve_project(arg):
    """Map a project argument to its project id, or None if it is no package.

    Accepts a project id ("ritz", "ritzunit/inventory") or a path to the
    package directory: workspace-relative ("projects/ritzunit/inventory"),
    cwd-relative, or absolute. `rz test projects/ritzunit/inventory` used to
    join the argument onto projects/ and report "Project not found"
    (AGAST #1383).

    Resolution is by ritz.toml, not by membership: an excluded package such
    as an example can still be built by path, it just is not swept by --all.
    """
    for base in (PROJECTS_DIR, WORKSPACE_ROOT, Path.cwd()):
        pkg = (base / arg).resolve()
        if (pkg / "ritz.toml").is_file():
            return os.path.relpath(pkg, PROJECTS_DIR.resolve())
    return None


def _resolve_or_report(arg):
    """resolve_project for a CLI argument, printing the error on failure."""
    project = resolve_project(arg)
    if project is None:
        print(f"Error: Project '{arg}' not found (no ritz.toml there)",
              file=sys.stderr)
    return project


def get_project_config(project_name):
    """Load a project's ritz.toml configuration."""
    config_path = PROJECTS_DIR / project_name / "ritz.toml"
    if not config_path.exists():
        return None

    return manifest.load(config_path)


def collect_dependency_paths(project_name):
    """The project's directory, then every package it depends on.

    resolve.py's walk, the one build.py's resolver shares (AGAST #1835):
    depth-first in declaration order, each package once. This used to be its
    own walk, which followed a dependency's dependencies only when it sat
    directly under projects/, so a nested package's were never on RITZ_PATH.
    """
    return dependency_package_dirs(PROJECTS_DIR / project_name)


def child_env(project_name):
    """Environment for a build.py child: dependency RITZ_PATH + unbuffered stdio.

    PYTHONUNBUFFERED matters more than it looks. When CI pipes our stdout,
    the parent's "Testing: <project>" banners sit in an 8 KB block buffer
    until this process exits, while each child's diagnostics flush when the
    child exits. The CI log then shows all the diagnostics first (orphaned,
    unattributed) and every banner back-to-back at the end — which is how
    `rz test --all` came to report "12 projects failed" with apparently zero
    output between the banners (AGAST #1324). Unbuffered children plus
    flushed banners (see the --all loops) keep cause next to effect.
    """
    # Collect all dependency paths for RITZ_PATH (for lib.* imports in dependencies)
    dep_paths = collect_dependency_paths(project_name)
    # Always include ritz for ritzlib
    dep_paths.append(PROJECTS_DIR / "ritz")
    # Build colon-separated RITZ_PATH using absolute paths
    ritz_path = ":".join(str(p.resolve()) for p in dep_paths)

    env = os.environ.copy()
    env["RITZ_PATH"] = ritz_path
    env["PYTHONUNBUFFERED"] = "1"
    return env


def sweep_results(failed, ran):
    """{project: "pass" | "fail"} for known_failures.outcome, failures first
    and in `failed` order (the order the verdict lines print in)."""
    results = {p: "fail" for p in failed}
    for p in ran:
        results.setdefault(p, "pass")
    return results


# AGAST #2141: build.py's exit code for "every failure was a missing tool"
# (build.EXIT_SETUP). A sweep whose only unexcused failures are setup errors
# exits with it too: neither a pass nor a regression.
EXIT_SETUP = 3


def summarize_gate(kind, failed, known_failing, ran, setup=None):
    """Print the end-of-sweep gate summary; return the process exit code.

    The known-failing list is deliberately NOT continue-on-error: excused
    failures are printed with their justification (each cites its AGAST
    task — enforced at load time by tools/known_failures.py), and an excused
    project that starts passing fails the gate until it is delisted. Strict
    xpass forces stale entries OUT; it does not prevent new entries being
    added — additions are a review-time concern.

    Both sweeps read the `build` gate's entries (see cmd_test for why there
    is no test-side excuse).

    `setup` names failed projects whose build exited EXIT_SETUP: a missing
    toolchain binary, the machine's fault (AGAST #2141). Unexcused, they are
    listed as SETUP ERROR rather than as failures, and alone make the exit
    EXIT_SETUP; any real failure or xpass still exits 1.
    """
    o = known_failures.outcome(known_failing, sweep_results(failed, ran))
    hard, known, xpass = o.hard, list(o.known), o.xpass
    setup_set = set(setup or ())
    setup_err = [p for p in hard if p in setup_set]
    hard = [p for p in hard if p not in setup_set]

    # One verdict line per package (AGAST #3969), in the `PKG <VERDICT> <id>`
    # form train.sh's package step prints, so the room gate's log says what
    # happened to each package and run-gate.sh --wait (`grep '^PKG '`)
    # surfaces it. Passes first, then the verdicts that matter, so a FAIL is
    # last and survives --wait's `tail -20`.
    print(flush=True)
    failed_set = set(failed)
    for p in ran:
        if p not in failed_set and p not in xpass:
            print(f"PKG PASS {p}", flush=True)
    for p in known:
        print(f"PKG KNOWN {p}: {known_failing[p]}", flush=True)
    for p in xpass:
        print(f"PKG XPASS {p}: excused in {KNOWN_WHERE} but passed",
              flush=True)
    for p in setup_err:
        print(f"PKG SETUP {p}: a missing tool, not a regression", flush=True)
    for p in hard:
        print(f"PKG FAIL {p}", flush=True)

    print(flush=True)
    if known:
        print(f"⚠ {len(known)} known-failing project(s) still failing "
              f"(advisory, tracked in {KNOWN_WHERE}):",
              flush=True)
        for p in known:
            print(f"    {p} — {known_failing[p]}", flush=True)
    if xpass:
        print(f"🎉 known-failing project(s) now PASS: {', '.join(xpass)}",
              flush=True)
        print("    Remove their entries from known-failures/<agast>.toml "
              "(and close the task) — this gate fails until the list is "
              "accurate.", flush=True)
    if setup_err:
        print(f"⚠ SETUP ERROR — not verified on this machine (a missing tool, "
              f"not a regression; see the project's log above): "
              f"{', '.join(setup_err)}", flush=True)
    if hard:
        print(f"✗ Failed {kind}: {', '.join(hard)}", flush=True)
        return 1
    if xpass:
        return 1
    if setup_err:
        return EXIT_SETUP
    gating = len(ran) - len(known)
    print(f"✓ All {gating} gating project(s) passed {kind} "
          f"({len(known)} known-failing excluded, listed above)."
          if known else
          f"✓ All {gating} project(s) passed {kind}.", flush=True)
    return 0


# Where the build gate's excuses live, as the summary names it.
KNOWN_WHERE = 'known-failures/ (gate = "build")'


def known_failing_from_config(compiler="any"):
    """The `build` gate's excuses, {project: "AGAST #n: reason"}, from
    known-failures/<agast>.toml via tools/known_failures.py (AGAST #1834):
    the `any` entries plus those naming `compiler`, the sweep's compiler
    (AGAST #4272: a package only ritz1 cannot build is excused under ritz1).

    The parser refuses an entry without a ticket, so `rz` refuses a
    malformed excuse rather than honouring it: exit 2, naming the file.
    """
    try:
        return known_failures.known("build", compiler)
    except known_failures.KnownFailuresError as e:
        print(f"rz: {e}", file=sys.stderr)
        sys.exit(2)


def run_build(project_name, extra_args=None):
    """Run build.py for a specific project."""
    project_dir = PROJECTS_DIR / project_name
    if not project_dir.exists():
        print(f"Error: Project '{project_name}' not found", file=sys.stderr)
        return 1

    env = child_env(project_name)

    cmd = [sys.executable, str(RITZ_BUILD), "build", str(project_dir)]
    if extra_args:
        cmd.extend(extra_args)

    result = bounded_run.child(cmd, env=env, cwd=WORKSPACE_ROOT)
    return result.returncode


def run_test(project_name, extra_args=None):
    """Run tests for a specific project."""
    project_dir = PROJECTS_DIR / project_name
    if not project_dir.exists():
        print(f"Error: Project '{project_name}' not found", file=sys.stderr)
        return 1

    env = child_env(project_name)

    cmd = [sys.executable, str(RITZ_BUILD), "test", str(project_dir)]
    if extra_args:
        cmd.extend(extra_args)

    result = bounded_run.child(cmd, env=env, cwd=WORKSPACE_ROOT)
    return result.returncode


# ---------------------------------------------------------------------------
# Parallel --all sweeps (AGAST #1809)
#
# `rz build --all` and `rz test --all` used to run one project at a time, and
# build.py ran each project's test files one at a time: 196 files back to
# back, 23m31s on CI, while #1808 had already made compiles cheap and
# concurrency-safe (content-addressed store, atomic writes, no shared index).
#
# Now every sweep is a flat set of UNITS on ONE bounded worker pool, so -j is
# the true ceiling on concurrent compiler/test processes (no per-project pool
# multiplying it):
#
#   build: one unit per project  (build.py build P)
#   test:  per project, a plan unit (build.py test P --unit-plan: builds the
#          package, reports its test files), then one unit per test file
#          (--unit-file) and one for test.sh (--unit-test-sh), scheduled when
#          the plan finishes.
#
# Output is buffered per unit and printed per project in discovery order,
# units in serial order — the same lines the serial sweep prints, whatever
# order units finish in. Verdicts feed summarize_gate unchanged, so the
# known_failing / strict-xpass semantics are the serial ones.
#
# -j 1 keeps the original streaming serial path; the acceptance check for
# this change is "same per-project verdicts serial vs parallel".
# ---------------------------------------------------------------------------

import heapq
import tempfile
import time
from concurrent.futures import FIRST_COMPLETED, ThreadPoolExecutor, wait
from dataclasses import dataclass, field


def resolve_jobs(cli_jobs, config=None):
    """Worker count: -j, else rz.toml [build] (parallel=false → 1,
    else max_jobs), else os.cpu_count(). Invalid values exit(2)."""
    if cli_jobs is not None:
        if isinstance(cli_jobs, bool) or not isinstance(cli_jobs, int) \
                or cli_jobs < 1:
            sys.exit(f"rz: -j must be a positive integer, got {cli_jobs!r}")
        return cli_jobs
    build = (config if config is not None else load_workspace_config()).get(
        "build", {})
    if build.get("parallel", True) is False:
        return 1
    if "max_jobs" in build:
        mj = build["max_jobs"]
        if isinstance(mj, bool) or not isinstance(mj, int) or mj < 1:
            sys.exit(f"rz.toml [build] max_jobs must be a positive integer, "
                     f"got {mj!r}")
        return mj
    return os.cpu_count() or 1


@dataclass
class Unit:
    """One schedulable subprocess. `order` is its print position (project
    index first); `sched` its priority on the pool (lower runs first)."""
    project: str
    order: tuple
    sched: tuple
    kind: str            # build | plan | file | test-sh
    cmd: list
    env: dict
    path: Path = None    # JSON the unit writes (plan / file result)
    file: str = None     # test file, for kind == "file"
    rc: int = None
    output: str = ""


def run_unit(unit):
    """Run a unit to completion, stdout+stderr merged in one buffer (so a
    unit's own diagnostics stay in order and next to its banner)."""
    proc = bounded_run.child(unit.cmd, env=unit.env, cwd=WORKSPACE_ROOT,
                          stdout=subprocess.PIPE, stderr=subprocess.STDOUT,
                          text=True, errors="replace")
    unit.rc, unit.output = proc.returncode, proc.stdout
    return unit


def run_pool(jobs, units, on_done):
    """Run `units` on at most `jobs` workers, lowest `sched` first.

    on_done(unit) is called on the calling thread as each unit finishes and
    returns follow-up units to schedule. Single-threaded bookkeeping: only
    run_unit runs on workers.
    """
    seq = 0
    ready = []

    def push(u):
        nonlocal seq
        heapq.heappush(ready, (u.sched, seq, u))
        seq += 1

    for u in units:
        push(u)
    running = set()
    with ThreadPoolExecutor(max_workers=jobs) as ex:
        while ready or running:
            while ready and len(running) < jobs:
                running.add(ex.submit(run_unit, heapq.heappop(ready)[2]))
            done, running = wait(running, return_when=FIRST_COMPLETED)
            for fut in sorted(done, key=lambda f: f.result().order):
                for nxt in on_done(fut.result()) or []:
                    push(nxt)


def _emit(text):
    if text:
        sys.stdout.write(text if text.endswith("\n") else text + "\n")


def _read_json(path):
    try:
        return json.loads(Path(path).read_text())
    except (OSError, ValueError):
        return None


_BUILDPY = None


def _buildpy():
    """build.py as a module, for summarize_file_outcomes: the Σ line must be
    build.py's own, not a copy that can drift from it."""
    global _BUILDPY
    if _BUILDPY is None:
        import importlib.util
        sys.path.insert(0, str(RITZ_BUILD.parent))
        spec = importlib.util.spec_from_file_location("_rz_buildpy",
                                                      RITZ_BUILD)
        _BUILDPY = importlib.util.module_from_spec(spec)
        spec.loader.exec_module(_BUILDPY)
    return _BUILDPY


class _InOrderPrinter:
    """Prints finished projects strictly in discovery order."""

    def __init__(self, n, render):
        self.done = [False] * n
        self.next = 0
        self.render = render

    def finish(self, idx):
        self.done[idx] = True
        while self.next < len(self.done) and self.done[self.next]:
            self.render(self.next)
            self.next += 1
        sys.stdout.flush()


def _banner(verb, project, compiler):
    return (f"\n{'='*60}\n{verb}: {project}  (compiler={compiler})\n"
            f"{'='*60}\n")


def build_projects_parallel(projects, jobs, extra_args):
    """`rz build --all` on the pool. Returns (failed, setup): failed
    projects in order, and the subset whose build exited EXIT_SETUP."""
    compiler = extra_args[extra_args.index("--compiler") + 1] \
        if "--compiler" in extra_args else "ritz0"
    units = [Unit(project=p, order=(i,), sched=(i,), kind="build",
                  cmd=[sys.executable, str(RITZ_BUILD), "build",
                       str(PROJECTS_DIR / p), *extra_args],
                  env=child_env(p))
             for i, p in enumerate(projects)]
    failed, setup = [], []

    def render(i):
        u = units[i]
        _emit(_banner("Building", u.project, compiler))
        _emit(u.output)
        if u.rc != 0:
            failed.append(u.project)
            if u.rc == EXIT_SETUP:
                setup.append(u.project)
            _emit(f"✗ {u.project}: build failed (exit {u.rc})")

    printer = _InOrderPrinter(len(projects), render)
    t0 = time.monotonic()
    run_pool(jobs, units, lambda u: printer.finish(u.order[0]))
    _emit(f"rz: built {len(projects)} project(s) on {jobs} worker(s) "
          f"in {time.monotonic() - t0:.1f}s")
    return failed, setup


@dataclass
class _ProjectRun:
    project: str
    plan_unit: Unit = None
    plan: dict = None
    files: list = field(default_factory=list)   # file Units, serial order
    test_sh: Unit = None
    pending: int = 0


def test_projects_parallel(projects, jobs, compiler):
    """`rz test --all` on the pool. Returns failed projects, in order.

    A project fails iff any of its units exits non-zero — exactly when the
    serial `build.py test P` exits non-zero.
    """
    tmp = tempfile.TemporaryDirectory(prefix="rz-units-")
    tmpdir = Path(tmp.name)
    runs = [_ProjectRun(p) for p in projects]
    envs = {}
    base = [sys.executable, str(RITZ_BUILD), "test"]

    def env_for(p):
        if p not in envs:
            envs[p] = child_env(p)
        return envs[p]

    def pdir(p):
        return str(PROJECTS_DIR / p)

    initial = []
    for i, r in enumerate(runs):
        plan_path = tmpdir / f"{i}.plan.json"
        # Plans (package builds) schedule ahead of every file so the ready
        # set fills as early as possible; files then run project by project.
        r.plan_unit = Unit(project=r.project, order=(i, 0), sched=(0, i),
                           kind="plan", path=plan_path, env=env_for(r.project),
                           cmd=[*base, pdir(r.project), "--compiler", compiler,
                                "--unit-plan", str(plan_path)])
        r.pending = 1
        initial.append(r.plan_unit)

    failed = []

    def render(i):
        r = runs[i]
        _emit(_banner("Testing", r.project, compiler))
        _emit(r.plan_unit.output)
        plan = r.plan or {}
        if r.files:
            _emit(f"  🧪 Running {len(r.files)} .ritz test file(s)...")
            outcomes = []
            for u in r.files:
                _emit(u.output)
                res = _read_json(u.path)
                if not isinstance(res, dict) or "status" not in res:
                    # The unit died before writing a verdict: count it as a
                    # file that did not pass, never as a missing file.
                    res = {"status": "error", "passed": 0, "failed": 0}
                outcomes.append(res)
            _emit(_buildpy().summarize_file_outcomes(outcomes))
        if r.test_sh:
            _emit(r.test_sh.output)
        if plan.get("built") and not r.files and not r.test_sh:
            _emit("  ⚠ No tests found, skipping")
        units = [r.plan_unit, *r.files, *([r.test_sh] if r.test_sh else [])]
        rc = next((u.rc for u in units if u.rc != 0), 0)
        _emit("\n✓ All tests passed!" if rc == 0 else "\n✗ Some tests failed")
        if rc != 0:
            failed.append(r.project)
            _emit(f"✗ {r.project}: tests failed (exit {rc})")

    printer = _InOrderPrinter(len(runs), render)

    def on_done(u):
        i = u.order[0]
        r = runs[i]
        r.pending -= 1
        follow = []
        if u.kind == "plan":
            r.plan = _read_json(u.path)
            plan = r.plan if isinstance(r.plan, dict) else {}
            if plan.get("built"):
                for j, f in enumerate(plan.get("files", [])):
                    res = tmpdir / f"{i}.{j}.result.json"
                    follow.append(Unit(
                        project=r.project, order=(i, 1, j), sched=(1, i, j),
                        kind="file", path=res, file=f, env=env_for(r.project),
                        cmd=[*base, pdir(r.project), "--compiler", compiler,
                             "--unit-file", f, "--unit-result", str(res)]))
                r.files = list(follow)
                if plan.get("test_sh"):
                    r.test_sh = Unit(
                        project=r.project, order=(i, 2), sched=(1, i, -1),
                        kind="test-sh", env=env_for(r.project),
                        cmd=[*base, pdir(r.project), "--compiler", compiler,
                             "--unit-test-sh"])
                    follow.append(r.test_sh)
            r.pending += len(follow)
        if r.pending == 0:
            printer.finish(i)
        return follow

    t0 = time.monotonic()
    try:
        run_pool(jobs, initial, on_done)
    finally:
        tmp.cleanup()
    n_units = sum(1 + len(r.files) + bool(r.test_sh) for r in runs)
    _emit(f"rz: tested {len(projects)} project(s), {n_units} unit(s) on "
          f"{jobs} worker(s) in {time.monotonic() - t0:.1f}s")
    return failed


def cmd_build(args):
    """Handle 'rz build' command."""
    extra_args = ["--release"] if getattr(args, "release", False) else []
    compiler = getattr(args, "compiler", "ritz0")
    extra_args.extend(["--compiler", compiler])

    if args.all:
        projects = discover_projects()
        jobs = resolve_jobs(getattr(args, "jobs", None))
        if jobs > 1:
            failed, setup = build_projects_parallel(projects, jobs, extra_args)
            return summarize_gate(
                "build", failed, known_failing_from_config(compiler), projects,
                setup=setup)
        failed, setup = [], []
        for project in projects:
            # flush=True on the banner (and the verdict below) is load-bearing:
            # with stdout piped (CI), unflushed banners detach from the child
            # diagnostics that follow them. See child_env().
            print(f"\n{'='*60}", flush=True)
            print(f"Building: {project}  (compiler={compiler})", flush=True)
            print('='*60, flush=True)
            rc = run_build(project, extra_args)
            if rc != 0:
                failed.append(project)
                if rc == EXIT_SETUP:
                    setup.append(project)
                print(f"✗ {project}: build failed (exit {rc})", flush=True)

        return summarize_gate(
            "build", failed, known_failing_from_config(compiler), projects,
            setup=setup)

    if not args.project:
        print("Error: Specify a project or use --all", file=sys.stderr)
        return 1

    project = _resolve_or_report(args.project)
    if project is None:
        return 1
    return run_build(project, extra_args)


def cmd_test(args):
    """Handle 'rz test' command."""
    compiler = getattr(args, "compiler", "ritz0")
    extra_args = ["--compiler", compiler]

    if args.all:
        projects = discover_projects()
        jobs = resolve_jobs(getattr(args, "jobs", None))
        if jobs > 1:
            failed = test_projects_parallel(projects, jobs, compiler)
        else:
            failed = serial_test_sweep(projects, extra_args, compiler)
        # There is deliberately NO test-side excuse (known_failures.py
        # refuses gate = "test"). House rule
        # (scripts/regression.sh): an allowlist may say "this program is
        # known not to compile"; it must never excuse behavioural failure.
        # A test-side excuse would do exactly that. But a project that
        # cannot COMPILE also fails its test sweep for the same compile
        # reason — that is the build fact again, not new behavioural
        # information — so the test gate consults the BUILD list and
        # nothing else. If an excused project starts compiling, the build
        # sweep xpass-fails and forces delisting, which immediately
        # re-exposes any genuine behavioural failure here. Every other
        # test failure gates, always.
        return summarize_gate(
            "test", failed, known_failing_from_config(compiler), projects)

    if not args.project:
        print("Error: Specify a project or use --all", file=sys.stderr)
        return 1

    project = _resolve_or_report(args.project)
    if project is None:
        return 1
    return run_test(project, extra_args)


def serial_test_sweep(projects, extra_args, compiler):
    """The original one-project-at-a-time `rz test --all` (-j 1)."""
    failed = []
    for project in projects:
        # No pre-filter here on purpose.
        #
        # This used to skip any project whose [build] table lacked a
        # literal `test` key. Almost nothing sets that key — projects
        # declare tests via `[[test]]` fns, `test_only`, or simply a
        # test/ directory — so `rz test --all` silently covered 2 of 26
        # projects while reporting "All tests passed!". A gate that skips
        # 92% of the workspace is worse than no gate: it reports green.
        #
        # build.py already owns test discovery (the test/ glob,
        # `[[test]]` fns under src/ and ritz.toml [test] sources,
        # test_only packages, test.sh) and prints
        # "No tests found, skipping" without failing. Deferring to it
        # keeps discovery in one place instead of two that disagree.
        #
        # This comment used to say "test/ and tests/ globs". build.py does
        # NOT glob tests/ — discover_test_files() reads pkg_dir/"test"
        # only. That false claim was the only written record of a tests/
        # convention, and five packages followed it: iris (30 test fns),
        # valet (99), lexis (115), tempest (7) and ritz1 (3) were
        # invisible to every gate. All moved to test/, and a tests/ holding
        # .ritz (unless it is its own package) is now a build.py error
        # naming the files (StrayTestsDirError). See AGAST #1386.
        # flush=True is load-bearing under a piped stdout — see child_env().
        print(f"\n{'='*60}", flush=True)
        print(f"Testing: {project}  (compiler={compiler})", flush=True)
        print('='*60, flush=True)
        rc = run_test(project, extra_args)
        if rc != 0:
            failed.append(project)
            print(f"✗ {project}: tests failed (exit {rc})", flush=True)

    return failed


def cmd_run(args):
    """Handle 'rz run' command."""
    if not args.project:
        print("Error: Specify a project to run", file=sys.stderr)
        return 1

    compiler = getattr(args, "compiler", "ritz0")
    extra_args = ["--compiler", compiler]
    if getattr(args, "release", False):
        extra_args.append("--release")

    project = _resolve_or_report(args.project)
    if project is None:
        return 1

    # First build
    if run_build(project, extra_args) != 0:
        return 1

    # Then run - look for the binary
    project_dir = PROJECTS_DIR / project
    build_dir = project_dir / "build"

    # Find the binary (typically named after the package directory; for a
    # nested id like "a/b" that is "b", not the id)
    bin_name = Path(project).name
    binary = build_dir / bin_name
    if not binary.exists():
        # Try debug subdirectory
        binary = build_dir / "debug" / bin_name

    if not binary.exists():
        print(f"Error: Could not find binary for '{args.project}'", file=sys.stderr)
        return 1

    env = os.environ.copy()
    env["RITZ_PATH"] = str(PROJECTS_DIR / "ritz")

    result = bounded_run.user_program([str(binary)] + args.args, env=env)
    return result.returncode


def cmd_list(args):
    """Handle 'rz list' command."""
    projects = discover_projects()

    ws = load_workspace_config().get("workspace", {})
    header = " ".join(filter(None, [ws.get("name", WORKSPACE_ROOT.name),
                                    ws.get("version")]))
    print(f"Workspace: {header}")
    if ws.get("description"):
        print(f"  {ws['description']}")
    print(f"Projects ({len(projects)}):\n")

    for project in projects:
        config = get_project_config(project)
        if config and "package" in config:
            desc = config["package"].get("description", "")
            name = config["package"].get("name", project)
            version = config["package"].get("version", "")
            print(f"  {name:20} {version:12} {desc}")
        else:
            print(f"  {project}")

    return 0


def cmd_clean(args):
    """Handle 'rz clean' command."""
    if args.all:
        projects = discover_projects()
    elif args.project:
        project = _resolve_or_report(args.project)
        if project is None:
            return 1
        projects = [project]
    else:
        print("Error: Specify a project or use --all", file=sys.stderr)
        return 1

    for project in projects:
        project_dir = PROJECTS_DIR / project
        build_dir = project_dir / "build"
        if build_dir.exists():
            print(f"Cleaning: {project}")
            import shutil
            shutil.rmtree(build_dir)

    return 0


def cmd_cache(args):
    """Handle 'rz cache' — the shared artifact store (projects/ritz/cas.py).

    `rz cache gc` trims it to a size cap, least-recently-used first
    (default $RITZ_CACHE_MAX_BYTES, else cas.DEFAULT_GC_BYTES); every
    ci_local gate ends with the same trim. `rz cache path` prints where it is.
    AGAST #1894.
    """
    argv = [args.cache_command or "path"]
    if getattr(args, "max_bytes", None) is not None:
        argv += ["--max-bytes", str(args.max_bytes)]
    return bounded_run.child([sys.executable, str(PROJECTS_DIR / "ritz" / "cas.py"), *argv]).returncode


def _positive_int(text):
    try:
        n = int(text)
    except ValueError:
        raise argparse.ArgumentTypeError(f"not an integer: {text!r}")
    if n < 1:
        raise argparse.ArgumentTypeError(f"must be >= 1, got {n}")
    return n


JOBS_HELP = ("Run up to N build/test units at once for --all (default: "
             "rz.toml [build] max_jobs; 1 = the serial, streaming sweep)")


def build_parser():
    parser = argparse.ArgumentParser(
        description="Unified workspace CLI for the Ritz ecosystem",
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog=__doc__
    )

    subparsers = parser.add_subparsers(dest="command", help="Command to run")

    # build
    build_parser = subparsers.add_parser("build", help="Build a project")
    build_parser.add_argument("project", nargs="?", help="Project to build")
    build_parser.add_argument("--all", action="store_true", help="Build all projects")
    build_parser.add_argument("--release", action="store_true", help="Build with release profile")
    build_parser.add_argument("--compiler", choices=["ritz0", "ritz1", "ritz1_selfhosted"], default="ritz0",
                              help="Compiler to use (default: ritz0)")
    build_parser.add_argument("-j", "--jobs", type=_positive_int, metavar="N",
                              help=JOBS_HELP)

    # test
    test_parser = subparsers.add_parser("test", help="Run tests")
    test_parser.add_argument("project", nargs="?", help="Project to test")
    test_parser.add_argument("--all", action="store_true", help="Test all projects")
    test_parser.add_argument("--compiler", choices=["ritz0", "ritz1", "ritz1_selfhosted"], default="ritz0",
                             help="Compiler to use (default: ritz0)")
    test_parser.add_argument("-j", "--jobs", type=_positive_int, metavar="N",
                             help=JOBS_HELP)

    # run
    run_parser = subparsers.add_parser("run", help="Build and run a project")
    run_parser.add_argument("project", help="Project to run")
    run_parser.add_argument("--compiler", choices=["ritz0", "ritz1", "ritz1_selfhosted"], default="ritz0",
                            help="Compiler to use (default: ritz0)")
    run_parser.add_argument("--release", action="store_true", help="Build with release profile")
    run_parser.add_argument("args", nargs="*", help="Arguments to pass to the binary")

    # list
    subparsers.add_parser("list", help="List all projects")

    # clean
    clean_parser = subparsers.add_parser("clean", help="Clean build artifacts")
    clean_parser.add_argument("project", nargs="?", help="Project to clean")
    clean_parser.add_argument("--all", action="store_true", help="Clean all projects")

    # cache
    cache_parser = subparsers.add_parser("cache", help="Shared artifact store (gc, path)")
    cache_sub = cache_parser.add_subparsers(dest="cache_command")
    cache_gc = cache_sub.add_parser("gc", help="Trim least-recently-used entries to a size cap")
    cache_gc.add_argument("--max-bytes", type=int, default=None,
                          help="cap in bytes (default $RITZ_CACHE_MAX_BYTES, else 4 GiB)")
    cache_sub.add_parser("path", help="Print the store directory")

    commands = {
        "build": cmd_build,
        "test": cmd_test,
        "run": cmd_run,
        "list": cmd_list,
        "clean": cmd_clean,
        "cache": cmd_cache,
    }
    for name, sub in subparsers.choices.items():
        sub.set_defaults(func=commands[name])
    return parser


def main():
    parser = build_parser()
    args = parser.parse_args()

    if not args.command:
        parser.print_help()
        return 1

    try:
        return args.func(args)
    except manifest.ManifestError as e:
        # file:line, not a traceback: the manifest is the user's to fix.
        print(f"rz: error: {e}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    sys.exit(main())
