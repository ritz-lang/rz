# protocol.ritz - mirror of zeus/lib/zeus_client.ritz pattern
# pub struct + pub fn with param-name == field-name, called cross-module.

pub const PROTO_VERSION: u8 = 1
pub const MSG_HELLO: u8 = 1

pub struct Msg
    msg_type: u8
    version: u8
    _reserved: [6]u8

pub fn msg_init(msg: *Msg, msg_type: u8)
    msg.msg_type = msg_type
    msg.version = PROTO_VERSION
    var i: i32 = 0
    while i < 6
        msg._reserved[i] = 0
        i = i + 1
