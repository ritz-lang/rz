# S3: parameter name shadows struct field name (multi-module).
# Mirrors the zeus_client.ritz / zeus main.ritz call pattern that failed.

import ritzlib.io { prints, print_int }
import s3_param_shadow.protocol { Msg, msg_init, MSG_HELLO }

pub fn main() -> i32
    var m: Msg
    m.msg_type = 0 as u8
    m.version = 0 as u8
    msg_init(@m, MSG_HELLO)
    prints("multi-module shadow: msg_type=")
    print_int(m.msg_type as i64)
    prints(" (expect 1)\n")
    prints("multi-module shadow: version=")
    print_int(m.version as i64)
    prints(" (expect 1)\n")
    return 0
