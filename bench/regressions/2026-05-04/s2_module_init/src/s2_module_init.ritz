# S2: Module-level `var X: T = literal` initializer.
# Hypothesis: some `var X: i32 = N` at module scope land as 0 at runtime.
# Counter-evidence: nexus's `var g_port: i32 = 7777` printed correctly.
#
# Probe: declare several module-level vars with different values and types,
# then print each from main without any reassignment.

import ritzlib.io { prints, print_int }

var g_one: i32 = 1
var g_two: i32 = 2
var g_seven: i32 = 7
var g_port: i32 = 7777
var g_minus: i32 = -1
var g_zero: i32 = 0
var g_running: i32 = 1
var g_u8: u8 = 1
var g_u32: u32 = 1
var g_u64: u64 = 1
var g_i64: i64 = 1
var g_big: i64 = 7777777777

pub fn main() -> i32
    prints("g_one     = ")
    print_int(g_one as i64)
    prints(" (expect 1)\n")
    prints("g_two     = ")
    print_int(g_two as i64)
    prints(" (expect 2)\n")
    prints("g_seven   = ")
    print_int(g_seven as i64)
    prints(" (expect 7)\n")
    prints("g_port    = ")
    print_int(g_port as i64)
    prints(" (expect 7777)\n")
    prints("g_minus   = ")
    print_int(g_minus as i64)
    prints(" (expect -1)\n")
    prints("g_zero    = ")
    print_int(g_zero as i64)
    prints(" (expect 0)\n")
    prints("g_running = ")
    print_int(g_running as i64)
    prints(" (expect 1)\n")
    prints("g_u8      = ")
    print_int(g_u8 as i64)
    prints(" (expect 1)\n")
    prints("g_u32     = ")
    print_int(g_u32 as i64)
    prints(" (expect 1)\n")
    prints("g_u64     = ")
    print_int(g_u64 as i64)
    prints(" (expect 1)\n")
    prints("g_i64     = ")
    print_int(g_i64)
    prints(" (expect 1)\n")
    prints("g_big     = ")
    print_int(g_big)
    prints(" (expect 7777777777)\n")

    # Probe the actual zeus pattern: `while g_X != 0` with module-level var
    # set to 1.  Also test reading g_running through a function call boundary.
    var iters: i32 = 0
    while g_running != 0 and iters < 3
        prints("loop-iter ")
        print_int(iters as i64)
        prints(" g_running=")
        print_int(g_running as i64)
        prints("\n")
        iters = iters + 1
    prints("loop-exit iters=")
    print_int(iters as i64)
    prints(" (expect 3)\n")

    # Also test the call-boundary pattern (zeus: handle_signals -> g_running = 0)
    prints("after_set g_running=")
    set_running_zero()
    print_int(g_running as i64)
    prints(" (expect 0)\n")
    return 0

fn set_running_zero()
    g_running = 0
