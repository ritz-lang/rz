# S2: Module-level `var X: T = literal` initializer.
# Hypothesis: some `var X: i32 = N` at module scope land as 0 at runtime.
# Counter-evidence: nexus's `var g_port: i32 = 7777` printed correctly.
#
# Probe: declare several module-level vars with different values and types,
# then print each from main without any reassignment.

import ritzlib.io

var g_one: i32 = 1
var g_two: i32 = 2
var g_seven: i32 = 7
var g_port: i32 = 7777
var g_minus: i32 = -1
var g_zero: i32 = 0
var g_running: i32 = 1
var g_u8: u8 = 1
var g_u32: u32 = 1
var g_u64: u64 = 1
var g_i64: i64 = 1
var g_big: i64 = 7777777777

pub fn main() -> i32
    print("g_one     = {g_one} (expect 1)\n")
    print("g_two     = {g_two} (expect 2)\n")
    print("g_seven   = {g_seven} (expect 7)\n")
    print("g_port    = {g_port} (expect 7777)\n")
    print("g_minus   = {g_minus} (expect -1)\n")
    print("g_zero    = {g_zero} (expect 0)\n")
    print("g_running = {g_running} (expect 1)\n")
    print("g_u8      = {g_u8} (expect 1)\n")
    print("g_u32     = {g_u32} (expect 1)\n")
    print("g_u64     = {g_u64} (expect 1)\n")
    print("g_i64     = {g_i64} (expect 1)\n")
    print("g_big     = {g_big} (expect 7777777777)\n")

    # Probe the actual zeus pattern: `while g_X != 0` with module-level var
    # set to 1.  Also test reading g_running through a function call boundary.
    var iters: i32 = 0
    while g_running != 0 and iters < 3
        print("loop-iter {iters} g_running={g_running}\n")
        iters = iters + 1
    print("loop-exit iters={iters} (expect 3)\n")

    # Also test the call-boundary pattern (zeus: handle_signals -> g_running = 0)
    set_running_zero()
    print("after_set g_running={g_running} (expect 0)\n")
    return 0

fn set_running_zero()
    g_running = 0
